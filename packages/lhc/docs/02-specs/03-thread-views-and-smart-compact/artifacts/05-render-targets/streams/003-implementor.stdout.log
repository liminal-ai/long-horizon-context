{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BvH5gSqtH1aBefDo3eJeao","type":"tool_result","content":"1\t// Story 1 (Epic 02), process-boundary suite: the architecture-risk tests\n2\t// that in-process fixtures cannot prove. TC-1.3 SIGKILLs a real drain in the\n3\t// reclaim window (between an item's claim and its complete) and shows a later\n4\t// drain finishes the queue with nothing lost and nothing duplicated. TC-1.4\n5\t// proves cross-process claim exclusion through the durable lease alone — the\n6\t// second process is the real spawned CLI. The parity rows prove `lhc work\n7\t// drain` through dist/cli.js, including DD-11 provider resolution. Runs\n8\t// under verify-all only (LHC_PROCESS_SUITE=1).\n9\timport { spawn, spawnSync, type ChildProcess } from \"node:child_process\";\n10\timport { mkdtempSync, rmSync } from \"node:fs\";\n11\timport { tmpdir } from \"node:os\";\n12\timport path from \"node:path\";\n13\timport { fileURLToPath } from \"node:url\";\n14\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n15\timport {\n16\t  countLiveItems,\n17\t  createSdk,\n18\t  intakeStream,\n19\t  queueDetail,\n20\t  resolveNamedProvider,\n21\t  threads,\n22\t  type DrainReport,\n23\t  type OpResult,\n24\t} from \"../src/index.js\";\n25\timport {\n26\t  createProviderDouble,\n27\t  openRaw,\n28\t  readDerivedForms,\n29\t  registerTestWorkHandlers,\n30\t  validEvent,\n31\t} from \"./fixtures/index.js\";\n32\t\n33\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n34\tconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\n35\tconst runnerPath = path.join(pkgRoot, \"test\", \"fixtures\", \"drain-runner.ts\");\n36\t\n37\tfunction sleep(ms: number): Promise<void> {\n38\t  return new Promise((resolve) => setTimeout(resolve, ms));\n39\t}\n40\t\n41\tfunction runBinary(\n42\t  args: string[],\n43\t  env?: Record<string, string | undefined>,\n44\t): { status: number | null; stdout: string; stderr: string } {\n45\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n46\t    encoding: \"utf8\",\n47\t    env: { ...process.env, ...env },\n48\t  });\n49\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n50\t}\n51\t\n52\tinterface RunnerHandle {\n53\t  child: ChildProcess;\n54\t  stdout: () => string;\n55\t  waitForLine: (prefix: string) => Promise<string>;\n56\t  waitForExit: () => Promise<{ code: number | null; signal: NodeJS.Signals | null }>;\n57\t}\n58\t\n59\t// Spawns the drain runner under tsx — a real second process draining through\n60\t// the real SDK surface, no in-process shortcuts.\n61\tfunction spawnRunner(config: {\n62\t  threadPath: string;\n63\t  leaseMs: number;\n64\t  holdMs: number;\n65\t  holdFrom: number;\n66\t}): RunnerHandle {\n67\t  const child = spawn(\n68\t    process.execPath,\n69\t    [\"--import\", \"tsx\", runnerPath, JSON.stringify(config)],\n70\t    { cwd: pkgRoot, stdio: [\"ignore\", \"pipe\", \"pipe\"] },\n71\t  );\n72\t  let buffered = \"\";\n73\t  let errBuffered = \"\";\n74\t  child.stdout?.setEncoding(\"utf8\");\n75\t  child.stderr?.setEncoding(\"utf8\");\n76\t  child.stdout?.on(\"data\", (chunk: string) => {\n77\t    buffered += chunk;\n78\t  });\n79\t  child.stderr?.on(\"data\", (chunk: string) => {\n80\t    errBuffered += chunk;\n81\t  });\n82\t  return {\n83\t    child,\n84\t    stdout: () => buffered,\n85\t    waitForLine: (prefix: string) =>\n86\t      new Promise<string>((resolve, reject) => {\n87\t        const check = (): void => {\n88\t          const line = buffered.split(\"\\n\").find((candidate) => candidate.startsWith(prefix));\n89\t          if (line !== undefined) {\n90\t            child.stdout?.off(\"data\", check);\n91\t            resolve(line);\n92\t          }\n93\t        };\n94\t        child.stdout?.on(\"data\", check);\n95\t        child.on(\"exit\", () =>\n96\t          reject(\n97\t            new Error(`runner exited before \"${prefix}\"; stdout=${buffered} stderr=${errBuffered}`),\n98\t          ),\n99\t        );\n100\t        check();\n101\t      }),\n102\t    waitForExit: () =>\n103\t      new Promise((resolve) => {\n104\t        child.on(\"exit\", (code, signal) => resolve({ code, signal }));\n105\t      }),\n106\t  };\n107\t}\n108\t\n109\tlet dir: string;\n110\tbeforeEach(() => {\n111\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-drain-\"));\n112\t});\n113\tafterEach(() => {\n114\t  rmSync(dir, { recursive: true, force: true });\n115\t});\n116\t\n117\tasync function newThreadFile(name: string): Promise<string> {\n118\t  const filePath = path.join(dir, `${name}.sqlite`);\n119\t  const created = await threads.newThread({\n120\t    filePath,\n121\t    registryPath: path.join(dir, \"registry.sqlite\"),\n122\t  });\n123\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n124\t  return filePath;\n125\t}\n126\t\n127\tfunction rawLiveCount(filePath: string): number {\n128\t  const db = openRaw(filePath);\n129\t  try {\n130\t    return countLiveItems(db);\n131\t  } finally {\n132\t    db.close();\n133\t  }\n134\t}\n135\t\n136\tfunction rawDetail(filePath: string): ReturnType<typeof queueDetail> {\n137\t  const db = openRaw(filePath);\n138\t  try {\n139\t    return queueDetail(db);\n140\t  } finally {\n141\t    db.close();\n142\t  }\n143\t}\n144\t\n145\tdescribe(\"TC-1.3 / AC-1.3 (architecture risk): queued and claimed work survives SIGKILL mid-drain\", () => {\n146\t  it(\"kills the drain between item 2's claim and complete; a later drain reclaims and finishes with nothing lost or duplicated\", async () => {\n147\t    const threadPath = await newThreadFile(\"kill\");\n148\t    const seeded = await intakeStream.messageEvents({ filePath: threadPath }, [\n149\t      validEvent(\"user_prompt\"),\n150\t      validEvent(\"tool_call\"),\n151\t      validEvent(\"tool_result\"),\n152\t      validEvent(\"turn_end\"),\n153\t    ]);\n154\t    expect(seeded.ok).toBe(true);\n155\t    // 4 items since Epic 02 Story 2: tool_call queues its summary\n156\t    // (sanctioned amendment — was 3).\n157\t    expect(rawLiveCount(threadPath)).toBe(4);\n158\t\n159\t    // Runner: item 1 completes normally; from item 2 on, the handler holds —\n160\t    // so the HANDLER_START 2 marker means item 1's complete landed and item\n161\t    // 2 sits claimed inside the reclaim window.\n162\t    const runner = spawnRunner({ threadPath, leaseMs: 250, holdMs: 8000, holdFrom: 2 });\n163\t    await runner.waitForLine(\"HANDLER_START 2\");\n164\t\n165\t    // Pre-kill read of item 1's landed artifact — the byte-compare baseline.\n166\t    const preKill = readDerivedForms(threadPath).find(\n167\t      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n168\t    );\n169\t    expect(preKill?.state).toBe(\"ready\");\n170\t\n171\t    runner.child.kill(\"SIGKILL\");\n172\t    const exit = await runner.waitForExit();\n173\t    expect(exit.signal).toBe(\"SIGKILL\");\n174\t\n175\t    // The kill landed in the reclaim window: item 2 is still claimed in the\n176\t    // record, item 3 untouched, and no artifact beyond item 1's is visible\n177\t    // as ready (NFR: a killed drain leaves no partial artifact).\n178\t    const afterKill = rawDetail(threadPath);\n179\t    expect(afterKill.map((row) => [row.workItemId, row.status])).toEqual([\n180\t      [\"w-m2-tool_call_summary-v1\", \"claimed\"],\n181\t      [\"w-m3-tool_result_summary-v1\", \"queued\"],\n182\t      [\"w-t1-turn_derivation-v1\", \"queued\"],\n183\t    ]);\n184\t    const readyAfterKill = readDerivedForms(threadPath).filter((f) => f.state === \"ready\");\n185\t    expect(readyAfterKill.map((f) => `${f.subjectId}/${f.form}`)).toEqual([\"m1/smoothed_prompt\"]);\n186\t\n187\t    // Let the orphaned lease expire, then drain from a fresh process-side\n188\t    // handle: the expired claim is reclaimed with attempts incremented — the\n189\t    // crash made visible in the report.\n190\t    await sleep(450);\n191\t    const double = createProviderDouble();\n192\t    const sdk = createSdk({\n193\t      provider: double,\n194\t      mode: \"manual\",\n195\t      lease: { durationMs: 250 },\n196\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n197\t    });\n198\t    registerTestWorkHandlers(sdk, double);\n199\t    const drained = await sdk.work.drain({ filePath: threadPath });\n200\t    expect(drained.ok).toBe(true);\n201\t    if (!drained.ok) return;\n202\t    expect(drained.value.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n203\t      [\"w-m2-tool_call_summary-v1\", \"done\"],\n204\t      [\"w-m3-tool_result_summary-v1\", \"done\"],\n205\t      [\"w-t1-turn_derivation-v1\", \"done\"],\n206\t    ]);\n207\t    expect(drained.value.ran[0]?.attempts).toBe(1); // the reclaim, counted\n208\t\n209\t    // Item 1's artifact is byte-unchanged against the pre-kill read; every\n210\t    // unfinished item ran exactly once; no duplicate rows anywhere.\n211\t    const finalForms = readDerivedForms(threadPath);\n212\t    const postKill = finalForms.find(\n213\t      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n214\t    );\n215\t    expect(postKill).toEqual(preKill);\n216\t    expect(finalForms).toHaveLength(5);\n217\t    expect(finalForms.every((form) => form.state === \"ready\")).toBe(true);\n218\t    expect(rawLiveCount(threadPath)).toBe(0);\n219\t  }, 30000);\n220\t});\n221\t\n222\tdescribe(\"TC-1.4 / AC-1.4 (architecture risk): two drains cannot interleave — the lease is the only coordination\", () => {\n223\t  it(\"a second process's drain against a live claim reports in_flight, runs nothing, and never skips ahead\", async () => {\n224\t    const threadPath = await newThreadFile(\"hold\");\n225\t    const seeded = await intakeStream.messageEvents({ filePath: threadPath }, [\n226\t      validEvent(\"user_prompt\"),\n227\t      validEvent(\"turn_end\"),\n228\t    ]);\n229\t    expect(seeded.ok).toBe(true);\n230\t    expect(rawLiveCount(threadPath)).toBe(2);\n231\t\n232\t    // Process A claims the head under a 10s lease and holds mid-handler.\n233\t    const runner = spawnRunner({ threadPath, leaseMs: 10000, holdMs: 2500, holdFrom: 1 });\n234\t    await runner.waitForLine(\"HANDLER_START 1\");\n235\t\n236\t    // Process B: the real spawned CLI, against A's live claim.\n237\t    const second = runBinary([\"work\", \"drain\", \"--file-path\", threadPath], {\n238\t      LHC_PROVIDER: \"deterministic\",\n239\t    });\n240\t    expect(second.status).toBe(0);\n241\t    const parsed = JSON.parse(second.stdout) as OpResult<DrainReport>;\n242\t    expect(parsed.ok).toBe(true);\n243\t    if (!parsed.ok) return;\n244\t    expect(parsed.value.stoppedBecause).toBe(\"in_flight\");\n245\t    expect(parsed.value.ran).toEqual([]);\n246\t    expect(parsed.value.remaining).toBe(2);\n247\t\n248\t    // The skip-ahead proof: the queued item behind the live head was not\n249\t    // claimed by B — exclusion without this is half the test.\n250\t    const detail = rawDetail(threadPath);\n251\t    expect(detail[1]).toMatchObject({\n252\t      workItemId: \"w-t1-turn_derivation-v1\",\n253\t      status: \"queued\",\n254\t      attempts: 0,\n255\t    });\n256\t    expect(detail[1]?.claimedAt).toBeUndefined();\n257\t\n258\t    // A finishes its drain normally.\n259\t    const exit = await runner.waitForExit();\n260\t    expect(exit.code).toBe(0);\n261\t    expect(runner.stdout()).toContain(\"DRAIN_DONE\");\n262\t    expect(rawLiveCount(threadPath)).toBe(0);\n263\t    expect(readDerivedForms(threadPath).every((form) => form.state === \"ready\")).toBe(true);\n264\t  }, 30000);\n265\t});\n266\t\n267\tdescribe(\"CLI parity: lhc work drain through the spawned binary (DD-11 provider resolution)\", () => {\n268\t  it(\"report JSON matches the SDK shape on twin threads; exits 0 with work\", async () => {\n269\t    const batch = [validEvent(\"user_prompt\"), validEvent(\"turn_end\")];\n270\t    const cliThread = await newThreadFile(\"cli-twin\");\n271\t    const sdkThread = await newThreadFile(\"sdk-twin\");\n272\t    for (const filePath of [cliThread, sdkThread]) {\n273\t      const seeded = await intakeStream.messageEvents(\n274\t        { filePath },\n275\t        batch.map((event, index) => ({ ...event, idempotencyKey: `twin-${index}` })),\n276\t      );\n277\t      expect(seeded.ok).toBe(true);\n278\t    }\n279\t\n280\t    const viaCli = runBinary([\"work\", \"drain\", \"--file-path\", cliThread], {\n281\t      LHC_PROVIDER: \"deterministic\",\n282\t    });\n283\t    expect(viaCli.status).toBe(0);\n284\t    const cliReport = JSON.parse(viaCli.stdout) as OpResult<DrainReport>;\n285\t    expect(cliReport.ok).toBe(true);\n286\t\n287\t    // The SDK twin drains through the same production assembly the CLI uses:\n288\t    // registry provider, manual mode, the production domain handler tables\n289\t    // (messages registered in Story 2) — so the two reports must be\n290\t    // identical, shape and content.\n291\t    const provider = resolveNamedProvider(\"deterministic\");\n292\t    if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n293\t    const sdk = createSdk({ provider, mode: \"manual\" });\n294\t    const viaSdk = await sdk.work.drain({ filePath: sdkThread });\n295\t    expect(viaSdk.ok).toBe(true);\n296\t    if (!cliReport.ok || !viaSdk.ok) return;\n297\t    expect(cliReport.value).toEqual(viaSdk.value);\n298\t  });\n299\t\n300\t  it(\"exits 0 on an empty queue and 1 on a missing thread\", async () => {\n301\t    const emptyThread = await newThreadFile(\"empty\");\n302\t    const empty = runBinary([\"work\", \"drain\", \"--file-path\", emptyThread], {\n303\t      LHC_PROVIDER: \"deterministic\",\n304\t    });\n305\t    expect(empty.status).toBe(0);\n306\t    const emptyReport = JSON.parse(empty.stdout) as OpResult<DrainReport>;\n307\t    expect(emptyReport.ok).toBe(true);\n308\t    if (!emptyReport.ok) return;\n309\t    expect(emptyReport.value).toEqual({ ran: [], stoppedBecause: \"empty\", remaining: 0 });\n310\t\n311\t    const missing = runBinary(\n312\t      [\"work\", \"drain\", \"--file-path\", path.join(dir, \"nope.sqlite\")],\n313\t      { LHC_PROVIDER: \"deterministic\" },\n314\t    );\n315\t    expect(missing.status).toBe(1);\n316\t    const missingResult = JSON.parse(missing.stdout) as { ok: boolean; error: { code: string } };\n317\t    expect(missingResult.ok).toBe(false);\n318\t    expect(missingResult.error.code).toBe(\"thread_not_found\");\n319\t  });\n320\t\n321\t  it(\"refuses to drain without a resolvable provider, naming the flag and env var (DD-11)\", async () => {\n322\t    const threadPath = await newThreadFile(\"no-provider\");\n323\t    const result = runBinary([\"work\", \"drain\", \"--file-path\", threadPath], {\n324\t      LHC_PROVIDER: undefined,\n325\t    });\n326\t    expect(result.status).toBe(1);\n327\t    const parsed = JSON.parse(result.stdout) as {\n328\t      ok: boolean;\n329\t      error: { code: string; reason: string };\n330\t    };\n331\t    expect(parsed.ok).toBe(false);\n332\t    expect(parsed.error.code).toBe(\"provider_not_configured\");\n333\t    expect(parsed.error.reason).toContain(\"--provider\");\n334\t    expect(parsed.error.reason).toContain(\"LHC_PROVIDER\");\n335\t\n336\t    const unknown = runBinary(\n337\t      [\"work\", \"drain\", \"--file-path\", threadPath, \"--provider\", \"no-such-provider\"],\n338\t      {},\n339\t    );\n340\t    expect(unknown.status).toBe(1);\n341\t    const unknownParsed = JSON.parse(unknown.stdout) as { ok: boolean; error: { code: string } };\n342\t    expect(unknownParsed.error.code).toBe(\"provider_not_configured\");\n343\t  });\n344\t});\n345\t"}]},"parent_tool_use_id":null,"session_id":"d96b6140-abf0-4148-ae10-52f37fa752e0","uuid":"28ebc13c-317d-4862-80ec-f08d47b6b383","timestamp":"2026-06-11T17:53:30.563Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/cli-process-work.test.ts","content":"// Story 1 (Epic 02), process-boundary suite: the architecture-risk tests\n// that in-process fixtures cannot prove. TC-1.3 SIGKILLs a real drain in the\n// reclaim window (between an item's claim and its complete) and shows a later\n// drain finishes the queue with nothing lost and nothing duplicated. TC-1.4\n// proves cross-process claim exclusion through the durable lease alone — the\n// second process is the real spawned CLI. The parity rows prove `lhc work\n// drain` through dist/cli.js, including DD-11 provider resolution. Runs\n// under verify-all only (LHC_PROCESS_SUITE=1).\nimport { spawn, spawnSync, type ChildProcess } from \"node:child_process\";\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  countLiveItems,\n  createSdk,\n  intakeStream,\n  queueDetail,\n  resolveNamedProvider,\n  threads,\n  type DrainReport,\n  type OpResult,\n} from \"../src/index.js\";\nimport {\n  createProviderDouble,\n  openRaw,\n  readDerivedForms,\n  registerTestWorkHandlers,\n  validEvent,\n} from \"./fixtures/index.js\";\n\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\nconst runnerPath = path.join(pkgRoot, \"test\", \"fixtures\", \"drain-runner.ts\");\n\nfunction sleep(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nfunction runBinary(\n  args: string[],\n  env?: Record<string, string | undefined>,\n): { status: number | null; stdout: string; stderr: string } {\n  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    encoding: \"utf8\",\n    env: { ...process.env, ...env },\n  });\n  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n}\n\ninterface RunnerHandle {\n  child: ChildProcess;\n  stdout: () => string;\n  waitForLine: (prefix: string) => Promise<string>;\n  waitForExit: () => Promise<{ code: number | null; signal: NodeJS.Signals | null }>;\n}\n\n// Spawns the drain runner under tsx — a real second process draining through\n// the real SDK surface, no in-process shortcuts.\nfunction spawnRunner(config: {\n  threadPath: string;\n  leaseMs: number;\n  holdMs: number;\n  holdFrom: number;\n}): RunnerHandle {\n  const child = spawn(\n    process.execPath,\n    [\"--import\", \"tsx\", runnerPath, JSON.stringify(config)],\n    { cwd: pkgRoot, stdio: [\"ignore\", \"pipe\", \"pipe\"] },\n  );\n  let buffered = \"\";\n  let errBuffered = \"\";\n  child.stdout?.setEncoding(\"utf8\");\n  child.stderr?.setEncoding(\"utf8\");\n  child.stdout?.on(\"data\", (chunk: string) => {\n    buffered += chunk;\n  });\n  child.stderr?.on(\"data\", (chunk: string) => {\n    errBuffered += chunk;\n  });\n  return {\n    child,\n    stdout: () => buffered,\n    waitForLine: (prefix: string) =>\n      new Promise<string>((resolve, reject) => {\n        const check = (): void => {\n          const line = buffered.split(\"\\n\").find((candidate) => candidate.startsWith(prefix));\n          if (line !== undefined) {\n            child.stdout?.off(\"data\", check);\n            resolve(line);\n          }\n        };\n        child.stdout?.on(\"data\", check);\n        child.on(\"exit\", () =>\n          reject(\n            new Error(`runner exited before \"${prefix}\"; stdout=${buffered} stderr=${errBuffered}`),\n          ),\n        );\n        check();\n      }),\n    waitForExit: () =>\n      new Promise((resolve) => {\n        child.on(\"exit\", (code, signal) => resolve({ code, signal }));\n      }),\n  };\n}\n\nlet dir: string;\nbeforeEach(() => {\n  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-drain-\"));\n});\nafterEach(() => {\n  rmSync(dir, { recursive: true, force: true });\n});\n\nasync function newThreadFile(name: string): Promise<string> {\n  const filePath = path.join(dir, `${name}.sqlite`);\n  const created = await threads.newThread({\n    filePath,\n    registryPath: path.join(dir, \"registry.sqlite\"),\n  });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nfunction rawLiveCount(filePath: string): number {\n  const db = openRaw(filePath);\n  try {\n    return countLiveItems(db);\n  } finally {\n    db.close();\n  }\n}\n\nfunction rawDetail(filePath: string): ReturnType<typeof queueDetail> {\n  const db = openRaw(filePath);\n  try {\n    return queueDetail(db);\n  } finally {\n    db.close();\n  }\n}\n\ndescribe(\"TC-1.3 / AC-1.3 (architecture risk): queued and claimed work survives SIGKILL mid-drain\", () => {\n  it(\"kills the drain between item 2's claim and complete; a later drain reclaims and finishes with nothing lost or duplicated\", async () => {\n    const threadPath = await newThreadFile(\"kill\");\n    const seeded = await intakeStream.messageEvents({ filePath: threadPath }, [\n      validEvent(\"user_prompt\"),\n      validEvent(\"tool_call\"),\n      validEvent(\"tool_result\"),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(seeded.ok).toBe(true);\n    // 4 items since Epic 02 Story 2: tool_call queues its summary\n    // (sanctioned amendment — was 3).\n    expect(rawLiveCount(threadPath)).toBe(4);\n\n    // Runner: item 1 completes normally; from item 2 on, the handler holds —\n    // so the HANDLER_START 2 marker means item 1's complete landed and item\n    // 2 sits claimed inside the reclaim window.\n    const runner = spawnRunner({ threadPath, leaseMs: 250, holdMs: 8000, holdFrom: 2 });\n    await runner.waitForLine(\"HANDLER_START 2\");\n\n    // Pre-kill read of item 1's landed artifact — the byte-compare baseline.\n    const preKill = readDerivedForms(threadPath).find(\n      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n    );\n    expect(preKill?.state).toBe(\"ready\");\n\n    runner.child.kill(\"SIGKILL\");\n    const exit = await runner.waitForExit();\n    expect(exit.signal).toBe(\"SIGKILL\");\n\n    // The kill landed in the reclaim window: item 2 is still claimed in the\n    // record, item 3 untouched, and no artifact beyond item 1's is visible\n    // as ready (NFR: a killed drain leaves no partial artifact).\n    const afterKill = rawDetail(threadPath);\n    expect(afterKill.map((row) => [row.workItemId, row.status])).toEqual([\n      [\"w-m2-tool_call_summary-v1\", \"claimed\"],\n      [\"w-m3-tool_result_summary-v1\", \"queued\"],\n      [\"w-t1-turn_derivation-v1\", \"queued\"],\n    ]);\n    const readyAfterKill = readDerivedForms(threadPath).filter((f) => f.state === \"ready\");\n    expect(readyAfterKill.map((f) => `${f.subjectId}/${f.form}`)).toEqual([\"m1/smoothed_prompt\"]);\n\n    // Let the orphaned lease expire, then drain from a fresh process-side\n    // handle: the expired claim is reclaimed with attempts incremented — the\n    // crash made visible in the report.\n    await sleep(450);\n    const double = createProviderDouble();\n    const sdk = createSdk({\n      provider: double,\n      mode: \"manual\",\n      lease: { durationMs: 250 },\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    });\n    registerTestWorkHandlers(sdk, double);\n    const drained = await sdk.work.drain({ filePath: threadPath });\n    expect(drained.ok).toBe(true);\n    if (!drained.ok) return;\n    expect(drained.value.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n      [\"w-m2-tool_call_summary-v1\", \"done\"],\n      [\"w-m3-tool_result_summary-v1\", \"done\"],\n      [\"w-t1-turn_derivation-v1\", \"done\"],\n    ]);\n    expect(drained.value.ran[0]?.attempts).toBe(1); // the reclaim, counted\n\n    // Item 1's artifact is byte-unchanged against the pre-kill read; every\n    // unfinished item ran exactly once; no duplicate rows anywhere.\n    const finalForms = readDerivedForms(threadPath);\n    const postKill = finalForms.find(\n      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n    );\n    expect(postKill).toEqual(preKill);\n    expect(finalForms).toHaveLength(5);\n    expect(finalForms.every((form) => form.state === \"ready\")).toBe(true);\n    expect(rawLiveCount(threadPath)).toBe(0);\n  }, 30000);\n});\n\ndescribe(\"TC-1.4 / AC-1.4 (architecture risk): two drains cannot interleave — the lease is the only coordination\", () => {\n  it(\"a second process's drain against a live claim reports in_flight, runs nothing, and never skips ahead\", async () => {\n    const threadPath = await newThreadFile(\"hold\");\n    const seeded = await intakeStream.messageEvents({ filePath: threadPath }, [\n      validEvent(\"user_prompt\"),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(seeded.ok).toBe(true);\n    expect(rawLiveCount(threadPath)).toBe(2);\n\n    // Process A claims the head under a 10s lease and holds mid-handler.\n    const runner = spawnRunner({ threadPath, leaseMs: 10000, holdMs: 2500, holdFrom: 1 });\n    await runner.waitForLine(\"HANDLER_START 1\");\n\n    // Process B: the real spawned CLI, against A's live claim.\n    const second = runBinary([\"work\", \"drain\", \"--file-path\", threadPath], {\n      LHC_PROVIDER: \"deterministic\",\n    });\n    expect(second.status).toBe(0);\n    const parsed = JSON.parse(second.stdout) as OpResult<DrainReport>;\n    expect(parsed.ok).toBe(true);\n    if (!parsed.ok) return;\n    expect(parsed.value.stoppedBecause).toBe(\"in_flight\");\n    expect(parsed.value.ran).toEqual([]);\n    expect(parsed.value.remaining).toBe(2);\n\n    // The skip-ahead proof: the queued item behind the live head was not\n    // claimed by B — exclusion without this is half the test.\n    const detail = rawDetail(threadPath);\n    expect(detail[1]).toMatchObject({\n      workItemId: \"w-t1-turn_derivation-v1\",\n      status: \"queued\",\n      attempts: 0,\n    });\n    expect(detail[1]?.claimedAt).toBeUndefined();\n\n    // A finishes its drain normally.\n    const exit = await runner.waitForExit();\n    expect(exit.code).toBe(0);\n    expect(runner.stdout()).toContain(\"DRAIN_DONE\");\n    expect(rawLiveCount(threadPath)).toBe(0);\n    expect(readDerivedForms(threadPath).every((form) => form.state === \"ready\")).toBe(true);\n  }, 30000);\n});\n\ndescribe(\"CLI parity: lhc work drain through the spawned binary (DD-11 provider resolution)\", () => {\n  it(\"report JSON matches the SDK shape on twin threads; exits 0 with work\", async () => {\n    const batch = [validEvent(\"user_prompt\"), validEvent(\"turn_end\")];\n    const cliThread = await newThreadFile(\"cli-twin\");\n    const sdkThread = await newThreadFile(\"sdk-twin\");\n    for (const filePath of [cliThread, sdkThread]) {\n      const seeded = await intakeStream.messageEvents(\n        { filePath },\n        batch.map((event, index) => ({ ...event, idempotencyKey: `twin-${index}` })),\n      );\n      expect(seeded.ok).toBe(true);\n    }\n\n    const viaCli = runBinary([\"work\", \"drain\", \"--file-path\", cliThread], {\n      LHC_PROVIDER: \"deterministic\",\n    });\n    expect(viaCli.status).toBe(0);\n    const cliReport = JSON.parse(viaCli.stdout) as OpResult<DrainReport>;\n    expect(cliReport.ok).toBe(true);\n\n    // The SDK twin drains through the same production assembly the CLI uses:\n    // registry provider, manual mode, the production domain handler tables\n    // (messages registered in Story 2) — so the two reports must be\n    // identical, shape and content.\n    const provider = resolveNamedProvider(\"deterministic\");\n    if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n    const sdk = createSdk({ provider, mode: \"manual\" });\n    const viaSdk = await sdk.work.drain({ filePath: sdkThread });\n    expect(viaSdk.ok).toBe(true);\n    if (!cliReport.ok || !viaSdk.ok) return;\n    expect(cliReport.value).toEqual(viaSdk.value);\n  });\n\n  it(\"exits 0 on an empty queue and 1 on a missing thread\", async () => {\n    const emptyThread = await newThreadFile(\"empty\");\n    const empty = runBinary([\"work\", \"drain\", \"--file-path\", emptyThread], {\n      LHC_PROVIDER: \"deterministic\",\n    });\n    expect(empty.status).toBe(0);\n    const emptyReport = JSON.parse(empty.stdout) as OpResult<DrainReport>;\n    expect(emptyReport.ok).toBe(true);\n    if (!emptyReport.ok) return;\n    expect(emptyReport.value).toEqual({ ran: [], stoppedBecause: \"empty\", remaining: 0 });\n\n    const missing = runBinary(\n      [\"work\", \"drain\", \"--file-path\", path.join(dir, \"nope.sqlite\")],\n      { LHC_PROVIDER: \"deterministic\" },\n    );\n    expect(missing.status).toBe(1);\n    const missingResult = JSON.parse(missing.stdout) as { ok: boolean; error: { code: string } };\n    expect(missingResult.ok).toBe(false);\n    expect(missingResult.error.code).toBe(\"thread_not_found\");\n  });\n\n  it(\"refuses to drain without a resolvable provider, naming the flag and env var (DD-11)\", async () => {\n    const threadPath = await newThreadFile(\"no-provider\");\n    const result = runBinary([\"work\", \"drain\", \"--file-path\", threadPath], {\n      LHC_PROVIDER: undefined,\n    });\n    expect(result.status).toBe(1);\n    const parsed = JSON.parse(result.stdout) as {\n      ok: boolean;\n      error: { code: string; reason: string };\n    };\n    expect(parsed.ok).toBe(false);\n    expect(parsed.error.code).toBe(\"provider_not_configured\");\n    expect(parsed.error.reason).toContain(\"--provider\");\n    expect(parsed.error.reason).toContain(\"LHC_PROVIDER\");\n\n    const unknown = runBinary(\n      [\"work\", \"drain\", \"--file-path\", threadPath, \"--provider\", \"no-such-provider\"],\n      {},\n    );\n    expect(unknown.status).toBe(1);\n    const unknownParsed = JSON.parse(unknown.stdout) as { ok: boolean; error: { code: string } };\n    expect(unknownParsed.error.code).toBe(\"provider_not_configured\");\n  });\n});\n","numLines":345,"startLine":1,"totalLines":345}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ESHjipkbsXAKR4GkgLFLkP","type":"tool_result","content":"1\texport type ErrorClass = \"caller_error\" | \"state_corruption\" | \"system_error\";\n2\t\n3\texport type ErrorCode =\n4\t  | \"path_exists\"\n5\t  | \"thread_not_found\"\n6\t  | \"invalid_thread_ref\" // empty/blank file path or otherwise unusable reference\n7\t  | \"invalid_event\"\n8\t  | \"empty_batch\"\n9\t  | \"empty_stdin\" // CLI adapter only, emitted before any SDK call\n10\t  | \"turn_state_corrupt\"\n11\t  | \"storage_failure\"\n12\t  // Epic 02 (tech design §Interfaces, issue 4):\n13\t  | \"turn_open\" // caller_error — mutation against an open turn\n14\t  | \"message_initiates_turn\" // caller_error — delete refused toward turns.delete\n15\t  | \"message_not_found\" // caller_error\n16\t  | \"turn_not_found\" // caller_error\n17\t  | \"unknown_work_kind\" // state_corruption — unregistered kind at dispatch\n18\t  | \"provider_not_configured\" // caller_error — CLI drain without --provider / LHC_PROVIDER (DD-11)\n19\t  | \"provider_failure\" // system_error — exhausted retries; form.reason carries detail\n20\t  | \"source_damaged\" // state_corruption — handler found corrupt source; form blocked\n21\t  // Epic 03 (tech design §Interface Definitions): the surface-skeleton stub\n22\t  // contract — machine-readable, never a throw on the thread-view surface.\n23\t  | \"not_implemented\" // system_error — operation's story has not landed yet\n24\t  // Epic 03 Story 2 (AC-2.2/2.3): compact-time config rejection — unlike SDK\n25\t  // construction (programmer error, throws), a bad compact invocation is an\n26\t  // operational caller error returned as a result.\n27\t  | \"unknown_profile\" // caller_error — named profile not configured\n28\t  | \"invalid_view_config\"; // caller_error — band sum / bound violation, named\n29\t\n30\texport interface ErrorResult {\n31\t  errorClass: ErrorClass;\n32\t  code: ErrorCode;\n33\t  reason: string; // human-readable; machine logic switches on code\n34\t  eventIndex?: number; // present on batch validation failures\n35\t}\n36\t\n37\t// Expected operational failures — caller errors, corruption, environment\n38\t// failures — are always returned as OpResult errors, never thrown.\n39\t// Programmer bugs inside lhc may still throw; callers are not expected\n40\t// to handle throws as contract outcomes.\n41\texport type OpResult<T> =\n42\t  | { ok: true; value: T }\n43\t  | { ok: false; error: ErrorResult };\n44\t\n45\t// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n46\t// caught at the operation boundary and wrapped with the underlying detail.\n47\texport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n48\t  return {\n49\t    ok: false,\n50\t    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n51\t  };\n52\t}\n53\t"}]},"parent_tool_use_id":null,"session_id":"d96b6140-abf0-4148-ae10-52f37fa752e0","uuid":"465ecf45-d632-4a27-9034-aab66bdd39d4","timestamp":"2026-06-11T17:56:56.567Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/errors.ts","content":"export type ErrorClass = \"caller_error\" | \"state_corruption\" | \"system_error\";\n\nexport type ErrorCode =\n  | \"path_exists\"\n  | \"thread_not_found\"\n  | \"invalid_thread_ref\" // empty/blank file path or otherwise unusable reference\n  | \"invalid_event\"\n  | \"empty_batch\"\n  | \"empty_stdin\" // CLI adapter only, emitted before any SDK call\n  | \"turn_state_corrupt\"\n  | \"storage_failure\"\n  // Epic 02 (tech design §Interfaces, issue 4):\n  | \"turn_open\" // caller_error — mutation against an open turn\n  | \"message_initiates_turn\" // caller_error — delete refused toward turns.delete\n  | \"message_not_found\" // caller_error\n  | \"turn_not_found\" // caller_error\n  | \"unknown_work_kind\" // state_corruption — unregistered kind at dispatch\n  | \"provider_not_configured\" // caller_error — CLI drain without --provider / LHC_PROVIDER (DD-11)\n  | \"provider_failure\" // system_error — exhausted retries; form.reason carries detail\n  | \"source_damaged\" // state_corruption — handler found corrupt source; form blocked\n  // Epic 03 (tech design §Interface Definitions): the surface-skeleton stub\n  // contract — machine-readable, never a throw on the thread-view surface.\n  | \"not_implemented\" // system_error — operation's story has not landed yet\n  // Epic 03 Story 2 (AC-2.2/2.3): compact-time config rejection — unlike SDK\n  // construction (programmer error, throws), a bad compact invocation is an\n  // operational caller error returned as a result.\n  | \"unknown_profile\" // caller_error — named profile not configured\n  | \"invalid_view_config\"; // caller_error — band sum / bound violation, named\n\nexport interface ErrorResult {\n  errorClass: ErrorClass;\n  code: ErrorCode;\n  reason: string; // human-readable; machine logic switches on code\n  eventIndex?: number; // present on batch validation failures\n}\n\n// Expected operational failures — caller errors, corruption, environment\n// failures — are always returned as OpResult errors, never thrown.\n// Programmer bugs inside lhc may still throw; callers are not expected\n// to handle throws as contract outcomes.\nexport type OpResult<T> =\n  | { ok: true; value: T }\n  | { ok: false; error: ErrorResult };\n\n// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n// caught at the operation boundary and wrapped with the underlying detail.\nexport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n  };\n}\n","numLines":53,"startLine":1,"totalLines":53}}}

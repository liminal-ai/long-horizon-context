{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015yEAUG2vZ8imTLE2jGwSuy","type":"tool_result","content":"1\t// thread-view surface (Epic 03): pull, status, compact, sweep, materialize.\n2\t// Story 1 landed the hot-path reads (`pull`, `status`): local reads and\n3\t// deterministic string assembly only, no inference, no network, no queue\n4\t// interaction, no writes (AC-1.1, AC-2.8). Story 2 landed `compact`;\n5\t// Story 3 lands `sweep` (standalone and embedded default-on in compact).\n6\t// `materialize` stays a structured-result stub until Story 5. Story 0's\n7\t// substrate (profile resolution, consumed by createSdk) re-exports at the\n8\t// bottom.\n9\timport { existsSync } from \"node:fs\";\n10\timport {\n11\t  resolveInstanceViewConfig,\n12\t  runWithThreadTouchSuppressed,\n13\t  type OperationContext,\n14\t} from \"../../shared/context.js\";\n15\timport type { FormReportEntry } from \"../../shared/derivation.js\";\n16\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n17\timport type {\n18\t  CompactReceipt,\n19\t  PullResult,\n20\t  ResolvedViewConfig,\n21\t  SweepReceipt,\n22\t  ViewCompactParams,\n23\t  ViewMessage,\n24\t  ViewProfile,\n25\t  ViewStatus,\n26\t} from \"../../shared/view.js\";\n27\timport * as messagesDomain from \"../messages/index.js\";\n28\timport * as turnsDomain from \"../turns/index.js\";\n29\timport {\n30\t  openThreadDatabase,\n31\t  resolveThreadRef,\n32\t  type ThreadRef,\n33\t} from \"../threads/index.js\";\n34\timport {\n35\t  executeBoundaryAdvance,\n36\t  readBoundaryPosition,\n37\t  visibilityZoneTokens,\n38\t} from \"./internal/boundary.js\";\n39\timport { profileViolation, resolveViewConfig } from \"./internal/profiles.js\";\n40\timport {\n41\t  assembleBandText,\n42\t  renderBandMessage,\n43\t  renderTailMessage,\n44\t  toolNamesByCallId,\n45\t} from \"./internal/render.js\";\n46\timport { fireViewInjection } from \"./internal/seam.js\";\n47\timport {\n48\t  CanonicalCorruptionError,\n49\t  readSelectionInputs,\n50\t  selectArrangement,\n51\t  type ArrangementEntry,\n52\t} from \"./internal/select.js\";\n53\timport {\n54\t  readReadyToolResultSummaries,\n55\t  readTailMessages,\n56\t  readViewSnapshot,\n57\t  replaceViewSnapshot,\n58\t  tailTokenSum,\n59\t} from \"./internal/snapshot.js\";\n60\timport { runSweep } from \"./internal/sweep.js\";\n61\timport { estimateTokens } from \"../../tech-utils/token-counting/index.js\";\n62\timport type { Band } from \"../../shared/view.js\";\n63\t\n64\t// Config resolution for the operation in hand: the SDK instance's resolved\n65\t// view config rides the per-instance seam (epic-fix-001 pattern, tech design\n66\t// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\n67\t// through the same one resolution path createSdk uses.\n68\tconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\n69\t\n70\tfunction viewConfig(): ResolvedViewConfig {\n71\t  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\n72\t}\n73\t\n74\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n75\t  return {\n76\t    ok: false,\n77\t    error: {\n78\t      errorClass: \"caller_error\",\n79\t      code: \"thread_not_found\",\n80\t      reason: `no thread file exists at ${filePath}`,\n81\t    },\n82\t  };\n83\t}\n84\t\n85\tfunction detail(cause: unknown): string {\n86\t  return cause instanceof Error ? cause.message : String(cause);\n87\t}\n88\t\n89\t// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\n90\t\n91\t// The hot-path read: view header + bands (if any), tail messages after the\n92\t// compact point (deleted-filtered, record order), boundary position; then\n93\t// format — band messages first, tail per the mapping table, tool results\n94\t// at-or-behind the boundary in short form. No view row ⇒ the whole record is\n95\t// tail from event 1 (AC-1.3) through this same code path with the compact\n96\t// point at its zero origin — snapshot-absent, never a separate branch.\n97\t//\n98\t// Reads-only is structural, not disciplined: the whole operation runs in the\n99\t// touch-suppressed scope, so the open announcement that would let a\n100\t// background SDK's scheduler hang a first-touch catch-up drain off this read\n101\t// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\n102\t// AC-1.1's no-queue-interaction holds in both host modes.\n103\texport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\n104\t  return runWithThreadTouchSuppressed(() => pullInner(ref));\n105\t}\n106\t\n107\tasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n108\t  const resolved = await resolveThreadRef(ref);\n109\t  if (!resolved.ok) return resolved;\n110\t  const { filePath } = resolved.value;\n111\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n112\t\n113\t  const opened = openThreadDatabase(filePath);\n114\t  if (!opened.ok) return opened;\n115\t  const db = opened.value;\n116\t  try {\n117\t    const snapshot = readViewSnapshot(db);\n118\t    const compactPoint = snapshot?.compactPoint ?? 0;\n119\t    const boundaryPosition = readBoundaryPosition(db);\n120\t    const tailRows = readTailMessages(db, compactPoint);\n121\t    const renderCtx = {\n122\t      boundaryPosition,\n123\t      toolNameByCallId: toolNamesByCallId(tailRows),\n124\t      toolResultSummaries: readReadyToolResultSummaries(db),\n125\t    };\n126\t\n127\t    const messages: ViewMessage[] = [];\n128\t    if (snapshot !== null) {\n129\t      for (const band of snapshot.bands) {\n130\t        messages.push(renderBandMessage(band.band, band.renderedText));\n131\t      }\n132\t    }\n133\t    for (const row of tailRows) {\n134\t      messages.push(renderTailMessage(row, renderCtx));\n135\t    }\n136\t\n137\t    return {\n138\t      ok: true,\n139\t      value: {\n140\t        messages,\n141\t        meta: {\n142\t          compactPoint: snapshot?.compactPoint ?? null,\n143\t          coveredFrom: snapshot?.coveredFrom ?? null,\n144\t          boundaryPosition,\n145\t          gapCount: snapshot?.gapCount ?? 0,\n146\t          degradedCount: snapshot?.degradedCount ?? 0,\n147\t          viewId: snapshot?.viewId ?? null,\n148\t          createdAt: snapshot?.createdAt ?? null,\n149\t        },\n150\t      },\n151\t    };\n152\t  } catch (cause) {\n153\t    return storageFailure(`view pull failed: ${detail(cause)}`);\n154\t  } finally {\n155\t    db.close();\n156\t  }\n157\t}\n158\t\n159\t// ── status (AC-2.8) ───────────────────────────────────────────────\n160\t\n161\t// Derivation counts bucket from one report entry the way the report's own\n162\t// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\n163\t// pending, retrying (pending with attempts spent), failed, blocked. Ready\n164\t// forms are healthy and not an operational situation.\n165\tfunction bucketDerivation(\n166\t  entries: readonly FormReportEntry[],\n167\t  counts: ViewStatus[\"derivation\"],\n168\t): void {\n169\t  for (const entry of entries) {\n170\t    switch (entry.state) {\n171\t      case \"pending\":\n172\t        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\n173\t        else counts.pending += 1;\n174\t        break;\n175\t      case \"failed\":\n176\t        counts.failed += 1;\n177\t        break;\n178\t      case \"blocked\":\n179\t        counts.blocked += 1;\n180\t        break;\n181\t      case \"ready\":\n182\t        break;\n183\t    }\n184\t  }\n185\t}\n186\t\n187\t// Reads only, callable any time, no side effects: tail size against the\n188\t// configured trigger threshold with a compact recommendation (`tailTokens >\n189\t// threshold`, nothing smarter — the caller owns policy), derivation counts\n190\t// by state read through the OWNERS' report surfaces (must-not-own: never a\n191\t// direct derived_form read here), the active view's health or null\n192\t// pre-compact, and the visibility zone's sum against its max — computed live\n193\t// by the same query the Story 4 advance will use, so \"visible in status\" is\n194\t// structural, not stored.\n195\t//\n196\t// Like pull, the whole read — including the owners' report surfaces it\n197\t// consumes — runs in the touch-suppressed scope, so a background SDK's\n198\t// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n199\t// host modes).\n200\texport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n201\t  return runWithThreadTouchSuppressed(() => statusInner(ref));\n202\t}\n203\t\n204\tasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n205\t  const resolved = await resolveThreadRef(ref);\n206\t  if (!resolved.ok) return resolved;\n207\t  const { filePath } = resolved.value;\n208\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n209\t\n210\t  const config = viewConfig();\n211\t  const opened = openThreadDatabase(filePath);\n212\t  if (!opened.ok) return opened;\n213\t  const db = opened.value;\n214\t  let tailTokens: number;\n215\t  let zoneTokens: number;\n216\t  let view: ViewStatus[\"view\"];\n217\t  try {\n218\t    const snapshot = readViewSnapshot(db);\n219\t    const compactPoint = snapshot?.compactPoint ?? 0;\n220\t    const boundaryPosition = readBoundaryPosition(db);\n221\t    tailTokens = tailTokenSum(db, compactPoint);\n222\t    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n223\t    view =\n224\t      snapshot === null\n225\t        ? null\n226\t        : {\n227\t            degraded: snapshot.degradedCount,\n228\t            gaps: snapshot.gapCount,\n229\t            builtAt: snapshot.createdAt,\n230\t          };\n231\t  } catch (cause) {\n232\t    return storageFailure(`view status failed: ${detail(cause)}`);\n233\t  } finally {\n234\t    db.close();\n235\t  }\n236\t\n237\t  // The owners' report surfaces open their own handles; ours is closed first\n238\t  // so the status read never holds two handles on one thread file.\n239\t  const messageReport = await messagesDomain.report({ filePath });\n240\t  if (!messageReport.ok) return messageReport;\n241\t  const turnReport = await turnsDomain.report({ filePath });\n242\t  if (!turnReport.ok) return turnReport;\n243\t  const derivation: ViewStatus[\"derivation\"] = {\n244\t    pending: 0,\n245\t    retrying: 0,\n246\t    failed: 0,\n247\t    blocked: 0,\n248\t  };\n249\t  bucketDerivation(messageReport.value, derivation);\n250\t  bucketDerivation(turnReport.value, derivation);\n251\t\n252\t  return {\n253\t    ok: true,\n254\t    value: {\n255\t      tailTokens,\n256\t      threshold: config.compactThreshold,\n257\t      compactRecommended: tailTokens > config.compactThreshold,\n258\t      derivation,\n259\t      view,\n260\t      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\n261\t    },\n262\t  };\n263\t}\n264\t\n265\t// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\n266\t\n267\t// The default base when no profile is named: the first built-in, matching\n268\t// the epic's primary user (the PI continuation harness). Explicit params\n269\t// override the base field-wise (AC-2.2).\n270\tconst DEFAULT_PROFILE_NAME = \"continuation\";\n271\t\n272\tfunction callerError(\n273\t  code: \"unknown_profile\" | \"invalid_view_config\",\n274\t  reason: string,\n275\t): { ok: false; error: ErrorResult } {\n276\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n277\t}\n278\t\n279\tconst BAND_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n280\t\n281\t// Compact runs only when invoked through this surface (AC-2.1: no code path\n282\t// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\n283\t// rejection provably touches nothing) → sweep, on by default, `sweep: false`\n284\t// skips (AC-3.6; the receipt records which) → read record + forms with the\n285\t// corruption check in the reads (pre-transaction, prior view trivially\n286\t// intact on refusal) → selection walk → band rendering → one BEGIN\n287\t// IMMEDIATE replacing the view and resetting the boundary → receipt.\n288\t// Assembly is entirely from stored artifacts: nothing here can reach a\n289\t// provider (AC-2.4 zero-inference is structural — the sweep step repairs\n290\t// through owners' requeue surfaces and calls no provider either).\n291\texport async function compact(\n292\t  ref: ThreadRef,\n293\t  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n294\t): Promise<OpResult<CompactReceipt>> {\n295\t  const resolved = await resolveThreadRef(ref);\n296\t  if (!resolved.ok) return resolved;\n297\t  const { filePath } = resolved.value;\n298\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n299\t\n300\t  const config = viewConfig();\n301\t  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\n302\t  const base = config.profiles[baseName];\n303\t  if (base === undefined) {\n304\t    return callerError(\n305\t      \"unknown_profile\",\n306\t      `unknown profile \"${baseName}\"; configured profiles are ${Object.keys(config.profiles)\n307\t        .map((name) => `\"${name}\"`)\n308\t        .join(\", \")}`,\n309\t    );\n310\t  }\n311\t  const merged: ViewProfile = {\n312\t    name: base.name,\n313\t    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\n314\t    percentages: { ...base.percentages, ...opts.params?.percentages },\n315\t  };\n316\t  const violation = profileViolation(merged);\n317\t  if (violation !== null) return callerError(\"invalid_view_config\", violation);\n318\t  // Receipt provenance: \"null when explicit params\" (tech design §Storage) —\n319\t  // any param override means the config is no longer a named profile's mix,\n320\t  // even when one served as the merge base; the receipt's config carries the\n321\t  // resolved truth. A bare or profile-only call names its profile.\n322\t  const profileName = opts.params === undefined ? baseName : null;\n323\t\n324\t  // The sweep step (Flow 2 / Flow 3, AC-3.6): on by default so every compact\n325\t  // leaves the thread healthier than it found it; `sweep: false` skips with\n326\t  // the skip recorded in the receipt. Runs before this operation opens its\n327\t  // own handle (the owners' surfaces open theirs), and before any view\n328\t  // write — a sweep failure aborts the compact with the prior view intact.\n329\t  let sweepOutcome: SweepReceipt | { skipped: true };\n330\t  if (opts.sweep === false) {\n331\t    sweepOutcome = { skipped: true };\n332\t  } else {\n333\t    const swept = await runSweep(filePath);\n334\t    if (!swept.ok) return swept;\n335\t    sweepOutcome = swept.value;\n336\t  }\n337\t\n338\t  const opened = openThreadDatabase(filePath);\n339\t  if (!opened.ok) return opened;\n340\t  const db = opened.value;\n341\t  try {\n342\t    let inputs;\n343\t    try {\n344\t      inputs = readSelectionInputs(db);\n345\t    } catch (cause) {\n346\t      if (cause instanceof CanonicalCorruptionError) {\n347\t        // Pre-transaction refusal: nothing was written, the prior view and\n348\t        // the record are untouched (AC-2.5).\n349\t        return {\n350\t          ok: false,\n351\t          error: { errorClass: \"state_corruption\", code: cause.code, reason: cause.message },\n352\t        };\n353\t      }\n354\t      throw cause;\n355\t    }\n356\t    const selection = selectArrangement(inputs, {\n357\t      lowerBound: merged.lowerBound,\n358\t      percentages: merged.percentages,\n359\t    });\n360\t\n361\t    const entriesByBand = (band: Band): ArrangementEntry[] =>\n362\t      selection.entries.filter((entry) => entry.band === band);\n363\t    const bands = BAND_ORDER.flatMap((band) => {\n364\t      const entries = entriesByBand(band);\n365\t      if (entries.length === 0) return [];\n366\t      const renderedText = assembleBandText(entries.map((entry) => entry.text));\n367\t      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\n368\t    });\n369\t\n370\t    const createdAt = new Date().toISOString();\n371\t    // view_id is v<compact event order> — deterministic, and deliberately\n372\t    // reused by an intake-free recompact (tech design L395: do not \"fix\"\n373\t    // into a uniqueness scheme; the singleton row is replaced whole).\n374\t    const viewId = `v${inputs.maxEventOrder}`;\n375\t\n376\t    // Story-0 injection point: TC-2.4's crash between the sweep and the\n377\t    // view-write transaction. An installed hook's throw aborts here —\n378\t    // before BEGIN — so the previous view keeps serving.\n379\t    fireViewInjection(\"compact-write\");\n380\t\n381\t    replaceViewSnapshot(db, {\n382\t      viewId,\n383\t      createdAt,\n384\t      compactPoint: selection.compactPoint,\n385\t      coveredFrom: selection.coveredFrom,\n386\t      profileName,\n387\t      configJson: JSON.stringify({\n388\t        lowerBound: merged.lowerBound,\n389\t        percentages: merged.percentages,\n390\t      }),\n391\t      arrangementJson: JSON.stringify(\n392\t        selection.entries.map((entry) => ({\n393\t          band: entry.band,\n394\t          subjectKind: entry.subjectKind,\n395\t          subjectId: entry.subjectId,\n396\t          formUsed: entry.formUsed,\n397\t          degraded: entry.degraded,\n398\t        })),\n399\t      ),\n400\t      gapsJson: JSON.stringify(\n401\t        selection.entries\n402\t          .filter((entry) => entry.gap)\n403\t          .map((entry) => ({\n404\t            band: entry.band,\n405\t            subjectId: entry.subjectId,\n406\t            reason: entry.reason ?? \"unknown\",\n407\t          })),\n408\t      ),\n409\t      sourceStateJson: JSON.stringify({\n410\t        maxEventOrder: inputs.maxEventOrder,\n411\t        formCounts: inputs.formCounts,\n412\t      }),\n413\t      bands,\n414\t    });\n415\t\n416\t    const bandReport = {} as CompactReceipt[\"bands\"];\n417\t    for (const band of BAND_ORDER) {\n418\t      const stored = bands.find((row) => row.band === band);\n419\t      bandReport[band] = {\n420\t        entries: entriesByBand(band).length,\n421\t        tokens: stored?.tokenCount ?? 0,\n422\t      };\n423\t    }\n424\t    const tailTokens = tailTokenSum(db, selection.compactPoint);\n425\t    return {\n426\t      ok: true,\n427\t      value: {\n428\t        viewId,\n429\t        profile: profileName,\n430\t        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n431\t        bands: bandReport,\n432\t        tailTokens,\n433\t        // Actual assembled total vs the bound (target, not cap — AC-2.4).\n434\t        totalTokens:\n435\t          bandReport.brief.tokens +\n436\t          bandReport.detailed.tokens +\n437\t          bandReport.smooth.tokens +\n438\t          tailTokens,\n439\t        coveredFrom: selection.coveredFrom,\n440\t        compactPoint: selection.compactPoint,\n441\t        degraded: selection.entries\n442\t          .filter((entry) => entry.degraded)\n443\t          .map((entry) => ({\n444\t            band: entry.band,\n445\t            subjectId: entry.subjectId,\n446\t            usedForm: entry.formUsed,\n447\t          })),\n448\t        gaps: selection.entries\n449\t          .filter((entry) => entry.gap)\n450\t          .map((entry) => ({\n451\t            band: entry.band,\n452\t            subjectId: entry.subjectId,\n453\t            reason: entry.reason ?? \"unknown\",\n454\t          })),\n455\t        sweep: sweepOutcome,\n456\t      },\n457\t    };\n458\t  } catch (cause) {\n459\t    return storageFailure(`view compact failed: ${detail(cause)}`);\n460\t  } finally {\n461\t    db.close();\n462\t  }\n463\t}\n464\t\n465\t// ── sweep (Flow 3: AC-3.1–3.5, 3.7) ──────────────────────────────\n466\t\n467\t// The standalone readiness sweep: walk the owners' reports, requeue the\n468\t// transiently-failed forms through the owners' requeue surfaces, return the\n469\t// per-owner/kind receipt. The walk itself lives in internal/sweep.ts; the\n470\t// compact embeds the same walk (AC-3.6), so standalone and embedded receipts\n471\t// share one shape by construction (AC-3.7's SDK leg; the CLI leg rides\n472\t// Story 5's process suite). Returns without waiting on any queued work\n473\t// (AC-3.2): requeues are row writes; background mode's drain heals later.\n474\texport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\n475\t  const resolved = await resolveThreadRef(ref);\n476\t  if (!resolved.ok) return resolved;\n477\t  const { filePath } = resolved.value;\n478\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n479\t  try {\n480\t    return await runSweep(filePath);\n481\t  } catch (cause) {\n482\t    return storageFailure(`view sweep failed: ${detail(cause)}`);\n483\t  }\n484\t}\n485\t\n486\t// ── boundary advance (Flow 4: AC-4.3–4.6, 4.9) ───────────────────\n487\t\n488\t// The post-commit advance, Story 4. NOT a host operation: no public advance\n489\t// surface exists (story Anti-Shim Requirements) — the SDK's ThreadViewSurface\n490\t// carries only the five operations, and this function's one production caller\n491\t// is intake-stream's ctx.onCommit registration (the sanctioned\n492\t// intake→thread-view surface import, tech design §Module Boundaries). It\n493\t// runs at flush in BOTH host modes — unlike the queue poke it is cheap and\n494\t// deterministic, and a CLI intake must advance too or CLI-driven threads\n495\t// bloat. Budgets resolve through the per-instance seam exactly as the poke\n496\t// does (the flush runs synchronously inside the SDK operation's seam scope),\n497\t// falling back to the built-in defaults for direct domain calls.\n498\t//\n499\t// Synchronous and throw-permitted by contract: the registering site wraps it\n500\t// (catch + diagnose) so a failure never reaches intake's caller and never\n501\t// eats the queue poke; the boundary is then simply unchanged and the\n502\t// over-budget condition stays visible because status computes the same zone\n503\t// sum live (AC-4.9).\n504\texport function runPostCommitBoundaryAdvance(ctx: OperationContext): void {\n505\t  // Story-0 injection point (TC-4.6): fired before the advance computes; an\n506\t  // installed hook's throw stands in for an advance failure.\n507\t  fireViewInjection(\"post-commit-advance\");\n508\t  executeBoundaryAdvance(ctx.db, viewConfig().visibility, ctx.clock);\n509\t}\n510\t\n511\t// ── stub (Story 5) ───────────────────────────────────────────────\n512\t\n513\t// The skeleton's stub contract (tech design §Interface Definitions):\n514\t// structured result, machine-readable, never a throw on this surface.\n515\tfunction notImplemented(op: string): { ok: false; error: ErrorResult } {\n516\t  return {\n517\t    ok: false,\n518\t    error: {\n519\t      errorClass: \"system_error\",\n520\t      code: \"not_implemented\",\n521\t      reason: `not implemented: ${op}`,\n522\t    },\n523\t  };\n524\t}\n525\t\n526\texport async function materialize(\n527\t  ref: ThreadRef,\n528\t  opts: { path: string; format?: \"pi-session\" },\n529\t): Promise<OpResult<{ writtenPath: string }>> {\n530\t  void ref;\n531\t  void opts;\n532\t  return notImplemented(\"materialize\");\n533\t}\n534\t\n535\t// ── Story 0 substrate (consumed by createSdk at construction) ─────\n536\texport {\n537\t  BUILT_IN_PROFILES,\n538\t  DEFAULT_COMPACT_THRESHOLD,\n539\t  DEFAULT_VISIBILITY,\n540\t  resolveViewConfig,\n541\t} from \"./internal/profiles.js\";\n542\t"}]},"parent_tool_use_id":null,"session_id":"d96b6140-abf0-4148-ae10-52f37fa752e0","uuid":"29eca64e-81b0-41bb-a04a-bc9b4eee22d7","timestamp":"2026-06-11T17:51:05.679Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/index.ts","content":"// thread-view surface (Epic 03): pull, status, compact, sweep, materialize.\n// Story 1 landed the hot-path reads (`pull`, `status`): local reads and\n// deterministic string assembly only, no inference, no network, no queue\n// interaction, no writes (AC-1.1, AC-2.8). Story 2 landed `compact`;\n// Story 3 lands `sweep` (standalone and embedded default-on in compact).\n// `materialize` stays a structured-result stub until Story 5. Story 0's\n// substrate (profile resolution, consumed by createSdk) re-exports at the\n// bottom.\nimport { existsSync } from \"node:fs\";\nimport {\n  resolveInstanceViewConfig,\n  runWithThreadTouchSuppressed,\n  type OperationContext,\n} from \"../../shared/context.js\";\nimport type { FormReportEntry } from \"../../shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport type {\n  CompactReceipt,\n  PullResult,\n  ResolvedViewConfig,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewMessage,\n  ViewProfile,\n  ViewStatus,\n} from \"../../shared/view.js\";\nimport * as messagesDomain from \"../messages/index.js\";\nimport * as turnsDomain from \"../turns/index.js\";\nimport {\n  openThreadDatabase,\n  resolveThreadRef,\n  type ThreadRef,\n} from \"../threads/index.js\";\nimport {\n  executeBoundaryAdvance,\n  readBoundaryPosition,\n  visibilityZoneTokens,\n} from \"./internal/boundary.js\";\nimport { profileViolation, resolveViewConfig } from \"./internal/profiles.js\";\nimport {\n  assembleBandText,\n  renderBandMessage,\n  renderTailMessage,\n  toolNamesByCallId,\n} from \"./internal/render.js\";\nimport { fireViewInjection } from \"./internal/seam.js\";\nimport {\n  CanonicalCorruptionError,\n  readSelectionInputs,\n  selectArrangement,\n  type ArrangementEntry,\n} from \"./internal/select.js\";\nimport {\n  readReadyToolResultSummaries,\n  readTailMessages,\n  readViewSnapshot,\n  replaceViewSnapshot,\n  tailTokenSum,\n} from \"./internal/snapshot.js\";\nimport { runSweep } from \"./internal/sweep.js\";\nimport { estimateTokens } from \"../../tech-utils/token-counting/index.js\";\nimport type { Band } from \"../../shared/view.js\";\n\n// Config resolution for the operation in hand: the SDK instance's resolved\n// view config rides the per-instance seam (epic-fix-001 pattern, tech design\n// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\n// through the same one resolution path createSdk uses.\nconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\n\nfunction viewConfig(): ResolvedViewConfig {\n  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\n\n// The hot-path read: view header + bands (if any), tail messages after the\n// compact point (deleted-filtered, record order), boundary position; then\n// format — band messages first, tail per the mapping table, tool results\n// at-or-behind the boundary in short form. No view row ⇒ the whole record is\n// tail from event 1 (AC-1.3) through this same code path with the compact\n// point at its zero origin — snapshot-absent, never a separate branch.\n//\n// Reads-only is structural, not disciplined: the whole operation runs in the\n// touch-suppressed scope, so the open announcement that would let a\n// background SDK's scheduler hang a first-touch catch-up drain off this read\n// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\n// AC-1.1's no-queue-interaction holds in both host modes.\nexport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\n  return runWithThreadTouchSuppressed(() => pullInner(ref));\n}\n\nasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const snapshot = readViewSnapshot(db);\n    const compactPoint = snapshot?.compactPoint ?? 0;\n    const boundaryPosition = readBoundaryPosition(db);\n    const tailRows = readTailMessages(db, compactPoint);\n    const renderCtx = {\n      boundaryPosition,\n      toolNameByCallId: toolNamesByCallId(tailRows),\n      toolResultSummaries: readReadyToolResultSummaries(db),\n    };\n\n    const messages: ViewMessage[] = [];\n    if (snapshot !== null) {\n      for (const band of snapshot.bands) {\n        messages.push(renderBandMessage(band.band, band.renderedText));\n      }\n    }\n    for (const row of tailRows) {\n      messages.push(renderTailMessage(row, renderCtx));\n    }\n\n    return {\n      ok: true,\n      value: {\n        messages,\n        meta: {\n          compactPoint: snapshot?.compactPoint ?? null,\n          coveredFrom: snapshot?.coveredFrom ?? null,\n          boundaryPosition,\n          gapCount: snapshot?.gapCount ?? 0,\n          degradedCount: snapshot?.degradedCount ?? 0,\n          viewId: snapshot?.viewId ?? null,\n          createdAt: snapshot?.createdAt ?? null,\n        },\n      },\n    };\n  } catch (cause) {\n    return storageFailure(`view pull failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── status (AC-2.8) ───────────────────────────────────────────────\n\n// Derivation counts bucket from one report entry the way the report's own\n// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\n// pending, retrying (pending with attempts spent), failed, blocked. Ready\n// forms are healthy and not an operational situation.\nfunction bucketDerivation(\n  entries: readonly FormReportEntry[],\n  counts: ViewStatus[\"derivation\"],\n): void {\n  for (const entry of entries) {\n    switch (entry.state) {\n      case \"pending\":\n        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\n        else counts.pending += 1;\n        break;\n      case \"failed\":\n        counts.failed += 1;\n        break;\n      case \"blocked\":\n        counts.blocked += 1;\n        break;\n      case \"ready\":\n        break;\n    }\n  }\n}\n\n// Reads only, callable any time, no side effects: tail size against the\n// configured trigger threshold with a compact recommendation (`tailTokens >\n// threshold`, nothing smarter — the caller owns policy), derivation counts\n// by state read through the OWNERS' report surfaces (must-not-own: never a\n// direct derived_form read here), the active view's health or null\n// pre-compact, and the visibility zone's sum against its max — computed live\n// by the same query the Story 4 advance will use, so \"visible in status\" is\n// structural, not stored.\n//\n// Like pull, the whole read — including the owners' report surfaces it\n// consumes — runs in the touch-suppressed scope, so a background SDK's\n// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n// host modes).\nexport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n  return runWithThreadTouchSuppressed(() => statusInner(ref));\n}\n\nasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const config = viewConfig();\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  let tailTokens: number;\n  let zoneTokens: number;\n  let view: ViewStatus[\"view\"];\n  try {\n    const snapshot = readViewSnapshot(db);\n    const compactPoint = snapshot?.compactPoint ?? 0;\n    const boundaryPosition = readBoundaryPosition(db);\n    tailTokens = tailTokenSum(db, compactPoint);\n    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n    view =\n      snapshot === null\n        ? null\n        : {\n            degraded: snapshot.degradedCount,\n            gaps: snapshot.gapCount,\n            builtAt: snapshot.createdAt,\n          };\n  } catch (cause) {\n    return storageFailure(`view status failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n\n  // The owners' report surfaces open their own handles; ours is closed first\n  // so the status read never holds two handles on one thread file.\n  const messageReport = await messagesDomain.report({ filePath });\n  if (!messageReport.ok) return messageReport;\n  const turnReport = await turnsDomain.report({ filePath });\n  if (!turnReport.ok) return turnReport;\n  const derivation: ViewStatus[\"derivation\"] = {\n    pending: 0,\n    retrying: 0,\n    failed: 0,\n    blocked: 0,\n  };\n  bucketDerivation(messageReport.value, derivation);\n  bucketDerivation(turnReport.value, derivation);\n\n  return {\n    ok: true,\n    value: {\n      tailTokens,\n      threshold: config.compactThreshold,\n      compactRecommended: tailTokens > config.compactThreshold,\n      derivation,\n      view,\n      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\n    },\n  };\n}\n\n// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\n\n// The default base when no profile is named: the first built-in, matching\n// the epic's primary user (the PI continuation harness). Explicit params\n// override the base field-wise (AC-2.2).\nconst DEFAULT_PROFILE_NAME = \"continuation\";\n\nfunction callerError(\n  code: \"unknown_profile\" | \"invalid_view_config\",\n  reason: string,\n): { ok: false; error: ErrorResult } {\n  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n}\n\nconst BAND_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n\n// Compact runs only when invoked through this surface (AC-2.1: no code path\n// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\n// rejection provably touches nothing) → sweep, on by default, `sweep: false`\n// skips (AC-3.6; the receipt records which) → read record + forms with the\n// corruption check in the reads (pre-transaction, prior view trivially\n// intact on refusal) → selection walk → band rendering → one BEGIN\n// IMMEDIATE replacing the view and resetting the boundary → receipt.\n// Assembly is entirely from stored artifacts: nothing here can reach a\n// provider (AC-2.4 zero-inference is structural — the sweep step repairs\n// through owners' requeue surfaces and calls no provider either).\nexport async function compact(\n  ref: ThreadRef,\n  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n): Promise<OpResult<CompactReceipt>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const config = viewConfig();\n  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\n  const base = config.profiles[baseName];\n  if (base === undefined) {\n    return callerError(\n      \"unknown_profile\",\n      `unknown profile \"${baseName}\"; configured profiles are ${Object.keys(config.profiles)\n        .map((name) => `\"${name}\"`)\n        .join(\", \")}`,\n    );\n  }\n  const merged: ViewProfile = {\n    name: base.name,\n    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\n    percentages: { ...base.percentages, ...opts.params?.percentages },\n  };\n  const violation = profileViolation(merged);\n  if (violation !== null) return callerError(\"invalid_view_config\", violation);\n  // Receipt provenance: \"null when explicit params\" (tech design §Storage) —\n  // any param override means the config is no longer a named profile's mix,\n  // even when one served as the merge base; the receipt's config carries the\n  // resolved truth. A bare or profile-only call names its profile.\n  const profileName = opts.params === undefined ? baseName : null;\n\n  // The sweep step (Flow 2 / Flow 3, AC-3.6): on by default so every compact\n  // leaves the thread healthier than it found it; `sweep: false` skips with\n  // the skip recorded in the receipt. Runs before this operation opens its\n  // own handle (the owners' surfaces open theirs), and before any view\n  // write — a sweep failure aborts the compact with the prior view intact.\n  let sweepOutcome: SweepReceipt | { skipped: true };\n  if (opts.sweep === false) {\n    sweepOutcome = { skipped: true };\n  } else {\n    const swept = await runSweep(filePath);\n    if (!swept.ok) return swept;\n    sweepOutcome = swept.value;\n  }\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    let inputs;\n    try {\n      inputs = readSelectionInputs(db);\n    } catch (cause) {\n      if (cause instanceof CanonicalCorruptionError) {\n        // Pre-transaction refusal: nothing was written, the prior view and\n        // the record are untouched (AC-2.5).\n        return {\n          ok: false,\n          error: { errorClass: \"state_corruption\", code: cause.code, reason: cause.message },\n        };\n      }\n      throw cause;\n    }\n    const selection = selectArrangement(inputs, {\n      lowerBound: merged.lowerBound,\n      percentages: merged.percentages,\n    });\n\n    const entriesByBand = (band: Band): ArrangementEntry[] =>\n      selection.entries.filter((entry) => entry.band === band);\n    const bands = BAND_ORDER.flatMap((band) => {\n      const entries = entriesByBand(band);\n      if (entries.length === 0) return [];\n      const renderedText = assembleBandText(entries.map((entry) => entry.text));\n      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\n    });\n\n    const createdAt = new Date().toISOString();\n    // view_id is v<compact event order> — deterministic, and deliberately\n    // reused by an intake-free recompact (tech design L395: do not \"fix\"\n    // into a uniqueness scheme; the singleton row is replaced whole).\n    const viewId = `v${inputs.maxEventOrder}`;\n\n    // Story-0 injection point: TC-2.4's crash between the sweep and the\n    // view-write transaction. An installed hook's throw aborts here —\n    // before BEGIN — so the previous view keeps serving.\n    fireViewInjection(\"compact-write\");\n\n    replaceViewSnapshot(db, {\n      viewId,\n      createdAt,\n      compactPoint: selection.compactPoint,\n      coveredFrom: selection.coveredFrom,\n      profileName,\n      configJson: JSON.stringify({\n        lowerBound: merged.lowerBound,\n        percentages: merged.percentages,\n      }),\n      arrangementJson: JSON.stringify(\n        selection.entries.map((entry) => ({\n          band: entry.band,\n          subjectKind: entry.subjectKind,\n          subjectId: entry.subjectId,\n          formUsed: entry.formUsed,\n          degraded: entry.degraded,\n        })),\n      ),\n      gapsJson: JSON.stringify(\n        selection.entries\n          .filter((entry) => entry.gap)\n          .map((entry) => ({\n            band: entry.band,\n            subjectId: entry.subjectId,\n            reason: entry.reason ?? \"unknown\",\n          })),\n      ),\n      sourceStateJson: JSON.stringify({\n        maxEventOrder: inputs.maxEventOrder,\n        formCounts: inputs.formCounts,\n      }),\n      bands,\n    });\n\n    const bandReport = {} as CompactReceipt[\"bands\"];\n    for (const band of BAND_ORDER) {\n      const stored = bands.find((row) => row.band === band);\n      bandReport[band] = {\n        entries: entriesByBand(band).length,\n        tokens: stored?.tokenCount ?? 0,\n      };\n    }\n    const tailTokens = tailTokenSum(db, selection.compactPoint);\n    return {\n      ok: true,\n      value: {\n        viewId,\n        profile: profileName,\n        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n        bands: bandReport,\n        tailTokens,\n        // Actual assembled total vs the bound (target, not cap — AC-2.4).\n        totalTokens:\n          bandReport.brief.tokens +\n          bandReport.detailed.tokens +\n          bandReport.smooth.tokens +\n          tailTokens,\n        coveredFrom: selection.coveredFrom,\n        compactPoint: selection.compactPoint,\n        degraded: selection.entries\n          .filter((entry) => entry.degraded)\n          .map((entry) => ({\n            band: entry.band,\n            subjectId: entry.subjectId,\n            usedForm: entry.formUsed,\n          })),\n        gaps: selection.entries\n          .filter((entry) => entry.gap)\n          .map((entry) => ({\n            band: entry.band,\n            subjectId: entry.subjectId,\n            reason: entry.reason ?? \"unknown\",\n          })),\n        sweep: sweepOutcome,\n      },\n    };\n  } catch (cause) {\n    return storageFailure(`view compact failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── sweep (Flow 3: AC-3.1–3.5, 3.7) ──────────────────────────────\n\n// The standalone readiness sweep: walk the owners' reports, requeue the\n// transiently-failed forms through the owners' requeue surfaces, return the\n// per-owner/kind receipt. The walk itself lives in internal/sweep.ts; the\n// compact embeds the same walk (AC-3.6), so standalone and embedded receipts\n// share one shape by construction (AC-3.7's SDK leg; the CLI leg rides\n// Story 5's process suite). Returns without waiting on any queued work\n// (AC-3.2): requeues are row writes; background mode's drain heals later.\nexport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n  try {\n    return await runSweep(filePath);\n  } catch (cause) {\n    return storageFailure(`view sweep failed: ${detail(cause)}`);\n  }\n}\n\n// ── boundary advance (Flow 4: AC-4.3–4.6, 4.9) ───────────────────\n\n// The post-commit advance, Story 4. NOT a host operation: no public advance\n// surface exists (story Anti-Shim Requirements) — the SDK's ThreadViewSurface\n// carries only the five operations, and this function's one production caller\n// is intake-stream's ctx.onCommit registration (the sanctioned\n// intake→thread-view surface import, tech design §Module Boundaries). It\n// runs at flush in BOTH host modes — unlike the queue poke it is cheap and\n// deterministic, and a CLI intake must advance too or CLI-driven threads\n// bloat. Budgets resolve through the per-instance seam exactly as the poke\n// does (the flush runs synchronously inside the SDK operation's seam scope),\n// falling back to the built-in defaults for direct domain calls.\n//\n// Synchronous and throw-permitted by contract: the registering site wraps it\n// (catch + diagnose) so a failure never reaches intake's caller and never\n// eats the queue poke; the boundary is then simply unchanged and the\n// over-budget condition stays visible because status computes the same zone\n// sum live (AC-4.9).\nexport function runPostCommitBoundaryAdvance(ctx: OperationContext): void {\n  // Story-0 injection point (TC-4.6): fired before the advance computes; an\n  // installed hook's throw stands in for an advance failure.\n  fireViewInjection(\"post-commit-advance\");\n  executeBoundaryAdvance(ctx.db, viewConfig().visibility, ctx.clock);\n}\n\n// ── stub (Story 5) ───────────────────────────────────────────────\n\n// The skeleton's stub contract (tech design §Interface Definitions):\n// structured result, machine-readable, never a throw on this surface.\nfunction notImplemented(op: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"system_error\",\n      code: \"not_implemented\",\n      reason: `not implemented: ${op}`,\n    },\n  };\n}\n\nexport async function materialize(\n  ref: ThreadRef,\n  opts: { path: string; format?: \"pi-session\" },\n): Promise<OpResult<{ writtenPath: string }>> {\n  void ref;\n  void opts;\n  return notImplemented(\"materialize\");\n}\n\n// ── Story 0 substrate (consumed by createSdk at construction) ─────\nexport {\n  BUILT_IN_PROFILES,\n  DEFAULT_COMPACT_THRESHOLD,\n  DEFAULT_VISIBILITY,\n  resolveViewConfig,\n} from \"./internal/profiles.js\";\n","numLines":542,"startLine":1,"totalLines":542}}}

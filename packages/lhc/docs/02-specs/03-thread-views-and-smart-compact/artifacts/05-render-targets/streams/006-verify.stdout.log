{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'git diff -- packages/lhc/src/cli/view.ts packages/lhc/src/cli/index.ts packages/lhc/test/cli-process-view.test.ts packages/lhc/test/red-manifest.json'","aggregated_output":"diff --git a/packages/lhc/src/cli/index.ts b/packages/lhc/src/cli/index.ts\nindex 1ba4fe3..85688d6 100644\n--- a/packages/lhc/src/cli/index.ts\n+++ b/packages/lhc/src/cli/index.ts\n@@ -16,6 +16,7 @@ import {\n   runTurnsRequeue,\n   runWorkDrain,\n } from \"./work.js\";\n+import { runViewCommand } from \"./view.js\";\n \n // Stdin seam: in-process tests inject a reader; the binary reads the real\n // process stdin. null means interactive (TTY) — distinct from empty input\n@@ -56,9 +57,19 @@ Usage:\n   lhc turns requeue (--thread-id <id> | --file-path <p>) --subject-kind (turn|chunk) --subject-id <id> --form <form> [--registry <r>]\n   lhc turns delete (--thread-id <id> | --file-path <p>) --turn <id> [--registry <r>]\n   lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n+  lhc view pull (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n+  lhc view status (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n+  lhc view compact (--thread-id <id> | --file-path <p>) [--profile <name>]\n+                   [--lower-bound <n>] [--full <n>] [--smooth <n>] [--detailed <n>] [--brief <n>]\n+                   [--no-sweep] [--json] [--registry <r>]\n+  lhc view sweep (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n+  lhc view materialize (--thread-id <id> | --file-path <p>) --out <path> [--format pi-session] [--registry <r>]\n \n Every command prints the SDK result (value or error) as JSON and exits 0 on\n success, 1 on failure. message-events reads an events JSON array on stdin.\n+View commands need no provider; output is always JSON (--json accepted).\n+Two exceptions on success: view pull prints the message array itself, and\n+view materialize prints the written path; their failures stay structured.\n `;\n \n interface ParsedFlags {\n@@ -176,6 +187,12 @@ export async function runCli(\n   }\n \n   const [group, command, ...rest] = argv;\n+  // The view group parses its own flag surface (band overrides, --out,\n+  // --format) — routed before the shared parse so its flags never widen the\n+  // other commands' accepted set.\n+  if (group === \"view\") {\n+    return runViewCommand(command, rest);\n+  }\n   const key = command === undefined ? group : `${group} ${command}`;\n   const parsed = parseFlags(command === undefined ? [] : rest);\n   if (!parsed.ok) {\ndiff --git a/packages/lhc/test/red-manifest.json b/packages/lhc/test/red-manifest.json\nindex 27ed4e3..1c75e35 100644\n--- a/packages/lhc/test/red-manifest.json\n+++ b/packages/lhc/test/red-manifest.json\n@@ -28,7 +28,7 @@\n     \"test/mutations-delete.test.ts\": \"dc2c238f278412796de0ac94e30e60240cc59a5fa05b0062bdfba0d6aded434a\",\n     \"test/cli-process-mutations-delete.test.ts\": \"98898996cdf9eb06cdce0d0c31edce5a7710f92004ef1981cd0b72706fe548e3\",\n     \"test/view-fixture.test.ts\": \"daebd6e969248dc08847945a92bbac159a319351dec1dac291f94641d97329c5\",\n-    \"test/view-pull.test.ts\": \"fe47ec68b99ca44a0adb510b6096fa7dc71c10a8188c81087f3e3029462e31c6\",\n+    \"test/view-pull.test.ts\": \"f32bd662bcc48a130ded37a3f211be22a3a8e298fadd0e651cc73e4895b6e0ea\",\n     \"test/view-compact.test.ts\": \"5d87af4da4957768488f24694c0c52a56fa79fc79f51ccbfdde8f6286153cabf\",\n     \"test/view-select-golden.test.ts\": \"e22f5a9eb662f4f5b69c6cd35f49471cc5e2d91562b5a7c2dc0b7c8a962ca07b\",\n     \"test/goldens/g1-proportions.json\": \"fdf041a02aa15c78407ed34b687c38195da0013a3f8f47f19635488ee2a0bdd9\",\n@@ -36,8 +36,10 @@\n     \"test/goldens/g2-edge-exclusion.json\": \"851d12966180e109525394d059f82c2fbc566ada959240781f236759939686c9\",\n     \"test/goldens/g3-oversized-loner.json\": \"0268d5c71cb4c85abf2841d36edac2b17703cb4c1767083
   const sdkOut = path.join(store.dir, \"sdk-materialized.jsonl\");\n   179\t    // The materialize contract (AC-5.5/TC-5.4): stdout IS the written path,\n   180\t    // no OpResult wrapper.\n   181\t    const run = runBinary([\n   182\t      \"view\", \"materialize\", \"--file-path\", twinCli.filePath, \"--out\", cliOut,\n   183\t    ]);\n   184\t    expect(run.status).toBe(0);\n   185\t    expect(run.stdout.trim()).toBe(cliOut);\n   186\t\n   187\t    const written = readFileSync(cliOut, \"utf8\");\n   188\t    expect(() => assertPiSessionConformance(written)).not.toThrow();\n   189\t\n   190\t    const viaSdk = await reader.threadView.materialize(\n   191\t      { filePath: twinCli.filePath },\n   192\t      { path: sdkOut },\n   193\t    );\n   194\t    expect(viaSdk.ok).toBe(true);\n   195\t    expect(readFileSync(sdkOut, \"utf8\")).toBe(written);\n   196\t  });\n   197\t\n   198\t  it(\"unknown --format exits nonzero naming the accepted values\", () => {\n   199\t    const run = runBinary([\n   200\t      \"view\", \"materialize\",\n   201\t      \"--file-path\", twinCli.filePath,\n   202\t      \"--out\", path.join(store.dir, \"never.jsonl\"),\n   203\t      \"--format\", \"markdown\",\n   204\t    ]);\n   205\t    expect(run.status).toBe(1);\n   300\t      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n   301\t      JSON.stringify(events),\n   302\t    );\n   303\t    expectOk(intake);\n   304\t\n   305\t    // status: the advance ran at flush — the zone dropped to C alone,\n   306\t    // at-or-under target.\n   307\t    const status = expectOk<ViewStatus>(\n   308\t      runBinary([\"view\", \"status\", \"--file-path\", threadPath]),\n   309\t    );\n   310\t    expect(status.visibility.maxTokens).toBe(32000);\n   311\t    expect(status.visibility.zoneTokens).toBe(estimateTokens(contentC));\n   312\t    expect(status.visibility.zoneTokens).toBeLessThanOrEqual(24000);\n   313\t\n   314\t    // pull: A and B render short (at-or-behind
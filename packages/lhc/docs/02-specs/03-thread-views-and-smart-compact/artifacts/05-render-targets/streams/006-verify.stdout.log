string;\n    28\t  registryPath?: string;\n    29\t  json?: boolean;\n    30\t  profile?: string;\n   136\t    return renderCliError(\n   137\t      \"caller_error\",\n   138\t      \"missing_flag\",\n   139\t      `${name} requires --thread-id or --file-path`,\n   140\t    );\n   141\t  }\n   142\t  const ref = threadRefFrom(flags);\n   143\t\n   144\t  switch (command) {\n   145\t    case \"pull\": {\n   146\t      const result = await threadView.pull(ref);\n   147\t      if (!result.ok) return renderResult(result);\n   148\t      // The story contract (AC-5.5/TC-5.4): the message array on stdout,\n   149\t      // not the OpResult wrapper.\n   150\t      return {\n   151\t        exitCode: 0,\n   152\t        stdout: `${JSON.stringify(result.value.messages, null, 2)}\\n`,\n   153\t        stderr: \"\",\n   154\t      };\n   155\t    }\n   156\t    case \"status\":\n   157\t      return renderResult(await threadView.status(ref));\n   158\t    case \"sweep\":\n   159\t      return renderResult(await threadView.sweep(ref));\n   160\t    case \"compact\": {\n   161\t      const opts: Parameters<typeof threadView.compact>[1] = {};\n   162\t      if (flags.profile !== undefined) opts.profile = flags.profile;\n   163\t      if (flags.noSweep === true) opts.sweep = false;\n   164\t      // Band flags override the profile field-wise BEFORE validation\n   165\t      // (AC-2.2): `--full 40` over a 30/30/20/20 profile fails the sum check\n   166\t      // with the named violation — correct behavior, not adapter business.\n   167\t      const params: ViewCompactParams = {};\n   168\t      const percentages: NonNullable<ViewCompactParams[\"percentages\"]> = {};\n   169\t      const numeric: Array<[string | undefined, string, (n: number) => void]> = [\n   170\t        [flags.lowerBound, \"--lower-bound\", (n) => (params.lowerBound = n)],\n   171\t        [flags.full, \"--full\", (n) => (percentages.full = n)],\n   172\t        [flags.smooth, \"--smooth\", (n) => (percentages.smooth = n)],\n   173\t        [flags.detailed, \"--detailed\", (n) => (percentages.detailed = n)],\n   174\t        [flags.brief, \"--brief\", (n) => (percentages.brief = n)],\n   175\t      ];\n   176\t      for (const [raw, flag, assign] of numeric) {\n   177\t        if (raw === undefined) continue;\n   178\t        const value = parseNumericFlag(raw, flag);\n   179\t        if (!value.ok) return value.result;\n   180\t        assign(value.value);\n   181\t      }\n   182\t      if (Object.keys(percentages).length > 0) params.percentages = percentages;\n   183\t      if (Object.keys(params).length > 0) opts.params = params;\n   184\t      return renderResult(await threadView.compact(ref, opts));\n   185\t    }\n   186\t    case \"materialize\": {\n   187\t      if (flags.out === undefined) {\n   188\t        return renderCliError(\n   189\t          \"caller_error\",\n   190\t          \"missing_flag\",\n   191\t          \"view materialize requires --out <path>\",\n   192\t        );\n   193\t      }\n   194\t      const opts: Parameters<typeof threadView.materialize>[1] = { path: flags.out };\n","exit_code":0,"status":"completed"}}

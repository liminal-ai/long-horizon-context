{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"pnpm exec tsx -e '\nimport { createHash } from \\\"node:crypto\\\";\nimport { createSdk } from \\\"./src/index.ts\\\";\nimport { createProviderDouble, tempStore, validEvent, seedViewBoundary, openRaw } from \\\"./test/fixtures/index.ts\\\";\nconst hash = (v:any) => createHash(\\\"sha256\\\").update(JSON.stringify(v)).digest(\\\"hex\\\");\nasync function seedThread(store:any, suffix:string) {\n  const manual = createSdk({ provider: createProviderDouble(), mode: \\\"manual\\\" });\n  const filePath = store.threadPath(suffix);\n  const created = await manual.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (\"'!created.ok) throw new Error(created.error.reason);\n  const batch = await manual.intakeStream.messageEvents({ filePath }, [\n    validEvent(\"user_prompt\", { payload: { text: `queued prompt ${suffix}` } }),\n    validEvent(\"tool_call\", { payload: { toolCallId: `call-${suffix}`, toolName: \"read_file\", arguments: { path: `${suffix}.txt` } } }),\n    validEvent(\"tool_result\", { payload: { toolCallId: `call-${suffix}`, content: `queued result ${suffix}`, isError: false } }),\n    validEvent(\"turn_end\"),\n  ]);\n  if (!batch.ok) throw new Error(batch.error.reason);\n  return filePath;\n}\nfunction workCount(filePath:string) { const db = openRaw(filePath); try { return Number((db.prepare(\"SELECT COUNT(*) AS n FROM work_item\").get() as any).n); } finally { db.close(); } }\n(async () => {\nconst store = tempStore();\ntry {\n  const pullFile = await seedThread(store, \"pull\");\n  const pullProvider = createProviderDouble(); const pullCaptured = pullProvider.captureInputs(); const pullBg = createSdk({ provider: pullProvider, mode: \"background\" });\n  const pullBefore = workCount(pullFile); const pull = await pullBg.threadView.pull({ filePath: pullFile }); if (!pull.ok) throw new Error(pull.error.reason); await new Promise(r=>setTimeout(r,25)); await pullBg.drainSettled({ filePath: pullFile });\n  const pullResult = { before: pullBefore, after: workCount(pullFile), captured: pullCaptured.length };\n  const statusFile = await seedThread(store, \"status\");\n  const statusProvider = createProviderDouble(); const statusCaptured = statusProvider.captureInputs(); const statusBg = createSdk({ provider: statusProvider, mode: \"background\" });\n  const statusBefore = workCount(statusFile); const status = await statusBg.threadView.status({ filePath: statusFile }); if (!status.ok) throw new Error(status.error.reason); await new Promise(r=>setTimeout(r,25)); await statusBg.drainSettled({ filePath: statusFile });\n  const statusResult = { before: statusBefore, after: workCount(statusFile), captured: statusCaptured.length, pending: status.value.derivation.pending };\n  const detFile = await seedThread(store, \"det\"); const db = openRaw(detFile); let order; try { order = Number((db.prepare(\"SELECT source_event_order FROM message WHERE kind = ?\").get(\"tool_result\") as any).source_event_order); } finally { db.close(); } seedViewBoundary(detFile, order);\n  const detProvider = createProviderDouble(); const detCaptured = detProvider.captureInputs(); const detBg = createSdk({ provider: detProvider, mode: \"background\" });\n  const one = await detBg.threadView.pull({ filePath: detFile }); if (!one.ok) throw new Error(one.error.reason); await new Promise(r=>setTimeout(r,25)); await detBg.drainSettled({ filePath: detFile }); const two = await detBg.threadView.pull({ filePath: detFile }); if (!two.ok) throw new Error(two.error.reason);\n  const detResult = { captured: detCaptured.length, equal: JSON.stringify(one.value) === JSON.stringify(two.value), oneHash: hash(one.value), twoHash: hash(two.value), tool: one.value.messages.find(m=>m.content.startsWith(\"[tool result\"))?.content };\n  console.log(JSON.stringify({ pullResult, statusResult, detResult }));\n} finally { store.cleanup(); }\n})();\n'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

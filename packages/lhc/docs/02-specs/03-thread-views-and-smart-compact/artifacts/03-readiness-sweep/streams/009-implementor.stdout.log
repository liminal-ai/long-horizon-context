{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JvkjdSwMP4zXkcRZckC71j","type":"tool_result","content":"1\t// Epic 03 Story 1: pull and status on the record (TC-1.1, TC-1.2, TC-1.4,\n2\t// TC-2.5 pre-compact legs, the per-kind tail-mapping legs, and the pull/status\n3\t// legs of the suite-wide zero-provider assertion). Every TC goes through the\n4\t// real SDK surface (createSdk().threadView.pull/status) against real temp\n5\t// thread files; the provider double appears only in construction/fixture\n6\t// setup — no Epic 03 operation may touch it.\n7\timport { createHash } from \"node:crypto\";\n8\timport { join } from \"node:path\";\n9\timport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\n10\timport { createSdk, type Lhc, type SdkViewConfig, type ViewMessage } from \"../src/index.js\";\n11\timport {\n12\t  blockedSiblingThread,\n13\t  createProviderDouble,\n14\t  derivedThreadFixture,\n15\t  openRaw,\n16\t  seedViewBoundary,\n17\t  tempStore,\n18\t  validEvent,\n19\t  type DerivedThreadFixture,\n20\t  type TempStore,\n21\t} from \"./fixtures/index.js\";\n22\t\n23\tlet store: TempStore;\n24\tlet fixture: DerivedThreadFixture;\n25\t\n26\tbeforeAll(async () => {\n27\t  store = tempStore();\n28\t  fixture = await derivedThreadFixture(store);\n29\t});\n30\tafterAll(() => {\n31\t  store.cleanup();\n32\t});\n33\t\n34\tfunction manualSdk(view?: SdkViewConfig): Lhc {\n35\t  return createSdk({\n36\t    provider: createProviderDouble(),\n37\t    mode: \"manual\",\n38\t    ...(view === undefined ? {} : { view }),\n39\t  });\n40\t}\n41\t\n42\tasync function newThread(sdk: Lhc): Promise<string> {\n43\t  const filePath = store.threadPath();\n44\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n45\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n46\t  return filePath;\n47\t}\n48\t\n49\tasync function intake(sdk: Lhc, filePath: string, batch: Parameters<Lhc[\"intakeStream\"][\"messageEvents\"]>[1]): Promise<void> {\n50\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n51\t  if (!result.ok) throw new Error(`intake failed: ${result.error.reason}`);\n52\t}\n53\t\n54\tfunction sha256(value: unknown): string {\n55\t  return createHash(\"sha256\").update(JSON.stringify(value)).digest(\"hex\");\n56\t}\n57\t\n58\tfunction workItemCount(filePath: string): number {\n59\t  const db = openRaw(filePath);\n60\t  try {\n61\t    const row = db.prepare(`SELECT COUNT(*) AS n FROM work_item`).get() as {\n62\t      n: number | bigint;\n63\t    };\n64\t    return Number(row.n);\n65\t  } finally {\n66\t    db.close();\n67\t  }\n68\t}\n69\t\n70\t// Below-SDK read-only snapshot of everything a read could illegally mutate:\n71\t// queue rows, form states, view rows, boundary position (TC-1.2 / TC-2.5\n72\t// reads-only assertions).\n73\tfunction stateSnapshot(filePath: string): Record<string, unknown> {\n74\t  const db = openRaw(filePath);\n75\t  try {\n76\t    return {\n77\t      workItems: (\n78\t        db\n79\t          .prepare(`SELECT work_item_id, status, attempts FROM work_item ORDER BY work_item_id`)\n80\t          .all() as unknown as Array<{ work_item_id: string; status: string; attempts: number | bigint }>\n81\t      ).map((row) => ({ id: row.work_item_id, status: row.status, attempts: Number(row.attempts) })),\n82\t      forms: db\n83\t        .prepare(`SELECT subject_id, form, state FROM derived_form ORDER BY subject_id, form`)\n84\t        .all(),\n85\t      viewRows: Number(\n86\t        (db.prepare(`SELECT COUNT(*) AS n FROM thread_view`).get() as { n: number | bigint }).n,\n87\t      ),\n88\t      boundary: Number(\n89\t        (db.prepare(`SELECT position FROM view_boundary`).get() as { position: number | bigint })\n90\t          .position,\n91\t      ),\n92\t    };\n93\t  } finally {\n94\t    db.close();\n95\t  }\n96\t}\n97\t\n98\tdescribe(\"surface skeleton: unimplemented ops return structured results\", () => {\n99\t  // Epic 03 Story 2 (sanctioned amendment): compact is real now, so its\n100\t  // not-implemented leg moved out of this test; view-compact.test.ts owns the\n101\t  // operation. sweep and materialize stay stubbed until Stories 3 and 5.\n102\t  it(\"sweep and materialize return ok:false not-implemented, never throw\", async () => {\n103\t    const ref = { filePath: fixture.filePath };\n104\t    const swept = await fixture.sdk.threadView.sweep(ref);\n105\t    expect(swept).toEqual({\n106\t      ok: false,\n107\t      error: { errorClass: \"system_error\", code: \"not_implemented\", reason: \"not implemented: sweep\" },\n108\t    });\n109\t    const materialized = await fixture.sdk.threadView.materialize(ref, {\n110\t      path: join(store.dir, \"out.jsonl\"),\n111\t    });\n112\t    expect(materialized).toEqual({\n113\t      ok: false,\n114\t      error: { errorClass: \"system_error\", code: \"not_implemented\", reason: \"not implemented: materialize\" },\n115\t    });\n116\t  });\n117\t});\n118\t\n119\tdescribe(\"TC-1.1 (AC-1.2, AC-1.3): never-compacted thread pulls the full conversation in order; later intake appends\", () => {\n120\t  it(\"carries both intake rounds in record order with tail-only meta\", async () => {\n121\t    const sdk = manualSdk();\n122\t    const filePath = await newThread(sdk);\n123\t    await intake(sdk, filePath, [\n124\t      validEvent(\"user_prompt\", { payload: { text: \"first question\" } }),\n125\t      validEvent(\"assistant_text\", { payload: { text: \"first answer\" } }),\n126\t      validEvent(\"turn_end\"),\n127\t    ]);\n128\t\n129\t    const first = await sdk.threadView.pull({ filePath });\n130\t    expect(first.ok).toBe(true);\n131\t    if (!first.ok) return;\n132\t    expect(first.value.messages).toEqual([\n133\t      { role: \"user\", content: \"first question\" },\n134\t      { role: \"assistant\", content: \"first answer\" },\n135\t    ]);\n136\t    // Never compacted: no band content, no error, tail from event 1 (AC-1.3).\n137\t    expect(first.value.messages.every((m) => m.band === undefined)).toBe(true);\n138\t    expect(first.value.meta).toEqual({\n139\t      compactPoint: null,\n140\t      coveredFrom: null,\n141\t      boundaryPosition: 0,\n142\t      gapCount: 0,\n143\t      degradedCount: 0,\n144\t      viewId: null,\n145\t      createdAt: null,\n146\t    });\n147\t\n148\t    await intake(sdk, filePath, [\n149\t      validEvent(\"user_prompt\", { payload: { text: \"second question\" } }),\n150\t      validEvent(\"assistant_text\", { payload: { text: \"second answer\" } }),\n151\t      validEvent(\"turn_end\"),\n152\t    ]);\n153\t    const second = await sdk.threadView.pull({ filePath });\n154\t    expect(second.ok).toBe(true);\n155\t    if (!second.ok) return;\n156\t    // All committed intake appears, in record order; the new batch appends\n157\t    // after the first round's messages, which are byte-unchanged (AC-1.2).\n158\t    expect(second.value.messages).toEqual([\n159\t      { role: \"user\", content: \"first question\" },\n160\t      { role: \"assistant\", content: \"first answer\" },\n161\t      { role: \"user\", content: \"second question\" },\n162\t      { role: \"assistant\", content: \"second answer\" },\n163\t    ]);\n164\t  });\n165\t});\n166\t\n167\tdescribe(\"TC-1.2 (AC-1.1, AC-1.7): two pulls with nothing between are byte-identical and create no work or provider calls\", () => {\n168\t  it(\"hashes identical, zero work rows created, provider double observes zero calls\", async () => {\n169\t    // The double's capture log starts recording here; any Epic 03 read that\n170\t    // touched the provider would append to it (zero-provider assertion, pull\n171\t    // leg of the suite-wide architecture-risk row).\n172\t    const captured = fixture.double.captureInputs();\n173\t    const before = stateSnapshot(fixture.filePath);\n174\t    const workRowsBefore = workItemCount(fixture.filePath);\n175\t\n176\t    const one = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n177\t    const two = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n178\t    expect(one.ok && two.ok).toBe(true);\n179\t    if (!one.ok || !two.ok) return;\n180\t\n181\t    // Byte-identical via the FULL serialized result, not field spot-checks\n182\t    // (story Anti-Shim Requirements).\n183\t    expect(sha256(one.value)).toBe(sha256(two.value));\n184\t    expect(JSON.stringify(one.value)).toBe(JSON.stringify(two.value));\n185\t\n186\t    expect(workItemCount(fixture.filePath)).toBe(workRowsBefore);\n187\t    expect(stateSnapshot(fixture.filePath)).toEqual(before);\n188\t    expect(captured.length).toBe(0);\n189\t  });\n190\t});\n191\t\n192\tdescribe(\"tail mapping legs (architecture-risk): one named leg per message kind\", () => {\n193\t  let sdk: Lhc;\n194\t  let filePath: string;\n195\t  let pulled: ViewMessage[];\n196\t\n197\t  beforeAll(async () => {\n198\t    sdk = manualSdk();\n199\t    filePath = await newThread(sdk);\n200\t    await intake(sdk, filePath, [\n201\t      validEvent(\"user_prompt\", { payload: { text: \"mapping prompt\" } }),\n202\t      validEvent(\"assistant_thinking\", { payload: { text: \"mapping thought\" } }),\n203\t      validEvent(\"tool_call\", {\n204\t        payload: { toolCallId: \"call-map-1\", toolName: \"read_file\", arguments: { path: \"map.txt\" } },\n205\t      }),\n206\t      validEvent(\"tool_result\", {\n207\t        payload: { toolCallId: \"call-map-1\", content: \"mapping output\", isError: false },\n208\t      }),\n209\t      validEvent(\"runtime_note\", { payload: { text: \"mapping note\" } }),\n210\t      validEvent(\"assistant_text\", { payload: { text: \"mapping answer\" } }),\n211\t      validEvent(\"turn_end\"),\n212\t    ]);\n213\t    const result = await sdk.threadView.pull({ filePath });\n214\t    if (!result.ok) throw new Error(`pull failed: ${result.error.reason}`);\n215\t    pulled = result.value.messages;\n216\t  });\n217\t\n218\t  it(\"user_prompt: user role, text verbatim\", () => {\n219\t    expect(pulled[0]).toEqual({ role: \"user\", content: \"mapping prompt\" });\n220\t  });\n221\t\n222\t  it(\"assistant_thinking: assistant role, fenced [thinking] block\", () => {\n223\t    expect(pulled[1]).toEqual({\n224\t      role: \"assistant\",\n225\t      content: \"[thinking]\\nmapping thought\\n[/thinking]\",\n226\t    });\n227\t  });\n228\t\n229\t  it(\"tool_call: assistant role, name marker plus deterministic arg rendering\", () => {\n230\t    expect(pulled[2]).toEqual({\n231\t      role: \"assistant\",\n232\t      content: '[tool call · read_file] {\"path\":\"map.txt\"}',\n233\t    });\n234\t  });\n235\t\n236\t  it(\"tool_result ahead of the boundary: user role, name marker plus full content\", () => {\n237\t    expect(pulled[3]).toEqual({\n238\t      role: \"user\",\n239\t      content: \"[tool result · read_file]\\nmapping output\",\n240\t    });\n241\t  });\n242\t\n243\t  it(\"runtime_note: user role, [runtime note] marker plus text\", () => {\n244\t    expect(pulled[4]).toEqual({ role: \"user\", content: \"[runtime note] mapping note\" });\n245\t  });\n246\t\n247\t  it(\"assistant_text: assistant role, text verbatim\", () => {\n248\t    expect(pulled[5]).toEqual({ role: \"assistant\", content: \"mapping answer\" });\n249\t  });\n250\t\n251\t  it(\"tool_result at-or-behind the boundary: abridged marker plus short form (boundary seeded below-SDK)\", async () => {\n252\t    const listed = await sdk.messages.listMessages({ filePath });\n253\t    expect(listed.ok).toBe(true);\n254\t    if (!listed.ok) return;\n255\t    const result = listed.value.find((m) => m.kind === \"tool_result\");\n256\t    expect(result).toBeDefined();\n257\t    if (result === undefined) return;\n258\t    seedViewBoundary(filePath, result.sourceEventOrder);\n259\t\n260\t    const repulled = await sdk.threadView.pull({ filePath });\n261\t    expect(repulled.ok).toBe(true);\n262\t    if (!repulled.ok) return;\n263\t    const short = repulled.value.messages[3];\n264\t    // Summaries are pending on this undrained thread: the short-form ladder\n265\t    // falls to the deterministic truncation rung (content under the limit\n266\t    // passes through whole), with the abridged marker and the record pointer.\n267\t    expect(short).toEqual({\n268\t      role: \"user\",\n269\t      content: `[tool result · read_file · abridged]\\nmapping output [full content in record §${result.messageId}]`,\n270\t    });\n271\t    expect(repulled.value.meta.boundaryPosition).toBe(result.sourceEventOrder);\n272\t  });\n273\t});\n274\t\n275\tdescribe(\"TC-1.4 (AC-1.5): boundary mid-tail — short behind, full ahead, non-tool content full everywhere\", () => {\n276\t  it(\"renders the ready summary behind the boundary and full content ahead of it\", async () => {\n277\t    const sdk = manualSdk();\n278\t    const filePath = await newThread(sdk);\n279\t    for (const turn of [1, 2]) {\n280\t      await intake(sdk, filePath, [\n281\t        validEvent(\"user_prompt\", { payload: { text: `boundary prompt ${turn}` } }),\n282\t        validEvent(\"assistant_thinking\", { payload: { text: `boundary thought ${turn}` } }),\n283\t        validEvent(\"tool_call\", {\n284\t          payload: {\n285\t            toolCallId: `call-bd-${turn}`,\n286\t            toolName: \"read_file\",\n287\t            arguments: { path: `bd-${turn}.txt` },\n288\t          },\n289\t        }),\n290\t        validEvent(\"tool_result\", {\n291\t          payload: { toolCallId: `call-bd-${turn}`, content: `boundary output ${turn}`, isError: false },\n292\t        }),\n293\t        validEvent(\"assistant_text\", { payload: { text: `boundary answer ${turn}` } }),\n294\t        validEvent(\"turn_end\"),\n295\t      ]);\n296\t    }\n297\t    // Drain through the real Epic 02 machinery so the tool-result summaries\n298\t    // are ready — the short-form ladder's first rung.\n299\t    const drained = await sdk.work.drain({ filePath });\n300\t    expect(drained.ok).toBe(true);\n301\t\n302\t    const listed = await sdk.messages.listMessages({ filePath });\n303\t    expect(listed.ok).toBe(true);\n304\t    if (!listed.ok) return;\n305\t    const results = listed.value.filter((m) => m.kind === \"tool_result\");\n306\t    expect(results).toHaveLength(2);\n307\t    const [behind, ahead] = results;\n308\t    if (behind === undefined || ahead === undefined) return;\n309\t    const behindSummary = behind.forms?.find(\n310\t      (form) => form.form === \"tool_result_summary\" && form.state === \"ready\",\n311\t    );\n312\t    expect(behindSummary?.content).toBeDefined();\n313\t\n314\t    // The sanctioned below-SDK helper seeds the boundary mid-tail: at the\n315\t    // first result's event order (at-or-behind includes it), ahead of nothing\n316\t    // else. Boundary mechanics are Story 4's; only the position's effect on\n317\t    // rendering is under test here.\n318\t    seedViewBoundary(filePath, behind.sourceEventOrder);\n319\t\n320\t    const pull = await sdk.threadView.pull({ filePath });\n321\t    expect(pull.ok).toBe(true);\n322\t    if (!pull.ok) return;\n323\t    const contents = pull.value.messages.map((m) => m.content);\n324\t\n325\t    // Behind: short form — the ready summary verbatim, abridged marker,\n326\t    // record pointer.\n327\t    expect(contents).toContain(\n328\t      `[tool result · read_file · abridged]\\n${behindSummary?.content} [full content in record §${behind.messageId}]`,\n329\t    );\n330\t    // Ahead: full content.\n331\t    expect(contents).toContain(\"[tool result · read_file]\\nboundary output 2\");\n332\t    // Non-tool-result content renders full everywhere, both sides of the\n333\t    // boundary (prompts, thinking, assistant text).\n334\t    for (const turn of [1, 2]) {\n335\t      expect(contents).toContain(`boundary prompt ${turn}`);\n336\t      expect(contents).toContain(`[thinking]\\nboundary thought ${turn}\\n[/thinking]`);\n337\t      expect(contents).toContain(`boundary answer ${turn}`);\n338\t    }\n339\t  });\n340\t\n341\t  it(\"falls to deterministic truncation when no summary is ready and the content is oversized\", async () => {\n342\t    const sdk = manualSdk();\n343\t    const filePath = await newThread(sdk);\n344\t    const longContent = \"x\".repeat(260);\n345\t    await intake(sdk, filePath, [\n346\t      validEvent(\"user_prompt\", { payload: { text: \"truncation prompt\" } }),\n347\t      validEvent(\"tool_call\", {\n348\t        payload: { toolCallId: \"call-tr-1\", toolName: \"read_file\", arguments: { path: \"tr.txt\" } },\n349\t      }),\n350\t      validEvent(\"tool_result\", {\n351\t        payload: { toolCallId: \"call-tr-1\", content: longContent, isError: false },\n352\t      }),\n353\t      validEvent(\"turn_end\"),\n354\t    ]);\n355\t    // No drain: the summary stays pending, so the ladder's truncation rung\n356\t    // renders — fixed 200-char prefix plus the exact dropped-count marker\n357\t    // (Epic 01's abbreviation rule).\n358\t    const listed = await sdk.messages.listMessages({ filePath });\n359\t    expect(listed.ok).toBe(true);\n360\t    if (!listed.ok) return;\n361\t    const result = listed.value.find((m) => m.kind === \"tool_result\");\n362\t    if (result === undefined) return;\n363\t    seedViewBoundary(filePath, result.sourceEventOrder);\n364\t\n365\t    const pull = await sdk.threadView.pull({ filePath });\n366\t    expect(pull.ok).toBe(true);\n367\t    if (!pull.ok) return;\n368\t    const short = pull.value.messages.find((m) => m.content.startsWith(\"[tool result\"));\n369\t    expect(short?.content).toBe(\n370\t      `[tool result · read_file · abridged]\\n${\"x\".repeat(200)}… [truncated 60 chars] [full content in record §${result.messageId}]`,\n371\t    );\n372\t  });\n373\t});\n374\t\n375\tdescribe(\"TC-2.5 pre-compact legs (AC-2.8): the status read on a heavy thread\", () => {\n376\t  // TC-2.5's intake leg mutates its thread, so this describe builds its own\n377\t  // fixture instance instead of sharing the suite's read-only one.\n378\t  let heavyStore: TempStore;\n379\t  let heavy: DerivedThreadFixture;\n380\t  let statusSdk: Lhc;\n381\t\n382\t  beforeAll(async () => {\n383\t    heavyStore = tempStore();\n384\t    heavy = await derivedThreadFixture(heavyStore);\n385\t    // A low threshold makes the fixture \"heavy\" relative to config: the\n386\t    // recommendation must trip without any conversation-scale inflation.\n387\t    statusSdk = manualSdk({ compactThreshold: 100 });\n388\t  });\n389\t  afterAll(() => {\n390\t    heavyStore.cleanup();\n391\t  });\n392\t\n393\t  it(\"reports tail tokens vs threshold, recommendation, derivation counts, null view health, and the zone sum — reads only\", async () => {\n394\t    // Status legs of the zero-provider assertion: the builder's double\n395\t    // records every call from here on; status must add none.\n396\t    const captured = heavy.double.captureInputs();\n397\t    const before = stateSnapshot(heavy.filePath);\n398\t\n399\t    const status = await statusSdk.threadView.status({ filePath: heavy.filePath });\n400\t    expect(status.ok).toBe(true);\n401\t    if (!status.ok) return;\n402\t\n403\t    expect(status.value.threshold).toBe(100);\n404\t    expect(status.value.tailTokens).toBeGreaterThan(100);\n405\t    expect(status.value.compactRecommended).toBe(true);\n406\t\n407\t    // Derivation counts by state, from the owners' report surfaces: the\n408\t    // fixture's two scripted failures (transient-exhausted + permanent), all\n409\t    // other forms drained ready — nothing pending, retrying, or blocked here\n410\t    // (the blocked leg reads the sacrificial sibling below).\n411\t    expect(status.value.derivation).toEqual({ pending: 0, retrying: 0, failed: 2, blocked: 0 });\n412\t\n413\t    // Pre-compact: view health is null, not a zeroed shape (AC-2.8 leg owned\n414\t    // here; the view-health legs complete in Story 2).\n415\t    expect(status.value.view).toBeNull();\n416\t\n417\t    // The visibility zone: boundary at its seeded default 0, so the sum is\n418\t    // every live tool result's estimate — cross-checked against the record.\n419\t    const listed = await statusSdk.messages.listMessages({ filePath: heavy.filePath });\n420\t    expect(listed.ok).toBe(true);\n421\t    if (!listed.ok) return;\n422\t    const expectedZone = listed.value\n423\t      .filter((m) => m.kind === \"tool_result\")\n424\t      .reduce((sum, m) => sum + m.tokenEstimate, 0);\n425\t    expect(status.value.visibility).toEqual({ zoneTokens: expectedZone, maxTokens: 32000 });\n426\t\n427\t    // Reads only: no work rows, no form-state change, no view row, boundary\n428\t    // unmoved, zero provider calls — and no compact occurred uninvoked.\n429\t    expect(stateSnapshot(heavy.filePath)).toEqual(before);\n430\t    expect(captured.length).toBe(0);\n431\t  });\n432\t\n433\t  it(\"counts blocked forms through the owner's report (sacrificial sibling)\", async () => {\n434\t    const sibling = await blockedSiblingThread(heavyStore);\n435\t    const status = await sibling.sdk.threadView.status({ filePath: sibling.filePath });\n436\t    expect(status.ok).toBe(true);\n437\t    if (!status.ok) return;\n438\t    // The sibling's damaged turn landed both turn forms blocked through the\n439\t    // production terminal path (turn_rendering + lower_band_projection).\n440\t    expect(status.value.derivation.blocked).toBe(2);\n441\t    expect(status.value.view).toBeNull();\n442\t  });\n443\t\n444\t  it(\"after more intake the tail grew; still no compact without invocation\", async () => {\n445\t    const first = await statusSdk.threadView.status({ filePath: heavy.filePath });\n446\t    expect(first.ok).toBe(true);\n447\t    if (!first.ok) return;\n448\t\n449\t    await intake(heavy.sdk, heavy.filePath, [\n450\t      validEvent(\"user_prompt\", { payload: { text: \"one more question for the heavy thread\" } }),\n451\t      validEvent(\"assistant_text\", { payload: { text: \"one more answer for the heavy thread\" } }),\n452\t      validEvent(\"turn_end\"),\n453\t    ]);\n454\t\n455\t    const second = await statusSdk.threadView.status({ filePath: heavy.filePath });\n456\t    expect(second.ok).toBe(true);\n457\t    if (!second.ok) return;\n458\t    expect(second.value.tailTokens).toBeGreaterThan(first.value.tailTokens);\n459\t    expect(second.value.view).toBeNull();\n460\t    expect(stateSnapshot(heavy.filePath)[\"viewRows\"]).toBe(0);\n461\t  });\n462\t});\n463\t\n464\tdescribe(\"TC-1.2 / TC-2.5 background legs (SV-01-PULL-STATUS-001): pull and status are reads-only in a background SDK with pending work queued\", () => {\n465\t  it(\"schedules no catch-up drain: work rows, form states, provider count, and status all unchanged; repeated pulls byte-identical\", async () => {\n466\t    // Pending work manufactured through a manual SDK (its no-op seam never\n467\t    // drains): one tool-heavy turn leaves live queue rows and pending forms.\n468\t    const seeder = manualSdk();\n469\t    const filePath = await newThread(seeder);\n470\t    await intake(seeder, filePath, [\n471\t      validEvent(\"user_prompt\", { payload: { text: \"background prompt\" } }),\n472\t      validEvent(\"tool_call\", {\n473\t        payload: { toolCallId: \"call-bg-1\", toolName: \"read_file\", arguments: { path: \"bg.txt\" } },\n474\t      }),\n475\t      validEvent(\"tool_result\", {\n476\t        payload: { toolCallId: \"call-bg-1\", content: \"background output\", isError: false },\n477\t      }),\n478\t      validEvent(\"assistant_text\", { payload: { text: \"background answer\" } }),\n479\t      validEvent(\"turn_end\"),\n480\t    ]);\n481\t    expect(workItemCount(filePath)).toBeGreaterThan(0);\n482\t\n483\t    // The production background path: a fresh background SDK whose scheduler\n484\t    // WOULD hang a first-touch catch-up drain off the open announcement\n485\t    // (openThreadDatabase → fireThreadTouch → scheduler.touch) if pull or\n486\t    // status fired it — the SV-01-PULL-STATUS-001 side-effect path.\n487\t    const bgDouble = createProviderDouble();\n488\t    const bg = createSdk({\n489\t      provider: bgDouble,\n490\t      mode: \"background\",\n491\t      view: { compactThreshold: 100 },\n492\t    });\n493\t    const captured = bgDouble.captureInputs();\n494\t    const before = stateSnapshot(filePath);\n495\t\n496\t    const one = await bg.threadView.pull({ filePath });\n497\t    const firstStatus = await bg.threadView.status({ filePath });\n498\t    const two = await bg.threadView.pull({ filePath });\n499\t    expect(one.ok && two.ok && firstStatus.ok).toBe(true);\n500\t    if (!one.ok || !two.ok || !firstStatus.ok) return;\n501\t\n502\t    // The pending work is visible through the read itself (never-attempted\n503\t    // forms bucket as pending) — proof the reads ran against live queue rows.\n504\t    expect(firstStatus.value.derivation.pending).toBeGreaterThan(0);\n505\t\n506\t    // Give any wrongly-scheduled catch-up drain room to surface, then wait\n507\t    // out the scheduler before asserting nothing happened.\n508\t    await new Promise((resolve) => setTimeout(resolve, 25));\n509\t    await bg.drainSettled({ filePath });\n510\t\n511\t    // Byte-identical repeated pulls (AC-1.7) in background mode.\n512\t    expect(sha256(one.value)).toBe(sha256(two.value));\n513\t    expect(JSON.stringify(one.value)).toBe(JSON.stringify(two.value));\n514\t\n515\t    // Reads only: queue rows, form states, view rows, and boundary all\n516\t    // unchanged; the provider fake observed zero calls.\n517\t    expect(stateSnapshot(filePath)).toEqual(before);\n518\t    expect(captured.length).toBe(0);\n519\t\n520\t    // The status read repeats unchanged too — no state moved underneath it.\n521\t    const secondStatus = await bg.threadView.status({ filePath });\n522\t    expect(secondStatus.ok).toBe(true);\n523\t    if (!secondStatus.ok) return;\n524\t    expect(JSON.stringify(secondStatus.value)).toBe(JSON.stringify(firstStatus.value));\n525\t  });\n526\t});\n527\t"}]},"parent_tool_use_id":null,"session_id":"14af1c76-5e3a-4e59-acc7-c3c9d062b23f","uuid":"fb567e10-edda-4b1b-bc02-6e70cba7ec1a","timestamp":"2026-06-11T17:06:18.093Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-pull.test.ts","content":"// Epic 03 Story 1: pull and status on the record (TC-1.1, TC-1.2, TC-1.4,\n// TC-2.5 pre-compact legs, the per-kind tail-mapping legs, and the pull/status\n// legs of the suite-wide zero-provider assertion). Every TC goes through the\n// real SDK surface (createSdk().threadView.pull/status) against real temp\n// thread files; the provider double appears only in construction/fixture\n// setup — no Epic 03 operation may touch it.\nimport { createHash } from \"node:crypto\";\nimport { join } from \"node:path\";\nimport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\nimport { createSdk, type Lhc, type SdkViewConfig, type ViewMessage } from \"../src/index.js\";\nimport {\n  blockedSiblingThread,\n  createProviderDouble,\n  derivedThreadFixture,\n  openRaw,\n  seedViewBoundary,\n  tempStore,\n  validEvent,\n  type DerivedThreadFixture,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nlet fixture: DerivedThreadFixture;\n\nbeforeAll(async () => {\n  store = tempStore();\n  fixture = await derivedThreadFixture(store);\n});\nafterAll(() => {\n  store.cleanup();\n});\n\nfunction manualSdk(view?: SdkViewConfig): Lhc {\n  return createSdk({\n    provider: createProviderDouble(),\n    mode: \"manual\",\n    ...(view === undefined ? {} : { view }),\n  });\n}\n\nasync function newThread(sdk: Lhc): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nasync function intake(sdk: Lhc, filePath: string, batch: Parameters<Lhc[\"intakeStream\"][\"messageEvents\"]>[1]): Promise<void> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`intake failed: ${result.error.reason}`);\n}\n\nfunction sha256(value: unknown): string {\n  return createHash(\"sha256\").update(JSON.stringify(value)).digest(\"hex\");\n}\n\nfunction workItemCount(filePath: string): number {\n  const db = openRaw(filePath);\n  try {\n    const row = db.prepare(`SELECT COUNT(*) AS n FROM work_item`).get() as {\n      n: number | bigint;\n    };\n    return Number(row.n);\n  } finally {\n    db.close();\n  }\n}\n\n// Below-SDK read-only snapshot of everything a read could illegally mutate:\n// queue rows, form states, view rows, boundary position (TC-1.2 / TC-2.5\n// reads-only assertions).\nfunction stateSnapshot(filePath: string): Record<string, unknown> {\n  const db = openRaw(filePath);\n  try {\n    return {\n      workItems: (\n        db\n          .prepare(`SELECT work_item_id, status, attempts FROM work_item ORDER BY work_item_id`)\n          .all() as unknown as Array<{ work_item_id: string; status: string; attempts: number | bigint }>\n      ).map((row) => ({ id: row.work_item_id, status: row.status, attempts: Number(row.attempts) })),\n      forms: db\n        .prepare(`SELECT subject_id, form, state FROM derived_form ORDER BY subject_id, form`)\n        .all(),\n      viewRows: Number(\n        (db.prepare(`SELECT COUNT(*) AS n FROM thread_view`).get() as { n: number | bigint }).n,\n      ),\n      boundary: Number(\n        (db.prepare(`SELECT position FROM view_boundary`).get() as { position: number | bigint })\n          .position,\n      ),\n    };\n  } finally {\n    db.close();\n  }\n}\n\ndescribe(\"surface skeleton: unimplemented ops return structured results\", () => {\n  // Epic 03 Story 2 (sanctioned amendment): compact is real now, so its\n  // not-implemented leg moved out of this test; view-compact.test.ts owns the\n  // operation. sweep and materialize stay stubbed until Stories 3 and 5.\n  it(\"sweep and materialize return ok:false not-implemented, never throw\", async () => {\n    const ref = { filePath: fixture.filePath };\n    const swept = await fixture.sdk.threadView.sweep(ref);\n    expect(swept).toEqual({\n      ok: false,\n      error: { errorClass: \"system_error\", code: \"not_implemented\", reason: \"not implemented: sweep\" },\n    });\n    const materialized = await fixture.sdk.threadView.materialize(ref, {\n      path: join(store.dir, \"out.jsonl\"),\n    });\n    expect(materialized).toEqual({\n      ok: false,\n      error: { errorClass: \"system_error\", code: \"not_implemented\", reason: \"not implemented: materialize\" },\n    });\n  });\n});\n\ndescribe(\"TC-1.1 (AC-1.2, AC-1.3): never-compacted thread pulls the full conversation in order; later intake appends\", () => {\n  it(\"carries both intake rounds in record order with tail-only meta\", async () => {\n    const sdk = manualSdk();\n    const filePath = await newThread(sdk);\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"first question\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"first answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n\n    const first = await sdk.threadView.pull({ filePath });\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    expect(first.value.messages).toEqual([\n      { role: \"user\", content: \"first question\" },\n      { role: \"assistant\", content: \"first answer\" },\n    ]);\n    // Never compacted: no band content, no error, tail from event 1 (AC-1.3).\n    expect(first.value.messages.every((m) => m.band === undefined)).toBe(true);\n    expect(first.value.meta).toEqual({\n      compactPoint: null,\n      coveredFrom: null,\n      boundaryPosition: 0,\n      gapCount: 0,\n      degradedCount: 0,\n      viewId: null,\n      createdAt: null,\n    });\n\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"second question\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"second answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    const second = await sdk.threadView.pull({ filePath });\n    expect(second.ok).toBe(true);\n    if (!second.ok) return;\n    // All committed intake appears, in record order; the new batch appends\n    // after the first round's messages, which are byte-unchanged (AC-1.2).\n    expect(second.value.messages).toEqual([\n      { role: \"user\", content: \"first question\" },\n      { role: \"assistant\", content: \"first answer\" },\n      { role: \"user\", content: \"second question\" },\n      { role: \"assistant\", content: \"second answer\" },\n    ]);\n  });\n});\n\ndescribe(\"TC-1.2 (AC-1.1, AC-1.7): two pulls with nothing between are byte-identical and create no work or provider calls\", () => {\n  it(\"hashes identical, zero work rows created, provider double observes zero calls\", async () => {\n    // The double's capture log starts recording here; any Epic 03 read that\n    // touched the provider would append to it (zero-provider assertion, pull\n    // leg of the suite-wide architecture-risk row).\n    const captured = fixture.double.captureInputs();\n    const before = stateSnapshot(fixture.filePath);\n    const workRowsBefore = workItemCount(fixture.filePath);\n\n    const one = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n    const two = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n    expect(one.ok && two.ok).toBe(true);\n    if (!one.ok || !two.ok) return;\n\n    // Byte-identical via the FULL serialized result, not field spot-checks\n    // (story Anti-Shim Requirements).\n    expect(sha256(one.value)).toBe(sha256(two.value));\n    expect(JSON.stringify(one.value)).toBe(JSON.stringify(two.value));\n\n    expect(workItemCount(fixture.filePath)).toBe(workRowsBefore);\n    expect(stateSnapshot(fixture.filePath)).toEqual(before);\n    expect(captured.length).toBe(0);\n  });\n});\n\ndescribe(\"tail mapping legs (architecture-risk): one named leg per message kind\", () => {\n  let sdk: Lhc;\n  let filePath: string;\n  let pulled: ViewMessage[];\n\n  beforeAll(async () => {\n    sdk = manualSdk();\n    filePath = await newThread(sdk);\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"mapping prompt\" } }),\n      validEvent(\"assistant_thinking\", { payload: { text: \"mapping thought\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"call-map-1\", toolName: \"read_file\", arguments: { path: \"map.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"call-map-1\", content: \"mapping output\", isError: false },\n      }),\n      validEvent(\"runtime_note\", { payload: { text: \"mapping note\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"mapping answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    const result = await sdk.threadView.pull({ filePath });\n    if (!result.ok) throw new Error(`pull failed: ${result.error.reason}`);\n    pulled = result.value.messages;\n  });\n\n  it(\"user_prompt: user role, text verbatim\", () => {\n    expect(pulled[0]).toEqual({ role: \"user\", content: \"mapping prompt\" });\n  });\n\n  it(\"assistant_thinking: assistant role, fenced [thinking] block\", () => {\n    expect(pulled[1]).toEqual({\n      role: \"assistant\",\n      content: \"[thinking]\\nmapping thought\\n[/thinking]\",\n    });\n  });\n\n  it(\"tool_call: assistant role, name marker plus deterministic arg rendering\", () => {\n    expect(pulled[2]).toEqual({\n      role: \"assistant\",\n      content: '[tool call · read_file] {\"path\":\"map.txt\"}',\n    });\n  });\n\n  it(\"tool_result ahead of the boundary: user role, name marker plus full content\", () => {\n    expect(pulled[3]).toEqual({\n      role: \"user\",\n      content: \"[tool result · read_file]\\nmapping output\",\n    });\n  });\n\n  it(\"runtime_note: user role, [runtime note] marker plus text\", () => {\n    expect(pulled[4]).toEqual({ role: \"user\", content: \"[runtime note] mapping note\" });\n  });\n\n  it(\"assistant_text: assistant role, text verbatim\", () => {\n    expect(pulled[5]).toEqual({ role: \"assistant\", content: \"mapping answer\" });\n  });\n\n  it(\"tool_result at-or-behind the boundary: abridged marker plus short form (boundary seeded below-SDK)\", async () => {\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const result = listed.value.find((m) => m.kind === \"tool_result\");\n    expect(result).toBeDefined();\n    if (result === undefined) return;\n    seedViewBoundary(filePath, result.sourceEventOrder);\n\n    const repulled = await sdk.threadView.pull({ filePath });\n    expect(repulled.ok).toBe(true);\n    if (!repulled.ok) return;\n    const short = repulled.value.messages[3];\n    // Summaries are pending on this undrained thread: the short-form ladder\n    // falls to the deterministic truncation rung (content under the limit\n    // passes through whole), with the abridged marker and the record pointer.\n    expect(short).toEqual({\n      role: \"user\",\n      content: `[tool result · read_file · abridged]\\nmapping output [full content in record §${result.messageId}]`,\n    });\n    expect(repulled.value.meta.boundaryPosition).toBe(result.sourceEventOrder);\n  });\n});\n\ndescribe(\"TC-1.4 (AC-1.5): boundary mid-tail — short behind, full ahead, non-tool content full everywhere\", () => {\n  it(\"renders the ready summary behind the boundary and full content ahead of it\", async () => {\n    const sdk = manualSdk();\n    const filePath = await newThread(sdk);\n    for (const turn of [1, 2]) {\n      await intake(sdk, filePath, [\n        validEvent(\"user_prompt\", { payload: { text: `boundary prompt ${turn}` } }),\n        validEvent(\"assistant_thinking\", { payload: { text: `boundary thought ${turn}` } }),\n        validEvent(\"tool_call\", {\n          payload: {\n            toolCallId: `call-bd-${turn}`,\n            toolName: \"read_file\",\n            arguments: { path: `bd-${turn}.txt` },\n          },\n        }),\n        validEvent(\"tool_result\", {\n          payload: { toolCallId: `call-bd-${turn}`, content: `boundary output ${turn}`, isError: false },\n        }),\n        validEvent(\"assistant_text\", { payload: { text: `boundary answer ${turn}` } }),\n        validEvent(\"turn_end\"),\n      ]);\n    }\n    // Drain through the real Epic 02 machinery so the tool-result summaries\n    // are ready — the short-form ladder's first rung.\n    const drained = await sdk.work.drain({ filePath });\n    expect(drained.ok).toBe(true);\n\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const results = listed.value.filter((m) => m.kind === \"tool_result\");\n    expect(results).toHaveLength(2);\n    const [behind, ahead] = results;\n    if (behind === undefined || ahead === undefined) return;\n    const behindSummary = behind.forms?.find(\n      (form) => form.form === \"tool_result_summary\" && form.state === \"ready\",\n    );\n    expect(behindSummary?.content).toBeDefined();\n\n    // The sanctioned below-SDK helper seeds the boundary mid-tail: at the\n    // first result's event order (at-or-behind includes it), ahead of nothing\n    // else. Boundary mechanics are Story 4's; only the position's effect on\n    // rendering is under test here.\n    seedViewBoundary(filePath, behind.sourceEventOrder);\n\n    const pull = await sdk.threadView.pull({ filePath });\n    expect(pull.ok).toBe(true);\n    if (!pull.ok) return;\n    const contents = pull.value.messages.map((m) => m.content);\n\n    // Behind: short form — the ready summary verbatim, abridged marker,\n    // record pointer.\n    expect(contents).toContain(\n      `[tool result · read_file · abridged]\\n${behindSummary?.content} [full content in record §${behind.messageId}]`,\n    );\n    // Ahead: full content.\n    expect(contents).toContain(\"[tool result · read_file]\\nboundary output 2\");\n    // Non-tool-result content renders full everywhere, both sides of the\n    // boundary (prompts, thinking, assistant text).\n    for (const turn of [1, 2]) {\n      expect(contents).toContain(`boundary prompt ${turn}`);\n      expect(contents).toContain(`[thinking]\\nboundary thought ${turn}\\n[/thinking]`);\n      expect(contents).toContain(`boundary answer ${turn}`);\n    }\n  });\n\n  it(\"falls to deterministic truncation when no summary is ready and the content is oversized\", async () => {\n    const sdk = manualSdk();\n    const filePath = await newThread(sdk);\n    const longContent = \"x\".repeat(260);\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"truncation prompt\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"call-tr-1\", toolName: \"read_file\", arguments: { path: \"tr.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"call-tr-1\", content: longContent, isError: false },\n      }),\n      validEvent(\"turn_end\"),\n    ]);\n    // No drain: the summary stays pending, so the ladder's truncation rung\n    // renders — fixed 200-char prefix plus the exact dropped-count marker\n    // (Epic 01's abbreviation rule).\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const result = listed.value.find((m) => m.kind === \"tool_result\");\n    if (result === undefined) return;\n    seedViewBoundary(filePath, result.sourceEventOrder);\n\n    const pull = await sdk.threadView.pull({ filePath });\n    expect(pull.ok).toBe(true);\n    if (!pull.ok) return;\n    const short = pull.value.messages.find((m) => m.content.startsWith(\"[tool result\"));\n    expect(short?.content).toBe(\n      `[tool result · read_file · abridged]\\n${\"x\".repeat(200)}… [truncated 60 chars] [full content in record §${result.messageId}]`,\n    );\n  });\n});\n\ndescribe(\"TC-2.5 pre-compact legs (AC-2.8): the status read on a heavy thread\", () => {\n  // TC-2.5's intake leg mutates its thread, so this describe builds its own\n  // fixture instance instead of sharing the suite's read-only one.\n  let heavyStore: TempStore;\n  let heavy: DerivedThreadFixture;\n  let statusSdk: Lhc;\n\n  beforeAll(async () => {\n    heavyStore = tempStore();\n    heavy = await derivedThreadFixture(heavyStore);\n    // A low threshold makes the fixture \"heavy\" relative to config: the\n    // recommendation must trip without any conversation-scale inflation.\n    statusSdk = manualSdk({ compactThreshold: 100 });\n  });\n  afterAll(() => {\n    heavyStore.cleanup();\n  });\n\n  it(\"reports tail tokens vs threshold, recommendation, derivation counts, null view health, and the zone sum — reads only\", async () => {\n    // Status legs of the zero-provider assertion: the builder's double\n    // records every call from here on; status must add none.\n    const captured = heavy.double.captureInputs();\n    const before = stateSnapshot(heavy.filePath);\n\n    const status = await statusSdk.threadView.status({ filePath: heavy.filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n\n    expect(status.value.threshold).toBe(100);\n    expect(status.value.tailTokens).toBeGreaterThan(100);\n    expect(status.value.compactRecommended).toBe(true);\n\n    // Derivation counts by state, from the owners' report surfaces: the\n    // fixture's two scripted failures (transient-exhausted + permanent), all\n    // other forms drained ready — nothing pending, retrying, or blocked here\n    // (the blocked leg reads the sacrificial sibling below).\n    expect(status.value.derivation).toEqual({ pending: 0, retrying: 0, failed: 2, blocked: 0 });\n\n    // Pre-compact: view health is null, not a zeroed shape (AC-2.8 leg owned\n    // here; the view-health legs complete in Story 2).\n    expect(status.value.view).toBeNull();\n\n    // The visibility zone: boundary at its seeded default 0, so the sum is\n    // every live tool result's estimate — cross-checked against the record.\n    const listed = await statusSdk.messages.listMessages({ filePath: heavy.filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const expectedZone = listed.value\n      .filter((m) => m.kind === \"tool_result\")\n      .reduce((sum, m) => sum + m.tokenEstimate, 0);\n    expect(status.value.visibility).toEqual({ zoneTokens: expectedZone, maxTokens: 32000 });\n\n    // Reads only: no work rows, no form-state change, no view row, boundary\n    // unmoved, zero provider calls — and no compact occurred uninvoked.\n    expect(stateSnapshot(heavy.filePath)).toEqual(before);\n    expect(captured.length).toBe(0);\n  });\n\n  it(\"counts blocked forms through the owner's report (sacrificial sibling)\", async () => {\n    const sibling = await blockedSiblingThread(heavyStore);\n    const status = await sibling.sdk.threadView.status({ filePath: sibling.filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n    // The sibling's damaged turn landed both turn forms blocked through the\n    // production terminal path (turn_rendering + lower_band_projection).\n    expect(status.value.derivation.blocked).toBe(2);\n    expect(status.value.view).toBeNull();\n  });\n\n  it(\"after more intake the tail grew; still no compact without invocation\", async () => {\n    const first = await statusSdk.threadView.status({ filePath: heavy.filePath });\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n\n    await intake(heavy.sdk, heavy.filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"one more question for the heavy thread\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"one more answer for the heavy thread\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n\n    const second = await statusSdk.threadView.status({ filePath: heavy.filePath });\n    expect(second.ok).toBe(true);\n    if (!second.ok) return;\n    expect(second.value.tailTokens).toBeGreaterThan(first.value.tailTokens);\n    expect(second.value.view).toBeNull();\n    expect(stateSnapshot(heavy.filePath)[\"viewRows\"]).toBe(0);\n  });\n});\n\ndescribe(\"TC-1.2 / TC-2.5 background legs (SV-01-PULL-STATUS-001): pull and status are reads-only in a background SDK with pending work queued\", () => {\n  it(\"schedules no catch-up drain: work rows, form states, provider count, and status all unchanged; repeated pulls byte-identical\", async () => {\n    // Pending work manufactured through a manual SDK (its no-op seam never\n    // drains): one tool-heavy turn leaves live queue rows and pending forms.\n    const seeder = manualSdk();\n    const filePath = await newThread(seeder);\n    await intake(seeder, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"background prompt\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"call-bg-1\", toolName: \"read_file\", arguments: { path: \"bg.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"call-bg-1\", content: \"background output\", isError: false },\n      }),\n      validEvent(\"assistant_text\", { payload: { text: \"background answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(workItemCount(filePath)).toBeGreaterThan(0);\n\n    // The production background path: a fresh background SDK whose scheduler\n    // WOULD hang a first-touch catch-up drain off the open announcement\n    // (openThreadDatabase → fireThreadTouch → scheduler.touch) if pull or\n    // status fired it — the SV-01-PULL-STATUS-001 side-effect path.\n    const bgDouble = createProviderDouble();\n    const bg = createSdk({\n      provider: bgDouble,\n      mode: \"background\",\n      view: { compactThreshold: 100 },\n    });\n    const captured = bgDouble.captureInputs();\n    const before = stateSnapshot(filePath);\n\n    const one = await bg.threadView.pull({ filePath });\n    const firstStatus = await bg.threadView.status({ filePath });\n    const two = await bg.threadView.pull({ filePath });\n    expect(one.ok && two.ok && firstStatus.ok).toBe(true);\n    if (!one.ok || !two.ok || !firstStatus.ok) return;\n\n    // The pending work is visible through the read itself (never-attempted\n    // forms bucket as pending) — proof the reads ran against live queue rows.\n    expect(firstStatus.value.derivation.pending).toBeGreaterThan(0);\n\n    // Give any wrongly-scheduled catch-up drain room to surface, then wait\n    // out the scheduler before asserting nothing happened.\n    await new Promise((resolve) => setTimeout(resolve, 25));\n    await bg.drainSettled({ filePath });\n\n    // Byte-identical repeated pulls (AC-1.7) in background mode.\n    expect(sha256(one.value)).toBe(sha256(two.value));\n    expect(JSON.stringify(one.value)).toBe(JSON.stringify(two.value));\n\n    // Reads only: queue rows, form states, view rows, and boundary all\n    // unchanged; the provider fake observed zero calls.\n    expect(stateSnapshot(filePath)).toEqual(before);\n    expect(captured.length).toBe(0);\n\n    // The status read repeats unchanged too — no state moved underneath it.\n    const secondStatus = await bg.threadView.status({ filePath });\n    expect(secondStatus.ok).toBe(true);\n    if (!secondStatus.ok) return;\n    expect(JSON.stringify(secondStatus.value)).toBe(JSON.stringify(firstStatus.value));\n  });\n});\n","numLines":527,"startLine":1,"totalLines":527}}}

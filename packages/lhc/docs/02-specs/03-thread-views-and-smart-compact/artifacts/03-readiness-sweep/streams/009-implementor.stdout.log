{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_013X5c5gpPBJ1rKZCX932rdQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Nh3U9TousRpbkbYMv4iaYf","name":"Edit","input":{"replace_all":false,"file_path":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-compact.test.ts","old_string":"    // Sweep step is absent this story (the honest literal, not a fake empty\n    // receipt — Story 3 flips it).\n    expect(receipt.value.sweep).toBe(\"absent\");","new_string":"    // Story 3 (sanctioned amendment): the embedded sweep replaced Story 2's\n    // \"absent\" literal. This is the file's first default-sweep compact, so\n    // the fixture's transiently-failed summary requeues HERE — every later\n    // compact in this file sees it in-flight and writes nothing, which is\n    // what keeps the record-untouched assertions below honest. The sweep's\n    // own contract lives in view-sweep.test.ts.\n    expect(receipt.value.sweep).not.toEqual({ skipped: true });\n    if (!(\"owners\" in receipt.value.sweep)) throw new Error(\"expected embedded sweep receipt\");\n    const sweepLine = receipt.value.sweep.owners.find(\n      (line) => line.owner === \"messages\" && line.kind === \"tool_result_summary\",\n    );\n    expect(sweepLine?.requeued).toEqual([fixture.failedTransientMessageId]);"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1575,"cache_read_input_tokens":154910,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1575},"output_tokens":50,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"14af1c76-5e3a-4e59-acc7-c3c9d062b23f","uuid":"4009d9d9-3c94-479e-9cdb-5cad3b1990b7","request_id":"req_011CbwrE31ZMJi6wZn8Cs8Z9"}

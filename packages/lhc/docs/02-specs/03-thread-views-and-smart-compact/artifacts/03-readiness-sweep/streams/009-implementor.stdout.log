{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012Hjy7RsRbB465dZNtAXntL","type":"tool_result","content":"240\t\n241\texport interface Scheduler {\n242\t  readonly mode: SchedulerMode;\n243\t  // Post-commit nudge that work was queued for a thread (DD-5). Manual mode:\n244\t  // no-op by contract. Background mode: starts a drain, or coalesces into\n245\t  // the pending flag if one is already running for the thread (AC-1.2).\n246\t  poke(threadId: string): void;\n247\t  // Thread-file open announcement (DD-10): learns threadId → filePath and,\n248\t  // on the first touch of a thread this process lifetime, schedules a\n249\t  // catch-up drain if the queue has leftover live work (AC-1.6).\n250\t  touch(filePath: string, db: DatabaseSync): void;\n251\t  // Resolves when the scheduler has no running or pending drain for the\n252\t  // thread (issue 3). Manual mode resolves immediately.\n253\t  drainSettled(threadId: string): Promise<void>;\n254\t  // Test-only observability for coalescing exactness (TC-1.2): drain passes\n255\t  // started for a thread. Named as a test hook on purpose — not API.\n256\t  testPassCount(threadId: string): number;\n257\t}\n258\t\n259\tfunction readThreadId(db: DatabaseSync): string | null {\n260\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n261\t    | { thread_id: string }\n262\t    | undefined;\n263\t  return row?.thread_id ?? null;\n264\t}\n265\t\n266\t// Read a thread file's id without side effects (no migration, no touch) —\n267\t// drainSettled must observe scheduler state, never schedule work.\n268\texport function peekThreadId(filePath: string): string | null {\n269\t  if (!existsSync(filePath)) return null;\n270\t  let db: DatabaseSync | undefined;\n271\t  try {\n272\t    db = new DatabaseSync(filePath, { readOnly: true });\n273\t    return readThreadId(db);\n274\t  } catch {\n275\t    return null;\n276\t  } finally {\n277\t    db?.close();\n278\t  }\n279\t}\n280\t\n281\texport function createScheduler(mode: SchedulerMode, deps: DrainDeps): Scheduler {\n282\t  const states = new Map<string, ThreadDrainState>();\n283\t  const seen = new Set<string>(); // first-touch catch-up guard, process lifetime\n284\t\n285\t  function stateFor(threadId: string): ThreadDrainState {\n286\t    let st = states.get(threadId);\n287\t    if (st === undefined) {\n288\t      st = {\n289\t        threadId,\n290\t        filePath: \"\",\n291\t        running: false,\n292\t        pending: false,\n293\t        passes: 0,\n294\t        waiters: [],\n295\t        wakeTimer: undefined,\n296\t      };\n297\t      states.set(threadId, st);\n298\t    }\n299\t    return st;\n300\t  }\n301\t\n302\t  function clearWake(st: ThreadDrainState): void {\n303\t    if (st.wakeTimer !== undefined) {\n304\t      cancelTimer(st.wakeTimer);\n305\t      st.wakeTimer = undefined;\n306\t    }\n307\t  }\n308\t\n309\t  // Arm the lone backoff wake (Fix 1): when a background pass stops on the\n310\t  // eligibility gate, schedule a single nudge at the head's eligible_at that\n311\t  // re-enters the existing poke path. The delay reads the SDK clock seam (no\n312\t  // fresh Date here — E02-NB-001) and is floored to a sane minimum; correctness\n313\t  // rides claimNext's durable gate, so a coarse timer never retries early.\n314\t  function armWake(st: ThreadDrainState, waitingUntil: string): void {\n315\t    clearWake(st);\n316\t    const nowMs = deps.config.clock().getTime();\n317\t    const delay = Math.max(WAKE_MIN_DELAY_MS, Date.parse(waitingUntil) - nowMs);\n318\t    const timer = scheduleTimer(() => {\n319\t      st.wakeTimer = undefined;\n320\t      schedule(st.threadId);\n321\t    }, delay);\n322\t    timer.unref();\n323\t    st.wakeTimer = timer;\n324\t  }\n325\t\n326\t  async function runLoop(st: ThreadDrainState): Promise<void> {\n327\t    // Defer past the committing operation's synchronous tail so the drain\n328\t    // never contends with the transaction whose commit scheduled it.\n329\t    await new Promise((resolve) => scheduleMacrotask(resolve));\n330\t    let lastReport: DrainReport | undefined;\n331\t    try {\n332\t      do {\n333\t        st.pending = false;\n334\t        st.passes += 1;\n335\t        // A failed pass (storage error) has no caller to report to in\n336\t        // background mode; the durable rows are untouched and the next poke\n337\t        // or touch retries. A pass stopping on \"waiting\" leaves a backing-off\n338\t        // head — handled below by arming a single eligibility wake.\n339\t        const result = await runDrain(st.filePath, deps);\n340\t        lastReport = result.ok ? result.value : undefined;\n341\t      } while (st.pending);\n342\t    } finally {\n343\t      st.running = false;\n344\t      // Fix 1 (DD-4 completion): honor eligibility in background mode. A pass\n345\t      // that stopped on \"waiting\" left a backing-off head that no later poke is\n346\t      // guaranteed to revisit; arm one wake at its eligible_at through the poke\n347\t      // path and stay unsettled until it fires, so drainSettled awaits the\n348\t      // retry. Any other stop reason (empty / max_items / in_flight, or a\n349\t      // failed pass) settles the thread now.\n350\t      if (\n351\t        st.wakeTimer === undefined &&\n352\t        lastReport?.stoppedBecause === \"waiting\" &&\n353\t        lastReport.waitingUntil !== undefined\n354\t      ) {\n355\t        armWake(st, lastReport.waitingUntil);\n356\t        return; // waiters resolve when the wake's drain settles, not here\n357\t      }\n358\t      for (const waiter of st.waiters.splice(0)) waiter();\n359\t    }\n360\t  }\n361\t\n362\t  function schedule(threadId: string): void {\n363\t    const st = stateFor(threadId);\n364\t    // A poke (or the wake itself) supersedes any pending backoff wake — we are\n365\t    // about to drain or coalesce, so the timer's job is done (one wake max).\n366\t    clearWake(st);\n367\t    if (st.filePath === \"\") return; // never touched here: no path to drain\n368\t    if (st.running) {\n369\t      st.pending = true; // burst coalesce: at most one further pass (AC-1.2)\n370\t      return;\n371\t    }\n372\t    st.running = true;\n373\t    void runLoop(st);\n374\t  }\n375\t\n376\t  return {\n377\t    mode,\n378\t    poke(threadId: string): void {\n379\t      if (mode !== \"background\") return;\n380\t      if (!deps.hasAnyHandler()) return;\n381\t      schedule(threadId);\n382\t    },\n383\t    touch(filePath: string, db: DatabaseSync): void {\n384\t      if (mode !== \"background\") return;\n385\t      const threadId = readThreadId(db);\n386\t      if (threadId === null) return;\n387\t      const st = stateFor(threadId);\n388\t      st.filePath = filePath;\n389\t      if (seen.has(threadId)) return;\n390\t      seen.add(threadId);\n391\t      // Catch-up (DD-10): leftover live work from a previous process runs on\n392\t      // first touch. One indexed query on the already-open handle keeps the\n393\t      // empty-queue case cheap.\n394\t      if (deps.hasAnyHandler() && countLiveItems(db) > 0) schedule(threadId);\n395\t    },\n396\t    drainSettled(threadId: string): Promise<void> {\n397\t      const st = states.get(threadId);\n398\t      // A pending backoff wake counts as unsettled (Fix 1): the retry it will\n399\t      // fire is part of this drain cycle, so the awaitable must span it.\n400\t      if (\n401\t        st === undefined ||\n402\t        (!st.running && !st.pending && st.wakeTimer === undefined)\n403\t      ) {\n404\t        return Promise.resolve();\n405\t      }\n406\t      return new Promise((resolve) => st.waiters.push(resolve));\n407\t    },\n408\t    testPassCount(threadId: string): number {\n409\t      return states.get(threadId)?.passes ?? 0;\n410\t    },\n411\t  };\n412\t}\n413\t"}]},"parent_tool_use_id":null,"session_id":"14af1c76-5e3a-4e59-acc7-c3c9d062b23f","uuid":"57dd5cf7-92ad-4876-ac9f-6163232ba751","timestamp":"2026-06-11T17:10:16.832Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/scheduler.ts","content":"\nexport interface Scheduler {\n  readonly mode: SchedulerMode;\n  // Post-commit nudge that work was queued for a thread (DD-5). Manual mode:\n  // no-op by contract. Background mode: starts a drain, or coalesces into\n  // the pending flag if one is already running for the thread (AC-1.2).\n  poke(threadId: string): void;\n  // Thread-file open announcement (DD-10): learns threadId → filePath and,\n  // on the first touch of a thread this process lifetime, schedules a\n  // catch-up drain if the queue has leftover live work (AC-1.6).\n  touch(filePath: string, db: DatabaseSync): void;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3). Manual mode resolves immediately.\n  drainSettled(threadId: string): Promise<void>;\n  // Test-only observability for coalescing exactness (TC-1.2): drain passes\n  // started for a thread. Named as a test hook on purpose — not API.\n  testPassCount(threadId: string): number;\n}\n\nfunction readThreadId(db: DatabaseSync): string | null {\n  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n    | { thread_id: string }\n    | undefined;\n  return row?.thread_id ?? null;\n}\n\n// Read a thread file's id without side effects (no migration, no touch) —\n// drainSettled must observe scheduler state, never schedule work.\nexport function peekThreadId(filePath: string): string | null {\n  if (!existsSync(filePath)) return null;\n  let db: DatabaseSync | undefined;\n  try {\n    db = new DatabaseSync(filePath, { readOnly: true });\n    return readThreadId(db);\n  } catch {\n    return null;\n  } finally {\n    db?.close();\n  }\n}\n\nexport function createScheduler(mode: SchedulerMode, deps: DrainDeps): Scheduler {\n  const states = new Map<string, ThreadDrainState>();\n  const seen = new Set<string>(); // first-touch catch-up guard, process lifetime\n\n  function stateFor(threadId: string): ThreadDrainState {\n    let st = states.get(threadId);\n    if (st === undefined) {\n      st = {\n        threadId,\n        filePath: \"\",\n        running: false,\n        pending: false,\n        passes: 0,\n        waiters: [],\n        wakeTimer: undefined,\n      };\n      states.set(threadId, st);\n    }\n    return st;\n  }\n\n  function clearWake(st: ThreadDrainState): void {\n    if (st.wakeTimer !== undefined) {\n      cancelTimer(st.wakeTimer);\n      st.wakeTimer = undefined;\n    }\n  }\n\n  // Arm the lone backoff wake (Fix 1): when a background pass stops on the\n  // eligibility gate, schedule a single nudge at the head's eligible_at that\n  // re-enters the existing poke path. The delay reads the SDK clock seam (no\n  // fresh Date here — E02-NB-001) and is floored to a sane minimum; correctness\n  // rides claimNext's durable gate, so a coarse timer never retries early.\n  function armWake(st: ThreadDrainState, waitingUntil: string): void {\n    clearWake(st);\n    const nowMs = deps.config.clock().getTime();\n    const delay = Math.max(WAKE_MIN_DELAY_MS, Date.parse(waitingUntil) - nowMs);\n    const timer = scheduleTimer(() => {\n      st.wakeTimer = undefined;\n      schedule(st.threadId);\n    }, delay);\n    timer.unref();\n    st.wakeTimer = timer;\n  }\n\n  async function runLoop(st: ThreadDrainState): Promise<void> {\n    // Defer past the committing operation's synchronous tail so the drain\n    // never contends with the transaction whose commit scheduled it.\n    await new Promise((resolve) => scheduleMacrotask(resolve));\n    let lastReport: DrainReport | undefined;\n    try {\n      do {\n        st.pending = false;\n        st.passes += 1;\n        // A failed pass (storage error) has no caller to report to in\n        // background mode; the durable rows are untouched and the next poke\n        // or touch retries. A pass stopping on \"waiting\" leaves a backing-off\n        // head — handled below by arming a single eligibility wake.\n        const result = await runDrain(st.filePath, deps);\n        lastReport = result.ok ? result.value : undefined;\n      } while (st.pending);\n    } finally {\n      st.running = false;\n      // Fix 1 (DD-4 completion): honor eligibility in background mode. A pass\n      // that stopped on \"waiting\" left a backing-off head that no later poke is\n      // guaranteed to revisit; arm one wake at its eligible_at through the poke\n      // path and stay unsettled until it fires, so drainSettled awaits the\n      // retry. Any other stop reason (empty / max_items / in_flight, or a\n      // failed pass) settles the thread now.\n      if (\n        st.wakeTimer === undefined &&\n        lastReport?.stoppedBecause === \"waiting\" &&\n        lastReport.waitingUntil !== undefined\n      ) {\n        armWake(st, lastReport.waitingUntil);\n        return; // waiters resolve when the wake's drain settles, not here\n      }\n      for (const waiter of st.waiters.splice(0)) waiter();\n    }\n  }\n\n  function schedule(threadId: string): void {\n    const st = stateFor(threadId);\n    // A poke (or the wake itself) supersedes any pending backoff wake — we are\n    // about to drain or coalesce, so the timer's job is done (one wake max).\n    clearWake(st);\n    if (st.filePath === \"\") return; // never touched here: no path to drain\n    if (st.running) {\n      st.pending = true; // burst coalesce: at most one further pass (AC-1.2)\n      return;\n    }\n    st.running = true;\n    void runLoop(st);\n  }\n\n  return {\n    mode,\n    poke(threadId: string): void {\n      if (mode !== \"background\") return;\n      if (!deps.hasAnyHandler()) return;\n      schedule(threadId);\n    },\n    touch(filePath: string, db: DatabaseSync): void {\n      if (mode !== \"background\") return;\n      const threadId = readThreadId(db);\n      if (threadId === null) return;\n      const st = stateFor(threadId);\n      st.filePath = filePath;\n      if (seen.has(threadId)) return;\n      seen.add(threadId);\n      // Catch-up (DD-10): leftover live work from a previous process runs on\n      // first touch. One indexed query on the already-open handle keeps the\n      // empty-queue case cheap.\n      if (deps.hasAnyHandler() && countLiveItems(db) > 0) schedule(threadId);\n    },\n    drainSettled(threadId: string): Promise<void> {\n      const st = states.get(threadId);\n      // A pending backoff wake counts as unsettled (Fix 1): the retry it will\n      // fire is part of this drain cycle, so the awaitable must span it.\n      if (\n        st === undefined ||\n        (!st.running && !st.pending && st.wakeTimer === undefined)\n      ) {\n        return Promise.resolve();\n      }\n      return new Promise((resolve) => st.waiters.push(resolve));\n    },\n    testPassCount(threadId: string): number {\n      return states.get(threadId)?.passes ?? 0;\n    },\n  };\n}\n","numLines":174,"startLine":240,"totalLines":413}}}

{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/scheduler.ts | sed -n '250,430p'\"","aggregated_output":"   250\t  touch(filePath: string, db: DatabaseSync): void;\n   251\t  // Resolves when the scheduler has no running or pending drain for the\n   252\t  // thread (issue 3). Manual mode resolves immediately.\n   253\t  drainSettled(threadId: string): Promise<void>;\n   254\t  // Test-only observability for coalescing exactness (TC-1.2): drain passes\n   255\t  // started for a thread. Named as a test hook on purpose — not API.\n   256\t  testPassCount(threadId: string): number;\n   257\t}\n   258\t\n   259\tfunction readThreadId(db: DatabaseSync): string | null {\n   260\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n   261\t    | { thread_id: string }\n   262\t    | undefined;\n   263\t  return row?.thread_id ?? null;\n   264\t}\n   265\t\n   266\t// Read a thread file's id without side effects (no migration, no touch) —\n   267\t// drainSettled must observe scheduler state, never schedule work.\n   268\texport function peekThreadId(filePath: string): string | null {\n   269\t  if (!existsSync(filePath)) return null;\n   270\t  let db: DatabaseSync | undefined;\n   271\t  try {\n   272\t    db = new DatabaseSync(filePath, { readOnly: true });\n   273\t    return readThreadId(db);\n   274\t  } catch {\n   275\t    return null;\n   276\t  } finally {\n   277\t    db?.close();\n   278\t  }\n   279\t}\n   280\t\n   281\texport function createScheduler(mode: SchedulerMode, deps: DrainDeps): Scheduler {\n   282\t  const states = new Map<string, ThreadDrainState>();\n   283\t  const seen = new Set<string>(); // first-touch catch-up guard, process lifetime\n   284\t\n   285\t  function stateFor(threadId: string): ThreadDrainState {\n   286\t    let st = states.get(threadId);\n   287\t    if (st === undefined) {\n   288\t      st = {\n   289\t        threadId,\n   290\t        filePath: \"\",\n   291\t        running: false,\n   292\t        pending: false,\n   293\t        passes: 0,\n   294\t        waiters: [],\n   295\t        wakeTimer: undefined,\n   296\t      };\n   297\t      states.set(threadId, st);\n   298\t    }\n   299\t    return st;\n   300\t  }\n   301\t\n   302\t  function clearWake(st: ThreadDrainState): void {\n   303\t    if (st.wakeTimer !== undefined) {\n   304\t      cancelTimer(st.wakeTimer);\n   305\t      st.wakeTimer = undefined;\n   306\t    }\n   307\t  }\n   308\t\n   309\t  // Arm the lone backoff wake (Fix 1): when a background pass stops on the\n   310\t  // eligibility gate, schedule a single nudge at the head's eligible_at that\n   311\t  // re-enters the existing poke path. The delay reads the SDK clock seam (no\n   312\t  // fresh Date here — E02-NB-001) and is floored to a sane minimum; correctness\n   313\t  // rides claimNext's durable gate, so a coarse timer never retries early.\n   314\t  function armWake(st: ThreadDrainState, waitingUntil: string): void {\n   315\t    clearWake(st);\n   316\t    const nowMs = deps.config.clock().getTime();\n   317\t    const delay = Math.max(WAKE_MIN_DELAY_MS, Date.parse(waitingUntil) - nowMs);\n   318\t    const timer = scheduleTimer(() => {\n   319\t      st.wakeTimer = undefined;\n   320\t      schedule(st.threadId);\n   321\t    }, delay);\n   322\t    timer.unref();\n   323\t    st.wakeTimer = timer;\n   324\t  }\n   325\t\n   326\t  async function runLoop(st: ThreadDrainState): Promise<void> {\n   327\t    // Defer past the committing operation's synchronous tail so the drain\n   328\t    // never contends with the transaction whose commit scheduled it.\n   329\t    await new Promise((resolve) => scheduleMacrotask(resolve));\n   330\t    let lastReport: DrainReport | undefined;\n   331\t    try {\n   332\t      do {\n   333\t        st.pending = false;\n   334\t        st.passes += 1;\n   335\t        // A failed pass (storage error) has no caller to report to in\n   336\t        // background mode; the durable rows are untouched and the next poke\n   337\t        // or touch retries. A pass stopping on \"waiting\" leaves a backing-off\n   338\t        // head — handled below by arming a single eligibility wake.\n   339\t        const result = await runDrain(st.filePath, deps);\n   340\t        lastReport = result.ok ? result.value : undefined;\n   341\t      } while (st.pending);\n   342\t    } finally {\n   343\t      st.running = false;\n   344\t      // Fix 1 (DD-4 completion): honor eligibility in background mode. A pass\n   345\t      // that stopped on \"waiting\" left a backing-off head that no later poke is\n   346\t      // guaranteed to revisit; arm one wake at its eligible_at through the poke\n   347\t      // path and stay unsettled until it fires, so drainSettled awaits the\n   348\t      // retry. Any other stop reason (empty / max_items / in_flight, or a\n   349\t      // failed pass) settles the thread now.\n   350\t      if (\n   351\t        st.wakeTimer === undefined &&\n   352\t        lastReport?.stoppedBecause === \"waiting\" &&\n   353\t        lastReport.waitingUntil !== undefined\n   354\t      ) {\n   355\t        armWake(st, lastReport.waitingUntil);\n   356\t        return; // waiters resolve when the wake's drain settles, not here\n   357\t      }\n   358\t      for (const waiter of st.waiters.splice(0)) waiter();\n   359\t    }\n   360\t  }\n   361\t\n   362\t  function schedule(threadId: string): void {\n   363\t    const st = stateFor(threadId);\n   364\t    // A poke (or the wake itself) supersedes any pending backoff wake — we are\n   365\t    // about to drain or coalesce, so the timer's job is done (one wake max).\n   366\t    clearWake(st);\n   367\t    if (st.filePath === \"\") return; // never touched here: no path to drain\n   368\t    if (st.running) {\n   369\t      st.pending = true; // burst coalesce: at most one further pass (AC-1.2)\n   370\t      return;\n   371\t    }\n   372\t    st.running = true;\n   373\t    void runLoop(st);\n   374\t  }\n   375\t\n   376\t  return {\n   377\t    mode,\n   378\t    poke(threadId: string): void {\n   379\t      if (mode !== \"background\") return;\n   380\t      if (!deps.hasAnyHandler()) return;\n   381\t      schedule(threadId);\n   382\t    },\n   383\t    touch(filePath: string, db: DatabaseSync): void {\n   384\t      if (mode !== \"background\") return;\n   385\t      const threadId = readThreadId(db);\n   386\t      if (threadId === null) return;\n   387\t      const st = stateFor(threadId);\n   388\t      st.filePath = filePath;\n   389\t      if (seen.has(threadId)) return;\n   390\t      seen.add(threadId);\n   391\t      // Catch-up (DD-10): leftover live work from a previous process runs on\n   392\t      // first touch. One indexed query on the already-open handle keeps the\n   393\t      // empty-queue case cheap.\n   394\t      if (deps.hasAnyHandler() && countLiveItems(db) > 0) schedule(threadId);\n   395\t    },\n   396\t    drainSettled(threadId: string): Promise<void> {\n   397\t      const st = states.get(threadId);\n   398\t      // A pending backoff wake counts as unsettled (Fix 1): the retry it will\n   399\t      // fire is part of this drain cycle, so the awaitable must span it.\n   400\t      if (\n   401\t        st === undefined ||\n   402\t        (!st.running && !st.pending && st.wakeTimer === undefined)\n   403\t      ) {\n   404\t        return Promise.resolve();\n   405\t      }\n   406\t      return new Promise((resolve) => st.waiters.push(resolve));\n   407\t    },\n   408\t    testPassCount(threadId: string): number {\n   409\t      return states.get(threadId)?.passes ?? 0;\n   410\t    },\n   411\t  };\n   412\t}\n","exit_code":0,"status":"completed"}}

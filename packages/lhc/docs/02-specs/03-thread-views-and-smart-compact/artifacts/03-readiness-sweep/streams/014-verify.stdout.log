{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/receipt-schema.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// The shared SweepReceipt schema (TC-3.3, AC-3.5/AC-3.7): one structural\n     2\t// validator both the SDK leg (view-sweep.test.ts, Story 3) and the spawned\n     3\t// CLI parity leg (cli-process-view.test.ts, Story 5) assert against — \"same\n     4\t// receipt shape\" is proven by both targets passing the same checker, not by\n     5\t// two hand-kept assertion lists drifting apart.\n     6\timport type { SweepReceipt } from \"../../src/index.js\";\n     7\t\n     8\tfunction fail(path: string, expected: string, actual: unknown): never {\n     9\t  throw new Error(\n    10\t    `SweepReceipt schema violation at ${path}: expected ${expected}, got ${JSON.stringify(actual)}`,\n    11\t  );\n    12\t}\n    13\t\n    14\tfunction assertCount(value: unknown, path: string): void {\n    15\t  if (typeof value !== \"number\" || !Number.isInteger(value) || value < 0) {\n    16\t    fail(path, \"a non-negative integer\", value);\n    17\t  }\n    18\t}\n    19\t\n    20\tfunction assertSubjectReasonList(value: unknown, path: string): void {\n    21\t  if (!Array.isArray(value)) fail(path, \"an array\", value);\n    22\t  value.forEach((item, i) => {\n    23\t    if (typeof item !== \"object\" || item === null) fail(`${path}[${i}]`, \"an object\", item);\n    24\t    const entry = item as Record<string, unknown>;\n    25\t    if (typeof entry.subjectId !== \"string\" || entry.subjectId === \"\") {\n    26\t      fail(`${path}[${i}].subjectId`, \"a non-empty string\", entry.subjectId);\n    27\t    }\n    28\t    if (typeof entry.reason !== \"string\" || entry.reason === \"\") {\n    29\t      fail(`${path}[${i}].reason`, \"a non-empty string\", entry.reason);\n    30\t    }\n    31\t  });\n    32\t}\n    33\t\n    34\texport function assertSweepReceiptShape(value: unknown): asserts value is SweepReceipt {\n    35\t  if (typeof value !== \"object\" || value === null) fail(\"receipt\", \"an object\", value);\n    36\t  const receipt = value as Record<string, unknown>;\n    37\t  if (!Array.isArray(receipt.owners)) fail(\"receipt.owners\", \"an array\", receipt.owners);\n    38\t  receipt.owners.forEach((line, i) => {\n    39\t    const path = `owners[${i}]`;\n    40\t    if (typeof line !== \"object\" || line === null) fail(path, \"an object\", line);\n    41\t    const entry = line as Record<string, unknown>;\n    42\t    if (entry.owner !== \"messages\" && entry.owner !== \"turns\") {\n    43\t      fail(`${path}.owner`, '\"messages\" | \"turns\"', entry.owner);\n    44\t    }\n    45\t    if (typeof entry.kind !== \"string\" || entry.kind === \"\") {\n    46\t      fail(`${path}.kind`, \"a non-empty string\", entry.kind);\n    47\t    }\n    48\t    assertCount(entry.ready, `${path}.ready`);\n    49\t    assertCount(entry.inFlight, `${path}.inFlight`);\n    50\t    if (\n    51\t      !Array.isArray(entry.requeued) ||\n    52\t      entry.requeued.some((id) => typeof id !== \"string\" || id === \"\")\n    53\t    ) {\n    54\t      fail(`${path}.requeued`, \"an array of non-empty subject-id strings\", entry.requeued);\n    55\t    }\n    56\t    assertSubjectReasonList(entry.blocked, `${path}.blocked`);\n    57\t    assertSubjectReasonList(entry.permanentFailed, `${path}.permanentFailed`);\n    58\t  });\n    59\t}\n","exit_code":0,"status":"completed"}}

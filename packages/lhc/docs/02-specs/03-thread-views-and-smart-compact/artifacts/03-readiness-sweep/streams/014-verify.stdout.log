{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/view-sweep.test.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Epic 03 Story 3: the readiness sweep (TC-3.1–3.4, the classification-edge\n     2\t// architecture-risk legs, and the suite-wide zero-provider assertion's\n     3\t// completion across all five thread-view ops). Every TC goes through the\n     4\t// real SDK surface (createSdk().threadView.sweep / .compact) against real\n     5\t// temp thread files; the provider double appears only in fixture setup and\n     6\t// in TC-3.4's sanctioned heal drain — no Epic 03 operation may touch it.\n     7\t// Failed and blocked states are reached through production paths (scripted\n     8\t// provider failures consumed by real retry/exhaustion mechanics, real source\n     9\t// damage on the sacrificial sibling), never by writing derived_form rows.\n    10\timport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\n    11\timport { createSdk, type Lhc, type SweepReceipt } from \"../src/index.js\";\n    12\timport {\n    13\t  assertSweepReceiptShape,\n    14\t  blockedSiblingThread,\n    15\t  classifyFailureReason,\n    16\t  createProviderDouble,\n    17\t  derivedThreadFixture,\n    18\t  openRaw,\n    19\t  PERMANENT_FAILURE_REASON,\n    20\t  REASON_CLASS_TABLE,\n    21\t  seedViewBoundary,\n    22\t  tempStore,\n    23\t  validEvent,\n    24\t  type DerivedThreadFixture,\n    25\t  type TempStore,\n    26\t} from \"./fixtures/index.js\";\n    27\t\n    28\ttype OwnerLine = SweepReceipt[\"owners\"][number];\n    29\t\n    30\tfunction ownerLine(\n    31\t  receipt: SweepReceipt,\n    32\t  owner: OwnerLine[\"owner\"],\n    33\t  kind: string,\n    34\t): OwnerLine {\n    35\t  const line = receipt.owners.find((entry) => entry.owner === owner && entry.kind === kind);\n    36\t  if (line === undefined) throw new Error(`no receipt line for ${owner}/${kind}`);\n    37\t  return line;\n    38\t}\n    39\t\n    40\t// Work rows for one subject's rebuild, counted by key below the SDK\n    41\t// (TC-3.2's \"exactly one work row exists for it\"). The requeue patch keeps\n    42\t// the queue live-work-only, so any row here is queued or claimed work.\n    43\tfunction workRowsFor(filePath: string, kind: string, subjectId: string): number {\n    44\t  const db = openRaw(filePath);\n    45\t  try {\n    46\t    const row = db\n    47\t      .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE kind = ? AND source_ref LIKE ?`)\n    48\t      .get(kind, `%\"${subjectId}\"%`) as { n: number | bigint };\n    49\t    return Number(row.n);\n    50\t  } finally {\n    51\t    db.close();\n    52\t  }\n    53\t}\n    54\t\n    55\tfunction workItemCount(filePath: string): number {\n    56\t  const db = openRaw(filePath);\n    57\t  try {\n    58\t    const row = db.prepare(`SELECT COUNT(*) AS n FROM work_item`).get() as {\n    59\t      n: number | bigint;\n    60\t    };\n    61\t    return Number(row.n);\n    62\t  } finally {\n    63\t    db.close();\n    64\t  }\n    65\t}\n    66\t\n    67\tasync function reportEntry(\n    68\t  sdk: Lhc,\n    69\t  filePath: string,\n    70\t  messageId: string,\n    71\t  form: string,\n    72\t): Promise<{ state: string; reason?: string; queueStatus?: string; content?: string }> {\n    73\t  const report = await sdk.messages.report({ filePath }, { messageId });\n    74\t  if (!report.ok) throw new Error(`report failed: ${report.error.reason}`);\n    75\t  const entry = report.value.find((row) => row.form === form);\n    76\t  if (entry === undefined) throw new Error(`no ${form} entry for ${messageId}`);\n    77\t  return {\n    78\t    state: entry.state,\n    79\t    ...(entry.reason === undefined ? {} : { reason: entry.reason }),\n    80\t    ...(entry.queue === undefined ? {} : { queueStatus: entry.queue.status }),\n    81\t    ...(entry.content === undefined ? {} : { content: entry.content }),\n    82\t  };\n    83\t}\n    84\t\n    85\tdescribe(\"TC-3.1–TC-3.3 (AC-3.1–3.5, 3.7): the standalone sweep over the seeded states\", () => {\n    86\t  let store: TempStore;\n    87\t  let fixture: DerivedThreadFixture;\n    88\t  let transientId: string;\n    89\t  let permanentId: string;\n    90\t  let firstReceipt: SweepReceipt;\n    91\t\n    92\t  beforeAll(async () => {\n    93\t    store = tempStore();\n    94\t    fixture = await derivedThreadFixture(store);\n    95\t    transientId = fixture.failedTransientMessageId ?? \"\";\n    96\t    permanentId = fixture.failedPermanentMessageId ?? \"\";\n    97\t    if (transientId === \"\" || permanentId === \"\") {\n    98\t      throw new Error(\"fixture did not record the manufactured failed subjects\");\n    99\t    }\n   100\t    // The pending leg of the seed: one more closed turn, NOT drained (manual\n   101\t    // mode never drains uninvoked), so its smoothed_prompt and turn forms sit\n   102\t    // pending with live queue rows when the sweep walks the reports.\n   103\t    const sent = await fixture.sdk.intakeStream.messageEvents({ filePath: fixture.filePath }, [\n   104\t      validEvent(\"user_prompt\", { payload: { text: \"extra pending turn for the sweep seed\" } }),\n   105\t      validEvent(\"assistant_text\", { payload: { text: \"left undrained on purpose\" } }),\n   106\t      validEvent(\"turn_end\"),\n   107\t    ]);\n   108\t    if (!sent.ok) throw new Error(`extra-turn intake failed: ${sent.error.reason}`);\n   109\t  });\n   110\t  afterAll(() => {\n   111\t    store.cleanup();\n   112\t  });\n   113\t\n   114\t  it(\"TC-3.1: buckets the five seeded states, requeues only the transient failure, returns without waiting, zero provider calls\", async () => {\n   115\t    const captured = fixture.double.captureInputs();\n   116\t    expect(workRowsFor(fixture.filePath, \"tool_result_summary\", transientId)).toBe(0);\n   117\t\n   118\t    const startedAt = Date.now();\n   119\t    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\n   120\t    const elapsedMs = Date.now() - startedAt;\n   121\t    expect(swept.ok).toBe(true);\n   122\t    if (!swept.ok) return;\n   123\t    firstReceipt = swept.value;\n   124\t\n   125\t    // No waiting (AC-3.2): the sweep is report reads plus row writes; any\n   126\t    // drain or poll inside it would blow this bound (anti-shim tripwire).\n   127\t    expect(elapsedMs).toBeLessThan(1000);\n   128\t\n   129\t    // The tool_result_summary line carries the story's whole failed×classify\n   130\t    // contract: 6 of the fixture's 8 results drained ready, the scripted\n   131\t    // transient exhaustion requeued, the scripted permanent failure reported\n   132\t    // with its reason and left alone (AC-3.3, AC-3.5).\n   133\t    const results = ownerLine(swept.value, \"messages\", \"tool_result_summary\");\n   134\t    expect(results.ready).toBe(6);\n   135\t    expect(results.requeued).toEqual([transientId]);\n   136\t    expect(results.permanentFailed).toEqual([\n   137\t      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\n   138\t    ]);\n   139\t    expect(results.blocked).toEqual([]);\n   140\t\n   141\t    // Pending forms are left alone and reported as in-flight: the undrained\n   142\t    // extra turn's prompt smoothing (messages) and turn derivation (turns).\n   143\t    const prompts = ownerLine(swept.value, \"messages\", \"smoothed_prompt\");\n   144\t    expect(prompts.ready).toBe(12);\n   145\t    expect(prompts.inFlight).toBe(1);\n   146\t    expect(prompts.requeued).toEqual([]);\n   147\t    const renderings = ownerLine(swept.value, \"turns\", \"turn_rendering\");\n   148\t    expect(renderings.ready).toBe(12);\n   149\t    expect(renderings.inFlight).toBe(1);\n   150\t    expect(renderings.requeued).toEqual([]);\n   151\t\n   152\t    // The transient requeue really landed through the owner: one work row by\n   153\t    // key, form cleared to pending with its queue row visible (AC-3.1's\n   154\t    // owners-only write path read back through the owner's report).\n   155\t    expect(workRowsFor(fixture.filePath, \"tool_result_summary\", transientId)).toBe(1);\n   156\t    const transient = await reportEntry(\n   157\t      fixture.sdk,\n   158\t      fixture.filePath,\n   159\t      transientId,\n   160\t      \"tool_result_summary\",\n   161\t    );\n   162\t    expect(transient.state).toBe(\"pending\");\n   163\t    expect(transient.queueStatus).toBe(\"queued\");\n   164\t\n   165\t    // The permanent failure is untouched: still failed, no work row.\n   166\t    const permanent = await reportEntry(\n   167\t      fixture.sdk,\n   168\t      fixture.filePath,\n   169\t      permanentId,\n   170\t      \"tool_result_summary\",\n   171\t    );\n   172\t    expect(permanent.state).toBe(\"failed\");\n   173\t    expect(permanent.reason).toBe(PERMANENT_FAILURE_REASON);\n   174\t    expect(workRowsFor(fixture.filePath, \"tool_result_summary\", permanentId)).toBe(0);\n   175\t\n   176\t    // Nothing requeued anywhere else, and the sweep itself called no\n   177\t    // provider (AC-3.1: no derivation, no model calls).\n   178\t    const allRequeued = swept.value.owners.flatMap((line) => line.requeued);\n   179\t    expect(allRequeued).toEqual([transientId]);\n   180\t    expect(captured.length).toBe(0);\n   181\t  });\n   182\t\n   183\t  it(\"TC-3.2 (AC-3.4): a second sweep without draining reports the requeued form in-flight and writes no second row\", async () => {\n   184\t    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\n   185\t    expect(swept.ok).toBe(true);\n   186\t    if (!swept.ok) return;\n   187\t\n   188\t    const results = ownerLine(swept.value, \"messages\", \"tool_result_summary\");\n   189\t    expect(results.requeued).toEqual([]);\n   190\t    expect(results.inFlight).toBe(1);\n   191\t    expect(results.ready).toBe(6);\n   192\t    expect(results.permanentFailed).toEqual([\n   193\t      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\n   194\t    ]);\n   195\t\n   196\t    // Exactly one work row exists for the requeued form (count by key).\n   197\t    expect(workRowsFor(fixture.filePath, \"tool_result_summary\", transientId)).toBe(1);\n   198\t  });\n   199\t\n   200\t  it(\"TC-3.3 schema leg (AC-3.5, AC-3.7): the SDK receipt validates against the shared receipt schema\", async () => {\n   201\t    // The same checker Story 5's spawned CLI leg asserts against — \"same\n   202\t    // receipt shape\" is one validator passing both targets, not two\n   203\t    // hand-kept assertion lists.\n   204\t    expect(() => assertSweepReceiptShape(firstReceipt)).not.toThrow();\n   205\t    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\n   206\t    expect(swept.ok).toBe(true);\n   207\t    if (!swept.ok) return;\n   208\t    expect(() => assertSweepReceiptShape(swept.value)).not.toThrow();\n   209\t    // Counts and reasons match the seeds across invocations: the receipt is\n   210\t    // an accounting of durable state, not of sweep-local bookkeeping.\n   211\t    expect(ownerLine(swept.value, \"messages\", \"tool_result_summary\").permanentFailed).toEqual([\n   212\t      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\n   213\t    ]);\n   214\t  });\n   215\t\n   216\t  it(\"zero-provider assertion across all five ops (architecture-risk): pull, status, compact, sweep, materialize\", async () => {\n   217\t    const captured = fixture.double.captureInputs();\n   218\t    const before = captured.length;\n   219\t\n   220\t    const pulled = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n   221\t    const status = await fixture.sdk.threadView.status({ filePath: fixture.filePath });\n   222\t    const compacted = await fixture.sdk.threadView.compact(\n   223\t      { filePath: fixture.filePath },\n   224\t      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 25, brief: 25 } } },\n   225\t    );\n   226\t    const swept = await fixture.sdk.threadView.sweep({ filePath: fixture.filePath });\n   227\t    const materialized = await fixture.sdk.threadView.materialize(\n   228\t      { filePath: fixture.filePath },\n   229\t      { path: `${fixture.filePath}.out.jsonl` },\n   230\t    );\n   231\t\n   232\t    expect(pulled.ok && status.ok && compacted.ok && swept.ok).toBe(true);\n   233\t    expect(materialized.ok).toBe(false); // Story 5's stub — still no provider\n   234\t    expect(captured.length).toBe(before);\n   235\t  });\n   236\t});\n   237\t\n   238\tdescribe(\"classification edges (architecture-risk): blocked, in-walk dedupe, unclassified\", () => {\n   239\t  let store: TempStore;\n   240\t\n   241\t  beforeAll(() => {\n   242\t    store = tempStore();\n   243\t  });\n   244\t  afterAll(() => {\n   245\t    store.cleanup();\n   246\t  });\n   247\t\n   248\t  it(\"blocked forms are reported with their stored reasons and never requeued\", async () => {\n   249\t    const sibling = await blockedSiblingThread(store);\n   250\t    const rowsBefore = workItemCount(sibling.filePath);\n   251\t\n   252\t    const swept = await sibling.sdk.threadView.sweep({ filePath: sibling.filePath });\n   253\t    expect(swept.ok).toBe(true);\n   254\t    if (!swept.ok) return;\n   255\t\n   256\t    // The damaged turn landed both turn forms blocked through the production\n   257\t    // terminal path; the sweep reports each with its reason and asks the\n   258\t    // owners for nothing.\n   259\t    for (const kind of [\"turn_rendering\", \"lower_band_projection\"]) {\n   260\t      const line = ownerLine(swept.value, \"turns\", kind);\n   261\t      expect(line.blocked).toHaveLength(1);\n   262\t      expect(line.blocked[0]?.subjectId).toBe(sibling.blockedTurnId);\n   263\t      expect(line.blocked[0]?.reason).not.toBe(\"\");\n   264\t      expect(line.requeued).toEqual([]);\n   265\t    }\n   266\t    expect(swept.value.owners.flatMap((line) => line.requeued)).toEqual([]);\n   267\t    expect(workItemCount(sibling.filePath)).toBe(rowsBefore);\n   268\t  });\n   269\t\n   270\t  it(\"once-per-invocation dedupe is structural: a turn's two transiently-failed forms share one work row, the second ask noops to in-flight\", async () => {\n   271\t    // Both turn forms exhaust together through real retry mechanics (one\n   272\t    // turn_derivation item rebuilds both), so the sweep's walk meets two\n   273\t    // failed transient entries that share one queue site — the owner's\n   274\t    // already_queued noop is what keeps the second ask from double-queuing,\n   275\t    // and this test is what notices if Epic 02's requeue ever stops nooping.\n   276\t    const double = createProviderDouble();\n   277\t    const sdk = createSdk({\n   278\t      provider: double,\n   279\t      mode: \"manual\",\n   280\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n   281\t    });\n   282\t    const filePath = store.threadPath();\n   283\t    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   284\t    expect(created.ok).toBe(true);\n   285\t\n   286\t    double.failKind(\"turn_rendering\", 3, {\n   287\t      retryable: true,\n   288\t      reason: \"timeout: scripted turn exhaustion (test)\",\n   289\t    });\n   290\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\n   291\t      validEvent(\"user_prompt\", { payload: { text: \"a turn whose derivation exhausts\" } }),\n   292\t      validEvent(\"assistant_text\", { payload: { text: \"an answer\" } }),\n   293\t      validEvent(\"turn_end\"),\n   294\t    ]);\n   295\t    expect(sent.ok).toBe(true);\n   296\t    const drained = await sdk.work.drain({ filePath });\n   297\t    expect(drained.ok).toBe(true);\n   298\t\n   299\t    expect(workRowsFor(filePath, \"turn_derivation\", \"t1\")).toBe(0);\n   300\t    const swept = await sdk.threadView.sweep({ filePath });\n   301\t    expect(swept.ok).toBe(true);\n   302\t    if (!swept.ok) return;\n   303\t\n   304\t    // One requeue, one noop-counted-as-in-flight, exactly one work row.\n   305\t    const rendering = ownerLine(swept.value, \"turns\", \"turn_rendering\");\n   306\t    const projection = ownerLine(swept.value, \"turns\", \"lower_band_projection\");\n   307\t    const requeued = [...rendering.requeued, ...projection.requeued];\n   308\t    expect(requeued).toEqual([\"t1\"]);\n   309\t    expect(rendering.inFlight + projection.inFlight).toBe(1);\n   310\t    expect(workRowsFor(filePath, \"turn_derivation\", \"t1\")).toBe(1);\n   311\t  });\n   312\t\n   313\t  it(\"an unclassified reason code lands in permanentFailed with its literal reason and is never requeued\", async () => {\n   314\t    const double = createProviderDouble();\n   315\t    const sdk = createSdk({\n   316\t      provider: double,\n   317\t      mode: \"manual\",\n   318\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n   319\t    });\n   320\t    const filePath = store.threadPath();\n   321\t    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   322\t    expect(created.ok).toBe(true);\n   323\t\n   324\t    // A terminal failure whose reason class the table has never heard of —\n   325\t    // persisted through the production write path, classified conservative.\n   326\t    const unclassifiedReason = \"mystery_code: gremlins in the pipeline\";\n   327\t    double.failKind(\"tool_result_summary\", 1, { retryable: false, reason: unclassifiedReason });\n   328\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\n   329\t      validEvent(\"user_prompt\", { payload: { text: \"run the tool\" } }),\n   330\t      validEvent(\"tool_call\", {\n   331\t        payload: { toolCallId: \"call-uc-1\", toolName: \"read_file\", arguments: { path: \"u.txt\" } },\n   332\t      }),\n   333\t      validEvent(\"tool_result\", {\n   334\t        payload: { toolCallId: \"call-uc-1\", content: \"unclassified-path output\", isError: false },\n   335\t      }),\n   336\t      validEvent(\"turn_end\"),\n   337\t    ]);\n   338\t    expect(sent.ok).toBe(true);\n   339\t    const messageIds = sent.ok ? sent.value.events.map((entry) => entry.messageId ?? \"\") : [];\n   340\t    const resultId = messageIds[2] ?? \"\";\n   341\t    expect(resultId).not.toBe(\"\");\n   342\t    const drained = await sdk.work.drain({ filePath });\n   343\t    expect(drained.ok).toBe(true);\n   344\t\n   345\t    const rowsBefore = workItemCount(filePath);\n   346\t    const swept = await sdk.threadView.sweep({ filePath });\n   347\t    expect(swept.ok).toBe(true);\n   348\t    if (!swept.ok) return;\n   349\t\n   350\t    const line = ownerLine(swept.value, \"messages\", \"tool_result_summary\");\n   351\t    expect(line.permanentFailed).toEqual([{ subjectId: resultId, reason: unclassifiedReason }]);\n   352\t    expect(line.requeued).toEqual([]);\n   353\t    expect(workItemCount(filePath)).toBe(rowsBefore);\n   354\t    const entry = await reportEntry(sdk, filePath, resultId, \"tool_result_summary\");\n   355\t    expect(entry.state).toBe(\"failed\");\n   356\t  });\n   357\t\n   358\t  it(\"the classification table is data: named classes map as designed, everything else is permanent\", () => {\n   359\t    expect(REASON_CLASS_TABLE).toEqual({\n   360\t      rate_limit: \"transient\",\n   361\t      timeout: \"transient\",\n   362\t      provider_unavailable: \"transient\",\n   363\t      content_refusal: \"permanent\",\n   364\t      validation: \"permanent\",\n   365\t      unknown_work_kind: \"permanent\",\n   366\t    });\n   367\t    expect(classifyFailureReason(\"rate_limit: provider said slow down\")).toBe(\"transient\");\n   368\t    expect(classifyFailureReason(\"timeout: no response in 30s\")).toBe(\"transient\");\n   369\t    expect(classifyFailureReason(\"provider_unavailable: 503\")).toBe(\"transient\");\n   370\t    expect(classifyFailureReason(\"content_refusal: declined\")).toBe(\"permanent\");\n   371\t    expect(classifyFailureReason(\"validation: bad output shape\")).toBe(\"permanent\");\n   372\t    expect(classifyFailureReason(\"unknown_work_kind: nonesuch\")).toBe(\"permanent\");\n   373\t    // The conservative default: unknown codes, codeless prose, and missing\n   374\t    // reasons all classify permanent — never a requeue on a guess.\n   375\t    expect(classifyFailureReason(\"mystery_code: gremlins\")).toBe(\"permanent\");\n   376\t    expect(classifyFailureReason(\"free prose with no class code\")).toBe(\"permanent\");\n   377\t    expect(classifyFailureReason(undefined)).toBe(\"permanent\");\n   378\t    expect(classifyFailureReason(\"\")).toBe(\"permanent\");\n   379\t  });\n   380\t});\n   381\t\n   382\tdescribe(\"TC-3.4 (AC-3.6, AC-2.7): the compact-embedded sweep, the skip, and the heal\", () => {\n   383\t  let store: TempStore;\n   384\t  let fixture: DerivedThreadFixture;\n   385\t  let transientId: string;\n   386\t  let permanentId: string;\n   387\t\n   388\t  beforeAll(async () => {\n   389\t    store = tempStore();\n   390\t    fixture = await derivedThreadFixture(store);\n   391\t    transientId = fixture.failedTransientMessageId ?? \"\";\n   392\t    permanentId = fixture.failedPermanentMessageId ?? \"\";\n   393\t    if (transientId === \"\" || permanentId === \"\") {\n   394\t      throw new Error(\"fixture did not record the manufactured failed subjects\");\n   395\t    }\n   396\t  });\n   397\t  afterAll(() => {\n   398\t    store.cleanup();\n   399\t  });\n   400\t\n   401\t  it(\"compact with sweep: false records the skip and requeues nothing\", async () => {\n   402\t    const rowsBefore = workItemCount(fixture.filePath);\n   403\t    const receipt = await fixture.sdk.threadView.compact(\n   404\t      { filePath: fixture.filePath },\n   405\t      { profile: \"coding\", sweep: false },\n   406\t    );\n   407\t    expect(receipt.ok).toBe(true);\n   408\t    if (!receipt.ok) return;\n   409\t    expect(receipt.value.sweep).toEqual({ skipped: true });\n   410\t\n   411\t    // Zero requeues occurred: no work row landed, the transient failure is\n   412\t    // still failed.\n   413\t    expect(workItemCount(fixture.filePath)).toBe(rowsBefore);\n   414\t    const transient = await reportEntry(\n   415\t      fixture.sdk,\n   416\t      fixture.filePath,\n   417\t      transientId,\n   418\t      \"tool_result_summary\",\n   419\t    );\n   420\t    expect(transient.state).toBe(\"failed\");\n   421\t  });\n   422\t\n   423\t  it(\"default compact embeds the sweep receipt; the drained requeue heals into the next compact's view\", async () => {\n   424\t    // Default compact through a BACKGROUND SDK: the sweep runs first and its\n   425\t    // full receipt embeds (Story 2's \"absent\" placeholder is gone from the\n   426\t    // vocabulary), and the embedded requeue's poke-on-commit lands on the\n   427\t    // background scheduler — the production repair path needs no drain call.\n   428\t    const bg = createSdk({ provider: createProviderDouble(), mode: \"background\" });\n   429\t    const receipt = await bg.threadView.compact(\n   430\t      { filePath: fixture.filePath },\n   431\t      { profile: \"coding\" },\n   432\t    );\n   433\t    expect(receipt.ok).toBe(true);\n   434\t    if (!receipt.ok) return;\n   435\t    const embedded = receipt.value.sweep;\n   436\t    expect(embedded).not.toEqual({ skipped: true });\n   437\t    if (!(\"owners\" in embedded)) return;\n   438\t    expect(() => assertSweepReceiptShape(embedded)).not.toThrow();\n   439\t    expect(ownerLine(embedded, \"messages\", \"tool_result_summary\").requeued).toEqual([\n   440\t      transientId,\n   441\t    ]);\n   442\t\n   443\t    // The heal leg — the one sanctioned test-setup use of inference\n   444\t    // machinery: drainSettled awaits the poked background drain over the\n   445\t    // requeued row. No Epic 03 operation below touches the provider.\n   446\t    await bg.drainSettled({ filePath: fixture.filePath });\n   447\t\n   448\t    const healed = await reportEntry(\n   449\t      fixture.sdk,\n   450\t      fixture.filePath,\n   451\t      transientId,\n   452\t      \"tool_result_summary\",\n   453\t    );\n   454\t    expect(healed.state).toBe(\"ready\");\n   455\t    expect(healed.content).toBeDefined();\n   456\t\n   457\t    // The next default compact sees the heal: its embedded sweep reports the\n   458\t    // form ready (7 now), nothing to requeue, only the permanent failure\n   459\t    // still on the books.\n   460\t    const next = await fixture.sdk.threadView.compact(\n   461\t      { filePath: fixture.filePath },\n   462\t      { profile: \"coding\" },\n   463\t    );\n   464\t    expect(next.ok).toBe(true);\n   465\t    if (!next.ok) return;\n   466\t    const nextSweep = next.value.sweep;\n   467\t    if (!(\"owners\" in nextSweep)) return;\n   468\t    const results = ownerLine(nextSweep, \"messages\", \"tool_result_summary\");\n   469\t    expect(results.ready).toBe(7);\n   470\t    expect(results.requeued).toEqual([]);\n   471\t    expect(results.permanentFailed).toEqual([\n   472\t      { subjectId: permanentId, reason: PERMANENT_FAILURE_REASON },\n   473\t    ]);\n   474\t\n   475\t    // And the healed form feeds the served view: with the coding bound this\n   476\t    // small thread is all tail (compact point 0), so seed the boundary at the\n   477\t    // healed result's position — the short form now renders the READY\n   478\t    // summary, the ladder's first rung, not the truncation fallback.\n   479\t    expect(next.value.compactPoint).toBe(0);\n   480\t    const listed = await fixture.sdk.messages.listMessages({ filePath: fixture.filePath });\n   481\t    expect(listed.ok).toBe(true);\n   482\t    if (!listed.ok) return;\n   483\t    const healedMessage = listed.value.find((m) => m.messageId === transientId);\n   484\t    expect(healedMessage).toBeDefined();\n   485\t    if (healedMessage === undefined) return;\n   486\t    seedViewBoundary(fixture.filePath, healedMessage.sourceEventOrder);\n   487\t\n   488\t    const pulled = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n   489\t    expect(pulled.ok).toBe(true);\n   490\t    if (!pulled.ok) return;\n   491\t    expect(pulled.value.messages.map((m) => m.content)).toContain(\n   492\t      `[tool result · read_file · abridged]\\n${healed.content} [full content in record §${transientId}]`,\n   493\t    );\n   494\t  });\n   495\t});\n","exit_code":0,"status":"completed"}}

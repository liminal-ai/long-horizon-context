{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/view.ts | sed -n '100,150p'\"","aggregated_output":"   100\t  threshold: number;\n   101\t  compactRecommended: boolean;\n   102\t  derivation: { pending: number; retrying: number; failed: number; blocked: number };\n   103\t  view: { degraded: number; gaps: number; builtAt: string } | null;\n   104\t  visibility: { zoneTokens: number; maxTokens: number };\n   105\t}\n   106\t\n   107\t// ── receipts (AC-2.7, AC-3.x) ─────────────────────────────────────\n   108\texport interface CompactReceipt {\n   109\t  viewId: string;\n   110\t  profile: string | null;\n   111\t  config: ViewProfile[\"percentages\"] & { lowerBound: number };\n   112\t  bands: Record<Band, { entries: number; tokens: number }>;\n   113\t  tailTokens: number;\n   114\t  // The assembled view's actual total (band tokens + tail tokens) against\n   115\t  // the configured lower bound — a target, not a cap: whole-entry fills may\n   116\t  // land under it, indivisible entries over it (AC-2.4; ruling 013).\n   117\t  totalTokens: number;\n   118\t  coveredFrom: number;\n   119\t  compactPoint: number;\n   120\t  degraded: Array<{ band: Band; subjectId: string; usedForm: string }>;\n   121\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n   122\t  // The embedded sweep's receipt (AC-3.6): the sweep runs first by default\n   123\t  // and its full receipt embeds here; `sweep: false` records the skip — the\n   124\t  // receipt always says whether the sweep ran (Story 3 closed Story 2's\n   125\t  // \"absent\" placeholder).\n   126\t  sweep: SweepReceipt | { skipped: true };\n   127\t}\n   128\t\n   129\texport interface SweepReceipt {\n   130\t  owners: Array<{\n   131\t    owner: \"messages\" | \"turns\";\n   132\t    kind: string;\n   133\t    ready: number;\n   134\t    inFlight: number;\n   135\t    requeued: string[]; // subject ids\n   136\t    blocked: Array<{ subjectId: string; reason: string }>;\n   137\t    permanentFailed: Array<{ subjectId: string; reason: string }>;\n   138\t  }>;\n   139\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/internal/sweep.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// thread-view internal: the readiness sweep (Story 3, Flow 3, AC-3.1–3.7).\n     2\t// Thread-view's only writing interaction with other domains — and it writes\n     3\t// nothing itself: derivation state is read exclusively through the owners'\n     4\t// report surfaces, repair goes exclusively through the owners' requeue\n     5\t// surfaces (must-not-own: never a direct work_item or derived_form touch).\n     6\t// No derivation, no provider calls, and no waiting: a requeue returns when\n     7\t// the queue row is written; background mode's drain heals it later. Any\n     8\t// drainSettled/polling in this module is a contract violation (anti-shim;\n     9\t// TC-3.1's elapsed bound is the tripwire).\n    10\timport type { FormReportEntry } from \"../../../shared/derivation.js\";\n    11\timport type { OpResult } from \"../../../shared/errors.js\";\n    12\timport type { SweepReceipt } from \"../../../shared/view.js\";\n    13\timport * as messagesDomain from \"../../messages/index.js\";\n    14\timport * as turnsDomain from \"../../turns/index.js\";\n    15\t\n    16\texport type ReasonClass = \"transient\" | \"permanent\";\n    17\t\n    18\t// The reason-code classification table (tech design §Spec Validation row 1):\n    19\t// data, not branching logic — the single source for transient-vs-permanent.\n    20\t// Keys are the reason class codes the production terminal-failure path\n    21\t// persists as the prefix of a failed form's reason (`<code>: <detail>`,\n    22\t// FC-0.4's distinguishable-on-read-back guarantee). Codes absent from the\n    23\t// table classify PERMANENT — the conservative default: an unknown failure is\n    24\t// reported in the receipt with its literal reason and never requeued, where\n    25\t// the other default would re-spend on a permanent failure at every compact.\n    26\t// Expanding the table is config-tier work later, not a redesign.\n    27\texport const REASON_CLASS_TABLE: Readonly<Record<string, ReasonClass>> = {\n    28\t  rate_limit: \"transient\",\n    29\t  timeout: \"transient\",\n    30\t  provider_unavailable: \"transient\",\n    31\t  content_refusal: \"permanent\",\n    32\t  validation: \"permanent\",\n    33\t  unknown_work_kind: \"permanent\",\n    34\t};\n    35\t\n    36\t// Classification reads the persisted reason's class code (the token before\n    37\t// the first \":\"), never the prose after it (anti-shim: no string-matching on\n    38\t// lastError prose). A missing or codeless reason is unclassified ⇒ permanent.\n    39\texport function classifyFailureReason(reason: string | undefined): ReasonClass {\n    40\t  const code = (reason ?? \"\").split(\":\", 1)[0]?.trim() ?? \"\";\n    41\t  return REASON_CLASS_TABLE[code] ?? \"permanent\";\n    42\t}\n    43\t\n    44\ttype Owner = \"messages\" | \"turns\";\n    45\ttype OwnerLine = SweepReceipt[\"owners\"][number];\n    46\t\n    47\t// One owner's requeue, dispatched by the entry's own subject vocabulary —\n    48\t// the consumed Epic 02 contract (messages by messageId; turns by\n    49\t// subjectKind turn|chunk). The owner's `already_queued` noop is what makes\n    50\t// once-per-invocation requeue dedupe structural (AC-3.4): a second ask for\n    51\t// work already live at the form's source version writes nothing.\n    52\tfunction requeueThroughOwner(\n    53\t  filePath: string,\n    54\t  owner: Owner,\n    55\t  entry: FormReportEntry,\n    56\t): Promise<OpResult<{ workItemId: string } | { noop: \"already_queued\" }>> {\n    57\t  if (owner === \"messages\") {\n    58\t    return messagesDomain.requeue({ filePath }, { messageId: entry.subjectId, form: entry.form });\n    59\t  }\n    60\t  return turnsDomain.requeue(\n    61\t    { filePath },\n    62\t    {\n    63\t      subjectKind: entry.subjectKind === \"chunk\" ? \"chunk\" : \"turn\",\n    64\t      subjectId: entry.subjectId,\n    65\t      form: entry.form,\n    66\t    },\n    67\t  );\n    68\t}\n    69\t\n    70\t// The sweep walk (Flow 3): `messages.report` + `turns.report` → bucket each\n    71\t// form — ready / pending ⇒ in-flight / blocked / failed × classify — then\n    72\t// requeue the transient failures through their owners and assemble the\n    73\t// receipt per owner and kind. Buckets come from the owners' report joins,\n    74\t// not raw form states: \"retrying\" is a report-level distinction the sweep\n    75\t// must not re-derive. Pending forms are left alone (their work is already\n    76\t// live); blocked and permanent-failed are reported with reasons, never\n    77\t// requeued.\n    78\texport async function runSweep(filePath: string): Promise<OpResult<SweepReceipt>> {\n    79\t  const messageReport = await messagesDomain.report({ filePath });\n    80\t  if (!messageReport.ok) return messageReport;\n    81\t  const turnReport = await turnsDomain.report({ filePath });\n    82\t  if (!turnReport.ok) return turnReport;\n    83\t\n    84\t  const lines = new Map<string, OwnerLine>();\n    85\t  const lineFor = (owner: Owner, kind: string): OwnerLine => {\n    86\t    const key = `${owner}/${kind}`;\n    87\t    let line = lines.get(key);\n    88\t    if (line === undefined) {\n    89\t      line = { owner, kind, ready: 0, inFlight: 0, requeued: [], blocked: [], permanentFailed: [] };\n    90\t      lines.set(key, line);\n    91\t    }\n    92\t    return line;\n    93\t  };\n    94\t\n    95\t  const walks: Array<{ owner: Owner; entries: readonly FormReportEntry[] }> = [\n    96\t    { owner: \"messages\", entries: messageReport.value },\n    97\t    { owner: \"turns\", entries: turnReport.value },\n    98\t  ];\n    99\t  for (const { owner, entries } of walks) {\n   100\t    for (const entry of entries) {\n   101\t      const line = lineFor(owner, entry.form);\n   102\t      switch (entry.state) {\n   103\t        case \"ready\":\n   104\t          line.ready += 1;\n   105\t          break;\n   106\t        case \"pending\":\n   107\t          // Queued or retrying — work is live; the sweep waits on nothing.\n   108\t          line.inFlight += 1;\n   109\t          break;\n   110\t        case \"blocked\":\n   111\t          line.blocked.push({\n   112\t            subjectId: entry.subjectId,\n   113\t            reason: entry.reason ?? \"blocked (no stored reason)\",\n   114\t          });\n   115\t          break;\n   116\t        case \"failed\": {\n   117\t          const reason = entry.reason ?? \"unclassified (no stored reason)\";\n   118\t          if (classifyFailureReason(entry.reason) === \"permanent\") {\n   119\t            line.permanentFailed.push({ subjectId: entry.subjectId, reason });\n   120\t            break;\n   121\t          }\n   122\t          const requeued = await requeueThroughOwner(filePath, owner, entry);\n   123\t          if (!requeued.ok) return requeued;\n   124\t          // already_queued counts as in-flight: a sibling form's requeue in\n   125\t          // this same walk (a turn's two forms share one work item) or a\n   126\t          // prior sweep already put the work live.\n   127\t          if (\"noop\" in requeued.value) line.inFlight += 1;\n   128\t          else line.requeued.push(entry.subjectId);\n   129\t          break;\n   130\t        }\n   131\t      }\n   132\t    }\n   133\t  }\n   134\t\n   135\t  return { ok: true, value: { owners: [...lines.values()] } };\n   136\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/index.ts | sed -n '1,540p'\"","aggregated_output":"     1\t// thread-view surface (Epic 03): pull, status, compact, sweep, materialize.\n     2\t// Story 1 landed the hot-path reads (`pull`, `status`): local reads and\n     3\t// deterministic string assembly only, no inference, no network, no queue\n     4\t// interaction, no writes (AC-1.1, AC-2.8). Story 2 landed `compact`;\n     5\t// Story 3 lands `sweep` (standalone and embedded default-on in compact).\n     6\t// `materialize` stays a structured-result stub until Story 5. Story 0's\n     7\t// substrate (profile resolution, consumed by createSdk) re-exports at the\n     8\t// bottom.\n     9\timport { existsSync } from \"node:fs\";\n    10\timport {\n    11\t  resolveInstanceViewConfig,\n    12\t  runWithThreadTouchSuppressed,\n    13\t} from \"../../shared/context.js\";\n    14\timport type { FormReportEntry } from \"../../shared/derivation.js\";\n    15\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n    16\timport type {\n    17\t  CompactReceipt,\n    18\t  PullResult,\n    19\t  ResolvedViewConfig,\n    20\t  SweepReceipt,\n    21\t  ViewCompactParams,\n    22\t  ViewMessage,\n    23\t  ViewProfile,\n    24\t  ViewStatus,\n    25\t} from \"../../shared/view.js\";\n    26\timport * as messagesDomain from \"../messages/index.js\";\n    27\timport * as turnsDomain from \"../turns/index.js\";\n    28\timport {\n    29\t  openThreadDatabase,\n    30\t  resolveThreadRef,\n    31\t  type ThreadRef,\n    32\t} from \"../threads/index.js\";\n    33\timport { readBoundaryPosition, visibilityZoneTokens } from \"./internal/boundary.js\";\n    34\timport { profileViolation, resolveViewConfig } from \"./internal/profiles.js\";\n    35\timport {\n    36\t  assembleBandText,\n    37\t  renderBandMessage,\n    38\t  renderTailMessage,\n    39\t  toolNamesByCallId,\n    40\t} from \"./internal/render.js\";\n    41\timport { fireViewInjection } from \"./internal/seam.js\";\n    42\timport {\n    43\t  CanonicalCorruptionError,\n    44\t  readSelectionInputs,\n    45\t  selectArrangement,\n    46\t  type ArrangementEntry,\n    47\t} from \"./internal/select.js\";\n    48\timport {\n    49\t  readReadyToolResultSummaries,\n    50\t  readTailMessages,\n    51\t  readViewSnapshot,\n    52\t  replaceViewSnapshot,\n    53\t  tailTokenSum,\n    54\t} from \"./internal/snapshot.js\";\n    55\timport { runSweep } from \"./internal/sweep.js\";\n    56\timport { estimateTokens } from \"../../tech-utils/token-counting/index.js\";\n    57\timport type { Band } from \"../../shared/view.js\";\n    58\t\n    59\t// Config resolution for the operation in hand: the SDK instance's resolved\n    60\t// view config rides the per-instance seam (epic-fix-001 pattern, tech design\n    61\t// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\n    62\t// through the same one resolution path createSdk uses.\n    63\tconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\n    64\t\n    65\tfunction viewConfig(): ResolvedViewConfig {\n    66\t  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\n    67\t}\n    68\t\n    69\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n    70\t  return {\n    71\t    ok: false,\n    72\t    error: {\n    73\t      errorClass: \"caller_error\",\n    74\t      code: \"thread_not_found\",\n    75\t      reason: `no thread file exists at ${filePath}`,\n    76\t    },\n    77\t  };\n    78\t}\n    79\t\n    80\tfunction detail(cause: unknown): string {\n    81\t  return cause instanceof Error ? cause.message : String(cause);\n    82\t}\n    83\t\n    84\t// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\n    85\t\n    86\t// The hot-path read: view header + bands (if any), tail messages after the\n    87\t// compact point (deleted-filtered, record order), boundary position; then\n    88\t// format — band messages first, tail per the mapping table, tool results\n    89\t// at-or-behind the boundary in short form. No view row ⇒ the whole record is\n    90\t// tail from event 1 (AC-1.3) through this same code path with the compact\n    91\t// point at its zero origin — snapshot-absent, never a separate branch.\n    92\t//\n    93\t// Reads-only is structural, not disciplined: the whole operation runs in the\n    94\t// touch-suppressed scope, so the open announcement that would let a\n    95\t// background SDK's scheduler hang a first-touch catch-up drain off this read\n    96\t// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\n    97\t// AC-1.1's no-queue-interaction holds in both host modes.\n    98\texport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\n    99\t  return runWithThreadTouchSuppressed(() => pullInner(ref));\n   100\t}\n   101\t\n   102\tasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n   103\t  const resolved = await resolveThreadRef(ref);\n   104\t  if (!resolved.ok) return resolved;\n   105\t  const { filePath } = resolved.value;\n   106\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   107\t\n   108\t  const opened = openThreadDatabase(filePath);\n   109\t  if (!opened.ok) return opened;\n   110\t  const db = opened.value;\n   111\t  try {\n   112\t    const snapshot = readViewSnapshot(db);\n   113\t    const compactPoint = snapshot?.compactPoint ?? 0;\n   114\t    const boundaryPosition = readBoundaryPosition(db);\n   115\t    const tailRows = readTailMessages(db, compactPoint);\n   116\t    const renderCtx = {\n   117\t      boundaryPosition,\n   118\t      toolNameByCallId: toolNamesByCallId(tailRows),\n   119\t      toolResultSummaries: readReadyToolResultSummaries(db),\n   120\t    };\n   121\t\n   122\t    const messages: ViewMessage[] = [];\n   123\t    if (snapshot !== null) {\n   124\t      for (const band of snapshot.bands) {\n   125\t        messages.push(renderBandMessage(band.band, band.renderedText));\n   126\t      }\n   127\t    }\n   128\t    for (const row of tailRows) {\n   129\t      messages.push(renderTailMessage(row, renderCtx));\n   130\t    }\n   131\t\n   132\t    return {\n   133\t      ok: true,\n   134\t      value: {\n   135\t        messages,\n   136\t        meta: {\n   137\t          compactPoint: snapshot?.compactPoint ?? null,\n   138\t          coveredFrom: snapshot?.coveredFrom ?? null,\n   139\t          boundaryPosition,\n   140\t          gapCount: snapshot?.gapCount ?? 0,\n   141\t          degradedCount: snapshot?.degradedCount ?? 0,\n   142\t          viewId: snapshot?.viewId ?? null,\n   143\t          createdAt: snapshot?.createdAt ?? null,\n   144\t        },\n   145\t      },\n   146\t    };\n   147\t  } catch (cause) {\n   148\t    return storageFailure(`view pull failed: ${detail(cause)}`);\n   149\t  } finally {\n   150\t    db.close();\n   151\t  }\n   152\t}\n   153\t\n   154\t// ── status (AC-2.8) ───────────────────────────────────────────────\n   155\t\n   156\t// Derivation counts bucket from one report entry the way the report's own\n   157\t// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\n   158\t// pending, retrying (pending with attempts spent), failed, blocked. Ready\n   159\t// forms are healthy and not an operational situation.\n   160\tfunction bucketDerivation(\n   161\t  entries: readonly FormReportEntry[],\n   162\t  counts: ViewStatus[\"derivation\"],\n   163\t): void {\n   164\t  for (const entry of entries) {\n   165\t    switch (entry.state) {\n   166\t      case \"pending\":\n   167\t        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\n   168\t        else counts.pending += 1;\n   169\t        break;\n   170\t      case \"failed\":\n   171\t        counts.failed += 1;\n   172\t        break;\n   173\t      case \"blocked\":\n   174\t        counts.blocked += 1;\n   175\t        break;\n   176\t      case \"ready\":\n   177\t        break;\n   178\t    }\n   179\t  }\n   180\t}\n   181\t\n   182\t// Reads only, callable any time, no side effects: tail size against the\n   183\t// configured trigger threshold with a compact recommendation (`tailTokens >\n   184\t// threshold`, nothing smarter — the caller owns policy), derivation counts\n   185\t// by state read through the OWNERS' report surfaces (must-not-own: never a\n   186\t// direct derived_form read here), the active view's health or null\n   187\t// pre-compact, and the visibility zone's sum against its max — computed live\n   188\t// by the same query the Story 4 advance will use, so \"visible in status\" is\n   189\t// structural, not stored.\n   190\t//\n   191\t// Like pull, the whole read — including the owners' report surfaces it\n   192\t// consumes — runs in the touch-suppressed scope, so a background SDK's\n   193\t// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n   194\t// host modes).\n   195\texport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n   196\t  return runWithThreadTouchSuppressed(() => statusInner(ref));\n   197\t}\n   198\t\n   199\tasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n   200\t  const resolved = await resolveThreadRef(ref);\n   201\t  if (!resolved.ok) return resolved;\n   202\t  const { filePath } = resolved.value;\n   203\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   204\t\n   205\t  const config = viewConfig();\n   206\t  const opened = openThreadDatabase(filePath);\n   207\t  if (!opened.ok) return opened;\n   208\t  const db = opened.value;\n   209\t  let tailTokens: number;\n   210\t  let zoneTokens: number;\n   211\t  let view: ViewStatus[\"view\"];\n   212\t  try {\n   213\t    const snapshot = readViewSnapshot(db);\n   214\t    const compactPoint = snapshot?.compactPoint ?? 0;\n   215\t    const boundaryPosition = readBoundaryPosition(db);\n   216\t    tailTokens = tailTokenSum(db, compactPoint);\n   217\t    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n   218\t    view =\n   219\t      snapshot === null\n   220\t        ? null\n   221\t        : {\n   222\t            degraded: snapshot.degradedCount,\n   223\t            gaps: snapshot.gapCount,\n   224\t            builtAt: snapshot.createdAt,\n   225\t          };\n   226\t  } catch (cause) {\n   227\t    return storageFailure(`view status failed: ${detail(cause)}`);\n   228\t  } finally {\n   229\t    db.close();\n   230\t  }\n   231\t\n   232\t  // The owners' report surfaces open their own handles; ours is closed first\n   233\t  // so the status read never holds two handles on one thread file.\n   234\t  const messageReport = await messagesDomain.report({ filePath });\n   235\t  if (!messageReport.ok) return messageReport;\n   236\t  const turnReport = await turnsDomain.report({ filePath });\n   237\t  if (!turnReport.ok) return turnReport;\n   238\t  const derivation: ViewStatus[\"derivation\"] = {\n   239\t    pending: 0,\n   240\t    retrying: 0,\n   241\t    failed: 0,\n   242\t    blocked: 0,\n   243\t  };\n   244\t  bucketDerivation(messageReport.value, derivation);\n   245\t  bucketDerivation(turnReport.value, derivation);\n   246\t\n   247\t  return {\n   248\t    ok: true,\n   249\t    value: {\n   250\t      tailTokens,\n   251\t      threshold: config.compactThreshold,\n   252\t      compactRecommended: tailTokens > config.compactThreshold,\n   253\t      derivation,\n   254\t      view,\n   255\t      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\n   256\t    },\n   257\t  };\n   258\t}\n   259\t\n   260\t// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\n   261\t\n   262\t// The default base when no profile is named: the first built-in, matching\n   263\t// the epic's primary user (the PI continuation harness). Explicit params\n   264\t// override the base field-wise (AC-2.2).\n   265\tconst DEFAULT_PROFILE_NAME = \"continuation\";\n   266\t\n   267\tfunction callerError(\n   268\t  code: \"unknown_profile\" | \"invalid_view_config\",\n   269\t  reason: string,\n   270\t): { ok: false; error: ErrorResult } {\n   271\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n   272\t}\n   273\t\n   274\tconst BAND_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n   275\t\n   276\t// Compact runs only when invoked through this surface (AC-2.1: no code path\n   277\t// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\n   278\t// rejection provably touches nothing) → sweep, on by default, `sweep: false`\n   279\t// skips (AC-3.6; the receipt records which) → read record + forms with the\n   280\t// corruption check in the reads (pre-transaction, prior view trivially\n   281\t// intact on refusal) → selection walk → band rendering → one BEGIN\n   282\t// IMMEDIATE replacing the view and resetting the boundary → receipt.\n   283\t// Assembly is entirely from stored artifacts: nothing here can reach a\n   284\t// provider (AC-2.4 zero-inference is structural — the sweep step repairs\n   285\t// through owners' requeue surfaces and calls no provider either).\n   286\texport async function compact(\n   287\t  ref: ThreadRef,\n   288\t  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n   289\t): Promise<OpResult<CompactReceipt>> {\n   290\t  const resolved = await resolveThreadRef(ref);\n   291\t  if (!resolved.ok) return resolved;\n   292\t  const { filePath } = resolved.value;\n   293\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   294\t\n   295\t  const config = viewConfig();\n   296\t  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\n   297\t  const base = config.profiles[baseName];\n   298\t  if (base === undefined) {\n   299\t    return callerError(\n   300\t      \"unknown_profile\",\n   301\t      `unknown profile \"${baseName}\"; configured profiles are ${Object.keys(config.profiles)\n   302\t        .map((name) => `\"${name}\"`)\n   303\t        .join(\", \")}`,\n   304\t    );\n   305\t  }\n   306\t  const merged: ViewProfile = {\n   307\t    name: base.name,\n   308\t    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\n   309\t    percentages: { ...base.percentages, ...opts.params?.percentages },\n   310\t  };\n   311\t  const violation = profileViolation(merged);\n   312\t  if (violation !== null) return callerError(\"invalid_view_config\", violation);\n   313\t  // Receipt provenance: \"null when explicit params\" (tech design §Storage) —\n   314\t  // any param override means the config is no longer a named profile's mix,\n   315\t  // even when one served as the merge base; the receipt's config carries the\n   316\t  // resolved truth. A bare or profile-only call names its profile.\n   317\t  const profileName = opts.params === undefined ? baseName : null;\n   318\t\n   319\t  // The sweep step (Flow 2 / Flow 3, AC-3.6): on by default so every compact\n   320\t  // leaves the thread healthier than it found it; `sweep: false` skips with\n   321\t  // the skip recorded in the receipt. Runs before this operation opens its\n   322\t  // own handle (the owners' surfaces open theirs), and before any view\n   323\t  // write — a sweep failure aborts the compact with the prior view intact.\n   324\t  let sweepOutcome: SweepReceipt | { skipped: true };\n   325\t  if (opts.sweep === false) {\n   326\t    sweepOutcome = { skipped: true };\n   327\t  } else {\n   328\t    const swept = await runSweep(filePath);\n   329\t    if (!swept.ok) return swept;\n   330\t    sweepOutcome = swept.value;\n   331\t  }\n   332\t\n   333\t  const opened = openThreadDatabase(filePath);\n   334\t  if (!opened.ok) return opened;\n   335\t  const db = opened.value;\n   336\t  try {\n   337\t    let inputs;\n   338\t    try {\n   339\t      inputs = readSelectionInputs(db);\n   340\t    } catch (cause) {\n   341\t      if (cause instanceof CanonicalCorruptionError) {\n   342\t        // Pre-transaction refusal: nothing was written, the prior view and\n   343\t        // the record are untouched (AC-2.5).\n   344\t        return {\n   345\t          ok: false,\n   346\t          error: { errorClass: \"state_corruption\", code: cause.code, reason: cause.message },\n   347\t        };\n   348\t      }\n   349\t      throw cause;\n   350\t    }\n   351\t    const selection = selectArrangement(inputs, {\n   352\t      lowerBound: merged.lowerBound,\n   353\t      percentages: merged.percentages,\n   354\t    });\n   355\t\n   356\t    const entriesByBand = (band: Band): ArrangementEntry[] =>\n   357\t      selection.entries.filter((entry) => entry.band === band);\n   358\t    const bands = BAND_ORDER.flatMap((band) => {\n   359\t      const entries = entriesByBand(band);\n   360\t      if (entries.length === 0) return [];\n   361\t      const renderedText = assembleBandText(entries.map((entry) => entry.text));\n   362\t      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\n   363\t    });\n   364\t\n   365\t    const createdAt = new Date().toISOString();\n   366\t    // view_id is v<compact event order> — deterministic, and deliberately\n   367\t    // reused by an intake-free recompact (tech design L395: do not \"fix\"\n   368\t    // into a uniqueness scheme; the singleton row is replaced whole).\n   369\t    const viewId = `v${inputs.maxEventOrder}`;\n   370\t\n   371\t    // Story-0 injection point: TC-2.4's crash between the sweep and the\n   372\t    // view-write transaction. An installed hook's throw aborts here —\n   373\t    // before BEGIN — so the previous view keeps serving.\n   374\t    fireViewInjection(\"compact-write\");\n   375\t\n   376\t    replaceViewSnapshot(db, {\n   377\t      viewId,\n   378\t      createdAt,\n   379\t      compactPoint: selection.compactPoint,\n   380\t      coveredFrom: selection.coveredFrom,\n   381\t      profileName,\n   382\t      configJson: JSON.stringify({\n   383\t        lowerBound: merged.lowerBound,\n   384\t        percentages: merged.percentages,\n   385\t      }),\n   386\t      arrangementJson: JSON.stringify(\n   387\t        selection.entries.map((entry) => ({\n   388\t          band: entry.band,\n   389\t          subjectKind: entry.subjectKind,\n   390\t          subjectId: entry.subjectId,\n   391\t          formUsed: entry.formUsed,\n   392\t          degraded: entry.degraded,\n   393\t        })),\n   394\t      ),\n   395\t      gapsJson: JSON.stringify(\n   396\t        selection.entries\n   397\t          .filter((entry) => entry.gap)\n   398\t          .map((entry) => ({\n   399\t            band: entry.band,\n   400\t            subjectId: entry.subjectId,\n   401\t            reason: entry.reason ?? \"unknown\",\n   402\t          })),\n   403\t      ),\n   404\t      sourceStateJson: JSON.stringify({\n   405\t        maxEventOrder: inputs.maxEventOrder,\n   406\t        formCounts: inputs.formCounts,\n   407\t      }),\n   408\t      bands,\n   409\t    });\n   410\t\n   411\t    const bandReport = {} as CompactReceipt[\"bands\"];\n   412\t    for (const band of BAND_ORDER) {\n   413\t      const stored = bands.find((row) => row.band === band);\n   414\t      bandReport[band] = {\n   415\t        entries: entriesByBand(band).length,\n   416\t        tokens: stored?.tokenCount ?? 0,\n   417\t      };\n   418\t    }\n   419\t    const tailTokens = tailTokenSum(db, selection.compactPoint);\n   420\t    return {\n   421\t      ok: true,\n   422\t      value: {\n   423\t        viewId,\n   424\t        profile: profileName,\n   425\t        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n   426\t        bands: bandReport,\n   427\t        tailTokens,\n   428\t        // Actual assembled total vs the bound (target, not cap — AC-2.4).\n   429\t        totalTokens:\n   430\t          bandReport.brief.tokens +\n   431\t          bandReport.detailed.tokens +\n   432\t          bandReport.smooth.tokens +\n   433\t          tailTokens,\n   434\t        coveredFrom: selection.coveredFrom,\n   435\t        compactPoint: selection.compactPoint,\n   436\t        degraded: selection.entries\n   437\t          .filter((entry) => entry.degraded)\n   438\t          .map((entry) => ({\n   439\t            band: entry.band,\n   440\t            subjectId: entry.subjectId,\n   441\t            usedForm: entry.formUsed,\n   442\t          })),\n   443\t        gaps: selection.entries\n   444\t          .filter((entry) => entry.gap)\n   445\t          .map((entry) => ({\n   446\t            band: entry.band,\n   447\t            subjectId: entry.subjectId,\n   448\t            reason: entry.reason ?? \"unknown\",\n   449\t          })),\n   450\t        sweep: sweepOutcome,\n   451\t      },\n   452\t    };\n   453\t  } catch (cause) {\n   454\t    return storageFailure(`view compact failed: ${detail(cause)}`);\n   455\t  } finally {\n   456\t    db.close();\n   457\t  }\n   458\t}\n   459\t\n   460\t// ── sweep (Flow 3: AC-3.1–3.5, 3.7) ──────────────────────────────\n   461\t\n   462\t// The standalone readiness sweep: walk the owners' reports, requeue the\n   463\t// transiently-failed forms through the owners' requeue surfaces, return the\n   464\t// per-owner/kind receipt. The walk itself lives in internal/sweep.ts; the\n   465\t// compact embeds the same walk (AC-3.6), so standalone and embedded receipts\n   466\t// share one shape by construction (AC-3.7's SDK leg; the CLI leg rides\n   467\t// Story 5's process suite). Returns without waiting on any queued work\n   468\t// (AC-3.2): requeues are row writes; background mode's drain heals later.\n   469\texport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\n   470\t  const resolved = await resolveThreadRef(ref);\n   471\t  if (!resolved.ok) return resolved;\n   472\t  const { filePath } = resolved.value;\n   473\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   474\t  try {\n   475\t    return await runSweep(filePath);\n   476\t  } catch (cause) {\n   477\t    return storageFailure(`view sweep failed: ${detail(cause)}`);\n   478\t  }\n   479\t}\n   480\t\n   481\t// ── stub (Story 5) ───────────────────────────────────────────────\n   482\t\n   483\t// The skeleton's stub contract (tech design §Interface Definitions):\n   484\t// structured result, machine-readable, never a throw on this surface.\n   485\tfunction notImplemented(op: string): { ok: false; error: ErrorResult } {\n   486\t  return {\n   487\t    ok: false,\n   488\t    error: {\n   489\t      errorClass: \"system_error\",\n   490\t      code: \"not_implemented\",\n   491\t      reason: `not implemented: ${op}`,\n   492\t    },\n   493\t  };\n   494\t}\n   495\t\n   496\texport async function materialize(\n   497\t  ref: ThreadRef,\n   498\t  opts: { path: string; format?: \"pi-session\" },\n   499\t): Promise<OpResult<{ writtenPath: string }>> {\n   500\t  void ref;\n   501\t  void opts;\n   502\t  return notImplemented(\"materialize\");\n   503\t}\n   504\t\n   505\t// ── Story 0 substrate (consumed by createSdk at construction) ─────\n   506\texport {\n   507\t  BUILT_IN_PROFILES,\n   508\t  DEFAULT_COMPACT_THRESHOLD,\n   509\t  DEFAULT_VISIBILITY,\n   510\t  resolveViewConfig,\n   511\t} from \"./internal/profiles.js\";\n","exit_code":0,"status":"completed"}}

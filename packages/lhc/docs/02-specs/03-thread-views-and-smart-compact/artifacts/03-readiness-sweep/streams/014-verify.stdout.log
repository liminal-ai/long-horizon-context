;\n   249\t  } catch (cause) {\n   250\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   251\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   252\t  } finally {\n   253\t    db.close();\n   254\t  }\n   255\t}\n   256\t\n   257\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   258\t\n   259\t// This owner's repair report: every turn- and chunk-owned form's durable\n   260\t// state joined with live queue detail in one query. Needs no provider;\n   261\t// reads degrade, never block.\n   262\texport async function report(\n   263\t  thread: ThreadRef,\n   264\t  opts?: { notReady?: boolean; turnId?: string; chunkId?: string },\n   265\t): Promise<OpResult<FormReportEntry[]>> {\n   266\t  const resolved = await resolveThreadRef(thread);\n   267\t  if (!resolved.ok) return resolved;\n   268\t  const { filePath } = resolved.value;\n   269\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   270\t\n   271\t  const opened = openThreadDatabase(filePath);\n   272\t  if (!opened.ok) return opened;\n   273\t  const db = opened.value;\n   274\t  try {\n   275\t    return { ok: true, value: reportTurnForms(db, opts ?? {}) };\n   276\t  } catch (cause) {\n   277\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   278\t    return storageFailure(`report read failed: ${reason}`);\n   279\t  } finally {\n   280\t    db.close();\n   281\t  }\n   282\t}\n   283\t\n   284\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n","exit_code":0,"status":"completed"}}

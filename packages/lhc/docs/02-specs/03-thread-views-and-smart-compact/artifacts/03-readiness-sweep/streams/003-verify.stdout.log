sages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\n   315\t      },\n   316\t    };\n   317\t  }\n   318\t  const resolved = await resolveThreadRef(thread);\n   319\t  if (!resolved.ok) return resolved;\n   320\t  const { filePath } = resolved.value;\n   321\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   322\t\n   323\t  const opened = openThreadDatabase(filePath);\n   324\t  if (!opened.ok) return opened;\n   325\t  const db = opened.value;\n   326\t  try {\n   327\t    const meta = db\n   328\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   329\t      .get() as { thread_id: string } | undefined;\n   330\t    const threadId = meta?.thread_id ?? \"\";\n   331\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   332\t      const row = readMessageFormRow(ctx.db, target.messageId, target.form);\n   333\t      if (row === undefined) {\n   334\t        return {\n   335\t          ok: false,\n   336\t          error: {\n   337\t            errorClass: \"caller_error\",\n   338\t            code: \"message_not_found\",\n   339\t            reason: `no derived form ${target.form} exists for message ${target.messageId}`,\n   340\t          },\n   341\t        };\n   342\t      }\n   343\t      if (row.state === \"blocked\") {\n   344\t        // The refusal carries the form's stored reason — the damage named at\n   345\t        // blocking time, not a generic string (AC-4.6).\n   346\t        return {\n   347\t          ok: false,\n   348\t          error: {\n   349\t            errorClass: \"state_corruption\",\n   350\t            code: \"source_damaged\",\n   351\t            reason: row.reason ?? `form ${target.form} for message ${target.messageId} is blocked`,\n   352\t          },\n   353\t        };\n   354\t      }\n   355\t      const sourceRef = { messageId: target.messageId };\n   356\t      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\n   357\t        return { ok: true, value: { noop: \"already_queued\" } };\n   358\t      }\n   359\t      const item = enqueue(ctx, {\n   360\t        owner: \"messages\",\n   361\t        kind,\n   362\t        sourceRef,\n   363\t        sourceVersion: row.sourceVersion + 1,\n   364\t        forms: [{ subjectKind: \"message\", subjectId: target.messageId, form: target.form }],\n   365\t      });\n   366\t      return { ok: true, value: { workItemId: item.workItemId } };\n   367\t    });\n   368\t  } catch (cause) {\n   369\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   370\t    return storageFailure(`requeue failed: ${reason}`);\n","exit_code":0,"status":"completed"}}

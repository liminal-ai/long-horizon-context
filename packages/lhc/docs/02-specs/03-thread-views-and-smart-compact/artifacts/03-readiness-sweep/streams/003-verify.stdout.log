  112\t    expect(materialized).toEqual({\n   113\t      ok: false,\n   114\t      error: { errorClass: \"system_error\", code: \"not_implemented\", reason: \"not implemented: materialize\" },\n   115\t    });\n   116\t  });\n   117\t});\n   118\t\n   119\tdescribe(\"TC-1.1 (AC-1.2, AC-1.3): never-compacted thread pulls the full conversation in order; later intake appends\", () => {\n   120\t  it(\"carries both intake rounds in record order with tail-only meta\", async () => {\n   180\t\n   181\t  it(\"compacts with a built-in profile: the profile's bound and mix land in the receipt\", async () => {\n   182\t    const receipt = await fixture.sdk.threadView.compact(\n   183\t      { filePath: fixture.filePath },\n   184\t      { profile: \"coding\" },\n   185\t    );\n   186\t    expect(receipt.ok).toBe(true);\n   187\t    if (!receipt.ok) return;\n   188\t    expect(receipt.value.profile).toBe(\"coding\");\n   189\t    expect(receipt.value.config).toEqual({\n   190\t      full: 25,\n   191\t      smooth: 35,\n   192\t      detailed: 20,\n   193\t      brief: 20,\n   194\t      lowerBound: 120000,\n   195\t    });\n   196\t    // Sweep step is absent this story (the honest literal, not a fake empty\n   197\t    // receipt — Story 3 flips it).\n   198\t    expect(receipt.value.sweep).toBe(\"absent\");\n   199\t    // At a 120k bound this small thread is all tail: bands empty, compact\n   200\t    // point at the origin, and the reported total IS the tail (totalTokens\n   201\t    // receipt coverage, ruling 013).\n   202\t    expect(receipt.value.compactPoint).toBe(0);\n   203\t    expect(receipt.value.bands.smooth.entries).toBe(0);\n   204\t    expect(receipt.value.totalTokens).toBe(receipt.value.tailTokens);\n   205\t  });\n   206\t\n   207\t  it(\"explicit params override profile values field-wise and report profile null\", async () => {\n   208\t    const receipt = await fixture.sdk.threadView.compact(\n   209\t      { filePath: fixture.filePath },\n   210\t      
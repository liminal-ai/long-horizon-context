he mutation commands' spellings\n   109\t        // (story/tech design); they parse into the same slots as\n   110\t        // `--message-id` / `--turn-id`.\n   111\t        message: { type: \"string\" },\n   112\t        turn: { type: \"string\" },\n   113\t        content: { type: \"string\" },\n   114\t      },\n   115\t      strict: true,\n   116\t      allowPositionals: true,\n   117\t    }));\n   118\t  } catch (cause) {\n   119\t    const message = cause instanceof Error ? cause.message : String(cause);\n   120\t    // parseArgs names the offending option in single quotes (e.g. Unknown\n   121\t    // option '--file-pth'); surface that token, falling back to the message.\n   122\t    const named = /'([^']+)'/.exec(message);\n   123\t    return { ok: false, unknownFlag: named?.[1] ?? message };\n   124\t  }\n   125\t  const flags: ParsedFlags = {};\n   126\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n   127\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n   128\t  if (typeof values.title === \"string\") flags.title = values.title;\n   129\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n   130\t  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n   131\t  if (typeof values.provider === \"string\") flags.provider = values.provider;\n   132\t  if (values[\"not-ready\"] === true) flags.notReady = true;\n   133\t  if (typeof values[\"message-id\"] === \"string\") flags.messageId = values[\"message-id\"];\n   134\t  if (typeof values.message === \"string\") flags.messageId = values.message;\n   135\t  if (typeof values.content === \"string\") flags.content = values.content;\n   136\t  if (typeof values[\"turn-id\"] === \"string\") flags.turnId = values[\"turn-id\"];\n   137\t  if (typeof values.turn === \"string\") flags.turnId = values.turn;\n   138\t  if (typeof values[\"chunk-id\"] === \"string\") flags.chunkId = values[\"chunk-id\"];\n   139\t  if (typeof values.form === \"string\") flags.form = values.form;\n   140\t  if (typeof values[\"subject-kind\"] === \"string\") flags.subjectKind = values[\"subject-kind\"];\n   141\t  if (typeof values[\"subject-id\"] === \"string\") flags.subjectId = values[\"subject-id\"];\n   142\t  return { ok: true, flags };\n   143\t}\n   144\t\n   145\t// The read commands take a thread reference but no stdin; a missing reference\n   146\t// is a usage error named before any SDK call, matching the intake commands.\n   147\tfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n   148\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n   149\t    return renderCliError(\n   150\t      \"caller_error\",\n   151\t      \"missing_flag\",\n   152\t      `${command} requires --thread-id or --file-path`,\n   153\t    );\n   154\t  }\n   155\t  return undefined;\n   156\t}\n   157\t\n   158\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n   159\t  if (flags.threadId !== undefined) {\n   160\t    return flags.registryPath !== undefined\n   161\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n   162\t      : { threadId: flags.threadId };\n   163\t  }\n   164\t  return { filePath: flags.filePath ?? \"\" };\n   165\t}\n   166\t\n   167\texport async function runCli(\n   168\t  argv: readonly string[],\n   169\t  readStdin: StdinReader = readProcessStdin,\n   170\t): Promise<CliResult> {\n   171\t  if (argv.length === 0) {\n   172\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n   173\t  }\n   174\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n   175\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n   176\t  }\n   177\t\n   178\t  const [group, command, ...rest] = argv;\n   179\t  const key = command === undefined ? group : `${group} ${command}`;\n   180\t  const parsed = parseFlags(command === undefined ? [] : rest);\n   181\t  if (!parsed.ok) {\n   182\t    return renderCliError(\n   183\t      \"caller_error\",\n   184\t      \"unknown_flag\",\n   185\t      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n   186\t    );\n   187\t  }\n   188\t  const flags = parsed.flags;\n   189\t\n   190\t  switch (key) {\n   191\t    case \"threads new-thread\": {\n   192\t      // Guard here: an empty path reaching node:sqlite opens a temp database\n   193\t      // instead of failing, so the adapter refuses before any SDK call.\n   194\t      if (flags.filePath === undefined) {\n   195\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n   196\t      }\n   197\t      const input: Parameters<typeof threads.newThread>[0] = {\n   198\t        filePath: flags.filePath,\n   199\t      };\n   200\t      if (flags.title !== undefined) input.title = flags.title;\n   201\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n   202\t      return renderResult(await threads.newThread(input));\n   203\t    }\n   204\t    case \"threads resolve\": {\n   205\t      if (flags.threadId === undefined) {\n   206\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n   207\t      }\n   208\t      const input: Parameters<typeof threads.resolve>[0] = {\n   209\t        threadId: flags.threadId,\n   210\t      };\n   211\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n   212\t      return renderResult(await threads.resolve(input));\n   213\t    }\n   214\t    case \"threads list\": {\n   215\t      return renderResult(\n   216\t        await threads.listThreads(\n   217\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n   218\t        ),\n   219\t      );\n   220\t    }\n   221\t    case \"intake-stream message-events\": {\n   222\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n   223\t        return renderCliError(\n   224\t          \"caller_error\",\n   225\t          \"missing_flag\",\n   226\t          \"intake-stream message-events requires --thread-id or --file-path\",\n   227\t        );\n   228\t      }\n   229\t      const text = await readStdin();\n   230\t      if (text === null || text.trim() === \"\") {\n   231\t        return renderResult(\n   232\t          stdinCallerError(\n   233\t            \"empty_stdin\",\n   234\t            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n   235\t          ),\n   236\t        );\n   237\t      }\n   238\t      let parsed: unknown;\n   239\t      try {\n   240\t        parsed = JSON.parse(text);\n   241\t      } catch (cause) {\n   242\t        const detail = cause instanceof Error ? cause.message : String(cause);\n   243\t        return renderResult(\n   244\t          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n   245\t        );\n   246\t      }\n   247\t      if (!Array.isArray(parsed)) {\n   248\t        return renderResult(\n   249\t          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n   250\t        );\n   251\t      }\n   252\t      return renderResult(\n   253\t        await intakeStream.messageEvents(\n   254\t          threadRefFrom(flags),\n   255\t          parsed as readonly MessageEventInput[],\n   256\t        ),\n   257\t      );\n   258\t    }\n   259\t    case \"intake-stream list-events\": {\n   260\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n   261\t        return renderCliError(\n   262\t          \"caller_error\",\n   263\t          \"missing_flag\",\n   264\t          \"intake-stream list-events requires --thread-id or --file-path\",\n   265\t        );\n   266\t      }\n   267\t      return renderResult(await intakeStream.listEvents(threadRefFrom
f (\n   310\t    target.subjectKind === \"chunk\" &&\n   311\t    (target.form === \"chunk_summary_detailed\" || target.form === \"chunk_summary_brief\")\n   312\t  ) {\n   313\t    return {\n   314\t      kind: target.form,\n   315\t      sourceRef: { chunkId: target.subjectId },\n   316\t      forms: [{ subjectKind: \"chunk\", subjectId: target.subjectId, form: target.form }],\n   317\t    };\n   318\t  }\n   319\t  return undefined;\n   320\t}\n   321\t\n   322\t// Explicit re-queue through the owning surface (AC-4.4): same contract as\n   323\t// messages.requeue — blocked refused with the stored damage reason, missing\n   324\t// rows refused, no-op against live work at the current source version, and\n   325\t// the no-op check + enqueue in one transaction. A successful requeue rebuilds\n   326\t// at the next source version: composed forms recompute their gaps from\n   327\t// current dependency states (Flow 3's rebuild rule).\n   328\texport async function requeue(\n   329\t  thread: ThreadRef,\n   330\t  target: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: FormKind },\n   331\t): Promise<OpResult<RequeueOutcome>> {\n   332\t  const mapped = turnRequeueTarget(target);\n   333\t  if (mapped === undefined) {\n   334\t    return {\n   335\t      ok: false,\n   336\t      error: {\n   337\t        errorClass: \"caller_error\",\n   338\t        code: \"turn_not_found\",\n   339\t        reason: `form ${target.form} is not a ${target.subjectKind}-owned form; turns.requeue repairs turn_rendering and lower_band_projection (turn) or chunk_summary_detailed and chunk_summary_brief (chunk)`,\n   340\t      },\n   341\t    };\n   342\t  }\n   343\t  const resolved = await resolveThreadRef(thread);\n   344\t  if (!resolved.ok) return resolved;\n   345\t  const { filePath } = resolved.value;\n   346\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   347\t\n   348\t  const opened = openThreadDatabase(filePath);\n   349\t  if (!opened.ok) return opened;\n   350\t  const db = opened.value;\n   351\t  try {\n   352\t    const meta = db\n   353\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   354\t      .get() as { thread_id: string } | undefined;\n   355\t    const threadId = meta?.thread_id ?? \"\";\n   356\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   357\t      const row = readTurnFormRow(ctx.db, target.subjectKind, target.subjectId, target.form);\n   358\t      if (row === undefined) {\n   359\t        return {\n   360\t          ok: false,\n   361\t          error: {\n   362\t            errorClass: \"caller_error\",\n   363\t            code: \"turn_not_found\",\n   364\t            reason: `no derived form ${target.form} exists for ${target.subjectKind} ${target.subjectId}`,\n   365\t          },\n   366\t        };\n   367\t      }\n   368\t      if (row.state === \"blocked\") {\n   369\t        // The refusal carries the form's stored reason — the damage named at\n   370\t        // blocking time, not a generic string (AC-4.6).\n   371\t        return {\n   372\t          ok: false,\n   373\t          error: {\n   374\t            errorClass: \"state_corruption\",\n   375\t            code: \"source_damaged\",\n   376\t            reason:\n   377\t              row.reason ??\n   378\t              `form ${target.form} for ${target.subjectKind} ${target.subjectId} is blocked`,\n   379\t          },\n   380\t        };\n   381\t      }\n   382\t      if (hasLiveItem(ctx.db, mapped.kind, mapped.sourceRef, row.sourceVersion)) {\n   383\t        return { ok: true, value: { noop: \"already_queued\" } };\n   384\t      }\n   385\t      const item = enqueue(ctx, {\n   386\t        owner: \"turns\",\n   387\t        kind: mapped.kind,\n   388\t        sourceRef: mapped.sourceRef,\n   389\t        sourceVersion: row.sourceVersion + 1,\n   390\t        forms: mapped.forms,\n   391\t      });\n   392\t      return { ok: true, value: { workItemId: item.workItemId } };\n   393\t    });\n   394\t  } catch (cause) {\n   395\t    const reason = cause instanceof Error ? cause.message : String(cause);\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/index.ts | sed -n '1,520p'\"","aggregated_output":"     1\t// thread-view surface (Epic 03): pull, status, compact, sweep, materialize.\n     2\t// Story 1 lands the skeleton with `pull` and `status` real — the hot-path\n     3\t// reads: local reads and deterministic string assembly only, no inference,\n     4\t// no network, no queue interaction, no writes (AC-1.1, AC-2.8). The other\n     5\t// three are structured-result stubs until their stories (2, 3, 5) land.\n     6\t// Story 0's substrate (profile resolution, consumed by createSdk) re-exports\n     7\t// at the bottom.\n     8\timport { existsSync } from \"node:fs\";\n     9\timport {\n    10\t  resolveInstanceViewConfig,\n    11\t  runWithThreadTouchSuppressed,\n    12\t} from \"../../shared/context.js\";\n    13\timport type { FormReportEntry } from \"../../shared/derivation.js\";\n    14\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n    15\timport type {\n    16\t  CompactReceipt,\n    17\t  PullResult,\n    18\t  ResolvedViewConfig,\n    19\t  SweepReceipt,\n    20\t  ViewCompactParams,\n    21\t  ViewMessage,\n    22\t  ViewProfile,\n    23\t  ViewStatus,\n    24\t} from \"../../shared/view.js\";\n    25\timport * as messagesDomain from \"../messages/index.js\";\n    26\timport * as turnsDomain from \"../turns/index.js\";\n    27\timport {\n    28\t  openThreadDatabase,\n    29\t  resolveThreadRef,\n    30\t  type ThreadRef,\n    31\t} from \"../threads/index.js\";\n    32\timport { readBoundaryPosition, visibilityZoneTokens } from \"./internal/boundary.js\";\n    33\timport { profileViolation, resolveViewConfig } from \"./internal/profiles.js\";\n    34\timport {\n    35\t  assembleBandText,\n    36\t  renderBandMessage,\n    37\t  renderTailMessage,\n    38\t  toolNamesByCallId,\n    39\t} from \"./internal/render.js\";\n    40\timport { fireViewInjection } from \"./internal/seam.js\";\n    41\timport {\n    42\t  CanonicalCorruptionError,\n    43\t  readSelectionInputs,\n    44\t  selectArrangement,\n    45\t  type ArrangementEntry,\n    46\t} from \"./internal/select.js\";\n    47\timport {\n    48\t  readReadyToolResultSummaries,\n    49\t  readTailMessages,\n    50\t  readViewSnapshot,\n    51\t  replaceViewSnapshot,\n    52\t  tailTokenSum,\n    53\t} from \"./internal/snapshot.js\";\n    54\timport { estimateTokens } from \"../../tech-utils/token-counting/index.js\";\n    55\timport type { Band } from \"../../shared/view.js\";\n    56\t\n    57\t// Config resolution for the operation in hand: the SDK instance's resolved\n    58\t// view config rides the per-instance seam (epic-fix-001 pattern, tech design\n    59\t// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\n    60\t// through the same one resolution path createSdk uses.\n    61\tconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\n    62\t\n    63\tfunction viewConfig(): ResolvedViewConfig {\n    64\t  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\n    65\t}\n    66\t\n    67\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n    68\t  return {\n    69\t    ok: false,\n    70\t    error: {\n    71\t      errorClass: \"caller_error\",\n    72\t      code: \"thread_not_found\",\n    73\t      reason: `no thread file exists at ${filePath}`,\n    74\t    },\n    75\t  };\n    76\t}\n    77\t\n    78\tfunction detail(cause: unknown): string {\n    79\t  return cause instanceof Error ? cause.message : String(cause);\n    80\t}\n    81\t\n    82\t// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\n    83\t\n    84\t// The hot-path read: view header + bands (if any), tail messages after the\n    85\t// compact point (deleted-filtered, record order), boundary position; then\n    86\t// format — band messages first, tail per the mapping table, tool results\n    87\t// at-or-behind the boundary in short form. No view row ⇒ the whole record is\n    88\t// tail from event 1 (AC-1.3) through this same code path with the compact\n    89\t// point at its zero origin — snapshot-absent, never a separate branch.\n    90\t//\n    91\t// Reads-only is structural, not disciplined: the whole operation runs in the\n    92\t// touch-suppressed scope, so the open announcement that would let a\n    93\t// background SDK's scheduler hang a first-touch catch-up drain off this read\n    94\t// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\n    95\t// AC-1.1's no-queue-interaction holds in both host modes.\n    96\texport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\n    97\t  return runWithThreadTouchSuppressed(() => pullInner(ref));\n    98\t}\n    99\t\n   100\tasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n   101\t  const resolved = await resolveThreadRef(ref);\n   102\t  if (!resolved.ok) return resolved;\n   103\t  const { filePath } = resolved.value;\n   104\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   105\t\n   106\t  const opened = openThreadDatabase(filePath);\n   107\t  if (!opened.ok) return opened;\n   108\t  const db = opened.value;\n   109\t  try {\n   110\t    const snapshot = readViewSnapshot(db);\n   111\t    const compactPoint = snapshot?.compactPoint ?? 0;\n   112\t    const boundaryPosition = readBoundaryPosition(db);\n   113\t    const tailRows = readTailMessages(db, compactPoint);\n   114\t    const renderCtx = {\n   115\t      boundaryPosition,\n   116\t      toolNameByCallId: toolNamesByCallId(tailRows),\n   117\t      toolResultSummaries: readReadyToolResultSummaries(db),\n   118\t    };\n   119\t\n   120\t    const messages: ViewMessage[] = [];\n   121\t    if (snapshot !== null) {\n   122\t      for (const band of snapshot.bands) {\n   123\t        messages.push(renderBandMessage(band.band, band.renderedText));\n   124\t      }\n   125\t    }\n   126\t    for (const row of tailRows) {\n   127\t      messages.push(renderTailMessage(row, renderCtx));\n   128\t    }\n   129\t\n   130\t    return {\n   131\t      ok: true,\n   132\t      value: {\n   133\t        messages,\n   134\t        meta: {\n   135\t          compactPoint: snapshot?.compactPoint ?? null,\n   136\t          coveredFrom: snapshot?.coveredFrom ?? null,\n   137\t          boundaryPosition,\n   138\t          gapCount: snapshot?.gapCount ?? 0,\n   139\t          degradedCount: snapshot?.degradedCount ?? 0,\n   140\t          viewId: snapshot?.viewId ?? null,\n   141\t          createdAt: snapshot?.createdAt ?? null,\n   142\t        },\n   143\t      },\n   144\t    };\n   145\t  } catch (cause) {\n   146\t    return storageFailure(`view pull failed: ${detail(cause)}`);\n   147\t  } finally {\n   148\t    db.close();\n   149\t  }\n   150\t}\n   151\t\n   152\t// ── status (AC-2.8) ───────────────────────────────────────────────\n   153\t\n   154\t// Derivation counts bucket from one report entry the way the report's own\n   155\t// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\n   156\t// pending, retrying (pending with attempts spent), failed, blocked. Ready\n   157\t// forms are healthy and not an operational situation.\n   158\tfunction bucketDerivation(\n   159\t  entries: readonly FormReportEntry[],\n   160\t  counts: ViewStatus[\"derivation\"],\n   161\t): void {\n   162\t  for (const entry of entries) {\n   163\t    switch (entry.state) {\n   164\t      case \"pending\":\n   165\t        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\n   166\t        else counts.pending += 1;\n   167\t        break;\n   168\t      case \"failed\":\n   169\t        counts.failed += 1;\n   170\t        break;\n   171\t      case \"blocked\":\n   172\t        counts.blocked += 1;\n   173\t        break;\n   174\t      case \"ready\":\n   175\t        break;\n   176\t    }\n   177\t  }\n   178\t}\n   179\t\n   180\t// Reads only, callable any time, no side effects: tail size against the\n   181\t// configured trigger threshold with a compact recommendation (`tailTokens >\n   182\t// threshold`, nothing smarter — the caller owns policy), derivation counts\n   183\t// by state read through the OWNERS' report surfaces (must-not-own: never a\n   184\t// direct derived_form read here), the active view's health or null\n   185\t// pre-compact, and the visibility zone's sum against its max — computed live\n   186\t// by the same query the Story 4 advance will use, so \"visible in status\" is\n   187\t// structural, not stored.\n   188\t//\n   189\t// Like pull, the whole read — including the owners' report surfaces it\n   190\t// consumes — runs in the touch-suppressed scope, so a background SDK's\n   191\t// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n   192\t// host modes).\n   193\texport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n   194\t  return runWithThreadTouchSuppressed(() => statusInner(ref));\n   195\t}\n   196\t\n   197\tasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n   198\t  const resolved = await resolveThreadRef(ref);\n   199\t  if (!resolved.ok) return resolved;\n   200\t  const { filePath } = resolved.value;\n   201\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   202\t\n   203\t  const config = viewConfig();\n   204\t  const opened = openThreadDatabase(filePath);\n   205\t  if (!opened.ok) return opened;\n   206\t  const db = opened.value;\n   207\t  let tailTokens: number;\n   208\t  let zoneTokens: number;\n   209\t  let view: ViewStatus[\"view\"];\n   210\t  try {\n   211\t    const snapshot = readViewSnapshot(db);\n   212\t    const compactPoint = snapshot?.compactPoint ?? 0;\n   213\t    const boundaryPosition = readBoundaryPosition(db);\n   214\t    tailTokens = tailTokenSum(db, compactPoint);\n   215\t    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n   216\t    view =\n   217\t      snapshot === null\n   218\t        ? null\n   219\t        : {\n   220\t            degraded: snapshot.degradedCount,\n   221\t            gaps: snapshot.gapCount,\n   222\t            builtAt: snapshot.createdAt,\n   223\t          };\n   224\t  } catch (cause) {\n   225\t    return storageFailure(`view status failed: ${detail(cause)}`);\n   226\t  } finally {\n   227\t    db.close();\n   228\t  }\n   229\t\n   230\t  // The owners' report surfaces open their own handles; ours is closed first\n   231\t  // so the status read never holds two handles on one thread file.\n   232\t  const messageReport = await messagesDomain.report({ filePath });\n   233\t  if (!messageReport.ok) return messageReport;\n   234\t  const turnReport = await turnsDomain.report({ filePath });\n   235\t  if (!turnReport.ok) return turnReport;\n   236\t  const derivation: ViewStatus[\"derivation\"] = {\n   237\t    pending: 0,\n   238\t    retrying: 0,\n   239\t    failed: 0,\n   240\t    blocked: 0,\n   241\t  };\n   242\t  bucketDerivation(messageReport.value, derivation);\n   243\t  bucketDerivation(turnReport.value, derivation);\n   244\t\n   245\t  return {\n   246\t    ok: true,\n   247\t    value: {\n   248\t      tailTokens,\n   249\t      threshold: config.compactThreshold,\n   250\t      compactRecommended: tailTokens > config.compactThreshold,\n   251\t      derivation,\n   252\t      view,\n   253\t      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\n   254\t    },\n   255\t  };\n   256\t}\n   257\t\n   258\t// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\n   259\t\n   260\t// The default base when no profile is named: the first built-in, matching\n   261\t// the epic's primary user (the PI continuation harness). Explicit params\n   262\t// override the base field-wise (AC-2.2).\n   263\tconst DEFAULT_PROFILE_NAME = \"continuation\";\n   264\t\n   265\tfunction callerError(\n   266\t  code: \"unknown_profile\" | \"invalid_view_config\",\n   267\t  reason: string,\n   268\t): { ok: false; error: ErrorResult } {\n   269\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n   270\t}\n   271\t\n   272\tconst BAND_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n   273\t\n   274\t// Compact runs only when invoked through this surface (AC-2.1: no code path\n   275\t// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\n   276\t// rejection provably touches nothing) → [sweep step ABSENT this story — the\n   277\t// receipt's sweep field reports the literal \"absent\"; Story 3 embeds the\n   278\t// real sweep here per stories/02-smart-compact.md §Scope out] → read record\n   279\t// + forms with the corruption check in the reads (pre-transaction, prior\n   280\t// view trivially intact on refusal) → selection walk → band rendering → one\n   281\t// BEGIN IMMEDIATE replacing the view and resetting the boundary → receipt.\n   282\t// Assembly is entirely from stored artifacts: nothing here can reach a\n   283\t// provider (AC-2.4 zero-inference is structural).\n   284\texport async function compact(\n   285\t  ref: ThreadRef,\n   286\t  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n   287\t): Promise<OpResult<CompactReceipt>> {\n   288\t  const resolved = await resolveThreadRef(ref);\n   289\t  if (!resolved.ok) return resolved;\n   290\t  const { filePath } = resolved.value;\n   291\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   292\t\n   293\t  const config = viewConfig();\n   294\t  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\n   295\t  const base = config.profiles[baseName];\n   296\t  if (base === undefined) {\n   297\t    return callerError(\n   298\t      \"unknown_profile\",\n   299\t      `unknown profile \"${baseName}\"; configured profiles are ${Object.keys(config.profiles)\n   300\t        .map((name) => `\"${name}\"`)\n   301\t        .join(\", \")}`,\n   302\t    );\n   303\t  }\n   304\t  const merged: ViewProfile = {\n   305\t    name: base.name,\n   306\t    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\n   307\t    percentages: { ...base.percentages, ...opts.params?.percentages },\n   308\t  };\n   309\t  const violation = profileViolation(merged);\n   310\t  if (violation !== null) return callerError(\"invalid_view_config\", violation);\n   311\t  // Receipt provenance: \"null when explicit params\" (tech design §Storage) —\n   312\t  // any param override means the config is no longer a named profile's mix,\n   313\t  // even when one served as the merge base; the receipt's config carries the\n   314\t  // resolved truth. A bare or profile-only call names its profile.\n   315\t  const profileName = opts.params === undefined ? baseName : null;\n   316\t\n   317\t  const opened = openThreadDatabase(filePath);\n   318\t  if (!opened.ok) return opened;\n   319\t  const db = opened.value;\n   320\t  try {\n   321\t    let inputs;\n   322\t    try {\n   323\t      inputs = readSelectionInputs(db);\n   324\t    } catch (cause) {\n   325\t      if (cause instanceof CanonicalCorruptionError) {\n   326\t        // Pre-transaction refusal: nothing was written, the prior view and\n   327\t        // the record are untouched (AC-2.5).\n   328\t        return {\n   329\t          ok: false,\n   330\t          error: { errorClass: \"state_corruption\", code: cause.code, reason: cause.message },\n   331\t        };\n   332\t      }\n   333\t      throw cause;\n   334\t    }\n   335\t    const selection = selectArrangement(inputs, {\n   336\t      lowerBound: merged.lowerBound,\n   337\t      percentages: merged.percentages,\n   338\t    });\n   339\t\n   340\t    const entriesByBand = (band: Band): ArrangementEntry[] =>\n   341\t      selection.entries.filter((entry) => entry.band === band);\n   342\t    const bands = BAND_ORDER.flatMap((band) => {\n   343\t      const entries = entriesByBand(band);\n   344\t      if (entries.length === 0) return [];\n   345\t      const renderedText = assembleBandText(entries.map((entry) => entry.text));\n   346\t      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\n   347\t    });\n   348\t\n   349\t    const createdAt = new Date().toISOString();\n   350\t    // view_id is v<compact event order> — deterministic, and deliberately\n   351\t    // reused by an intake-free recompact (tech design L395: do not \"fix\"\n   352\t    // into a uniqueness scheme; the singleton row is replaced whole).\n   353\t    const viewId = `v${inputs.maxEventOrder}`;\n   354\t\n   355\t    // Story-0 injection point: TC-2.4's crash between the (absent) sweep and\n   356\t    // the view-write transaction. An installed hook's throw aborts here —\n   357\t    // before BEGIN — so the previous view keeps serving.\n   358\t    fireViewInjection(\"compact-write\");\n   359\t\n   360\t    replaceViewSnapshot(db, {\n   361\t      viewId,\n   362\t      createdAt,\n   363\t      compactPoint: selection.compactPoint,\n   364\t      coveredFrom: selection.coveredFrom,\n   365\t      profileName,\n   366\t      configJson: JSON.stringify({\n   367\t        lowerBound: merged.lowerBound,\n   368\t        percentages: merged.percentages,\n   369\t      }),\n   370\t      arrangementJson: JSON.stringify(\n   371\t        selection.entries.map((entry) => ({\n   372\t          band: entry.band,\n   373\t          subjectKind: entry.subjectKind,\n   374\t          subjectId: entry.subjectId,\n   375\t          formUsed: entry.formUsed,\n   376\t          degraded: entry.degraded,\n   377\t        })),\n   378\t      ),\n   379\t      gapsJson: JSON.stringify(\n   380\t        selection.entries\n   381\t          .filter((entry) => entry.gap)\n   382\t          .map((entry) => ({\n   383\t            band: entry.band,\n   384\t            subjectId: entry.subjectId,\n   385\t            reason: entry.reason ?? \"unknown\",\n   386\t          })),\n   387\t      ),\n   388\t      sourceStateJson: JSON.stringify({\n   389\t        maxEventOrder: inputs.maxEventOrder,\n   390\t        formCounts: inputs.formCounts,\n   391\t      }),\n   392\t      bands,\n   393\t    });\n   394\t\n   395\t    const bandReport = {} as CompactReceipt[\"bands\"];\n   396\t    for (const band of BAND_ORDER) {\n   397\t      const stored = bands.find((row) => row.band === band);\n   398\t      bandReport[band] = {\n   399\t        entries: entriesByBand(band).length,\n   400\t        tokens: stored?.tokenCount ?? 0,\n   401\t      };\n   402\t    }\n   403\t    const tailTokens = tailTokenSum(db, selection.compactPoint);\n   404\t    return {\n   405\t      ok: true,\n   406\t      value: {\n   407\t        viewId,\n   408\t        profile: profileName,\n   409\t        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n   410\t        bands: bandReport,\n   411\t        tailTokens,\n   412\t        // Actual assembled total vs the bound (target, not cap — AC-2.4).\n   413\t        totalTokens:\n   414\t          bandReport.brief.tokens +\n   415\t          bandReport.detailed.tokens +\n   416\t          bandReport.smooth.tokens +\n   417\t          tailTokens,\n   418\t        coveredFrom: selection.coveredFrom,\n   419\t        compactPoint: selection.compactPoint,\n   420\t        degraded: selection.entries\n   421\t          .filter((entry) => entry.degraded)\n   422\t          .map((entry) => ({\n   423\t            band: entry.band,\n   424\t            subjectId: entry.subjectId,\n   425\t            usedForm: entry.formUsed,\n   426\t          })),\n   427\t        gaps: selection.entries\n   428\t          .filter((entry) => entry.gap)\n   429\t          .map((entry) => ({\n   430\t            band: entry.band,\n   431\t            subjectId: entry.subjectId,\n   432\t            reason: entry.reason ?? \"unknown\",\n   433\t          })),\n   434\t        // Sweep step absent this story (NOT skipped, NOT an empty receipt):\n   435\t        // Story 3 embeds the sweep and flips this field's vocabulary.\n   436\t        sweep: \"absent\",\n   437\t      },\n   438\t    };\n   439\t  } catch (cause) {\n   440\t    return storageFailure(`view compact failed: ${detail(cause)}`);\n   441\t  } finally {\n   442\t    db.close();\n   443\t  }\n   444\t}\n   445\t\n   446\t// ── stubs (Stories 3, 5) ─────────────────────────────────────────\n   447\t\n   448\t// The skeleton's stub contract (tech design §Interface Definitions):\n   449\t// structured result, machine-readable, never a throw on this surface.\n   450\tfunction notImplemented(op: string): { ok: false; error: ErrorResult } {\n   451\t  return {\n   452\t    ok: false,\n   453\t    error: {\n   454\t      errorClass: \"system_error\",\n   455\t      code: \"not_implemented\",\n   456\t      reason: `not implemented: ${op}`,\n   457\t    },\n   458\t  };\n   459\t}\n   460\t\n   461\texport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\n   462\t  void ref;\n   463\t  return notImplemented(\"sweep\");\n   464\t}\n   465\t\n   466\texport async function materialize(\n   467\t  ref: ThreadRef,\n   468\t  opts: { path: string; format?: \"pi-session\" },\n   469\t): Promise<OpResult<{ writtenPath: string }>> {\n   470\t  void ref;\n   471\t  void opts;\n   472\t  return notImplemented(\"materialize\");\n   473\t}\n   474\t\n   475\t// ── Story 0 substrate (consumed by createSdk at construction) ─────\n   476\texport {\n   477\t  BUILT_IN_PROFILES,\n   478\t  DEFAULT_COMPACT_THRESHOLD,\n   479\t  DEFAULT_VISIBILITY,\n   480\t  resolveViewConfig,\n   481\t} from \"./internal/profiles.js\";\n","exit_code":0,"status":"completed"}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WCfH1EwuGWWEwx4io2FxP7","type":"tool_result","content":"1\timport { DatabaseSync } from \"node:sqlite\";\n2\t\n3\t// The one sanctioned below-SDK write in the test suite: inserts a second\n4\t// status='open' turn row, a state no public operation can produce (the state\n5\t// machine always closes before opening). Columns match the Story 4 turn\n6\t// schema in threads/internal/create.ts.\n7\texport function corruptTwoOpenTurns(path: string): void {\n8\t  const db = new DatabaseSync(path);\n9\t  try {\n10\t    const row = db\n11\t      .prepare(\"SELECT MAX(turn_order) AS max_order FROM turns\")\n12\t      .get() as { max_order: number | bigint | null } | undefined;\n13\t    const nextOrder = Number(row?.max_order ?? 0) + 1;\n14\t    db.prepare(\n15\t      \"INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order) VALUES (?, ?, 'open', ?)\",\n16\t    ).run(`t${nextOrder}`, nextOrder, 0);\n17\t  } finally {\n18\t    db.close();\n19\t  }\n20\t}\n21\t"}]},"parent_tool_use_id":null,"session_id":"9b79ae20-893f-4407-8201-b760b8487b13","uuid":"2487ee6e-a32e-4c6a-9b6c-b82322318b09","timestamp":"2026-06-11T14:03:35.824Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/corrupt.ts","content":"import { DatabaseSync } from \"node:sqlite\";\n\n// The one sanctioned below-SDK write in the test suite: inserts a second\n// status='open' turn row, a state no public operation can produce (the state\n// machine always closes before opening). Columns match the Story 4 turn\n// schema in threads/internal/create.ts.\nexport function corruptTwoOpenTurns(path: string): void {\n  const db = new DatabaseSync(path);\n  try {\n    const row = db\n      .prepare(\"SELECT MAX(turn_order) AS max_order FROM turns\")\n      .get() as { max_order: number | bigint | null } | undefined;\n    const nextOrder = Number(row?.max_order ?? 0) + 1;\n    db.prepare(\n      \"INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order) VALUES (?, ?, 'open', ?)\",\n    ).run(`t${nextOrder}`, nextOrder, 0);\n  } finally {\n    db.close();\n  }\n}\n","numLines":21,"startLine":1,"totalLines":21}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BFpNLJzcqBKUmSTTbdvhFe","type":"tool_result","content":"1\timport { DatabaseSync } from \"node:sqlite\";\n2\t\n3\texport interface Migration {\n4\t  version: number; // 1-based, strictly increasing\n5\t  statements: readonly string[];\n6\t}\n7\t\n8\texport function openDatabase(path: string): DatabaseSync {\n9\t  const db = new DatabaseSync(path);\n10\t  db.exec(\"PRAGMA journal_mode = WAL;\");\n11\t  db.exec(\"PRAGMA foreign_keys = ON;\");\n12\t  db.exec(\"PRAGMA busy_timeout = 5000;\");\n13\t  db.exec(\"PRAGMA synchronous = NORMAL;\");\n14\t  return db;\n15\t}\n16\t\n17\t// Epic 02's single migration (tech design §Storage): queue mechanical fields\n18\t// on the existing work_item table, the derived_form state table, the chunk\n19\t// tables, and the projection-level delete stamps. The whole epic's schema\n20\t// lands in one version — behavior arrives story by story. Assembled into the\n21\t// thread-file migration history by threads/internal/create.ts.\n22\texport const MIGRATION_V5_STATEMENTS: readonly string[] = [\n23\t  // claim mechanics on the existing table (DD-1: no disposition column —\n24\t  // queue rows are live work only; terminal rows are deleted and their\n25\t  // outcomes reported in-memory; durable outcome state lives on derived_form)\n26\t  `ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`,\n27\t  `ALTER TABLE work_item ADD COLUMN last_error TEXT;`,\n28\t  `ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`,\n29\t  `ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`,\n30\t  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\n31\t  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\n32\t  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\n33\t  // inside an index definition, so the index covers the two real columns and\n34\t  // claimNext's ORDER BY rowid walks the head as before.\n35\t  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\n36\t  // Call-id pairing index (Story 2): the tool-activity handlers' paired-read\n37\t  // and intake's AC-2.8 late-result lookup are each one indexed query by\n38\t  // call id — never a block scan (anti-shim requirement).\n39\t  `CREATE INDEX idx_message_block_tool_call_id\n40\t     ON message_block (block_type, json_extract(content, '$.toolCallId'));`,\n41\t  `CREATE TABLE derived_form (\n42\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n43\t    subject_id   TEXT NOT NULL,\n44\t    form         TEXT NOT NULL,\n45\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n46\t    content      TEXT,\n47\t    reason       TEXT,\n48\t    metadata     TEXT,\n49\t    source_version INTEGER NOT NULL DEFAULT 1,\n50\t    gaps         TEXT,\n51\t    derived_at   TEXT,\n52\t    PRIMARY KEY (subject_kind, subject_id, form)\n53\t  );`,\n54\t  `CREATE TABLE chunk (\n55\t    chunk_id     TEXT PRIMARY KEY,\n56\t    chunk_order  INTEGER NOT NULL UNIQUE,\n57\t    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\n58\t    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\n59\t  );`,\n60\t  `CREATE TABLE chunk_member (\n61\t    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\n62\t    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\n63\t    member_idx INTEGER NOT NULL,\n64\t    PRIMARY KEY (chunk_id, member_idx)\n65\t  );`,\n66\t  // projection-level delete (the record keeps everything; reads filter)\n67\t  `ALTER TABLE message ADD COLUMN deleted_at TEXT;`,\n68\t  `ALTER TABLE turns   ADD COLUMN deleted_at TEXT;`,\n69\t  // F-02 backfill: pending form rows for work queued before v5 existed, so\n70\t  // UPDATE-only completion finds them (row missing must mean deleted).\n71\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n72\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'smoothed_prompt', 'pending', 1\n73\t    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\n74\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n75\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'tool_result_summary', 'pending', 1\n76\t    FROM work_item WHERE status = 'queued' AND kind = 'tool_result_summary';`,\n77\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n78\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'turn_rendering', 'pending', 1\n79\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n80\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n81\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'lower_band_projection', 'pending', 1\n82\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n83\t];\n84\t\n85\texport function getSchemaVersion(db: DatabaseSync): number {\n86\t  const row = db.prepare(\"PRAGMA user_version\").get() as\n87\t    | { user_version: number | bigint }\n88\t    | undefined;\n89\t  return Number(row?.user_version ?? 0);\n90\t}\n91\t\n92\texport function runMigrations(\n93\t  db: DatabaseSync,\n94\t  migrations: readonly Migration[],\n95\t): void {\n96\t  let current = getSchemaVersion(db);\n97\t  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n98\t  for (const migration of ordered) {\n99\t    if (migration.version <= current) continue;\n100\t    db.exec(\"BEGIN IMMEDIATE;\");\n101\t    try {\n102\t      for (const statement of migration.statements) db.exec(statement);\n103\t      db.exec(`PRAGMA user_version = ${migration.version};`);\n104\t      db.exec(\"COMMIT;\");\n105\t    } catch (cause) {\n106\t      db.exec(\"ROLLBACK;\");\n107\t      throw cause;\n108\t    }\n109\t    current = migration.version;\n110\t  }\n111\t}\n112\t"}]},"parent_tool_use_id":null,"session_id":"9b79ae20-893f-4407-8201-b760b8487b13","uuid":"e6d1fa3f-89f2-4543-a53f-e64be63e8ea2","timestamp":"2026-06-11T14:02:49.343Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/storage.ts","content":"import { DatabaseSync } from \"node:sqlite\";\n\nexport interface Migration {\n  version: number; // 1-based, strictly increasing\n  statements: readonly string[];\n}\n\nexport function openDatabase(path: string): DatabaseSync {\n  const db = new DatabaseSync(path);\n  db.exec(\"PRAGMA journal_mode = WAL;\");\n  db.exec(\"PRAGMA foreign_keys = ON;\");\n  db.exec(\"PRAGMA busy_timeout = 5000;\");\n  db.exec(\"PRAGMA synchronous = NORMAL;\");\n  return db;\n}\n\n// Epic 02's single migration (tech design §Storage): queue mechanical fields\n// on the existing work_item table, the derived_form state table, the chunk\n// tables, and the projection-level delete stamps. The whole epic's schema\n// lands in one version — behavior arrives story by story. Assembled into the\n// thread-file migration history by threads/internal/create.ts.\nexport const MIGRATION_V5_STATEMENTS: readonly string[] = [\n  // claim mechanics on the existing table (DD-1: no disposition column —\n  // queue rows are live work only; terminal rows are deleted and their\n  // outcomes reported in-memory; durable outcome state lives on derived_form)\n  `ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`,\n  `ALTER TABLE work_item ADD COLUMN last_error TEXT;`,\n  `ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`,\n  `ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`,\n  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\n  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\n  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\n  // inside an index definition, so the index covers the two real columns and\n  // claimNext's ORDER BY rowid walks the head as before.\n  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\n  // Call-id pairing index (Story 2): the tool-activity handlers' paired-read\n  // and intake's AC-2.8 late-result lookup are each one indexed query by\n  // call id — never a block scan (anti-shim requirement).\n  `CREATE INDEX idx_message_block_tool_call_id\n     ON message_block (block_type, json_extract(content, '$.toolCallId'));`,\n  `CREATE TABLE derived_form (\n    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n    subject_id   TEXT NOT NULL,\n    form         TEXT NOT NULL,\n    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n    content      TEXT,\n    reason       TEXT,\n    metadata     TEXT,\n    source_version INTEGER NOT NULL DEFAULT 1,\n    gaps         TEXT,\n    derived_at   TEXT,\n    PRIMARY KEY (subject_kind, subject_id, form)\n  );`,\n  `CREATE TABLE chunk (\n    chunk_id     TEXT PRIMARY KEY,\n    chunk_order  INTEGER NOT NULL UNIQUE,\n    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\n    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\n  );`,\n  `CREATE TABLE chunk_member (\n    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\n    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\n    member_idx INTEGER NOT NULL,\n    PRIMARY KEY (chunk_id, member_idx)\n  );`,\n  // projection-level delete (the record keeps everything; reads filter)\n  `ALTER TABLE message ADD COLUMN deleted_at TEXT;`,\n  `ALTER TABLE turns   ADD COLUMN deleted_at TEXT;`,\n  // F-02 backfill: pending form rows for work queued before v5 existed, so\n  // UPDATE-only completion finds them (row missing must mean deleted).\n  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    SELECT 'message', json_extract(source_ref, '$.messageId'), 'smoothed_prompt', 'pending', 1\n    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\n  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    SELECT 'message', json_extract(source_ref, '$.messageId'), 'tool_result_summary', 'pending', 1\n    FROM work_item WHERE status = 'queued' AND kind = 'tool_result_summary';`,\n  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'turn_rendering', 'pending', 1\n    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'lower_band_projection', 'pending', 1\n    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n];\n\nexport function getSchemaVersion(db: DatabaseSync): number {\n  const row = db.prepare(\"PRAGMA user_version\").get() as\n    | { user_version: number | bigint }\n    | undefined;\n  return Number(row?.user_version ?? 0);\n}\n\nexport function runMigrations(\n  db: DatabaseSync,\n  migrations: readonly Migration[],\n): void {\n  let current = getSchemaVersion(db);\n  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n  for (const migration of ordered) {\n    if (migration.version <= current) continue;\n    db.exec(\"BEGIN IMMEDIATE;\");\n    try {\n      for (const statement of migration.statements) db.exec(statement);\n      db.exec(`PRAGMA user_version = ${migration.version};`);\n      db.exec(\"COMMIT;\");\n    } catch (cause) {\n      db.exec(\"ROLLBACK;\");\n      throw cause;\n    }\n    current = migration.version;\n  }\n}\n","numLines":112,"startLine":1,"totalLines":112}}}

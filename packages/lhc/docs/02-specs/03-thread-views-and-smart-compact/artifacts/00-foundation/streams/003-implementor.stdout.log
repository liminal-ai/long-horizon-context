      for (const fn of callbacks.splice(0)) fn();\n39\t    },\n40\t  };\n41\t}\n42\t\n43\t// Per-SDK-instance delivery seam (DD-5/DD-10, epic-fix-001). Each SDK runs\n44\t// every one of its operations inside runWithInstanceSeam, so the code reached\n45\t// deep inside — enqueue's poke and openThreadDatabase's touch — delivers to\n46\t// THAT SDK's scheduler (background) or to a no-op (manual), isolated from any\n47\t// other SDK in the process. Carried through async-context, not a mutable\n48\t// module slot two SDKs would share: that sharing was the bug — a manual SDK\n49\t// auto-drained because a background SDK had overwritten the global slot.\n50\texport interface InstanceSeam {\n51\t  poke: (threadId: string) => void;\n52\t  touch: (filePath: string, db: DatabaseSync) => void;\n53\t}\n54\tconst seamStore = new AsyncLocalStorage<InstanceSeam>();\n55\t\n56\texport function runWithInstanceSeam<T>(seam: InstanceSeam, fn: () => T): T {\n57\t  return seamStore.run(seam, fn);\n58\t}\n59\t\n60\t// The below-SDK default seam (the former module-global poke/touch slots),\n61\t// kept ONLY as the fallback for direct domain calls made with no SDK seam in\n62\t// scope: the enqueue-atomicity tests that drive enqueue/runInTransaction\n63\t// directly, and the single-background \"production path\" where a top-level\n64\t// mutation still reaches the one installed scheduler. A background SDK\n65\t// installs itself here at construction; a manual SDK leaves it alone AND\n66\t// scopes its own operations to a no-op seam, so the fallback can never\n67\t// auto-drain a manual SDK's queued work.\n68\ttype SchedulerPoke = (threadId: string) => void;\n69\tlet schedulerPoke: SchedulerPoke | null = null;\n70\t\n71\texport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n72\t  schedulerPoke = poke;\n73\t}\n74\t\n75\ttype ThreadTouch = (filePath: string, db: DatabaseSync) => void;\n76\tlet threadTouch: ThreadTouch | null = null;\n77\t\n78\texport function setThreadTouch(touch: ThreadTouch | null): void {\n79\t  threadTouch = touch;\n80\t}\n81\t\n82\t// The poke target for a context built now: the running SDK's seam if one is\n83\t// in scope, else the below-SDK default (null-safe). Captured onto ctx.poke so\n84\t// the enqueue carries its target rather than reading a shared slot at fire\n85\t// time — except, deliberately, through the default fallback for direct calls.\n86\texport function resolveInstancePoke(): (threadId: string) => void {\n87\t  const seam = seamStore.getStore();\n88\t  if (seam !== undefined) return seam.poke;\n89\t  return (threadId) => {\n90\t    schedulerPoke?.(threadId);\n91\t  };\n92\t}\n93\t\n94\t// Thread-file open announcement (DD-10): openThreadDatabase fires this on\n95\t// every open, before any caller transaction begins. Delivers to the SDK seam\n96\t// in scope if any (background → first-touch catch-up; manual → no-op), else\n97\t// the below-SDK default. The background scheduler learns threadId→filePath\n98\t// and runs the first-touch catch-up off this seam.\n99\texport function fireThreadTouch(filePath: string, db: DatabaseSync): void {\n100\t  const seam = seamStore.getStore();\n101\t  if (seam !== undefined) {\n102\t    seam.touch(filePath, db);\n103\t    return;\n104\t  }\n105\t  threadTouch?.(filePath, db);\n106\t}\n107\t\n108\t// Transaction owner for operations outside the intake pipeline (mutations,\n109\t// repair re-queues, tests of enqueue atomicity): BEGIN IMMEDIATE, run the\n110\t// body with a context whose onCommit registrations flush only after COMMIT\n111\t// succeeds and drop whole on rollback.\n112\texport function runInTransaction<T>(\n113\t  db: DatabaseSync,\n114\t  clock: () => Date,\n115\t  threadId: string,\n116\t  fn: (ctx: OperationContext) => T,\n117\t): T {\n118\t  const hooks = createCommitHooks();\n119\t  const poke = resolveInstancePoke();\n120\t  db.exec(\"BEGIN IMMEDIATE;\");\n121\t  let value: T;\n122\t  try {\n123\t    value = fn({ db, clock, threadId, onCommit: ho
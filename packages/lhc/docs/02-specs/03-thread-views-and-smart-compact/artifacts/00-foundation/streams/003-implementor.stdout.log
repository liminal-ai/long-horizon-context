{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FTrsk5zqz3ZnApYVQojwTW","type":"tool_result","content":"1\t// F-03-001: an existing valid Story 2 thread file (user_version=1, only\n2\t// thread_metadata/event tables) must be migrated to the current schema before\n3\t// any Story 3 message write or read. The fixture reproduces the accepted\n4\t// Story 2 on-disk layout exactly; the assertions go through the production\n5\t// entry points (messageEvents, listMessages, listEvents) plus below-SDK\n6\t// schema-version reads.\n7\t// F-03-002: the lazy opener must reject existing files that are not thread\n8\t// files without creating lhc schema or bumping user_version on them.\n9\timport { readFileSync, writeFileSync } from \"node:fs\";\n10\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n11\timport { intakeStream, messages, turns } from \"../src/index.js\";\n12\timport {\n13\t  legacyEpic01ThreadFile,\n14\t  legacyStory2ThreadFile,\n15\t  openRaw,\n16\t  readDerivedForms,\n17\t  schemaVersionOf,\n18\t  tempStore,\n19\t  validEvent,\n20\t  type TempStore,\n21\t} from \"./fixtures/index.js\";\n22\t\n23\tlet store: TempStore;\n24\tbeforeEach(() => {\n25\t  store = tempStore();\n26\t});\n27\tafterEach(() => {\n28\t  store.cleanup();\n29\t});\n30\t\n31\tconst legacyEvent = {\n32\t  eventOrder: 1,\n33\t  eventKind: \"user_prompt\",\n34\t  idempotencyKey: \"legacy-key-1\",\n35\t  actor: \"legacy-actor\",\n36\t  harness: \"legacy-harness\",\n37\t  payload: { text: \"recorded before story 3 shipped\" },\n38\t  recordedAt: \"2026-06-01T00:00:01.000Z\",\n39\t};\n40\t\n41\tdescribe(\"F-03-001: Story 2 thread files migrate before message write/read\", () => {\n42\t  it(\"messageEvents on a Story 2 file upgrades the schema, keeps the legacy record intact, and projects the new events\", async () => {\n43\t    const filePath = store.threadPath();\n44\t    legacyStory2ThreadFile(filePath, \"th_legacy01\", [legacyEvent]);\n45\t    expect(schemaVersionOf(filePath)).toBe(1);\n46\t\n47\t    const result = await intakeStream.messageEvents({ filePath }, [\n48\t      validEvent(\"assistant_text\", { payload: { text: \"answered after upgrade\" } }),\n49\t      validEvent(\"turn_end\"),\n50\t    ]);\n51\t    expect(result.ok).toBe(true);\n52\t    if (!result.ok) return;\n53\t    expect(result.value.events.map((entry) => entry.outcome)).toEqual([\n54\t      \"recorded\",\n55\t      \"recorded\",\n56\t    ]);\n57\t    // The order counter continues from the legacy record; the new message id\n58\t    // derives from the continued order.\n59\t    expect(result.value.threadPosition.lastEventOrder).toBe(3);\n60\t    expect(result.value.events[0]!.messageId).toBe(\"m2\");\n61\t\n62\t    expect(schemaVersionOf(filePath)).toBe(5);\n63\t\n64\t    // The legacy event survives the upgrade byte-for-byte at the SDK level.\n65\t    const events = await intakeStream.listEvents({ filePath });\n66\t    expect(events.ok).toBe(true);\n67\t    if (!events.ok) return;\n68\t    expect(events.value).toHaveLength(3);\n69\t    expect(events.value[0]).toEqual({\n70\t      eventKind: \"user_prompt\",\n71\t      idempotencyKey: \"legacy-key-1\",\n72\t      actor: \"legacy-actor\",\n73\t      harness: \"legacy-harness\",\n74\t      payload: { text: \"recorded before story 3 shipped\" },\n75\t      eventOrder: 1,\n76\t      recordedAt: \"2026-06-01T00:00:01.000Z\",\n77\t    });\n78\t\n79\t    // Projection is intake-time, not retroactive: the new assistant_text\n80\t    // projects; the legacy pre-Story-3 event stays event-only.\n81\t    const projected = await messages.listMessages({ filePath });\n82\t    expect(projected.ok).toBe(true);\n83\t    if (!projected.ok) return;\n84\t    expect(projected.value).toHaveLength(1);\n85\t    expect(projected.value[0]!.messageId).toBe(\"m2\");\n86\t    expect(projected.value[0]!.sourceEventOrder).toBe(2);\n87\t    expect(projected.value[0]!.blocks).toEqual([\n88\t      { blockType: \"text\", content: { text: \"answered after upgrade\" } },\n89\t    ]);\n90\t    expect(projected.value[0]!.tokenEstimate).toBeGreaterThan(0);\n91\t  });\n92\t\n93\t  it(\"listMessages on an untouched Story 2 file migrates on read and returns an empty list\", async () => {\n94\t    const filePath = store.threadPath();\n95\t    legacyStory2ThreadFile(filePath, \"th_legacy02\", [legacyEvent]);\n96\t    expect(schemaVersionOf(filePath)).toBe(1);\n97\t\n98\t    const projected = await messages.listMessages({ filePath });\n99\t    expect(projected.ok).toBe(true);\n100\t    if (!projected.ok) return;\n101\t    expect(projected.value).toEqual([]);\n102\t\n103\t    expect(schemaVersionOf(filePath)).toBe(5);\n104\t\n105\t    // The read-path upgrade changed no record content.\n106\t    const events = await intakeStream.listEvents({ filePath });\n107\t    expect(events.ok).toBe(true);\n108\t    if (!events.ok) return;\n109\t    expect(events.value).toHaveLength(1);\n110\t    expect(events.value[0]!.idempotencyKey).toBe(\"legacy-key-1\");\n111\t  });\n112\t\n113\t  it(\"idempotency keys recorded under Story 2 still skip after the upgrade\", async () => {\n114\t    const filePath = store.threadPath();\n115\t    legacyStory2ThreadFile(filePath, \"th_legacy03\", [legacyEvent]);\n116\t\n117\t    const resend = await intakeStream.messageEvents({ filePath }, [\n118\t      validEvent(\"user_prompt\", {\n119\t        idempotencyKey: \"legacy-key-1\",\n120\t        payload: { text: \"resent after upgrade\" },\n121\t      }),\n122\t    ]);\n123\t    expect(resend.ok).toBe(true);\n124\t    if (!resend.ok) return;\n125\t    expect(resend.value.events[0]).toEqual({\n126\t      idempotencyKey: \"legacy-key-1\",\n127\t      outcome: \"skipped\",\n128\t      skipReason: \"duplicate_idempotency_key\",\n129\t    });\n130\t\n131\t    // No message was created for the skipped resend of the legacy event.\n132\t    const projected = await messages.listMessages({ filePath });\n133\t    expect(projected.ok).toBe(true);\n134\t    if (!projected.ok) return;\n135\t    expect(projected.value).toEqual([]);\n136\t  });\n137\t});\n138\t\n139\t// Tables present in a file, by name — asserts what schema (if any) the\n140\t// rejected open left behind.\n141\tfunction tableNames(filePath: string): string[] {\n142\t  const db = openRaw(filePath);\n143\t  try {\n144\t    const rows = db\n145\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name\")\n146\t      .all() as unknown as Array<{ name: string }>;\n147\t    return rows.map((row) => row.name);\n148\t  } finally {\n149\t    db.close();\n150\t  }\n151\t}\n152\t\n153\tdescribe(\"F-03-002: non-thread files are rejected, not adopted\", () => {\n154\t  it(\"listMessages against an existing empty database file fails without creating schema or bumping user_version\", async () => {\n155\t    const filePath = store.threadPath();\n156\t    writeFileSync(filePath, \"\"); // exists, zero bytes — a valid empty SQLite database\n157\t\n158\t    const result = await messages.listMessages({ filePath });\n159\t    expect(result.ok).toBe(false);\n160\t    if (result.ok) return;\n161\t    expect(result.error.errorClass).toBe(\"caller_error\");\n162\t    expect(result.error.code).toBe(\"thread_not_found\");\n163\t    expect(result.error.reason).toContain(\"not an lhc thread file\");\n164\t\n165\t    expect(schemaVersionOf(filePath)).toBe(0);\n166\t    expect(tableNames(filePath)).toEqual([]);\n167\t  });\n168\t\n169\t  it(\"messageEvents against an unrelated SQLite database fails and leaves its content untouched\", async () => {\n170\t    const filePath = store.threadPath();\n171\t    const foreign = openRaw(filePath);\n172\t    try {\n173\t      foreign.exec(\"CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT NOT NULL);\");\n174\t      foreign.prepare(\"INSERT INTO notes (id, body) VALUES (1, ?)\").run(\"not lhc data\");\n175\t    } finally {\n176\t      foreign.close();\n177\t    }\n178\t\n179\t    const result = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n180\t    expect(result.ok).toBe(false);\n181\t    if (result.ok) return;\n182\t    expect(result.error.errorClass).toBe(\"caller_error\");\n183\t    expect(result.error.code).toBe(\"thread_not_found\");\n184\t    expect(result.error.reason).toContain(\"not an lhc thread file\");\n185\t\n186\t    // No lhc tables were created, the version was not bumped, and the\n187\t    // foreign data is intact.\n188\t    expect(schemaVersionOf(filePath)).toBe(0);\n189\t    expect(tableNames(filePath)).toEqual([\"notes\"]);\n190\t    const db = openRaw(filePath);\n191\t    try {\n192\t      const row = db.prepare(\"SELECT body FROM notes WHERE id = 1\").get() as unknown as {\n193\t        body: string;\n194\t      };\n195\t      expect(row.body).toBe(\"not lhc data\");\n196\t    } finally {\n197\t      db.close();\n198\t    }\n199\t  });\n200\t\n201\t  it(\"a non-SQLite file is rejected as a caller error with its bytes unchanged\", async () => {\n202\t    const filePath = store.threadPath();\n203\t    const original = \"just some text, definitely not a database\\n\";\n204\t    writeFileSync(filePath, original);\n205\t\n206\t    const listed = await messages.listMessages({ filePath });\n207\t    expect(listed.ok).toBe(false);\n208\t    if (listed.ok) return;\n209\t    expect(listed.error.errorClass).toBe(\"caller_error\");\n210\t    expect(listed.error.code).toBe(\"thread_not_found\");\n211\t\n212\t    const batched = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n213\t    expect(batched.ok).toBe(false);\n214\t    if (batched.ok) return;\n215\t    expect(batched.error.errorClass).toBe(\"caller_error\");\n216\t    expect(batched.error.code).toBe(\"thread_not_found\");\n217\t\n218\t    expect(readFileSync(filePath, \"utf8\")).toBe(original);\n219\t  });\n220\t});\n221\t\n222\t// Story 0 (Epic 02), FC-0.5 + architecture risk \"migration on live data\":\n223\t// v5 applies in place to a populated Epic 01 file — existing rows intact,\n224\t// new columns defaulted, the F-02 backfill creating pending derived_form\n225\t// rows for live queued items. A fresh-file migration test would pass while\n226\t// breaking real threads; this one runs over real Epic 01 data.\n227\tdescribe(\"FC-0.5: migration v5 over a populated Epic 01 thread file\", () => {\n228\t  it(\"upgrades in place: records intact, queue columns defaulted, F-02 backfill pending rows present\", async () => {\n229\t    const filePath = store.threadPath();\n230\t    legacyEpic01ThreadFile(filePath, \"th_epic01\");\n231\t    expect(schemaVersionOf(filePath)).toBe(4);\n232\t\n233\t    // Any SDK read migrates lazily; the read itself must succeed post-v5.\n234\t    const projected = await messages.listMessages({ filePath });\n235\t    expect(projected.ok).toBe(true);\n236\t    if (!projected.ok) return;\n237\t    expect(schemaVersionOf(filePath)).toBe(5);\n238\t\n239\t    // Existing records intact through the production read surfaces.\n240\t    expect(projected.value.map((m) => m.messageId)).toEqual([\"m1\", \"m2\", \"m3\"]);\n241\t    const events = await intakeStream.listEvents({ filePath });\n242\t    expect(events.ok).toBe(true);\n243\t    if (!events.ok) return;\n244\t    expect(events.value).toHaveLength(4);\n245\t    const turnRecords = await turns.listTurns({ filePath });\n246\t    expect(turnRecords.ok).toBe(true);\n247\t    if (!turnRecords.ok) return;\n248\t    expect(turnRecords.value).toEqual([\n249\t      {\n250\t        turnId: \"t1\",\n251\t        status: \"closed\",\n252\t        memberMessageIds: [\"m1\", \"m2\", \"m3\"],\n253\t        openedAtEventOrder: 1,\n254\t        closedAtEventOrder: 4,\n255\t        forms: [\n256\t          {\n257\t            subjectKind: \"turn\",\n258\t            subjectId: \"t1\",\n259\t            form: \"lower_band_projection\",\n260\t            state: \"pending\",\n261\t            sourceVersion: 1,\n262\t          },\n263\t          {\n264\t            subjectKind: \"turn\",\n265\t            subjectId: \"t1\",\n266\t            form: \"turn_rendering\",\n267\t            state: \"pending\",\n268\t            sourceVersion: 1,\n269\t          },\n270\t        ],\n271\t      },\n272\t    ]);\n273\t\n274\t    // Work rows survive with their pre-v5 ids; the queue's mechanical\n275\t    // columns exist and default to not-claimed / immediately eligible.\n276\t    const db = openRaw(filePath);\n277\t    try {\n278\t      const items = db\n279\t        .prepare(\n280\t          `SELECT work_item_id, status, attempts, last_error, claimed_at,\n281\t                  claim_expires_at, eligible_at, payload\n282\t           FROM work_item ORDER BY work_item_id`,\n283\t        )\n284\t        .all() as unknown as Array<Record<string, unknown>>;\n285\t      expect(items.map((row) => row.work_item_id)).toEqual([\n286\t        \"w-m1-prompt_smoothing\",\n287\t        \"w-m3-tool_result_summary\",\n288\t        \"w-t1-turn_derivation\",\n289\t      ]);\n290\t      for (const row of items) {\n291\t        expect(row.status).toBe(\"queued\");\n292\t        expect(Number(row.attempts)).toBe(0);\n293\t        expect(row.last_error).toBeNull();\n294\t        expect(row.claimed_at).toBeNull();\n295\t        expect(row.claim_expires_at).toBeNull();\n296\t        expect(row.eligible_at).toBeNull();\n297\t        expect(row.payload).toBeNull();\n298\t      }\n299\t      // The epic's other v5 surfaces exist (schema ships whole): chunk\n300\t      // tables empty, deleted_at stamps present and null.\n301\t      const chunkCount = db.prepare(\"SELECT COUNT(*) AS n FROM chunk\").get() as { n: number | bigint };\n302\t      expect(Number(chunkCount.n)).toBe(0);\n303\t      const deleted = db\n304\t        .prepare(\"SELECT COUNT(*) AS n FROM message WHERE deleted_at IS NOT NULL\")\n305\t        .get() as { n: number | bigint };\n306\t      expect(Number(deleted.n)).toBe(0);\n307\t    } finally {\n308\t      db.close();\n309\t    }\n310\t\n311\t    // F-02 backfill: one pending row per live queued item, mapped per kind —\n312\t    // turn_derivation fans out to both turn forms; all at source version 1.\n313\t    expect(\n314\t      readDerivedForms(filePath).map(({ subjectKind, subjectId, form, state, sourceVersion }) => ({\n315\t        subjectKind,\n316\t        subjectId,\n317\t        form,\n318\t        state,\n319\t        sourceVersion,\n320\t      })),\n321\t    ).toEqual([\n322\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\", state: \"pending\", sourceVersion: 1 },\n323\t      { subjectKind: \"message\", subjectId: \"m3\", form: \"tool_result_summary\", state: \"pending\", sourceVersion: 1 },\n324\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\", state: \"pending\", sourceVersion: 1 },\n325\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\", state: \"pending\", sourceVersion: 1 },\n326\t    ]);\n327\t\n328\t    // The migrated file keeps working through the Epic 01 write path: a new\n329\t    // batch records, projects, and queues against the v5 schema.\n330\t    const batch = await intakeStream.messageEvents({ filePath }, [\n331\t      validEvent(\"user_prompt\", { payload: { text: \"recorded after the upgrade\" } }),\n332\t      validEvent(\"turn_end\"),\n333\t    ]);\n334\t    expect(batch.ok).toBe(true);\n335\t    if (!batch.ok) return;\n336\t    expect(batch.value.events.map((entry) => entry.outcome)).toEqual([\"recorded\", \"recorded\"]);\n337\t    expect(batch.value.queuedWork.map((item) => item.workItemId)).toEqual([\n338\t      \"w-m5-prompt_smoothing-v1\",\n339\t      \"w-t2-turn_derivation-v1\",\n340\t    ]);\n341\t  });\n342\t});\n343\t"}]},"parent_tool_use_id":null,"session_id":"9b79ae20-893f-4407-8201-b760b8487b13","uuid":"b282f73f-b261-47be-b85e-72fd37271068","timestamp":"2026-06-11T14:04:01.483Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/thread-migration.test.ts","content":"// F-03-001: an existing valid Story 2 thread file (user_version=1, only\n// thread_metadata/event tables) must be migrated to the current schema before\n// any Story 3 message write or read. The fixture reproduces the accepted\n// Story 2 on-disk layout exactly; the assertions go through the production\n// entry points (messageEvents, listMessages, listEvents) plus below-SDK\n// schema-version reads.\n// F-03-002: the lazy opener must reject existing files that are not thread\n// files without creating lhc schema or bumping user_version on them.\nimport { readFileSync, writeFileSync } from \"node:fs\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport { intakeStream, messages, turns } from \"../src/index.js\";\nimport {\n  legacyEpic01ThreadFile,\n  legacyStory2ThreadFile,\n  openRaw,\n  readDerivedForms,\n  schemaVersionOf,\n  tempStore,\n  validEvent,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nconst legacyEvent = {\n  eventOrder: 1,\n  eventKind: \"user_prompt\",\n  idempotencyKey: \"legacy-key-1\",\n  actor: \"legacy-actor\",\n  harness: \"legacy-harness\",\n  payload: { text: \"recorded before story 3 shipped\" },\n  recordedAt: \"2026-06-01T00:00:01.000Z\",\n};\n\ndescribe(\"F-03-001: Story 2 thread files migrate before message write/read\", () => {\n  it(\"messageEvents on a Story 2 file upgrades the schema, keeps the legacy record intact, and projects the new events\", async () => {\n    const filePath = store.threadPath();\n    legacyStory2ThreadFile(filePath, \"th_legacy01\", [legacyEvent]);\n    expect(schemaVersionOf(filePath)).toBe(1);\n\n    const result = await intakeStream.messageEvents({ filePath }, [\n      validEvent(\"assistant_text\", { payload: { text: \"answered after upgrade\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(result.ok).toBe(true);\n    if (!result.ok) return;\n    expect(result.value.events.map((entry) => entry.outcome)).toEqual([\n      \"recorded\",\n      \"recorded\",\n    ]);\n    // The order counter continues from the legacy record; the new message id\n    // derives from the continued order.\n    expect(result.value.threadPosition.lastEventOrder).toBe(3);\n    expect(result.value.events[0]!.messageId).toBe(\"m2\");\n\n    expect(schemaVersionOf(filePath)).toBe(5);\n\n    // The legacy event survives the upgrade byte-for-byte at the SDK level.\n    const events = await intakeStream.listEvents({ filePath });\n    expect(events.ok).toBe(true);\n    if (!events.ok) return;\n    expect(events.value).toHaveLength(3);\n    expect(events.value[0]).toEqual({\n      eventKind: \"user_prompt\",\n      idempotencyKey: \"legacy-key-1\",\n      actor: \"legacy-actor\",\n      harness: \"legacy-harness\",\n      payload: { text: \"recorded before story 3 shipped\" },\n      eventOrder: 1,\n      recordedAt: \"2026-06-01T00:00:01.000Z\",\n    });\n\n    // Projection is intake-time, not retroactive: the new assistant_text\n    // projects; the legacy pre-Story-3 event stays event-only.\n    const projected = await messages.listMessages({ filePath });\n    expect(projected.ok).toBe(true);\n    if (!projected.ok) return;\n    expect(projected.value).toHaveLength(1);\n    expect(projected.value[0]!.messageId).toBe(\"m2\");\n    expect(projected.value[0]!.sourceEventOrder).toBe(2);\n    expect(projected.value[0]!.blocks).toEqual([\n      { blockType: \"text\", content: { text: \"answered after upgrade\" } },\n    ]);\n    expect(projected.value[0]!.tokenEstimate).toBeGreaterThan(0);\n  });\n\n  it(\"listMessages on an untouched Story 2 file migrates on read and returns an empty list\", async () => {\n    const filePath = store.threadPath();\n    legacyStory2ThreadFile(filePath, \"th_legacy02\", [legacyEvent]);\n    expect(schemaVersionOf(filePath)).toBe(1);\n\n    const projected = await messages.listMessages({ filePath });\n    expect(projected.ok).toBe(true);\n    if (!projected.ok) return;\n    expect(projected.value).toEqual([]);\n\n    expect(schemaVersionOf(filePath)).toBe(5);\n\n    // The read-path upgrade changed no record content.\n    const events = await intakeStream.listEvents({ filePath });\n    expect(events.ok).toBe(true);\n    if (!events.ok) return;\n    expect(events.value).toHaveLength(1);\n    expect(events.value[0]!.idempotencyKey).toBe(\"legacy-key-1\");\n  });\n\n  it(\"idempotency keys recorded under Story 2 still skip after the upgrade\", async () => {\n    const filePath = store.threadPath();\n    legacyStory2ThreadFile(filePath, \"th_legacy03\", [legacyEvent]);\n\n    const resend = await intakeStream.messageEvents({ filePath }, [\n      validEvent(\"user_prompt\", {\n        idempotencyKey: \"legacy-key-1\",\n        payload: { text: \"resent after upgrade\" },\n      }),\n    ]);\n    expect(resend.ok).toBe(true);\n    if (!resend.ok) return;\n    expect(resend.value.events[0]).toEqual({\n      idempotencyKey: \"legacy-key-1\",\n      outcome: \"skipped\",\n      skipReason: \"duplicate_idempotency_key\",\n    });\n\n    // No message was created for the skipped resend of the legacy event.\n    const projected = await messages.listMessages({ filePath });\n    expect(projected.ok).toBe(true);\n    if (!projected.ok) return;\n    expect(projected.value).toEqual([]);\n  });\n});\n\n// Tables present in a file, by name — asserts what schema (if any) the\n// rejected open left behind.\nfunction tableNames(filePath: string): string[] {\n  const db = openRaw(filePath);\n  try {\n    const rows = db\n      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name\")\n      .all() as unknown as Array<{ name: string }>;\n    return rows.map((row) => row.name);\n  } finally {\n    db.close();\n  }\n}\n\ndescribe(\"F-03-002: non-thread files are rejected, not adopted\", () => {\n  it(\"listMessages against an existing empty database file fails without creating schema or bumping user_version\", async () => {\n    const filePath = store.threadPath();\n    writeFileSync(filePath, \"\"); // exists, zero bytes — a valid empty SQLite database\n\n    const result = await messages.listMessages({ filePath });\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.errorClass).toBe(\"caller_error\");\n    expect(result.error.code).toBe(\"thread_not_found\");\n    expect(result.error.reason).toContain(\"not an lhc thread file\");\n\n    expect(schemaVersionOf(filePath)).toBe(0);\n    expect(tableNames(filePath)).toEqual([]);\n  });\n\n  it(\"messageEvents against an unrelated SQLite database fails and leaves its content untouched\", async () => {\n    const filePath = store.threadPath();\n    const foreign = openRaw(filePath);\n    try {\n      foreign.exec(\"CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT NOT NULL);\");\n      foreign.prepare(\"INSERT INTO notes (id, body) VALUES (1, ?)\").run(\"not lhc data\");\n    } finally {\n      foreign.close();\n    }\n\n    const result = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.errorClass).toBe(\"caller_error\");\n    expect(result.error.code).toBe(\"thread_not_found\");\n    expect(result.error.reason).toContain(\"not an lhc thread file\");\n\n    // No lhc tables were created, the version was not bumped, and the\n    // foreign data is intact.\n    expect(schemaVersionOf(filePath)).toBe(0);\n    expect(tableNames(filePath)).toEqual([\"notes\"]);\n    const db = openRaw(filePath);\n    try {\n      const row = db.prepare(\"SELECT body FROM notes WHERE id = 1\").get() as unknown as {\n        body: string;\n      };\n      expect(row.body).toBe(\"not lhc data\");\n    } finally {\n      db.close();\n    }\n  });\n\n  it(\"a non-SQLite file is rejected as a caller error with its bytes unchanged\", async () => {\n    const filePath = store.threadPath();\n    const original = \"just some text, definitely not a database\\n\";\n    writeFileSync(filePath, original);\n\n    const listed = await messages.listMessages({ filePath });\n    expect(listed.ok).toBe(false);\n    if (listed.ok) return;\n    expect(listed.error.errorClass).toBe(\"caller_error\");\n    expect(listed.error.code).toBe(\"thread_not_found\");\n\n    const batched = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n    expect(batched.ok).toBe(false);\n    if (batched.ok) return;\n    expect(batched.error.errorClass).toBe(\"caller_error\");\n    expect(batched.error.code).toBe(\"thread_not_found\");\n\n    expect(readFileSync(filePath, \"utf8\")).toBe(original);\n  });\n});\n\n// Story 0 (Epic 02), FC-0.5 + architecture risk \"migration on live data\":\n// v5 applies in place to a populated Epic 01 file — existing rows intact,\n// new columns defaulted, the F-02 backfill creating pending derived_form\n// rows for live queued items. A fresh-file migration test would pass while\n// breaking real threads; this one runs over real Epic 01 data.\ndescribe(\"FC-0.5: migration v5 over a populated Epic 01 thread file\", () => {\n  it(\"upgrades in place: records intact, queue columns defaulted, F-02 backfill pending rows present\", async () => {\n    const filePath = store.threadPath();\n    legacyEpic01ThreadFile(filePath, \"th_epic01\");\n    expect(schemaVersionOf(filePath)).toBe(4);\n\n    // Any SDK read migrates lazily; the read itself must succeed post-v5.\n    const projected = await messages.listMessages({ filePath });\n    expect(projected.ok).toBe(true);\n    if (!projected.ok) return;\n    expect(schemaVersionOf(filePath)).toBe(5);\n\n    // Existing records intact through the production read surfaces.\n    expect(projected.value.map((m) => m.messageId)).toEqual([\"m1\", \"m2\", \"m3\"]);\n    const events = await intakeStream.listEvents({ filePath });\n    expect(events.ok).toBe(true);\n    if (!events.ok) return;\n    expect(events.value).toHaveLength(4);\n    const turnRecords = await turns.listTurns({ filePath });\n    expect(turnRecords.ok).toBe(true);\n    if (!turnRecords.ok) return;\n    expect(turnRecords.value).toEqual([\n      {\n        turnId: \"t1\",\n        status: \"closed\",\n        memberMessageIds: [\"m1\", \"m2\", \"m3\"],\n        openedAtEventOrder: 1,\n        closedAtEventOrder: 4,\n        forms: [\n          {\n            subjectKind: \"turn\",\n            subjectId: \"t1\",\n            form: \"lower_band_projection\",\n            state: \"pending\",\n            sourceVersion: 1,\n          },\n          {\n            subjectKind: \"turn\",\n            subjectId: \"t1\",\n            form: \"turn_rendering\",\n            state: \"pending\",\n            sourceVersion: 1,\n          },\n        ],\n      },\n    ]);\n\n    // Work rows survive with their pre-v5 ids; the queue's mechanical\n    // columns exist and default to not-claimed / immediately eligible.\n    const db = openRaw(filePath);\n    try {\n      const items = db\n        .prepare(\n          `SELECT work_item_id, status, attempts, last_error, claimed_at,\n                  claim_expires_at, eligible_at, payload\n           FROM work_item ORDER BY work_item_id`,\n        )\n        .all() as unknown as Array<Record<string, unknown>>;\n      expect(items.map((row) => row.work_item_id)).toEqual([\n        \"w-m1-prompt_smoothing\",\n        \"w-m3-tool_result_summary\",\n        \"w-t1-turn_derivation\",\n      ]);\n      for (const row of items) {\n        expect(row.status).toBe(\"queued\");\n        expect(Number(row.attempts)).toBe(0);\n        expect(row.last_error).toBeNull();\n        expect(row.claimed_at).toBeNull();\n        expect(row.claim_expires_at).toBeNull();\n        expect(row.eligible_at).toBeNull();\n        expect(row.payload).toBeNull();\n      }\n      // The epic's other v5 surfaces exist (schema ships whole): chunk\n      // tables empty, deleted_at stamps present and null.\n      const chunkCount = db.prepare(\"SELECT COUNT(*) AS n FROM chunk\").get() as { n: number | bigint };\n      expect(Number(chunkCount.n)).toBe(0);\n      const deleted = db\n        .prepare(\"SELECT COUNT(*) AS n FROM message WHERE deleted_at IS NOT NULL\")\n        .get() as { n: number | bigint };\n      expect(Number(deleted.n)).toBe(0);\n    } finally {\n      db.close();\n    }\n\n    // F-02 backfill: one pending row per live queued item, mapped per kind —\n    // turn_derivation fans out to both turn forms; all at source version 1.\n    expect(\n      readDerivedForms(filePath).map(({ subjectKind, subjectId, form, state, sourceVersion }) => ({\n        subjectKind,\n        subjectId,\n        form,\n        state,\n        sourceVersion,\n      })),\n    ).toEqual([\n      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\", state: \"pending\", sourceVersion: 1 },\n      { subjectKind: \"message\", subjectId: \"m3\", form: \"tool_result_summary\", state: \"pending\", sourceVersion: 1 },\n      { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\", state: \"pending\", sourceVersion: 1 },\n      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\", state: \"pending\", sourceVersion: 1 },\n    ]);\n\n    // The migrated file keeps working through the Epic 01 write path: a new\n    // batch records, projects, and queues against the v5 schema.\n    const batch = await intakeStream.messageEvents({ filePath }, [\n      validEvent(\"user_prompt\", { payload: { text: \"recorded after the upgrade\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(batch.ok).toBe(true);\n    if (!batch.ok) return;\n    expect(batch.value.events.map((entry) => entry.outcome)).toEqual([\"recorded\", \"recorded\"]);\n    expect(batch.value.queuedWork.map((item) => item.workItemId)).toEqual([\n      \"w-m5-prompt_smoothing-v1\",\n      \"w-t2-turn_derivation-v1\",\n    ]);\n  });\n});\n","numLines":343,"startLine":1,"totalLines":343}}}

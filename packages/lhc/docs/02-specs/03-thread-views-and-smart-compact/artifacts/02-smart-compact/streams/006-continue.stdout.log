{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PMsgHJ8xLffhsKaAwygYAf","type":"tool_result","content":"280\t    const list = messagesByTurn.get(message.turnId) ?? [];\n281\t    list.push(message);\n282\t    messagesByTurn.set(message.turnId, list);\n283\t  }\n284\t\n285\t  // Rule 6: turnless stragglers attach to the FOLLOWING turn — they ride its\n286\t  // band assignment, price into its fill cost, and render marked immediately\n287\t  // before its entry. No following turn ⇒ tail by construction.\n288\t  const notesByTurn = new Map<string, SelectionMessage[]>();\n289\t  for (const message of messages) {\n290\t    if (message.turnId !== null) continue;\n291\t    const following = turns.find((turn) => turn.openedAt > message.order);\n292\t    if (following === undefined) continue; // trailing straggler: tail\n293\t    const list = notesByTurn.get(following.turnId) ?? [];\n294\t    list.push(message);\n295\t    notesByTurn.set(following.turnId, list);\n296\t  }\n297\t\n298\t  // The oldest event order a turn's entry represents: its oldest live\n299\t  // message or attached note, falling back to its open boundary.\n300\t  function turnStartOrder(turn: SelectionTurn): number {\n301\t    const candidates = [\n302\t      ...(messagesByTurn.get(turn.turnId) ?? []).map((message) => message.order),\n303\t      ...(notesByTurn.get(turn.turnId) ?? []).map((note) => note.order),\n304\t    ];\n305\t    return candidates.length === 0 ? turn.openedAt : Math.min(...candidates);\n306\t  }\n307\t\n308\t  // Rule 1 — compact point: messages newest-first until the estimate sum\n309\t  // first reaches the full share; the point snaps to a turn boundary so the\n310\t  // tail never begins mid-turn. Open-turn messages always land in the tail.\n311\t  const fullBudget = budget(config.percentages.full);\n312\t  const closedTurns = turns.filter((turn) => turn.status === \"closed\");\n313\t  let compactPoint = 0;\n314\t  if (closedTurns.length > 0 && messages.length > 0) {\n315\t    let sum = 0;\n316\t    let crossing: SelectionMessage | null = null;\n317\t    for (let i = messages.length - 1; i >= 0; i -= 1) {\n318\t      const message = messages[i] as SelectionMessage;\n319\t      sum += message.tokenEstimate;"}]},"parent_tool_use_id":null,"session_id":"8dde17a3-d739-40da-bd65-ee3687cdd63f","uuid":"5006277e-4f4b-4318-9fb0-641a6834e422","timestamp":"2026-06-11T16:20:06.511Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/internal/select.ts","content":"    const list = messagesByTurn.get(message.turnId) ?? [];\n    list.push(message);\n    messagesByTurn.set(message.turnId, list);\n  }\n\n  // Rule 6: turnless stragglers attach to the FOLLOWING turn — they ride its\n  // band assignment, price into its fill cost, and render marked immediately\n  // before its entry. No following turn ⇒ tail by construction.\n  const notesByTurn = new Map<string, SelectionMessage[]>();\n  for (const message of messages) {\n    if (message.turnId !== null) continue;\n    const following = turns.find((turn) => turn.openedAt > message.order);\n    if (following === undefined) continue; // trailing straggler: tail\n    const list = notesByTurn.get(following.turnId) ?? [];\n    list.push(message);\n    notesByTurn.set(following.turnId, list);\n  }\n\n  // The oldest event order a turn's entry represents: its oldest live\n  // message or attached note, falling back to its open boundary.\n  function turnStartOrder(turn: SelectionTurn): number {\n    const candidates = [\n      ...(messagesByTurn.get(turn.turnId) ?? []).map((message) => message.order),\n      ...(notesByTurn.get(turn.turnId) ?? []).map((note) => note.order),\n    ];\n    return candidates.length === 0 ? turn.openedAt : Math.min(...candidates);\n  }\n\n  // Rule 1 — compact point: messages newest-first until the estimate sum\n  // first reaches the full share; the point snaps to a turn boundary so the\n  // tail never begins mid-turn. Open-turn messages always land in the tail.\n  const fullBudget = budget(config.percentages.full);\n  const closedTurns = turns.filter((turn) => turn.status === \"closed\");\n  let compactPoint = 0;\n  if (closedTurns.length > 0 && messages.length > 0) {\n    let sum = 0;\n    let crossing: SelectionMessage | null = null;\n    for (let i = messages.length - 1; i >= 0; i -= 1) {\n      const message = messages[i] as SelectionMessage;\n      sum += message.tokenEstimate;","numLines":40,"startLine":280,"totalLines":559}}}

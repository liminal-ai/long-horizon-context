{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/internal/profiles.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Profile config resolution and validation (Story 0, FC-0.2): built-in\n     2\t// profiles, user profiles merged over them by name, and the budget rules —\n     3\t// band shares sum to 100, lower bound positive, visibility max > target ≥\n     4\t// floor. Pure functions, no IO. Config mistakes are programmer errors at SDK\n     5\t// construction and throw naming the violation (Epic 02 rule); nothing here\n     6\t// returns OpResults.\n     7\timport type {\n     8\t  ResolvedViewConfig,\n     9\t  SdkViewConfig,\n    10\t  ViewProfile,\n    11\t  ViewProfileOverride,\n    12\t  VisibilityBudgets,\n    13\t} from \"../../../shared/view.js\";\n    14\t\n    15\t// Built-in profiles (tech design §Interface Definitions): defaults, knobs\n    16\t// not architecture.\n    17\texport const BUILT_IN_PROFILES: readonly ViewProfile[] = [\n    18\t  {\n    19\t    name: \"continuation\",\n    20\t    lowerBound: 120000,\n    21\t    percentages: { full: 30, smooth: 30, detailed: 20, brief: 20 },\n    22\t  },\n    23\t  {\n    24\t    name: \"conversation\",\n    25\t    lowerBound: 120000,\n    26\t    percentages: { full: 12, smooth: 48, detailed: 20, brief: 20 },\n    27\t  },\n    28\t  {\n    29\t    name: \"coding\",\n    30\t    lowerBound: 120000,\n    31\t    percentages: { full: 25, smooth: 35, detailed: 20, brief: 20 },\n    32\t  },\n    33\t];\n    34\t\n    35\texport const DEFAULT_VISIBILITY: VisibilityBudgets = {\n    36\t  maxTokens: 32000,\n    37\t  targetTokens: 24000,\n    38\t  floorTokens: 8000,\n    39\t};\n    40\t\n    41\texport const DEFAULT_COMPACT_THRESHOLD = 160000;\n    42\t\n    43\tfunction fail(detail: string): never {\n    44\t  throw new TypeError(`createSdk config: view: ${detail}`);\n    45\t}\n    46\t\n    47\tconst BAND_KEYS = [\"full\", \"smooth\", \"detailed\", \"brief\"] as const;\n    48\t\n    49\t// The violated constraint, named, or null when the profile is sound: one\n    50\t// rule set shared by both rejection surfaces — SDK construction (throws,\n    51\t// below) and compact invocation (caller-error result, AC-2.3).\n    52\texport function profileViolation(profile: ViewProfile): string | null {\n    53\t  if (!Number.isFinite(profile.lowerBound) || profile.lowerBound <= 0) {\n    54\t    return `profile \"${profile.name}\": lowerBound must be a positive number, got ${profile.lowerBound}`;\n    55\t  }\n    56\t  for (const key of BAND_KEYS) {\n    57\t    const share = profile.percentages[key];\n    58\t    if (!Number.isFinite(share) || share < 0) {\n    59\t      return `profile \"${profile.name}\": percentage ${key} must be a non-negative number, got ${share}`;\n    60\t    }\n    61\t  }\n    62\t  const sum = BAND_KEYS.reduce((total, key) => total + profile.percentages[key], 0);\n    63\t  if (sum !== 100) {\n    64\t    return `profile \"${profile.name}\": percentages must sum to 100, got ${sum}`;\n    65\t  }\n    66\t  return null;\n    67\t}\n    68\t\n    69\t// A complete, merged profile validates whole: positive lower bound, finite\n    70\t// non-negative shares, shares summing to exactly 100. Errors name the\n    71\t// violated constraint and the profile (AC-2.3's vocabulary, applied at\n    72\t// construction).\n    73\texport function validateProfile(profile: ViewProfile): void {\n    74\t  const violation = profileViolation(profile);\n    75\t  if (violation !== null) fail(violation);\n    76\t}\n    77\t\n    78\tfunction isCompleteOverride(entry: ViewProfileOverride): boolean {\n    79\t  return (\n    80\t    entry.lowerBound !== undefined &&\n    81\t    entry.percentages !== undefined &&\n    82\t    BAND_KEYS.every((key) => entry.percentages?.[key] !== undefined)\n    83\t  );\n    84\t}\n    85\t\n    86\t// Merge one configured entry: field-wise over the built-in it names, or — for\n    87\t// a name no built-in carries — the entry must be complete, since there is\n    88\t// nothing to merge over (FC-0.2's unknown-built-in-override-target violation).\n    89\tfunction mergeProfile(entry: ViewProfileOverride, base: ViewProfile | undefined): ViewProfile {\n    90\t  if (base === undefined) {\n    91\t    if (!isCompleteOverride(entry)) {\n    92\t      fail(\n    93\t        `profile \"${entry.name}\" is partial but overrides no built-in (unknown built-in override target); built-ins are ${BUILT_IN_PROFILES.map((p) => `\"${p.name}\"`).join(\", \")} — a new profile must carry lowerBound and all four percentages`,\n    94\t      );\n    95\t    }\n    96\t    return {\n    97\t      name: entry.name,\n    98\t      lowerBound: entry.lowerBound as number,\n    99\t      percentages: {\n   100\t        full: entry.percentages?.full as number,\n   101\t        smooth: entry.percentages?.smooth as number,\n   102\t        detailed: entry.percentages?.detailed as number,\n   103\t        brief: entry.percentages?.brief as number,\n   104\t      },\n   105\t    };\n   106\t  }\n   107\t  return {\n   108\t    name: entry.name,\n   109\t    lowerBound: entry.lowerBound ?? base.lowerBound,\n   110\t    percentages: {\n   111\t      full: entry.percentages?.full ?? base.percentages.full,\n   112\t      smooth: entry.percentages?.smooth ?? base.percentages.smooth,\n   113\t      detailed: entry.percentages?.detailed ?? base.percentages.detailed,\n   114\t      brief: entry.percentages?.brief ?? base.percentages.brief,\n   115\t    },\n   116\t  };\n   117\t}\n   118\t\n   119\tfunction resolveVisibility(partial: Partial<VisibilityBudgets> | undefined): VisibilityBudgets {\n   120\t  const visibility: VisibilityBudgets = {\n   121\t    maxTokens: partial?.maxTokens ?? DEFAULT_VISIBILITY.maxTokens,\n   122\t    targetTokens: partial?.targetTokens ?? DEFAULT_VISIBILITY.targetTokens,\n   123\t    floorTokens: partial?.floorTokens ?? DEFAULT_VISIBILITY.floorTokens,\n   124\t  };\n   125\t  for (const key of [\"maxTokens\", \"targetTokens\", \"floorTokens\"] as const) {\n   126\t    if (!Number.isFinite(visibility[key]) || visibility[key] <= 0) {\n   127\t      fail(`visibility.${key} must be a positive number, got ${visibility[key]}`);\n   128\t    }\n   129\t  }\n   130\t  // The budget ordering rule (AC-4.8): max > target ≥ floor.\n   131\t  if (visibility.maxTokens <= visibility.targetTokens) {\n   132\t    fail(\n   133\t      `visibility.maxTokens (${visibility.maxTokens}) must be greater than targetTokens (${visibility.targetTokens})`,\n   134\t    );\n   135\t  }\n   136\t  if (visibility.targetTokens < visibility.floorTokens) {\n   137\t    fail(\n   138\t      `visibility.targetTokens (${visibility.targetTokens}) must be at least floorTokens (${visibility.floorTokens})`,\n   139\t    );\n   140\t  }\n   141\t  return visibility;\n   142\t}\n   143\t\n   144\t// The one resolution path: built-ins, user profiles merged by name, every\n   145\t// resolved profile validated, visibility and threshold defaulted and checked.\n   146\t// Called from createSdk so validation runs through real construction, never a\n   147\t// standalone validator (Story 0 production-path proof).\n   148\texport function resolveViewConfig(config?: SdkViewConfig): ResolvedViewConfig {\n   149\t  const profiles: Record<string, ViewProfile> = {};\n   150\t  for (const builtIn of BUILT_IN_PROFILES) {\n   151\t    profiles[builtIn.name] = builtIn;\n   152\t  }\n   153\t  for (const entry of config?.profiles ?? []) {\n   154\t    if (typeof entry.name !== \"string\" || entry.name.length === 0) {\n   155\t      fail(`profile entries must carry a non-empty name`);\n   156\t    }\n   157\t    profiles[entry.name] = mergeProfile(entry, profiles[entry.name]);\n   158\t  }\n   159\t  for (const profile of Object.values(profiles)) {\n   160\t    validateProfile(profile);\n   161\t  }\n   162\t\n   163\t  const compactThreshold = config?.compactThreshold ?? DEFAULT_COMPACT_THRESHOLD;\n   164\t  if (!Number.isFinite(compactThreshold) || compactThreshold <= 0) {\n   165\t    fail(`compactThreshold must be a positive number, got ${compactThreshold}`);\n   166\t  }\n   167\t\n   168\t  return {\n   169\t    profiles,\n   170\t    visibility: resolveVisibility(config?.visibility),\n   171\t    compactThreshold,\n   172\t  };\n   173\t}\n","exit_code":0,"status":"completed"}}

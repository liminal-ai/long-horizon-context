lect.js\\\";\\nimport { openThreadDatabase } from \\\"./src/domains/threads/index.js\\\";\\nconst store = tempStore();\\nconst fx = await derivedThreadFixture(store);\\nconst o = openThreadDatabase(fx.filePath);\\nif (!o.ok) throw new Error(\\\"open\\\");\\nconst inputs = readSelectionInputs(o.value);\\no.value.close();\\nfor (const [name, cfg] of [\\n  [\\\"G2A\\\", { lowerBound: 1440, percentages: { full: 7, smooth: 10, detailed: 33, brief: 50 } }],\\n  [\\\"G2B\\\", { lowerBound: 1430, percentages: { full: 7, smooth: 10, detailed: 33, brief: 50 } }],\\n  [\\\"G3\\\", { lowerBound: 250, percentages: { full: 80, smooth: 4, detailed: 8, brief: 8 } }],\\n] as const) {\\n  const s = selectArrangement(inputs, cfg);\\n  console.log(`${name}: cp=${s.compactPoint} cf=${s.coveredFrom}`, s.entries.map((e) => `${e.band}:${e.subjectId}:${e.formUsed}${e.degraded ? \\\":D\\\" : \\\"\\\"}`).join(\\\" \\\"));\\n}\\nstore.cleanup();\\nEOF\\nnpx tsx scratch-goldens.ts 2>/dev/null\",\"description\":\"Verify G2/G3 arrangements\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":188,\"cache_read_input_tokens\":276009,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":188},\"output_tokens\":6,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"8dde17a3-d739-40da-bd65-ee3687cdd63f\",\"uuid\":\"5464963a-a69f-468c-a5a7-77057bf3a380\",\"request_id\":\"req_011CbwkwLAdZbuD8Sgm92Aei\"}\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3171:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01ARegkDXFTznEtWcPNvQ46Y\",\"type\":\"tool_result\",\"content\":\"G2A: cp=48 cf=1 detailed:c1:chunk_summary_detailed smooth:t4:turn_rendering smooth:t5:turn_rendering smooth:t6:turn_rendering smooth:t7:turn_rendering smooth:t8:turn_rendering\\nG2B: cp=48 cf=1 detailed:c1:chunk_summary_detailed detailed:c2:chunk_summary_detailed smooth:t7:turn_rendering smooth:t8:turn_rendering\\nG3: cp=40 cf=13 detailed:c2:chunk_summary_detailed smooth:t7:turn_rendering\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"8dde17a3-d739-40da-bd65-ee3687cdd63f\",\"uuid\":\"538bfdbd-1e42-4339-b6b8-28e0ec59aaf2\",\"timestamp\":\"2026-06-11T16:06:13.097Z\",\"tool_use_result\":{\"stdout\":\"G2A: cp=48 cf=1 detailed:c1:chunk_summary_detailed smooth:t4:turn_rendering smooth:t5:turn_rendering smooth:t6:turn_rendering smooth:t7:turn_rendering smooth:t8:turn_rendering\\nG2B: cp=48 cf=1 detailed:c1:chunk_summary_detailed detailed:c2:chunk_summary_detailed smooth:t7:turn_rendering smooth:t8:turn_rendering\\nG3: cp=40 cf=13 detailed:c2:chunk_summary_detailed smooth:t7:turn_rendering\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3196:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":3,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"den.test.ts`.\\\\nEach golden pins the exact arrangement a compact\"}},\"session_id\":\"8dde17a3-d739-40da-bd65-ee3687cdd63f\",\"parent_tool_use_id\":null,\"uuid\":\"5fd41f6b-ae40-4d73-af30-c1c13da4ba16\"}\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3198:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":3,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\" under explicit params: subject ids per\\\\nband, form used, compact point, cov\"}},\"session_id\":\"8dde17a3-d739-40da-bd65-ee3687cdd63f\",\"parent_tool_use_id\":null,\"uuid\":\"616abaae-d63e-4cb4-9e37-8969dc9e4e47\"}\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3199:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":3,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"ered_from, and gaps.\\\\n\\\\n**Goldens are immutable once committed.** An implementation that disagrees\\\\nwith a golden is wrong until the *design rule* is shown w\"}},\"session_id\":\"8dde17a3-d739-40da-bd65-ee3687cdd63f\",\"parent_tool_use_id\":null,\"uuid\":\"490f492c-e3ee-4d39-8049-fc0b9a99832f\"}\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3210:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":3,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"\\\\n```\\\\n\\\\nEach case logs its actual `{compactPoint, coveredFrom, arr\"}},\"session_id\":\"8dde17a3-d739-40da-bd65-ee3687cdd63f\",\"parent_tool_use_id\":null,\"uuid\":\"377e4d86-6b81-458e-b176-59e056270aef\"}\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3211:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":3,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"angement, gaps}`\\\\nJSON; verify the new values against the design rules by hand before replacing\\\\na file, and\"}},\"session_id\":\"8dde17a3-d739-40da-bd65-ee3687cdd63f\",\"parent_tool_use_id\":null,\"uuid\":\"c6257e5b-606b-4d24-bcf3-b9a404ea481f\"}\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3214:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5\",\"id\":\"msg_01UDKv1PVEDrxX3jYJMAaCP5\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_013CCArQV7PPqemeRJ8dcej3\",\"name\":\"Write\",\"input\":{\"file_path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/goldens/README.md\",\"content\":\"# Selection goldens (Epic 03 Story 2, G1–G4)\\n\\nCommitted expected arrangements for the band-selection walk (tech design\\n§Deterministic Algorithms), consumed by `test/view-select-golden.test.ts`.\\nEach golden pins the exact arrangement a compact must produce on the Story-0\\nfixture (or its straggler variant) under explicit params: subject ids per\\nband, form used, compact point, covered_from, and gaps.\\n\\n**Goldens are immutable once committed.** An implementation that disagrees\\nwith a golden is wrong until the *design rule* is shown wrong — that takes the\\ndeviation process, not a golden edit. The expected values were hand-derived\\nfrom the design's rules (rules 1–6, the pinned ≤/newest-first/newest-member\\ntie-breakers) against the fixture's deterministic token costs.\\n\\n| File | Case | Rule under test |\\n|------|------|-----------------|\\n| `g1-proportions.json` | G1 | shares → bands across the full gradient |\\n| `g2-edge-inclusion.json` | G2a | entry exactly filling the remainder is included (≤) |\\n| `g2-edge-exclusion.json` | G2b | one token under the exact fill → excluded, band stops |\\n| `g3-oversized-loner.json` | G3 | oversized entry on an otherwise-empty band represents alone |\\n| `g4-turnless-straggler.json` | G4 | rule 6: straggler rides the following turn's band entry; trailing straggler is tail |\\n\\n## Regeneration (only with a granted deviation)\\n\\nThe actual arrangement for any params can be printed by running the golden\\nsuite with `GOLDEN_DUMP=1`:\\n\\n```\\nGOLDEN_DUMP=1 npx vitest run test/view-select-golden.test.ts\\n```\\n\\nEach case logs its actual `{compactPoint, coveredFrom, arrangement, gaps}`\\nJSON; verify the new values against the design rules by hand before replacing\\na file, and record the deviation that made the old golden wrong.\\n\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1874,\"cache_read_input_tokens\":276197,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1874},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"8dde17a3-d739-40da-bd65-ee3687cdd63f\",\"uuid\":\"30c1886d-07ce-4a2a-af0e-c6ca559240c6\",\"request_id\":\"req_011Cbwky2R6NTbAxj6UMdDZz\"}\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3218:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_013CCArQV7PPqemeRJ8dcej3\",\"type\":\"tool_result\",\"content\":\"File created successfully at: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/goldens/README.md (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"8dde17a3-d739-40da-bd65-ee3687cdd63f\",\"uuid\":\"195b2a2d-880b-470b-b941-78eca13a6fe6\",\"timestamp\":\"2026-06-11T16:06:29.557Z\",\"tool_use_result\":{\"type\":\"create\",\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/goldens/README.md\",\"content\":\"# Selection goldens (Epic 03 Story 2, G1–G4)\\n\\nCommitted expected arrangements for the band-selection walk (tech design\\n§Deterministic Algorithms), consumed by `test/view-select-golden.test.ts`.\\nEach golden pins the exact arrangement a compact must produce on the Story-0\\nfixture (or its straggler variant) under explicit params: subject ids per\\nband, form used, compact point, covered_from, and gaps.\\n\\n**Goldens are immutable once committed.** An implementation that disagrees\\nwith a golden is wrong until the *design rule* is shown wrong — that takes the\\ndeviation process, not a golden edit. The expected values were hand-derived\\nfrom the design's rules (rules 1–6, the pinned ≤/newest-first/newest-member\\ntie-breakers) against the fixture's deterministic token costs.\\n\\n| File | Case | Rule under test |\\n|------|------|-----------------|\\n| `g1-proportions.json` | G1 | shares → bands across the full gradient |\\n| `g2-edge-inclusion.json` | G2a | entry exactly filling the remainder is included (≤) |\\n| `g2-edge-exclusion.json` | G2b | one token under the exact fill → excluded, band stops |\\n| `g3-oversized-loner.json` | G3 | oversized entry on an otherwise-empty band represents alone |\\n| `g4-turnless-straggler.json` | G4 | rule 6: straggler rides the following turn's band entry; trailing straggler is tail |\\n\\n## Regeneration (only with a granted deviation)\\n\\nThe actual arrangement for any params can be printed by running the golden\\nsuite with `GOLDEN_DUMP=1`:\\n\\n```\\nGOLDEN_DUMP=1 npx vitest run test/view-select-golden.test.ts\\n```\\n\\nEach case logs its actual `{compactPoint, coveredFrom, arrangement, gaps}`\\nJSON; verify the new values against the design rules by hand before replacing\\na file, and record the deviation that made the old golden wrong.\\n\",\"structuredPatch\":[],\"originalFile\":null,\"userModified\":false}}\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3225:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"read\\\\\\\",\\\\n  \\\\\\\"params\\\\\\\": { \\\\\\\"lowerBound\\\\\\\": 400, \\\\\\\"percentages\\\\\\\": { \\\\\\\"full\\\\\\\": 25, \\\\\\\"smooth\\\\\\\": 25, \\\\\\\"detailed\\\\\\\": 25, \\\\\\\"brief\\\\\\\": 25 } },\\\\n  \\\\\\\"compactPoint\\\\\\\":\"}},\"session_id\":\"8dde17a3-d739-40da-bd65-ee3687cdd63f\",\"parent_tool_use_id\":null,\"uuid\":\"bfa8e2e6-1aa7-48cf-a47d-bd7f330a60ca\"}\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compa
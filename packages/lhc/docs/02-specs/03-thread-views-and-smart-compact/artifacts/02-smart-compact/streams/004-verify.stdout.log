{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/view-fixture.test.ts | sed -n '1,190p'\"","aggregated_output":"     1\t// Epic 03 Story 0 foundation checks (FC-0.1–FC-0.6): migration v6 storage,\n     2\t// profile config validation through real createSdk construction, the\n     3\t// derived-thread fixture's state fidelity proven by read-back through the\n     4\t// owning report surfaces (states reached through production drains, never\n     5\t// hand-written rows), the corruption and turnless-straggler variants, and\n     6\t// the two-point test injection facility.\n     7\timport { afterAll, afterEach, beforeAll, describe, expect, it } from \"vitest\";\n     8\timport { createSdk, messages, turns, type Lhc } from \"../src/index.js\";\n     9\timport {\n    10\t  blockedSiblingThread,\n    11\t  corruptedVariantThread,\n    12\t  createProviderDouble,\n    13\t  derivedThreadFixture,\n    14\t  fireViewInjection,\n    15\t  openRaw,\n    16\t  PERMANENT_FAILURE_REASON,\n    17\t  schemaVersionOf,\n    18\t  setViewInjectionHook,\n    19\t  stragglerVariantThread,\n    20\t  tempStore,\n    21\t  TRANSIENT_EXHAUST_REASON,\n    22\t  validEvent,\n    23\t  type DerivedThreadFixture,\n    24\t  type TempStore,\n    25\t} from \"./fixtures/index.js\";\n    26\t\n    27\t// The main fixture is the suite's load-bearing asset and is expensive to\n    28\t// drain; it is built once and read (never mutated) by every check below.\n    29\tlet store: TempStore;\n    30\tlet fixture: DerivedThreadFixture;\n    31\t\n    32\tbeforeAll(async () => {\n    33\t  store = tempStore();\n    34\t  fixture = await derivedThreadFixture(store);\n    35\t});\n    36\tafterAll(() => {\n    37\t  store.cleanup();\n    38\t});\n    39\t\n    40\tfunction manualSdk(view?: Parameters<typeof createSdk>[0][\"view\"]): Lhc {\n    41\t  return createSdk({\n    42\t    provider: createProviderDouble(),\n    43\t    mode: \"manual\",\n    44\t    ...(view === undefined ? {} : { view }),\n    45\t  });\n    46\t}\n    47\t\n    48\tdescribe(\"FC-0.1: migration v6 storage on a current thread file\", () => {\n    49\t  it(\"creates the three view tables with their CHECK constraints and seeds the boundary at 0\", () => {\n    50\t    expect(schemaVersionOf(fixture.filePath)).toBe(6);\n    51\t    const db = openRaw(fixture.filePath);\n    52\t    try {\n    53\t      const tables = (\n    54\t        db\n    55\t          .prepare(\n    56\t            `SELECT name FROM sqlite_master WHERE type = 'table'\n    57\t             AND name IN ('thread_view', 'thread_view_band', 'view_boundary') ORDER BY name`,\n    58\t          )\n    59\t          .all() as unknown as Array<{ name: string }>\n    60\t      ).map((row) => row.name);\n    61\t      expect(tables).toEqual([\"thread_view\", \"thread_view_band\", \"view_boundary\"]);\n    62\t\n    63\t      // The boundary singleton is seeded at position 0 (everything full).\n    64\t      const boundary = db\n    65\t        .prepare(`SELECT thread_singleton, position, updated_at FROM view_boundary`)\n    66\t        .all() as unknown as Array<{\n    67\t        thread_singleton: number | bigint;\n    68\t        position: number | bigint;\n    69\t        updated_at: string;\n    70\t      }>;\n    71\t      expect(boundary).toHaveLength(1);\n    72\t      expect(Number(boundary[0]!.thread_singleton)).toBe(1);\n    73\t      expect(Number(boundary[0]!.position)).toBe(0);\n    74\t      expect(boundary[0]!.updated_at.length).toBeGreaterThan(0);\n    75\t\n    76\t      // Singleton CHECKs enforce structurally: a second view row or a second\n    77\t      // boundary row cannot exist (failed inserts, nothing mutated).\n    78\t      expect(() =>\n    79\t        db\n    80\t          .prepare(\n    81\t            `INSERT INTO thread_view (singleton, view_id, created_at, compact_point,\n    82\t               covered_from, config_json, arrangement_json, gaps_json, source_state_json)\n    83\t             VALUES (2, 'v1', 'now', 0, 0, '{}', '[]', '[]', '{}')`,\n    84\t          )\n    85\t          .run(),\n    86\t      ).toThrow(/CHECK/);\n    87\t      expect(() =>\n    88\t        db\n    89\t          .prepare(`INSERT INTO view_boundary (thread_singleton, position, updated_at) VALUES (2, 0, 'now')`)\n    90\t          .run(),\n    91\t      ).toThrow(/CHECK/);\n    92\t\n    93\t      // The band table pins its band vocabulary and cascade in the DDL.\n    94\t      const bandDdl = (\n    95\t        db\n    96\t          .prepare(`SELECT sql FROM sqlite_master WHERE name = 'thread_view_band'`)\n    97\t          .get() as { sql: string }\n    98\t      ).sql;\n    99\t      expect(bandDdl).toContain(\"CHECK (band IN ('brief','detailed','smooth'))\");\n   100\t      expect(bandDdl).toContain(\"ON DELETE CASCADE\");\n   101\t    } finally {\n   102\t      db.close();\n   103\t    }\n   104\t  });\n   105\t});\n   106\t\n   107\tdescribe(\"FC-0.2: view config validated at SDK construction, errors naming the violation\", () => {\n   108\t  it(\"rejects a profile whose band percentages do not sum to 100\", () => {\n   109\t    expect(() =>\n   110\t      manualSdk({\n   111\t        profiles: [\n   112\t          {\n   113\t            name: \"skewed\",\n   114\t            lowerBound: 50000,\n   115\t            percentages: { full: 30, smooth: 35, detailed: 20, brief: 20 },\n   116\t          },\n   117\t        ],\n   118\t      }),\n   119\t    ).toThrow(/profile \"skewed\": percentages must sum to 100, got 105/);\n   120\t  });\n   121\t\n   122\t  it(\"rejects visibility budgets violating max > target >= floor, naming the constraint\", () => {\n   123\t    expect(() => manualSdk({ visibility: { maxTokens: 24000, targetTokens: 24000 } })).toThrow(\n   124\t      /visibility\\.maxTokens \\(24000\\) must be greater than targetTokens \\(24000\\)/,\n   125\t    );\n   126\t    expect(() =>\n   127\t      manualSdk({ visibility: { targetTokens: 7000, floorTokens: 8000, maxTokens: 32000 } }),\n   128\t    ).toThrow(/visibility\\.targetTokens \\(7000\\) must be at least floorTokens \\(8000\\)/);\n   129\t  });\n   130\t\n   131\t  it(\"rejects a non-positive lower bound\", () => {\n   132\t    expect(() =>\n   133\t      manualSdk({\n   134\t        profiles: [\n   135\t          {\n   136\t            name: \"hollow\",\n   137\t            lowerBound: 0,\n   138\t            percentages: { full: 25, smooth: 35, detailed: 20, brief: 20 },\n   139\t          },\n   140\t        ],\n   141\t      }),\n   142\t    ).toThrow(/profile \"hollow\": lowerBound must be a positive number, got 0/);\n   143\t  });\n   144\t\n   145\t  it(\"rejects a partial profile that overrides no built-in (unknown override target)\", () => {\n   146\t    expect(() => manualSdk({ profiles: [{ name: \"mystery\", lowerBound: 64000 }] })).toThrow(\n   147\t      /profile \"mystery\" is partial but overrides no built-in \\(unknown built-in override target\\)/,\n   148\t    );\n   149\t  });\n   150\t\n   151\t  it(\"resolves defaults and merges a built-in override field-wise\", () => {\n   152\t    const sdk = manualSdk({ profiles: [{ name: \"coding\", lowerBound: 64000 }] });\n   153\t    expect(sdk.config.view.visibility).toEqual({\n   154\t      maxTokens: 32000,\n   155\t      targetTokens: 24000,\n   156\t      floorTokens: 8000,\n   157\t    });\n   158\t    expect(sdk.config.view.compactThreshold).toBe(160000);\n   159\t    // The override replaced only the named field; the built-in's percentages\n   160\t    // survive, and the other built-ins are untouched.\n   161\t    expect(sdk.config.view.profiles[\"coding\"]).toEqual({\n   162\t      name: \"coding\",\n   163\t      lowerBound: 64000,\n   164\t      percentages: { full: 25, smooth: 35, detailed: 20, brief: 20 },\n   165\t    });\n   166\t    expect(sdk.config.view.profiles[\"continuation\"]).toEqual({\n   167\t      name: \"continuation\",\n   168\t      lowerBound: 120000,\n   169\t      percentages: { full: 30, smooth: 30, detailed: 20, brief: 20 },\n   170\t    });\n   171\t    expect(sdk.config.view.profiles[\"conversation\"]?.percentages).toEqual({\n   172\t      full: 12,\n   173\t      smooth: 48,\n   174\t      detailed: 20,\n   175\t      brief: 20,\n   176\t    });\n   177\t  });\n   178\t});\n   179\t\n   180\tdescribe(\"FC-0.3: fixture states proven by read-back through the owning report surfaces\", () => {\n   181\t  it(\"ready: every turn rendering and the closed chunks' summaries read back ready through turns.report\", async () => {\n   182\t    const report = await turns.report({ filePath: fixture.filePath });\n   183\t    expect(report.ok).toBe(true);\n   184\t    if (!report.ok) return;\n   185\t    const renderings = report.value.filter((entry) => entry.form === \"turn_rendering\");\n   186\t    expect(renderings.map((entry) => entry.subjectId).sort()).toEqual(\n   187\t      [...fixture.turnIds].sort(),\n   188\t    );\n   189\t    for (const rendering of renderings) {\n   190\t      expect(rendering.state).toBe(\"ready\");\n","exit_code":0,"status":"completed"}}

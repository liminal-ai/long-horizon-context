{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/context.ts | sed -n '1,240p'\"","aggregated_output":"     1\timport { AsyncLocalStorage } from \"node:async_hooks\";\n     2\timport type { DatabaseSync } from \"node:sqlite\";\n     3\timport type { ResolvedViewConfig } from \"./view.js\";\n     4\t\n     5\texport interface OperationContext {\n     6\t  db: DatabaseSync; // open thread-file handle, inside the batch transaction\n     7\t  clock: () => Date; // injected for deterministic recordedAt/queuedAt in tests\n     8\t  threadId: string; // resolved identity of the thread being operated on\n     9\t  // Post-commit callback registration (DD-5): the transaction owner flushes\n    10\t  // the registered callbacks after its COMMIT succeeds and drops them on\n    11\t  // rollback, so anything registered here — the scheduler poke above all —\n    12\t  // is transactional by construction.\n    13\t  onCommit: (fn: () => void) => void;\n    14\t  // The scheduler poke for the SDK instance whose operation is running (DD-5,\n    15\t  // epic-fix-001): enqueue registers its onCommit poke against THIS, carried\n    16\t  // on the context, never a shared module slot. Resolved from the per-SDK\n    17\t  // seam in scope (background → its own scheduler; manual → a no-op), falling\n    18\t  // back to the below-SDK default seam only for direct domain calls with no\n    19\t  // SDK around. A manual SDK therefore never auto-drains even with a\n    20\t  // background SDK alive in the same process.\n    21\t  poke: (threadId: string) => void;\n    22\t}\n    23\t\n    24\t// The callback list behind ctx.onCommit, owned by whoever owns the\n    25\t// transaction. Flush after COMMIT; never call flush on a rollback path —\n    26\t// dropping the hooks is simply not flushing them.\n    27\texport interface CommitHooks {\n    28\t  register: (fn: () => void) => void;\n    29\t  flush: () => void;\n    30\t}\n    31\t\n    32\texport function createCommitHooks(): CommitHooks {\n    33\t  const callbacks: Array<() => void> = [];\n    34\t  return {\n    35\t    register: (fn) => {\n    36\t      callbacks.push(fn);\n    37\t    },\n    38\t    flush: () => {\n    39\t      for (const fn of callbacks.splice(0)) fn();\n    40\t    },\n    41\t  };\n    42\t}\n    43\t\n    44\t// Per-SDK-instance delivery seam (DD-5/DD-10, epic-fix-001). Each SDK runs\n    45\t// every one of its operations inside runWithInstanceSeam, so the code reached\n    46\t// deep inside — enqueue's poke and openThreadDatabase's touch — delivers to\n    47\t// THAT SDK's scheduler (background) or to a no-op (manual), isolated from any\n    48\t// other SDK in the process. Carried through async-context, not a mutable\n    49\t// module slot two SDKs would share: that sharing was the bug — a manual SDK\n    50\t// auto-drained because a background SDK had overwritten the global slot.\n    51\texport interface InstanceSeam {\n    52\t  poke: (threadId: string) => void;\n    53\t  touch: (filePath: string, db: DatabaseSync) => void;\n    54\t  // Epic 03 (tech design Flow 4): the instance's resolved view config rides\n    55\t  // the same seam the poke does, so a thread-view operation invoked through\n    56\t  // sdk.* reads THIS SDK's profiles/budgets/threshold. Below-SDK direct\n    57\t  // domain calls find no seam and fall back to the built-in defaults at the\n    58\t  // consuming site (thread-view), never here — shared/ may not import\n    59\t  // domains/, and the defaults' one resolution path lives there.\n    60\t  view?: ResolvedViewConfig;\n    61\t}\n    62\tconst seamStore = new AsyncLocalStorage<InstanceSeam>();\n    63\t\n    64\texport function runWithInstanceSeam<T>(seam: InstanceSeam, fn: () => T): T {\n    65\t  return seamStore.run(seam, fn);\n    66\t}\n    67\t\n    68\t// The below-SDK default seam (the former module-global poke/touch slots),\n    69\t// kept ONLY as the fallback for direct domain calls made with no SDK seam in\n    70\t// scope: the enqueue-atomicity tests that drive enqueue/runInTransaction\n    71\t// directly, and the single-background \"production path\" where a top-level\n    72\t// mutation still reaches the one installed scheduler. A background SDK\n    73\t// installs itself here at construction; a manual SDK leaves it alone AND\n    74\t// scopes its own operations to a no-op seam, so the fallback can never\n    75\t// auto-drain a manual SDK's queued work.\n    76\ttype SchedulerPoke = (threadId: string) => void;\n    77\tlet schedulerPoke: SchedulerPoke | null = null;\n    78\t\n    79\texport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n    80\t  schedulerPoke = poke;\n    81\t}\n    82\t\n    83\ttype ThreadTouch = (filePath: string, db: DatabaseSync) => void;\n    84\tlet threadTouch: ThreadTouch | null = null;\n    85\t\n    86\texport function setThreadTouch(touch: ThreadTouch | null): void {\n    87\t  threadTouch = touch;\n    88\t}\n    89\t\n    90\t// The poke target for a context built now: the running SDK's seam if one is\n    91\t// in scope, else the below-SDK default (null-safe). Captured onto ctx.poke so\n    92\t// the enqueue carries its target rather than reading a shared slot at fire\n    93\t// time — except, deliberately, through the default fallback for direct calls.\n    94\texport function resolveInstancePoke(): (threadId: string) => void {\n    95\t  const seam = seamStore.getStore();\n    96\t  if (seam !== undefined) return seam.poke;\n    97\t  return (threadId) => {\n    98\t    schedulerPoke?.(threadId);\n    99\t  };\n   100\t}\n   101\t\n   102\t// The view config for the operation now running: the SDK seam's resolved\n   103\t// config when one is in scope, undefined for direct domain calls (the\n   104\t// thread-view surface defaults those itself — see InstanceSeam.view).\n   105\texport function resolveInstanceViewConfig(): ResolvedViewConfig | undefined {\n   106\t  return seamStore.getStore()?.view;\n   107\t}\n   108\t\n   109\t// Reads-only operation scope (Epic 03 AC-1.1/AC-2.8): runs fn under the\n   110\t// current seam with the thread-touch announcement suppressed, so a pure read\n   111\t// — thread-view pull/status above all — can never schedule a background\n   112\t// scheduler's first-touch catch-up drain through its openThreadDatabase\n   113\t// calls (or those of the report surfaces it consumes). Everything else on\n   114\t// the seam (poke target, view config) carries through unchanged; for a\n   115\t// direct domain call with no seam in scope the installed scope delegates to\n   116\t// the below-SDK defaults, minus the touch. Write paths never use this.\n   117\texport function runWithThreadTouchSuppressed<T>(fn: () => T): T {\n   118\t  const seam = seamStore.getStore();\n   119\t  const base: InstanceSeam =\n   120\t    seam ??\n   121\t    {\n   122\t      poke: (threadId) => {\n   123\t        schedulerPoke?.(threadId);\n   124\t      },\n   125\t      touch: (filePath, db) => {\n   126\t        threadTouch?.(filePath, db);\n   127\t      },\n   128\t    };\n   129\t  return seamStore.run({ ...base, touch: () => {} }, fn);\n   130\t}\n   131\t\n   132\t// Thread-file open announcement (DD-10): openThreadDatabase fires this on\n   133\t// every open, before any caller transaction begins. Delivers to the SDK seam\n   134\t// in scope if any (background → first-touch catch-up; manual → no-op), else\n   135\t// the below-SDK default. The background scheduler learns threadId→filePath\n   136\t// and runs the first-touch catch-up off this seam.\n   137\texport function fireThreadTouch(filePath: string, db: DatabaseSync): void {\n   138\t  const seam = seamStore.getStore();\n   139\t  if (seam !== undefined) {\n   140\t    seam.touch(filePath, db);\n   141\t    return;\n   142\t  }\n   143\t  threadTouch?.(filePath, db);\n   144\t}\n   145\t\n   146\t// Transaction owner for operations outside the intake pipeline (mutations,\n   147\t// repair re-queues, tests of enqueue atomicity): BEGIN IMMEDIATE, run the\n   148\t// body with a context whose onCommit registrations flush only after COMMIT\n   149\t// succeeds and drop whole on rollback.\n   150\texport function runInTransaction<T>(\n   151\t  db: DatabaseSync,\n   152\t  clock: () => Date,\n   153\t  threadId: string,\n   154\t  fn: (ctx: OperationContext) => T,\n   155\t): T {\n   156\t  const hooks = createCommitHooks();\n   157\t  const poke = resolveInstancePoke();\n   158\t  db.exec(\"BEGIN IMMEDIATE;\");\n   159\t  let value: T;\n   160\t  try {\n   161\t    value = fn({ db, clock, threadId, onCommit: hooks.register, poke });\n   162\t    db.exec(\"COMMIT;\");\n   163\t  } catch (cause) {\n   164\t    db.exec(\"ROLLBACK;\");\n   165\t    throw cause;\n   166\t  }\n   167\t  hooks.flush();\n   168\t  return value;\n   169\t}\n","exit_code":0,"status":"completed"}}

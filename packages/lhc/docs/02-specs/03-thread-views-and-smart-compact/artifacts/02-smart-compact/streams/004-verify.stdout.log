{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/sdk.ts | sed -n '1,430p'\"","aggregated_output":"     1\texport * as threads from \"./domains/threads/index.js\";\n     2\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n     3\texport * as messages from \"./domains/messages/index.js\";\n     4\texport * as turns from \"./domains/turns/index.js\";\n     5\texport * as threadView from \"./domains/thread-view/index.js\";\n     6\t\n     7\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n     8\timport * as threadViewDomain from \"./domains/thread-view/index.js\";\n     9\timport { resolveViewConfig } from \"./domains/thread-view/index.js\";\n    10\timport * as messagesDomain from \"./domains/messages/index.js\";\n    11\timport * as threadsDomain from \"./domains/threads/index.js\";\n    12\timport * as turnsDomain from \"./domains/turns/index.js\";\n    13\timport {\n    14\t  createScheduler,\n    15\t  peekThreadId,\n    16\t  runDrain,\n    17\t  type DrainDeps,\n    18\t  type DrainReport,\n    19\t  type Scheduler,\n    20\t} from \"./scheduler.js\";\n    21\timport {\n    22\t  runWithInstanceSeam,\n    23\t  setSchedulerPoke as installSchedulerPoke,\n    24\t  setThreadTouch,\n    25\t  type InstanceSeam,\n    26\t} from \"./shared/context.js\";\n    27\timport {\n    28\t  PROVIDER_OPERATIONS,\n    29\t  type ResolvedSdkConfig,\n    30\t  type SdkConfig,\n    31\t  type WorkHandler,\n    32\t} from \"./shared/derivation.js\";\n    33\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n    34\timport type {\n    35\t  CompactReceipt,\n    36\t  PullResult,\n    37\t  SweepReceipt,\n    38\t  ViewCompactParams,\n    39\t  ViewProfile,\n    40\t  ViewStatus,\n    41\t} from \"./shared/view.js\";\n    42\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n    43\t\n    44\texport {\n    45\t  estimateTokens,\n    46\t  TOKEN_ESTIMATOR_ID,\n    47\t} from \"./tech-utils/token-counting/index.js\";\n    48\t\n    49\texport {\n    50\t  WORK_KIND_REGISTRY,\n    51\t  type WorkItemRecord,\n    52\t  type WorkKind,\n    53\t  type WorkOwner,\n    54\t  type WorkSourceRef,\n    55\t} from \"./tech-utils/work-queue/index.js\";\n    56\t\n    57\texport type {\n    58\t  ErrorClass,\n    59\t  ErrorCode,\n    60\t  ErrorResult,\n    61\t  OpResult,\n    62\t} from \"./shared/errors.js\";\n    63\texport {\n    64\t  runInTransaction,\n    65\t  setSchedulerPoke,\n    66\t  setThreadTouch,\n    67\t  type OperationContext,\n    68\t} from \"./shared/context.js\";\n    69\t\n    70\texport {\n    71\t  createDeterministicProvider,\n    72\t  deterministicOutcomesSuffix,\n    73\t  deterministicReceiptsSuffix,\n    74\t  deterministicText,\n    75\t  type DeterministicOpName,\n    76\t} from \"./providers/deterministic.js\";\n    77\texport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n    78\t\n    79\texport type {\n    80\t  CompletionTx,\n    81\t  DependencyGap,\n    82\t  DerivationProvider,\n    83\t  DerivedForm,\n    84\t  DerivedFormMetadata,\n    85\t  DerivedFormState,\n    86\t  FormKind,\n    87\t  FormReportEntry,\n    88\t  HandlerFormWrite,\n    89\t  HandlerOutcome,\n    90\t  HandlerRunContext,\n    91\t  ProviderResult,\n    92\t  RenderingPart,\n    93\t  ResolvedSdkConfig,\n    94\t  SdkConfig,\n    95\t  SubjectKind,\n    96\t  ToolOutcome,\n    97\t  ToolRunReceipt,\n    98\t  WorkHandler,\n    99\t} from \"./shared/derivation.js\";\n   100\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n   101\t\n   102\t// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n   103\t// from Story 0; the operation shapes land with Stories 1–5.\n   104\texport {\n   105\t  BUILT_IN_PROFILES,\n   106\t  DEFAULT_COMPACT_THRESHOLD,\n   107\t  DEFAULT_VISIBILITY,\n   108\t} from \"./domains/thread-view/index.js\";\n   109\texport type {\n   110\t  Band,\n   111\t  CompactReceipt,\n   112\t  PullResult,\n   113\t  ResolvedViewConfig,\n   114\t  SdkViewConfig,\n   115\t  SweepReceipt,\n   116\t  ViewCompactParams,\n   117\t  ViewMessage,\n   118\t  ViewMeta,\n   119\t  ViewProfile,\n   120\t  ViewProfileOverride,\n   121\t  ViewStatus,\n   122\t  VisibilityBudgets,\n   123\t} from \"./shared/view.js\";\n   124\texport {\n   125\t  countLiveItems,\n   126\t  enqueue,\n   127\t  queueDetail,\n   128\t  supersedeQueued,\n   129\t  type ClaimedWorkItem,\n   130\t  type EnqueueFormTarget,\n   131\t  type EnqueueInput,\n   132\t  type QueueDetailRow,\n   133\t} from \"./tech-utils/work-queue/index.js\";\n   134\t\n   135\texport type { ThreadRef } from \"./domains/threads/index.js\";\n   136\texport type {\n   137\t  Block,\n   138\t  BlockType,\n   139\t  MessageRecord,\n   140\t  MutationResult,\n   141\t} from \"./domains/messages/index.js\";\n   142\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n   143\texport type {\n   144\t  BatchResult,\n   145\t  EventKind,\n   146\t  EventRecord,\n   147\t  MessageEventInput,\n   148\t} from \"./domains/intake-stream/index.js\";\n   149\t\n   150\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n   151\t\n   152\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n   153\t\n   154\t// Merge per-domain handler tables into the one join between the queue's\n   155\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n   156\t// (each kind has exactly one owner) and throws at construction.\n   157\texport function assembleWorkHandlerMap(\n   158\t  tables: ReadonlyArray<WorkHandlerMap>,\n   159\t): WorkHandlerMap {\n   160\t  const map: WorkHandlerMap = {};\n   161\t  for (const table of tables) {\n   162\t    for (const [kind, handler] of Object.entries(table)) {\n   163\t      if (map[kind as WorkKind] !== undefined) {\n   164\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n   165\t      }\n   166\t      map[kind as WorkKind] = handler;\n   167\t    }\n   168\t  }\n   169\t  return map;\n   170\t}\n   171\t\n   172\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n   173\t  return {\n   174\t    ok: false,\n   175\t    error: {\n   176\t      errorClass: \"state_corruption\",\n   177\t      code: \"unknown_work_kind\",\n   178\t      reason: `no handler registered for work kind \"${kind}\"`,\n   179\t    },\n   180\t  };\n   181\t}\n   182\t\n   183\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n   184\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n   185\texport function lookupWorkHandler(\n   186\t  map: WorkHandlerMap,\n   187\t  kind: string,\n   188\t): OpResult<WorkHandler> {\n   189\t  const handler = map[kind as WorkKind];\n   190\t  if (handler === undefined) return unknownWorkKind(kind);\n   191\t  return { ok: true, value: handler };\n   192\t}\n   193\t\n   194\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n   195\t// requeue land in Story 4.\n   196\texport interface WorkSurface {\n   197\t  drain(\n   198\t    ref: threadsDomain.ThreadRef,\n   199\t    opts?: { maxItems?: number },\n   200\t  ): Promise<OpResult<DrainReport>>;\n   201\t}\n   202\t\n   203\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n   204\t// §Interface Definitions): the five operations only — the Story 0 config\n   205\t// substrate the domain index also carries is construction machinery, not an\n   206\t// operation. pull and status are real from Story 1; compact, sweep, and\n   207\t// materialize return structured not-implemented results until their stories\n   208\t// land.\n   209\texport interface ThreadViewSurface {\n   210\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n   211\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n   212\t  compact(\n   213\t    ref: threadsDomain.ThreadRef,\n   214\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n   215\t  ): Promise<OpResult<CompactReceipt>>;\n   216\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n   217\t  materialize(\n   218\t    ref: threadsDomain.ThreadRef,\n   219\t    opts: { path: string; format?: \"pi-session\" },\n   220\t  ): Promise<OpResult<{ writtenPath: string }>>;\n   221\t}\n   222\t\n   223\texport interface Lhc {\n   224\t  threads: typeof threadsDomain;\n   225\t  intakeStream: typeof intakeStreamDomain;\n   226\t  messages: typeof messagesDomain;\n   227\t  turns: typeof turnsDomain;\n   228\t  threadView: ThreadViewSurface;\n   229\t  config: ResolvedSdkConfig;\n   230\t  scheduler: Scheduler;\n   231\t  workHandlers: WorkHandlerMap;\n   232\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n   233\t  work: WorkSurface;\n   234\t  // Resolves when the scheduler has no running or pending drain for the\n   235\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n   236\t  // resolve in manual mode.\n   237\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n   238\t}\n   239\t\n   240\tfunction requirePositive(value: number, name: string): void {\n   241\t  if (!Number.isFinite(value) || value <= 0) {\n   242\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n   243\t  }\n   244\t}\n   245\t\n   246\tfunction requireNonNegative(value: number, name: string): void {\n   247\t  if (!Number.isFinite(value) || value < 0) {\n   248\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n   249\t  }\n   250\t}\n   251\t\n   252\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n   253\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n   254\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n   255\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n   256\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n   257\t// object is the same shape as the namespace, so the public surface type holds.\n   258\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n   259\t  const scoped: Record<string, unknown> = {};\n   260\t  for (const key of Object.keys(surface)) {\n   261\t    const value = (surface as Record<string, unknown>)[key];\n   262\t    scoped[key] =\n   263\t      typeof value === \"function\"\n   264\t        ? (...args: unknown[]): unknown =>\n   265\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n   266\t        : value;\n   267\t  }\n   268\t  return scoped as T;\n   269\t}\n   270\t\n   271\t// The only assembly path: provider, mode, clock, and policy enter here.\n   272\t// Config mistakes are programmer errors at construction and throw; operating\n   273\t// failures after construction return OpResults per the error contract.\n   274\texport function createSdk(config: SdkConfig): Lhc {\n   275\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   276\t    throw new TypeError(\n   277\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   278\t    );\n   279\t  }\n   280\t  if (config.provider === null || typeof config.provider !== \"object\") {\n   281\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   282\t  }\n   283\t  for (const operation of PROVIDER_OPERATIONS) {\n   284\t    if (typeof config.provider[operation] !== \"function\") {\n   285\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   286\t    }\n   287\t  }\n   288\t\n   289\t  const resolved: ResolvedSdkConfig = {\n   290\t    provider: config.provider,\n   291\t    mode: config.mode,\n   292\t    clock: config.clock ?? (() => new Date()),\n   293\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   294\t    lease: config.lease ?? { durationMs: 120000 },\n   295\t    chunkPolicy:\n   296\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n   297\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n   298\t    // sums and visibility budgets validated — throws naming the violation.\n   299\t    view: resolveViewConfig(config.view),\n   300\t  };\n   301\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n   302\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n   303\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n   304\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n   305\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n   306\t  }\n   307\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n   308\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n   309\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n   310\t    throw new TypeError(\n   311\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n   312\t    );\n   313\t  }\n   314\t\n   315\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n   316\t  // The tables are empty until Stories 2–3 land the real handlers; the\n   317\t  // assembly mechanics are production code from day one.\n   318\t  const workHandlers = assembleWorkHandlerMap([\n   319\t    messagesDomain.workHandlers,\n   320\t    turnsDomain.workHandlers,\n   321\t  ]);\n   322\t\n   323\t  const drainDeps: DrainDeps = {\n   324\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   325\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n   326\t    config: resolved,\n   327\t  };\n   328\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n   329\t\n   330\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n   331\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n   332\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n   333\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n   334\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n   335\t  // the construction order, because its operations deliver to the no-op seam,\n   336\t  // not to whatever a background SDK installed below.\n   337\t  // The seam also carries this instance's resolved view config (Epic 03,\n   338\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n   339\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n   340\t  // fall back to the built-in defaults inside the thread-view surface.\n   341\t  const seam: InstanceSeam =\n   342\t    resolved.mode === \"background\"\n   343\t      ? {\n   344\t          poke: (threadId) => scheduler.poke(threadId),\n   345\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n   346\t          view: resolved.view,\n   347\t        }\n   348\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\n   349\t\n   350\t  // Background mode also installs the below-SDK default seam so a direct\n   351\t  // domain call made with no SDK scope — a top-level mutation in the\n   352\t  // single-background \"production path\" — still reaches the one installed\n   353\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n   354\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n   355\t  // leaves the default alone (pokes stay no-ops by contract).\n   356\t  if (resolved.mode === \"background\") {\n   357\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n   358\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n   359\t  }\n   360\t\n   361\t  const work: WorkSurface = {\n   362\t    drain: (ref, opts) =>\n   363\t      runWithInstanceSeam(seam, async () => {\n   364\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   365\t        if (!resolvedRef.ok) return resolvedRef;\n   366\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n   367\t      }),\n   368\t  };\n   369\t\n   370\t  return {\n   371\t    threads: threadsDomain,\n   372\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n   373\t    messages: scopeSurface(messagesDomain, seam),\n   374\t    turns: scopeSurface(turnsDomain, seam),\n   375\t    threadView: scopeSurface<ThreadViewSurface>(\n   376\t      {\n   377\t        pull: threadViewDomain.pull,\n   378\t        status: threadViewDomain.status,\n   379\t        compact: threadViewDomain.compact,\n   380\t        sweep: threadViewDomain.sweep,\n   381\t        materialize: threadViewDomain.materialize,\n   382\t      },\n   383\t      seam,\n   384\t    ),\n   385\t    config: resolved,\n   386\t    scheduler,\n   387\t    workHandlers,\n   388\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   389\t    work,\n   390\t    drainSettled: async (ref) => {\n   391\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   392\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n   393\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n   394\t      if (threadId === null) return;\n   395\t      return scheduler.drainSettled(threadId);\n   396\t    },\n   397\t  };\n   398\t}\n","exit_code":0,"status":"completed"}}

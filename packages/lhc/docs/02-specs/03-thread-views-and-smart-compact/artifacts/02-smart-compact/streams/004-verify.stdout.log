{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/threads/index.ts | sed -n '1,180p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     3\timport {\n     4\t  createThreadFile,\n     5\t  deleteThreadFile,\n     6\t  generateThreadId,\n     7\t  openThreadDatabase,\n     8\t} from \"./internal/create.js\";\n     9\t\n    10\t// Re-exported for the other domain surfaces: opening a thread file through\n    11\t// the threads domain is what guarantees its schema is current (a pre-Story-3\n    12\t// file gains the message tables here before any write or read touches them).\n    13\texport { openThreadDatabase };\n    14\timport {\n    15\t  insertThreadRow,\n    16\t  openRegistryForRead,\n    17\t  openRegistryForWrite,\n    18\t  resolveRegistryPath,\n    19\t  selectAllThreadRows,\n    20\t  selectThreadRow,\n    21\t  type RegistryRow,\n    22\t} from \"./internal/registry.js\";\n    23\t\n    24\texport type ThreadRef =\n    25\t  | { threadId: string; registryPath?: string }\n    26\t  | { filePath: string };\n    27\t\n    28\texport interface NewThreadInput {\n    29\t  filePath: string;\n    30\t  title?: string;\n    31\t  registryPath?: string;\n    32\t}\n    33\t\n    34\texport interface ThreadInfo {\n    35\t  threadId: string;\n    36\t  filePath: string;\n    37\t  title?: string;\n    38\t  createdAt: string; // ISO-8601\n    39\t}\n    40\t\n    41\tfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n    42\t  const info: ThreadInfo = {\n    43\t    threadId: row.threadId,\n    44\t    filePath: row.filePath,\n    45\t    createdAt: row.createdAt,\n    46\t  };\n    47\t  if (row.title !== undefined) info.title = row.title;\n    48\t  return info;\n    49\t}\n    50\t\n    51\tfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n    52\t  return {\n    53\t    ok: false,\n    54\t    error: {\n    55\t      errorClass: \"caller_error\",\n    56\t      code: \"thread_not_found\",\n    57\t      reason: `no thread registered with id ${threadId}`,\n    58\t    },\n    59\t  };\n    60\t}\n    61\t\n    62\tfunction invalidThreadRef(reason: string): { ok: false; error: ErrorResult } {\n    63\t  return {\n    64\t    ok: false,\n    65\t    error: { errorClass: \"caller_error\", code: \"invalid_thread_ref\", reason },\n    66\t  };\n    67\t}\n    68\t\n    69\t// A file path that is empty or whitespace-only cannot name a durable file:\n    70\t// node:sqlite's DatabaseSync(\"\") opens a temporary database that vanishes on\n    71\t// close, so such a path must be refused as a caller error before any storage\n    72\t// is touched rather than silently producing a thread with no durable file.\n    73\tfunction isBlankPath(filePath: string): boolean {\n    74\t  return filePath.trim() === \"\";\n    75\t}\n    76\t\n    77\tfunction detail(cause: unknown): string {\n    78\t  return cause instanceof Error ? cause.message : String(cause);\n    79\t}\n    80\t\n    81\t// Creation spans two databases that cannot share a transaction. Order is\n    82\t// file-then-row with compensation: the invariant \"no registry row without\n    83\t// its file\" is absolute; an orphan file from a crash between the writes is\n    84\t// documented harmless (design decision 2).\n    85\texport async function newThread(\n    86\t  input: NewThreadInput,\n    87\t): Promise<OpResult<{ threadId: string; filePath: string }>> {\n    88\t  // Guard before any storage touch: an empty/blank path would otherwise open\n    89\t  // a temp database and register a thread with no durable file (the no-row-\n    90\t  // without-file invariant below depends on the path naming a real file).\n    91\t  if (isBlankPath(input.filePath)) {\n    92\t    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n    93\t  }\n    94\t  if (existsSync(input.filePath)) {\n    95\t    return {\n    96\t      ok: false,\n    97\t      error: {\n    98\t        errorClass: \"caller_error\",\n    99\t        code: \"path_exists\",\n   100\t        reason: `a file already exists at ${input.filePath}`,\n   101\t      },\n   102\t    };\n   103\t  }\n   104\t\n   105\t  const threadId = generateThreadId();\n   106\t  const createdAt = new Date().toISOString();\n   107\t\n   108\t  try {\n   109\t    createThreadFile(input.filePath, threadId, createdAt);\n   110\t  } catch (cause) {\n   111\t    deleteThreadFile(input.filePath);\n   112\t    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n   113\t  }\n   114\t\n   115\t  let registry;\n   116\t  try {\n   117\t    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n   118\t    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n   119\t    if (input.title !== undefined) row.title = input.title;\n   120\t    insertThreadRow(registry, row);\n   121\t  } catch (cause) {\n   122\t    deleteThreadFile(input.filePath);\n   123\t    return storageFailure(`registry insert failed: ${detail(cause)}`);\n   124\t  } finally {\n   125\t    registry?.close();\n   126\t  }\n   127\t\n   128\t  return { ok: true, value: { threadId, filePath: input.filePath } };\n   129\t}\n   130\t\n   131\texport async function resolve(input: {\n   132\t  threadId: string;\n   133\t  registryPath?: string;\n   134\t}): Promise<OpResult<ThreadInfo>> {\n   135\t  let registry;\n   136\t  try {\n   137\t    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n   138\t    if (registry === null) return threadNotFound(input.threadId);\n   139\t    const row = selectThreadRow(registry, input.threadId);\n   140\t    if (row === undefined) return threadNotFound(input.threadId);\n   141\t    return { ok: true, value: toThreadInfo(row) };\n   142\t  } catch (cause) {\n   143\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n   144\t  } finally {\n   145\t    registry?.close();\n   146\t  }\n   147\t}\n   148\t\n   149\texport async function listThreads(input?: {\n   150\t  registryPath?: string;\n   151\t}): Promise<OpResult<ThreadInfo[]>> {\n   152\t  let registry;\n   153\t  try {\n   154\t    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n   155\t    if (registry === null) return { ok: true, value: [] };\n   156\t    return { ok: true, value: selectAllThreadRows(registry).map(toThreadInfo) };\n   157\t  } catch (cause) {\n   158\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n   159\t  } finally {\n   160\t    registry?.close();\n   161\t  }\n   162\t}\n   163\t\n   164\t// The single interpreter of thread references: { threadId } resolves to a\n   165\t// path through the registry, { filePath } passes through untouched. No other\n   166\t// code ever reads a thread reference.\n   167\texport async function resolveThreadRef(\n   168\t  ref: ThreadRef,\n   169\t): Promise<OpResult<{ filePath: string }>> {\n   170\t  if (\"threadId\" in ref) {\n   171\t    const resolved = await resolve(ref);\n   172\t    if (!resolved.ok) return resolved;\n   173\t    return { ok: true, value: { filePath: resolved.value.filePath } };\n   174\t  }\n   175\t  // Mirror newThread's guard so every read surface that routes through here\n   176\t  // fails closed on a blank path instead of opening a temp database.\n   177\t  if (isBlankPath(ref.filePath)) {\n   178\t    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n   179\t  }\n   180\t  return { ok: true, value: { filePath: ref.filePath } };\n","exit_code":0,"status":"completed"}}

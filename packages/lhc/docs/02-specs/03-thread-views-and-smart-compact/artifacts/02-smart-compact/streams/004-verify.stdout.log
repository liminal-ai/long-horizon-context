{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc 'wc -l packages/lhc/test/view-compact.test.ts packages/lhc/test/view-select-golden.test.ts packages/lhc/test/view-pull.test.ts packages/lhc/test/fixtures/view-thread.ts packages/lhc/test/fixtures/view-seam.ts packages/lhc/test/goldens/*.json packages/lhc/test/goldens/README.md'","aggregated_output":"     745 packages/lhc/test/view-compact.test.ts\n     178 packages/lhc/test/view-select-golden.test.ts\n     526 packages/lhc/test/view-pull.test.ts\n     317 packages/lhc/test/fixtures/view-thread.ts\n      40 packages/lhc/test/fixtures/view-seam.ts\n      14 packages/lhc/test/goldens/g1-proportions.json\n      14 packages/lhc/test/goldens/g2-edge-exclusion.json\n      16 packages/lhc/test/goldens/g2-edge-inclusion.json\n      12 packages/lhc/test/goldens/g3-oversized-loner.json\n      14 packages/lhc/test/goldens/g4-turnless-straggler.json\n      34 packages/lhc/test/goldens/README.md\n    1910 total\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/view-compact.test.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Epic 03 Story 2: smart compact (TC-2.1–2.4, TC-2.6, TC-2.7, TC-1.3,\n     2\t// TC-1.5, the TC-2.5 view-health completion legs, and the architecture-risk\n     3\t// rows: restart-serves-snapshot and coverage-edge accounting). Every TC goes\n     4\t// through the real SDK surface (createSdk().threadView.compact) against real\n     5\t// temp thread files; the provider double appears only in fixture setup —\n     6\t// degraded states are reached through production paths (scripted provider\n     7\t// exhaustion at build, edit-cascade pending clears), never by writing\n     8\t// derived_form directly.\n     9\timport { createHash } from \"node:crypto\";\n    10\timport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\n    11\timport {\n    12\t  createSdk,\n    13\t  type Lhc,\n    14\t  type MessageEventInput,\n    15\t  type ViewMessage,\n    16\t} from \"../src/index.js\";\n    17\timport {\n    18\t  corruptTwoOpenTurns,\n    19\t  createProviderDouble,\n    20\t  derivedThreadFixture,\n    21\t  openRaw,\n    22\t  setViewInjectionHook,\n    23\t  tempStore,\n    24\t  validEvent,\n    25\t  type DerivedThreadFixture,\n    26\t  type ProviderDouble,\n    27\t  type TempStore,\n    28\t} from \"./fixtures/index.js\";\n    29\t\n    30\tlet store: TempStore;\n    31\tlet fixture: DerivedThreadFixture;\n    32\t\n    33\tbeforeAll(async () => {\n    34\t  store = tempStore();\n    35\t  fixture = await derivedThreadFixture(store);\n    36\t});\n    37\tafterAll(() => {\n    38\t  store.cleanup();\n    39\t});\n    40\t\n    41\t// The story's reference configs (hand-derived from the fixture's\n    42\t// deterministic token costs; the goldens in view-select-golden.test.ts pin\n    43\t// the resulting arrangements exactly).\n    44\tconst GRADIENT_PARAMS = {\n    45\t  lowerBound: 400,\n    46\t  percentages: { full: 25, smooth: 25, detailed: 25, brief: 25 },\n    47\t};\n    48\tconst EDGE_PARAMS = {\n    49\t  lowerBound: 120,\n    50\t  percentages: { full: 88, smooth: 5, detailed: 5, brief: 2 },\n    51\t};\n    52\t\n    53\tfunction sha256(value: unknown): string {\n    54\t  return createHash(\"sha256\").update(JSON.stringify(value)).digest(\"hex\");\n    55\t}\n    56\t\n    57\t// The canonical record plus its derived state — everything compact must\n    58\t// never touch (AC-2.9). View tables and the boundary are deliberately\n    59\t// excluded: those are compact's own rows.\n    60\tfunction recordSnapshot(filePath: string): string {\n    61\t  const db = openRaw(filePath);\n    62\t  try {\n    63\t    return sha256({\n    64\t      events: db.prepare(`SELECT * FROM event ORDER BY event_order`).all(),\n    65\t      messages: db.prepare(`SELECT * FROM message ORDER BY source_event_order`).all(),\n    66\t      blocks: db\n    67\t        .prepare(`SELECT * FROM message_block ORDER BY message_id, block_index`)\n    68\t        .all(),\n    69\t      turns: db.prepare(`SELECT * FROM turns ORDER BY turn_order`).all(),\n    70\t      chunks: db.prepare(`SELECT * FROM chunk ORDER BY chunk_order`).all(),\n    71\t      members: db.prepare(`SELECT * FROM chunk_member ORDER BY chunk_id, member_idx`).all(),\n    72\t      forms: db\n    73\t        .prepare(`SELECT * FROM derived_form ORDER BY subject_kind, subject_id, form`)\n    74\t        .all(),\n    75\t    });\n    76\t  } finally {\n    77\t    db.close();\n    78\t  }\n    79\t}\n    80\t\n    81\t// Full-file state including the view rows and boundary — for the\n    82\t// thread-unchanged-after-rejection assertions.\n    83\tfunction fullStateSnapshot(filePath: string): string {\n    84\t  const db = openRaw(filePath);\n    85\t  try {\n    86\t    return sha256({\n    87\t      record: recordSnapshot(filePath),\n    88\t      views: db.prepare(`SELECT * FROM thread_view`).all(),\n    89\t      bands: db.prepare(`SELECT * FROM thread_view_band ORDER BY band`).all(),\n    90\t      boundary: db.prepare(`SELECT position FROM view_boundary`).all(),\n    91\t      work: db.prepare(`SELECT work_item_id, status FROM work_item ORDER BY work_item_id`).all(),\n    92\t    });\n    93\t  } finally {\n    94\t    db.close();\n    95\t  }\n    96\t}\n    97\t\n    98\tfunction viewRowCount(filePath: string): number {\n    99\t  const db = openRaw(filePath);\n   100\t  try {\n   101\t    const row = db.prepare(`SELECT COUNT(*) AS n FROM thread_view`).get() as {\n   102\t      n: number | bigint;\n   103\t    };\n   104\t    return Number(row.n);\n   105\t  } finally {\n   106\t    db.close();\n   107\t  }\n   108\t}\n   109\t\n   110\tfunction boundaryPosition(filePath: string): number {\n   111\t  const db = openRaw(filePath);\n   112\t  try {\n   113\t    const row = db.prepare(`SELECT position FROM view_boundary`).get() as {\n   114\t      position: number | bigint;\n   115\t    };\n   116\t    return Number(row.position);\n   117\t  } finally {\n   118\t    db.close();\n   119\t  }\n   120\t}\n   121\t\n   122\tfunction bandMessages(messages: readonly ViewMessage[]): ViewMessage[] {\n   123\t  return messages.filter((message) => message.band !== undefined);\n   124\t}\n   125\t\n   126\tasync function pullMessages(sdk: Lhc, filePath: string): Promise<ViewMessage[]> {\n   127\t  const pulled = await sdk.threadView.pull({ filePath });\n   128\t  if (!pulled.ok) throw new Error(`pull failed: ${pulled.error.reason}`);\n   129\t  return pulled.value.messages;\n   130\t}\n   131\t\n   132\tdescribe(\"TC-2.1 (AC-2.2, AC-2.3, AC-2.7): profiles, explicit params, and named rejections\", () => {\n   133\t  it(\"rejects percentages summing to 105 naming the sum, and an unknown profile naming it; thread unchanged\", async () => {\n   134\t    const before = fullStateSnapshot(fixture.filePath);\n   135\t\n   136\t    const badSum = await fixture.sdk.threadView.compact(\n   137\t      { filePath: fixture.filePath },\n   138\t      { params: { percentages: { full: 30, smooth: 30, detailed: 25, brief: 20 } } },\n   139\t    );\n   140\t    expect(badSum.ok).toBe(false);\n   141\t    if (badSum.ok) return;\n   142\t    expect(badSum.error.errorClass).toBe(\"caller_error\");\n   143\t    expect(badSum.error.code).toBe(\"invalid_view_config\");\n   144\t    expect(badSum.error.reason).toContain(\"105\");\n   145\t\n   146\t    const badBound = await fixture.sdk.threadView.compact(\n   147\t      { filePath: fixture.filePath },\n   148\t      { params: { lowerBound: 0 } },\n   149\t    );\n   150\t    expect(badBound.ok).toBe(false);\n   151\t    if (badBound.ok) return;\n   152\t    expect(badBound.error.code).toBe(\"invalid_view_config\");\n   153\t    expect(badBound.error.reason).toContain(\"lowerBound\");\n   154\t\n   155\t    const unknown = await fixture.sdk.threadView.compact(\n   156\t      { filePath: fixture.filePath },\n   157\t      { profile: \"nonesuch\" },\n   158\t    );\n   159\t    expect(unknown.ok).toBe(false);\n   160\t    if (unknown.ok) return;\n   161\t    expect(unknown.error.errorClass).toBe(\"caller_error\");\n   162\t    expect(unknown.error.code).toBe(\"unknown_profile\");\n   163\t    expect(unknown.error.reason).toContain('\"nonesuch\"');\n   164\t\n   165\t    // Thread unchanged after all rejections: no view row landed, no record\n   166\t    // or boundary movement (read-back equality).\n   167\t    expect(fullStateSnapshot(fixture.filePath)).toBe(before);\n   168\t    expect(viewRowCount(fixture.filePath)).toBe(0);\n   169\t  });\n   170\t\n   171\t  it(\"compacts with a built-in profile: the profile's bound and mix land in the receipt\", async () => {\n   172\t    const receipt = await fixture.sdk.threadView.compact(\n   173\t      { filePath: fixture.filePath },\n   174\t      { profile: \"coding\" },\n   175\t    );\n   176\t    expect(receipt.ok).toBe(true);\n   177\t    if (!receipt.ok) return;\n   178\t    expect(receipt.value.profile).toBe(\"coding\");\n   179\t    expect(receipt.value.config).toEqual({\n   180\t      full: 25,\n   181\t      smooth: 35,\n   182\t      detailed: 20,\n   183\t      brief: 20,\n   184\t      lowerBound: 120000,\n   185\t    });\n   186\t    // Sweep step is absent this story (the honest literal, not a fake empty\n   187\t    // receipt — Story 3 flips it).\n   188\t    expect(receipt.value.sweep).toBe(\"absent\");\n   189\t    // At a 120k bound this small thread is all tail: bands empty, compact\n   190\t    // point at the origin.\n   191\t    expect(receipt.value.compactPoint).toBe(0);\n   192\t    expect(receipt.value.bands.smooth.entries).toBe(0);\n   193\t  });\n   194\t\n   195\t  it(\"explicit params override profile values field-wise and report profile null\", async () => {\n   196\t    const receipt = await fixture.sdk.threadView.compact(\n   197\t      { filePath: fixture.filePath },\n   198\t      { profile: \"coding\", params: { lowerBound: 400, percentages: { smooth: 40, detailed: 15 } } },\n   199\t    );\n   200\t    expect(receipt.ok).toBe(true);\n   201\t    if (!receipt.ok) return;\n   202\t    // coding's mix with the two overridden fields; explicit params ⇒ the\n   203\t    // receipt names no profile (config carries the resolved truth).\n   204\t    expect(receipt.value.config).toEqual({\n   205\t      full: 25,\n   206\t      smooth: 40,\n   207\t      detailed: 15,\n   208\t      brief: 20,\n   209\t      lowerBound: 400,\n   210\t    });\n   211\t    expect(receipt.value.profile).toBeNull();\n   212\t  });\n   213\t});\n   214\t\n   215\tdescribe(\"TC-2.2 (AC-2.4, AC-2.9): the compact targets the bound from stored artifacts only\", () => {\n   216\t  it(\"actuals near shares with whole-entry deviations, zero provider calls, record untouched\", async () => {\n   217\t    const captured = fixture.double.captureInputs();\n   218\t    const capturedBefore = captured.length;\n   219\t    const recordBefore = recordSnapshot(fixture.filePath);\n   220\t\n   221\t    const receipt = await fixture.sdk.threadView.compact(\n   222\t      { filePath: fixture.filePath },\n   223\t      { params: GRADIENT_PARAMS },\n   224\t    );\n   225\t    expect(receipt.ok).toBe(true);\n   226\t    if (!receipt.ok) return;\n   227\t    const shares = {\n   228\t      smooth: (400 * 25) / 100,\n   229\t      detailed: (400 * 25) / 100,\n   230\t      brief: (400 * 25) / 100,\n   231\t    };\n   232\t\n   233\t    // Whole-entry fills: a band lands at-or-under its share unless a single\n   234\t    // indivisible entry had to represent (the only sanctioned over-share\n   235\t    // deviation, AC-2.4).\n   236\t    for (const band of [\"brief\", \"detailed\", \"smooth\"] as const) {\n   237\t      const actual = receipt.value.bands[band];\n   238\t      const attributable = actual.tokens <= shares[band] || actual.entries === 1;\n   239\t      expect(attributable).toBe(true);\n   240\t    }\n   241\t    // The fixture's pinned arrangement under these params: c1 brief within\n   242\t    // share, c2 an oversized single detailed entry, two smooth turns within\n   243\t    // share, tail under the full share plus turn-boundary snap.\n   244\t    expect(receipt.value.bands.brief).toEqual({ entries: 1, tokens: expect.any(Number) });\n   245\t    expect(receipt.value.bands.detailed.entries).toBe(1);\n   246\t    expect(receipt.value.bands.smooth.entries).toBe(2);\n   247\t    expect(receipt.value.bands.smooth.tokens).toBeLessThanOrEqual(shares.smooth);\n   248\t    expect(receipt.value.tailTokens).toBeLessThanOrEqual((400 * 25) / 100);\n   249\t    expect(receipt.value.compactPoint).toBe(48);\n   250\t\n   251\t    // No provider call anywhere in the compact path; the record (events,\n   252\t    // messages, turns, chunks, forms) is byte-identical after.\n   253\t    expect(captured.length).toBe(capturedBefore);\n   254\t    expect(recordSnapshot(fixture.filePath)).toBe(recordBefore);\n   255\t  });\n   256\t});\n   257\t\n   258\tdescribe(\"TC-2.6 (AC-2.10): band entries carry their subject keys visibly\", () => {\n   259\t  it(\"chunk keys in brief/detailed text, turn keys in smooth text\", async () => {\n   260\t    const receipt = await fixture.sdk.threadView.compact(\n","exit_code":0,"status":"completed"}}

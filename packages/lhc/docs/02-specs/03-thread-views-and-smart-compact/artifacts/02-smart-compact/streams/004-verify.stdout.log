{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/view.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Epic 03 shared vocabulary: the thread-view types (tech design §Interface\n     2\t// Definitions). Shared so cli/sdk/tests import one home; the thread-view\n     3\t// domain owns the behavior, this module owns only the shapes.\n     4\t\n     5\texport type Band = \"brief\" | \"detailed\" | \"smooth\";\n     6\t\n     7\texport interface ViewProfile {\n     8\t  name: string;\n     9\t  // Target assembled size; whole-entry fills may land under or over (epic\n    10\t  // Data Contracts — the bound is a target, not a cap).\n    11\t  lowerBound: number;\n    12\t  // Band shares of the lower bound; must sum to 100 (AC-2.3).\n    13\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\n    14\t}\n    15\t\n    16\t// A user profile entry as configured: a full profile under a new name, or a\n    17\t// field-wise override of a built-in (merged by name, AC-2.2). A partial entry\n    18\t// whose name matches no built-in has nothing to merge over and is rejected at\n    19\t// construction (FC-0.2's unknown-override violation).\n    20\texport interface ViewProfileOverride {\n    21\t  name: string;\n    22\t  lowerBound?: number;\n    23\t  percentages?: Partial<ViewProfile[\"percentages\"]>;\n    24\t}\n    25\t\n    26\t// Compact-time explicit parameters (AC-2.2): field-wise overrides of the\n    27\t// base profile, down to single band percentages — the same depth the CLI's\n    28\t// per-band flags override at. A nested-partial deepening of the tech\n    29\t// design's `Partial<ViewProfile>` sketch, which could not express a\n    30\t// single-band override.\n    31\texport interface ViewCompactParams {\n    32\t  lowerBound?: number;\n    33\t  percentages?: Partial<ViewProfile[\"percentages\"]>;\n    34\t}\n    35\t\n    36\t// Visibility-boundary budgets (AC-4.x): max > target ≥ floor, all positive.\n    37\texport interface VisibilityBudgets {\n    38\t  maxTokens: number;\n    39\t  targetTokens: number;\n    40\t  floorTokens: number;\n    41\t}\n    42\t\n    43\t// ── SDK assembly config (validated at construction, throws on nonsense\n    44\t// per the Epic 02 rule) ───────────────────────────────────────────\n    45\texport interface SdkViewConfig {\n    46\t  profiles?: ViewProfileOverride[]; // merged over built-ins by name\n    47\t  visibility?: Partial<VisibilityBudgets>; // defaults: 32000 / 24000 / 8000\n    48\t  compactThreshold?: number; // status trigger; default 160000\n    49\t}\n    50\t\n    51\t// Every optional filled by createSdk's central defaults; profiles resolved\n    52\t// to complete, validated entries keyed by name.\n    53\texport interface ResolvedViewConfig {\n    54\t  profiles: Readonly<Record<string, ViewProfile>>;\n    55\t  visibility: VisibilityBudgets;\n    56\t  compactThreshold: number;\n    57\t}\n    58\t\n    59\t// ── pull / status shapes (the product crossing to the harness) ────\n    60\t//\n    61\t// The pull's array shape (Story 1, load-bearing for Stories 2–5): band\n    62\t// messages first — one `user` message per non-empty band, gradient order\n    63\t// brief → detailed → smooth, marker header + snapshot bytes verbatim — then\n    64\t// the tail in record order. Tail messages render by the message-kind mapping\n    65\t// table (tech design §Tail message rendering), the contract every later\n    66\t// story renders into:\n    67\t//\n    68\t//   | Message kind                       | Role      | Content shape |\n    69\t//   |------------------------------------|-----------|---------------|\n    70\t//   | user_prompt                        | user      | text verbatim |\n    71\t//   | assistant_text                     | assistant | text verbatim |\n    72\t//   | assistant_thinking                 | assistant | fenced: `[thinking]\\n<text>\\n[/thinking]` — included (the tail is full fidelity) |\n    73\t//   | tool_call                          | assistant | `[tool call · <name>] <compact args>` — deterministic arg rendering, abbreviation rule for oversized args |\n    74\t//   | tool_result (ahead of boundary)    | user      | `[tool result · <name>]\\n<full content>` |\n    75\t//   | tool_result (at-or-behind boundary)| user      | `[tool result · <name> · abridged]\\n<summary or deterministic truncation>` (short-form ladder) |\n    76\t//   | runtime_note                       | user      | `[runtime note] <text>` |\n    77\texport interface ViewMessage {\n    78\t  role: \"user\" | \"assistant\";\n    79\t  content: string;\n    80\t  band?: Band; // band absent ⇒ tail\n    81\t}\n    82\t\n    83\texport interface ViewMeta {\n    84\t  compactPoint: number | null; // null ⇒ never compacted (AC-1.3)\n    85\t  coveredFrom: number | null;\n    86\t  boundaryPosition: number;\n    87\t  gapCount: number;\n    88\t  degradedCount: number;\n    89\t  viewId: string | null;\n    90\t  createdAt: string | null;\n    91\t}\n    92\t\n    93\texport interface PullResult {\n    94\t  messages: ViewMessage[];\n    95\t  meta: ViewMeta;\n    96\t}\n    97\t\n    98\texport interface ViewStatus {\n    99\t  tailTokens: number;\n   100\t  threshold: number;\n   101\t  compactRecommended: boolean;\n   102\t  derivation: { pending: number; retrying: number; failed: number; blocked: number };\n   103\t  view: { degraded: number; gaps: number; builtAt: string } | null;\n   104\t  visibility: { zoneTokens: number; maxTokens: number };\n   105\t}\n   106\t\n   107\t// ── receipts (AC-2.7, AC-3.x) ─────────────────────────────────────\n   108\texport interface CompactReceipt {\n   109\t  viewId: string;\n   110\t  profile: string | null;\n   111\t  config: ViewProfile[\"percentages\"] & { lowerBound: number };\n   112\t  bands: Record<Band, { entries: number; tokens: number }>;\n   113\t  tailTokens: number;\n   114\t  coveredFrom: number;\n   115\t  compactPoint: number;\n   116\t  degraded: Array<{ band: Band; subjectId: string; usedForm: string }>;\n   117\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n   118\t  // Story 2 ships the compact with the sweep step ABSENT: the field reports\n   119\t  // the honest literal \"absent\" — never a fake empty SweepReceipt. Story 3\n   120\t  // adds the embedded sweep and flips this to SweepReceipt | { skipped: true }\n   121\t  // (cross-story debt, stated: stories/02-smart-compact.md §Scope out).\n   122\t  sweep: SweepReceipt | { skipped: true } | \"absent\";\n   123\t}\n   124\t\n   125\texport interface SweepReceipt {\n   126\t  owners: Array<{\n   127\t    owner: \"messages\" | \"turns\";\n   128\t    kind: string;\n   129\t    ready: number;\n   130\t    inFlight: number;\n   131\t    requeued: string[]; // subject ids\n   132\t    blocked: Array<{ subjectId: string; reason: string }>;\n   133\t    permanentFailed: Array<{ subjectId: string; reason: string }>;\n   134\t  }>;\n   135\t}\n","exit_code":0,"status":"completed"}}

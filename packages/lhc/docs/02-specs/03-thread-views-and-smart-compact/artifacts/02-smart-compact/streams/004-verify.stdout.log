{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/view-select-golden.test.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Epic 03 Story 2: selection goldens G1–G4 (architecture-risk). Exact\n     2\t// arrangements against committed JSON (test/goldens/) — the only guard that\n     3\t// catches tie-breaker drift (≤ vs <, newest-first ordering, newest-member\n     4\t// chunk coverage) that replay-on-the-same-engine cannot. Each case runs a\n     5\t// REAL compact through the SDK surface and compares the stored arrangement,\n     6\t// compact point, covered_from, and gaps verbatim against the golden.\n     7\t//\n     8\t// Goldens are immutable once committed: an implementation that disagrees\n     9\t// with one is wrong until the design rule is shown wrong (deviation process,\n    10\t// never a golden edit). Regeneration instructions: test/goldens/README.md\n    11\t// (GOLDEN_DUMP=1 prints actuals).\n    12\timport { readFileSync } from \"node:fs\";\n    13\timport { join } from \"node:path\";\n    14\timport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\n    15\timport type { Lhc } from \"../src/index.js\";\n    16\timport {\n    17\t  derivedThreadFixture,\n    18\t  openRaw,\n    19\t  stragglerVariantThread,\n    20\t  tempStore,\n    21\t  type DerivedThreadFixture,\n    22\t  type TempStore,\n    23\t} from \"./fixtures/index.js\";\n    24\t\n    25\tinterface Golden {\n    26\t  case: string;\n    27\t  fixture: \"derived-thread\" | \"straggler-variant\";\n    28\t  params: {\n    29\t    lowerBound: number;\n    30\t    percentages: { full: number; smooth: number; detailed: number; brief: number };\n    31\t  };\n    32\t  compactPoint: number;\n    33\t  coveredFrom: number;\n    34\t  arrangement: Array<{\n    35\t    band: string;\n    36\t    subjectKind: string;\n    37\t    subjectId: string;\n    38\t    formUsed: string;\n    39\t    degraded: boolean;\n    40\t  }>;\n    41\t  gaps: Array<{ band: string; subjectId: string; reason: string }>;\n    42\t}\n    43\t\n    44\tfunction loadGolden(name: string): Golden {\n    45\t  return JSON.parse(\n    46\t    readFileSync(join(import.meta.dirname, \"goldens\", name), \"utf8\"),\n    47\t  ) as Golden;\n    48\t}\n    49\t\n    50\tinterface StoredView {\n    51\t  compactPoint: number;\n    52\t  coveredFrom: number;\n    53\t  arrangement: Golden[\"arrangement\"];\n    54\t  gaps: Golden[\"gaps\"];\n    55\t}\n    56\t\n    57\tfunction readStoredView(filePath: string): StoredView {\n    58\t  const db = openRaw(filePath);\n    59\t  try {\n    60\t    const row = db\n    61\t      .prepare(\n    62\t        `SELECT compact_point, covered_from, arrangement_json, gaps_json\n    63\t         FROM thread_view WHERE singleton = 1`,\n    64\t      )\n    65\t      .get() as\n    66\t      | {\n    67\t          compact_point: number | bigint;\n    68\t          covered_from: number | bigint;\n    69\t          arrangement_json: string;\n    70\t          gaps_json: string;\n    71\t        }\n    72\t      | undefined;\n    73\t    if (row === undefined) throw new Error(\"no view row after compact\");\n    74\t    return {\n    75\t      compactPoint: Number(row.compact_point),\n    76\t      coveredFrom: Number(row.covered_from),\n    77\t      arrangement: JSON.parse(row.arrangement_json) as Golden[\"arrangement\"],\n    78\t      gaps: JSON.parse(row.gaps_json) as Golden[\"gaps\"],\n    79\t    };\n    80\t  } finally {\n    81\t    db.close();\n    82\t  }\n    83\t}\n    84\t\n    85\tlet store: TempStore;\n    86\tlet fixture: DerivedThreadFixture;\n    87\tlet straggler: DerivedThreadFixture;\n    88\t\n    89\tbeforeAll(async () => {\n    90\t  store = tempStore();\n    91\t  fixture = await derivedThreadFixture(store);\n    92\t  straggler = await stragglerVariantThread(store);\n    93\t});\n    94\tafterAll(() => {\n    95\t  store.cleanup();\n    96\t});\n    97\t\n    98\tasync function runGolden(golden: Golden): Promise<StoredView> {\n    99\t  const target = golden.fixture === \"straggler-variant\" ? straggler : fixture;\n   100\t  const receipt = await target.sdk.threadView.compact(\n   101\t    { filePath: target.filePath },\n   102\t    { params: golden.params },\n   103\t  );\n   104\t  expect(receipt.ok).toBe(true);\n   105\t  if (!receipt.ok) throw new Error(receipt.error.reason);\n   106\t  const stored = readStoredView(target.filePath);\n   107\t  if (process.env[\"GOLDEN_DUMP\"] === \"1\") {\n   108\t    console.log(`${golden.case}\\n${JSON.stringify(stored, null, 2)}`);\n   109\t  }\n   110\t  // Receipt and stored row agree (one selection, two reports).\n   111\t  expect(receipt.value.compactPoint).toBe(stored.compactPoint);\n   112\t  expect(receipt.value.coveredFrom).toBe(stored.coveredFrom);\n   113\t  return stored;\n   114\t}\n   115\t\n   116\tfunction expectMatches(stored: StoredView, golden: Golden): void {\n   117\t  expect(stored.compactPoint).toBe(golden.compactPoint);\n   118\t  expect(stored.coveredFrom).toBe(golden.coveredFrom);\n   119\t  expect(stored.arrangement).toEqual(golden.arrangement);\n   120\t  expect(stored.gaps).toEqual(golden.gaps);\n   121\t}\n   122\t\n   123\tdescribe(\"selection goldens G1–G4 (committed JSON, exact arrangements)\", () => {\n   124\t  it(\"G1 proportions: shares fill the full gradient as committed\", async () => {\n   125\t    const golden = loadGolden(\"g1-proportions.json\");\n   126\t    expectMatches(await runGolden(golden), golden);\n   127\t  });\n   128\t\n   129\t  it(\"G2a budget edge: a turn exactly filling the smooth remainder is included (≤ rule)\", async () => {\n   130\t    const golden = loadGolden(\"g2-edge-inclusion.json\");\n   131\t    expectMatches(await runGolden(golden), golden);\n   132\t  });\n   133\t\n   134\t  it(\"G2b budget edge: one token under the exact fill excludes the turn and stops the band\", async () => {\n   135\t    const golden = loadGolden(\"g2-edge-exclusion.json\");\n   136\t    expectMatches(await runGolden(golden), golden);\n   137\t  });\n   138\t\n   139\t  it(\"G3 oversized loner: a single turn larger than the whole smooth budget represents alone\", async () => {\n   140\t    const golden = loadGolden(\"g3-oversized-loner.json\");\n   141\t    const stored = await runGolden(golden);\n   142\t    expectMatches(stored, golden);\n   143\t    // The loner condition itself: exactly one smooth entry, and the smooth\n   144\t    // budget (250 × 4% = 10) is smaller than any turn entry could render.\n   145\t    expect(stored.arrangement.filter((entry) => entry.band === \"smooth\")).toHaveLength(1);\n   146\t  });\n   147\t\n   148\t  it(\"G4 turnless straggler: the note rides the following turn's band entry; the trailing note is tail\", async () => {\n   149\t    const golden = loadGolden(\"g4-turnless-straggler.json\");\n   150\t    const stored = await runGolden(golden);\n   151\t    expectMatches(stored, golden);\n   152\t\n   153\t    // Rule 6's rendering halves, beyond the arrangement: the between-turns\n   154\t    // note renders raw with its marker immediately before c2's entry (t4's\n   155\t    // representation), and the trailing note pulls as tail.\n   156\t    const pulled = await (straggler.sdk as Lhc).threadView.pull({\n   157\t      filePath: straggler.filePath,\n   158\t    });\n   159\t    expect(pulled.ok).toBe(true);\n   160\t    if (!pulled.ok) return;\n   161\t    const detailedBand = pulled.value.messages.find((message) => message.band === \"detailed\");\n   162\t    expect(detailedBand?.content).toMatch(\n   163\t      /\\[inter-turn note\\] harness restarted between turns \\(fixture straggler\\)\\n§c2/,\n   164\t    );\n   165\t    const tail = pulled.value.messages.filter((message) => message.band === undefined);\n   166\t    expect(\n   167\t      tail.some(\n   168\t        (message) =>\n   169\t          message.content ===\n   170\t          \"[runtime note] session closing note after the last turn (fixture straggler)\",\n   171\t      ),\n   172\t    ).toBe(true);\n   173\t    // The note appears once: banded with c2, not duplicated into the tail.\n   174\t    expect(\n   175\t      tail.some((message) => message.content.includes(\"harness restarted between turns\")),\n   176\t    ).toBe(false);\n   177\t  });\n   178\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/view-thread.ts | sed -n '1,320p'\"","aggregated_output":"     1\t// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\n     2\t// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\n     3\t// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\n     4\t// deterministic provider double into known form states. States are reached\n     5\t// through production paths, never hand-written rows (the anti-shim line\n     6\t// FC-0.3 enforces): the failed states come from scripted provider failures\n     7\t// consumed by the real retry/exhaustion mechanics, and blocked comes from\n     8\t// real source damage on a sacrificial sibling thread. Every later Epic 03\n     9\t// story compacts against what this builder returns.\n    10\timport {\n    11\t  createSdk,\n    12\t  type FormReportEntry,\n    13\t  type Lhc,\n    14\t  type MessageEventInput,\n    15\t} from \"../../src/index.js\";\n    16\timport { corruptTwoOpenTurns } from \"./corrupt.js\";\n    17\timport { createProviderDouble, type ProviderDouble } from \"./provider-double.js\";\n    18\timport { readChunks, type ChunkSnapshot } from \"./threads.js\";\n    19\timport { validEvent, type TempStore } from \"./index.js\";\n    20\t\n    21\t// Reason classes the scripted failures stamp, chosen from the sweep\n    22\t// classification table's vocabulary (tech design §Spec Validation): a\n    23\t// rate-limit class reads transient, a content-refusal class reads permanent —\n    24\t// FC-0.4's distinguishable-on-read-back guarantee, proven here before\n    25\t// Story 3 depends on it.\n    26\texport const TRANSIENT_EXHAUST_REASON =\n    27\t  \"rate_limit: scripted transient exhaustion (fixture)\";\n    28\texport const PERMANENT_FAILURE_REASON =\n    29\t  \"content_refusal: scripted permanent failure (fixture)\";\n    30\t\n    31\t// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\n    32\t// (3 members each; c1–c3 closed, c4 still open). Projections from the\n    33\t// deterministic double are near-constant in size (`projection(<digest>:<40\n    34\t// chars>)`), so the cut is stable; the builder asserts the shape and throws\n    35\t// if drift ever moves it.\n    36\tconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\n    37\t\n    38\tconst TURN_COUNT = 12;\n    39\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n    40\t\n    41\tfunction turnEvents(turn: number): MessageEventInput[] {\n    42\t  const events: MessageEventInput[] = [\n    43\t    validEvent(\"user_prompt\", {\n    44\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n    45\t    }),\n    46\t    validEvent(\"assistant_thinking\", {\n    47\t      payload: { text: `considering what area ${turn} contains` },\n    48\t    }),\n    49\t  ];\n    50\t  if (TOOL_HEAVY_TURNS.has(turn)) {\n    51\t    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\n    52\t    // realistic over-max zone of tool results to age behind the boundary.\n    53\t    for (const run of [1, 2]) {\n    54\t      const toolCallId = `call-fx-${turn}-${run}`;\n    55\t      events.push(\n    56\t        validEvent(\"tool_call\", {\n    57\t          payload: {\n    58\t            toolCallId,\n    59\t            toolName: \"read_file\",\n    60\t            arguments: { path: `area-${turn}/file-${run}.txt` },\n    61\t          },\n    62\t        }),\n    63\t        validEvent(\"tool_result\", {\n    64\t          payload: {\n    65\t            toolCallId,\n    66\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n    67\t            isError: false,\n    68\t          },\n    69\t        }),\n    70\t      );\n    71\t    }\n    72\t  }\n    73\t  events.push(\n    74\t    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n    75\t    validEvent(\"turn_end\"),\n    76\t  );\n    77\t  return events;\n    78\t}\n    79\t\n    80\texport interface DerivedThreadFixture {\n    81\t  filePath: string;\n    82\t  sdk: Lhc;\n    83\t  double: ProviderDouble;\n    84\t  turnIds: string[]; // t1..t12\n    85\t  chunks: ChunkSnapshot;\n    86\t  // The two manufactured failed subjects (tool_result_summary forms), reached\n    87\t  // through real retry exhaustion / terminal failure — absent when failures\n    88\t  // are disabled for a variant.\n    89\t  failedTransientMessageId?: string;\n    90\t  failedPermanentMessageId?: string;\n    91\t  // The straggler variant's turnId-null messages: one between two turns, one\n    92\t  // after the last turn — absent unless stragglers are enabled.\n    93\t  stragglerBetweenMessageId?: string;\n    94\t  stragglerTrailingMessageId?: string;\n    95\t}\n    96\t\n    97\texport interface DerivedThreadOptions {\n    98\t  failures?: boolean; // default true: manufacture the two failed states\n    99\t  stragglers?: boolean; // default false: insert the turnless runtime notes\n   100\t}\n   101\t\n   102\tasync function send(\n   103\t  sdk: Lhc,\n   104\t  filePath: string,\n   105\t  batch: readonly MessageEventInput[],\n   106\t): Promise<string[]> {\n   107\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n   108\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n   109\t  return result.value.events.map((entry) => entry.messageId ?? \"\");\n   110\t}\n   111\t\n   112\tasync function drain(sdk: Lhc, filePath: string): Promise<void> {\n   113\t  const report = await sdk.work.drain({ filePath });\n   114\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n   115\t  if (report.value.stoppedBecause !== \"empty\" || report.value.remaining !== 0) {\n   116\t    throw new Error(\n   117\t      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\n   118\t    );\n   119\t  }\n   120\t}\n   121\t\n   122\tfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\n   123\t  return entries.filter((entry) => entry.state === \"failed\" && entry.reason === reason);\n   124\t}\n   125\t\n   126\texport async function derivedThreadFixture(\n   127\t  store: TempStore,\n   128\t  opts: DerivedThreadOptions = {},\n   129\t): Promise<DerivedThreadFixture> {\n   130\t  const failures = opts.failures ?? true;\n   131\t  const stragglers = opts.stragglers ?? false;\n   132\t\n   133\t  const double = createProviderDouble();\n   134\t  const sdk = createSdk({\n   135\t    provider: double,\n   136\t    mode: \"manual\",\n   137\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n   138\t    chunkPolicy: FIXTURE_CHUNK_POLICY,\n   139\t  });\n   140\t\n   141\t  const filePath = store.threadPath();\n   142\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   143\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n   144\t\n   145\t  const turnIds: string[] = [];\n   146\t  const fixture: DerivedThreadFixture = {\n   147\t    filePath,\n   148\t    sdk,\n   149\t    double,\n   150\t    turnIds,\n   151\t    chunks: { chunks: [], members: [] },\n   152\t  };\n   153\t\n   154\t  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\n   155\t    if (failures && turn === 6) {\n   156\t      // Retryable failures consumed to exhaustion by the head-first drain:\n   157\t      // the first tool_result_summary item of this batch takes all three\n   158\t      // attempts and lands failed with the transient reason class.\n   159\t      double.failKind(\"tool_result_summary\", 3, {\n   160\t        retryable: true,\n   161\t        reason: TRANSIENT_EXHAUST_REASON,\n   162\t      });\n   163\t    }\n   164\t    if (failures && turn === 7) {\n   165\t      // One non-retryable failure: terminal on the first attempt — the\n   166\t      // permanent reason class, attempts 1.\n   167\t      double.failKind(\"tool_result_summary\", 1, {\n   168\t        retryable: false,\n   169\t        reason: PERMANENT_FAILURE_REASON,\n   170\t      });\n   171\t    }\n   172\t    const messageIds = await send(sdk, filePath, turnEvents(turn));\n   173\t    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\n   174\t    // result, call, result, text, end — index 3 is the first tool result,\n   175\t    // the scripted failures' subject.\n   176\t    const firstToolResultId = messageIds[3];\n   177\t    if (failures && (turn === 6 || turn === 7)) {\n   178\t      if (firstToolResultId === undefined || firstToolResultId === \"\") {\n   179\t        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\n   180\t      }\n   181\t      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\n   182\t      else fixture.failedPermanentMessageId = firstToolResultId;\n   183\t    }\n   184\t    await drain(sdk, filePath);\n   185\t\n   186\t    if (stragglers && turn === 3) {\n   187\t      // A runtime note between turn 3's end and turn 4's prompt: projected\n   188\t      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\n   189\t      const noteIds = await send(sdk, filePath, [\n   190\t        validEvent(\"runtime_note\", {\n   191\t          payload: { text: \"harness restarted between turns (fixture straggler)\" },\n   192\t        }),\n   193\t      ]);\n   194\t      const noteId = noteIds[0];\n   195\t      if (noteId === undefined || noteId === \"\") {\n   196\t        throw new Error(\"fixture invariant: between-turns straggler did not project\");\n   197\t      }\n   198\t      fixture.stragglerBetweenMessageId = noteId;\n   199\t    }\n   200\t    turnIds.push(`t${turn}`);\n   201\t  }\n   202\t\n   203\t  if (stragglers) {\n   204\t    const noteIds = await send(sdk, filePath, [\n   205\t      validEvent(\"runtime_note\", {\n   206\t        payload: { text: \"session closing note after the last turn (fixture straggler)\" },\n   207\t      }),\n   208\t    ]);\n   209\t    const noteId = noteIds[0];\n   210\t    if (noteId === undefined || noteId === \"\") {\n   211\t      throw new Error(\"fixture invariant: trailing straggler did not project\");\n   212\t    }\n   213\t    fixture.stragglerTrailingMessageId = noteId;\n   214\t    await drain(sdk, filePath);\n   215\t  }\n   216\t\n   217\t  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\n   218\t  // chunks, the first three closed. A failure here means the deterministic\n   219\t  // substrate moved (provider output or tokenizer), not a flaky test.\n   220\t  fixture.chunks = readChunks(filePath);\n   221\t  if (fixture.chunks.chunks.length !== 4) {\n   222\t    throw new Error(\n   223\t      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\n   224\t    );\n   225\t  }\n   226\t  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \"closed\").length;\n   227\t  if (closed !== 3) {\n   228\t    throw new Error(\n   229\t      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\n   230\t    );\n   231\t  }\n   232\t\n   233\t  if (failures) {\n   234\t    // Verify the manufactured states by read-back through the owning report\n   235\t    // surface before handing the fixture to any test (FC-0.3's enforcement\n   236\t    // lives in the tests; this guards the builder's own contract).\n   237\t    const report = await sdk.messages.report({ filePath });\n   238\t    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\n   239\t    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\n   240\t    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\n   241\t    if (\n   242\t      transient.length !== 1 ||\n   243\t      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\n   244\t      permanent.length !== 1 ||\n   245\t      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\n   246\t    ) {\n   247\t      throw new Error(\n   248\t        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\n   249\t      );\n   250\t    }\n   251\t  }\n   252\t\n   253\t  return fixture;\n   254\t}\n   255\t\n   256\t// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\n   257\t// conversation with a runtime note between two turns and one after the last\n   258\t// turn, fully drained, no manufactured failures.\n   259\texport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\n   260\t  return derivedThreadFixture(store, { failures: false, stragglers: true });\n   261\t}\n   262\t\n   263\t// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\n   264\t// short real conversation, drained clean, then damaged below the SDK into\n   265\t// the two-open-turns state no public operation can produce. Canonical\n   266\t// consumers refuse it with state_corruption.\n   267\texport async function corruptedVariantThread(\n   268\t  store: TempStore,\n   269\t): Promise<{ filePath: string; sdk: Lhc }> {\n   270\t  const double = createProviderDouble();\n   271\t  const sdk = createSdk({ provider: double, mode: \"manual\" });\n   272\t  const filePath = store.threadPath();\n   273\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   274\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n   275\t  for (let turn = 1; turn <= 3; turn += 1) {\n   276\t    await send(sdk, filePath, turnEvents(turn));\n   277\t  }\n   278\t  await drain(sdk, filePath);\n   279\t  // Open a turn through real intake, then add a second open row: two open\n   280\t  // turns, the Epic 01 invariant violation.\n   281\t  await send(sdk, filePath, [\n   282\t    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n   283\t  ]);\n   284\t  corruptTwoOpenTurns(filePath);\n   285\t  return { filePath, sdk };\n   286\t}\n   287\t\n   288\t// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\n   289\t// queued derivation meets real source damage at drain time — the handler\n   290\t// finds two open turns and lands the turn forms blocked through the\n   291\t// production terminal path, never a hand-written row.\n   292\texport async function blockedSiblingThread(\n   293\t  store: TempStore,\n   294\t): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\n   295\t  const double = createProviderDouble();\n   296\t  const sdk = createSdk({ provider: double, mode: \"manual\" });\n   297\t  const filePath = store.threadPath();\n   298\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   299\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n   300\t  // Turn 1 closes (its turn_derivation queues); a second turn opens through\n   301\t  // real intake; the corruption writer adds another open row. The drain then\n   302\t  // claims t1's derivation against a record with two open turns.\n   303\t  await send(sdk, filePath, turnEvents(1));\n   304\t  await send(sdk, filePath, [\n   305\t    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n   306\t  ]);\n   307\t  corruptTwoOpenTurns(filePath);\n   308\t  const report = await sdk.work.drain({ filePath });\n   309\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n   310\t  const blocked = report.value.ran.find(\n   311\t    (entry) => entry.kind === \"turn_derivation\" && entry.disposition === \"failed_terminal\",\n   312\t  );\n   313\t  if (blocked === undefined) {\n   314\t    throw new Error(\"fixture invariant: turn_derivation expected to land terminal on damage\");\n   315\t  }\n   316\t  return { filePath, sdk, blockedTurnId: \"t1\" };\n   317\t}\n","exit_code":0,"status":"completed"}}

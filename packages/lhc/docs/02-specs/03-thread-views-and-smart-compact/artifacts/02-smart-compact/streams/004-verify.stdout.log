{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/internal/snapshot.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// The pull's read path (Story 1): the stored view snapshot — header plus\n     2\t// band rows, absent ⇒ tail-only signal — and the record reads the tail\n     3\t// assembly needs (live messages after the compact point, their ready\n     4\t// tool-result summaries, the tail token sum). Story 2 adds the one writer:\n     5\t// the atomic replace at compact. Direct record/derived_form reads are\n     6\t// sanctioned for thread-view internals (tech design §System View — the\n     7\t// surface-import rule governs code imports, not SQL); what must NOT read\n     8\t// derived_form directly is the status's derivation counting, which goes\n     9\t// through the owners' report surfaces in index.ts.\n    10\timport type { DatabaseSync } from \"node:sqlite\";\n    11\timport type { Band } from \"../../../shared/view.js\";\n    12\timport type { RenderingPartKind } from \"../../../shared/derivation.js\";\n    13\t\n    14\t// ── view snapshot (header + bands) ────────────────────────────────\n    15\t\n    16\texport interface ViewSnapshot {\n    17\t  viewId: string;\n    18\t  createdAt: string;\n    19\t  compactPoint: number;\n    20\t  coveredFrom: number;\n    21\t  gapCount: number;\n    22\t  degradedCount: number;\n    23\t  // Non-empty bands in gradient order (brief → detailed → smooth), the order\n    24\t  // the pull prepends them in.\n    25\t  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\n    26\t}\n    27\t\n    28\tinterface RawViewRow {\n    29\t  view_id: string;\n    30\t  created_at: string;\n    31\t  compact_point: number | bigint;\n    32\t  covered_from: number | bigint;\n    33\t  arrangement_json: string;\n    34\t  gaps_json: string;\n    35\t}\n    36\t\n    37\tconst BAND_GRADIENT_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n    38\t\n    39\t// null ⇒ no view exists (never compacted): the whole record renders as tail\n    40\t// from event 1 through the same pull code path — snapshot-absent, not a\n    41\t// separate branch (story Anti-Shim Requirements).\n    42\texport function readViewSnapshot(db: DatabaseSync): ViewSnapshot | null {\n    43\t  const header = db\n    44\t    .prepare(\n    45\t      `SELECT view_id, created_at, compact_point, covered_from, arrangement_json, gaps_json\n    46\t       FROM thread_view WHERE singleton = 1`,\n    47\t    )\n    48\t    .get() as RawViewRow | undefined;\n    49\t  if (header === undefined) return null;\n    50\t\n    51\t  const arrangement = JSON.parse(header.arrangement_json) as Array<{ degraded?: boolean }>;\n    52\t  const gaps = JSON.parse(header.gaps_json) as unknown[];\n    53\t  const bandRows = db\n    54\t    .prepare(\n    55\t      `SELECT band, rendered_text, token_count FROM thread_view_band WHERE view_id = ?`,\n    56\t    )\n    57\t    .all(header.view_id) as unknown as Array<{\n    58\t    band: string;\n    59\t    rendered_text: string;\n    60\t    token_count: number | bigint;\n    61\t  }>;\n    62\t  const byBand = new Map(bandRows.map((row) => [row.band, row]));\n    63\t\n    64\t  return {\n    65\t    viewId: header.view_id,\n    66\t    createdAt: header.created_at,\n    67\t    compactPoint: Number(header.compact_point),\n    68\t    coveredFrom: Number(header.covered_from),\n    69\t    gapCount: gaps.length,\n    70\t    degradedCount: arrangement.filter((entry) => entry.degraded === true).length,\n    71\t    bands: BAND_GRADIENT_ORDER.flatMap((band) => {\n    72\t      const row = byBand.get(band);\n    73\t      return row === undefined\n    74\t        ? []\n    75\t        : [{ band, renderedText: row.rendered_text, tokenCount: Number(row.token_count) }];\n    76\t    }),\n    77\t  };\n    78\t}\n    79\t\n    80\t// ── tail record reads ─────────────────────────────────────────────\n    81\t\n    82\texport interface TailMessageRow {\n    83\t  messageId: string;\n    84\t  sourceEventOrder: number;\n    85\t  kind: RenderingPartKind;\n    86\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n    87\t}\n    88\t\n    89\t// Live messages after the compact point in record order, with their projected\n    90\t// blocks — the deleted-read filter applied here so a deleted message never\n    91\t// reaches rendering (AC-1.x delete filtering).\n    92\texport function readTailMessages(db: DatabaseSync, compactPoint: number): TailMessageRow[] {\n    93\t  const messageRows = db\n    94\t    .prepare(\n    95\t      `SELECT message_id, source_event_order, kind FROM message\n    96\t       WHERE deleted_at IS NULL AND source_event_order > ?\n    97\t       ORDER BY source_event_order`,\n    98\t    )\n    99\t    .all(compactPoint) as unknown as Array<{\n   100\t    message_id: string;\n   101\t    source_event_order: number | bigint;\n   102\t    kind: string;\n   103\t  }>;\n   104\t  const blockRows = db\n   105\t    .prepare(\n   106\t      `SELECT mb.message_id, mb.block_type, mb.content\n   107\t       FROM message_block mb JOIN message m ON m.message_id = mb.message_id\n   108\t       WHERE m.deleted_at IS NULL AND m.source_event_order > ?\n   109\t       ORDER BY m.source_event_order, mb.block_index`,\n   110\t    )\n   111\t    .all(compactPoint) as unknown as Array<{\n   112\t    message_id: string;\n   113\t    block_type: string;\n   114\t    content: string;\n   115\t  }>;\n   116\t  const blocksByMessage = new Map<string, TailMessageRow[\"blocks\"]>();\n   117\t  for (const row of blockRows) {\n   118\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n   119\t    blocks.push({\n   120\t      blockType: row.block_type,\n   121\t      content: JSON.parse(row.content) as Record<string, unknown>,\n   122\t    });\n   123\t    blocksByMessage.set(row.message_id, blocks);\n   124\t  }\n   125\t  return messageRows.map((row) => ({\n   126\t    messageId: row.message_id,\n   127\t    sourceEventOrder: Number(row.source_event_order),\n   128\t    kind: row.kind as RenderingPartKind,\n   129\t    blocks: blocksByMessage.get(row.message_id) ?? [],\n   130\t  }));\n   131\t}\n   132\t\n   133\t// The tail's token sum for status (AC-2.8): every live message after the\n   134\t// compact point, all kinds — the same population the pull renders as tail.\n   135\texport function tailTokenSum(db: DatabaseSync, compactPoint: number): number {\n   136\t  const row = db\n   137\t    .prepare(\n   138\t      `SELECT COALESCE(SUM(token_estimate), 0) AS total FROM message\n   139\t       WHERE deleted_at IS NULL AND source_event_order > ?`,\n   140\t    )\n   141\t    .get(compactPoint) as { total: number | bigint };\n   142\t  return Number(row.total);\n   143\t}\n   144\t\n   145\t// ── the atomic replace (Story 2, AC-2.6) ──────────────────────────\n   146\t\n   147\texport interface ViewReplaceInput {\n   148\t  viewId: string;\n   149\t  createdAt: string;\n   150\t  compactPoint: number;\n   151\t  coveredFrom: number;\n   152\t  profileName: string | null;\n   153\t  configJson: string;\n   154\t  arrangementJson: string;\n   155\t  gapsJson: string;\n   156\t  sourceStateJson: string;\n   157\t  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\n   158\t}\n   159\t\n   160\t// Compact's one transaction: delete the singleton view row (the FK cascade\n   161\t// drops its bands), insert the new header and bands, and reset the boundary\n   162\t// to the compact point (AC-4.7) — all inside one BEGIN IMMEDIATE, so a crash\n   163\t// anywhere rolls the whole replace back and the previous view keeps serving\n   164\t// (AC-2.6, TC-2.4). Compact is the only writer of these rows; the boundary's\n   165\t// other writer is Story 4's advance.\n   166\texport function replaceViewSnapshot(db: DatabaseSync, input: ViewReplaceInput): void {\n   167\t  db.exec(\"BEGIN IMMEDIATE;\");\n   168\t  try {\n   169\t    db.prepare(`DELETE FROM thread_view WHERE singleton = 1`).run();\n   170\t    db.prepare(\n   171\t      `INSERT INTO thread_view (singleton, view_id, created_at, compact_point, covered_from,\n   172\t         profile_name, config_json, arrangement_json, gaps_json, source_state_json)\n   173\t       VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n   174\t    ).run(\n   175\t      input.viewId,\n   176\t      input.createdAt,\n   177\t      input.compactPoint,\n   178\t      input.coveredFrom,\n   179\t      input.profileName,\n   180\t      input.configJson,\n   181\t      input.arrangementJson,\n   182\t      input.gapsJson,\n   183\t      input.sourceStateJson,\n   184\t    );\n   185\t    const insertBand = db.prepare(\n   186\t      `INSERT INTO thread_view_band (view_id, band, rendered_text, token_count)\n   187\t       VALUES (?, ?, ?, ?)`,\n   188\t    );\n   189\t    for (const band of input.bands) {\n   190\t      insertBand.run(input.viewId, band.band, band.renderedText, band.tokenCount);\n   191\t    }\n   192\t    db.prepare(\n   193\t      `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\n   194\t    ).run(input.compactPoint, input.createdAt);\n   195\t    db.exec(\"COMMIT;\");\n   196\t  } catch (cause) {\n   197\t    db.exec(\"ROLLBACK;\");\n   198\t    throw cause;\n   199\t  }\n   200\t}\n   201\t\n   202\t// Ready tool-result summaries by message id — the short-form ladder's first\n   203\t// rung. Stored state read verbatim, never derived here (no-inference rule).\n   204\texport function readReadyToolResultSummaries(db: DatabaseSync): Map<string, string> {\n   205\t  const rows = db\n   206\t    .prepare(\n   207\t      `SELECT subject_id, content FROM derived_form\n   208\t       WHERE subject_kind = 'message' AND form = 'tool_result_summary'\n   209\t         AND state = 'ready' AND content IS NOT NULL`,\n   210\t    )\n   211\t    .all() as unknown as Array<{ subject_id: string; content: string }>;\n   212\t  return new Map(rows.map((row) => [row.subject_id, row.content]));\n   213\t}\n","exit_code":0,"status":"completed"}}

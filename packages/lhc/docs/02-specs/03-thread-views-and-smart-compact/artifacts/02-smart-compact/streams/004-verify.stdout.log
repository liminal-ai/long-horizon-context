th, \"t1\", \"turn_rendering\");\npackages/lhc/test/derivation-turns.test.ts:182:    expect(rendering).toMatchObject({\npackages/lhc/test/derivation-turns.test.ts:185:      content: renderingText,\npackages/lhc/test/derivation-turns.test.ts:188:    expect(rendering?.gaps).toBeUndefined();\npackages/lhc/test/derivation-turns.test.ts:192:      content: deterministicText(\"projectLowerBand\", { rendering: renderingText }, renderingText),\npackages/lhc/test/derivation-turns.test.ts:199:describe(\"TC-3.2 / AC-3.2: a non-ready message form falls back and records a gap; the rendering still lands ready\", () => {\npackages/lhc/test/derivation-turns.test.ts:200:  it(\"failed smoothing → rendering ready with the raw prompt text and a gap naming message and form\", async () => {\npackages/lhc/test/derivation-turns.test.ts:213:    // Message-form gaps degrade the rendering's inputs; they do not fail\npackages/lhc/test/derivation-turns.test.ts:214:    // the turn: ready, raw text composed, the gap a recorded fact.\npackages/lhc/test/derivation-turns.test.ts:215:    const rendering = formOf(filePath, \"t1\", \"turn_rendering\");\npackages/lhc/test/derivation-turns.test.ts:216:    expect(rendering?.state).toBe(\"ready\");\npackages/lhc/test/derivation-turns.test.ts:217:    expect(rendering?.content).toContain(\"raw prompt one\");\npackages/lhc/test/derivation-turns.test.ts:218:    expect(rendering?.gaps).toEqual([\npackages/lhc/test/derivation-turns.test.ts:226:describe(\"TC-3.3 / AC-3.3 (architecture risk): gaps stand after dependency repair; only an explicit rebuild clears them\", () => {\npackages/lhc/test/derivation-turns.test.ts:227:  it(\"repairing the smoothing changes nothing; re-queueing the rendering rebuilds it without the gap at the next source version\", async () => {\npackages/lhc/test/derivation-turns.test.ts:232:    await sendTurn(sdk, filePath, \"gapped prompt\", \"gapped answer\");\npackages/lhc/test/derivation-turns.test.ts:234:    const gapped = formOf(filePath, \"t1\", \"turn_rendering\");\npackages/lhc/test/derivation-turns.test.ts:235:    expect(gapped?.state).toBe(\"ready\");\npackages/lhc/test/derivation-turns.test.ts:236:    expect(gapped?.gaps).toEqual([\npackages/lhc/test/derivation-turns.test.ts:255:    // Byte-for-byte: the gapped rendering is exactly the row that landed —\npackages/lhc/test/derivation-turns.test.ts:256:    // content, gaps, derivedAt, source version, all of it.\npackages/lhc/test/derivation-turns.test.ts:257:    expect(formOf(filePath, \"t1\", \"turn_rendering\")).toEqual(gapped);\npackages/lhc/test/derivation-turns.test.ts:262:    // dependency states: the smoothing is ready now, so the gap clears.\npackages/lhc/test/derivation-turns.test.ts:269:        { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\npackages/lhc/test/derivation-turns.test.ts:277:    const rebuilt = formOf(filePath, \"t1\", \"turn_rendering\");\npackages/lhc/test/derivation-turns.test.ts:280:    expect(rebuilt?.gaps).toBeUndefined();\npackages/lhc/test/derivation-turns.test.ts:281:    expect(rebuilt?.content).not.toBe(gapped?.content);\npackages/lhc/test/derivation-turns.test.ts:312:    expect(formOf(filePath, \"t1\", \"turn_rendering\")?.state).toBe(\"ready\");\npackages/lhc/test/derivation-turns.test.ts:563:    const receipts = formOf(filePath, \"t1\", \"turn_rendering\")?.metadata?.receipts;\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:4:You are the story lead for `02-smart-compact` on durable story run `02-smart-compact-story-run-001`.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:19:Path: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/stories/02-smart-compact.md\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:22:# Story 2: Smart Compact\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:26:The compact operation: profiles and validation, band arrangement from stored artifacts, degrade ladders and gaps, atomic snapshot replace with boundary reset, receipts; pull serves snapshot + tail.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:31:**User Profile (from epic):** the agentic harness (PI extension first), calling through the SDK on every model call; and the agent/operator running compacts and checking thread health through the CLI.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:33:**Objective:** the view exists. Compact selects, renders, and atomically installs the band snapshot; pull serves it verbatim between compacts.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:36:- `compact(ref, { profile?, params?, sweep? })` per tech design §Flow 2: validate → (sweep step **absent this story** — see scope out) → read record + forms → selection walk (§Deterministic Algorithms, rules 1–6 including turnless stragglers) → band rendering (degrade ladders, gap entries, subject keys, `[inter-turn note]` markers) → one `BEGIN IMMEDIATE` transaction (delete view row cascade, insert header + bands, boundary ← compact point) → `CompactReceipt`\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:37:- Canonical-corruption refusal (`state_corruption`, pre-transaction, prior view untouched)\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:38:- Coverage edge: `covered_from`, receipt reports out-of-window history\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:40:- Status upgraded: view-health fields live (degraded count, gap count, built-at)\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:43:**Scope out:** the sweep — compact ships with the sweep step absent; the receipt's sweep section reports `absent`. Story 3 adds the embedded sweep and flips the receipt to `SweepReceipt | { skipped: true }`. Same pattern as Epic 01's Story 4→5 queue seam: the gap is a stated cross-story debt, not a shim — nothing fakes a sweep, nothing stubs one.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:50:- **AC-2.1**: Compact runs only when invoked through the surface (SDK or CLI). No code path in core invokes it internally.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:51:- **AC-2.2**: The operation accepts a named profile or explicit parameters; explicit parameters override profile values; built-in profiles exist and user-defined profiles are configurable.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:52:- **AC-2.3**: Invalid configuration (band percentages not summing to 100, unknown profile, non-positive bound) is rejected with a caller error naming the violation; thread state is unchanged.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:53:  - **TC-2.1** (AC-2.2, AC-2.3, AC-2.7): Compact with a built-in profile → succeeds with that profile's bound and mix recorded in the receipt; compact with percentages summing to 105 → caller error naming the sum; unknown profile → caller error naming it; thread unchanged after both rejections.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:54:- **AC-2.4**: A compacted view targets the configured lower bound: band shares are computed from its percentages, each band fills by whole entries against its share, and the receipt reports actual per-band and total token counts. The total may land below the bound (insufficient stored material, or the next whole entry would exceed a band's share) or above it (an indivisible turn/chunk/message included by the selection rules). Assembly is entirely from stored artifacts — no provider calls during compact (sweep requeues background work; the compact itself never waits on or invokes inference).\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:55:  - **TC-2.2** (AC-2.4, AC-2.9): On a thread with full derivation coverage, compact → view targets the bound (receipt's actual counts within whole-entry tolerance of band shares, deviations attributable to whole-entry inclusion rules), provider fake observes zero calls during the compact; read the record after → identical to before.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:56:- **AC-2.5**: Missing or unusable band material degrades: the entry renders the best available stored form for its subject and is marked degraded, or renders as an explicit gap entry when nothing usable exists. The compact records every degraded entry and gap on the view and reports them in the receipt. A compact never fails because derived material is missing or failed; it refuses only when canonical source state needed to identify or read the compacted span is corrupt or unreadable, with a structured `state_corruption` error naming the damage, leaving the prior view and the record unchanged.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:57:  - **TC-2.3** (AC-2.5, AC-2.7): On a thread with one failed chunk summary and one pending turn rendering, compact → completes; degraded entries render fallbacks and are marked; receipt lists both with reasons and reports per-band counts; no span silently absent (every turn/chunk in the compacted range accounted for in some form).\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:58:  - **TC-2.7** (AC-2.5): On a fixture thread with manufactured canonical corruption (damaged below the SDK, per the Epic 01 corruption-fixture pattern), compact → refuses with `state_corruption` naming the damage; the prior active view still serves; record unchanged. Control: the same thread with only derived-material damage (failed summaries) compacts successfully with gaps.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:59:- **AC-2.6**: The compact replaces the active view atomically: band arrangement, rendered snapshot, compact point, config used, and gaps land in one transaction; the visibility boundary resets to the compact point in the same transaction. A crash mid-compact leaves the previous view intact and serving.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:60:  - **TC-2.4** (AC-2.6): Crash injection between sweep and view write (test seam) → previous view still serves; rerun compact → new view lands; no partial state.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:61:- **AC-2.7**: The receipt reports what was built: per-band entry counts and rendered sizes, degraded entries and gaps with reasons, sweep results (or that the sweep was skipped), and the config used. *(Sweep section reports `absent` until Story 3 — cross-story debt, stated.)*\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:62:- **AC-2.9**: Compacting destroys nothing canonical: every prior view's content remains derivable from the record, and the record is untouched by compaction.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:63:- **AC-2.10**: Band entries carry their subject keys visibly in rendered text (chunk ids for chunk bands, turn ids for the smoothed band).\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:64:  - **TC-2.6** (AC-2.10): Compact, pull, inspect band text → chunk keys present for brief/detailed entries, turn keys for smoothed entries.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:65:- **AC-1.4**: Between compacts, band content is served byte-identical across pulls. Record edits, deletes, and repair landings after the snapshot do not alter it.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:66:  - **TC-1.3** (AC-1.4): Compact, pull, then edit a message whose chunk summary landed in a band; pull again → band bytes unchanged; drain; pull again → still unchanged (rebuilt summary lands in record only).\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:67:- **AC-1.6**: A message deleted in the tail region is absent from subsequent pulls. A deletion whose derived content sits in the band snapshot leaves the snapshot unchanged until the next compact.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:68:  - **TC-1.5** (AC-1.6): Delete a tail message, pull → message absent. Delete a message banded in the snapshot, pull → band unchanged; status read shows the record changed (next-compact visibility).\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:69:- *(debt closure, primary owner Story 1)*: TC-2.5's view-health legs complete here — status reports degraded/gap counts and built-at after a degraded compact.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:76:The view comes into existence here. Compact is the only writer of the snapshot (`thread_view` + `thread_view_band`, singleton, delete-then-insert in one transaction) and one of exactly two writers of the boundary (reset; the other writer is Story 4's advance). Pull — Story 1's code, unmodified in shape — starts serving snapshot + tail the moment a view row exists. The sweep step is **absent** this story: the receipt's `sweep` field reports a literal `absent` placeholder, and Story 3 replaces it with `SweepReceipt | { skipped: true }`.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:80:Inside-out, pure-to-stateful: (1) `select.ts` as a pure function against fixture data, driven by goldens G1–G4 — this is most of the story's risk and none of its IO; (2) `render.ts` band rendering with ladders/gaps/keys, driven by TC-2.3 and TC-2.6; (3) `snapshot.ts` atomic replace + boundary reset; (4) `index.ts` compact assembly with validation and corruption abort; (5) receipts. Goldens are committed JSON — write the expected arrangements by hand from the design's rules *before* implementing, so the goldens test the rules rather than memorialize the implementation.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:86:| `src/domains/thread-view/internal/select.ts` | the six-rule walk + tie-breakers; corruption detection (unreadable canonical rows → abort signal); coverage edge (`covered_from`) |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:87:| `src/domains/thread-view/internal/render.ts` | band text: ladders (smooth/detailed/brief rows), gap entries, `§` subject keys, `[degraded: …]` and `[inter-turn note]` markers |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:88:| `src/domains/thread-view/internal/snapshot.ts` | atomic replace: `BEGIN IMMEDIATE`, delete singleton (cascade bands), insert header + bands, boundary ← compact point, COMMIT |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:89:| `src/domains/thread-view/index.ts` | `compact` real: validate → [sweep absent] → read → select → render → replace → receipt |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:97:| Degrade ladders + gap entries + keys | tech-design.md L191–200 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:98:| Compact flow + sequence diagram + corruption/crash semantics | tech-design.md L251–279 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:101:| `CompactReceipt` shape | tech-design.md L326–333 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:109:| TC-2.1 | `test/view-compact.test.ts` | profile compact: receipt config matches; 105% sum → named error; unknown profile → named error; thread unchanged after rejections (read-back equality) |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:110:| TC-2.2 | `view-compact.test.ts` | actuals near shares, every deviation attributable to a whole-entry rule; zero provider calls; record hash unchanged |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:111:| TC-2.3 | `view-compact.test.ts` | failed chunk summary + pending rendering → ladder fallbacks marked degraded; receipt lists both with reasons + per-band counts; every subject represented |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:112:| TC-2.4 | `view-compact.test.ts` | crash at compact-write injection point → prior view serves; rerun lands; no partial rows |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:113:| TC-2.6 | `view-compact.test.ts` | `§c…` keys in brief/detailed text, `§t…` in smooth |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:114:| TC-2.7 | `view-compact.test.ts` | corruption variant → `state_corruption` naming subject, prior view intact; control: derived-only damage compacts with gaps |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:115:| TC-1.3 | `view-compact.test.ts` | edit banded subject + drain → band bytes hash-identical across pulls |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:116:| TC-1.5 | `view-compact.test.ts` | tail delete vanishes; banded delete leaves snapshot; status reflects record change |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:122:| restart serves snapshot | compact, close SDK, reopen file fresh, pull → identical bytes — real-file durability, not same-process reread |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:123:| coverage edge accounting | old chunks beyond brief budget: `covered_from` correct, receipt reports exclusion, no silent omission, **no phantom gap entries** for out-of-window chunks |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:129:**TC-2.5 completion leg** (primary owner Story 1): post-degraded-compact status shows degraded/gap counts + `builtAt` live — `view-compact.test.ts`. This story closes the view-health half Story 1 couldn't assert without a compacted view; coverage.md records the split.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:133:The corruption check lives in `select.ts`'s reads, *before* the transaction opens — nothing written means prior view trivially intact; don't move it inside the transaction and rely on rollback. The receipt's `source_state_json` is written at select time (maxEventOrder + form counts seen) — it's the provenance answer to \"why does this view say that.\" `view_id` reuse after intake-free recompacts is by design (L395): do not add a uniqueness scheme. Band order in the pull is brief → detailed → smooth (oldest representation first), then tail.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:137:The sweep-absent receipt must be the honest literal (`sweep: \"absent\"` placeholder shape per Story 3's flip note) — not a fake empty `SweepReceipt`, which would make TC-3.4's Story 3 diff invisible. Goldens are immutable once committed: an implementation that disagrees with a golden is wrong until the *design rule* is shown wrong (deviation process, not golden edit). Degrade ladders must consume real fixture states — no test may flip a form's state by writing `derived_form` directly.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:141:Compact through `createSdk().threadView.compact` with real profiles resolved from real `SdkConfig.view`; crash injection through the Story 0 facility's named compact-write point, not a monkeypatch.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:154:- [ ] All TCs above green, including both architecture-risk tests (restart snapshot via real file close/reopen; coverage edge with no phantom gaps)\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:156:- [ ] Receipt sweep section reports `absent` (Story 3 debt stated in code comment referencing this story file)\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:157:- [ ] Zero provider calls asserted across compact paths\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:163:Path: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/test-plan.md\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:166:# Epic 03: Thread Views and Smart Compact — Test Plan\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:176:| `test/view-compact.test.ts` | default | TC-2.1–2.7 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:178:| `test/view-sweep.test.ts` | default | TC-3.1–3.4 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:180:| `test/view-render-targets.test.ts` | default | TC-5.1–5.3, 5.5 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:181:| `test/cli-process-view.test.ts` | process | TC-5.4; CLI parity for all five commands (pull, status, compact, sweep, materialize) |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:187:| TC-1.1 | 1.2, 1.3 | view-pull | never-compacted thread pulls full conversation in order; later intake appends | fresh temp thread, two intake rounds |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:189:| TC-1.3 | 1.4 | view-pull | band bytes unchanged after edit + drain of a banded subject | compact first via fixture; hash band messages |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:191:| TC-1.5 | 1.6 | view-pull | tail delete vanishes from next pull; banded-subject delete leaves snapshot until compact | uses messages.delete + turns.delete |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:192:| TC-2.1 | 2.2, 2.3, 2.7 | view-compact | profile compact succeeds with config in receipt; 105% sum and unknown profile reject with named violations, thread unchanged | read-back equality after rejections |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:193:| TC-2.2 | 2.4, 2.9 | view-compact | full-coverage compact targets the bound: receipt actuals near band shares, every deviation attributable to a whole-entry rule; zero provider calls; record untouched | record hash before/after |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:194:| TC-2.3 | 2.5, 2.7 | view-compact | failed + pending forms degrade per ladder, receipt lists both, every subject represented | fixture's failed-transient/pending subjects |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:195:| TC-2.4 | 2.6 | view-compact | crash injected between sweep and write: prior view serves; rerun lands clean | Story-0 injection seam |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:196:| TC-2.5 | 2.1, 2.8 | view-pull + view-compact | status on degraded thread reports all fields; reads only; nothing compacts uninvoked | split: pre-compact legs in Story 1, view-health legs Story 2 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:197:| TC-2.6 | 2.10 | view-compact | band text carries §chunk/§turn keys | regex over rendered bands |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:198:| TC-2.7 | 2.5 | view-compact | canonical corruption → `state_corruption` naming damage, prior view serves; derived-only damage → compacts with gaps | corruption fixture variant; control leg |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:199:| TC-3.1 | 3.1–3.3 | view-sweep | sweep classifies the five seeded states correctly, requeues only transient, returns without waiting, zero provider calls | elapsed-time + provider-count asserts |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:200:| TC-3.2 | 3.4 | view-sweep | second sweep without drain: requeued form reported in-flight, no second work row | work_item count by key |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:201:| TC-3.3 | 3.5, 3.7 | view-sweep | standalone SDK and CLI sweep return same receipt shape and counts | CLI leg lives in process suite, asserted by shape here via shared schema |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:202:| TC-3.4 | 3.6, 2.7 | view-sweep | default compact embeds sweep receipt; skip records skip + zero requeues; post-drain compact includes healed form | drain via background drainSettled |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:204:| TC-4.2 | 4.1, 4.2 | view-boundary | flipped: usable summary renders summary; failed renders truncation + marker; interleaved assistant text full | |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:206:| TC-4.4 | 4.6, 4.7 | view-boundary | no backward motion across small batches; compact resets to compact point; fresh tail full | |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:208:| TC-4.6 | 4.9 | view-boundary | injected advance failure: intake succeeds, boundary unmoved, status shows over-max; next batch heals | injection seam; also asserts poke still fired (drain ran) |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:209:| TC-5.1 | 5.1 | view-render-targets | array opens with bands in gradient order then tail in record order; deterministic | |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:210:| TC-5.2 | 5.2, 5.3 | view-render-targets | materialize/pull parity item-for-item; repeat byte-identical; thread state hash unchanged | |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:211:| TC-5.3 | 5.4 | view-render-targets | never-compacted materialize: valid tail-only file loadable against fixture | |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:213:| TC-5.5 | 5.3 | view-render-targets | materialized file validates against real-PI-session structure fixture | header line, entry shape, parentId chain |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:223:| zero-provider sweep across all five ops | view-sweep | The provider fake is in scope for fixtures; nothing stops an internal \"helpful\" derivation call except this assert. The epic's no-inference rule needs teeth. |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:227:| restart serves snapshot | view-compact | Snapshot durability: compact, close SDK, reopen thread file fresh, pull → identical bytes. Real-file restart, not same-process reread. |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:228:| coverage edge accounting | view-compact | When brief budget excludes old chunks: `covered_from` correct, receipt reports exclusion, no silent omission *and* no phantom gap entries for out-of-window chunks. |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:229:| CLI parity: compact/status/sweep | cli-process-view | Scope promises five CLI commands; spawned legs: `view compact --profile` (receipt JSON = SDK shape), `view status` (status JSON = SDK shape), `view sweep` (receipt JSON = SDK shape), plus profile-violation exit-nonzero leg. Closes the gap between claimed CLI surface and proven CLI surface. |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:234:**Selection G1 — proportions:** fixture thread, `conversation` profile (120k/12/48/20/20 scaled down by fixture factor): exact expected arrangement (subject ids per band, compact point, covered_from) checked against committed JSON golden.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:235:**Selection G2 — budget-edge inclusion:** a turn whose rendering exactly fills the smooth remainder → included (≤ rule); one token over → excluded and band stops.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:237:**Selection G4 — turnless straggler:** fixture variant with a runtime note between `turn_end` and the next prompt, compacted so the note's neighborhood lands in a band → note rides the following turn's band entry (rule 6: `[inter-turn note]` marker before the entry, its tokens counted in that turn's fill cost); trailing-straggler leg: a note after the last turn → tail.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:256:- latest_response_path: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/003-implementor.json\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:266:path: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/003-implementor.json\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:282:      storyId: \"02-smart-compact\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:285:      id: \"02-smart-compact\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:286:      title: \"Story 2: Smart Compact\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:287:    planSummary: \"Built compact inside-out per the story's build strategy: (1) render.ts gained the degrade ladders (smooth/detailed/brief resolvers), gap entries as last rung, §subject keys, [degraded: …]/[inter-turn note] markers, and band assembly; (2) select.ts is new — readSelectionInputs (record/forms reads with the canonical-corruption check in the reads, pre-transaction) plus the pure selectArrangement walk implementing rules 1–6 with pinned tie-breakers (≤ inclusion, newest-first, turn-boundary snap, straggler attachment, coverage edge); (3) snapshot.ts gained replaceViewSnapshot — one BEGIN IMMEDIATE doing delete-cascade, header+band insert, and boundary reset; (4) index.ts compact assembles validate → [sweep absent] → read → select → render → injection point → atomic replace → CompactReceipt with sweep: \\\"absent\\\". Entry costs are tokens of the exact rendered entry text (one renderer, no drift). Two ambiguities surfaced during golden derivation and were pinned with code rationale: (a) turns whose chunk straddles the tail or is open are smooth-obligate and always render (AC-2.4's sanctioned over-bound indivisible-entry case — the alternative silently drops spans, violating TC-2.3); (b) a budget stop splitting a fully-banded chunk retreats the included members to the chunk so it represents whole; (c) the brief band has no oversized-loner exception (rule 4's coverage edge is the documented exclusion path). Goldens G1–G4 were hand-derived from the rules against the fixture's deterministic token costs, verified against the pure walk, committed as JSON, and pinned in the immutability manifest.\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:293:        path: \"src/domains/thread-view/internal/render.ts\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:294:        reason: \"Band-entry side: degrade-ladder resolvers per band, gap entries, §keys, degraded/inter-turn-note markers, excerpt lines, band text assembly\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:300:        reason: \"compact real: profile/params validation as caller errors, corruption abort, compact-write injection point, receipt with sweep \\\"absent\\\"; stub removed\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:302:        path: \"src/domains/thread-view/internal/profiles.ts\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:303:        reason: \"Extracted profileViolation so construction (throw) and compact (caller-error result) share one rule set\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:306:        reason: \"CompactReceipt.sweep gains the \\\"absent\\\" literal (Story 3 debt comment referencing this story file); new ViewCompactParams (nested-partial params for field-wise band overrides, AC-2.2)\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:309:        reason: \"Two additive caller-error codes: unknown_profile, invalid_view_config (no new classes)\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:312:        reason: \"ThreadViewSurface.compact params type → ViewCompactParams; type re-exported\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:321:        - \"test/view-compact.test.ts :: TC-2.1 rejections named (105 sum, non-positive bound, unknown profile), thread unchanged by read-back\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:322:        - \"test/view-compact.test.ts :: TC-2.1 built-in profile compact, bound+mix in receipt, sweep literal 'absent'\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:323:        - \"test/view-compact.test.ts :: TC-2.1/AC-2.2 field-wise param override over a named profile, receipt profile null\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:324:        - \"test/view-compact.test.ts :: TC-2.2 actuals near shares with whole-entry deviations, zero provider calls, record hash unchanged\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:325:        - \"test/view-compact.test.ts :: TC-2.6 §chunk keys in brief/detailed, §turn keys in smooth\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:326:        - \"test/view-compact.test.ts :: architecture-risk coverage edge: covered_from=13, exclusion reported, no phantom gaps\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:327:        - \"test/view-compact.test.ts :: architecture-risk restart: fresh SDK pulls byte-identical snapshot\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:328:        - \"test/view-compact.test.ts :: TC-2.4 crash injection at compact-write: prior view serves, rerun lands, no partial rows\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:329:        - \"test/view-compact.test.ts :: TC-2.3 degraded compact: pending rendering → excerpt, failed brief summary → detailed-truncated, c2 gap with reason, full accounting, zero provider calls\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:330:        - \"test/view-compact.test.ts :: TC-2.5 completion leg: status view-health live (degraded=2, gaps=1, builtAt)\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:331:        - \"test/view-compact.test.ts :: TC-2.7 canonical corruption → state_corruption naming open turns, prior view serves, record unchanged\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:332:        - \"test/view-compact.test.ts :: TC-2.7 control: derived-only damage compacts\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:333:        - \"test/view-compact.test.ts :: TC-1.3 banded-subject edit + drain → band bytes hash-identical, rebuilt summary in record only\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:334:        - \"test/view-compact.test.ts :: TC-1.5 tail delete vanishes; banded delete leaves snapshot; status reflects record change\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:341:        - \"test/view-pull.test.ts :: sanctioned amendment — compact's not-implemented leg removed (operation is real); sweep/materialize stub assertions kept\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:357:        - \"Compact-point walk had a malformed never-reached-budget branch — rewritten as explicit crossing detection\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:359:        - \"receipt.profile initially named the base profile even when params overrode it — corrected to null whenever explicit params are present (tech design §Storage: 'null when explicit params')\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:360:        - \"Pinned Partial<ViewProfile> params type could not express the single-band override AC-2.2 itself requires — deepened to ViewCompactParams (nested partial)\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:363:        - \"view-pull.test.ts's skeleton test asserted compact returns not_implemented; amended under the established Epic 02 sanctioned-amendment precedent (cc304bb) and the manifest re-recorded\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:365:      - \"Default base profile for a bare compact({}) is pinned to 'continuation' (first built-in, the epic's primary PI-continuation user); the design names no default — confirm or change the pin before the CLI (Story 5 surface) exposes it\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:367:      - \"Pinned interpretation (not a behavior change to any stated rule): banded turns with no available chunk representation (chunk open or straddling the tail) always render in the smooth band even past its share — justified by AC-2.4's 'above it (an indivisible turn… included by the selection rules)' and required by AC-2.5/TC-2.3's no-silent-absence; documented in select.ts\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:370:      - \"compact opts params type is ViewCompactParams (nested partial) rather than the sketched Partial<ViewProfile> — AC-2.2's field-wise band override is inexpressible in the sketched type\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:371:      - \"Additive vocabulary: ErrorCode gains unknown_profile and invalid_view_config (caller_error class; no new classes per the error contract); CompactReceipt.sweep gains the 'absent' literal this story (Story 3 flips it, comment references this story file)\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:372:    recommendedNextStep: \"Run story verification; on acceptance proceed to Story 3 (sweep) — its gate requires confirming the Epic 02 requeue patch and the persisted terminal-failure reason classes (FC-0.4 already proves the fixture side), and it flips the receipt's sweep field from the 'absent' literal to SweepReceipt | { skipped: true }\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:380:      path: \"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/003-implementor.json\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:392:Path: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/001-current.json\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:396:storyRunId: \"02-smart-compact-story-run-001\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:397:storyId: \"02-smart-compact\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:407:    path: \"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/001-story-validate.json\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:411:    path: \"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/003-implementor.json\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:417:    storyId: \"02-smart-compact\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:427:  artifactRef: \"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/003-implementor.json\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:443:Path: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/001-events.jsonl\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:448:  storyRunId: \"02-smart-compact-story-run-001\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:454:  storyRunId: \"02-smart-compact-story-run-001\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:463:    promptArtifactPath: \"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:466:  storyRunId: \"02-smart-compact-story-run-001\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:476:  storyRunId: \"02-smart-compact-story-run-001\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:487:  storyRunId: \"02-smart-compact-story-run-001\"\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-002.md:492:  artifact: \"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/003-implementor.json\"\npackages/lhc/src/index.ts:3:export type { CliResult } from \"./cli/render.js\";\npackages/lhc/test/epic-fix-02.test.ts:345:    // rendering carries no one-entry-per-tool-message segment.\npackages/lhc/test/epic-fix-02.test.ts:346:    const rendering = readDerivedForms(filePath).find(\npackages/lhc/test/epic-fix-02.test.ts:347:      (f) => f.subjectId === \"t1\" && f.form === \"turn_rendering\",\npackages/lhc/test/epic-fix-02.test.ts:349:    const receipts = rendering?.metadata?.receipts;\npackages/lhc/test/epic-fix-02.test.ts:378:      (f) => f.subjectId === \"t1\" && f.form === \"turn_rendering\",\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:4:You are the story lead for `02-smart-compact` on durable story run `02-smart-compact-story-run-001`.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:19:Path: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/stories/02-smart-compact.md\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:22:# Story 2: Smart Compact\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:26:The compact operation: profiles and validation, band arrangement from stored artifacts, degrade ladders and gaps, atomic snapshot replace with boundary reset, receipts; pull serves snapshot + tail.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:31:**User Profile (from epic):** the agentic harness (PI extension first), calling through the SDK on every model call; and the agent/operator running compacts and checking thread health through the CLI.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:33:**Objective:** the view exists. Compact selects, renders, and atomically installs the band snapshot; pull serves it verbatim between compacts.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:36:- `compact(ref, { profile?, params?, sweep? })` per tech design §Flow 2: validate → (sweep step **absent this story** — see scope out) → read record + forms → selection walk (§Deterministic Algorithms, rules 1–6 including turnless stragglers) → band rendering (degrade ladders, gap entries, subject keys, `[inter-turn note]` markers) → one `BEGIN IMMEDIATE` transaction (delete view row cascade, insert header + bands, boundary ← compact point) → `CompactReceipt`\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:37:- Canonical-corruption refusal (`state_corruption`, pre-transaction, prior view untouched)\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:38:- Coverage edge: `covered_from`, receipt reports out-of-window history\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:40:- Status upgraded: view-health fields live (degraded count, gap count, built-at)\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:43:**Scope out:** the sweep — compact ships with the sweep step absent; the receipt's sweep section reports `absent`. Story 3 adds the embedded sweep and flips the receipt to `SweepReceipt | { skipped: true }`. Same pattern as Epic 01's Story 4→5 queue seam: the gap is a stated cross-story debt, not a shim — nothing fakes a sweep, nothing stubs one.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:50:- **AC-2.1**: Compact runs only when invoked through the surface (SDK or CLI). No code path in core invokes it internally.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:51:- **AC-2.2**: The operation accepts a named profile or explicit parameters; explicit parameters override profile values; built-in profiles exist and user-defined profiles are configurable.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:52:- **AC-2.3**: Invalid configuration (band percentages not summing to 100, unknown profile, non-positive bound) is rejected with a caller error naming the violation; thread state is unchanged.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:53:  - **TC-2.1** (AC-2.2, AC-2.3, AC-2.7): Compact with a built-in profile → succeeds with that profile's bound and mix recorded in the receipt; compact with percentages summing to 105 → caller error naming the sum; unknown profile → caller error naming it; thread unchanged after both rejections.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:54:- **AC-2.4**: A compacted view targets the configured lower bound: band shares are computed from its percentages, each band fills by whole entries against its share, and the receipt reports actual per-band and total token counts. The total may land below the bound (insufficient stored material, or the next whole entry would exceed a band's share) or above it (an indivisible turn/chunk/message included by the selection rules). Assembly is entirely from stored artifacts — no provider calls during compact (sweep requeues background work; the compact itself never waits on or invokes inference).\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:55:  - **TC-2.2** (AC-2.4, AC-2.9): On a thread with full derivation coverage, compact → view targets the bound (receipt's actual counts within whole-entry tolerance of band shares, deviations attributable to whole-entry inclusion rules), provider fake observes zero calls during the compact; read the record after → identical to before.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:56:- **AC-2.5**: Missing or unusable band material degrades: the entry renders the best available stored form for its subject and is marked degraded, or renders as an explicit gap entry when nothing usable exists. The compact records every degraded entry and gap on the view and reports them in the receipt. A compact never fails because derived material is missing or failed; it refuses only when canonical source state needed to identify or read the compacted span is corrupt or unreadable, with a structured `state_corruption` error naming the damage, leaving the prior view and the record unchanged.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:57:  - **TC-2.3** (AC-2.5, AC-2.7): On a thread with one failed chunk summary and one pending turn rendering, compact → completes; degraded entries render fallbacks and are marked; receipt lists both with reasons and reports per-band counts; no span silently absent (every turn/chunk in the compacted range accounted for in some form).\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:58:  - **TC-2.7** (AC-2.5): On a fixture thread with manufactured canonical corruption (damaged below the SDK, per the Epic 01 corruption-fixture pattern), compact → refuses with `state_corruption` naming the damage; the prior active view still serves; record unchanged. Control: the same thread with only derived-material damage (failed summaries) compacts successfully with gaps.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:59:- **AC-2.6**: The compact replaces the active view atomically: band arrangement, rendered snapshot, compact point, config used, and gaps land in one transaction; the visibility boundary resets to the compact point in the same transaction. A crash mid-compact leaves the previous view intact and serving.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:60:  - **TC-2.4** (AC-2.6): Crash injection between sweep and view write (test seam) → previous view still serves; rerun compact → new view lands; no partial state.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:61:- **AC-2.7**: The receipt reports what was built: per-band entry counts and rendered sizes, degraded entries and gaps with reasons, sweep results (or that the sweep was skipped), and the config used. *(Sweep section reports `absent` until Story 3 — cross-story debt, stated.)*\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:62:- **AC-2.9**: Compacting destroys nothing canonical: every prior view's content remains derivable from the record, and the record is untouched by compaction.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:63:- **AC-2.10**: Band entries carry their subject keys visibly in rendered text (chunk ids for chunk bands, turn ids for the smoothed band).\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:64:  - **TC-2.6** (AC-2.10): Compact, pull, inspect band text → chunk keys present for brief/detailed entries, turn keys for smoothed entries.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:65:- **AC-1.4**: Between compacts, band content is served byte-identical across pulls. Record edits, deletes, and repair landings after the snapshot do not alter it.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:66:  - **TC-1.3** (AC-1.4): Compact, pull, then edit a message whose chunk summary landed in a band; pull again → band bytes unchanged; drain; pull again → still unchanged (rebuilt summary lands in record only).\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:67:- **AC-1.6**: A message deleted in the tail region is absent from subsequent pulls. A deletion whose derived content sits in the band snapshot leaves the snapshot unchanged until the next compact.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:68:  - **TC-1.5** (AC-1.6): Delete a tail message, pull → message absent. Delete a message banded in the snapshot, pull → band unchanged; status read shows the record changed (next-compact visibility).\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:69:- *(debt closure, primary owner Story 1)*: TC-2.5's view-health legs complete here — status reports degraded/gap counts and built-at after a degraded compact.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:76:The view comes into existence here. Compact is the only writer of the snapshot (`thread_view` + `thread_view_band`, singleton, delete-then-insert in one transaction) and one of exactly two writers of the boundary (reset; the other writer is Story 4's advance). Pull — Story 1's code, unmodified in shape — starts serving snapshot + tail the moment a view row exists. The sweep step is **absent** this story: the receipt's `sweep` field reports a literal `absent` placeholder, and Story 3 replaces it with `SweepReceipt | { skipped: true }`.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:80:Inside-out, pure-to-stateful: (1) `select.ts` as a pure function against fixture data, driven by goldens G1–G4 — this is most of the story's risk and none of its IO; (2) `render.ts` band rendering with ladders/gaps/keys, driven by TC-2.3 and TC-2.6; (3) `snapshot.ts` atomic replace + boundary reset; (4) `index.ts` compact assembly with validation and corruption abort; (5) receipts. Goldens are committed JSON — write the expected arrangements by hand from the design's rules *before* implementing, so the goldens test the rules rather than memorialize the implementation.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:86:| `src/domains/thread-view/internal/select.ts` | the six-rule walk + tie-breakers; corruption detection (unreadable canonical rows → abort signal); coverage edge (`covered_from`) |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:87:| `src/domains/thread-view/internal/render.ts` | band text: ladders (smooth/detailed/brief rows), gap entries, `§` subject keys, `[degraded: …]` and `[inter-turn note]` markers |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:88:| `src/domains/thread-view/internal/snapshot.ts` | atomic replace: `BEGIN IMMEDIATE`, delete singleton (cascade bands), insert header + bands, boundary ← compact point, COMMIT |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:89:| `src/domains/thread-view/index.ts` | `compact` real: validate → [sweep absent] → read → select → render → replace → receipt |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:97:| Degrade ladders + gap entries + keys | tech-design.md L191–200 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:98:| Compact flow + sequence diagram + corruption/crash semantics | tech-design.md L251–279 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:101:| `CompactReceipt` shape | tech-design.md L326–333 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:109:| TC-2.1 | `test/view-compact.test.ts` | profile compact: receipt config matches; 105% sum → named error; unknown profile → named error; thread unchanged after rejections (read-back equality) |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:110:| TC-2.2 | `view-compact.test.ts` | actuals near shares, every deviation attributable to a whole-entry rule; zero provider calls; record hash unchanged |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:111:| TC-2.3 | `view-compact.test.ts` | failed chunk summary + pending rendering → ladder fallbacks marked degraded; receipt lists both with reasons + per-band counts; every subject represented |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:112:| TC-2.4 | `view-compact.test.ts` | crash at compact-write injection point → prior view serves; rerun lands; no partial rows |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:113:| TC-2.6 | `view-compact.test.ts` | `§c…` keys in brief/detailed text, `§t…` in smooth |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:114:| TC-2.7 | `view-compact.test.ts` | corruption variant → `state_corruption` naming subject, prior view intact; control: derived-only damage compacts with gaps |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:115:| TC-1.3 | `view-compact.test.ts` | edit banded subject + drain → band bytes hash-identical across pulls |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:116:| TC-1.5 | `view-compact.test.ts` | tail delete vanishes; banded delete leaves snapshot; status reflects record change |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:122:| restart serves snapshot | compact, close SDK, reopen file fresh, pull → identical bytes — real-file durability, not same-process reread |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:123:| coverage edge accounting | old chunks beyond brief budget: `covered_from` correct, receipt reports exclusion, no silent omission, **no phantom gap entries** for out-of-window chunks |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:129:**TC-2.5 completion leg** (primary owner Story 1): post-degraded-compact status shows degraded/gap counts + `builtAt` live — `view-compact.test.ts`. This story closes the view-health half Story 1 couldn't assert without a compacted view; coverage.md records the split.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:133:The corruption check lives in `select.ts`'s reads, *before* the transaction opens — nothing written means prior view trivially intact; don't move it inside the transaction and rely on rollback. The receipt's `source_state_json` is written at select time (maxEventOrder + form counts seen) — it's the provenance answer to \"why does this view say that.\" `view_id` reuse after intake-free recompacts is by design (L395): do not add a uniqueness scheme. Band order in the pull is brief → detailed → smooth (oldest representation first), then tail.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:137:The sweep-absent receipt must be the honest literal (`sweep: \"absent\"` placeholder shape per Story 3's flip note) — not a fake empty `SweepReceipt`, which would make TC-3.4's Story 3 diff invisible. Goldens are immutable once committed: an implementation that disagrees with a golden is wrong until the *design rule* is shown wrong (deviation process, not golden edit). Degrade ladders must consume real fixture states — no test may flip a form's state by writing `derived_form` directly.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:141:Compact through `createSdk().threadView.compact` with real profiles resolved from real `SdkConfig.view`; crash injection through the Story 0 facility's named compact-write point, not a monkeypatch.\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:154:- [ ] All TCs above green, including both architecture-risk tests (restart snapshot via real file close/reopen; coverage edge with no phantom gaps)\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:156:- [ ] Receipt sweep section reports `absent` (Story 3 debt stated in code comment referencing this story file)\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:157:- [ ] Zero provider calls asserted across compact paths\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:163:Path: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/03-thread-views-and-smart-compact/test-plan.md\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:166:# Epic 03: Thread Views and Smart Compact — Test Plan\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:176:| `test/view-compact.test.ts` | default | TC-2.1–2.7 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:178:| `test/view-sweep.test.ts` | default | TC-3.1–3.4 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:180:| `test/view-render-targets.test.ts` | default | TC-5.1–5.3, 5.5 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:181:| `test/cli-process-view.test.ts` | process | TC-5.4; CLI parity for all five commands (pull, status, compact, sweep, materialize) |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:187:| TC-1.1 | 1.2, 1.3 | view-pull | never-compacted thread pulls full conversation in order; later intake appends | fresh temp thread, two intake rounds |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:189:| TC-1.3 | 1.4 | view-pull | band bytes unchanged after edit + drain of a banded subject | compact first via fixture; hash band messages |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:191:| TC-1.5 | 1.6 | view-pull | tail delete vanishes from next pull; banded-subject delete leaves snapshot until compact | uses messages.delete + turns.delete |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:192:| TC-2.1 | 2.2, 2.3, 2.7 | view-compact | profile compact succeeds with config in receipt; 105% sum and unknown profile reject with named violations, thread unchanged | read-back equality after rejections |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:193:| TC-2.2 | 2.4, 2.9 | view-compact | full-coverage compact targets the bound: receipt actuals near band shares, every deviation attributable to a whole-entry rule; zero provider calls; record untouched | record hash before/after |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:194:| TC-2.3 | 2.5, 2.7 | view-compact | failed + pending forms degrade per ladder, receipt lists both, every subject represented | fixture's failed-transient/pending subjects |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:195:| TC-2.4 | 2.6 | view-compact | crash injected between sweep and write: prior view serves; rerun lands clean | Story-0 injection seam |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:196:| TC-2.5 | 2.1, 2.8 | view-pull + view-compact | status on degraded thread reports all fields; reads only; nothing compacts uninvoked | split: pre-compact legs in Story 1, view-health legs Story 2 |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:197:| TC-2.6 | 2.10 | view-compact | band text carries §chunk/§turn keys | regex over rendered bands |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:198:| TC-2.7 | 2.5 | view-compact | canonical corruption → `state_corruption` naming damage, prior view serves; derived-only damage → compacts with gaps | corruption fixture variant; control leg |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:199:| TC-3.1 | 3.1–3.3 | view-sweep | sweep classifies the five seeded states correctly, requeues only transient, returns without waiting, zero provider calls | elapsed-time + provider-count asserts |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:200:| TC-3.2 | 3.4 | view-sweep | second sweep without drain: requeued form reported in-flight, no second work row | work_item count by key |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/story-lead/prompts/001-planner-turn-001.md:201:| TC-3.3 | 3.5, 3.7 | view-sweep | standalone SDK and CLI sweep return same receipt shape and counts | CLI leg lives in process suite, asserted by shape here via shared schema |\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compac
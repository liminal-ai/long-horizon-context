{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/index.ts | sed -n '1,420p'\"","aggregated_output":"     1\t// thread-view surface (Epic 03): pull, status, compact, sweep, materialize.\n     2\t// Story 1 lands the skeleton with `pull` and `status` real — the hot-path\n     3\t// reads: local reads and deterministic string assembly only, no inference,\n     4\t// no network, no queue interaction, no writes (AC-1.1, AC-2.8). The other\n     5\t// three are structured-result stubs until their stories (2, 3, 5) land.\n     6\t// Story 0's substrate (profile resolution, consumed by createSdk) re-exports\n     7\t// at the bottom.\n     8\timport { existsSync } from \"node:fs\";\n     9\timport {\n    10\t  resolveInstanceViewConfig,\n    11\t  runWithThreadTouchSuppressed,\n    12\t} from \"../../shared/context.js\";\n    13\timport type { FormReportEntry } from \"../../shared/derivation.js\";\n    14\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n    15\timport type {\n    16\t  CompactReceipt,\n    17\t  PullResult,\n    18\t  ResolvedViewConfig,\n    19\t  SweepReceipt,\n    20\t  ViewCompactParams,\n    21\t  ViewMessage,\n    22\t  ViewProfile,\n    23\t  ViewStatus,\n    24\t} from \"../../shared/view.js\";\n    25\timport * as messagesDomain from \"../messages/index.js\";\n    26\timport * as turnsDomain from \"../turns/index.js\";\n    27\timport {\n    28\t  openThreadDatabase,\n    29\t  resolveThreadRef,\n    30\t  type ThreadRef,\n    31\t} from \"../threads/index.js\";\n    32\timport { readBoundaryPosition, visibilityZoneTokens } from \"./internal/boundary.js\";\n    33\timport { profileViolation, resolveViewConfig } from \"./internal/profiles.js\";\n    34\timport {\n    35\t  assembleBandText,\n    36\t  renderBandMessage,\n    37\t  renderTailMessage,\n    38\t  toolNamesByCallId,\n    39\t} from \"./internal/render.js\";\n    40\timport { fireViewInjection } from \"./internal/seam.js\";\n    41\timport {\n    42\t  CanonicalCorruptionError,\n    43\t  readSelectionInputs,\n    44\t  selectArrangement,\n    45\t  type ArrangementEntry,\n    46\t} from \"./internal/select.js\";\n    47\timport {\n    48\t  readReadyToolResultSummaries,\n    49\t  readTailMessages,\n    50\t  readViewSnapshot,\n    51\t  replaceViewSnapshot,\n    52\t  tailTokenSum,\n    53\t} from \"./internal/snapshot.js\";\n    54\timport { estimateTokens } from \"../../tech-utils/token-counting/index.js\";\n    55\timport type { Band } from \"../../shared/view.js\";\n    56\t\n    57\t// Config resolution for the operation in hand: the SDK instance's resolved\n    58\t// view config rides the per-instance seam (epic-fix-001 pattern, tech design\n    59\t// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\n    60\t// through the same one resolution path createSdk uses.\n    61\tconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\n    62\t\n    63\tfunction viewConfig(): ResolvedViewConfig {\n    64\t  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\n    65\t}\n    66\t\n    67\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n    68\t  return {\n    69\t    ok: false,\n    70\t    error: {\n    71\t      errorClass: \"caller_error\",\n    72\t      code: \"thread_not_found\",\n    73\t      reason: `no thread file exists at ${filePath}`,\n    74\t    },\n    75\t  };\n    76\t}\n    77\t\n    78\tfunction detail(cause: unknown): string {\n    79\t  return cause instanceof Error ? cause.message : String(cause);\n    80\t}\n    81\t\n    82\t// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\n    83\t\n    84\t// The hot-path read: view header + bands (if any), tail messages after the\n    85\t// compact point (deleted-filtered, record order), boundary position; then\n    86\t// format — band messages first, tail per the mapping table, tool results\n    87\t// at-or-behind the boundary in short form. No view row ⇒ the whole record is\n    88\t// tail from event 1 (AC-1.3) through this same code path with the compact\n    89\t// point at its zero origin — snapshot-absent, never a separate branch.\n    90\t//\n    91\t// Reads-only is structural, not disciplined: the whole operation runs in the\n    92\t// touch-suppressed scope, so the open announcement that would let a\n    93\t// background SDK's scheduler hang a first-touch catch-up drain off this read\n    94\t// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\n    95\t// AC-1.1's no-queue-interaction holds in both host modes.\n    96\texport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\n    97\t  return runWithThreadTouchSuppressed(() => pullInner(ref));\n    98\t}\n    99\t\n   100\tasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n   101\t  const resolved = await resolveThreadRef(ref);\n   102\t  if (!resolved.ok) return resolved;\n   103\t  const { filePath } = resolved.value;\n   104\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   105\t\n   106\t  const opened = openThreadDatabase(filePath);\n   107\t  if (!opened.ok) return opened;\n   108\t  const db = opened.value;\n   109\t  try {\n   110\t    const snapshot = readViewSnapshot(db);\n   111\t    const compactPoint = snapshot?.compactPoint ?? 0;\n   112\t    const boundaryPosition = readBoundaryPosition(db);\n   113\t    const tailRows = readTailMessages(db, compactPoint);\n   114\t    const renderCtx = {\n   115\t      boundaryPosition,\n   116\t      toolNameByCallId: toolNamesByCallId(tailRows),\n   117\t      toolResultSummaries: readReadyToolResultSummaries(db),\n   118\t    };\n   119\t\n   120\t    const messages: ViewMessage[] = [];\n   121\t    if (snapshot !== null) {\n   122\t      for (const band of snapshot.bands) {\n   123\t        messages.push(renderBandMessage(band.band, band.renderedText));\n   124\t      }\n   125\t    }\n   126\t    for (const row of tailRows) {\n   127\t      messages.push(renderTailMessage(row, renderCtx));\n   128\t    }\n   129\t\n   130\t    return {\n   131\t      ok: true,\n   132\t      value: {\n   133\t        messages,\n   134\t        meta: {\n   135\t          compactPoint: snapshot?.compactPoint ?? null,\n   136\t          coveredFrom: snapshot?.coveredFrom ?? null,\n   137\t          boundaryPosition,\n   138\t          gapCount: snapshot?.gapCount ?? 0,\n   139\t          degradedCount: snapshot?.degradedCount ?? 0,\n   140\t          viewId: snapshot?.viewId ?? null,\n   141\t          createdAt: snapshot?.createdAt ?? null,\n   142\t        },\n   143\t      },\n   144\t    };\n   145\t  } catch (cause) {\n   146\t    return storageFailure(`view pull failed: ${detail(cause)}`);\n   147\t  } finally {\n   148\t    db.close();\n   149\t  }\n   150\t}\n   151\t\n   152\t// ── status (AC-2.8) ───────────────────────────────────────────────\n   153\t\n   154\t// Derivation counts bucket from one report entry the way the report's own\n   155\t// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\n   156\t// pending, retrying (pending with attempts spent), failed, blocked. Ready\n   157\t// forms are healthy and not an operational situation.\n   158\tfunction bucketDerivation(\n   159\t  entries: readonly FormReportEntry[],\n   160\t  counts: ViewStatus[\"derivation\"],\n   161\t): void {\n   162\t  for (const entry of entries) {\n   163\t    switch (entry.state) {\n   164\t      case \"pending\":\n   165\t        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\n   166\t        else counts.pending += 1;\n   167\t        break;\n   168\t      case \"failed\":\n   169\t        counts.failed += 1;\n   170\t        break;\n   171\t      case \"blocked\":\n   172\t        counts.blocked += 1;\n   173\t        break;\n   174\t      case \"ready\":\n   175\t        break;\n   176\t    }\n   177\t  }\n   178\t}\n   179\t\n   180\t// Reads only, callable any time, no side effects: tail size against the\n   181\t// configured trigger threshold with a compact recommendation (`tailTokens >\n   182\t// threshold`, nothing smarter — the caller owns policy), derivation counts\n   183\t// by state read through the OWNERS' report surfaces (must-not-own: never a\n   184\t// direct derived_form read here), the active view's health or null\n   185\t// pre-compact, and the visibility zone's sum against its max — computed live\n   186\t// by the same query the Story 4 advance will use, so \"visible in status\" is\n   187\t// structural, not stored.\n   188\t//\n   189\t// Like pull, the whole read — including the owners' report surfaces it\n   190\t// consumes — runs in the touch-suppressed scope, so a background SDK's\n   191\t// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n   192\t// host modes).\n   193\texport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n   194\t  return runWithThreadTouchSuppressed(() => statusInner(ref));\n   195\t}\n   196\t\n   197\tasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n   198\t  const resolved = await resolveThreadRef(ref);\n   199\t  if (!resolved.ok) return resolved;\n   200\t  const { filePath } = resolved.value;\n   201\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   202\t\n   203\t  const config = viewConfig();\n   204\t  const opened = openThreadDatabase(filePath);\n   205\t  if (!opened.ok) return opened;\n   206\t  const db = opened.value;\n   207\t  let tailTokens: number;\n   208\t  let zoneTokens: number;\n   209\t  let view: ViewStatus[\"view\"];\n   210\t  try {\n   211\t    const snapshot = readViewSnapshot(db);\n   212\t    const compactPoint = snapshot?.compactPoint ?? 0;\n   213\t    const boundaryPosition = readBoundaryPosition(db);\n   214\t    tailTokens = tailTokenSum(db, compactPoint);\n   215\t    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n   216\t    view =\n   217\t      snapshot === null\n   218\t        ? null\n   219\t        : {\n   220\t            degraded: snapshot.degradedCount,\n   221\t            gaps: snapshot.gapCount,\n   222\t            builtAt: snapshot.createdAt,\n   223\t          };\n   224\t  } catch (cause) {\n   225\t    return storageFailure(`view status failed: ${detail(cause)}`);\n   226\t  } finally {\n   227\t    db.close();\n   228\t  }\n   229\t\n   230\t  // The owners' report surfaces open their own handles; ours is closed first\n   231\t  // so the status read never holds two handles on one thread file.\n   232\t  const messageReport = await messagesDomain.report({ filePath });\n   233\t  if (!messageReport.ok) return messageReport;\n   234\t  const turnReport = await turnsDomain.report({ filePath });\n   235\t  if (!turnReport.ok) return turnReport;\n   236\t  const derivation: ViewStatus[\"derivation\"] = {\n   237\t    pending: 0,\n   238\t    retrying: 0,\n   239\t    failed: 0,\n   240\t    blocked: 0,\n   241\t  };\n   242\t  bucketDerivation(messageReport.value, derivation);\n   243\t  bucketDerivation(turnReport.value, derivation);\n   244\t\n   245\t  return {\n   246\t    ok: true,\n   247\t    value: {\n   248\t      tailTokens,\n   249\t      threshold: config.compactThreshold,\n   250\t      compactRecommended: tailTokens > config.compactThreshold,\n   251\t      derivation,\n   252\t      view,\n   253\t      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\n   254\t    },\n   255\t  };\n   256\t}\n   257\t\n   258\t// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\n   259\t\n   260\t// The default base when no profile is named: the first built-in, matching\n   261\t// the epic's primary user (the PI continuation harness). Explicit params\n   262\t// override the base field-wise (AC-2.2).\n   263\tconst DEFAULT_PROFILE_NAME = \"continuation\";\n   264\t\n   265\tfunction callerError(\n   266\t  code: \"unknown_profile\" | \"invalid_view_config\",\n   267\t  reason: string,\n   268\t): { ok: false; error: ErrorResult } {\n   269\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n   270\t}\n   271\t\n   272\tconst BAND_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n   273\t\n   274\t// Compact runs only when invoked through this surface (AC-2.1: no code path\n   275\t// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\n   276\t// rejection provably touches nothing) → [sweep step ABSENT this story — the\n   277\t// receipt's sweep field reports the literal \"absent\"; Story 3 embeds the\n   278\t// real sweep here per stories/02-smart-compact.md §Scope out] → read record\n   279\t// + forms with the corruption check in the reads (pre-transaction, prior\n   280\t// view trivially intact on refusal) → selection walk → band rendering → one\n   281\t// BEGIN IMMEDIATE replacing the view and resetting the boundary → receipt.\n   282\t// Assembly is entirely from stored artifacts: nothing here can reach a\n   283\t// provider (AC-2.4 zero-inference is structural).\n   284\texport async function compact(\n   285\t  ref: ThreadRef,\n   286\t  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n   287\t): Promise<OpResult<CompactReceipt>> {\n   288\t  const resolved = await resolveThreadRef(ref);\n   289\t  if (!resolved.ok) return resolved;\n   290\t  const { filePath } = resolved.value;\n   291\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   292\t\n   293\t  const config = viewConfig();\n   294\t  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\n   295\t  const base = config.profiles[baseName];\n   296\t  if (base === undefined) {\n   297\t    return callerError(\n   298\t      \"unknown_profile\",\n   299\t      `unknown profile \"${baseName}\"; configured profiles are ${Object.keys(config.profiles)\n   300\t        .map((name) => `\"${name}\"`)\n   301\t        .join(\", \")}`,\n   302\t    );\n   303\t  }\n   304\t  const merged: ViewProfile = {\n   305\t    name: base.name,\n   306\t    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\n   307\t    percentages: { ...base.percentages, ...opts.params?.percentages },\n   308\t  };\n   309\t  const violation = profileViolation(merged);\n   310\t  if (violation !== null) return callerError(\"invalid_view_config\", violation);\n   311\t  // Receipt provenance: \"null when explicit params\" (tech design §Storage) —\n   312\t  // any param override means the config is no longer a named profile's mix,\n   313\t  // even when one served as the merge base; the receipt's config carries the\n   314\t  // resolved truth. A bare or profile-only call names its profile.\n   315\t  const profileName = opts.params === undefined ? baseName : null;\n   316\t\n   317\t  const opened = openThreadDatabase(filePath);\n   318\t  if (!opened.ok) return opened;\n   319\t  const db = opened.value;\n   320\t  try {\n   321\t    let inputs;\n   322\t    try {\n   323\t      inputs = readSelectionInputs(db);\n   324\t    } catch (cause) {\n   325\t      if (cause instanceof CanonicalCorruptionError) {\n   326\t        // Pre-transaction refusal: nothing was written, the prior view and\n   327\t        // the record are untouched (AC-2.5).\n   328\t        return {\n   329\t          ok: false,\n   330\t          error: { errorClass: \"state_corruption\", code: cause.code, reason: cause.message },\n   331\t        };\n   332\t      }\n   333\t      throw cause;\n   334\t    }\n   335\t    const selection = selectArrangement(inputs, {\n   336\t      lowerBound: merged.lowerBound,\n   337\t      percentages: merged.percentages,\n   338\t    });\n   339\t\n   340\t    const entriesByBand = (band: Band): ArrangementEntry[] =>\n   341\t      selection.entries.filter((entry) => entry.band === band);\n   342\t    const bands = BAND_ORDER.flatMap((band) => {\n   343\t      const entries = entriesByBand(band);\n   344\t      if (entries.length === 0) return [];\n   345\t      const renderedText = assembleBandText(entries.map((entry) => entry.text));\n   346\t      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\n   347\t    });\n   348\t\n   349\t    const createdAt = new Date().toISOString();\n   350\t    // view_id is v<compact event order> — deterministic, and deliberately\n   351\t    // reused by an intake-free recompact (tech design L395: do not \"fix\"\n   352\t    // into a uniqueness scheme; the singleton row is replaced whole).\n   353\t    const viewId = `v${inputs.maxEventOrder}`;\n   354\t\n   355\t    // Story-0 injection point: TC-2.4's crash between the (absent) sweep and\n   356\t    // the view-write transaction. An installed hook's throw aborts here —\n   357\t    // before BEGIN — so the previous view keeps serving.\n   358\t    fireViewInjection(\"compact-write\");\n   359\t\n   360\t    replaceViewSnapshot(db, {\n   361\t      viewId,\n   362\t      createdAt,\n   363\t      compactPoint: selection.compactPoint,\n   364\t      coveredFrom: selection.coveredFrom,\n   365\t      profileName,\n   366\t      configJson: JSON.stringify({\n   367\t        lowerBound: merged.lowerBound,\n   368\t        percentages: merged.percentages,\n   369\t      }),\n   370\t      arrangementJson: JSON.stringify(\n   371\t        selection.entries.map((entry) => ({\n   372\t          band: entry.band,\n   373\t          subjectKind: entry.subjectKind,\n   374\t          subjectId: entry.subjectId,\n   375\t          formUsed: entry.formUsed,\n   376\t          degraded: entry.degraded,\n   377\t        })),\n   378\t      ),\n   379\t      gapsJson: JSON.stringify(\n   380\t        selection.entries\n   381\t          .filter((entry) => entry.gap)\n   382\t          .map((entry) => ({\n   383\t            band: entry.band,\n   384\t            subjectId: entry.subjectId,\n   385\t            reason: entry.reason ?? \"unknown\",\n   386\t          })),\n   387\t      ),\n   388\t      sourceStateJson: JSON.stringify({\n   389\t        maxEventOrder: inputs.maxEventOrder,\n   390\t        formCounts: inputs.formCounts,\n   391\t      }),\n   392\t      bands,\n   393\t    });\n   394\t\n   395\t    const bandReport = {} as CompactReceipt[\"bands\"];\n   396\t    for (const band of BAND_ORDER) {\n   397\t      const stored = bands.find((row) => row.band === band);\n   398\t      bandReport[band] = {\n   399\t        entries: entriesByBand(band).length,\n   400\t        tokens: stored?.tokenCount ?? 0,\n   401\t      };\n   402\t    }\n   403\t    return {\n   404\t      ok: true,\n   405\t      value: {\n   406\t        viewId,\n   407\t        profile: profileName,\n   408\t        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n   409\t        bands: bandReport,\n   410\t        tailTokens: tailTokenSum(db, selection.compactPoint),\n   411\t        coveredFrom: selection.coveredFrom,\n   412\t        compactPoint: selection.compactPoint,\n   413\t        degraded: selection.entries\n   414\t          .filter((entry) => entry.degraded)\n   415\t          .map((entry) => ({\n   416\t            band: entry.band,\n   417\t            subjectId: entry.subjectId,\n   418\t            usedForm: entry.formUsed,\n   419\t          })),\n   420\t        gaps: selection.entries\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/internal/select.ts | sed -n '1,520p'\"","aggregated_output":"     1\t// Band selection (Story 2): the six-rule walk from tech design §Deterministic\n     2\t// Algorithms — compact point, smooth/detailed/brief fills, rule-5 unchunked\n     3\t// turns, rule-6 turnless stragglers — plus the coverage edge (covered_from)\n     4\t// and canonical-corruption detection. Two halves, deliberately split:\n     5\t//\n     6\t//   - readSelectionInputs: the record/forms reads, with the corruption check\n     7\t//     IN the reads, before any transaction opens (story Technical Notes) —\n     8\t//     a refusal here means nothing was written, so the prior view is\n     9\t//     trivially intact (AC-2.5). Never moved inside the transaction.\n    10\t//   - selectArrangement: a pure function over those inputs. No DB handle, no\n    11\t//     clock, no provider — same inputs ⇒ same arrangement, byte-for-byte\n    12\t//     (AC-2.9; goldens G1–G4 pin the tie-breakers).\n    13\t//\n    14\t// Tie-breakers, pinned (tech design): inclusion thresholds are ≤; walks are\n    15\t// newest-first everywhere; chunk coverage is decided by the chunk's newest\n    16\t// member turn. Entry costs are the tokens of the rendered entry text itself\n    17\t// (render.ts's renderArrangementEntry, including attached inter-turn notes),\n    18\t// so the budgeted tokens are the stored tokens — no second estimate.\n    19\timport type { DatabaseSync } from \"node:sqlite\";\n    20\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n    21\timport type { Band } from \"../../../shared/view.js\";\n    22\timport {\n    23\t  excerptLine,\n    24\t  renderArrangementEntry,\n    25\t  resolveBriefRepresentation,\n    26\t  resolveDetailedRepresentation,\n    27\t  resolveSmoothRepresentation,\n    28\t  type FormSnapshot,\n    29\t} from \"./render.js\";\n    30\t\n    31\t// Canonical source state needed to identify or read the compacted span is\n    32\t// damaged: compact refuses with state_corruption (AC-2.5). Derived-material\n    33\t// damage never raises this — it degrades through the ladders instead.\n    34\texport class CanonicalCorruptionError extends Error {\n    35\t  readonly code: \"turn_state_corrupt\" | \"source_damaged\";\n    36\t  constructor(code: \"turn_state_corrupt\" | \"source_damaged\", reason: string) {\n    37\t    super(reason);\n    38\t    this.code = code;\n    39\t    this.name = \"CanonicalCorruptionError\";\n    40\t  }\n    41\t}\n    42\t\n    43\texport interface SelectionMessage {\n    44\t  messageId: string;\n    45\t  order: number; // source_event_order\n    46\t  kind: string;\n    47\t  tokenEstimate: number;\n    48\t  turnId: string | null;\n    49\t  text: string; // excerpt/note line (render.excerptLine)\n    50\t}\n    51\t\n    52\texport interface SelectionTurn {\n    53\t  turnId: string;\n    54\t  turnOrder: number;\n    55\t  status: \"open\" | \"closed\";\n    56\t  openedAt: number;\n    57\t  closedAt: number | null;\n    58\t}\n    59\t\n    60\texport interface SelectionChunk {\n    61\t  chunkId: string;\n    62\t  chunkOrder: number;\n    63\t  status: \"open\" | \"closed\";\n    64\t  memberTurnIds: string[]; // member order\n    65\t}\n    66\t\n    67\texport interface SelectionInputs {\n    68\t  messages: SelectionMessage[]; // live only, ascending order\n    69\t  turns: SelectionTurn[]; // ascending turnOrder\n    70\t  chunks: SelectionChunk[]; // ascending chunkOrder\n    71\t  forms: Map<string, FormSnapshot>; // `${subjectId}/${form}` (turn/chunk subjects)\n    72\t  maxEventOrder: number;\n    73\t  formCounts: Record<string, Record<string, number>>; // form → state → count\n    74\t}\n    75\t\n    76\texport interface ArrangementEntry {\n    77\t  band: Band;\n    78\t  subjectKind: \"turn\" | \"chunk\";\n    79\t  subjectId: string;\n    80\t  formUsed: string;\n    81\t  degraded: boolean;\n    82\t  gap: boolean;\n    83\t  reason?: string; // gap entries\n    84\t  startOrder: number; // oldest event order the entry represents (notes included)\n    85\t  text: string; // rendered entry text (the band stores this verbatim)\n    86\t  tokens: number;\n    87\t}\n    88\t\n    89\texport interface SelectionResult {\n    90\t  compactPoint: number;\n    91\t  coveredFrom: number;\n    92\t  // Gradient order (brief → detailed → smooth), oldest-first within band —\n    93\t  // the order the bands render and the arrangement persists.\n    94\t  entries: ArrangementEntry[];\n    95\t}\n    96\t\n    97\t// ── reads (corruption check lives here, pre-transaction) ─────────\n    98\t\n    99\texport function readSelectionInputs(db: DatabaseSync): SelectionInputs {\n   100\t  const turnRows = db\n   101\t    .prepare(\n   102\t      `SELECT turn_id, turn_order, status, opened_at_event_order, closed_at_event_order, deleted_at\n   103\t       FROM turns ORDER BY turn_order`,\n   104\t    )\n   105\t    .all() as unknown as Array<{\n   106\t    turn_id: string;\n   107\t    turn_order: number | bigint;\n   108\t    status: string;\n   109\t    opened_at_event_order: number | bigint;\n   110\t    closed_at_event_order: number | bigint | null;\n   111\t    deleted_at: string | null;\n   112\t  }>;\n   113\t  // Referential checks compare against every turn row (a tombstoned turn is\n   114\t  // a legitimate reference target, not damage); the selection walk itself\n   115\t  // sees live turns only.\n   116\t  const turnIds = new Set(turnRows.map((row) => row.turn_id));\n   117\t  const turns: SelectionTurn[] = turnRows\n   118\t    .filter((row) => row.deleted_at === null)\n   119\t    .map((row) => ({\n   120\t      turnId: row.turn_id,\n   121\t      turnOrder: Number(row.turn_order),\n   122\t      status: row.status as \"open\" | \"closed\",\n   123\t      openedAt: Number(row.opened_at_event_order),\n   124\t      closedAt: row.closed_at_event_order === null ? null : Number(row.closed_at_event_order),\n   125\t    }));\n   126\t\n   127\t  // Canonical damage the walk cannot select across (AC-2.5): the Epic 01\n   128\t  // turn-state invariant (at most one open turn, open turns carry no close),\n   129\t  // and referential damage between the chunk/message rows and their turns.\n   130\t  const openTurns = turns.filter((turn) => turn.status === \"open\");\n   131\t  if (openTurns.length > 1) {\n   132\t    throw new CanonicalCorruptionError(\n   133\t      \"turn_state_corrupt\",\n   134\t      `canonical turn state corrupt: ${openTurns.length} open turns (${openTurns\n   135\t        .map((turn) => turn.turnId)\n   136\t        .join(\", \")}); the compacted span cannot be identified`,\n   137\t    );\n   138\t  }\n   139\t  for (const turn of turns) {\n   140\t    if (turn.status === \"closed\" && turn.closedAt === null) {\n   141\t      throw new CanonicalCorruptionError(\n   142\t        \"source_damaged\",\n   143\t        `canonical turn state corrupt: closed turn ${turn.turnId} carries no close boundary`,\n   144\t      );\n   145\t    }\n   146\t  }\n   147\t\n   148\t  const messageRows = db\n   149\t    .prepare(\n   150\t      `SELECT message_id, source_event_order, kind, token_estimate, turn_id\n   151\t       FROM message WHERE deleted_at IS NULL ORDER BY source_event_order`,\n   152\t    )\n   153\t    .all() as unknown as Array<{\n   154\t    message_id: string;\n   155\t    source_event_order: number | bigint;\n   156\t    kind: string;\n   157\t    token_estimate: number | bigint;\n   158\t    turn_id: string | null;\n   159\t  }>;\n   160\t  const blockRows = db\n   161\t    .prepare(\n   162\t      `SELECT mb.message_id, mb.block_type, mb.content\n   163\t       FROM message_block mb JOIN message m ON m.message_id = mb.message_id\n   164\t       WHERE m.deleted_at IS NULL\n   165\t       ORDER BY m.source_event_order, mb.block_index`,\n   166\t    )\n   167\t    .all() as unknown as Array<{ message_id: string; block_type: string; content: string }>;\n   168\t  const blocksByMessage = new Map<\n   169\t    string,\n   170\t    Array<{ blockType: string; content: Record<string, unknown> }>\n   171\t  >();\n   172\t  for (const row of blockRows) {\n   173\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n   174\t    blocks.push({\n   175\t      blockType: row.block_type,\n   176\t      content: JSON.parse(row.content) as Record<string, unknown>,\n   177\t    });\n   178\t    blocksByMessage.set(row.message_id, blocks);\n   179\t  }\n   180\t  const messages: SelectionMessage[] = messageRows.map((row) => {\n   181\t    if (row.turn_id !== null && !turnIds.has(row.turn_id)) {\n   182\t      throw new CanonicalCorruptionError(\n   183\t        \"source_damaged\",\n   184\t        `canonical record corrupt: message ${row.message_id} references missing turn ${row.turn_id}`,\n   185\t      );\n   186\t    }\n   187\t    return {\n   188\t      messageId: row.message_id,\n   189\t      order: Number(row.source_event_order),\n   190\t      kind: row.kind,\n   191\t      tokenEstimate: Number(row.token_estimate),\n   192\t      turnId: row.turn_id,\n   193\t      text: excerptLine(row.kind, blocksByMessage.get(row.message_id) ?? []),\n   194\t    };\n   195\t  });\n   196\t\n   197\t  const chunkRows = db\n   198\t    .prepare(`SELECT chunk_id, chunk_order, status FROM chunk ORDER BY chunk_order`)\n   199\t    .all() as unknown as Array<{ chunk_id: string; chunk_order: number | bigint; status: string }>;\n   200\t  const memberRows = db\n   201\t    .prepare(\n   202\t      `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\n   203\t       JOIN chunk c ON c.chunk_id = cm.chunk_id\n   204\t       ORDER BY c.chunk_order, cm.member_idx`,\n   205\t    )\n   206\t    .all() as unknown as Array<{ chunk_id: string; turn_id: string; member_idx: number | bigint }>;\n   207\t  const membersByChunk = new Map<string, string[]>();\n   208\t  for (const row of memberRows) {\n   209\t    if (!turnIds.has(row.turn_id)) {\n   210\t      throw new CanonicalCorruptionError(\n   211\t        \"source_damaged\",\n   212\t        `canonical record corrupt: chunk ${row.chunk_id} membership references missing turn ${row.turn_id}`,\n   213\t      );\n   214\t    }\n   215\t    const members = membersByChunk.get(row.chunk_id) ?? [];\n   216\t    members.push(row.turn_id);\n   217\t    membersByChunk.set(row.chunk_id, members);\n   218\t  }\n   219\t  const chunks: SelectionChunk[] = chunkRows.map((row) => ({\n   220\t    chunkId: row.chunk_id,\n   221\t    chunkOrder: Number(row.chunk_order),\n   222\t    status: row.status as \"open\" | \"closed\",\n   223\t    memberTurnIds: membersByChunk.get(row.chunk_id) ?? [],\n   224\t  }));\n   225\t\n   226\t  const formRows = db\n   227\t    .prepare(\n   228\t      `SELECT subject_id, form, state, content, reason FROM derived_form\n   229\t       WHERE subject_kind IN ('turn', 'chunk')`,\n   230\t    )\n   231\t    .all() as unknown as Array<{\n   232\t    subject_id: string;\n   233\t    form: string;\n   234\t    state: string;\n   235\t    content: string | null;\n   236\t    reason: string | null;\n   237\t  }>;\n   238\t  const forms = new Map<string, FormSnapshot>();\n   239\t  for (const row of formRows) {\n   240\t    const snapshot: FormSnapshot = { state: row.state as FormSnapshot[\"state\"] };\n   241\t    if (row.content !== null) snapshot.content = row.content;\n   242\t    if (row.reason !== null) snapshot.reason = row.reason;\n   243\t    forms.set(`${row.subject_id}/${row.form}`, snapshot);\n   244\t  }\n   245\t\n   246\t  const maxRow = db.prepare(`SELECT COALESCE(MAX(event_order), 0) AS m FROM event`).get() as {\n   247\t    m: number | bigint;\n   248\t  };\n   249\t  const countRows = db\n   250\t    .prepare(`SELECT form, state, COUNT(*) AS n FROM derived_form GROUP BY form, state`)\n   251\t    .all() as unknown as Array<{ form: string; state: string; n: number | bigint }>;\n   252\t  const formCounts: Record<string, Record<string, number>> = {};\n   253\t  for (const row of countRows) {\n   254\t    formCounts[row.form] = { ...formCounts[row.form], [row.state]: Number(row.n) };\n   255\t  }\n   256\t\n   257\t  return { messages, turns, chunks, forms, maxEventOrder: Number(maxRow.m), formCounts };\n   258\t}\n   259\t\n   260\t// ── the pure walk ─────────────────────────────────────────────────\n   261\t\n   262\texport interface SelectionConfig {\n   263\t  lowerBound: number;\n   264\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\n   265\t}\n   266\t\n   267\texport function selectArrangement(\n   268\t  inputs: SelectionInputs,\n   269\t  config: SelectionConfig,\n   270\t): SelectionResult {\n   271\t  const { messages, turns, chunks, forms } = inputs;\n   272\t  const lookup = (subjectId: string, form: string): FormSnapshot | undefined =>\n   273\t    forms.get(`${subjectId}/${form}`);\n   274\t  const budget = (share: number): number => (config.lowerBound * share) / 100;\n   275\t\n   276\t  const turnsById = new Map(turns.map((turn) => [turn.turnId, turn]));\n   277\t  const messagesByTurn = new Map<string, SelectionMessage[]>();\n   278\t  for (const message of messages) {\n   279\t    if (message.turnId === null) continue;\n   280\t    const list = messagesByTurn.get(message.turnId) ?? [];\n   281\t    list.push(message);\n   282\t    messagesByTurn.set(message.turnId, list);\n   283\t  }\n   284\t\n   285\t  // Rule 6: turnless stragglers attach to the FOLLOWING turn — they ride its\n   286\t  // band assignment, price into its fill cost, and render marked immediately\n   287\t  // before its entry. No following turn ⇒ tail by construction.\n   288\t  const notesByTurn = new Map<string, SelectionMessage[]>();\n   289\t  for (const message of messages) {\n   290\t    if (message.turnId !== null) continue;\n   291\t    const following = turns.find((turn) => turn.openedAt > message.order);\n   292\t    if (following === undefined) continue; // trailing straggler: tail\n   293\t    const list = notesByTurn.get(following.turnId) ?? [];\n   294\t    list.push(message);\n   295\t    notesByTurn.set(following.turnId, list);\n   296\t  }\n   297\t\n   298\t  // The oldest event order a turn's entry represents: its oldest live\n   299\t  // message or attached note, falling back to its open boundary.\n   300\t  function turnStartOrder(turn: SelectionTurn): number {\n   301\t    const candidates = [\n   302\t      ...(messagesByTurn.get(turn.turnId) ?? []).map((message) => message.order),\n   303\t      ...(notesByTurn.get(turn.turnId) ?? []).map((note) => note.order),\n   304\t    ];\n   305\t    return candidates.length === 0 ? turn.openedAt : Math.min(...candidates);\n   306\t  }\n   307\t\n   308\t  // Rule 1 — compact point: messages newest-first until the estimate sum\n   309\t  // first reaches the full share; the point snaps to a turn boundary so the\n   310\t  // tail never begins mid-turn. Open-turn messages always land in the tail.\n   311\t  const fullBudget = budget(config.percentages.full);\n   312\t  const closedTurns = turns.filter((turn) => turn.status === \"closed\");\n   313\t  let compactPoint = 0;\n   314\t  if (closedTurns.length > 0 && messages.length > 0) {\n   315\t    let sum = 0;\n   316\t    let crossing: SelectionMessage | null = null;\n   317\t    for (let i = messages.length - 1; i >= 0; i -= 1) {\n   318\t      const message = messages[i] as SelectionMessage;\n   319\t      sum += message.tokenEstimate;\n   320\t      if (sum >= fullBudget) {\n   321\t        crossing = message;\n   322\t        break;\n   323\t      }\n   324\t    }\n   325\t    // Budget never reached ⇒ the whole record fits the full share:\n   326\t    // everything is tail, no bands.\n   327\t    compactPoint = crossing === null ? 0 : snapCompactPoint(crossing);\n   328\t  }\n   329\t\n   330\t  function snapCompactPoint(oldestTaken: SelectionMessage): number {\n   331\t    // The turn whose boundary the point snaps against: the message's own\n   332\t    // turn, or — for a turnless straggler — the turn it attaches to.\n   333\t    let candidate: SelectionTurn | undefined =\n   334\t      oldestTaken.turnId !== null ? turnsById.get(oldestTaken.turnId) : undefined;\n   335\t    if (candidate === undefined && oldestTaken.turnId === null) {\n   336\t      candidate = turns.find((turn) => turn.openedAt > oldestTaken.order);\n   337\t    }\n   338\t    const previousClose = (turn: SelectionTurn): number => {\n   339\t      const previous = closedTurns.filter((t) => t.turnOrder < turn.turnOrder).at(-1);\n   340\t      return previous?.closedAt ?? 0;\n   341\t    };\n   342\t    if (candidate === undefined) {\n   343\t      // A trailing straggler with no following turn sits after the last turn\n   344\t      // boundary, where the compact point cannot pass it: tail begins after\n   345\t      // the newest closed turn.\n   346\t      return closedTurns.at(-1)?.closedAt ?? 0;\n   347\t    }\n   348\t    if (candidate.status === \"open\") {\n   349\t      // Open-turn messages are tail regardless of budget; the tail begins at\n   350\t      // the open turn's start.\n   351\t      return previousClose(candidate);\n   352\t    }\n   353\t    // Fully covered down to the turn's start (notes included) ⇒ the tail\n   354\t    // begins at this turn; otherwise snap FORWARD to the next turn start —\n   355\t    // the partially-covered turn falls whole to the bands.\n   356\t    if (oldestTaken.order <= turnStartOrder(candidate)) {\n   357\t      return previousClose(candidate);\n   358\t    }\n   359\t    return candidate.closedAt ?? 0;\n   360\t  }\n   361\t\n   362\t  // Band candidates: closed turns wholly behind the compact point. Rule 5 is\n   363\t  // structural here — chunked or not, a banded turn is a smooth candidate\n   364\t  // (bands are defined by representation, not strict time strata).\n   365\t  const bandedTurns = closedTurns.filter(\n   366\t    (turn) => turn.closedAt !== null && turn.closedAt <= compactPoint,\n   367\t  );\n   368\t  const bandedTurnIds = new Set(bandedTurns.map((turn) => turn.turnId));\n   369\t\n   370\t  function buildTurnEntry(turn: SelectionTurn): ArrangementEntry {\n   371\t    const turnMessages = messagesByTurn.get(turn.turnId) ?? [];\n   372\t    const excerpt =\n   373\t      turnMessages.length === 0 ? null : turnMessages.map((message) => message.text).join(\"\\n\");\n   374\t    const rep = resolveSmoothRepresentation(turn.turnId, lookup, excerpt);\n   375\t    const noteTexts = (notesByTurn.get(turn.turnId) ?? []).map((note) => note.text);\n   376\t    const text = renderArrangementEntry(\"turn\", turn.turnId, rep, noteTexts);\n   377\t    const entry: ArrangementEntry = {\n   378\t      band: \"smooth\",\n   379\t      subjectKind: \"turn\",\n   380\t      subjectId: turn.turnId,\n   381\t      formUsed: rep.formUsed,\n   382\t      degraded: rep.degraded,\n   383\t      gap: rep.gap,\n   384\t      startOrder: turnStartOrder(turn),\n   385\t      text,\n   386\t      tokens: estimateTokens(text),\n   387\t    };\n   388\t    if (rep.reason !== undefined) entry.reason = rep.reason;\n   389\t    return entry;\n   390\t  }\n   391\t\n   392\t  function buildChunkEntry(chunk: SelectionChunk, band: \"detailed\" | \"brief\"): ArrangementEntry {\n   393\t    const memberProjections = chunk.memberTurnIds\n   394\t      .map((turnId) => lookup(turnId, \"lower_band_projection\"))\n   395\t      .filter((form): form is FormSnapshot & { content: string } => form?.state === \"ready\")\n   396\t      .map((form) => form.content ?? \"\")\n   397\t      .filter((content) => content.length > 0);\n   398\t    const rep =\n   399\t      band === \"detailed\"\n   400\t        ? resolveDetailedRepresentation(chunk.chunkId, lookup, memberProjections)\n   401\t        : resolveBriefRepresentation(chunk.chunkId, lookup);\n   402\t    const noteTexts = chunk.memberTurnIds.flatMap((turnId) =>\n   403\t      (notesByTurn.get(turnId) ?? []).map((note) => note.text),\n   404\t    );\n   405\t    const text = renderArrangementEntry(\"chunk\", chunk.chunkId, rep, noteTexts);\n   406\t    const memberStarts = chunk.memberTurnIds\n   407\t      .map((turnId) => turnsById.get(turnId))\n   408\t      .filter((turn): turn is SelectionTurn => turn !== undefined)\n   409\t      .map((turn) => turnStartOrder(turn));\n   410\t    const entry: ArrangementEntry = {\n   411\t      band,\n   412\t      subjectKind: \"chunk\",\n   413\t      subjectId: chunk.chunkId,\n   414\t      formUsed: rep.formUsed,\n   415\t      degraded: rep.degraded,\n   416\t      gap: rep.gap,\n   417\t      startOrder: memberStarts.length === 0 ? compactPoint : Math.min(...memberStarts),\n   418\t      text,\n   419\t      tokens: estimateTokens(text),\n   420\t    };\n   421\t    if (rep.reason !== undefined) entry.reason = rep.reason;\n   422\t    return entry;\n   423\t  }\n   424\t\n   425\t  // Chunk representation is available to a turn only through a closed chunk\n   426\t  // whose live members ALL sit behind the compact point — a chunk straddling\n   427\t  // the tail (or still open) cannot stand in for its banded members. Such\n   428\t  // members are smooth-obligate: the smooth band is their only\n   429\t  // representation, so the walk always includes them — this is AC-2.4's\n   430\t  // sanctioned over-bound case (\"an indivisible turn … included by the\n   431\t  // selection rules\") and what keeps every span in the compacted range\n   432\t  // accounted for (AC-2.5, TC-2.3's no-silent-absence).\n   433\t  const liveMembersOf = (chunk: SelectionChunk): SelectionTurn[] =>\n   434\t    chunk.memberTurnIds\n   435\t      .map((turnId) => turnsById.get(turnId))\n   436\t      .filter((turn): turn is SelectionTurn => turn !== undefined);\n   437\t  const fullyBandedChunks = chunks.filter((chunk) => {\n   438\t    const members = liveMembersOf(chunk);\n   439\t    return (\n   440\t      chunk.status === \"closed\" &&\n   441\t      members.length > 0 &&\n   442\t      members.every((turn) => bandedTurnIds.has(turn.turnId))\n   443\t    );\n   444\t  });\n   445\t  const chunkRepresentableTurnIds = new Set(\n   446\t    fullyBandedChunks.flatMap((chunk) => chunk.memberTurnIds),\n   447\t  );\n   448\t\n   449\t  // Rule 2 + 5 — smooth band: banded closed turns, newest-first (chunked or\n   450\t  // not — rule 5 is structural). Obligates always include; chunk-representable\n   451\t  // turns fill against the share with ≤ inclusion, and the first crossing one\n   452\t  // stops admission — the remainder takes chunk representation.\n   453\t  const smoothBudget = budget(config.percentages.smooth);\n   454\t  const smoothIncluded: ArrangementEntry[] = [];\n   455\t  let smoothSum = 0;\n   456\t  let smoothStopped = false;\n   457\t  for (const turn of [...bandedTurns].reverse()) {\n   458\t    const entry = buildTurnEntry(turn);\n   459\t    if (!chunkRepresentableTurnIds.has(turn.turnId)) {\n   460\t      smoothIncluded.push(entry);\n   461\t      smoothSum += entry.tokens;\n   462\t      continue;\n   463\t    }\n   464\t    if (smoothStopped) continue;\n   465\t    if (smoothSum + entry.tokens <= smoothBudget) {\n   466\t      smoothIncluded.push(entry);\n   467\t      smoothSum += entry.tokens;\n   468\t      continue;\n   469\t    }\n   470\t    if (smoothIncluded.length === 0) {\n   471\t      // Oversized loner on an otherwise-empty band: one turn still represents.\n   472\t      smoothIncluded.push(entry);\n   473\t    }\n   474\t    smoothStopped = true;\n   475\t  }\n   476\t\n   477\t  // Partial-chunk retreat: when the budget stop (or the loner rule) leaves a\n   478\t  // fully-banded chunk split — some members in the smooth band, some not —\n   479\t  // the included members retreat to the chunk, which then represents whole in\n   480\t  // a chunk band. Bands are defined by representation; a chunk can stand in\n   481\t  // for all of its members or none, never a slice (the alternative leaves the\n   482\t  // unincluded slice represented nowhere).\n   483\t  const smoothTurnIdSet = (): Set<string> =>\n   484\t    new Set(smoothIncluded.map((entry) => entry.subjectId));\n   485\t  for (const chunk of fullyBandedChunks) {\n   486\t    const inSmooth = smoothTurnIdSet();\n   487\t    const members = liveMembersOf(chunk);\n   488\t    const includedMembers = members.filter((turn) => inSmooth.has(turn.turnId));\n   489\t    if (includedMembers.length > 0 && includedMembers.length < members.length) {\n   490\t      const retreatIds = new Set(includedMembers.map((turn) => turn.turnId));\n   491\t      for (let i = smoothIncluded.length - 1; i >= 0; i -= 1) {\n   492\t        const entry = smoothIncluded[i] as ArrangementEntry;\n   493\t        if (retreatIds.has(entry.subjectId)) smoothIncluded.splice(i, 1);\n   494\t      }\n   495\t    }\n   496\t  }\n   497\t  const smoothTurnIds = smoothTurnIdSet();\n   498\t\n   499\t  // Rules 3–4 — chunk candidacy: fully banded, nothing already represented\n   500\t  // smoothly (\"entirely older than the smooth band's coverage\", with the\n   501\t  // newest-member tie-breaker subsumed by the retreat above). Newest-first.\n   502\t  const chunkCandidates = fullyBandedChunks\n   503\t    .filter((chunk) => liveMembersOf(chunk).every((turn) => !smoothTurnIds.has(turn.turnId)))\n   504\t    .reverse();\n   505\t\n   506\t  // Detailed fill: ≤ inclusion, crossing chunk stops the band, one oversized\n   507\t  // chunk still represents on an empty band (rule 3's \"same fill rule\").\n   508\t  function fillChunkBand(\n   509\t    candidates: readonly SelectionChunk[],\n   510\t    bandBudget: number,\n   511\t    band: \"detailed\" | \"brief\",\n   512\t    lonerException: boolean,\n   513\t  ): { included: ArrangementEntry[]; rest: SelectionChunk[] } {\n   514\t    const included: ArrangementEntry[] = [];\n   515\t    let sum = 0;\n   516\t    for (let i = 0; i < candidates.length; i += 1) {\n   517\t      const entry = buildChunkEntry(candidates[i] as SelectionChunk, band);\n   518\t      if (sum + entry.tokens <= bandBudget) {\n   519\t        included.push(entry);\n   520\t        sum += entry.tokens;\n","exit_code":0,"status":"completed"}}

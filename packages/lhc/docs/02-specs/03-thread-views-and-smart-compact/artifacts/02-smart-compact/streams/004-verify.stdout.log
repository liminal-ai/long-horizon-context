{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/view-compact.test.ts | sed -n '258,560p'\"","aggregated_output":"   258\tdescribe(\"TC-2.6 (AC-2.10): band entries carry their subject keys visibly\", () => {\n   259\t  it(\"chunk keys in brief/detailed text, turn keys in smooth text\", async () => {\n   260\t    const receipt = await fixture.sdk.threadView.compact(\n   261\t      { filePath: fixture.filePath },\n   262\t      { params: GRADIENT_PARAMS },\n   263\t    );\n   264\t    expect(receipt.ok).toBe(true);\n   265\t\n   266\t    const messages = await pullMessages(fixture.sdk, fixture.filePath);\n   267\t    const bands = bandMessages(messages);\n   268\t    const byBand = new Map(bands.map((message) => [message.band, message.content]));\n   269\t    expect(byBand.get(\"brief\")).toMatch(/§c\\d+/);\n   270\t    expect(byBand.get(\"detailed\")).toMatch(/§c\\d+/);\n   271\t    expect(byBand.get(\"smooth\")).toMatch(/§t\\d+/);\n   272\t    expect(byBand.get(\"smooth\")).not.toMatch(/§c\\d+/);\n   273\t  });\n   274\t});\n   275\t\n   276\tdescribe(\"architecture-risk: coverage edge accounting\", () => {\n   277\t  it(\"excluded old chunks set covered_from, the receipt reports the window, and no phantom gaps appear\", async () => {\n   278\t    const receipt = await fixture.sdk.threadView.compact(\n   279\t      { filePath: fixture.filePath },\n   280\t      { params: EDGE_PARAMS },\n   281\t    );\n   282\t    expect(receipt.ok).toBe(true);\n   283\t    if (!receipt.ok) return;\n   284\t\n   285\t    // Brief budget (2% of 120) cannot hold c1: the oldest chunk is outside\n   286\t    // the view. covered_from lands at c2's start — t4's prompt, event 13 —\n   287\t    // and the exclusion is visible as coveredFrom > first event.\n   288\t    expect(receipt.value.compactPoint).toBe(48);\n   289\t    expect(receipt.value.coveredFrom).toBe(13);\n   290\t    expect(receipt.value.bands.brief.entries).toBe(0);\n   291\t    // No silent omission AND no phantom gap entries for the out-of-window\n   292\t    // chunk: gaps report unusable material, not the window's edge.\n   293\t    expect(receipt.value.gaps).toEqual([]);\n   294\t\n   295\t    const messages = await pullMessages(fixture.sdk, fixture.filePath);\n   296\t    const bandText = bandMessages(messages)\n   297\t      .map((message) => message.content)\n   298\t      .join(\"\\n\");\n   299\t    expect(bandText).not.toContain(\"§c1\");\n   300\t    expect(bandText).toContain(\"§c2\");\n   301\t  });\n   302\t});\n   303\t\n   304\tdescribe(\"architecture-risk: restart serves the snapshot (real-file durability)\", () => {\n   305\t  it(\"a fresh SDK on the same file pulls byte-identical band content\", async () => {\n   306\t    const receipt = await fixture.sdk.threadView.compact(\n   307\t      { filePath: fixture.filePath },\n   308\t      { params: GRADIENT_PARAMS },\n   309\t    );\n   310\t    expect(receipt.ok).toBe(true);\n   311\t    const before = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n   312\t    expect(before.ok).toBe(true);\n   313\t    if (!before.ok) return;\n   314\t\n   315\t    // Not a same-process reread: a fresh SDK instance opens the file cold.\n   316\t    const fresh = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n   317\t    const after = await fresh.threadView.pull({ filePath: fixture.filePath });\n   318\t    expect(after.ok).toBe(true);\n   319\t    if (!after.ok) return;\n   320\t    expect(JSON.stringify(after.value)).toBe(JSON.stringify(before.value));\n   321\t  });\n   322\t});\n   323\t\n   324\tdescribe(\"TC-2.4 (AC-2.6): crash injection at the compact-write point\", () => {\n   325\t  it(\"an injected crash leaves the previous view serving; the rerun lands clean with no partial state\", async () => {\n   326\t    const first = await fixture.sdk.threadView.compact(\n   327\t      { filePath: fixture.filePath },\n   328\t      { params: GRADIENT_PARAMS },\n   329\t    );\n   330\t    expect(first.ok).toBe(true);\n   331\t    const priorPull = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n   332\t    expect(priorPull.ok).toBe(true);\n   333\t    if (!priorPull.ok) return;\n   334\t    expect(boundaryPosition(fixture.filePath)).toBe(48);\n   335\t\n   336\t    setViewInjectionHook(\"compact-write\", () => {\n   337\t      throw new Error(\"injected crash between sweep and view write\");\n   338\t    });\n   339\t    try {\n   340\t      const crashed = await fixture.sdk.threadView.compact(\n   341\t        { filePath: fixture.filePath },\n   342\t        { params: EDGE_PARAMS },\n   343\t      );\n   344\t      expect(crashed.ok).toBe(false);\n   345\t      if (crashed.ok) return;\n   346\t      expect(crashed.error.errorClass).toBe(\"system_error\");\n   347\t      expect(crashed.error.reason).toContain(\"injected crash\");\n   348\t    } finally {\n   349\t      setViewInjectionHook(\"compact-write\", null);\n   350\t    }\n   351\t\n   352\t    // The previous view still serves, byte-identical; no partial rows, no\n   353\t    // boundary movement.\n   354\t    const afterCrash = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n   355\t    expect(afterCrash.ok).toBe(true);\n   356\t    if (!afterCrash.ok) return;\n   357\t    expect(JSON.stringify(afterCrash.value)).toBe(JSON.stringify(priorPull.value));\n   358\t    expect(viewRowCount(fixture.filePath)).toBe(1);\n   359\t    expect(boundaryPosition(fixture.filePath)).toBe(48);\n   360\t\n   361\t    // Rerun: the new view lands whole and the boundary resets with it.\n   362\t    const rerun = await fixture.sdk.threadView.compact(\n   363\t      { filePath: fixture.filePath },\n   364\t      { params: EDGE_PARAMS },\n   365\t    );\n   366\t    expect(rerun.ok).toBe(true);\n   367\t    if (!rerun.ok) return;\n   368\t    expect(rerun.value.coveredFrom).toBe(13);\n   369\t    expect(viewRowCount(fixture.filePath)).toBe(1);\n   370\t    expect(boundaryPosition(fixture.filePath)).toBe(48);\n   371\t    const rerunPull = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n   372\t    expect(rerunPull.ok).toBe(true);\n   373\t    if (!rerunPull.ok) return;\n   374\t    expect(JSON.stringify(rerunPull.value)).not.toBe(JSON.stringify(priorPull.value));\n   375\t  });\n   376\t});\n   377\t\n   378\t// ── degraded thread (TC-2.3 + the TC-2.5 view-health completion legs) ──\n   379\t\n   380\t// The fixture conversation rebuilt with manufactured derived damage, all\n   381\t// through production paths: c1's brief summary exhausts through scripted\n   382\t// retryable provider failures at build; post-build edits clear t8's turn\n   383\t// forms and all of c2's dependent chain to pending (the Epic 02 cascade) —\n   384\t// a pending turn rendering for the smooth band, and a chunk with no usable\n   385\t// form at all (summaries pending, zero ready member projections) for the\n   386\t// gap rung.\n   387\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n   388\tconst C1_BRIEF_EXHAUST_REASON = \"rate_limit: scripted c1 brief exhaustion (test)\";\n   389\t\n   390\tfunction degradedTurnEvents(turn: number): MessageEventInput[] {\n   391\t  const events: MessageEventInput[] = [\n   392\t    validEvent(\"user_prompt\", { payload: { text: `turn ${turn}: please investigate area ${turn}` } }),\n   393\t    validEvent(\"assistant_thinking\", { payload: { text: `considering what area ${turn} contains` } }),\n   394\t  ];\n   395\t  if (TOOL_HEAVY_TURNS.has(turn)) {\n   396\t    for (const run of [1, 2]) {\n   397\t      const toolCallId = `call-dg-${turn}-${run}`;\n   398\t      events.push(\n   399\t        validEvent(\"tool_call\", {\n   400\t          payload: { toolCallId, toolName: \"read_file\", arguments: { path: `area-${turn}/file-${run}.txt` } },\n   401\t        }),\n   402\t        validEvent(\"tool_result\", {\n   403\t          payload: {\n   404\t            toolCallId,\n   405\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n   406\t            isError: false,\n   407\t          },\n   408\t        }),\n   409\t      );\n   410\t    }\n   411\t  }\n   412\t  events.push(\n   413\t    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n   414\t    validEvent(\"turn_end\"),\n   415\t  );\n   416\t  return events;\n   417\t}\n   418\t\n   419\tinterface DegradedThread {\n   420\t  filePath: string;\n   421\t  sdk: Lhc;\n   422\t  double: ProviderDouble;\n   423\t  promptIdByTurn: Map<number, string>;\n   424\t}\n   425\t\n   426\tasync function buildDegradedThread(intoStore: TempStore): Promise<DegradedThread> {\n   427\t  const double = createProviderDouble();\n   428\t  const sdk = createSdk({\n   429\t    provider: double,\n   430\t    mode: \"manual\",\n   431\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n   432\t    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\n   433\t  });\n   434\t  const filePath = intoStore.threadPath();\n   435\t  const created = await sdk.threads.newThread({ filePath, registryPath: intoStore.registryPath });\n   436\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n   437\t\n   438\t  const promptIdByTurn = new Map<number, string>();\n   439\t  for (let turn = 1; turn <= 12; turn += 1) {\n   440\t    if (turn === 4) {\n   441\t      // c1 closes during turn 4's drain (placement of t4): its brief summary\n   442\t      // exhausts through real retry mechanics — a FAILED chunk summary.\n   443\t      double.failKind(\"chunk_summary_brief\", 3, {\n   444\t        retryable: true,\n   445\t        reason: C1_BRIEF_EXHAUST_REASON,\n   446\t      });\n   447\t    }\n   448\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, degradedTurnEvents(turn));\n   449\t    if (!sent.ok) throw new Error(`intake failed: ${sent.error.reason}`);\n   450\t    const promptId = sent.value.events[0]?.messageId;\n   451\t    if (promptId !== undefined && promptId !== null) promptIdByTurn.set(turn, promptId);\n   452\t    const drained = await sdk.work.drain({ filePath });\n   453\t    if (!drained.ok) throw new Error(`drain failed: ${drained.error.reason}`);\n   454\t  }\n   455\t\n   456\t  // Post-build edits, NOT drained: the cascade clears each edited message's\n   457\t  // dependent chain to pending. t8 ⇒ a PENDING turn rendering in the smooth\n   458\t  // band; t4+t5+t6 ⇒ c2's summaries pending with zero ready member\n   459\t  // projections — the gap rung.\n   460\t  for (const turn of [4, 5, 6, 8]) {\n   461\t    const promptId = promptIdByTurn.get(turn);\n   462\t    if (promptId === undefined) throw new Error(`no prompt id recorded for turn ${turn}`);\n   463\t    const edited = await sdk.messages.edit(\n   464\t      { filePath },\n   465\t      { messageId: promptId, content: `turn ${turn}: edited investigation of area ${turn}` },\n   466\t    );\n   467\t    if (!edited.ok) throw new Error(`edit failed: ${edited.error.reason}`);\n   468\t  }\n   469\t  return { filePath, sdk, double, promptIdByTurn };\n   470\t}\n   471\t\n   472\tdescribe(\"TC-2.3 (AC-2.5, AC-2.7) + TC-2.5 view-health legs: degraded material renders fallbacks, never fails the compact\", () => {\n   473\t  let degradedStore: TempStore;\n   474\t  let degraded: DegradedThread;\n   475\t\n   476\t  beforeAll(async () => {\n   477\t    degradedStore = tempStore();\n   478\t    degraded = await buildDegradedThread(degradedStore);\n   479\t  });\n   480\t  afterAll(() => {\n   481\t    degradedStore.cleanup();\n   482\t  });\n   483\t\n   484\t  it(\"completes with ladder fallbacks marked, gap entries for unusable spans, and full accounting in the receipt\", async () => {\n   485\t    const captured = degraded.double.captureInputs();\n   486\t    const capturedBefore = captured.length;\n   487\t\n   488\t    const receipt = await degraded.sdk.threadView.compact(\n   489\t      { filePath: degraded.filePath },\n   490\t      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 10, brief: 40 } } },\n   491\t    );\n   492\t    expect(receipt.ok).toBe(true);\n   493\t    if (!receipt.ok) return;\n   494\t\n   495\t    // The pending turn rendering (t8, edited): the smooth entry degrades down\n   496\t    // its ladder (projection pending too) to the deterministic excerpt.\n   497\t    const t8 = receipt.value.degraded.find((entry) => entry.subjectId === \"t8\");\n   498\t    expect(t8).toBeDefined();\n   499\t    expect(t8?.band).toBe(\"smooth\");\n   500\t    expect(t8?.usedForm).toBe(\"message_excerpt\");\n   501\t\n   502\t    // The failed chunk summary (c1's brief): the brief entry renders the\n   503\t    // truncated detailed summary, marked.\n   504\t    const c1 = receipt.value.degraded.find((entry) => entry.subjectId === \"c1\");\n   505\t    expect(c1).toBeDefined();\n   506\t    expect(c1?.band).toBe(\"brief\");\n   507\t    expect(c1?.usedForm).toBe(\"chunk_summary_detailed_truncated\");\n   508\t\n   509\t    // The unusable chunk (c2: summaries pending, zero ready member\n   510\t    // projections): an explicit gap entry with its reason — never absence.\n   511\t    expect(receipt.value.gaps).toHaveLength(1);\n   512\t    const gap = receipt.value.gaps[0];\n   513\t    expect(gap?.subjectId).toBe(\"c2\");\n   514\t    expect(gap?.reason).toMatch(/no usable form/);\n   515\t    expect(gap?.reason).toContain(\"chunk_summary_detailed: pending\");\n   516\t\n   517\t    // Per-band counts present; no span silently absent: every turn in the\n   518\t    // compacted range is accounted for by a band subject (c1: t1–t3, c2:\n   519\t    // t4–t6, smooth: t7–t8) and everything after the compact point is tail.\n   520\t    expect(receipt.value.bands.brief.entries).toBe(1);\n   521\t    expect(receipt.value.bands.detailed.entries).toBe(1);\n   522\t    expect(receipt.value.bands.smooth.entries).toBe(2);\n   523\t    expect(receipt.value.compactPoint).toBe(48);\n   524\t    expect(receipt.value.coveredFrom).toBe(1);\n   525\t\n   526\t    // The rendered text carries the markers (degrade visibly, AC-2.5/2.10).\n   527\t    const messages = await pullMessages(degraded.sdk, degraded.filePath);\n   528\t    const bandText = bandMessages(messages)\n   529\t      .map((message) => message.content)\n   530\t      .join(\"\\n\\n\");\n   531\t    expect(bandText).toContain(\"[degraded: brief-from-detailed]\");\n   532\t    expect(bandText).toContain(\"[degraded: smooth-from-excerpt]\");\n   533\t    expect(bandText).toMatch(/§c2 \\[chunk c2 unavailable: no usable form/);\n   534\t\n   535\t    // Zero provider calls: missing material degrades, it is never re-derived\n   536\t    // inline (AC-2.4's no-inference rule with teeth).\n   537\t    expect(captured.length).toBe(capturedBefore);\n   538\t  });\n   539\t\n   540\t  it(\"status reports the view-health fields live after the degraded compact (TC-2.5 completion leg)\", async () => {\n   541\t    const status = await degraded.sdk.threadView.status({ filePath: degraded.filePath });\n   542\t    expect(status.ok).toBe(true);\n   543\t    if (!status.ok) return;\n   544\t    expect(status.value.view).not.toBeNull();\n   545\t    expect(status.value.view?.degraded).toBe(2);\n   546\t    expect(status.value.view?.gaps).toBe(1);\n   547\t    expect(typeof status.value.view?.builtAt).toBe(\"string\");\n   548\t    // The edits' requeued rebuild work is visible as pending derivation.\n   549\t    expect(status.value.derivation.pending).toBeGreaterThan(0);\n   550\t  });\n   551\t});\n   552\t\n   553\tdescribe(\"TC-2.7 (AC-2.5): canonical corruption refuses; derived-only damage degrades\", () => {\n   554\t  it(\"refuses with state_corruption naming the damage; the prior view still serves; record unchanged\", async () => {\n   555\t    const corruptStore = tempStore();\n   556\t    try {\n   557\t      const double = createProviderDouble();\n   558\t      const sdk = createSdk({ provider: double, mode: \"manual\" });\n   559\t      const filePath = corruptStore.threadPath();\n   560\t      const created = await sdk.threads.newThread({\n","exit_code":0,"status":"completed"}}

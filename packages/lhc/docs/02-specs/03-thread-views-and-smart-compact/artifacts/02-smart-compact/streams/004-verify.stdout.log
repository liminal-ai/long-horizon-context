iewConfig,\\\\n  SweepReceipt,\\\\n  ViewMessage,\\\\n  ViewProfile,\\\\n  ViewStatus,\\\\n} from \\\\\\\"../../shared/view.js\\\\\\\";\\\\nimport * as messagesDomain from \\\\\\\"../messages/index.js\\\\\\\";\\\",\\\"stderr\\\":\\\"\\\",\\\"interrupted\\\":false,\\\"isImage\\\":false,\\\"noOutputExpected\\\":false}}\\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3580:{\\\"type\\\":\\\"stream_event\\\",\\\"event\\\":{\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":0,\\\"delta\\\":{\\\"type\\\":\\\"input_json_delta\\\",\\\"partial_json\\\":\\\"\\\\\\\", \\\\\\\"old_string\\\\\\\": \\\\\\\"import type {\\\\\\\\n  CompactReceipt,\\\\\\\\n  PullResult,\\\\\\\\n  SweepReceipt,\\\\\\\\n  ViewProfile,\\\\\\\\n  ViewStatus\\\"}},\\\"session_id\\\":\\\"8dde17a3-d739-40da-bd65-ee3687cdd63f\\\",\\\"parent_tool_use_id\\\":null,\\\"uuid\\\":\\\"5bdafa6f-3709-4a0c-b414-14a6a30ba416\\\"}\\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3582:{\\\"type\\\":\\\"stream_event\\\",\\\"event\\\":{\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":0,\\\"delta\\\":{\\\"type\\\":\\\"input_json_delta\\\",\\\"partial_json\\\":\\\"\\\\\\\", \\\\\\\"new_string\\\\\\\": \\\\\\\"import type {\\\\\\\\n  CompactReceipt,\\\\\\\\n  PullResult,\\\\\\\\n  S\\\"}},\\\"session_id\\\":\\\"8dde17a3-d739-40da-bd65-ee3687cdd63f\\\",\\\"parent_tool_use_id\\\":null,\\\"uuid\\\":\\\"4c273f52-f26e-4b28-9db1-8ddb5d950d5b\\\"}\\npackages/lhc/docs/02-specs/03-thread-views-and-smart-compact/artifacts/02-smart-compact/streams/003-implementor.stdout.log:3583:{\\\"type\\\":\\\"stream_event\\\",\\\"event\\\":{\\\"type\\\":\\\"content_block_delta\\\",\\\"index\\\":0,\\\"delta\\\":{\\\"type\\\":\\\"input_json_delta\\\",\\\"partial_json\\\":\\\"weepReceipt,\\\\\\\\n  ViewCompactParams,\\\\\\\\n  ViewProfile,\\\\\\\\n  ViewStatus,\\\\\\\\n} from \\\\\\\\\\\\\\\"
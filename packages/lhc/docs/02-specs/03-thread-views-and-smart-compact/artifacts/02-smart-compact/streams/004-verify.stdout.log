etailed: 10, brief: 10 } } },\n   595\t      );\n   596\t      expect(refused.ok).toBe(false);\n   597\t      if (refused.ok) return;\n   598\t      expect(refused.error.errorClass).toBe(\"state_corruption\");\n   599\t      expect(refused.error.code).toBe(\"turn_state_corrupt\");\n   600\t      expect(refused.error.reason).toMatch(/open turns/);\n   601\t\n   602\t      // Pre-transaction refusal: prior view serves byte-identically, record\n   603\t      // untouched.\n   604\t      const afterPull = await sdk.threadView.pull({ filePath });\n   605\t      expect(afterPull.ok).toBe(true);\n   606\t      if (!afterPull.ok) return;\n   607\t      expect(JSON.stringify(afterPull.value.messages.filter((m) => m.band !== undefined))).toBe(\n   608\t        JSON.stringify(priorPull.value.messages.filter((m) => m.band !== undefined)),\n   609\t      );\n   610\t      expect(afterPull.value.meta.viewId).toBe(priorPull.value.meta.viewId);\n   611\t      expect(recordSnapshot(filePath)).toBe(recordBefore);\n   612\t    } finally {\n   613\t      corruptStore.cleanup();\n   614\t    }\n   615\t  });\n   616\t\n   617\t  it(\"control: a thread with only derived-material damage compacts successfully with gaps\", async () => {\n   618\t    // The suite fixture carries two scripted FAILED tool_result_summary forms\n   619\t    // (derived damage only) and compacts clean throughout this file; the\n   620\t    // explicit control here is the degraded build: summaries pending/failed,\n   621\t    // zero usable forms on c2 — and the compact above completed with a gap\n   622\t    // rather than refusing. Re-assert the contrast directly on the main\n   623\t    // fixture: derived failures present, compact succeeds, no state_corruption.\n   624\t    const receipt = await fixture.sdk.threadView.compact(\n   625\t      { filePath: fixture.filePath },\n   626\t      { params: GRADIENT_PARAMS },\n   627\t    );\n   628\t    expect(receipt.ok).toBe(true);\n   629\t  });\n   630\t});\n   631\t\n   632\tdescribe(\"TC-1.3 (AC-1.4) and TC-1.5 (AC-1.6): snapshot immutability under record mutation\", () => {\n   633\t  let mutStore: TempStore;\n   634\t  let mut: DerivedThreadFixture;\n   635\t\n   636\t  beforeAll(async () => {\n   637\t    mutStore = tempStore();\n   638\t    mut = await derivedThreadFixture(mutStore, { failures: false });\n   639\t    const receipt = await mut.sdk.threadView.compact(\n   640\t      { filePath: mut.filePath },\n   641\t      { params: GRADIENT_PARAMS },\n   642\t    );\n   643\t    if (!receipt.ok) throw new Error(`setup compact failed: ${receipt.error.reason}`);\n   644\t  });\n   645\t  afterAll(() => {\n   646\t    mutStore.cleanup();\n   647\t  });\n   648\t\n   649\t  it(\"TC-1.3: editing a banded subject leaves band bytes unchanged across pulls, before and after the drain\", async () => {\n   650\t    const before = bandMessages(await pullMessages(mut.sdk, mut.filePath));\n   651\t    const bandHash = sha256(before);\n   652\t\n   653\t    // t5 is banded inside c2's detailed entry; edit its prompt.\n   654\t    const listed = await mut.sdk.messages.listMessages({ filePath: mut.filePath });\n   655\t    expect(listed.ok).toBe(true);\n   656\t    if (!listed.ok) return;\n   657\t    const t5Prompt = listed.value.find((m) => m.turnId === \"t5\" && m.kind === \"user_prompt\");\n   658\t    expect(t5Prompt).toBeDefined();\n   659\t    if (t5Prompt === undefined) return;\n   660\t    const edited = await mut.sdk.messages.edit(\n   661\t      { filePath: mut.filePath },\n   662\t      { messageId: t5Prompt.messageId, content: \"turn 5: edited after the snapshot\" },\n   663\t    );\n   664\t    expect(edited.ok).toBe(true);\n   665\t\n   666\t    const afterEdit = bandMessages(await pullMessages(mut.sdk, mut.filePath));\n   667\t    expect(sha256(afterEdit)).toBe(bandHash);\n   668\t\n   669\t    // Drain the requeued rebuilds: the rebuilt summary lands in the RECORD\n   670\t    // only; the snapshot still serves the same bytes.\n   671\t    const drained = await mut.sdk.work.drain({ filePath: mut.filePath });\n   672\t    expect(drained.ok).toBe(true);\n   673\t    const afterDrain = bandMessages(await pullMessages(mut.sdk, mut.filePath));\n   674\t    expect(sha256(afterDrain)).toBe(bandHash);\n   675\t\n   676\t    // The record really changed underneath: c2's rebuilt detailed summary is\n   677\t    // not the text the band serves.\n   678\t    const db = openRaw(mut.filePath);\n   679\t    try {\n   680\t      const row = db\n   681\t        .prepare(\n   682\t          `SELECT content FROM derived_form\n   683\t           WHERE subject_kind = 'chunk' AND subject_id = 'c2' AND form = 'chunk_summary_detailed'`,\n   684\t        )\n   685\t        .get() as { content: string | null } | undefined;\n   686\t      expect(row?.content).toBeDefined();\n   687\t      const detailedBand = afterDrain.find((m) => m.band === \"detailed\");\n   688\t      expect(detailedBand?.content).not.toContain(row?.content ?? \"<unset>\");\n   689\t    } finally {\n   690\t      db.close();\n   691\t    }\n   692\t  });\n   693\t\n   694\t  it(\"TC-1.5: a tail delete vanishes from the next pull; a banded delete leaves the snapshot until the next compact\", async () => {\n   695\t    const listed = await mut.sdk.messages.listMessages({ filePath: mut.filePath });\n   696\t    expect(listed.ok).toBe(true);\n   697\t    if (!listed.ok) return;\n   698\t\n   699\t    // Tail region: t9 onward (compact point 48). Delete t10's findings.\n   700\t    const tailTarget = listed.value.find((m) => m.turnId === \"t10\" && m.kind === \"assistant_text\");\n   701\t    expect(tailTarget).toBeDefined();\n   702\t    if (tailTarget === undefined) return;\n   703\t    const statusBefore = await mut.sdk.threadView.status({ filePath: mut.filePath });\n   704\t    expect(statusBefore.ok).toBe(true);\n   705\t    if (!statusBefore.ok) return;\n   706\t\n   707\t    const tailDelete = await mut.sdk.messages.deleteMessage(\n   708\t      { filePath: mut.filePath },\n   709\t      { messageId: tailTarget.messageId },\n   710\t    );\n   711\t    expect(tailDelete.ok).toBe(true);\n   712\t    const afterTailDelete = await pullMessages(mut.sdk, mut.filePath);\n   713\t    expect(\n   714\t      afterTailDelete.some((m) => m.content === \"findings for area 10\"),\n   715\t    ).toBe(false);\n   716\t\n   717\t    // The record change is visible to the status read (tail sum shrank).\n   718\t    const statusAfter = await mut.sdk.threadView.status({ filePath: mut.filePath });\n   719\t    expect(statusAfter.ok).toBe(true);\n   720\t    if (!statusAfter.ok) return;\n   721\t    expect(statusAfter.value.tailTokens).toBeLessThan(statusBefore.value.tailTokens);\n   722\t\n   723\t    // Banded region: delete a t6 message whose derived content sits inside\n   724\t    // c2's band entry. The snapshot is untouched until the next compact.\n   725\t    const bandsBefore = bandMessages(afterTailDelete);\n   726\t    const bandTarget = listed.value.find((m) => m.turnId === \"t6\" && m.kind === \"assistant_text\");\n   727\t    expect(bandTarget).toBeDefined();\n   728\t    if (bandTarget === undefined) return;\n   729\t    const bandedDelete = await mut.sdk.messages.deleteMessage(\n   730\t      { filePath: mut.filePath },\n   731\t      { messageId: bandTarget.messageId },\n   732\t    );\n   733\t    expect(bandedDelete.ok).toBe(true);\n   734\t\n   735\t    const afterBandedDelete = await pullMessages(mut.sdk, mut.filePath);\n   736\t    expect(sha256(bandMessages(afterBandedDelete))).toBe(sha256(bandsBefore));\n   737\t\n   738\t    // Next-compact visibility: the record changed under the snapshot — the\n   739\t    // delete's cascade left rebuild work pending in the status read.\n   740\t    const statusFinal = await mut.sdk.threadView.status({ filePath: mut.filePath });\n   741\t    expect(statusFinal.ok).toBe(true);\n   742\t    if (!statusFinal.ok) return;\n   743\t    expect(statusFinal.value.derivation.pending).toBeGreaterThan(0);\n   744\t  });\n   745\t});\n","exit_code":0,"status":"completed"}}

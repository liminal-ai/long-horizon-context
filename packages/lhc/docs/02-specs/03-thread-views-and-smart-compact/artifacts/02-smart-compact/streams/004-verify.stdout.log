{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/internal/render.ts | sed -n '1,460p'\"","aggregated_output":"     1\t// Tail and band formatting (Story 1): the seven-kind tail mapping table\n     2\t// (tech design §Tail message rendering — contract, not implementation\n     3\t// choice), short/full tool-result selection by boundary position, and the\n     4\t// short-form ladder (ready summary → deterministic truncation). Pure\n     5\t// functions over read state by design: no DB handle, no provider, no clock —\n     6\t// determinism is structural (AC-1.7 byte-identical pulls fall out of it).\n     7\t//\n     8\t// Story 2 adds the band-entry side: the degrade ladders (tech design\n     9\t// §Degrade ladders), gap entries as the last rung (never absence, AC-2.5),\n    10\t// visible subject keys (§t12 / §c4, AC-2.10), the [degraded: …] and\n    11\t// [inter-turn note] markers, and band-text assembly. select.ts consumes the\n    12\t// same entry renderer to price entries during the fill walk, so the tokens\n    13\t// the walk budgets are the tokens the band stores — one renderer, no drift.\n    14\timport type { Band, ViewMessage } from \"../../../shared/view.js\";\n    15\timport type { TailMessageRow } from \"./snapshot.js\";\n    16\t\n    17\t// Epic 01's deterministic abbreviation rule: a fixed prefix plus an exact\n    18\t// tail marker, a pure function of the input string alone. Restated here —\n    19\t// byte-identical to turns/internal/compose.ts's truncateForFallback —\n    20\t// because cross-domain internals may not be imported and the turns domain\n    21\t// is frozen for this epic (tech design §Top-Tier Surfaces: no changes).\n    22\texport const ABBREVIATION_LIMIT = 200;\n    23\t\n    24\texport function deterministicTruncation(text: string): string {\n    25\t  if (text.length <= ABBREVIATION_LIMIT) return text;\n    26\t  const dropped = text.length - ABBREVIATION_LIMIT;\n    27\t  return `${text.slice(0, ABBREVIATION_LIMIT)}… [truncated ${dropped} chars]`;\n    28\t}\n    29\t\n    30\tfunction blockContent(message: TailMessageRow): Record<string, unknown> {\n    31\t  return message.blocks[0]?.content ?? {};\n    32\t}\n    33\t\n    34\tfunction textOf(message: TailMessageRow): string {\n    35\t  const text = blockContent(message)[\"text\"];\n    36\t  return typeof text === \"string\" ? text : \"\";\n    37\t}\n    38\t\n    39\t// What the tail renderer needs beyond the message itself: the boundary\n    40\t// position (short/full selection), the call-id → tool-name pairing (results\n    41\t// carry only their call id), and the ready tool-result summaries (the\n    42\t// short-form ladder's first rung).\n    43\texport interface TailRenderContext {\n    44\t  boundaryPosition: number;\n    45\t  toolNameByCallId: ReadonlyMap<string, string>;\n    46\t  toolResultSummaries: ReadonlyMap<string, string>;\n    47\t}\n    48\t\n    49\t// The call-id → tool-name map from the messages in hand. Pairing within the\n    50\t// tail is structurally sufficient: the compact point snaps to a turn start,\n    51\t// so a tail result's call is never behind it.\n    52\texport function toolNamesByCallId(\n    53\t  messages: readonly TailMessageRow[],\n    54\t): Map<string, string> {\n    55\t  const names = new Map<string, string>();\n    56\t  for (const message of messages) {\n    57\t    if (message.kind !== \"tool_call\") continue;\n    58\t    const block = blockContent(message);\n    59\t    const callId = block[\"toolCallId\"];\n    60\t    const toolName = block[\"toolName\"];\n    61\t    if (typeof callId === \"string\" && typeof toolName === \"string\") {\n    62\t      names.set(callId, toolName);\n    63\t    }\n    64\t  }\n    65\t  return names;\n    66\t}\n    67\t\n    68\tfunction renderToolCall(message: TailMessageRow): ViewMessage {\n    69\t  const block = blockContent(message);\n    70\t  const name = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n    71\t  // Deterministic arg rendering: the projected arguments serialized verbatim,\n    72\t  // oversized args abbreviated by the same Epic 01 rule.\n    73\t  const args = deterministicTruncation(JSON.stringify(block[\"arguments\"] ?? {}));\n    74\t  return { role: \"assistant\", content: `[tool call · ${name}] ${args}` };\n    75\t}\n    76\t\n    77\tfunction renderToolResult(message: TailMessageRow, ctx: TailRenderContext): ViewMessage {\n    78\t  const block = blockContent(message);\n    79\t  const callId = block[\"toolCallId\"];\n    80\t  const name =\n    81\t    (typeof callId === \"string\" ? ctx.toolNameByCallId.get(callId) : undefined) ??\n    82\t    \"unknown_tool\";\n    83\t  const content = typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\";\n    84\t  if (message.sourceEventOrder > ctx.boundaryPosition) {\n    85\t    return { role: \"user\", content: `[tool result · ${name}]\\n${content}` };\n    86\t  }\n    87\t  // At-or-behind the boundary: the short-form ladder — the ready summary\n    88\t  // when usable, else deterministic truncation of the raw content (AC-4.2's\n    89\t  // vocabulary; the default-boundary leg lands here in Story 1). Short-form\n    90\t  // rendering marks that fuller content exists in the record.\n    91\t  const short = ctx.toolResultSummaries.get(message.messageId) ?? deterministicTruncation(content);\n    92\t  return {\n    93\t    role: \"user\",\n    94\t    content: `[tool result · ${name} · abridged]\\n${short} [full content in record §${message.messageId}]`,\n    95\t  };\n    96\t}\n    97\t\n    98\t// One tail message → one ViewMessage per the mapping table. Each kind is its\n    99\t// own arm so a single kind's drift fails its own named test leg.\n   100\texport function renderTailMessage(\n   101\t  message: TailMessageRow,\n   102\t  ctx: TailRenderContext,\n   103\t): ViewMessage {\n   104\t  switch (message.kind) {\n   105\t    case \"user_prompt\":\n   106\t      return { role: \"user\", content: textOf(message) };\n   107\t    case \"assistant_text\":\n   108\t      return { role: \"assistant\", content: textOf(message) };\n   109\t    case \"assistant_thinking\":\n   110\t      // Included: the tail is full fidelity (bands compress thinking away for\n   111\t      // older turns); harness-side conversion may re-block or drop.\n   112\t      return { role: \"assistant\", content: `[thinking]\\n${textOf(message)}\\n[/thinking]` };\n   113\t    case \"tool_call\":\n   114\t      return renderToolCall(message);\n   115\t    case \"tool_result\":\n   116\t      return renderToolResult(message, ctx);\n   117\t    case \"runtime_note\":\n   118\t      return { role: \"user\", content: `[runtime note] ${textOf(message)}` };\n   119\t  }\n   120\t}\n   121\t\n   122\t// One non-empty band → one labeled `user` message: band-marker header, then\n   123\t// the snapshot bytes verbatim (AC-5.1 resolution: provider APIs reject\n   124\t// unknown roles; `user` is what the MVP's injection used).\n   125\texport function renderBandMessage(band: Band, renderedText: string): ViewMessage {\n   126\t  return { role: \"user\", band, content: `[context · ${band}]\\n${renderedText}` };\n   127\t}\n   128\t\n   129\t// ── band entries: degrade ladders, gaps, keys (Story 2) ──────────\n   130\t\n   131\t// One derived form's stored state as the ladder reads it (a projection of\n   132\t// DerivedForm: the resolvers never write, never re-derive).\n   133\texport interface FormSnapshot {\n   134\t  state: \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n   135\t  content?: string;\n   136\t  reason?: string;\n   137\t}\n   138\t\n   139\texport type FormLookup = (subjectId: string, form: string) => FormSnapshot | undefined;\n   140\t\n   141\t// A subject's resolved representation: which rung of its ladder renders.\n   142\t// `formUsed` is the arrangement/receipt vocabulary; `degradedMarker` is the\n   143\t// rendered [degraded: …] text for fallback rungs.\n   144\texport interface ResolvedRepresentation {\n   145\t  formUsed: string;\n   146\t  body: string;\n   147\t  degraded: boolean;\n   148\t  gap: boolean;\n   149\t  degradedMarker?: string;\n   150\t  reason?: string;\n   151\t}\n   152\t\n   153\tfunction usable(form: FormSnapshot | undefined): form is FormSnapshot & { content: string } {\n   154\t  // \"Usable\" means state = ready (tech design §Degrade ladders).\n   155\t  return form?.state === \"ready\" && typeof form.content === \"string\";\n   156\t}\n   157\t\n   158\tfunction ladderState(form: FormSnapshot | undefined): string {\n   159\t  return form === undefined ? \"absent\" : form.state;\n   160\t}\n   161\t\n   162\t// Smooth (turn) ladder: turn_rendering → lower_band_projection →\n   163\t// deterministic excerpt of the turn's live messages → gap entry.\n   164\texport function resolveSmoothRepresentation(\n   165\t  turnId: string,\n   166\t  lookup: FormLookup,\n   167\t  excerpt: string | null,\n   168\t): ResolvedRepresentation {\n   169\t  const rendering = lookup(turnId, \"turn_rendering\");\n   170\t  if (usable(rendering)) {\n   171\t    return { formUsed: \"turn_rendering\", body: rendering.content, degraded: false, gap: false };\n   172\t  }\n   173\t  const projection = lookup(turnId, \"lower_band_projection\");\n   174\t  if (usable(projection)) {\n   175\t    return {\n   176\t      formUsed: \"lower_band_projection\",\n   177\t      body: projection.content,\n   178\t      degraded: true,\n   179\t      gap: false,\n   180\t      degradedMarker: \"smooth-from-projection\",\n   181\t    };\n   182\t  }\n   183\t  if (excerpt !== null) {\n   184\t    return {\n   185\t      formUsed: \"message_excerpt\",\n   186\t      body: deterministicTruncation(excerpt),\n   187\t      degraded: true,\n   188\t      gap: false,\n   189\t      degradedMarker: \"smooth-from-excerpt\",\n   190\t    };\n   191\t  }\n   192\t  return {\n   193\t    formUsed: \"gap\",\n   194\t    body: \"\",\n   195\t    degraded: false,\n   196\t    gap: true,\n   197\t    reason: `no usable form (turn_rendering: ${ladderState(rendering)}, lower_band_projection: ${ladderState(projection)}, no live messages)`,\n   198\t  };\n   199\t}\n   200\t\n   201\t// Detailed (chunk) ladder: chunk_summary_detailed → chunk_summary_brief →\n   202\t// concatenated member projections (truncated, marked) → gap entry.\n   203\texport function resolveDetailedRepresentation(\n   204\t  chunkId: string,\n   205\t  lookup: FormLookup,\n   206\t  memberProjections: readonly string[],\n   207\t): ResolvedRepresentation {\n   208\t  const detailed = lookup(chunkId, \"chunk_summary_detailed\");\n   209\t  if (usable(detailed)) {\n   210\t    return { formUsed: \"chunk_summary_detailed\", body: detailed.content, degraded: false, gap: false };\n   211\t  }\n   212\t  const brief = lookup(chunkId, \"chunk_summary_brief\");\n   213\t  if (usable(brief)) {\n   214\t    return {\n   215\t      formUsed: \"chunk_summary_brief\",\n   216\t      body: brief.content,\n   217\t      degraded: true,\n   218\t      gap: false,\n   219\t      degradedMarker: \"detailed-from-brief\",\n   220\t    };\n   221\t  }\n   222\t  if (memberProjections.length > 0) {\n   223\t    return {\n   224\t      formUsed: \"member_projections\",\n   225\t      body: deterministicTruncation(memberProjections.join(\"\\n\")),\n   226\t      degraded: true,\n   227\t      gap: false,\n   228\t      degradedMarker: \"detailed-from-projections\",\n   229\t    };\n   230\t  }\n   231\t  return {\n   232\t    formUsed: \"gap\",\n   233\t    body: \"\",\n   234\t    degraded: false,\n   235\t    gap: true,\n   236\t    reason: `no usable form (chunk_summary_detailed: ${ladderState(detailed)}, chunk_summary_brief: ${ladderState(brief)}, member projections ready: 0)`,\n   237\t  };\n   238\t}\n   239\t\n   240\t// Brief (chunk) ladder: chunk_summary_brief → chunk_summary_detailed\n   241\t// truncated → gap entry (no projections rung in this band's ladder).\n   242\texport function resolveBriefRepresentation(\n   243\t  chunkId: string,\n   244\t  lookup: FormLookup,\n   245\t): ResolvedRepresentation {\n   246\t  const brief = lookup(chunkId, \"chunk_summary_brief\");\n   247\t  if (usable(brief)) {\n   248\t    return { formUsed: \"chunk_summary_brief\", body: brief.content, degraded: false, gap: false };\n   249\t  }\n   250\t  const detailed = lookup(chunkId, \"chunk_summary_detailed\");\n   251\t  if (usable(detailed)) {\n   252\t    return {\n   253\t      formUsed: \"chunk_summary_detailed_truncated\",\n   254\t      body: deterministicTruncation(detailed.content),\n   255\t      degraded: true,\n   256\t      gap: false,\n   257\t      degradedMarker: \"brief-from-detailed\",\n   258\t    };\n   259\t  }\n   260\t  return {\n   261\t    formUsed: \"gap\",\n   262\t    body: \"\",\n   263\t    degraded: false,\n   264\t    gap: true,\n   265\t    reason: `no usable form (chunk_summary_brief: ${ladderState(brief)}, chunk_summary_detailed: ${ladderState(detailed)}, member projections ready: 0)`,\n   266\t  };\n   267\t}\n   268\t\n   269\t// The per-message line an excerpt or note renders — a compact, deterministic\n   270\t// projection of the raw record (last-rung fallback, not the tail mapping).\n   271\texport function excerptLine(\n   272\t  kind: string,\n   273\t  blocks: ReadonlyArray<{ blockType: string; content: Record<string, unknown> }>,\n   274\t): string {\n   275\t  const content = blocks[0]?.content ?? {};\n   276\t  const text = typeof content[\"text\"] === \"string\" ? content[\"text\"] : \"\";\n   277\t  switch (kind) {\n   278\t    case \"tool_call\": {\n   279\t      const name = typeof content[\"toolName\"] === \"string\" ? content[\"toolName\"] : \"unknown_tool\";\n   280\t      return `[tool call · ${name}]`;\n   281\t    }\n   282\t    case \"tool_result\":\n   283\t      return \"[tool result]\";\n   284\t    default:\n   285\t      return text;\n   286\t  }\n   287\t}\n   288\t\n   289\t// One selected subject → its band-entry text: any attached inter-turn notes\n   290\t// (rule 6: rendered raw with the marker, immediately before the entry), then\n   291\t// the keyed entry — §key, [degraded: …] when a fallback rung rendered, or the\n   292\t// gap line as the last rung. select.ts prices exactly this text in the fill\n   293\t// walk; the band stores exactly this text.\n   294\texport function renderArrangementEntry(\n   295\t  subjectKind: \"turn\" | \"chunk\",\n   296\t  subjectId: string,\n   297\t  rep: ResolvedRepresentation,\n   298\t  noteTexts: readonly string[],\n   299\t): string {\n   300\t  const lines = noteTexts.map((text) => `[inter-turn note] ${text}`);\n   301\t  if (rep.gap) {\n   302\t    lines.push(`§${subjectId} [${subjectKind} ${subjectId} unavailable: ${rep.reason ?? \"unknown\"}]`);\n   303\t  } else {\n   304\t    const marker = rep.degraded ? ` [degraded: ${rep.degradedMarker ?? rep.formUsed}]` : \"\";\n   305\t    lines.push(`§${subjectId}${marker}\\n${rep.body}`);\n   306\t  }\n   307\t  return lines.join(\"\\n\");\n   308\t}\n   309\t\n   310\t// A band's snapshot bytes: its entries oldest-first, blank-line separated.\n   311\texport function assembleBandText(entryTexts: readonly string[]): string {\n   312\t  return entryTexts.join(\"\\n\\n\");\n   313\t}\n","exit_code":0,"status":"completed"}}

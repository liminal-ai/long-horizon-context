{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/view-seam.ts | sed -n '1,120p'\"","aggregated_output":"     1\t// Epic 03 Story 0 view-domain test seams. Lives in fixtures/ — the one\n     2\t// directory sanctioned to reach below the SDK surface (boundary check\n     3\t// exempt).\n     4\t//\n     5\t// The injection facility (FC-0.6): re-export of the thread-view seam so\n     6\t// tests install crash/failure hooks at the two named points — the\n     7\t// post-commit advance (TC-4.6) and compact's write path between sweep and\n     8\t// view write (TC-2.4). Uninstalled, production fires are no-ops.\n     9\texport {\n    10\t  fireViewInjection,\n    11\t  setViewInjectionHook,\n    12\t  type ViewInjectionHook,\n    13\t  type ViewInjectionPoint,\n    14\t} from \"../../src/domains/thread-view/internal/seam.js\";\n    15\t\n    16\timport { DatabaseSync } from \"node:sqlite\";\n    17\t\n    18\t// Sanctioned below-SDK write (same sanctioning as corrupt.ts): seeds the\n    19\t// view_boundary row to an arbitrary position for TC-1.4's mid-tail pulls.\n    20\t// Boundary *mechanics* — how the position legally moves — are Story 4's to\n    21\t// prove; this helper only manufactures a position the pull must respect.\n    22\t// UPDATE-only on purpose: migration v6 seeded the singleton row, mirroring\n    23\t// the production advance's write shape.\n    24\texport function seedViewBoundary(filePath: string, position: number): void {\n    25\t  const db = new DatabaseSync(filePath);\n    26\t  try {\n    27\t    const changed = db\n    28\t      .prepare(\n    29\t        `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\n    30\t      )\n    31\t      .run(position, new Date().toISOString());\n    32\t    if (Number(changed.changes) !== 1) {\n    33\t      throw new Error(\n    34\t        `fixture seedViewBoundary hit ${String(changed.changes)} rows; expected the migration-seeded singleton`,\n    35\t      );\n    36\t    }\n    37\t  } finally {\n    38\t    db.close();\n    39\t  }\n    40\t}\n","exit_code":0,"status":"completed"}}

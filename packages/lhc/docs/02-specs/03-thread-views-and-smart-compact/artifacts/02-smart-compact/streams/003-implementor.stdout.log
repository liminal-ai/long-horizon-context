{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UZ1GfMTG1RuLT4DjSv4GAx","type":"tool_result","content":"120\t\n121\tdescribe(\"TC-1.1 (AC-1.2, AC-1.3): never-compacted thread pulls the full conversation in order; later intake appends\", () => {\n122\t  it(\"carries both intake rounds in record order with tail-only meta\", async () => {\n123\t    const sdk = manualSdk();\n124\t    const filePath = await newThread(sdk);\n125\t    await intake(sdk, filePath, [\n126\t      validEvent(\"user_prompt\", { payload: { text: \"first question\" } }),\n127\t      validEvent(\"assistant_text\", { payload: { text: \"first answer\" } }),\n128\t      validEvent(\"turn_end\"),\n129\t    ]);\n130\t\n131\t    const first = await sdk.threadView.pull({ filePath });\n132\t    expect(first.ok).toBe(true);\n133\t    if (!first.ok) return;\n134\t    expect(first.value.messages).toEqual([\n135\t      { role: \"user\", content: \"first question\" },\n136\t      { role: \"assistant\", content: \"first answer\" },\n137\t    ]);\n138\t    // Never compacted: no band content, no error, tail from event 1 (AC-1.3).\n139\t    expect(first.value.messages.every((m) => m.band === undefined)).toBe(true);\n140\t    expect(first.value.meta).toEqual({\n141\t      compactPoint: null,\n142\t      coveredFrom: null,\n143\t      boundaryPosition: 0,\n144\t      gapCount: 0,\n145\t      degradedCount: 0,\n146\t      viewId: null,\n147\t      createdAt: null,\n148\t    });\n149\t\n150\t    await intake(sdk, filePath, [\n151\t      validEvent(\"user_prompt\", { payload: { text: \"second question\" } }),\n152\t      validEvent(\"assistant_text\", { payload: { text: \"second answer\" } }),\n153\t      validEvent(\"turn_end\"),\n154\t    ]);\n155\t    const second = await sdk.threadView.pull({ filePath });\n156\t    expect(second.ok).toBe(true);\n157\t    if (!second.ok) return;\n158\t    // All committed intake appears, in record order; the new batch appends\n159\t    // after the first round's messages, which are byte-unchanged (AC-1.2).\n160\t    expect(second.value.messages).toEqual([\n161\t      { role: \"user\", content: \"first question\" },\n162\t      { role: \"assistant\", content: \"first answer\" },\n163\t      { role: \"user\", content: \"second question\" },\n164\t      { role: \"assistant\", content: \"second answer\" },\n165\t    ]);\n166\t  });\n167\t});\n168\t\n169\tdescribe(\"TC-1.2 (AC-1.1, AC-1.7): two pulls with nothing between are byte-identical and create no work or provider calls\", () => {\n170\t  it(\"hashes identical, zero work rows created, provider double observes zero calls\", async () => {\n171\t    // The double's capture log starts recording here; any Epic 03 read that\n172\t    // touched the provider would append to it (zero-provider assertion, pull\n173\t    // leg of the suite-wide architecture-risk row).\n174\t    const captured = fixture.double.captureInputs();\n175\t    const before = stateSnapshot(fixture.filePath);\n176\t    const workRowsBefore = workItemCount(fixture.filePath);\n177\t\n178\t    const one = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n179\t    const two = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n180\t    expect(one.ok && two.ok).toBe(true);\n181\t    if (!one.ok || !two.ok) return;\n182\t\n183\t    // Byte-identical via the FULL serialized result, not field spot-checks\n184\t    // (story Anti-Shim Requirements).\n185\t    expect(sha256(one.value)).toBe(sha256(two.value));\n186\t    expect(JSON.stringify(one.value)).toBe(JSON.stringify(two.value));\n187\t\n188\t    expect(workItemCount(fixture.filePath)).toBe(workRowsBefore);\n189\t    expect(stateSnapshot(fixture.filePath)).toEqual(before);\n190\t    expect(captured.length).toBe(0);\n191\t  });\n192\t});\n193\t\n194\tdescribe(\"tail mapping legs (architecture-risk): one named leg per message kind\", () => {\n195\t  let sdk: Lhc;\n196\t  let filePath: string;\n197\t  let pulled: ViewMessage[];\n198\t\n199\t  beforeAll(async () => {\n200\t    sdk = manualSdk();\n201\t    filePath = await newThread(sdk);\n202\t    await intake(sdk, filePath, [\n203\t      validEvent(\"user_prompt\", { payload: { text: \"mapping prompt\" } }),\n204\t      validEvent(\"assistant_thinking\", { payload: { text: \"mapping thought\" } }),\n205\t      validEvent(\"tool_call\", {\n206\t        payload: { toolCallId: \"call-map-1\", toolName: \"read_file\", arguments: { path: \"map.txt\" } },\n207\t      }),\n208\t      validEvent(\"tool_result\", {\n209\t        payload: { toolCallId: \"call-map-1\", content: \"mapping output\", isError: false },\n210\t      }),\n211\t      validEvent(\"runtime_note\", { payload: { text: \"mapping note\" } }),\n212\t      validEvent(\"assistant_text\", { payload: { text: \"mapping answer\" } }),\n213\t      validEvent(\"turn_end\"),\n214\t    ]);\n215\t    const result = await sdk.threadView.pull({ filePath });\n216\t    if (!result.ok) throw new Error(`pull failed: ${result.error.reason}`);\n217\t    pulled = result.value.messages;\n218\t  });\n219\t\n220\t  it(\"user_prompt: user role, text verbatim\", () => {\n221\t    expect(pulled[0]).toEqual({ role: \"user\", content: \"mapping prompt\" });\n222\t  });\n223\t\n224\t  it(\"assistant_thinking: assistant role, fenced [thinking] block\", () => {\n225\t    expect(pulled[1]).toEqual({\n226\t      role: \"assistant\",\n227\t      content: \"[thinking]\\nmapping thought\\n[/thinking]\",\n228\t    });\n229\t  });\n230\t\n231\t  it(\"tool_call: assistant role, name marker plus deterministic arg rendering\", () => {\n232\t    expect(pulled[2]).toEqual({\n233\t      role: \"assistant\",\n234\t      content: '[tool call · read_file] {\"path\":\"map.txt\"}',\n235\t    });\n236\t  });\n237\t\n238\t  it(\"tool_result ahead of the boundary: user role, name marker plus full content\", () => {\n239\t    expect(pulled[3]).toEqual({\n240\t      role: \"user\",\n241\t      content: \"[tool result · read_file]\\nmapping output\",\n242\t    });\n243\t  });\n244\t\n245\t  it(\"runtime_note: user role, [runtime note] marker plus text\", () => {\n246\t    expect(pulled[4]).toEqual({ role: \"user\", content: \"[runtime note] mapping note\" });\n247\t  });\n248\t\n249\t  it(\"assistant_text: assistant role, text verbatim\", () => {\n250\t    expect(pulled[5]).toEqual({ role: \"assistant\", content: \"mapping answer\" });\n251\t  });\n252\t\n253\t  it(\"tool_result at-or-behind the boundary: abridged marker plus short form (boundary seeded below-SDK)\", async () => {\n254\t    const listed = await sdk.messages.listMessages({ filePath });\n255\t    expect(listed.ok).toBe(true);\n256\t    if (!listed.ok) return;\n257\t    const result = listed.value.find((m) => m.kind === \"tool_result\");\n258\t    expect(result).toBeDefined();\n259\t    if (result === undefined) return;\n260\t    seedViewBoundary(filePath, result.sourceEventOrder);\n261\t\n262\t    const repulled = await sdk.threadView.pull({ filePath });\n263\t    expect(repulled.ok).toBe(true);\n264\t    if (!repulled.ok) return;\n265\t    const short = repulled.value.messages[3];\n266\t    // Summaries are pending on this undrained thread: the short-form ladder\n267\t    // falls to the deterministic truncation rung (content under the limit\n268\t    // passes through whole), with the abridged marker and the record pointer.\n269\t    expect(short).toEqual({\n270\t      role: \"user\",\n271\t      content: `[tool result · read_file · abridged]\\nmapping output [full content in record §${result.messageId}]`,\n272\t    });\n273\t    expect(repulled.value.meta.boundaryPosition).toBe(result.sourceEventOrder);\n274\t  });\n275\t});\n276\t\n277\tdescribe(\"TC-1.4 (AC-1.5): boundary mid-tail — short behind, full ahead, non-tool content full everywhere\", () => {\n278\t  it(\"renders the ready summary behind the boundary and full content ahead of it\", async () => {\n279\t    const sdk = manualSdk();\n280\t    const filePath = await newThread(sdk);\n281\t    for (const turn of [1, 2]) {\n282\t      await intake(sdk, filePath, [\n283\t        validEvent(\"user_prompt\", { payload: { text: `boundary prompt ${turn}` } }),\n284\t        validEvent(\"assistant_thinking\", { payload: { text: `boundary thought ${turn}` } }),\n285\t        validEvent(\"tool_call\", {\n286\t          payload: {\n287\t            toolCallId: `call-bd-${turn}`,\n288\t            toolName: \"read_file\",\n289\t            arguments: { path: `bd-${turn}.txt` },\n290\t          },\n291\t        }),\n292\t        validEvent(\"tool_result\", {\n293\t          payload: { toolCallId: `call-bd-${turn}`, content: `boundary output ${turn}`, isError: false },\n294\t        }),\n295\t        validEvent(\"assistant_text\", { payload: { text: `boundary answer ${turn}` } }),\n296\t        validEvent(\"turn_end\"),\n297\t      ]);\n298\t    }\n299\t    // Drain through the real Epic 02 machinery so the tool-result summaries\n300\t    // are ready — the short-form ladder's first rung.\n301\t    const drained = await sdk.work.drain({ filePath });\n302\t    expect(drained.ok).toBe(true);\n303\t\n304\t    const listed = await sdk.messages.listMessages({ filePath });\n305\t    expect(listed.ok).toBe(true);\n306\t    if (!listed.ok) return;\n307\t    const results = listed.value.filter((m) => m.kind === \"tool_result\");\n308\t    expect(results).toHaveLength(2);\n309\t    const [behind, ahead] = results;\n310\t    if (behind === undefined || ahead === undefined) return;\n311\t    const behindSummary = behind.forms?.find(\n312\t      (form) => form.form === \"tool_result_summary\" && form.state === \"ready\",\n313\t    );\n314\t    expect(behindSummary?.content).toBeDefined();\n315\t\n316\t    // The sanctioned below-SDK helper seeds the boundary mid-tail: at the\n317\t    // first result's event order (at-or-behind includes it), ahead of nothing\n318\t    // else. Boundary mechanics are Story 4's; only the position's effect on\n319\t    // rendering is under test here.\n320\t    seedViewBoundary(filePath, behind.sourceEventOrder);\n321\t\n322\t    const pull = await sdk.threadView.pull({ filePath });\n323\t    expect(pull.ok).toBe(true);\n324\t    if (!pull.ok) return;\n325\t    const contents = pull.value.messages.map((m) => m.content);\n326\t\n327\t    // Behind: short form — the ready summary verbatim, abridged marker,\n328\t    // record pointer.\n329\t    expect(contents).toContain(\n330\t      `[tool result · read_file · abridged]\\n${behindSummary?.content} [full content in record §${behind.messageId}]`,\n331\t    );\n332\t    // Ahead: full content.\n333\t    expect(contents).toContain(\"[tool result · read_file]\\nboundary output 2\");\n334\t    // Non-tool-result content renders full everywhere, both sides of the\n335\t    // boundary (prompts, thinking, assistant text).\n336\t    for (const turn of [1, 2]) {\n337\t      expect(contents).toContain(`boundary prompt ${turn}`);\n338\t      expect(contents).toContain(`[thinking]\\nboundary thought ${turn}\\n[/thinking]`);\n339\t      expect(contents).toContain(`boundary answer ${turn}`);\n340\t    }\n341\t  });\n342\t\n343\t  it(\"falls to deterministic truncation when no summary is ready and the content is oversized\", async () => {\n344\t    const sdk = manualSdk();\n345\t    const filePath = await newThread(sdk);\n346\t    const longContent = \"x\".repeat(260);\n347\t    await intake(sdk, filePath, [\n348\t      validEvent(\"user_prompt\", { payload: { text: \"truncation prompt\" } }),\n349\t      validEvent(\"tool_call\", {\n350\t        payload: { toolCallId: \"call-tr-1\", toolName: \"read_file\", arguments: { path: \"tr.txt\" } },\n351\t      }),\n352\t      validEvent(\"tool_result\", {\n353\t        payload: { toolCallId: \"call-tr-1\", content: longContent, isError: false },\n354\t      }),\n355\t      validEvent(\"turn_end\"),\n356\t    ]);\n357\t    // No drain: the summary stays pending, so the ladder's truncation rung\n358\t    // renders — fixed 200-char prefix plus the exact dropped-count marker\n359\t    // (Epic 01's abbreviation rule).\n360\t    const listed = await sdk.messages.listMessages({ filePath });\n361\t    expect(listed.ok).toBe(true);\n362\t    if (!listed.ok) return;\n363\t    const result = listed.value.find((m) => m.kind === \"tool_result\");\n364\t    if (result === undefined) return;\n365\t    seedViewBoundary(filePath, result.sourceEventOrder);\n366\t\n367\t    const pull = await sdk.threadView.pull({ filePath });\n368\t    expect(pull.ok).toBe(true);\n369\t    if (!pull.ok) return;\n370\t    const short = pull.value.messages.find((m) => m.content.startsWith(\"[tool result\"));\n371\t    expect(short?.content).toBe(\n372\t      `[tool result · read_file · abridged]\\n${\"x\".repeat(200)}… [truncated 60 chars] [full content in record §${result.messageId}]`,\n373\t    );\n374\t  });\n375\t});\n376\t\n377\tdescribe(\"TC-2.5 pre-compact legs (AC-2.8): the status read on a heavy thread\", () => {\n378\t  // TC-2.5's intake leg mutates its thread, so this describe builds its own\n379\t  // fixture instance instead of sharing the suite's read-only one.\n380\t  let heavyStore: TempStore;\n381\t  let heavy: DerivedThreadFixture;\n382\t  let statusSdk: Lhc;\n383\t\n384\t  beforeAll(async () => {\n385\t    heavyStore = tempStore();\n386\t    heavy = await derivedThreadFixture(heavyStore);\n387\t    // A low threshold makes the fixture \"heavy\" relative to config: the\n388\t    // recommendation must trip without any conversation-scale inflation.\n389\t    statusSdk = manualSdk({ compactThreshold: 100 });\n390\t  });\n391\t  afterAll(() => {\n392\t    heavyStore.cleanup();\n393\t  });\n394\t\n395\t  it(\"reports tail tokens vs threshold, recommendation, derivation counts, null view health, and the zone sum — reads only\", async () => {\n396\t    // Status legs of the zero-provider assertion: the builder's double\n397\t    // records every call from here on; status must add none.\n398\t    const captured = heavy.double.captureInputs();\n399\t    const before = stateSnapshot(heavy.filePath);\n400\t\n401\t    const status = await statusSdk.threadView.status({ filePath: heavy.filePath });\n402\t    expect(status.ok).toBe(true);\n403\t    if (!status.ok) return;\n404\t\n405\t    expect(status.value.threshold).toBe(100);\n406\t    expect(status.value.tailTokens).toBeGreaterThan(100);\n407\t    expect(status.value.compactRecommended).toBe(true);\n408\t\n409\t    // Derivation counts by state, from the owners' report surfaces: the\n410\t    // fixture's two scripted failures (transient-exhausted + permanent), all\n411\t    // other forms drained ready — nothing pending, retrying, or blocked here\n412\t    // (the blocked leg reads the sacrificial sibling below).\n413\t    expect(status.value.derivation).toEqual({ pending: 0, retrying: 0, failed: 2, blocked: 0 });\n414\t\n415\t    // Pre-compact: view health is null, not a zeroed shape (AC-2.8 leg owned\n416\t    // here; the view-health legs complete in Story 2).\n417\t    expect(status.value.view).toBeNull();\n418\t\n419\t    // The visibility zone: boundary at its seeded default 0, so the sum is\n420\t    // every live tool result's estimate — cross-checked against the record.\n421\t    const listed = await statusSdk.messages.listMessages({ filePath: heavy.filePath });\n422\t    expect(listed.ok).toBe(true);\n423\t    if (!listed.ok) return;\n424\t    const expectedZone = listed.value\n425\t      .filter((m) => m.kind === \"tool_result\")\n426\t      .reduce((sum, m) => sum + m.tokenEstimate, 0);\n427\t    expect(status.value.visibility).toEqual({ zoneTokens: expectedZone, maxTokens: 32000 });\n428\t\n429\t    // Reads only: no work rows, no form-state change, no view row, boundary\n430\t    // unmoved, zero provider calls — and no compact occurred uninvoked.\n431\t    expect(stateSnapshot(heavy.filePath)).toEqual(before);\n432\t    expect(captured.length).toBe(0);\n433\t  });\n434\t\n435\t  it(\"counts blocked forms through the owner's report (sacrificial sibling)\", async () => {\n436\t    const sibling = await blockedSiblingThread(heavyStore);\n437\t    const status = await sibling.sdk.threadView.status({ filePath: sibling.filePath });\n438\t    expect(status.ok).toBe(true);\n439\t    if (!status.ok) return;\n440\t    // The sibling's damaged turn landed both turn forms blocked through the\n441\t    // production terminal path (turn_rendering + lower_band_projection).\n442\t    expect(status.value.derivation.blocked).toBe(2);\n443\t    expect(status.value.view).toBeNull();\n444\t  });\n445\t\n446\t  it(\"after more intake the tail grew; still no compact without invocation\", async () => {\n447\t    const first = await statusSdk.threadView.status({ filePath: heavy.filePath });\n448\t    expect(first.ok).toBe(true);\n449\t    if (!first.ok) return;\n450\t\n451\t    await intake(heavy.sdk, heavy.filePath, [\n452\t      validEvent(\"user_prompt\", { payload: { text: \"one more question for the heavy thread\" } }),\n453\t      validEvent(\"assistant_text\", { payload: { text: \"one more answer for the heavy thread\" } }),\n454\t      validEvent(\"turn_end\"),\n455\t    ]);\n456\t\n457\t    const second = await statusSdk.threadView.status({ filePath: heavy.filePath });\n458\t    expect(second.ok).toBe(true);\n459\t    if (!second.ok) return;\n460\t    expect(second.value.tailTokens).toBeGreaterThan(first.value.tailTokens);\n461\t    expect(second.value.view).toBeNull();\n462\t    expect(stateSnapshot(heavy.filePath)[\"viewRows\"]).toBe(0);\n463\t  });\n464\t});\n465\t\n466\tdescribe(\"TC-1.2 / TC-2.5 background legs (SV-01-PULL-STATUS-001): pull and status are reads-only in a background SDK with pending work queued\", () => {\n467\t  it(\"schedules no catch-up drain: work rows, form states, provider count, and status all unchanged; repeated pulls byte-identical\", async () => {\n468\t    // Pending work manufactured through a manual SDK (its no-op seam never\n469\t    // drains): one tool-heavy turn leaves live queue rows and pending forms.\n470\t    const seeder = manualSdk();\n471\t    const filePath = await newThread(seeder);\n472\t    await intake(seeder, filePath, [\n473\t      validEvent(\"user_prompt\", { payload: { text: \"background prompt\" } }),\n474\t      validEvent(\"tool_call\", {\n475\t        payload: { toolCallId: \"call-bg-1\", toolName: \"read_file\", arguments: { path: \"bg.txt\" } },\n476\t      }),\n477\t      validEvent(\"tool_result\", {\n478\t        payload: { toolCallId: \"call-bg-1\", content: \"background output\", isError: false },\n479\t      }),\n480\t      validEvent(\"assistant_text\", { payload: { text: \"background answer\" } }),\n481\t      validEvent(\"turn_end\"),\n482\t    ]);\n483\t    expect(workItemCount(filePath)).toBeGreaterThan(0);\n484\t\n485\t    // The production background path: a fresh background SDK whose scheduler\n486\t    // WOULD hang a first-touch catch-up drain off the open announcement\n487\t    // (openThreadDatabase → fireThreadTouch → scheduler.touch) if pull or\n488\t    // status fired it — the SV-01-PULL-STATUS-001 side-effect path.\n489\t    const bgDouble = createProviderDouble();\n490\t    const bg = createSdk({\n491\t      provider: bgDouble,\n492\t      mode: \"background\",\n493\t      view: { compactThreshold: 100 },\n494\t    });\n495\t    const captured = bgDouble.captureInputs();\n496\t    const before = stateSnapshot(filePath);\n497\t\n498\t    const one = await bg.threadView.pull({ filePath });\n499\t    const firstStatus = await bg.threadView.status({ filePath });\n500\t    const two = await bg.threadView.pull({ filePath });\n501\t    expect(one.ok && two.ok && firstStatus.ok).toBe(true);\n502\t    if (!one.ok || !two.ok || !firstStatus.ok) return;\n503\t\n504\t    // The pending work is visible through the read itself (never-attempted\n505\t    // forms bucket as pending) — proof the reads ran against live queue rows.\n506\t    expect(firstStatus.value.derivation.pending).toBeGreaterThan(0);\n507\t\n508\t    // Give any wrongly-scheduled catch-up drain room to surface, then wait\n509\t    // out the scheduler before asserting nothing happened.\n510\t    await new Promise((resolve) => setTimeout(resolve, 25));\n511\t    await bg.drainSettled({ filePath });\n512\t\n513\t    // Byte-identical repeated pulls (AC-1.7) in background mode.\n514\t    expect(sha256(one.value)).toBe(sha256(two.value));\n515\t    expect(JSON.stringify(one.value)).toBe(JSON.stringify(two.value));\n516\t\n517\t    // Reads only: queue rows, form states, view rows, and boundary all\n518\t    // unchanged; the provider fake observed zero calls.\n519\t    expect(stateSnapshot(filePath)).toEqual(before);\n520\t    expect(captured.length).toBe(0);\n521\t\n522\t    // The status read repeats unchanged too — no state moved underneath it.\n523\t    const secondStatus = await bg.threadView.status({ filePath });\n524\t    expect(secondStatus.ok).toBe(true);\n525\t    if (!secondStatus.ok) return;\n526\t    expect(JSON.stringify(secondStatus.value)).toBe(JSON.stringify(firstStatus.value));\n527\t  });\n528\t});\n529\t"}]},"parent_tool_use_id":null,"session_id":"8dde17a3-d739-40da-bd65-ee3687cdd63f","uuid":"5a06dae5-8043-49a8-9e74-8d8cb2773279","timestamp":"2026-06-11T15:13:33.933Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-pull.test.ts","content":"\ndescribe(\"TC-1.1 (AC-1.2, AC-1.3): never-compacted thread pulls the full conversation in order; later intake appends\", () => {\n  it(\"carries both intake rounds in record order with tail-only meta\", async () => {\n    const sdk = manualSdk();\n    const filePath = await newThread(sdk);\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"first question\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"first answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n\n    const first = await sdk.threadView.pull({ filePath });\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    expect(first.value.messages).toEqual([\n      { role: \"user\", content: \"first question\" },\n      { role: \"assistant\", content: \"first answer\" },\n    ]);\n    // Never compacted: no band content, no error, tail from event 1 (AC-1.3).\n    expect(first.value.messages.every((m) => m.band === undefined)).toBe(true);\n    expect(first.value.meta).toEqual({\n      compactPoint: null,\n      coveredFrom: null,\n      boundaryPosition: 0,\n      gapCount: 0,\n      degradedCount: 0,\n      viewId: null,\n      createdAt: null,\n    });\n\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"second question\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"second answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    const second = await sdk.threadView.pull({ filePath });\n    expect(second.ok).toBe(true);\n    if (!second.ok) return;\n    // All committed intake appears, in record order; the new batch appends\n    // after the first round's messages, which are byte-unchanged (AC-1.2).\n    expect(second.value.messages).toEqual([\n      { role: \"user\", content: \"first question\" },\n      { role: \"assistant\", content: \"first answer\" },\n      { role: \"user\", content: \"second question\" },\n      { role: \"assistant\", content: \"second answer\" },\n    ]);\n  });\n});\n\ndescribe(\"TC-1.2 (AC-1.1, AC-1.7): two pulls with nothing between are byte-identical and create no work or provider calls\", () => {\n  it(\"hashes identical, zero work rows created, provider double observes zero calls\", async () => {\n    // The double's capture log starts recording here; any Epic 03 read that\n    // touched the provider would append to it (zero-provider assertion, pull\n    // leg of the suite-wide architecture-risk row).\n    const captured = fixture.double.captureInputs();\n    const before = stateSnapshot(fixture.filePath);\n    const workRowsBefore = workItemCount(fixture.filePath);\n\n    const one = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n    const two = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n    expect(one.ok && two.ok).toBe(true);\n    if (!one.ok || !two.ok) return;\n\n    // Byte-identical via the FULL serialized result, not field spot-checks\n    // (story Anti-Shim Requirements).\n    expect(sha256(one.value)).toBe(sha256(two.value));\n    expect(JSON.stringify(one.value)).toBe(JSON.stringify(two.value));\n\n    expect(workItemCount(fixture.filePath)).toBe(workRowsBefore);\n    expect(stateSnapshot(fixture.filePath)).toEqual(before);\n    expect(captured.length).toBe(0);\n  });\n});\n\ndescribe(\"tail mapping legs (architecture-risk): one named leg per message kind\", () => {\n  let sdk: Lhc;\n  let filePath: string;\n  let pulled: ViewMessage[];\n\n  beforeAll(async () => {\n    sdk = manualSdk();\n    filePath = await newThread(sdk);\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"mapping prompt\" } }),\n      validEvent(\"assistant_thinking\", { payload: { text: \"mapping thought\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"call-map-1\", toolName: \"read_file\", arguments: { path: \"map.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"call-map-1\", content: \"mapping output\", isError: false },\n      }),\n      validEvent(\"runtime_note\", { payload: { text: \"mapping note\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"mapping answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    const result = await sdk.threadView.pull({ filePath });\n    if (!result.ok) throw new Error(`pull failed: ${result.error.reason}`);\n    pulled = result.value.messages;\n  });\n\n  it(\"user_prompt: user role, text verbatim\", () => {\n    expect(pulled[0]).toEqual({ role: \"user\", content: \"mapping prompt\" });\n  });\n\n  it(\"assistant_thinking: assistant role, fenced [thinking] block\", () => {\n    expect(pulled[1]).toEqual({\n      role: \"assistant\",\n      content: \"[thinking]\\nmapping thought\\n[/thinking]\",\n    });\n  });\n\n  it(\"tool_call: assistant role, name marker plus deterministic arg rendering\", () => {\n    expect(pulled[2]).toEqual({\n      role: \"assistant\",\n      content: '[tool call · read_file] {\"path\":\"map.txt\"}',\n    });\n  });\n\n  it(\"tool_result ahead of the boundary: user role, name marker plus full content\", () => {\n    expect(pulled[3]).toEqual({\n      role: \"user\",\n      content: \"[tool result · read_file]\\nmapping output\",\n    });\n  });\n\n  it(\"runtime_note: user role, [runtime note] marker plus text\", () => {\n    expect(pulled[4]).toEqual({ role: \"user\", content: \"[runtime note] mapping note\" });\n  });\n\n  it(\"assistant_text: assistant role, text verbatim\", () => {\n    expect(pulled[5]).toEqual({ role: \"assistant\", content: \"mapping answer\" });\n  });\n\n  it(\"tool_result at-or-behind the boundary: abridged marker plus short form (boundary seeded below-SDK)\", async () => {\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const result = listed.value.find((m) => m.kind === \"tool_result\");\n    expect(result).toBeDefined();\n    if (result === undefined) return;\n    seedViewBoundary(filePath, result.sourceEventOrder);\n\n    const repulled = await sdk.threadView.pull({ filePath });\n    expect(repulled.ok).toBe(true);\n    if (!repulled.ok) return;\n    const short = repulled.value.messages[3];\n    // Summaries are pending on this undrained thread: the short-form ladder\n    // falls to the deterministic truncation rung (content under the limit\n    // passes through whole), with the abridged marker and the record pointer.\n    expect(short).toEqual({\n      role: \"user\",\n      content: `[tool result · read_file · abridged]\\nmapping output [full content in record §${result.messageId}]`,\n    });\n    expect(repulled.value.meta.boundaryPosition).toBe(result.sourceEventOrder);\n  });\n});\n\ndescribe(\"TC-1.4 (AC-1.5): boundary mid-tail — short behind, full ahead, non-tool content full everywhere\", () => {\n  it(\"renders the ready summary behind the boundary and full content ahead of it\", async () => {\n    const sdk = manualSdk();\n    const filePath = await newThread(sdk);\n    for (const turn of [1, 2]) {\n      await intake(sdk, filePath, [\n        validEvent(\"user_prompt\", { payload: { text: `boundary prompt ${turn}` } }),\n        validEvent(\"assistant_thinking\", { payload: { text: `boundary thought ${turn}` } }),\n        validEvent(\"tool_call\", {\n          payload: {\n            toolCallId: `call-bd-${turn}`,\n            toolName: \"read_file\",\n            arguments: { path: `bd-${turn}.txt` },\n          },\n        }),\n        validEvent(\"tool_result\", {\n          payload: { toolCallId: `call-bd-${turn}`, content: `boundary output ${turn}`, isError: false },\n        }),\n        validEvent(\"assistant_text\", { payload: { text: `boundary answer ${turn}` } }),\n        validEvent(\"turn_end\"),\n      ]);\n    }\n    // Drain through the real Epic 02 machinery so the tool-result summaries\n    // are ready — the short-form ladder's first rung.\n    const drained = await sdk.work.drain({ filePath });\n    expect(drained.ok).toBe(true);\n\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const results = listed.value.filter((m) => m.kind === \"tool_result\");\n    expect(results).toHaveLength(2);\n    const [behind, ahead] = results;\n    if (behind === undefined || ahead === undefined) return;\n    const behindSummary = behind.forms?.find(\n      (form) => form.form === \"tool_result_summary\" && form.state === \"ready\",\n    );\n    expect(behindSummary?.content).toBeDefined();\n\n    // The sanctioned below-SDK helper seeds the boundary mid-tail: at the\n    // first result's event order (at-or-behind includes it), ahead of nothing\n    // else. Boundary mechanics are Story 4's; only the position's effect on\n    // rendering is under test here.\n    seedViewBoundary(filePath, behind.sourceEventOrder);\n\n    const pull = await sdk.threadView.pull({ filePath });\n    expect(pull.ok).toBe(true);\n    if (!pull.ok) return;\n    const contents = pull.value.messages.map((m) => m.content);\n\n    // Behind: short form — the ready summary verbatim, abridged marker,\n    // record pointer.\n    expect(contents).toContain(\n      `[tool result · read_file · abridged]\\n${behindSummary?.content} [full content in record §${behind.messageId}]`,\n    );\n    // Ahead: full content.\n    expect(contents).toContain(\"[tool result · read_file]\\nboundary output 2\");\n    // Non-tool-result content renders full everywhere, both sides of the\n    // boundary (prompts, thinking, assistant text).\n    for (const turn of [1, 2]) {\n      expect(contents).toContain(`boundary prompt ${turn}`);\n      expect(contents).toContain(`[thinking]\\nboundary thought ${turn}\\n[/thinking]`);\n      expect(contents).toContain(`boundary answer ${turn}`);\n    }\n  });\n\n  it(\"falls to deterministic truncation when no summary is ready and the content is oversized\", async () => {\n    const sdk = manualSdk();\n    const filePath = await newThread(sdk);\n    const longContent = \"x\".repeat(260);\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"truncation prompt\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"call-tr-1\", toolName: \"read_file\", arguments: { path: \"tr.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"call-tr-1\", content: longContent, isError: false },\n      }),\n      validEvent(\"turn_end\"),\n    ]);\n    // No drain: the summary stays pending, so the ladder's truncation rung\n    // renders — fixed 200-char prefix plus the exact dropped-count marker\n    // (Epic 01's abbreviation rule).\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const result = listed.value.find((m) => m.kind === \"tool_result\");\n    if (result === undefined) return;\n    seedViewBoundary(filePath, result.sourceEventOrder);\n\n    const pull = await sdk.threadView.pull({ filePath });\n    expect(pull.ok).toBe(true);\n    if (!pull.ok) return;\n    const short = pull.value.messages.find((m) => m.content.startsWith(\"[tool result\"));\n    expect(short?.content).toBe(\n      `[tool result · read_file · abridged]\\n${\"x\".repeat(200)}… [truncated 60 chars] [full content in record §${result.messageId}]`,\n    );\n  });\n});\n\ndescribe(\"TC-2.5 pre-compact legs (AC-2.8): the status read on a heavy thread\", () => {\n  // TC-2.5's intake leg mutates its thread, so this describe builds its own\n  // fixture instance instead of sharing the suite's read-only one.\n  let heavyStore: TempStore;\n  let heavy: DerivedThreadFixture;\n  let statusSdk: Lhc;\n\n  beforeAll(async () => {\n    heavyStore = tempStore();\n    heavy = await derivedThreadFixture(heavyStore);\n    // A low threshold makes the fixture \"heavy\" relative to config: the\n    // recommendation must trip without any conversation-scale inflation.\n    statusSdk = manualSdk({ compactThreshold: 100 });\n  });\n  afterAll(() => {\n    heavyStore.cleanup();\n  });\n\n  it(\"reports tail tokens vs threshold, recommendation, derivation counts, null view health, and the zone sum — reads only\", async () => {\n    // Status legs of the zero-provider assertion: the builder's double\n    // records every call from here on; status must add none.\n    const captured = heavy.double.captureInputs();\n    const before = stateSnapshot(heavy.filePath);\n\n    const status = await statusSdk.threadView.status({ filePath: heavy.filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n\n    expect(status.value.threshold).toBe(100);\n    expect(status.value.tailTokens).toBeGreaterThan(100);\n    expect(status.value.compactRecommended).toBe(true);\n\n    // Derivation counts by state, from the owners' report surfaces: the\n    // fixture's two scripted failures (transient-exhausted + permanent), all\n    // other forms drained ready — nothing pending, retrying, or blocked here\n    // (the blocked leg reads the sacrificial sibling below).\n    expect(status.value.derivation).toEqual({ pending: 0, retrying: 0, failed: 2, blocked: 0 });\n\n    // Pre-compact: view health is null, not a zeroed shape (AC-2.8 leg owned\n    // here; the view-health legs complete in Story 2).\n    expect(status.value.view).toBeNull();\n\n    // The visibility zone: boundary at its seeded default 0, so the sum is\n    // every live tool result's estimate — cross-checked against the record.\n    const listed = await statusSdk.messages.listMessages({ filePath: heavy.filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const expectedZone = listed.value\n      .filter((m) => m.kind === \"tool_result\")\n      .reduce((sum, m) => sum + m.tokenEstimate, 0);\n    expect(status.value.visibility).toEqual({ zoneTokens: expectedZone, maxTokens: 32000 });\n\n    // Reads only: no work rows, no form-state change, no view row, boundary\n    // unmoved, zero provider calls — and no compact occurred uninvoked.\n    expect(stateSnapshot(heavy.filePath)).toEqual(before);\n    expect(captured.length).toBe(0);\n  });\n\n  it(\"counts blocked forms through the owner's report (sacrificial sibling)\", async () => {\n    const sibling = await blockedSiblingThread(heavyStore);\n    const status = await sibling.sdk.threadView.status({ filePath: sibling.filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n    // The sibling's damaged turn landed both turn forms blocked through the\n    // production terminal path (turn_rendering + lower_band_projection).\n    expect(status.value.derivation.blocked).toBe(2);\n    expect(status.value.view).toBeNull();\n  });\n\n  it(\"after more intake the tail grew; still no compact without invocation\", async () => {\n    const first = await statusSdk.threadView.status({ filePath: heavy.filePath });\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n\n    await intake(heavy.sdk, heavy.filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"one more question for the heavy thread\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"one more answer for the heavy thread\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n\n    const second = await statusSdk.threadView.status({ filePath: heavy.filePath });\n    expect(second.ok).toBe(true);\n    if (!second.ok) return;\n    expect(second.value.tailTokens).toBeGreaterThan(first.value.tailTokens);\n    expect(second.value.view).toBeNull();\n    expect(stateSnapshot(heavy.filePath)[\"viewRows\"]).toBe(0);\n  });\n});\n\ndescribe(\"TC-1.2 / TC-2.5 background legs (SV-01-PULL-STATUS-001): pull and status are reads-only in a background SDK with pending work queued\", () => {\n  it(\"schedules no catch-up drain: work rows, form states, provider count, and status all unchanged; repeated pulls byte-identical\", async () => {\n    // Pending work manufactured through a manual SDK (its no-op seam never\n    // drains): one tool-heavy turn leaves live queue rows and pending forms.\n    const seeder = manualSdk();\n    const filePath = await newThread(seeder);\n    await intake(seeder, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"background prompt\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"call-bg-1\", toolName: \"read_file\", arguments: { path: \"bg.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"call-bg-1\", content: \"background output\", isError: false },\n      }),\n      validEvent(\"assistant_text\", { payload: { text: \"background answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(workItemCount(filePath)).toBeGreaterThan(0);\n\n    // The production background path: a fresh background SDK whose scheduler\n    // WOULD hang a first-touch catch-up drain off the open announcement\n    // (openThreadDatabase → fireThreadTouch → scheduler.touch) if pull or\n    // status fired it — the SV-01-PULL-STATUS-001 side-effect path.\n    const bgDouble = createProviderDouble();\n    const bg = createSdk({\n      provider: bgDouble,\n      mode: \"background\",\n      view: { compactThreshold: 100 },\n    });\n    const captured = bgDouble.captureInputs();\n    const before = stateSnapshot(filePath);\n\n    const one = await bg.threadView.pull({ filePath });\n    const firstStatus = await bg.threadView.status({ filePath });\n    const two = await bg.threadView.pull({ filePath });\n    expect(one.ok && two.ok && firstStatus.ok).toBe(true);\n    if (!one.ok || !two.ok || !firstStatus.ok) return;\n\n    // The pending work is visible through the read itself (never-attempted\n    // forms bucket as pending) — proof the reads ran against live queue rows.\n    expect(firstStatus.value.derivation.pending).toBeGreaterThan(0);\n\n    // Give any wrongly-scheduled catch-up drain room to surface, then wait\n    // out the scheduler before asserting nothing happened.\n    await new Promise((resolve) => setTimeout(resolve, 25));\n    await bg.drainSettled({ filePath });\n\n    // Byte-identical repeated pulls (AC-1.7) in background mode.\n    expect(sha256(one.value)).toBe(sha256(two.value));\n    expect(JSON.stringify(one.value)).toBe(JSON.stringify(two.value));\n\n    // Reads only: queue rows, form states, view rows, and boundary all\n    // unchanged; the provider fake observed zero calls.\n    expect(stateSnapshot(filePath)).toEqual(before);\n    expect(captured.length).toBe(0);\n\n    // The status read repeats unchanged too — no state moved underneath it.\n    const secondStatus = await bg.threadView.status({ filePath });\n    expect(secondStatus.ok).toBe(true);\n    if (!secondStatus.ok) return;\n    expect(JSON.stringify(secondStatus.value)).toBe(JSON.stringify(firstStatus.value));\n  });\n});\n","numLines":410,"startLine":120,"totalLines":529}}}

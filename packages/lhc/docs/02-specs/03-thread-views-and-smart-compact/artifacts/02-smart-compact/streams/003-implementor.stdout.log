{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KP6eyKxQTfSshdfAR7jp1Y","type":"tool_result","content":"1\t// Thread builders for Epic 02 (test plan §Test Substrate). All built through\n2\t// real intake; the multi-state and damaged-source builders then apply the\n3\t// sanctioned below-SDK writes for states the SDK cannot yet produce (drain\n4\t// and handlers land in Stories 1–3) — Story 0 proves read-back of what the\n5\t// builders wrote; Stories 2/4 confirm the states arise for real\n6\t// (coverage.md cross-story debt).\n7\timport { DatabaseSync } from \"node:sqlite\";\n8\timport {\n9\t  intakeStream,\n10\t  runCli,\n11\t  threads,\n12\t  type DerivedForm,\n13\t  type DerivedFormState,\n14\t  type DependencyGap,\n15\t  type FormKind,\n16\t  type Lhc,\n17\t  type MessageEventInput,\n18\t  type SubjectKind,\n19\t  type ToolOutcome,\n20\t} from \"../../src/index.js\";\n21\timport { setIntakeClock } from \"./intake-seam.js\";\n22\timport { corruptTwoOpenTurns } from \"./corrupt.js\";\n23\timport type { ProviderDouble } from \"./provider-double.js\";\n24\timport { validEvent, type TempStore } from \"./index.js\";\n25\t\n26\tasync function newThreadFile(store: TempStore): Promise<string> {\n27\t  const filePath = store.threadPath();\n28\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n29\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n30\t  return filePath;\n31\t}\n32\t\n33\tasync function send(filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n34\t  const result = await intakeStream.messageEvents({ filePath }, batch);\n35\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n36\t}\n37\t\n38\t// n closed turns, each prompt + assistant text + explicit end. Turn ids are\n39\t// deterministic (t1..tn) per the turn store's id scheme.\n40\texport async function threadWithClosedTurns(\n41\t  store: TempStore,\n42\t  n: number,\n43\t): Promise<{ filePath: string; turnIds: string[] }> {\n44\t  const filePath = await newThreadFile(store);\n45\t  const turnIds: string[] = [];\n46\t  for (let i = 1; i <= n; i += 1) {\n47\t    await send(filePath, [\n48\t      validEvent(\"user_prompt\", { payload: { text: `prompt for turn ${i}` } }),\n49\t      validEvent(\"assistant_text\", { payload: { text: `answer for turn ${i}` } }),\n50\t      validEvent(\"turn_end\"),\n51\t    ]);\n52\t    turnIds.push(`t${i}`);\n53\t  }\n54\t  return { filePath, turnIds };\n55\t}\n56\t\n57\t// One closed turn containing a tool run: call + result pair by default;\n58\t// error and missing-result variants per the epic's outcome vocabulary.\n59\texport async function threadWithToolRun(\n60\t  store: TempStore,\n61\t  opts: { isError?: boolean; missingResult?: boolean; resultContent?: string } = {},\n62\t): Promise<{ filePath: string; turnId: string }> {\n63\t  const filePath = await newThreadFile(store);\n64\t  const batch: MessageEventInput[] = [\n65\t    validEvent(\"user_prompt\", { payload: { text: \"please run the tool\" } }),\n66\t    validEvent(\"tool_call\", {\n67\t      payload: { toolCallId: \"call-fixture-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n68\t    }),\n69\t  ];\n70\t  if (opts.missingResult !== true) {\n71\t    batch.push(\n72\t      validEvent(\"tool_result\", {\n73\t        payload: {\n74\t          toolCallId: \"call-fixture-1\",\n75\t          content: opts.resultContent ?? \"contents of notes.txt\",\n76\t          isError: opts.isError ?? false,\n77\t        },\n78\t      }),\n79\t    );\n80\t  }\n81\t  batch.push(validEvent(\"turn_end\"));\n82\t  await send(filePath, batch);\n83\t  return { filePath, turnId: \"t1\" };\n84\t}\n85\t\n86\t// ── chunk read-back (Story 3): raw rows for boundary assertions ──\n87\t\n88\texport interface ChunkSnapshot {\n89\t  chunks: Array<{\n90\t    chunkId: string;\n91\t    chunkOrder: number;\n92\t    status: \"open\" | \"closed\";\n93\t    accumulatedProjectedTokens: number;\n94\t  }>;\n95\t  members: Array<{ chunkId: string; turnId: string; memberIdx: number }>;\n96\t}\n97\t\n98\texport function readChunks(filePath: string): ChunkSnapshot {\n99\t  const db = new DatabaseSync(filePath);\n100\t  try {\n101\t    const chunks = (\n102\t      db\n103\t        .prepare(\n104\t          `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\n105\t           FROM chunk ORDER BY chunk_order`,\n106\t        )\n107\t        .all() as unknown as Array<{\n108\t        chunk_id: string;\n109\t        chunk_order: number | bigint;\n110\t        status: string;\n111\t        accumulated_projected_tokens: number | bigint;\n112\t      }>\n113\t    ).map((row) => ({\n114\t      chunkId: row.chunk_id,\n115\t      chunkOrder: Number(row.chunk_order),\n116\t      status: row.status as \"open\" | \"closed\",\n117\t      accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\n118\t    }));\n119\t    const members = (\n120\t      db\n121\t        .prepare(\n122\t          `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\n123\t           JOIN chunk c ON c.chunk_id = cm.chunk_id\n124\t           ORDER BY c.chunk_order, cm.member_idx`,\n125\t        )\n126\t        .all() as unknown as Array<{\n127\t        chunk_id: string;\n128\t        turn_id: string;\n129\t        member_idx: number | bigint;\n130\t      }>\n131\t    ).map((row) => ({\n132\t      chunkId: row.chunk_id,\n133\t      turnId: row.turn_id,\n134\t      memberIdx: Number(row.member_idx),\n135\t    }));\n136\t    return { chunks, members };\n137\t  } finally {\n138\t    db.close();\n139\t  }\n140\t}\n141\t\n142\t// ── derived_form read-back and the sanctioned state writer ───────\n143\t\n144\tinterface RawFormRow {\n145\t  subject_kind: string;\n146\t  subject_id: string;\n147\t  form: string;\n148\t  state: string;\n149\t  content: string | null;\n150\t  reason: string | null;\n151\t  metadata: string | null;\n152\t  source_version: number | bigint;\n153\t  gaps: string | null;\n154\t  derived_at: string | null;\n155\t}\n156\t\n157\texport function readDerivedForms(filePath: string): DerivedForm[] {\n158\t  const db = new DatabaseSync(filePath);\n159\t  try {\n160\t    const rows = db\n161\t      .prepare(\n162\t        `SELECT subject_kind, subject_id, form, state, content, reason, metadata,\n163\t                source_version, gaps, derived_at\n164\t         FROM derived_form ORDER BY subject_kind, subject_id, form`,\n165\t      )\n166\t      .all() as unknown as RawFormRow[];\n167\t    return rows.map((row) => {\n168\t      const record: DerivedForm = {\n169\t        subjectKind: row.subject_kind as SubjectKind,\n170\t        subjectId: row.subject_id,\n171\t        form: row.form as FormKind,\n172\t        state: row.state as DerivedFormState,\n173\t        sourceVersion: Number(row.source_version),\n174\t      };\n175\t      if (row.content !== null) record.content = row.content;\n176\t      if (row.reason !== null) record.reason = row.reason;\n177\t      if (row.metadata !== null) {\n178\t        record.metadata = JSON.parse(row.metadata) as { outcome?: ToolOutcome };\n179\t      }\n180\t      if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n181\t      if (row.derived_at !== null) record.derivedAt = row.derived_at;\n182\t      return record;\n183\t    });\n184\t  } finally {\n185\t    db.close();\n186\t  }\n187\t}\n188\t\n189\t// Below-SDK state writer, sanctioned like corrupt.ts: ready/failed/blocked\n190\t// are unreachable through the SDK until the drain (Story 1) and handlers\n191\t// (Stories 2–3) land. UPDATE-only on purpose — the pending row exists from\n192\t// enqueue, mirroring the production completion contract.\n193\texport function setFormState(\n194\t  filePath: string,\n195\t  target: { subjectKind: SubjectKind; subjectId: string; form: FormKind },\n196\t  update: {\n197\t    state: DerivedFormState;\n198\t    content?: string;\n199\t    reason?: string;\n200\t    metadata?: { outcome?: ToolOutcome };\n201\t    derivedAt?: string;\n202\t  },\n203\t): void {\n204\t  const db = new DatabaseSync(filePath);\n205\t  try {\n206\t    const changed = db\n207\t      .prepare(\n208\t        `UPDATE derived_form\n209\t         SET state = ?, content = ?, reason = ?, metadata = ?, derived_at = ?\n210\t         WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n211\t      )\n212\t      .run(\n213\t        update.state,\n214\t        update.content ?? null,\n215\t        update.reason ?? null,\n216\t        update.metadata === undefined ? null : JSON.stringify(update.metadata),\n217\t        update.derivedAt ?? null,\n218\t        target.subjectKind,\n219\t        target.subjectId,\n220\t        target.form,\n221\t      );\n222\t    if (Number(changed.changes) !== 1) {\n223\t      throw new Error(\n224\t        `fixture setFormState hit ${String(changed.changes)} rows for ${target.subjectKind}/${target.subjectId}/${target.form}; expected the pending row from enqueue`,\n225\t      );\n226\t    }\n227\t  } finally {\n228\t    db.close();\n229\t  }\n230\t}\n231\t\n232\t// ── multi-state thread: every form state in one file ─────────────\n233\t\n234\texport interface MultiStateClaim {\n235\t  subjectKind: SubjectKind;\n236\t  subjectId: string;\n237\t  form: FormKind;\n238\t  state: DerivedFormState;\n239\t}\n240\t\n241\texport async function multiStateThread(\n242\t  store: TempStore,\n243\t): Promise<{ filePath: string; expected: MultiStateClaim[] }> {\n244\t  const filePath = await newThreadFile(store);\n245\t  // Turn 1: prompt + tool run; turn 2: prompt. Intake's enqueue leaves every\n246\t  // form pending; the writes below move a subset into the other three states.\n247\t  await send(filePath, [\n248\t    validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n249\t    validEvent(\"assistant_text\", { payload: { text: \"working on it\" } }),\n250\t    validEvent(\"tool_call\", {\n251\t      payload: { toolCallId: \"call-ms-1\", toolName: \"read_file\", arguments: { path: \"a.txt\" } },\n252\t    }),\n253\t    validEvent(\"tool_result\", {\n254\t      payload: { toolCallId: \"call-ms-1\", content: \"contents of a.txt\", isError: false },\n255\t    }),\n256\t    validEvent(\"turn_end\"),\n257\t    validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n258\t    validEvent(\"turn_end\"),\n259\t  ]);\n260\t  const derivedAt = \"2026-06-10T12:00:00.000Z\";\n261\t  setFormState(\n262\t    filePath,\n263\t    { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n264\t    { state: \"ready\", content: \"smoothed(fixture:first prompt)\", derivedAt },\n265\t  );\n266\t  // Tool-activity outcome lives in machine-readable metadata, never inside\n267\t  // provider-authored content (FC-0.3).\n268\t  setFormState(\n269\t    filePath,\n270\t    { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\" },\n271\t    {\n272\t      state: \"ready\",\n273\t      content: \"toolresult(fixture:contents of a.txt)\",\n274\t      metadata: { outcome: \"succeeded\" },\n275\t      derivedAt,\n276\t    },\n277\t  );\n278\t  setFormState(\n279\t    filePath,\n280\t    { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n281\t    { state: \"failed\", reason: \"provider_failure: scripted exhaustion (fixture)\" },\n282\t  );\n283\t  setFormState(\n284\t    filePath,\n285\t    { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\" },\n286\t    { state: \"blocked\", reason: \"source_damaged: manufactured damage (fixture)\" },\n287\t  );\n288\t  return {\n289\t    filePath,\n290\t    expected: [\n291\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\", state: \"ready\" },\n292\t      { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\", state: \"ready\" },\n293\t      { subjectKind: \"message\", subjectId: \"m6\", form: \"smoothed_prompt\", state: \"pending\" },\n294\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\", state: \"failed\" },\n295\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\", state: \"pending\" },\n296\t      { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\", state: \"blocked\" },\n297\t      { subjectKind: \"turn\", subjectId: \"t2\", form: \"lower_band_projection\", state: \"pending\" },\n298\t    ],\n299\t  };\n300\t}\n301\t\n302\t// ── damaged-source thread (Epic 01 corruption definition) ────────\n303\t\n304\t// A closed turn with its turn_derivation work queued, then the Epic 01\n305\t// two-open-turns corruption — the damage a turn handler must find and the\n306\t// intake pipeline refuses (turn_state_corrupt).\n307\texport async function damagedSourceThread(\n308\t  store: TempStore,\n309\t): Promise<{ filePath: string; turnId: string }> {\n310\t  const { filePath, turnIds } = await threadWithClosedTurns(store, 1);\n311\t  // Open a second turn through real intake; the corruption writer then adds\n312\t  // another open row — two open turns, the Epic 01 invariant violation.\n313\t  await send(filePath, [validEvent(\"user_prompt\", { payload: { text: \"left open\" } })]);\n314\t  corruptTwoOpenTurns(filePath);\n315\t  const turnId = turnIds[0];\n316\t  if (turnId === undefined) throw new Error(\"fixture invariant: one closed turn expected\");\n317\t  return { filePath, turnId };\n318\t}\n319\t\n320\t// ── gapped-rendering thread (TC-3.2's state, shared) ─────────────\n321\t\n322\t// TC-3.2's gapped-rendering state as one shared builder (coverage.md\n323\t// cross-story debt: TC-4.4 consumes this exact scenario; don't rebuild it by\n324\t// hand). Expects a manual-mode SDK with retry budget 3 and zero backoff:\n325\t// scripts the double to exhaust the prompt's smoothing, then drains — the\n326\t// smoothing lands failed (its work row deleted at exhaustion, DD-1) and the\n327\t// turn rendering lands ready with the recorded gap.\n328\texport const GAPPED_SMOOTHING_REASON = \"provider_failure: scripted smoothing exhaustion\";\n329\t\n330\texport async function gappedRenderingThread(\n331\t  store: TempStore,\n332\t  sdk: Lhc,\n333\t  double: ProviderDouble,\n334\t): Promise<{ filePath: string; messageId: string; turnId: string }> {\n335\t  const filePath = await newThreadFile(store);\n336\t  double.failKind(\"prompt_smoothing\", 3, {\n337\t    retryable: true,\n338\t    reason: GAPPED_SMOOTHING_REASON,\n339\t  });\n340\t  await send(filePath, [\n341\t    validEvent(\"user_prompt\", { payload: { text: \"gapped prompt\" } }),\n342\t    validEvent(\"assistant_text\", { payload: { text: \"gapped answer\" } }),\n343\t    validEvent(\"turn_end\"),\n344\t  ]);\n345\t  const drained = await sdk.work.drain({ filePath });\n346\t  if (!drained.ok) throw new Error(`fixture drain failed: ${drained.error.reason}`);\n347\t  const forms = readDerivedForms(filePath);\n348\t  const smoothing = forms.find((f) => f.subjectId === \"m1\" && f.form === \"smoothed_prompt\");\n349\t  const rendering = forms.find((f) => f.subjectId === \"t1\" && f.form === \"turn_rendering\");\n350\t  if (\n351\t    smoothing?.state !== \"failed\" ||\n352\t    rendering?.state !== \"ready\" ||\n353\t    rendering.gaps === undefined\n354\t  ) {\n355\t    throw new Error(\n356\t      \"fixture invariant: failed smoothing under a ready, gapped rendering expected\",\n357\t    );\n358\t  }\n359\t  return { filePath, messageId: \"m1\", turnId: \"t1\" };\n360\t}\n361\t\n362\t// ── twin SDK/CLI threads for parity tests ────────────────────────\n363\t\n364\t// The same batch recorded through the SDK entry and the in-process CLI\n365\t// adapter, under one injected clock, so the two files are comparable\n366\t// record-for-record. Distinct idempotency-key spaces are unnecessary: keys\n367\t// scope per thread file.\n368\texport async function twinThreads(\n369\t  store: TempStore,\n370\t  batch?: readonly MessageEventInput[],\n371\t): Promise<{ sdkPath: string; cliPath: string; batch: readonly MessageEventInput[] }> {\n372\t  const events =\n373\t    batch ??\n374\t    ([\n375\t      validEvent(\"user_prompt\", { payload: { text: \"twin prompt\" } }),\n376\t      validEvent(\"assistant_text\", { payload: { text: \"twin answer\" } }),\n377\t      validEvent(\"tool_call\", {\n378\t        payload: { toolCallId: \"call-twin-1\", toolName: \"read_file\", arguments: { path: \"t.txt\" } },\n379\t      }),\n380\t      validEvent(\"tool_result\", {\n381\t        payload: { toolCallId: \"call-twin-1\", content: \"twin tool output\", isError: false },\n382\t      }),\n383\t      validEvent(\"turn_end\"),\n384\t    ] as const);\n385\t\n386\t  setIntakeClock(() => new Date(\"2026-06-10T12:00:00.000Z\"));\n387\t  try {\n388\t    const sdkPath = await newThreadFile(store);\n389\t    await send(sdkPath, events);\n390\t\n391\t    const cliPath = store.threadPath();\n392\t    const created = await runCli([\n393\t      \"threads\",\n394\t      \"new-thread\",\n395\t      \"--file-path\",\n396\t      cliPath,\n397\t      \"--registry\",\n398\t      store.registryPath,\n399\t    ]);\n400\t    if (created.exitCode !== 0) {\n401\t      throw new Error(`fixture CLI new-thread failed: ${created.stdout}`);\n402\t    }\n403\t    const recorded = await runCli(\n404\t      [\"intake-stream\", \"message-events\", \"--file-path\", cliPath],\n405\t      async () => JSON.stringify(events),\n406\t    );\n407\t    if (recorded.exitCode !== 0) {\n408\t      throw new Error(`fixture CLI message-events failed: ${recorded.stdout}`);\n409\t    }\n410\t    return { sdkPath, cliPath, batch: events };\n411\t  } finally {\n412\t    setIntakeClock(null);\n413\t  }\n414\t}\n415\t"}]},"parent_tool_use_id":null,"session_id":"8dde17a3-d739-40da-bd65-ee3687cdd63f","uuid":"6ef27cbd-aa16-4b77-abfe-db95763912fa","timestamp":"2026-06-11T15:13:26.815Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/threads.ts","content":"// Thread builders for Epic 02 (test plan §Test Substrate). All built through\n// real intake; the multi-state and damaged-source builders then apply the\n// sanctioned below-SDK writes for states the SDK cannot yet produce (drain\n// and handlers land in Stories 1–3) — Story 0 proves read-back of what the\n// builders wrote; Stories 2/4 confirm the states arise for real\n// (coverage.md cross-story debt).\nimport { DatabaseSync } from \"node:sqlite\";\nimport {\n  intakeStream,\n  runCli,\n  threads,\n  type DerivedForm,\n  type DerivedFormState,\n  type DependencyGap,\n  type FormKind,\n  type Lhc,\n  type MessageEventInput,\n  type SubjectKind,\n  type ToolOutcome,\n} from \"../../src/index.js\";\nimport { setIntakeClock } from \"./intake-seam.js\";\nimport { corruptTwoOpenTurns } from \"./corrupt.js\";\nimport type { ProviderDouble } from \"./provider-double.js\";\nimport { validEvent, type TempStore } from \"./index.js\";\n\nasync function newThreadFile(store: TempStore): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nasync function send(filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n  const result = await intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n}\n\n// n closed turns, each prompt + assistant text + explicit end. Turn ids are\n// deterministic (t1..tn) per the turn store's id scheme.\nexport async function threadWithClosedTurns(\n  store: TempStore,\n  n: number,\n): Promise<{ filePath: string; turnIds: string[] }> {\n  const filePath = await newThreadFile(store);\n  const turnIds: string[] = [];\n  for (let i = 1; i <= n; i += 1) {\n    await send(filePath, [\n      validEvent(\"user_prompt\", { payload: { text: `prompt for turn ${i}` } }),\n      validEvent(\"assistant_text\", { payload: { text: `answer for turn ${i}` } }),\n      validEvent(\"turn_end\"),\n    ]);\n    turnIds.push(`t${i}`);\n  }\n  return { filePath, turnIds };\n}\n\n// One closed turn containing a tool run: call + result pair by default;\n// error and missing-result variants per the epic's outcome vocabulary.\nexport async function threadWithToolRun(\n  store: TempStore,\n  opts: { isError?: boolean; missingResult?: boolean; resultContent?: string } = {},\n): Promise<{ filePath: string; turnId: string }> {\n  const filePath = await newThreadFile(store);\n  const batch: MessageEventInput[] = [\n    validEvent(\"user_prompt\", { payload: { text: \"please run the tool\" } }),\n    validEvent(\"tool_call\", {\n      payload: { toolCallId: \"call-fixture-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n    }),\n  ];\n  if (opts.missingResult !== true) {\n    batch.push(\n      validEvent(\"tool_result\", {\n        payload: {\n          toolCallId: \"call-fixture-1\",\n          content: opts.resultContent ?? \"contents of notes.txt\",\n          isError: opts.isError ?? false,\n        },\n      }),\n    );\n  }\n  batch.push(validEvent(\"turn_end\"));\n  await send(filePath, batch);\n  return { filePath, turnId: \"t1\" };\n}\n\n// ── chunk read-back (Story 3): raw rows for boundary assertions ──\n\nexport interface ChunkSnapshot {\n  chunks: Array<{\n    chunkId: string;\n    chunkOrder: number;\n    status: \"open\" | \"closed\";\n    accumulatedProjectedTokens: number;\n  }>;\n  members: Array<{ chunkId: string; turnId: string; memberIdx: number }>;\n}\n\nexport function readChunks(filePath: string): ChunkSnapshot {\n  const db = new DatabaseSync(filePath);\n  try {\n    const chunks = (\n      db\n        .prepare(\n          `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\n           FROM chunk ORDER BY chunk_order`,\n        )\n        .all() as unknown as Array<{\n        chunk_id: string;\n        chunk_order: number | bigint;\n        status: string;\n        accumulated_projected_tokens: number | bigint;\n      }>\n    ).map((row) => ({\n      chunkId: row.chunk_id,\n      chunkOrder: Number(row.chunk_order),\n      status: row.status as \"open\" | \"closed\",\n      accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\n    }));\n    const members = (\n      db\n        .prepare(\n          `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\n           JOIN chunk c ON c.chunk_id = cm.chunk_id\n           ORDER BY c.chunk_order, cm.member_idx`,\n        )\n        .all() as unknown as Array<{\n        chunk_id: string;\n        turn_id: string;\n        member_idx: number | bigint;\n      }>\n    ).map((row) => ({\n      chunkId: row.chunk_id,\n      turnId: row.turn_id,\n      memberIdx: Number(row.member_idx),\n    }));\n    return { chunks, members };\n  } finally {\n    db.close();\n  }\n}\n\n// ── derived_form read-back and the sanctioned state writer ───────\n\ninterface RawFormRow {\n  subject_kind: string;\n  subject_id: string;\n  form: string;\n  state: string;\n  content: string | null;\n  reason: string | null;\n  metadata: string | null;\n  source_version: number | bigint;\n  gaps: string | null;\n  derived_at: string | null;\n}\n\nexport function readDerivedForms(filePath: string): DerivedForm[] {\n  const db = new DatabaseSync(filePath);\n  try {\n    const rows = db\n      .prepare(\n        `SELECT subject_kind, subject_id, form, state, content, reason, metadata,\n                source_version, gaps, derived_at\n         FROM derived_form ORDER BY subject_kind, subject_id, form`,\n      )\n      .all() as unknown as RawFormRow[];\n    return rows.map((row) => {\n      const record: DerivedForm = {\n        subjectKind: row.subject_kind as SubjectKind,\n        subjectId: row.subject_id,\n        form: row.form as FormKind,\n        state: row.state as DerivedFormState,\n        sourceVersion: Number(row.source_version),\n      };\n      if (row.content !== null) record.content = row.content;\n      if (row.reason !== null) record.reason = row.reason;\n      if (row.metadata !== null) {\n        record.metadata = JSON.parse(row.metadata) as { outcome?: ToolOutcome };\n      }\n      if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n      if (row.derived_at !== null) record.derivedAt = row.derived_at;\n      return record;\n    });\n  } finally {\n    db.close();\n  }\n}\n\n// Below-SDK state writer, sanctioned like corrupt.ts: ready/failed/blocked\n// are unreachable through the SDK until the drain (Story 1) and handlers\n// (Stories 2–3) land. UPDATE-only on purpose — the pending row exists from\n// enqueue, mirroring the production completion contract.\nexport function setFormState(\n  filePath: string,\n  target: { subjectKind: SubjectKind; subjectId: string; form: FormKind },\n  update: {\n    state: DerivedFormState;\n    content?: string;\n    reason?: string;\n    metadata?: { outcome?: ToolOutcome };\n    derivedAt?: string;\n  },\n): void {\n  const db = new DatabaseSync(filePath);\n  try {\n    const changed = db\n      .prepare(\n        `UPDATE derived_form\n         SET state = ?, content = ?, reason = ?, metadata = ?, derived_at = ?\n         WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n      )\n      .run(\n        update.state,\n        update.content ?? null,\n        update.reason ?? null,\n        update.metadata === undefined ? null : JSON.stringify(update.metadata),\n        update.derivedAt ?? null,\n        target.subjectKind,\n        target.subjectId,\n        target.form,\n      );\n    if (Number(changed.changes) !== 1) {\n      throw new Error(\n        `fixture setFormState hit ${String(changed.changes)} rows for ${target.subjectKind}/${target.subjectId}/${target.form}; expected the pending row from enqueue`,\n      );\n    }\n  } finally {\n    db.close();\n  }\n}\n\n// ── multi-state thread: every form state in one file ─────────────\n\nexport interface MultiStateClaim {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n  state: DerivedFormState;\n}\n\nexport async function multiStateThread(\n  store: TempStore,\n): Promise<{ filePath: string; expected: MultiStateClaim[] }> {\n  const filePath = await newThreadFile(store);\n  // Turn 1: prompt + tool run; turn 2: prompt. Intake's enqueue leaves every\n  // form pending; the writes below move a subset into the other three states.\n  await send(filePath, [\n    validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n    validEvent(\"assistant_text\", { payload: { text: \"working on it\" } }),\n    validEvent(\"tool_call\", {\n      payload: { toolCallId: \"call-ms-1\", toolName: \"read_file\", arguments: { path: \"a.txt\" } },\n    }),\n    validEvent(\"tool_result\", {\n      payload: { toolCallId: \"call-ms-1\", content: \"contents of a.txt\", isError: false },\n    }),\n    validEvent(\"turn_end\"),\n    validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n    validEvent(\"turn_end\"),\n  ]);\n  const derivedAt = \"2026-06-10T12:00:00.000Z\";\n  setFormState(\n    filePath,\n    { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n    { state: \"ready\", content: \"smoothed(fixture:first prompt)\", derivedAt },\n  );\n  // Tool-activity outcome lives in machine-readable metadata, never inside\n  // provider-authored content (FC-0.3).\n  setFormState(\n    filePath,\n    { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\" },\n    {\n      state: \"ready\",\n      content: \"toolresult(fixture:contents of a.txt)\",\n      metadata: { outcome: \"succeeded\" },\n      derivedAt,\n    },\n  );\n  setFormState(\n    filePath,\n    { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n    { state: \"failed\", reason: \"provider_failure: scripted exhaustion (fixture)\" },\n  );\n  setFormState(\n    filePath,\n    { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\" },\n    { state: \"blocked\", reason: \"source_damaged: manufactured damage (fixture)\" },\n  );\n  return {\n    filePath,\n    expected: [\n      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\", state: \"ready\" },\n      { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\", state: \"ready\" },\n      { subjectKind: \"message\", subjectId: \"m6\", form: \"smoothed_prompt\", state: \"pending\" },\n      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\", state: \"failed\" },\n      { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\", state: \"pending\" },\n      { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\", state: \"blocked\" },\n      { subjectKind: \"turn\", subjectId: \"t2\", form: \"lower_band_projection\", state: \"pending\" },\n    ],\n  };\n}\n\n// ── damaged-source thread (Epic 01 corruption definition) ────────\n\n// A closed turn with its turn_derivation work queued, then the Epic 01\n// two-open-turns corruption — the damage a turn handler must find and the\n// intake pipeline refuses (turn_state_corrupt).\nexport async function damagedSourceThread(\n  store: TempStore,\n): Promise<{ filePath: string; turnId: string }> {\n  const { filePath, turnIds } = await threadWithClosedTurns(store, 1);\n  // Open a second turn through real intake; the corruption writer then adds\n  // another open row — two open turns, the Epic 01 invariant violation.\n  await send(filePath, [validEvent(\"user_prompt\", { payload: { text: \"left open\" } })]);\n  corruptTwoOpenTurns(filePath);\n  const turnId = turnIds[0];\n  if (turnId === undefined) throw new Error(\"fixture invariant: one closed turn expected\");\n  return { filePath, turnId };\n}\n\n// ── gapped-rendering thread (TC-3.2's state, shared) ─────────────\n\n// TC-3.2's gapped-rendering state as one shared builder (coverage.md\n// cross-story debt: TC-4.4 consumes this exact scenario; don't rebuild it by\n// hand). Expects a manual-mode SDK with retry budget 3 and zero backoff:\n// scripts the double to exhaust the prompt's smoothing, then drains — the\n// smoothing lands failed (its work row deleted at exhaustion, DD-1) and the\n// turn rendering lands ready with the recorded gap.\nexport const GAPPED_SMOOTHING_REASON = \"provider_failure: scripted smoothing exhaustion\";\n\nexport async function gappedRenderingThread(\n  store: TempStore,\n  sdk: Lhc,\n  double: ProviderDouble,\n): Promise<{ filePath: string; messageId: string; turnId: string }> {\n  const filePath = await newThreadFile(store);\n  double.failKind(\"prompt_smoothing\", 3, {\n    retryable: true,\n    reason: GAPPED_SMOOTHING_REASON,\n  });\n  await send(filePath, [\n    validEvent(\"user_prompt\", { payload: { text: \"gapped prompt\" } }),\n    validEvent(\"assistant_text\", { payload: { text: \"gapped answer\" } }),\n    validEvent(\"turn_end\"),\n  ]);\n  const drained = await sdk.work.drain({ filePath });\n  if (!drained.ok) throw new Error(`fixture drain failed: ${drained.error.reason}`);\n  const forms = readDerivedForms(filePath);\n  const smoothing = forms.find((f) => f.subjectId === \"m1\" && f.form === \"smoothed_prompt\");\n  const rendering = forms.find((f) => f.subjectId === \"t1\" && f.form === \"turn_rendering\");\n  if (\n    smoothing?.state !== \"failed\" ||\n    rendering?.state !== \"ready\" ||\n    rendering.gaps === undefined\n  ) {\n    throw new Error(\n      \"fixture invariant: failed smoothing under a ready, gapped rendering expected\",\n    );\n  }\n  return { filePath, messageId: \"m1\", turnId: \"t1\" };\n}\n\n// ── twin SDK/CLI threads for parity tests ────────────────────────\n\n// The same batch recorded through the SDK entry and the in-process CLI\n// adapter, under one injected clock, so the two files are comparable\n// record-for-record. Distinct idempotency-key spaces are unnecessary: keys\n// scope per thread file.\nexport async function twinThreads(\n  store: TempStore,\n  batch?: readonly MessageEventInput[],\n): Promise<{ sdkPath: string; cliPath: string; batch: readonly MessageEventInput[] }> {\n  const events =\n    batch ??\n    ([\n      validEvent(\"user_prompt\", { payload: { text: \"twin prompt\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"twin answer\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"call-twin-1\", toolName: \"read_file\", arguments: { path: \"t.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"call-twin-1\", content: \"twin tool output\", isError: false },\n      }),\n      validEvent(\"turn_end\"),\n    ] as const);\n\n  setIntakeClock(() => new Date(\"2026-06-10T12:00:00.000Z\"));\n  try {\n    const sdkPath = await newThreadFile(store);\n    await send(sdkPath, events);\n\n    const cliPath = store.threadPath();\n    const created = await runCli([\n      \"threads\",\n      \"new-thread\",\n      \"--file-path\",\n      cliPath,\n      \"--registry\",\n      store.registryPath,\n    ]);\n    if (created.exitCode !== 0) {\n      throw new Error(`fixture CLI new-thread failed: ${created.stdout}`);\n    }\n    const recorded = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", cliPath],\n      async () => JSON.stringify(events),\n    );\n    if (recorded.exitCode !== 0) {\n      throw new Error(`fixture CLI message-events failed: ${recorded.stdout}`);\n    }\n    return { sdkPath, cliPath, batch: events };\n  } finally {\n    setIntakeClock(null);\n  }\n}\n","numLines":415,"startLine":1,"totalLines":415}}}

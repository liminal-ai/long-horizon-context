{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LXBTsVUcLhbxhL1pcfGs9Y","type":"tool_result","content":"1\t// Visibility-boundary read path (Story 1). The boundary is a source event\n2\t// order shared with the compact point's coordinate system; tool results\n3\t// at-or-behind it render short. Writes — the post-commit advance and\n4\t// compact's reset — land in Stories 4 and 2; this module reads only.\n5\timport type { DatabaseSync } from \"node:sqlite\";\n6\t\n7\t// The singleton row exists from migration v6 on (seeded at position 0,\n8\t// everything full). A missing row is a damaged thread file, surfaced as a\n9\t// throw for the operation boundary's storage_failure wrap.\n10\texport function readBoundaryPosition(db: DatabaseSync): number {\n11\t  const row = db\n12\t    .prepare(`SELECT position FROM view_boundary WHERE thread_singleton = 1`)\n13\t    .get() as { position: number | bigint } | undefined;\n14\t  if (row === undefined) {\n15\t    throw new Error(\"view_boundary singleton row missing (migration v6 seeds it)\");\n16\t  }\n17\t  return Number(row.position);\n18\t}\n19\t\n20\t// The visibility zone's token sum: live (deleted-filtered) tool results ahead\n21\t// of both the boundary position and the compact point, one indexed query.\n22\t// Parameterized by position on purpose (story Technical Notes): Story 4's\n23\t// advance consumes this same function instead of re-deriving the sum, so\n24\t// \"the advance's sum equals what status reports\" is structural — the design\n25\t// requires the two sums equal, and sharing the query makes that a fact of\n26\t// the code rather than a discipline.\n27\texport function visibilityZoneTokens(\n28\t  db: DatabaseSync,\n29\t  position: number,\n30\t  compactPoint: number,\n31\t): number {\n32\t  const row = db\n33\t    .prepare(\n34\t      `SELECT COALESCE(SUM(token_estimate), 0) AS zone FROM message\n35\t       WHERE kind = 'tool_result' AND deleted_at IS NULL\n36\t         AND source_event_order > ? AND source_event_order > ?`,\n37\t    )\n38\t    .get(position, compactPoint) as { zone: number | bigint };\n39\t  return Number(row.zone);\n40\t}\n41\t"}]},"parent_tool_use_id":null,"session_id":"8dde17a3-d739-40da-bd65-ee3687cdd63f","uuid":"43df6a1b-9dbb-4147-9e51-f0b9ab2becfd","timestamp":"2026-06-11T15:11:44.173Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/internal/boundary.ts","content":"// Visibility-boundary read path (Story 1). The boundary is a source event\n// order shared with the compact point's coordinate system; tool results\n// at-or-behind it render short. Writes — the post-commit advance and\n// compact's reset — land in Stories 4 and 2; this module reads only.\nimport type { DatabaseSync } from \"node:sqlite\";\n\n// The singleton row exists from migration v6 on (seeded at position 0,\n// everything full). A missing row is a damaged thread file, surfaced as a\n// throw for the operation boundary's storage_failure wrap.\nexport function readBoundaryPosition(db: DatabaseSync): number {\n  const row = db\n    .prepare(`SELECT position FROM view_boundary WHERE thread_singleton = 1`)\n    .get() as { position: number | bigint } | undefined;\n  if (row === undefined) {\n    throw new Error(\"view_boundary singleton row missing (migration v6 seeds it)\");\n  }\n  return Number(row.position);\n}\n\n// The visibility zone's token sum: live (deleted-filtered) tool results ahead\n// of both the boundary position and the compact point, one indexed query.\n// Parameterized by position on purpose (story Technical Notes): Story 4's\n// advance consumes this same function instead of re-deriving the sum, so\n// \"the advance's sum equals what status reports\" is structural — the design\n// requires the two sums equal, and sharing the query makes that a fact of\n// the code rather than a discipline.\nexport function visibilityZoneTokens(\n  db: DatabaseSync,\n  position: number,\n  compactPoint: number,\n): number {\n  const row = db\n    .prepare(\n      `SELECT COALESCE(SUM(token_estimate), 0) AS zone FROM message\n       WHERE kind = 'tool_result' AND deleted_at IS NULL\n         AND source_event_order > ? AND source_event_order > ?`,\n    )\n    .get(position, compactPoint) as { zone: number | bigint };\n  return Number(row.zone);\n}\n","numLines":41,"startLine":1,"totalLines":41}}}

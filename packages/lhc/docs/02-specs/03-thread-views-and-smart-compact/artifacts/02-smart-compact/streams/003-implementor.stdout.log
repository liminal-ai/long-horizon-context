{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018mBFiDrPKz2KD4pb6PvxnW","type":"tool_result","content":"180\tdescribe(\"FC-0.3: fixture states proven by read-back through the owning report surfaces\", () => {\n181\t  it(\"ready: every turn rendering and the closed chunks' summaries read back ready through turns.report\", async () => {\n182\t    const report = await turns.report({ filePath: fixture.filePath });\n183\t    expect(report.ok).toBe(true);\n184\t    if (!report.ok) return;\n185\t    const renderings = report.value.filter((entry) => entry.form === \"turn_rendering\");\n186\t    expect(renderings.map((entry) => entry.subjectId).sort()).toEqual(\n187\t      [...fixture.turnIds].sort(),\n188\t    );\n189\t    for (const rendering of renderings) {\n190\t      expect(rendering.state).toBe(\"ready\");\n191\t      expect(rendering.content).toBeDefined();\n192\t    }\n193\t    // The fixture's pinned shape: 4 chunks, c1–c3 closed with both summary\n194\t    // forms ready (the drain ran their close→summary enqueues to completion).\n195\t    expect(fixture.chunks.chunks.map((chunk) => `${chunk.chunkId}:${chunk.status}`)).toEqual([\n196\t      \"c1:closed\",\n197\t      \"c2:closed\",\n198\t      \"c3:closed\",\n199\t      \"c4:open\",\n200\t    ]);\n201\t    for (const chunkId of [\"c1\", \"c2\", \"c3\"]) {\n202\t      for (const form of [\"chunk_summary_detailed\", \"chunk_summary_brief\"]) {\n203\t        const summary = report.value.find(\n204\t          (entry) => entry.subjectId === chunkId && entry.form === form,\n205\t        );\n206\t        expect(summary?.state).toBe(\"ready\");\n207\t      }\n208\t    }\n209\t  });\n210\t\n211\t  it(\"failed-transient and failed-permanent: the scripted subjects read back failed through messages.report\", async () => {\n212\t    const report = await messages.report({ filePath: fixture.filePath }, { notReady: true });\n213\t    expect(report.ok).toBe(true);\n214\t    if (!report.ok) return;\n215\t    const transient = report.value.find(\n216\t      (entry) => entry.subjectId === fixture.failedTransientMessageId,\n217\t    );\n218\t    expect(transient?.form).toBe(\"tool_result_summary\");\n219\t    expect(transient?.state).toBe(\"failed\");\n220\t    const permanent = report.value.find(\n221\t      (entry) => entry.subjectId === fixture.failedPermanentMessageId,\n222\t    );\n223\t    expect(permanent?.form).toBe(\"tool_result_summary\");\n224\t    expect(permanent?.state).toBe(\"failed\");\n225\t    // Terminal failures left no live queue rows behind (DD-1): neither entry\n226\t    // carries queue detail.\n227\t    expect(transient?.queue).toBeUndefined();\n228\t    expect(permanent?.queue).toBeUndefined();\n229\t  });\n230\t\n231\t  it(\"blocked: real source damage on the sacrificial sibling lands the turn forms blocked\", async () => {\n232\t    const sibling = await blockedSiblingThread(store);\n233\t    const report = await turns.report({ filePath: sibling.filePath });\n234\t    expect(report.ok).toBe(true);\n235\t    if (!report.ok) return;\n236\t    const blocked = report.value.filter(\n237\t      (entry) => entry.subjectId === sibling.blockedTurnId && entry.state === \"blocked\",\n238\t    );\n239\t    expect(blocked.map((entry) => entry.form).sort()).toEqual([\n240\t      \"lower_band_projection\",\n241\t      \"turn_rendering\",\n242\t    ]);\n243\t    for (const entry of blocked) {\n244\t      expect(entry.reason).toMatch(/^source_damaged: turn state corrupt/);\n245\t    }\n246\t  });\n247\t});\n248\t\n249\tdescribe(\"FC-0.4: the two failed forms carry distinguishable reason classes (Story 3 dependency)\", () => {\n250\t  it(\"transient exhaustion persists the final failure's reason class and its attempt count\", async () => {\n251\t    const report = await messages.report({ filePath: fixture.filePath }, { notReady: true });\n252\t    expect(report.ok).toBe(true);\n253\t    if (!report.ok) return;\n254\t    const transient = report.value.find(\n255\t      (entry) => entry.subjectId === fixture.failedTransientMessageId,\n256\t    );\n257\t    const permanent = report.value.find(\n258\t      (entry) => entry.subjectId === fixture.failedPermanentMessageId,\n259\t    );\n260\t\n261\t    // Not a bare retry-exhausted marker: the persisted reason is the final\n262\t    // provider failure's, classifiable by the sweep's reason-code table.\n263\t    expect(transient?.reason).toBe(TRANSIENT_EXHAUST_REASON);\n264\t    expect(transient?.reason).toMatch(/^rate_limit:/);\n265\t    expect(transient?.metadata?.attempts).toBe(3);\n266\t    expect(transient?.metadata?.lastError).toBe(TRANSIENT_EXHAUST_REASON);\n267\t\n268\t    expect(permanent?.reason).toBe(PERMANENT_FAILURE_REASON);\n269\t    expect(permanent?.reason).toMatch(/^content_refusal:/);\n270\t    expect(permanent?.metadata?.attempts).toBe(1);\n271\t\n272\t    // The classes are distinguishable on read-back — attempt count is NOT\n273\t    // the discriminator (it distinguishes retrying-vs-exhausted only).\n274\t    expect(transient?.reason).not.toBe(permanent?.reason);\n275\t  });\n276\t});\n277\t\n278\tdescribe(\"FC-0.5: corruption and turnless-straggler variants\", () => {\n279\t  it(\"the corruption variant refuses canonical consumption with state_corruption naming the damage\", async () => {\n280\t    const corrupted = await corruptedVariantThread(store);\n281\t    const refused = await corrupted.sdk.intakeStream.messageEvents({ filePath: corrupted.filePath }, [\n282\t      validEvent(\"user_prompt\", { payload: { text: \"after the damage\" } }),\n283\t    ]);\n284\t    expect(refused.ok).toBe(false);\n285\t    if (refused.ok) return;\n286\t    expect(refused.error.errorClass).toBe(\"state_corruption\");\n287\t    expect(refused.error.code).toBe(\"turn_state_corrupt\");\n288\t    expect(refused.error.reason).toMatch(/open turns/);\n289\t  });\n290\t\n291\t  it(\"the straggler variant carries turnId-null notes between two turns and after the last turn\", async () => {\n292\t    const variant = await stragglerVariantThread(store);\n293\t    const listed = await messages.listMessages({ filePath: variant.filePath });\n294\t    const turnList = await turns.listTurns({ filePath: variant.filePath });\n295\t    expect(listed.ok && turnList.ok).toBe(true);\n296\t    if (!listed.ok || !turnList.ok) return;\n297\t\n298\t    const between = listed.value.find(\n299\t      (message) => message.messageId === variant.stragglerBetweenMessageId,"}]},"parent_tool_use_id":null,"session_id":"8dde17a3-d739-40da-bd65-ee3687cdd63f","uuid":"0a968dd3-b275-4ddb-bbcf-76548ebeb26e","timestamp":"2026-06-11T15:45:37.707Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-fixture.test.ts","content":"describe(\"FC-0.3: fixture states proven by read-back through the owning report surfaces\", () => {\n  it(\"ready: every turn rendering and the closed chunks' summaries read back ready through turns.report\", async () => {\n    const report = await turns.report({ filePath: fixture.filePath });\n    expect(report.ok).toBe(true);\n    if (!report.ok) return;\n    const renderings = report.value.filter((entry) => entry.form === \"turn_rendering\");\n    expect(renderings.map((entry) => entry.subjectId).sort()).toEqual(\n      [...fixture.turnIds].sort(),\n    );\n    for (const rendering of renderings) {\n      expect(rendering.state).toBe(\"ready\");\n      expect(rendering.content).toBeDefined();\n    }\n    // The fixture's pinned shape: 4 chunks, c1–c3 closed with both summary\n    // forms ready (the drain ran their close→summary enqueues to completion).\n    expect(fixture.chunks.chunks.map((chunk) => `${chunk.chunkId}:${chunk.status}`)).toEqual([\n      \"c1:closed\",\n      \"c2:closed\",\n      \"c3:closed\",\n      \"c4:open\",\n    ]);\n    for (const chunkId of [\"c1\", \"c2\", \"c3\"]) {\n      for (const form of [\"chunk_summary_detailed\", \"chunk_summary_brief\"]) {\n        const summary = report.value.find(\n          (entry) => entry.subjectId === chunkId && entry.form === form,\n        );\n        expect(summary?.state).toBe(\"ready\");\n      }\n    }\n  });\n\n  it(\"failed-transient and failed-permanent: the scripted subjects read back failed through messages.report\", async () => {\n    const report = await messages.report({ filePath: fixture.filePath }, { notReady: true });\n    expect(report.ok).toBe(true);\n    if (!report.ok) return;\n    const transient = report.value.find(\n      (entry) => entry.subjectId === fixture.failedTransientMessageId,\n    );\n    expect(transient?.form).toBe(\"tool_result_summary\");\n    expect(transient?.state).toBe(\"failed\");\n    const permanent = report.value.find(\n      (entry) => entry.subjectId === fixture.failedPermanentMessageId,\n    );\n    expect(permanent?.form).toBe(\"tool_result_summary\");\n    expect(permanent?.state).toBe(\"failed\");\n    // Terminal failures left no live queue rows behind (DD-1): neither entry\n    // carries queue detail.\n    expect(transient?.queue).toBeUndefined();\n    expect(permanent?.queue).toBeUndefined();\n  });\n\n  it(\"blocked: real source damage on the sacrificial sibling lands the turn forms blocked\", async () => {\n    const sibling = await blockedSiblingThread(store);\n    const report = await turns.report({ filePath: sibling.filePath });\n    expect(report.ok).toBe(true);\n    if (!report.ok) return;\n    const blocked = report.value.filter(\n      (entry) => entry.subjectId === sibling.blockedTurnId && entry.state === \"blocked\",\n    );\n    expect(blocked.map((entry) => entry.form).sort()).toEqual([\n      \"lower_band_projection\",\n      \"turn_rendering\",\n    ]);\n    for (const entry of blocked) {\n      expect(entry.reason).toMatch(/^source_damaged: turn state corrupt/);\n    }\n  });\n});\n\ndescribe(\"FC-0.4: the two failed forms carry distinguishable reason classes (Story 3 dependency)\", () => {\n  it(\"transient exhaustion persists the final failure's reason class and its attempt count\", async () => {\n    const report = await messages.report({ filePath: fixture.filePath }, { notReady: true });\n    expect(report.ok).toBe(true);\n    if (!report.ok) return;\n    const transient = report.value.find(\n      (entry) => entry.subjectId === fixture.failedTransientMessageId,\n    );\n    const permanent = report.value.find(\n      (entry) => entry.subjectId === fixture.failedPermanentMessageId,\n    );\n\n    // Not a bare retry-exhausted marker: the persisted reason is the final\n    // provider failure's, classifiable by the sweep's reason-code table.\n    expect(transient?.reason).toBe(TRANSIENT_EXHAUST_REASON);\n    expect(transient?.reason).toMatch(/^rate_limit:/);\n    expect(transient?.metadata?.attempts).toBe(3);\n    expect(transient?.metadata?.lastError).toBe(TRANSIENT_EXHAUST_REASON);\n\n    expect(permanent?.reason).toBe(PERMANENT_FAILURE_REASON);\n    expect(permanent?.reason).toMatch(/^content_refusal:/);\n    expect(permanent?.metadata?.attempts).toBe(1);\n\n    // The classes are distinguishable on read-back — attempt count is NOT\n    // the discriminator (it distinguishes retrying-vs-exhausted only).\n    expect(transient?.reason).not.toBe(permanent?.reason);\n  });\n});\n\ndescribe(\"FC-0.5: corruption and turnless-straggler variants\", () => {\n  it(\"the corruption variant refuses canonical consumption with state_corruption naming the damage\", async () => {\n    const corrupted = await corruptedVariantThread(store);\n    const refused = await corrupted.sdk.intakeStream.messageEvents({ filePath: corrupted.filePath }, [\n      validEvent(\"user_prompt\", { payload: { text: \"after the damage\" } }),\n    ]);\n    expect(refused.ok).toBe(false);\n    if (refused.ok) return;\n    expect(refused.error.errorClass).toBe(\"state_corruption\");\n    expect(refused.error.code).toBe(\"turn_state_corrupt\");\n    expect(refused.error.reason).toMatch(/open turns/);\n  });\n\n  it(\"the straggler variant carries turnId-null notes between two turns and after the last turn\", async () => {\n    const variant = await stragglerVariantThread(store);\n    const listed = await messages.listMessages({ filePath: variant.filePath });\n    const turnList = await turns.listTurns({ filePath: variant.filePath });\n    expect(listed.ok && turnList.ok).toBe(true);\n    if (!listed.ok || !turnList.ok) return;\n\n    const between = listed.value.find(\n      (message) => message.messageId === variant.stragglerBetweenMessageId,","numLines":120,"startLine":180,"totalLines":360}}}

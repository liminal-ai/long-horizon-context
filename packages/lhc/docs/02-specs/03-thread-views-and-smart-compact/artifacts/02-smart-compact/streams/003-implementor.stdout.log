{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KhGViLSFLo8zLFu2JXgWdf","type":"tool_result","content":"1\timport { AsyncLocalStorage } from \"node:async_hooks\";\n2\timport type { DatabaseSync } from \"node:sqlite\";\n3\timport type { ResolvedViewConfig } from \"./view.js\";\n4\t\n5\texport interface OperationContext {\n6\t  db: DatabaseSync; // open thread-file handle, inside the batch transaction\n7\t  clock: () => Date; // injected for deterministic recordedAt/queuedAt in tests\n8\t  threadId: string; // resolved identity of the thread being operated on\n9\t  // Post-commit callback registration (DD-5): the transaction owner flushes\n10\t  // the registered callbacks after its COMMIT succeeds and drops them on\n11\t  // rollback, so anything registered here — the scheduler poke above all —\n12\t  // is transactional by construction.\n13\t  onCommit: (fn: () => void) => void;\n14\t  // The scheduler poke for the SDK instance whose operation is running (DD-5,\n15\t  // epic-fix-001): enqueue registers its onCommit poke against THIS, carried\n16\t  // on the context, never a shared module slot. Resolved from the per-SDK\n17\t  // seam in scope (background → its own scheduler; manual → a no-op), falling\n18\t  // back to the below-SDK default seam only for direct domain calls with no\n19\t  // SDK around. A manual SDK therefore never auto-drains even with a\n20\t  // background SDK alive in the same process.\n21\t  poke: (threadId: string) => void;\n22\t}\n23\t\n24\t// The callback list behind ctx.onCommit, owned by whoever owns the\n25\t// transaction. Flush after COMMIT; never call flush on a rollback path —\n26\t// dropping the hooks is simply not flushing them.\n27\texport interface CommitHooks {\n28\t  register: (fn: () => void) => void;\n29\t  flush: () => void;\n30\t}\n31\t\n32\texport function createCommitHooks(): CommitHooks {\n33\t  const callbacks: Array<() => void> = [];\n34\t  return {\n35\t    register: (fn) => {\n36\t      callbacks.push(fn);\n37\t    },\n38\t    flush: () => {\n39\t      for (const fn of callbacks.splice(0)) fn();\n40\t    },\n41\t  };\n42\t}\n43\t\n44\t// Per-SDK-instance delivery seam (DD-5/DD-10, epic-fix-001). Each SDK runs\n45\t// every one of its operations inside runWithInstanceSeam, so the code reached\n46\t// deep inside — enqueue's poke and openThreadDatabase's touch — delivers to\n47\t// THAT SDK's scheduler (background) or to a no-op (manual), isolated from any\n48\t// other SDK in the process. Carried through async-context, not a mutable\n49\t// module slot two SDKs would share: that sharing was the bug — a manual SDK\n50\t// auto-drained because a background SDK had overwritten the global slot.\n51\texport interface InstanceSeam {\n52\t  poke: (threadId: string) => void;\n53\t  touch: (filePath: string, db: DatabaseSync) => void;\n54\t  // Epic 03 (tech design Flow 4): the instance's resolved view config rides\n55\t  // the same seam the poke does, so a thread-view operation invoked through\n56\t  // sdk.* reads THIS SDK's profiles/budgets/threshold. Below-SDK direct\n57\t  // domain calls find no seam and fall back to the built-in defaults at the\n58\t  // consuming site (thread-view), never here — shared/ may not import\n59\t  // domains/, and the defaults' one resolution path lives there.\n60\t  view?: ResolvedViewConfig;\n61\t}\n62\tconst seamStore = new AsyncLocalStorage<InstanceSeam>();\n63\t\n64\texport function runWithInstanceSeam<T>(seam: InstanceSeam, fn: () => T): T {\n65\t  return seamStore.run(seam, fn);\n66\t}\n67\t\n68\t// The below-SDK default seam (the former module-global poke/touch slots),\n69\t// kept ONLY as the fallback for direct domain calls made with no SDK seam in\n70\t// scope: the enqueue-atomicity tests that drive enqueue/runInTransaction\n71\t// directly, and the single-background \"production path\" where a top-level\n72\t// mutation still reaches the one installed scheduler. A background SDK\n73\t// installs itself here at construction; a manual SDK leaves it alone AND\n74\t// scopes its own operations to a no-op seam, so the fallback can never\n75\t// auto-drain a manual SDK's queued work.\n76\ttype SchedulerPoke = (threadId: string) => void;\n77\tlet schedulerPoke: SchedulerPoke | null = null;\n78\t\n79\texport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n80\t  schedulerPoke = poke;\n81\t}\n82\t\n83\ttype ThreadTouch = (filePath: string, db: DatabaseSync) => void;\n84\tlet threadTouch: ThreadTouch | null = null;\n85\t\n86\texport function setThreadTouch(touch: ThreadTouch | null): void {\n87\t  threadTouch = touch;\n88\t}\n89\t\n90\t// The poke target for a context built now: the running SDK's seam if one is\n91\t// in scope, else the below-SDK default (null-safe). Captured onto ctx.poke so\n92\t// the enqueue carries its target rather than reading a shared slot at fire\n93\t// time — except, deliberately, through the default fallback for direct calls.\n94\texport function resolveInstancePoke(): (threadId: string) => void {\n95\t  const seam = seamStore.getStore();\n96\t  if (seam !== undefined) return seam.poke;\n97\t  return (threadId) => {\n98\t    schedulerPoke?.(threadId);\n99\t  };\n100\t}\n101\t\n102\t// The view config for the operation now running: the SDK seam's resolved\n103\t// config when one is in scope, undefined for direct domain calls (the\n104\t// thread-view surface defaults those itself — see InstanceSeam.view).\n105\texport function resolveInstanceViewConfig(): ResolvedViewConfig | undefined {\n106\t  return seamStore.getStore()?.view;\n107\t}\n108\t\n109\t// Reads-only operation scope (Epic 03 AC-1.1/AC-2.8): runs fn under the\n110\t// current seam with the thread-touch announcement suppressed, so a pure read\n111\t// — thread-view pull/status above all — can never schedule a background\n112\t// scheduler's first-touch catch-up drain through its openThreadDatabase\n113\t// calls (or those of the report surfaces it consumes). Everything else on\n114\t// the seam (poke target, view config) carries through unchanged; for a\n115\t// direct domain call with no seam in scope the installed scope delegates to\n116\t// the below-SDK defaults, minus the touch. Write paths never use this.\n117\texport function runWithThreadTouchSuppressed<T>(fn: () => T): T {\n118\t  const seam = seamStore.getStore();\n119\t  const base: InstanceSeam =\n120\t    seam ??\n121\t    {\n122\t      poke: (threadId) => {\n123\t        schedulerPoke?.(threadId);\n124\t      },\n125\t      touch: (filePath, db) => {\n126\t        threadTouch?.(filePath, db);\n127\t      },\n128\t    };\n129\t  return seamStore.run({ ...base, touch: () => {} }, fn);\n130\t}\n131\t\n132\t// Thread-file open announcement (DD-10): openThreadDatabase fires this on\n133\t// every open, before any caller transaction begins. Delivers to the SDK seam\n134\t// in scope if any (background → first-touch catch-up; manual → no-op), else\n135\t// the below-SDK default. The background scheduler learns threadId→filePath\n136\t// and runs the first-touch catch-up off this seam.\n137\texport function fireThreadTouch(filePath: string, db: DatabaseSync): void {\n138\t  const seam = seamStore.getStore();\n139\t  if (seam !== undefined) {\n140\t    seam.touch(filePath, db);\n141\t    return;\n142\t  }\n143\t  threadTouch?.(filePath, db);\n144\t}\n145\t\n146\t// Transaction owner for operations outside the intake pipeline (mutations,\n147\t// repair re-queues, tests of enqueue atomicity): BEGIN IMMEDIATE, run the\n148\t// body with a context whose onCommit registrations flush only after COMMIT\n149\t// succeeds and drop whole on rollback.\n150\texport function runInTransaction<T>(\n151\t  db: DatabaseSync,\n152\t  clock: () => Date,\n153\t  threadId: string,\n154\t  fn: (ctx: OperationContext) => T,\n155\t): T {\n156\t  const hooks = createCommitHooks();\n157\t  const poke = resolveInstancePoke();\n158\t  db.exec(\"BEGIN IMMEDIATE;\");\n159\t  let value: T;\n160\t  try {\n161\t    value = fn({ db, clock, threadId, onCommit: hooks.register, poke });\n162\t    db.exec(\"COMMIT;\");\n163\t  } catch (cause) {\n164\t    db.exec(\"ROLLBACK;\");\n165\t    throw cause;\n166\t  }\n167\t  hooks.flush();\n168\t  return value;\n169\t}\n170\t"}]},"parent_tool_use_id":null,"session_id":"8dde17a3-d739-40da-bd65-ee3687cdd63f","uuid":"49bb82f3-e6b0-43fd-beab-29092e73bcfa","timestamp":"2026-06-11T15:12:18.861Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/context.ts","content":"import { AsyncLocalStorage } from \"node:async_hooks\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { ResolvedViewConfig } from \"./view.js\";\n\nexport interface OperationContext {\n  db: DatabaseSync; // open thread-file handle, inside the batch transaction\n  clock: () => Date; // injected for deterministic recordedAt/queuedAt in tests\n  threadId: string; // resolved identity of the thread being operated on\n  // Post-commit callback registration (DD-5): the transaction owner flushes\n  // the registered callbacks after its COMMIT succeeds and drops them on\n  // rollback, so anything registered here — the scheduler poke above all —\n  // is transactional by construction.\n  onCommit: (fn: () => void) => void;\n  // The scheduler poke for the SDK instance whose operation is running (DD-5,\n  // epic-fix-001): enqueue registers its onCommit poke against THIS, carried\n  // on the context, never a shared module slot. Resolved from the per-SDK\n  // seam in scope (background → its own scheduler; manual → a no-op), falling\n  // back to the below-SDK default seam only for direct domain calls with no\n  // SDK around. A manual SDK therefore never auto-drains even with a\n  // background SDK alive in the same process.\n  poke: (threadId: string) => void;\n}\n\n// The callback list behind ctx.onCommit, owned by whoever owns the\n// transaction. Flush after COMMIT; never call flush on a rollback path —\n// dropping the hooks is simply not flushing them.\nexport interface CommitHooks {\n  register: (fn: () => void) => void;\n  flush: () => void;\n}\n\nexport function createCommitHooks(): CommitHooks {\n  const callbacks: Array<() => void> = [];\n  return {\n    register: (fn) => {\n      callbacks.push(fn);\n    },\n    flush: () => {\n      for (const fn of callbacks.splice(0)) fn();\n    },\n  };\n}\n\n// Per-SDK-instance delivery seam (DD-5/DD-10, epic-fix-001). Each SDK runs\n// every one of its operations inside runWithInstanceSeam, so the code reached\n// deep inside — enqueue's poke and openThreadDatabase's touch — delivers to\n// THAT SDK's scheduler (background) or to a no-op (manual), isolated from any\n// other SDK in the process. Carried through async-context, not a mutable\n// module slot two SDKs would share: that sharing was the bug — a manual SDK\n// auto-drained because a background SDK had overwritten the global slot.\nexport interface InstanceSeam {\n  poke: (threadId: string) => void;\n  touch: (filePath: string, db: DatabaseSync) => void;\n  // Epic 03 (tech design Flow 4): the instance's resolved view config rides\n  // the same seam the poke does, so a thread-view operation invoked through\n  // sdk.* reads THIS SDK's profiles/budgets/threshold. Below-SDK direct\n  // domain calls find no seam and fall back to the built-in defaults at the\n  // consuming site (thread-view), never here — shared/ may not import\n  // domains/, and the defaults' one resolution path lives there.\n  view?: ResolvedViewConfig;\n}\nconst seamStore = new AsyncLocalStorage<InstanceSeam>();\n\nexport function runWithInstanceSeam<T>(seam: InstanceSeam, fn: () => T): T {\n  return seamStore.run(seam, fn);\n}\n\n// The below-SDK default seam (the former module-global poke/touch slots),\n// kept ONLY as the fallback for direct domain calls made with no SDK seam in\n// scope: the enqueue-atomicity tests that drive enqueue/runInTransaction\n// directly, and the single-background \"production path\" where a top-level\n// mutation still reaches the one installed scheduler. A background SDK\n// installs itself here at construction; a manual SDK leaves it alone AND\n// scopes its own operations to a no-op seam, so the fallback can never\n// auto-drain a manual SDK's queued work.\ntype SchedulerPoke = (threadId: string) => void;\nlet schedulerPoke: SchedulerPoke | null = null;\n\nexport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n  schedulerPoke = poke;\n}\n\ntype ThreadTouch = (filePath: string, db: DatabaseSync) => void;\nlet threadTouch: ThreadTouch | null = null;\n\nexport function setThreadTouch(touch: ThreadTouch | null): void {\n  threadTouch = touch;\n}\n\n// The poke target for a context built now: the running SDK's seam if one is\n// in scope, else the below-SDK default (null-safe). Captured onto ctx.poke so\n// the enqueue carries its target rather than reading a shared slot at fire\n// time — except, deliberately, through the default fallback for direct calls.\nexport function resolveInstancePoke(): (threadId: string) => void {\n  const seam = seamStore.getStore();\n  if (seam !== undefined) return seam.poke;\n  return (threadId) => {\n    schedulerPoke?.(threadId);\n  };\n}\n\n// The view config for the operation now running: the SDK seam's resolved\n// config when one is in scope, undefined for direct domain calls (the\n// thread-view surface defaults those itself — see InstanceSeam.view).\nexport function resolveInstanceViewConfig(): ResolvedViewConfig | undefined {\n  return seamStore.getStore()?.view;\n}\n\n// Reads-only operation scope (Epic 03 AC-1.1/AC-2.8): runs fn under the\n// current seam with the thread-touch announcement suppressed, so a pure read\n// — thread-view pull/status above all — can never schedule a background\n// scheduler's first-touch catch-up drain through its openThreadDatabase\n// calls (or those of the report surfaces it consumes). Everything else on\n// the seam (poke target, view config) carries through unchanged; for a\n// direct domain call with no seam in scope the installed scope delegates to\n// the below-SDK defaults, minus the touch. Write paths never use this.\nexport function runWithThreadTouchSuppressed<T>(fn: () => T): T {\n  const seam = seamStore.getStore();\n  const base: InstanceSeam =\n    seam ??\n    {\n      poke: (threadId) => {\n        schedulerPoke?.(threadId);\n      },\n      touch: (filePath, db) => {\n        threadTouch?.(filePath, db);\n      },\n    };\n  return seamStore.run({ ...base, touch: () => {} }, fn);\n}\n\n// Thread-file open announcement (DD-10): openThreadDatabase fires this on\n// every open, before any caller transaction begins. Delivers to the SDK seam\n// in scope if any (background → first-touch catch-up; manual → no-op), else\n// the below-SDK default. The background scheduler learns threadId→filePath\n// and runs the first-touch catch-up off this seam.\nexport function fireThreadTouch(filePath: string, db: DatabaseSync): void {\n  const seam = seamStore.getStore();\n  if (seam !== undefined) {\n    seam.touch(filePath, db);\n    return;\n  }\n  threadTouch?.(filePath, db);\n}\n\n// Transaction owner for operations outside the intake pipeline (mutations,\n// repair re-queues, tests of enqueue atomicity): BEGIN IMMEDIATE, run the\n// body with a context whose onCommit registrations flush only after COMMIT\n// succeeds and drop whole on rollback.\nexport function runInTransaction<T>(\n  db: DatabaseSync,\n  clock: () => Date,\n  threadId: string,\n  fn: (ctx: OperationContext) => T,\n): T {\n  const hooks = createCommitHooks();\n  const poke = resolveInstancePoke();\n  db.exec(\"BEGIN IMMEDIATE;\");\n  let value: T;\n  try {\n    value = fn({ db, clock, threadId, onCommit: hooks.register, poke });\n    db.exec(\"COMMIT;\");\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n  hooks.flush();\n  return value;\n}\n","numLines":170,"startLine":1,"totalLines":170}}}

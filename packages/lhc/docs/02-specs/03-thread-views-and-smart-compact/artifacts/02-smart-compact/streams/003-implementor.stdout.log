{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019jexh9zE51gqEY7YCaXtU7","type":"tool_result","content":"1\t// Tail and band formatting (Story 1): the seven-kind tail mapping table\n2\t// (tech design §Tail message rendering — contract, not implementation\n3\t// choice), short/full tool-result selection by boundary position, and the\n4\t// short-form ladder (ready summary → deterministic truncation). Pure\n5\t// functions over read state by design: no DB handle, no provider, no clock —\n6\t// determinism is structural (AC-1.7 byte-identical pulls fall out of it).\n7\timport type { Band, ViewMessage } from \"../../../shared/view.js\";\n8\timport type { TailMessageRow } from \"./snapshot.js\";\n9\t\n10\t// Epic 01's deterministic abbreviation rule: a fixed prefix plus an exact\n11\t// tail marker, a pure function of the input string alone. Restated here —\n12\t// byte-identical to turns/internal/compose.ts's truncateForFallback —\n13\t// because cross-domain internals may not be imported and the turns domain\n14\t// is frozen for this epic (tech design §Top-Tier Surfaces: no changes).\n15\texport const ABBREVIATION_LIMIT = 200;\n16\t\n17\texport function deterministicTruncation(text: string): string {\n18\t  if (text.length <= ABBREVIATION_LIMIT) return text;\n19\t  const dropped = text.length - ABBREVIATION_LIMIT;\n20\t  return `${text.slice(0, ABBREVIATION_LIMIT)}… [truncated ${dropped} chars]`;\n21\t}\n22\t\n23\tfunction blockContent(message: TailMessageRow): Record<string, unknown> {\n24\t  return message.blocks[0]?.content ?? {};\n25\t}\n26\t\n27\tfunction textOf(message: TailMessageRow): string {\n28\t  const text = blockContent(message)[\"text\"];\n29\t  return typeof text === \"string\" ? text : \"\";\n30\t}\n31\t\n32\t// What the tail renderer needs beyond the message itself: the boundary\n33\t// position (short/full selection), the call-id → tool-name pairing (results\n34\t// carry only their call id), and the ready tool-result summaries (the\n35\t// short-form ladder's first rung).\n36\texport interface TailRenderContext {\n37\t  boundaryPosition: number;\n38\t  toolNameByCallId: ReadonlyMap<string, string>;\n39\t  toolResultSummaries: ReadonlyMap<string, string>;\n40\t}\n41\t\n42\t// The call-id → tool-name map from the messages in hand. Pairing within the\n43\t// tail is structurally sufficient: the compact point snaps to a turn start,\n44\t// so a tail result's call is never behind it.\n45\texport function toolNamesByCallId(\n46\t  messages: readonly TailMessageRow[],\n47\t): Map<string, string> {\n48\t  const names = new Map<string, string>();\n49\t  for (const message of messages) {\n50\t    if (message.kind !== \"tool_call\") continue;\n51\t    const block = blockContent(message);\n52\t    const callId = block[\"toolCallId\"];\n53\t    const toolName = block[\"toolName\"];\n54\t    if (typeof callId === \"string\" && typeof toolName === \"string\") {\n55\t      names.set(callId, toolName);\n56\t    }\n57\t  }\n58\t  return names;\n59\t}\n60\t\n61\tfunction renderToolCall(message: TailMessageRow): ViewMessage {\n62\t  const block = blockContent(message);\n63\t  const name = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n64\t  // Deterministic arg rendering: the projected arguments serialized verbatim,\n65\t  // oversized args abbreviated by the same Epic 01 rule.\n66\t  const args = deterministicTruncation(JSON.stringify(block[\"arguments\"] ?? {}));\n67\t  return { role: \"assistant\", content: `[tool call · ${name}] ${args}` };\n68\t}\n69\t\n70\tfunction renderToolResult(message: TailMessageRow, ctx: TailRenderContext): ViewMessage {\n71\t  const block = blockContent(message);\n72\t  const callId = block[\"toolCallId\"];\n73\t  const name =\n74\t    (typeof callId === \"string\" ? ctx.toolNameByCallId.get(callId) : undefined) ??\n75\t    \"unknown_tool\";\n76\t  const content = typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\";\n77\t  if (message.sourceEventOrder > ctx.boundaryPosition) {\n78\t    return { role: \"user\", content: `[tool result · ${name}]\\n${content}` };\n79\t  }\n80\t  // At-or-behind the boundary: the short-form ladder — the ready summary\n81\t  // when usable, else deterministic truncation of the raw content (AC-4.2's\n82\t  // vocabulary; the default-boundary leg lands here in Story 1). Short-form\n83\t  // rendering marks that fuller content exists in the record.\n84\t  const short = ctx.toolResultSummaries.get(message.messageId) ?? deterministicTruncation(content);\n85\t  return {\n86\t    role: \"user\",\n87\t    content: `[tool result · ${name} · abridged]\\n${short} [full content in record §${message.messageId}]`,\n88\t  };\n89\t}\n90\t\n91\t// One tail message → one ViewMessage per the mapping table. Each kind is its\n92\t// own arm so a single kind's drift fails its own named test leg.\n93\texport function renderTailMessage(\n94\t  message: TailMessageRow,\n95\t  ctx: TailRenderContext,\n96\t): ViewMessage {\n97\t  switch (message.kind) {\n98\t    case \"user_prompt\":\n99\t      return { role: \"user\", content: textOf(message) };\n100\t    case \"assistant_text\":\n101\t      return { role: \"assistant\", content: textOf(message) };\n102\t    case \"assistant_thinking\":\n103\t      // Included: the tail is full fidelity (bands compress thinking away for\n104\t      // older turns); harness-side conversion may re-block or drop.\n105\t      return { role: \"assistant\", content: `[thinking]\\n${textOf(message)}\\n[/thinking]` };\n106\t    case \"tool_call\":\n107\t      return renderToolCall(message);\n108\t    case \"tool_result\":\n109\t      return renderToolResult(message, ctx);\n110\t    case \"runtime_note\":\n111\t      return { role: \"user\", content: `[runtime note] ${textOf(message)}` };\n112\t  }\n113\t}\n114\t\n115\t// One non-empty band → one labeled `user` message: band-marker header, then\n116\t// the snapshot bytes verbatim (AC-5.1 resolution: provider APIs reject\n117\t// unknown roles; `user` is what the MVP's injection used).\n118\texport function renderBandMessage(band: Band, renderedText: string): ViewMessage {\n119\t  return { role: \"user\", band, content: `[context · ${band}]\\n${renderedText}` };\n120\t}\n121\t"}]},"parent_tool_use_id":null,"session_id":"8dde17a3-d739-40da-bd65-ee3687cdd63f","uuid":"bcbc0c47-6144-4b9d-941c-6b81a400be26","timestamp":"2026-06-11T15:11:38.311Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/internal/render.ts","content":"// Tail and band formatting (Story 1): the seven-kind tail mapping table\n// (tech design §Tail message rendering — contract, not implementation\n// choice), short/full tool-result selection by boundary position, and the\n// short-form ladder (ready summary → deterministic truncation). Pure\n// functions over read state by design: no DB handle, no provider, no clock —\n// determinism is structural (AC-1.7 byte-identical pulls fall out of it).\nimport type { Band, ViewMessage } from \"../../../shared/view.js\";\nimport type { TailMessageRow } from \"./snapshot.js\";\n\n// Epic 01's deterministic abbreviation rule: a fixed prefix plus an exact\n// tail marker, a pure function of the input string alone. Restated here —\n// byte-identical to turns/internal/compose.ts's truncateForFallback —\n// because cross-domain internals may not be imported and the turns domain\n// is frozen for this epic (tech design §Top-Tier Surfaces: no changes).\nexport const ABBREVIATION_LIMIT = 200;\n\nexport function deterministicTruncation(text: string): string {\n  if (text.length <= ABBREVIATION_LIMIT) return text;\n  const dropped = text.length - ABBREVIATION_LIMIT;\n  return `${text.slice(0, ABBREVIATION_LIMIT)}… [truncated ${dropped} chars]`;\n}\n\nfunction blockContent(message: TailMessageRow): Record<string, unknown> {\n  return message.blocks[0]?.content ?? {};\n}\n\nfunction textOf(message: TailMessageRow): string {\n  const text = blockContent(message)[\"text\"];\n  return typeof text === \"string\" ? text : \"\";\n}\n\n// What the tail renderer needs beyond the message itself: the boundary\n// position (short/full selection), the call-id → tool-name pairing (results\n// carry only their call id), and the ready tool-result summaries (the\n// short-form ladder's first rung).\nexport interface TailRenderContext {\n  boundaryPosition: number;\n  toolNameByCallId: ReadonlyMap<string, string>;\n  toolResultSummaries: ReadonlyMap<string, string>;\n}\n\n// The call-id → tool-name map from the messages in hand. Pairing within the\n// tail is structurally sufficient: the compact point snaps to a turn start,\n// so a tail result's call is never behind it.\nexport function toolNamesByCallId(\n  messages: readonly TailMessageRow[],\n): Map<string, string> {\n  const names = new Map<string, string>();\n  for (const message of messages) {\n    if (message.kind !== \"tool_call\") continue;\n    const block = blockContent(message);\n    const callId = block[\"toolCallId\"];\n    const toolName = block[\"toolName\"];\n    if (typeof callId === \"string\" && typeof toolName === \"string\") {\n      names.set(callId, toolName);\n    }\n  }\n  return names;\n}\n\nfunction renderToolCall(message: TailMessageRow): ViewMessage {\n  const block = blockContent(message);\n  const name = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n  // Deterministic arg rendering: the projected arguments serialized verbatim,\n  // oversized args abbreviated by the same Epic 01 rule.\n  const args = deterministicTruncation(JSON.stringify(block[\"arguments\"] ?? {}));\n  return { role: \"assistant\", content: `[tool call · ${name}] ${args}` };\n}\n\nfunction renderToolResult(message: TailMessageRow, ctx: TailRenderContext): ViewMessage {\n  const block = blockContent(message);\n  const callId = block[\"toolCallId\"];\n  const name =\n    (typeof callId === \"string\" ? ctx.toolNameByCallId.get(callId) : undefined) ??\n    \"unknown_tool\";\n  const content = typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\";\n  if (message.sourceEventOrder > ctx.boundaryPosition) {\n    return { role: \"user\", content: `[tool result · ${name}]\\n${content}` };\n  }\n  // At-or-behind the boundary: the short-form ladder — the ready summary\n  // when usable, else deterministic truncation of the raw content (AC-4.2's\n  // vocabulary; the default-boundary leg lands here in Story 1). Short-form\n  // rendering marks that fuller content exists in the record.\n  const short = ctx.toolResultSummaries.get(message.messageId) ?? deterministicTruncation(content);\n  return {\n    role: \"user\",\n    content: `[tool result · ${name} · abridged]\\n${short} [full content in record §${message.messageId}]`,\n  };\n}\n\n// One tail message → one ViewMessage per the mapping table. Each kind is its\n// own arm so a single kind's drift fails its own named test leg.\nexport function renderTailMessage(\n  message: TailMessageRow,\n  ctx: TailRenderContext,\n): ViewMessage {\n  switch (message.kind) {\n    case \"user_prompt\":\n      return { role: \"user\", content: textOf(message) };\n    case \"assistant_text\":\n      return { role: \"assistant\", content: textOf(message) };\n    case \"assistant_thinking\":\n      // Included: the tail is full fidelity (bands compress thinking away for\n      // older turns); harness-side conversion may re-block or drop.\n      return { role: \"assistant\", content: `[thinking]\\n${textOf(message)}\\n[/thinking]` };\n    case \"tool_call\":\n      return renderToolCall(message);\n    case \"tool_result\":\n      return renderToolResult(message, ctx);\n    case \"runtime_note\":\n      return { role: \"user\", content: `[runtime note] ${textOf(message)}` };\n  }\n}\n\n// One non-empty band → one labeled `user` message: band-marker header, then\n// the snapshot bytes verbatim (AC-5.1 resolution: provider APIs reject\n// unknown roles; `user` is what the MVP's injection used).\nexport function renderBandMessage(band: Band, renderedText: string): ViewMessage {\n  return { role: \"user\", band, content: `[context · ${band}]\\n${renderedText}` };\n}\n","numLines":121,"startLine":1,"totalLines":121}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0161KQxBEu711bJmbhENsU8d","type":"tool_result","content":"1\timport { randomBytes } from \"node:crypto\";\n2\timport { rmSync } from \"node:fs\";\n3\timport { DatabaseSync } from \"node:sqlite\";\n4\timport { fireThreadTouch } from \"../../../shared/context.js\";\n5\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n6\timport {\n7\t  getSchemaVersion,\n8\t  MIGRATION_V5_STATEMENTS,\n9\t  MIGRATION_V6_STATEMENTS,\n10\t  openDatabase,\n11\t  runMigrations,\n12\t  type Migration,\n13\t} from \"../../../shared/storage.js\";\n14\timport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n15\t\n16\t// The one random id: its uniqueness scope is global across files and\n17\t// registries (design decision 7).\n18\texport function generateThreadId(): string {\n19\t  return `th_${randomBytes(8).toString(\"hex\")}`;\n20\t}\n21\t\n22\t// The thread-file schema as a versioned history, never rewritten in place:\n23\t// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n24\t// each later story appends a version. Existing files upgrade lazily through\n25\t// openThreadDatabase, so a file recorded under an earlier story is always\n26\t// usable by a later one (F-03-001).\n27\t//\n28\t// Creation-time metadata values are interpolated through buildThreadMigrations\n29\t// for new files only; existing files already hold their metadata row and the\n30\t// upgrade path never touches it.\n31\tfunction buildThreadMigrations(\n32\t  metadata?: { threadId: string; createdAt: string },\n33\t): Migration[] {\n34\t  const metadataInsert =\n35\t    metadata === undefined\n36\t      ? []\n37\t      : [\n38\t          // Interpolated values are all generated by us (hex id, ISO\n39\t          // timestamp, estimator constant) — never caller input.\n40\t          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n41\t           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n42\t        ];\n43\t  return [\n44\t    {\n45\t      version: 1,\n46\t      statements: [\n47\t        `CREATE TABLE thread_metadata (\n48\t          id INTEGER PRIMARY KEY CHECK (id = 1),\n49\t          thread_id TEXT NOT NULL,\n50\t          created_at TEXT NOT NULL,\n51\t          token_estimator TEXT NOT NULL\n52\t        );`,\n53\t        ...metadataInsert,\n54\t        `CREATE TABLE event (\n55\t          event_order INTEGER PRIMARY KEY,\n56\t          event_kind TEXT NOT NULL,\n57\t          idempotency_key TEXT NOT NULL UNIQUE,\n58\t          actor TEXT NOT NULL,\n59\t          harness TEXT NOT NULL,\n60\t          payload TEXT NOT NULL,\n61\t          recorded_at TEXT NOT NULL\n62\t        );`,\n63\t      ],\n64\t    },\n65\t    {\n66\t      version: 2, // Story 3: message projection\n67\t      statements: [\n68\t        `CREATE TABLE message (\n69\t          message_id TEXT PRIMARY KEY,\n70\t          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n71\t          kind TEXT NOT NULL,\n72\t          token_estimate INTEGER NOT NULL,\n73\t          actor TEXT NOT NULL,\n74\t          harness TEXT NOT NULL,\n75\t          turn_id TEXT\n76\t        );`,\n77\t        `CREATE TABLE message_block (\n78\t          message_id TEXT NOT NULL REFERENCES message(message_id),\n79\t          block_index INTEGER NOT NULL,\n80\t          block_type TEXT NOT NULL,\n81\t          content TEXT NOT NULL,\n82\t          PRIMARY KEY (message_id, block_index)\n83\t        );`,\n84\t      ],\n85\t    },\n86\t    {\n87\t      version: 3, // Story 4: turn state machine\n88\t      statements: [\n89\t        `CREATE TABLE turns (\n90\t          turn_id TEXT PRIMARY KEY,\n91\t          turn_order INTEGER NOT NULL UNIQUE,\n92\t          status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n93\t          opened_at_event_order INTEGER NOT NULL,\n94\t          closed_at_event_order INTEGER\n95\t        );`,\n96\t      ],\n97\t    },\n98\t    {\n99\t      version: 4, // Story 5: derivation work queueing\n100\t      statements: [\n101\t        // Work items live in the thread file and commit with the batch —\n102\t        // not a separate database, not a separate transaction. status is\n103\t        // unconstrained TEXT: this epic only ever writes 'queued'; the\n104\t        // claim/lease statuses are Epic 02's to add.\n105\t        `CREATE TABLE work_item (\n106\t          work_item_id TEXT PRIMARY KEY,\n107\t          owner TEXT NOT NULL,\n108\t          kind TEXT NOT NULL,\n109\t          source_ref TEXT NOT NULL,\n110\t          status TEXT NOT NULL,\n111\t          queued_at TEXT NOT NULL\n112\t        );`,\n113\t      ],\n114\t    },\n115\t    {\n116\t      version: 5, // Epic 02 Story 0: queue mechanical fields, derived_form,\n117\t      // chunk tables, deleted_at stamps, F-02 pending-row backfill — the\n118\t      // epic's single migration (tech design §Storage), statements owned by\n119\t      // shared/storage.ts.\n120\t      statements: MIGRATION_V5_STATEMENTS,\n121\t    },\n122\t    {\n123\t      version: 6, // Epic 03 Story 0: thread-view snapshot tables and the\n124\t      // visibility boundary (seeded at position 0) — the epic's single\n125\t      // migration (tech design §Storage), statements owned by\n126\t      // shared/storage.ts.\n127\t      statements: MIGRATION_V6_STATEMENTS,\n128\t    },\n129\t  ];\n130\t}\n131\t\n132\tfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n133\t  return {\n134\t    ok: false,\n135\t    error: {\n136\t      errorClass: \"caller_error\",\n137\t      code: \"thread_not_found\",\n138\t      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n139\t    },\n140\t  };\n141\t}\n142\t\n143\tfunction errorDetail(cause: unknown): string {\n144\t  return cause instanceof Error ? cause.message : String(cause);\n145\t}\n146\t\n147\t// Identity check before any migration runs, on a read-only handle so an\n148\t// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n149\t// file always carries schema version >= 1 and the thread_metadata singleton\n150\t// row that creation wrote transactionally. Anything else — an empty\n151\t// database, an unrelated SQLite file, a non-database file — is rejected as a\n152\t// caller error, never adopted.\n153\tfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n154\t  let db: DatabaseSync | undefined;\n155\t  try {\n156\t    db = new DatabaseSync(filePath, { readOnly: true });\n157\t    if (getSchemaVersion(db) < 1) {\n158\t      return notAThreadFile(filePath, \"no lhc schema version\");\n159\t    }\n160\t    const table = db\n161\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n162\t      .get();\n163\t    if (table === undefined) {\n164\t      return notAThreadFile(filePath, \"no thread_metadata table\");\n165\t    }\n166\t    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n167\t    if (row === undefined) {\n168\t      return notAThreadFile(filePath, \"no thread metadata row\");\n169\t    }\n170\t    return { ok: true };\n171\t  } catch (cause) {\n172\t    const detail = errorDetail(cause);\n173\t    // SQLite refusing the file as a database is an identity failure, not an\n174\t    // environment failure; everything else stays a system error.\n175\t    if (detail.includes(\"not a database\")) {\n176\t      return notAThreadFile(filePath, detail);\n177\t    }\n178\t    return storageFailure(`could not inspect thread file: ${detail}`);\n179\t  } finally {\n180\t    db?.close();\n181\t  }\n182\t}\n183\t\n184\t// Opens a thread file and brings its schema to the current version before\n185\t// returning the handle. Every SDK operation on an existing thread file goes\n186\t// through here, so a pre-Story-3 file gains the message tables on its first\n187\t// open by newer code — but only after the file proves it is a thread file;\n188\t// migration never creates lhc schema on an arbitrary existing file. Each\n189\t// migration runs in its own transaction (storage helper), completing before\n190\t// any caller transaction begins.\n191\texport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n192\t  const valid = validateThreadFile(filePath);\n193\t  if (!valid.ok) return valid;\n194\t  let db: DatabaseSync;\n195\t  try {\n196\t    db = openDatabase(filePath);\n197\t  } catch (cause) {\n198\t    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n199\t  }\n200\t  try {\n201\t    runMigrations(db, buildThreadMigrations());\n202\t  } catch (cause) {\n203\t    db.close();\n204\t    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n205\t  }\n206\t  // Announce the open (DD-10): the background scheduler's first-touch\n207\t  // catch-up hangs off this seam. Fired before any caller transaction\n208\t  // begins; a no-op unless a listener is installed.\n209\t  fireThreadTouch(filePath, db);\n210\t  return { ok: true, value: db };\n211\t}\n212\t\n213\t// Schema v1 plus the metadata row land in one migration transaction, so the\n214\t// file either has its full schema and metadata row or creation fails whole.\n215\texport function createThreadFile(\n216\t  filePath: string,\n217\t  threadId: string,\n218\t  createdAt: string,\n219\t): void {\n220\t  const db = openDatabase(filePath);\n221\t  try {\n222\t    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n223\t  } finally {\n224\t    db.close();\n225\t  }\n226\t}\n227\t\n228\t// Compensation: removes the thread file and its WAL companions. Used when the\n229\t// registry insert fails after file creation (no registry row without its\n230\t// file) and when file creation itself fails partway.\n231\texport function deleteThreadFile(filePath: string): void {\n232\t  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n233\t    rmSync(`${filePath}${suffix}`, { force: true });\n234\t  }\n235\t}\n236\t"}]},"parent_tool_use_id":null,"session_id":"8dde17a3-d739-40da-bd65-ee3687cdd63f","uuid":"ac4abbe6-df57-4320-84ee-d879e1a38949","timestamp":"2026-06-11T15:12:18.272Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/threads/internal/create.ts","content":"import { randomBytes } from \"node:crypto\";\nimport { rmSync } from \"node:fs\";\nimport { DatabaseSync } from \"node:sqlite\";\nimport { fireThreadTouch } from \"../../../shared/context.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\nimport {\n  getSchemaVersion,\n  MIGRATION_V5_STATEMENTS,\n  MIGRATION_V6_STATEMENTS,\n  openDatabase,\n  runMigrations,\n  type Migration,\n} from \"../../../shared/storage.js\";\nimport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n\n// The one random id: its uniqueness scope is global across files and\n// registries (design decision 7).\nexport function generateThreadId(): string {\n  return `th_${randomBytes(8).toString(\"hex\")}`;\n}\n\n// The thread-file schema as a versioned history, never rewritten in place:\n// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n// each later story appends a version. Existing files upgrade lazily through\n// openThreadDatabase, so a file recorded under an earlier story is always\n// usable by a later one (F-03-001).\n//\n// Creation-time metadata values are interpolated through buildThreadMigrations\n// for new files only; existing files already hold their metadata row and the\n// upgrade path never touches it.\nfunction buildThreadMigrations(\n  metadata?: { threadId: string; createdAt: string },\n): Migration[] {\n  const metadataInsert =\n    metadata === undefined\n      ? []\n      : [\n          // Interpolated values are all generated by us (hex id, ISO\n          // timestamp, estimator constant) — never caller input.\n          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n        ];\n  return [\n    {\n      version: 1,\n      statements: [\n        `CREATE TABLE thread_metadata (\n          id INTEGER PRIMARY KEY CHECK (id = 1),\n          thread_id TEXT NOT NULL,\n          created_at TEXT NOT NULL,\n          token_estimator TEXT NOT NULL\n        );`,\n        ...metadataInsert,\n        `CREATE TABLE event (\n          event_order INTEGER PRIMARY KEY,\n          event_kind TEXT NOT NULL,\n          idempotency_key TEXT NOT NULL UNIQUE,\n          actor TEXT NOT NULL,\n          harness TEXT NOT NULL,\n          payload TEXT NOT NULL,\n          recorded_at TEXT NOT NULL\n        );`,\n      ],\n    },\n    {\n      version: 2, // Story 3: message projection\n      statements: [\n        `CREATE TABLE message (\n          message_id TEXT PRIMARY KEY,\n          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n          kind TEXT NOT NULL,\n          token_estimate INTEGER NOT NULL,\n          actor TEXT NOT NULL,\n          harness TEXT NOT NULL,\n          turn_id TEXT\n        );`,\n        `CREATE TABLE message_block (\n          message_id TEXT NOT NULL REFERENCES message(message_id),\n          block_index INTEGER NOT NULL,\n          block_type TEXT NOT NULL,\n          content TEXT NOT NULL,\n          PRIMARY KEY (message_id, block_index)\n        );`,\n      ],\n    },\n    {\n      version: 3, // Story 4: turn state machine\n      statements: [\n        `CREATE TABLE turns (\n          turn_id TEXT PRIMARY KEY,\n          turn_order INTEGER NOT NULL UNIQUE,\n          status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n          opened_at_event_order INTEGER NOT NULL,\n          closed_at_event_order INTEGER\n        );`,\n      ],\n    },\n    {\n      version: 4, // Story 5: derivation work queueing\n      statements: [\n        // Work items live in the thread file and commit with the batch —\n        // not a separate database, not a separate transaction. status is\n        // unconstrained TEXT: this epic only ever writes 'queued'; the\n        // claim/lease statuses are Epic 02's to add.\n        `CREATE TABLE work_item (\n          work_item_id TEXT PRIMARY KEY,\n          owner TEXT NOT NULL,\n          kind TEXT NOT NULL,\n          source_ref TEXT NOT NULL,\n          status TEXT NOT NULL,\n          queued_at TEXT NOT NULL\n        );`,\n      ],\n    },\n    {\n      version: 5, // Epic 02 Story 0: queue mechanical fields, derived_form,\n      // chunk tables, deleted_at stamps, F-02 pending-row backfill — the\n      // epic's single migration (tech design §Storage), statements owned by\n      // shared/storage.ts.\n      statements: MIGRATION_V5_STATEMENTS,\n    },\n    {\n      version: 6, // Epic 03 Story 0: thread-view snapshot tables and the\n      // visibility boundary (seeded at position 0) — the epic's single\n      // migration (tech design §Storage), statements owned by\n      // shared/storage.ts.\n      statements: MIGRATION_V6_STATEMENTS,\n    },\n  ];\n}\n\nfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n    },\n  };\n}\n\nfunction errorDetail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n// Identity check before any migration runs, on a read-only handle so an\n// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n// file always carries schema version >= 1 and the thread_metadata singleton\n// row that creation wrote transactionally. Anything else — an empty\n// database, an unrelated SQLite file, a non-database file — is rejected as a\n// caller error, never adopted.\nfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n  let db: DatabaseSync | undefined;\n  try {\n    db = new DatabaseSync(filePath, { readOnly: true });\n    if (getSchemaVersion(db) < 1) {\n      return notAThreadFile(filePath, \"no lhc schema version\");\n    }\n    const table = db\n      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n      .get();\n    if (table === undefined) {\n      return notAThreadFile(filePath, \"no thread_metadata table\");\n    }\n    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n    if (row === undefined) {\n      return notAThreadFile(filePath, \"no thread metadata row\");\n    }\n    return { ok: true };\n  } catch (cause) {\n    const detail = errorDetail(cause);\n    // SQLite refusing the file as a database is an identity failure, not an\n    // environment failure; everything else stays a system error.\n    if (detail.includes(\"not a database\")) {\n      return notAThreadFile(filePath, detail);\n    }\n    return storageFailure(`could not inspect thread file: ${detail}`);\n  } finally {\n    db?.close();\n  }\n}\n\n// Opens a thread file and brings its schema to the current version before\n// returning the handle. Every SDK operation on an existing thread file goes\n// through here, so a pre-Story-3 file gains the message tables on its first\n// open by newer code — but only after the file proves it is a thread file;\n// migration never creates lhc schema on an arbitrary existing file. Each\n// migration runs in its own transaction (storage helper), completing before\n// any caller transaction begins.\nexport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n  const valid = validateThreadFile(filePath);\n  if (!valid.ok) return valid;\n  let db: DatabaseSync;\n  try {\n    db = openDatabase(filePath);\n  } catch (cause) {\n    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n  }\n  try {\n    runMigrations(db, buildThreadMigrations());\n  } catch (cause) {\n    db.close();\n    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n  }\n  // Announce the open (DD-10): the background scheduler's first-touch\n  // catch-up hangs off this seam. Fired before any caller transaction\n  // begins; a no-op unless a listener is installed.\n  fireThreadTouch(filePath, db);\n  return { ok: true, value: db };\n}\n\n// Schema v1 plus the metadata row land in one migration transaction, so the\n// file either has its full schema and metadata row or creation fails whole.\nexport function createThreadFile(\n  filePath: string,\n  threadId: string,\n  createdAt: string,\n): void {\n  const db = openDatabase(filePath);\n  try {\n    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n  } finally {\n    db.close();\n  }\n}\n\n// Compensation: removes the thread file and its WAL companions. Used when the\n// registry insert fails after file creation (no registry row without its\n// file) and when file creation itself fails partway.\nexport function deleteThreadFile(filePath: string): void {\n  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n    rmSync(`${filePath}${suffix}`, { force: true });\n  }\n}\n","numLines":236,"startLine":1,"totalLines":236}}}

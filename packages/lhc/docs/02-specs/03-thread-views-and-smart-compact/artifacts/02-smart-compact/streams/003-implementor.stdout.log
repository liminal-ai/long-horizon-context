{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FciXz8DjYBqti8spTpYwuA","type":"tool_result","content":"1\texport * as threads from \"./domains/threads/index.js\";\n2\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n3\texport * as messages from \"./domains/messages/index.js\";\n4\texport * as turns from \"./domains/turns/index.js\";\n5\texport * as threadView from \"./domains/thread-view/index.js\";\n6\t\n7\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n8\timport * as threadViewDomain from \"./domains/thread-view/index.js\";\n9\timport { resolveViewConfig } from \"./domains/thread-view/index.js\";\n10\timport * as messagesDomain from \"./domains/messages/index.js\";\n11\timport * as threadsDomain from \"./domains/threads/index.js\";\n12\timport * as turnsDomain from \"./domains/turns/index.js\";\n13\timport {\n14\t  createScheduler,\n15\t  peekThreadId,\n16\t  runDrain,\n17\t  type DrainDeps,\n18\t  type DrainReport,\n19\t  type Scheduler,\n20\t} from \"./scheduler.js\";\n21\timport {\n22\t  runWithInstanceSeam,\n23\t  setSchedulerPoke as installSchedulerPoke,\n24\t  setThreadTouch,\n25\t  type InstanceSeam,\n26\t} from \"./shared/context.js\";\n27\timport {\n28\t  PROVIDER_OPERATIONS,\n29\t  type ResolvedSdkConfig,\n30\t  type SdkConfig,\n31\t  type WorkHandler,\n32\t} from \"./shared/derivation.js\";\n33\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n34\timport type {\n35\t  CompactReceipt,\n36\t  PullResult,\n37\t  SweepReceipt,\n38\t  ViewProfile,\n39\t  ViewStatus,\n40\t} from \"./shared/view.js\";\n41\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n42\t\n43\texport {\n44\t  estimateTokens,\n45\t  TOKEN_ESTIMATOR_ID,\n46\t} from \"./tech-utils/token-counting/index.js\";\n47\t\n48\texport {\n49\t  WORK_KIND_REGISTRY,\n50\t  type WorkItemRecord,\n51\t  type WorkKind,\n52\t  type WorkOwner,\n53\t  type WorkSourceRef,\n54\t} from \"./tech-utils/work-queue/index.js\";\n55\t\n56\texport type {\n57\t  ErrorClass,\n58\t  ErrorCode,\n59\t  ErrorResult,\n60\t  OpResult,\n61\t} from \"./shared/errors.js\";\n62\texport {\n63\t  runInTransaction,\n64\t  setSchedulerPoke,\n65\t  setThreadTouch,\n66\t  type OperationContext,\n67\t} from \"./shared/context.js\";\n68\t\n69\texport {\n70\t  createDeterministicProvider,\n71\t  deterministicOutcomesSuffix,\n72\t  deterministicReceiptsSuffix,\n73\t  deterministicText,\n74\t  type DeterministicOpName,\n75\t} from \"./providers/deterministic.js\";\n76\texport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n77\t\n78\texport type {\n79\t  CompletionTx,\n80\t  DependencyGap,\n81\t  DerivationProvider,\n82\t  DerivedForm,\n83\t  DerivedFormMetadata,\n84\t  DerivedFormState,\n85\t  FormKind,\n86\t  FormReportEntry,\n87\t  HandlerFormWrite,\n88\t  HandlerOutcome,\n89\t  HandlerRunContext,\n90\t  ProviderResult,\n91\t  RenderingPart,\n92\t  ResolvedSdkConfig,\n93\t  SdkConfig,\n94\t  SubjectKind,\n95\t  ToolOutcome,\n96\t  ToolRunReceipt,\n97\t  WorkHandler,\n98\t} from \"./shared/derivation.js\";\n99\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n100\t\n101\t// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n102\t// from Story 0; the operation shapes land with Stories 1–5.\n103\texport {\n104\t  BUILT_IN_PROFILES,\n105\t  DEFAULT_COMPACT_THRESHOLD,\n106\t  DEFAULT_VISIBILITY,\n107\t} from \"./domains/thread-view/index.js\";\n108\texport type {\n109\t  Band,\n110\t  CompactReceipt,\n111\t  PullResult,\n112\t  ResolvedViewConfig,\n113\t  SdkViewConfig,\n114\t  SweepReceipt,\n115\t  ViewMessage,\n116\t  ViewMeta,\n117\t  ViewProfile,\n118\t  ViewProfileOverride,\n119\t  ViewStatus,\n120\t  VisibilityBudgets,\n121\t} from \"./shared/view.js\";\n122\texport {\n123\t  countLiveItems,\n124\t  enqueue,\n125\t  queueDetail,\n126\t  supersedeQueued,\n127\t  type ClaimedWorkItem,\n128\t  type EnqueueFormTarget,\n129\t  type EnqueueInput,\n130\t  type QueueDetailRow,\n131\t} from \"./tech-utils/work-queue/index.js\";\n132\t\n133\texport type { ThreadRef } from \"./domains/threads/index.js\";\n134\texport type {\n135\t  Block,\n136\t  BlockType,\n137\t  MessageRecord,\n138\t  MutationResult,\n139\t} from \"./domains/messages/index.js\";\n140\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n141\texport type {\n142\t  BatchResult,\n143\t  EventKind,\n144\t  EventRecord,\n145\t  MessageEventInput,\n146\t} from \"./domains/intake-stream/index.js\";\n147\t\n148\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n149\t\n150\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n151\t\n152\t// Merge per-domain handler tables into the one join between the queue's\n153\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n154\t// (each kind has exactly one owner) and throws at construction.\n155\texport function assembleWorkHandlerMap(\n156\t  tables: ReadonlyArray<WorkHandlerMap>,\n157\t): WorkHandlerMap {\n158\t  const map: WorkHandlerMap = {};\n159\t  for (const table of tables) {\n160\t    for (const [kind, handler] of Object.entries(table)) {\n161\t      if (map[kind as WorkKind] !== undefined) {\n162\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n163\t      }\n164\t      map[kind as WorkKind] = handler;\n165\t    }\n166\t  }\n167\t  return map;\n168\t}\n169\t\n170\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n171\t  return {\n172\t    ok: false,\n173\t    error: {\n174\t      errorClass: \"state_corruption\",\n175\t      code: \"unknown_work_kind\",\n176\t      reason: `no handler registered for work kind \"${kind}\"`,\n177\t    },\n178\t  };\n179\t}\n180\t\n181\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n182\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n183\texport function lookupWorkHandler(\n184\t  map: WorkHandlerMap,\n185\t  kind: string,\n186\t): OpResult<WorkHandler> {\n187\t  const handler = map[kind as WorkKind];\n188\t  if (handler === undefined) return unknownWorkKind(kind);\n189\t  return { ok: true, value: handler };\n190\t}\n191\t\n192\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n193\t// requeue land in Story 4.\n194\texport interface WorkSurface {\n195\t  drain(\n196\t    ref: threadsDomain.ThreadRef,\n197\t    opts?: { maxItems?: number },\n198\t  ): Promise<OpResult<DrainReport>>;\n199\t}\n200\t\n201\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n202\t// §Interface Definitions): the five operations only — the Story 0 config\n203\t// substrate the domain index also carries is construction machinery, not an\n204\t// operation. pull and status are real from Story 1; compact, sweep, and\n205\t// materialize return structured not-implemented results until their stories\n206\t// land.\n207\texport interface ThreadViewSurface {\n208\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n209\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n210\t  compact(\n211\t    ref: threadsDomain.ThreadRef,\n212\t    opts: { profile?: string; params?: Partial<ViewProfile>; sweep?: boolean },\n213\t  ): Promise<OpResult<CompactReceipt>>;\n214\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n215\t  materialize(\n216\t    ref: threadsDomain.ThreadRef,\n217\t    opts: { path: string; format?: \"pi-session\" },\n218\t  ): Promise<OpResult<{ writtenPath: string }>>;\n219\t}\n220\t\n221\texport interface Lhc {\n222\t  threads: typeof threadsDomain;\n223\t  intakeStream: typeof intakeStreamDomain;\n224\t  messages: typeof messagesDomain;\n225\t  turns: typeof turnsDomain;\n226\t  threadView: ThreadViewSurface;\n227\t  config: ResolvedSdkConfig;\n228\t  scheduler: Scheduler;\n229\t  workHandlers: WorkHandlerMap;\n230\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n231\t  work: WorkSurface;\n232\t  // Resolves when the scheduler has no running or pending drain for the\n233\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n234\t  // resolve in manual mode.\n235\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n236\t}\n237\t\n238\tfunction requirePositive(value: number, name: string): void {\n239\t  if (!Number.isFinite(value) || value <= 0) {\n240\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n241\t  }\n242\t}\n243\t\n244\tfunction requireNonNegative(value: number, name: string): void {\n245\t  if (!Number.isFinite(value) || value < 0) {\n246\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n247\t  }\n248\t}\n249\t\n250\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n251\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n252\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n253\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n254\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n255\t// object is the same shape as the namespace, so the public surface type holds.\n256\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n257\t  const scoped: Record<string, unknown> = {};\n258\t  for (const key of Object.keys(surface)) {\n259\t    const value = (surface as Record<string, unknown>)[key];\n260\t    scoped[key] =\n261\t      typeof value === \"function\"\n262\t        ? (...args: unknown[]): unknown =>\n263\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n264\t        : value;\n265\t  }\n266\t  return scoped as T;\n267\t}\n268\t\n269\t// The only assembly path: provider, mode, clock, and policy enter here.\n270\t// Config mistakes are programmer errors at construction and throw; operating\n271\t// failures after construction return OpResults per the error contract.\n272\texport function createSdk(config: SdkConfig): Lhc {\n273\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n274\t    throw new TypeError(\n275\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n276\t    );\n277\t  }\n278\t  if (config.provider === null || typeof config.provider !== \"object\") {\n279\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n280\t  }\n281\t  for (const operation of PROVIDER_OPERATIONS) {\n282\t    if (typeof config.provider[operation] !== \"function\") {\n283\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n284\t    }\n285\t  }\n286\t\n287\t  const resolved: ResolvedSdkConfig = {\n288\t    provider: config.provider,\n289\t    mode: config.mode,\n290\t    clock: config.clock ?? (() => new Date()),\n291\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n292\t    lease: config.lease ?? { durationMs: 120000 },\n293\t    chunkPolicy:\n294\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n295\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n296\t    // sums and visibility budgets validated — throws naming the violation.\n297\t    view: resolveViewConfig(config.view),\n298\t  };\n299\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n300\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n301\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n302\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n303\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n304\t  }\n305\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n306\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n307\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n308\t    throw new TypeError(\n309\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n310\t    );\n311\t  }\n312\t\n313\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n314\t  // The tables are empty until Stories 2–3 land the real handlers; the\n315\t  // assembly mechanics are production code from day one.\n316\t  const workHandlers = assembleWorkHandlerMap([\n317\t    messagesDomain.workHandlers,\n318\t    turnsDomain.workHandlers,\n319\t  ]);\n320\t\n321\t  const drainDeps: DrainDeps = {\n322\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n323\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n324\t    config: resolved,\n325\t  };\n326\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n327\t\n328\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n329\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n330\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n331\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n332\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n333\t  // the construction order, because its operations deliver to the no-op seam,\n334\t  // not to whatever a background SDK installed below.\n335\t  // The seam also carries this instance's resolved view config (Epic 03,\n336\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n337\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n338\t  // fall back to the built-in defaults inside the thread-view surface.\n339\t  const seam: InstanceSeam =\n340\t    resolved.mode === \"background\"\n341\t      ? {\n342\t          poke: (threadId) => scheduler.poke(threadId),\n343\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n344\t          view: resolved.view,\n345\t        }\n346\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\n347\t\n348\t  // Background mode also installs the below-SDK default seam so a direct\n349\t  // domain call made with no SDK scope — a top-level mutation in the\n350\t  // single-background \"production path\" — still reaches the one installed\n351\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n352\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n353\t  // leaves the default alone (pokes stay no-ops by contract).\n354\t  if (resolved.mode === \"background\") {\n355\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n356\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n357\t  }\n358\t\n359\t  const work: WorkSurface = {\n360\t    drain: (ref, opts) =>\n361\t      runWithInstanceSeam(seam, async () => {\n362\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n363\t        if (!resolvedRef.ok) return resolvedRef;\n364\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n365\t      }),\n366\t  };\n367\t\n368\t  return {\n369\t    threads: threadsDomain,\n370\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n371\t    messages: scopeSurface(messagesDomain, seam),\n372\t    turns: scopeSurface(turnsDomain, seam),\n373\t    threadView: scopeSurface<ThreadViewSurface>(\n374\t      {\n375\t        pull: threadViewDomain.pull,\n376\t        status: threadViewDomain.status,\n377\t        compact: threadViewDomain.compact,\n378\t        sweep: threadViewDomain.sweep,\n379\t        materialize: threadViewDomain.materialize,\n380\t      },\n381\t      seam,\n382\t    ),\n383\t    config: resolved,\n384\t    scheduler,\n385\t    workHandlers,\n386\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n387\t    work,\n388\t    drainSettled: async (ref) => {\n389\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n390\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n391\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n392\t      if (threadId === null) return;\n393\t      return scheduler.drainSettled(threadId);\n394\t    },\n395\t  };\n396\t}\n397\t"}]},"parent_tool_use_id":null,"session_id":"8dde17a3-d739-40da-bd65-ee3687cdd63f","uuid":"7646e5c0-fde5-4a76-a120-86ec64b33477","timestamp":"2026-06-11T15:12:29.640Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts","content":"export * as threads from \"./domains/threads/index.js\";\nexport * as intakeStream from \"./domains/intake-stream/index.js\";\nexport * as messages from \"./domains/messages/index.js\";\nexport * as turns from \"./domains/turns/index.js\";\nexport * as threadView from \"./domains/thread-view/index.js\";\n\nimport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\nimport * as threadViewDomain from \"./domains/thread-view/index.js\";\nimport { resolveViewConfig } from \"./domains/thread-view/index.js\";\nimport * as messagesDomain from \"./domains/messages/index.js\";\nimport * as threadsDomain from \"./domains/threads/index.js\";\nimport * as turnsDomain from \"./domains/turns/index.js\";\nimport {\n  createScheduler,\n  peekThreadId,\n  runDrain,\n  type DrainDeps,\n  type DrainReport,\n  type Scheduler,\n} from \"./scheduler.js\";\nimport {\n  runWithInstanceSeam,\n  setSchedulerPoke as installSchedulerPoke,\n  setThreadTouch,\n  type InstanceSeam,\n} from \"./shared/context.js\";\nimport {\n  PROVIDER_OPERATIONS,\n  type ResolvedSdkConfig,\n  type SdkConfig,\n  type WorkHandler,\n} from \"./shared/derivation.js\";\nimport type { ErrorResult, OpResult } from \"./shared/errors.js\";\nimport type {\n  CompactReceipt,\n  PullResult,\n  SweepReceipt,\n  ViewProfile,\n  ViewStatus,\n} from \"./shared/view.js\";\nimport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n\nexport {\n  estimateTokens,\n  TOKEN_ESTIMATOR_ID,\n} from \"./tech-utils/token-counting/index.js\";\n\nexport {\n  WORK_KIND_REGISTRY,\n  type WorkItemRecord,\n  type WorkKind,\n  type WorkOwner,\n  type WorkSourceRef,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type {\n  ErrorClass,\n  ErrorCode,\n  ErrorResult,\n  OpResult,\n} from \"./shared/errors.js\";\nexport {\n  runInTransaction,\n  setSchedulerPoke,\n  setThreadTouch,\n  type OperationContext,\n} from \"./shared/context.js\";\n\nexport {\n  createDeterministicProvider,\n  deterministicOutcomesSuffix,\n  deterministicReceiptsSuffix,\n  deterministicText,\n  type DeterministicOpName,\n} from \"./providers/deterministic.js\";\nexport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n\nexport type {\n  CompletionTx,\n  DependencyGap,\n  DerivationProvider,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  FormReportEntry,\n  HandlerFormWrite,\n  HandlerOutcome,\n  HandlerRunContext,\n  ProviderResult,\n  RenderingPart,\n  ResolvedSdkConfig,\n  SdkConfig,\n  SubjectKind,\n  ToolOutcome,\n  ToolRunReceipt,\n  WorkHandler,\n} from \"./shared/derivation.js\";\nexport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n\n// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n// from Story 0; the operation shapes land with Stories 1–5.\nexport {\n  BUILT_IN_PROFILES,\n  DEFAULT_COMPACT_THRESHOLD,\n  DEFAULT_VISIBILITY,\n} from \"./domains/thread-view/index.js\";\nexport type {\n  Band,\n  CompactReceipt,\n  PullResult,\n  ResolvedViewConfig,\n  SdkViewConfig,\n  SweepReceipt,\n  ViewMessage,\n  ViewMeta,\n  ViewProfile,\n  ViewProfileOverride,\n  ViewStatus,\n  VisibilityBudgets,\n} from \"./shared/view.js\";\nexport {\n  countLiveItems,\n  enqueue,\n  queueDetail,\n  supersedeQueued,\n  type ClaimedWorkItem,\n  type EnqueueFormTarget,\n  type EnqueueInput,\n  type QueueDetailRow,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type { ThreadRef } from \"./domains/threads/index.js\";\nexport type {\n  Block,\n  BlockType,\n  MessageRecord,\n  MutationResult,\n} from \"./domains/messages/index.js\";\nexport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\nexport type {\n  BatchResult,\n  EventKind,\n  EventRecord,\n  MessageEventInput,\n} from \"./domains/intake-stream/index.js\";\n\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n\n// Merge per-domain handler tables into the one join between the queue's\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n// (each kind has exactly one owner) and throws at construction.\nexport function assembleWorkHandlerMap(\n  tables: ReadonlyArray<WorkHandlerMap>,\n): WorkHandlerMap {\n  const map: WorkHandlerMap = {};\n  for (const table of tables) {\n    for (const [kind, handler] of Object.entries(table)) {\n      if (map[kind as WorkKind] !== undefined) {\n        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n      }\n      map[kind as WorkKind] = handler;\n    }\n  }\n  return map;\n}\n\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"state_corruption\",\n      code: \"unknown_work_kind\",\n      reason: `no handler registered for work kind \"${kind}\"`,\n    },\n  };\n}\n\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\nexport function lookupWorkHandler(\n  map: WorkHandlerMap,\n  kind: string,\n): OpResult<WorkHandler> {\n  const handler = map[kind as WorkKind];\n  if (handler === undefined) return unknownWorkKind(kind);\n  return { ok: true, value: handler };\n}\n\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n// requeue land in Story 4.\nexport interface WorkSurface {\n  drain(\n    ref: threadsDomain.ThreadRef,\n    opts?: { maxItems?: number },\n  ): Promise<OpResult<DrainReport>>;\n}\n\n// The thread-view surface as the SDK exposes it (Epic 03, tech design\n// §Interface Definitions): the five operations only — the Story 0 config\n// substrate the domain index also carries is construction machinery, not an\n// operation. pull and status are real from Story 1; compact, sweep, and\n// materialize return structured not-implemented results until their stories\n// land.\nexport interface ThreadViewSurface {\n  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n  compact(\n    ref: threadsDomain.ThreadRef,\n    opts: { profile?: string; params?: Partial<ViewProfile>; sweep?: boolean },\n  ): Promise<OpResult<CompactReceipt>>;\n  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n  materialize(\n    ref: threadsDomain.ThreadRef,\n    opts: { path: string; format?: \"pi-session\" },\n  ): Promise<OpResult<{ writtenPath: string }>>;\n}\n\nexport interface Lhc {\n  threads: typeof threadsDomain;\n  intakeStream: typeof intakeStreamDomain;\n  messages: typeof messagesDomain;\n  turns: typeof turnsDomain;\n  threadView: ThreadViewSurface;\n  config: ResolvedSdkConfig;\n  scheduler: Scheduler;\n  workHandlers: WorkHandlerMap;\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n  work: WorkSurface;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3) — the awaitable for background mode, and a no-op\n  // resolve in manual mode.\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n}\n\nfunction requirePositive(value: number, name: string): void {\n  if (!Number.isFinite(value) || value <= 0) {\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n  }\n}\n\nfunction requireNonNegative(value: number, name: string): void {\n  if (!Number.isFinite(value) || value < 0) {\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n  }\n}\n\n// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n// (background) or a no-op (manual) — never another SDK's. Non-function exports\n// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n// object is the same shape as the namespace, so the public surface type holds.\nfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n  const scoped: Record<string, unknown> = {};\n  for (const key of Object.keys(surface)) {\n    const value = (surface as Record<string, unknown>)[key];\n    scoped[key] =\n      typeof value === \"function\"\n        ? (...args: unknown[]): unknown =>\n            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n        : value;\n  }\n  return scoped as T;\n}\n\n// The only assembly path: provider, mode, clock, and policy enter here.\n// Config mistakes are programmer errors at construction and throw; operating\n// failures after construction return OpResults per the error contract.\nexport function createSdk(config: SdkConfig): Lhc {\n  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n    throw new TypeError(\n      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n    );\n  }\n  if (config.provider === null || typeof config.provider !== \"object\") {\n    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n  }\n  for (const operation of PROVIDER_OPERATIONS) {\n    if (typeof config.provider[operation] !== \"function\") {\n      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n    }\n  }\n\n  const resolved: ResolvedSdkConfig = {\n    provider: config.provider,\n    mode: config.mode,\n    clock: config.clock ?? (() => new Date()),\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n    lease: config.lease ?? { durationMs: 120000 },\n    chunkPolicy:\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n    // sums and visibility budgets validated — throws naming the violation.\n    view: resolveViewConfig(config.view),\n  };\n  requirePositive(resolved.retry.budget, \"retry.budget\");\n  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n  }\n  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n    throw new TypeError(\n      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n    );\n  }\n\n  // Handler maps merge from per-domain contributions at construction (DD-6).\n  // The tables are empty until Stories 2–3 land the real handlers; the\n  // assembly mechanics are production code from day one.\n  const workHandlers = assembleWorkHandlerMap([\n    messagesDomain.workHandlers,\n    turnsDomain.workHandlers,\n  ]);\n\n  const drainDeps: DrainDeps = {\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n    config: resolved,\n  };\n  const scheduler = createScheduler(resolved.mode, drainDeps);\n\n  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n  // background mode, or a no-op in manual mode — isolated from any other SDK\n  // alive in the process. A manual SDK therefore never auto-drains, whatever\n  // the construction order, because its operations deliver to the no-op seam,\n  // not to whatever a background SDK installed below.\n  // The seam also carries this instance's resolved view config (Epic 03,\n  // tech design Flow 4): thread-view operations invoked through sdk.* read\n  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n  // fall back to the built-in defaults inside the thread-view surface.\n  const seam: InstanceSeam =\n    resolved.mode === \"background\"\n      ? {\n          poke: (threadId) => scheduler.poke(threadId),\n          touch: (filePath, db) => scheduler.touch(filePath, db),\n          view: resolved.view,\n        }\n      : { poke: () => {}, touch: () => {}, view: resolved.view };\n\n  // Background mode also installs the below-SDK default seam so a direct\n  // domain call made with no SDK scope — a top-level mutation in the\n  // single-background \"production path\" — still reaches the one installed\n  // scheduler. The per-instance scoping above overrides this for every sdk.*\n  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n  // leaves the default alone (pokes stay no-ops by contract).\n  if (resolved.mode === \"background\") {\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n  }\n\n  const work: WorkSurface = {\n    drain: (ref, opts) =>\n      runWithInstanceSeam(seam, async () => {\n        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n        if (!resolvedRef.ok) return resolvedRef;\n        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n      }),\n  };\n\n  return {\n    threads: threadsDomain,\n    intakeStream: scopeSurface(intakeStreamDomain, seam),\n    messages: scopeSurface(messagesDomain, seam),\n    turns: scopeSurface(turnsDomain, seam),\n    threadView: scopeSurface<ThreadViewSurface>(\n      {\n        pull: threadViewDomain.pull,\n        status: threadViewDomain.status,\n        compact: threadViewDomain.compact,\n        sweep: threadViewDomain.sweep,\n        materialize: threadViewDomain.materialize,\n      },\n      seam,\n    ),\n    config: resolved,\n    scheduler,\n    workHandlers,\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    work,\n    drainSettled: async (ref) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n      const threadId = peekThreadId(resolvedRef.value.filePath);\n      if (threadId === null) return;\n      return scheduler.drainSettled(threadId);\n    },\n  };\n}\n","numLines":397,"startLine":1,"totalLines":397}}}

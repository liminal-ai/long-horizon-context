ingify({\n   367\t        lowerBound: merged.lowerBound,\n   368\t        percentages: merged.percentages,\n   369\t      }),\n   370\t      arrangementJson: JSON.stringify(\n   371\t        selection.entries.map((entry) => ({\n   372\t          band: entry.band,\n   373\t          subjectKind: entry.subjectKind,\n   374\t          subjectId: entry.subjectId,\n   375\t          formUsed: entry.formUsed,\n   376\t          degraded: entry.degraded,\n   377\t        })),\n   378\t      ),\n   379\t      gapsJson: JSON.stringify(\n   380\t        selection.entries\n   381\t          .filter((entry) => entry.gap)\n   382\t          .map((entry) => ({\n   383\t            band: entry.band,\n   384\t            subjectId: entry.subjectId,\n   385\t            reason: entry.reason ?? \"unknown\",\n   386\t          })),\n   387\t      ),\n   388\t      sourceStateJson: JSON.stringify({\n   389\t        maxEventOrder: inputs.maxEventOrder,\n   390\t        formCounts: inputs.formCounts,\n   391\t      }),\n   392\t      bands,\n   393\t    });\n   394\t\n   395\t    const bandReport = {} as CompactReceipt[\"bands\"];\n   396\t    for (const band of BAND_ORDER) {\n   397\t      const stored = bands.find((row) => row.band === band);\n   398\t      bandReport[band] = {\n   399\t        entries: entriesByBand(band).length,\n   400\t        tokens: stored?.tokenCount ?? 0,\n   401\t      };\n   402\t    }\n   403\t    const tailTokens = tailTokenSum(db, selection.compactPoint);\n   404\t    return {\n   405\t      ok: true,\n   406\t      value: {\n   407\t        viewId,\n   408\t        profile: profileName,\n   409\t        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n   410\t        bands: bandReport,\n   411\t        tailTokens,\n   412\t        // Actual assembled total vs the bound (target, not cap — AC-2.4).\n   413\t        totalTokens:\n   414\t          bandReport.brief.tokens +\n   415\t          bandReport.detailed.tokens +\n   416\t          bandReport.smooth.tokens +\n   417\t          tailTokens,\n   418\t        coveredFrom: selection.coveredFrom,\n   419\t        compactPoint: selection.compactPoint,\n   420\t        degraded: selection.entries\n   421\t          .filter((entry) => entry.degraded)\n   422\t          .map((entry) => ({\n   423\t            band: entry.band,\n   424\t            subjectId: entry.subjectId,\n   425\t            usedForm: entry.formUsed,\n   426\t          })),\n   427\t        gaps: selection.entries\n   428\t          .filter((entry) => entry.gap)\n   429\t          .map((entry) => ({\n   430\t            band: entry.band,\n   431\t            subjectId: entry.subjectId,\n   432\t            reason: entry.reason ?? \"unknown\",\n   433\t          })),\n   434\t        // Sweep step absent this story (NOT skipped, NOT an empty receipt):\n   435\t        // Story 3 embeds the sweep and flips this field's vocabulary.\n   436\t        sweep: \"absent\",\n   437\t      },\n   438\t    };\n   439\t  } catch (cause) {\n   440\t    return storageFailure(`view compact failed: ${detail(cause)}`);\n","exit_code":0,"status":"completed"}}

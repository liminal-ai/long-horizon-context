{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/view-compact.test.ts | sed -n '560,820p'\"","aggregated_output":"   560\t    const bandText = bandMessages(messages)\n   561\t      .map((message) => message.content)\n   562\t      .join(\"\\n\\n\");\n   563\t    expect(bandText).toContain(\"[degraded: brief-from-detailed]\");\n   564\t    expect(bandText).toContain(\"[degraded: smooth-from-excerpt]\");\n   565\t    expect(bandText).toMatch(/§c2 \\[chunk c2 unavailable: no usable form/);\n   566\t\n   567\t    // Zero provider calls: missing material degrades, it is never re-derived\n   568\t    // inline (AC-2.4's no-inference rule with teeth).\n   569\t    expect(captured.length).toBe(capturedBefore);\n   570\t  });\n   571\t\n   572\t  it(\"status reports the view-health fields live after the degraded compact (TC-2.5 completion leg)\", async () => {\n   573\t    const status = await degraded.sdk.threadView.status({ filePath: degraded.filePath });\n   574\t    expect(status.ok).toBe(true);\n   575\t    if (!status.ok) return;\n   576\t    expect(status.value.view).not.toBeNull();\n   577\t    expect(status.value.view?.degraded).toBe(2);\n   578\t    expect(status.value.view?.gaps).toBe(1);\n   579\t    expect(typeof status.value.view?.builtAt).toBe(\"string\");\n   580\t    // The edits' requeued rebuild work is visible as pending derivation.\n   581\t    expect(status.value.derivation.pending).toBeGreaterThan(0);\n   582\t  });\n   583\t});\n   584\t\n   585\tdescribe(\"TC-2.7 (AC-2.5): canonical corruption refuses; derived-only damage degrades\", () => {\n   586\t  it(\"refuses with state_corruption naming the damage; the prior view still serves; record unchanged\", async () => {\n   587\t    const corruptStore = tempStore();\n   588\t    try {\n   589\t      const double = createProviderDouble();\n   590\t      const sdk = createSdk({ provider: double, mode: \"manual\" });\n   591\t      const filePath = corruptStore.threadPath();\n   592\t      const created = await sdk.threads.newThread({\n   593\t        filePath,\n   594\t        registryPath: corruptStore.registryPath,\n   595\t      });\n   596\t      expect(created.ok).toBe(true);\n   597\t      for (let turn = 1; turn <= 4; turn += 1) {\n   598\t        const sent = await sdk.intakeStream.messageEvents({ filePath }, degradedTurnEvents(turn));\n   599\t        expect(sent.ok).toBe(true);\n   600\t      }\n   601\t      const drained = await sdk.work.drain({ filePath });\n   602\t      expect(drained.ok).toBe(true);\n   603\t\n   604\t      // A prior view exists before the damage.\n   605\t      const first = await sdk.threadView.compact(\n   606\t        { filePath },\n   607\t        { params: { lowerBound: 80, percentages: { full: 50, smooth: 30, detailed: 10, brief: 10 } } },\n   608\t      );\n   609\t      expect(first.ok).toBe(true);\n   610\t      const priorPull = await sdk.threadView.pull({ filePath });\n   611\t      expect(priorPull.ok).toBe(true);\n   612\t      if (!priorPull.ok) return;\n   613\t\n   614\t      // Manufactured canonical corruption, damaged below the SDK (the Epic 01\n   615\t      // two-open-turns pattern): open a turn through real intake, then add a\n   616\t      // second open row.\n   617\t      const opened = await sdk.intakeStream.messageEvents({ filePath }, [\n   618\t        validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n   619\t      ]);\n   620\t      expect(opened.ok).toBe(true);\n   621\t      corruptTwoOpenTurns(filePath);\n   622\t      const recordBefore = recordSnapshot(filePath);\n   623\t\n   624\t      const refused = await sdk.threadView.compact(\n   625\t        { filePath },\n   626\t        { params: { lowerBound: 80, percentages: { full: 50, smooth: 30, detailed: 10, brief: 10 } } },\n   627\t      );\n   628\t      expect(refused.ok).toBe(false);\n   629\t      if (refused.ok) return;\n   630\t      expect(refused.error.errorClass).toBe(\"state_corruption\");\n   631\t      expect(refused.error.code).toBe(\"turn_state_corrupt\");\n   632\t      expect(refused.error.reason).toMatch(/open turns/);\n   633\t\n   634\t      // Pre-transaction refusal: prior view serves byte-identically, record\n   635\t      // untouched.\n   636\t      const afterPull = await sdk.threadView.pull({ filePath });\n   637\t      expect(afterPull.ok).toBe(true);\n   638\t      if (!afterPull.ok) return;\n   639\t      expect(JSON.stringify(afterPull.value.messages.filter((m) => m.band !== undefined))).toBe(\n   640\t        JSON.stringify(priorPull.value.messages.filter((m) => m.band !== undefined)),\n   641\t      );\n   642\t      expect(afterPull.value.meta.viewId).toBe(priorPull.value.meta.viewId);\n   643\t      expect(recordSnapshot(filePath)).toBe(recordBefore);\n   644\t    } finally {\n   645\t      corruptStore.cleanup();\n   646\t    }\n   647\t  });\n   648\t\n   649\t  it(\"control: a thread with only derived-material damage compacts successfully with gaps\", async () => {\n   650\t    // The suite fixture carries two scripted FAILED tool_result_summary forms\n   651\t    // (derived damage only) and compacts clean throughout this file; the\n   652\t    // explicit control here is the degraded build: summaries pending/failed,\n   653\t    // zero usable forms on c2 — and the compact above completed with a gap\n   654\t    // rather than refusing. Re-assert the contrast directly on the main\n   655\t    // fixture: derived failures present, compact succeeds, no state_corruption.\n   656\t    const receipt = await fixture.sdk.threadView.compact(\n   657\t      { filePath: fixture.filePath },\n   658\t      { params: GRADIENT_PARAMS },\n   659\t    );\n   660\t    expect(receipt.ok).toBe(true);\n   661\t  });\n   662\t});\n   663\t\n   664\tdescribe(\"TC-1.3 (AC-1.4) and TC-1.5 (AC-1.6): snapshot immutability under record mutation\", () => {\n   665\t  let mutStore: TempStore;\n   666\t  let mut: DerivedThreadFixture;\n   667\t\n   668\t  beforeAll(async () => {\n   669\t    mutStore = tempStore();\n   670\t    mut = await derivedThreadFixture(mutStore, { failures: false });\n   671\t    const receipt = await mut.sdk.threadView.compact(\n   672\t      { filePath: mut.filePath },\n   673\t      { params: GRADIENT_PARAMS },\n   674\t    );\n   675\t    if (!receipt.ok) throw new Error(`setup compact failed: ${receipt.error.reason}`);\n   676\t  });\n   677\t  afterAll(() => {\n   678\t    mutStore.cleanup();\n   679\t  });\n   680\t\n   681\t  it(\"TC-1.3: editing a banded subject leaves band bytes unchanged across pulls, before and after the drain\", async () => {\n   682\t    const before = bandMessages(await pullMessages(mut.sdk, mut.filePath));\n   683\t    const bandHash = sha256(before);\n   684\t\n   685\t    // t5 is banded inside c2's detailed entry; edit its prompt.\n   686\t    const listed = await mut.sdk.messages.listMessages({ filePath: mut.filePath });\n   687\t    expect(listed.ok).toBe(true);\n   688\t    if (!listed.ok) return;\n   689\t    const t5Prompt = listed.value.find((m) => m.turnId === \"t5\" && m.kind === \"user_prompt\");\n   690\t    expect(t5Prompt).toBeDefined();\n   691\t    if (t5Prompt === undefined) return;\n   692\t    const edited = await mut.sdk.messages.edit(\n   693\t      { filePath: mut.filePath },\n   694\t      { messageId: t5Prompt.messageId, content: \"turn 5: edited after the snapshot\" },\n   695\t    );\n   696\t    expect(edited.ok).toBe(true);\n   697\t\n   698\t    const afterEdit = bandMessages(await pullMessages(mut.sdk, mut.filePath));\n   699\t    expect(sha256(afterEdit)).toBe(bandHash);\n   700\t\n   701\t    // Drain the requeued rebuilds: the rebuilt summary lands in the RECORD\n   702\t    // only; the snapshot still serves the same bytes.\n   703\t    const drained = await mut.sdk.work.drain({ filePath: mut.filePath });\n   704\t    expect(drained.ok).toBe(true);\n   705\t    const afterDrain = bandMessages(await pullMessages(mut.sdk, mut.filePath));\n   706\t    expect(sha256(afterDrain)).toBe(bandHash);\n   707\t\n   708\t    // The record really changed underneath: c2's rebuilt detailed summary is\n   709\t    // not the text the band serves.\n   710\t    const db = openRaw(mut.filePath);\n   711\t    try {\n   712\t      const row = db\n   713\t        .prepare(\n   714\t          `SELECT content FROM derived_form\n   715\t           WHERE subject_kind = 'chunk' AND subject_id = 'c2' AND form = 'chunk_summary_detailed'`,\n   716\t        )\n   717\t        .get() as { content: string | null } | undefined;\n   718\t      expect(row?.content).toBeDefined();\n   719\t      const detailedBand = afterDrain.find((m) => m.band === \"detailed\");\n   720\t      expect(detailedBand?.content).not.toContain(row?.content ?? \"<unset>\");\n   721\t    } finally {\n   722\t      db.close();\n   723\t    }\n   724\t  });\n   725\t\n   726\t  it(\"TC-1.5: a tail delete vanishes from the next pull; a banded delete leaves the snapshot until the next compact\", async () => {\n   727\t    const listed = await mut.sdk.messages.listMessages({ filePath: mut.filePath });\n   728\t    expect(listed.ok).toBe(true);\n   729\t    if (!listed.ok) return;\n   730\t\n   731\t    // Tail region: t9 onward (compact point 48). Delete t10's findings.\n   732\t    const tailTarget = listed.value.find((m) => m.turnId === \"t10\" && m.kind === \"assistant_text\");\n   733\t    expect(tailTarget).toBeDefined();\n   734\t    if (tailTarget === undefined) return;\n   735\t    const statusBefore = await mut.sdk.threadView.status({ filePath: mut.filePath });\n   736\t    expect(statusBefore.ok).toBe(true);\n   737\t    if (!statusBefore.ok) return;\n   738\t\n   739\t    const tailDelete = await mut.sdk.messages.deleteMessage(\n   740\t      { filePath: mut.filePath },\n   741\t      { messageId: tailTarget.messageId },\n   742\t    );\n   743\t    expect(tailDelete.ok).toBe(true);\n   744\t    const afterTailDelete = await pullMessages(mut.sdk, mut.filePath);\n   745\t    expect(\n   746\t      afterTailDelete.some((m) => m.content === \"findings for area 10\"),\n   747\t    ).toBe(false);\n   748\t\n   749\t    // The record change is visible to the status read (tail sum shrank).\n   750\t    const statusAfter = await mut.sdk.threadView.status({ filePath: mut.filePath });\n   751\t    expect(statusAfter.ok).toBe(true);\n   752\t    if (!statusAfter.ok) return;\n   753\t    expect(statusAfter.value.tailTokens).toBeLessThan(statusBefore.value.tailTokens);\n   754\t\n   755\t    // Banded region: delete a t6 message whose derived content sits inside\n   756\t    // c2's band entry. The snapshot is untouched until the next compact.\n   757\t    const bandsBefore = bandMessages(afterTailDelete);\n   758\t    const bandTarget = listed.value.find((m) => m.turnId === \"t6\" && m.kind === \"assistant_text\");\n   759\t    expect(bandTarget).toBeDefined();\n   760\t    if (bandTarget === undefined) return;\n   761\t    const bandedDelete = await mut.sdk.messages.deleteMessage(\n   762\t      { filePath: mut.filePath },\n   763\t      { messageId: bandTarget.messageId },\n   764\t    );\n   765\t    expect(bandedDelete.ok).toBe(true);\n   766\t\n   767\t    const afterBandedDelete = await pullMessages(mut.sdk, mut.filePath);\n   768\t    expect(sha256(bandMessages(afterBandedDelete))).toBe(sha256(bandsBefore));\n   769\t\n   770\t    // Next-compact visibility: the record changed under the snapshot — the\n   771\t    // delete's cascade left rebuild work pending in the status read.\n   772\t    const statusFinal = await mut.sdk.threadView.status({ filePath: mut.filePath });\n   773\t    expect(statusFinal.ok).toBe(true);\n   774\t    if (!statusFinal.ok) return;\n   775\t    expect(statusFinal.value.derivation.pending).toBeGreaterThan(0);\n   776\t  });\n   777\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/view-compact.test.ts | sed -n '1,280p'\"","aggregated_output":"     1\t// Epic 03 Story 2: smart compact (TC-2.1–2.4, TC-2.6, TC-2.7, TC-1.3,\n     2\t// TC-1.5, the TC-2.5 view-health completion legs, and the architecture-risk\n     3\t// rows: restart-serves-snapshot and coverage-edge accounting). Every TC goes\n     4\t// through the real SDK surface (createSdk().threadView.compact) against real\n     5\t// temp thread files; the provider double appears only in fixture setup —\n     6\t// degraded states are reached through production paths (scripted provider\n     7\t// exhaustion at build, edit-cascade pending clears), never by writing\n     8\t// derived_form directly.\n     9\timport { createHash } from \"node:crypto\";\n    10\timport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\n    11\timport {\n    12\t  createSdk,\n    13\t  type Lhc,\n    14\t  type MessageEventInput,\n    15\t  type ViewMessage,\n    16\t} from \"../src/index.js\";\n    17\timport {\n    18\t  corruptTwoOpenTurns,\n    19\t  createProviderDouble,\n    20\t  derivedThreadFixture,\n    21\t  openRaw,\n    22\t  setViewInjectionHook,\n    23\t  tempStore,\n    24\t  validEvent,\n    25\t  type DerivedThreadFixture,\n    26\t  type ProviderDouble,\n    27\t  type TempStore,\n    28\t} from \"./fixtures/index.js\";\n    29\t\n    30\tlet store: TempStore;\n    31\tlet fixture: DerivedThreadFixture;\n    32\t\n    33\tbeforeAll(async () => {\n    34\t  store = tempStore();\n    35\t  fixture = await derivedThreadFixture(store);\n    36\t});\n    37\tafterAll(() => {\n    38\t  store.cleanup();\n    39\t});\n    40\t\n    41\t// The story's reference configs (hand-derived from the fixture's\n    42\t// deterministic token costs via the literal selection rules — ruling 013;\n    43\t// the goldens in view-select-golden.test.ts pin arrangements exactly).\n    44\t// TARGET: equal shares for the targets-the-bound assertions (smooth absorbs\n    45\t// t6–t8 within share; c1 fills detailed; brief left empty by candidacy).\n    46\tconst TARGET_PARAMS = {\n    47\t  lowerBound: 400,\n    48\t  percentages: { full: 25, smooth: 25, detailed: 25, brief: 25 },\n    49\t};\n    50\t// GRADIENT: all three bands non-empty (smooth t7+t8, detailed c2, brief c1).\n    51\tconst GRADIENT_PARAMS = {\n    52\t  lowerBound: 400,\n    53\t  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\n    54\t};\n    55\t// EDGE: compact point lands at t10's close (full 50 tokens), making c3, c2,\n    56\t// and c1 chunk candidates; the brief share (30) holds c2 alone (36, loner)\n    57\t// and excludes c1 — the coverage edge.\n    58\tconst EDGE_PARAMS = {\n    59\t  lowerBound: 100,\n    60\t  percentages: { full: 50, smooth: 10, detailed: 10, brief: 30 },\n    61\t};\n    62\t\n    63\tfunction sha256(value: unknown): string {\n    64\t  return createHash(\"sha256\").update(JSON.stringify(value)).digest(\"hex\");\n    65\t}\n    66\t\n    67\t// The canonical record plus its derived state — everything compact must\n    68\t// never touch (AC-2.9). View tables and the boundary are deliberately\n    69\t// excluded: those are compact's own rows.\n    70\tfunction recordSnapshot(filePath: string): string {\n    71\t  const db = openRaw(filePath);\n    72\t  try {\n    73\t    return sha256({\n    74\t      events: db.prepare(`SELECT * FROM event ORDER BY event_order`).all(),\n    75\t      messages: db.prepare(`SELECT * FROM message ORDER BY source_event_order`).all(),\n    76\t      blocks: db\n    77\t        .prepare(`SELECT * FROM message_block ORDER BY message_id, block_index`)\n    78\t        .all(),\n    79\t      turns: db.prepare(`SELECT * FROM turns ORDER BY turn_order`).all(),\n    80\t      chunks: db.prepare(`SELECT * FROM chunk ORDER BY chunk_order`).all(),\n    81\t      members: db.prepare(`SELECT * FROM chunk_member ORDER BY chunk_id, member_idx`).all(),\n    82\t      forms: db\n    83\t        .prepare(`SELECT * FROM derived_form ORDER BY subject_kind, subject_id, form`)\n    84\t        .all(),\n    85\t    });\n    86\t  } finally {\n    87\t    db.close();\n    88\t  }\n    89\t}\n    90\t\n    91\t// Full-file state including the view rows and boundary — for the\n    92\t// thread-unchanged-after-rejection assertions.\n    93\tfunction fullStateSnapshot(filePath: string): string {\n    94\t  const db = openRaw(filePath);\n    95\t  try {\n    96\t    return sha256({\n    97\t      record: recordSnapshot(filePath),\n    98\t      views: db.prepare(`SELECT * FROM thread_view`).all(),\n    99\t      bands: db.prepare(`SELECT * FROM thread_view_band ORDER BY band`).all(),\n   100\t      boundary: db.prepare(`SELECT position FROM view_boundary`).all(),\n   101\t      work: db.prepare(`SELECT work_item_id, status FROM work_item ORDER BY work_item_id`).all(),\n   102\t    });\n   103\t  } finally {\n   104\t    db.close();\n   105\t  }\n   106\t}\n   107\t\n   108\tfunction viewRowCount(filePath: string): number {\n   109\t  const db = openRaw(filePath);\n   110\t  try {\n   111\t    const row = db.prepare(`SELECT COUNT(*) AS n FROM thread_view`).get() as {\n   112\t      n: number | bigint;\n   113\t    };\n   114\t    return Number(row.n);\n   115\t  } finally {\n   116\t    db.close();\n   117\t  }\n   118\t}\n   119\t\n   120\tfunction boundaryPosition(filePath: string): number {\n   121\t  const db = openRaw(filePath);\n   122\t  try {\n   123\t    const row = db.prepare(`SELECT position FROM view_boundary`).get() as {\n   124\t      position: number | bigint;\n   125\t    };\n   126\t    return Number(row.position);\n   127\t  } finally {\n   128\t    db.close();\n   129\t  }\n   130\t}\n   131\t\n   132\tfunction bandMessages(messages: readonly ViewMessage[]): ViewMessage[] {\n   133\t  return messages.filter((message) => message.band !== undefined);\n   134\t}\n   135\t\n   136\tasync function pullMessages(sdk: Lhc, filePath: string): Promise<ViewMessage[]> {\n   137\t  const pulled = await sdk.threadView.pull({ filePath });\n   138\t  if (!pulled.ok) throw new Error(`pull failed: ${pulled.error.reason}`);\n   139\t  return pulled.value.messages;\n   140\t}\n   141\t\n   142\tdescribe(\"TC-2.1 (AC-2.2, AC-2.3, AC-2.7): profiles, explicit params, and named rejections\", () => {\n   143\t  it(\"rejects percentages summing to 105 naming the sum, and an unknown profile naming it; thread unchanged\", async () => {\n   144\t    const before = fullStateSnapshot(fixture.filePath);\n   145\t\n   146\t    const badSum = await fixture.sdk.threadView.compact(\n   147\t      { filePath: fixture.filePath },\n   148\t      { params: { percentages: { full: 30, smooth: 30, detailed: 25, brief: 20 } } },\n   149\t    );\n   150\t    expect(badSum.ok).toBe(false);\n   151\t    if (badSum.ok) return;\n   152\t    expect(badSum.error.errorClass).toBe(\"caller_error\");\n   153\t    expect(badSum.error.code).toBe(\"invalid_view_config\");\n   154\t    expect(badSum.error.reason).toContain(\"105\");\n   155\t\n   156\t    const badBound = await fixture.sdk.threadView.compact(\n   157\t      { filePath: fixture.filePath },\n   158\t      { params: { lowerBound: 0 } },\n   159\t    );\n   160\t    expect(badBound.ok).toBe(false);\n   161\t    if (badBound.ok) return;\n   162\t    expect(badBound.error.code).toBe(\"invalid_view_config\");\n   163\t    expect(badBound.error.reason).toContain(\"lowerBound\");\n   164\t\n   165\t    const unknown = await fixture.sdk.threadView.compact(\n   166\t      { filePath: fixture.filePath },\n   167\t      { profile: \"nonesuch\" },\n   168\t    );\n   169\t    expect(unknown.ok).toBe(false);\n   170\t    if (unknown.ok) return;\n   171\t    expect(unknown.error.errorClass).toBe(\"caller_error\");\n   172\t    expect(unknown.error.code).toBe(\"unknown_profile\");\n   173\t    expect(unknown.error.reason).toContain('\"nonesuch\"');\n   174\t\n   175\t    // Thread unchanged after all rejections: no view row landed, no record\n   176\t    // or boundary movement (read-back equality).\n   177\t    expect(fullStateSnapshot(fixture.filePath)).toBe(before);\n   178\t    expect(viewRowCount(fixture.filePath)).toBe(0);\n   179\t  });\n   180\t\n   181\t  it(\"compacts with a built-in profile: the profile's bound and mix land in the receipt\", async () => {\n   182\t    const receipt = await fixture.sdk.threadView.compact(\n   183\t      { filePath: fixture.filePath },\n   184\t      { profile: \"coding\" },\n   185\t    );\n   186\t    expect(receipt.ok).toBe(true);\n   187\t    if (!receipt.ok) return;\n   188\t    expect(receipt.value.profile).toBe(\"coding\");\n   189\t    expect(receipt.value.config).toEqual({\n   190\t      full: 25,\n   191\t      smooth: 35,\n   192\t      detailed: 20,\n   193\t      brief: 20,\n   194\t      lowerBound: 120000,\n   195\t    });\n   196\t    // Sweep step is absent this story (the honest literal, not a fake empty\n   197\t    // receipt — Story 3 flips it).\n   198\t    expect(receipt.value.sweep).toBe(\"absent\");\n   199\t    // At a 120k bound this small thread is all tail: bands empty, compact\n   200\t    // point at the origin, and the reported total IS the tail (totalTokens\n   201\t    // receipt coverage, ruling 013).\n   202\t    expect(receipt.value.compactPoint).toBe(0);\n   203\t    expect(receipt.value.bands.smooth.entries).toBe(0);\n   204\t    expect(receipt.value.totalTokens).toBe(receipt.value.tailTokens);\n   205\t  });\n   206\t\n   207\t  it(\"explicit params override profile values field-wise and report profile null\", async () => {\n   208\t    const receipt = await fixture.sdk.threadView.compact(\n   209\t      { filePath: fixture.filePath },\n   210\t      { profile: \"coding\", params: { lowerBound: 400, percentages: { smooth: 40, detailed: 15 } } },\n   211\t    );\n   212\t    expect(receipt.ok).toBe(true);\n   213\t    if (!receipt.ok) return;\n   214\t    // coding's mix with the two overridden fields; explicit params ⇒ the\n   215\t    // receipt names no profile (config carries the resolved truth).\n   216\t    expect(receipt.value.config).toEqual({\n   217\t      full: 25,\n   218\t      smooth: 40,\n   219\t      detailed: 15,\n   220\t      brief: 20,\n   221\t      lowerBound: 400,\n   222\t    });\n   223\t    expect(receipt.value.profile).toBeNull();\n   224\t  });\n   225\t});\n   226\t\n   227\tdescribe(\"TC-2.2 (AC-2.4, AC-2.9): the compact targets the bound from stored artifacts only\", () => {\n   228\t  it(\"actuals near shares with whole-entry deviations, zero provider calls, record untouched\", async () => {\n   229\t    const captured = fixture.double.captureInputs();\n   230\t    const capturedBefore = captured.length;\n   231\t    const recordBefore = recordSnapshot(fixture.filePath);\n   232\t\n   233\t    const receipt = await fixture.sdk.threadView.compact(\n   234\t      { filePath: fixture.filePath },\n   235\t      { params: TARGET_PARAMS },\n   236\t    );\n   237\t    expect(receipt.ok).toBe(true);\n   238\t    if (!receipt.ok) return;\n   239\t    const shares = {\n   240\t      smooth: (400 * 25) / 100,\n   241\t      detailed: (400 * 25) / 100,\n   242\t      brief: (400 * 25) / 100,\n   243\t    };\n   244\t\n   245\t    // Whole-entry fills: a band lands at-or-under its share unless a single\n   246\t    // indivisible entry had to represent (the only sanctioned over-share\n   247\t    // deviation, AC-2.4).\n   248\t    for (const band of [\"brief\", \"detailed\", \"smooth\"] as const) {\n   249\t      const actual = receipt.value.bands[band];\n   250\t      const attributable = actual.tokens <= shares[band] || actual.entries === 1;\n   251\t      expect(attributable).toBe(true);\n   252\t    }\n   253\t    // The fixture's pinned arrangement under these params (literal rules):\n   254\t    // smooth fills t6–t8 within its share, c1 fills detailed within its\n   255\t    // share, brief is empty by candidacy, tail under the full share plus\n   256\t    // turn-boundary snap.\n   257\t    expect(receipt.value.bands.brief).toEqual({ entries: 0, tokens: 0 });\n   258\t    expect(receipt.value.bands.detailed.entries).toBe(1);\n   259\t    expect(receipt.value.bands.detailed.tokens).toBeLessThanOrEqual(shares.detailed);\n   260\t    expect(receipt.value.bands.smooth.entries).toBe(3);\n   261\t    expect(receipt.value.bands.smooth.tokens).toBeLessThanOrEqual(shares.smooth);\n   262\t    expect(receipt.value.tailTokens).toBeLessThanOrEqual((400 * 25) / 100);\n   263\t    expect(receipt.value.compactPoint).toBe(48);\n   264\t\n   265\t    // The explicit total (ruling 013): the assembled view's actual size —\n   266\t    // band tokens plus tail — reported beside the per-band actuals. Here it\n   267\t    // lands UNDER the bound (insufficient stored material at this scale),\n   268\t    // the bound being a target, not a cap.\n   269\t    expect(receipt.value.totalTokens).toBe(\n   270\t      receipt.value.bands.brief.tokens +\n   271\t        receipt.value.bands.detailed.tokens +\n   272\t        receipt.value.bands.smooth.tokens +\n   273\t        receipt.value.tailTokens,\n   274\t    );\n   275\t    expect(receipt.value.totalTokens).toBeGreaterThan(0);\n   276\t    expect(receipt.value.totalTokens).toBeLessThanOrEqual(400);\n   277\t\n   278\t    // No provider call anywhere in the compact path; the record (events,\n   279\t    // messages, turns, chunks, forms) is byte-identical after.\n   280\t    expect(captured.length).toBe(capturedBefore);\n","exit_code":0,"status":"completed"}}

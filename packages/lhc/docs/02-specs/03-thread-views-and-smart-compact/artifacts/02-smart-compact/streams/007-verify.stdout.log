{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/internal/select.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Band selection (Story 2): the six-rule walk from tech design §Deterministic\n     2\t// Algorithms — compact point, smooth/detailed/brief fills, rule-5 unchunked\n     3\t// turns, rule-6 turnless stragglers — plus the coverage edge (covered_from)\n     4\t// and canonical-corruption detection. Two halves, deliberately split:\n     5\t//\n     6\t//   - readSelectionInputs: the record/forms reads, with the corruption check\n     7\t//     IN the reads, before any transaction opens (story Technical Notes) —\n     8\t//     a refusal here means nothing was written, so the prior view is\n     9\t//     trivially intact (AC-2.5). Never moved inside the transaction.\n    10\t//   - selectArrangement: a pure function over those inputs. No DB handle, no\n    11\t//     clock, no provider — same inputs ⇒ same arrangement, byte-for-byte\n    12\t//     (AC-2.9; goldens G1–G4 pin the tie-breakers).\n    13\t//\n    14\t// Tie-breakers, pinned (tech design): inclusion thresholds are ≤; walks are\n    15\t// newest-first everywhere; chunk coverage is decided by the chunk's newest\n    16\t// member turn. Entry costs are the tokens of the rendered entry text itself\n    17\t// (render.ts's renderArrangementEntry, including attached inter-turn notes),\n    18\t// so the budgeted tokens are the stored tokens — no second estimate.\n    19\timport type { DatabaseSync } from \"node:sqlite\";\n    20\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n    21\timport type { Band } from \"../../../shared/view.js\";\n    22\timport {\n    23\t  excerptLine,\n    24\t  renderArrangementEntry,\n    25\t  resolveBriefRepresentation,\n    26\t  resolveDetailedRepresentation,\n    27\t  resolveSmoothRepresentation,\n    28\t  type FormSnapshot,\n    29\t} from \"./render.js\";\n    30\t\n    31\t// Canonical source state needed to identify or read the compacted span is\n    32\t// damaged: compact refuses with state_corruption (AC-2.5). Derived-material\n    33\t// damage never raises this — it degrades through the ladders instead.\n    34\texport class CanonicalCorruptionError extends Error {\n    35\t  readonly code: \"turn_state_corrupt\" | \"source_damaged\";\n    36\t  constructor(code: \"turn_state_corrupt\" | \"source_damaged\", reason: string) {\n    37\t    super(reason);\n    38\t    this.code = code;\n    39\t    this.name = \"CanonicalCorruptionError\";\n    40\t  }\n    41\t}\n    42\t\n    43\texport interface SelectionMessage {\n    44\t  messageId: string;\n    45\t  order: number; // source_event_order\n    46\t  kind: string;\n    47\t  tokenEstimate: number;\n    48\t  turnId: string | null;\n    49\t  text: string; // excerpt/note line (render.excerptLine)\n    50\t}\n    51\t\n    52\texport interface SelectionTurn {\n    53\t  turnId: string;\n    54\t  turnOrder: number;\n    55\t  status: \"open\" | \"closed\";\n    56\t  openedAt: number;\n    57\t  closedAt: number | null;\n    58\t}\n    59\t\n    60\texport interface SelectionChunk {\n    61\t  chunkId: string;\n    62\t  chunkOrder: number;\n    63\t  status: \"open\" | \"closed\";\n    64\t  memberTurnIds: string[]; // member order\n    65\t}\n    66\t\n    67\texport interface SelectionInputs {\n    68\t  messages: SelectionMessage[]; // live only, ascending order\n    69\t  turns: SelectionTurn[]; // ascending turnOrder\n    70\t  chunks: SelectionChunk[]; // ascending chunkOrder\n    71\t  forms: Map<string, FormSnapshot>; // `${subjectId}/${form}` (turn/chunk subjects)\n    72\t  maxEventOrder: number;\n    73\t  formCounts: Record<string, Record<string, number>>; // form → state → count\n    74\t}\n    75\t\n    76\texport interface ArrangementEntry {\n    77\t  band: Band;\n    78\t  subjectKind: \"turn\" | \"chunk\";\n    79\t  subjectId: string;\n    80\t  formUsed: string;\n    81\t  degraded: boolean;\n    82\t  gap: boolean;\n    83\t  reason?: string; // gap entries\n    84\t  startOrder: number; // oldest event order the entry represents (notes included)\n    85\t  text: string; // rendered entry text (the band stores this verbatim)\n    86\t  tokens: number;\n    87\t}\n    88\t\n    89\texport interface SelectionResult {\n    90\t  compactPoint: number;\n    91\t  coveredFrom: number;\n    92\t  // Gradient order (brief → detailed → smooth), oldest-first within band —\n    93\t  // the order the bands render and the arrangement persists.\n    94\t  entries: ArrangementEntry[];\n    95\t}\n    96\t\n    97\t// ── reads (corruption check lives here, pre-transaction) ─────────\n    98\t\n    99\texport function readSelectionInputs(db: DatabaseSync): SelectionInputs {\n   100\t  const turnRows = db\n   101\t    .prepare(\n   102\t      `SELECT turn_id, turn_order, status, opened_at_event_order, closed_at_event_order, deleted_at\n   103\t       FROM turns ORDER BY turn_order`,\n   104\t    )\n   105\t    .all() as unknown as Array<{\n   106\t    turn_id: string;\n   107\t    turn_order: number | bigint;\n   108\t    status: string;\n   109\t    opened_at_event_order: number | bigint;\n   110\t    closed_at_event_order: number | bigint | null;\n   111\t    deleted_at: string | null;\n   112\t  }>;\n   113\t  // Referential checks compare against every turn row (a tombstoned turn is\n   114\t  // a legitimate reference target, not damage); the selection walk itself\n   115\t  // sees live turns only.\n   116\t  const turnIds = new Set(turnRows.map((row) => row.turn_id));\n   117\t  const turns: SelectionTurn[] = turnRows\n   118\t    .filter((row) => row.deleted_at === null)\n   119\t    .map((row) => ({\n   120\t      turnId: row.turn_id,\n   121\t      turnOrder: Number(row.turn_order),\n   122\t      status: row.status as \"open\" | \"closed\",\n   123\t      openedAt: Number(row.opened_at_event_order),\n   124\t      closedAt: row.closed_at_event_order === null ? null : Number(row.closed_at_event_order),\n   125\t    }));\n   126\t\n   127\t  // Canonical damage the walk cannot select across (AC-2.5): the Epic 01\n   128\t  // turn-state invariant (at most one open turn, open turns carry no close),\n   129\t  // and referential damage between the chunk/message rows and their turns.\n   130\t  const openTurns = turns.filter((turn) => turn.status === \"open\");\n   131\t  if (openTurns.length > 1) {\n   132\t    throw new CanonicalCorruptionError(\n   133\t      \"turn_state_corrupt\",\n   134\t      `canonical turn state corrupt: ${openTurns.length} open turns (${openTurns\n   135\t        .map((turn) => turn.turnId)\n   136\t        .join(\", \")}); the compacted span cannot be identified`,\n   137\t    );\n   138\t  }\n   139\t  for (const turn of turns) {\n   140\t    if (turn.status === \"closed\" && turn.closedAt === null) {\n   141\t      throw new CanonicalCorruptionError(\n   142\t        \"source_damaged\",\n   143\t        `canonical turn state corrupt: closed turn ${turn.turnId} carries no close boundary`,\n   144\t      );\n   145\t    }\n   146\t  }\n   147\t\n   148\t  const messageRows = db\n   149\t    .prepare(\n   150\t      `SELECT message_id, source_event_order, kind, token_estimate, turn_id\n   151\t       FROM message WHERE deleted_at IS NULL ORDER BY source_event_order`,\n   152\t    )\n   153\t    .all() as unknown as Array<{\n   154\t    message_id: string;\n   155\t    source_event_order: number | bigint;\n   156\t    kind: string;\n   157\t    token_estimate: number | bigint;\n   158\t    turn_id: string | null;\n   159\t  }>;\n   160\t  const blockRows = db\n   161\t    .prepare(\n   162\t      `SELECT mb.message_id, mb.block_type, mb.content\n   163\t       FROM message_block mb JOIN message m ON m.message_id = mb.message_id\n   164\t       WHERE m.deleted_at IS NULL\n   165\t       ORDER BY m.source_event_order, mb.block_index`,\n   166\t    )\n   167\t    .all() as unknown as Array<{ message_id: string; block_type: string; content: string }>;\n   168\t  const blocksByMessage = new Map<\n   169\t    string,\n   170\t    Array<{ blockType: string; content: Record<string, unknown> }>\n   171\t  >();\n   172\t  for (const row of blockRows) {\n   173\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n   174\t    blocks.push({\n   175\t      blockType: row.block_type,\n   176\t      content: JSON.parse(row.content) as Record<string, unknown>,\n   177\t    });\n   178\t    blocksByMessage.set(row.message_id, blocks);\n   179\t  }\n   180\t  const messages: SelectionMessage[] = messageRows.map((row) => {\n   181\t    if (row.turn_id !== null && !turnIds.has(row.turn_id)) {\n   182\t      throw new CanonicalCorruptionError(\n   183\t        \"source_damaged\",\n   184\t        `canonical record corrupt: message ${row.message_id} references missing turn ${row.turn_id}`,\n   185\t      );\n   186\t    }\n   187\t    return {\n   188\t      messageId: row.message_id,\n   189\t      order: Number(row.source_event_order),\n   190\t      kind: row.kind,\n   191\t      tokenEstimate: Number(row.token_estimate),\n   192\t      turnId: row.turn_id,\n   193\t      text: excerptLine(row.kind, blocksByMessage.get(row.message_id) ?? []),\n   194\t    };\n   195\t  });\n   196\t\n   197\t  const chunkRows = db\n   198\t    .prepare(`SELECT chunk_id, chunk_order, status FROM chunk ORDER BY chunk_order`)\n   199\t    .all() as unknown as Array<{ chunk_id: string; chunk_order: number | bigint; status: string }>;\n   200\t  const memberRows = db\n   201\t    .prepare(\n   202\t      `SELECT cm.chunk_id, cm.turn_id, cm.member_idx FROM chunk_member cm\n   203\t       JOIN chunk c ON c.chunk_id = cm.chunk_id\n   204\t       ORDER BY c.chunk_order, cm.member_idx`,\n   205\t    )\n   206\t    .all() as unknown as Array<{ chunk_id: string; turn_id: string; member_idx: number | bigint }>;\n   207\t  const membersByChunk = new Map<string, string[]>();\n   208\t  for (const row of memberRows) {\n   209\t    if (!turnIds.has(row.turn_id)) {\n   210\t      throw new CanonicalCorruptionError(\n   211\t        \"source_damaged\",\n   212\t        `canonical record corrupt: chunk ${row.chunk_id} membership references missing turn ${row.turn_id}`,\n   213\t      );\n   214\t    }\n   215\t    const members = membersByChunk.get(row.chunk_id) ?? [];\n   216\t    members.push(row.turn_id);\n   217\t    membersByChunk.set(row.chunk_id, members);\n   218\t  }\n   219\t  const chunks: SelectionChunk[] = chunkRows.map((row) => ({\n   220\t    chunkId: row.chunk_id,\n   221\t    chunkOrder: Number(row.chunk_order),\n   222\t    status: row.status as \"open\" | \"closed\",\n   223\t    memberTurnIds: membersByChunk.get(row.chunk_id) ?? [],\n   224\t  }));\n   225\t\n   226\t  const formRows = db\n   227\t    .prepare(\n   228\t      `SELECT subject_id, form, state, content, reason FROM derived_form\n   229\t       WHERE subject_kind IN ('turn', 'chunk')`,\n   230\t    )\n   231\t    .all() as unknown as Array<{\n   232\t    subject_id: string;\n   233\t    form: string;\n   234\t    state: string;\n   235\t    content: string | null;\n   236\t    reason: string | null;\n   237\t  }>;\n   238\t  const forms = new Map<string, FormSnapshot>();\n   239\t  for (const row of formRows) {\n   240\t    const snapshot: FormSnapshot = { state: row.state as FormSnapshot[\"state\"] };\n   241\t    if (row.content !== null) snapshot.content = row.content;\n   242\t    if (row.reason !== null) snapshot.reason = row.reason;\n   243\t    forms.set(`${row.subject_id}/${row.form}`, snapshot);\n   244\t  }\n   245\t\n   246\t  const maxRow = db.prepare(`SELECT COALESCE(MAX(event_order), 0) AS m FROM event`).get() as {\n   247\t    m: number | bigint;\n   248\t  };\n   249\t  const countRows = db\n   250\t    .prepare(`SELECT form, state, COUNT(*) AS n FROM derived_form GROUP BY form, state`)\n   251\t    .all() as unknown as Array<{ form: string; state: string; n: number | bigint }>;\n   252\t  const formCounts: Record<string, Record<string, number>> = {};\n   253\t  for (const row of countRows) {\n   254\t    formCounts[row.form] = { ...formCounts[row.form], [row.state]: Number(row.n) };\n   255\t  }\n   256\t\n   257\t  return { messages, turns, chunks, forms, maxEventOrder: Number(maxRow.m), formCounts };\n   258\t}\n   259\t\n   260\t// ── the pure walk ─────────────────────────────────────────────────\n   261\t\n   262\texport interface SelectionConfig {\n   263\t  lowerBound: number;\n   264\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\n   265\t}\n   266\t\n   267\texport function selectArrangement(\n   268\t  inputs: SelectionInputs,\n   269\t  config: SelectionConfig,\n   270\t): SelectionResult {\n   271\t  const { messages, turns, chunks, forms } = inputs;\n   272\t  const lookup = (subjectId: string, form: string): FormSnapshot | undefined =>\n   273\t    forms.get(`${subjectId}/${form}`);\n   274\t  const budget = (share: number): number => (config.lowerBound * share) / 100;\n   275\t\n   276\t  const turnsById = new Map(turns.map((turn) => [turn.turnId, turn]));\n   277\t  const messagesByTurn = new Map<string, SelectionMessage[]>();\n   278\t  for (const message of messages) {\n   279\t    if (message.turnId === null) continue;\n   280\t    const list = messagesByTurn.get(message.turnId) ?? [];\n   281\t    list.push(message);\n   282\t    messagesByTurn.set(message.turnId, list);\n   283\t  }\n   284\t\n   285\t  // Rule 6: turnless stragglers attach to the FOLLOWING turn — they ride its\n   286\t  // band assignment, price into its fill cost, and render marked immediately\n   287\t  // before its entry. No following turn ⇒ tail by construction.\n   288\t  const notesByTurn = new Map<string, SelectionMessage[]>();\n   289\t  for (const message of messages) {\n   290\t    if (message.turnId !== null) continue;\n   291\t    const following = turns.find((turn) => turn.openedAt > message.order);\n   292\t    if (following === undefined) continue; // trailing straggler: tail\n   293\t    const list = notesByTurn.get(following.turnId) ?? [];\n   294\t    list.push(message);\n   295\t    notesByTurn.set(following.turnId, list);\n   296\t  }\n   297\t\n   298\t  // The oldest event order a turn's entry represents: its oldest live\n   299\t  // message or attached note, falling back to its open boundary.\n   300\t  function turnStartOrder(turn: SelectionTurn): number {\n   301\t    const candidates = [\n   302\t      ...(messagesByTurn.get(turn.turnId) ?? []).map((message) => message.order),\n   303\t      ...(notesByTurn.get(turn.turnId) ?? []).map((note) => note.order),\n   304\t    ];\n   305\t    return candidates.length === 0 ? turn.openedAt : Math.min(...candidates);\n   306\t  }\n   307\t\n   308\t  // Rule 1 — compact point: messages newest-first until the estimate sum\n   309\t  // first reaches the full share; the point snaps to a turn boundary so the\n   310\t  // tail never begins mid-turn. Open-turn messages always land in the tail.\n   311\t  const fullBudget = budget(config.percentages.full);\n   312\t  const closedTurns = turns.filter((turn) => turn.status === \"closed\");\n   313\t  let compactPoint = 0;\n   314\t  if (closedTurns.length > 0 && messages.length > 0) {\n   315\t    let sum = 0;\n   316\t    let crossing: SelectionMessage | null = null;\n   317\t    for (let i = messages.length - 1; i >= 0; i -= 1) {\n   318\t      const message = messages[i] as SelectionMessage;\n   319\t      sum += message.tokenEstimate;\n   320\t      if (sum >= fullBudget) {\n   321\t        crossing = message;\n   322\t        break;\n   323\t      }\n   324\t    }\n   325\t    // Budget never reached ⇒ the whole record fits the full share:\n   326\t    // everything is tail, no bands.\n   327\t    compactPoint = crossing === null ? 0 : snapCompactPoint(crossing);\n   328\t  }\n   329\t\n   330\t  function snapCompactPoint(oldestTaken: SelectionMessage): number {\n   331\t    // The turn whose boundary the point snaps against: the message's own\n   332\t    // turn, or — for a turnless straggler — the turn it attaches to.\n   333\t    let candidate: SelectionTurn | undefined =\n   334\t      oldestTaken.turnId !== null ? turnsById.get(oldestTaken.turnId) : undefined;\n   335\t    if (candidate === undefined && oldestTaken.turnId === null) {\n   336\t      candidate = turns.find((turn) => turn.openedAt > oldestTaken.order);\n   337\t    }\n   338\t    const previousClose = (turn: SelectionTurn): number => {\n   339\t      const previous = closedTurns.filter((t) => t.turnOrder < turn.turnOrder).at(-1);\n   340\t      return previous?.closedAt ?? 0;\n   341\t    };\n   342\t    if (candidate === undefined) {\n   343\t      // A trailing straggler with no following turn sits after the last turn\n   344\t      // boundary, where the compact point cannot pass it: tail begins after\n   345\t      // the newest closed turn.\n   346\t      return closedTurns.at(-1)?.closedAt ?? 0;\n   347\t    }\n   348\t    if (candidate.status === \"open\") {\n   349\t      // Open-turn messages are tail regardless of budget; the tail begins at\n   350\t      // the open turn's start.\n   351\t      return previousClose(candidate);\n   352\t    }\n   353\t    // Fully covered down to the turn's start (notes included) ⇒ the tail\n   354\t    // begins at this turn; otherwise snap FORWARD to the next turn start —\n   355\t    // the partially-covered turn falls whole to the bands.\n   356\t    if (oldestTaken.order <= turnStartOrder(candidate)) {\n   357\t      return previousClose(candidate);\n   358\t    }\n   359\t    return candidate.closedAt ?? 0;\n   360\t  }\n   361\t\n   362\t  // Band candidates: closed turns wholly behind the compact point. Rule 5 is\n   363\t  // structural here — chunked or not, a banded turn is a smooth candidate\n   364\t  // (bands are defined by representation, not strict time strata).\n   365\t  const bandedTurns = closedTurns.filter(\n   366\t    (turn) => turn.closedAt !== null && turn.closedAt <= compactPoint,\n   367\t  );\n   368\t  const bandedTurnIds = new Set(bandedTurns.map((turn) => turn.turnId));\n   369\t\n   370\t  function buildTurnEntry(turn: SelectionTurn): ArrangementEntry {\n   371\t    const turnMessages = messagesByTurn.get(turn.turnId) ?? [];\n   372\t    const excerpt =\n   373\t      turnMessages.length === 0 ? null : turnMessages.map((message) => message.text).join(\"\\n\");\n   374\t    const rep = resolveSmoothRepresentation(turn.turnId, lookup, excerpt);\n   375\t    const noteTexts = (notesByTurn.get(turn.turnId) ?? []).map((note) => note.text);\n   376\t    const text = renderArrangementEntry(\"turn\", turn.turnId, rep, noteTexts);\n   377\t    const entry: ArrangementEntry = {\n   378\t      band: \"smooth\",\n   379\t      subjectKind: \"turn\",\n   380\t      subjectId: turn.turnId,\n   381\t      formUsed: rep.formUsed,\n   382\t      degraded: rep.degraded,\n   383\t      gap: rep.gap,\n   384\t      startOrder: turnStartOrder(turn),\n   385\t      text,\n   386\t      tokens: estimateTokens(text),\n   387\t    };\n   388\t    if (rep.reason !== undefined) entry.reason = rep.reason;\n   389\t    return entry;\n   390\t  }\n   391\t\n   392\t  function buildChunkEntry(chunk: SelectionChunk, band: \"detailed\" | \"brief\"): ArrangementEntry {\n   393\t    const memberProjections = chunk.memberTurnIds\n   394\t      .map((turnId) => lookup(turnId, \"lower_band_projection\"))\n   395\t      .filter((form): form is FormSnapshot & { content: string } => form?.state === \"ready\")\n   396\t      .map((form) => form.content ?? \"\")\n   397\t      .filter((content) => content.length > 0);\n   398\t    const rep =\n   399\t      band === \"detailed\"\n   400\t        ? resolveDetailedRepresentation(chunk.chunkId, lookup, memberProjections)\n   401\t        : resolveBriefRepresentation(chunk.chunkId, lookup);\n   402\t    const noteTexts = chunk.memberTurnIds.flatMap((turnId) =>\n   403\t      (notesByTurn.get(turnId) ?? []).map((note) => note.text),\n   404\t    );\n   405\t    const text = renderArrangementEntry(\"chunk\", chunk.chunkId, rep, noteTexts);\n   406\t    const memberStarts = chunk.memberTurnIds\n   407\t      .map((turnId) => turnsById.get(turnId))\n   408\t      .filter((turn): turn is SelectionTurn => turn !== undefined)\n   409\t      .map((turn) => turnStartOrder(turn));\n   410\t    const entry: ArrangementEntry = {\n   411\t      band,\n   412\t      subjectKind: \"chunk\",\n   413\t      subjectId: chunk.chunkId,\n   414\t      formUsed: rep.formUsed,\n   415\t      degraded: rep.degraded,\n   416\t      gap: rep.gap,\n   417\t      startOrder: memberStarts.length === 0 ? compactPoint : Math.min(...memberStarts),\n   418\t      text,\n   419\t      tokens: estimateTokens(text),\n   420\t    };\n   421\t    if (rep.reason !== undefined) entry.reason = rep.reason;\n   422\t    return entry;\n   423\t  }\n   424\t\n   425\t  // The one fill rule, shared by all three bands (rules 2–4, ruling 013's\n   426\t  // literal reading): newest-first whole-entry fill, ≤ inclusion (an entry\n   427\t  // exactly filling the budget is included), the first crossing entry stops\n   428\t  // the band — included only when the band was still empty (one oversized\n   429\t  // entry still represents).\n   430\t  function fillBand<T>(\n   431\t    candidates: readonly T[], // newest-first\n   432\t    bandBudget: number,\n   433\t    build: (candidate: T) => ArrangementEntry,\n   434\t  ): { included: ArrangementEntry[]; rest: T[] } {\n   435\t    const included: ArrangementEntry[] = [];\n   436\t    let sum = 0;\n   437\t    for (let i = 0; i < candidates.length; i += 1) {\n   438\t      const entry = build(candidates[i] as T);\n   439\t      if (sum + entry.tokens <= bandBudget) {\n   440\t        included.push(entry);\n   441\t        sum += entry.tokens;\n   442\t        continue;\n   443\t      }\n   444\t      if (included.length === 0) {\n   445\t        included.push(entry);\n   446\t        return { included, rest: candidates.slice(i + 1) as T[] };\n   447\t      }\n   448\t      return { included, rest: candidates.slice(i) as T[] };\n   449\t    }\n   450\t    return { included, rest: [] };\n   451\t  }\n   452\t\n   453\t  // Rule 2 + 5 — smooth band: banded closed turns newest-first, chunked or\n   454\t  // not (rule 5 is structural: a closed-but-unchunked turn is a turn, takes\n   455\t  // the smooth representation, and consumes this budget).\n   456\t  const smooth = fillBand(\n   457\t    [...bandedTurns].reverse(),\n   458\t    budget(config.percentages.smooth),\n   459\t    buildTurnEntry,\n   460\t  );\n   461\t  const oldestSmoothOrder = smooth.included.reduce(\n   462\t    (oldest, entry) =>\n   463\t      Math.min(oldest, turnsById.get(entry.subjectId)?.turnOrder ?? Number.POSITIVE_INFINITY),\n   464\t    Number.POSITIVE_INFINITY,\n   465\t  );\n   466\t\n   467\t  // Rules 3–4 — chunk candidacy: chunks entirely older than the smooth\n   468\t  // band's coverage, with the pinned tie-breaker doing the deciding — chunk\n   469\t  // coverage is its NEWEST member turn, which must sit behind the compact\n   470\t  // point and be older than the smooth band's oldest included turn.\n   471\t  const chunkCandidates = chunks\n   472\t    .filter((chunk) => chunk.status === \"closed\")\n   473\t    .filter((chunk) => {\n   474\t      const liveMembers = chunk.memberTurnIds\n   475\t        .map((turnId) => turnsById.get(turnId))\n   476\t        .filter((turn): turn is SelectionTurn => turn !== undefined);\n   477\t      if (liveMembers.length === 0) return false; // fully tombstoned membership\n   478\t      const newestMember = liveMembers.reduce((newest, turn) =>\n   479\t        turn.turnOrder > newest.turnOrder ? turn : newest,\n   480\t      );\n   481\t      return (\n   482\t        bandedTurnIds.has(newestMember.turnId) && newestMember.turnOrder < oldestSmoothOrder\n   483\t      );\n   484\t    })\n   485\t    .reverse(); // newest-first\n   486\t\n   487\t  // Rule 3 — detailed: same fill rule against its share.\n   488\t  const detailed = fillBand(chunkCandidates, budget(config.percentages.detailed), (chunk) =>\n   489\t    buildChunkEntry(chunk, \"detailed\"),\n   490\t  );\n   491\t  // Rule 4 — brief: the remaining chunks, same fill rule against its share.\n   492\t  // Chunks remaining after the budget are the coverage edge — outside the\n   493\t  // view, reported via covered_from, never phantom gap entries.\n   494\t  const brief = fillBand(detailed.rest, budget(config.percentages.brief), (chunk) =>\n   495\t    buildChunkEntry(chunk, \"brief\"),\n   496\t  );\n   497\t\n   498\t  const byRecordOrder = (a: ArrangementEntry, b: ArrangementEntry): number =>\n   499\t    a.startOrder - b.startOrder;\n   500\t  const entries: ArrangementEntry[] = [\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/view-compact.test.ts | sed -n '280,560p'\"","aggregated_output":"   280\t    expect(captured.length).toBe(capturedBefore);\n   281\t    expect(recordSnapshot(fixture.filePath)).toBe(recordBefore);\n   282\t  });\n   283\t});\n   284\t\n   285\tdescribe(\"TC-2.6 (AC-2.10): band entries carry their subject keys visibly\", () => {\n   286\t  it(\"chunk keys in brief/detailed text, turn keys in smooth text\", async () => {\n   287\t    const receipt = await fixture.sdk.threadView.compact(\n   288\t      { filePath: fixture.filePath },\n   289\t      { params: GRADIENT_PARAMS },\n   290\t    );\n   291\t    expect(receipt.ok).toBe(true);\n   292\t\n   293\t    const messages = await pullMessages(fixture.sdk, fixture.filePath);\n   294\t    const bands = bandMessages(messages);\n   295\t    const byBand = new Map(bands.map((message) => [message.band, message.content]));\n   296\t    expect(byBand.get(\"brief\")).toMatch(/§c\\d+/);\n   297\t    expect(byBand.get(\"detailed\")).toMatch(/§c\\d+/);\n   298\t    expect(byBand.get(\"smooth\")).toMatch(/§t\\d+/);\n   299\t    expect(byBand.get(\"smooth\")).not.toMatch(/§c\\d+/);\n   300\t  });\n   301\t});\n   302\t\n   303\tdescribe(\"architecture-risk: coverage edge accounting\", () => {\n   304\t  it(\"excluded old chunks set covered_from, the receipt reports the window, and no phantom gaps appear\", async () => {\n   305\t    const receipt = await fixture.sdk.threadView.compact(\n   306\t      { filePath: fixture.filePath },\n   307\t      { params: EDGE_PARAMS },\n   308\t    );\n   309\t    expect(receipt.ok).toBe(true);\n   310\t    if (!receipt.ok) return;\n   311\t\n   312\t    // The compact point lands at t10's close, so c3, c2, and c1 are all\n   313\t    // chunk candidates; c3 takes detailed (loner), the brief share holds c2\n   314\t    // alone, and c1 remains AFTER the budget: outside the view. covered_from\n   315\t    // lands at c2's start — t4's prompt, event 13 — and the exclusion is\n   316\t    // visible as coveredFrom > first event.\n   317\t    expect(receipt.value.compactPoint).toBe(56);\n   318\t    expect(receipt.value.coveredFrom).toBe(13);\n   319\t    expect(receipt.value.bands.detailed.entries).toBe(1);\n   320\t    expect(receipt.value.bands.brief.entries).toBe(1);\n   321\t    // No silent omission AND no phantom gap entries for the out-of-window\n   322\t    // chunk: gaps report unusable material, not the window's edge.\n   323\t    expect(receipt.value.gaps).toEqual([]);\n   324\t\n   325\t    const messages = await pullMessages(fixture.sdk, fixture.filePath);\n   326\t    const bandText = bandMessages(messages)\n   327\t      .map((message) => message.content)\n   328\t      .join(\"\\n\");\n   329\t    expect(bandText).not.toContain(\"§c1\");\n   330\t    expect(bandText).toContain(\"§c2\");\n   331\t    expect(bandText).toContain(\"§c3\");\n   332\t  });\n   333\t});\n   334\t\n   335\tdescribe(\"architecture-risk: restart serves the snapshot (real-file durability)\", () => {\n   336\t  it(\"a fresh SDK on the same file pulls byte-identical band content\", async () => {\n   337\t    const receipt = await fixture.sdk.threadView.compact(\n   338\t      { filePath: fixture.filePath },\n   339\t      { params: GRADIENT_PARAMS },\n   340\t    );\n   341\t    expect(receipt.ok).toBe(true);\n   342\t    const before = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n   343\t    expect(before.ok).toBe(true);\n   344\t    if (!before.ok) return;\n   345\t\n   346\t    // Not a same-process reread: a fresh SDK instance opens the file cold.\n   347\t    const fresh = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n   348\t    const after = await fresh.threadView.pull({ filePath: fixture.filePath });\n   349\t    expect(after.ok).toBe(true);\n   350\t    if (!after.ok) return;\n   351\t    expect(JSON.stringify(after.value)).toBe(JSON.stringify(before.value));\n   352\t  });\n   353\t});\n   354\t\n   355\tdescribe(\"TC-2.4 (AC-2.6): crash injection at the compact-write point\", () => {\n   356\t  it(\"an injected crash leaves the previous view serving; the rerun lands clean with no partial state\", async () => {\n   357\t    const first = await fixture.sdk.threadView.compact(\n   358\t      { filePath: fixture.filePath },\n   359\t      { params: GRADIENT_PARAMS },\n   360\t    );\n   361\t    expect(first.ok).toBe(true);\n   362\t    const priorPull = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n   363\t    expect(priorPull.ok).toBe(true);\n   364\t    if (!priorPull.ok) return;\n   365\t    expect(boundaryPosition(fixture.filePath)).toBe(48);\n   366\t\n   367\t    setViewInjectionHook(\"compact-write\", () => {\n   368\t      throw new Error(\"injected crash between sweep and view write\");\n   369\t    });\n   370\t    try {\n   371\t      const crashed = await fixture.sdk.threadView.compact(\n   372\t        { filePath: fixture.filePath },\n   373\t        { params: EDGE_PARAMS },\n   374\t      );\n   375\t      expect(crashed.ok).toBe(false);\n   376\t      if (crashed.ok) return;\n   377\t      expect(crashed.error.errorClass).toBe(\"system_error\");\n   378\t      expect(crashed.error.reason).toContain(\"injected crash\");\n   379\t    } finally {\n   380\t      setViewInjectionHook(\"compact-write\", null);\n   381\t    }\n   382\t\n   383\t    // The previous view still serves, byte-identical; no partial rows, no\n   384\t    // boundary movement.\n   385\t    const afterCrash = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n   386\t    expect(afterCrash.ok).toBe(true);\n   387\t    if (!afterCrash.ok) return;\n   388\t    expect(JSON.stringify(afterCrash.value)).toBe(JSON.stringify(priorPull.value));\n   389\t    expect(viewRowCount(fixture.filePath)).toBe(1);\n   390\t    expect(boundaryPosition(fixture.filePath)).toBe(48);\n   391\t\n   392\t    // Rerun: the new view lands whole and the boundary resets to ITS compact\n   393\t    // point (56) in the same transaction.\n   394\t    const rerun = await fixture.sdk.threadView.compact(\n   395\t      { filePath: fixture.filePath },\n   396\t      { params: EDGE_PARAMS },\n   397\t    );\n   398\t    expect(rerun.ok).toBe(true);\n   399\t    if (!rerun.ok) return;\n   400\t    expect(rerun.value.coveredFrom).toBe(13);\n   401\t    expect(viewRowCount(fixture.filePath)).toBe(1);\n   402\t    expect(boundaryPosition(fixture.filePath)).toBe(56);\n   403\t    const rerunPull = await fixture.sdk.threadView.pull({ filePath: fixture.filePath });\n   404\t    expect(rerunPull.ok).toBe(true);\n   405\t    if (!rerunPull.ok) return;\n   406\t    expect(JSON.stringify(rerunPull.value)).not.toBe(JSON.stringify(priorPull.value));\n   407\t  });\n   408\t});\n   409\t\n   410\t// ── degraded thread (TC-2.3 + the TC-2.5 view-health completion legs) ──\n   411\t\n   412\t// The fixture conversation rebuilt with manufactured derived damage, all\n   413\t// through production paths: c1's brief summary exhausts through scripted\n   414\t// retryable provider failures at build; post-build edits clear t8's turn\n   415\t// forms and all of c2's dependent chain to pending (the Epic 02 cascade) —\n   416\t// a pending turn rendering for the smooth band, and a chunk with no usable\n   417\t// form at all (summaries pending, zero ready member projections) for the\n   418\t// gap rung.\n   419\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n   420\tconst C1_BRIEF_EXHAUST_REASON = \"rate_limit: scripted c1 brief exhaustion (test)\";\n   421\t\n   422\tfunction degradedTurnEvents(turn: number): MessageEventInput[] {\n   423\t  const events: MessageEventInput[] = [\n   424\t    validEvent(\"user_prompt\", { payload: { text: `turn ${turn}: please investigate area ${turn}` } }),\n   425\t    validEvent(\"assistant_thinking\", { payload: { text: `considering what area ${turn} contains` } }),\n   426\t  ];\n   427\t  if (TOOL_HEAVY_TURNS.has(turn)) {\n   428\t    for (const run of [1, 2]) {\n   429\t      const toolCallId = `call-dg-${turn}-${run}`;\n   430\t      events.push(\n   431\t        validEvent(\"tool_call\", {\n   432\t          payload: { toolCallId, toolName: \"read_file\", arguments: { path: `area-${turn}/file-${run}.txt` } },\n   433\t        }),\n   434\t        validEvent(\"tool_result\", {\n   435\t          payload: {\n   436\t            toolCallId,\n   437\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n   438\t            isError: false,\n   439\t          },\n   440\t        }),\n   441\t      );\n   442\t    }\n   443\t  }\n   444\t  events.push(\n   445\t    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n   446\t    validEvent(\"turn_end\"),\n   447\t  );\n   448\t  return events;\n   449\t}\n   450\t\n   451\tinterface DegradedThread {\n   452\t  filePath: string;\n   453\t  sdk: Lhc;\n   454\t  double: ProviderDouble;\n   455\t  promptIdByTurn: Map<number, string>;\n   456\t}\n   457\t\n   458\tasync function buildDegradedThread(intoStore: TempStore): Promise<DegradedThread> {\n   459\t  const double = createProviderDouble();\n   460\t  const sdk = createSdk({\n   461\t    provider: double,\n   462\t    mode: \"manual\",\n   463\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n   464\t    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\n   465\t  });\n   466\t  const filePath = intoStore.threadPath();\n   467\t  const created = await sdk.threads.newThread({ filePath, registryPath: intoStore.registryPath });\n   468\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n   469\t\n   470\t  const promptIdByTurn = new Map<number, string>();\n   471\t  for (let turn = 1; turn <= 12; turn += 1) {\n   472\t    if (turn === 4) {\n   473\t      // c1 closes during turn 4's drain (placement of t4): its brief summary\n   474\t      // exhausts through real retry mechanics — a FAILED chunk summary.\n   475\t      double.failKind(\"chunk_summary_brief\", 3, {\n   476\t        retryable: true,\n   477\t        reason: C1_BRIEF_EXHAUST_REASON,\n   478\t      });\n   479\t    }\n   480\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, degradedTurnEvents(turn));\n   481\t    if (!sent.ok) throw new Error(`intake failed: ${sent.error.reason}`);\n   482\t    const promptId = sent.value.events[0]?.messageId;\n   483\t    if (promptId !== undefined && promptId !== null) promptIdByTurn.set(turn, promptId);\n   484\t    const drained = await sdk.work.drain({ filePath });\n   485\t    if (!drained.ok) throw new Error(`drain failed: ${drained.error.reason}`);\n   486\t  }\n   487\t\n   488\t  // Post-build edits, NOT drained: the cascade clears each edited message's\n   489\t  // dependent chain to pending. t8 ⇒ a PENDING turn rendering in the smooth\n   490\t  // band; t4+t5+t6 ⇒ c2's summaries pending with zero ready member\n   491\t  // projections — the gap rung.\n   492\t  for (const turn of [4, 5, 6, 8]) {\n   493\t    const promptId = promptIdByTurn.get(turn);\n   494\t    if (promptId === undefined) throw new Error(`no prompt id recorded for turn ${turn}`);\n   495\t    const edited = await sdk.messages.edit(\n   496\t      { filePath },\n   497\t      { messageId: promptId, content: `turn ${turn}: edited investigation of area ${turn}` },\n   498\t    );\n   499\t    if (!edited.ok) throw new Error(`edit failed: ${edited.error.reason}`);\n   500\t  }\n   501\t  return { filePath, sdk, double, promptIdByTurn };\n   502\t}\n   503\t\n   504\tdescribe(\"TC-2.3 (AC-2.5, AC-2.7) + TC-2.5 view-health legs: degraded material renders fallbacks, never fails the compact\", () => {\n   505\t  let degradedStore: TempStore;\n   506\t  let degraded: DegradedThread;\n   507\t\n   508\t  beforeAll(async () => {\n   509\t    degradedStore = tempStore();\n   510\t    degraded = await buildDegradedThread(degradedStore);\n   511\t  });\n   512\t  afterAll(() => {\n   513\t    degradedStore.cleanup();\n   514\t  });\n   515\t\n   516\t  it(\"completes with ladder fallbacks marked, gap entries for unusable spans, and full accounting in the receipt\", async () => {\n   517\t    const captured = degraded.double.captureInputs();\n   518\t    const capturedBefore = captured.length;\n   519\t\n   520\t    const receipt = await degraded.sdk.threadView.compact(\n   521\t      { filePath: degraded.filePath },\n   522\t      { params: { lowerBound: 400, percentages: { full: 25, smooth: 25, detailed: 10, brief: 40 } } },\n   523\t    );\n   524\t    expect(receipt.ok).toBe(true);\n   525\t    if (!receipt.ok) return;\n   526\t\n   527\t    // The pending turn rendering (t8, edited): the smooth entry degrades down\n   528\t    // its ladder (projection pending too) to the deterministic excerpt.\n   529\t    const t8 = receipt.value.degraded.find((entry) => entry.subjectId === \"t8\");\n   530\t    expect(t8).toBeDefined();\n   531\t    expect(t8?.band).toBe(\"smooth\");\n   532\t    expect(t8?.usedForm).toBe(\"message_excerpt\");\n   533\t\n   534\t    // The failed chunk summary (c1's brief): the brief entry renders the\n   535\t    // truncated detailed summary, marked.\n   536\t    const c1 = receipt.value.degraded.find((entry) => entry.subjectId === \"c1\");\n   537\t    expect(c1).toBeDefined();\n   538\t    expect(c1?.band).toBe(\"brief\");\n   539\t    expect(c1?.usedForm).toBe(\"chunk_summary_detailed_truncated\");\n   540\t\n   541\t    // The unusable chunk (c2: summaries pending, zero ready member\n   542\t    // projections): an explicit gap entry with its reason — never absence.\n   543\t    expect(receipt.value.gaps).toHaveLength(1);\n   544\t    const gap = receipt.value.gaps[0];\n   545\t    expect(gap?.subjectId).toBe(\"c2\");\n   546\t    expect(gap?.reason).toMatch(/no usable form/);\n   547\t    expect(gap?.reason).toContain(\"chunk_summary_detailed: pending\");\n   548\t\n   549\t    // Per-band counts present; no span silently absent: every turn in the\n   550\t    // compacted range is accounted for by a band subject (c1: t1–t3, c2:\n   551\t    // t4–t6, smooth: t7–t8) and everything after the compact point is tail.\n   552\t    expect(receipt.value.bands.brief.entries).toBe(1);\n   553\t    expect(receipt.value.bands.detailed.entries).toBe(1);\n   554\t    expect(receipt.value.bands.smooth.entries).toBe(2);\n   555\t    expect(receipt.value.compactPoint).toBe(48);\n   556\t    expect(receipt.value.coveredFrom).toBe(1);\n   557\t\n   558\t    // The rendered text carries the markers (degrade visibly, AC-2.5/2.10).\n   559\t    const messages = await pullMessages(degraded.sdk, degraded.filePath);\n   560\t    const bandText = bandMessages(messages)\n","exit_code":0,"status":"completed"}}

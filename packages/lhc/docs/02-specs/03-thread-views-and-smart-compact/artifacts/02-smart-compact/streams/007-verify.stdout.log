{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/view.ts | sed -n '100,132p'\"","aggregated_output":"   100\t  threshold: number;\n   101\t  compactRecommended: boolean;\n   102\t  derivation: { pending: number; retrying: number; failed: number; blocked: number };\n   103\t  view: { degraded: number; gaps: number; builtAt: string } | null;\n   104\t  visibility: { zoneTokens: number; maxTokens: number };\n   105\t}\n   106\t\n   107\t// ── receipts (AC-2.7, AC-3.x) ─────────────────────────────────────\n   108\texport interface CompactReceipt {\n   109\t  viewId: string;\n   110\t  profile: string | null;\n   111\t  config: ViewProfile[\"percentages\"] & { lowerBound: number };\n   112\t  bands: Record<Band, { entries: number; tokens: number }>;\n   113\t  tailTokens: number;\n   114\t  // The assembled view's actual total (band tokens + tail tokens) against\n   115\t  // the configured lower bound — a target, not a cap: whole-entry fills may\n   116\t  // land under it, indivisible entries over it (AC-2.4; ruling 013).\n   117\t  totalTokens: number;\n   118\t  coveredFrom: number;\n   119\t  compactPoint: number;\n   120\t  degraded: Array<{ band: Band; subjectId: string; usedForm: string }>;\n   121\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n   122\t  // Story 2 ships the compact with the sweep step ABSENT: the field reports\n   123\t  // the honest literal \"absent\" — never a fake empty SweepReceipt. Story 3\n   124\t  // adds the embedded sweep and flips this to SweepReceipt | { skipped: true }\n   125\t  // (cross-story debt, stated: stories/02-smart-compact.md §Scope out).\n   126\t  sweep: SweepReceipt | { skipped: true } | \"absent\";\n   127\t}\n   128\t\n   129\texport interface SweepReceipt {\n   130\t  owners: Array<{\n   131\t    owner: \"messages\" | \"turns\";\n   132\t    kind: string;\n","exit_code":0,"status":"completed"}}

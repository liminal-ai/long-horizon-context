{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013vHGsZC5PTzMfj6atmWpnr","type":"tool_result","content":"1\t// The scripted-host builders (Epic 05 test plan §Fixture Contracts): fake\n2\t// ModelCall implementations every Flow 1–3 test uses. These are boundary\n3\t// doubles, not internal mocks — the ModelCall function is where LHC's code\n4\t// ends (tech design §Testing Strategy). All builders return\n5\t// contract-conformant shapes (AC-1.2); seam-conformance.ts asserts that of\n6\t// recordingCall in its own test so fixture drift is caught by the suite.\n7\timport { FORM_KINDS, type FormKind } from \"../../src/shared/derivation.js\";\n8\timport { DEFAULT_PROMPT_NAMES } from \"../../src/inference/prompts/index.js\";\n9\timport type {\n10\t  ModelAssignment,\n11\t  ModelCall,\n12\t  ModelCallInput,\n13\t  ModelCallResult,\n14\t} from \"../../src/inference/types.js\";\n15\t\n16\texport { FORM_KINDS, type FormKind };\n17\t\n18\t// validAssignments gives every kind a distinct fake provider/model lane;\n19\t// recordingCall infers the kind back from the model string, so per-kind\n20\t// routing is observable from the log alone (TC-1.2).\n21\texport const FAKE_PROVIDER_PREFIX = \"prov-\";\n22\texport const FAKE_MODEL_PREFIX = \"model-\";\n23\t\n24\texport function validAssignments(\n25\t  overrides: Partial<Record<FormKind, Partial<ModelAssignment>>> = {},\n26\t): Record<FormKind, ModelAssignment> {\n27\t  const map = {} as Record<FormKind, ModelAssignment>;\n28\t  for (const kind of FORM_KINDS) {\n29\t    map[kind] = {\n30\t      provider: `${FAKE_PROVIDER_PREFIX}${kind}`,\n31\t      model: `${FAKE_MODEL_PREFIX}${kind}`,\n32\t      prompt: DEFAULT_PROMPT_NAMES[kind],\n33\t      ...(overrides[kind] ?? {}),\n34\t    };\n35\t  }\n36\t  return map;\n37\t}\n38\t\n39\t// One distinct canned sentence per kind, so cross-kind bleed is visible in\n40\t// landed form content, never just in call counts.\n41\texport function cannedResponses(): Record<FormKind, string> {\n42\t  const map = {} as Record<FormKind, string>;\n43\t  for (const kind of FORM_KINDS) {\n44\t    map[kind] = `canned ${kind} text from the fake host`;\n45\t  }\n46\t  return map;\n47\t}\n48\t\n49\t// Resolves each call with its kind's canned text — the kind inferred from\n50\t// the model routing key validAssignments made unique per kind. Every input\n51\t// is cloned into `log` in call order. An unknown model is a test bug and\n52\t// throws loudly.\n53\texport function recordingCall(responses: Record<FormKind, string>): {\n54\t  call: ModelCall;\n55\t  log: ModelCallInput[];\n56\t} {\n57\t  const log: ModelCallInput[] = [];\n58\t  const known = new Set<string>(FORM_KINDS);\n59\t  const call: ModelCall = (input) => {\n60\t    log.push(structuredClone(input));\n61\t    const kind = input.model.startsWith(FAKE_MODEL_PREFIX)\n62\t      ? input.model.slice(FAKE_MODEL_PREFIX.length)\n63\t      : input.model;\n64\t    if (!known.has(kind)) {\n65\t      throw new Error(`recordingCall: no canned response for model \"${input.model}\"`);\n66\t    }\n67\t    return Promise.resolve({ ok: true, text: responses[kind as FormKind] });\n68\t  };\n69\t  return { call, log };\n70\t}\n71\t\n72\t// Returns script entries in order; a call past the end of the script is a\n73\t// test bug and throws loudly.\n74\texport function scriptedCall(script: ModelCallResult[]): ModelCall {\n75\t  let next = 0;\n76\t  return (input) => {\n77\t    const entry = script[next];\n78\t    next += 1;\n79\t    if (entry === undefined) {\n80\t      throw new Error(\n81\t        `scriptedCall: script exhausted after ${String(script.length)} calls (model \"${input.model}\")`,\n82\t      );\n83\t    }\n84\t    return Promise.resolve(entry);\n85\t  };\n86\t}\n87\t\n88\t// A host whose function throws — the AC-3.3 containment leg.\n89\texport function throwingCall(error: Error): ModelCall {\n90\t  return () => Promise.reject(error);\n91\t}\n92\t\n93\t// A host that never settles — the DD-6 timeout leg (tests pass a small\n94\t// timeoutMs).\n95\texport function hangingCall(): ModelCall {\n96\t  return () => new Promise<ModelCallResult>(() => {});\n97\t}\n98\t"}]},"parent_tool_use_id":null,"session_id":"6f6a66f7-9908-4860-b5a4-ba92a559f344","uuid":"e436e27e-c0ba-47b4-ae76-eed8648a04d5","timestamp":"2026-06-12T22:59:38.038Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/model-call.ts","content":"// The scripted-host builders (Epic 05 test plan §Fixture Contracts): fake\n// ModelCall implementations every Flow 1–3 test uses. These are boundary\n// doubles, not internal mocks — the ModelCall function is where LHC's code\n// ends (tech design §Testing Strategy). All builders return\n// contract-conformant shapes (AC-1.2); seam-conformance.ts asserts that of\n// recordingCall in its own test so fixture drift is caught by the suite.\nimport { FORM_KINDS, type FormKind } from \"../../src/shared/derivation.js\";\nimport { DEFAULT_PROMPT_NAMES } from \"../../src/inference/prompts/index.js\";\nimport type {\n  ModelAssignment,\n  ModelCall,\n  ModelCallInput,\n  ModelCallResult,\n} from \"../../src/inference/types.js\";\n\nexport { FORM_KINDS, type FormKind };\n\n// validAssignments gives every kind a distinct fake provider/model lane;\n// recordingCall infers the kind back from the model string, so per-kind\n// routing is observable from the log alone (TC-1.2).\nexport const FAKE_PROVIDER_PREFIX = \"prov-\";\nexport const FAKE_MODEL_PREFIX = \"model-\";\n\nexport function validAssignments(\n  overrides: Partial<Record<FormKind, Partial<ModelAssignment>>> = {},\n): Record<FormKind, ModelAssignment> {\n  const map = {} as Record<FormKind, ModelAssignment>;\n  for (const kind of FORM_KINDS) {\n    map[kind] = {\n      provider: `${FAKE_PROVIDER_PREFIX}${kind}`,\n      model: `${FAKE_MODEL_PREFIX}${kind}`,\n      prompt: DEFAULT_PROMPT_NAMES[kind],\n      ...(overrides[kind] ?? {}),\n    };\n  }\n  return map;\n}\n\n// One distinct canned sentence per kind, so cross-kind bleed is visible in\n// landed form content, never just in call counts.\nexport function cannedResponses(): Record<FormKind, string> {\n  const map = {} as Record<FormKind, string>;\n  for (const kind of FORM_KINDS) {\n    map[kind] = `canned ${kind} text from the fake host`;\n  }\n  return map;\n}\n\n// Resolves each call with its kind's canned text — the kind inferred from\n// the model routing key validAssignments made unique per kind. Every input\n// is cloned into `log` in call order. An unknown model is a test bug and\n// throws loudly.\nexport function recordingCall(responses: Record<FormKind, string>): {\n  call: ModelCall;\n  log: ModelCallInput[];\n} {\n  const log: ModelCallInput[] = [];\n  const known = new Set<string>(FORM_KINDS);\n  const call: ModelCall = (input) => {\n    log.push(structuredClone(input));\n    const kind = input.model.startsWith(FAKE_MODEL_PREFIX)\n      ? input.model.slice(FAKE_MODEL_PREFIX.length)\n      : input.model;\n    if (!known.has(kind)) {\n      throw new Error(`recordingCall: no canned response for model \"${input.model}\"`);\n    }\n    return Promise.resolve({ ok: true, text: responses[kind as FormKind] });\n  };\n  return { call, log };\n}\n\n// Returns script entries in order; a call past the end of the script is a\n// test bug and throws loudly.\nexport function scriptedCall(script: ModelCallResult[]): ModelCall {\n  let next = 0;\n  return (input) => {\n    const entry = script[next];\n    next += 1;\n    if (entry === undefined) {\n      throw new Error(\n        `scriptedCall: script exhausted after ${String(script.length)} calls (model \"${input.model}\")`,\n      );\n    }\n    return Promise.resolve(entry);\n  };\n}\n\n// A host whose function throws — the AC-3.3 containment leg.\nexport function throwingCall(error: Error): ModelCall {\n  return () => Promise.reject(error);\n}\n\n// A host that never settles — the DD-6 timeout leg (tests pass a small\n// timeoutMs).\nexport function hangingCall(): ModelCall {\n  return () => new Promise<ModelCallResult>(() => {});\n}\n","numLines":98,"startLine":1,"totalLines":98}}}

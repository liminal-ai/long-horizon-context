{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018yvJUkkrDC8Bd239Uop6T2","type":"tool_result","content":"1\t// Spawnable drain runner for the process-boundary suite (TC-1.3 / TC-1.4).\n2\t// Argument: one JSON config — { threadPath, leaseMs, holdMs, holdFrom }.\n3\t// It assembles a real SDK (manual mode), registers the test work handlers\n4\t// with a marker/hold protocol, and drains the thread:\n5\t//   - prints `HANDLER_START <n> <workItemId>` when the nth handler begins —\n6\t//     by drain mechanics that means item n's claim committed and item n-1's\n7\t//     completion landed (the reclaim window for a kill is open);\n8\t//   - from item `holdFrom` on, sleeps `holdMs` inside the handler before the\n9\t//     provider call, keeping that item claimed-and-running while the parent\n10\t//     kills this process (TC-1.3) or drains from a second process (TC-1.4);\n11\t//   - prints `DRAIN_DONE <report JSON>` if it survives to the end.\n12\timport process from \"node:process\";\n13\timport { createSdk } from \"../../src/index.js\";\n14\timport { createProviderDouble } from \"./provider-double.js\";\n15\timport { registerTestWorkHandlers } from \"./work-handlers.js\";\n16\t\n17\tinterface RunnerConfig {\n18\t  threadPath: string;\n19\t  leaseMs: number;\n20\t  holdMs: number;\n21\t  holdFrom: number; // 1-based handler-start index the hold applies from\n22\t}\n23\t\n24\tfunction sleep(ms: number): Promise<void> {\n25\t  return new Promise((resolve) => setTimeout(resolve, ms));\n26\t}\n27\t\n28\tasync function main(): Promise<void> {\n29\t  const raw = process.argv[2];\n30\t  if (raw === undefined) throw new Error(\"drain-runner: missing JSON config argument\");\n31\t  const config = JSON.parse(raw) as RunnerConfig;\n32\t\n33\t  const double = createProviderDouble();\n34\t  const sdk = createSdk({\n35\t    provider: double,\n36\t    mode: \"manual\",\n37\t    lease: { durationMs: config.leaseMs },\n38\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n39\t  });\n40\t  let started = 0;\n41\t  registerTestWorkHandlers(sdk, double, {\n42\t    onHandlerStart: async (item) => {\n43\t      started += 1;\n44\t      process.stdout.write(`HANDLER_START ${started} ${item.workItemId}\\n`);\n45\t      if (started >= config.holdFrom) await sleep(config.holdMs);\n46\t    },\n47\t  });\n48\t\n49\t  const report = await sdk.work.drain({ filePath: config.threadPath });\n50\t  process.stdout.write(`DRAIN_DONE ${JSON.stringify(report)}\\n`);\n51\t  process.exit(report.ok ? 0 : 1);\n52\t}\n53\t\n54\tmain().catch((cause: unknown) => {\n55\t  process.stderr.write(`drain-runner failed: ${String(cause)}\\n`);\n56\t  process.exit(1);\n57\t});\n58\t"}]},"parent_tool_use_id":null,"session_id":"6f6a66f7-9908-4860-b5a4-ba92a559f344","uuid":"4fe90ed8-9318-4648-ab16-b7f142f99a28","timestamp":"2026-06-12T23:02:38.168Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/drain-runner.ts","content":"// Spawnable drain runner for the process-boundary suite (TC-1.3 / TC-1.4).\n// Argument: one JSON config — { threadPath, leaseMs, holdMs, holdFrom }.\n// It assembles a real SDK (manual mode), registers the test work handlers\n// with a marker/hold protocol, and drains the thread:\n//   - prints `HANDLER_START <n> <workItemId>` when the nth handler begins —\n//     by drain mechanics that means item n's claim committed and item n-1's\n//     completion landed (the reclaim window for a kill is open);\n//   - from item `holdFrom` on, sleeps `holdMs` inside the handler before the\n//     provider call, keeping that item claimed-and-running while the parent\n//     kills this process (TC-1.3) or drains from a second process (TC-1.4);\n//   - prints `DRAIN_DONE <report JSON>` if it survives to the end.\nimport process from \"node:process\";\nimport { createSdk } from \"../../src/index.js\";\nimport { createProviderDouble } from \"./provider-double.js\";\nimport { registerTestWorkHandlers } from \"./work-handlers.js\";\n\ninterface RunnerConfig {\n  threadPath: string;\n  leaseMs: number;\n  holdMs: number;\n  holdFrom: number; // 1-based handler-start index the hold applies from\n}\n\nfunction sleep(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nasync function main(): Promise<void> {\n  const raw = process.argv[2];\n  if (raw === undefined) throw new Error(\"drain-runner: missing JSON config argument\");\n  const config = JSON.parse(raw) as RunnerConfig;\n\n  const double = createProviderDouble();\n  const sdk = createSdk({\n    provider: double,\n    mode: \"manual\",\n    lease: { durationMs: config.leaseMs },\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n  });\n  let started = 0;\n  registerTestWorkHandlers(sdk, double, {\n    onHandlerStart: async (item) => {\n      started += 1;\n      process.stdout.write(`HANDLER_START ${started} ${item.workItemId}\\n`);\n      if (started >= config.holdFrom) await sleep(config.holdMs);\n    },\n  });\n\n  const report = await sdk.work.drain({ filePath: config.threadPath });\n  process.stdout.write(`DRAIN_DONE ${JSON.stringify(report)}\\n`);\n  process.exit(report.ok ? 0 : 1);\n}\n\nmain().catch((cause: unknown) => {\n  process.stderr.write(`drain-runner failed: ${String(cause)}\\n`);\n  process.exit(1);\n});\n","numLines":58,"startLine":1,"totalLines":58}}}

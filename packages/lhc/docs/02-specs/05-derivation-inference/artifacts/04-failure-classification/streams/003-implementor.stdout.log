{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MVyxBNKRv2hVqEBbfPw3tU","type":"tool_result","content":"330\t    expect(report.stoppedBecause).toBe(\"empty\");\n331\t    expect(liveCount(filePath)).toBe(0);\n332\t    const smoothed = readDerivedForms(filePath).find((f) => f.subjectId === \"m1\");\n333\t    expect(smoothed?.state).toBe(\"ready\");\n334\t  });\n335\t});\n336\t\n337\tdescribe(\"TC-1.8 / AC-1.9: retry per policy, terminal exhaustion, and the backoff eligibility gate\", () => {\n338\t  it(\"fails twice then succeeds: artifact ready, report shows attempts=2\", async () => {\n339\t    const double = createProviderDouble();\n340\t    const sdk = manualSdk(double);\n341\t    const { filePath } = await newThread();\n342\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n343\t\n344\t    double.failNext(2, { retryable: true });\n345\t    const report = await drain(sdk, filePath);\n346\t    expect(report.ran).toHaveLength(1);\n347\t    expect(report.ran[0]).toMatchObject({\n348\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n349\t      disposition: \"done\",\n350\t      attempts: 2,\n351\t    });\n352\t    expect(readDerivedForms(filePath)[0]?.state).toBe(\"ready\");\n353\t    expect(liveCount(filePath)).toBe(0);\n354\t  });\n355\t\n356\t  it(\"exhausts the budget: form failed with the final provider reason; the next item still ran; row deleted\", async () => {\n357\t    const double = createProviderDouble();\n358\t    const sdk = manualSdk(double);\n359\t    const { filePath } = await newThread();\n360\t    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n361\t\n362\t    double.failKind(\"prompt_smoothing\", 99, {\n363\t      retryable: true,\n364\t      reason: \"scripted exhaustion (smoothPrompt)\",\n365\t    });\n366\t    const report = await drain(sdk, filePath);\n367\t    expect(report.ran).toHaveLength(2);\n368\t    expect(report.ran[0]).toMatchObject({\n369\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n370\t      disposition: \"failed_terminal\",\n371\t      attempts: 3,\n372\t      reason: \"scripted exhaustion (smoothPrompt)\",\n373\t    });\n374\t    expect(report.ran[1]).toMatchObject({\n375\t      workItemId: \"w-t1-turn_derivation-v1\",\n376\t      disposition: \"done\",\n377\t    });\n378\t\n379\t    const forms = readDerivedForms(filePath);\n380\t    const failed = forms.find((f) => f.form === \"smoothed_prompt\");\n381\t    expect(failed?.state).toBe(\"failed\");\n382\t    expect(failed?.reason).toBe(\"scripted exhaustion (smoothPrompt)\");\n383\t    // Final attempts/last-error copied onto the form at exhaustion (DD-1).\n384\t    expect(failed?.metadata?.attempts).toBe(3);\n385\t    expect(forms.find((f) => f.form === \"turn_rendering\")?.state).toBe(\"ready\");\n386\t    expect(liveCount(filePath)).toBe(0);\n387\t  });\n388\t\n389\t  it(\"backoff gates the head and the head gates the queue: waiting stop, waitingUntil, and no skip-ahead\", async () => {\n390\t    const double = createProviderDouble();\n391\t    let nowMs = Date.parse(\"2026-06-10T12:00:00.000Z\");\n392\t    const sdk = manualSdk(double, {\n393\t      clock: () => new Date(nowMs),\n394\t      retry: { budget: 3, backoffBaseMs: 50, backoffCapMs: 60000 },\n395\t    });\n396\t    const { filePath } = await newThread();\n397\t    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n398\t\n399\t    double.failNext(1, { retryable: true });\n400\t    const first = await drain(sdk, filePath);\n401\t    // The head failed once and is backing off: nothing terminal ran, the\n402\t    // drain stopped on the eligibility gate, and the queue behind the head\n403\t    // was not touched.\n404\t    expect(first.ran).toEqual([]);\n405\t    expect(first.stoppedBecause).toBe(\"waiting\");\n406\t    expect(first.remaining).toBe(2);\n407\t    expect(first.waitingUntil).toBeDefined();\n408\t    expect(Date.parse(first.waitingUntil ?? \"\")).toBeGreaterThan(nowMs);\n409\t\n410\t    const detail = liveDetail(filePath);\n411\t    expect(detail).toHaveLength(2);\n412\t    expect(detail[0]).toMatchObject({\n413\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n414\t      status: \"queued\",\n415\t      attempts: 1,\n416\t    });\n417\t    expect(detail[0]?.eligibleAt).toBe(first.waitingUntil);\n418\t    // Skip-ahead proof: the eligible item behind the backing-off head was\n419\t    // never claimed.\n420\t    expect(detail[1]).toMatchObject({\n421\t      workItemId: \"w-t1-turn_derivation-v1\",\n422\t      status: \"queued\",\n423\t      attempts: 0,\n424\t    });\n425\t    expect(detail[1]?.claimedAt).toBeUndefined();\n426\t\n427\t    // Pass the gate: the head becomes eligible and the queue drains in order.\n428\t    nowMs += 60000;\n429\t    const second = await drain(sdk, filePath);\n430\t    expect(second.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n431\t      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n432\t      [\"w-t1-turn_derivation-v1\", \"done\"],\n433\t    ]);\n434\t    expect(second.ran[0]?.attempts).toBe(1);\n435\t    expect(liveCount(filePath)).toBe(0);\n436\t  });\n437\t\n438\t  it(\"a non-retryable provider failure is terminal immediately\", async () => {\n439\t    const double = createProviderDouble();\n440\t    const sdk = manualSdk(double);\n441\t    const { filePath } = await newThread();\n442\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n443\t\n444\t    double.failNext(1, { retryable: false, reason: \"content refusal (scripted)\" });\n445\t    const report = await drain(sdk, filePath);\n446\t    expect(report.ran[0]).toMatchObject({\n447\t      disposition: \"failed_terminal\",\n448\t      attempts: 1,\n449\t      reason: \"content refusal (scripted)\",\n450\t    });\n451\t    expect(readDerivedForms(filePath)[0]?.state).toBe(\"failed\");\n452\t    expect(liveCount(filePath)).toBe(0);\n453\t  });\n454\t\n455\t  it(\"maxItems stops the drain with max_
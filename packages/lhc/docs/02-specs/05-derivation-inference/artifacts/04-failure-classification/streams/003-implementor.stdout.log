{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gm9htYFpkoTZFUi9oSKAxA","type":"tool_result","content":"1\t// The real provider (DD-2): createInferenceProvider returns the same\n2\t// DerivationProvider interface the deterministic provider implements, so\n3\t// createSdk and everything below it see a provider, full stop. Every\n4\t// operation is the same five-step pipeline (Flow 2): bound the input where\n5\t// DD-7 applies, render the kind's prompt template into single-turn messages,\n6\t// call the host ModelCall with the kind's assignment, reject empty or\n7\t// whitespace-only text as empty_output (AC-2.4), and return the shaped text\n8\t// with config-known provenance (AC-2.5). The adapter never parses model text\n9\t// for outcomes, receipts, or any mechanical fact — those stay\n10\t// handler-authored from the record. The safeCall timeout race (DD-6)\n11\t// supersedes the inline thrown-exception containment in the classification\n12\t// story.\n13\timport type {\n14\t  DerivationProvider,\n15\t  FormKind,\n16\t  ProviderResult,\n17\t} from \"../shared/derivation.js\";\n18\timport { FAILURE_CLASSIFICATION } from \"./classify.js\";\n19\timport { PROMPT_REGISTRY, type PromptTemplate } from \"./prompts/index.js\";\n20\timport type {\n21\t  ModelCallFailureKind,\n22\t  ModelCallResult,\n23\t  ResolvedInferenceConfig,\n24\t} from \"./types.js\";\n25\t\n26\t// DD-7: a pathological tool result must not blow a small-context model.\n27\t// Content over the bound keeps its head and tail around a marker, and the\n28\t// bounded whole stays within maxInputChars; bounding happens before prompt\n29\t// rendering, so the dropped middle never crosses the boundary.\n30\tfunction boundContent(content: string, maxInputChars: number): string {\n31\t  if (content.length <= maxInputChars) return content;\n32\t  const marker = `\\n\\n[... truncated: tool result was ${String(content.length)} chars; head and tail retained ...]\\n\\n`;\n33\t  // The marker only earns its place when head + marker + tail still fits the\n34\t  // bound. When maxInputChars is smaller than the marker itself, there is no\n35\t  // budget for the marker — emitting it would be the one path that crosses the\n36\t  // boundary DD-7 exists to hold — so degrade to a plain head truncation that\n37\t  // honors the cap exactly.\n38\t  if (marker.length > maxInputChars) return content.slice(0, maxInputChars);\n39\t  const keep = maxInputChars - marker.length;\n40\t  const head = Math.ceil(keep / 2);\n41\t  const tail = keep - head;\n42\t  return content.slice(0, head) + marker + (tail > 0 ? content.slice(content.length - tail) : \"\");\n43\t}\n44\t\n45\t// Failure mapping (DD-3): the queue consumes `retryable` exactly as it always\n46\t// has, and the reason string is machine-readable by the established\n47\t// code-before-first-colon convention. Retryable failures lead with\n48\t// `provider_failure` — the code Epic 02 has always landed on exhausted forms\n49\t// (the queue copies the provider's reason verbatim at exhaustion, AC-3.2) —\n50\t// with the failure kind named next; terminal kinds lead with the kind itself\n51\t// and land failed immediately.\n52\tfunction classifiedFailure(kind: ModelCallFailureKind, message: string): ProviderResult {\n53\t  const { retryable } = FAILURE_CLASSIFICATION[kind];\n54\t  const detail = message === \"\" ? kind : `${kind}: ${message}`;\n55\t  return {\n56\t    ok: false,\n57\t    retryable,\n58\t    reason: retryable ? `provider_failure: ${detail}` : detail,\n59\t  };\n60\t}\n61\t\n62\texport function createInferenceProvider(config: ResolvedInferenceConfig): DerivationProvider {\n63\t  const callKind = async (kind: FormKind, input: unknown): Promise<ProviderResult> => {\n64\t    const assignment = config.assignments[kind];\n65\t    // Construction validated the name (AC-1.3); a miss here is registry\n66\t    // drift after construction and is terminal, never retried into.\n67\t    const template = PROMPT_REGISTRY[assignment.prompt] as PromptTemplate<unknown> | undefined;\n68\t    if (template === undefined) {\n69\t      return classifiedFailure(\n70\t        \"invalid_request\",\n71\t        `prompt template \"${assignment.prompt}\" not in registry`,\n72\t      );\n73\t    }\n74\t    const messages = template.render(input);\n75\t    let result: ModelCallResult;\n76\t    try {\n77\t      result = await config.call({\n78\t        provider: assignment.provider,\n79\t        model: assignment.model,\n80\t        messages,\n81\t      });\n82\t    } catch (cause) {\n83\t      // Thrown host exceptions classify as `other` (AC-3.3); the structured\n84\t      // safeCall wrapper (timeout race, DD-6) supersedes this containment in\n85\t      // the classification story.\n86\t      result = { ok: false, kind: \"other\", message: String(cause) };\n87\t    }\n88\t    if (!result.ok) {\n89\t      return classifiedFailure(result.kind, result.message);\n90\t    }\n91\t    // Shaping: surrounding whitespace never becomes form content — and a\n92\t    // model that returned nothing but whitespace has not produced a\n93\t    // derivation (AC-2.4): a classified retryable failure, never a ready\n94\t    // form. `empty_output` is adapter-generated; hosts never return it.\n95\t    const text = result.text.trim();\n96\t    if (text === \"\") {\n97\t      return classifiedFailure(\"empty_output\", \"model returned empty or whitespace-only text\");\n98\t    }\n99\t    // Provenance is the assignment's three config-known strings, copied —\n100\t    // never authored from model output (DD-4).\n101\t    return {\n102\t      ok: true,\n103\t      text,\n104\t      provenance: {\n105\t        provider: assignment.provider,\n106\t        model: assignment.model,\n107\t        prompt: assignment.prompt,\n108\t      },\n109\t    };\n110\t  };\n111\t\n112\t  return {\n113\t    smoothPrompt: (i) => callKind(\"smoothed_prompt\", i),\n114\t    summarizeToolCall: (i) => callKind(\"tool_call_summary\", i),\n115\t    summarizeToolResult: (i) =>\n116\t      callKind(\"tool_result_summary\", {\n117\t        toolName: i.toolName,\n118\t        content: boundContent(i.content, config.maxInputChars),\n119\t      }),\n120\t    composeTurnRendering: (i) => callKind(\"turn_rendering\", i),\n121\t    projectLowerBand: (i) => callKind(\"lower_band_projection\", i),\n122\t    summarizeChunkDetailed: (i) => callKind(\"chunk_summary_detailed\", i),\n123\t    summarizeChunkBrief: (i) => callKind(\"chunk_summary_brief\", i),\n124\t  };\n125\t}\n126\t"}]},"parent_tool_use_id":null,"session_id":"6f6a66f7-9908-4860-b5a4-ba92a559f344","uuid":"390e4681-1c71-48a5-bfdc-433ecaa676db","timestamp":"2026-06-12T22:59:36.855Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/inference/adapter.ts","content":"// The real provider (DD-2): createInferenceProvider returns the same\n// DerivationProvider interface the deterministic provider implements, so\n// createSdk and everything below it see a provider, full stop. Every\n// operation is the same five-step pipeline (Flow 2): bound the input where\n// DD-7 applies, render the kind's prompt template into single-turn messages,\n// call the host ModelCall with the kind's assignment, reject empty or\n// whitespace-only text as empty_output (AC-2.4), and return the shaped text\n// with config-known provenance (AC-2.5). The adapter never parses model text\n// for outcomes, receipts, or any mechanical fact — those stay\n// handler-authored from the record. The safeCall timeout race (DD-6)\n// supersedes the inline thrown-exception containment in the classification\n// story.\nimport type {\n  DerivationProvider,\n  FormKind,\n  ProviderResult,\n} from \"../shared/derivation.js\";\nimport { FAILURE_CLASSIFICATION } from \"./classify.js\";\nimport { PROMPT_REGISTRY, type PromptTemplate } from \"./prompts/index.js\";\nimport type {\n  ModelCallFailureKind,\n  ModelCallResult,\n  ResolvedInferenceConfig,\n} from \"./types.js\";\n\n// DD-7: a pathological tool result must not blow a small-context model.\n// Content over the bound keeps its head and tail around a marker, and the\n// bounded whole stays within maxInputChars; bounding happens before prompt\n// rendering, so the dropped middle never crosses the boundary.\nfunction boundContent(content: string, maxInputChars: number): string {\n  if (content.length <= maxInputChars) return content;\n  const marker = `\\n\\n[... truncated: tool result was ${String(content.length)} chars; head and tail retained ...]\\n\\n`;\n  // The marker only earns its place when head + marker + tail still fits the\n  // bound. When maxInputChars is smaller than the marker itself, there is no\n  // budget for the marker — emitting it would be the one path that crosses the\n  // boundary DD-7 exists to hold — so degrade to a plain head truncation that\n  // honors the cap exactly.\n  if (marker.length > maxInputChars) return content.slice(0, maxInputChars);\n  const keep = maxInputChars - marker.length;\n  const head = Math.ceil(keep / 2);\n  const tail = keep - head;\n  return content.slice(0, head) + marker + (tail > 0 ? content.slice(content.length - tail) : \"\");\n}\n\n// Failure mapping (DD-3): the queue consumes `retryable` exactly as it always\n// has, and the reason string is machine-readable by the established\n// code-before-first-colon convention. Retryable failures lead with\n// `provider_failure` — the code Epic 02 has always landed on exhausted forms\n// (the queue copies the provider's reason verbatim at exhaustion, AC-3.2) —\n// with the failure kind named next; terminal kinds lead with the kind itself\n// and land failed immediately.\nfunction classifiedFailure(kind: ModelCallFailureKind, message: string): ProviderResult {\n  const { retryable } = FAILURE_CLASSIFICATION[kind];\n  const detail = message === \"\" ? kind : `${kind}: ${message}`;\n  return {\n    ok: false,\n    retryable,\n    reason: retryable ? `provider_failure: ${detail}` : detail,\n  };\n}\n\nexport function createInferenceProvider(config: ResolvedInferenceConfig): DerivationProvider {\n  const callKind = async (kind: FormKind, input: unknown): Promise<ProviderResult> => {\n    const assignment = config.assignments[kind];\n    // Construction validated the name (AC-1.3); a miss here is registry\n    // drift after construction and is terminal, never retried into.\n    const template = PROMPT_REGISTRY[assignment.prompt] as PromptTemplate<unknown> | undefined;\n    if (template === undefined) {\n      return classifiedFailure(\n        \"invalid_request\",\n        `prompt template \"${assignment.prompt}\" not in registry`,\n      );\n    }\n    const messages = template.render(input);\n    let result: ModelCallResult;\n    try {\n      result = await config.call({\n        provider: assignment.provider,\n        model: assignment.model,\n        messages,\n      });\n    } catch (cause) {\n      // Thrown host exceptions classify as `other` (AC-3.3); the structured\n      // safeCall wrapper (timeout race, DD-6) supersedes this containment in\n      // the classification story.\n      result = { ok: false, kind: \"other\", message: String(cause) };\n    }\n    if (!result.ok) {\n      return classifiedFailure(result.kind, result.message);\n    }\n    // Shaping: surrounding whitespace never becomes form content — and a\n    // model that returned nothing but whitespace has not produced a\n    // derivation (AC-2.4): a classified retryable failure, never a ready\n    // form. `empty_output` is adapter-generated; hosts never return it.\n    const text = result.text.trim();\n    if (text === \"\") {\n      return classifiedFailure(\"empty_output\", \"model returned empty or whitespace-only text\");\n    }\n    // Provenance is the assignment's three config-known strings, copied —\n    // never authored from model output (DD-4).\n    return {\n      ok: true,\n      text,\n      provenance: {\n        provider: assignment.provider,\n        model: assignment.model,\n        prompt: assignment.prompt,\n      },\n    };\n  };\n\n  return {\n    smoothPrompt: (i) => callKind(\"smoothed_prompt\", i),\n    summarizeToolCall: (i) => callKind(\"tool_call_summary\", i),\n    summarizeToolResult: (i) =>\n      callKind(\"tool_result_summary\", {\n        toolName: i.toolName,\n        content: boundContent(i.content, config.maxInputChars),\n      }),\n    composeTurnRendering: (i) => callKind(\"turn_rendering\", i),\n    projectLowerBand: (i) => callKind(\"lower_band_projection\", i),\n    summarizeChunkDetailed: (i) => callKind(\"chunk_summary_detailed\", i),\n    summarizeChunkBrief: (i) => callKind(\"chunk_summary_brief\", i),\n  };\n}\n","numLines":126,"startLine":1,"totalLines":126}}}

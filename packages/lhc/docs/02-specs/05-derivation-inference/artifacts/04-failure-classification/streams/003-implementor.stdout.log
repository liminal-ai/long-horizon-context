{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DXhHvPhNsprWmSWYR2Uk5K","type":"tool_result","content":"1\t// Epic 05 Story 3 — TC-2.1 (AC-2.1, AC-2.2, AC-2.5) and TC-2.3 (AC-2.4): the\n2\t// real adapter behind the unchanged Epic 02 seam. A seeded thread drains all\n3\t// seven kinds to ready with the fake host's canned content; the same seeding\n4\t// drained under the deterministic provider proves the handlers unchanged\n5\t// (equivalence, AC-2.1). The canned text for the tool lanes deliberately\n6\t// claims the wrong outcome — the stamped outcome must come from the record,\n7\t// never provider prose (architecture risk: adapter parses model output).\n8\t// Empty or whitespace-only success text is a classified retryable failure,\n9\t// never a ready form.\n10\timport { afterEach, describe, expect, it } from \"vitest\";\n11\timport { createDeterministicProvider, createSdk, type DerivedForm, type Lhc } from \"../src/index.js\";\n12\timport { DEFAULT_PROMPT_NAMES } from \"../src/inference/prompts/index.js\";\n13\timport type { ModelCall } from \"../src/inference/types.js\";\n14\timport {\n15\t  cannedResponses,\n16\t  FORM_KINDS,\n17\t  readDerivedForms,\n18\t  recordingCall,\n19\t  scriptedCall,\n20\t  tempStore,\n21\t  validAssignments,\n22\t  validEvent,\n23\t  type FormKind,\n24\t  type TempStore,\n25\t} from \"./fixtures/index.js\";\n26\t\n27\tconst stores: TempStore[] = [];\n28\tafterEach(() => {\n29\t  for (const store of stores.splice(0)) store.cleanup();\n30\t});\n31\t\n32\tfunction freshStore(): TempStore {\n33\t  const store = tempStore();\n34\t  stores.push(store);\n35\t  return store;\n36\t}\n37\t\n38\tconst RETRY = { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 };\n39\t// Tiny target: each placed turn crosses it, so turn 1's chunk closes during\n40\t// the drain and the two chunk-summary kinds run too.\n41\tconst CHUNK_POLICY = { targetProjectedTokens: 5, maxProjectedTokens: 4400 };\n42\t\n43\tconst MARKER_PATTERN = /^(smoothed|toolcall|toolresult|rendering|projection|detailed|brief)\\(/;\n44\t\n45\t// The adversarial canned set: the tool lanes' text claims failure while the\n46\t// record's tool result carries isError: false. A stored outcome agreeing\n47\t// with this prose would prove the adapter (or a handler) parsed model output\n48\t// for mechanical facts.\n49\tfunction adversarialResponses(): Record<FormKind, string> {\n50\t  const responses = cannedResponses();\n51\t  responses.tool_call_summary = \"the read_file call failed catastrophically and was aborted\";\n52\t  responses.tool_result_summary = \"error: the tool produced nothing and the run failed\";\n53\t  return responses;\n54\t}\n55\t\n56\t// Turn 1 carries a clean tool run (smoothing, both tool summaries, rendering,\n57\t// projection); turn 2 exists so turn 1's chunk closes under the tiny target\n58\t// policy and both chunk summaries enqueue.\n59\tasync function seedSevenKinds(sdk: Lhc, store: TempStore): Promise<string> {\n60\t  const filePath = store.threadPath();\n61\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n62\t  expect(created.ok).toBe(true);\n63\t  const result = await sdk.intakeStream.messageEvents({ filePath }, [\n64\t    validEvent(\"user_prompt\", { payload: { text: \"please inspect the fixture file\" } }),\n65\t    validEvent(\"tool_call\", {\n66\t      payload: {\n67\t        toolCallId: \"call-adapter-1\",\n68\t        toolName: \"read_file\",\n69\t        arguments: { path: \"fixture.txt\" },\n70\t      },\n71\t    }),\n72\t    validEvent(\"tool_result\", {\n73\t      payload: { toolCallId: \"call-adapter-1\", content: \"contents of fixture.txt\", isError: false },\n74\t    }),\n75\t    validEvent(\"assistant_text\", { payload: { text: \"the fixture file holds fixture text\" } }),\n76\t    validEvent(\"turn_end\"),\n77\t    validEvent(\"user_prompt\", { payload: { text: \"thanks, now summarize it\" } }),\n78\t    validEvent(\"assistant_text\", { payload: { text: \"summarized\" } }),\n79\t    validEvent(\"turn_end\"),\n80\t  ]);\n81\t  expect(result.ok).toBe(true);\n82\t  return filePath;\n83\t}\n84\t\n85\tasync function drainAll(sdk: Lhc, filePath: string): Promise<DerivedForm[]> {\n86\t  const drained = await sdk.work.drain({ filePath });\n87\t  expect(drained.ok).toBe(true);\n88\t  if (drained.ok) {\n89\t    expect(drained.value.stoppedBecause).toBe(\"empty\");\n90\t    expect(drained.value.remaining).toBe(0);\n91\t  }\n92\t  return readDerivedForms(filePath);\n93\t}\n94\t\n95\t// One prompt, no turn_end: exactly one work item (prompt_smoothing) queues,\n96\t// so a scripted call's entries map one-to-one onto smoothing attempts.\n97\tasync function seedSmoothingOnly(sdk: Lhc, store: TempStore): Promise<string> {\n98\t  const filePath = store.threadPath();\n99\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n100\t  expect(created.ok).toBe(true);\n101\t  const result = await sdk.intakeStream.messageEvents({ filePath }, [\n102\t    validEvent(\"user_prompt\", { payload: { text: \"only a prompt to smooth\" } }),\n103\t  ]);\n104\t  expect(result.ok).toBe(true);\n105\t  return filePath;\n106\t}\n107\t\n108\tfunction inferenceSdk(call: ModelCall): { sdk: Lhc; assignments: ReturnType<typeof validAssignments> } {\n109\t  const assignments = validAssignments();\n110\t  const sdk = createSdk({\n111\t    inference: { call, assignments },\n112\t    mode: \"manual\",\n113\t    retry: RETRY,\n114\t    chunkPolicy: CHUNK_POLICY,\n115\t  });\n116\t  return { sdk, assignments };\n117\t}\n118\t\n119\tdescribe(\"TC-2.1: seven kinds land ready through the adapter (AC-2.1, AC-2.2, AC-2.5)\", () => {\n120\t  it(\"a seeded drain lands every kind ready with its lane's canned content and assignment provenance\", async () => {\n121\t    const responses = adversarialResponses();\n122\t    const { call } = recordingCall(responses);\n123\t    const { sdk, assignments } = inferenceSdk(call);\n124\t    const forms = await drainAll(sdk, await seedSevenKinds(sdk, freshStore()));\n125\t\n126\t    for (const kind of FORM_KINDS) {\n127\t      const ready = forms.filter((form) => form.form === kind && form.state === \"ready\");\n128\t      expect(ready.length).toBeGreaterThan(0);\n129\t      for (const form of ready) {\n130\t        // Content is the canned response, shaped — and provenance is the\n131\t        // assignment's three config-known strings, never authored from text.\n132\t        expect(form.content).toBe(responses[kind]);\n133\t        expect(form.metadata?.provenance).toEqual({\n134\t          provider: assignments[kind].provider,\n135\t          model: assignments[kind].model,\n136\t          prompt: DEFAULT_PROMPT_NAMES[kind],\n137\t        });\n138\t      }\n139\t    }\n140\t  });\n141\t\n142\t  it(\"outcomes and receipts are stamped from the record, disagreeing with the adversarial canned text\", async () => {\n143\t    const responses = adversarialResponses();\n144\t    const { call } = recordingCall(responses);\n145\t    const { sdk } = inferenceSdk(call);\n146\t    const forms = await drainAll(sdk, await seedSevenKinds(sdk, freshStore()));\n147\t\n148\t    // The record's tool result has isError: false, so both tool summaries\n149\t    // must stamp \"succeeded\" even though their landed content claims failure.\n150\t    for (const kind of [\"tool_call_summary\", \"tool_result_summary\"] as const) {\n151\t      const form = forms.find((row) => row.form === kind && row.state === \"ready\");\n152\t      expect(form?.metadata?.outcome).toBe(\"succeeded\");\n153\t      expect(form?.content).toContain(\"failed\");\n154\t    }\n155\t    const rendering = forms.find(\n156\t      (row) => row.form === \"turn_rendering\" && row.state === \"ready\" && row.metadata?.receipts,\n157\t    );\n158\t    expect(rendering).toBeDefined();\n159\t    for (const receipt of rendering?.metadata?.receipts ?? []) {\n160\t      expect(receipt.outcome).toBe(\"succeeded\");\n161\t    }\n162\t  });\n163\t\n164\t  it(\"handler equivalence: the deterministic provider lands the same rows with marker content and no provenance\", async () => {\n165\t    const { call } = recordingCall(adversarialResponses());\n166\t    const { sdk: adapterSdk } = inferenceSdk(call);\n167\t    const adapterForms = await drainAll(adapterSdk, await seedSevenKinds(adapterSdk, freshStore()));\n168\t\n169\t    const deterministicSdk = createSdk({\n170\t      provider: createDeterministicProvider(),\n171\t      mode: \"manual\",\n172\t      retry: RETRY,\n173\t      chunkPolicy: CHUNK_POLICY,\n174\t    });\n175\t    const deterministicForms = await drainAll(\n176\t      deterministicSdk,\n177\t      await seedSevenKinds(deterministicSdk, freshStore()),\n178\t    );\n179\t\n180\t    // Same handler code, same record: the same form rows, subjects, and\n181\t    // states land under both providers (message/turn/chunk ids are\n182\t    // deterministic functions of the event order).\n183\t    const rowKey = (form: DerivedForm): string =>\n184\t      `${form.subjectKind}|${form.subjectId}|${form.form}|${form.state}`;\n185\t    expect(deterministicForms.map(rowKey).sort()).toEqual(adapterForms.map(rowKey).sort());\n186\t\n187\t    for (const form of deterministicForms) {\n188\t      expect(form.state).toBe(\"ready\");\n189\t      expect(form.content).toMatch(MARKER_PATTERN);\n190\t      // The deterministic provider never sets provenance (AC-2.5).\n191\t      expect(form.metadata?.provenance).toBeUndefined();\n192\t    }\n193\t    for (const form of adapterForms) {\n194\t      expect(form.content).not.toMatch(MARKER_PATTERN);\n195\t    }\n196\t  });\n197\t});\n198\t\n199\tdescribe(\"TC-2.3: empty or whitespace-only output is a classified failure (AC-2.4)\", () => {\n200\t  it(\"a whitespace-only success classifies empty_output retryable; the retry lands ready\", async () => {\n201\t    let calls = 0;\n202\t    const script = scriptedCall([\n203\t      { ok: true, text: \"  \" },\n204\t      { ok: true, text: \"the real smoothing\" },\n205\t    ]);\n206\t    const call: ModelCall = (input) => {\n207\t      calls += 1;\n208\t      return script(input);\n209\t    };\n210\t    const { sdk } = inferenceSdk(call);\n211\t    const forms = await drainAll(sdk, await seedSmoothingOnly(sdk, freshStore()));\n212\t\n213\t    const smoothed = forms.find((form) => form.form === \"smoothed_prompt\");\n214\t    expect(smoothed?.state).toBe(\"ready\");\n215\t    expect(smoothed?.content).toBe(\"the real smoothing\");\n216\t    // Two boundary calls: the whitespace-only first attempt was rejected and\n217\t    // retried — it never landed as a ready form.\n218\t    expect(calls).toBe(2);\n219\t  });\n220\t\n221\t  it(\"an all-whitespace script exhausts the budget: failed, reason provider_failure, last error naming empty_output\", async () => {\n222\t    let calls = 0;\n223\t    const script = scriptedCall([\n224\t      { ok: true, text: \"\" },\n225\t      { ok: true, text: \"   \" },\n226\t      { ok: true, text: \"\\n\\t \" },\n227\t    ]);\n228\t    const call: ModelCall = (input) => {\n229\t      calls += 1;\n230\t      return script(input);\n231\t    };\n232\t    const { sdk } = inferenceSdk(call);\n233\t    const forms = await drainAll(sdk, await seedSmoothingOnly(sdk, freshStore()));\n234\t\n235\t    const smoothed = forms.find((form) => form.form === \"smoothed_prompt\");\n236\t    expect(smoothed?.state).toBe(\"failed\");\n237\t    expect(smoothed?.content).toBeUndefined();\n238\t    expect(smoothed?.reason?.startsWith(\"provider_failure\")).toBe(true);\n239\t    expect(smoothed?.reason).toContain(\"empty_output\");\n240\t    expect(smoothed?.metadata?.attempts).toBe(RETRY.budget);\n241\t    expect(smoothed?.metadata?.lastError).toContain(\"empty_output\");\n242\t    expect(calls).toBe(RETRY.budget);\n243\t  });\n244\t\n245\t  it(\"success text is shaped: surrounding whitespace never reaches the form content\", async () => {\n246\t    const { sdk } = inferenceSdk(scriptedCall([{ ok: true, text: \"\\n  shaped result text  \\n\" }]));\n247\t    const forms = await drainAll(sdk, await seedSmoothingOnly(sdk, freshStore()));\n248\t\n249\t    const smoothed = forms.find((form) => form.form === \"smoothed_prompt\");\n250\t    expect(smoothed?.state).toBe(\"ready\");\n251\t    expect(smoothed?.content).toBe(\"shaped result text\");\n252\t  });\n253\t});\n254\t"}]},"parent_tool_use_id":null,"session_id":"6f6a66f7-9908-4860-b5a4-ba92a559f344","uuid":"58bd7762-b9e5-408d-b028-608d221b9ec7","timestamp":"2026-06-12T22:59:50.929Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/inference-adapter.test.ts","content":"// Epic 05 Story 3 — TC-2.1 (AC-2.1, AC-2.2, AC-2.5) and TC-2.3 (AC-2.4): the\n// real adapter behind the unchanged Epic 02 seam. A seeded thread drains all\n// seven kinds to ready with the fake host's canned content; the same seeding\n// drained under the deterministic provider proves the handlers unchanged\n// (equivalence, AC-2.1). The canned text for the tool lanes deliberately\n// claims the wrong outcome — the stamped outcome must come from the record,\n// never provider prose (architecture risk: adapter parses model output).\n// Empty or whitespace-only success text is a classified retryable failure,\n// never a ready form.\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport { createDeterministicProvider, createSdk, type DerivedForm, type Lhc } from \"../src/index.js\";\nimport { DEFAULT_PROMPT_NAMES } from \"../src/inference/prompts/index.js\";\nimport type { ModelCall } from \"../src/inference/types.js\";\nimport {\n  cannedResponses,\n  FORM_KINDS,\n  readDerivedForms,\n  recordingCall,\n  scriptedCall,\n  tempStore,\n  validAssignments,\n  validEvent,\n  type FormKind,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nconst stores: TempStore[] = [];\nafterEach(() => {\n  for (const store of stores.splice(0)) store.cleanup();\n});\n\nfunction freshStore(): TempStore {\n  const store = tempStore();\n  stores.push(store);\n  return store;\n}\n\nconst RETRY = { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 };\n// Tiny target: each placed turn crosses it, so turn 1's chunk closes during\n// the drain and the two chunk-summary kinds run too.\nconst CHUNK_POLICY = { targetProjectedTokens: 5, maxProjectedTokens: 4400 };\n\nconst MARKER_PATTERN = /^(smoothed|toolcall|toolresult|rendering|projection|detailed|brief)\\(/;\n\n// The adversarial canned set: the tool lanes' text claims failure while the\n// record's tool result carries isError: false. A stored outcome agreeing\n// with this prose would prove the adapter (or a handler) parsed model output\n// for mechanical facts.\nfunction adversarialResponses(): Record<FormKind, string> {\n  const responses = cannedResponses();\n  responses.tool_call_summary = \"the read_file call failed catastrophically and was aborted\";\n  responses.tool_result_summary = \"error: the tool produced nothing and the run failed\";\n  return responses;\n}\n\n// Turn 1 carries a clean tool run (smoothing, both tool summaries, rendering,\n// projection); turn 2 exists so turn 1's chunk closes under the tiny target\n// policy and both chunk summaries enqueue.\nasync function seedSevenKinds(sdk: Lhc, store: TempStore): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  expect(created.ok).toBe(true);\n  const result = await sdk.intakeStream.messageEvents({ filePath }, [\n    validEvent(\"user_prompt\", { payload: { text: \"please inspect the fixture file\" } }),\n    validEvent(\"tool_call\", {\n      payload: {\n        toolCallId: \"call-adapter-1\",\n        toolName: \"read_file\",\n        arguments: { path: \"fixture.txt\" },\n      },\n    }),\n    validEvent(\"tool_result\", {\n      payload: { toolCallId: \"call-adapter-1\", content: \"contents of fixture.txt\", isError: false },\n    }),\n    validEvent(\"assistant_text\", { payload: { text: \"the fixture file holds fixture text\" } }),\n    validEvent(\"turn_end\"),\n    validEvent(\"user_prompt\", { payload: { text: \"thanks, now summarize it\" } }),\n    validEvent(\"assistant_text\", { payload: { text: \"summarized\" } }),\n    validEvent(\"turn_end\"),\n  ]);\n  expect(result.ok).toBe(true);\n  return filePath;\n}\n\nasync function drainAll(sdk: Lhc, filePath: string): Promise<DerivedForm[]> {\n  const drained = await sdk.work.drain({ filePath });\n  expect(drained.ok).toBe(true);\n  if (drained.ok) {\n    expect(drained.value.stoppedBecause).toBe(\"empty\");\n    expect(drained.value.remaining).toBe(0);\n  }\n  return readDerivedForms(filePath);\n}\n\n// One prompt, no turn_end: exactly one work item (prompt_smoothing) queues,\n// so a scripted call's entries map one-to-one onto smoothing attempts.\nasync function seedSmoothingOnly(sdk: Lhc, store: TempStore): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  expect(created.ok).toBe(true);\n  const result = await sdk.intakeStream.messageEvents({ filePath }, [\n    validEvent(\"user_prompt\", { payload: { text: \"only a prompt to smooth\" } }),\n  ]);\n  expect(result.ok).toBe(true);\n  return filePath;\n}\n\nfunction inferenceSdk(call: ModelCall): { sdk: Lhc; assignments: ReturnType<typeof validAssignments> } {\n  const assignments = validAssignments();\n  const sdk = createSdk({\n    inference: { call, assignments },\n    mode: \"manual\",\n    retry: RETRY,\n    chunkPolicy: CHUNK_POLICY,\n  });\n  return { sdk, assignments };\n}\n\ndescribe(\"TC-2.1: seven kinds land ready through the adapter (AC-2.1, AC-2.2, AC-2.5)\", () => {\n  it(\"a seeded drain lands every kind ready with its lane's canned content and assignment provenance\", async () => {\n    const responses = adversarialResponses();\n    const { call } = recordingCall(responses);\n    const { sdk, assignments } = inferenceSdk(call);\n    const forms = await drainAll(sdk, await seedSevenKinds(sdk, freshStore()));\n\n    for (const kind of FORM_KINDS) {\n      const ready = forms.filter((form) => form.form === kind && form.state === \"ready\");\n      expect(ready.length).toBeGreaterThan(0);\n      for (const form of ready) {\n        // Content is the canned response, shaped — and provenance is the\n        // assignment's three config-known strings, never authored from text.\n        expect(form.content).toBe(responses[kind]);\n        expect(form.metadata?.provenance).toEqual({\n          provider: assignments[kind].provider,\n          model: assignments[kind].model,\n          prompt: DEFAULT_PROMPT_NAMES[kind],\n        });\n      }\n    }\n  });\n\n  it(\"outcomes and receipts are stamped from the record, disagreeing with the adversarial canned text\", async () => {\n    const responses = adversarialResponses();\n    const { call } = recordingCall(responses);\n    const { sdk } = inferenceSdk(call);\n    const forms = await drainAll(sdk, await seedSevenKinds(sdk, freshStore()));\n\n    // The record's tool result has isError: false, so both tool summaries\n    // must stamp \"succeeded\" even though their landed content claims failure.\n    for (const kind of [\"tool_call_summary\", \"tool_result_summary\"] as const) {\n      const form = forms.find((row) => row.form === kind && row.state === \"ready\");\n      expect(form?.metadata?.outcome).toBe(\"succeeded\");\n      expect(form?.content).toContain(\"failed\");\n    }\n    const rendering = forms.find(\n      (row) => row.form === \"turn_rendering\" && row.state === \"ready\" && row.metadata?.receipts,\n    );\n    expect(rendering).toBeDefined();\n    for (const receipt of rendering?.metadata?.receipts ?? []) {\n      expect(receipt.outcome).toBe(\"succeeded\");\n    }\n  });\n\n  it(\"handler equivalence: the deterministic provider lands the same rows with marker content and no provenance\", async () => {\n    const { call } = recordingCall(adversarialResponses());\n    const { sdk: adapterSdk } = inferenceSdk(call);\n    const adapterForms = await drainAll(adapterSdk, await seedSevenKinds(adapterSdk, freshStore()));\n\n    const deterministicSdk = createSdk({\n      provider: createDeterministicProvider(),\n      mode: \"manual\",\n      retry: RETRY,\n      chunkPolicy: CHUNK_POLICY,\n    });\n    const deterministicForms = await drainAll(\n      deterministicSdk,\n      await seedSevenKinds(deterministicSdk, freshStore()),\n    );\n\n    // Same handler code, same record: the same form rows, subjects, and\n    // states land under both providers (message/turn/chunk ids are\n    // deterministic functions of the event order).\n    const rowKey = (form: DerivedForm): string =>\n      `${form.subjectKind}|${form.subjectId}|${form.form}|${form.state}`;\n    expect(deterministicForms.map(rowKey).sort()).toEqual(adapterForms.map(rowKey).sort());\n\n    for (const form of deterministicForms) {\n      expect(form.state).toBe(\"ready\");\n      expect(form.content).toMatch(MARKER_PATTERN);\n      // The deterministic provider never sets provenance (AC-2.5).\n      expect(form.metadata?.provenance).toBeUndefined();\n    }\n    for (const form of adapterForms) {\n      expect(form.content).not.toMatch(MARKER_PATTERN);\n    }\n  });\n});\n\ndescribe(\"TC-2.3: empty or whitespace-only output is a classified failure (AC-2.4)\", () => {\n  it(\"a whitespace-only success classifies empty_output retryable; the retry lands ready\", async () => {\n    let calls = 0;\n    const script = scriptedCall([\n      { ok: true, text: \"  \" },\n      { ok: true, text: \"the real smoothing\" },\n    ]);\n    const call: ModelCall = (input) => {\n      calls += 1;\n      return script(input);\n    };\n    const { sdk } = inferenceSdk(call);\n    const forms = await drainAll(sdk, await seedSmoothingOnly(sdk, freshStore()));\n\n    const smoothed = forms.find((form) => form.form === \"smoothed_prompt\");\n    expect(smoothed?.state).toBe(\"ready\");\n    expect(smoothed?.content).toBe(\"the real smoothing\");\n    // Two boundary calls: the whitespace-only first attempt was rejected and\n    // retried — it never landed as a ready form.\n    expect(calls).toBe(2);\n  });\n\n  it(\"an all-whitespace script exhausts the budget: failed, reason provider_failure, last error naming empty_output\", async () => {\n    let calls = 0;\n    const script = scriptedCall([\n      { ok: true, text: \"\" },\n      { ok: true, text: \"   \" },\n      { ok: true, text: \"\\n\\t \" },\n    ]);\n    const call: ModelCall = (input) => {\n      calls += 1;\n      return script(input);\n    };\n    const { sdk } = inferenceSdk(call);\n    const forms = await drainAll(sdk, await seedSmoothingOnly(sdk, freshStore()));\n\n    const smoothed = forms.find((form) => form.form === \"smoothed_prompt\");\n    expect(smoothed?.state).toBe(\"failed\");\n    expect(smoothed?.content).toBeUndefined();\n    expect(smoothed?.reason?.startsWith(\"provider_failure\")).toBe(true);\n    expect(smoothed?.reason).toContain(\"empty_output\");\n    expect(smoothed?.metadata?.attempts).toBe(RETRY.budget);\n    expect(smoothed?.metadata?.lastError).toContain(\"empty_output\");\n    expect(calls).toBe(RETRY.budget);\n  });\n\n  it(\"success text is shaped: surrounding whitespace never reaches the form content\", async () => {\n    const { sdk } = inferenceSdk(scriptedCall([{ ok: true, text: \"\\n  shaped result text  \\n\" }]));\n    const forms = await drainAll(sdk, await seedSmoothingOnly(sdk, freshStore()));\n\n    const smoothed = forms.find((form) => form.form === \"smoothed_prompt\");\n    expect(smoothed?.state).toBe(\"ready\");\n    expect(smoothed?.content).toBe(\"shaped result text\");\n  });\n});\n","numLines":254,"startLine":1,"totalLines":254}}}

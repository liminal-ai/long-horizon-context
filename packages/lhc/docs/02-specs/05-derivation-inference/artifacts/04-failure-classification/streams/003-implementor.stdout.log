{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NAboH2s5zMmdAxjbXzDHu8","type":"tool_result","content":"1\t// Epic 05 boundary vocabulary (tech design §Interface Definitions): the one\n2\t// function a host supplies, its structured result shapes, and the config that\n3\t// arrives at createSdk as the alternative to direct provider injection\n4\t// (DD-1, DD-5). LHC treats provider/model strings as opaque routing keys —\n5\t// the host's ModelCall implementation is the only code that interprets them.\n6\timport type { FormKind } from \"../shared/derivation.js\";\n7\t\n8\t/** The one function a host supplies. Single-turn completion; provider/model\n9\t *  are opaque routing keys the host's implementation interprets. (AC-1.2) */\n10\texport type ModelCall = (input: ModelCallInput) => Promise<ModelCallResult>;\n11\t\n12\texport interface ModelCallInput {\n13\t  provider: string;\n14\t  model: string;\n15\t  messages: { role: \"system\" | \"user\"; content: string }[];\n16\t}\n17\t\n18\texport type ModelCallResult =\n19\t  | { ok: true; text: string }\n20\t  | { ok: false; kind: ModelCallFailureKind; message: string };\n21\t\n22\t/** `empty_output` is adapter-generated (AC-2.4); hosts never return it.\n23\t *  Thrown exceptions classify as `other` (AC-3.3). */\n24\texport type ModelCallFailureKind =\n25\t  | \"rate_limit\"\n26\t  | \"timeout\"\n27\t  | \"network\"\n28\t  | \"empty_output\"\n29\t  | \"other\"\n30\t  | \"auth\"\n31\t  | \"invalid_request\";\n32\t\n33\texport interface ModelAssignment {\n34\t  provider: string;\n35\t  model: string;\n36\t  prompt: string; // must name a PROMPT_REGISTRY entry (AC-1.3)\n37\t}\n38\t\n39\t/** SdkConfig.inference — the alternative to SdkConfig.provider (DD-5). */\n40\texport interface InferenceConfig {\n41\t  call: ModelCall;\n42\t  assignments: Record<FormKind, ModelAssignment>; // all seven, validated complete\n43\t  timeoutMs?: number; // default 60_000 (DD-6)\n44\t  maxInputChars?: number; // default 200_000 (DD-7)\n45\t}\n46\t\n47\t/** InferenceConfig after createSdk validation: every optional filled. */\n48\texport interface ResolvedInferenceConfig {\n49\t  call: ModelCall;\n50\t  assignments: Record<FormKind, ModelAssignment>;\n51\t  timeoutMs: number;\n52\t  maxInputChars: number;\n53\t}\n54\t"}]},"parent_tool_use_id":null,"session_id":"6f6a66f7-9908-4860-b5a4-ba92a559f344","uuid":"3c2d6819-780b-484d-854c-03603f662a0f","timestamp":"2026-06-12T22:59:37.876Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/inference/types.ts","content":"// Epic 05 boundary vocabulary (tech design §Interface Definitions): the one\n// function a host supplies, its structured result shapes, and the config that\n// arrives at createSdk as the alternative to direct provider injection\n// (DD-1, DD-5). LHC treats provider/model strings as opaque routing keys —\n// the host's ModelCall implementation is the only code that interprets them.\nimport type { FormKind } from \"../shared/derivation.js\";\n\n/** The one function a host supplies. Single-turn completion; provider/model\n *  are opaque routing keys the host's implementation interprets. (AC-1.2) */\nexport type ModelCall = (input: ModelCallInput) => Promise<ModelCallResult>;\n\nexport interface ModelCallInput {\n  provider: string;\n  model: string;\n  messages: { role: \"system\" | \"user\"; content: string }[];\n}\n\nexport type ModelCallResult =\n  | { ok: true; text: string }\n  | { ok: false; kind: ModelCallFailureKind; message: string };\n\n/** `empty_output` is adapter-generated (AC-2.4); hosts never return it.\n *  Thrown exceptions classify as `other` (AC-3.3). */\nexport type ModelCallFailureKind =\n  | \"rate_limit\"\n  | \"timeout\"\n  | \"network\"\n  | \"empty_output\"\n  | \"other\"\n  | \"auth\"\n  | \"invalid_request\";\n\nexport interface ModelAssignment {\n  provider: string;\n  model: string;\n  prompt: string; // must name a PROMPT_REGISTRY entry (AC-1.3)\n}\n\n/** SdkConfig.inference — the alternative to SdkConfig.provider (DD-5). */\nexport interface InferenceConfig {\n  call: ModelCall;\n  assignments: Record<FormKind, ModelAssignment>; // all seven, validated complete\n  timeoutMs?: number; // default 60_000 (DD-6)\n  maxInputChars?: number; // default 200_000 (DD-7)\n}\n\n/** InferenceConfig after createSdk validation: every optional filled. */\nexport interface ResolvedInferenceConfig {\n  call: ModelCall;\n  assignments: Record<FormKind, ModelAssignment>;\n  timeoutMs: number;\n  maxInputChars: number;\n}\n","numLines":54,"startLine":1,"totalLines":54}}}

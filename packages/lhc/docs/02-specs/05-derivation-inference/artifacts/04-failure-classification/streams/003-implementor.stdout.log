st f of failures) console.error(`  - ${f}`);\n  process.exit(1);\n}\nconsole.log(`test-immutability: OK (${entries.length} Red-phase files unchanged)`);\n40:    \"test/inference-construction.test.ts\": \"84c3e57d496b714a8f531dbea0559d4938f80fb17918851afd35a5ea8e974966\",\n41:    \"test/inference-routing.test.ts\": \"cfcc021c9794efd8ca3249efc9640eff5ab7871a28b15701c5a1933975cc90ab\",\n42:    \"test/inference-adapter.test.ts\": \"b6a00627f4b2a7bd1549ffa985b60833c8e0174ceb57608cd72df7dbcb50a08c\",\n43:    \"test/inference-prompts.test.ts\": \"0d354e74e70570df6fd0203eb93be5816fd133dd704c38dd82d347261f1818cd\",","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

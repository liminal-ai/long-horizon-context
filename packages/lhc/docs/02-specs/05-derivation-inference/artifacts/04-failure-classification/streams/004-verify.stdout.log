{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/inference/classify.ts | sed -n '1,120p'\"","aggregated_output":"     1\t// Failure classification (DD-3): a pure table from the boundary's failure\n     2\t// vocabulary onto Epic 02's retryable-or-not. The queue machinery consumes\n     3\t// `retryable` exactly as it always has — no queue changes, no new states.\n     4\t// `safeCall` is the containment wrapper around the host function: a thrown\n     5\t// exception classifies `other` (AC-3.3) and the adapter-owned timeout race\n     6\t// classifies `timeout` (DD-6) — both structured failures, so no host\n     7\t// function behavior can crash a drain.\n     8\timport type {\n     9\t  ModelCall,\n    10\t  ModelCallFailureKind,\n    11\t  ModelCallInput,\n    12\t  ModelCallResult,\n    13\t} from \"./types.js\";\n    14\t\n    15\texport const FAILURE_CLASSIFICATION: Record<ModelCallFailureKind, { retryable: boolean }> = {\n    16\t  rate_limit: { retryable: true },\n    17\t  timeout: { retryable: true },\n    18\t  network: { retryable: true },\n    19\t  empty_output: { retryable: true },\n    20\t  other: { retryable: true },\n    21\t  auth: { retryable: false },\n    22\t  invalid_request: { retryable: false },\n    23\t};\n    24\t\n    25\t/** try/catch + timeout race around the host function (AC-3.3, DD-6). */\n    26\texport async function safeCall(\n    27\t  call: ModelCall,\n    28\t  input: ModelCallInput,\n    29\t  timeoutMs: number,\n    30\t): Promise<ModelCallResult> {\n    31\t  let timer: NodeJS.Timeout | undefined;\n    32\t  const timeout = new Promise<ModelCallResult>((resolve) => {\n    33\t    timer = setTimeout(() => {\n    34\t      resolve({\n    35\t        ok: false,\n    36\t        kind: \"timeout\",\n    37\t        message: `model call timed out after ${String(timeoutMs)}ms`,\n    38\t      });\n    39\t    }, timeoutMs);\n    40\t  });\n    41\t  // The async wrapper folds synchronous throws into the same rejection path —\n    42\t  // the host's promise contract is not trusted (AC-3.3).\n    43\t  const attempt = (async (): Promise<ModelCallResult> => {\n    44\t    try {\n    45\t      return await call(input);\n    46\t    } catch (cause) {\n    47\t      return { ok: false, kind: \"other\", message: String(cause) };\n    48\t    }\n    49\t  })();\n    50\t  try {\n    51\t    // A host that resolves after the race resolves into nothing (DD-6).\n    52\t    return await Promise.race([attempt, timeout]);\n    53\t  } finally {\n    54\t    clearTimeout(timer);\n    55\t  }\n    56\t}\n","exit_code":0,"status":"completed"}}

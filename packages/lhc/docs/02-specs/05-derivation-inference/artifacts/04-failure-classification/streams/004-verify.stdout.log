s file\\\\\\\" is absolute; an orphan file from a crash between the writes is\\\\n84\\\\t// documented harmless (design decision 2).\\\\n85\\\\texport async function newThread(\\\\n86\\\\t  input: NewThreadInput,\\\\n87\\\\t): Promise<OpResult<{ threadId: string; filePath: string }>> {\\\\n88\\\\t  // Guard before any storage touch: an empty/blank path would otherwise open\\\\n89\\\\t  // a temp database and register a thread with no durable file (the no-row-\\\\n90\\\\t  // without-file invariant below depends on the path naming a real file).\\\\n91\\\\t  if (isBlankPath(input.filePath)) {\\\\n92\\\\t    return invalidThreadRef(\\\\\\\"filePath must be a non-empty path; received a blank string\\\\\\\");\\\\n93\\\\t  }\\\\n94\\\\t  if (existsSync(input.filePath)) {\\\\n95\\\\t    return {\\\\n96\\\\t      ok: false,\\\\n97\\\\t      error: {\\\\n98\\\\t        errorClass: \\\\\\\"caller_error\\\\\\\",\\\\n99\\\\t        code: \\\\\\\"path_exists\\\\\\\",\\\\n100\\\\t        reason: `a file already exists at ${input.filePath}`,\\\\n101\\\\t      },\\\\n102\\\\t    };\\\\n103\\\\t  }\\\\n104\\\\t\\\\n105\\\\t  const threadId = generateThreadId();\\\\n106\\\\t  const createdAt = new Date().toISOString();\\\\n107\\\\t\\\\n108\\\\t  try {\\\\n109\\\\t    createThreadFile(input.filePath, threadId, createdAt);\\\\n110\\\\t  } catch (cause) {\\\\n111\\\\t    deleteThreadFile(input.filePath);\\\\n112\\\\t    return storageFailure(`thread file creation failed: ${detail(cause)}`);\\\\n113\\\\t  }\\\\n114\\\\t\\\\n115\\\\t  let registry;\\\\n116\\\\t  try {\\\\n117\\\\t    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\\\\n118\\\\t    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\\\\n119\\\\t    if (input.title !== undefined) row.title = input.title;\\\\n120\\\\t    insertThreadRow(registry, row);\\\\n121\\\\t  } catch (cause) {\\\\n122\\\\t    deleteThreadFile(input.filePath);\\\\n123\\\\t    return storageFailure(`registry insert failed: ${detail(cause)}`);\\\\n124\\\\t  } finally {\\\\n125\\\\t    registry?.close();\\\\n126\\\\t  }\\\\n127\\\\t\\\\n128\\\\t  return { ok: true, value: { threadId, filePath: input.filePath } };\\\\n129\\\\t}\\\\n130\\\\t\\\\n131\\\\texport async function resolve(input: {\\\\n132\\\\t  threadId: string;\\\\n133\\\\t  registryPath?: string;\\\\n134\\\\t}): Promise<OpResult<ThreadInfo>> {\\\\n135\\\\t  let registry;\\\\n136\\\\t  try {\\\\n137\\\\t    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\\\\n138\\\\t    if (registry === null) return threadNotFound(input.threadId);\\\\n139\\\\t    const row = selectThreadRow(registry, input.threadId);\\\\n140\\\\t    if (row === undefined) return threadNotFound(input.threadId);\\\\n141\\\\t    return { ok: true, value: toThreadInfo(row) };\\\\n142\\\\t  } catch (cause) {\\\\n143\\\\t    return storageFailure(`registry read failed: ${detail(cause)}`);\\\\n144\\\\t  } finally {\\\\n145\\\\t    registry?.close();\\\\n146\\\\t  }\\\\n147\\\\t}\\\\n148\\\\t\\\\n149\\\\texport async function listThreads(input?: {\\\\n150\\\\t  registryPath?: string;\\\\n151\\\\t}): Promise<OpResult<ThreadInfo[]>> {\\\\n152\\\\t  let registry;\\\\n153\\\\t  try {\\\\n154\\\\t    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\\\\n155\\\\t    if (registry === null) return { ok: true, value: [] };\\\\n156\\\\t    return { ok: true, value: selectAllThreadRows(registry).map(toThreadInfo) };\\\\n157\\\\t  } catch (cause) {\\\\n158\\\\t    return storageFailure(`registry read failed: ${detail(cause)}`);\\\\n159\\\\t  } finally {\\\\n160\\\\t    registry?.close();\\\\n161\\\\t  }\\\\n162\\\\t}\\\\n163\\\\t\\\\n164\\\\t// The single interpreter of thread references: { threadId } resolves to a\\\\n165\\\\t// path through the registry, { filePath } passes through untouched. No other\\\\n166\\\\t// code ever reads a thread reference.\\\\n167\\\\texport async function resolveThreadRef(\\\\n168\
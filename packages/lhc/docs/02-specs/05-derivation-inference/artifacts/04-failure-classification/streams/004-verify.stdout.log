{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/inference/adapter.ts | sed -n '35,105p'\"","aggregated_output":"    35\t  const head = Math.ceil(keep / 2);\n    36\t  const tail = keep - head;\n    37\t  return content.slice(0, head) + marker + (tail > 0 ? content.slice(content.length - tail) : \"\");\n    38\t}\n    39\t\n    40\t// Failure mapping (DD-3): the queue consumes `retryable` exactly as it always\n    41\t// has, and the reason string is machine-readable by the established\n    42\t// code-before-first-colon convention. Retryable failures lead with\n    43\t// `provider_failure` — the code Epic 02 has always landed on exhausted forms\n    44\t// (the queue copies the provider's reason verbatim at exhaustion, AC-3.2) —\n    45\t// with the failure kind named next; terminal kinds lead with the kind itself\n    46\t// and land failed immediately.\n    47\tfunction classifiedFailure(kind: ModelCallFailureKind, message: string): ProviderResult {\n    48\t  const { retryable } = FAILURE_CLASSIFICATION[kind];\n    49\t  const detail = message === \"\" ? kind : `${kind}: ${message}`;\n    50\t  return {\n    51\t    ok: false,\n    52\t    retryable,\n    53\t    reason: retryable ? `provider_failure: ${detail}` : detail,\n    54\t  };\n    55\t}\n    56\t\n    57\texport function createInferenceProvider(config: ResolvedInferenceConfig): DerivationProvider {\n    58\t  const callKind = async (kind: FormKind, input: unknown): Promise<ProviderResult> => {\n    59\t    const assignment = config.assignments[kind];\n    60\t    // Construction validated the name (AC-1.3); a miss here is registry\n    61\t    // drift after construction and is terminal, never retried into.\n    62\t    const template = PROMPT_REGISTRY[assignment.prompt] as PromptTemplate<unknown> | undefined;\n    63\t    if (template === undefined) {\n    64\t      return classifiedFailure(\n    65\t        \"invalid_request\",\n    66\t        `prompt template \"${assignment.prompt}\" not in registry`,\n    67\t      );\n    68\t    }\n    69\t    const messages = template.render(input);\n    70\t    // safeCall contains the host (AC-3.3, DD-6): thrown exceptions arrive as\n    71\t    // structured `other` failures and a hung function loses the timeout race\n    72\t    // as `timeout` — both flow through the same classification below.\n    73\t    const result = await safeCall(\n    74\t      config.call,\n    75\t      { provider: assignment.provider, model: assignment.model, messages },\n    76\t      config.timeoutMs,\n    77\t    );\n    78\t    if (!result.ok) {\n    79\t      return classifiedFailure(result.kind, result.message);\n    80\t    }\n    81\t    // Shaping: surrounding whitespace never becomes form content — and a\n    82\t    // model that returned nothing but whitespace has not produced a\n    83\t    // derivation (AC-2.4): a classified retryable failure, never a ready\n    84\t    // form. `empty_output` is adapter-generated; hosts never return it.\n    85\t    const text = result.text.trim();\n    86\t    if (text === \"\") {\n    87\t      return classifiedFailure(\"empty_output\", \"model returned empty or whitespace-only text\");\n    88\t    }\n    89\t    // Provenance is the assignment's three config-known strings, copied —\n    90\t    // never authored from model output (DD-4).\n    91\t    return {\n    92\t      ok: true,\n    93\t      text,\n    94\t      provenance: {\n    95\t        provider: assignment.provider,\n    96\t        model: assignment.model,\n    97\t        prompt: assignment.prompt,\n    98\t      },\n    99\t    };\n   100\t  };\n   101\t\n   102\t  return {\n   103\t    smoothPrompt: (i) => callKind(\"smoothed_prompt\", i),\n   104\t    summarizeToolCall: (i) => callKind(\"tool_call_summary\", i),\n   105\t    summarizeToolResult: (i) =>\n","exit_code":0,"status":"completed"}}

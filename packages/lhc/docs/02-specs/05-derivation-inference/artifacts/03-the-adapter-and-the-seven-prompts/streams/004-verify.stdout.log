turn naming the turn and both turns-delete paths, empty chunks drop their summary forms with no rebuild queued, and the deleted-read filter covers message reads, turn reads, membership, chunk member loads, and composition inputs (proven by captureInputs in TC-6.5). Completed the unfinished tail: rebuilt dist (parity tests had failed only on a stale build), recorded the two new test files in the red-manifest per project convention, and added the new process-suite file to vitest.config.ts's exclusion list so it runs under verify-all only. Both gates green.\\\\\\\",\\\\\\\"changedFiles\\\\\\\":[{\\\\\\\"path\\\\\\\":\\\\\\\"packages/lhc/src/domains/messages/index.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"deleteMessage operation (validation incl. prompt protection, deleted_at stamp, delete cascade) and applyTurnDeleteCascade cross-domain surface for turns.deleteTurn (DD-8 one cascade, two callers)\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"packages/lhc/src/domains/messages/internal/cascade.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"drop-vs-clear parameterized core cascade; cascadeMessageDelete and cascadeTurnDelete entry points; empty-chunk drop path; supersede of queued items against dropped subjects\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"packages/lhc/src/domains/messages/internal/store.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"markMessageDeleted/markTurnMessagesDeleted tombstone writes (live-row scoped); initiatesTurn on the validation read; deleted-read filter on readMessages\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"packages/lhc/src/domains/turns/index.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"deleteTurn operation: filtered validation, turn-row stamp, shared cascade via the messages domain's public surface\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"packages/lhc/src/domains/turns/internal/store.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"readMutableTurn filtered validation read; markTurnDeleted; deleted-read filters on readTurns turn rows and membership\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"packages/lhc/src/cli/turns-mutate.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"NEW per tech design §Placement: lhc turns delete command\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"packages/lhc/src/cli/messages-mutate.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"lhc messages delete command\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"packages/lhc/src/cli/index.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"messages delete / turns delete dispatch, --message/--turn flag parsing, usage text\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"packages/lhc/test/mutations-delete.test.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"NEW: TC-6.1 through TC-6.7 plus live-row-walk and background-mode production-path tests\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"packages/lhc/test/cli-process-mutations-delete.test.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"NEW: TC-6.8 SDK/CLI parity twins plus CLI refusal parity (process suite)\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"packages/lhc/test/red-manifest.json\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"recorded the two new Story 6 test files (hash-lock convention from prior stories)\\\\\\\"},{\\\\\\\"path\\\\\\\":\\\\\\\"packages/lhc/vitest.config.ts\\\\\\\",\\\\\\\"reason\\\\\\\":\\\\\\\"fix found in self-review: new process-suite file added to the LHC_PROCESS_SUITE exclusion list so it runs under verify-all only, matching every other cli-process file\\\\\\\"}],\\\\\\\"tests\\\\\\\":{\\\\\\\"added\\\\\\\":[\\\\\\\"test/mutations-delete.test.ts\\\\\\\",\\\\\\\"test/cli-process-mutations-delete.test.ts\\\\\\\"],\\\\\\\"modified\\\\\\\":[],\\\\\\\"removed\\\\\\\":[],\\\\\\\"totalAfterStory\\\\\\\":231,\\\\\\\"deltaFromPriorBaseline\\\\\\\":13},\\\\\\\"gatesRun\\\\\\\":[{\\\\\\\"command\\\\\\\":\\\\\\\"pnpm vitest run test/mutations-delete.test.ts\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"LHC_PROCESS_SUITE=1 pnpm vitest run test/cli-process-mutations-delete.test.ts\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"pnpm run green-verify\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"},{\\\\\\\"command\\\\\\\":\\\\\\\"pnpm run verify-all\\\\\\\",\\\\\\\"result\\\\\\\":\\\\\\\"pass\\\\\\\"}],\\\\\\\"selfReview\\\\\\\":{\\\\\\\"passesRun\\\\\\\":0,\\\\\\\"findingsFixed\\\\\\\":[\\\\\\\"TC-6.8 parity tests failed against a stale dist/cli.js lacking the delete subcommands — environmental, not code; resolved by build (red-verify always rebuilds, so the gates were never at risk)\\\\\\\",\\\\\\\"test/cli-process-mutations-delete.test.ts was absent from vitest.config.ts's process-suite exclusion list, so it ran inside plain verify/green-verify against the build artifact instead of under verify-all only — added to the list; green-verify now counts 204 (in-process only) and verify-all 231\\\\\\\",\\\\\\\"the two new test files were not yet recorded in test/red-manifest.json — recorded per the convention every prior story followed (immutability gate now pins 27 files)\\\\\\\"],\\\\\\\"findingsSurfaced\\\\\\\":[\\\\\\\"handler source reads in messages/internal/forms.ts (message row/blocks loaded at derivation time) carry no deleted_at filter — deliberate: they are not in §Mechanics' site list, and a handler racing a delete is already harmless because the dropped form row makes its UPDATE-only completion discard as stale_discarded, with queued items superseded by the cascade; composition and chunk-summary input reads (the sites that matter) are filtered and proven by TC-6.2/TC-6.5 capture assertions\\\\\\\",\\\\\\\"cascade chainSubjects walk is deliberately unfiltered (commented in code): it runs after the delete stamps its subject, and the chain above a just-deleted record is exactly what must still cascade\\\\\\\"]},\\\\\\\"openQuestions\\\\\\\":[],\\\\\\\"specDeviations\\\\\\\":[\\\\\\\"TC-6.1–6.7 live in new test/mutations-delete.test.ts rather than the test plan's test/mutations.test.ts, and TC-6.8 in new test/cli-process-mutations-delete.test.ts rather than cli-process-work.test.ts — both target files are hash-locked in the red manifest by earlier stories; new-file-per-story is the approved Story 4/5 precedent (green may add files, not edit Red's)\\\\\\\",\\\\\\\"CLI flags spelled --message / --turn with --message-id / --turn-id accepted as aliases — extends Story 5's approved --message/--message-id alias deviation to the delete commands\\\\\\\"],\\\\\\\"recommendedNextStep\\\\\\\":\\\\\\\"Hand to the story verifier: all TC-6.x and architecture-risk tests green, both gates pass at 204/231 (baseline 218 → 231, +13), DoD items checked (event read-back byte-stable in every delete variant, no unfiltered read path on the §Mechanics site list, CLI parity).\\\\\\\"},\\\\\\\"errors\\\\\\\":[],\\\\\\\"warnings\\\\\\\":[],\\\\\\\"artifacts\\\\\\\":[{\\\\\\\"kind\\\\\\\":\\\\\\\"result-envelope\\\\\\\",\\\\\\\"path\\\\\\\":\\\\\\\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/06-message-turn-delete/005-implementor.json\\\\\\\"}],\\\\\\\"startedAt\\\\\\\":\\\\\\\"2026-06-11T07:47:12.982Z\\\\\\\",\\\\\\\"finishedAt\\\\\\\":\\\\\\\"2026-06-11T07:53:15.257Z\\\\\\\"}\\\\n\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n{\\\"type\\\":\\\"item.started\\\",\\\"item\\\":{\\\"id\\\":\\\"item_35\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"sed -n '1,260p' packages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/06-message-turn-delete/006-verify.json\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":null,\\\"status\\\":\\\"in_progress\\\"}}\\n{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_35\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"sed -n '1,260p' packages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/06-message-turn-delete/006-verify.json\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"\\\",\\\"exit_code\\\":0,\\\"status\\\":\\\"completed\\\"}}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./packages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/00-foundation/streams/004-verify.stdout.log:71:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_33\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'nl -ba packages/lhc/test/thread-migration.test.ts'\",\"aggregated_output\":\"     1\\t// F-03-001: an existing valid Story 2 thread file (user_version=1, only\\n     2\\t// thread_metadata/event tables) must be migrated to the current schema before\\n     3\\t// any Story 3 message write or read. The fixture reproduces the accepted\\n     4\\t// Story 2 on-disk layout exactly; the assertions go through the production\\n     5\\t// entry points (messageEvents, listMessages, listEvents) plus below-SDK\\n     6\\t// schema-version reads.\\n     7\\t// F-03-002: the lazy opener must reject existing files that are not thread\\n     8\\t// files without creating lhc schema or bumping user_version on them.\\n     9\\timport { readFileSync, writeFileSync } from \\\"node:fs\\\";\\n    10\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n    11\\timport { intakeStream, messages, turns } from \\\"../src/index.js\\\";\\n    12\\timport {\\n    13\\t  legacyEpic01ThreadFile,\\n    14\\t  legacyStory2ThreadFile,\\n    15\\t  openRaw,\\n    16\\t  readDerivedForms,\\n    17\\t  schemaVersionOf,\\n    18\\t  tempStore,\\n    19\\t  validEvent,\\n    20\\t  type TempStore,\\n    21\\t} from \\\"./fixtures/index.js\\\";\\n    22\\t\\n    23\\tlet store: TempStore;\\n    24\\tbeforeEach(() => {\\n    25\\t  store = tempStore();\\n    26\\t});\\n    27\\tafterEach(() => {\\n    28\\t  store.cleanup();\\n    29\\t});\\n    30\\t\\n    31\\tconst legacyEvent = {\\n    32\\t  eventOrder: 1,\\n    33\\t  eventKind: \\\"user_prompt\\\",\\n    34\\t  idempotencyKey: \\\"legacy-key-1\\\",\\n    35\\t  actor: \\\"legacy-actor\\\",\\n    36\\t  harness: \\\"legacy-harness\\\",\\n    37\\t  payload: { text: \\\"recorded before story 3 shipped\\\" },\\n    38\\t  recordedAt: \\\"2026-06-01T00:00:01.000Z\\\",\\n    39\\t};\\n    40\\t\\n    41\\tdescribe(\\\"F-03-001: Story 2 thread files migrate before message write/read\\\", () => {\\n    42\\t  it(\\\"messageEvents on a Story 2 file upgrades the schema, keeps the legacy record intact, and projects the new events\\\", async () => {\\n    43\\t    const filePath = store.threadPath();\\n    44\\t    legacyStory2ThreadFile(filePath, \\\"th_legacy01\\\", [legacyEvent]);\\n    45\\t    expect(schemaVersionOf(filePath)).toBe(1);\\n    46\\t\\n    47\\t    const result = await intakeStream.messageEvents({ filePath }, [\\n    48\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"answered after upgrade\\\" } }),\\n    49\\t      validEvent(\\\"turn_end\\\"),\\n    50\\t    ]);\\n    51\\t    expect(result.ok).toBe(true);\\n    52\\t    if (!result.ok) return;\\n    53\\t    expect(result.value.events.map((entry) => entry.outcome)).toEqual([\\n    54\\t      \\\"recorded\\\",\\n    55\\t      \\\"recorded\\\",\\n    56\\t    ]);\\n    57\\t    // The order counter continues from the legacy record; the new message id\\n    58\\t    // derives from the continued order.\\n    59\\t    expect(result.value.threadPosition.lastEventOrder).toBe(3);\\n    60\\t    expect(result.value.events[0]!.messageId).toBe(\\\"m2\\\");\\n    61\\t\\n    62\\t    expect(schemaVersionOf(filePath)).toBe(5);\\n    63\\t\\n    64\\t    // The legacy event survives the upgrade byte-for-byte at the SDK level.\\n    65\\t    const events = await intakeStream.listEvents({ filePath });\\n    66\\t    expect(events.ok).toBe(true);\\n    67\\t    if (!events.ok) return;\\n    68\\t    expect(events.value).toHaveLength(3);\\n    69\\t    expect(events.value[0]).toEqual({\\n    70\\t      eventKind: \\\"user_prompt\\\",\\n    71\\t      idempotencyKey: \\\"legacy-key-1\\\",\\n    72\\t      actor: \\\"legacy-actor\\\",\\n    73\\t      harness: \\\"legacy-harness\\\",\\n    74\\t      payload: { text: \\\"recorded before story 3 shipped\\\" },\\n    75\\t      eventOrder: 1,\\n    76\\t      recordedAt: \\\"2026-06-01T00:00:01.000Z\\\",\\n    77\\t    });\\n    78\\t\\n    79\\t    // Projection is intake-time, not retroactive: the new assistant_text\\n    80\\t    // projects; the legacy pre-Story-3 event stays event-only.\\n    81\\t    const projected = await messages.listMessages({ filePath });\\n    82\\t    expect(projected.ok).toBe(true);\\n    83\\t    if (!projected.ok) return;\\n    84\\t    expect(projected.value).toHaveLength(1);\\n    85\\t    expect(projected.value[0]!.messageId).toBe(\\\"m2\\\");\\n    86\\t    expect(projected.value[0]!.sourceEventOrder).toBe(2);\\n    87\\t    expect(projected.value[0]!.blocks).toEqual([\\n    88\\t      { blockType: \\\"text\\\", content: { text: \\\"answered after upgrade\\\" } },\\n    89\\t    ]);\\n    90\\t    expect(projected.value[0]!.tokenEstimate).toBeGreaterThan(0);\\n    91\\t  });\\n    92\\t\\n    93\\t  it(\\\"listMessages on an untouched Story 2 file migrates on read and returns an empty list\\\", async () => {\\n    94\\t    const filePath = store.threadPath();\\n    95\\t    legacyStory2ThreadFile(filePath, \\\"th_legacy02\\\", [legacyEvent]);\\n    96\\t    expect(schemaVersionOf(filePath)).toBe(1);\\n    97\\t\\n    98\\t    const projected = await messages.listMessages({ filePath });\\n    99\\t    expect(projected.ok).toBe(true);\\n   100\\t    if (!projected.ok) return;\\n   101\\t    expect(projected.value).toEqual([]);\\n   102\\t\\n   103\\t    expect(schemaVersionOf(filePath)).toBe(5);\\n   104\\t\\n   105\\t    // The read-path upgrade changed no record content.\\n   106\\t    const events = await intakeStream.listEvents({ filePath });\\n   107\\t    expect(events.ok).toBe(true);\\n   108\\t    if (!events.ok) return;\\n   109\\t    expect(events.value).toHaveLength(1);\\n   110\\t    expect(events.value[0]!.idempotencyKey).toBe(\\\"legacy-key-1\\\");\\n   111\\t  });\\n   112\\t\\n   113\\t  it(\\\"idempotency keys recorded under Story 2 still skip after the upgrade\\\", async () => {\\n   114\\t    const filePath = store.threadPath();\\n   115\\t    legacyStory2ThreadFile(filePath, \\\"th_legacy03\\\", [legacyEvent]);\\n   116\\t\\n   117\\t    const resend = await intakeStream.messageEvents({ filePath }, [\\n   118\\t      validEvent(\\\"user_prompt\\\", {\\n   119\\t        idempotencyKey: \\\"legacy-key-1\\\",\\n   120\\t        payload: { text: \\\"resent after upgrade\\\" },\\n   121\\t      }),\\n   122\\t    ]);\\n   123\\t    expect(resend.ok).toBe(true);\\n   124\\t    if (!resend.ok) return;\\n   125\\t    expect(resend.value.events[0]).toEqual({\\n   126\\t      idempotencyKey: \\\"legacy-key-1\\\",\\n   127\\t      outcome: \\\"skipped\\\",\\n   128\\t      skipReason: \\\"duplicate_idempotency_key\\\",\\n   129\\t    });\\n   130\\t\\n   131\\t    // No message was created for the skipped resend of the legacy event.\\n   132\\t    const projected = await messages.listMessages({ filePath });\\n   133\\t    expect(projected.ok).toBe(true);\\n   134\\t    if (!projected.ok) return;\\n   135\\t    expect(projected.value).toEqual([]);\\n   136\\t  });\\n   137\\t});\\n   138\\t\\n   139\\t// Tables present in a file, by name — asserts what schema (if any) the\\n   140\\t// rejected open left behind.\\n   141\\tfunction tableNames(filePath: string): string[] {\\n   142\\t  const db = openRaw(filePath);\\n   143\\t  try {\\n   144\\t    const rows = db\\n   145\\t      .prepare(\\\"SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name\\\")\\n   146\\t      .all() as unknown as Array<{ name: string }>;\\n   147\\t    return rows.map((row) => row.name);\\n   148\\t  } finally {\\n   149\\t    db.close();\\n   150\\t  }\\n   151\\t}\\n   152\\t\\n   153\\tdescribe(\\\"F-03-002: non-thread files are rejected, not adopted\\\", () => {\\n   154\\t  it(\\\"listMessages against an existing empty database file fails without creating schema or bumping user_version\\\", async () => {\\n   155\\t    const filePath = store.threadPath();\\n   156\\t    writeFileSync(filePath, \\\"\\\"); // exists, zero bytes — a valid empty SQLite database\\n   157\\t\\n   158\\t    const result = await messages.listMessages({ filePath });\\n   159\\t    expect(result.ok).toBe(false);\\n   160\\t    if (result.ok) return;\\n   161\\t    expect(result.error.errorClass).toBe(\\\"caller_error\\\");\\n   162\\t    expect(result.error.code).toBe(\\\"thread_not_found\\\");\\n   163\\t    expect(result.error.reason).toContain(\\\"not an lhc thread file\\\");\\n   164\\t\\n   165\\t    expect(schemaVersionOf(filePath)).toBe(0);\\n   166\\t    expect(tableNames(filePath)).toEqual([]);\\n   167\\t  });\\n   168\\t\\n   169\\t  it(\\\"messageEvents against an unrelated SQLite database fails and leaves its content untouched\\\", async () => {\\n   170\\t    const filePath = store.threadPath();\\n   171\\t    const foreign = openRaw(filePath);\\n   172\\t    try {\\n   173\\t      foreign.exec(\\\"CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT NOT NULL);\\\");\\n   174\\t      foreign.prepare(\\\"INSERT INTO notes (id, body) VALUES (1, ?)\\\").run(\\\"not lhc data\\\");\\n   175\\t    } finally {\\n   176\\t      foreign.close();\\n   177\\t    }\\n   178\\t\\n   179\\t    const result = await intakeStream.messageEvents({ filePath }, [validEvent(\\\"user_prompt\\\")]);\\n   180\\t    expect(result.ok).toBe(false);\\n   181\\t    if (result.ok) return;\\n   182\\t    expect(result.error.errorClass).toBe(\\\"caller_error\\\");\\n   183\\t    expect(result.error.code).toBe(\\\"thread_not_found\\\");\\n   184\\t    expect(result.error.reason).toContain(\\\"not an lhc thread file\\\");\\n   185\\t\\n   186\\t    // No lhc tables were created, the version was not bumped, and the\\n   187\\t    // foreign data is intact.\\n   188\\t    expect(schemaVersionOf(filePath)).toBe(0);\\n   189\\t    expect(tableNames(filePath)).toEqual([\\\"notes\\\"]);\\n   190\\t    const db = openRaw(filePath);\\n   191\\t    try {\\n   192\\t      const row = db.prepare(\\\"SELECT body FROM notes WHERE id = 1\\\").get() as unknown as {\\n   193\\t        body: string;\\n   194\\t      };\\n   195\\t      expect(row.body).toBe(\\\"not lhc data\\\");\\n   196\\t    } finally {\\n   197\\t      db.close();\\n   198\\t    }\\n   199\\t  });\\n   200\\t\\n   201\\t  it(\\\"a non-SQLite file is rejected as a caller error with its bytes unchanged\\\", async () => {\\n   202\\t    const filePath = store.threadPath();\\n   203\\t    const original = \\\"just some text, definitely not a database\\\\n\\\";\\n   204\\t    writeFileSync(filePath, original);\\n   205\\t\\n   206\\t    const listed = await messages.listMessages({ filePath });\\n   207\\t    expect(listed.ok).toBe(false);\\n   208\\t    if (listed.ok) return;\\n   209\\t    expect(listed.error.errorClass).toBe(\\\"caller_error\\\");\\n   210\\t    expect(listed.error.code).toBe(\\\"thread_not_found\\\");\\n   211\\t\\n   212\\t    const batched = await intakeStream.messageEvents({ filePath }, [validEvent(\\\"user_prompt\\\")]);\\n   213\\t    expect(batched.ok).toBe(false);\\n   214\\t    if (batched.ok) return;\\n   215\\t    expect(batched.error.errorClass).toBe(\\\"caller_error\\\");\\n   216\\t    expect(batched.error.code).toBe(\\\"thread_not_found\\\");\\n   217\\t\\n   218\\t    expect(readFileSync(filePath, \\\"utf8\\\")).toBe(original);\\n   219\\t  });\\n   220\\t});\\n   221\\t\\n   222\\t// Story 0 (Epic 02), FC-0.5 + architecture risk \\\"migration on live data\\\":\\n   223\\t// v5 applies in place to a populated Epic 01 file — existing rows intact,\\n   224\\t// new columns defaulted, the F-02 backfill creating pending derived_form\\n   225\\t// rows for live queued items. A fresh-file migration test would pass while\\n   226\\t// breaking real threads; this one runs over real Epic 01 data.\\n   227\\tdescribe(\\\"FC-0.5: migration v5 over a populated Epic 01 thread file\\\", () => {\\n   228\\t  it(\\\"upgrades in place: records intact, queue columns defaulted, F-02 backfill pending rows present\\\", async () => {\\n   229\\t    const filePath = store.threadPath();\\n   230\\t    legacyEpic01ThreadFile(filePath, \\\"th_epic01\\\");\\n   231\\t    expect(schemaVersionOf(filePath)).toBe(4);\\n   232\\t\\n   233\\t    // Any SDK read migrates lazily; the read itself must succeed post-v5.\\n   234\\t    const projected = await messages.listMessages({ filePath });\\n   235\\t    expect(projected.ok).toBe(true);\\n   236\\t    if (!projected.ok) return;\\n   237\\t    expect(schemaVersionOf(filePath)).toBe(5);\\n   238\\t\\n   239\\t    // Existing records intact through the production read surfaces.\\n   240\\t    expect(projected.value.map((m) => m.messageId)).toEqual([\\\"m1\\\", \\\"m2\\\", \\\"m3\\\"]);\\n   241\\t    const events = await intakeStream.listEvents({ filePath });\\n   242\\t    expect(events.ok).toBe(true);\\n   243\\t    if (!events.ok) return;\\n   244\\t    expect(events.value).toHaveLength(4);\\n   245\\t    const turnRecords = await turns.listTurns({ filePath });\\n   246\\t    expect(turnRecords.ok).toBe(true);\\n   247\\t    if (!turnRecords.ok) return;\\n   248\\t    expect(turnRecords.value).toEqual([\\n   249\\t      {\\n   250\\t        turnId: \\\"t1\\\",\\n   251\\t        status: \\\"closed\\\",\\n   252\\t        memberMessageIds: [\\\"m1\\\", \\\"m2\\\", \\\"m3\\\"],\\n   253\\t        openedAtEventOrder: 1,\\n   254\\t        closedAtEventOrder: 4,\\n   255\\t      },\\n   256\\t    ]);\\n   257\\t\\n   258\\t    // Work rows survive with their pre-v5 ids; the queue's mechanical\\n   259\\t    // columns exist and default to not-claimed / immediately eligible.\\n   260\\t    const db = openRaw(filePath);\\n   261\\t    try {\\n   262\\t      const items = db\\n   263\\t        .prepare(\\n   264\\t          `SELECT work_item_id, status, attempts, last_error, claimed_at,\\n   265\\t                  claim_expires_at, eligible_at, payload\\n   266\\t           FROM work_item ORDER BY work_item_id`,\\n   267\\t        )\\n   268\\t        .all() as unknown as Array<Record<string, unknown>>;\\n   269\\t      expect(items.map((row) => row.work_item_id)).toEqual([\\n   270\\t        \\\"w-m1-prompt_smoothing\\\",\\n   271\\t        \\\"w-m3-tool_result_summary\\\",\\n   272\\t        \\\"w-t1-turn_derivation\\\",\\n   273\\t      ]);\\n   274\\t      for (const row of items) {\\n   275\\t        expect(row.status).toBe(\\\"queued\\\");\\n   276\\t        expect(Number(row.attempts)).toBe(0);\\n   277\\t        expect(row.last_error).toBeNull();\\n   278\\t        expect(row.claimed_at).toBeNull();\\n   279\\t        expect(row.claim_expires_at).toBeNull();\\n   280\\t        expect(row.eligible_at).toBeNull();\\n   281\\t        expect(row.payload).toBeNull();\\n   282\\t      }\\n   283\\t      // The epic's other v5 surfaces exist (schema ships whole): chunk\\n   284\\t      // tables empty, deleted_at stamps present and null.\\n   285\\t      const chunkCount = db.prepare(\\\"SELECT COUNT(*) AS n FROM chunk\\\").get() as { n: number | bigint };\\n   286\\t      expect(Number(chunkCount.n)).toBe(0);\\n   287\\t      const deleted = db\\n   288\\t        .prepare(\\\"SELECT COUNT(*) AS n FROM message WHERE deleted_at IS NOT NULL\\\")\\n   289\\t        .get() as { n: number | bigint };\\n   290\\t      expect(Number(deleted.n)).toBe(0);\\n   291\\t    } finally {\\n   292\\t      db.close();\\n   293\\t    }\\n   294\\t\\n   295\\t    // F-02 backfill: one pending row per live queued item, mapped per kind —\\n   296\\t    // turn_derivation fans out to both turn forms; all at source version 1.\\n   297\\t    expect(\\n   298\\t      readDerivedForms(filePath).map(({ subjectKind, subjectId, form, state, sourceVersion }) => ({\\n   299\\t        subjectKind,\\n   300\\t        subjectId,\\n   301\\t        form,\\n   302\\t        state,\\n   303\\t        sourceVersion,\\n   304\\t      })),\\n   305\\t    ).toEqual([\\n   306\\t      { subjectKind: \\\"message\\\", subjectId: \\\"m1\\\", form: \\\"smoothed_prompt\\\", state: \\\"pending\\\", sourceVersion: 1 },\\n   307\\t      { subjectKind: \\\"message\\\", subjectId: \\\"m3\\\", form: \\\"tool_result_summary\\\", state: \\\"pending\\\", sourceVersion: 1 },\\n   308\\t      { subjectKind: \\\"turn\\\", subjectId: \\\"t1\\\", form: \\\"lower_band_projection\\\", state: \\\"pending\\\", sourceVersion: 1 },\\n   309\\t      { subjectKind: \\\"turn\\\", subjectId: \\\"t1\\\", form: \\\"turn_rendering\\\", state: \\\"pending\\\", sourceVersion: 1 },\\n   310\\t    ]);\\n   311\\t\\n   312\\t    // The migrated file keeps working through the Epic 01 write path: a new\\n   313\\t    // batch records, projects, and queues against the v5 schema.\\n   314\\t    const batch = await intakeStream.messageEvents({ filePath }, [\\n   315\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"recorded after the upgrade\\\" } }),\\n   316\\t      validEvent(\\\"turn_end\\\"),\\n   317\\t    ]);\\n   318\\t    expect(batch.ok).toBe(true);\\n   319\\t    if (!batch.ok) return;\\n   320\\t    expect(batch.value.events.map((entry) => entry.outcome)).toEqual([\\\"recorded\\\", \\\"recorded\\\"]);\\n   321\\t    expect(batch.value.queuedWork.map((item) => item.workItemId)).toEqual([\\n   322\\t      \\\"w-m5-prompt_smoothing-v1\\\",\\n   323\\t      \\\"w-t2-turn_derivation-v1\\\",\\n   324\\t    ]);\\n   325\\t  });\\n   326\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./packages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/00-foundation/streams/004-verify.stdout.log:76:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_36\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,500p' packages/lhc/test/work-queue.test.ts | nl -ba\\\"\",\"aggregated_output\":\"     1\\t// Story 5 (Chunk 5): derivation work queueing. TC-2.6 (complete batch\\n     2\\t// result), TC-2.7/TC-2.9 (message-owned work and its kind gate), the work\\n     3\\t// halves of TC-3.3/TC-3.6 (Story 4's named debt, paid here), TC-3.8's\\n     4\\t// two-work-items assertion, TC-5.4's no-work-item clause, and the two\\n     5\\t// architecture-risk regressions: restart survival extended to work items and\\n     6\\t// the complete-surface rollback. Work items are asserted through the owning\\n     7\\t// domains' listQueuedWork read-back and openRaw — never through the batch\\n     8\\t// result alone. The work-queue util has no public SDK surface; everything\\n     9\\t// here enters through the SDK or the in-process CLI.\\n    10\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n    11\\timport {\\n    12\\t  intakeStream,\\n    13\\t  messages,\\n    14\\t  runCli,\\n    15\\t  threads,\\n    16\\t  turns,\\n    17\\t  type MessageEventInput,\\n    18\\t  type WorkItemRecord,\\n    19\\t} from \\\"../src/index.js\\\";\\n    20\\timport {\\n    21\\t  openRaw,\\n    22\\t  setIntakeClock,\\n    23\\t  tempStore,\\n    24\\t  validEvent,\\n    25\\t  type TempStore,\\n    26\\t} from \\\"./fixtures/index.js\\\";\\n    27\\t\\n    28\\tlet store: TempStore;\\n    29\\tbeforeEach(() => {\\n    30\\t  store = tempStore();\\n    31\\t});\\n    32\\tafterEach(() => {\\n    33\\t  store.cleanup();\\n    34\\t  setIntakeClock(null);\\n    35\\t});\\n    36\\t\\n    37\\tasync function createThread(): Promise<string> {\\n    38\\t  const filePath = store.threadPath();\\n    39\\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\\n    40\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n    41\\t  return filePath;\\n    42\\t}\\n    43\\t\\n    44\\tasync function send(filePath: string, batch: MessageEventInput[]) {\\n    45\\t  const result = await intakeStream.messageEvents({ filePath }, batch);\\n    46\\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\\n    47\\t  return result.value;\\n    48\\t}\\n    49\\t\\n    50\\tasync function queuedFor(\\n    51\\t  filePath: string,\\n    52\\t  owner: \\\"messages\\\" | \\\"turns\\\",\\n    53\\t): Promise<WorkItemRecord[]> {\\n    54\\t  const result =\\n    55\\t    owner === \\\"messages\\\"\\n    56\\t      ? await messages.listQueuedWork({ filePath })\\n    57\\t      : await turns.listQueuedWork({ filePath });\\n    58\\t  if (!result.ok) throw new Error(`queued-work read-back failed: ${result.error.reason}`);\\n    59\\t  return result.value;\\n    60\\t}\\n    61\\t\\n    62\\t// Below-SDK count of durable work-item rows: the batch result alone is not\\n    63\\t// proof of durability (anti-shim requirement).\\n    64\\tfunction rawWorkItemCount(filePath: string): number {\\n    65\\t  const db = openRaw(filePath);\\n    66\\t  try {\\n    67\\t    const row = db.prepare(\\\"SELECT COUNT(*) AS n FROM work_item\\\").get() as { n: number | bigint };\\n    68\\t    return Number(row.n);\\n    69\\t  } finally {\\n    70\\t    db.close();\\n    71\\t  }\\n    72\\t}\\n    73\\t\\n    74\\t// Full logical read-back across every record kind the epic owns — the\\n    75\\t// complete-surface rollback regression compares this whole.\\n    76\\tasync function readBack(filePath: string) {\\n    77\\t  const [events, projected, turnRecords, messageWork, turnWork] = await Promise.all([\\n    78\\t    intakeStream.listEvents({ filePath }),\\n    79\\t    messages.listMessages({ filePath }),\\n    80\\t    turns.listTurns({ filePath }),\\n    81\\t    messages.listQueuedWork({ filePath }),\\n    82\\t    turns.listQueuedWork({ filePath }),\\n    83\\t  ]);\\n    84\\t  if (!events.ok || !projected.ok || !turnRecords.ok || !messageWork.ok || !turnWork.ok) {\\n    85\\t    throw new Error(\\\"read-back failed\\\");\\n    86\\t  }\\n    87\\t  return {\\n    88\\t    events: events.value,\\n    89\\t    messages: projected.value,\\n    90\\t    turns: turnRecords.value,\\n    91\\t    messageWork: messageWork.value,\\n    92\\t    turnWork: turnWork.value,\\n    93\\t  };\\n    94\\t}\\n    95\\t\\n    96\\tconst FIXED_INSTANT = \\\"2026-06-10T12:00:00.000Z\\\";\\n    97\\t\\n    98\\tdescribe(\\\"Flow 2 (SDK): message-owned work queueing\\\", () => {\\n    99\\t  it(\\\"TC-2.7: a prompt and a tool result each durably queue their kind, owner messages (AC-2.8)\\\", async () => {\\n   100\\t    setIntakeClock(() => new Date(FIXED_INSTANT));\\n   101\\t    const filePath = await createThread();\\n   102\\t    const result = await send(filePath, [validEvent(\\\"user_prompt\\\"), validEvent(\\\"tool_result\\\")]);\\n   103\\t\\n   104\\t    // The batch result reports both items with full identity.\\n   105\\t    expect(result.queuedWork).toContainEqual({\\n   106\\t      workItemId: \\\"w-m1-prompt_smoothing-v1\\\",\\n   107\\t      owner: \\\"messages\\\",\\n   108\\t      kind: \\\"prompt_smoothing\\\",\\n   109\\t      sourceRef: { messageId: \\\"m1\\\" },\\n   110\\t    });\\n   111\\t    expect(result.queuedWork).toContainEqual({\\n   112\\t      workItemId: \\\"w-m2-tool_result_summary-v1\\\",\\n   113\\t      owner: \\\"messages\\\",\\n   114\\t      kind: \\\"tool_result_summary\\\",\\n   115\\t      sourceRef: { messageId: \\\"m2\\\" },\\n   116\\t    });\\n   117\\t\\n   118\\t    // Durable read-back through the owning domain: deterministic ids, status\\n   119\\t    // queued, queuedAt from the injected clock.\\n   120\\t    expect(await queuedFor(filePath, \\\"messages\\\")).toEqual([\\n   121\\t      {\\n   122\\t        workItemId: \\\"w-m1-prompt_smoothing-v1\\\",\\n   123\\t        owner: \\\"messages\\\",\\n   124\\t        kind: \\\"prompt_smoothing\\\",\\n   125\\t        sourceRef: { messageId: \\\"m1\\\" },\\n   126\\t        status: \\\"queued\\\",\\n   127\\t        queuedAt: FIXED_INSTANT,\\n   128\\t      },\\n   129\\t      {\\n   130\\t        workItemId: \\\"w-m2-tool_result_summary-v1\\\",\\n   131\\t        owner: \\\"messages\\\",\\n   132\\t        kind: \\\"tool_result_summary\\\",\\n   133\\t        sourceRef: { messageId: \\\"m2\\\" },\\n   134\\t        status: \\\"queued\\\",\\n   135\\t        queuedAt: FIXED_INSTANT,\\n   136\\t      },\\n   137\\t    ]);\\n   138\\t\\n   139\\t    // The prompt opened a turn that is still open: no turn-owned work yet,\\n   140\\t    // and each domain reads back only its own items.\\n   141\\t    expect(await queuedFor(filePath, \\\"turns\\\")).toEqual([]);\\n   142\\t    expect(rawWorkItemCount(filePath)).toBe(2);\\n   143\\t  });\\n   144\\t\\n   145\\t  it(\\\"TC-2.9: text, thinking, and note messages queue nothing — the kind gate is exact (AC-2.8)\\\", async () => {\\n   146\\t    const filePath = await createThread();\\n   147\\t    const result = await send(filePath, [\\n   148\\t      validEvent(\\\"assistant_text\\\"),\\n   149\\t      validEvent(\\\"assistant_thinking\\\"),\\n   150\\t      validEvent(\\\"runtime_note\\\"),\\n   151\\t    ]);\\n   152\\t    expect(result.queuedWork).toEqual([]);\\n   153\\t    expect(await queuedFor(filePath, \\\"messages\\\")).toEqual([]);\\n   154\\t    expect(await queuedFor(filePath, \\\"turns\\\")).toEqual([]);\\n   155\\t    expect(rawWorkItemCount(filePath)).toBe(0);\\n   156\\t  });\\n   157\\t\\n   158\\t  it(\\\"TC-2.6: a mixed batch's result is complete — outcomes, messageIds, transitions, queuedWork, position (AC-2.7)\\\", async () => {\\n   159\\t    const filePath = await createThread();\\n   160\\t    const original = validEvent(\\\"user_prompt\\\");\\n   161\\t    await send(filePath, [original]);\\n   162\\t\\n   163\\t    const result = await send(filePath, [\\n   164\\t      original, // duplicate: skipped\\n   165\\t      validEvent(\\\"assistant_text\\\"),\\n   166\\t      validEvent(\\\"turn_end\\\"),\\n   167\\t    ]);\\n   168\\t\\n   169\\t    expect(result.events).toEqual([\\n   170\\t      {\\n   171\\t        idempotencyKey: original.idempotencyKey,\\n   172\\t        outcome: \\\"skipped\\\",\\n   173\\t        skipReason: \\\"duplicate_idempotency_key\\\",\\n   174\\t      },\\n   175\\t      expect.objectContaining({ outcome: \\\"recorded\\\", messageId: \\\"m2\\\" }),\\n   176\\t      expect.objectContaining({ outcome: \\\"recorded\\\" }),\\n   177\\t    ]);\\n   178\\t    // turn_end produces no message.\\n   179\\t    expect(result.events[2]).not.toHaveProperty(\\\"messageId\\\");\\n   180\\t    expect(result.turnTransitions).toEqual([{ action: \\\"closed\\\", turnId: \\\"t1\\\" }]);\\n   181\\t    expect(result.queuedWork).toEqual([\\n   182\\t      {\\n   183\\t        workItemId: \\\"w-t1-turn_derivation-v1\\\",\\n   184\\t        owner: \\\"turns\\\",\\n   185\\t        kind: \\\"turn_derivation\\\",\\n   186\\t        sourceRef: { turnId: \\\"t1\\\" },\\n   187\\t      },\\n   188\\t    ]);\\n   189\\t    expect(result.threadPosition).toEqual({ lastEventOrder: 3 });\\n   190\\t  });\\n   191\\t});\\n   192\\t\\n   193\\tdescribe(\\\"Flow 3 (SDK): turn-owned work queueing — Story 4's debt paid\\\", () => {\\n   194\\t  it(\\\"TC-3.3 (work half): explicit close durably queues w-t1-turn_derivation, owner turns (AC-3.4, AC-3.6)\\\", async () => {\\n   195\\t    setIntakeClock(() => new Date(FIXED_INSTANT));\\n   196\\t    const filePath = await createThread();\\n   197\\t    const result = await send(filePath, [\\n   198\\t      validEvent(\\\"user_prompt\\\"),\\n   199\\t      validEvent(\\\"assistant_text\\\"),\\n   200\\t      validEvent(\\\"turn_end\\\"),\\n   201\\t    ]);\\n   202\\t\\n   203\\t    expect(result.queuedWork).toContainEqual({\\n   204\\t      workItemId: \\\"w-t1-turn_derivation-v1\\\",\\n   205\\t      owner: \\\"turns\\\",\\n   206\\t      kind: \\\"turn_derivation\\\",\\n   207\\t      sourceRef: { turnId: \\\"t1\\\" },\\n   208\\t    });\\n   209\\t    expect(await queuedFor(filePath, \\\"turns\\\")).toEqual([\\n   210\\t      {\\n   211\\t        workItemId: \\\"w-t1-turn_derivation-v1\\\",\\n   212\\t        owner: \\\"turns\\\",\\n   213\\t        kind: \\\"turn_derivation\\\",\\n   214\\t        sourceRef: { turnId: \\\"t1\\\" },\\n   215\\t        status: \\\"queued\\\",\\n   216\\t        queuedAt: FIXED_INSTANT,\\n   217\\t      },\\n   218\\t    ]);\\n   219\\t  });\\n   220\\t\\n   221\\t  it(\\\"TC-3.6 (work half): implicit close queues the same work-item contract as the explicit path (AC-3.6)\\\", async () => {\\n   222\\t    const explicitPath = await createThread();\\n   223\\t    await send(explicitPath, [validEvent(\\\"user_prompt\\\"), validEvent(\\\"assistant_text\\\")]);\\n   224\\t    await send(explicitPath, [validEvent(\\\"turn_end\\\")]);\\n   225\\t\\n   226\\t    const implicitPath = await createThread();\\n   227\\t    await send(implicitPath, [validEvent(\\\"user_prompt\\\"), validEvent(\\\"assistant_text\\\")]);\\n   228\\t    await send(implicitPath, [validEvent(\\\"user_prompt\\\")]);\\n   229\\t\\n   230\\t    const explicitItems = await queuedFor(explicitPath, \\\"turns\\\");\\n   231\\t    const implicitItems = await queuedFor(implicitPath, \\\"turns\\\");\\n   232\\t    expect(explicitItems).toHaveLength(1);\\n   233\\t    // Same item contract modulo queuedAt (wall clock differs between runs).\\n   234\\t    const contract = (items: WorkItemRecord[]) =>\\n   235\\t      items.map(({ queuedAt: _queuedAt, ...rest }) => rest);\\n   236\\t    expect(contract(implicitItems)).toEqual(contract(explicitItems));\\n   237\\t    expect(contract(explicitItems)).toEqual([\\n   238\\t      {\\n   239\\t        workItemId: \\\"w-t1-turn_derivation-v1\\\",\\n   240\\t        owner: \\\"turns\\\",\\n   241\\t        kind: \\\"turn_derivation\\\",\\n   242\\t        sourceRef: { turnId: \\\"t1\\\" },\\n   243\\t        status: \\\"queued\\\",\\n   244\\t      },\\n   245\\t    ]);\\n   246\\t  });\\n   247\\t\\n   248\\t  it(\\\"TC-3.8 (work count): a multi-turn batch queues one turn_derivation item per closed turn (AC-3.6)\\\", async () => {\\n   249\\t    const filePath = await createThread();\\n   250\\t    await send(filePath, [\\n   251\\t      validEvent(\\\"user_prompt\\\"),\\n   252\\t      validEvent(\\\"assistant_text\\\"),\\n   253\\t      validEvent(\\\"user_prompt\\\"),\\n   254\\t      validEvent(\\\"assistant_text\\\"),\\n   255\\t      validEvent(\\\"turn_end\\\"),\\n   256\\t    ]);\\n   257\\t\\n   258\\t    const turnWork = await queuedFor(filePath, \\\"turns\\\");\\n   259\\t    expect(turnWork.map((item) => item.workItemId)).toEqual([\\n   260\\t      \\\"w-t1-turn_derivation-v1\\\",\\n   261\\t      \\\"w-t2-turn_derivation-v1\\\",\\n   262\\t    ]);\\n   263\\t    expect(turnWork.every((item) => item.kind === \\\"turn_derivation\\\")).toBe(true);\\n   264\\t    expect(turnWork.every((item) => item.status === \\\"queued\\\")).toBe(true);\\n   265\\t  });\\n   266\\t\\n   267\\t  it(\\\"TC-5.4 (no-work-item clause): a skipped event queues nothing (AC-5.4)\\\", async () => {\\n   268\\t    const filePath = await createThread();\\n   269\\t    const prompt = validEvent(\\\"user_prompt\\\");\\n   270\\t    const end = validEvent(\\\"turn_end\\\");\\n   271\\t    await send(filePath, [prompt, validEvent(\\\"assistant_text\\\"), end]);\\n   272\\t    await send(filePath, [validEvent(\\\"user_prompt\\\")]); // t2 now open\\n   273\\t    const baseline = await readBack(filePath);\\n   274\\t    const baselineCount = rawWorkItemCount(filePath);\\n   275\\t\\n   276\\t    const resend = await send(filePath, [prompt, end]);\\n   277\\t    expect(resend.events.map((entry) => entry.outcome)).toEqual([\\\"skipped\\\", \\\"skipped\\\"]);\\n   278\\t    expect(resend.queuedWork).toEqual([]);\\n   279\\t    expect(await readBack(filePath)).toEqual(baseline);\\n   280\\t    expect(rawWorkItemCount(filePath)).toBe(baselineCount);\\n   281\\t  });\\n   282\\t});\\n   283\\t\\n   284\\tdescribe(\\\"architecture-risk: durability and rollback over the complete record surface\\\", () => {\\n   285\\t  it(\\\"restart survival: a reopened thread file holds its work items intact, status queued\\\", async () => {\\n   286\\t    const filePath = await createThread();\\n   287\\t    await send(filePath, [\\n   288\\t      validEvent(\\\"user_prompt\\\"),\\n   289\\t      validEvent(\\\"tool_call\\\"),\\n   290\\t      validEvent(\\\"tool_result\\\"),\\n   291\\t      validEvent(\\\"turn_end\\\"),\\n   292\\t    ]);\\n   293\\t    const before = await readBack(filePath);\\n   294\\t    expect(before.messageWork).toHaveLength(2);\\n   295\\t    expect(before.turnWork).toHaveLength(1);\\n   296\\t\\n   297\\t    // Every SDK operation opens and closes its own handle, so a fresh\\n   298\\t    // read-back is a real reopen of the real file. The raw scan proves the\\n   299\\t    // rows live in the thread file itself — not an in-memory queue.\\n   300\\t    const db = openRaw(filePath);\\n   301\\t    try {\\n   302\\t      const rows = db\\n   303\\t        .prepare(\\\"SELECT work_item_id, status FROM work_item ORDER BY work_item_id\\\")\\n   304\\t        .all() as unknown as Array<{ work_item_id: string; status: string }>;\\n   305\\t      expect(rows).toEqual([\\n   306\\t        { work_item_id: \\\"w-m1-prompt_smoothing-v1\\\", status: \\\"queued\\\" },\\n   307\\t        { work_item_id: \\\"w-m3-tool_result_summary-v1\\\", status: \\\"queued\\\" },\\n   308\\t        { work_item_id: \\\"w-t1-turn_derivation-v1\\\", status: \\\"queued\\\" },\\n   309\\t      ]);\\n   310\\t    } finally {\\n   311\\t      db.close();\\n   312\\t    }\\n   313\\t    expect(await readBack(filePath)).toEqual(before);\\n   314\\t  });\\n   315\\t\\n   316\\t  it(\\\"complete-surface rollback: a rejected batch leaves events, messages, turns, and work items at baseline (AC-4.6)\\\", async () => {\\n   317\\t    const filePath = await createThread();\\n   318\\t    await send(filePath, [validEvent(\\\"user_prompt\\\"), validEvent(\\\"tool_result\\\"), validEvent(\\\"turn_end\\\")]);\\n   319\\t    const baseline = await readBack(filePath);\\n   320\\t    const baselineCount = rawWorkItemCount(filePath);\\n   321\\t\\n   322\\t    // A valid prefix that would queue work, then one invalid event: the\\n   323\\t    // batch must reject whole and queue nothing.\\n   324\\t    const rejected = await intakeStream.messageEvents({ filePath }, [\\n   325\\t      validEvent(\\\"user_prompt\\\"),\\n   326\\t      { ...validEvent(\\\"user_prompt\\\"), eventKind: \\\"bogus\\\" } as unknown as MessageEventInput,\\n   327\\t    ]);\\n   328\\t    expect(rejected.ok).toBe(false);\\n   329\\t    if (rejected.ok) return;\\n   330\\t    expect(rejected.error.code).toBe(\\\"invalid_event\\\");\\n   331\\t\\n   332\\t    expect(await readBack(filePath)).toEqual(baseline);\\n   333\\t    expect(rawWorkItemCount(filePath)).toBe(baselineCount);\\n   334\\t  });\\n   335\\t});\\n   336\\t\\n   337\\tdescribe(\\\"CLI in-process: list-queued-work on both owning domains\\\", () => {\\n   338\\t  it(\\\"messages list-queued-work and turns list-queued-work each return only their owner's items\\\", async () => {\\n   339\\t    const filePath = await createThread();\\n   340\\t    await send(filePath, [validEvent(\\\"user_prompt\\\"), validEvent(\\\"turn_end\\\")]);\\n   341\\t\\n   342\\t    const messagesListed = await runCli([\\\"messages\\\", \\\"list-queued-work\\\", \\\"--file-path\\\", filePath]);\\n   343\\t    expect(messagesListed.exitCode).toBe(0);\\n   344\\t    const messagesParsed = JSON.parse(messagesListed.stdout) as {\\n   345\\t      ok: boolean;\\n   346\\t      value: WorkItemRecord[];\\n   347\\t    };\\n   348\\t    expect(messagesParsed.ok).toBe(true);\\n   349\\t    expect(messagesParsed.value).toHaveLength(1);\\n   350\\t    expect(messagesParsed.value[0]).toMatchObject({\\n   351\\t      workItemId: \\\"w-m1-prompt_smoothing-v1\\\",\\n   352\\t      owner: \\\"messages\\\",\\n   353\\t      kind: \\\"prompt_smoothing\\\",\\n   354\\t      sourceRef: { messageId: \\\"m1\\\" },\\n   355\\t      status: \\\"queued\\\",\\n   356\\t    });\\n   357\\t\\n   358\\t    const turnsListed = await runCli([\\\"turns\\\", \\\"list-queued-work\\\", \\\"--file-path\\\", filePath]);\\n   359\\t    expect(turnsListed.exitCode).toBe(0);\\n   360\\t    const turnsParsed = JSON.parse(turnsListed.stdout) as {\\n   361\\t      ok: boolean;\\n   362\\t      value: WorkItemRecord[];\\n   363\\t    };\\n   364\\t    expect(turnsParsed.ok).toBe(true);\\n   365\\t    expect(turnsParsed.value).toHaveLength(1);\\n   366\\t    expect(turnsParsed.value[0]).toMatchObject({\\n   367\\t      workItemId: \\\"w-t1-turn_derivation-v1\\\",\\n   368\\t      owner: \\\"turns\\\",\\n   369\\t      kind: \\\"turn_derivation\\\",\\n   370\\t      sourceRef: { turnId: \\\"t1\\\" },\\n   371\\t      status: \\\"queued\\\",\\n   372\\t    });\\n   373\\t  });\\n   374\\t\\n   375\\t  it(\\\"list-queued-work on an unknown thread id fails with thread_not_found\\\", async () => {\\n   376\\t    const listed = await runCli([\\n   377\\t      \\\"messages\\\",\\n   378\\t      \\\"list-queued-work\\\",\\n   379\\t      \\\"--thread-id\\\",\\n   380\\t      \\\"th_nope\\\",\\n   381\\t      \\\"--registry\\\",\\n   382\\t      store.registryPath,\\n   383\\t    ]);\\n   384\\t    expect(listed.exitCode).toBe(1);\\n   385\\t    const parsed = JSON.parse(listed.stdout) as { ok: boolean; error: { code: string } };\\n   386\\t    expect(parsed.ok).toBe(false);\\n   387\\t    expect(parsed.error.code).toBe(\\\"thread_not_found\\\");\\n   388\\t  });\\n   389\\t});\\n   390\\t\\n   391\\t// ── Story 0 (Epic 02): work-kind registry, handler-map assembly, and the\\n   392\\t// enqueue wrapper's atomicity. The registry and map are FC-0.4; atomicity is\\n   393\\t// Chunk 0's named architecture risk — row + pending form + poke all drop on\\n   394\\t// rollback, because every later queue site (intake, cascade, repair) leans\\n   395\\t// on that invariant.\\n   396\\timport {\\n   397\\t  assembleWorkHandlerMap,\\n   398\\t  createSdk,\\n   399\\t  lookupWorkHandler,\\n   400\\t  runInTransaction,\\n   401\\t  setSchedulerPoke,\\n   402\\t  WORK_KIND_REGISTRY,\\n   403\\t  type WorkHandler,\\n   404\\t} from \\\"../src/index.js\\\";\\n   405\\timport { enqueue } from \\\"../src/tech-utils/work-queue/index.js\\\";\\n   406\\timport {\\n   407\\t  createProviderDouble,\\n   408\\t  readDerivedForms,\\n   409\\t  setIntakeWalkHook,\\n   410\\t} from \\\"./fixtures/index.js\\\";\\n   411\\t\\n   412\\t// Below-SDK read of derived_form rows — enqueue's pending rows are asserted\\n   413\\t// durably, not through the batch result.\\n   414\\tfunction rawFormRows(filePath: string): Array<{ key: string; state: string }> {\\n   415\\t  const db = openRaw(filePath);\\n   416\\t  try {\\n   417\\t    return db\\n   418\\t      .prepare(\\n   419\\t        `SELECT subject_kind || '/' || subject_id || '/' || form AS key, state\\n   420\\t         FROM derived_form ORDER BY key`,\\n   421\\t      )\\n   422\\t      .all() as unknown as Array<{ key: string; state: string }>;\\n   423\\t  } finally {\\n   424\\t    db.close();\\n   425\\t  }\\n   426\\t}\\n   427\\t\\n   428\\tdescribe(\\\"FC-0.4: work-kind registry and handler-map assembly\\\", () => {\\n   429\\t  it(\\\"the registry covers all six kinds with owner and sourceRef semantics per the Work Item contract\\\", () => {\\n   430\\t    expect(WORK_KIND_REGISTRY).toEqual({\\n   431\\t      prompt_smoothing: { owner: \\\"messages\\\", sourceRefKey: \\\"messageId\\\" },\\n   432\\t      tool_call_summary: { owner: \\\"messages\\\", sourceRefKey: \\\"messageId\\\" },\\n   433\\t      tool_result_summary: { owner: \\\"messages\\\", sourceRefKey: \\\"messageId\\\" },\\n   434\\t      turn_derivation: { owner: \\\"turns\\\", sourceRefKey: \\\"turnId\\\" },\\n   435\\t      chunk_summary_detailed: { owner: \\\"turns\\\", sourceRefKey: \\\"chunkId\\\" },\\n   436\\t      chunk_summary_brief: { owner: \\\"turns\\\", sourceRefKey: \\\"chunkId\\\" },\\n   437\\t    });\\n   438\\t  });\\n   439\\t\\n   440\\t  it(\\\"createSdk assembles the handler map from domain tables; an unregistered kind reports the miss explicitly\\\", () => {\\n   441\\t    const sdk = createSdk({ provider: createProviderDouble(), mode: \\\"manual\\\" });\\n   442\\t    // Domain tables are empty until Stories 2–3; assembly itself is live.\\n   443\\t    expect(sdk.workHandlers).toEqual({});\\n   444\\t    // The miss is reported as a structured result — not a throw, not silence.\\n   445\\t    const missed = sdk.lookupWorkHandler(\\\"prompt_smoothing\\\");\\n   446\\t    expect(missed.ok).toBe(false);\\n   447\\t    if (missed.ok) return;\\n   448\\t    expect(missed.error.errorClass).toBe(\\\"state_corruption\\\");\\n   449\\t    expect(missed.error.code).toBe(\\\"unknown_work_kind\\\");\\n   450\\t    expect(missed.error.reason).toContain(\\\"prompt_smoothing\\\");\\n   451\\t  });\\n   452\\t\\n   453\\t  it(\\\"assembly merges per-domain tables, dispatch finds a registered handler, and a doubly-claimed kind is refused\\\", () => {\\n   454\\t    const handler: WorkHandler = async () => ({ ok: true });\\n   455\\t    const map = assembleWorkHandlerMap([\\n   456\\t      { prompt_smoothing: handler },\\n   457\\t      { turn_derivation: handler },\\n   458\\t    ]);\\n   459\\t    const found = lookupWorkHandler(map, \\\"prompt_smoothing\\\");\\n   460\\t    expect(found.ok).toBe(true);\\n   461\\t    if (!found.ok) return;\\n   462\\t    expect(found.value).toBe(handler);\\n   463\\t    const missed = lookupWorkHandler(map, \\\"chunk_summary_brief\\\");\\n   464\\t    expect(missed.ok).toBe(false);\\n   465\\t    // One owner per kind: a second table claiming the same kind is a wiring\\n   466\\t    // bug surfaced at construction.\\n   467\\t    expect(() =>\\n   468\\t      assembleWorkHandlerMap([{ prompt_smoothing: handler }, { prompt_smoothing: handler }]),\\n   469\\t    ).toThrow(/prompt_smoothing/);\\n   470\\t  });\\n   471\\t});\\n   472\\t\\n   473\\tdescribe(\\\"architecture-risk: enqueue atomicity — row, pending form, poke commit or vanish together\\\", () => {\\n   474\\t  afterEach(() => {\\n   475\\t    setSchedulerPoke(null);\\n   476\\t    setIntakeWalkHook(null);\\n   477\\t  });\\n   478\\t\\n   479\\t  it(\\\"a committed intake batch durably writes work rows + pending forms and pokes once per enqueue, after commit\\\", async () => {\\n   480\\t    const filePath = await createThread();\\n   481\\t    const pokes: string[] = [];\\n   482\\t    setSchedulerPoke((threadId) => pokes.push(threadId));\\n   483\\t\\n   484\\t    const result = await send(filePath, [\\n   485\\t      validEvent(\\\"user_prompt\\\"),\\n   486\\t      validEvent(\\\"assistant_text\\\"),\\n   487\\t      validEvent(\\\"turn_end\\\"),\\n   488\\t    ]);\\n   489\\t    // Two enqueues (prompt smoothing + turn derivation) → two pokes, both\\n   490\\t    // carrying the thread's resolved id, fired only after COMMIT.\\n   491\\t    expect(pokes).toHaveLength(2);\\n   492\\t    expect(new Set(pokes).size).toBe(1);\\n   493\\t    expect(pokes[0]).toMatch(/^th_/);\\n   494\\t    expect(result.queuedWork).toHaveLength(2);\\n   495\\t\\n   496\\t    // The pending state rows rode the same transaction (DD-5): one for the\\n   497\\t    // prompt's form, two for the turn's rendering + projection.\\n   498\\t    expect(rawFormRows(filePath)).toEqual([\\n   499\\t      { key: \\\"message/m1/smoothed_prompt\\\", state: \\\"pending\\\" },\\n   500\\t      { key: \\\"turn/t1/lower_band_projection\\\", state: \\\"pending\\\" },\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n./packages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/00-foundation/streams/004-verify.stdout.log:96:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_46\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc 'git diff -- packages/lhc/test/thread-migration.test.ts packages/lhc/test/work-queue.test.ts packages/lhc/test/cli-process-work-queue.test.ts packages/lhc/test/fixtures.test.ts packages/lhc/src/tech-utils/work-queue/index.ts packages/lhc/src/shared/storage.ts packages/lhc/src/sdk.ts'\",\"aggregated_output\":\"diff --git a/packages/lhc/src/sdk.ts b/packages/lhc/src/sdk.ts\\nindex fd4d56f..cde83da 100644\\n--- a/packages/lhc/src/sdk.ts\\n+++ b/packages/lhc/src/sdk.ts\\n@@ -3,16 +3,31 @@ export * as intakeStream from \\\"./domains/intake-stream/index.js\\\";\\n export * as messages from \\\"./domains/messages/index.js\\\";\\n export * as turns from \\\"./domains/turns/index.js\\\";\\n \\n+import * as intakeStreamDomain from \\\"./domains/intake-stream/index.js\\\";\\n+import * as messagesDomain from \\\"./domains/messages/index.js\\\";\\n+import * as threadsDomain from \\\"./domains/threads/index.js\\\";\\n+import * as turnsDomain from \\\"./domains/turns/index.js\\\";\\n+import { createScheduler, type Scheduler } from \\\"./scheduler.js\\\";\\n+import {\\n+  PROVIDER_OPERATIONS,\\n+  type ResolvedSdkConfig,\\n+  type SdkConfig,\\n+  type WorkHandler,\\n+} from \\\"./shared/derivation.js\\\";\\n+import type { ErrorResult, OpResult } from \\\"./shared/errors.js\\\";\\n+import type { WorkKind } from \\\"./tech-utils/work-queue/index.js\\\";\\n+\\n export {\\n   estimateTokens,\\n   TOKEN_ESTIMATOR_ID,\\n } from \\\"./tech-utils/token-counting/index.js\\\";\\n \\n-export type {\\n-  WorkItemRecord,\\n-  WorkKind,\\n-  WorkOwner,\\n-  WorkSourceRef,\\n+export {\\n+  WORK_KIND_REGISTRY,\\n+  type WorkItemRecord,\\n+  type WorkKind,\\n+  type WorkOwner,\\n+  type WorkSourceRef,\\n } from \\\"./tech-utils/work-queue/index.js\\\";\\n \\n export type {\\n@@ -21,7 +36,29 @@ export type {\\n   ErrorResult,\\n   OpResult,\\n } from \\\"./shared/errors.js\\\";\\n-export type { OperationContext } from \\\"./shared/context.js\\\";\\n+export {\\n+  runInTransaction,\\n+  setSchedulerPoke,\\n+  type OperationContext,\\n+} from \\\"./shared/context.js\\\";\\n+\\n+export type {\\n+  DependencyGap,\\n+  DerivationProvider,\\n+  DerivedForm,\\n+  DerivedFormState,\\n+  FormKind,\\n+  HandlerOutcome,\\n+  HandlerRunContext,\\n+  ProviderResult,\\n+  RenderingPart,\\n+  ResolvedSdkConfig,\\n+  SdkConfig,\\n+  SubjectKind,\\n+  ToolOutcome,\\n+  WorkHandler,\\n+} from \\\"./shared/derivation.js\\\";\\n+export type { Scheduler, SchedulerMode } from \\\"./scheduler.js\\\";\\n \\n export type { ThreadRef } from \\\"./domains/threads/index.js\\\";\\n export type {\\n@@ -36,3 +73,131 @@ export type {\\n   EventRecord,\\n   MessageEventInput,\\n } from \\\"./domains/intake-stream/index.js\\\";\\n+\\n+// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\\n+\\n+export type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\\n+\\n+// Merge per-domain handler tables into the one join between the queue's\\n+// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\\n+// (each kind has exactly one owner) and throws at construction.\\n+export function assembleWorkHandlerMap(\\n+  tables: ReadonlyArray<WorkHandlerMap>,\\n+): WorkHandlerMap {\\n+  const map: WorkHandlerMap = {};\\n+  for (const table of tables) {\\n+    for (const [kind, handler] of Object.entries(table)) {\\n+      if (map[kind as WorkKind] !== undefined) {\\n+        throw new TypeError(`work kind \\\"${kind}\\\" registered by more than one domain`);\\n+      }\\n+      map[kind as WorkKind] = handler;\\n+    }\\n+  }\\n+  return map;\\n+}\\n+\\n+function unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\\n+  return {\\n+    ok: false,\\n+    error: {\\n+      errorClass: \\\"state_corruption\\\",\\n+      code: \\\"unknown_work_kind\\\",\\n+      reason: `no handler registered for work kind \\\"${kind}\\\"`,\\n+    },\\n+  };\\n+}\\n+\\n+// Dispatch-time lookup: an unregistered kind is reported explicitly — never\\n+// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\\n+export function lookupWorkHandler(\\n+  map: WorkHandlerMap,\\n+  kind: string,\\n+): OpResult<WorkHandler> {\\n+  const handler = map[kind as WorkKind];\\n+  if (handler === undefined) return unknownWorkKind(kind);\\n+  return { ok: true, value: handler };\\n+}\\n+\\n+export interface Lhc {\\n+  threads: typeof threadsDomain;\\n+  intakeStream: typeof intakeStreamDomain;\\n+  messages: typeof messagesDomain;\\n+  turns: typeof turnsDomain;\\n+  config: ResolvedSdkConfig;\\n+  scheduler: Scheduler;\\n+  workHandlers: WorkHandlerMap;\\n+  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\\n+}\\n+\\n+function requirePositive(value: number, name: string): void {\\n+  if (!Number.isFinite(value) || value <= 0) {\\n+    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\\n+  }\\n+}\\n+\\n+function requireNonNegative(value: number, name: string): void {\\n+  if (!Number.isFinite(value) || value < 0) {\\n+    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\\n+  }\\n+}\\n+\\n+// The only assembly path: provider, mode, clock, and policy enter here.\\n+// Config mistakes are programmer errors at construction and throw; operating\\n+// failures after construction return OpResults per the error contract.\\n+export function createSdk(config: SdkConfig): Lhc {\\n+  if (config.mode !== \\\"background\\\" && config.mode !== \\\"manual\\\") {\\n+    throw new TypeError(\\n+      `createSdk config: mode must be \\\"background\\\" or \\\"manual\\\", got ${JSON.stringify(config.mode)}`,\\n+    );\\n+  }\\n+  if (config.provider === null || typeof config.provider !== \\\"object\\\") {\\n+    throw new TypeError(\\\"createSdk config: provider must implement DerivationProvider\\\");\\n+  }\\n+  for (const operation of PROVIDER_OPERATIONS) {\\n+    if (typeof config.provider[operation] !== \\\"function\\\") {\\n+      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\\n+    }\\n+  }\\n+\\n+  const resolved: ResolvedSdkConfig = {\\n+    provider: config.provider,\\n+    mode: config.mode,\\n+    clock: config.clock ?? (() => new Date()),\\n+    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\\n+    lease: config.lease ?? { durationMs: 120000 },\\n+    chunkPolicy:\\n+      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\\n+  };\\n+  requirePositive(resolved.retry.budget, \\\"retry.budget\\\");\\n+  requireNonNegative(resolved.retry.backoffBaseMs, \\\"retry.backoffBaseMs\\\");\\n+  requireNonNegative(resolved.retry.backoffCapMs, \\\"retry.backoffCapMs\\\");\\n+  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\\n+    throw new TypeError(\\\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\\\");\\n+  }\\n+  requirePositive(resolved.lease.durationMs, \\\"lease.durationMs\\\");\\n+  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \\\"chunkPolicy.targetProjectedTokens\\\");\\n+  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\\n+    throw new TypeError(\\n+      \\\"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\\\",\\n+    );\\n+  }\\n+\\n+  // Handler maps merge from per-domain contributions at construction (DD-6).\\n+  // The tables are empty until Stories 2–3 land the real handlers; the\\n+  // assembly mechanics are production code from day one.\\n+  const workHandlers = assembleWorkHandlerMap([\\n+    messagesDomain.workHandlers,\\n+    turnsDomain.workHandlers,\\n+  ]);\\n+\\n+  return {\\n+    threads: threadsDomain,\\n+    intakeStream: intakeStreamDomain,\\n+    messages: messagesDomain,\\n+    turns: turnsDomain,\\n+    config: resolved,\\n+    scheduler: createScheduler(resolved.mode),\\n+    workHandlers,\\n+    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\n+  };\\n+}\\ndiff --git a/packages/lhc/src/shared/storage.ts b/packages/lhc/src/shared/storage.ts\\nindex c5b50c0..309c6e0 100644\\n--- a/packages/lhc/src/shared/storage.ts\\n+++ b/packages/lhc/src/shared/storage.ts\\n@@ -14,6 +14,69 @@ export function openDatabase(path: string): DatabaseSync {\\n   return db;\\n }\\n \\n+// Epic 02's single migration (tech design §Storage): queue mechanical fields\\n+// on the existing work_item table, the derived_form state table, the chunk\\n+// tables, and the projection-level delete stamps. The whole epic's schema\\n+// lands in one version — behavior arrives story by story. Assembled into the\\n+// thread-file migration history by threads/internal/create.ts.\\n+export const MIGRATION_V5_STATEMENTS: readonly string[] = [\\n+  // claim mechanics on the existing table (DD-1: no disposition column —\\n+  // queue rows are live work only; terminal rows are deleted and their\\n+  // outcomes reported in-memory; durable outcome state lives on derived_form)\\n+  `ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`,\\n+  `ALTER TABLE work_item ADD COLUMN last_error TEXT;`,\\n+  `ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`,\\n+  `ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`,\\n+  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\\n+  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\\n+  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\\n+  // inside an index definition, so the index covers the two real columns and\\n+  // claimNext's ORDER BY rowid walks the head as before.\\n+  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\\n+  `CREATE TABLE derived_form (\\n+    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\\n+    subject_id   TEXT NOT NULL,\\n+    form         TEXT NOT NULL,\\n+    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\\n+    content      TEXT,\\n+    reason       TEXT,\\n+    metadata     TEXT,\\n+    source_version INTEGER NOT NULL DEFAULT 1,\\n+    gaps         TEXT,\\n+    derived_at   TEXT,\\n+    PRIMARY KEY (subject_kind, subject_id, form)\\n+  );`,\\n+  `CREATE TABLE chunk (\\n+    chunk_id     TEXT PRIMARY KEY,\\n+    chunk_order  INTEGER NOT NULL UNIQUE,\\n+    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\\n+    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\\n+  );`,\\n+  `CREATE TABLE chunk_member (\\n+    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\\n+    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\\n+    member_idx INTEGER NOT NULL,\\n+    PRIMARY KEY (chunk_id, member_idx)\\n+  );`,\\n+  // projection-level delete (the record keeps everything; reads filter)\\n+  `ALTER TABLE message ADD COLUMN deleted_at TEXT;`,\\n+  `ALTER TABLE turns   ADD COLUMN deleted_at TEXT;`,\\n+  // F-02 backfill: pending form rows for work queued before v5 existed, so\\n+  // UPDATE-only completion finds them (row missing must mean deleted).\\n+  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\\n+    SELECT 'message', json_extract(source_ref, '$.messageId'), 'smoothed_prompt', 'pending', 1\\n+    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\\n+  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\\n+    SELECT 'message', json_extract(source_ref, '$.messageId'), 'tool_result_summary', 'pending', 1\\n+    FROM work_item WHERE status = 'queued' AND kind = 'tool_result_summary';`,\\n+  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\\n+    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'turn_rendering', 'pending', 1\\n+    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\\n+  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\\n+    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'lower_band_projection', 'pending', 1\\n+    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\\n+];\\n+\\n export function getSchemaVersion(db: DatabaseSync): number {\\n   const row = db.prepare(\\\"PRAGMA user_version\\\").get() as\\n     | { user_version: number | bigint }\\ndiff --git a/packages/lhc/src/tech-utils/work-queue/index.ts b/packages/lhc/src/tech-utils/work-queue/index.ts\\nindex 4449ed7..de96247 100644\\n--- a/packages/lhc/src/tech-utils/work-queue/index.ts\\n+++ b/packages/lhc/src/tech-utils/work-queue/index.ts\\n@@ -1,22 +1,47 @@\\n-// Durable work-item mechanics: recording and ordered listing, nothing else.\\n-// The util is domain-blind by the tech-arch capability rule — it knows the\\n-// item vocabulary (owner, kind, sourceRef) but nothing about what a turn or\\n-// a summary is; which kinds queue for which sources is the owning domains'\\n-// business. Writes run on the caller's handle inside the batch transaction,\\n-// so items commit (or roll back) with the batch. No public SDK surface:\\n-// read-back reaches here only through the owning domains' listQueuedWork.\\n+// Durable work-item mechanics: recording, ordered listing, and the enqueue\\n+// wrapper that makes \\\"queueing is what schedules processing\\\" structural\\n+// (DD-5). The util is domain-blind by the tech-arch capability rule — it\\n+// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\\n+// a turn or a summary is; which kinds queue for which sources, and which\\n+// derived forms a kind produces, is the owning domains' business (callers\\n+// pass the form targets in). Writes run on the caller's handle inside the\\n+// ambient transaction, so items commit (or roll back) with the batch. No\\n+// public SDK surface: read-back reaches here only through the owning\\n+// domains' listQueuedWork.\\n import type { DatabaseSync } from \\\"node:sqlite\\\";\\n+import { fireSchedulerPoke, type OperationContext } from \\\"../../shared/context.js\\\";\\n+import type { FormKind, SubjectKind } from \\\"../../shared/derivation.js\\\";\\n \\n export type WorkOwner = \\\"messages\\\" | \\\"turns\\\";\\n-export type WorkKind = \\\"prompt_smoothing\\\" | \\\"tool_result_summary\\\" | \\\"turn_derivation\\\";\\n-export type WorkSourceRef = { messageId: string } | { turnId: string };\\n+export type WorkKind =\\n+  | \\\"prompt_smoothing\\\"\\n+  | \\\"tool_call_summary\\\"\\n+  | \\\"tool_result_summary\\\"\\n+  | \\\"turn_derivation\\\"\\n+  | \\\"chunk_summary_detailed\\\"\\n+  | \\\"chunk_summary_brief\\\";\\n+export type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\\n+\\n+// The work-kind registry: owner and sourceRef semantics per the epic's Work\\n+// Item contract. Mechanical metadata only — what a kind *means* stays with\\n+// the owning domain's handler (registered at SDK construction, DD-6).\\n+export const WORK_KIND_REGISTRY: Readonly<\\n+  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \\\"messageId\\\" | \\\"turnId\\\" | \\\"chunkId\\\" }>\\n+> = {\\n+  prompt_smoothing: { owner: \\\"messages\\\", sourceRefKey: \\\"messageId\\\" },\\n+  tool_call_summary: { owner: \\\"messages\\\", sourceRefKey: \\\"messageId\\\" },\\n+  tool_result_summary: { owner: \\\"messages\\\", sourceRefKey: \\\"messageId\\\" },\\n+  turn_derivation: { owner: \\\"turns\\\", sourceRefKey: \\\"turnId\\\" },\\n+  chunk_summary_detailed: { owner: \\\"turns\\\", sourceRefKey: \\\"chunkId\\\" },\\n+  chunk_summary_brief: { owner: \\\"turns\\\", sourceRefKey: \\\"chunkId\\\" },\\n+};\\n \\n export interface WorkItemRecord {\\n   workItemId: string;\\n   owner: WorkOwner;\\n   kind: WorkKind;\\n   sourceRef: WorkSourceRef;\\n-  status: \\\"queued\\\"; // the only status this epic writes\\n+  status: \\\"queued\\\"; // the only status written
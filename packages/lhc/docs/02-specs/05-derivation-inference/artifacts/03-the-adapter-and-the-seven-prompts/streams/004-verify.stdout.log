\\\\\"INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order) VALUES (?, ?, 'open', ?)\\\\\\\",\\\\n16\\\\t    ).run(`t${nextOrder}`, nextOrder, 0);\\\\n17\\\\t  } finally {\\\\n18\\\\t    db.close();\\\\n19\\\\t  }\\\\n20\\\\t}\\\\n21\\\\t\\\\n22\\\\t// Poison pills for the bounded no-load-everything proof (Epic 04 AC-3.1,\\\\n23\\\\t// SV-01-002): overwrite one message's block content — or its derived-form\\\\n24\\\\t// metadata — with bytes that are not valid JSON, so any read that *loads* that\\\\n25\\\\t// row throws on parse. A bounded list that excludes the message must still\\\\n26\\\\t// succeed; a window that includes it must fail. Together that is positive\\\\n27\\\\t// proof the out-of-window row was never read, not merely absent from output.\\\\n28\\\\tconst NOT_JSON = \\\\\\\"{ this is not valid json\\\\\\\";\\\\n29\\\\t\\\\n30\\\\texport function poisonMessageBlockJson(path: string, messageId: string): void {\\\\n31\\\\t  const db = new DatabaseSync(path);\\\\n32\\\\t  try {\\\\n33\\\\t    db.prepare(`UPDATE message_block SET content = ? WHERE message_id = ?`).run(\\\\n34\\\\t      NOT_JSON,\\\\n35\\\\t      messageId,\\\\n36\\\\t    );\\\\n37\\\\t  } finally {\\\\n38\\\\t    db.close();\\\\n39\\\\t  }\\\\n40\\\\t}\\\\n41\\\\t\\\\n42\\\\texport function poisonMessageFormJson(path: string, messageId: string): void {\\\\n43\\\\t  const db = new DatabaseSync(path);\\\\n44\\\\t  try {\\\\n45\\\\t    db.prepare(\\\\n46\\\\t      `UPDATE derived_form SET metadata = ?\\\\n47\\\\t       WHERE subject_kind = 'message' AND subject_id = ?`,\\\\n48\\\\t    ).run(NOT_JSON, messageId);\\\\n49\\\\t  } finally {\\\\n50\\\\t    db.close();\\\\n51\\\\t  }\\\\n52\\\\t}\\\\n53\\\\t\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\\\",\\\"uuid\\\":\\\"180962aa-337c-407c-a416-ea9d8d5cab78\\\",\\\"timestamp\\\":\\\"2026-06-12T13:25:02.622Z\\\",\\\"tool_use_result\\\":{\\\"type\\\":\\\"text\\\",\\\"file\\\":{\\
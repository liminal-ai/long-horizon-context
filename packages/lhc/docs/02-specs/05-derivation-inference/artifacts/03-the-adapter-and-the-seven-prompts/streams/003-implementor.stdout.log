{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011JYZXUR1Jxff5SNu7edsCm","type":"tool_result","content":"1\t// Parameterized seam-contract assertions (Epic 05 DD-13): the same helpers\n2\t// run against the scripted fakes (TC-1.2) and, unchanged, against the real\n3\t// OpenRouter host (TC-4.3) — shared assertion code, never duplicated tests.\n4\t// Framework-agnostic on purpose: plain node:assert throws surface in vitest\n5\t// and in any future runner identically.\n6\timport assert from \"node:assert/strict\";\n7\timport { createSdk, type DerivedForm, type Lhc } from \"../../src/index.js\";\n8\timport { FORM_KINDS, type FormKind } from \"../../src/shared/derivation.js\";\n9\timport type {\n10\t  ModelAssignment,\n11\t  ModelCall,\n12\t  ModelCallInput,\n13\t} from \"../../src/inference/types.js\";\n14\timport { readDerivedForms } from \"./threads.js\";\n15\timport { validEvent, type TempStore } from \"./index.js\";\n16\t\n17\tconst FAILURE_KINDS = new Set([\n18\t  \"rate_limit\",\n19\t  \"timeout\",\n20\t  \"network\",\n21\t  \"empty_output\",\n22\t  \"other\",\n23\t  \"auth\",\n24\t  \"invalid_request\",\n25\t]);\n26\t\n27\texport function probeInput(overrides: Partial<ModelCallInput> = {}): ModelCallInput {\n28\t  return {\n29\t    provider: \"probe-provider\",\n30\t    model: \"probe-model\",\n31\t    messages: [\n32\t      { role: \"system\", content: \"You answer with one word.\" },\n33\t      { role: \"user\", content: \"Say ok.\" },\n34\t    ],\n35\t    ...overrides,\n36\t  };\n37\t}\n38\t\n39\t// AC-1.2's result contract on one probe call: a ModelCall resolves to either\n40\t// `{ ok: true, text }` or `{ ok: false, kind, message }` with `kind` from the\n41\t// failure vocabulary. Catches fixture (and real-host) drift from the\n42\t// boundary contract.\n43\texport async function assertModelCallContract(\n44\t  call: ModelCall,\n45\t  probe: ModelCallInput = probeInput(),\n46\t): Promise<void> {\n47\t  const result = await call(probe);\n48\t  assert.ok(\n49\t    typeof result === \"object\" && result !== null,\n50\t    \"ModelCall must resolve to a result object\",\n51\t  );\n52\t  if (result.ok === true) {\n53\t    assert.equal(typeof result.text, \"string\", \"success result must carry string text\");\n54\t  } else if (result.ok === false) {\n55\t    assert.ok(\n56\t      FAILURE_KINDS.has(result.kind),\n57\t      `failure kind \"${String(result.kind)}\" is not in the failure vocabulary`,\n58\t    );\n59\t    assert.equal(typeof result.message, \"string\", \"failure result must carry a string message\");\n60\t  } else {\n61\t    assert.fail(\"ModelCall result must discriminate on a boolean ok\");\n62\t  }\n63\t}\n64\t\n65\texport interface RoutingRunResult {\n66\t  sdk: Lhc;\n67\t  filePath: string;\n68\t  forms: DerivedForm[];\n69\t  log: ModelCallInput[];\n70\t}\n71\t\n72\tasync function seedAllSevenKinds(sdk: Lhc, store: TempStore): Promise<string> {\n73\t  const filePath = store.threadPath();\n74\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n75\t  assert.ok(created.ok, \"conformance fixture: thread creation failed\");\n76\t  // Turn 1 carries a tool run (smoothing, tool-call/result summaries,\n77\t  // rendering, projection); turn 2 exists so turn 1's chunk closes under the\n78\t  // tiny target policy and the two chunk summaries enqueue.\n79\t  const result = await sdk.intakeStream.messageEvents({ filePath }, [\n80\t    validEvent(\"user_prompt\", { payload: { text: \"please inspect the fixture file\" } }),\n81\t    validEvent(\"tool_call\", {\n82\t      payload: {\n83\t        toolCallId: \"call-seam-1\",\n84\t        toolName: \"read_file\",\n85\t        arguments: { path: \"fixture.txt\" },\n86\t      },\n87\t    }),\n88\t    validEvent(\"tool_result\", {\n89\t      payload: { toolCallId: \"call-seam-1\", content: \"contents of fixture.txt\", isError: false },\n90\t    }),\n91\t    validEvent(\"assistant_text\", { payload: { text: \"the fixture file holds fixture text\" } }),\n92\t    validEvent(\"turn_end\"),\n93\t    validEvent(\"user_prompt\", { payload: { text: \"thanks, now summarize it\" } }),\n94\t    validEvent(\"assistant_text\", { payload: { text: \"summarized\" } }),\n95\t    validEvent(\"turn_end\"),\n96\t  ]);\n97\t  assert.ok(result.ok, \"conformance fixture: intake batch failed\");\n98\t  return filePath;\n99\t}\n100\t\n101\t// TC-1.2's routing assertions, extracted so TC-4.3 runs them against the\n102\t// real host unchanged: construct an SDK on the inference path, drive all\n103\t// seven kinds through a real intake → drain, and assert (1) every kind lands\n104\t// ready, (2) every call that crossed the boundary carried exactly one\n105\t// kind's assigned provider/model routing keys, (3) each kind's lane was\n106\t// exercised, and (4) every messages value is single-turn shape — system and\n107\t// user roles only, string content (AC-1.2, AC-1.4).\n108\texport async function assertRoutingThroughSdk(\n109\t  call: ModelCall,\n110\t  assignments: Record<FormKind, ModelAssignment>,\n111\t  store: TempStore,\n112\t): Promise<RoutingRunResult> {\n113\t  const log: ModelCallInput[] = [];\n114\t  const logged: ModelCall = (input) => {\n115\t    log.push(structuredClone(input));\n116\t    return call(input);\n117\t  };\n118\t  const sdk = createSdk({\n119\t    inference: { call: logged, assignments },\n120\t    mode: \"manual\",\n121\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n122\t    // Tiny target: each placed turn crosses it, so the prior turn's chunk\n123\t    // closes during the drain and the chunk-summary kinds run too.\n124\t    chunkPolicy: { targetProjectedTokens: 5, maxProjectedTokens: 4400 },\n125\t  });\n126\t  const filePath = await seedAllSevenKinds(sdk, store);\n127\t\n128\t  const drained = await sdk.work.drain({ filePath });\n129\t  assert.ok(drained.ok, \"conformance drain failed\");\n130\t  assert.equal(drained.value.stoppedBecause, \"empty\", \"conformance drain left work behind\");\n131\t  assert.equal(drained.value.remaining, 0, \"conformance drain left items remaining\");\n132\t\n133\t  const forms = readDerivedForms(filePath);\n134\t  for (const kind of FORM_KINDS) {\n135\t    assert.ok(\n136\t      forms.some((form) => form.form === kind && form.state === \"ready\"),\n137\t      `expected at least one ready ${kind} form after the drain`,\n138\t    );\n139\t  }\n140\t\n141\t  assert.ok(log.length > 0, \"no calls crossed the ModelCall boundary\");\n142\t  for (const input of log) {\n143\t    const matched = FORM_KINDS.filter(\n144\t      (kind) =>\n145\t        assignments[kind].provider === input.provider && assignments[kind].model === input.model,\n146\t    );\n147\t    assert.ok(\n148\t      matched.length > 0,\n149\t      `call carried provider/model \"${input.provider}\"/\"${input.model}\" matching no kind's assignment`,\n150\t    );\n151\t    assert.ok(input.messages.length > 0, \"a call crossed the boundary with no messages\");\n152\t    assert.ok(\n153\t      input.messages.some((message) => message.role === \"user\"),\n154\t      \"single-turn shape requires a user message\",\n155\t    );\n156\t    for (const message of input.messages) {\n157\t      assert.ok(\n158\t        message.role === \"system\" || message.role === \"user\",\n159\t        `message role \"${String(message.role)}\" is outside the single-turn vocabulary`,\n160\t      );\n161\t      assert.equal(typeof message.content, \"string\", \"message content must be a string\");\n162\t    }\n163\t  }\n164\t  for (const kind of FORM_KINDS) {\n165\t    assert.ok(\n166\t      log.some(\n167\t        (input) =>\n168\t          input.provider === assignments[kind].provider && input.model === assignments[kind].model,\n169\t      ),\n170\t      `no boundary call carried ${kind}'s assigned provider/model lane`,\n171\t    );\n172\t  }\n173\t  return { sdk, filePath, forms, log };\n174\t}\n175\t"}]},"parent_tool_use_id":null,"session_id":"d415efd0-0780-463c-9946-d0cae549777f","uuid":"81d11307-1033-4126-9961-dc484e4bd8e0","timestamp":"2026-06-12T22:15:00.380Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/seam-conformance.ts","content":"// Parameterized seam-contract assertions (Epic 05 DD-13): the same helpers\n// run against the scripted fakes (TC-1.2) and, unchanged, against the real\n// OpenRouter host (TC-4.3) — shared assertion code, never duplicated tests.\n// Framework-agnostic on purpose: plain node:assert throws surface in vitest\n// and in any future runner identically.\nimport assert from \"node:assert/strict\";\nimport { createSdk, type DerivedForm, type Lhc } from \"../../src/index.js\";\nimport { FORM_KINDS, type FormKind } from \"../../src/shared/derivation.js\";\nimport type {\n  ModelAssignment,\n  ModelCall,\n  ModelCallInput,\n} from \"../../src/inference/types.js\";\nimport { readDerivedForms } from \"./threads.js\";\nimport { validEvent, type TempStore } from \"./index.js\";\n\nconst FAILURE_KINDS = new Set([\n  \"rate_limit\",\n  \"timeout\",\n  \"network\",\n  \"empty_output\",\n  \"other\",\n  \"auth\",\n  \"invalid_request\",\n]);\n\nexport function probeInput(overrides: Partial<ModelCallInput> = {}): ModelCallInput {\n  return {\n    provider: \"probe-provider\",\n    model: \"probe-model\",\n    messages: [\n      { role: \"system\", content: \"You answer with one word.\" },\n      { role: \"user\", content: \"Say ok.\" },\n    ],\n    ...overrides,\n  };\n}\n\n// AC-1.2's result contract on one probe call: a ModelCall resolves to either\n// `{ ok: true, text }` or `{ ok: false, kind, message }` with `kind` from the\n// failure vocabulary. Catches fixture (and real-host) drift from the\n// boundary contract.\nexport async function assertModelCallContract(\n  call: ModelCall,\n  probe: ModelCallInput = probeInput(),\n): Promise<void> {\n  const result = await call(probe);\n  assert.ok(\n    typeof result === \"object\" && result !== null,\n    \"ModelCall must resolve to a result object\",\n  );\n  if (result.ok === true) {\n    assert.equal(typeof result.text, \"string\", \"success result must carry string text\");\n  } else if (result.ok === false) {\n    assert.ok(\n      FAILURE_KINDS.has(result.kind),\n      `failure kind \"${String(result.kind)}\" is not in the failure vocabulary`,\n    );\n    assert.equal(typeof result.message, \"string\", \"failure result must carry a string message\");\n  } else {\n    assert.fail(\"ModelCall result must discriminate on a boolean ok\");\n  }\n}\n\nexport interface RoutingRunResult {\n  sdk: Lhc;\n  filePath: string;\n  forms: DerivedForm[];\n  log: ModelCallInput[];\n}\n\nasync function seedAllSevenKinds(sdk: Lhc, store: TempStore): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  assert.ok(created.ok, \"conformance fixture: thread creation failed\");\n  // Turn 1 carries a tool run (smoothing, tool-call/result summaries,\n  // rendering, projection); turn 2 exists so turn 1's chunk closes under the\n  // tiny target policy and the two chunk summaries enqueue.\n  const result = await sdk.intakeStream.messageEvents({ filePath }, [\n    validEvent(\"user_prompt\", { payload: { text: \"please inspect the fixture file\" } }),\n    validEvent(\"tool_call\", {\n      payload: {\n        toolCallId: \"call-seam-1\",\n        toolName: \"read_file\",\n        arguments: { path: \"fixture.txt\" },\n      },\n    }),\n    validEvent(\"tool_result\", {\n      payload: { toolCallId: \"call-seam-1\", content: \"contents of fixture.txt\", isError: false },\n    }),\n    validEvent(\"assistant_text\", { payload: { text: \"the fixture file holds fixture text\" } }),\n    validEvent(\"turn_end\"),\n    validEvent(\"user_prompt\", { payload: { text: \"thanks, now summarize it\" } }),\n    validEvent(\"assistant_text\", { payload: { text: \"summarized\" } }),\n    validEvent(\"turn_end\"),\n  ]);\n  assert.ok(result.ok, \"conformance fixture: intake batch failed\");\n  return filePath;\n}\n\n// TC-1.2's routing assertions, extracted so TC-4.3 runs them against the\n// real host unchanged: construct an SDK on the inference path, drive all\n// seven kinds through a real intake → drain, and assert (1) every kind lands\n// ready, (2) every call that crossed the boundary carried exactly one\n// kind's assigned provider/model routing keys, (3) each kind's lane was\n// exercised, and (4) every messages value is single-turn shape — system and\n// user roles only, string content (AC-1.2, AC-1.4).\nexport async function assertRoutingThroughSdk(\n  call: ModelCall,\n  assignments: Record<FormKind, ModelAssignment>,\n  store: TempStore,\n): Promise<RoutingRunResult> {\n  const log: ModelCallInput[] = [];\n  const logged: ModelCall = (input) => {\n    log.push(structuredClone(input));\n    return call(input);\n  };\n  const sdk = createSdk({\n    inference: { call: logged, assignments },\n    mode: \"manual\",\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    // Tiny target: each placed turn crosses it, so the prior turn's chunk\n    // closes during the drain and the chunk-summary kinds run too.\n    chunkPolicy: { targetProjectedTokens: 5, maxProjectedTokens: 4400 },\n  });\n  const filePath = await seedAllSevenKinds(sdk, store);\n\n  const drained = await sdk.work.drain({ filePath });\n  assert.ok(drained.ok, \"conformance drain failed\");\n  assert.equal(drained.value.stoppedBecause, \"empty\", \"conformance drain left work behind\");\n  assert.equal(drained.value.remaining, 0, \"conformance drain left items remaining\");\n\n  const forms = readDerivedForms(filePath);\n  for (const kind of FORM_KINDS) {\n    assert.ok(\n      forms.some((form) => form.form === kind && form.state === \"ready\"),\n      `expected at least one ready ${kind} form after the drain`,\n    );\n  }\n\n  assert.ok(log.length > 0, \"no calls crossed the ModelCall boundary\");\n  for (const input of log) {\n    const matched = FORM_KINDS.filter(\n      (kind) =>\n        assignments[kind].provider === input.provider && assignments[kind].model === input.model,\n    );\n    assert.ok(\n      matched.length > 0,\n      `call carried provider/model \"${input.provider}\"/\"${input.model}\" matching no kind's assignment`,\n    );\n    assert.ok(input.messages.length > 0, \"a call crossed the boundary with no messages\");\n    assert.ok(\n      input.messages.some((message) => message.role === \"user\"),\n      \"single-turn shape requires a user message\",\n    );\n    for (const message of input.messages) {\n      assert.ok(\n        message.role === \"system\" || message.role === \"user\",\n        `message role \"${String(message.role)}\" is outside the single-turn vocabulary`,\n      );\n      assert.equal(typeof message.content, \"string\", \"message content must be a string\");\n    }\n  }\n  for (const kind of FORM_KINDS) {\n    assert.ok(\n      log.some(\n        (input) =>\n          input.provider === assignments[kind].provider && input.model === assignments[kind].model,\n      ),\n      `no boundary call carried ${kind}'s assigned provider/model lane`,\n    );\n  }\n  return { sdk, filePath, forms, log };\n}\n","numLines":175,"startLine":1,"totalLines":175}}}

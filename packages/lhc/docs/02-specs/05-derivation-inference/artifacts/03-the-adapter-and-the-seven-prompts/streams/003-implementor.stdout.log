{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G5fmtJBF3iSGxZHgtyMHWa","type":"tool_result","content":"1\t// Epic 05 Story 2 — TC-1.2 (AC-1.2, AC-1.4): per-call routing through the\n2\t// inference seam. A recording fake logs every call while a seeded thread\n3\t// exercises all seven kinds; the assertions inspect the actual serialized\n4\t// ModelCall input emitted during the drain — never a helper-level intention\n5\t// (anti-shim). The routing assertions live in the parameterized\n6\t// seam-conformance helpers so TC-4.3 runs them against the real host\n7\t// unchanged (DD-13).\n8\timport { afterEach, describe, expect, it } from \"vitest\";\n9\timport {\n10\t  assertModelCallContract,\n11\t  assertRoutingThroughSdk,\n12\t  cannedResponses,\n13\t  FAKE_MODEL_PREFIX,\n14\t  FAKE_PROVIDER_PREFIX,\n15\t  FORM_KINDS,\n16\t  probeInput,\n17\t  recordingCall,\n18\t  tempStore,\n19\t  validAssignments,\n20\t  type TempStore,\n21\t} from \"./fixtures/index.js\";\n22\t\n23\tconst stores: TempStore[] = [];\n24\tafterEach(() => {\n25\t  for (const store of stores.splice(0)) store.cleanup();\n26\t});\n27\t\n28\tfunction freshStore(): TempStore {\n29\t  const store = tempStore();\n30\t  stores.push(store);\n31\t  return store;\n32\t}\n33\t\n34\tdescribe(\"TC-1.2: per-kind provider/model routing (AC-1.4)\", () => {\n35\t  it(\"a seeded drain exercises all seven kinds, each call carrying exactly its assigned strings\", async () => {\n36\t    const responses = cannedResponses();\n37\t    const { call, log } = recordingCall(responses);\n38\t    const assignments = validAssignments();\n39\t    const { forms } = await assertRoutingThroughSdk(call, assignments, freshStore());\n40\t\n41\t    for (const kind of FORM_KINDS) {\n42\t      const lane = log.filter((input) => input.model === `${FAKE_MODEL_PREFIX}${kind}`);\n43\t      expect(lane.length).toBeGreaterThan(0);\n44\t      for (const input of lane) {\n45\t        expect(input.provider).toBe(`${FAKE_PROVIDER_PREFIX}${kind}`);\n46\t        expect(input.model).toBe(assignments[kind].model);\n47\t      }\n48\t      // The landed content is the canned text the kind's lane returned —\n49\t      // routing proven end to end, not just at the call log.\n50\t      const ready = forms.filter((form) => form.form === kind && form.state === \"ready\");\n51\t      expect(ready.length).toBeGreaterThan(0);\n52\t      for (const form of ready) {\n53\t        expect(form.content).toBe(responses[kind]);\n54\t      }\n55\t    }\n56\t  });\n57\t\n58\t  it(\"every logged messages value is single-turn shape: system and user roles, string content (AC-1.2)\", async () => {\n59\t    const { call, log } = recordingCall(cannedResponses());\n60\t    await assertRoutingThroughSdk(call, validAssignments(), freshStore());\n61\t\n62\t    expect(log.length).toBeGreaterThan(0);\n63\t    for (const input of log) {\n64\t      expect(input.messages.length).toBeGreaterThan(0);\n65\t      expect(input.messages.some((message) => message.role === \"user\")).toBe(true);\n66\t      for (const message of input.messages) {\n67\t        expect([\"system\", \"user\"]).toContain(message.role);\n68\t        expect(typeof message.content).toBe(\"string\");\n69\t      }\n70\t    }\n71\t  });\n72\t\n73\t  it(\"a three-lane mixed config routes each call by item kind with no cross-kind bleed\", async () => {\n74\t    const lanes = {\n75\t      smoothed_prompt: \"lane-alpha\",\n76\t      tool_call_summary: \"lane-alpha\",\n77\t      tool_result_summary: \"lane-beta\",\n78\t      turn_rendering: \"lane-beta\",\n79\t      lower_band_projection: \"lane-beta\",\n80\t      chunk_summary_detailed: \"lane-gamma\",\n81\t      chunk_summary_brief: \"lane-gamma\",\n82\t    } as const;\n83\t    const assignments = validAssignments({\n84\t      smoothed_prompt: { provider: lanes.smoothed_prompt },\n85\t      tool_call_summary: { provider: lanes.tool_call_summary },\n86\t      tool_result_summary: { provider: lanes.tool_result_summary },\n87\t      turn_rendering: { provider: lanes.turn_rendering },\n88\t      lower_band_projection: { provider: lanes.lower_band_projection },\n89\t      chunk_summary_detailed: { provider: lanes.chunk_summary_detailed },\n90\t      chunk_summary_brief: { provider: lanes.chunk_summary_brief },\n91\t    });\n92\t    const responses = cannedResponses();\n93\t    const { call, log } = recordingCall(responses);\n94\t    const { forms } = await assertRoutingThroughSdk(call, assignments, freshStore());\n95\t\n96\t    for (const kind of FORM_KINDS) {\n97\t      // Models stay unique per kind, so the lane each item actually used is\n98\t      // readable from the log: every call for this kind's model must carry\n99\t      // this kind's lane provider — no bleed from the other lanes.\n100\t      const calls = log.filter((input) => input.model === assignments[kind].model);\n101\t      expect(calls.length).toBeGreaterThan(0);\n102\t      for (const input of calls) {\n103\t        expect(input.provider).toBe(lanes[kind]);\n104\t      }\n105\t      const ready = forms.filter((form) => form.form === kind && form.state === \"ready\");\n106\t      expect(ready.length).toBeGreaterThan(0);\n107\t      for (const form of ready) {\n108\t        expect(form.content).toBe(responses[kind]);\n109\t      }\n110\t    }\n111\t  });\n112\t});\n113\t\n114\tdescribe(\"TC-1.2: fake-host fixture conformance (AC-1.2)\", () => {\n115\t  it(\"assertModelCallContract holds against recordingCall\", async () => {\n116\t    const { call } = recordingCall(cannedResponses());\n117\t    await assertModelCallContract(\n118\t      call,\n119\t      probeInput({\n120\t        provider: `${FAKE_PROVIDER_PREFIX}smoothed_prompt`,\n121\t        model: `${FAKE_MODEL_PREFIX}smoothed_prompt`,\n122\t      }),\n123\t    );\n124\t  });\n125\t});\n126\t"}]},"parent_tool_use_id":null,"session_id":"d415efd0-0780-463c-9946-d0cae549777f","uuid":"92b56be0-68c2-4da5-90bf-2e8529344536","timestamp":"2026-06-12T22:14:54.063Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/inference-routing.test.ts","content":"// Epic 05 Story 2 — TC-1.2 (AC-1.2, AC-1.4): per-call routing through the\n// inference seam. A recording fake logs every call while a seeded thread\n// exercises all seven kinds; the assertions inspect the actual serialized\n// ModelCall input emitted during the drain — never a helper-level intention\n// (anti-shim). The routing assertions live in the parameterized\n// seam-conformance helpers so TC-4.3 runs them against the real host\n// unchanged (DD-13).\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport {\n  assertModelCallContract,\n  assertRoutingThroughSdk,\n  cannedResponses,\n  FAKE_MODEL_PREFIX,\n  FAKE_PROVIDER_PREFIX,\n  FORM_KINDS,\n  probeInput,\n  recordingCall,\n  tempStore,\n  validAssignments,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nconst stores: TempStore[] = [];\nafterEach(() => {\n  for (const store of stores.splice(0)) store.cleanup();\n});\n\nfunction freshStore(): TempStore {\n  const store = tempStore();\n  stores.push(store);\n  return store;\n}\n\ndescribe(\"TC-1.2: per-kind provider/model routing (AC-1.4)\", () => {\n  it(\"a seeded drain exercises all seven kinds, each call carrying exactly its assigned strings\", async () => {\n    const responses = cannedResponses();\n    const { call, log } = recordingCall(responses);\n    const assignments = validAssignments();\n    const { forms } = await assertRoutingThroughSdk(call, assignments, freshStore());\n\n    for (const kind of FORM_KINDS) {\n      const lane = log.filter((input) => input.model === `${FAKE_MODEL_PREFIX}${kind}`);\n      expect(lane.length).toBeGreaterThan(0);\n      for (const input of lane) {\n        expect(input.provider).toBe(`${FAKE_PROVIDER_PREFIX}${kind}`);\n        expect(input.model).toBe(assignments[kind].model);\n      }\n      // The landed content is the canned text the kind's lane returned —\n      // routing proven end to end, not just at the call log.\n      const ready = forms.filter((form) => form.form === kind && form.state === \"ready\");\n      expect(ready.length).toBeGreaterThan(0);\n      for (const form of ready) {\n        expect(form.content).toBe(responses[kind]);\n      }\n    }\n  });\n\n  it(\"every logged messages value is single-turn shape: system and user roles, string content (AC-1.2)\", async () => {\n    const { call, log } = recordingCall(cannedResponses());\n    await assertRoutingThroughSdk(call, validAssignments(), freshStore());\n\n    expect(log.length).toBeGreaterThan(0);\n    for (const input of log) {\n      expect(input.messages.length).toBeGreaterThan(0);\n      expect(input.messages.some((message) => message.role === \"user\")).toBe(true);\n      for (const message of input.messages) {\n        expect([\"system\", \"user\"]).toContain(message.role);\n        expect(typeof message.content).toBe(\"string\");\n      }\n    }\n  });\n\n  it(\"a three-lane mixed config routes each call by item kind with no cross-kind bleed\", async () => {\n    const lanes = {\n      smoothed_prompt: \"lane-alpha\",\n      tool_call_summary: \"lane-alpha\",\n      tool_result_summary: \"lane-beta\",\n      turn_rendering: \"lane-beta\",\n      lower_band_projection: \"lane-beta\",\n      chunk_summary_detailed: \"lane-gamma\",\n      chunk_summary_brief: \"lane-gamma\",\n    } as const;\n    const assignments = validAssignments({\n      smoothed_prompt: { provider: lanes.smoothed_prompt },\n      tool_call_summary: { provider: lanes.tool_call_summary },\n      tool_result_summary: { provider: lanes.tool_result_summary },\n      turn_rendering: { provider: lanes.turn_rendering },\n      lower_band_projection: { provider: lanes.lower_band_projection },\n      chunk_summary_detailed: { provider: lanes.chunk_summary_detailed },\n      chunk_summary_brief: { provider: lanes.chunk_summary_brief },\n    });\n    const responses = cannedResponses();\n    const { call, log } = recordingCall(responses);\n    const { forms } = await assertRoutingThroughSdk(call, assignments, freshStore());\n\n    for (const kind of FORM_KINDS) {\n      // Models stay unique per kind, so the lane each item actually used is\n      // readable from the log: every call for this kind's model must carry\n      // this kind's lane provider — no bleed from the other lanes.\n      const calls = log.filter((input) => input.model === assignments[kind].model);\n      expect(calls.length).toBeGreaterThan(0);\n      for (const input of calls) {\n        expect(input.provider).toBe(lanes[kind]);\n      }\n      const ready = forms.filter((form) => form.form === kind && form.state === \"ready\");\n      expect(ready.length).toBeGreaterThan(0);\n      for (const form of ready) {\n        expect(form.content).toBe(responses[kind]);\n      }\n    }\n  });\n});\n\ndescribe(\"TC-1.2: fake-host fixture conformance (AC-1.2)\", () => {\n  it(\"assertModelCallContract holds against recordingCall\", async () => {\n    const { call } = recordingCall(cannedResponses());\n    await assertModelCallContract(\n      call,\n      probeInput({\n        provider: `${FAKE_PROVIDER_PREFIX}smoothed_prompt`,\n        model: `${FAKE_MODEL_PREFIX}smoothed_prompt`,\n      }),\n    );\n  });\n});\n","numLines":126,"startLine":1,"totalLines":126}}}

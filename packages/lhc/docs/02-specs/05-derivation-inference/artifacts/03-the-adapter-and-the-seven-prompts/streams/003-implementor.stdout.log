{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WJwRMAcbGmie3QSCwT3neB","type":"tool_result","content":"1\t// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n2\t// biggest single handler — and the two chunk summaries. turn_derivation\n3\t// composes the rendering from message-level forms (compose.ts), sends it\n4\t// through composeTurnRendering then projectLowerBand, hands both forms back\n5\t// for the version-checked completion write, and runs placement in that same\n6\t// completion transaction via the onApplied hook: open-chunk append, the\n7\t// accumulated close policy, and any close's summary enqueues all ride the\n8\t// one commit (anti-shim: a crash leaves either a placed turn with queued\n9\t// summaries or an open chunk — nothing between).\n10\timport { resolveInstancePoke } from \"../../../shared/context.js\";\n11\timport type {\n12\t  DependencyGap,\n13\t  HandlerOutcome,\n14\t  HandlerRunContext,\n15\t  WorkHandler,\n16\t} from \"../../../shared/derivation.js\";\n17\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n18\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n19\timport { composeRenderingInput } from \"./compose.js\";\n20\timport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\n21\timport {\n22\t  chunkExists,\n23\t  readMemberMessages,\n24\t  readMemberProjections,\n25\t  readMessageFormRows,\n26\t  readTurnSource,\n27\t} from \"./forms.js\";\n28\timport { selectOpenTurnIds } from \"./store.js\";\n29\t\n30\tfunction sourceDamaged(reason: string): HandlerOutcome {\n31\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n32\t}\n33\t\n34\tfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n35\t  return { ok: false, retryable: result.retryable, reason: result.reason };\n36\t}\n37\t\n38\tfunction readThreadId(run: HandlerRunContext): string {\n39\t  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n40\t    | { thread_id: string }\n41\t    | undefined;\n42\t  return row?.thread_id ?? \"\";\n43\t}\n44\t\n45\tconst turnDerivationHandler: WorkHandler = async (run, item) => {\n46\t  const turnId = item.sourceRef[\"turnId\"];\n47\t  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n48\t  const db = run.openDb();\n49\t  const turn = readTurnSource(db, turnId);\n50\t  if (turn === undefined || turn.deleted) {\n51\t    // A deleted turn's form rows were dropped with it, so a blocked stamp\n52\t    // would hit nothing; either way the item is terminal against a source\n53\t    // that cannot improve.\n54\t    return sourceDamaged(`turn ${turnId} not found`);\n55\t  }\n56\t  if (turn.status !== \"closed\") {\n57\t    // Derivation is queued only at close; an open turn under a queued item\n58\t    // means the record was interfered with.\n59\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n60\t  }\n61\t  // Epic 01's corruption definition (AC-3.9 there, TC-4.6 here): only the\n62\t  // batch pipeline writes turn state and it never leaves two turns open, so\n63\t  // more than one open turn means the record was damaged below the SDK. A\n64\t  // handler must not compose against a membership it cannot trust; the form\n65\t  // lands blocked naming the damage, and requeue refuses with that reason\n66\t  // until the source reads clean (Story 4).\n67\t  const openTurnIds = selectOpenTurnIds(db);\n68\t  if (openTurnIds.length > 1) {\n69\t    return sourceDamaged(\n70\t      `turn state corrupt: ${openTurnIds.length} turns open (${openTurnIds.join(\", \")})`,\n71\t    );\n72\t  }\n73\t\n74\t  // Compose from current message-form states: ready forms verbatim,\n75\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n76\t  // before any provider call, and no transaction is held across them.\n77\t  const messages = readMemberMessages(db, turnId);\n78\t  const forms = readMessageFormRows(\n79\t    db,\n80\t    messages.map((message) => message.messageId),\n81\t  );\n82\t  const { parts, gaps, receipts } = composeRenderingInput(messages, forms);\n83\t\n84\t  const rendering = await run.provider.composeTurnRendering({ parts });\n85\t  if (!rendering.ok) return providerFailed(rendering);\n86\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n87\t  if (!projection.ok) return providerFailed(projection);\n88\t\n89\t  // The projection's token count is estimated exactly once, here, as the\n90\t  // artifact lands; placement reads this stored arithmetic and never\n91\t  // re-counts (AC-3.9's determinism input).\n92\t  const projectedTokens = estimateTokens(projection.text);\n93\t  const threadId = readThreadId(run);\n94\t  const renderingGaps: DependencyGap[] | undefined = gaps.length > 0 ? gaps : undefined;\n95\t\n96\t  return {\n97\t    ok: true,\n98\t    forms: [\n99\t      {\n100\t        subjectKind: \"turn\",\n101\t        subjectId: turnId,\n102\t        form: \"turn_rendering\",\n103\t        content: rendering.text,\n104\t        ...(renderingGaps === undefined ? {} : { gaps: renderingGaps }),\n105\t        // Tool-run receipts ride the rendering's metadata, mechanically\n106\t        // restated from the composition input (AC-3.8) — the chunk\n107\t        // summaries read them from here, never from provider prose.\n108\t        ...(receipts.length > 0 ? { metadata: { receipts } } : {}),\n109\t      },\n110\t      {\n111\t        subjectKind: \"turn\",\n112\t        subjectId: turnId,\n113\t        form: \"lower_band_projection\",\n114\t        content: projection.text,\n115\t      },\n116\t    ],\n117\t    onApplied: (tx) => {\n118\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n119\t      for (const chunkId of placement.closedChunkIds) {\n120\t        enqueueChunkSummaries(\n121\t          {\n122\t            db: tx.db,\n123\t            clock: run.clock,\n124\t            threadId,\n125\t            onCommit: tx.onCommit,\n126\t            poke: resolveInstancePoke(),\n127\t          },\n128\t          chunkId,\n129\t        );\n130\t      }\n131\t    },\n132\t  };\n133\t};\n134\t\n135\t// One read for both summary kinds — member projections in turn order — but\n136\t// two contracts at the provider seam (AC-3.8): detailed receives the\n137\t// members' tool-run receipts (what changed, outcome) read from the\n138\t// renderings' stamped metadata; brief receives outcomes only, the receipt\n139\t// text stripped here so the brief provider call structurally cannot carry\n140\t// it. Two work items, two handlers' runs, independent retry and states. A\n141\t// member whose projection is not ready falls back to nothing and records a\n142\t// gap, mirroring the rendering's fallback rule.\n143\tfunction chunkSummaryHandler(\n144\t  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n145\t): WorkHandler {\n146\t  return async (run, item) => {\n147\t    const chunkId = item.sourceRef[\"chunkId\"];\n148\t    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n149\t    const db = run.openDb();\n150\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n151\t\n152\t    const members = readMemberProjections(db, chunkId);\n153\t    const memberProjections: string[] = [];\n154\t    const gaps: DependencyGap[] = [];\n155\t    for (const member of members) {\n156\t      if (member.state === \"ready\" && member.content !== undefined) {\n157\t        memberProjections.push(member.content);\n158\t      } else {\n159\t        memberProjections.push(\"\");\n160\t        gaps.push({\n161\t          subjectKind: \"turn\",\n162\t          subjectId: member.turnId,\n163\t          form: \"lower_band_projection\",\n164\t        });\n165\t      }\n166\t    }\n167\t\n168\t    const result =\n169\t      kind === \"chunk_summary_detailed\"\n170\t        ? await run.provider.summarizeChunkDetailed({\n171\t            memberProjections,\n172\t            memberReceipts: members.map((member) => member.receipts),\n173\t          })\n174\t        : await run.provider.summarizeChunkBrief({\n175\t            memberProjections,\n176\t            memberOutcomes: members.map((member) =>\n177\t              member.receipts.map((receipt) => receipt.outcome),\n178\t            ),\n179\t          });\n180\t    if (!result.ok) return providerFailed(result);\n181\t\n182\t    return {\n183\t      ok: true,\n184\t      forms: [\n185\t        {\n186\t          subjectKind: \"chunk\",\n187\t          subjectId: chunkId,\n188\t          form: kind,\n189\t          content: result.text,\n190\t          ...(gaps.length > 0 ? { gaps } : {}),\n191\t        },\n192\t      ],\n193\t    };\n194\t  };\n195\t}\n196\t\n197\t// The domain's handler table, merged into the SDK dispatch map at\n198\t// construction (DD-6).\n199\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n200\t  turn_derivation: turnDerivationHandler,\n201\t  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n202\t  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n203\t};\n204\t"}]},"parent_tool_use_id":null,"session_id":"d415efd0-0780-463c-9946-d0cae549777f","uuid":"d5448c18-9463-4792-8d14-6f2f826f5bfe","timestamp":"2026-06-12T22:14:48.022Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/derive.ts","content":"// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n// biggest single handler — and the two chunk summaries. turn_derivation\n// composes the rendering from message-level forms (compose.ts), sends it\n// through composeTurnRendering then projectLowerBand, hands both forms back\n// for the version-checked completion write, and runs placement in that same\n// completion transaction via the onApplied hook: open-chunk append, the\n// accumulated close policy, and any close's summary enqueues all ride the\n// one commit (anti-shim: a crash leaves either a placed turn with queued\n// summaries or an open chunk — nothing between).\nimport { resolveInstancePoke } from \"../../../shared/context.js\";\nimport type {\n  DependencyGap,\n  HandlerOutcome,\n  HandlerRunContext,\n  WorkHandler,\n} from \"../../../shared/derivation.js\";\nimport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\nimport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\nimport { composeRenderingInput } from \"./compose.js\";\nimport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\nimport {\n  chunkExists,\n  readMemberMessages,\n  readMemberProjections,\n  readMessageFormRows,\n  readTurnSource,\n} from \"./forms.js\";\nimport { selectOpenTurnIds } from \"./store.js\";\n\nfunction sourceDamaged(reason: string): HandlerOutcome {\n  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n}\n\nfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n  return { ok: false, retryable: result.retryable, reason: result.reason };\n}\n\nfunction readThreadId(run: HandlerRunContext): string {\n  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n    | { thread_id: string }\n    | undefined;\n  return row?.thread_id ?? \"\";\n}\n\nconst turnDerivationHandler: WorkHandler = async (run, item) => {\n  const turnId = item.sourceRef[\"turnId\"];\n  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n  const db = run.openDb();\n  const turn = readTurnSource(db, turnId);\n  if (turn === undefined || turn.deleted) {\n    // A deleted turn's form rows were dropped with it, so a blocked stamp\n    // would hit nothing; either way the item is terminal against a source\n    // that cannot improve.\n    return sourceDamaged(`turn ${turnId} not found`);\n  }\n  if (turn.status !== \"closed\") {\n    // Derivation is queued only at close; an open turn under a queued item\n    // means the record was interfered with.\n    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n  }\n  // Epic 01's corruption definition (AC-3.9 there, TC-4.6 here): only the\n  // batch pipeline writes turn state and it never leaves two turns open, so\n  // more than one open turn means the record was damaged below the SDK. A\n  // handler must not compose against a membership it cannot trust; the form\n  // lands blocked naming the damage, and requeue refuses with that reason\n  // until the source reads clean (Story 4).\n  const openTurnIds = selectOpenTurnIds(db);\n  if (openTurnIds.length > 1) {\n    return sourceDamaged(\n      `turn state corrupt: ${openTurnIds.length} turns open (${openTurnIds.join(\", \")})`,\n    );\n  }\n\n  // Compose from current message-form states: ready forms verbatim,\n  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n  // before any provider call, and no transaction is held across them.\n  const messages = readMemberMessages(db, turnId);\n  const forms = readMessageFormRows(\n    db,\n    messages.map((message) => message.messageId),\n  );\n  const { parts, gaps, receipts } = composeRenderingInput(messages, forms);\n\n  const rendering = await run.provider.composeTurnRendering({ parts });\n  if (!rendering.ok) return providerFailed(rendering);\n  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n  if (!projection.ok) return providerFailed(projection);\n\n  // The projection's token count is estimated exactly once, here, as the\n  // artifact lands; placement reads this stored arithmetic and never\n  // re-counts (AC-3.9's determinism input).\n  const projectedTokens = estimateTokens(projection.text);\n  const threadId = readThreadId(run);\n  const renderingGaps: DependencyGap[] | undefined = gaps.length > 0 ? gaps : undefined;\n\n  return {\n    ok: true,\n    forms: [\n      {\n        subjectKind: \"turn\",\n        subjectId: turnId,\n        form: \"turn_rendering\",\n        content: rendering.text,\n        ...(renderingGaps === undefined ? {} : { gaps: renderingGaps }),\n        // Tool-run receipts ride the rendering's metadata, mechanically\n        // restated from the composition input (AC-3.8) — the chunk\n        // summaries read them from here, never from provider prose.\n        ...(receipts.length > 0 ? { metadata: { receipts } } : {}),\n      },\n      {\n        subjectKind: \"turn\",\n        subjectId: turnId,\n        form: \"lower_band_projection\",\n        content: projection.text,\n      },\n    ],\n    onApplied: (tx) => {\n      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n      for (const chunkId of placement.closedChunkIds) {\n        enqueueChunkSummaries(\n          {\n            db: tx.db,\n            clock: run.clock,\n            threadId,\n            onCommit: tx.onCommit,\n            poke: resolveInstancePoke(),\n          },\n          chunkId,\n        );\n      }\n    },\n  };\n};\n\n// One read for both summary kinds — member projections in turn order — but\n// two contracts at the provider seam (AC-3.8): detailed receives the\n// members' tool-run receipts (what changed, outcome) read from the\n// renderings' stamped metadata; brief receives outcomes only, the receipt\n// text stripped here so the brief provider call structurally cannot carry\n// it. Two work items, two handlers' runs, independent retry and states. A\n// member whose projection is not ready falls back to nothing and records a\n// gap, mirroring the rendering's fallback rule.\nfunction chunkSummaryHandler(\n  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n): WorkHandler {\n  return async (run, item) => {\n    const chunkId = item.sourceRef[\"chunkId\"];\n    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n    const db = run.openDb();\n    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n\n    const members = readMemberProjections(db, chunkId);\n    const memberProjections: string[] = [];\n    const gaps: DependencyGap[] = [];\n    for (const member of members) {\n      if (member.state === \"ready\" && member.content !== undefined) {\n        memberProjections.push(member.content);\n      } else {\n        memberProjections.push(\"\");\n        gaps.push({\n          subjectKind: \"turn\",\n          subjectId: member.turnId,\n          form: \"lower_band_projection\",\n        });\n      }\n    }\n\n    const result =\n      kind === \"chunk_summary_detailed\"\n        ? await run.provider.summarizeChunkDetailed({\n            memberProjections,\n            memberReceipts: members.map((member) => member.receipts),\n          })\n        : await run.provider.summarizeChunkBrief({\n            memberProjections,\n            memberOutcomes: members.map((member) =>\n              member.receipts.map((receipt) => receipt.outcome),\n            ),\n          });\n    if (!result.ok) return providerFailed(result);\n\n    return {\n      ok: true,\n      forms: [\n        {\n          subjectKind: \"chunk\",\n          subjectId: chunkId,\n          form: kind,\n          content: result.text,\n          ...(gaps.length > 0 ? { gaps } : {}),\n        },\n      ],\n    };\n  };\n}\n\n// The domain's handler table, merged into the SDK dispatch map at\n// construction (DD-6).\nexport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n  turn_derivation: turnDerivationHandler,\n  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n};\n","numLines":204,"startLine":1,"totalLines":204}}}

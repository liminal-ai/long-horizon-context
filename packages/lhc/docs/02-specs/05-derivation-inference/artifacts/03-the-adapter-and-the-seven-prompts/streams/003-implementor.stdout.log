{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XuejrketWUFYVuzPGiWHgq","type":"tool_result","content":"1\timport { complete, getModel, type Usage } from \"@earendil-works/pi-ai\";\n2\timport { AuthStorage } from \"@earendil-works/pi-coding-agent\";\n3\t\n4\timport {\n5\t  USER_PROMPT_SMOOTHING_PROMPT_VERSION,\n6\t  type UserPromptSmoothingProvider,\n7\t  type UserPromptSmoothingProviderInput,\n8\t  type UserPromptSmoothingProviderOutput,\n9\t} from \"./user-prompt-smoothing-service.js\";\n10\t\n11\tconst SYSTEM_PROMPT = `You smooth user prompts for long-horizon coding context.\n12\t\n13\tPreserve the user's intent, uncertainty, explicit constraints, file paths, commands, identifiers, numbers, thresholds, and priorities.\n14\tWhen protected literals are provided, copy each one exactly; do not normalize, shorten, spell-correct, or regenerate those strings.\n15\tFix typos, grammar, capitalization, and whitespace.\n16\tReduce repetition, anger, profanity, and attention-spiking phrasing without moralizing, apologizing, or adding therapeutic framing.\n17\tReturn only the smoothed prompt text.`;\n18\t\n19\tconst MODEL = getModel(\"openai-codex\", \"gpt-5.4-mini\");\n20\t\n21\tfunction usageToRecord(usage: Usage | undefined): Record<string, unknown> | undefined {\n22\t  return usage ? { ...usage } : undefined;\n23\t}\n24\t\n25\texport interface PiCodexUserPromptSmoothingProviderOptions {\n26\t  authStorage?: Pick<AuthStorage, \"getApiKey\">;\n27\t  authPath?: string;\n28\t  timeoutMs?: number;\n29\t  now?: () => Date;\n30\t}\n31\t\n32\texport class PiCodexUserPromptSmoothingProvider implements UserPromptSmoothingProvider {\n33\t  constructor(private readonly options: PiCodexUserPromptSmoothingProviderOptions = {}) {}\n34\t\n35\t  async smoothUserPrompt(input: UserPromptSmoothingProviderInput): Promise<UserPromptSmoothingProviderOutput> {\n36\t    const startedAt = Date.now();\n37\t    const authStorage = this.options.authStorage ?? AuthStorage.create(this.options.authPath);\n38\t    const apiKey = await authStorage.getApiKey(\"openai-codex\");\n39\t    if (!apiKey) {\n40\t      throw new Error(\"OpenAI Codex OAuth credential is not configured for provider openai-codex.\");\n41\t    }\n42\t\n43\t    const response = await complete(\n44\t      MODEL,\n45\t      {\n46\t        systemPrompt: SYSTEM_PROMPT,\n47\t        messages: [\n48\t          {\n49\t            role: \"user\",\n50\t            content: [\n51\t              {\n52\t                type: \"text\",\n53\t                text: input.protectedLiterals.length > 0\n54\t                  ? [\n55\t                      \"Protected literals that must appear exactly in the output:\",\n56\t                      ...input.protectedLiterals.map((literal) => `- ${literal}`),\n57\t                      \"\",\n58\t                      \"Prompt to smooth:\",\n59\t                      input.rawText,\n60\t                    ].join(\"\\n\")\n61\t                  : input.rawText,\n62\t              },\n63\t            ],\n64\t            timestamp: Date.now(),\n65\t          },\n66\t        ],\n67\t      },\n68\t      {\n69\t        apiKey,\n70\t        reasoningEffort: \"none\","}]},"parent_tool_use_id":null,"session_id":"d415efd0-0780-463c-9946-d0cae549777f","uuid":"cb6d0c74-a44f-4976-901a-77662d53a6de","timestamp":"2026-06-12T22:14:38.561Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/src/thread/async-thread/services/pi-codex-user-prompt-smoothing-provider.ts","content":"import { complete, getModel, type Usage } from \"@earendil-works/pi-ai\";\nimport { AuthStorage } from \"@earendil-works/pi-coding-agent\";\n\nimport {\n  USER_PROMPT_SMOOTHING_PROMPT_VERSION,\n  type UserPromptSmoothingProvider,\n  type UserPromptSmoothingProviderInput,\n  type UserPromptSmoothingProviderOutput,\n} from \"./user-prompt-smoothing-service.js\";\n\nconst SYSTEM_PROMPT = `You smooth user prompts for long-horizon coding context.\n\nPreserve the user's intent, uncertainty, explicit constraints, file paths, commands, identifiers, numbers, thresholds, and priorities.\nWhen protected literals are provided, copy each one exactly; do not normalize, shorten, spell-correct, or regenerate those strings.\nFix typos, grammar, capitalization, and whitespace.\nReduce repetition, anger, profanity, and attention-spiking phrasing without moralizing, apologizing, or adding therapeutic framing.\nReturn only the smoothed prompt text.`;\n\nconst MODEL = getModel(\"openai-codex\", \"gpt-5.4-mini\");\n\nfunction usageToRecord(usage: Usage | undefined): Record<string, unknown> | undefined {\n  return usage ? { ...usage } : undefined;\n}\n\nexport interface PiCodexUserPromptSmoothingProviderOptions {\n  authStorage?: Pick<AuthStorage, \"getApiKey\">;\n  authPath?: string;\n  timeoutMs?: number;\n  now?: () => Date;\n}\n\nexport class PiCodexUserPromptSmoothingProvider implements UserPromptSmoothingProvider {\n  constructor(private readonly options: PiCodexUserPromptSmoothingProviderOptions = {}) {}\n\n  async smoothUserPrompt(input: UserPromptSmoothingProviderInput): Promise<UserPromptSmoothingProviderOutput> {\n    const startedAt = Date.now();\n    const authStorage = this.options.authStorage ?? AuthStorage.create(this.options.authPath);\n    const apiKey = await authStorage.getApiKey(\"openai-codex\");\n    if (!apiKey) {\n      throw new Error(\"OpenAI Codex OAuth credential is not configured for provider openai-codex.\");\n    }\n\n    const response = await complete(\n      MODEL,\n      {\n        systemPrompt: SYSTEM_PROMPT,\n        messages: [\n          {\n            role: \"user\",\n            content: [\n              {\n                type: \"text\",\n                text: input.protectedLiterals.length > 0\n                  ? [\n                      \"Protected literals that must appear exactly in the output:\",\n                      ...input.protectedLiterals.map((literal) => `- ${literal}`),\n                      \"\",\n                      \"Prompt to smooth:\",\n                      input.rawText,\n                    ].join(\"\\n\")\n                  : input.rawText,\n              },\n            ],\n            timestamp: Date.now(),\n          },\n        ],\n      },\n      {\n        apiKey,\n        reasoningEffort: \"none\",","numLines":70,"startLine":1,"totalLines":114}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lo21ydQ2fMxQTJ43XRTEB3","type":"tool_result","content":"1\t// Epic 05 Story 5 — TC-4.1, TC-4.2, TC-4.3: the opt-in real-inference suite\n2\t// and the real-adapter lifecycle capstone (AC-4.1, AC-4.2, AC-1.2).\n3\t//\n4\t// The suite keys on LHC_OPENROUTER_KEY, resolved ONCE at module load by the\n5\t// suite-level guard: exactly one ran/not-ran line lands in run output, and\n6\t// the accounting tests below always run, so absence of the key can never\n7\t// produce a silent pass — unkeyed runs show one NOT-RAN line, a green\n8\t// accounting leg that asserted the not-ran record, and the keyed legs\n9\t// reported as skipped (never as passes). This is the CI-default posture:\n10\t// zero network calls. With the key present, the seven derivation kinds\n11\t// round-trip a real endpoint, the same seam-conformance helpers that ran\n12\t// against the fake host run against the real one unchanged (DD-13), and the\n13\t// Epic 04 lifecycle sequence completes under the real adapter with\n14\t// structural assertions: ready forms, non-marker content, real-model\n15\t// provenance, mutation regeneration, coherent checkpoints.\n16\timport { readFileSync } from \"node:fs\";\n17\timport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\n18\timport type {\n19\t  DerivedForm,\n20\t  HealthReport,\n21\t  MutationResult,\n22\t  OpResult,\n23\t} from \"../src/index.js\";\n24\timport {\n25\t  assertModelCallContract,\n26\t  assertRoutingThroughSdk,\n27\t  createOpenRouterCall,\n28\t  DEFAULT_OPENROUTER_MODEL,\n29\t  DELETED_MESSAGE_TEXT,\n30\t  EDITED_MESSAGE_TEXT,\n31\t  emitRealSuiteAccounting,\n32\t  FORM_KINDS,\n33\t  probeInput,\n34\t  readDerivedForms,\n35\t  realSuiteAccountingEmissions,\n36\t  resolveRealSuiteEnv,\n37\t  runLifecycle,\n38\t  tempStore,\n39\t  validAssignments,\n40\t  type FormKind,\n41\t  type LifecycleRun,\n42\t  type RoutingRunResult,\n43\t  type TempStore,\n44\t} from \"./fixtures/index.js\";\n45\t\n46\t// ── the suite-level guard: one resolution, one visible line ───────\n47\tconst suiteEnv = resolveRealSuiteEnv(process.env);\n48\tconst keyed = !(\"notRan\" in suiteEnv);\n49\tconst realKey = \"notRan\" in suiteEnv ? undefined : suiteEnv.key;\n50\tconst realModel = \"notRan\" in suiteEnv ? DEFAULT_OPENROUTER_MODEL : suiteEnv.model;\n51\temitRealSuiteAccounting(suiteEnv);\n52\t\n53\t// The deterministic provider's signature, two grains: the design's anchored\n54\t// form-content pattern, and a digest-bearing scan pattern for \"appears\n55\t// anywhere\" sweeps over served views and materialized files.\n56\tconst MARKER_AT_START =\n57\t  /^(?:smoothed|toolcall|toolresult|rendering|projection|detailed|brief)\\(/;\n58\tconst MARKER_ANYWHERE =\n59\t  /(?:smoothed|toolcall|toolresult|rendering|projection|detailed|brief)\\([0-9a-f]{8}:/;\n60\t\n61\tfunction ok<T>(result: OpResult<T>): T {\n62\t  if (!result.ok) {\n63\t    throw new Error(`expected ok result: ${JSON.stringify(result.error)}`);\n64\t  }\n65\t  return result.value;\n66\t}\n67\t\n68\t// All seven kinds assigned to the one real lane; prompt names stay the\n69\t// registry defaults validAssignments already wires.\n70\tfunction realAssignments(model: string): ReturnType<typeof validAssignments> {\n71\t  const overrides: Partial<Record<FormKind, { provider: string; model: string }>> = {};\n72\t  for (const kind of FORM_KINDS) {\n73\t    overrides[kind] = { provider: \"openrouter\", model };\n74\t  }\n75\t  return validAssignments(overrides);\n76\t}\n77\t\n78\t// ── TC-4.1: accounting — these tests run keyed or not ─────────────\n79\t\n80\tdescribe(\"TC-4.1 / AC-4.1: ran/not-ran accounting is always visible\", () => {\n81\t  it(\"the unkeyed guard returns a not-ran record with reason, never a pass-shaped record\", () => {\n82\t    const record = resolveRealSuiteEnv({});\n83\t    expect(\"notRan\" in record).toBe(true);\n84\t    if (!(\"notRan\" in record)) throw new Error(\"unreachable\");\n85\t    expect(record.notRan).toContain(\"LHC_OPENROUTER_KEY\");\n86\t    // Distinguishable from a pass: the not-ran shape carries no key/model —\n87\t    // nothing downstream can construct a keyed run from it.\n88\t    expect(\"key\" in record).toBe(false);\n89\t    expect(\"model\" in record).toBe(false);\n90\t  });\n91\t\n92\t  it(\"a whitespace-only key is unset, not a silent keyed run\", () => {\n93\t    const record = resolveRealSuiteEnv({ LHC_OPENROUTER_KEY: \"   \" });\n94\t    expect(\"notRan\" in record).toBe(true);\n95\t  });\n96\t\n97\t  it(\"a keyed env resolves key and model, defaulting the model when unset\", () => {\n98\t    const defaulted = resolveRealSuiteEnv({ LHC_OPENROUTER_KEY: \"test-key\" });\n99\t    expect(defaulted).toEqual({ key: \"test-key\", model: DEFAULT_OPENROUTER_MODEL });\n100\t    const explicit = resolveRealSuiteEnv({\n101\t      LHC_OPENROUTER_KEY: \"test-key\",\n102\t      LHC_OPENROUTER_MODEL: \"vendor/cheap-model\",\n103\t    });\n104\t    expect(explicit).toEqual({ key: \"test-key\", model: \"vendor/cheap-model\" });\n105\t  });\n106\t\n107\t  it(\"the suite-level guard emitted exactly one ran/not-ran line into run output\", () => {\n108\t    const emissions = realSuiteAccountingEmissions();\n109\t    expect(emissions).toHaveLength(1);\n110\t    expect(emissions[0]).toBe(\n111\t      keyed\n112\t        ? `RAN: real-inference (model ${realModel})`\n113\t        : \"NOT-RAN: real-inference (LHC_OPENROUTER_KEY unset)\",\n114\t    );\n115\t  });\n116\t});\n117\t\n118\t// ── TC-4.1 / TC-4.3: keyed seven-kind round-trips + conformance ───\n119\t\n120\tdescribe.runIf(keyed)(\n121\t  \"TC-4.1 / TC-4.3 (keyed): seven real round-trips through the shared seam helpers\",\n122\t  () => {\n123\t    const call = realKey === undefined ? undefined : createOpenRouterCall(realKey, realModel);\n124\t    const assignments = realAssignments(realModel);\n125\t    let store: TempStore;\n126\t    let routing: RoutingRunResult;\n127\t\n128\t    beforeAll(async () => {\n129\t      store = tempStore();\n130\t      if (call === undefined) throw new Error(\"keyed leg started without a key\");\n131\t      // TC-4.3: the SAME routing helper Story 2's fake-host seam test runs,\n132\t      // unchanged, against the real host — it drives a real intake → drain\n133\t      // exercising all seven kinds and asserts routing, lane coverage, and\n134\t      // single-turn message shape internally.\n135\t      routing = await assertRoutingThroughSdk(call, assignments, store);\n136\t    }, 300_000);\n137\t    afterAll(() => {\n138\t      store.cleanup();\n139\t    });\n140\t\n141\t    it(\n142\t      \"TC-4.3: the real host function passes the ModelCall contract on a real probe\",\n143\t      async () => {\n144\t        if (call === undefined) throw new Error(\"keyed leg started without a key\");\n145\t        await assertModelCallContract(\n146\t          call,\n147\t          probeInput({ provider: \"openrouter\", model: realModel }),\n148\t        );\n149\t      },\n150\t      120_000,\n151\t    );\n152\t\n153\t    it(\"TC-4.1: each of the seven kinds round-tripped real inference to a ready form\", () => {\n154\t      for (const kind of FORM_KINDS) {\n155\t        const ready = routing.forms.filter(\n156\t          (form) => form.form === kind && form.state === \"ready\",\n157\t        );\n158\t        expect(ready.length).toBeGreaterThan(0);\n159\t        for (const form of ready) {\n160\t          expect(form.content).toBeDefined();\n161\t          expect((form.content ?? \"\").trim()).not.toBe(\"\");\n162\t          expect(form.content).not.toMatch(MARKER_AT_START);\n163\t          expect(form.content).not.toMatch(MARKER_ANYWHERE);\n164\t          // Provenance names the real lane from config, never model output.\n165\t          expect(form.metadata?.provenance).toEqual({\n166\t            provider: \"openrouter\",\n167\t            model: realModel,\n168\t            prompt: assignments[form.form].prompt,\n169\t          });\n170\t        }\n171\t      }\n172\t    });\n173\t  },\n174\t);\n175\t\n176\t// ── TC-4.2: the real-adapter lifecycle capstone ───────────────────\n177\t\n178\tdescribe.runIf(keyed)(\"TC-4.2 (keyed): Epic 04 lifecycle capstone under the real adapter\", () => {\n179\t  let store: TempStore;\n180\t  let run: LifecycleRun;\n181\t  let preEditForms: DerivedForm[] = [];\n182\t  let finalForms: DerivedForm[] = [];\n183\t\n184\t  beforeAll(async () => {\n185\t    store = tempStore();\n186\t    if (\"notRan\" in suiteEnv) throw new Error(\"keyed leg started without a key\");\n187\t    const call = createOpenRouterCall(suiteEnv.key, realModel);\n188\t    // The Epic 04 sequence verbatim — intake, drain, compact, pull, inspect,\n189\t    // edit, rebuild, drain, compact, materialize — with the inference\n190\t    // adapter in the provider-arrival slot (the one swap point).\n191\t    run = await runLifecycle(store, {\n192\t      name: \"real-capstone\",\n193\t      inference: { call, assignments: realAssignments(realModel) },\n194\t      onCheckpoint: (checkpoint, ctx) => {\n195\t        // Pre-mutation snapshot: the regeneration assertion compares each\n196\t        // mutation-cleared form's content before the edit and after rebuild.\n197\t        if (checkpoint === \"inspect1\") preEditForms = readDerivedForms(ctx.filePath);\n198\t        return Promise.resolve();\n199\t      },\n200\t    });\n201\t    finalForms = readDerivedForms(run.filePath);\n202\t  }, 1_800_000);\n203\t  afterAll(() => {\n204\t    store.cleanup();\n205\t  });\n206\t\n207\t  it(\"every derivation kind lands ready at least once with non-empty content\", () => {\n208\t    for (const kind of FORM_KINDS) {\n209\t      const ready = finalForms.filter((form) => form.form === kind && form.state === \"ready\");\n210\t      expect(ready.length).toBeGreaterThan(0);\n211\t      for (const form of ready) {\n212\t        expect((form.content ?? \"\").trim()).not.toBe(\"\");\n213\t      }\n214\t    }\n215\t  });\n216\t\n217\t  it(\"no deterministic marker pattern appears anywhere — forms, served views, materialized file\", () => {\n218\t    for (const form of finalForms) {\n219\t      if (form.content === undefined) continue;\n220\t      expect(form.content).not.toMatch(MARKER_AT_START);\n221\t      expect(form.content).not.toMatch(MARKER_ANYWHERE);\n222\t    }\n223\t    for (const pull of [ok(run.phases.pull1), ok(run.phases.pull2)]) {\n224\t      for (const message of pull.messages) {\n225\t        expect(message.content).not.toMatch(MARKER_ANYWHERE);\n226\t      }\n227\t    }\n228\t    expect(readFileSync(run.outPath, \"utf8\")).not.toMatch(MARKER_ANYWHERE);\n229\t  });\n230\t\n231\t  it(\"provenance on every ready form names the real model\", () => {\n232\t    for (const form of finalForms) {\n233\t      if (form.state !== \"ready\") continue;\n234\t      expect(form.metadata?.provenance?.provider).toBe(\"openrouter\");\n235\t      expect(form.metadata?.provenance?.model).toBe(realModel);\n236\t    }\n237\t  });\n238\t\n239\t  it(\"mutation-cleared forms went cleared-then-ready and regenerated with different content\", () => {\n240\t    const cleared = [\n241\t      ...ok(run.phases.mutate.edit).cleared,\n242\t      ...ok(run.phases.mutate.delete).cleared,\n243\t    ];\n244\t    expect(cleared.length).toBeGreaterThan(0);\n245\t    const find = (forms: DerivedForm[], target: (typeof cleared)[number]): DerivedForm | undefined =>\n246\t      forms.find(\n247\t        (form) =>\n248\t          form.subjectKind === target.subjectKind &&\n249\t          form.subjectId === target.subjectId &&\n250\t          form.form === target.form,\n251\t      );\n252\t    for (const target of cleared) {\n253\t      const before = find(preEditForms, target);\n254\t      const after = find(finalForms, target);\n255\t      // Cleared-then-ready: ready before the mutation (pre-edit snapshot),\n256\t      // pending in the mutate-phase health below, ready again after rebuild.\n257\t      expect(before?.state).toBe(\"ready\");\n258\t      expect(after?.state).toBe(\"ready\");\n259\t      expect(after?.content).toBeDefined();\n260\t      expect(after?.content).not.toBe(before?.content);\n261\t    }\n262\t  });\n263\t\n264\t  it(\"health is coherent at each checkpoint: settled, cleared-set pending, settled again\", () => {\n265\t    // Checkpoint 1 — post-drain status: derivation fully settled before the\n266\t    // first compact.\n267\t    const status = ok(run.phases.status);\n268\t    expect(status.derivation).toEqual({ pending: 0, retrying: 0, failed: 0, blocked: 0 });\n269\t\n270\t    // Checkpoint 2 — immediately after the mutations: exactly the cleared\n271\t    // set is in flight, queued and unclaimed (cleared → pending around\n272\t    // mutations).\n273\t    const clearedCount =\n274\t      ok(run.phases.mutate.edit).cleared.length + ok(run.phases.mutate.delete).cleared.length;\n275\t    const healthAfterMutate = ok(run.phases.mutate.healthAfterMutate);\n276\t    const inFlight = healthAfterMutate.owners.reduce(\n277\t      (sum, row) => sum + row.counts.pending + row.counts.retrying,\n278\t      0,\n279\t    );\n280\t    expect(inFlight).toBe(clearedCount);\n281\t    expect(healthAfterMutate.queue).toEqual({ queued: clearedCount, claimed: 0 });\n282\t    expect(healthAfterMutate.failures).toEqual([]);\n283\t\n284\t    // Checkpoint 3 — post-rebuild: everything ready, nothing failed or\n285\t    // blocked, queue empty.\n286\t    const health2: HealthReport = ok(run.phases.health2);\n287\t    for (const row of health2.owners) {\n288\t      expect(row.counts.pending).toBe(0);\n289\t      expect(row.counts.retrying).toBe(0);\n290\t      expect(row.counts.failed).toBe(0);\n291\t      expect(row.counts.blocked).toBe(0);\n292\t      expect(row.counts.ready).toBeGreaterThan(0);\n293\t    }\n294\t    expect(health2.failures).toEqual([]);\n295\t    expect(health2.queue).toEqual({ queued: 0, claimed: 0 });\n296\t  });\n297\t\n298\t  it(\"the second compact's view reflects post-edit content\", () => {\n299\t    const pull2 = ok(run.phases.pull2);\n300\t    expect(\n301\t      pull2.messages.some(\n302\t        (message) =>\n303\t          message.band === undefined &&\n304\t          message.role === \"user\" &&\n305\t          message.content === EDITED_MESSAGE_TEXT,\n306\t      ),\n307\t    ).toBe(true);\n308\t    expect(pull2.messages.some((m) => m.content.includes(DELETED_MESSAGE_TEXT))).toBe(false);\n309\t    expect(\n310\t      pull2.messages.some((m) => m.content === \"turn 12: please investigate area 12\"),\n311\t    ).toBe(false);\n312\t  });\n313\t\n314\t  it(\"mutation results carried queued replacement work (the cleared set was re-derived, not left stale)\", () => {\n315\t    const edit: MutationResult = ok(run.phases.mutate.edit);\n316\t    const deleted: MutationResult = ok(run.phases.mutate.delete);\n317\t    expect(edit.queued.length).toBeGreaterThan(0);\n318\t    expect(deleted.queued.length).toBeGreaterThan(0);\n319\t  });\n320\t});\n321\t"}]},"parent_tool_use_id":null,"session_id":"40f6c7de-865c-49b2-84c6-8862983c5a5a","uuid":"4a6d88e1-b457-4e4b-85d1-585db48f8a27","timestamp":"2026-06-13T00:27:01.776Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/inference-real.test.ts","content":"// Epic 05 Story 5 — TC-4.1, TC-4.2, TC-4.3: the opt-in real-inference suite\n// and the real-adapter lifecycle capstone (AC-4.1, AC-4.2, AC-1.2).\n//\n// The suite keys on LHC_OPENROUTER_KEY, resolved ONCE at module load by the\n// suite-level guard: exactly one ran/not-ran line lands in run output, and\n// the accounting tests below always run, so absence of the key can never\n// produce a silent pass — unkeyed runs show one NOT-RAN line, a green\n// accounting leg that asserted the not-ran record, and the keyed legs\n// reported as skipped (never as passes). This is the CI-default posture:\n// zero network calls. With the key present, the seven derivation kinds\n// round-trip a real endpoint, the same seam-conformance helpers that ran\n// against the fake host run against the real one unchanged (DD-13), and the\n// Epic 04 lifecycle sequence completes under the real adapter with\n// structural assertions: ready forms, non-marker content, real-model\n// provenance, mutation regeneration, coherent checkpoints.\nimport { readFileSync } from \"node:fs\";\nimport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\nimport type {\n  DerivedForm,\n  HealthReport,\n  MutationResult,\n  OpResult,\n} from \"../src/index.js\";\nimport {\n  assertModelCallContract,\n  assertRoutingThroughSdk,\n  createOpenRouterCall,\n  DEFAULT_OPENROUTER_MODEL,\n  DELETED_MESSAGE_TEXT,\n  EDITED_MESSAGE_TEXT,\n  emitRealSuiteAccounting,\n  FORM_KINDS,\n  probeInput,\n  readDerivedForms,\n  realSuiteAccountingEmissions,\n  resolveRealSuiteEnv,\n  runLifecycle,\n  tempStore,\n  validAssignments,\n  type FormKind,\n  type LifecycleRun,\n  type RoutingRunResult,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\n// ── the suite-level guard: one resolution, one visible line ───────\nconst suiteEnv = resolveRealSuiteEnv(process.env);\nconst keyed = !(\"notRan\" in suiteEnv);\nconst realKey = \"notRan\" in suiteEnv ? undefined : suiteEnv.key;\nconst realModel = \"notRan\" in suiteEnv ? DEFAULT_OPENROUTER_MODEL : suiteEnv.model;\nemitRealSuiteAccounting(suiteEnv);\n\n// The deterministic provider's signature, two grains: the design's anchored\n// form-content pattern, and a digest-bearing scan pattern for \"appears\n// anywhere\" sweeps over served views and materialized files.\nconst MARKER_AT_START =\n  /^(?:smoothed|toolcall|toolresult|rendering|projection|detailed|brief)\\(/;\nconst MARKER_ANYWHERE =\n  /(?:smoothed|toolcall|toolresult|rendering|projection|detailed|brief)\\([0-9a-f]{8}:/;\n\nfunction ok<T>(result: OpResult<T>): T {\n  if (!result.ok) {\n    throw new Error(`expected ok result: ${JSON.stringify(result.error)}`);\n  }\n  return result.value;\n}\n\n// All seven kinds assigned to the one real lane; prompt names stay the\n// registry defaults validAssignments already wires.\nfunction realAssignments(model: string): ReturnType<typeof validAssignments> {\n  const overrides: Partial<Record<FormKind, { provider: string; model: string }>> = {};\n  for (const kind of FORM_KINDS) {\n    overrides[kind] = { provider: \"openrouter\", model };\n  }\n  return validAssignments(overrides);\n}\n\n// ── TC-4.1: accounting — these tests run keyed or not ─────────────\n\ndescribe(\"TC-4.1 / AC-4.1: ran/not-ran accounting is always visible\", () => {\n  it(\"the unkeyed guard returns a not-ran record with reason, never a pass-shaped record\", () => {\n    const record = resolveRealSuiteEnv({});\n    expect(\"notRan\" in record).toBe(true);\n    if (!(\"notRan\" in record)) throw new Error(\"unreachable\");\n    expect(record.notRan).toContain(\"LHC_OPENROUTER_KEY\");\n    // Distinguishable from a pass: the not-ran shape carries no key/model —\n    // nothing downstream can construct a keyed run from it.\n    expect(\"key\" in record).toBe(false);\n    expect(\"model\" in record).toBe(false);\n  });\n\n  it(\"a whitespace-only key is unset, not a silent keyed run\", () => {\n    const record = resolveRealSuiteEnv({ LHC_OPENROUTER_KEY: \"   \" });\n    expect(\"notRan\" in record).toBe(true);\n  });\n\n  it(\"a keyed env resolves key and model, defaulting the model when unset\", () => {\n    const defaulted = resolveRealSuiteEnv({ LHC_OPENROUTER_KEY: \"test-key\" });\n    expect(defaulted).toEqual({ key: \"test-key\", model: DEFAULT_OPENROUTER_MODEL });\n    const explicit = resolveRealSuiteEnv({\n      LHC_OPENROUTER_KEY: \"test-key\",\n      LHC_OPENROUTER_MODEL: \"vendor/cheap-model\",\n    });\n    expect(explicit).toEqual({ key: \"test-key\", model: \"vendor/cheap-model\" });\n  });\n\n  it(\"the suite-level guard emitted exactly one ran/not-ran line into run output\", () => {\n    const emissions = realSuiteAccountingEmissions();\n    expect(emissions).toHaveLength(1);\n    expect(emissions[0]).toBe(\n      keyed\n        ? `RAN: real-inference (model ${realModel})`\n        : \"NOT-RAN: real-inference (LHC_OPENROUTER_KEY unset)\",\n    );\n  });\n});\n\n// ── TC-4.1 / TC-4.3: keyed seven-kind round-trips + conformance ───\n\ndescribe.runIf(keyed)(\n  \"TC-4.1 / TC-4.3 (keyed): seven real round-trips through the shared seam helpers\",\n  () => {\n    const call = realKey === undefined ? undefined : createOpenRouterCall(realKey, realModel);\n    const assignments = realAssignments(realModel);\n    let store: TempStore;\n    let routing: RoutingRunResult;\n\n    beforeAll(async () => {\n      store = tempStore();\n      if (call === undefined) throw new Error(\"keyed leg started without a key\");\n      // TC-4.3: the SAME routing helper Story 2's fake-host seam test runs,\n      // unchanged, against the real host — it drives a real intake → drain\n      // exercising all seven kinds and asserts routing, lane coverage, and\n      // single-turn message shape internally.\n      routing = await assertRoutingThroughSdk(call, assignments, store);\n    }, 300_000);\n    afterAll(() => {\n      store.cleanup();\n    });\n\n    it(\n      \"TC-4.3: the real host function passes the ModelCall contract on a real probe\",\n      async () => {\n        if (call === undefined) throw new Error(\"keyed leg started without a key\");\n        await assertModelCallContract(\n          call,\n          probeInput({ provider: \"openrouter\", model: realModel }),\n        );\n      },\n      120_000,\n    );\n\n    it(\"TC-4.1: each of the seven kinds round-tripped real inference to a ready form\", () => {\n      for (const kind of FORM_KINDS) {\n        const ready = routing.forms.filter(\n          (form) => form.form === kind && form.state === \"ready\",\n        );\n        expect(ready.length).toBeGreaterThan(0);\n        for (const form of ready) {\n          expect(form.content).toBeDefined();\n          expect((form.content ?? \"\").trim()).not.toBe(\"\");\n          expect(form.content).not.toMatch(MARKER_AT_START);\n          expect(form.content).not.toMatch(MARKER_ANYWHERE);\n          // Provenance names the real lane from config, never model output.\n          expect(form.metadata?.provenance).toEqual({\n            provider: \"openrouter\",\n            model: realModel,\n            prompt: assignments[form.form].prompt,\n          });\n        }\n      }\n    });\n  },\n);\n\n// ── TC-4.2: the real-adapter lifecycle capstone ───────────────────\n\ndescribe.runIf(keyed)(\"TC-4.2 (keyed): Epic 04 lifecycle capstone under the real adapter\", () => {\n  let store: TempStore;\n  let run: LifecycleRun;\n  let preEditForms: DerivedForm[] = [];\n  let finalForms: DerivedForm[] = [];\n\n  beforeAll(async () => {\n    store = tempStore();\n    if (\"notRan\" in suiteEnv) throw new Error(\"keyed leg started without a key\");\n    const call = createOpenRouterCall(suiteEnv.key, realModel);\n    // The Epic 04 sequence verbatim — intake, drain, compact, pull, inspect,\n    // edit, rebuild, drain, compact, materialize — with the inference\n    // adapter in the provider-arrival slot (the one swap point).\n    run = await runLifecycle(store, {\n      name: \"real-capstone\",\n      inference: { call, assignments: realAssignments(realModel) },\n      onCheckpoint: (checkpoint, ctx) => {\n        // Pre-mutation snapshot: the regeneration assertion compares each\n        // mutation-cleared form's content before the edit and after rebuild.\n        if (checkpoint === \"inspect1\") preEditForms = readDerivedForms(ctx.filePath);\n        return Promise.resolve();\n      },\n    });\n    finalForms = readDerivedForms(run.filePath);\n  }, 1_800_000);\n  afterAll(() => {\n    store.cleanup();\n  });\n\n  it(\"every derivation kind lands ready at least once with non-empty content\", () => {\n    for (const kind of FORM_KINDS) {\n      const ready = finalForms.filter((form) => form.form === kind && form.state === \"ready\");\n      expect(ready.length).toBeGreaterThan(0);\n      for (const form of ready) {\n        expect((form.content ?? \"\").trim()).not.toBe(\"\");\n      }\n    }\n  });\n\n  it(\"no deterministic marker pattern appears anywhere — forms, served views, materialized file\", () => {\n    for (const form of finalForms) {\n      if (form.content === undefined) continue;\n      expect(form.content).not.toMatch(MARKER_AT_START);\n      expect(form.content).not.toMatch(MARKER_ANYWHERE);\n    }\n    for (const pull of [ok(run.phases.pull1), ok(run.phases.pull2)]) {\n      for (const message of pull.messages) {\n        expect(message.content).not.toMatch(MARKER_ANYWHERE);\n      }\n    }\n    expect(readFileSync(run.outPath, \"utf8\")).not.toMatch(MARKER_ANYWHERE);\n  });\n\n  it(\"provenance on every ready form names the real model\", () => {\n    for (const form of finalForms) {\n      if (form.state !== \"ready\") continue;\n      expect(form.metadata?.provenance?.provider).toBe(\"openrouter\");\n      expect(form.metadata?.provenance?.model).toBe(realModel);\n    }\n  });\n\n  it(\"mutation-cleared forms went cleared-then-ready and regenerated with different content\", () => {\n    const cleared = [\n      ...ok(run.phases.mutate.edit).cleared,\n      ...ok(run.phases.mutate.delete).cleared,\n    ];\n    expect(cleared.length).toBeGreaterThan(0);\n    const find = (forms: DerivedForm[], target: (typeof cleared)[number]): DerivedForm | undefined =>\n      forms.find(\n        (form) =>\n          form.subjectKind === target.subjectKind &&\n          form.subjectId === target.subjectId &&\n          form.form === target.form,\n      );\n    for (const target of cleared) {\n      const before = find(preEditForms, target);\n      const after = find(finalForms, target);\n      // Cleared-then-ready: ready before the mutation (pre-edit snapshot),\n      // pending in the mutate-phase health below, ready again after rebuild.\n      expect(before?.state).toBe(\"ready\");\n      expect(after?.state).toBe(\"ready\");\n      expect(after?.content).toBeDefined();\n      expect(after?.content).not.toBe(before?.content);\n    }\n  });\n\n  it(\"health is coherent at each checkpoint: settled, cleared-set pending, settled again\", () => {\n    // Checkpoint 1 — post-drain status: derivation fully settled before the\n    // first compact.\n    const status = ok(run.phases.status);\n    expect(status.derivation).toEqual({ pending: 0, retrying: 0, failed: 0, blocked: 0 });\n\n    // Checkpoint 2 — immediately after the mutations: exactly the cleared\n    // set is in flight, queued and unclaimed (cleared → pending around\n    // mutations).\n    const clearedCount =\n      ok(run.phases.mutate.edit).cleared.length + ok(run.phases.mutate.delete).cleared.length;\n    const healthAfterMutate = ok(run.phases.mutate.healthAfterMutate);\n    const inFlight = healthAfterMutate.owners.reduce(\n      (sum, row) => sum + row.counts.pending + row.counts.retrying,\n      0,\n    );\n    expect(inFlight).toBe(clearedCount);\n    expect(healthAfterMutate.queue).toEqual({ queued: clearedCount, claimed: 0 });\n    expect(healthAfterMutate.failures).toEqual([]);\n\n    // Checkpoint 3 — post-rebuild: everything ready, nothing failed or\n    // blocked, queue empty.\n    const health2: HealthReport = ok(run.phases.health2);\n    for (const row of health2.owners) {\n      expect(row.counts.pending).toBe(0);\n      expect(row.counts.retrying).toBe(0);\n      expect(row.counts.failed).toBe(0);\n      expect(row.counts.blocked).toBe(0);\n      expect(row.counts.ready).toBeGreaterThan(0);\n    }\n    expect(health2.failures).toEqual([]);\n    expect(health2.queue).toEqual({ queued: 0, claimed: 0 });\n  });\n\n  it(\"the second compact's view reflects post-edit content\", () => {\n    const pull2 = ok(run.phases.pull2);\n    expect(\n      pull2.messages.some(\n        (message) =>\n          message.band === undefined &&\n          message.role === \"user\" &&\n          message.content === EDITED_MESSAGE_TEXT,\n      ),\n    ).toBe(true);\n    expect(pull2.messages.some((m) => m.content.includes(DELETED_MESSAGE_TEXT))).toBe(false);\n    expect(\n      pull2.messages.some((m) => m.content === \"turn 12: please investigate area 12\"),\n    ).toBe(false);\n  });\n\n  it(\"mutation results carried queued replacement work (the cleared set was re-derived, not left stale)\", () => {\n    const edit: MutationResult = ok(run.phases.mutate.edit);\n    const deleted: MutationResult = ok(run.phases.mutate.delete);\n    expect(edit.queued.length).toBeGreaterThan(0);\n    expect(deleted.queued.length).toBeGreaterThan(0);\n  });\n});\n","numLines":321,"startLine":1,"totalLines":321}}}

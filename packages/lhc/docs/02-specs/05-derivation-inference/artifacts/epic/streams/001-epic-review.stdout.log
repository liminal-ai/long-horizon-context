{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LfHDTRyQhX3BJqpPCAAAbE","type":"tool_result","content":"85\t  const rendering = await run.provider.composeTurnRendering({ parts });\n86\t  if (!rendering.ok) return providerFailed(rendering);\n87\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n88\t  if (!projection.ok) return providerFailed(projection);\n89\t\n90\t  // The projection's token count is estimated exactly once, here, as the\n91\t  // artifact lands; placement reads this stored arithmetic and never\n92\t  // re-counts (AC-3.9's determinism input).\n93\t  const projectedTokens = estimateTokens(projection.text);\n94\t  const threadId = readThreadId(run);\n95\t  const renderingGaps: DependencyGap[] | undefined = gaps.length > 0 ? gaps : undefined;\n96\t  // Tool-run receipts ride the rendering's metadata, mechanically restated\n97\t  // from the composition input (AC-3.8) — the chunk summaries read them from\n98\t  // here, never from provider prose. Provenance is copied from the provider\n99\t  // result, stamped there from config-known strings (Epic 05 DD-4); the\n100\t  // deterministic provider sets none.\n101\t  const renderingMetadata: DerivedFormMetadata = {\n102\t    ...(receipts.length > 0 ? { receipts } : {}),\n103\t    ...(rendering.provenance === undefined ? {} : { provenance: rendering.provenance }),\n104\t  };\n105\t\n106\t  return {\n107\t    ok: true,\n108\t    forms: [\n109\t      {\n110\t        subjectKind: \"turn\",\n111\t        subjectId: turnId,\n112\t        form: \"turn_rendering\",\n113\t        content: rendering.text,\n114\t        ...(renderingGaps === undefined ? {} : { gaps: renderingGaps }),\n115\t        ...(Object.keys(renderingMetadata).length > 0 ? { metadata: renderingMetadata } : {}),\n116\t      },\n117\t      {\n118\t        subjectKind: \"turn\",\n119\t        subjectId: turnId,\n120\t        form: \"lower_band_projection\",\n121\t        content: projection.text,\n122\t        ...(projection.provenance === undefined\n123\t          ? {}\n124\t          : { metadata: { provenance: projection.provenance } }),\n125\t      },\n126\t    ],\n127\t    onApplied: (tx) => {\n128\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n129\t      for (const chunkId of placement.closedChunkIds) {\n130\t        enqueueChunkSummaries(\n131\t          {\n132\t            db: tx.db,\n133\t            clock: run.clock,\n134\t            threadId,\n135\t            onCommit: tx.onCommit,\n136\t            poke: resolveInstancePoke(),\n137\t          },\n138\t          chunkId,\n139\t        );\n140\t      }\n141\t    },\n142\t  };\n143\t};\n144\t\n145\t// One read for both summary kinds — member projections in turn order — but\n146\t// two contracts at the provider seam (AC-3.8): detailed receives the\n147\t// members' tool-run receipts (what changed, outcome) read from the\n148\t// renderings' stamped metadata; brief receives outcomes only, the receipt\n149\t// text stripped here so the brief provider call structurally cannot carry\n150\t// it. Two work items, two handlers' runs, independent retry and states. A\n151\t// member whose projection is not ready falls back to nothing and records a\n152\t// gap, mirroring the rendering's fallback rule.\n153\tfunction chunkSummaryHandler(\n154\t  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n155\t): WorkHandler {\n156\t  return async (run, item) => {\n157\t    const chunkId = item.sourceRef[\"chunkId\"];\n158\t    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n159\t    const db = run.openDb();\n160\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n161\t\n162\t    const members = readMemberProjections(db, chunkId);\n163\t    const memberProjections: string[] = [];\n164\t    const gaps: DependencyGap[] = [];\n165\t    for (const member of members) {\n166\t      if (member.state === \"ready\" && member.content !== undefined) {\n167\t        memberProjections.push(member.content);\n168\t      } else {\n169\t        memberProjections.push(\"\");\n170\t        gaps.push({\n171\t          subjectKind: \"turn\",\n172\t          subjectId: member.turnId,\n173\t          form: \"lower_band_projection\",\n174\t        });\n175\t      }\n176\t    }\n177\t\n178\t    const result =\n179\t      kind === \"chunk_summary_detailed\"\n180\t        ? await run.provider.summarizeChunkDetailed({\n181\t            memberProjections,\n182\t            memberReceipts: members.map((member) => member.receipts),\n183\t          })\n184\t        : await run.provider.summarizeChunkBrief({\n185\t            memberProjections,\n186\t            memberOutcomes: members.map((member) =>\n187\t              member.receipts.map((receipt) => receipt.outcome),\n188\t            ),\n189\t          });\n190\t    if (!result.ok) return providerFailed(result);\n191\t\n192\t    return {\n193\t      ok: true,\n194\t      forms: [\n195\t        {\n196\t          subjectKind: \"chunk\",\n197\t          subjectId: chunkId,\n198\t          form: kind,\n199\t          content: result.text,\n200\t          ...(gaps.length > 0 ? { gaps } : {}),\n201\t          ...(result.provenance === undefined\n202\t            ? {}\n203\t            : { metadata: { provenance: result.provenance } }),\n204\t        },\n205\t      ],\n206\t    };\n207\t  };\n208\t}\n209\t\n210\t// The domain's handler table, merged into the SDK dispatch map at\n211\t// construction (DD-6).\n212\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n213\t  turn_derivation: turnDerivationHandler,\n214\t  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),"}]},"parent_tool_use_id":null,"session_id":"40f6c7de-865c-49b2-84c6-8862983c5a5a","uuid":"8634ad9d-6973-4c2f-9d4d-c5160c659b8d","timestamp":"2026-06-13T00:26:47.160Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/derive.ts","content":"  const rendering = await run.provider.composeTurnRendering({ parts });\n  if (!rendering.ok) return providerFailed(rendering);\n  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n  if (!projection.ok) return providerFailed(projection);\n\n  // The projection's token count is estimated exactly once, here, as the\n  // artifact lands; placement reads this stored arithmetic and never\n  // re-counts (AC-3.9's determinism input).\n  const projectedTokens = estimateTokens(projection.text);\n  const threadId = readThreadId(run);\n  const renderingGaps: DependencyGap[] | undefined = gaps.length > 0 ? gaps : undefined;\n  // Tool-run receipts ride the rendering's metadata, mechanically restated\n  // from the composition input (AC-3.8) — the chunk summaries read them from\n  // here, never from provider prose. Provenance is copied from the provider\n  // result, stamped there from config-known strings (Epic 05 DD-4); the\n  // deterministic provider sets none.\n  const renderingMetadata: DerivedFormMetadata = {\n    ...(receipts.length > 0 ? { receipts } : {}),\n    ...(rendering.provenance === undefined ? {} : { provenance: rendering.provenance }),\n  };\n\n  return {\n    ok: true,\n    forms: [\n      {\n        subjectKind: \"turn\",\n        subjectId: turnId,\n        form: \"turn_rendering\",\n        content: rendering.text,\n        ...(renderingGaps === undefined ? {} : { gaps: renderingGaps }),\n        ...(Object.keys(renderingMetadata).length > 0 ? { metadata: renderingMetadata } : {}),\n      },\n      {\n        subjectKind: \"turn\",\n        subjectId: turnId,\n        form: \"lower_band_projection\",\n        content: projection.text,\n        ...(projection.provenance === undefined\n          ? {}\n          : { metadata: { provenance: projection.provenance } }),\n      },\n    ],\n    onApplied: (tx) => {\n      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n      for (const chunkId of placement.closedChunkIds) {\n        enqueueChunkSummaries(\n          {\n            db: tx.db,\n            clock: run.clock,\n            threadId,\n            onCommit: tx.onCommit,\n            poke: resolveInstancePoke(),\n          },\n          chunkId,\n        );\n      }\n    },\n  };\n};\n\n// One read for both summary kinds — member projections in turn order — but\n// two contracts at the provider seam (AC-3.8): detailed receives the\n// members' tool-run receipts (what changed, outcome) read from the\n// renderings' stamped metadata; brief receives outcomes only, the receipt\n// text stripped here so the brief provider call structurally cannot carry\n// it. Two work items, two handlers' runs, independent retry and states. A\n// member whose projection is not ready falls back to nothing and records a\n// gap, mirroring the rendering's fallback rule.\nfunction chunkSummaryHandler(\n  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n): WorkHandler {\n  return async (run, item) => {\n    const chunkId = item.sourceRef[\"chunkId\"];\n    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n    const db = run.openDb();\n    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n\n    const members = readMemberProjections(db, chunkId);\n    const memberProjections: string[] = [];\n    const gaps: DependencyGap[] = [];\n    for (const member of members) {\n      if (member.state === \"ready\" && member.content !== undefined) {\n        memberProjections.push(member.content);\n      } else {\n        memberProjections.push(\"\");\n        gaps.push({\n          subjectKind: \"turn\",\n          subjectId: member.turnId,\n          form: \"lower_band_projection\",\n        });\n      }\n    }\n\n    const result =\n      kind === \"chunk_summary_detailed\"\n        ? await run.provider.summarizeChunkDetailed({\n            memberProjections,\n            memberReceipts: members.map((member) => member.receipts),\n          })\n        : await run.provider.summarizeChunkBrief({\n            memberProjections,\n            memberOutcomes: members.map((member) =>\n              member.receipts.map((receipt) => receipt.outcome),\n            ),\n          });\n    if (!result.ok) return providerFailed(result);\n\n    return {\n      ok: true,\n      forms: [\n        {\n          subjectKind: \"chunk\",\n          subjectId: chunkId,\n          form: kind,\n          content: result.text,\n          ...(gaps.length > 0 ? { gaps } : {}),\n          ...(result.provenance === undefined\n            ? {}\n            : { metadata: { provenance: result.provenance } }),\n        },\n      ],\n    };\n  };\n}\n\n// The domain's handler table, merged into the SDK dispatch map at\n// construction (DD-6).\nexport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n  turn_derivation: turnDerivationHandler,\n  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),","numLines":130,"startLine":85,"totalLines":217}}}

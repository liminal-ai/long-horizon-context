yZ4JWe1teVWqjfkG1zXz\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/derivation.ts\"},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":10402,\"cache_read_input_tokens\":66813,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":10402},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"uuid\":\"80e3be73-e15d-4978-b8c3-0592ace7fc70\",\"request_id\":\"req_011CbzJsRm74YCEH1ipDi4Lv\"}\n{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_stop\",\"index\":2},\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"parent_tool_use_id\":null,\"uuid\":\"d8192d1f-909c-4771-8cba-5d13e99eb048\"}\n{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_start\",\"index\":3,\"content_block\":{\"type\":\"tool_use\",\"id\":\"toolu_01NjVWUHT3joQG2N57an6oXq\",\"name\":\"Read\",\"input\":{},\"caller\":{\"type\":\"direct\"}}},\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"parent_tool_use_id\":null,\"uuid\":\"5aa1f2bc-0602-4f41-b6c1-a6d7e627596f\"}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01KryZ4JWe1teVWqjfkG1zXz\",\"type\":\"tool_result\",\"content\":\"1\\t// Epic 02 shared vocabulary: the derived-form state machine's types, the\\n2\\t// provider seam, and the handler contract. Both owning domains (messages,\\n3\\t// turns) consume these; neither owns them — the repair report, the mutation\\n4\\t// cascade, and the drain all speak this vocabulary across domain lines, so it\\n5\\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\\n6\\timport type { DatabaseSync } from \\\"node:sqlite\\\";\\n7\\t// Type-only and erased at build: the runtime graph stays one-directional\\n8\\t// (inference/ imports shared/, never the reverse).\\n9\\timport type { InferenceConfig } from \\\"../inference/types.js\\\";\\n10\\timport type { ResolvedViewConfig, SdkViewConfig } from \\\"./view.js\\\";\\n11\\t\\n12\\texport type SubjectKind = \\\"message\\\" | \\\"turn\\\" | \\\"chunk\\\";\\n13\\t\\n14\\t// The kind set is a runtime constant with the type derived from it, so code\\n15\\t// that must cover every kind — assignment validation above all (Epic 05\\n16\\t// AC-1.3) — iterates the exported set instead of maintaining a second\\n17\\t// literal list that can drift.\\n18\\texport const FORM_KINDS = [\\n19\\t  \\\"smoothed_prompt\\\",\\n20\\t  \\\"tool_call_summary\\\",\\n21\\t  \\\"tool_result_summary\\\",\\n22\\t  \\\"turn_rendering\\\",\\n23\\t  \\\"lower_band_projection\\\",\\n24\\t  \\\"chunk_summary_detailed\\\",\\n25\\t  \\\"chunk_summary_brief\\\",\\n26\\t] as const;\\n27\\t\\n28\\texport type FormKind = (typeof FORM_KINDS)[number];\\n29\\t\\n30\\texport type DerivedFormState = \\\"pending\\\" | \\\"ready\\\" | \\\"failed\\\" | \\\"blocked\\\";\\n31\\t\\n32\\t// Outcome on tool-activity summaries — mechanically stamped from the record\\n33\\t// (isError/presence), never authored by the provider (AC-2.4).\\n34\\texport type ToolOutcome = \\\"succeeded\\\" | \\\"failed\\\" | \\\"unknown\\\";\\n35\\t\\n36\\t// A composed form's record of a dependency that fell back during composition:\\n37\\t// names the source record and the form that was not ready (AC-3.2/3.3).\\n38\\texport interface DependencyGap {\\n39\\t  subjectKind: SubjectKind;\\n40\\t  subjectId: string;\\n41\\t  form: FormKind;\\n42\\t}\\n43\\t\\n44\\t// The read shape for one derived form's state row (DD-2, DD-3).\\n45\\texport interface DerivedForm {\\n46\\t  subjectKind: SubjectKind;\\n47\\t  subjectId: string;\\n48\\t  form: FormKind;\\n49\\t  state: DerivedFormState;\\n50\\t  content?: string; // ready only\\n51\\t  reason?: string; // failed | blocked\\n52\\t  sourceVersion: number; // which version of the source this form derives from (DD-3)\\n53\\t  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\\n54\\t  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\\n55\\t  derivedAt?: string;\\n56\\t}\\n57\\t\\n58\\t// One tool call's or result's receipt within a turn's composed account\\n59\\t// (AC-3.8): the account text — what changed, as composed — plus the\\n60\\t// mechanically derived outcome. Derived from the composition input, never\\n61\\t// from provider prose; stamped on the turn_rendering form so the chunk\\n62\\t// summaries can read receipts machine-readably in turn order.\\n63\\texport interface ToolRunReceipt {\\n64\\t  messageId: string;\\n65\\t  activity: \\\"tool_call\\\" | \\\"tool_result\\\";\\n66\\t  account: string;\\n67\\t  outcome: ToolOutcome;\\n68\\t}\\n69\\t\\n70\\t// Mechanically stamped form metadata: tool outcomes (AC-2.4), the turn\\n71\\t// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\\n72\\t// final attempts/last-error copied from the work item before its row is\\n73\\t// deleted (DD-1: the queue is not an audit table; durable outcome detail\\n74\\t// lives here).\\n75\\texport interface DerivedFormMetadata {\\n76\\t  outcome?: ToolOutcome;\\n77\\t  receipts?: ToolRunReceipt[];\\n78\\t  attempts?: number;\\n79\\t  lastError?: string;\\n80\\t  // Epic 05 (DD-4): which provider/model/prompt produced the content —\\n81\\t  // copied from the ProviderResult's config-known strings, never authored\\n82\\t  // from model output. The deterministic provider never sets it.\\n83\\t  provenance?: ProviderProvenance;\\n84\\t}\\n85\\t\\n86\\t// One row of an owner's repair report (Flow 4): the form's durable state\\n87\\t// joined with the queue's mechanical detail for the live item still working\\n88\\t// toward it, if any. The five operational situations read from this one row:\\n89\\t// never-attempted (pending, no queue), retrying (pending + queue with\\n90\\t// attempts > 0), ready, failed (+ reason), blocked (+ reason) — no caller\\n91\\t// ever needs a queue API.\\n92\\texport interface FormReportEntry extends DerivedForm {\\n93\\t  queue?: {\\n94\\t    status: \\\"queued\\\" | \\\"claimed\\\";\\n95\\t    attempts: number;\\n96\\t    lastError?: string;\\n97\\t    eligibleAt?: string;\\n98\\t  };\\n99\\t}\\n100\\t\\n101\\t// ── provider seam (DD-7) ─────────────────────────────────────────\\n102\\t// Every operation returns content or a structured failure carrying\\n103\\t// retryable-or-not; classification is the adapter's duty.\\n104\\t// Provenance: the three config-known assignment strings, stamped by the\\n105\\t// inference adapter (it alone knows the assignment) and copied by handlers\\n106\\t// into form metadata (Epic 05 DD-4). Never derived from model output.\\n107\\texport interface ProviderProvenance {\\n108\\t  provider: string;\\n109\\t  model: string;\\n110\\t  prompt: string;\\n111\\t}\\n112\\t\\n113\\texport type ProviderResult =\\n114\\t  | { ok: true; text: string; provenance?: ProviderProvenance }\\n115\\t  | { ok: false; retryable: boolean; reason: string };\\n116\\t\\n117\\t// Message kinds a rendering part can carry — mirrors the intake event-kind\\n118\\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\\n119\\t// rather than imported: shared/ may not import domains/.\\n120\\texport type RenderingPartKind =\\n121\\t  | \\\"user_prompt\\\"\\n122\\t  | \\\"assistant_text\\\"\\n123\\t  | \\\"assistant_thinking\\\"\\n124\\t  | \\\"runtime_note\\\"\\n125\\t  | \\\"tool_call\\\"\\n126\\t  | \\\"tool_result\\\";\\n127\\t\\n128\\texport interface RenderingPart {\\n129\\t  messageId: string;\\n130\\t  kind: RenderingPartKind;\\n131\\t  text: string; // ready form content, or raw/truncated fallback\\n132\\t  fallback: boolean; // true ⇒ gap recorded\\n133\\t  outcome?: ToolOutcome; // tool activity only\\n134\\t}\\n135\\t\\n136\\texport interface DerivationProvider {\\n137\\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\\n138\\t  summarizeToolCall(i: {\\n139\\t    toolName: string;\\n140\\t    argsJson: string;\\n141\\t    pairedResult?: { content: string; isError: boolean };\\n142\\t  }): Promise<ProviderResult>;\\n143\\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\\n144\\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\\n145\\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\\n146\\t  // The two summary inputs differ by contract (AC-3.8): detailed receives\\n147\\t  // the members' tool-run receipts (what changed, outcome) alongside the\\n148\\t  // projections; brief receives outcomes only — receipt text is stripped\\n149\\t  // before the provider is called, so brief structurally cannot leak it.\\n150\\t  // The receipt fields are optional in the type for callers without member\\n151\\t  // context (the production chunk handlers always pass them).\\n152\\t  summarizeChunkDetailed(i: {\\n153\\t    memberProjections: string[];\\n154\\t    memberReceipts?: ToolRunReceipt[][];\\n155\\t  }): Promise<ProviderResult>;\\n156\\t  summarizeChunkBrief(i: {\\n157\\t    memberProjections: string[];\\n158\\t    memberOutcomes?: ToolOutcome[][];\\n159\\t  }): Promise<ProviderResult>;\\n160\\t}\\n161\\t\\n162\\texport const PROVIDER_OPERATIONS = [\\n163\\t  \\\"smoothPrompt\\\",\\n164\\t  \\\"summarizeToolCall\\\",\\n165\\t  \\\"summarizeToolResult\\\",\\n166\\t  \\\"composeTurnRendering\\\",\\n167\\t  \\\"projectLowerBand\\\",\\n168\\t  \\\"summarizeChunkDetailed\\\",\\n169\\t  \\\"summarizeChunkBrief\\\",\\n170\\t] as const;\\n171\\t\\n172\\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\\n173\\t\\n174\\t// ── SDK assembly config (tech design §Interfaces) ────────────────\\n175\\t// Provider arrival is exactly one of `provider` (direct injection,\\n176\\t// unchanged — the deterministic test default) or `inference` (host\\n177\\t// model-call function + per-kind assignments, Epic 05 DD-5). Both or\\n178\\t// neither is a construction TypeError naming the XOR rule (AC-1.1).\\n179\\texport interface SdkConfig {\\n180\\t  provider?: DerivationProvider;\\n181\\t  inference?: InferenceConfig;\\n182\\t  mode: \\\"background\\\" | \\\"manual\\\";\\n183\\t  clock?: () => Date;\\n184\\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\\n185\\t  lease?: { durationMs: number }; // 120000\\n186\\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\\n187\\t  view?: SdkViewConfig; // Epic 03: profiles, visibility budgets, compact threshold\\n188\\t}\\n189\\t\\n190\\t// Every optional filled by createSdk's central defaults.\\n191\\texport interface ResolvedSdkConfig {\\n192\\t  provider: DerivationProvider;\\n193\\t  mode: \\\"background\\\" | \\\"manual\\\";\\n194\\t  clock: () => Date;\\n195\\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\\n196\\t  lease: { durationMs: number };\\n197\\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\\n198\\t  view: ResolvedViewConfig;\\n199\\t}\\n200\\t\\n201\\t// ── handler contract (DD-6; the map's value type) ────────────────\\n202\\texport interface HandlerRunContext {\\n203\\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\\n204\\t  provider: DerivationProvider;\\n205\\t  clock: () => Date;\\n206\\t  config: ResolvedSdkConfig;\\n207\\t}\\n208\\t\\n209\\t// A successful handler hands its derived-form content back as data; the\\n210\\t// drain's completion transaction performs the version-checked UPDATE and the\\n211\\t// item-row deletion atomically (tech design §Mechanics: completion is one\\n212\\t// short BEGIN IMMEDIATE doing the form write and the delete). The handler\\n213\\t// never opens that transaction itself, so the version check and the\\n214\\t// done/stale_discarded disposition stay in one place — the queue util.\\n215\\texport interface HandlerFormWrite {\\n216\\t  subjectKind: SubjectKind;\\n217\\t  subjectId: string;\\n218\\t  form: FormKind;\\n219\\t  content: string;\\n220\\t  metadata?: DerivedFormMetadata;\\n221\\t  gaps?: DependencyGap[];\\n222\\t}\\n223\\t\\n224\\t// The completion-transaction hook (Story 3): work that must land atomically\\n225\\t// with the version-checked form writes — chunk placement and the\\n226\\t// close→summary enqueues above all. The queue util invokes it inside the\\n227\\t// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\\n228\\t// (a stale completion must not place a turn or enqueue summaries); onCommit\\n229\\t// registrations flush after that COMMIT succeeds and drop on rollback, so a\\n230\\t// crash leaves either a placed turn with its enqueues or nothing — never a\\n231\\t// derived-but-unplaced turn.\\n232\\texport interface CompletionTx {\\n233\\t  db: DatabaseSync;\\n234\\t  onCommit: (fn: () => void) => void;\\n235\\t}\\n236\\t\\n237\\texport type HandlerOutcome =\\n238\\t  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\\n239\\t  | { ok: false; retryable: boolean; reason: string }\\n240\\t  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\\n241\\t\\n242\\t// item is the queue util's WorkItemRecord; typed structurally here so the\\n243\\t// shared layer does not depend on the util's module (and vice versa stays\\n244\\t// one-directional: tech-utils imports shared).\\n245\\texport type WorkHandler = (\\n246\\t  run: HandlerRunContext,\\n247\\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\\n248\\t) => Promise<HandlerOutcome>;\\n249\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"uuid\":\"5b806782-d8ad-45a7-8dda-7c2eabb3d95c\",\"timestamp\":\"2026-06-13T00:25:55.772Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/derivation.ts\",\"content\":\"// Epic 02 shared vocabulary: the derived-form state machine's types, the\\n// provider seam, and the handler contract. Both owning domains (messages,\\n// turns) consume these; neither owns them — the repair report, the mutation\\n// cascade, and the drain all speak this vocabulary across domain lines, so it\\n// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\\nimport type { DatabaseSync } from \\\"node:sqlite\\\";\\n// Type-only and erased at build: the runtime graph stays one-directional\\n// (inference/ imports shared/, never the reverse).\\nimport type { InferenceConfig } from \\\"../inference/types.js\\\";\\nimport type { ResolvedViewConfig, SdkViewConfig } from \\\"./view.js\\\";\\n\\nexport type SubjectKind = \\\"message\\\" | \\\"turn\\\" | \\\"chunk\\\";\\n\\n// The kind set is a runtime constant with the type derived from it, so code\\n// that must cover every kind — assignment validation above all (Epic 05\\n// AC-1.3) — iterates the exported set instead of maintaining a second\\n// literal list that can drift.\\nexport const FORM_KINDS = [\\n  \\\"smoothed_prompt\\\",\\n  \\\"tool_call_summary\\\",\\n  \\\"tool_result_summary\\\",\\n  \\\"turn_rendering\\\",\\n  \\\"lower_band_projection\\\",\\n  \\\"chunk_summary_detailed\\\",\\n  \\\"chunk_summary_brief\\\",\\n] as const;\\n\\nexport type FormKind = (typeof FORM_KINDS)[number];\\n\\nexport type DerivedFormState = \\\"pending\\\" | \\\"ready\\\" | \\\"failed\\\" | \\\"blocked\\\";\\n\\n// Outcome on tool-activity summaries — mechanically stamped from the record\\n// (isError/presence), never authored by the provider (AC-2.4).\\nexport type ToolOutcome = \\\"succeeded\\\" | \\\"failed\\\" | \\\"unknown\\\";\\n\\n// A composed form's record of a dependency that fell back during composition:\\n// names the source record and the form that was not ready (AC-3.2/3.3).\\nexport interface DependencyGap {\\n  subjectKind: SubjectKind;\\n  subjectId: string;\\n  form: FormKind;\\n}\\n\\n// The read shape for one derived form's state row (DD-2, DD-3).\\nexport interface DerivedForm {\\n  subjectKind: SubjectKind;\\n  subjectId: string;\\n  form: FormKind;\\n  state: DerivedFormState;\\n  content?: string; // ready only\\n  reason?: string; // failed | blocked\\n  sourceVersion: number; // which version of the source this form derives from (DD-3)\\n  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\\n  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\\n  derivedAt?: string;\\n}\\n\\n// One tool call's or result's receipt within a turn's composed account\\n// (AC-3.8): the account text — what changed, as composed — plus the\\n// mechanically derived outcome. Derived from the composition input, never\\n// from provider prose; stamped on the turn_rendering form so the chunk\\n// summaries can read receipts machine-readably in turn order.\\nexport interface ToolRunReceipt {\\n  messageId: string;\\n  activity: \\\"tool_call\\\" | \\\"tool_result\\\";\\n  account: string;\\n  outcome: ToolOutcome;\\n}\\n\\n// Mechanically stamped form metadata: tool outcomes (AC-2.4), the turn\\n// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\\n// final attempts/last-error copied from the work item before its row is\\n// deleted (DD-1: the queue is not an audit table; durable outcome detail\\n// lives here).\\nexport interface DerivedFormMetadata {\\n  outcome?: ToolOutcome;\\n  receipts?: ToolRunReceipt[];\\n  attempts?: number;\\n  lastError?: string;\\n  // Epic 05 (DD-4): which provider/model/prompt produced the content —\\n  // copied from the ProviderResult's config-known strings, never authored\\n  // from model output. The deterministic provider never sets it.\\n  provenance?: ProviderProvenance;\\n}\\n\\n// One row of an owner's repair report (Flow 4): the form's durable state\\n// joined with the queue's mechanical detail for the live item still working\\n// toward it, if any. The five operational situations read from this one row:\\n// never-attempted (pending, no queue), retrying (pending + queue with\\n// attempts > 0), ready, failed (+ reason), blocked (+ reason) — no caller\\n// ever needs a queue API.\\nexport interface FormReportEntry extends DerivedForm {\\n  queue?: {\\n    status: \\\"queued\\\" | \\\"claimed\\\";\\n    attempts: number;\\n    lastError?: string;\\n    eligibleAt?: string;\\n  };\\n}\\n\\n// ── provider seam (DD-7) ─────────────────────────────────────────\\n// Every operation returns content or a structured failure carrying\\n// retryable-or-not; classification is the adapter's duty.\\n// Provenance: the three config-known assignment strings, stamped by the\\n// inference adapter (it alone knows the assignment) and copied by handlers\\n// into form metadata (Epic 05 DD-4). Never derived from model output.\\nexport interface ProviderProvenance {\\n  provider: string;\\n  model: string;\\n  prompt: string;\\n}\\n\\nexport type ProviderResult =\\n  | { ok: true; text: string; provenance?: ProviderProvenance }\\n  | { ok: false; retryable: boolean; reason: string };\\n\\n// Message kinds a rendering part can carry — mirrors the intake event-kind\\n// vocabulary minus turn_end (turn_end never projects a message). Mirrored\\n// rather than imported: shared/ may not import domains/.\\nexport type RenderingPartKind =\\n  | \\\"user_prompt\\\"\\n  | \\\"assistant_text\\\"\\n  | \\\"assistant_thinking\\\"\\n  | \\\"runtime_note\\\"\\n  | \\\"tool_call\\\"\\n  | \\\"tool_result\\\";\\n\\nexport interface RenderingPart {\\n  messageId: string;\\n  kind: RenderingPartKind;\\n  text: string; // ready form content, or raw/truncated fallback\\n  fallback: boolean; // true ⇒ gap recorded\\n  outcome?: ToolOutcome; // tool activity only\\n}\\n\\nexport interface DerivationProvider {\\n  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\\n  summarizeToolCall(i: {\\n    toolName: string;\\n    argsJson: string;\\n    pairedResult?: { content: string; isError: boolean };\\n  }): Promise<ProviderResult>;\\n  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\\n  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\\n  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\\n  // The two summary inputs differ by contract (AC-3.8): detailed receives\\n  // the members' tool-run receipts (what changed, outcome) alongside the\\n  // projections; brief receives outcomes only — receipt text is stripped\\n  // before the provider is called, so brief structurally cannot leak it.\\n  // The receipt fields are optional in the type for callers without member\\n  // context (the production chunk handlers always pass them).\\n  summarizeChunkDetailed(i: {\\n    memberProjections: string[];\\n    memberReceipts?: ToolRunReceipt[][];\\n  }): Promise<ProviderResult>;\\n  summarizeChunkBrief(i: {\\n    memberProjections: string[];\\n    memberOutcomes?: ToolOutcome[][];\\n  }): Promise<ProviderResult>;\\n}\\n\\nexport const PROVIDER_OPERATIONS = [\\n  \\\"smoothPrompt\\\",\\n  \\\"summarizeToolCall\\\",\\n  \\\"summarizeToolResult\\\",\\n  \\\"composeTurnRendering\\\",\\n  \\\"projectLowerBand\\\",\\n  \\\"summarizeChunkDetailed\\\",\\n  \\\"summarizeChunkBrief\\\",\\n] as const;\\n\\nexport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\\n\\n// ── SDK assembly config (tech design §Interfaces) ────────────────\\n// Provider arrival is exactly one of `provider` (direct injection,\\n// unchanged — the deterministic test default) or `inference` (host\\n// model-call function + per-kind assignments, Epic 05 DD-5). Both or\\n// neither is a construction TypeError naming the XOR rule (AC-1.1).\\nexport interface SdkConfig {\\n  provider?: DerivationProvider;\\n  inference?: InferenceConfig;\\n  mode: \\\"background\\\" | \\\"manual\\\";\\n  clock?: () => Date;\\n  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\\n  lease?: { durationMs: number }; // 120000\\n  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\\n  view?: SdkViewConfig; // Epic 03: profiles, visibility budgets, compact threshold\\n}\\n\\n// Every optional filled by createSdk's central defaults.\\nexport interface ResolvedSdkConfig {\\n  provider: DerivationProvider;\\n  mode: \\\"background\\\" | \\\"manual\\\";\\n  clock: () => Date;\\n  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\\n  lease: { durationMs: number };\\n  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\\n  view: ResolvedViewConfig;\\n}\\n\\n// ── handler contract (DD-6; the map's value type) ────────────────\\nexport interface HandlerRunContext {\\n  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\\n  provider: DerivationProvider;\\n  clock: () => Date;\\n  config: ResolvedSdkConfig;\\n}\\n\\n// A successful handler hands its derived-form content back as data; the\\n// drain's completion transaction performs the version-checked UPDATE and the\\n// item-row deletion atomically (tech design §Mechanics: completion is one\\n// short BEGIN IMMEDIATE doing the form write and the delete). The handler\\n// never opens that transaction itself, so the version check and the\\n// done/stale_discarded disposition stay in one place — the queue util.\\nexport interface HandlerFormWrite {\\n  subjectKind: SubjectKind;\\n  subjectId: string;\\n  form: FormKind;\\n  content: string;\\n  metadata?: DerivedFormMetadata;\\n  gaps?: DependencyGap[];\\n}\\n\\n// The completion-transaction hook (Story 3): work that must land atomically\\n// with the version-checked form writes — chunk placement and the\\n// close→summary enqueues above all. The queue util invokes it inside the\\n// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\\n// (a stale completion must not place a turn or enqueue summaries); onCommit\\n// registrations flush after that COMMIT succeeds and drop on rollback, so a\\n// crash leaves either a placed turn with its enqueues or nothing — never a\\n// derived-but-unplaced turn.\\nexport interface CompletionTx {\\n  db: DatabaseSync;\\n  onCommit: (fn: () => void) => void;\\n}\\n\\nexport type HandlerOutcome =\\n  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\\n  | { ok: false; retryable: boolean; reason: string }\\n  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\\n\\n// item is the queue util's WorkItemRecord; typed structurally here so the\\n// shared layer does not depend on the util's module (and vice versa stays\\n// one-directional: tech-utils imports shared).\\nexport type WorkHandler = (\\n  run: HandlerRunContext,\\n  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\\n) => Promise<HandlerOutcome>;\\n\",\"numLines\":249,\"startLine\":1,\"totalLines\":249}}}\n{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":3,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"\"}},\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"parent_tool_use_id\":null,\"uuid\":\"158fb07e-0b58-4e08-864e-81d54e9722c3\"}\n{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":3,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"{\\\"file_path\\\": \\\"/Users/le\"}},\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"parent_tool_use_id\":null,\"uuid\":\"91b89af6-1a10-4ad1-bef2-261da262044f\"}\n{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":3,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"emoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/view.ts\"}},\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"parent_tool_use_id\":null,\"uuid\":\"73b42128-a65e-4626-a422-5dbd8f2038b6\"}\n{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":3,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"\\\", \\\"limit\\\": 120\"}},\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"parent_tool_use_id\":null,\"uuid\":\"6e1283a1-412b-4b33-8ae0-39916c849cda\"}\n{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":3,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"}\"}},\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"parent_tool_use_id\":null,\"uuid\":\"9f9db2ec-ab6c-4b06-b805-e9b6afffe930\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5\",\"id\":\"msg_01WtdboX6qn2VRzmNCf6yj96\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01NjVWUHT3joQG2N57an6oXq\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/view.ts\",\"limit\":120},\"caller\":{\"type\":\"direct\"}}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":10402,\"cache_read_input_tokens\":66813,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":10402},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"uuid\":\"f0ee6127-a019-4a4e-a592-c58530d2f4ba\",\"request_id\":\"req_011CbzJsRm74YCEH1ipDi4Lv\"}\n{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_stop\",\"index\":3},\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"parent_tool_use_id\":null,\"uuid\":\"351eafd7-3339-4efc-9604-16e71e91e04c\"}\n{\"type\":\"stream_event\",\"event\":{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\",\"stop_sequence\":null,\"stop_details\":null},\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":10402,\"cache_read_input_tokens\":66813,\"output_tokens\":454,\"output_tokens_details\":{\"thinking_tokens\":219},\"iterations\":[{\"input_tokens\":2,\"output_tokens\":454,\"cache_read_input_tokens\":66813,\"cache_creation_input_tokens\":10402,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":10402},\"type\":\"message\"}]},\"context_management\":{\"applied_edits\":[]}},\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"parent_tool_use_id\":null,\"uuid\":\"d5c70d38-88fd-4e58-8074-e59c48b7e1e7\"}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01NjVWUHT3joQG2N57an6oXq\",\"type\":\"tool_result\",\"content\":\"1\\t// Epic 03 shared vocabulary: the thread-view types (tech design §Interface\\n2\\t// Definitions). Shared so cli/sdk/tests import one home; the thread-view\\n3\\t// domain owns the behavior, this module owns only the shapes.\\n4\\t\\n5\\texport type Band = \\\"brief\\\" | \\\"detailed\\\" | \\\"smooth\\\";\\n6\\t\\n7\\texport interface ViewProfile {\\n8\\t  name: string;\\n9\\t  // Target assembled size; whole-entry fills may land under or over (epic\\n10\\t  // Data Contracts — the bound is a target, not a cap).\\n11\\t  lowerBound: number;\\n12\\t  // Band shares of the lower bound; must sum to 100 (AC-2.3).\\n13\\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\\n14\\t}\\n15\\t\\n16\\t// A user profile entry as configured: a full profile under a new name, or a\\n17\\t// field-wise override of a built-in (merged by name, AC-2.2). A partial entry\\n18\\t// whose name matches no built-in has nothing to merge over and is rejected at\\n19\\t// construction (FC-0.2's unknown-override violation).\\n20\\texport interface ViewProfileOverride {\\n21\\t  name: string;\\n22\\t  lowerBound?: number;\\n23\\t  percentages?: Partial<ViewProfile[\\\"percentages\\\"]>;\\n24\\t}\\n25\\t\\n26\\t// Compact-time explicit parameters (AC-2.2): field-wise overrides of the\\n27\\t// base profile, down to single band percentages — the same depth the CLI's\\n28\\t// per-band flags override at. A nested-partial deepening of the tech\\n29\\t// design's `Partial<ViewProfile>` sketch, which could not express a\\n30\\t// single-band override.\\n31\\texport interface ViewCompactParams {\\n32\\t  lowerBound?: number;\\n33\\t  percentages?: Partial<ViewProfile[\\\"percentages\\\"]>;\\n34\\t}\\n35\\t\\n36\\t// Visibility-boundary budgets (Epic 03 AC-4.x as patched by Epic 05 AC-5.4):\\n37\\t// max > target, both positive. The floor budget is retired — its job is done\\n38\\t// structurally by the turn-end trigger (the open turn is untouchable) and the\\n39\\t// never-evicted newest closed turn (Epic 05 DD-11).\\n40\\texport interface VisibilityBudgets {\\n41\\t  maxTokens: number;\\n42\\t  targetTokens: number;\\n43\\t}\\n44\\t\\n45\\t// ── SDK assembly config (validated at construction, throws on nonsense\\n46\\t// per the Epic 02 rule) ───────────────────────────────────────────\\n47\\texport interface SdkViewConfig {\\n48\\t  profiles?: ViewProfileOverride[]; // merged over built-ins by name\\n49\\t  visibility?: Partial<VisibilityBudgets>; // defaults: 64000 / 32000\\n50\\t  compactThreshold?: number; // status trigger; default 160000\\n51\\t}\\n52\\t\\n53\\t// Every optional filled by createSdk's central defaults; profiles resolved\\n54\\t// to complete, validated entries keyed by name.\\n55\\texport interface ResolvedViewConfig {\\n56\\t  profiles: Readonly<Record<string, ViewProfile>>;\\n57\\t  visibility: VisibilityBudgets;\\n58\\t  compactThreshold: number;\\n59\\t}\\n60\\t\\n61\\t// ── pull / status shapes (the product crossing to the harness) ────\\n62\\t//\\n63\\t// The pull's array shape (Story 1, load-bearing for Stories 2–5): band\\n64\\t// messages first — one `user` message per non-empty band, gradient order\\n65\\t// brief → detailed → smooth, marker header + snapshot bytes verbatim — then\\n66\\t// the tail in record order. Tail messages render by the message-kind mapping\\n67\\t// table (tech design §Tail message rendering), the contract every later\\n68\\t// story renders into:\\n69\\t//\\n70\\t//   | Message kind                       | Role      | Content shape |\\n71\\t//   |------------------------------------|-----------|---------------|\\n72\\t//   | user_prompt                        | user      | text verbatim |\\n73\\t//   | assistant_text                     | assistant | text verbatim |\\n74\\t//   | assistant_thinking                 | assistant | fenced: `[thinking]\\\\n<text>\\\\n[/thinking]` — included (the tail is full fidelity) |\\n75\\t//   | tool_call                          | assistant | `[tool call · <name>] <compact args>` — deterministic arg rendering, abbreviation rule for oversized args |\\n76\\t//   | tool_result (ahead of boundary)    | user      | `[tool result · <name>]\\\\n<full content>` |\\n77\\t//   | tool_result (at-or-behind boundary)| user      | `[tool result · <name> · abridged]\\\\n<summary or deterministic truncation>` (short-form ladder) |\\n78\\t//   | runtime_note                       | user      | `[runtime note] <text>` |\\n79\\texport interface ViewMessage {\\n80\\t  role: \\\"user\\\" | \\\"assistant\\\";\\n81\\t  content: string;\\n82\\t  band?: Band; // band absent ⇒ tail\\n83\\t}\\n84\\t\\n85\\texport interface ViewMeta {\\n86\\t  compactPoint: number | null; // null ⇒ never compacted (AC-1.3)\\n87\\t  coveredFrom: number | null;\\n88\\t  boundaryPosition: number;\\n89\\t  gapCount: number;\\n90\\t  degradedCount: number;\\n91\\t  viewId: string | null;\\n92\\t  createdAt: string | null;\\n93\\t}\\n94\\t\\n95\\texport interface PullResult {\\n96\\t  messages: ViewMessage[];\\n97\\t  meta: ViewMeta;\\n98\\t}\\n99\\t\\n100\\t// The stored active view row as `threadView.describe` exposes it (Epic 04\\n101\\t// Story 3): the snapshot verbatim — arrangement, gaps, config, source-state\\n102\\t// provenance, per-band stored token counts — never recomputed, never\\n103\\t// repaired. Absent view ⇒ describe returns ok/null, mirroring status's\\n104\\t// never-compacted behavior (DD-1).\\n105\\texport interface StoredView {\\n106\\t  viewId: string;\\n107\\t  createdAt: string;\\n108\\t  compactPoint: number;\\n109\\t  coveredFrom: number;\\n110\\t  // null when explicit params overrode a named base at compact (the stored\\n111\\t  // config carries the resolved truth either way).\\n112\\t  profileName: string | null;\\n113\\t  config: { lowerBound: number; percentages: Record<string, number> };\\n114\\t  // Every selected entry in served order, gap entries included (they are\\n115\\t  // arrangement rows too; `gaps` carries their reasons).\\n116\\t  arrangement: Array<{\\n117\\t    band: Band;\\n118\\t    subjectKind: \\\"chunk\\\" | \\\"turn\\\";\\n119\\t    subjectId: string;\\n120\\t    formUsed: string;\"}]},\"parent_tool_use_id\":null,\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"uuid\":\"dd17a86b-2b9c-4163-9f81-1d4e057f92d0\",\"timestamp\":\"2026-06-13T00:25:56.291Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/view.ts\",\"content\":\"// Epic 03 shared vocabulary: the thread-view types (tech design §Interface\\n// Definitions). Shared so cli/sdk/tests import one home; the thread-view\\n// domain owns the behavior, this module owns only the shapes.\\n\\nexport type Band = \\\"brief\\\" | \\\"detailed\\\" | \\\"smooth\\\";\\n\\nexport interface ViewProfile {\\n  name: string;\\n  // Target assembled size; whole-entry fills may land under or over (epic\\n  // Data Contracts — the bound is a target, not a cap).\\n  lowerBound: number;\\n  // Band shares of the lower bound; must sum to 100 (AC-2.3).\\n  percentages: { full: number; smooth: number; detailed: number; brief: number };\\n}\\n\\n// A user profile entry as configured: a full profile under a new name, or a\\n// field-wise override of a built-in (merged by name, AC-2.2). A partial entry\\n// whose name matches no built-in has nothing to merge over and is rejected at\\n// construction (FC-0.2's unknown-override violation).\\nexport interface ViewProfileOverride {\\n  name: string;\\n  lowerBound?: number;\\n  percentages?: Partial<ViewProfile[\\\"percentages\\\"]>;\\n}\\n\\n// Compact-time explicit parameters (AC-2.2): field-wise overrides of the\\n// base profile, down to single band percentages — the same depth the CLI's\\n// per-band flags override at. A nested-partial deepening of the tech\\n// design's `Partial<ViewProfile>` sketch, which could not express a\\n// single-band override.\\nexport interface ViewCompactParams {\\n  lowerBound?: number;\\n  percentages?: Partial<ViewProfile[\\\"percentages\\\"]>;\\n}\\n\\n// Visibility-boundary budgets (Epic 03 AC-4.x as patched by Epic 05 AC-5.4):\\n// max > target, both positive. The floor budget is retired — its job is done\\n// structurally by the turn-end trigger (the open turn is untouchable) and the\\n// never-evicted newest closed turn (Epic 05 DD-11).\\nexport interface VisibilityBudgets {\\n  maxTokens: number;\\n  targetTokens: number;\\n}\\n\\n// ── SDK assembly config (validated at construction, throws on nonsense\\n// per the Epic 02 rule) ───────────────────────────────────────────\\nexport interface SdkViewConfig {\\n  profiles?: ViewProfileOverride[]; // merged over built-ins by name\\n  visibility?: Partial<VisibilityBudgets>; // defaults: 64000 / 32000\\n  compactThreshold?: number; // status trigger; default 160000\\n}\\n\\n// Every optional filled by createSdk's central defaults; profiles resolved\\n// to complete, validated entries keyed by name.\\nexport interface ResolvedViewConfig {\\n  profiles: Readonly<Record<string, ViewProfile>>;\\n  visibility: VisibilityBudgets;\\n  compactThreshold: number;\\n}\\n\\n// ── pull / status shapes (the product crossing to the harness) ────\\n//\\n// The pull's array shape (Story 1, load-bearing for Stories 2–5): band\\n// messages first — one `user` message per non-empty band, gradient order\\n// brief → detailed → smooth, marker header + snapshot bytes verbatim — then\\n// the tail in record order. Tail messages render by the message-kind mapping\\n// table (tech design §Tail message rendering), the contract every later\\n// story renders into:\\n//\\n//   | Message kind                       | Role      | Content shape |\\n//   |------------------------------------|-----------|---------------|\\n//   | user_prompt                        | user      | text verbatim |\\n//   | assistant_text                     | assistant | text verbatim |\\n//   | assistant_thinking                 | assistant | fenced: `[thinking]\\\\n<text>\\\\n[/thinking]` — included (the tail is full fidelity) |\\n//   | tool_call                          | assistant | `[tool call · <name>] <compact args>` — deterministic arg rendering, abbreviation rule for oversized args |\\n//   | tool_result (ahead of boundary)    | user      | `[tool result · <name>]\\\\n<full content>` |\\n//   | tool_result (at-or-behind boundary)| user      | `[tool result · <name> · abridged]\\\\n<summary or deterministic truncation>` (short-form ladder) |\\n//   | runtime_note                       | user      | `[runtime note] <text>` |\\nexport interface ViewMessage {\\n  role: \\\"user\\\" | \\\"assistant\\\";\\n  content: string;\\n  band?: Band; // band absent ⇒ tail\\n}\\n\\nexport interface ViewMeta {\\n  compactPoint: number | null; // null ⇒ never compacted (AC-1.3)\\n  coveredFrom: number | null;\\n  boundaryPosition: number;\\n  gapCount: number;\\n  degradedCount: number;\\n  viewId: string | null;\\n  createdAt: string | null;\\n}\\n\\nexport interface PullResult {\\n  messages: ViewMessage[];\\n  meta: ViewMeta;\\n}\\n\\n// The stored active view row as `threadView.describe` exposes it (Epic 04\\n// Story 3): the snapshot verbatim — arrangement, gaps, config, source-state\\n// provenance, per-band stored token counts — never recomputed, never\\n// repaired. Absent view ⇒ describe returns ok/null, mirroring status's\\n// never-compacted behavior (DD-1).\\nexport interface StoredView {\\n  viewId: string;\\n  createdAt: string;\\n  compactPoint: number;\\n  coveredFrom: number;\\n  // null when explicit params overrode a named base at compact (the stored\\n  // config carries the resolved truth either way).\\n  profileName: string | null;\\n  config: { lowerBound: number; percentages: Record<string, number> };\\n  // Every selected entry in served order, gap entries included (they are\\n  // arrangement rows too; `gaps` carries their reasons).\\n  arrangement: Array<{\\n    band: Band;\\n    subjectKind: \\\"chunk\\\" | \\\"turn\\\";\\n    subjectId: string;\\n    formUsed: string;\",\"numLines\":120,\"startLine\":1,\"totalLines\":172}}}\n{\"type\":\"stream_event\",\"event\":{\"type\":\"message_stop\"},\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"parent_tool_use_id\":null,\"uuid\":\"6a77d515-64cf-4108-92b9-9047e7391856\"}\n{\"type\":\"system\",\"subtype\":\"status\",\"status\":\"requesting\",\"uuid\":\"d4a6d15b-b591-480e-add7-d5d95d05d3b8\",\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\"}\n{\"type\":\"stream_event\",\"event\":{\"type\":\"message_start\",\"message\":{\"model\":\"claude-fable-5\",\"id\":\"msg_01KqBBA9pZvTsKZZRZPGXoNp\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":292,\"cache_creation_input_tokens\":7280,\"cache_read_input_tokens\":77215,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":7280},\"output_tokens\":3,\"service_tier\":\"standard\",\"inferen
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011VfoeGF84bmoHFbxW35Vn3","type":"tool_result","content":"125\t    inTransaction = true;\n126\t\n127\t    // Cross-domain calls inside the transaction share the open handle through\n128\t    // the operation context (design decision 8); built once per batch, never\n129\t    // stored. onCommit registrations (the scheduler pokes enqueue makes,\n130\t    // DD-5) flush only after COMMIT succeeds; a rollback path never flushes,\n131\t    // so they drop with the transaction.\n132\t    const hooks = createCommitHooks();\n133\t    const ctx: OperationContext = {\n134\t      db,\n135\t      clock,\n136\t      threadId: threadIdOf(db),\n137\t      onCommit: hooks.register,\n138\t      poke: resolveInstancePoke(),\n139\t    };\n140\t\n141\t    // The boundary-advance registration (Epic 03 Flow 4, AC-4.9; trigger\n142\t    // gated by Epic 05 AC-5.1): registered FIRST so the flush runs it before\n143\t    // any queue poke the walk's enqueues register — advance first, poke\n144\t    // second, the pinned order. It runs in both host modes (deterministic and\n145\t    // cheap, unlike the mode-gated drain). Throw-isolated: a failing advance\n146\t    // is caught and diagnosed here, never thrown into the flush — it cannot\n147\t    // eat the pokes behind it and cannot reach this batch's caller; intake's\n148\t    // outcome never depends on it. The boundary is then unchanged and the\n149\t    // over-budget condition stays visible in status (computed live); the next\n150\t    // turn-end batch's check heals.\n151\t    //\n152\t    // The gate (Epic 05 DD-9): the advance check runs only when this batch\n153\t    // COMMITS a turn_end event. The registration site, ordering, and throw\n154\t    // isolation are untouched — the callback consults a flag the walk below\n155\t    // sets when it records a turn_end (skipped duplicates never set it, so a\n156\t    // resent turn_end alone triggers nothing). Mid-turn batches therefore\n157\t    // never move the boundary regardless of zone size.\n158\t    let batchCommittedTurnEnd = false;\n159\t    ctx.onCommit(() => {\n160\t      if (!batchCommittedTurnEnd) return;\n161\t      try {\n162\t        runPostCommitBoundaryAdvance(ctx);\n163\t      } catch (cause) {\n164\t        process.stderr.write(\n165\t          `lhc: boundary advance failed after intake commit (boundary unchanged; condition visible in view status): ${detail(cause)}\\n`,\n166\t        );\n167\t      }\n168\t    });\n169\t\n170\t    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n171\t    // any event is processed — once is sufficient because only this pipeline\n172\t    // writes turn state and the write lock is already held, so more than one\n173\t    // open turn can only mean external interference. The batch records\n174\t    // nothing: nothing has been written yet, and the rollback closes the\n175\t    // never-used transaction.\n176\t    const openTurnIds = listOpenTurnIds(ctx);\n177\t    if (openTurnIds.length > 1) {\n178\t      db.exec(\"ROLLBACK;\");\n179\t      inTransaction = false;\n180\t      return {\n181\t        ok: false,\n182\t        error: {\n183\t          errorClass: \"state_corruption\",\n184\t          code: \"turn_state_corrupt\",\n185\t          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n186\t        },\n187\t      };\n188\t    }\n189\t\n190\t    const skipSet = recordedKeys(\n191\t      db,\n192\t      events.map((event) => event.idempotencyKey),\n193\t    );\n194\t    // Order counter from MAX(event_order): only recorded events increment it,\n195\t    // so skips consume no order numbers and the sequence stays dense.\n196\t    let lastOrder = maxEventOrder(db);\n197\t\n198\t    const insert = db.prepare(\n199\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n200\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n201\t    );\n202\t\n203\t    const eventResults: BatchResult[\"events\"] = [];\n204\t    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n205\t    // Work items append as they queue, in walk order — the result is a\n206\t    // faithful log of what the transaction did (AC-2.7). The full records\n207\t    // (status, queuedAt) stay in the thread file; the result carries item\n208\t    // identity only.\n209\t    const queuedItems: WorkItemRecord[] = [];\n210\t    for (const [index, event] of events.entries()) {\n211\t      if (skipSet.has(event.idempotencyKey)) {\n212\t        eventResults.push({\n213\t          idempotencyKey: event.idempotencyKey,\n214\t          outcome: \"skipped\",\n215\t          skipReason: \"duplicate_idempotency_key\",\n216\t        });\n217\t      } else {\n218\t        lastOrder += 1;\n219\t        if (event.eventKind === \"turn_end\") batchCommittedTurnEnd = true;\n220\t        const recordedAt = clock().toISOString();\n221\t        insert.run(\n222\t          lastOrder,\n223\t          event.eventKind,\n224\t          event.idempotencyKey,\n225\t          event.actor,\n226\t          event.harness,\n227\t          JSON.stringify(event.payload),\n228\t          recordedAt,\n229\t        );\n230\t        skipSet.add(event.idempotencyKey);\n231\t        // Turn transition before projection — the order is load-bearing: a\n232\t        // prompt transitions first and stamps to the turn it just opened\n233\t        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n234\t        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this"}]},"parent_tool_use_id":null,"session_id":"40f6c7de-865c-49b2-84c6-8862983c5a5a","uuid":"9aae7526-afef-4b7b-9a78-de76ce8db0f1","timestamp":"2026-06-13T00:26:35.688Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/intake-stream/internal/pipeline.ts","content":"    inTransaction = true;\n\n    // Cross-domain calls inside the transaction share the open handle through\n    // the operation context (design decision 8); built once per batch, never\n    // stored. onCommit registrations (the scheduler pokes enqueue makes,\n    // DD-5) flush only after COMMIT succeeds; a rollback path never flushes,\n    // so they drop with the transaction.\n    const hooks = createCommitHooks();\n    const ctx: OperationContext = {\n      db,\n      clock,\n      threadId: threadIdOf(db),\n      onCommit: hooks.register,\n      poke: resolveInstancePoke(),\n    };\n\n    // The boundary-advance registration (Epic 03 Flow 4, AC-4.9; trigger\n    // gated by Epic 05 AC-5.1): registered FIRST so the flush runs it before\n    // any queue poke the walk's enqueues register — advance first, poke\n    // second, the pinned order. It runs in both host modes (deterministic and\n    // cheap, unlike the mode-gated drain). Throw-isolated: a failing advance\n    // is caught and diagnosed here, never thrown into the flush — it cannot\n    // eat the pokes behind it and cannot reach this batch's caller; intake's\n    // outcome never depends on it. The boundary is then unchanged and the\n    // over-budget condition stays visible in status (computed live); the next\n    // turn-end batch's check heals.\n    //\n    // The gate (Epic 05 DD-9): the advance check runs only when this batch\n    // COMMITS a turn_end event. The registration site, ordering, and throw\n    // isolation are untouched — the callback consults a flag the walk below\n    // sets when it records a turn_end (skipped duplicates never set it, so a\n    // resent turn_end alone triggers nothing). Mid-turn batches therefore\n    // never move the boundary regardless of zone size.\n    let batchCommittedTurnEnd = false;\n    ctx.onCommit(() => {\n      if (!batchCommittedTurnEnd) return;\n      try {\n        runPostCommitBoundaryAdvance(ctx);\n      } catch (cause) {\n        process.stderr.write(\n          `lhc: boundary advance failed after intake commit (boundary unchanged; condition visible in view status): ${detail(cause)}\\n`,\n        );\n      }\n    });\n\n    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n    // any event is processed — once is sufficient because only this pipeline\n    // writes turn state and the write lock is already held, so more than one\n    // open turn can only mean external interference. The batch records\n    // nothing: nothing has been written yet, and the rollback closes the\n    // never-used transaction.\n    const openTurnIds = listOpenTurnIds(ctx);\n    if (openTurnIds.length > 1) {\n      db.exec(\"ROLLBACK;\");\n      inTransaction = false;\n      return {\n        ok: false,\n        error: {\n          errorClass: \"state_corruption\",\n          code: \"turn_state_corrupt\",\n          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n        },\n      };\n    }\n\n    const skipSet = recordedKeys(\n      db,\n      events.map((event) => event.idempotencyKey),\n    );\n    // Order counter from MAX(event_order): only recorded events increment it,\n    // so skips consume no order numbers and the sequence stays dense.\n    let lastOrder = maxEventOrder(db);\n\n    const insert = db.prepare(\n      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    );\n\n    const eventResults: BatchResult[\"events\"] = [];\n    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n    // Work items append as they queue, in walk order — the result is a\n    // faithful log of what the transaction did (AC-2.7). The full records\n    // (status, queuedAt) stay in the thread file; the result carries item\n    // identity only.\n    const queuedItems: WorkItemRecord[] = [];\n    for (const [index, event] of events.entries()) {\n      if (skipSet.has(event.idempotencyKey)) {\n        eventResults.push({\n          idempotencyKey: event.idempotencyKey,\n          outcome: \"skipped\",\n          skipReason: \"duplicate_idempotency_key\",\n        });\n      } else {\n        lastOrder += 1;\n        if (event.eventKind === \"turn_end\") batchCommittedTurnEnd = true;\n        const recordedAt = clock().toISOString();\n        insert.run(\n          lastOrder,\n          event.eventKind,\n          event.idempotencyKey,\n          event.actor,\n          event.harness,\n          JSON.stringify(event.payload),\n          recordedAt,\n        );\n        skipSet.add(event.idempotencyKey);\n        // Turn transition before projection — the order is load-bearing: a\n        // prompt transitions first and stamps to the turn it just opened\n        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this","numLines":110,"startLine":125,"totalLines":354}}}

n7\\timport { chunkBriefV1 } from \\\"./chunk-brief-v1.js\\\";\\n8\\timport { chunkDetailedV1 } from \\\"./chunk-detailed-v1.js\\\";\\n9\\timport { lowerBandV1 } from \\\"./lower-band-v1.js\\\";\\n10\\timport { smoothingV1 } from \\\"./smoothing-v1.js\\\";\\n11\\timport { toolCallV1 } from \\\"./tool-call-v1.js\\\";\\n12\\timport { toolResultV1 } from \\\"./tool-result-v1.js\\\";\\n13\\timport { turnComposeV1 } from \\\"./turn-compose-v1.js\\\";\\n14\\t\\n15\\texport interface PromptTemplate<I = unknown> {\\n16\\t  name: string;\\n17\\t  render(input: I): ModelCallInput[\\\"messages\\\"];\\n18\\t}\\n19\\t\\n20\\t// Every config-selectable name. `never` pins the registry read-only at the\\n21\\t// type level — rendering goes through the adapter, which owns the only\\n22\\t// kind→input pairing.\\n23\\texport const PROMPT_REGISTRY: Record<string, PromptTemplate<never>> = {\\n24\\t  [smoothingV1.name]: smoothingV1,\\n25\\t  [toolCallV1.name]: toolCallV1,\\n26\\t  [toolResultV1.name]: toolResultV1,\\n27\\t  [turnComposeV1.name]: turnComposeV1,\\n28\\t  [lowerBandV1.name]: lowerBandV1,\\n29\\t  [chunkDetailedV1.name]: chunkDetailedV1,\\n30\\t  [chunkBriefV1.name]: chunkBriefV1,\\n31\\t};\\n32\\t\\n33\\t// The default template per kind — the seven names an operator's first config\\n34\\t// reaches for, and what test fixtures assign.\\n35\\texport const DEFAULT_PROMPT_NAMES: Record<FormKind, string> = {\\n36\\t  smoothed_prompt: smoothingV1.name,\\n37\\t  tool_call_summary: toolCallV1.name,\\n38\\t  tool_result_summary: toolResultV1.name,\\n39\\t  turn_rendering: turnComposeV1.name,\\n40\\t  lower_band_projection: lowerBandV1.name,\\n41\\t  chunk_summary_detailed: chunkDetailedV1.name,\\n42\\t  chunk_summary_brief: chunkBriefV1.name,\\n43\\t};\\n44\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"40f6c7de-865c-49b2-84c6-8862983c5a5a\",\"uuid\":\"6304366b-cfd9-4473-9e89-453c3fd8402e\",\"timestamp\":\"2026-06-13T00:25:46.644Z\",\"tool_use_result\":{\"type\":\"text\",\"fi
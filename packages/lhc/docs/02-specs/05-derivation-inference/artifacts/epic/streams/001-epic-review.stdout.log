{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LSn7zK6i2PPzR5KU3FD2rD","type":"tool_result","content":"1\t// PRE-DIAL-IN: structurally sound, untuned (AC-2.3); the dial-in working\n2\t// period produces the tuned text under a new versioned name. Receipt text is\n3\t// structurally absent here: the brief handler strips it before the provider\n4\t// is called (AC-3.8) and this template's input carries outcomes only.\n5\timport type { ToolOutcome } from \"../../shared/derivation.js\";\n6\timport type { PromptTemplate } from \"./index.js\";\n7\t\n8\tfunction outcomesSection(memberOutcomes?: ToolOutcome[][]): string {\n9\t  const outcomes = (memberOutcomes ?? []).flat();\n10\t  if (outcomes.length === 0) return \"\";\n11\t  return `\\n\\nTool outcomes, in order: ${outcomes.join(\", \")}`;\n12\t}\n13\t\n14\texport const chunkBriefV1: PromptTemplate<{\n15\t  memberProjections: string[];\n16\t  memberOutcomes?: ToolOutcome[][];\n17\t}> = {\n18\t  name: \"chunk-brief-v1\",\n19\t  render: (i) => [\n20\t    {\n21\t      role: \"system\",\n22\t      content:\n23\t        \"You write a brief summary of a sequence of conversation turns. State what was worked on and what was accomplished, and reflect the tool outcomes given. No detail beyond outcomes, no speculation, three sentences maximum.\",\n24\t    },\n25\t    {\n26\t      role: \"user\",\n27\t      content:\n28\t        `Turns, in order:\\n\\n${i.memberProjections\n29\t          .map((projection, idx) => `${String(idx + 1)}. ${projection}`)\n30\t          .join(\"\\n\\n\")}` + outcomesSection(i.memberOutcomes),\n31\t    },\n32\t  ],\n33\t};\n34\t"}]},"parent_tool_use_id":null,"session_id":"40f6c7de-865c-49b2-84c6-8862983c5a5a","uuid":"b771482b-edfb-49c6-a1da-8b75e7f090aa","timestamp":"2026-06-13T00:28:43.593Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/inference/prompts/chunk-brief-v1.ts","content":"// PRE-DIAL-IN: structurally sound, untuned (AC-2.3); the dial-in working\n// period produces the tuned text under a new versioned name. Receipt text is\n// structurally absent here: the brief handler strips it before the provider\n// is called (AC-3.8) and this template's input carries outcomes only.\nimport type { ToolOutcome } from \"../../shared/derivation.js\";\nimport type { PromptTemplate } from \"./index.js\";\n\nfunction outcomesSection(memberOutcomes?: ToolOutcome[][]): string {\n  const outcomes = (memberOutcomes ?? []).flat();\n  if (outcomes.length === 0) return \"\";\n  return `\\n\\nTool outcomes, in order: ${outcomes.join(\", \")}`;\n}\n\nexport const chunkBriefV1: PromptTemplate<{\n  memberProjections: string[];\n  memberOutcomes?: ToolOutcome[][];\n}> = {\n  name: \"chunk-brief-v1\",\n  render: (i) => [\n    {\n      role: \"system\",\n      content:\n        \"You write a brief summary of a sequence of conversation turns. State what was worked on and what was accomplished, and reflect the tool outcomes given. No detail beyond outcomes, no speculation, three sentences maximum.\",\n    },\n    {\n      role: \"user\",\n      content:\n        `Turns, in order:\\n\\n${i.memberProjections\n          .map((projection, idx) => `${String(idx + 1)}. ${projection}`)\n          .join(\"\\n\\n\")}` + outcomesSection(i.memberOutcomes),\n    },\n  ],\n};\n","numLines":34,"startLine":1,"totalLines":34}}}

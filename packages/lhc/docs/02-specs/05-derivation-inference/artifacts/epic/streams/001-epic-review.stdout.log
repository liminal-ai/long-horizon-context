{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SJ7okvJ5K6YwFJKY9TxZCk","type":"tool_result","content":"1\t// The real host (DD-13, AC-4.1): a test-owned ModelCall over OpenRouter's\n2\t// OpenAI-compatible chat-completions endpoint using plain fetch — test code,\n3\t// never production LHC transport. It exists to prove the injected-function\n4\t// contract is sufficient against a real endpoint: the same AC-1.2 shape the\n5\t// scripted fakes implement, exercised by the same seam-conformance helpers.\n6\t//\n7\t// Key resolution and the suite's ran/not-ran accounting also live here so the\n8\t// run/not-run state is one fact reported once (Flow 4): the suite-level guard\n9\t// in inference-real.test.ts calls resolveRealSuiteEnv exactly once at module\n10\t// load and emits exactly one visible line — absence of the key can never look\n11\t// like a pass.\n12\timport type {\n13\t  ModelCall,\n14\t  ModelCallFailureKind,\n15\t  ModelCallResult,\n16\t} from \"../../src/inference/types.js\";\n17\t\n18\texport const OPENROUTER_ENDPOINT = \"https://openrouter.ai/api/v1/chat/completions\";\n19\t\n20\t// The suite's cheap default lane; LHC_OPENROUTER_MODEL overrides it for\n21\t// dial-in experiments without touching test code.\n22\texport const DEFAULT_OPENROUTER_MODEL = \"openai/gpt-4o-mini\";\n23\t\n24\t// The guard's one fact: ran (with the key and the model lane the run will\n25\t// use) or not-ran (with reason). The shapes share no fields, so a not-ran\n26\t// record can never be mistaken for a keyed resolution by any structural\n27\t// check (AC-4.1's \"absence of the key can never produce a silent pass\").\n28\texport type RealSuiteEnv = { key: string; model: string } | { notRan: string };\n29\t\n30\texport function resolveRealSuiteEnv(\n31\t  env: Record<string, string | undefined>,\n32\t): RealSuiteEnv {\n33\t  const key = env[\"LHC_OPENROUTER_KEY\"];\n34\t  if (key === undefined || key.trim() === \"\") {\n35\t    return { notRan: \"LHC_OPENROUTER_KEY unset\" };\n36\t  }\n37\t  const model = env[\"LHC_OPENROUTER_MODEL\"];\n38\t  return {\n39\t    key,\n40\t    model: model !== undefined && model.trim() !== \"\" ? model : DEFAULT_OPENROUTER_MODEL,\n41\t  };\n42\t}\n43\t\n44\t// ── suite-level accounting (AC-4.1) ───────────────────────────────\n45\t//\n46\t// One visible line per resolution, written straight to the runner's stdout\n47\t// (not through a logger a reporter could swallow). The emission log lets the\n48\t// always-run guard test assert \"exactly one ran/not-ran line\" as data.\n49\tconst emissions: string[] = [];\n50\t\n51\texport function emitRealSuiteAccounting(env: RealSuiteEnv): string {\n52\t  const line =\n53\t    \"notRan\" in env\n54\t      ? `NOT-RAN: real-inference (${env.notRan})`\n55\t      : `RAN: real-inference (model ${env.model})`;\n56\t  emissions.push(line);\n57\t  process.stdout.write(`${line}\\n`);\n58\t  return line;\n59\t}\n60\t\n61\texport function realSuiteAccountingEmissions(): readonly string[] {\n62\t  return emissions;\n63\t}\n64\t\n65\t// ── the real ModelCall (AC-1.2 over a real endpoint) ──────────────\n66\t\n67\t// OpenRouter failure mapping (story §Technical Notes): auth-shaped statuses\n68\t// are terminal-classified by LHC, the rest fall where the table says.\n69\tfunction failureKindForStatus(status: number): ModelCallFailureKind {\n70\t  if (status === 401 || status === 403) return \"auth\";\n71\t  if (status === 429) return \"rate_limit\";\n72\t  if (status === 400) return \"invalid_request\";\n73\t  return \"other\";\n74\t}\n75\t\n76\tfunction failure(kind: ModelCallFailureKind, message: string): ModelCallResult {\n77\t  return { ok: false, kind, message };\n78\t}\n79\t\n80\t// The assistant text out of an OpenAI-compatible completion payload, or\n81\t// undefined when the body is not the shape the endpoint documents.\n82\tfunction extractAssistantText(payload: unknown): string | undefined {\n83\t  if (typeof payload !== \"object\" || payload === null) return undefined;\n84\t  const choices = (payload as { choices?: unknown }).choices;\n85\t  if (!Array.isArray(choices) || choices.length === 0) return undefined;\n86\t  const first: unknown = choices[0];\n87\t  if (typeof first !== \"object\" || first === null) return undefined;\n88\t  const message = (first as { message?: unknown }).message;\n89\t  if (typeof message !== \"object\" || message === null) return undefined;\n90\t  const content = (message as { content?: unknown }).content;\n91\t  return typeof content === \"string\" ? content : undefined;\n92\t}\n93\t\n94\t// createOpenRouterCall(key, defaultModel) implements the ModelCall contract\n95\t// over plain fetch. Host-side interpretation of the opaque routing keys\n96\t// (AC-1.2 grants this): OpenRouter takes one model slug, so a `model` string\n97\t// that already names a slug (contains \"/\") routes as-is and anything else —\n98\t// including conformance-probe placeholders — falls to the suite's default\n99\t// model. The provider string is carried but not consulted: this host has\n100\t// exactly one lane behind it.\n101\texport function createOpenRouterCall(key: string, defaultModel: string): ModelCall {\n102\t  return async (input) => {\n103\t    const slug = input.model.includes(\"/\") ? input.model : defaultModel;\n104\t    let response: Response;\n105\t    try {\n106\t      response = await fetch(OPENROUTER_ENDPOINT, {\n107\t        method: \"POST\",\n108\t        headers: {\n109\t          Authorization: `Bearer ${key}`,\n110\t          \"Content-Type\": \"application/json\",\n111\t        },\n112\t        body: JSON.stringify({ model: slug, messages: input.messages }),\n113\t      });\n114\t    } catch (error) {\n115\t      return failure(\"network\", error instanceof Error ? error.message : String(error));\n116\t    }\n117\t    if (!response.ok) {\n118\t      const body = await response.text().catch(() => \"\");\n119\t      return failure(\n120\t        failureKindForStatus(response.status),\n121\t        `HTTP ${String(response.status)}: ${body.slice(0, 200)}`,\n122\t      );\n123\t    }\n124\t    let payload: unknown;\n125\t    try {\n126\t      payload = await response.json();\n127\t    } catch {\n128\t      return failure(\"other\", \"response body was not JSON\");\n129\t    }\n130\t    const text = extractAssistantText(payload);\n131\t    if (text === undefined) {\n132\t      return failure(\"other\", \"response carried no assistant text\");\n133\t    }\n134\t    // Empty/whitespace text crosses the boundary as a success: empty_output\n135\t    // is adapter-generated (AC-2.4); hosts never return it.\n136\t    return { ok: true, text };\n137\t  };\n138\t}\n139\t"}]},"parent_tool_use_id":null,"session_id":"40f6c7de-865c-49b2-84c6-8862983c5a5a","uuid":"1d24de17-bbf9-4fb6-b409-f025f205011c","timestamp":"2026-06-13T00:26:56.865Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/openrouter-call.ts","content":"// The real host (DD-13, AC-4.1): a test-owned ModelCall over OpenRouter's\n// OpenAI-compatible chat-completions endpoint using plain fetch — test code,\n// never production LHC transport. It exists to prove the injected-function\n// contract is sufficient against a real endpoint: the same AC-1.2 shape the\n// scripted fakes implement, exercised by the same seam-conformance helpers.\n//\n// Key resolution and the suite's ran/not-ran accounting also live here so the\n// run/not-run state is one fact reported once (Flow 4): the suite-level guard\n// in inference-real.test.ts calls resolveRealSuiteEnv exactly once at module\n// load and emits exactly one visible line — absence of the key can never look\n// like a pass.\nimport type {\n  ModelCall,\n  ModelCallFailureKind,\n  ModelCallResult,\n} from \"../../src/inference/types.js\";\n\nexport const OPENROUTER_ENDPOINT = \"https://openrouter.ai/api/v1/chat/completions\";\n\n// The suite's cheap default lane; LHC_OPENROUTER_MODEL overrides it for\n// dial-in experiments without touching test code.\nexport const DEFAULT_OPENROUTER_MODEL = \"openai/gpt-4o-mini\";\n\n// The guard's one fact: ran (with the key and the model lane the run will\n// use) or not-ran (with reason). The shapes share no fields, so a not-ran\n// record can never be mistaken for a keyed resolution by any structural\n// check (AC-4.1's \"absence of the key can never produce a silent pass\").\nexport type RealSuiteEnv = { key: string; model: string } | { notRan: string };\n\nexport function resolveRealSuiteEnv(\n  env: Record<string, string | undefined>,\n): RealSuiteEnv {\n  const key = env[\"LHC_OPENROUTER_KEY\"];\n  if (key === undefined || key.trim() === \"\") {\n    return { notRan: \"LHC_OPENROUTER_KEY unset\" };\n  }\n  const model = env[\"LHC_OPENROUTER_MODEL\"];\n  return {\n    key,\n    model: model !== undefined && model.trim() !== \"\" ? model : DEFAULT_OPENROUTER_MODEL,\n  };\n}\n\n// ── suite-level accounting (AC-4.1) ───────────────────────────────\n//\n// One visible line per resolution, written straight to the runner's stdout\n// (not through a logger a reporter could swallow). The emission log lets the\n// always-run guard test assert \"exactly one ran/not-ran line\" as data.\nconst emissions: string[] = [];\n\nexport function emitRealSuiteAccounting(env: RealSuiteEnv): string {\n  const line =\n    \"notRan\" in env\n      ? `NOT-RAN: real-inference (${env.notRan})`\n      : `RAN: real-inference (model ${env.model})`;\n  emissions.push(line);\n  process.stdout.write(`${line}\\n`);\n  return line;\n}\n\nexport function realSuiteAccountingEmissions(): readonly string[] {\n  return emissions;\n}\n\n// ── the real ModelCall (AC-1.2 over a real endpoint) ──────────────\n\n// OpenRouter failure mapping (story §Technical Notes): auth-shaped statuses\n// are terminal-classified by LHC, the rest fall where the table says.\nfunction failureKindForStatus(status: number): ModelCallFailureKind {\n  if (status === 401 || status === 403) return \"auth\";\n  if (status === 429) return \"rate_limit\";\n  if (status === 400) return \"invalid_request\";\n  return \"other\";\n}\n\nfunction failure(kind: ModelCallFailureKind, message: string): ModelCallResult {\n  return { ok: false, kind, message };\n}\n\n// The assistant text out of an OpenAI-compatible completion payload, or\n// undefined when the body is not the shape the endpoint documents.\nfunction extractAssistantText(payload: unknown): string | undefined {\n  if (typeof payload !== \"object\" || payload === null) return undefined;\n  const choices = (payload as { choices?: unknown }).choices;\n  if (!Array.isArray(choices) || choices.length === 0) return undefined;\n  const first: unknown = choices[0];\n  if (typeof first !== \"object\" || first === null) return undefined;\n  const message = (first as { message?: unknown }).message;\n  if (typeof message !== \"object\" || message === null) return undefined;\n  const content = (message as { content?: unknown }).content;\n  return typeof content === \"string\" ? content : undefined;\n}\n\n// createOpenRouterCall(key, defaultModel) implements the ModelCall contract\n// over plain fetch. Host-side interpretation of the opaque routing keys\n// (AC-1.2 grants this): OpenRouter takes one model slug, so a `model` string\n// that already names a slug (contains \"/\") routes as-is and anything else —\n// including conformance-probe placeholders — falls to the suite's default\n// model. The provider string is carried but not consulted: this host has\n// exactly one lane behind it.\nexport function createOpenRouterCall(key: string, defaultModel: string): ModelCall {\n  return async (input) => {\n    const slug = input.model.includes(\"/\") ? input.model : defaultModel;\n    let response: Response;\n    try {\n      response = await fetch(OPENROUTER_ENDPOINT, {\n        method: \"POST\",\n        headers: {\n          Authorization: `Bearer ${key}`,\n          \"Content-Type\": \"application/json\",\n        },\n        body: JSON.stringify({ model: slug, messages: input.messages }),\n      });\n    } catch (error) {\n      return failure(\"network\", error instanceof Error ? error.message : String(error));\n    }\n    if (!response.ok) {\n      const body = await response.text().catch(() => \"\");\n      return failure(\n        failureKindForStatus(response.status),\n        `HTTP ${String(response.status)}: ${body.slice(0, 200)}`,\n      );\n    }\n    let payload: unknown;\n    try {\n      payload = await response.json();\n    } catch {\n      return failure(\"other\", \"response body was not JSON\");\n    }\n    const text = extractAssistantText(payload);\n    if (text === undefined) {\n      return failure(\"other\", \"response carried no assistant text\");\n    }\n    // Empty/whitespace text crosses the boundary as a success: empty_output\n    // is adapter-generated (AC-2.4); hosts never return it.\n    return { ok: true, text };\n  };\n}\n","numLines":139,"startLine":1,"totalLines":139}}}

trips; unknown id exits 1 with thread_not_found\", async () => {\n16:301:    const created = await runCli([\n17:313:    const known = await runCli([\n18:327:    const unknown = await runCli([\n19:342:  it(\"TC-1.5 (CLI): list returns created threads; absent registry lists empty and creates nothing\", async () => {\n20:344:      const result = await runCli([\n21:356:    const listed = await runCli([\"threads\", \"list\", \"--registry\", store.registryPath]);\n22:365:    const empty = await runCli([\"threads\", \"list\", \"--registry\", absentPath]);\n23:374:  it(\"TC-1.6 (CLI): registry failure compensates — exit 1 and the thread file is gone\", async () => {\n24:378:    const result = await runCli([\n=== work-queue ===\n1:14:  runCli,\n2:98:describe(\"Flow 2 (SDK): message-owned work queueing\", () => {\n3:99:  it(\"TC-2.7: a prompt and a tool result each durably queue their kind, owner messages (AC-2.8)\", async () => {\n4:148:  it(\"TC-2.9: text, thinking, and note messages queue nothing — the kind gate is exact (AC-2.8)\", async () => {\n5:161:  it(\"TC-2.6: a mixed batch's result is complete — outcomes, messageIds, transitions, queuedWork, position (AC-2.7)\", async () => {\n6:196:describe(\"Flow 3 (SDK): turn-owned work queueing — Story 4's debt paid\", () => {\n7:197:  it(\"TC-3.3 (work half): explicit close durably queues w-t1-turn_derivation, owner turns (AC-3.4, AC-3.6)\", async () => {\n8:224:  it(\"TC-3.6 (work half): implicit close queues the same work-item contract as the explicit path (AC-3.6)\", async () => {\n9:251:  it(\"TC-3.8 (work count): a multi-turn batch queues one turn_derivation item per closed turn (AC-3.6)\", async () => {\n10:270:  it(\"TC-5.4 (no-work-item clause): a skipped event queues nothing (AC-5.4)\", async () => {\n11:287:describe(\"architecture-risk: durability and rollback over the complete record surface\", () => {\n12:288:  it(\"restart survival: a reopened thread file holds its work items intact, status queued\", async () => {\n13:322:  it(\"complete-surface rollback: a rejected batch leaves events, messages, turns, and work items at baseline (AC-4.6)\", async () => {\n14:343:describe(\"CLI in-process: list-queued-work on both owning domains\", () => {\n15:344:  it(\"messages list-queued-work and turns list-queued-work each return only their owner's items\", async () => {\n16:348:    const messagesListed = await runCli([\"messages\", \"list-queued-work\", \"--file-path\", filePath]);\n17:364:    const turnsListed = await runCli([\"turns\", \"list-queued-work\", \"--file-path\", filePath]);\n18:381:  it(\"list-queued-work on an unknown thread id fails with thread_not_found\", async () => {\n19:382:    const listed = await runCli([\n20:434:describe(\"FC-0.4: work-kind registry and handler-map assembly\", () => {\n21:435:  it(\"the registry covers all six kinds with owner and sourceRef semantics per the Work Item contract\", () => {\n22:446:  it(\"createSdk assembles the handler map from domain tables; an unregistered kind reports the miss explicitly\", () => {\n23:469:  it(\"assembly merges per-domain tables, dispatch finds a registered handler, and a doubly-claimed kind is refused\", () => {\n24:489:describe(\"architecture-risk: enqueue atomicity — row, pending form, poke commit or vanish together\", () => {\n25:495:  it(\"a committed intake batch durably writes work rows + pending forms and pokes once per enqueue, after commit\", async () => {\n26:521:  it(\"an induced rollback after enqueue drops the work row, the pending form row, and the poke\", async () => {\n27:543:  it(\"enqueue via runInTransaction: rollback drops all three effects; commit lands them and then pokes\", async () => {\n28:592:  it(\"re-enqueueing at a later source version resets the form row to pending at that version\", async () => {\n=== validation ===\n1:10:  runCli,\n2:39:describe(\"Flow 4 (SDK): batch validation and rejection\", () => {\n3:40:  it(\"TC-4.1: four invalidity categories, each rejected whole with a named reason\", async () => {\n4:81:  it(\"TC-4.2: first failure names index 2; the valid earlier events did not land\", async () => {\n5:98:  it(\"TC-4.3: after a rejection the thread reads back logically identical to its baseline\", async () => {\n6:116:  it(\"TC-4.4 (caller/system legs): error classes separate; corruption leg is Story 4's\", async () => {\n7:141:    const cliCaller = await runCli(\n8:153:    const cliSystem = await runCli([\n9:170:  it(\"TC-4.5: a batch mixing new, duplicate, and invalid events is rejected whole\", async () => {\n10:193:  it(\"strictness supplemental: unknown fields rejected at envelope, event, and payload levels\", async () => {\n11:229:  it(\"strictness supplemental: empty actor and empty harness are rejected\", async () => {\n=== inspect-view ===\n1:15:  runCli,\n2:140:    const edited = await sdk.messages.edit(\n3:194:describe(\"TC-2.1 / AC-2.1, AC-2.5: arrangement fidelity from the stored snapshot\", () => {\n4:195:  it(\"report entries, forms, degraded flags, gap reasons, config, and provenance equal describe output and the stored row\", async () => {\n5:202:    const described = valueOf<StoredView | null>(await sdk.threadView.describe({ filePath }));\n6:251:  it(\"describe returns ok/null on a never-compacted thread and thread_not_found on a missing one\", async () => {\n7:253:    const described = await sdk.threadView.describe({ filePath });\n8:258:    const missing = await sdk.threadView.describe({ filePath: store.threadPath(\"missing\") });\n9:267:describe(\"TC-2.2 / AC-2.2, AC-2.3: loadCost parity on a boundary-advanced fixture\", () => {\n10:268:  it(\"tail costs short forms short and total equals an independent pull re-measured\", async () => {\n11:348:describe(\"TC-2.3 / AC-2.4: never-compacted thread reports tail-only under the same parity contract\", () => {\n12:349:  it(\"meta null, bands empty, tail spans the record, cost parity holds\", async () => {\n13:372:describe(\"AC-1.4 contract: view and describe are pure reads\", () => {\n14:373:  it(\"repeated calls are deep-equal, leave no delta, and call no provider — including under a throwing provider\", async () => {\n15:381:      sdk.threadView.describe({ filePath }),\n16:404:      reader.threadView.describe({ filePath }),\n17:409:  it(\"inspect.view on a missing thread is thread_not_found, not a shape error\", async () => {\n18:419:describe(\"CLI parity: lhc inspect view returns SDK-parity JSON\", () => {\n19:420:  it(\"the in-process CLI result deep-equals the SDK result on compacted and never-compacted threads\", async () => {\n20:423:    const viaCli = await runCli([\"inspect\", \"view\", \"--file-path\", filePath]);\n21:429:    const plainCli = await runCli([\"inspect\", \"view\", \"--file-path\", plain.filePath]);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_018Z5aRszc6TPtBUF6j9M1eu","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LXYMkHGg7wTBxp4ESA9MSM","name":"Edit","input":{"replace_all":false,"file_path":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/turns.test.ts","old_string":"    expect(classes.size).toBe(3);\n\n    // The corruption class reaches the CLI error rendering unchanged.\n    const cliCorruption = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", corruptPath],\n      async () => JSON.stringify([validEvent(\"assistant_text\")]),\n    );\n    expect(cliCorruption.exitCode).toBe(1);\n    const parsed = JSON.parse(cliCorruption.stdout) as {\n      ok: boolean;\n      error: { errorClass: string; code: string };\n    };\n    expect(parsed.ok).toBe(false);\n    expect(parsed.error.errorClass).toBe(\"state_corruption\");\n    expect(parsed.error.code).toBe(\"turn_state_corrupt\");\n  });","new_string":"    expect(classes.size).toBe(3);\n  });"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2652,"cache_read_input_tokens":106076,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2652},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9f78dc1a-4fbe-4699-948e-9b3f41e6eacd","uuid":"97fa76c1-cf65-42ce-a81b-2bcf1689be95","request_id":"req_011Cbz2TtZd9NTXeudnAsfQU"}

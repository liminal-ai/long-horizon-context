{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018wCX42isDuGpehEWox84Qa","type":"tool_result","content":"1\timport { describe, expect, it } from \"vitest\";\n2\timport { estimateTokens, runCli, TOKEN_ESTIMATOR_ID } from \"../src/index.js\";\n3\t\n4\t// Story 1 made the threads commands real (test/threads.test.ts), Story 2 the\n5\t// intake-stream commands (test/intake.test.ts), Story 3 messages list\n6\t// (test/projection.test.ts), Story 4 turns list (test/turns.test.ts), and\n7\t// Story 5 both list-queued-work commands (test/work-queue.test.ts); no\n8\t// stubbed commands remain, so the Story 0 fail-closed-stub rail test retired\n9\t// with its last entry.\n10\t\n11\tdescribe(\"FC-0.3: CLI rail\", () => {\n12\t  it(\"responds to --help with usage for every planned command\", async () => {\n13\t    const result = await runCli([\"--help\"]);\n14\t    expect(result.exitCode).toBe(0);\n15\t    expect(result.stdout).toContain(\"Usage:\");\n16\t    for (const command of [\n17\t      \"threads new-thread\",\n18\t      \"threads resolve\",\n19\t      \"threads list\",\n20\t      \"intake-stream message-events\",\n21\t      \"intake-stream list-events\",\n22\t      \"messages list\",\n23\t      \"messages list-queued-work\",\n24\t      \"turns list\",\n25\t      \"turns list-queued-work\",\n26\t    ]) {\n27\t      expect(result.stdout).toContain(command);\n28\t    }\n29\t  });\n30\t\n31\t  it(\"unknown commands exit non-zero with a structured error\", async () => {\n32\t    const result = await runCli([\"frobnicate\", \"everything\"]);\n33\t    expect(result.exitCode).toBe(1);\n34\t    const parsed = JSON.parse(result.stdout) as {\n35\t      ok: boolean;\n36\t      error: { errorClass: string; code: string; reason: string };\n37\t    };\n38\t    expect(parsed.ok).toBe(false);\n39\t    expect(parsed.error.errorClass).toBe(\"caller_error\");\n40\t    expect(parsed.error.code).toBe(\"unknown_command\");\n41\t    expect(parsed.error.reason).toContain(\"frobnicate\");\n42\t  });\n43\t\n44\t  it(\"no command at all exits non-zero with a structured error\", async () => {\n45\t    const result = await runCli([]);\n46\t    expect(result.exitCode).toBe(1);\n47\t    const parsed = JSON.parse(result.stdout) as { ok: boolean };\n48\t    expect(parsed.ok).toBe(false);\n49\t  });\n50\t});\n51\t\n52\tdescribe(\"FC-0.5: token counting\", () => {\n53\t  it(\"pins the estimator identity\", () => {\n54\t    expect(TOKEN_ESTIMATOR_ID).toBe(\"js-tiktoken:o200k_base\");\n55\t  });\n56\t\n57\t  it(\"returns golden counts for known strings\", () => {\n58\t    expect(estimateTokens(\"\")).toBe(0);\n59\t    expect(estimateTokens(\"hello world\")).toBe(2);\n60\t  });\n61\t\n62\t  it(\"same input, same count, every run\", () => {\n63\t    const inputs = [\n64\t      \"hello world\",\n65\t      \"The quick brown fox jumps over the lazy dog.\",\n66\t      \"tokens: émojis 🎉 and 中文 text\",\n67\t      JSON.stringify({ toolCallId: \"call-1\", arguments: { path: \"notes.txt\" } }),\n68\t    ];\n69\t    for (const input of inputs) {\n70\t      const first = estimateTokens(input);\n71\t      expect(first).toBeGreaterThan(0);\n72\t      expect(estimateTokens(input)).toBe(first);\n73\t      expect(estimateTokens(input)).toBe(first);\n74\t    }\n75\t  });\n76\t});\n77\t"}]},"parent_tool_use_id":null,"session_id":"9f78dc1a-4fbe-4699-948e-9b3f41e6eacd","uuid":"ca550b18-d03a-4cda-a8e1-d3d7f01a5388","timestamp":"2026-06-12T20:46:30.323Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/smoke.test.ts","content":"import { describe, expect, it } from \"vitest\";\nimport { estimateTokens, runCli, TOKEN_ESTIMATOR_ID } from \"../src/index.js\";\n\n// Story 1 made the threads commands real (test/threads.test.ts), Story 2 the\n// intake-stream commands (test/intake.test.ts), Story 3 messages list\n// (test/projection.test.ts), Story 4 turns list (test/turns.test.ts), and\n// Story 5 both list-queued-work commands (test/work-queue.test.ts); no\n// stubbed commands remain, so the Story 0 fail-closed-stub rail test retired\n// with its last entry.\n\ndescribe(\"FC-0.3: CLI rail\", () => {\n  it(\"responds to --help with usage for every planned command\", async () => {\n    const result = await runCli([\"--help\"]);\n    expect(result.exitCode).toBe(0);\n    expect(result.stdout).toContain(\"Usage:\");\n    for (const command of [\n      \"threads new-thread\",\n      \"threads resolve\",\n      \"threads list\",\n      \"intake-stream message-events\",\n      \"intake-stream list-events\",\n      \"messages list\",\n      \"messages list-queued-work\",\n      \"turns list\",\n      \"turns list-queued-work\",\n    ]) {\n      expect(result.stdout).toContain(command);\n    }\n  });\n\n  it(\"unknown commands exit non-zero with a structured error\", async () => {\n    const result = await runCli([\"frobnicate\", \"everything\"]);\n    expect(result.exitCode).toBe(1);\n    const parsed = JSON.parse(result.stdout) as {\n      ok: boolean;\n      error: { errorClass: string; code: string; reason: string };\n    };\n    expect(parsed.ok).toBe(false);\n    expect(parsed.error.errorClass).toBe(\"caller_error\");\n    expect(parsed.error.code).toBe(\"unknown_command\");\n    expect(parsed.error.reason).toContain(\"frobnicate\");\n  });\n\n  it(\"no command at all exits non-zero with a structured error\", async () => {\n    const result = await runCli([]);\n    expect(result.exitCode).toBe(1);\n    const parsed = JSON.parse(result.stdout) as { ok: boolean };\n    expect(parsed.ok).toBe(false);\n  });\n});\n\ndescribe(\"FC-0.5: token counting\", () => {\n  it(\"pins the estimator identity\", () => {\n    expect(TOKEN_ESTIMATOR_ID).toBe(\"js-tiktoken:o200k_base\");\n  });\n\n  it(\"returns golden counts for known strings\", () => {\n    expect(estimateTokens(\"\")).toBe(0);\n    expect(estimateTokens(\"hello world\")).toBe(2);\n  });\n\n  it(\"same input, same count, every run\", () => {\n    const inputs = [\n      \"hello world\",\n      \"The quick brown fox jumps over the lazy dog.\",\n      \"tokens: émojis 🎉 and 中文 text\",\n      JSON.stringify({ toolCallId: \"call-1\", arguments: { path: \"notes.txt\" } }),\n    ];\n    for (const input of inputs) {\n      const first = estimateTokens(input);\n      expect(first).toBeGreaterThan(0);\n      expect(estimateTokens(input)).toBe(first);\n      expect(estimateTokens(input)).toBe(first);\n    }\n  });\n});\n","numLines":77,"startLine":1,"totalLines":77}}}

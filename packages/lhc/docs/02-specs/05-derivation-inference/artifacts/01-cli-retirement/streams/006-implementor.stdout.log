{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RfMgXWVZQEhdvZPCMCtcdx","type":"tool_result","content":"355\t    expect(await readBack(filePath)).toEqual(baseline);\n356\t  });\n357\t});\n358\t\n359\tdescribe(\"TC-4.4: three error classes, asserted against each other (AC-4.7)\", () => {\n360\t  it(\"validation, corruption, and storage failures carry three distinct classes with stable codes\", async () => {\n361\t    // Caller leg: a malformed event.\n362\t    const callerPath = await createThread();\n363\t    const callerLeg = await intakeStream.messageEvents({ filePath: callerPath }, [\n364\t      { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n365\t    ]);\n366\t    expect(callerLeg.ok).toBe(false);\n367\t    if (callerLeg.ok) return;\n368\t    expect(callerLeg.error.errorClass).toBe(\"caller_error\");\n369\t    expect(callerLeg.error.code).toBe(\"invalid_event\");\n370\t\n371\t    // Corruption leg: the two-open-turns fixture.\n372\t    const corruptPath = await createThread();\n373\t    await send(corruptPath, [validEvent(\"user_prompt\")]);\n374\t    corruptTwoOpenTurns(corruptPath);\n375\t    const corruptionLeg = await intakeStream.messageEvents({ filePath: corruptPath }, [\n376\t      validEvent(\"assistant_text\"),\n377\t    ]);\n378\t    expect(corruptionLeg.ok).toBe(false);\n379\t    if (corruptionLeg.ok) return;\n380\t    expect(corruptionLeg.error.errorClass).toBe(\"state_corruption\");\n381\t    expect(corruptionLeg.error.code).toBe(\"turn_state_corrupt\");\n382\t\n383\t    // System leg: registry creation under a path whose parent is a file.\n384\t    const blocker = join(store.dir, \"blocker-file\");\n385\t    writeFileSync(blocker, \"regular file standing where a directory must be\");\n386\t    const systemLeg = await threads.newThread({\n387\t      filePath: store.threadPath(),\n388\t      registryPath: join(blocker, \"registry.sqlite\"),\n389\t    });\n390\t    expect(systemLeg.ok).toBe(false);\n391\t    if (systemLeg.ok) return;\n392\t    expect(systemLeg.error.errorClass).toBe(\"system_error\");\n393\t    expect(systemLeg.error.code).toBe(\"storage_failure\");\n394\t\n395\t    // The three classes compared against each other, not pattern-matched\n396\t    // individually.\n397\t    const classes = new Set([\n398\t      callerLeg.error.errorClass,\n399\t      corruptionLeg.error.errorClass,\n400\t      systemLeg.error.errorClass,\n401\t    ]);\n402\t    expect(classes.size).toBe(3);\n403\t\n404\t    // The corruption class reaches the CLI error rendering unchanged.\n405\t    const cliCorruption = await runCli(\n406\t      [\"intake-stream\", \"message-events\", \"--file-path\", corruptPath],\n407\t      async () => JSON.stringify([validEvent(\"assistant_text\")]),\n408\t    );\n409\t    expect(cliCorruption.exitCode).toBe(1);\n410\t    const parsed = JSON.parse(cliCorruption.stdout) as {\n411\t      ok: boolean;\n412\t      error: { errorClass: string; code: string };\n413\t    };\n414\t    expect(parsed.ok).toBe(false);\n415\t    expect(parsed.error.errorClass).toBe(\"state_corruption\");\n416\t    expect(parsed.error.code).toBe(\"turn_state_corrupt\");\n417\t  });\n418\t});\n419\t"}]},"parent_tool_use_id":null,"session_id":"9f78dc1a-4fbe-4699-948e-9b3f41e6eacd","uuid":"1badcf9f-5ce0-4529-8e2b-72a82b09dfe9","timestamp":"2026-06-12T20:50:37.330Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/turns.test.ts","content":"    expect(await readBack(filePath)).toEqual(baseline);\n  });\n});\n\ndescribe(\"TC-4.4: three error classes, asserted against each other (AC-4.7)\", () => {\n  it(\"validation, corruption, and storage failures carry three distinct classes with stable codes\", async () => {\n    // Caller leg: a malformed event.\n    const callerPath = await createThread();\n    const callerLeg = await intakeStream.messageEvents({ filePath: callerPath }, [\n      { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n    ]);\n    expect(callerLeg.ok).toBe(false);\n    if (callerLeg.ok) return;\n    expect(callerLeg.error.errorClass).toBe(\"caller_error\");\n    expect(callerLeg.error.code).toBe(\"invalid_event\");\n\n    // Corruption leg: the two-open-turns fixture.\n    const corruptPath = await createThread();\n    await send(corruptPath, [validEvent(\"user_prompt\")]);\n    corruptTwoOpenTurns(corruptPath);\n    const corruptionLeg = await intakeStream.messageEvents({ filePath: corruptPath }, [\n      validEvent(\"assistant_text\"),\n    ]);\n    expect(corruptionLeg.ok).toBe(false);\n    if (corruptionLeg.ok) return;\n    expect(corruptionLeg.error.errorClass).toBe(\"state_corruption\");\n    expect(corruptionLeg.error.code).toBe(\"turn_state_corrupt\");\n\n    // System leg: registry creation under a path whose parent is a file.\n    const blocker = join(store.dir, \"blocker-file\");\n    writeFileSync(blocker, \"regular file standing where a directory must be\");\n    const systemLeg = await threads.newThread({\n      filePath: store.threadPath(),\n      registryPath: join(blocker, \"registry.sqlite\"),\n    });\n    expect(systemLeg.ok).toBe(false);\n    if (systemLeg.ok) return;\n    expect(systemLeg.error.errorClass).toBe(\"system_error\");\n    expect(systemLeg.error.code).toBe(\"storage_failure\");\n\n    // The three classes compared against each other, not pattern-matched\n    // individually.\n    const classes = new Set([\n      callerLeg.error.errorClass,\n      corruptionLeg.error.errorClass,\n      systemLeg.error.errorClass,\n    ]);\n    expect(classes.size).toBe(3);\n\n    // The corruption class reaches the CLI error rendering unchanged.\n    const cliCorruption = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", corruptPath],\n      async () => JSON.stringify([validEvent(\"assistant_text\")]),\n    );\n    expect(cliCorruption.exitCode).toBe(1);\n    const parsed = JSON.parse(cliCorruption.stdout) as {\n      ok: boolean;\n      error: { errorClass: string; code: string };\n    };\n    expect(parsed.ok).toBe(false);\n    expect(parsed.error.errorClass).toBe(\"state_corruption\");\n    expect(parsed.error.code).toBe(\"turn_state_corrupt\");\n  });\n});\n","numLines":65,"startLine":355,"totalLines":420}}}

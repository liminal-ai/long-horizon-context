{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NCHeyKtDdHwig3GBBHqWfn","type":"tool_result","content":"370\t  batch?: readonly MessageEventInput[],\n371\t): Promise<{ sdkPath: string; cliPath: string; batch: readonly MessageEventInput[] }> {\n372\t  const events =\n373\t    batch ??\n374\t    ([\n375\t      validEvent(\"user_prompt\", { payload: { text: \"twin prompt\" } }),\n376\t      validEvent(\"assistant_text\", { payload: { text: \"twin answer\" } }),\n377\t      validEvent(\"tool_call\", {\n378\t        payload: { toolCallId: \"call-twin-1\", toolName: \"read_file\", arguments: { path: \"t.txt\" } },\n379\t      }),\n380\t      validEvent(\"tool_result\", {\n381\t        payload: { toolCallId: \"call-twin-1\", content: \"twin tool output\", isError: false },\n382\t      }),\n383\t      validEvent(\"turn_end\"),\n384\t    ] as const);\n385\t\n386\t  setIntakeClock(() => new Date(\"2026-06-10T12:00:00.000Z\"));\n387\t  try {\n388\t    const sdkPath = await newThreadFile(store);\n389\t    await send(sdkPath, events);\n390\t\n391\t    const cliPath = store.threadPath();\n392\t    const created = await runCli([\n393\t      \"threads\",\n394\t      \"new-thread\",\n395\t      \"--file-path\",\n396\t      cliPath,\n397\t      \"--registry\",\n398\t      store.registryPath,\n399\t    ]);\n400\t    if (created.exitCode !== 0) {\n401\t      throw new Error(`fixture CLI new-thread failed: ${created.stdout}`);\n402\t    }\n403\t    const recorded = await runCli(\n404\t      [\"intake-stream\", \"message-events\", \"--file-path\", cliPath],\n405\t      async () => JSON.stringify(events),\n406\t    );\n407\t    if (recorded.exitCode !== 0) {\n408\t      throw new Error(`fixture CLI message-events failed: ${recorded.stdout}`);\n409\t    }\n410\t    return { sdkPath, cliPath, batch: events };\n411\t  } finally {\n412\t    setIntakeClock(null);\n413\t  }\n414\t}\n415\t"}]},"parent_tool_use_id":null,"session_id":"9f78dc1a-4fbe-4699-948e-9b3f41e6eacd
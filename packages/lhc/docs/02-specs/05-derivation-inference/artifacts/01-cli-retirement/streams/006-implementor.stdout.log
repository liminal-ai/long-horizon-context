{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BTpHHmZZoPWpDX7bfrwbXq","type":"tool_result","content":"1\timport { configDefaults, defineConfig } from \"vitest/config\";\n2\t\n3\t// The CLI process-boundary suite spawns dist/cli.js and needs a build\n4\t// artifact, so it runs under verify-all only (LHC_PROCESS_SUITE=1). Its\n5\t// absence from plain verify is announced by the verify script, never silent.\n6\tconst includeProcessSuite = process.env[\"LHC_PROCESS_SUITE\"] === \"1\";\n7\t\n8\texport default defineConfig({\n9\t  test: {\n10\t    // Process-suite tests spawn dist/cli.js subprocesses; under verify-all the\n11\t    // whole suite runs concurrently and per-spawn latency climbs with CPU\n12\t    // contention, so they need headroom past Vitest's 5s default. The editable\n13\t    // process files already set explicit per-test timeouts (30s floor; 60s/120s\n14\t    // for compaction-heavy legs, which override this global). This floor covers\n15\t    // the ones that don't — notably the hash-locked cli-process-report-repair —\n16\t    // without touching the locked test. Plain verify keeps the tight 5s default\n17\t    // so the in-process unit tests stay fast and a genuine hang surfaces quickly.\n18\t    ...(includeProcessSuite ? { testTimeout: 30000, hookTimeout: 30000 } : {}),\n19\t    include: [\"test/**/*.test.ts\"],\n20\t    exclude: [\n21\t      ...configDefaults.exclude,\n22\t      ...(includeProcessSuite\n23\t        ? []\n24\t        : [\n25\t            \"test/cli-process.test.ts\",\n26\t            \"test/cli-process-intake.test.ts\",\n27\t            \"test/cli-process-projection.test.ts\",\n28\t            \"test/cli-process-turns.test.ts\",\n29\t            \"test/cli-process-work-queue.test.ts\",\n30\t            \"test/cli-process-work.test.ts\",\n31\t            \"test/cli-process-report-repair.test.ts\",\n32\t            \"test/cli-process-mutations.test.ts\",\n33\t            \"test/cli-process-mutations-delete.test.ts\",\n34\t            \"test/cli-process-fix.test.ts\",\n35\t            \"test/cli-process-view.test.ts\",\n36\t            \"test/cli-process-inspect.test.ts\",\n37\t          ]),\n38\t    ],\n39\t    passWithNoTests: true,\n40\t  },\n41\t});\n42\t"}]},"parent_tool_use_id":null,"session_id":"9f78dc1a-4fbe-4699-948e-9b3f41e6eacd","uuid":"766256a7-4bc1-4f75-8a35-1f48afca1ac3","timestamp":"2026-06-12T20:49:50.511Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/vitest.config.ts","content":"import { configDefaults, defineConfig } from \"vitest/config\";\n\n// The CLI process-boundary suite spawns dist/cli.js and needs a build\n// artifact, so it runs under verify-all only (LHC_PROCESS_SUITE=1). Its\n// absence from plain verify is announced by the verify script, never silent.\nconst includeProcessSuite = process.env[\"LHC_PROCESS_SUITE\"] === \"1\";\n\nexport default defineConfig({\n  test: {\n    // Process-suite tests spawn dist/cli.js subprocesses; under verify-all the\n    // whole suite runs concurrently and per-spawn latency climbs with CPU\n    // contention, so they need headroom past Vitest's 5s default. The editable\n    // process files already set explicit per-test timeouts (30s floor; 60s/120s\n    // for compaction-heavy legs, which override this global). This floor covers\n    // the ones that don't — notably the hash-locked cli-process-report-repair —\n    // without touching the locked test. Plain verify keeps the tight 5s default\n    // so the in-process unit tests stay fast and a genuine hang surfaces quickly.\n    ...(includeProcessSuite ? { testTimeout: 30000, hookTimeout: 30000 } : {}),\n    include: [\"test/**/*.test.ts\"],\n    exclude: [\n      ...configDefaults.exclude,\n      ...(includeProcessSuite\n        ? []\n        : [\n            \"test/cli-process.test.ts\",\n            \"test/cli-process-intake.test.ts\",\n            \"test/cli-process-projection.test.ts\",\n            \"test/cli-process-turns.test.ts\",\n            \"test/cli-process-work-queue.test.ts\",\n            \"test/cli-process-work.test.ts\",\n            \"test/cli-process-report-repair.test.ts\",\n            \"test/cli-process-mutations.test.ts\",\n            \"test/cli-process-mutations-delete.test.ts\",\n            \"test/cli-process-fix.test.ts\",\n            \"test/cli-process-view.test.ts\",\n            \"test/cli-process-inspect.test.ts\",\n          ]),\n    ],\n    passWithNoTests: true,\n  },\n});\n","numLines":42,"startLine":1,"totalLines":42}}}

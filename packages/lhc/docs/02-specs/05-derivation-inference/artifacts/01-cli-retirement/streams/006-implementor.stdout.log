{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YNT4pBVSBxUGnaTEBkgof8","type":"tool_result","content":"1\t// Flow 2 (recording half): TC-2.1, TC-2.8, TC-1.4 (closing Story 1's\n2\t// deferral), the four architecture-risk tests (mid-walk rollback, restart\n3\t// survival, no-lock-on-rejection, system_error rollback parity), and the CLI\n4\t// in-process stdin legs.\n5\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n6\timport {\n7\t  intakeStream,\n8\t  runCli,\n9\t  threads,\n10\t  type EventRecord,\n11\t  type MessageEventInput,\n12\t} from \"../src/index.js\";\n13\timport {\n14\t  conversationTurn,\n15\t  eventBatch,\n16\t  openRaw,\n17\t  setIntakeClock,\n18\t  setIntakeWalkHook,\n19\t  tempStore,\n20\t  validEvent,\n21\t  type TempStore,\n22\t} from \"./fixtures/index.js\";\n23\t\n24\tlet store: TempStore;\n25\tbeforeEach(() => {\n26\t  store = tempStore();\n27\t});\n28\tafterEach(() => {\n29\t  setIntakeWalkHook(null);\n30\t  setIntakeClock(null);\n31\t  store.cleanup();\n32\t});\n33\t\n34\tasync function createThread(): Promise<string> {\n35\t  const filePath = store.threadPath();\n36\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n37\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n38\t  return filePath;\n39\t}\n40\t\n41\tasync function readBack(filePath: string): Promise<EventRecord[]> {\n42\t  const result = await intakeStream.listEvents({ filePath });\n43\t  if (!result.ok) throw new Error(`read-back failed: ${result.error.reason}`);\n44\t  return result.value;\n45\t}\n46\t\n47\tdescribe(\"Flow 2 (SDK): event recording\", () => {\n48\t  it(\"TC-2.1: two batches record in array order with a dense, continuing event order\", async () => {\n49\t    const filePath = await createThread();\n50\t    const batchOne = eventBatch([\"user_prompt\", \"assistant_text\", \"tool_call\"]);"}]},"parent_tool_use_id":null,"session_i
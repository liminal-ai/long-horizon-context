{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KPd6LsTUCCZDv1LnC4wRj8","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t// Zero-dependency import-boundary check.\n3\t// Rules:\n4\t//   1. No file may import another domain's internal/ modules.\n5\t//   2. tech-utils/ and shared/ may not import from domains/.\n6\t//   3. A domain may import another domain's surface (index.ts) only along an\n7\t//      edge pinned in ALLOWED_SURFACE_IMPORTS below — a new cross-domain\n8\t//      edge is a conscious decision, never a silent pass.\n9\t// The test fixtures directory (test/fixtures/) is exempt by design — it is\n10\t// the one sanctioned below-SDK writer.\n11\timport { readdirSync, readFileSync, statSync } from \"node:fs\";\n12\timport path from \"node:path\";\n13\timport { fileURLToPath } from \"node:url\";\n14\t\n15\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n16\tconst srcRoot = path.join(pkgRoot, \"src\");\n17\tconst testRoot = path.join(pkgRoot, \"test\");\n18\tconst fixturesRoot = path.join(testRoot, \"fixtures\");\n19\t\n20\tfunction collectTsFiles(dir, out = []) {\n21\t  let entries;\n22\t  try {\n23\t    entries = readdirSync(dir);\n24\t  } catch {\n25\t    return out;\n26\t  }\n27\t  for (const entry of entries) {\n28\t    const full = path.join(dir, entry);\n29\t    if (full === fixturesRoot) continue; // fixtures exempt\n30\t    if (statSync(full).isDirectory()) {\n31\t      collectTsFiles(full, out);\n32\t    } else if (full.endsWith(\".ts\")) {\n33\t      out.push(full);\n34\t    }\n35\t  }\n36\t  return out;\n37\t}\n38\t\n39\tfunction importSpecifiers(source) {\n40\t  const specs = [];\n41\t  const patterns = [\n42\t    /(?:^|\\s)import\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n43\t    /(?:^|\\s)export\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n44\t    /(?:^|\\s)import\\s+[\"']([^\"']+)[\"']/gm,\n45\t    /import\\(\\s*[\"']([^\"']+)[\"']\\s*\\)/g,\n46\t  ];\n47\t  for (const re of patterns) {\n48\t    let m;\n49\t    while ((m = re.exec(source)) !== null) specs.push(m[1]);\n50\t  }\n51\t  return specs;\n52\t}\n53\t\n54\tfunction domainOf(filePath) {\n55\t  const rel = path.relative(srcRoot, filePath);\n56\t  const parts = rel.split(path.sep);\n57\t  if (parts[0] === \"domains\" && parts.length > 1) return parts[1];\n58\t  return null;\n59\t}\n60\t\n61\t// The pinned domain-surface dependency edges (rule 3). Epic 03 adds two:\n62\t// thread-view consumes the messages/turns report surfaces and the threads\n63\t// resolver; intake-stream gains the thread-view surface for the boundary\n64\t// advance registration (Flow 4).\n65\t// SANCTIONED CYCLE (Epic 03 tech design §Module Boundaries): intake-stream →\n66\t// thread-view → messages/turns → intake-stream (the last edges are type-only\n67\t// event vocabulary). The domain graph is therefore deliberately not a DAG —\n68\t// runtime-safe because the advance is registration-then-flush with no\n69\t// import-time execution — so this check pins the allowed edge set instead of\n70\t// asserting acyclicity.\n71\tconst ALLOWED_SURFACE_IMPORTS = {\n72\t  \"intake-stream\": new Set([\"threads\", \"messages\", \"turns\", \"thread-view\"]),\n73\t  messages: new Set([\"threads\", \"intake-stream\"]),\n74\t  turns: new Set([\"threads\", \"intake-stream\", \"messages\"]),\n75\t  \"thread-view\": new Set([\"threads\", \"messages\", \"turns\"]),\n76\t  threads: new Set(),\n77\t  // Epic 04: inspect sits at the top of the graph — pure consumer of the\n78\t  // five surfaces, nothing imports it except sdk.ts and cli/. Acyclic by\n79\t  // construction.\n80\t  inspect: new Set([\"threads\", \"intake-stream\", \"messages\", \"turns\", \"thread-view\"]),\n81\t};\n82\t\n83\t// Epic 04 source check (tech design §Testing Strategy): inspect composes\n84\t// other domains' SURFACES — it owns no tables and may not reach storage at\n85\t// all. Any sqlite usage or SQL keyword over a known table name inside\n86\t// domains/inspect/** is a violation; a direct-SQL implementation could match\n87\t// report output while violating inspect's entire contract.\n88\tconst INSPECT_FORBIDDEN_PATTERNS = [\n89\t  [/node:sqlite/, \"imports node:sqlite\"],\n90\t  [/DatabaseSync/, \"references DatabaseSync\"],\n91\t  [/\\.prepare\\s*\\(/, \"prepares a SQL statement\"],\n92\t  [\n93\t    /\\b(?:FROM|JOIN|INSERT\\s+INTO|UPDATE|DELETE\\s+FROM)\\s+(?:event|message|message_block|turns|chunk|chunk_member|work_item|derived_form|thread_metadata|thread_view|thread_view_band|view_boundary)\\b/i,\n94\t    \"contains raw SQL over a domain table\",\n95\t  ],\n96\t];\n97\t\n98\tfunction inspectSourceViolations(file, source) {\n99\t  const rel = path.relative(srcRoot, file);\n100\t  if (!rel.startsWith(path.join(\"domains\", \"inspect\") + path.sep)) return [];\n101\t  const found = [];\n102\t  for (const [pattern, label] of INSPECT_FORBIDDEN_PATTERNS) {\n103\t    if (pattern.test(source)) {\n104\t      found.push(`${path.relative(pkgRoot, file)} ${label} — inspect may not read storage`);\n105\t    }\n106\t  }\n107\t  return found;\n108\t}\n109\t\n110\tconst files = [...collectTsFiles(srcRoot), ...collectTsFiles(testRoot)];\n111\tconst violations = [];\n112\t\n113\tfor (const file of files) {\n114\t  const source = readFileSync(file, \"utf8\");\n115\t  violations.push(...inspectSourceViolations(file, source));\n116\t  const fileDomain = domainOf(file);\n117\t  const inTechUtilsOrShared =\n118\t    file.startsWith(path.join(srcRoot, \"tech-utils\") + path.sep) ||\n119\t    file.startsWith(path.join(srcRoot, \"shared\") + path.sep);\n120\t\n121\t  for (const spec of importSpecifiers(source)) {\n122\t    if (!spec.startsWith(\".\")) continue; // only relative imports cross our tree\n123\t    const resolved = path.resolve(path.dirname(file), spec);\n124\t    const relToSrc = path.relative(srcRoot, resolved);\n125\t    if (relToSrc.startsWith(\"..\")) continue; // outside src/\n126\t    const parts = relToSrc.split(path.sep);\n127\t\n128\t    if (parts[0] === \"domains\" && parts.includes(\"internal\")) {\n129\t      const targetDomain = parts[1];\n130\t      if (fileDomain !== targetDomain) {\n131\t        violations.push(\n132\t          `${path.relative(pkgRoot, file)} imports ${spec} — reaches into domain \"${targetDomain}\" internal/`,\n133\t        );\n134\t      }\n135\t    }\n136\t    if (\n137\t      parts[0] === \"domains\" &&\n138\t      !parts.includes(\"internal\") &&\n139\t      fileDomain !== null &&\n140\t      parts[1] !== fileDomain\n141\t    ) {\n142\t      const targetDomain = parts[1];\n143\t      const allowed = ALLOWED_SURFACE_IMPORTS[fileDomain];\n144\t      if (allowed === undefined || !allowed.has(targetDomain)) {\n145\t        violations.push(\n146\t          `${path.relative(pkgRoot, file)} imports ${spec} — domain \"${fileDomain}\" has no pinned surface edge to \"${targetDomain}\" (rule 3)`,\n147\t        );\n148\t      }\n149\t    }\n150\t    if (inTechUtilsOrShared && parts[0] === \"domains\") {\n151\t      violations.push(\n152\t        `${path.relative(pkgRoot, file)} imports ${spec} — tech-utils/shared may not import domains/`,\n153\t      );\n154\t    }\n155\t  }\n156\t}\n157\t\n158\tif (violations.length > 0) {\n159\t  console.error(\"boundary check FAILED:\");\n160\t  for (const v of violations) console.error(`  - ${v}`);\n161\t  process.exit(1);\n162\t}\n163\tconsole.log(`boundaries: OK (${files.length} files checked, fixtures exempt)`);\n164\t"}]},"parent_tool_use_id":null,"session_id":"9f78dc1a-4fbe-4699-948e-9b3f41e6eacd","uuid":"69aebdf9-d2b7-4e91-9bca-bb62f330cc1b","timestamp":"2026-06-12T20:47:40.688Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/scripts/check-boundaries.mjs","content":"#!/usr/bin/env node\n// Zero-dependency import-boundary check.\n// Rules:\n//   1. No file may import another domain's internal/ modules.\n//   2. tech-utils/ and shared/ may not import from domains/.\n//   3. A domain may import another domain's surface (index.ts) only along an\n//      edge pinned in ALLOWED_SURFACE_IMPORTS below — a new cross-domain\n//      edge is a conscious decision, never a silent pass.\n// The test fixtures directory (test/fixtures/) is exempt by design — it is\n// the one sanctioned below-SDK writer.\nimport { readdirSync, readFileSync, statSync } from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\n\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst srcRoot = path.join(pkgRoot, \"src\");\nconst testRoot = path.join(pkgRoot, \"test\");\nconst fixturesRoot = path.join(testRoot, \"fixtures\");\n\nfunction collectTsFiles(dir, out = []) {\n  let entries;\n  try {\n    entries = readdirSync(dir);\n  } catch {\n    return out;\n  }\n  for (const entry of entries) {\n    const full = path.join(dir, entry);\n    if (full === fixturesRoot) continue; // fixtures exempt\n    if (statSync(full).isDirectory()) {\n      collectTsFiles(full, out);\n    } else if (full.endsWith(\".ts\")) {\n      out.push(full);\n    }\n  }\n  return out;\n}\n\nfunction importSpecifiers(source) {\n  const specs = [];\n  const patterns = [\n    /(?:^|\\s)import\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    /(?:^|\\s)export\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    /(?:^|\\s)import\\s+[\"']([^\"']+)[\"']/gm,\n    /import\\(\\s*[\"']([^\"']+)[\"']\\s*\\)/g,\n  ];\n  for (const re of patterns) {\n    let m;\n    while ((m = re.exec(source)) !== null) specs.push(m[1]);\n  }\n  return specs;\n}\n\nfunction domainOf(filePath) {\n  const rel = path.relative(srcRoot, filePath);\n  const parts = rel.split(path.sep);\n  if (parts[0] === \"domains\" && parts.length > 1) return parts[1];\n  return null;\n}\n\n// The pinned domain-surface dependency edges (rule 3). Epic 03 adds two:\n// thread-view consumes the messages/turns report surfaces and the threads\n// resolver; intake-stream gains the thread-view surface for the boundary\n// advance registration (Flow 4).\n// SANCTIONED CYCLE (Epic 03 tech design §Module Boundaries): intake-stream →\n// thread-view → messages/turns → intake-stream (the last edges are type-only\n// event vocabulary). The domain graph is therefore deliberately not a DAG —\n// runtime-safe because the advance is registration-then-flush with no\n// import-time execution — so this check pins the allowed edge set instead of\n// asserting acyclicity.\nconst ALLOWED_SURFACE_IMPORTS = {\n  \"intake-stream\": new Set([\"threads\", \"messages\", \"turns\", \"thread-view\"]),\n  messages: new Set([\"threads\", \"intake-stream\"]),\n  turns: new Set([\"threads\", \"intake-stream\", \"messages\"]),\n  \"thread-view\": new Set([\"threads\", \"messages\", \"turns\"]),\n  threads: new Set(),\n  // Epic 04: inspect sits at the top of the graph — pure consumer of the\n  // five surfaces, nothing imports it except sdk.ts and cli/. Acyclic by\n  // construction.\n  inspect: new Set([\"threads\", \"intake-stream\", \"messages\", \"turns\", \"thread-view\"]),\n};\n\n// Epic 04 source check (tech design §Testing Strategy): inspect composes\n// other domains' SURFACES — it owns no tables and may not reach storage at\n// all. Any sqlite usage or SQL keyword over a known table name inside\n// domains/inspect/** is a violation; a direct-SQL implementation could match\n// report output while violating inspect's entire contract.\nconst INSPECT_FORBIDDEN_PATTERNS = [\n  [/node:sqlite/, \"imports node:sqlite\"],\n  [/DatabaseSync/, \"references DatabaseSync\"],\n  [/\\.prepare\\s*\\(/, \"prepares a SQL statement\"],\n  [\n    /\\b(?:FROM|JOIN|INSERT\\s+INTO|UPDATE|DELETE\\s+FROM)\\s+(?:event|message|message_block|turns|chunk|chunk_member|work_item|derived_form|thread_metadata|thread_view|thread_view_band|view_boundary)\\b/i,\n    \"contains raw SQL over a domain table\",\n  ],\n];\n\nfunction inspectSourceViolations(file, source) {\n  const rel = path.relative(srcRoot, file);\n  if (!rel.startsWith(path.join(\"domains\", \"inspect\") + path.sep)) return [];\n  const found = [];\n  for (const [pattern, label] of INSPECT_FORBIDDEN_PATTERNS) {\n    if (pattern.test(source)) {\n      found.push(`${path.relative(pkgRoot, file)} ${label} — inspect may not read storage`);\n    }\n  }\n  return found;\n}\n\nconst files = [...collectTsFiles(srcRoot), ...collectTsFiles(testRoot)];\nconst violations = [];\n\nfor (const file of files) {\n  const source = readFileSync(file, \"utf8\");\n  violations.push(...inspectSourceViolations(file, source));\n  const fileDomain = domainOf(file);\n  const inTechUtilsOrShared =\n    file.startsWith(path.join(srcRoot, \"tech-utils\") + path.sep) ||\n    file.startsWith(path.join(srcRoot, \"shared\") + path.sep);\n\n  for (const spec of importSpecifiers(source)) {\n    if (!spec.startsWith(\".\")) continue; // only relative imports cross our tree\n    const resolved = path.resolve(path.dirname(file), spec);\n    const relToSrc = path.relative(srcRoot, resolved);\n    if (relToSrc.startsWith(\"..\")) continue; // outside src/\n    const parts = relToSrc.split(path.sep);\n\n    if (parts[0] === \"domains\" && parts.includes(\"internal\")) {\n      const targetDomain = parts[1];\n      if (fileDomain !== targetDomain) {\n        violations.push(\n          `${path.relative(pkgRoot, file)} imports ${spec} — reaches into domain \"${targetDomain}\" internal/`,\n        );\n      }\n    }\n    if (\n      parts[0] === \"domains\" &&\n      !parts.includes(\"internal\") &&\n      fileDomain !== null &&\n      parts[1] !== fileDomain\n    ) {\n      const targetDomain = parts[1];\n      const allowed = ALLOWED_SURFACE_IMPORTS[fileDomain];\n      if (allowed === undefined || !allowed.has(targetDomain)) {\n        violations.push(\n          `${path.relative(pkgRoot, file)} imports ${spec} — domain \"${fileDomain}\" has no pinned surface edge to \"${targetDomain}\" (rule 3)`,\n        );\n      }\n    }\n    if (inTechUtilsOrShared && parts[0] === \"domains\") {\n      violations.push(\n        `${path.relative(pkgRoot, file)} imports ${spec} — tech-utils/shared may not import domains/`,\n      );\n    }\n  }\n}\n\nif (violations.length > 0) {\n  console.error(\"boundary check FAILED:\");\n  for (const v of violations) console.error(`  - ${v}`);\n  process.exit(1);\n}\nconsole.log(`boundaries: OK (${files.length} files checked, fixtures exempt)`);\n","numLines":164,"startLine":1,"totalLines":164}}}

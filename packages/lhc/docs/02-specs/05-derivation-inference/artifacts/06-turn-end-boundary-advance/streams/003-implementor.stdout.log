{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014NmyKPFrxqSfB4MpXJz3Vb","type":"tool_result","content":"180\t      tail.some((message) => message.content.includes(\"harness restarted between turns\")),\n181\t    ).toBe(false);\n182\t  });\n183\t});\n184\t\n185\t// ── Boundary G1 (Story 4, architecture-risk): the trajectory golden ─────\n186\t//\n187\t// Committed expected positions after each scripted batch — floor/target\n188\t// arithmetic off-by-ones survive property tests, not goldens. The expected\n189\t// values were hand-derived from the design rules (tech design §Boundary\n190\t// advance) before implementation: contents are n joined \"tok\" words (exactly\n191\t// n o200k tokens each), so every sum in the golden is checkable by hand.\n192\t// Every advance fires through a real intake commit; positions and zone sums\n193\t// read back through real pull/status calls (no test-only advance surface).\n194\t\n195\tinterface BoundaryGolden {\n196\t  case: string;\n197\t  budgets: { maxTokens: number; targetTokens: number; floorTokens: number };\n198\t  batches: Array<{\n199\t    label: string;\n200\t    resultTokens: number[];\n201\t    turnEnd: boolean;\n202\t    expectedPosition: number;\n203\t    expectedZoneTokens: number;\n204\t  }>;\n205\t}\n206\t\n207\tfunction trajectoryTokens(n: number): string {\n208\t  return Array<string>(n).fill(\"tok\").join(\" \");\n209\t}\n210\t\n211\tlet trajectoryCallCounter = 0;\n212\t\n213\tfunction trajectoryBatch(batch: BoundaryGolden[\"batches\"][number]): MessageEventInput[] {\n214\t  const events: MessageEventInput[] = [\n215\t    validEvent(\"user_prompt\", { payload: { text: \"trajectory prompt\" } }),\n216\t  ];\n217\t  for (const n of batch.resultTokens) {\n218\t    trajectoryCallCounter += 1;\n219\t    const toolCallId = `call-g1b-${trajectoryCallCounter}`;\n220\t    events.push(\n221\t      validEvent(\"tool_call\", {\n222\t        payload: { toolCallId, toolName: \"read_file\", arguments: { path: `g1b-${trajectoryCallCounter}.txt` } },\n223\t      }),\n224\t      validEvent(\"tool_result\", {\n225\t        payload: { toolCallId, content: trajectoryTokens(n), isError: false },\n226\t      }),\n227\t    );\n228\t  }\n229\t  if (batch.turnEnd) events.push(validEvent(\"turn_end\"));\n230\t  return events;\n231\t}\n232\t\n233\t// One full replay of the golden's script against a fresh thread: the\n234\t// committed positions and zone sums after each batch."}]},"parent_tool_use_id":null,"session_id":"bb1f3fcf-4d78-4a97-8c5b-320e502ce14a","uuid":"45aa8991-0371-4677-88ca-dbfc0c5f85d7","timestamp":"2026-06-12T23:39:01.616Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-select-golden.test.ts","content":"      tail.some((message) => message.content.includes(\"harness restarted between turns\")),\n    ).toBe(false);\n  });\n});\n\n// ── Boundary G1 (Story 4, architecture-risk): the trajectory golden ─────\n//\n// Committed expected positions after each scripted batch — floor/target\n// arithmetic off-by-ones survive property tests, not goldens. The expected\n// values were hand-derived from the design rules (tech design §Boundary\n// advance) before implementation: contents are n joined \"tok\" words (exactly\n// n o200k tokens each), so every sum in the golden is checkable by hand.\n// Every advance fires through a real intake commit; positions and zone sums\n// read back through real pull/status calls (no test-only advance surface).\n\ninterface BoundaryGolden {\n  case: string;\n  budgets: { maxTokens: number; targetTokens: number; floorTokens: number };\n  batches: Array<{\n    label: string;\n    resultTokens: number[];\n    turnEnd: boolean;\n    expectedPosition: number;\n    expectedZoneTokens: number;\n  }>;\n}\n\nfunction trajectoryTokens(n: number): string {\n  return Array<string>(n).fill(\"tok\").join(\" \");\n}\n\nlet trajectoryCallCounter = 0;\n\nfunction trajectoryBatch(batch: BoundaryGolden[\"batches\"][number]): MessageEventInput[] {\n  const events: MessageEventInput[] = [\n    validEvent(\"user_prompt\", { payload: { text: \"trajectory prompt\" } }),\n  ];\n  for (const n of batch.resultTokens) {\n    trajectoryCallCounter += 1;\n    const toolCallId = `call-g1b-${trajectoryCallCounter}`;\n    events.push(\n      validEvent(\"tool_call\", {\n        payload: { toolCallId, toolName: \"read_file\", arguments: { path: `g1b-${trajectoryCallCounter}.txt` } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId, content: trajectoryTokens(n), isError: false },\n      }),\n    );\n  }\n  if (batch.turnEnd) events.push(validEvent(\"turn_end\"));\n  return events;\n}\n\n// One full replay of the golden's script against a fresh thread: the\n// committed positions and zone sums after each batch.","numLines":55,"startLine":180,"totalLines":283}}}

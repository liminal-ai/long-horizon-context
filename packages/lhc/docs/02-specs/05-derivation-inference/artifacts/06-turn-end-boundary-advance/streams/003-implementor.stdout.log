{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012PgFdDwT1sKWRzLScZkfwm","type":"tool_result","content":"1\t// Visibility boundary (Stories 1 + 4). The boundary is a source event\n2\t// order shared with the compact point's coordinate system; tool results\n3\t// at-or-behind it render short. Its writers are exactly two: the\n4\t// post-commit advance below (Story 4) and compact's reset, which lands\n5\t// inside compact's own transaction (snapshot.ts, Story 2).\n6\timport type { DatabaseSync } from \"node:sqlite\";\n7\timport type { VisibilityBudgets } from \"../../../shared/view.js\";\n8\t\n9\t// The singleton row exists from migration v6 on (seeded at position 0,\n10\t// everything full). A missing row is a damaged thread file, surfaced as a\n11\t// throw for the operation boundary's storage_failure wrap.\n12\texport function readBoundaryPosition(db: DatabaseSync): number {\n13\t  const row = db\n14\t    .prepare(`SELECT position FROM view_boundary WHERE thread_singleton = 1`)\n15\t    .get() as { position: number | bigint } | undefined;\n16\t  if (row === undefined) {\n17\t    throw new Error(\"view_boundary singleton row missing (migration v6 seeds it)\");\n18\t  }\n19\t  return Number(row.position);\n20\t}\n21\t\n22\t// The visibility zone's token sum: live (deleted-filtered) tool results ahead\n23\t// of both the boundary position and the compact point, one indexed query.\n24\t// Parameterized by position on purpose (story Technical Notes): Story 4's\n25\t// advance consumes this same function instead of re-deriving the sum, so\n26\t// \"the advance's sum equals what status reports\" is structural — the design\n27\t// requires the two sums equal, and sharing the query makes that a fact of\n28\t// the code rather than a discipline.\n29\texport function visibilityZoneTokens(\n30\t  db: DatabaseSync,\n31\t  position: number,\n32\t  compactPoint: number,\n33\t): number {\n34\t  const row = db\n35\t    .prepare(\n36\t      `SELECT COALESCE(SUM(token_estimate), 0) AS zone FROM message\n37\t       WHERE kind = 'tool_result' AND deleted_at IS NULL\n38\t         AND source_event_order > ? AND source_event_order > ?`,\n39\t    )\n40\t    .get(position, compactPoint) as { zone: number | bigint };\n41\t  return Number(row.zone);\n42\t}\n43\t\n44\t// ── the post-commit advance (Story 4, AC-4.3–4.6, 4.9) ───────────\n45\t\n46\t// The compact point for the advance's zone predicate: the stored view's, or\n47\t// the zero origin when the thread has never compacted — the same default the\n48\t// pull uses, read without dragging band bytes along.\n49\tfunction readCompactPoint(db: DatabaseSync): number {\n50\t  const row = db\n51\t    .prepare(`SELECT compact_point FROM thread_view WHERE singleton = 1`)\n52\t    .get() as { compact_point: number | bigint } | undefined;\n53\t  return row === undefined ? 0 : Number(row.compact_point);\n54\t}\n55\t\n56\t// One zone member as the decision walks it. Rows come back oldest-first by\n57\t// source event order — the flip order AC-4.3 pins.\n58\texport interface ZoneToolResult {\n59\t  sourceEventOrder: number;\n60\t  tokenEstimate: number;\n61\t}\n62\t\n63\t// The zone's member rows: the same population visibilityZoneTokens sums —\n64\t// identical WHERE clause on purpose, so the decision's arithmetic and the\n65\t// status read's sum can never diverge (story Technical Notes; TC-4.6's\n66\t// status assertion is the canary).\n67\tfunction readZoneToolResults(\n68\t  db: DatabaseSync,\n69\t  position: number,\n70\t  compactPoint: number,\n71\t): ZoneToolResult[] {\n72\t  const rows = db\n73\t    .prepare(\n74\t      `SELECT source_event_order, token_estimate FROM message\n75\t       WHERE kind = 'tool_result' AND deleted_at IS NULL\n76\t         AND source_event_order > ? AND source_event_order > ?\n77\t       ORDER BY source_event_order`,\n78\t    )\n79\t    .all(position, compactPoint) as unknown as Array<{\n80\t    source_event_order: number | bigint;\n81\t    token_estimate: number | bigint;\n82\t  }>;\n83\t  return rows.map((row) => ({\n84\t    sourceEventOrder: Number(row.source_event_order),\n85\t    tokenEstimate: Number(row.token_estimate),\n86\t  }));\n87\t}\n88\t\n89\t// The pure decision (tech design §Boundary advance): token sums from stored\n90\t// per-message estimates, no inference, no IO — same inputs, same answer\n91\t// (AC-4.4; Boundary G1's trajectory golden drives the arithmetic).\n92\t//\n93\t// Zone is the full-rendering tool results oldest-first. Under-or-at max the\n94\t// boundary does not move. Over max, walk oldest-first accumulating flips\n95\t// until the remaining sum is at-or-under target OR the next flip would touch\n96\t// the protected set. The floor protects whole messages: walking\n97\t// newest-backward, results join the protected set until its sum first\n98\t// reaches or exceeds the floor — so the newest result is always protected\n99\t// when any exists, an oversized newest result is protected alone, and the\n100\t// zone may legally sit above target (or max) until newer batches or a\n101\t// compact create room (AC-4.5).\n102\texport function advanceDecision(\n103\t  zone: readonly ZoneToolResult[],\n104\t  budgets: VisibilityBudgets,\n105\t): number | null {\n106\t  let total = 0;\n107\t  for (const result of zone) total += result.tokenEstimate;\n108\t  if (total <= budgets.maxTokens) return null;\n109\t\n110\t  // protectedStart: index of the oldest member of the protected set.\n111\t  let protectedStart = zone.length;\n112\t  let protectedSum = 0;\n113\t  while (protectedStart > 0 && protectedSum < budgets.floorTokens) {\n114\t    protectedStart -= 1;\n115\t    protectedSum += zone[protectedStart]?.tokenEstimate ?? 0;\n116\t  }\n117\t\n118\t  let remaining = total;\n119\t  let newPosition: number | null = null;\n120\t  for (let i = 0; i < protectedStart && remaining > budgets.targetTokens; i += 1) {\n121\t    const flipped = zone[i];\n122\t    if (flipped === undefined) break;\n123\t    remaining -= flipped.tokenEstimate;\n124\t    newPosition = flipped.sourceEventOrder;\n125\t  }\n126\t  return newPosition;\n127\t}\n128\t\n129\t// The advance executor: indexed sum → over max ⇒ decide → write the new\n130\t// position in its own short transaction (never inside intake's — AC-4.9's\n131\t// isolation; this runs at flush, strictly after intake's COMMIT). The\n132\t// position-forward guard in the UPDATE makes never-backward (AC-4.6) a\n133\t// property of the write, not just of the decision's inputs.\n134\texport function executeBoundaryAdvance(\n135\t  db: DatabaseSync,\n136\t  budgets: VisibilityBudgets,\n137\t  clock: () => Date,\n138\t): void {\n139\t  const position = readBoundaryPosition(db);\n140\t  const compactPoint = readCompactPoint(db);\n141\t  if (visibilityZoneTokens(db, position, compactPoint) <= budgets.maxTokens) return;\n142\t\n143\t  const zone = readZoneToolResults(db, position, compactPoint);\n144\t  const newPosition = advanceDecision(zone, budgets);\n145\t  if (newPosition === null || newPosition <= position) return;\n146\t\n147\t  db.exec(\"BEGIN IMMEDIATE;\");\n148\t  try {\n149\t    db.prepare(\n150\t      `UPDATE view_boundary SET position = ?, updated_at = ?\n151\t       WHERE thread_singleton = 1 AND position < ?`,\n152\t    ).run(newPosition, clock().toISOString(), newPosition);\n153\t    db.exec(\"COMMIT;\");\n154\t  } catch (cause) {\n155\t    db.exec(\"ROLLBACK;\");\n156\t    throw cause;\n157\t  }\n158\t}\n159\t"}]},"parent_tool_use_id":null,"session_id":"bb1f3fcf-4d78-4a97-8c5b-320e502ce14a","uuid":"5c5ec55c-a3ac-4612-99ed-f1e416051df7","timestamp":"2026-06-12T23:36:37.323Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/internal/boundary.ts","content":"// Visibility boundary (Stories 1 + 4). The boundary is a source event\n// order shared with the compact point's coordinate system; tool results\n// at-or-behind it render short. Its writers are exactly two: the\n// post-commit advance below (Story 4) and compact's reset, which lands\n// inside compact's own transaction (snapshot.ts, Story 2).\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { VisibilityBudgets } from \"../../../shared/view.js\";\n\n// The singleton row exists from migration v6 on (seeded at position 0,\n// everything full). A missing row is a damaged thread file, surfaced as a\n// throw for the operation boundary's storage_failure wrap.\nexport function readBoundaryPosition(db: DatabaseSync): number {\n  const row = db\n    .prepare(`SELECT position FROM view_boundary WHERE thread_singleton = 1`)\n    .get() as { position: number | bigint } | undefined;\n  if (row === undefined) {\n    throw new Error(\"view_boundary singleton row missing (migration v6 seeds it)\");\n  }\n  return Number(row.position);\n}\n\n// The visibility zone's token sum: live (deleted-filtered) tool results ahead\n// of both the boundary position and the compact point, one indexed query.\n// Parameterized by position on purpose (story Technical Notes): Story 4's\n// advance consumes this same function instead of re-deriving the sum, so\n// \"the advance's sum equals what status reports\" is structural — the design\n// requires the two sums equal, and sharing the query makes that a fact of\n// the code rather than a discipline.\nexport function visibilityZoneTokens(\n  db: DatabaseSync,\n  position: number,\n  compactPoint: number,\n): number {\n  const row = db\n    .prepare(\n      `SELECT COALESCE(SUM(token_estimate), 0) AS zone FROM message\n       WHERE kind = 'tool_result' AND deleted_at IS NULL\n         AND source_event_order > ? AND source_event_order > ?`,\n    )\n    .get(position, compactPoint) as { zone: number | bigint };\n  return Number(row.zone);\n}\n\n// ── the post-commit advance (Story 4, AC-4.3–4.6, 4.9) ───────────\n\n// The compact point for the advance's zone predicate: the stored view's, or\n// the zero origin when the thread has never compacted — the same default the\n// pull uses, read without dragging band bytes along.\nfunction readCompactPoint(db: DatabaseSync): number {\n  const row = db\n    .prepare(`SELECT compact_point FROM thread_view WHERE singleton = 1`)\n    .get() as { compact_point: number | bigint } | undefined;\n  return row === undefined ? 0 : Number(row.compact_point);\n}\n\n// One zone member as the decision walks it. Rows come back oldest-first by\n// source event order — the flip order AC-4.3 pins.\nexport interface ZoneToolResult {\n  sourceEventOrder: number;\n  tokenEstimate: number;\n}\n\n// The zone's member rows: the same population visibilityZoneTokens sums —\n// identical WHERE clause on purpose, so the decision's arithmetic and the\n// status read's sum can never diverge (story Technical Notes; TC-4.6's\n// status assertion is the canary).\nfunction readZoneToolResults(\n  db: DatabaseSync,\n  position: number,\n  compactPoint: number,\n): ZoneToolResult[] {\n  const rows = db\n    .prepare(\n      `SELECT source_event_order, token_estimate FROM message\n       WHERE kind = 'tool_result' AND deleted_at IS NULL\n         AND source_event_order > ? AND source_event_order > ?\n       ORDER BY source_event_order`,\n    )\n    .all(position, compactPoint) as unknown as Array<{\n    source_event_order: number | bigint;\n    token_estimate: number | bigint;\n  }>;\n  return rows.map((row) => ({\n    sourceEventOrder: Number(row.source_event_order),\n    tokenEstimate: Number(row.token_estimate),\n  }));\n}\n\n// The pure decision (tech design §Boundary advance): token sums from stored\n// per-message estimates, no inference, no IO — same inputs, same answer\n// (AC-4.4; Boundary G1's trajectory golden drives the arithmetic).\n//\n// Zone is the full-rendering tool results oldest-first. Under-or-at max the\n// boundary does not move. Over max, walk oldest-first accumulating flips\n// until the remaining sum is at-or-under target OR the next flip would touch\n// the protected set. The floor protects whole messages: walking\n// newest-backward, results join the protected set until its sum first\n// reaches or exceeds the floor — so the newest result is always protected\n// when any exists, an oversized newest result is protected alone, and the\n// zone may legally sit above target (or max) until newer batches or a\n// compact create room (AC-4.5).\nexport function advanceDecision(\n  zone: readonly ZoneToolResult[],\n  budgets: VisibilityBudgets,\n): number | null {\n  let total = 0;\n  for (const result of zone) total += result.tokenEstimate;\n  if (total <= budgets.maxTokens) return null;\n\n  // protectedStart: index of the oldest member of the protected set.\n  let protectedStart = zone.length;\n  let protectedSum = 0;\n  while (protectedStart > 0 && protectedSum < budgets.floorTokens) {\n    protectedStart -= 1;\n    protectedSum += zone[protectedStart]?.tokenEstimate ?? 0;\n  }\n\n  let remaining = total;\n  let newPosition: number | null = null;\n  for (let i = 0; i < protectedStart && remaining > budgets.targetTokens; i += 1) {\n    const flipped = zone[i];\n    if (flipped === undefined) break;\n    remaining -= flipped.tokenEstimate;\n    newPosition = flipped.sourceEventOrder;\n  }\n  return newPosition;\n}\n\n// The advance executor: indexed sum → over max ⇒ decide → write the new\n// position in its own short transaction (never inside intake's — AC-4.9's\n// isolation; this runs at flush, strictly after intake's COMMIT). The\n// position-forward guard in the UPDATE makes never-backward (AC-4.6) a\n// property of the write, not just of the decision's inputs.\nexport function executeBoundaryAdvance(\n  db: DatabaseSync,\n  budgets: VisibilityBudgets,\n  clock: () => Date,\n): void {\n  const position = readBoundaryPosition(db);\n  const compactPoint = readCompactPoint(db);\n  if (visibilityZoneTokens(db, position, compactPoint) <= budgets.maxTokens) return;\n\n  const zone = readZoneToolResults(db, position, compactPoint);\n  const newPosition = advanceDecision(zone, budgets);\n  if (newPosition === null || newPosition <= position) return;\n\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    db.prepare(\n      `UPDATE view_boundary SET position = ?, updated_at = ?\n       WHERE thread_singleton = 1 AND position < ?`,\n    ).run(newPosition, clock().toISOString(), newPosition);\n    db.exec(\"COMMIT;\");\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n}\n","numLines":159,"startLine":1,"totalLines":159}}}

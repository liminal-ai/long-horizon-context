{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BHLf7w2qc4NyDUH6cemrAF","type":"tool_result","content":"230\t  return events;\n231\t}\n232\t\n233\t// One full replay of the golden's script against a fresh thread: the\n234\t// committed positions and zone sums after each batch.\n235\tasync function replayTrajectory(\n236\t  golden: BoundaryGolden,\n237\t): Promise<Array<{ position: number; zoneTokens: number }>> {\n238\t  const sdk = createSdk({\n239\t    provider: createProviderDouble(),\n240\t    mode: \"manual\",\n241\t    view: { visibility: golden.budgets },\n242\t  });\n243\t  const filePath = store.threadPath();\n244\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n245\t  if (!created.ok) throw new Error(`trajectory thread creation failed: ${created.error.reason}`);\n246\t\n247\t  const observed: Array<{ position: number; zoneTokens: number }> = [];\n248\t  for (const batch of golden.batches) {\n249\t    const result = await sdk.intakeStream.messageEvents({ filePath }, trajectoryBatch(batch));\n250\t    if (!result.ok) throw new Error(`trajectory intake failed: ${result.error.reason}`);\n251\t    const pulled = await sdk.threadView.pull({ filePath });\n252\t    const status = await sdk.threadView.status({ filePath });\n253\t    if (!pulled.ok || !status.ok) throw new Error(\"trajectory read-back failed\");\n254\t    observed.push({\n255\t      position: pulled.value.meta.boundaryPosition,\n256\t      zoneTokens: status.value.visibility.zoneTokens,\n257\t    });\n258\t  }\n259\t  return observed;\n260\t}\n261\t\n262\tdescribe(\"Boundary G1 (committed JSON): the advance trajectory, floor legs included\", () => {\n263\t  it(\"matches the committed positions and zone sums after every scripted batch\", async () => {\n264\t    const golden = JSON.parse(\n265\t      readFileSync(join(import.meta.dirname, \"goldens\", \"boundary-g1-trajectory.json\"), \"utf8\"),\n266\t    ) as BoundaryGolden;\n267\t    const observed = await replayTrajectory(golden);\n268\t    if (process.env[\"GOLDEN_DUMP\"] === \"1\") {\n269\t      console.log(`${golden.case}\\n${JSON.stringify(observed, null, 2)}`);\n270\t    }\n271\t    expect(observed).toEqual(\n272\t      golden.batches.map((batch) => ({\n273\t        position: batch.expectedPosition,\n274\t        zoneTokens: batch.expectedZoneTokens,\n275\t      })),\n276\t    );\n277\t\n278\t    // TC-4.5 (AC-4.4) replay equality: the same record and budgets on a\n279\t    // second fresh thread produce the same boundary trajectory.\n280\t    expect(await replayTrajectory(golden)).toEqual(observed);\n281\t  });\n282\t});\n283\t"}]},"parent_tool_use_id":null,"session_id":"bb1f3fcf-4d78-4a97-8c5b-320e502ce14a","uuid":"ef5c6937-a71e-48ce-8c0a-81614d417ee9","timestamp":"2026-06-12T23:38:53.037Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-select-golden.test.ts","content":"  return events;\n}\n\n// One full replay of the golden's script against a fresh thread: the\n// committed positions and zone sums after each batch.\nasync function replayTrajectory(\n  golden: BoundaryGolden,\n): Promise<Array<{ position: number; zoneTokens: number }>> {\n  const sdk = createSdk({\n    provider: createProviderDouble(),\n    mode: \"manual\",\n    view: { visibility: golden.budgets },\n  });\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`trajectory thread creation failed: ${created.error.reason}`);\n\n  const observed: Array<{ position: number; zoneTokens: number }> = [];\n  for (const batch of golden.batches) {\n    const result = await sdk.intakeStream.messageEvents({ filePath }, trajectoryBatch(batch));\n    if (!result.ok) throw new Error(`trajectory intake failed: ${result.error.reason}`);\n    const pulled = await sdk.threadView.pull({ filePath });\n    const status = await sdk.threadView.status({ filePath });\n    if (!pulled.ok || !status.ok) throw new Error(\"trajectory read-back failed\");\n    observed.push({\n      position: pulled.value.meta.boundaryPosition,\n      zoneTokens: status.value.visibility.zoneTokens,\n    });\n  }\n  return observed;\n}\n\ndescribe(\"Boundary G1 (committed JSON): the advance trajectory, floor legs included\", () => {\n  it(\"matches the committed positions and zone sums after every scripted batch\", async () => {\n    const golden = JSON.parse(\n      readFileSync(join(import.meta.dirname, \"goldens\", \"boundary-g1-trajectory.json\"), \"utf8\"),\n    ) as BoundaryGolden;\n    const observed = await replayTrajectory(golden);\n    if (process.env[\"GOLDEN_DUMP\"] === \"1\") {\n      console.log(`${golden.case}\\n${JSON.stringify(observed, null, 2)}`);\n    }\n    expect(observed).toEqual(\n      golden.batches.map((batch) => ({\n        position: batch.expectedPosition,\n        zoneTokens: batch.expectedZoneTokens,\n      })),\n    );\n\n    // TC-4.5 (AC-4.4) replay equality: the same record and budgets on a\n    // second fresh thread produce the same boundary trajectory.\n    expect(await replayTrajectory(golden)).toEqual(observed);\n  });\n});\n","numLines":54,"startLine":230,"totalLines":283}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011BStDhzvVjnNaS9du6PYqD","type":"tool_result","content":"1\t// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n2\t// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n3\t// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n4\t// Stories 3–5 extend the same per-event walk with projection, turn\n5\t// transitions, and work queueing.\n6\timport { existsSync } from \"node:fs\";\n7\timport type { DatabaseSync } from \"node:sqlite\";\n8\timport {\n9\t  createCommitHooks,\n10\t  resolveInstancePoke,\n11\t  type OperationContext,\n12\t} from \"../../../shared/context.js\";\n13\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n14\timport type { WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\n15\timport { createFromEvent, queueMessageWork } from \"../../messages/index.js\";\n16\t// The sanctioned intake→thread-view surface import (Epic 03 Flow 4, named in\n17\t// check-boundaries): the boundary-advance registration below, nothing else.\n18\t// This is the domain graph's first surface-level cycle (intake → thread-view\n19\t// → messages ← intake) — runtime-safe because thread-view never imports\n20\t// intake-stream at runtime and the registration executes only at flush.\n21\timport { runPostCommitBoundaryAdvance } from \"../../thread-view/index.js\";\n22\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\n23\timport { applyEvent as applyTurnEvent, listOpenTurnIds } from \"../../turns/index.js\";\n24\timport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\n25\timport { validateEvents, validateThreadRef } from \"./validate.js\";\n26\t\n27\t// Test seam (set only through test/fixtures): called after each event is\n28\t// processed inside the walk, so atomicity under mid-walk failure can be\n29\t// induced through a real mechanism — closing the handle — rather than a\n30\t// mocked transaction object.\n31\texport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\n32\tlet walkHook: IntakeWalkHook | null = null;\n33\texport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n34\t  walkHook = hook;\n35\t}\n36\t\n37\t// Test seam (set only through test/fixtures): replaces the wall clock so\n38\t// recordedAt is sourced deterministically for the public SDK contract proof —\n39\t// TC-1.4 records the same batch through both reference forms and reads it back\n40\t// field-for-field, recordedAt included, with nothing stripped. Unset in\n41\t// production: recording stamps real wall time. An explicit clock argument to\n42\t// runMessageEvents still wins over the seam.\n43\tlet injectedClock: (() => Date) | null = null;\n44\texport function setIntakeClock(clock: (() => Date) | null): void {\n45\t  injectedClock = clock;\n46\t}\n47\t\n48\tfunction detail(cause: unknown): string {\n49\t  return cause instanceof Error ? cause.message : String(cause);\n50\t}\n51\t\n52\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n53\t  return {\n54\t    ok: false,\n55\t    error: {\n56\t      errorClass: \"caller_error\",\n57\t      code: \"thread_not_found\",\n58\t      reason: `no thread file exists at ${filePath}`,\n59\t    },\n60\t  };\n61\t}\n62\t\n63\t// The skip set is read at transaction start and reads only the key column:\n64\t// key-wins-over-content is the absence of a content comparison (AC-5.5).\n65\t// Chunked to stay under SQLite's bound-parameter limit.\n66\tfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n67\t  const found = new Set<string>();\n68\t  for (let offset = 0; offset < keys.length; offset += 400) {\n69\t    const chunk = keys.slice(offset, offset + 400);\n70\t    const placeholders = chunk.map(() => \"?\").join(\", \");\n71\t    const rows = db\n72\t      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n73\t      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n74\t    for (const row of rows) found.add(row.idempotency_key);\n75\t  }\n76\t  return found;\n77\t}\n78\t\n79\tfunction threadIdOf(db: DatabaseSync): string {\n80\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n81\t    | { thread_id: string }\n82\t    | undefined;\n83\t  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n84\t  return row.thread_id;\n85\t}\n86\t\n87\tfunction maxEventOrder(db: DatabaseSync): number {\n88\t  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n89\t    | { max_order: number | bigint | null }\n90\t    | undefined;\n91\t  return Number(row?.max_order ?? 0);\n92\t}\n93\t\n94\texport async function runMessageEvents(\n95\t  thread: ThreadRef,\n96\t  events: readonly MessageEventInput[],\n97\t  clock: () => Date = injectedClock ?? (() => new Date()),\n98\t): Promise<OpResult<BatchResult>> {\n99\t  // Pure validation first: a rejected batch never opens the file, never takes\n100\t  // the write lock, and a duplicate key on a malformed event is a rejection,\n101\t  // not a skip (validation-before-idempotency precedence).\n102\t  const refFailure = validateThreadRef(thread);\n103\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n104\t  const batchFailure = validateEvents(events);\n105\t  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n106\t\n107\t  const resolved = await resolveThreadRef(thread);\n108\t  if (!resolved.ok) return resolved;\n109\t  const { filePath } = resolved.value;\n110\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n111\t\n112\t  // openThreadDatabase verifies the file is a real thread file, then brings\n113\t  // its schema to the current version before the batch transaction begins,\n114\t  // so a thread recorded under an earlier story is writable here (F-03-001)\n115\t  // and a non-thread file is rejected unmutated (F-03-002).\n116\t  const opened = openThreadDatabase(filePath);\n117\t  if (!opened.ok) return opened;\n118\t  const db = opened.value;\n119\t\n120\t  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n121\t  // single-writer violations fail loudly at a defined point.\n122\t  let inTransaction = false;\n123\t  try {\n124\t    db.exec(\"BEGIN IMMEDIATE;\");\n125\t    inTransaction = true;\n126\t\n127\t    // Cross-domain calls inside the transaction share the open handle through\n128\t    // the operation context (design decision 8); built once per batch, never\n129\t    // stored. onCommit registrations (the scheduler pokes enqueue makes,\n130\t    // DD-5) flush only after COMMIT succeeds; a rollback path never flushes,\n131\t    // so they drop with the transaction.\n132\t    const hooks = createCommitHooks();\n133\t    const ctx: OperationContext = {\n134\t      db,\n135\t      clock,\n136\t      threadId: threadIdOf(db),\n137\t      onCommit: hooks.register,\n138\t      poke: resolveInstancePoke(),\n139\t    };\n140\t\n141\t    // The boundary-advance registration (Epic 03 Flow 4, AC-4.9): registered\n142\t    // FIRST so the flush runs it before any queue poke the walk's enqueues\n143\t    // register — advance first, poke second, the pinned order. It runs in\n144\t    // both host modes (deterministic and cheap, unlike the mode-gated drain).\n145\t    // Throw-isolated: a failing advance is caught and diagnosed here, never\n146\t    // thrown into the flush — it cannot eat the pokes behind it and cannot\n147\t    // reach this batch's caller; intake's outcome never depends on it. The\n148\t    // boundary is then unchanged and the over-budget condition stays visible\n149\t    // in status (computed live); the next successful check heals.\n150\t    ctx.onCommit(() => {\n151\t      try {\n152\t        runPostCommitBoundaryAdvance(ctx);\n153\t      } catch (cause) {\n154\t        process.stderr.write(\n155\t          `lhc: boundary advance failed after intake commit (boundary unchanged; condition visible in view status): ${detail(cause)}\\n`,\n156\t        );\n157\t      }\n158\t    });\n159\t\n160\t    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n161\t    // any event is processed — once is sufficient because only this pipeline\n162\t    // writes turn state and the write lock is already held, so more than one\n163\t    // open turn can only mean external interference. The batch records\n164\t    // nothing: nothing has been written yet, and the rollback closes the\n165\t    // never-used transaction.\n166\t    const openTurnIds = listOpenTurnIds(ctx);\n167\t    if (openTurnIds.length > 1) {\n168\t      db.exec(\"ROLLBACK;\");\n169\t      inTransaction = false;\n170\t      return {\n171\t        ok: false,\n172\t        error: {\n173\t          errorClass: \"state_corruption\",\n174\t          code: \"turn_state_corrupt\",\n175\t          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n176\t        },\n177\t      };\n178\t    }\n179\t\n180\t    const skipSet = recordedKeys(\n181\t      db,\n182\t      events.map((event) => event.idempotencyKey),\n183\t    );\n184\t    // Order counter from MAX(event_order): only recorded events increment it,\n185\t    // so skips consume no order numbers and the sequence stays dense.\n186\t    let lastOrder = maxEventOrder(db);\n187\t\n188\t    const insert = db.prepare(\n189\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n190\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n191\t    );\n192\t\n193\t    const eventResults: BatchResult[\"events\"] = [];\n194\t    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n195\t    // Work items append as they queue, in walk order — the result is a\n196\t    // faithful log of what the transaction did (AC-2.7). The full records\n197\t    // (status, queuedAt) stay in the thread file; the result carries item\n198\t    // identity only.\n199\t    const queuedItems: WorkItemRecord[] = [];\n200\t    for (const [index, event] of events.entries()) {\n201\t      if (skipSet.has(event.idempotencyKey)) {\n202\t        eventResults.push({\n203\t          idempotencyKey: event.idempotencyKey,\n204\t          outcome: \"skipped\",\n205\t          skipReason: \"duplicate_idempotency_key\",\n206\t        });\n207\t      } else {\n208\t        lastOrder += 1;\n209\t        const recordedAt = clock().toISOString();\n210\t        insert.run(\n211\t          lastOrder,\n212\t          event.eventKind,\n213\t          event.idempotencyKey,\n214\t          event.actor,\n215\t          event.harness,\n216\t          JSON.stringify(event.payload),\n217\t          recordedAt,\n218\t        );\n219\t        skipSet.add(event.idempotencyKey);\n220\t        // Turn transition before projection — the order is load-bearing: a\n221\t        // prompt transitions first and stamps to the turn it just opened\n222\t        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n223\t        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this\n224\t        // call, so a resend causes no transition (TC-5.4).\n225\t        const turnOutcome = applyTurnEvent(ctx, event.eventKind, lastOrder);\n226\t        turnTransitions.push(...turnOutcome.transitions);\n227\t        queuedItems.push(...turnOutcome.queuedWork);\n228\t        // Projection runs in the same iteration that recorded the event, so\n229\t        // it can never drift from its source; a projection failure throws\n230\t        // and rejects the whole batch. Skipped events never reach this call\n231\t        // (no duplicate message, AC-5.4).\n232\t        const created = createFromEvent(\n233\t          ctx,\n234\t          {\n235\t            ...event,\n236\t            eventOrder: lastOrder,\n237\t            recordedAt,\n238\t          },\n239\t          turnOutcome.openTurnId,\n240\t        );\n241\t        // Message-owned work queues in the same iteration, gated on\n242\t        // recorded: a skipped event never reaches this call, so it queues\n243\t        // nothing (AC-5.4), and the kind gate inside queueMessageWork\n244\t        // decides which messages are derivation sources (AC-2.8).\n245\t        queuedItems.push(...queueMessageWork(ctx, created));\n246\t        const entry: BatchResult[\"events\"][number] = {\n247\t          idempotencyKey: event.idempotencyKey,\n248\t          outcome: \"recorded\",\n249\t        };\n250\t        if (created !== null) entry.messageId = created.messageId;\n251\t        eventResults.push(entry);\n252\t      }\n253\t      walkHook?.(db, index);\n254\t    }\n255\t\n256\t    db.exec(\"COMMIT;\");\n257\t    inTransaction = false;\n258\t    hooks.flush();\n259\t\n260\t    return {\n261\t      ok: true,\n262\t      value: {\n263\t        events: eventResults,\n264\t        turnTransitions,\n265\t        queuedWork: queuedItems.map((item) => ({\n266\t          workItemId: item.workItemId,\n267\t          owner: item.owner,\n268\t          kind: item.kind,\n269\t          sourceRef: item.sourceRef,\n270\t        })),\n271\t        threadPosition: { lastEventOrder: lastOrder },\n272\t      },\n273\t    };\n274\t  } catch (cause) {\n275\t    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n276\t    // class-independent. The handle may already be gone (induced failure),\n277\t    // in which case SQLite has already discarded the uncommitted transaction.\n278\t    if (inTransaction) {\n279\t      try {\n280\t        db.exec(\"ROLLBACK;\");\n281\t      } catch {\n282\t        // handle closed mid-walk; the open transaction died with it\n283\t      }\n284\t    }\n285\t    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n286\t  } finally {\n287\t    try {\n288\t      db.close();\n289\t    } catch {\n290\t      // already closed by the induced-failure seam\n291\t    }\n292\t  }\n293\t}\n294\t\n295\tinterface RawEventRow {\n296\t  event_order: number | bigint;\n297\t  event_kind: string;\n298\t  idempotency_key: string;\n299\t  actor: string;\n300\t  harness: string;\n301\t  payload: string;\n302\t  recorded_at: string;\n303\t}\n304\t\n305\texport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n306\t  const refFailure = validateThreadRef(thread);\n307\t  if (refFailure !== undefined) return { ok: false, error: refFailure };\n308\t\n309\t  const resolved = await resolveThreadRef(thread);\n310\t  if (!resolved.ok) return resolved;\n311\t  const { filePath } = resolved.value;\n312\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n313\t\n314\t  const opened = openThreadDatabase(filePath);\n315\t  if (!opened.ok) return opened;\n316\t  const db = opened.value;\n317\t  try {\n318\t    const rows = db\n319\t      .prepare(\n320\t        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n321\t         FROM event ORDER BY event_order`,\n322\t      )\n323\t      .all() as unknown as RawEventRow[];\n324\t    const records = rows.map(\n325\t      (row) =>\n326\t        ({\n327\t          eventKind: row.event_kind,\n328\t          idempotencyKey: row.idempotency_key,\n329\t          actor: row.actor,\n330\t          harness: row.harness,\n331\t          payload: JSON.parse(row.payload) as Record<string, unknown>,\n332\t          eventOrder: Number(row.event_order),\n333\t          recordedAt: row.recorded_at,\n334\t        }) as unknown as EventRecord,\n335\t    );\n336\t    return { ok: true, value: records };\n337\t  } catch (cause) {\n338\t    return storageFailure(`event read-back failed: ${detail(cause)}`);\n339\t  } finally {\n340\t    db.close();\n341\t  }\n342\t}\n343\t"}]},"parent_tool_use_id":null,"session_id":"bb1f3fcf-4d78-4a97-8c5b-320e502ce14a","uuid":"bce97b46-674b-4eb5-b54a-ec18f6017ab7","timestamp":"2026-06-12T23:36:38.443Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/intake-stream/internal/pipeline.ts","content":"// Flow 2 (recording half) + Flow 5: the batch transaction. The pipeline order\n// is load-bearing: validate (pure, no lock) → BEGIN IMMEDIATE → per event in\n// array order [dedup-check → record] → walk-time result assembly → COMMIT.\n// Stories 3–5 extend the same per-event walk with projection, turn\n// transitions, and work queueing.\nimport { existsSync } from \"node:fs\";\nimport type { DatabaseSync } from \"node:sqlite\";\nimport {\n  createCommitHooks,\n  resolveInstancePoke,\n  type OperationContext,\n} from \"../../../shared/context.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\nimport type { WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\nimport { createFromEvent, queueMessageWork } from \"../../messages/index.js\";\n// The sanctioned intake→thread-view surface import (Epic 03 Flow 4, named in\n// check-boundaries): the boundary-advance registration below, nothing else.\n// This is the domain graph's first surface-level cycle (intake → thread-view\n// → messages ← intake) — runtime-safe because thread-view never imports\n// intake-stream at runtime and the registration executes only at flush.\nimport { runPostCommitBoundaryAdvance } from \"../../thread-view/index.js\";\nimport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../../threads/index.js\";\nimport { applyEvent as applyTurnEvent, listOpenTurnIds } from \"../../turns/index.js\";\nimport type { BatchResult, EventRecord, MessageEventInput } from \"../index.js\";\nimport { validateEvents, validateThreadRef } from \"./validate.js\";\n\n// Test seam (set only through test/fixtures): called after each event is\n// processed inside the walk, so atomicity under mid-walk failure can be\n// induced through a real mechanism — closing the handle — rather than a\n// mocked transaction object.\nexport type IntakeWalkHook = (db: DatabaseSync, eventIndex: number) => void;\nlet walkHook: IntakeWalkHook | null = null;\nexport function setIntakeWalkHook(hook: IntakeWalkHook | null): void {\n  walkHook = hook;\n}\n\n// Test seam (set only through test/fixtures): replaces the wall clock so\n// recordedAt is sourced deterministically for the public SDK contract proof —\n// TC-1.4 records the same batch through both reference forms and reads it back\n// field-for-field, recordedAt included, with nothing stripped. Unset in\n// production: recording stamps real wall time. An explicit clock argument to\n// runMessageEvents still wins over the seam.\nlet injectedClock: (() => Date) | null = null;\nexport function setIntakeClock(clock: (() => Date) | null): void {\n  injectedClock = clock;\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\n// The skip set is read at transaction start and reads only the key column:\n// key-wins-over-content is the absence of a content comparison (AC-5.5).\n// Chunked to stay under SQLite's bound-parameter limit.\nfunction recordedKeys(db: DatabaseSync, keys: readonly string[]): Set<string> {\n  const found = new Set<string>();\n  for (let offset = 0; offset < keys.length; offset += 400) {\n    const chunk = keys.slice(offset, offset + 400);\n    const placeholders = chunk.map(() => \"?\").join(\", \");\n    const rows = db\n      .prepare(`SELECT idempotency_key FROM event WHERE idempotency_key IN (${placeholders})`)\n      .all(...chunk) as unknown as Array<{ idempotency_key: string }>;\n    for (const row of rows) found.add(row.idempotency_key);\n  }\n  return found;\n}\n\nfunction threadIdOf(db: DatabaseSync): string {\n  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n    | { thread_id: string }\n    | undefined;\n  if (row === undefined) throw new Error(\"thread file has no metadata row\");\n  return row.thread_id;\n}\n\nfunction maxEventOrder(db: DatabaseSync): number {\n  const row = db.prepare(\"SELECT MAX(event_order) AS max_order FROM event\").get() as\n    | { max_order: number | bigint | null }\n    | undefined;\n  return Number(row?.max_order ?? 0);\n}\n\nexport async function runMessageEvents(\n  thread: ThreadRef,\n  events: readonly MessageEventInput[],\n  clock: () => Date = injectedClock ?? (() => new Date()),\n): Promise<OpResult<BatchResult>> {\n  // Pure validation first: a rejected batch never opens the file, never takes\n  // the write lock, and a duplicate key on a malformed event is a rejection,\n  // not a skip (validation-before-idempotency precedence).\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n  const batchFailure = validateEvents(events);\n  if (batchFailure !== undefined) return { ok: false, error: batchFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  // openThreadDatabase verifies the file is a real thread file, then brings\n  // its schema to the current version before the batch transaction begins,\n  // so a thread recorded under an earlier story is writable here (F-03-001)\n  // and a non-thread file is rejected unmutated (F-03-002).\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n\n  // BEGIN IMMEDIATE (not deferred): the write lock is taken up front so\n  // single-writer violations fail loudly at a defined point.\n  let inTransaction = false;\n  try {\n    db.exec(\"BEGIN IMMEDIATE;\");\n    inTransaction = true;\n\n    // Cross-domain calls inside the transaction share the open handle through\n    // the operation context (design decision 8); built once per batch, never\n    // stored. onCommit registrations (the scheduler pokes enqueue makes,\n    // DD-5) flush only after COMMIT succeeds; a rollback path never flushes,\n    // so they drop with the transaction.\n    const hooks = createCommitHooks();\n    const ctx: OperationContext = {\n      db,\n      clock,\n      threadId: threadIdOf(db),\n      onCommit: hooks.register,\n      poke: resolveInstancePoke(),\n    };\n\n    // The boundary-advance registration (Epic 03 Flow 4, AC-4.9): registered\n    // FIRST so the flush runs it before any queue poke the walk's enqueues\n    // register — advance first, poke second, the pinned order. It runs in\n    // both host modes (deterministic and cheap, unlike the mode-gated drain).\n    // Throw-isolated: a failing advance is caught and diagnosed here, never\n    // thrown into the flush — it cannot eat the pokes behind it and cannot\n    // reach this batch's caller; intake's outcome never depends on it. The\n    // boundary is then unchanged and the over-budget condition stays visible\n    // in status (computed live); the next successful check heals.\n    ctx.onCommit(() => {\n      try {\n        runPostCommitBoundaryAdvance(ctx);\n      } catch (cause) {\n        process.stderr.write(\n          `lhc: boundary advance failed after intake commit (boundary unchanged; condition visible in view status): ${detail(cause)}\\n`,\n        );\n      }\n    });\n\n    // Corruption check at state load (AC-3.9): after BEGIN IMMEDIATE, before\n    // any event is processed — once is sufficient because only this pipeline\n    // writes turn state and the write lock is already held, so more than one\n    // open turn can only mean external interference. The batch records\n    // nothing: nothing has been written yet, and the rollback closes the\n    // never-used transaction.\n    const openTurnIds = listOpenTurnIds(ctx);\n    if (openTurnIds.length > 1) {\n      db.exec(\"ROLLBACK;\");\n      inTransaction = false;\n      return {\n        ok: false,\n        error: {\n          errorClass: \"state_corruption\",\n          code: \"turn_state_corrupt\",\n          reason: `thread has ${openTurnIds.length} open turns (${openTurnIds.join(\", \")}); the invariant is at most one`,\n        },\n      };\n    }\n\n    const skipSet = recordedKeys(\n      db,\n      events.map((event) => event.idempotencyKey),\n    );\n    // Order counter from MAX(event_order): only recorded events increment it,\n    // so skips consume no order numbers and the sequence stays dense.\n    let lastOrder = maxEventOrder(db);\n\n    const insert = db.prepare(\n      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    );\n\n    const eventResults: BatchResult[\"events\"] = [];\n    const turnTransitions: BatchResult[\"turnTransitions\"] = [];\n    // Work items append as they queue, in walk order — the result is a\n    // faithful log of what the transaction did (AC-2.7). The full records\n    // (status, queuedAt) stay in the thread file; the result carries item\n    // identity only.\n    const queuedItems: WorkItemRecord[] = [];\n    for (const [index, event] of events.entries()) {\n      if (skipSet.has(event.idempotencyKey)) {\n        eventResults.push({\n          idempotencyKey: event.idempotencyKey,\n          outcome: \"skipped\",\n          skipReason: \"duplicate_idempotency_key\",\n        });\n      } else {\n        lastOrder += 1;\n        const recordedAt = clock().toISOString();\n        insert.run(\n          lastOrder,\n          event.eventKind,\n          event.idempotencyKey,\n          event.actor,\n          event.harness,\n          JSON.stringify(event.payload),\n          recordedAt,\n        );\n        skipSet.add(event.idempotencyKey);\n        // Turn transition before projection — the order is load-bearing: a\n        // prompt transitions first and stamps to the turn it just opened\n        // (AC-3.1, AC-3.3); non-transition kinds stamp to whatever is open,\n        // or null in a gap (AC-3.2, AC-3.8). Skipped events never reach this\n        // call, so a resend causes no transition (TC-5.4).\n        const turnOutcome = applyTurnEvent(ctx, event.eventKind, lastOrder);\n        turnTransitions.push(...turnOutcome.transitions);\n        queuedItems.push(...turnOutcome.queuedWork);\n        // Projection runs in the same iteration that recorded the event, so\n        // it can never drift from its source; a projection failure throws\n        // and rejects the whole batch. Skipped events never reach this call\n        // (no duplicate message, AC-5.4).\n        const created = createFromEvent(\n          ctx,\n          {\n            ...event,\n            eventOrder: lastOrder,\n            recordedAt,\n          },\n          turnOutcome.openTurnId,\n        );\n        // Message-owned work queues in the same iteration, gated on\n        // recorded: a skipped event never reaches this call, so it queues\n        // nothing (AC-5.4), and the kind gate inside queueMessageWork\n        // decides which messages are derivation sources (AC-2.8).\n        queuedItems.push(...queueMessageWork(ctx, created));\n        const entry: BatchResult[\"events\"][number] = {\n          idempotencyKey: event.idempotencyKey,\n          outcome: \"recorded\",\n        };\n        if (created !== null) entry.messageId = created.messageId;\n        eventResults.push(entry);\n      }\n      walkHook?.(db, index);\n    }\n\n    db.exec(\"COMMIT;\");\n    inTransaction = false;\n    hooks.flush();\n\n    return {\n      ok: true,\n      value: {\n        events: eventResults,\n        turnTransitions,\n        queuedWork: queuedItems.map((item) => ({\n          workItemId: item.workItemId,\n          owner: item.owner,\n          kind: item.kind,\n          sourceRef: item.sourceRef,\n        })),\n        threadPosition: { lastEventOrder: lastOrder },\n      },\n    };\n  } catch (cause) {\n    // Any in-transaction failure rolls back whole: AC-4.6's guarantee is\n    // class-independent. The handle may already be gone (induced failure),\n    // in which case SQLite has already discarded the uncommitted transaction.\n    if (inTransaction) {\n      try {\n        db.exec(\"ROLLBACK;\");\n      } catch {\n        // handle closed mid-walk; the open transaction died with it\n      }\n    }\n    return storageFailure(`event batch failed and rolled back whole: ${detail(cause)}`);\n  } finally {\n    try {\n      db.close();\n    } catch {\n      // already closed by the induced-failure seam\n    }\n  }\n}\n\ninterface RawEventRow {\n  event_order: number | bigint;\n  event_kind: string;\n  idempotency_key: string;\n  actor: string;\n  harness: string;\n  payload: string;\n  recorded_at: string;\n}\n\nexport async function runListEvents(thread: ThreadRef): Promise<OpResult<EventRecord[]>> {\n  const refFailure = validateThreadRef(thread);\n  if (refFailure !== undefined) return { ok: false, error: refFailure };\n\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const rows = db\n      .prepare(\n        `SELECT event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at\n         FROM event ORDER BY event_order`,\n      )\n      .all() as unknown as RawEventRow[];\n    const records = rows.map(\n      (row) =>\n        ({\n          eventKind: row.event_kind,\n          idempotencyKey: row.idempotency_key,\n          actor: row.actor,\n          harness: row.harness,\n          payload: JSON.parse(row.payload) as Record<string, unknown>,\n          eventOrder: Number(row.event_order),\n          recordedAt: row.recorded_at,\n        }) as unknown as EventRecord,\n    );\n    return { ok: true, value: records };\n  } catch (cause) {\n    return storageFailure(`event read-back failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":343,"startLine":1,"totalLines":343}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X5AqNguMVmpVKk66FJv5fp","type":"tool_result","content":"1\t// Epic 03 Story 4: the visibility boundary (TC-4.1–4.6, the seam-isolation\n2\t// legs both directions, the both-host-modes in-process proof, and the DoD's\n3\t// status-sum/advance-sum equality check). Every advance here fires through a\n4\t// REAL `intake.messageEvents` commit — no host-called advance surface exists\n5\t// and no test invents one (story Anti-Shim Requirements); rendering is proven\n6\t// through real `pull` calls. Budgets resolve through SDK view config (the\n7\t// per-instance seam); the one direct-domain-call leg proves the below-SDK\n8\t// default-budget fallback while it proves poke-failure isolation.\n9\timport { afterEach, describe, expect, it } from \"vitest\";\n10\timport {\n11\t  createSdk,\n12\t  intakeStream,\n13\t  setSchedulerPoke,\n14\t  type Lhc,\n15\t  type MessageEventInput,\n16\t  type SdkViewConfig,\n17\t} from \"../src/index.js\";\n18\timport {\n19\t  createProviderDouble,\n20\t  setViewInjectionHook,\n21\t  tempStore,\n22\t  validEvent,\n23\t  type TempStore,\n24\t} from \"./fixtures/index.js\";\n25\t\n26\t// \"tok\" tokenizes to exactly one o200k token, joined or leading-space alike,\n27\t// so a content of n joined \"tok\" words carries token_estimate n — the same\n28\t// hand-derivable unit the Boundary G1 golden uses.\n29\tfunction tokens(n: number): string {\n30\t  return Array<string>(n).fill(\"tok\").join(\" \");\n31\t}\n32\t\n33\t// The story's test budgets: max 100 > target 60 ≥ floor 30 (AC-4.8 ordering).\n34\tconst BUDGETS = { maxTokens: 100, targetTokens: 60, floorTokens: 30 };\n35\t\n36\tconst stores: TempStore[] = [];\n37\tafterEach(() => {\n38\t  setViewInjectionHook(\"post-commit-advance\", null);\n39\t  setSchedulerPoke(null);\n40\t  for (const store of stores.splice(0)) store.cleanup();\n41\t});\n42\t\n43\tfunction visSdk(view: SdkViewConfig = { visibility: BUDGETS }, mode: \"manual\" | \"background\" = \"manual\"): Lhc {\n44\t  return createSdk({ provider: createProviderDouble(), mode, view });\n45\t}\n46\t\n47\tasync function newThread(sdk: Lhc): Promise<string> {\n48\t  const store = tempStore();\n49\t  stores.push(store);\n50\t  const filePath = store.threadPath();\n51\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n52\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n53\t  return filePath;\n54\t}\n55\t\n56\tlet callCounter = 0;\n57\t\n58\t// One tool run: call + result with the given token count.\n59\tfunction toolRun(resultTokens: number): MessageEventInput[] {\n60\t  callCounter += 1;\n61\t  const toolCallId = `call-vb-${callCounter}`;\n62\t  return [\n63\t    validEvent(\"tool_call\", {\n64\t      payload: { toolCallId, toolName: \"read_file\", arguments: { path: `vb-${callCounter}.txt` } },\n65\t    }),\n66\t    validEvent(\"tool_result\", {\n67\t      payload: { toolCallId, content: tokens(resultTokens), isError: false },\n68\t    }),\n69\t  ];\n70\t}\n71\t\n72\t// One scripted turn: prompt, a tool run per entry, optional turn_end.\n73\tfunction toolTurn(resultTokens: readonly number[], opts: { turnEnd?: boolean } = {}): MessageEventInput[] {\n74\t  const events: MessageEventInput[] = [\n75\t    validEvent(\"user_prompt\", { payload: { text: \"scripted boundary turn\" } }),\n76\t  ];\n77\t  for (const n of resultTokens) events.push(...toolRun(n));\n78\t  if (opts.turnEnd !== false) events.push(validEvent(\"turn_end\"));\n79\t  return events;\n80\t}\n81\t\n82\tasync function intake(sdk: Lhc, filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n83\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n84\t  if (!result.ok) throw new Error(`intake failed: ${result.error.reason}`);\n85\t}\n86\t\n87\tasync function boundaryOf(sdk: Lhc, filePath: string): Promise<number> {\n88\t  const pulled = await sdk.threadView.pull({ filePath });\n89\t  if (!pulled.ok) throw new Error(`pull failed: ${pulled.error.reason}`);\n90\t  return pulled.value.meta.boundaryPosition;\n91\t}\n92\t\n93\tasync function toolResults(\n94\t  sdk: Lhc,\n95\t  filePath: string,\n96\t): Promise<Array<{ messageId: string; sourceEventOrder: number; tokenEstimate: number }>> {\n97\t  const listed = await sdk.messages.listMessages({ filePath });\n98\t  if (!listed.ok) throw new Error(`listMessages failed: ${listed.error.reason}`);\n99\t  return listed.value\n100\t    .filter((m) => m.kind === \"tool_result\")\n101\t    .map((m) => ({\n102\t      messageId: m.messageId,\n103\t      sourceEventOrder: m.sourceEventOrder,\n104\t      tokenEstimate: m.tokenEstimate,\n105\t    }));\n106\t}\n107\t\n108\tfunction abridgedCount(messages: ReadonlyArray<{ content: string }>): number {\n109\t  return messages.filter((m) => m.content.startsWith(\"[tool result · \") && m.content.includes(\" · abridged]\"))\n110\t    .length;\n111\t}\n112\t\n113\tdescribe(\"TC-4.1 (AC-4.3): under-max batches never move the boundary; the crossing batch moves once to target, oldest-first\", () => {\n114\t  it(\"holds position and bytes below max, then flips exactly one oldest-first batch of results\", async () => {\n115\t    const sdk = visSdk();\n116\t    const filePath = await newThread(sdk);\n117\t\n118\t    // Two under-max batches (zone 40, then 80 ≤ max 100): boundary unmoved.\n119\t    await intake(sdk, filePath, toolTurn([20, 20]));\n120\t    const afterFirst = await sdk.threadView.pull({ filePath });\n121\t    expect(afterFirst.ok).toBe(true);\n122\t    if (!afterFirst.ok) return;\n123\t    expect(afterFirst.value.meta.boundaryPosition).toBe(0);\n124\t\n125\t    await intake(sdk, filePath, toolTurn([20, 20]));\n126\t    const afterSecond = await sdk.threadView.pull({ filePath });\n127\t    expect(afterSecond.ok).toBe(true);\n128\t    if (!afterSecond.ok) return;\n129\t    expect(afterSecond.value.meta.boundaryPosition).toBe(0);\n130\t    // Rendered bytes do not change below max: the earlier pull's messages are\n131\t    // a byte-identical prefix of the later one (AC-4.3's no-churn half).\n132\t    expect(afterSecond.value.messages.slice(0, afterFirst.value.messages.length)).toEqual(\n133\t      afterFirst.value.messages,\n134\t    );\n135\t    expect(abridgedCount(afterSecond.value.messages)).toBe(0);\n136\t\n137\t    // The crossing batch (zone 120 > 100): one advance to target — the three\n138\t    // oldest results flip (120→100→80→60 = target), the newer three stay\n139\t    // full; the protected set (newest joined to 40 ≥ floor 30) is untouched.\n140\t    await intake(sdk, filePath, toolTurn([20, 20]));\n141\t    const results = await toolResults(sdk, filePath);\n142\t    expect(results).toHaveLength(6);\n143\t    const expectedPosition = results[2]?.sourceEventOrder;\n144\t    const crossed = await sdk.threadView.pull({ filePath });\n145\t    expect(crossed.ok).toBe(true);\n146\t    if (!crossed.ok) return;\n147\t    expect(crossed.value.meta.boundaryPosition).toBe(expectedPosition);\n148\t    expect(abridgedCount(crossed.value.messages)).toBe(3);\n149\t\n150\t    // Oldest-first: precisely the first three results render abridged.\n151\t    const abridgedIds = results\n152\t      .filter((r) => r.sourceEventOrder <= (expectedPosition ?? 0))\n153\t      .map((r) => r.messageId);\n154\t    expect(abridgedIds).toEqual(results.slice(0, 3).map((r) => r.messageId));\n155\t\n156\t    // DoD: status's zone sum equals the advance's decision sum on the same\n157\t    // state — the live tool-result estimates ahead of the boundary.\n158\t    const status = await sdk.threadView.status({ filePath });\n159\t    expect(status.ok).toBe(true);\n160\t    if (!status.ok) return;\n161\t    const expectedZone = results\n162\t      .filter((r) => r.sourceEventOrder > (expectedPosition ?? 0))\n163\t      .reduce((sum, r) => sum + r.tokenEstimate, 0);\n164\t    expect(status.value.visibility.zoneTokens).toBe(expectedZone);\n165\t    expect(status.value.visibility.zoneTokens).toBe(60);\n166\t\n167\t    // The next under-max batch (zone 70 ≤ 100): no movement.\n168\t    await intake(sdk, filePath, toolTurn([10]));\n169\t    expect(await boundaryOf(sdk, filePath)).toBe(expectedPosition);\n170\t  });\n171\t});\n172\t\n173\tdescribe(\"TC-4.2 (AC-4.1, AC-4.2): flipped renders — summary when usable, deterministic truncation with marker when not; non-tool content untouched\", () => {\n174\t  it(\"renders the ready summary, the truncation rung for the failed summary, and the interleaved assistant text full\", async () => {\n175\t    const double = createProviderDouble();\n176\t    const sdk = createSdk({ provider: double, mode: \"manual\", view: { visibility: BUDGETS } });\n177\t    const filePath = await newThread(sdk);\n178\t\n179\t    // r1 (60 tokens, 239 chars — over the 200-char abbreviation limit) will\n180\t    // have its summary FAIL terminally; r2 (20 tokens) drains a ready\n181\t    // summary; an assistant message sits between them.\n182\t    await intake(sdk, filePath, [\n183\t      validEvent(\"user_prompt\", { payload: { text: \"flip rendering prompt\" } }),\n184\t      ...toolRun(60),\n185\t      validEvent(\"assistant_text\", { payload: { text: \"interleaved assistant text\" } }),\n186\t      ...toolRun(20),\n187\t      validEvent(\"turn_end\"),\n188\t    ]);\n189\t    // First tool_result_summary execution fails non-retryably (r1's — queue\n190\t    // order is walk order); r2's succeeds. Real drain, production paths.\n191\t    double.failKind(\"tool_result_summary\", 1, {\n192\t      retryable: false,\n193\t      reason: \"content_refusal: scripted permanent failure (boundary test)\",\n194\t    });\n195\t    const drained = await sdk.work.drain({ filePath });\n196\t    expect(drained.ok).toBe(true);\n197\t\n198\t    const listed = await sdk.messages.listMessages({ filePath });\n199\t    expect(listed.ok).toBe(true);\n200\t    if (!listed.ok) return;\n201\t    const results = listed.value.filter((m) => m.kind === \"tool_result\");\n202\t    const [r1, r2] = results;\n203\t    expect(r1 && r2).toBeTruthy();\n204\t    if (r1 === undefined || r2 === undefined) return;\n205\t    expect(\n206\t      r1.forms?.find((f) => f.form === \"tool_result_summary\")?.state,\n207\t    ).toBe(\"failed\");\n208\t    const r2Summary = r2.forms?.find(\n209\t      (f) => f.form === \"tool_result_summary\" && f.state === \"ready\",\n210\t    )?.content;\n211\t    expect(r2Summary).toBeDefined();\n212\t\n213\t    // The crossing batch: an 80-token result (zone 60+20+80 = 160 > max).\n214\t    // Flips r1 and r2 (160→100→80); the newest is protected alone (≥ floor).\n215\t    await intake(sdk, filePath, toolTurn([80]));\n216\t    expect(await boundaryOf(sdk, filePath)).toBe(r2.sourceEventOrder);\n217\t\n218\t    const pulled = await sdk.threadView.pull({ filePath });\n219\t    expect(pulled.ok).toBe(true);\n220\t    if (!pulled.ok) return;\n221\t    const contents = pulled.value.messages.map((m) => m.content);\n222\t\n223\t    // r1: failed summary ⇒ deterministic truncation rung — fixed 200-char\n224\t    // prefix, exact dropped-count marker, abridged marker, record pointer.\n225\t    expect(contents).toContain(\n226\t      `[tool result · read_file · abridged]\\n${tokens(60).slice(0, 200)}… [truncated 39 chars] [full content in record §${r1.messageId}]`,\n227\t    );\n228\t    // r2: usable summary ⇒ the summary verbatim.\n229\t    expect(contents).toContain(\n230\t      `[tool result · read_file · abridged]\\n${r2Summary} [full content in record §${r2.messageId}]`,\n231\t    );\n232\t    // The interleaved assistant message renders full — non-tool-result\n233\t    // content is never affected by the boundary (AC-4.1).\n234\t    expect(contents).toContain(\"interleaved assistant text\");\n235\t    // The newest (protected) result renders full.\n236\t    expect(contents).toContain(`[tool result · read_file]\\n${tokens(80)}`);\n237\t  });\n238\t});\n239\t\n240\tdescribe(\"TC-4.3 (AC-4.5): monster turn — the advance enters the open turn but stops at the whole-message protected set\", () => {\n241\t  it(\"flips into the open turn, keeps the newest whole results (joined ≥ floor) full, and leaves the turn's text full\", async () => {\n242\t    const sdk = visSdk();\n243\t    const filePath = await newThread(sdk);\n244\t    // One small closed turn, then one open turn whose tool results alone\n245\t    // cross max: zone 20+40+40+40+25 = 165 > 100.\n246\t    await intake(sdk, filePath, toolTurn([20]));\n247\t    await intake(sdk, filePath, [\n248\t      validEvent(\"user_prompt\", { payload: { text: \"monster prompt\" } }),\n249\t      validEvent(\"assistant_thinking\", { payload: { text: \"monster thought\" } }),\n250\t      ...toolRun(40),\n251\t      ...toolRun(40),\n252\t      ...toolRun(40),\n253\t      ...toolRun(25),\n254\t      validEvent(\"assistant_text\", { payload: { text: \"monster narration\" } }),\n255\t      // No turn_end: the turn stays open.\n256\t    ]);\n257\t\n258\t    const results = await toolResults(sdk, filePath);\n259\t    expect(results).toHaveLength(5);\n260\t    // Protected set, newest-backward joined to ≥ floor 30: m4 (25) alone is\n261\t    // under the floor, so m3 joins (65) — whole messages, never a partial.\n262\t    // Flips stop there with the zone at 65, legally above target 60.\n263\t    const expectedPosition = results[2]?.sourceEventOrder; // m2: inside the open turn\n264\t    expect(await boundaryOf(sdk, filePath)).toBe(expectedPosition);\n265\t\n266\t    const pulled = await sdk.threadView.pull({ filePath });\n267\t    expect(pulled.ok).toBe(true);\n268\t    if (!pulled.ok) return;\n269\t    const contents = pulled.value.messages.map((m) => m.content);\n270\t    expect(abridgedCount(pulled.value.messages)).toBe(3); // r0, m1, m2\n271\t    // The protected newest results render full.\n272\t    expect(contents).toContain(`[tool result · read_file]\\n${tokens(40)}`);\n273\t    expect(contents).toContain(`[tool result · read_file]\\n${tokens(25)}`);\n274\t    // The turn's own text messages all render full.\n275\t    expect(contents).toContain(\"monster prompt\");\n276\t    expect(contents).toContain(\"[thinking]\\nmonster thought\\n[/thinking]\");\n277\t    expect(contents).toContain(\"monster narration\");\n278\t\n279\t    const status = await sdk.threadView.status({ filePath });\n280\t    expect(status.ok).toBe(true);\n281\t    if (!status.ok) return;\n282\t    expect(status.value.visibility.zoneTokens).toBe(65);\n283\t  });\n284\t\n285\t  it(\"oversized-newest leg: a single result larger than the floor is protected alone; the zone legally sits above target\", async () => {\n286\t    const sdk = visSdk();\n287\t    const filePath = await newThread(sdk);\n288\t    await intake(sdk, filePath, toolTurn([20]));\n289\t    // Open turn: 40 + 40 + 80; zone 180 > max. The newest (80) exceeds the\n290\t    // floor by itself and is protected alone (AC-4.5).\n291\t    await intake(sdk, filePath, [\n292\t      validEvent(\"user_prompt\", { payload: { text: \"oversized prompt\" } }),\n293\t      ...toolRun(40),\n294\t      ...toolRun(40),\n295\t      ...toolRun(80),\n296\t    ]);\n297\t    const results = await toolResults(sdk, filePath);\n298\t    expect(results).toHaveLength(4);\n299\t    expect(await boundaryOf(sdk, filePath)).toBe(results[2]?.sourceEventOrder);\n300\t\n301\t    const pulled = await sdk.threadView.pull({ filePath });\n302\t    expect(pulled.ok).toBe(true);\n303\t    if (!pulled.ok) return;\n304\t    // The oversized newest renders full; everything older flipped.\n305\t    expect(pulled.value.messages.map((m) => m.content)).toContain(\n306\t      `[tool result · read_file]\\n${tokens(80)}`,\n307\t    );\n308\t    expect(abridgedCount(pulled.value.messages)).toBe(3);\n309\t\n310\t    const status = await sdk.threadView.status({ filePath });\n311\t    expect(status.ok).toBe(true);\n312\t    if (!status.ok) return;\n313\t    expect(status.value.visibility.zoneTokens).toBe(80); // above target until room appears\n314\t  });\n315\t});\n316\t\n317\tdescribe(\"TC-4.4 (AC-4.6, AC-4.7): never backward within a window; compact resets to the compact point\", () => {\n318\t  it(\"keeps flipped results flipped across small batches, then resets to the compact point with a full fresh tail\", async () => {\n319\t    const sdk = visSdk();\n320\t    const filePath = await newThread(sdk);\n321\t    for (let i = 0; i < 3; i += 1) await intake(sdk, filePath, toolTurn([20, 20]));\n322\t    const results = await toolResults(sdk, filePath);\n323\t    const advanced = results[2]?.sourceEventOrder ?? 0;\n324\t    expect(await boundaryOf(sdk, filePath)).toBe(advanced);\n325\t\n326\t    // Small tool-free batches: no backward motion, flipped stay flipped.\n327\t    for (let i = 0; i < 2; i += 1) {\n328\t      await intake(sdk, filePath, [\n329\t        validEvent(\"user_prompt\", { payload: { text: `small batch ${i}` } }),\n330\t        validEvent(\"assistant_text\", { payload: { text: `small answer ${i}` } }),\n331\t        validEvent(\"turn_end\"),\n332\t      ]);\n333\t      const pulled = await sdk.threadView.pull({ filePath });\n334\t      expect(pulled.ok).toBe(true);\n335\t      if (!pulled.ok) return;\n336\t      expect(pulled.value.meta.boundaryPosition).toBe(advanced);\n337\t      expect(abridgedCount(pulled.value.messages)).toBe(3);\n338\t    }\n339\t\n340\t    // Compact: the boundary resets to the compact point (AC-4.7 — the reset\n341\t    // transaction landed in Story 2; this proves it end-to-end against a\n342\t    // boundary the production advance moved).\n343\t    const receipt = await sdk.threadView.compact(\n344\t      { filePath },\n345\t      { params: { lowerBound: 40 }, sweep: false },\n346\t    );\n347\t    expect(receipt.ok).toBe(true);\n348\t    if (!receipt.ok) return;\n349\t    const afterCompact = await sdk.threadView.pull({ filePath });\n350\t    expect(afterCompact.ok).toBe(true);\n351\t    if (!afterCompact.ok) return;\n352\t    expect(afterCompact.value.meta.compactPoint).toBe(receipt.value.compactPoint);\n353\t    expect(afterCompact.value.meta.boundaryPosition).toBe(receipt.value.compactPoint);\n354\t\n355\t    // Fresh tail renders full: a new under-max tool result is not abridged.\n356\t    await intake(sdk, filePath, toolTurn([20]));\n357\t    const fresh = await sdk.threadView.pull({ filePath });\n358\t    expect(fresh.ok).toBe(true);\n359\t    if (!fresh.ok) return;\n360\t    const tail = fresh.value.messages.filter((m) => m.band === undefined);\n361\t    expect(abridgedCount(tail)).toBe(0);\n362\t    expect(tail.map((m) => m.content)).toContain(`[tool result · read_file]\\n${tokens(20)}`);\n363\t  });\n364\t});\n365\t\n366\tdescribe(\"TC-4.5 (AC-4.8): budget validation names the violated constraint (replay equality lives in the Boundary G1 golden)\", () => {\n367\t  it(\"rejects max ≤ target at construction, naming the constraint\", () => {\n368\t    expect(() =>\n369\t      visSdk({ visibility: { maxTokens: 100, targetTokens: 200, floorTokens: 50 } }),\n370\t    ).toThrow(/maxTokens \\(100\\) must be greater than targetTokens \\(200\\)/);\n371\t  });\n372\t\n373\t  it(\"rejects target < floor at construction, naming the constraint\", () => {\n374\t    expect(() =>\n375\t      visSdk({ visibility: { maxTokens: 300, targetTokens: 100, floorTokens: 200 } }),\n376\t    ).toThrow(/targetTokens \\(100\\) must be at least floorTokens \\(200\\)/);\n377\t  });\n378\t});\n379\t\n380\tdescribe(\"TC-4.6 (AC-4.9): a failed advance leaves intake intact and the condition visible; the next batch heals — and the poke still fires\", () => {\n381\t  it(\"background mode: intake succeeds, boundary holds, status shows over-max, the drain still ran; cleared, the next batch lands at target\", async () => {\n382\t    const sdk = visSdk({ visibility: BUDGETS }, \"background\");\n383\t    const filePath = await newThread(sdk);\n384\t\n385\t    // The Story-0 facility's named post-commit point — not a mock of\n386\t    // boundary.ts: an installed throw stands in for an advance failure.\n387\t    let fired = 0;\n388\t    setViewInjectionHook(\"post-commit-advance\", () => {\n389\t      fired += 1;\n390\t      throw new Error(\"injected advance failure\");\n391\t    });\n392\t\n393\t    // One crossing batch: zone 120 > max 100.\n394\t    const result = await sdk.intakeStream.messageEvents({ filePath }, toolTurn([40, 40, 40]));\n395\t    expect(result.ok).toBe(true); // intake's outcome never depends on the advance\n396\t    if (!result.ok) return;\n397\t    expect(result.value.events.every((e) => e.outcome === \"recorded\")).toBe(true);\n398\t    expect(fired).toBe(1);\n399\t\n400\t    // All messages committed; boundary unchanged; the over-budget condition\n401\t    // is visible in status — computed live, the same sum the advance reads.\n402\t    const results = await toolResults(sdk, filePath);\n403\t    expect(results).toHaveLength(3);\n404\t    expect(await boundaryOf(sdk, filePath)).toBe(0);\n405\t    const status = await sdk.threadView.status({ filePath });\n406\t    expect(status.ok).toBe(true);\n407\t    if (!status.ok) return;\n408\t    expect(status.value.visibility.zoneTokens).toBe(120);\n409\t    expect(status.value.visibility.zoneTokens).toBeGreaterThan(status.value.visibility.maxTokens);\n410\t\n411\t    // Seam isolation, direction one: the throwing advance never ate the queue\n412\t    // poke — the background drain ran and the summaries landed ready.\n413\t    await sdk.drainSettled({ filePath });\n414\t    const listed = await sdk.messages.listMessages({ filePath });\n415\t    expect(listed.ok).toBe(true);\n416\t    if (!listed.ok) return;\n417\t    for (const m of listed.value.filter((msg) => msg.kind === \"tool_result\")) {\n418\t      expect(m.forms?.find((f) => f.form === \"tool_result_summary\")?.state).toBe(\"ready\");\n419\t    }\n420\t\n421\t    // Clear the injection; the next batch re-evaluates and lands at target:\n422\t    // zone 130 → flip the two oldest (130→90→50 ≤ 60), stop before the\n423\t    // protected set (r3+r4 joined to 50 ≥ floor 30).\n424\t    setViewInjectionHook(\"post-commit-advance\", null);\n425\t    await intake(sdk, filePath, toolTurn([10]));\n426\t    const all = await toolResults(sdk, filePath);\n427\t    expect(await boundaryOf(sdk, filePath)).toBe(all[1]?.sourceEventOrder);\n428\t    const healed = await sdk.threadView.status({ filePath });\n429\t    expect(healed.ok).toBe(true);\n430\t    if (!healed.ok) return;\n431\t    expect(healed.value.visibility.zoneTokens).toBe(50);\n432\t  });\n433\t});\n434\t\n435\tdescribe(\"seam isolation, direction two (architecture-risk): a failing poke never blocks the advance\", () => {\n436\t  it(\"advances through a direct domain call (default budgets) even when the fallback poke throws\", async () => {\n437\t    // Thread built through a manual SDK; the intake under test is a DIRECT\n438\t    // domain call with no SDK seam in scope, so budgets fall back to the\n439\t    // built-in defaults (32000/24000/8000) and the poke falls back to the\n440\t    // below-SDK slot — which this leg makes throw.\n441\t    const sdk = visSdk();\n442\t    const filePath = await newThread(sdk);\n443\t    setSchedulerPoke(() => {\n444\t      throw new Error(\"injected poke failure\");\n445\t    });\n446\t\n447\t    // Zone 40000 > default max 32000: flip the older result (→ 20000 ≤\n448\t    // target 24000); the newest (20000 ≥ floor 8000) is protected alone.\n449\t    await intakeStream.messageEvents({ filePath }, toolTurn([20000, 20000]));\n450\t    setSchedulerPoke(null);\n451\t\n452\t    const results = await toolResults(sdk, filePath);\n453\t    expect(results).toHaveLength(2); // the batch committed\n454\t    // The advance ran before the throwing poke: position = the older result.\n455\t    expect(await boundaryOf(sdk, filePath)).toBe(results[0]?.sourceEventOrder);\n456\t  });\n457\t});\n458\t\n459\tdescribe(\"deleted-filter consistency (story DoD): the advance's sum and status's zone sum both skip deleted results\", () => {\n460\t  it(\"drops a deleted zone result from the live sum, and the next advance decides over the filtered population\", async () => {\n461\t    const sdk = visSdk();\n462\t    const filePath = await newThread(sdk);\n463\t    // Zone 80 ≤ max 100: no advance yet.\n464\t    await intake(sdk, filePath, toolTurn([40, 40]));\n465\t    expect(await boundaryOf(sdk, filePath)).toBe(0);\n466\t\n467\t    // Delete the older result: the live zone drops to 40 — status computes\n468\t    // the deleted-filtered sum, the same query the advance reads.\n469\t    const results = await toolResults(sdk, filePath);\n470\t    const deleted = await sdk.messages.deleteMessage(\n471\t      { filePath },\n472\t      { messageId: results[0]?.messageId ?? \"\" },\n473\t    );\n474\t    expect(deleted.ok).toBe(true);\n475\t    const status = await sdk.threadView.status({ filePath });\n476\t    expect(status.ok).toBe(true);\n477\t    if (!status.ok) return;\n478\t    expect(status.value.visibility.zoneTokens).toBe(40);\n479\t\n480\t    // The next batch's advance decides over the filtered population: live\n481\t    // zone 40+40+40 = 120 > max; the deleted row neither sums nor flips.\n482\t    // Flips: the two oldest LIVE results (120→80→40 ≤ target 60); the newest\n483\t    // (40 ≥ floor 30) is protected alone.\n484\t    await intake(sdk, filePath, toolTurn([40, 40]));\n485\t    const all = await toolResults(sdk, filePath); // listMessages is deleted-filtered too\n486\t    expect(all).toHaveLength(3);\n487\t    expect(await boundaryOf(sdk, filePath)).toBe(all[1]?.sourceEventOrder);\n488\t    const after = await sdk.threadView.status({ filePath });\n489\t    expect(after.ok).toBe(true);\n490\t    if (!after.ok) return;\n491\t    expect(after.value.visibility.zoneTokens).toBe(40);\n492\t  });\n493\t});\n494\t\n495\tdescribe(\"both host modes advance in-process (story DoD; the process-boundary CLI leg is Story 5's named debt)\", () => {\n496\t  it.each([\"manual\", \"background\"] as const)(\"%s-mode SDK intake advances to the same position\", async (mode) => {\n497\t    const sdk = visSdk({ visibility: BUDGETS }, mode);\n498\t    const filePath = await newThread(sdk);\n499\t    // Zone 120 > 100: flip the two oldest (120→80→40 ≤ 60); the newest (40 ≥\n500\t    // floor 30) is protected alone.\n501\t    await intake(sdk, filePath, toolTurn([40, 40, 40]));\n502\t    const results = await toolResults(sdk, filePath);\n503\t    expect(await boundaryOf(sdk, filePath)).toBe(results[1]?.sourceEventOrder);\n504\t    if (mode === \"background\") await sdk.drainSettled({ filePath });\n505\t  });\n506\t});\n507\t"}]},"parent_tool_use_id":null,"session_id":"bb1f3fcf-4d78-4a97-8c5b-320e502ce14a","uuid":"00fde1e4-4d72-49f5-a894-1e88cccf54e0","timestamp":"2026-06-12T23:36:53.178Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-boundary.test.ts","content":"// Epic 03 Story 4: the visibility boundary (TC-4.1–4.6, the seam-isolation\n// legs both directions, the both-host-modes in-process proof, and the DoD's\n// status-sum/advance-sum equality check). Every advance here fires through a\n// REAL `intake.messageEvents` commit — no host-called advance surface exists\n// and no test invents one (story Anti-Shim Requirements); rendering is proven\n// through real `pull` calls. Budgets resolve through SDK view config (the\n// per-instance seam); the one direct-domain-call leg proves the below-SDK\n// default-budget fallback while it proves poke-failure isolation.\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport {\n  createSdk,\n  intakeStream,\n  setSchedulerPoke,\n  type Lhc,\n  type MessageEventInput,\n  type SdkViewConfig,\n} from \"../src/index.js\";\nimport {\n  createProviderDouble,\n  setViewInjectionHook,\n  tempStore,\n  validEvent,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\n// \"tok\" tokenizes to exactly one o200k token, joined or leading-space alike,\n// so a content of n joined \"tok\" words carries token_estimate n — the same\n// hand-derivable unit the Boundary G1 golden uses.\nfunction tokens(n: number): string {\n  return Array<string>(n).fill(\"tok\").join(\" \");\n}\n\n// The story's test budgets: max 100 > target 60 ≥ floor 30 (AC-4.8 ordering).\nconst BUDGETS = { maxTokens: 100, targetTokens: 60, floorTokens: 30 };\n\nconst stores: TempStore[] = [];\nafterEach(() => {\n  setViewInjectionHook(\"post-commit-advance\", null);\n  setSchedulerPoke(null);\n  for (const store of stores.splice(0)) store.cleanup();\n});\n\nfunction visSdk(view: SdkViewConfig = { visibility: BUDGETS }, mode: \"manual\" | \"background\" = \"manual\"): Lhc {\n  return createSdk({ provider: createProviderDouble(), mode, view });\n}\n\nasync function newThread(sdk: Lhc): Promise<string> {\n  const store = tempStore();\n  stores.push(store);\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nlet callCounter = 0;\n\n// One tool run: call + result with the given token count.\nfunction toolRun(resultTokens: number): MessageEventInput[] {\n  callCounter += 1;\n  const toolCallId = `call-vb-${callCounter}`;\n  return [\n    validEvent(\"tool_call\", {\n      payload: { toolCallId, toolName: \"read_file\", arguments: { path: `vb-${callCounter}.txt` } },\n    }),\n    validEvent(\"tool_result\", {\n      payload: { toolCallId, content: tokens(resultTokens), isError: false },\n    }),\n  ];\n}\n\n// One scripted turn: prompt, a tool run per entry, optional turn_end.\nfunction toolTurn(resultTokens: readonly number[], opts: { turnEnd?: boolean } = {}): MessageEventInput[] {\n  const events: MessageEventInput[] = [\n    validEvent(\"user_prompt\", { payload: { text: \"scripted boundary turn\" } }),\n  ];\n  for (const n of resultTokens) events.push(...toolRun(n));\n  if (opts.turnEnd !== false) events.push(validEvent(\"turn_end\"));\n  return events;\n}\n\nasync function intake(sdk: Lhc, filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`intake failed: ${result.error.reason}`);\n}\n\nasync function boundaryOf(sdk: Lhc, filePath: string): Promise<number> {\n  const pulled = await sdk.threadView.pull({ filePath });\n  if (!pulled.ok) throw new Error(`pull failed: ${pulled.error.reason}`);\n  return pulled.value.meta.boundaryPosition;\n}\n\nasync function toolResults(\n  sdk: Lhc,\n  filePath: string,\n): Promise<Array<{ messageId: string; sourceEventOrder: number; tokenEstimate: number }>> {\n  const listed = await sdk.messages.listMessages({ filePath });\n  if (!listed.ok) throw new Error(`listMessages failed: ${listed.error.reason}`);\n  return listed.value\n    .filter((m) => m.kind === \"tool_result\")\n    .map((m) => ({\n      messageId: m.messageId,\n      sourceEventOrder: m.sourceEventOrder,\n      tokenEstimate: m.tokenEstimate,\n    }));\n}\n\nfunction abridgedCount(messages: ReadonlyArray<{ content: string }>): number {\n  return messages.filter((m) => m.content.startsWith(\"[tool result · \") && m.content.includes(\" · abridged]\"))\n    .length;\n}\n\ndescribe(\"TC-4.1 (AC-4.3): under-max batches never move the boundary; the crossing batch moves once to target, oldest-first\", () => {\n  it(\"holds position and bytes below max, then flips exactly one oldest-first batch of results\", async () => {\n    const sdk = visSdk();\n    const filePath = await newThread(sdk);\n\n    // Two under-max batches (zone 40, then 80 ≤ max 100): boundary unmoved.\n    await intake(sdk, filePath, toolTurn([20, 20]));\n    const afterFirst = await sdk.threadView.pull({ filePath });\n    expect(afterFirst.ok).toBe(true);\n    if (!afterFirst.ok) return;\n    expect(afterFirst.value.meta.boundaryPosition).toBe(0);\n\n    await intake(sdk, filePath, toolTurn([20, 20]));\n    const afterSecond = await sdk.threadView.pull({ filePath });\n    expect(afterSecond.ok).toBe(true);\n    if (!afterSecond.ok) return;\n    expect(afterSecond.value.meta.boundaryPosition).toBe(0);\n    // Rendered bytes do not change below max: the earlier pull's messages are\n    // a byte-identical prefix of the later one (AC-4.3's no-churn half).\n    expect(afterSecond.value.messages.slice(0, afterFirst.value.messages.length)).toEqual(\n      afterFirst.value.messages,\n    );\n    expect(abridgedCount(afterSecond.value.messages)).toBe(0);\n\n    // The crossing batch (zone 120 > 100): one advance to target — the three\n    // oldest results flip (120→100→80→60 = target), the newer three stay\n    // full; the protected set (newest joined to 40 ≥ floor 30) is untouched.\n    await intake(sdk, filePath, toolTurn([20, 20]));\n    const results = await toolResults(sdk, filePath);\n    expect(results).toHaveLength(6);\n    const expectedPosition = results[2]?.sourceEventOrder;\n    const crossed = await sdk.threadView.pull({ filePath });\n    expect(crossed.ok).toBe(true);\n    if (!crossed.ok) return;\n    expect(crossed.value.meta.boundaryPosition).toBe(expectedPosition);\n    expect(abridgedCount(crossed.value.messages)).toBe(3);\n\n    // Oldest-first: precisely the first three results render abridged.\n    const abridgedIds = results\n      .filter((r) => r.sourceEventOrder <= (expectedPosition ?? 0))\n      .map((r) => r.messageId);\n    expect(abridgedIds).toEqual(results.slice(0, 3).map((r) => r.messageId));\n\n    // DoD: status's zone sum equals the advance's decision sum on the same\n    // state — the live tool-result estimates ahead of the boundary.\n    const status = await sdk.threadView.status({ filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n    const expectedZone = results\n      .filter((r) => r.sourceEventOrder > (expectedPosition ?? 0))\n      .reduce((sum, r) => sum + r.tokenEstimate, 0);\n    expect(status.value.visibility.zoneTokens).toBe(expectedZone);\n    expect(status.value.visibility.zoneTokens).toBe(60);\n\n    // The next under-max batch (zone 70 ≤ 100): no movement.\n    await intake(sdk, filePath, toolTurn([10]));\n    expect(await boundaryOf(sdk, filePath)).toBe(expectedPosition);\n  });\n});\n\ndescribe(\"TC-4.2 (AC-4.1, AC-4.2): flipped renders — summary when usable, deterministic truncation with marker when not; non-tool content untouched\", () => {\n  it(\"renders the ready summary, the truncation rung for the failed summary, and the interleaved assistant text full\", async () => {\n    const double = createProviderDouble();\n    const sdk = createSdk({ provider: double, mode: \"manual\", view: { visibility: BUDGETS } });\n    const filePath = await newThread(sdk);\n\n    // r1 (60 tokens, 239 chars — over the 200-char abbreviation limit) will\n    // have its summary FAIL terminally; r2 (20 tokens) drains a ready\n    // summary; an assistant message sits between them.\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"flip rendering prompt\" } }),\n      ...toolRun(60),\n      validEvent(\"assistant_text\", { payload: { text: \"interleaved assistant text\" } }),\n      ...toolRun(20),\n      validEvent(\"turn_end\"),\n    ]);\n    // First tool_result_summary execution fails non-retryably (r1's — queue\n    // order is walk order); r2's succeeds. Real drain, production paths.\n    double.failKind(\"tool_result_summary\", 1, {\n      retryable: false,\n      reason: \"content_refusal: scripted permanent failure (boundary test)\",\n    });\n    const drained = await sdk.work.drain({ filePath });\n    expect(drained.ok).toBe(true);\n\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const results = listed.value.filter((m) => m.kind === \"tool_result\");\n    const [r1, r2] = results;\n    expect(r1 && r2).toBeTruthy();\n    if (r1 === undefined || r2 === undefined) return;\n    expect(\n      r1.forms?.find((f) => f.form === \"tool_result_summary\")?.state,\n    ).toBe(\"failed\");\n    const r2Summary = r2.forms?.find(\n      (f) => f.form === \"tool_result_summary\" && f.state === \"ready\",\n    )?.content;\n    expect(r2Summary).toBeDefined();\n\n    // The crossing batch: an 80-token result (zone 60+20+80 = 160 > max).\n    // Flips r1 and r2 (160→100→80); the newest is protected alone (≥ floor).\n    await intake(sdk, filePath, toolTurn([80]));\n    expect(await boundaryOf(sdk, filePath)).toBe(r2.sourceEventOrder);\n\n    const pulled = await sdk.threadView.pull({ filePath });\n    expect(pulled.ok).toBe(true);\n    if (!pulled.ok) return;\n    const contents = pulled.value.messages.map((m) => m.content);\n\n    // r1: failed summary ⇒ deterministic truncation rung — fixed 200-char\n    // prefix, exact dropped-count marker, abridged marker, record pointer.\n    expect(contents).toContain(\n      `[tool result · read_file · abridged]\\n${tokens(60).slice(0, 200)}… [truncated 39 chars] [full content in record §${r1.messageId}]`,\n    );\n    // r2: usable summary ⇒ the summary verbatim.\n    expect(contents).toContain(\n      `[tool result · read_file · abridged]\\n${r2Summary} [full content in record §${r2.messageId}]`,\n    );\n    // The interleaved assistant message renders full — non-tool-result\n    // content is never affected by the boundary (AC-4.1).\n    expect(contents).toContain(\"interleaved assistant text\");\n    // The newest (protected) result renders full.\n    expect(contents).toContain(`[tool result · read_file]\\n${tokens(80)}`);\n  });\n});\n\ndescribe(\"TC-4.3 (AC-4.5): monster turn — the advance enters the open turn but stops at the whole-message protected set\", () => {\n  it(\"flips into the open turn, keeps the newest whole results (joined ≥ floor) full, and leaves the turn's text full\", async () => {\n    const sdk = visSdk();\n    const filePath = await newThread(sdk);\n    // One small closed turn, then one open turn whose tool results alone\n    // cross max: zone 20+40+40+40+25 = 165 > 100.\n    await intake(sdk, filePath, toolTurn([20]));\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"monster prompt\" } }),\n      validEvent(\"assistant_thinking\", { payload: { text: \"monster thought\" } }),\n      ...toolRun(40),\n      ...toolRun(40),\n      ...toolRun(40),\n      ...toolRun(25),\n      validEvent(\"assistant_text\", { payload: { text: \"monster narration\" } }),\n      // No turn_end: the turn stays open.\n    ]);\n\n    const results = await toolResults(sdk, filePath);\n    expect(results).toHaveLength(5);\n    // Protected set, newest-backward joined to ≥ floor 30: m4 (25) alone is\n    // under the floor, so m3 joins (65) — whole messages, never a partial.\n    // Flips stop there with the zone at 65, legally above target 60.\n    const expectedPosition = results[2]?.sourceEventOrder; // m2: inside the open turn\n    expect(await boundaryOf(sdk, filePath)).toBe(expectedPosition);\n\n    const pulled = await sdk.threadView.pull({ filePath });\n    expect(pulled.ok).toBe(true);\n    if (!pulled.ok) return;\n    const contents = pulled.value.messages.map((m) => m.content);\n    expect(abridgedCount(pulled.value.messages)).toBe(3); // r0, m1, m2\n    // The protected newest results render full.\n    expect(contents).toContain(`[tool result · read_file]\\n${tokens(40)}`);\n    expect(contents).toContain(`[tool result · read_file]\\n${tokens(25)}`);\n    // The turn's own text messages all render full.\n    expect(contents).toContain(\"monster prompt\");\n    expect(contents).toContain(\"[thinking]\\nmonster thought\\n[/thinking]\");\n    expect(contents).toContain(\"monster narration\");\n\n    const status = await sdk.threadView.status({ filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n    expect(status.value.visibility.zoneTokens).toBe(65);\n  });\n\n  it(\"oversized-newest leg: a single result larger than the floor is protected alone; the zone legally sits above target\", async () => {\n    const sdk = visSdk();\n    const filePath = await newThread(sdk);\n    await intake(sdk, filePath, toolTurn([20]));\n    // Open turn: 40 + 40 + 80; zone 180 > max. The newest (80) exceeds the\n    // floor by itself and is protected alone (AC-4.5).\n    await intake(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"oversized prompt\" } }),\n      ...toolRun(40),\n      ...toolRun(40),\n      ...toolRun(80),\n    ]);\n    const results = await toolResults(sdk, filePath);\n    expect(results).toHaveLength(4);\n    expect(await boundaryOf(sdk, filePath)).toBe(results[2]?.sourceEventOrder);\n\n    const pulled = await sdk.threadView.pull({ filePath });\n    expect(pulled.ok).toBe(true);\n    if (!pulled.ok) return;\n    // The oversized newest renders full; everything older flipped.\n    expect(pulled.value.messages.map((m) => m.content)).toContain(\n      `[tool result · read_file]\\n${tokens(80)}`,\n    );\n    expect(abridgedCount(pulled.value.messages)).toBe(3);\n\n    const status = await sdk.threadView.status({ filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n    expect(status.value.visibility.zoneTokens).toBe(80); // above target until room appears\n  });\n});\n\ndescribe(\"TC-4.4 (AC-4.6, AC-4.7): never backward within a window; compact resets to the compact point\", () => {\n  it(\"keeps flipped results flipped across small batches, then resets to the compact point with a full fresh tail\", async () => {\n    const sdk = visSdk();\n    const filePath = await newThread(sdk);\n    for (let i = 0; i < 3; i += 1) await intake(sdk, filePath, toolTurn([20, 20]));\n    const results = await toolResults(sdk, filePath);\n    const advanced = results[2]?.sourceEventOrder ?? 0;\n    expect(await boundaryOf(sdk, filePath)).toBe(advanced);\n\n    // Small tool-free batches: no backward motion, flipped stay flipped.\n    for (let i = 0; i < 2; i += 1) {\n      await intake(sdk, filePath, [\n        validEvent(\"user_prompt\", { payload: { text: `small batch ${i}` } }),\n        validEvent(\"assistant_text\", { payload: { text: `small answer ${i}` } }),\n        validEvent(\"turn_end\"),\n      ]);\n      const pulled = await sdk.threadView.pull({ filePath });\n      expect(pulled.ok).toBe(true);\n      if (!pulled.ok) return;\n      expect(pulled.value.meta.boundaryPosition).toBe(advanced);\n      expect(abridgedCount(pulled.value.messages)).toBe(3);\n    }\n\n    // Compact: the boundary resets to the compact point (AC-4.7 — the reset\n    // transaction landed in Story 2; this proves it end-to-end against a\n    // boundary the production advance moved).\n    const receipt = await sdk.threadView.compact(\n      { filePath },\n      { params: { lowerBound: 40 }, sweep: false },\n    );\n    expect(receipt.ok).toBe(true);\n    if (!receipt.ok) return;\n    const afterCompact = await sdk.threadView.pull({ filePath });\n    expect(afterCompact.ok).toBe(true);\n    if (!afterCompact.ok) return;\n    expect(afterCompact.value.meta.compactPoint).toBe(receipt.value.compactPoint);\n    expect(afterCompact.value.meta.boundaryPosition).toBe(receipt.value.compactPoint);\n\n    // Fresh tail renders full: a new under-max tool result is not abridged.\n    await intake(sdk, filePath, toolTurn([20]));\n    const fresh = await sdk.threadView.pull({ filePath });\n    expect(fresh.ok).toBe(true);\n    if (!fresh.ok) return;\n    const tail = fresh.value.messages.filter((m) => m.band === undefined);\n    expect(abridgedCount(tail)).toBe(0);\n    expect(tail.map((m) => m.content)).toContain(`[tool result · read_file]\\n${tokens(20)}`);\n  });\n});\n\ndescribe(\"TC-4.5 (AC-4.8): budget validation names the violated constraint (replay equality lives in the Boundary G1 golden)\", () => {\n  it(\"rejects max ≤ target at construction, naming the constraint\", () => {\n    expect(() =>\n      visSdk({ visibility: { maxTokens: 100, targetTokens: 200, floorTokens: 50 } }),\n    ).toThrow(/maxTokens \\(100\\) must be greater than targetTokens \\(200\\)/);\n  });\n\n  it(\"rejects target < floor at construction, naming the constraint\", () => {\n    expect(() =>\n      visSdk({ visibility: { maxTokens: 300, targetTokens: 100, floorTokens: 200 } }),\n    ).toThrow(/targetTokens \\(100\\) must be at least floorTokens \\(200\\)/);\n  });\n});\n\ndescribe(\"TC-4.6 (AC-4.9): a failed advance leaves intake intact and the condition visible; the next batch heals — and the poke still fires\", () => {\n  it(\"background mode: intake succeeds, boundary holds, status shows over-max, the drain still ran; cleared, the next batch lands at target\", async () => {\n    const sdk = visSdk({ visibility: BUDGETS }, \"background\");\n    const filePath = await newThread(sdk);\n\n    // The Story-0 facility's named post-commit point — not a mock of\n    // boundary.ts: an installed throw stands in for an advance failure.\n    let fired = 0;\n    setViewInjectionHook(\"post-commit-advance\", () => {\n      fired += 1;\n      throw new Error(\"injected advance failure\");\n    });\n\n    // One crossing batch: zone 120 > max 100.\n    const result = await sdk.intakeStream.messageEvents({ filePath }, toolTurn([40, 40, 40]));\n    expect(result.ok).toBe(true); // intake's outcome never depends on the advance\n    if (!result.ok) return;\n    expect(result.value.events.every((e) => e.outcome === \"recorded\")).toBe(true);\n    expect(fired).toBe(1);\n\n    // All messages committed; boundary unchanged; the over-budget condition\n    // is visible in status — computed live, the same sum the advance reads.\n    const results = await toolResults(sdk, filePath);\n    expect(results).toHaveLength(3);\n    expect(await boundaryOf(sdk, filePath)).toBe(0);\n    const status = await sdk.threadView.status({ filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n    expect(status.value.visibility.zoneTokens).toBe(120);\n    expect(status.value.visibility.zoneTokens).toBeGreaterThan(status.value.visibility.maxTokens);\n\n    // Seam isolation, direction one: the throwing advance never ate the queue\n    // poke — the background drain ran and the summaries landed ready.\n    await sdk.drainSettled({ filePath });\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    for (const m of listed.value.filter((msg) => msg.kind === \"tool_result\")) {\n      expect(m.forms?.find((f) => f.form === \"tool_result_summary\")?.state).toBe(\"ready\");\n    }\n\n    // Clear the injection; the next batch re-evaluates and lands at target:\n    // zone 130 → flip the two oldest (130→90→50 ≤ 60), stop before the\n    // protected set (r3+r4 joined to 50 ≥ floor 30).\n    setViewInjectionHook(\"post-commit-advance\", null);\n    await intake(sdk, filePath, toolTurn([10]));\n    const all = await toolResults(sdk, filePath);\n    expect(await boundaryOf(sdk, filePath)).toBe(all[1]?.sourceEventOrder);\n    const healed = await sdk.threadView.status({ filePath });\n    expect(healed.ok).toBe(true);\n    if (!healed.ok) return;\n    expect(healed.value.visibility.zoneTokens).toBe(50);\n  });\n});\n\ndescribe(\"seam isolation, direction two (architecture-risk): a failing poke never blocks the advance\", () => {\n  it(\"advances through a direct domain call (default budgets) even when the fallback poke throws\", async () => {\n    // Thread built through a manual SDK; the intake under test is a DIRECT\n    // domain call with no SDK seam in scope, so budgets fall back to the\n    // built-in defaults (32000/24000/8000) and the poke falls back to the\n    // below-SDK slot — which this leg makes throw.\n    const sdk = visSdk();\n    const filePath = await newThread(sdk);\n    setSchedulerPoke(() => {\n      throw new Error(\"injected poke failure\");\n    });\n\n    // Zone 40000 > default max 32000: flip the older result (→ 20000 ≤\n    // target 24000); the newest (20000 ≥ floor 8000) is protected alone.\n    await intakeStream.messageEvents({ filePath }, toolTurn([20000, 20000]));\n    setSchedulerPoke(null);\n\n    const results = await toolResults(sdk, filePath);\n    expect(results).toHaveLength(2); // the batch committed\n    // The advance ran before the throwing poke: position = the older result.\n    expect(await boundaryOf(sdk, filePath)).toBe(results[0]?.sourceEventOrder);\n  });\n});\n\ndescribe(\"deleted-filter consistency (story DoD): the advance's sum and status's zone sum both skip deleted results\", () => {\n  it(\"drops a deleted zone result from the live sum, and the next advance decides over the filtered population\", async () => {\n    const sdk = visSdk();\n    const filePath = await newThread(sdk);\n    // Zone 80 ≤ max 100: no advance yet.\n    await intake(sdk, filePath, toolTurn([40, 40]));\n    expect(await boundaryOf(sdk, filePath)).toBe(0);\n\n    // Delete the older result: the live zone drops to 40 — status computes\n    // the deleted-filtered sum, the same query the advance reads.\n    const results = await toolResults(sdk, filePath);\n    const deleted = await sdk.messages.deleteMessage(\n      { filePath },\n      { messageId: results[0]?.messageId ?? \"\" },\n    );\n    expect(deleted.ok).toBe(true);\n    const status = await sdk.threadView.status({ filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n    expect(status.value.visibility.zoneTokens).toBe(40);\n\n    // The next batch's advance decides over the filtered population: live\n    // zone 40+40+40 = 120 > max; the deleted row neither sums nor flips.\n    // Flips: the two oldest LIVE results (120→80→40 ≤ target 60); the newest\n    // (40 ≥ floor 30) is protected alone.\n    await intake(sdk, filePath, toolTurn([40, 40]));\n    const all = await toolResults(sdk, filePath); // listMessages is deleted-filtered too\n    expect(all).toHaveLength(3);\n    expect(await boundaryOf(sdk, filePath)).toBe(all[1]?.sourceEventOrder);\n    const after = await sdk.threadView.status({ filePath });\n    expect(after.ok).toBe(true);\n    if (!after.ok) return;\n    expect(after.value.visibility.zoneTokens).toBe(40);\n  });\n});\n\ndescribe(\"both host modes advance in-process (story DoD; the process-boundary CLI leg is Story 5's named debt)\", () => {\n  it.each([\"manual\", \"background\"] as const)(\"%s-mode SDK intake advances to the same position\", async (mode) => {\n    const sdk = visSdk({ visibility: BUDGETS }, mode);\n    const filePath = await newThread(sdk);\n    // Zone 120 > 100: flip the two oldest (120→80→40 ≤ 60); the newest (40 ≥\n    // floor 30) is protected alone.\n    await intake(sdk, filePath, toolTurn([40, 40, 40]));\n    const results = await toolResults(sdk, filePath);\n    expect(await boundaryOf(sdk, filePath)).toBe(results[1]?.sourceEventOrder);\n    if (mode === \"background\") await sdk.drainSettled({ filePath });\n  });\n});\n","numLines":507,"startLine":1,"totalLines":507}}}

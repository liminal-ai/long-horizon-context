{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019sgerq4LMMpepTxdUNHUwF","type":"tool_result","content":"1\t// Epic 05 Story 1 (Flow 6): CLI retirement proof — TC-6.1, TC-6.2.\n2\t// The package publishes an SDK-only surface: no binary, no named-provider\n3\t// registry, no env/flag provider resolution. Deletion is proven three ways:\n4\t// an export-name snapshot of the package entry (catches both leftover\n5\t// CLI-only exports and accidental removals), a manifest check, and a\n6\t// source-level scan for the retired resolution vocabulary. Provider arrival\n7\t// is injection at createSdk only.\n8\timport { existsSync, readdirSync, readFileSync, statSync } from \"node:fs\";\n9\timport path from \"node:path\";\n10\timport { fileURLToPath } from \"node:url\";\n11\timport { afterEach, describe, expect, it } from \"vitest\";\n12\timport * as api from \"../src/index.js\";\n13\timport { createSdk, type SdkConfig } from \"../src/index.js\";\n14\t\n15\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n16\t\n17\t// The checked-in SDK-only surface (AC-6.1). A diff here is an intentional\n18\t// public-API change: update the list in the same change that alters the\n19\t// exports, never to quiet the test.\n20\tconst SDK_ONLY_EXPORTS = [\n21\t  \"BUILT_IN_PROFILES\",\n22\t  \"DEFAULT_COMPACT_THRESHOLD\",\n23\t  \"DEFAULT_VISIBILITY\",\n24\t  \"TOKEN_ESTIMATOR_ID\",\n25\t  \"WORK_KIND_REGISTRY\",\n26\t  \"assembleWorkHandlerMap\",\n27\t  \"countLiveItems\",\n28\t  \"createDeterministicProvider\",\n29\t  \"createSdk\",\n30\t  \"deterministicOutcomesSuffix\",\n31\t  \"deterministicReceiptsSuffix\",\n32\t  \"deterministicText\",\n33\t  \"enqueue\",\n34\t  \"estimateTokens\",\n35\t  \"inspect\",\n36\t  \"intakeStream\",\n37\t  \"lookupWorkHandler\",\n38\t  \"messages\",\n39\t  \"queueDetail\",\n40\t  \"runInTransaction\",\n41\t  \"setSchedulerPoke\",\n42\t  \"setThreadTouch\",\n43\t  \"supersedeQueued\",\n44\t  \"threadView\",\n45\t  \"threads\",\n46\t  \"turns\",\n47\t];\n48\t\n49\tfunction collectSourceFiles(dir: string, out: string[] = []): string[] {\n50\t  for (const entry of readdirSync(dir)) {\n51\t    const full = path.join(dir, entry);\n52\t    if (statSync(full).isDirectory()) collectSourceFiles(full, out);\n53\t    else out.push(full);\n54\t  }\n55\t  return out;\n56\t}\n57\t\n58\tdescribe(\"TC-6.1: deletion proof — SDK-only public API, no binary (AC-6.1, AC-6.2)\", () => {\n59\t  it(\"the package entry's export-name set equals the checked-in SDK-only list\", () => {\n60\t    expect(Object.keys(api).sort()).toEqual(SDK_ONLY_EXPORTS);\n61\t  });\n62\t\n63\t  it(\"the CLI-only entries are gone from the surface\", () => {\n64\t    const names = new Set(Object.keys(api));\n65\t    expect(names.has(\"resolveNamedProvider\")).toBe(false);\n66\t    expect(names.has(\"registeredProviderNames\")).toBe(false);\n67\t    expect(names.has(\"runCli\")).toBe(false);\n68\t  });\n69\t\n70\t  it(\"the package manifest publishes no binary and no CLI script\", () => {\n71\t    const manifest = JSON.parse(readFileSync(path.join(pkgRoot, \"package.json\"), \"utf8\")) as {\n72\t      bin?: unknown;\n73\t      scripts?: Record<string, string>;\n74\t    };\n75\t    expect(manifest.bin).toBeUndefined();\n76\t    expect(manifest.scripts?.[\"dev:cli\"]).toBeUndefined();\n77\t    for (const command of Object.values(manifest.scripts ?? {})) {\n78\t      expect(command).not.toContain(\"LHC_PROCESS_SUITE\");\n79\t    }\n80\t  });\n81\t\n82\t  it(\"the CLI surface, registry module, and spawned-process suites are deleted\", () => {\n83\t    expect(existsSync(path.join(pkgRoot, \"src\", \"cli\"))).toBe(false);\n84\t    expect(existsSync(path.join(pkgRoot, \"src\", \"cli.ts\"))).toBe(false);\n85\t    expect(existsSync(path.join(pkgRoot, \"src\", \"providers\", \"registry.ts\"))).toBe(false);\n86\t    const processSuites = readdirSync(path.join(pkgRoot, \"test\")).filter((name) =>\n87\t      name.startsWith(\"cli-process\"),\n88\t    );\n89\t    expect(processSuites).toEqual([]);\n90\t  });\n91\t});\n92\t\n93\tdescribe(\"TC-6.2: the env/flag provider-resolution path is gone (AC-6.3)\", () => {\n94\t  const envKey = [\"LHC\", \"PROVIDER\"].join(\"_\"); // composed so the scan below stays meaningful\n95\t  const flag = \"--\" + \"provider\";\n96\t\n97\t  it(\"zero LHC_PROVIDER / --provider references under src/\", () => {\n98\t    const hits: string[] = [];\n99\t    for (const file of collectSourceFiles(path.join(pkgRoot, \"src\"))) {\n100\t      const source = readFileSync(file, \"utf8\");\n101\t      if (source.includes(envKey) || source.includes(flag)) {\n102\t        hits.push(path.relative(pkgRoot, file));\n103\t      }\n104\t    }\n105\t    expect(hits).toEqual([]);\n106\t  });\n107\t\n108\t  const priorEnv = process.env[envKey];\n109\t  afterEach(() => {\n110\t    if (priorEnv === undefined) delete process.env[envKey];\n111\t    else process.env[envKey] = priorEnv;\n112\t  });\n113\t\n114\t  it(\"neither provider nor inference is the XOR TypeError; no fallback resolution catches it\", () => {\n115\t    // Even with the retired env variable set, construction must throw: the\n116\t    // only provider-arrival path is injection at createSdk.\n117\t    process.env[envKey] = \"deterministic\";\n118\t    expect(() => createSdk({ mode: \"manual\" } as unknown as SdkConfig)).toThrow(TypeError);\n119\t    expect(() => createSdk({ mode: \"manual\" } as unknown as SdkConfig)).toThrow(\n120\t      /exactly one of provider or inference/,\n121\t    );\n122\t  });\n123\t});\n124\t"}]},"parent_tool_use_id":null,"session_id":"21aa2d18-a091-4ea4-98a8-848a8f6dbb81","uuid":"e56cdf73-957d-4100-adb2-412082ff11dd","timestamp":"2026-06-13T00:47:16.785Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/retirement.test.ts","content":"// Epic 05 Story 1 (Flow 6): CLI retirement proof — TC-6.1, TC-6.2.\n// The package publishes an SDK-only surface: no binary, no named-provider\n// registry, no env/flag provider resolution. Deletion is proven three ways:\n// an export-name snapshot of the package entry (catches both leftover\n// CLI-only exports and accidental removals), a manifest check, and a\n// source-level scan for the retired resolution vocabulary. Provider arrival\n// is injection at createSdk only.\nimport { existsSync, readdirSync, readFileSync, statSync } from \"node:fs\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { afterEach, describe, expect, it } from \"vitest\";\nimport * as api from \"../src/index.js\";\nimport { createSdk, type SdkConfig } from \"../src/index.js\";\n\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n\n// The checked-in SDK-only surface (AC-6.1). A diff here is an intentional\n// public-API change: update the list in the same change that alters the\n// exports, never to quiet the test.\nconst SDK_ONLY_EXPORTS = [\n  \"BUILT_IN_PROFILES\",\n  \"DEFAULT_COMPACT_THRESHOLD\",\n  \"DEFAULT_VISIBILITY\",\n  \"TOKEN_ESTIMATOR_ID\",\n  \"WORK_KIND_REGISTRY\",\n  \"assembleWorkHandlerMap\",\n  \"countLiveItems\",\n  \"createDeterministicProvider\",\n  \"createSdk\",\n  \"deterministicOutcomesSuffix\",\n  \"deterministicReceiptsSuffix\",\n  \"deterministicText\",\n  \"enqueue\",\n  \"estimateTokens\",\n  \"inspect\",\n  \"intakeStream\",\n  \"lookupWorkHandler\",\n  \"messages\",\n  \"queueDetail\",\n  \"runInTransaction\",\n  \"setSchedulerPoke\",\n  \"setThreadTouch\",\n  \"supersedeQueued\",\n  \"threadView\",\n  \"threads\",\n  \"turns\",\n];\n\nfunction collectSourceFiles(dir: string, out: string[] = []): string[] {\n  for (const entry of readdirSync(dir)) {\n    const full = path.join(dir, entry);\n    if (statSync(full).isDirectory()) collectSourceFiles(full, out);\n    else out.push(full);\n  }\n  return out;\n}\n\ndescribe(\"TC-6.1: deletion proof — SDK-only public API, no binary (AC-6.1, AC-6.2)\", () => {\n  it(\"the package entry's export-name set equals the checked-in SDK-only list\", () => {\n    expect(Object.keys(api).sort()).toEqual(SDK_ONLY_EXPORTS);\n  });\n\n  it(\"the CLI-only entries are gone from the surface\", () => {\n    const names = new Set(Object.keys(api));\n    expect(names.has(\"resolveNamedProvider\")).toBe(false);\n    expect(names.has(\"registeredProviderNames\")).toBe(false);\n    expect(names.has(\"runCli\")).toBe(false);\n  });\n\n  it(\"the package manifest publishes no binary and no CLI script\", () => {\n    const manifest = JSON.parse(readFileSync(path.join(pkgRoot, \"package.json\"), \"utf8\")) as {\n      bin?: unknown;\n      scripts?: Record<string, string>;\n    };\n    expect(manifest.bin).toBeUndefined();\n    expect(manifest.scripts?.[\"dev:cli\"]).toBeUndefined();\n    for (const command of Object.values(manifest.scripts ?? {})) {\n      expect(command).not.toContain(\"LHC_PROCESS_SUITE\");\n    }\n  });\n\n  it(\"the CLI surface, registry module, and spawned-process suites are deleted\", () => {\n    expect(existsSync(path.join(pkgRoot, \"src\", \"cli\"))).toBe(false);\n    expect(existsSync(path.join(pkgRoot, \"src\", \"cli.ts\"))).toBe(false);\n    expect(existsSync(path.join(pkgRoot, \"src\", \"providers\", \"registry.ts\"))).toBe(false);\n    const processSuites = readdirSync(path.join(pkgRoot, \"test\")).filter((name) =>\n      name.startsWith(\"cli-process\"),\n    );\n    expect(processSuites).toEqual([]);\n  });\n});\n\ndescribe(\"TC-6.2: the env/flag provider-resolution path is gone (AC-6.3)\", () => {\n  const envKey = [\"LHC\", \"PROVIDER\"].join(\"_\"); // composed so the scan below stays meaningful\n  const flag = \"--\" + \"provider\";\n\n  it(\"zero LHC_PROVIDER / --provider references under src/\", () => {\n    const hits: string[] = [];\n    for (const file of collectSourceFiles(path.join(pkgRoot, \"src\"))) {\n      const source = readFileSync(file, \"utf8\");\n      if (source.includes(envKey) || source.includes(flag)) {\n        hits.push(path.relative(pkgRoot, file));\n      }\n    }\n    expect(hits).toEqual([]);\n  });\n\n  const priorEnv = process.env[envKey];\n  afterEach(() => {\n    if (priorEnv === undefined) delete process.env[envKey];\n    else process.env[envKey] = priorEnv;\n  });\n\n  it(\"neither provider nor inference is the XOR TypeError; no fallback resolution catches it\", () => {\n    // Even with the retired env variable set, construction must throw: the\n    // only provider-arrival path is injection at createSdk.\n    process.env[envKey] = \"deterministic\";\n    expect(() => createSdk({ mode: \"manual\" } as unknown as SdkConfig)).toThrow(TypeError);\n    expect(() => createSdk({ mode: \"manual\" } as unknown as SdkConfig)).toThrow(\n      /exactly one of provider or inference/,\n    );\n  });\n});\n","numLines":124,"startLine":1,"totalLines":124}}}

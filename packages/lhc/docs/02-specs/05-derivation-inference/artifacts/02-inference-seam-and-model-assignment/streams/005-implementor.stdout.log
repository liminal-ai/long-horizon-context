{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ks8Qp7kWRKLMUYXq5UMLTJ","type":"tool_result","content":"1\t// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\n2\t// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\n3\t// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\n4\t// deterministic provider double into known form states. States are reached\n5\t// through production paths, never hand-written rows (the anti-shim line\n6\t// FC-0.3 enforces): the failed states come from scripted provider failures\n7\t// consumed by the real retry/exhaustion mechanics, and blocked comes from\n8\t// real source damage on a sacrificial sibling thread. Every later Epic 03\n9\t// story compacts against what this builder returns.\n10\timport {\n11\t  createSdk,\n12\t  type CompactReceipt,\n13\t  type FormReportEntry,\n14\t  type Lhc,\n15\t  type MessageEventInput,\n16\t  type MutationResult,\n17\t} from \"../../src/index.js\";\n18\timport { corruptTwoOpenTurns } from \"./corrupt.js\";\n19\timport { createProviderDouble, type ProviderDouble } from \"./provider-double.js\";\n20\timport { readChunks, type ChunkSnapshot } from \"./threads.js\";\n21\timport { validEvent, type TempStore } from \"./index.js\";\n22\t\n23\t// Reason classes the scripted failures stamp, chosen from the sweep\n24\t// classification table's vocabulary (tech design §Spec Validation): a\n25\t// rate-limit class reads transient, a content-refusal class reads permanent —\n26\t// FC-0.4's distinguishable-on-read-back guarantee, proven here before\n27\t// Story 3 depends on it.\n28\texport const TRANSIENT_EXHAUST_REASON =\n29\t  \"rate_limit: scripted transient exhaustion (fixture)\";\n30\texport const PERMANENT_FAILURE_REASON =\n31\t  \"content_refusal: scripted permanent failure (fixture)\";\n32\t\n33\t// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\n34\t// (3 members each; c1–c3 closed, c4 still open). Projections from the\n35\t// deterministic double are near-constant in size (`projection(<digest>:<40\n36\t// chars>)`), so the cut is stable; the builder asserts the shape and throws\n37\t// if drift ever moves it.\n38\tconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\n39\t\n40\tconst TURN_COUNT = 12;\n41\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n42\t\n43\tfunction turnEvents(turn: number): MessageEventInput[] {\n44\t  const events: MessageEventInput[] = [\n45\t    validEvent(\"user_prompt\", {\n46\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n47\t    }),\n48\t    validEvent(\"assistant_thinking\", {\n49\t      payload: { text: `considering what area ${turn} contains` },\n50\t    }),\n51\t  ];\n52\t  if (TOOL_HEAVY_TURNS.has(turn)) {\n53\t    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\n54\t    // realistic over-max zone of tool results to age behind the boundary.\n55\t    for (const run of [1, 2]) {\n56\t      const toolCallId = `call-fx-${turn}-${run}`;\n57\t      events.push(\n58\t        validEvent(\"tool_call\", {\n59\t          payload: {\n60\t            toolCallId,\n61\t            toolName: \"read_file\",\n62\t            arguments: { path: `area-${turn}/file-${run}.txt` },\n63\t          },\n64\t        }),\n65\t        validEvent(\"tool_result\", {\n66\t          payload: {\n67\t            toolCallId,\n68\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n69\t            isError: false,\n70\t          },\n71\t        }),\n72\t      );\n73\t    }\n74\t  }\n75\t  events.push(\n76\t    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n77\t    validEvent(\"turn_end\"),\n78\t  );\n79\t  return events;\n80\t}\n81\t\n82\texport interface DerivedThreadFixture {\n83\t  filePath: string;\n84\t  sdk: Lhc;\n85\t  double: ProviderDouble;\n86\t  turnIds: string[]; // t1..t12\n87\t  chunks: ChunkSnapshot;\n88\t  // The two manufactured failed subjects (tool_result_summary forms), reached\n89\t  // through real retry exhaustion / terminal failure — absent when failures\n90\t  // are disabled for a variant.\n91\t  failedTransientMessageId?: string;\n92\t  failedPermanentMessageId?: string;\n93\t  // The straggler variant's turnId-null messages: one between two turns, one\n94\t  // after the last turn — absent unless stragglers are enabled.\n95\t  stragglerBetweenMessageId?: string;\n96\t  stragglerTrailingMessageId?: string;\n97\t}\n98\t\n99\texport interface DerivedThreadOptions {\n100\t  failures?: boolean; // default true: manufacture the two failed states\n101\t  stragglers?: boolean; // default false: insert the turnless runtime notes\n102\t}\n103\t\n104\tasync function send(\n105\t  sdk: Lhc,\n106\t  filePath: string,\n107\t  batch: readonly MessageEventInput[],\n108\t): Promise<string[]> {\n109\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n110\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n111\t  return result.value.events.map((entry) => entry.messageId ?? \"\");\n112\t}\n113\t\n114\tasync function drain(sdk: Lhc, filePath: string): Promise<void> {\n115\t  const report = await sdk.work.drain({ filePath });\n116\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n117\t  if (report.value.stoppedBecause !== \"empty\" || report.value.remaining !== 0) {\n118\t    throw new Error(\n119\t      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\n120\t    );"}]},"parent_tool_use_id":null,"session_id":"469f8650-6354-4ece-8aab-220bbaeb8a44","uuid":"d841ef93-8a9b-47d1-b613-7aaf02ec0e72","timestamp":"2026-06-12T21:47:13.237Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/view-thread.ts","content":"// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\n// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\n// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\n// deterministic provider double into known form states. States are reached\n// through production paths, never hand-written rows (the anti-shim line\n// FC-0.3 enforces): the failed states come from scripted provider failures\n// consumed by the real retry/exhaustion mechanics, and blocked comes from\n// real source damage on a sacrificial sibling thread. Every later Epic 03\n// story compacts against what this builder returns.\nimport {\n  createSdk,\n  type CompactReceipt,\n  type FormReportEntry,\n  type Lhc,\n  type MessageEventInput,\n  type MutationResult,\n} from \"../../src/index.js\";\nimport { corruptTwoOpenTurns } from \"./corrupt.js\";\nimport { createProviderDouble, type ProviderDouble } from \"./provider-double.js\";\nimport { readChunks, type ChunkSnapshot } from \"./threads.js\";\nimport { validEvent, type TempStore } from \"./index.js\";\n\n// Reason classes the scripted failures stamp, chosen from the sweep\n// classification table's vocabulary (tech design §Spec Validation): a\n// rate-limit class reads transient, a content-refusal class reads permanent —\n// FC-0.4's distinguishable-on-read-back guarantee, proven here before\n// Story 3 depends on it.\nexport const TRANSIENT_EXHAUST_REASON =\n  \"rate_limit: scripted transient exhaustion (fixture)\";\nexport const PERMANENT_FAILURE_REASON =\n  \"content_refusal: scripted permanent failure (fixture)\";\n\n// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\n// (3 members each; c1–c3 closed, c4 still open). Projections from the\n// deterministic double are near-constant in size (`projection(<digest>:<40\n// chars>)`), so the cut is stable; the builder asserts the shape and throws\n// if drift ever moves it.\nconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\n\nconst TURN_COUNT = 12;\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n\nfunction turnEvents(turn: number): MessageEventInput[] {\n  const events: MessageEventInput[] = [\n    validEvent(\"user_prompt\", {\n      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n    }),\n    validEvent(\"assistant_thinking\", {\n      payload: { text: `considering what area ${turn} contains` },\n    }),\n  ];\n  if (TOOL_HEAVY_TURNS.has(turn)) {\n    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\n    // realistic over-max zone of tool results to age behind the boundary.\n    for (const run of [1, 2]) {\n      const toolCallId = `call-fx-${turn}-${run}`;\n      events.push(\n        validEvent(\"tool_call\", {\n          payload: {\n            toolCallId,\n            toolName: \"read_file\",\n            arguments: { path: `area-${turn}/file-${run}.txt` },\n          },\n        }),\n        validEvent(\"tool_result\", {\n          payload: {\n            toolCallId,\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n            isError: false,\n          },\n        }),\n      );\n    }\n  }\n  events.push(\n    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n    validEvent(\"turn_end\"),\n  );\n  return events;\n}\n\nexport interface DerivedThreadFixture {\n  filePath: string;\n  sdk: Lhc;\n  double: ProviderDouble;\n  turnIds: string[]; // t1..t12\n  chunks: ChunkSnapshot;\n  // The two manufactured failed subjects (tool_result_summary forms), reached\n  // through real retry exhaustion / terminal failure — absent when failures\n  // are disabled for a variant.\n  failedTransientMessageId?: string;\n  failedPermanentMessageId?: string;\n  // The straggler variant's turnId-null messages: one between two turns, one\n  // after the last turn — absent unless stragglers are enabled.\n  stragglerBetweenMessageId?: string;\n  stragglerTrailingMessageId?: string;\n}\n\nexport interface DerivedThreadOptions {\n  failures?: boolean; // default true: manufacture the two failed states\n  stragglers?: boolean; // default false: insert the turnless runtime notes\n}\n\nasync function send(\n  sdk: Lhc,\n  filePath: string,\n  batch: readonly MessageEventInput[],\n): Promise<string[]> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n  return result.value.events.map((entry) => entry.messageId ?? \"\");\n}\n\nasync function drain(sdk: Lhc, filePath: string): Promise<void> {\n  const report = await sdk.work.drain({ filePath });\n  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n  if (report.value.stoppedBecause !== \"empty\" || report.value.remaining !== 0) {\n    throw new Error(\n      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\n    );","numLines":120,"startLine":1,"totalLines":432}}}

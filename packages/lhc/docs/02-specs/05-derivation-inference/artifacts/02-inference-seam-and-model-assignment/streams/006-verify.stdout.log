{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/inference-routing.test.ts'","aggregated_output":"     1\t// Epic 05 Story 2 — TC-1.2 (AC-1.2, AC-1.4): per-call routing through the\n     2\t// inference seam. A recording fake logs every call while a seeded thread\n     3\t// exercises all seven kinds; the assertions inspect the actual serialized\n     4\t// ModelCall input emitted during the drain — never a helper-level intention\n     5\t// (anti-shim). The routing assertions live in the parameterized\n     6\t// seam-conformance helpers so TC-4.3 runs them against the real host\n     7\t// unchanged (DD-13).\n     8\timport { afterEach, describe, expect, it } from \"vitest\";\n     9\timport {\n    10\t  assertModelCallContract,\n    11\t  assertRoutingThroughSdk,\n    12\t  cannedResponses,\n    13\t  FAKE_MODEL_PREFIX,\n    14\t  FAKE_PROVIDER_PREFIX,\n    15\t  FORM_KINDS,\n    16\t  probeInput,\n    17\t  recordingCall,\n    18\t  tempStore,\n    19\t  validAssignments,\n    20\t  type TempStore,\n    21\t} from \"./fixtures/index.js\";\n    22\t\n    23\tconst stores: TempStore[] = [];\n    24\tafterEach(() => {\n    25\t  for (const store of stores.splice(0)) store.cleanup();\n    26\t});\n    27\t\n    28\tfunction freshStore(): TempStore {\n    29\t  const store = tempStore();\n    30\t  stores.push(store);\n    31\t  return store;\n    32\t}\n    33\t\n    34\tdescribe(\"TC-1.2: per-kind provider/model routing (AC-1.4)\", () => {\n    35\t  it(\"a seeded drain exercises all seven kinds, each call carrying exactly its assigned strings\", async () => {\n    36\t    const responses = cannedResponses();\n    37\t    const { call, log } = recordingCall(responses);\n    38\t    const assignments = validAssignments();\n    39\t    const { forms } = await assertRoutingThroughSdk(call, assignments, freshStore());\n    40\t\n    41\t    for (const kind of FORM_KINDS) {\n    42\t      const lane = log.filter((input) => input.model === `${FAKE_MODEL_PREFIX}${kind}`);\n    43\t      expect(lane.length).toBeGreaterThan(0);\n    44\t      for (const input of lane) {\n    45\t        expect(input.provider).toBe(`${FAKE_PROVIDER_PREFIX}${kind}`);\n    46\t        expect(input.model).toBe(assignments[kind].model);\n    47\t      }\n    48\t      // The landed content is the canned text the kind's lane returned —\n    49\t      // routing proven end to end, not just at the call log.\n    50\t      const ready = forms.filter((form) => form.form === kind && form.state === \"ready\");\n    51\t      expect(ready.length).toBeGreaterThan(0);\n    52\t      for (const form of ready) {\n    53\t        expect(form.content).toBe(responses[kind]);\n    54\t      }\n    55\t    }\n    56\t  });\n    57\t\n    58\t  it(\"every logged messages value is single-turn shape: system and user roles, string content (AC-1.2)\", async () => {\n    59\t    const { call, log } = recordingCall(cannedResponses());\n    60\t    await assertRoutingThroughSdk(call, validAssignments(), freshStore());\n    61\t\n    62\t    expect(log.length).toBeGreaterThan(0);\n    63\t    for (const input of log) {\n    64\t      expect(input.messages.length).toBeGreaterThan(0);\n    65\t      expect(input.messages.some((message) => message.role === \"user\")).toBe(true);\n    66\t      for (const message of input.messages) {\n    67\t        expect([\"system\", \"user\"]).toContain(message.role);\n    68\t        expect(typeof message.content).toBe(\"string\");\n    69\t      }\n    70\t    }\n    71\t  });\n    72\t\n    73\t  it(\"a three-lane mixed config routes each call by item kind with no cross-kind bleed\", async () => {\n    74\t    const lanes = {\n    75\t      smoothed_prompt: \"lane-alpha\",\n    76\t      tool_call_summary: \"lane-alpha\",\n    77\t      tool_result_summary: \"lane-beta\",\n    78\t      turn_rendering: \"lane-beta\",\n    79\t      lower_band_projection: \"lane-beta\",\n    80\t      chunk_summary_detailed: \"lane-gamma\",\n    81\t      chunk_summary_brief: \"lane-gamma\",\n    82\t    } as const;\n    83\t    const assignments = validAssignments({\n    84\t      smoothed_prompt: { provider: lanes.smoothed_prompt },\n    85\t      tool_call_summary: { provider: lanes.tool_call_summary },\n    86\t      tool_result_summary: { provider: lanes.tool_result_summary },\n    87\t      turn_rendering: { provider: lanes.turn_rendering },\n    88\t      lower_band_projection: { provider: lanes.lower_band_projection },\n    89\t      chunk_summary_detailed: { provider: lanes.chunk_summary_detailed },\n    90\t      chunk_summary_brief: { provider: lanes.chunk_summary_brief },\n    91\t    });\n    92\t    const responses = cannedResponses();\n    93\t    const { call, log } = recordingCall(responses);\n    94\t    const { forms } = await assertRoutingThroughSdk(call, assignments, freshStore());\n    95\t\n    96\t    for (const kind of FORM_KINDS) {\n    97\t      // Models stay unique per kind, so the lane each item actually used is\n    98\t      // readable from the log: every call for this kind's model must carry\n    99\t      // this kind's lane provider — no bleed from the other lanes.\n   100\t      const calls = log.filter((input) => input.model === assignments[kind].model);\n   101\t      expect(calls.length).toBeGreaterThan(0);\n   102\t      for (const input of calls) {\n   103\t        expect(input.provider).toBe(lanes[kind]);\n   104\t      }\n   105\t      const ready = forms.filter((form) => form.form === kind && form.state === \"ready\");\n   106\t      expect(ready.length).toBeGreaterThan(0);\n   107\t      for (const form of ready) {\n   108\t        expect(form.content).toBe(responses[kind]);\n   109\t      }\n   110\t    }\n   111\t  });\n   112\t});\n   113\t\n   114\tdescribe(\"TC-1.2: fake-host fixture conformance (AC-1.2)\", () => {\n   115\t  it(\"assertModelCallContract holds against recordingCall\", async () => {\n   116\t    const { call } = recordingCall(cannedResponses());\n   117\t    await assertModelCallContract(\n   118\t      call,\n   119\t      probeInput({\n   120\t        provider: `${FAKE_PROVIDER_PREFIX}smoothed_prompt`,\n   121\t        model: `${FAKE_MODEL_PREFIX}smoothed_prompt`,\n   122\t      }),\n   123\t    );\n   124\t  });\n   125\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/inference-construction.test.ts'","aggregated_output":"     1\t// Epic 05 Story 2 — TC-1.1 (AC-1.1, AC-1.3): the construction matrix.\n     2\t// Construction is where every config mistake dies: provider XOR inference,\n     3\t// all seven kinds present (parameterized over the exported FORM_KINDS set so\n     4\t// a new kind fails the matrix automatically), no unknown kind keys, every\n     5\t// prompt name known, non-empty provider/model strings — each a TypeError\n     6\t// naming the violated rule, with no partial construction. A complete valid\n     7\t// config does not merely construct: a seeded drain lands a form ready.\n     8\timport { afterEach, describe, expect, it } from \"vitest\";\n     9\timport { createSdk, type ModelAssignment, type SdkConfig } from \"../src/index.js\";\n    10\timport {\n    11\t  cannedResponses,\n    12\t  createProviderDouble,\n    13\t  FORM_KINDS,\n    14\t  readDerivedForms,\n    15\t  recordingCall,\n    16\t  tempStore,\n    17\t  validAssignments,\n    18\t  validEvent,\n    19\t  type FormKind,\n    20\t  type TempStore,\n    21\t} from \"./fixtures/index.js\";\n    22\t\n    23\tconst stores: TempStore[] = [];\n    24\tafterEach(() => {\n    25\t  for (const store of stores.splice(0)) store.cleanup();\n    26\t});\n    27\t\n    28\tfunction freshStore(): TempStore {\n    29\t  const store = tempStore();\n    30\t  stores.push(store);\n    31\t  return store;\n    32\t}\n    33\t\n    34\tfunction buildSdk(assignments: unknown): () => unknown {\n    35\t  const { call } = recordingCall(cannedResponses());\n    36\t  return () =>\n    37\t    createSdk({\n    38\t      mode: \"manual\",\n    39\t      inference: { call, assignments },\n    40\t    } as unknown as SdkConfig);\n    41\t}\n    42\t\n    43\tdescribe(\"TC-1.1: provider XOR inference (AC-1.1)\", () => {\n    44\t  it(\"both provider and inference is a TypeError naming the XOR rule\", () => {\n    45\t    const { call } = recordingCall(cannedResponses());\n    46\t    const make = (): unknown =>\n    47\t      createSdk({\n    48\t        mode: \"manual\",\n    49\t        provider: createProviderDouble(),\n    50\t        inference: { call, assignments: validAssignments() },\n    51\t      });\n    52\t    expect(make).toThrow(TypeError);\n    53\t    expect(make).toThrow(/exactly one of provider or inference/);\n    54\t  });\n    55\t\n    56\t  it(\"neither provider nor inference is a TypeError naming the XOR rule\", () => {\n    57\t    const make = (): unknown => createSdk({ mode: \"manual\" } as unknown as SdkConfig);\n    58\t    expect(make).toThrow(TypeError);\n    59\t    expect(make).toThrow(/exactly one of provider or inference/);\n    60\t  });\n    61\t});\n    62\t\n    63\tdescribe(\"TC-1.1: assignment validation (AC-1.3)\", () => {\n    64\t  it.each([...FORM_KINDS])(\"missing kind %s is a TypeError naming the kind\", (kind) => {\n    65\t    const assignments: Partial<Record<FormKind, ModelAssignment>> = validAssignments();\n    66\t    delete assignments[kind];\n    67\t    const make = buildSdk(assignments);\n    68\t    expect(make).toThrow(TypeError);\n    69\t    expect(make).toThrow(new RegExp(`missing kind ${kind}`));\n    70\t  });\n    71\t\n    72\t  it(\"an unknown prompt name is a TypeError naming kind and prompt\", () => {\n    73\t    const assignments = validAssignments({\n    74\t      tool_result_summary: { prompt: \"tool-result-v99\" },\n    75\t    });\n    76\t    const make = buildSdk(assignments);\n    77\t    expect(make).toThrow(TypeError);\n    78\t    expect(make).toThrow(/tool_result_summary/);\n    79\t    expect(make).toThrow(/unknown template \"tool-result-v99\"/);\n    80\t  });\n    81\t\n    82\t  it(\"an unknown kind key in assignments is a TypeError naming it\", () => {\n    83\t    const assignments: Record<string, ModelAssignment> = { ...validAssignments() };\n    84\t    assignments[\"smoothed_promptz\"] = {\n    85\t      provider: \"prov-x\",\n    86\t      model: \"model-x\",\n    87\t      prompt: \"smoothing-v1\",\n    88\t    };\n    89\t    const make = buildSdk(assignments);\n    90\t    expect(make).toThrow(TypeError);\n    91\t    expect(make).toThrow(/unknown kind key \"smoothed_promptz\"/);\n    92\t  });\n    93\t\n    94\t  it(\"an empty provider string in one assignment is a TypeError naming field and kind\", () => {\n    95\t    const assignments = validAssignments({ turn_rendering: { provider: \"\" } });\n    96\t    const make = buildSdk(assignments);\n    97\t    expect(make).toThrow(TypeError);\n    98\t    expect(make).toThrow(/turn_rendering\\.provider must be a non-empty string/);\n    99\t  });\n   100\t\n   101\t  it(\"an empty model string in one assignment is a TypeError naming field and kind\", () => {\n   102\t    const assignments = validAssignments({ chunk_summary_brief: { model: \"  \" } });\n   103\t    const make = buildSdk(assignments);\n   104\t    expect(make).toThrow(TypeError);\n   105\t    expect(make).toThrow(/chunk_summary_brief\\.model must be a non-empty string/);\n   106\t  });\n   107\t});\n   108\t\n   109\tdescribe(\"TC-1.1: a complete valid config operates (AC-1.1, AC-1.3)\", () => {\n   110\t  it(\"constructs, and a seeded drain lands a form ready with the host's text\", async () => {\n   111\t    const store = freshStore();\n   112\t    const responses = cannedResponses();\n   113\t    const { call, log } = recordingCall(responses);\n   114\t    const sdk = createSdk({\n   115\t      mode: \"manual\",\n   116\t      inference: { call, assignments: validAssignments() },\n   117\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n   118\t    });\n   119\t\n   120\t    const filePath = store.threadPath();\n   121\t    const created = await sdk.threads.newThread({\n   122\t      filePath,\n   123\t      registryPath: store.registryPath,\n   124\t    });\n   125\t    expect(created.ok).toBe(true);\n   126\t    const batch = await sdk.intakeStream.messageEvents({ filePath }, [\n   127\t      validEvent(\"user_prompt\", { payload: { text: \"construct me a context\" } }),\n   128\t      validEvent(\"assistant_text\", { payload: { text: \"constructing\" } }),\n   129\t      validEvent(\"turn_end\"),\n   130\t    ]);\n   131\t    expect(batch.ok).toBe(true);\n   132\t\n   133\t    const drained = await sdk.work.drain({ filePath });\n   134\t    expect(drained.ok).toBe(true);\n   135\t    if (drained.ok) {\n   136\t      expect(drained.value.stoppedBecause).toBe(\"empty\");\n   137\t      expect(drained.value.remaining).toBe(0);\n   138\t    }\n   139\t\n   140\t    const smoothed = readDerivedForms(filePath).find(\n   141\t      (form) => form.form === \"smoothed_prompt\" && form.subjectId === \"m1\",\n   142\t    );\n   143\t    expect(smoothed?.state).toBe(\"ready\");\n   144\t    expect(smoothed?.content).toBe(responses.smoothed_prompt);\n   145\t    expect(log.length).toBeGreaterThan(0);\n   146\t  });\n   147\t});\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/inference/types.ts'","aggregated_output":"     1\t// Epic 05 boundary vocabulary (tech design §Interface Definitions): the one\n     2\t// function a host supplies, its structured result shapes, and the config that\n     3\t// arrives at createSdk as the alternative to direct provider injection\n     4\t// (DD-1, DD-5). LHC treats provider/model strings as opaque routing keys —\n     5\t// the host's ModelCall implementation is the only code that interprets them.\n     6\timport type { FormKind } from \"../shared/derivation.js\";\n     7\t\n     8\t/** The one function a host supplies. Single-turn completion; provider/model\n     9\t *  are opaque routing keys the host's implementation interprets. (AC-1.2) */\n    10\texport type ModelCall = (input: ModelCallInput) => Promise<ModelCallResult>;\n    11\t\n    12\texport interface ModelCallInput {\n    13\t  provider: string;\n    14\t  model: string;\n    15\t  messages: { role: \"system\" | \"user\"; content: string }[];\n    16\t}\n    17\t\n    18\texport type ModelCallResult =\n    19\t  | { ok: true; text: string }\n    20\t  | { ok: false; kind: ModelCallFailureKind; message: string };\n    21\t\n    22\t/** `empty_output` is adapter-generated (AC-2.4); hosts never return it.\n    23\t *  Thrown exceptions classify as `other` (AC-3.3). */\n    24\texport type ModelCallFailureKind =\n    25\t  | \"rate_limit\"\n    26\t  | \"timeout\"\n    27\t  | \"network\"\n    28\t  | \"empty_output\"\n    29\t  | \"other\"\n    30\t  | \"auth\"\n    31\t  | \"invalid_request\";\n    32\t\n    33\texport interface ModelAssignment {\n    34\t  provider: string;\n    35\t  model: string;\n    36\t  prompt: string; // must name a PROMPT_REGISTRY entry (AC-1.3)\n    37\t}\n    38\t\n    39\t/** SdkConfig.inference — the alternative to SdkConfig.provider (DD-5). */\n    40\texport interface InferenceConfig {\n    41\t  call: ModelCall;\n    42\t  assignments: Record<FormKind, ModelAssignment>; // all seven, validated complete\n    43\t  timeoutMs?: number; // default 60_000 (DD-6)\n    44\t  maxInputChars?: number; // default 200_000 (DD-7)\n    45\t}\n    46\t\n    47\t/** InferenceConfig after createSdk validation: every optional filled. */\n    48\texport interface ResolvedInferenceConfig {\n    49\t  call: ModelCall;\n    50\t  assignments: Record<FormKind, ModelAssignment>;\n    51\t  timeoutMs: number;\n    52\t  maxInputChars: number;\n    53\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/inference/adapter.ts'","aggregated_output":"     1\t// The real provider (DD-2): createInferenceProvider returns the same\n     2\t// DerivationProvider interface the deterministic provider implements, so\n     3\t// createSdk and everything below it see a provider, full stop. Each operation\n     4\t// is one closure lookup at call time — the kind's assignment names the\n     5\t// provider/model routing keys and the prompt template; the host's ModelCall\n     6\t// is the only code that crosses the transport boundary (AC-1.2, AC-1.4).\n     7\t// Output shaping (empty-output rejection, input bounding) and the safeCall\n     8\t// timeout land with the adapter/classification stories; routing and result\n     9\t// mapping are complete here.\n    10\timport type {\n    11\t  DerivationProvider,\n    12\t  FormKind,\n    13\t  ProviderResult,\n    14\t} from \"../shared/derivation.js\";\n    15\timport { FAILURE_CLASSIFICATION } from \"./classify.js\";\n    16\timport { PROMPT_REGISTRY, type PromptTemplate } from \"./prompts/index.js\";\n    17\timport type { ModelCallResult, ResolvedInferenceConfig } from \"./types.js\";\n    18\t\n    19\texport function createInferenceProvider(config: ResolvedInferenceConfig): DerivationProvider {\n    20\t  const callKind = async (kind: FormKind, input: unknown): Promise<ProviderResult> => {\n    21\t    const assignment = config.assignments[kind];\n    22\t    // Construction validated the name (AC-1.3); a miss here is registry\n    23\t    // drift after construction and is terminal, never retried into.\n    24\t    const template = PROMPT_REGISTRY[assignment.prompt] as PromptTemplate<unknown> | undefined;\n    25\t    if (template === undefined) {\n    26\t      return {\n    27\t        ok: false,\n    28\t        retryable: false,\n    29\t        reason: `invalid_request: prompt template \"${assignment.prompt}\" not in registry`,\n    30\t      };\n    31\t    }\n    32\t    const messages = template.render(input);\n    33\t    let result: ModelCallResult;\n    34\t    try {\n    35\t      result = await config.call({\n    36\t        provider: assignment.provider,\n    37\t        model: assignment.model,\n    38\t        messages,\n    39\t      });\n    40\t    } catch (cause) {\n    41\t      // Thrown host exceptions classify as `other` (AC-3.3); the structured\n    42\t      // safeCall wrapper (timeout race, DD-6) supersedes this containment in\n    43\t      // the classification story.\n    44\t      result = { ok: false, kind: \"other\", message: String(cause) };\n    45\t    }\n    46\t    if (!result.ok) {\n    47\t      return {\n    48\t        ok: false,\n    49\t        retryable: FAILURE_CLASSIFICATION[result.kind].retryable,\n    50\t        // The kind string leads the reason — stable and machine-readable\n    51\t        // (DD-3) — with the host's message carried for the audit trail.\n    52\t        reason: result.message === \"\" ? result.kind : `${result.kind}: ${result.message}`,\n    53\t      };\n    54\t    }\n    55\t    // Provenance is the assignment's three config-known strings, copied —\n    56\t    // never authored from model output (DD-4).\n    57\t    return {\n    58\t      ok: true,\n    59\t      text: result.text,\n    60\t      provenance: {\n    61\t        provider: assignment.provider,\n    62\t        model: assignment.model,\n    63\t        prompt: assignment.prompt,\n    64\t      },\n    65\t    };\n    66\t  };\n    67\t\n    68\t  return {\n    69\t    smoothPrompt: (i) => callKind(\"smoothed_prompt\", i),\n    70\t    summarizeToolCall: (i) => callKind(\"tool_call_summary\", i),\n    71\t    summarizeToolResult: (i) => callKind(\"tool_result_summary\", i),\n    72\t    composeTurnRendering: (i) => callKind(\"turn_rendering\", i),\n    73\t    projectLowerBand: (i) => callKind(\"lower_band_projection\", i),\n    74\t    summarizeChunkDetailed: (i) => callKind(\"chunk_summary_detailed\", i),\n    75\t    summarizeChunkBrief: (i) => callKind(\"chunk_summary_brief\", i),\n    76\t  };\n    77\t}\n","exit_code":0,"status":"completed"}}

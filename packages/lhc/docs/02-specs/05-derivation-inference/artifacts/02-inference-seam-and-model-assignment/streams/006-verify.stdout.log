dFileInfo, ThreadRef } from \"./domains/threads/index.js\";\n   165\texport type {\n   166\t  Block,\n   167\t  BlockType,\n   168\t  MessageDetail,\n   169\t  MessageListOptions,\n   170\t  MessageRecord,\n   171\t  MutationResult,\n   172\t} from \"./domains/messages/index.js\";\n   173\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n   174\texport type {\n   175\t  BatchResult,\n   176\t  EventKind,\n   177\t  EventRecord,\n   178\t  MessageEventInput,\n   179\t} from \"./domains/intake-stream/index.js\";\n   180\t\n   181\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n   182\t\n   183\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n   184\t\n   185\t// Merge per-domain handler tables into the one join between the queue's\n   186\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n   187\t// (each kind has exactly one owner) and throws at construction.\n   188\texport function assembleWorkHandlerMap(\n   189\t  tables: ReadonlyArray<WorkHandlerMap>,\n   190\t): WorkHandlerMap {\n   191\t  const map: WorkHandlerMap = {};\n   192\t  for (const table of tables) {\n   193\t    for (const [kind, handler] of Object.entries(table)) {\n   194\t      if (map[kind as WorkKind] !== undefined) {\n   195\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n   196\t      }\n   197\t      map[kind as WorkKind] = handler;\n   198\t    }\n   199\t  }\n   200\t  return map;\n   201\t}\n   202\t\n   203\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n   204\t  return {\n   205\t    ok: false,\n   206\t    error: {\n   207\t      errorClass: \"state_corruption\",\n   208\t      code: \"unknown_work_kind\",\n   209\t      reason: `no handler registered for work kind \"${kind}\"`,\n   210\t    },\n   211\t  };\n   212\t}\n   213\t\n   214\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n   215\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n   216\texport function lookupWorkHandler(\n   217\t  map: WorkHandlerMap,\n   218\t  kind: string,\n   219\t): OpResult<WorkHandler> {\n   220\t  const handler = map[kind as WorkKind];\n   221\t  if (handler === undefined) return unknownWorkKind(kind);\n   222\t  return { ok: true, value: handler };\n   223\t}\n   224\t\n   225\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n   226\t// requeue land in Story 4.\n   227\texport interface WorkSurface {\n   228\t  drain(\n   229\t    ref: threadsDomain.ThreadRef,\n   230\t    opts?: { maxItems?: number },\n   231\t  ): Promise<OpResult<DrainReport>>;\n   232\t}\n   233\t\n   234\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n   235\t// §Interface Definitions): the operations only — the Story 0 config\n   236\t// substrate the domain index also carries is construction machinery, not an\n   237\t// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\n   238\t// inspect domain composes (DD-1).\n   239\texport interface ThreadViewSurface {\n   240\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n   241\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n   242\t  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\n   243\t  compact(\n   244\t    ref: threadsDomain.ThreadRef,\n   245\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n   246\t  ): Promise<OpResult<CompactReceipt>>;\n   247\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n   248\t  materialize(\n   249\t    ref: threadsDomain.ThreadRef,\n   250\t    opts: { path: string; format?: \"pi-session\" },\n   251\t  ): Promise<OpResult<{ writtenPath: string }>>;\n   252\t}\n   253\t\n   254\texport interface Lhc {\n   255\t  threads: typeof threadsDomain;\n   256\t  intakeStream: typeof intakeStreamDomain;\n   257\t  messages: typeof messagesDomain;\n   258\t  turns: typeof turnsDomain;\n   259\t  threadView: ThreadViewSurface;\n   260\t  // Epic 04: the read-only report surface. Scoped through the instance seam\n   261\t  // like every other namespace so the status read it composes resolves THIS\n   262\t  // SDK's view config (threshold, visibility budgets).\n   263\t  inspect: typeof inspectDomain;\n   264\t  config: ResolvedSdkConfig;\n   265\t  scheduler: Scheduler;\n   266\t  workHandlers: WorkHandlerMap;\n   267\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n   268\t  work: WorkSurface;\n   269\t  // Resolves when the scheduler has no running or pending drain for the\n   270\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n   271\t  // resolve in manual mode.\n   272\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n   273\t}\n   274\t\n   275\tfunction requirePositive(value: number, name: string): void {\n   276\t  if (!Number.isFinite(value) || value <= 0) {\n   277\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n   278\t  }\n   279\t}\n   280\t\n   281\tfunction requireNonNegative(value: number, name: string): void {\n   282\t  if (!Number.isFinite(value) || value < 0) {\n   283\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n   284\t  }\n   285\t}\n   286\t\n   287\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n   288\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n   289\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n   290\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n   291\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n   292\t// object is the same shape as the namespace, so the public surface type holds.\n   293\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n   294\t  const scoped: Record<string, unknown> = {};\n   295\t  for (const key of Object.keys(surface)) {\n   296\t    const value = (surface as Record<string, unknown>)[key];\n   297\t    scoped[key] =\n   298\t      typeof value === \"function\"\n   299\t        ? (...args: unknown[]): unknown =>\n   300\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n   301\t        : value;\n   302\t  }\n   303\t  return scoped as T;\n   304\t}\n   305\t\n   306\t// Resolve the `inference` construction path (Epic 05 Flow 1, DD-5): validate\n   307\t// the host function and the complete assignment map loudly — all seven kinds\n   308\t// present (iterating the exported FORM_KINDS set, never a second literal\n   309\t// list), no unknown kind keys, every prompt name in the registry, non-empty\n   310\t// provider/model routing keys — then build the adapter into the same\n   311\t// DerivationProvider slot direct injection uses. No partial construction:\n   312\t// every mistake throws before anything is assembled (AC-1.1, AC-1.3).\n   313\tfunction resolveInferenceProvider(inference: InferenceConfig): DerivationProvider {\n   314\t  if (typeof inference.call !== \"function\") {\n   315\t    throw new TypeError(\"createSdk config: inference.call must be a function\");\n   316\t  }\n   317\t  const assignments = inference.assignments as unknown;\n   318\t  if (assignments === null || typeof assignments !== \"object\") {\n   319\t    throw new TypeError(\"createSdk config: inference.assignments must be an object\");\n   320\t  }\n   321\t  const knownKinds = new Set<string>(FORM_KINDS);\n   322\t  for (const key of Object.keys(assignments)) {\n   323\t    if (!knownKinds.has(key)) {\n   324\t      throw new TypeError(\n   325\t        `createSdk config: inference.assignments has unknown kind key \"${key}\"`,\n   326\t      );\n   327\t    }\n   328\t  }\n   329\t  const map = assignments as Partial<Record<FormKind, ModelAssignment>>;\n   330\t  for (const kind of FORM_KINDS) {\n   331\t    const assignment = map[kind];\n   332\t    if (assignment === undefined || assignment === null || typeof assignment !== \"object\") {\n   333\t      throw new TypeError(`createSdk config: inference.assignments missing kind ${kind}`);\n   334\t    }\n   335\t    for (const field of [\"provider\", \"model\"] as const) {\n   336\t      const value = assignment[field];\n   337\t      if (typeof value !== \"string\" || value.trim() === \"\") {\n   338\t        throw new TypeError(\n   339\t          `createSdk config: inference.assignments.${kind}.${field} must be a non-empty string`,\n   340\t        );\n   341\t      }\n   342\t    }\n   343\t    if (typeof assignment.prompt !== \"string\" || PROMPT_REGISTRY[assignment.prompt] === undefined) {\n   344\t      throw new TypeError(\n   345\t        `createSdk config: inference.assignments.${kind}.prompt names unknown template \"${String(assignment.prompt)}\"`,\n   346\t      );\n   347\t    }\n   348\t  }\n   349\t  const timeoutMs = inference.timeoutMs ?? 60_000;\n   350\t  const maxInputChars = inference.maxInputChars ?? 200_000;\n   351\t  requirePositive(timeoutMs, \"inference.timeoutMs\");\n   352\t  requirePositive(maxInputChars, \"inference.maxInputChars\");\n   353\t  return createInferenceProvider({\n   354\t    call: inference.call,\n   355\t    assignments: map as Record<FormKind, ModelAssignment>,\n   356\t    timeoutMs,\n   357\t    maxInputChars,\n   358\t  });\n   359\t}\n   360\t\n   361\t// The only assembly path: provider, mode, clock, and policy enter here.\n   362\t// Config mistakes are programmer errors at construction and throw; operating\n   363\t// failures after construction return OpResults per the error contract.\n   364\texport function createSdk(config: SdkConfig): Lhc {\n   365\t  // Provider arrival is exactly one of direct injection or the inference\n   366\t  // config (Epic 05 DD-5); there is no named-provider registry and no\n   367\t  // env/flag resolution path to fall back on. The XOR rule is validated\n   368\t  // before anything downstream so the error names the caller's mistake, not\n   369\t  // a symptom (AC-1.1).\n   370\t  if (config.provider !== undefined && config.inference !== undefined) {\n   371\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n   372\t  }\n   373\t  if (config.provider === undefined && config.inference === undefined) {\n   374\t    throw new TypeError(\"createSdk config: exactly one of provider or inference\");\n   375\t  }\n   376\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   377\t    throw new TypeError(\n   378\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   379\t    );\n   380\t  }\n   381\t  let provider: DerivationProvider;\n   382\t  if (config.inference !== undefined) {\n   383\t    provider = resolveInferenceProvider(config.inference);\n   384\t  } else {\n   385\t    if (config.provider === null || typeof config.provider !== \"object\") {\n   386\t      throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   387\t    }\n   388\t    for (const operation of PROVIDER_OPERATIONS) {\n   389\t      if (typeof config.provider[operation] !== \"function\") {\n   390\t        throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   391\t      }\n   392\t    }\n   393\t    provider = config.provider;\n   394\t  }\n   395\t\n   396\t  const resolved: ResolvedSdkConfig = {\n   397\t    provider,\n   398\t    mode: config.mode,\n   399\t    clock: config.clock ?? (() => new Date()),\n   400\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   401\t    lease: config.lease ?? { durationMs: 120000 },\n   402\t    chunkPolicy:\n   403\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n   404\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n   405\t    // sums and visibility budgets validated — throws naming the violation.\n   406\t    view: resolveViewConfig(config.view),\n   407\t  };\n   408\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n   409\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n   410\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n   411\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n   412\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n   413\t  }\n   414\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n   415\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n   416\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n   417\t    throw new TypeError(\n   418\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n   419\t    );\n   420\t  }\n   421\t\n   422\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n   423\t  // The tables are empty until Stories 2–3 land the real handlers; the\n   424\t  // assembly mechanics are production code from day one.\n   425\t  const workHandlers = assembleWorkHandlerMap([\n   426\t    messagesDomain.workHandlers,\n   427\t    turnsDomain.workHandlers,\n   428\t  ]);\n   429\t\n   430\t  const drainDeps: DrainDeps = {\n   431\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   432\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n   433\t    config: resolved,\n   434\t  };\n   435\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n   436\t\n   437\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n   438\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n   439\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n   440\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n   441\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n   442\t  // the construction order, because its operations deliver to the no-op seam,\n   443\t  // not to whatever a background SDK installed below.\n   444\t  // The seam also carries this instance's resolved view config (Epic 03,\n   445\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n   446\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n   447\t  // fall back to the built-in defaults inside the thread-view surface.\n   448\t  const seam: InstanceSeam =\n   449\t    resolved.mode === \"background\"\n   450\t      ? {\n   451\t          poke: (threadId) => scheduler.poke(threadId),\n   452\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n   453\t          view: resolved.view,\n   454\t        }\n   455\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\n   456\t\n   457\t  // Background mode also installs the below-SDK default seam so a direct\n   458\t  // domain call made with no SDK scope — a top-level mutation in the\n   459\t  // single-background \"production path\" — still reaches the one installed\n   460\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n   461\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n   462\t  // leaves the default alone (pokes stay no-ops by contract).\n   463\t  if (resolved.mode === \"background\") {\n   464\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n   465\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n   466\t  }\n   467\t\n   468\t  const work: WorkSurface = {\n   469\t    drain: (ref, opts) =>\n   470\t      runWithInstanceSeam(seam, async () => {\n   471\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   472\t        if (!resolvedRef.ok) return resolvedRef;\n   473\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n   474\t      }),\n   475\t  };\n   476\t\n   477\t  return {\n   478\t    threads: threadsDomain,\n   479\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n   480\t    messages: scopeSurface(messagesDomain, seam),\n   481\t    turns: scopeSurface(turnsDomain, seam),\n   482\t    threadView: scopeSurface<ThreadViewSurface>(\n   483\t      {\n   484\t        pull: threadViewDomain.pull,\n   485\t        status: threadViewDomain.status,\n   486\t        describe: threadViewDomain.describe,\n   487\t        compact: threadViewDomain.compact,\n   488\t        sweep: threadViewDomain.sweep,\n   489\t        materialize: threadViewDomain.materialize,\n   490\t      },\n   491\t      seam,\n   492\t    ),\n   493\t    inspect: scopeSurface(inspectDomain, seam),\n   494\t    config: resolved,\n   495\t    scheduler,\n   496\t    workHandlers,\n   497\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   498\t    work,\n   499\t    drainSettled: async (ref) => {\n   500\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/fixtures/model-call.ts'","aggregated_output":"     1\t// The scripted-host builders (Epic 05 test plan §Fixture Contracts): fake\n     2\t// ModelCall implementations every Flow 1–3 test uses. These are boundary\n     3\t// doubles, not internal mocks — the ModelCall function is where LHC's code\n     4\t// ends (tech design §Testing Strategy). All builders return\n     5\t// contract-conformant shapes (AC-1.2); seam-conformance.ts asserts that of\n     6\t// recordingCall in its own test so fixture drift is caught by the suite.\n     7\timport { FORM_KINDS, type FormKind } from \"../../src/shared/derivation.js\";\n     8\timport { DEFAULT_PROMPT_NAMES } from \"../../src/inference/prompts/index.js\";\n     9\timport type {\n    10\t  ModelAssignment,\n    11\t  ModelCall,\n    12\t  ModelCallInput,\n    13\t  ModelCallResult,\n    14\t} from \"../../src/inference/types.js\";\n    15\t\n    16\texport { FORM_KINDS, type FormKind };\n    17\t\n    18\t// validAssignments gives every kind a distinct fake provider/model lane;\n    19\t// recordingCall infers the kind back from the model string, so per-kind\n    20\t// routing is observable from the log alone (TC-1.2).\n    21\texport const FAKE_PROVIDER_PREFIX = \"prov-\";\n    22\texport const FAKE_MODEL_PREFIX = \"model-\";\n    23\t\n    24\texport function validAssignments(\n    25\t  overrides: Partial<Record<FormKind, Partial<ModelAssignment>>> = {},\n    26\t): Record<FormKind, ModelAssignment> {\n    27\t  const map = {} as Record<FormKind, ModelAssignment>;\n    28\t  for (const kind of FORM_KINDS) {\n    29\t    map[kind] = {\n    30\t      provider: `${FAKE_PROVIDER_PREFIX}${kind}`,\n    31\t      model: `${FAKE_MODEL_PREFIX}${kind}`,\n    32\t      prompt: DEFAULT_PROMPT_NAMES[kind],\n    33\t      ...(overrides[kind] ?? {}),\n    34\t    };\n    35\t  }\n    36\t  return map;\n    37\t}\n    38\t\n    39\t// One distinct canned sentence per kind, so cross-kind bleed is visible in\n    40\t// landed form content, never just in call counts.\n    41\texport function cannedResponses(): Record<FormKind, string> {\n    42\t  const map = {} as Record<FormKind, string>;\n    43\t  for (const kind of FORM_KINDS) {\n    44\t    map[kind] = `canned ${kind} text from the fake host`;\n    45\t  }\n    46\t  return map;\n    47\t}\n    48\t\n    49\t// Resolves each call with its kind's canned text — the kind inferred from\n    50\t// the model routing key validAssignments made unique per kind. Every input\n    51\t// is cloned into `log` in call order. An unknown model is a test bug and\n    52\t// throws loudly.\n    53\texport function recordingCall(responses: Record<FormKind, string>): {\n    54\t  call: ModelCall;\n    55\t  log: ModelCallInput[];\n    56\t} {\n    57\t  const log: ModelCallInput[] = [];\n    58\t  const known = new Set<string>(FORM_KINDS);\n    59\t  const call: ModelCall = (input) => {\n    60\t    log.push(structuredClone(input));\n    61\t    const kind = input.model.startsWith(FAKE_MODEL_PREFIX)\n    62\t      ? input.model.slice(FAKE_MODEL_PREFIX.length)\n    63\t      : input.model;\n    64\t    if (!known.has(kind)) {\n    65\t      throw new Error(`recordingCall: no canned response for model \"${input.model}\"`);\n    66\t    }\n    67\t    return Promise.resolve({ ok: true, text: responses[kind as FormKind] });\n    68\t  };\n    69\t  return { call, log };\n    70\t}\n    71\t\n    72\t// Returns script entries in order; a call past the end of the script is a\n    73\t// test bug and throws loudly.\n    74\texport function scriptedCall(script: ModelCallResult[]): ModelCall {\n    75\t  let next = 0;\n    76\t  return (input) => {\n    77\t    const entry = script[next];\n    78\t    next += 1;\n    79\t    if (entry === undefined) {\n    80\t      throw new Error(\n    81\t        `scriptedCall: script exhausted after ${String(script.length)} calls (model \"${input.model}\")`,\n    82\t      );\n    83\t    }\n    84\t    return Promise.resolve(entry);\n    85\t  };\n    86\t}\n    87\t\n    88\t// A host whose function throws — the AC-3.3 containment leg.\n    89\texport function throwingCall(error: Error): ModelCall {\n    90\t  return () => Promise.reject(error);\n    91\t}\n    92\t\n    93\t// A host that never settles — the DD-6 timeout leg (tests pass a small\n    94\t// timeoutMs).\n    95\texport function hangingCall(): ModelCall {\n    96\t  return () => new Promise<ModelCallResult>(() => {});\n    97\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/fixtures/seam-conformance.ts'","aggregated_output":"     1\t// Parameterized seam-contract assertions (Epic 05 DD-13): the same helpers\n     2\t// run against the scripted fakes (TC-1.2) and, unchanged, against the real\n     3\t// OpenRouter host (TC-4.3) — shared assertion code, never duplicated tests.\n     4\t// Framework-agnostic on purpose: plain node:assert throws surface in vitest\n     5\t// and in any future runner identically.\n     6\timport assert from \"node:assert/strict\";\n     7\timport { createSdk, type DerivedForm, type Lhc } from \"../../src/index.js\";\n     8\timport { FORM_KINDS, type FormKind } from \"../../src/shared/derivation.js\";\n     9\timport type {\n    10\t  ModelAssignment,\n    11\t  ModelCall,\n    12\t  ModelCallInput,\n    13\t} from \"../../src/inference/types.js\";\n    14\timport { readDerivedForms } from \"./threads.js\";\n    15\timport { validEvent, type TempStore } from \"./index.js\";\n    16\t\n    17\tconst FAILURE_KINDS = new Set([\n    18\t  \"rate_limit\",\n    19\t  \"timeout\",\n    20\t  \"network\",\n    21\t  \"empty_output\",\n    22\t  \"other\",\n    23\t  \"auth\",\n    24\t  \"invalid_request\",\n    25\t]);\n    26\t\n    27\texport function probeInput(overrides: Partial<ModelCallInput> = {}): ModelCallInput {\n    28\t  return {\n    29\t    provider: \"probe-provider\",\n    30\t    model: \"probe-model\",\n    31\t    messages: [\n    32\t      { role: \"system\", content: \"You answer with one word.\" },\n    33\t      { role: \"user\", content: \"Say ok.\" },\n    34\t    ],\n    35\t    ...overrides,\n    36\t  };\n    37\t}\n    38\t\n    39\t// AC-1.2's result contract on one probe call: a ModelCall resolves to either\n    40\t// `{ ok: true, text }` or `{ ok: false, kind, message }` with `kind` from the\n    41\t// failure vocabulary. Catches fixture (and real-host) drift from the\n    42\t// boundary contract.\n    43\texport async function assertModelCallContract(\n    44\t  call: ModelCall,\n    45\t  probe: ModelCallInput = probeInput(),\n    46\t): Promise<void> {\n    47\t  const result = await call(probe);\n    48\t  assert.ok(\n    49\t    typeof result === \"object\" && result !== null,\n    50\t    \"ModelCall must resolve to a result object\",\n    51\t  );\n    52\t  if (result.ok === true) {\n    53\t    assert.equal(typeof result.text, \"string\", \"success result must carry string text\");\n    54\t  } else if (result.ok === false) {\n    55\t    assert.ok(\n    56\t      FAILURE_KINDS.has(result.kind),\n    57\t      `failure kind \"${String(result.kind)}\" is not in the failure vocabulary`,\n    58\t    );\n    59\t    assert.equal(typeof result.message, \"string\", \"failure result must carry a string message\");\n    60\t  } else {\n    61\t    assert.fail(\"ModelCall result must discriminate on a boolean ok\");\n    62\t  }\n    63\t}\n    64\t\n    65\texport interface RoutingRunResult {\n    66\t  sdk: Lhc;\n    67\t  filePath: string;\n    68\t  forms: DerivedForm[];\n    69\t  log: ModelCallInput[];\n    70\t}\n    71\t\n    72\tasync function seedAllSevenKinds(sdk: Lhc, store: TempStore): Promise<string> {\n    73\t  const filePath = store.threadPath();\n    74\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n    75\t  assert.ok(created.ok, \"conformance fixture: thread creation failed\");\n    76\t  // Turn 1 carries a tool run (smoothing, tool-call/result summaries,\n    77\t  // rendering, projection); turn 2 exists so turn 1's chunk closes under the\n    78\t  // tiny target policy and the two chunk summaries enqueue.\n    79\t  const result = await sdk.intakeStream.messageEvents({ filePath }, [\n    80\t    validEvent(\"user_prompt\", { payload: { text: \"please inspect the fixture file\" } }),\n    81\t    validEvent(\"tool_call\", {\n    82\t      payload: {\n    83\t        toolCallId: \"call-seam-1\",\n    84\t        toolName: \"read_file\",\n    85\t        arguments: { path: \"fixture.txt\" },\n    86\t      },\n    87\t    }),\n    88\t    validEvent(\"tool_result\", {\n    89\t      payload: { toolCallId: \"call-seam-1\", content: \"contents of fixture.txt\", isError: false },\n    90\t    }),\n    91\t    validEvent(\"assistant_text\", { payload: { text: \"the fixture file holds fixture text\" } }),\n    92\t    validEvent(\"turn_end\"),\n    93\t    validEvent(\"user_prompt\", { payload: { text: \"thanks, now summarize it\" } }),\n    94\t    validEvent(\"assistant_text\", { payload: { text: \"summarized\" } }),\n    95\t    validEvent(\"turn_end\"),\n    96\t  ]);\n    97\t  assert.ok(result.ok, \"conformance fixture: intake batch failed\");\n    98\t  return filePath;\n    99\t}\n   100\t\n   101\t// TC-1.2's routing assertions, extracted so TC-4.3 runs them against the\n   102\t// real host unchanged: construct an SDK on the inference path, drive all\n   103\t// seven kinds through a real intake → drain, and assert (1) every kind lands\n   104\t// ready, (2) every call that crossed the boundary carried exactly one\n   105\t// kind's assigned provider/model routing keys, (3) each kind's lane was\n   106\t// exercised, and (4) every messages value is single-turn shape — system and\n   107\t// user roles only, string content (AC-1.2, AC-1.4).\n   108\texport async function assertRoutingThroughSdk(\n   109\t  call: ModelCall,\n   110\t  assignments: Record<FormKind, ModelAssignment>,\n   111\t  store: TempStore,\n   112\t): Promise<RoutingRunResult> {\n   113\t  const log: ModelCallInput[] = [];\n   114\t  const logged: ModelCall = (input) => {\n   115\t    log.push(structuredClone(input));\n   116\t    return call(input);\n   117\t  };\n   118\t  const sdk = createSdk({\n   119\t    inference: { call: logged, assignments },\n   120\t    mode: \"manual\",\n   121\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n   122\t    // Tiny target: each placed turn crosses it, so the prior turn's chunk\n   123\t    // closes during the drain and the chunk-summary kinds run too.\n   124\t    chunkPolicy: { targetProjectedTokens: 5, maxProjectedTokens: 4400 },\n   125\t  });\n   126\t  const filePath = await seedAllSevenKinds(sdk, store);\n   127\t\n   128\t  const drained = await sdk.work.drain({ filePath });\n   129\t  assert.ok(drained.ok, \"conformance drain failed\");\n   130\t  assert.equal(drained.value.stoppedBecause, \"empty\", \"conformance drain left work behind\");\n   131\t  assert.equal(drained.value.remaining, 0, \"conformance drain left items remaining\");\n   132\t\n   133\t  const forms = readDerivedForms(filePath);\n   134\t  for (const kind of FORM_KINDS) {\n   135\t    assert.ok(\n   136\t      forms.some((form) => form.form === kind && form.state === \"ready\"),\n   137\t      `expected at least one ready ${kind} form after the drain`,\n   138\t    );\n   139\t  }\n   140\t\n   141\t  assert.ok(log.length > 0, \"no calls crossed the ModelCall boundary\");\n   142\t  for (const input of log) {\n   143\t    const matched = FORM_KINDS.filter(\n   144\t      (kind) =>\n   145\t        assignments[kind].provider === input.provider && assignments[kind].model === input.model,\n   146\t    );\n   147\t    assert.ok(\n   148\t      matched.length > 0,\n   149\t      `call carried provider/model \"${input.provider}\"/\"${input.model}\" matching no kind's assignment`,\n   150\t    );\n   151\t    assert.ok(input.messages.length > 0, \"a call crossed the boundary with no messages\");\n   152\t    assert.ok(\n   153\t      input.messages.some((message) => message.role === \"user\"),\n   154\t      \"single-turn shape requires a user message\",\n   155\t    );\n   156\t    for (const message of input.messages) {\n   157\t      assert.ok(\n   158\t        message.role === \"system\" || message.role === \"user\",\n   159\t        `message role \"${String(message.role)}\" is outside the single-turn vocabulary`,\n   160\t      );\n   161\t      assert.equal(typeof message.content, \"string\", \"message content must be a string\");\n   162\t    }\n   163\t  }\n   164\t  for (const kind of FORM_KINDS) {\n   165\t    assert.ok(\n   166\t      log.some(\n   167\t        (input) =>\n   168\t          input.provider === assignments[kind].provider && input.model === assignments[kind].model,\n   169\t      ),\n   170\t      `no boundary call carried ${kind}'s assigned provider/model lane`,\n   171\t    );\n   172\t  }\n   173\t  return { sdk, filePath, forms, log };\n   174\t}\n","exit_code":0,"status":"completed"}}

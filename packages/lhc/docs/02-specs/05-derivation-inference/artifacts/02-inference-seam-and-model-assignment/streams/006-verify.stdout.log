{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/inference/classify.ts'","aggregated_output":"     1\t// Failure classification (DD-3): a pure table from the boundary's failure\n     2\t// vocabulary onto Epic 02's retryable-or-not. The queue machinery consumes\n     3\t// `retryable` exactly as it always has — no queue changes, no new states.\n     4\t// `safeCall` (timeout race + thrown-exception containment, DD-6/AC-3.3)\n     5\t// lands with the classification story; the adapter's inline containment is\n     6\t// the construction-time minimum until then.\n     7\timport type { ModelCallFailureKind } from \"./types.js\";\n     8\t\n     9\texport const FAILURE_CLASSIFICATION: Record<ModelCallFailureKind, { retryable: boolean }> = {\n    10\t  rate_limit: { retryable: true },\n    11\t  timeout: { retryable: true },\n    12\t  network: { retryable: true },\n    13\t  empty_output: { retryable: true },\n    14\t  other: { retryable: true },\n    15\t  auth: { retryable: false },\n    16\t  invalid_request: { retryable: false },\n    17\t};\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/inference/prompts/index.ts'","aggregated_output":"     1\t// The name-keyed prompt registry (DD-8): one module per template exporting\n     2\t// `{ name, render(input) → messages }`; config selects by name and dial-in\n     3\t// swaps by adding a module and editing config — no handler, adapter, or host\n     4\t// changes. Versioning is in the name (`smoothing-v1`).\n     5\timport type { FormKind } from \"../../shared/derivation.js\";\n     6\timport type { ModelCallInput } from \"../types.js\";\n     7\timport { chunkBriefV1 } from \"./chunk-brief-v1.js\";\n     8\timport { chunkDetailedV1 } from \"./chunk-detailed-v1.js\";\n     9\timport { lowerBandV1 } from \"./lower-band-v1.js\";\n    10\timport { smoothingV1 } from \"./smoothing-v1.js\";\n    11\timport { toolCallV1 } from \"./tool-call-v1.js\";\n    12\timport { toolResultV1 } from \"./tool-result-v1.js\";\n    13\timport { turnComposeV1 } from \"./turn-compose-v1.js\";\n    14\t\n    15\texport interface PromptTemplate<I = unknown> {\n    16\t  name: string;\n    17\t  render(input: I): ModelCallInput[\"messages\"];\n    18\t}\n    19\t\n    20\t// Every config-selectable name. `never` pins the registry read-only at the\n    21\t// type level — rendering goes through the adapter, which owns the only\n    22\t// kind→input pairing.\n    23\texport const PROMPT_REGISTRY: Record<string, PromptTemplate<never>> = {\n    24\t  [smoothingV1.name]: smoothingV1,\n    25\t  [toolCallV1.name]: toolCallV1,\n    26\t  [toolResultV1.name]: toolResultV1,\n    27\t  [turnComposeV1.name]: turnComposeV1,\n    28\t  [lowerBandV1.name]: lowerBandV1,\n    29\t  [chunkDetailedV1.name]: chunkDetailedV1,\n    30\t  [chunkBriefV1.name]: chunkBriefV1,\n    31\t};\n    32\t\n    33\t// The default template per kind — the seven names an operator's first config\n    34\t// reaches for, and what test fixtures assign.\n    35\texport const DEFAULT_PROMPT_NAMES: Record<FormKind, string> = {\n    36\t  smoothed_prompt: smoothingV1.name,\n    37\t  tool_call_summary: toolCallV1.name,\n    38\t  tool_result_summary: toolResultV1.name,\n    39\t  turn_rendering: turnComposeV1.name,\n    40\t  lower_band_projection: lowerBandV1.name,\n    41\t  chunk_summary_detailed: chunkDetailedV1.name,\n    42\t  chunk_summary_brief: chunkBriefV1.name,\n    43\t};\n","exit_code":0,"status":"completed"}}

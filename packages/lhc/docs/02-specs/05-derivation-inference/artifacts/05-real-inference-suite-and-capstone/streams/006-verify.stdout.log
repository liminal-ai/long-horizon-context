\\\\":\\\\\\\"6e263ebe-a886-4471-999b-14783af3ae9f\\\\\\\",\\\\\\\"request_id\\\\\\\":\\\\\\\"req_011CbzE4ppQg9Z68iD5tg6cH\\\\\\\"}\\\\ndocs/02-specs/05-derivation-inference/artifacts/05-real-inference-suite-and-capstone/streams/003-implementor.stdout.log:367:{\\\\\\\"type\\\\\\\":\\\\\\\"user\\\\\\\",\\\\\\\"message\\\\\\\":{\\\\\\\"role\\\\\\\":\\\\\\\"user\\\\\\\",\\\\\\\"content\\\\\\\":[{\\\\\\\"tool_use_id\\\\\\\":\\\\\\\"toolu_01AKE1kN1hMriZN69jQwNq8N\\\\\\\",\\\\\\\"type\\\\\\\":\\\\\\\"tool_result\\\\\\\",\\\\\\\"content\\\\\\\":\\\\\\\"1\\\\\\\\t// The deterministic provider: marked, input-derived output for every seam\\\\\\\\n2\\\\\\\\t// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\\\\\\\\n3\\\\\\\\t// functions of the input. It backs the named-provider registry's\\\\\\\\n4\\\\\\\\t// \\\\\\\\\\\\\\\"deterministic\\\\\\\\\\\\\\\" entry (DD-11) so spawned-CLI tests exercise the production\\\\\\\\n5\\\\\\\\t// resolution seam, and the test double reuses these helpers so in-process and\\\\\\\\n6\\\\\\\\t// spawned runs produce byte-identical artifacts. It is selectable only by\\\\\\\\n7\\\\\\\\t// explicit name — never a production default.\\\\\\\\n8\\\\\\\\timport type {\\\\\\\\n9\\\\\\\\t  DerivationProvider,\\\\\\\\n10\\\\\\\\t  ProviderResult,\\\\\\\\n11\\\\\\\\t  RenderingPart,\\\\\\\\n12\\\\\\\\t  ToolOutcome,\\\\\\\\n13\\\\\\\\t  ToolRunReceipt,\\\\\\\\n14\\\\\\\\t} from \\\\\\\\\\\\\\\"../shared/derivation.js\\\\\\\\\\\\\\\";\\\\\\\\n15\\\\\\\\t\\\\\\\\n16\\\\\\\\texport type DeterministicOpName =\\\\\\\\n17\\\\\\\\t  | \\\\\\\\\\\\\\\"smoothPrompt\\\\\\\\\\\\\\\"\\\\\\\\n18\\\\\\\\t  | \\\\\\\\\\\\\\\"summarizeToolCall\\\\\\\\\\\\\\\"\\\\\\\\n19\\\\\\\\t  | \\\\\\\\\\\\\\\"summarizeToolResult\\\\\\\\\\\\\\\"\\\\\\\\n20\\\\\\\\t  | \\\\\\\\\\\\\\\"composeTurnRendering\\\\\\\\\\\\\\\"\\\\\\\\n21\\\\\\\\t  | \\\\\\\\\\\\\\\"projectLowerBand\\\\\\\\\\\\\\\"\\\\\\\\n22\\\\\\\\t  | \\\\\\\\\\\\\\\"summarizeChunkDetailed\\\\\
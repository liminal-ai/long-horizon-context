\\\\\\\tfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\\\\\\\\n56\\\\\\\\t  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\\\\\\\\n57\\\\\\\\t}\\\\\\\\n58\\\\\\\\t\\\\\\\\n59\\\\\\\\t// The chunk-summary contract made visible in deterministic output (AC-3.8):\\\\\\\\n60\\\\\\\\t// the detailed summary's artifact carries the members' tool-run receipts —\\\\\\\\n61\\\\\\\\t// account and outcome — verbatim; the brief summary's carries outcomes\\\\\\\\n62\\\\\\\\t// only. Pure suffixes over the input fields, shared with the test double so\\\\\\\\n63\\\\\\\\t// in-process and spawned artifacts stay byte-identical; empty receipt sets\\\\\\\\n64\\\\\\\\t// add nothing, keeping receipt-less output unchanged.\\\\\\\\n65\\\\\\\\texport function deterministicReceiptsSuffix(memberReceipts?: ToolRunReceipt[][]): string {\\\\\\\\n66\\\\\\\\t  const receipts = (memberReceipts ?? []).flat();\\\\\\\\n67\\\\\\\\t  if (receipts.length === 0) return \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\";\\\\\\\\n68\\\\\\\\t  return `[receipts ${receipts.map((r) => `${r.account}=>${r.outcome}`).join(\\\\\\\\\\\\\\\"; \\\\\\\\\\\\\\\")}]`;\\\\\\\\n69\\\\\\\\t}\\\\\\\\n70\\\\\\\\t\\\\\\\\n71\\\\\\\\texport function deterministicOutcomesSuffix(memberOutcomes?: ToolOutcome[][]): string {\\\\\\\\n72\\\\\\\\t  const outcomes = (memberOutcomes ?? []).flat();\\\\\\\\n73\\\\\\\\t  if (outcomes.length === 0) return \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\";\\\\\\\\n74\\\\\\\\t  return `[outcomes ${outcomes.join(\\\\\\\\\\\\\\\",\\\\\\\\\\\\\\\")}]`;\\\\\\\\n75\\\\\\\\t}\\\\\\\\n76\\\\\\\\t\\\\\\\\n77\\\\\\\\texport function createDeterministicProvider(): DerivationProvider {\\\\\\\\n78\\\\\\\\t  return {\\\\\\\\n79\\\\\\\\t    smoothPrompt: (i: { text: string }) => ok(\\\\\\\\\\\\\\\"smoothPrompt\\\\\\\\\\\\\\\", i, i.text),\\\\\\\\n80\\\\\\\\t    summarizeToolCall: (i: {\\\\\\\\n81\\\\\\\\t      toolName: string;\\\\\\\\n82\\\\\\\\t      argsJson: string;\\\\\\\\n83\\\\\\\\t      pairedResult?: { content: string; isError: boolean };\\\\\\\\n84\\\\\\\\t    }) => ok(\\\\\\\\\\\\\\\"summarizeToolCall\\\\\\\\\\\\\\\", i, `${i.toolName} ${i.argsJson}`),\\\\\\\\n85\\\\\\\\t    summarizeToolResult: (i: { toolName: string; content: string }) =>\\\\\\\\n86\\\\\\\\t      ok(\\\\\\\\\\\\\\\"summarizeToolResult\\\\\\\\\\\\\\\", i, i.content),\\\\\\\\n87\\\\\\\\t    composeTurnRendering: (i: { parts: RenderingPart[] }) =>\\\\\\\\n88\\\\\\\\t      ok(\\\\\\\\\\\\\\\"composeTurnRendering\\\\\\\\\\\\\\\", i, i.parts.map((p) => p.text).join(\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\")),\\\\\\\\n89\\\\\\\\t    projectLowerBand: (i: { rendering: string }) => ok(\\\\\\\\\\\\\\\"projectLowerBand\\\\\\\\\\\\\\\", i, i.rendering),\\\\\\\\n90\\\\\\\\t    summarizeChunkDetailed: async (i: {\\\\\\\\n91\\\\\\\\t      memberProjections: string[];\\\\\\\\n92\\\\\\\\t      memberReceipts?: ToolRunReceipt[][];\\\\\\\\n93\\\\\\\\t    }) => {\\\\\\\\n94\\\\\\\\t      const base = await ok(\\\\\\\\\\\\\\\"summarizeChunkDetailed\\\\\\\\\\\\\\\", i, i.memberProjections.join(\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\"));\\\\\\\\n95\\\\\\\\t      if (!base.ok) return base;\\\\\\\\n96\\\\\\\\t      return { ok: true, text: base.text + deterministicReceiptsSuffix(i.memberReceipts) };\\\\\\\\n97\\\\\\\\t    },\\\\\\\\n98\\\\\\\\t    summarizeChunkBrief: async (i: {\\\\\\\\n99\\\\\\\\t      memberProjections: string[];\\\\\\\\n100\\\\\\\\t      memberOutcomes?: ToolOutcome[][];\\\\\\\\n101\\\\\\\\t    }) => {\\\\\\\\n102\\\\\\\\t      const base = await ok(\\\\\\\\\\\\\\\"summarizeChunkBrief\\\\\\\\\\\\\\\", i, i.memberProjections.join(\\\\\\\\\\\\\\\" | \\\\\\\\\\\\\\\"));\\\\\\\\n103\\\\\\\\t      if (!base.ok) return base;\\\\\\\\n104\\\\\\\\t      return { ok: true, text: base.text + deterministicOutcomesSuffix(i.memberOutcomes) };\\\\\\\\n105\\\\\\\\t    },\\\\\\\\n106\\\\\\\\t  };\\\\\\\\n107\\\\\\\\t}\\\\\\\\n108\\\\\\\\t\\\\\\\"}]},\\\\\\\"parent_tool_use_
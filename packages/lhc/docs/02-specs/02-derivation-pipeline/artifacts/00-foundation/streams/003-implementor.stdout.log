{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012Pg5DYGdoqLVWX74GuEX6u","type":"tool_result","content":"1\t// Story 5 (Chunk 5): derivation work queueing. TC-2.6 (complete batch\n2\t// result), TC-2.7/TC-2.9 (message-owned work and its kind gate), the work\n3\t// halves of TC-3.3/TC-3.6 (Story 4's named debt, paid here), TC-3.8's\n4\t// two-work-items assertion, TC-5.4's no-work-item clause, and the two\n5\t// architecture-risk regressions: restart survival extended to work items and\n6\t// the complete-surface rollback. Work items are asserted through the owning\n7\t// domains' listQueuedWork read-back and openRaw — never through the batch\n8\t// result alone. The work-queue util has no public SDK surface; everything\n9\t// here enters through the SDK or the in-process CLI.\n10\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n11\timport {\n12\t  intakeStream,\n13\t  messages,\n14\t  runCli,\n15\t  threads,\n16\t  turns,\n17\t  type MessageEventInput,\n18\t  type WorkItemRecord,\n19\t} from \"../src/index.js\";\n20\timport {\n21\t  openRaw,\n22\t  setIntakeClock,\n23\t  tempStore,\n24\t  validEvent,\n25\t  type TempStore,\n26\t} from \"./fixtures/index.js\";\n27\t\n28\tlet store: TempStore;\n29\tbeforeEach(() => {\n30\t  store = tempStore();\n31\t});\n32\tafterEach(() => {\n33\t  store.cleanup();\n34\t  setIntakeClock(null);\n35\t});\n36\t\n37\tasync function createThread(): Promise<string> {\n38\t  const filePath = store.threadPath();\n39\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n40\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n41\t  return filePath;\n42\t}\n43\t\n44\tasync function send(filePath: string, batch: MessageEventInput[]) {\n45\t  const result = await intakeStream.messageEvents({ filePath }, batch);\n46\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n47\t  return result.value;\n48\t}\n49\t\n50\tasync function queuedFor(\n51\t  filePath: string,\n52\t  owner: \"messages\" | \"turns\",\n53\t): Promise<WorkItemRecord[]> {\n54\t  const result =\n55\t    owner === \"messages\"\n56\t      ? await messages.listQueuedWork({ filePath })\n57\t      : await turns.listQueuedWork({ filePath });\n58\t  if (!result.ok) throw new Error(`queued-work read-back failed: ${result.error.reason}`);\n59\t  return result.value;\n60\t}\n61\t\n62\t// Below-SDK count of durable work-item rows: the batch result alone is not\n63\t// proof of durability (anti-shim requirement).\n64\tfunction rawWorkItemCount(filePath: string): number {\n65\t  const db = openRaw(filePath);\n66\t  try {\n67\t    const row = db.prepare(\"SELECT COUNT(*) AS n FROM work_item\").get() as { n: number | bigint };\n68\t    return Number(row.n);\n69\t  } finally {\n70\t    db.close();\n71\t  }\n72\t}\n73\t\n74\t// Full logical read-back across every record kind the epic owns — the\n75\t// complete-surface rollback regression compares this whole.\n76\tasync function readBack(filePath: string) {\n77\t  const [events, projected, turnRecords, messageWork, turnWork] = await Promise.all([\n78\t    intakeStream.listEvents({ filePath }),\n79\t    messages.listMessages({ filePath }),\n80\t    turns.listTurns({ filePath }),\n81\t    messages.listQueuedWork({ filePath }),\n82\t    turns.listQueuedWork({ filePath }),\n83\t  ]);\n84\t  if (!events.ok || !projected.ok || !turnRecords.ok || !messageWork.ok || !turnWork.ok) {\n85\t    throw new Error(\"read-back failed\");\n86\t  }\n87\t  return {\n88\t    events: events.value,\n89\t    messages: projected.value,\n90\t    turns: turnRecords.value,\n91\t    messageWork: messageWork.value,\n92\t    turnWork: turnWork.value,\n93\t  };\n94\t}\n95\t\n96\tconst FIXED_INSTANT = \"2026-06-10T12:00:00.000Z\";\n97\t\n98\tdescribe(\"Flow 2 (SDK): message-owned work queueing\", () => {\n99\t  it(\"TC-2.7: a prompt and a tool result each durably queue their kind, owner messages (AC-2.8)\", async () => {\n100\t    setIntakeClock(() => new Date(FIXED_INSTANT));\n101\t    const filePath = await createThread();\n102\t    const result = await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"tool_result\")]);\n103\t\n104\t    // The batch result reports both items with full identity.\n105\t    expect(result.queuedWork).toContainEqual({\n106\t      workItemId: \"w-m1-prompt_smoothing\",\n107\t      owner: \"messages\",\n108\t      kind: \"prompt_smoothing\",\n109\t      sourceRef: { messageId: \"m1\" },\n110\t    });\n111\t    expect(result.queuedWork).toContainEqual({\n112\t      workItemId: \"w-m2-tool_result_summary\",\n113\t      owner: \"messages\",\n114\t      kind: \"tool_result_summary\",\n115\t      sourceRef: { messageId: \"m2\" },\n116\t    });\n117\t\n118\t    // Durable read-back through the owning domain: deterministic ids, status\n119\t    // queued, queuedAt from the injected clock.\n120\t    expect(await queuedFor(filePath, \"messages\")).toEqual([\n121\t      {\n122\t        workItemId: \"w-m1-prompt_smoothing\",\n123\t        owner: \"messages\",\n124\t        kind: \"prompt_smoothing\",\n125\t        sourceRef: { messageId: \"m1\" },\n126\t        status: \"queued\",\n127\t        queuedAt: FIXED_INSTANT,\n128\t      },\n129\t      {\n130\t        workItemId: \"w-m2-tool_result_summary\",\n131\t        owner: \"messages\",\n132\t        kind: \"tool_result_summary\",\n133\t        sourceRef: { messageId: \"m2\" },\n134\t        status: \"queued\",\n135\t        queuedAt: FIXED_INSTANT,\n136\t      },\n137\t    ]);\n138\t\n139\t    // The prompt opened a turn that is still open: no turn-owned work yet,\n140\t    // and each domain reads back only its own items.\n141\t    expect(await queuedFor(filePath, \"turns\")).toEqual([]);\n142\t    expect(rawWorkItemCount(filePath)).toBe(2);\n143\t  });\n144\t\n145\t  it(\"TC-2.9: text, thinking, and note messages queue nothing — the kind gate is exact (AC-2.8)\", async () => {\n146\t    const filePath = await createThread();\n147\t    const result = await send(filePath, [\n148\t      validEvent(\"assistant_text\"),\n149\t      validEvent(\"assistant_thinking\"),\n150\t      validEvent(\"runtime_note\"),\n151\t    ]);\n152\t    expect(result.queuedWork).toEqual([]);\n153\t    expect(await queuedFor(filePath, \"messages\")).toEqual([]);\n154\t    expect(await queuedFor(filePath, \"turns\")).toEqual([]);\n155\t    expect(rawWorkItemCount(filePath)).toBe(0);\n156\t  });\n157\t\n158\t  it(\"TC-2.6: a mixed batch's result is complete — outcomes, messageIds, transitions, queuedWork, position (AC-2.7)\", async () => {\n159\t    const filePath = await createThread();\n160\t    const original = validEvent(\"user_prompt\");\n161\t    await send(filePath, [original]);\n162\t\n163\t    const result = await send(filePath, [\n164\t      original, // duplicate: skipped\n165\t      validEvent(\"assistant_text\"),\n166\t      validEvent(\"turn_end\"),\n167\t    ]);\n168\t\n169\t    expect(result.events).toEqual([\n170\t      {\n171\t        idempotencyKey: original.idempotencyKey,\n172\t        outcome: \"skipped\",\n173\t        skipReason: \"duplicate_idempotency_key\",\n174\t      },\n175\t      expect.objectContaining({ outcome: \"recorded\", messageId: \"m2\" }),\n176\t      expect.objectContaining({ outcome: \"recorded\" }),\n177\t    ]);\n178\t    // turn_end produces no message.\n179\t    expect(result.events[2]).not.toHaveProperty(\"messageId\");\n180\t    expect(result.turnTransitions).toEqual([{ action: \"closed\", turnId: \"t1\" }]);\n181\t    expect(result.queuedWork).toEqual([\n182\t      {\n183\t        workItemId: \"w-t1-turn_derivation\",\n184\t        owner: \"turns\",\n185\t        kind: \"turn_derivation\",\n186\t        sourceRef: { turnId: \"t1\" },\n187\t      },\n188\t    ]);\n189\t    expect(result.threadPosition).toEqual({ lastEventOrder: 3 });\n190\t  });\n191\t});\n192\t\n193\tdescribe(\"Flow 3 (SDK): turn-owned work queueing — Story 4's debt paid\", () => {\n194\t  it(\"TC-3.3 (work half): explicit close durably queues w-t1-turn_derivation, owner turns (AC-3.4, AC-3.6)\", async () => {\n195\t    setIntakeClock(() => new Date(FIXED_INSTANT));\n196\t    const filePath = await createThread();\n197\t    const result = await send(filePath, [\n198\t      validEvent(\"user_prompt\"),\n199\t      validEvent(\"assistant_text\"),\n200\t      validEvent(\"turn_end\"),\n201\t    ]);\n202\t\n203\t    expect(result.queuedWork).toContainEqual({\n204\t      workItemId: \"w-t1-turn_derivation\",\n205\t      owner: \"turns\",\n206\t      kind: \"turn_derivation\",\n207\t      sourceRef: { turnId: \"t1\" },\n208\t    });\n209\t    expect(await queuedFor(filePath, \"turns\")).toEqual([\n210\t      {\n211\t        workItemId: \"w-t1-turn_derivation\",\n212\t        owner: \"turns\",\n213\t        kind: \"turn_derivation\",\n214\t        sourceRef: { turnId: \"t1\" },\n215\t        status: \"queued\",\n216\t        queuedAt: FIXED_INSTANT,\n217\t      },\n218\t    ]);\n219\t  });\n220\t\n221\t  it(\"TC-3.6 (work half): implicit close queues the same work-item contract as the explicit path (AC-3.6)\", async () => {\n222\t    const explicitPath = await createThread();\n223\t    await send(explicitPath, [validEvent(\"user_prompt\"), validEvent(\"assistant_text\")]);\n224\t    await send(explicitPath, [validEvent(\"turn_end\")]);\n225\t\n226\t    const implicitPath = await createThread();\n227\t    await send(implicitPath, [validEvent(\"user_prompt\"), validEvent(\"assistant_text\")]);\n228\t    await send(implicitPath, [validEvent(\"user_prompt\")]);\n229\t\n230\t    const explicitItems = await queuedFor(explicitPath, \"turns\");\n231\t    const implicitItems = await queuedFor(implicitPath, \"turns\");\n232\t    expect(explicitItems).toHaveLength(1);\n233\t    // Same item contract modulo queuedAt (wall clock differs between runs).\n234\t    const contract = (items: WorkItemRecord[]) =>\n235\t      items.map(({ queuedAt: _queuedAt, ...rest }) => rest);\n236\t    expect(contract(implicitItems)).toEqual(contract(explicitItems));\n237\t    expect(contract(explicitItems)).toEqual([\n238\t      {\n239\t        workItemId: \"w-t1-turn_derivation\",\n240\t        owner: \"turns\",\n241\t        kind: \"turn_derivation\",\n242\t        sourceRef: { turnId: \"t1\" },\n243\t        status: \"queued\",\n244\t      },\n245\t    ]);\n246\t  });\n247\t\n248\t  it(\"TC-3.8 (work count): a multi-turn batch queues one turn_derivation item per closed turn (AC-3.6)\", async () => {\n249\t    const filePath = await createThread();\n250\t    await send(filePath, [\n251\t      validEvent(\"user_prompt\"),\n252\t      validEvent(\"assistant_text\"),\n253\t      validEvent(\"user_prompt\"),\n254\t      validEvent(\"assistant_text\"),\n255\t      validEvent(\"turn_end\"),\n256\t    ]);\n257\t\n258\t    const turnWork = await queuedFor(filePath, \"turns\");\n259\t    expect(turnWork.map((item) => item.workItemId)).toEqual([\n260\t      \"w-t1-turn_derivation\",\n261\t      \"w-t2-turn_derivation\",\n262\t    ]);\n263\t    expect(turnWork.every((item) => item.kind === \"turn_derivation\")).toBe(true);\n264\t    expect(turnWork.every((item) => item.status === \"queued\")).toBe(true);\n265\t  });\n266\t\n267\t  it(\"TC-5.4 (no-work-item clause): a skipped event queues nothing (AC-5.4)\", async () => {\n268\t    const filePath = await createThread();\n269\t    const prompt = validEvent(\"user_prompt\");\n270\t    const end = validEvent(\"turn_end\");\n271\t    await send(filePath, [prompt, validEvent(\"assistant_text\"), end]);\n272\t    await send(filePath, [validEvent(\"user_prompt\")]); // t2 now open\n273\t    const baseline = await readBack(filePath);\n274\t    const baselineCount = rawWorkItemCount(filePath);\n275\t\n276\t    const resend = await send(filePath, [prompt, end]);\n277\t    expect(resend.events.map((entry) => entry.outcome)).toEqual([\"skipped\", \"skipped\"]);\n278\t    expect(resend.queuedWork).toEqual([]);\n279\t    expect(await readBack(filePath)).toEqual(baseline);\n280\t    expect(rawWorkItemCount(filePath)).toBe(baselineCount);\n281\t  });\n282\t});\n283\t\n284\tdescribe(\"architecture-risk: durability and rollback over the complete record surface\", () => {\n285\t  it(\"restart survival: a reopened thread file holds its work items intact, status queued\", async () => {\n286\t    const filePath = await createThread();\n287\t    await send(filePath, [\n288\t      validEvent(\"user_prompt\"),\n289\t      validEvent(\"tool_call\"),\n290\t      validEvent(\"tool_result\"),\n291\t      validEvent(\"turn_end\"),\n292\t    ]);\n293\t    const before = await readBack(filePath);\n294\t    expect(before.messageWork).toHaveLength(2);\n295\t    expect(before.turnWork).toHaveLength(1);\n296\t\n297\t    // Every SDK operation opens and closes its own handle, so a fresh\n298\t    // read-back is a real reopen of the real file. The raw scan proves the\n299\t    // rows live in the thread file itself — not an in-memory queue.\n300\t    const db = openRaw(filePath);\n301\t    try {\n302\t      const rows = db\n303\t        .prepare(\"SELECT work_item_id, status FROM work_item ORDER BY work_item_id\")\n304\t        .all() as unknown as Array<{ work_item_id: string; status: string }>;\n305\t      expect(rows).toEqual([\n306\t        { work_item_id: \"w-m1-prompt_smoothing\", status: \"queued\" },\n307\t        { work_item_id: \"w-m3-tool_result_summary\", status: \"queued\" },\n308\t        { work_item_id: \"w-t1-turn_derivation\", status: \"queued\" },\n309\t      ]);\n310\t    } finally {\n311\t      db.close();\n312\t    }\n313\t    expect(await readBack(filePath)).toEqual(before);\n314\t  });\n315\t\n316\t  it(\"complete-surface rollback: a rejected batch leaves events, messages, turns, and work items at baseline (AC-4.6)\", async () => {\n317\t    const filePath = await createThread();\n318\t    await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"tool_result\"), validEvent(\"turn_end\")]);\n319\t    const baseline = await readBack(filePath);\n320\t    const baselineCount = rawWorkItemCount(filePath);\n321\t\n322\t    // A valid prefix that would queue work, then one invalid event: the\n323\t    // batch must reject whole and queue nothing.\n324\t    const rejected = await intakeStream.messageEvents({ filePath }, [\n325\t      validEvent(\"user_prompt\"),\n326\t      { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n327\t    ]);\n328\t    expect(rejected.ok).toBe(false);\n329\t    if (rejected.ok) return;\n330\t    expect(rejected.error.code).toBe(\"invalid_event\");\n331\t\n332\t    expect(await readBack(filePath)).toEqual(baseline);\n333\t    expect(rawWorkItemCount(filePath)).toBe(baselineCount);\n334\t  });\n335\t});\n336\t\n337\tdescribe(\"CLI in-process: list-queued-work on both owning domains\", () => {\n338\t  it(\"messages list-queued-work and turns list-queued-work each return only their owner's items\", async () => {\n339\t    const filePath = await createThread();\n340\t    await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n341\t\n342\t    const messagesListed = await runCli([\"messages\", \"list-queued-work\", \"--file-path\", filePath]);\n343\t    expect(messagesListed.exitCode).toBe(0);\n344\t    const messagesParsed = JSON.parse(messagesListed.stdout) as {\n345\t      ok: boolean;\n346\t      value: WorkItemRecord[];\n347\t    };\n348\t    expect(messagesParsed.ok).toBe(true);\n349\t    expect(messagesParsed.value).toHaveLength(1);\n350\t    expect(messagesParsed.value[0]).toMatchObject({\n351\t      workItemId: \"w-m1-prompt_smoothing\",\n352\t      owner: \"messages\",\n353\t      kind: \"prompt_smoothing\",\n354\t      sourceRef: { messageId: \"m1\" },\n355\t      status: \"queued\",\n356\t    });\n357\t\n358\t    const turnsListed = await runCli([\"turns\", \"list-queued-work\", \"--file-path\", filePath]);\n359\t    expect(turnsListed.exitCode).toBe(0);\n360\t    const turnsParsed = JSON.parse(turnsListed.stdout) as {\n361\t      ok: boolean;\n362\t      value: WorkItemRecord[];\n363\t    };\n364\t    expect(turnsParsed.ok).toBe(true);\n365\t    expect(turnsParsed.value).toHaveLength(1);\n366\t    expect(turnsParsed.value[0]).toMatchObject({\n367\t      workItemId: \"w-t1-turn_derivation\",\n368\t      owner: \"turns\",\n369\t      kind: \"turn_derivation\",\n370\t      sourceRef: { turnId: \"t1\" },\n371\t      status: \"queued\",\n372\t    });\n373\t  });\n374\t\n375\t  it(\"list-queued-work on an unknown thread id fails with thread_not_found\", async () => {\n376\t    const listed = await runCli([\n377\t      \"messages\",\n378\t      \"list-queued-work\",\n379\t      \"--thread-id\",\n380\t      \"th_nope\",\n381\t      \"--registry\",\n382\t      store.registryPath,\n383\t    ]);\n384\t    expect(listed.exitCode).toBe(1);\n385\t    const parsed = JSON.parse(listed.stdout) as { ok: boolean; error: { code: string } };\n386\t    expect(parsed.ok).toBe(false);\n387\t    expect(parsed.error.code).toBe(\"thread_not_found\");\n388\t  });\n389\t});\n390\t"}]},"parent_tool_use_id":null,"session_id":"7698513f-2c28-4ac5-bcaf-f544bbac5176","uuid":"b0c6925c-91d6-4193-bdfc-fa6c74ae9a01","timestamp":"2026-06-11T03:04:32.029Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/work-queue.test.ts","content":"// Story 5 (Chunk 5): derivation work queueing. TC-2.6 (complete batch\n// result), TC-2.7/TC-2.9 (message-owned work and its kind gate), the work\n// halves of TC-3.3/TC-3.6 (Story 4's named debt, paid here), TC-3.8's\n// two-work-items assertion, TC-5.4's no-work-item clause, and the two\n// architecture-risk regressions: restart survival extended to work items and\n// the complete-surface rollback. Work items are asserted through the owning\n// domains' listQueuedWork read-back and openRaw — never through the batch\n// result alone. The work-queue util has no public SDK surface; everything\n// here enters through the SDK or the in-process CLI.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  intakeStream,\n  messages,\n  runCli,\n  threads,\n  turns,\n  type MessageEventInput,\n  type WorkItemRecord,\n} from \"../src/index.js\";\nimport {\n  openRaw,\n  setIntakeClock,\n  tempStore,\n  validEvent,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n  setIntakeClock(null);\n});\n\nasync function createThread(): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nasync function send(filePath: string, batch: MessageEventInput[]) {\n  const result = await intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n  return result.value;\n}\n\nasync function queuedFor(\n  filePath: string,\n  owner: \"messages\" | \"turns\",\n): Promise<WorkItemRecord[]> {\n  const result =\n    owner === \"messages\"\n      ? await messages.listQueuedWork({ filePath })\n      : await turns.listQueuedWork({ filePath });\n  if (!result.ok) throw new Error(`queued-work read-back failed: ${result.error.reason}`);\n  return result.value;\n}\n\n// Below-SDK count of durable work-item rows: the batch result alone is not\n// proof of durability (anti-shim requirement).\nfunction rawWorkItemCount(filePath: string): number {\n  const db = openRaw(filePath);\n  try {\n    const row = db.prepare(\"SELECT COUNT(*) AS n FROM work_item\").get() as { n: number | bigint };\n    return Number(row.n);\n  } finally {\n    db.close();\n  }\n}\n\n// Full logical read-back across every record kind the epic owns — the\n// complete-surface rollback regression compares this whole.\nasync function readBack(filePath: string) {\n  const [events, projected, turnRecords, messageWork, turnWork] = await Promise.all([\n    intakeStream.listEvents({ filePath }),\n    messages.listMessages({ filePath }),\n    turns.listTurns({ filePath }),\n    messages.listQueuedWork({ filePath }),\n    turns.listQueuedWork({ filePath }),\n  ]);\n  if (!events.ok || !projected.ok || !turnRecords.ok || !messageWork.ok || !turnWork.ok) {\n    throw new Error(\"read-back failed\");\n  }\n  return {\n    events: events.value,\n    messages: projected.value,\n    turns: turnRecords.value,\n    messageWork: messageWork.value,\n    turnWork: turnWork.value,\n  };\n}\n\nconst FIXED_INSTANT = \"2026-06-10T12:00:00.000Z\";\n\ndescribe(\"Flow 2 (SDK): message-owned work queueing\", () => {\n  it(\"TC-2.7: a prompt and a tool result each durably queue their kind, owner messages (AC-2.8)\", async () => {\n    setIntakeClock(() => new Date(FIXED_INSTANT));\n    const filePath = await createThread();\n    const result = await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"tool_result\")]);\n\n    // The batch result reports both items with full identity.\n    expect(result.queuedWork).toContainEqual({\n      workItemId: \"w-m1-prompt_smoothing\",\n      owner: \"messages\",\n      kind: \"prompt_smoothing\",\n      sourceRef: { messageId: \"m1\" },\n    });\n    expect(result.queuedWork).toContainEqual({\n      workItemId: \"w-m2-tool_result_summary\",\n      owner: \"messages\",\n      kind: \"tool_result_summary\",\n      sourceRef: { messageId: \"m2\" },\n    });\n\n    // Durable read-back through the owning domain: deterministic ids, status\n    // queued, queuedAt from the injected clock.\n    expect(await queuedFor(filePath, \"messages\")).toEqual([\n      {\n        workItemId: \"w-m1-prompt_smoothing\",\n        owner: \"messages\",\n        kind: \"prompt_smoothing\",\n        sourceRef: { messageId: \"m1\" },\n        status: \"queued\",\n        queuedAt: FIXED_INSTANT,\n      },\n      {\n        workItemId: \"w-m2-tool_result_summary\",\n        owner: \"messages\",\n        kind: \"tool_result_summary\",\n        sourceRef: { messageId: \"m2\" },\n        status: \"queued\",\n        queuedAt: FIXED_INSTANT,\n      },\n    ]);\n\n    // The prompt opened a turn that is still open: no turn-owned work yet,\n    // and each domain reads back only its own items.\n    expect(await queuedFor(filePath, \"turns\")).toEqual([]);\n    expect(rawWorkItemCount(filePath)).toBe(2);\n  });\n\n  it(\"TC-2.9: text, thinking, and note messages queue nothing — the kind gate is exact (AC-2.8)\", async () => {\n    const filePath = await createThread();\n    const result = await send(filePath, [\n      validEvent(\"assistant_text\"),\n      validEvent(\"assistant_thinking\"),\n      validEvent(\"runtime_note\"),\n    ]);\n    expect(result.queuedWork).toEqual([]);\n    expect(await queuedFor(filePath, \"messages\")).toEqual([]);\n    expect(await queuedFor(filePath, \"turns\")).toEqual([]);\n    expect(rawWorkItemCount(filePath)).toBe(0);\n  });\n\n  it(\"TC-2.6: a mixed batch's result is complete — outcomes, messageIds, transitions, queuedWork, position (AC-2.7)\", async () => {\n    const filePath = await createThread();\n    const original = validEvent(\"user_prompt\");\n    await send(filePath, [original]);\n\n    const result = await send(filePath, [\n      original, // duplicate: skipped\n      validEvent(\"assistant_text\"),\n      validEvent(\"turn_end\"),\n    ]);\n\n    expect(result.events).toEqual([\n      {\n        idempotencyKey: original.idempotencyKey,\n        outcome: \"skipped\",\n        skipReason: \"duplicate_idempotency_key\",\n      },\n      expect.objectContaining({ outcome: \"recorded\", messageId: \"m2\" }),\n      expect.objectContaining({ outcome: \"recorded\" }),\n    ]);\n    // turn_end produces no message.\n    expect(result.events[2]).not.toHaveProperty(\"messageId\");\n    expect(result.turnTransitions).toEqual([{ action: \"closed\", turnId: \"t1\" }]);\n    expect(result.queuedWork).toEqual([\n      {\n        workItemId: \"w-t1-turn_derivation\",\n        owner: \"turns\",\n        kind: \"turn_derivation\",\n        sourceRef: { turnId: \"t1\" },\n      },\n    ]);\n    expect(result.threadPosition).toEqual({ lastEventOrder: 3 });\n  });\n});\n\ndescribe(\"Flow 3 (SDK): turn-owned work queueing — Story 4's debt paid\", () => {\n  it(\"TC-3.3 (work half): explicit close durably queues w-t1-turn_derivation, owner turns (AC-3.4, AC-3.6)\", async () => {\n    setIntakeClock(() => new Date(FIXED_INSTANT));\n    const filePath = await createThread();\n    const result = await send(filePath, [\n      validEvent(\"user_prompt\"),\n      validEvent(\"assistant_text\"),\n      validEvent(\"turn_end\"),\n    ]);\n\n    expect(result.queuedWork).toContainEqual({\n      workItemId: \"w-t1-turn_derivation\",\n      owner: \"turns\",\n      kind: \"turn_derivation\",\n      sourceRef: { turnId: \"t1\" },\n    });\n    expect(await queuedFor(filePath, \"turns\")).toEqual([\n      {\n        workItemId: \"w-t1-turn_derivation\",\n        owner: \"turns\",\n        kind: \"turn_derivation\",\n        sourceRef: { turnId: \"t1\" },\n        status: \"queued\",\n        queuedAt: FIXED_INSTANT,\n      },\n    ]);\n  });\n\n  it(\"TC-3.6 (work half): implicit close queues the same work-item contract as the explicit path (AC-3.6)\", async () => {\n    const explicitPath = await createThread();\n    await send(explicitPath, [validEvent(\"user_prompt\"), validEvent(\"assistant_text\")]);\n    await send(explicitPath, [validEvent(\"turn_end\")]);\n\n    const implicitPath = await createThread();\n    await send(implicitPath, [validEvent(\"user_prompt\"), validEvent(\"assistant_text\")]);\n    await send(implicitPath, [validEvent(\"user_prompt\")]);\n\n    const explicitItems = await queuedFor(explicitPath, \"turns\");\n    const implicitItems = await queuedFor(implicitPath, \"turns\");\n    expect(explicitItems).toHaveLength(1);\n    // Same item contract modulo queuedAt (wall clock differs between runs).\n    const contract = (items: WorkItemRecord[]) =>\n      items.map(({ queuedAt: _queuedAt, ...rest }) => rest);\n    expect(contract(implicitItems)).toEqual(contract(explicitItems));\n    expect(contract(explicitItems)).toEqual([\n      {\n        workItemId: \"w-t1-turn_derivation\",\n        owner: \"turns\",\n        kind: \"turn_derivation\",\n        sourceRef: { turnId: \"t1\" },\n        status: \"queued\",\n      },\n    ]);\n  });\n\n  it(\"TC-3.8 (work count): a multi-turn batch queues one turn_derivation item per closed turn (AC-3.6)\", async () => {\n    const filePath = await createThread();\n    await send(filePath, [\n      validEvent(\"user_prompt\"),\n      validEvent(\"assistant_text\"),\n      validEvent(\"user_prompt\"),\n      validEvent(\"assistant_text\"),\n      validEvent(\"turn_end\"),\n    ]);\n\n    const turnWork = await queuedFor(filePath, \"turns\");\n    expect(turnWork.map((item) => item.workItemId)).toEqual([\n      \"w-t1-turn_derivation\",\n      \"w-t2-turn_derivation\",\n    ]);\n    expect(turnWork.every((item) => item.kind === \"turn_derivation\")).toBe(true);\n    expect(turnWork.every((item) => item.status === \"queued\")).toBe(true);\n  });\n\n  it(\"TC-5.4 (no-work-item clause): a skipped event queues nothing (AC-5.4)\", async () => {\n    const filePath = await createThread();\n    const prompt = validEvent(\"user_prompt\");\n    const end = validEvent(\"turn_end\");\n    await send(filePath, [prompt, validEvent(\"assistant_text\"), end]);\n    await send(filePath, [validEvent(\"user_prompt\")]); // t2 now open\n    const baseline = await readBack(filePath);\n    const baselineCount = rawWorkItemCount(filePath);\n\n    const resend = await send(filePath, [prompt, end]);\n    expect(resend.events.map((entry) => entry.outcome)).toEqual([\"skipped\", \"skipped\"]);\n    expect(resend.queuedWork).toEqual([]);\n    expect(await readBack(filePath)).toEqual(baseline);\n    expect(rawWorkItemCount(filePath)).toBe(baselineCount);\n  });\n});\n\ndescribe(\"architecture-risk: durability and rollback over the complete record surface\", () => {\n  it(\"restart survival: a reopened thread file holds its work items intact, status queued\", async () => {\n    const filePath = await createThread();\n    await send(filePath, [\n      validEvent(\"user_prompt\"),\n      validEvent(\"tool_call\"),\n      validEvent(\"tool_result\"),\n      validEvent(\"turn_end\"),\n    ]);\n    const before = await readBack(filePath);\n    expect(before.messageWork).toHaveLength(2);\n    expect(before.turnWork).toHaveLength(1);\n\n    // Every SDK operation opens and closes its own handle, so a fresh\n    // read-back is a real reopen of the real file. The raw scan proves the\n    // rows live in the thread file itself — not an in-memory queue.\n    const db = openRaw(filePath);\n    try {\n      const rows = db\n        .prepare(\"SELECT work_item_id, status FROM work_item ORDER BY work_item_id\")\n        .all() as unknown as Array<{ work_item_id: string; status: string }>;\n      expect(rows).toEqual([\n        { work_item_id: \"w-m1-prompt_smoothing\", status: \"queued\" },\n        { work_item_id: \"w-m3-tool_result_summary\", status: \"queued\" },\n        { work_item_id: \"w-t1-turn_derivation\", status: \"queued\" },\n      ]);\n    } finally {\n      db.close();\n    }\n    expect(await readBack(filePath)).toEqual(before);\n  });\n\n  it(\"complete-surface rollback: a rejected batch leaves events, messages, turns, and work items at baseline (AC-4.6)\", async () => {\n    const filePath = await createThread();\n    await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"tool_result\"), validEvent(\"turn_end\")]);\n    const baseline = await readBack(filePath);\n    const baselineCount = rawWorkItemCount(filePath);\n\n    // A valid prefix that would queue work, then one invalid event: the\n    // batch must reject whole and queue nothing.\n    const rejected = await intakeStream.messageEvents({ filePath }, [\n      validEvent(\"user_prompt\"),\n      { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n    ]);\n    expect(rejected.ok).toBe(false);\n    if (rejected.ok) return;\n    expect(rejected.error.code).toBe(\"invalid_event\");\n\n    expect(await readBack(filePath)).toEqual(baseline);\n    expect(rawWorkItemCount(filePath)).toBe(baselineCount);\n  });\n});\n\ndescribe(\"CLI in-process: list-queued-work on both owning domains\", () => {\n  it(\"messages list-queued-work and turns list-queued-work each return only their owner's items\", async () => {\n    const filePath = await createThread();\n    await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n\n    const messagesListed = await runCli([\"messages\", \"list-queued-work\", \"--file-path\", filePath]);\n    expect(messagesListed.exitCode).toBe(0);\n    const messagesParsed = JSON.parse(messagesListed.stdout) as {\n      ok: boolean;\n      value: WorkItemRecord[];\n    };\n    expect(messagesParsed.ok).toBe(true);\n    expect(messagesParsed.value).toHaveLength(1);\n    expect(messagesParsed.value[0]).toMatchObject({\n      workItemId: \"w-m1-prompt_smoothing\",\n      owner: \"messages\",\n      kind: \"prompt_smoothing\",\n      sourceRef: { messageId: \"m1\" },\n      status: \"queued\",\n    });\n\n    const turnsListed = await runCli([\"turns\", \"list-queued-work\", \"--file-path\", filePath]);\n    expect(turnsListed.exitCode).toBe(0);\n    const turnsParsed = JSON.parse(turnsListed.stdout) as {\n      ok: boolean;\n      value: WorkItemRecord[];\n    };\n    expect(turnsParsed.ok).toBe(true);\n    expect(turnsParsed.value).toHaveLength(1);\n    expect(turnsParsed.value[0]).toMatchObject({\n      workItemId: \"w-t1-turn_derivation\",\n      owner: \"turns\",\n      kind: \"turn_derivation\",\n      sourceRef: { turnId: \"t1\" },\n      status: \"queued\",\n    });\n  });\n\n  it(\"list-queued-work on an unknown thread id fails with thread_not_found\", async () => {\n    const listed = await runCli([\n      \"messages\",\n      \"list-queued-work\",\n      \"--thread-id\",\n      \"th_nope\",\n      \"--registry\",\n      store.registryPath,\n    ]);\n    expect(listed.exitCode).toBe(1);\n    const parsed = JSON.parse(listed.stdout) as { ok: boolean; error: { code: string } };\n    expect(parsed.ok).toBe(false);\n    expect(parsed.error.code).toBe(\"thread_not_found\");\n  });\n});\n","numLines":390,"startLine":1,"totalLines":390}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01887teJhEBzBCtQf3ZxJ7Y5","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport type { OperationContext } from \"../../shared/context.js\";\n3\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n4\timport {\n5\t  listItems,\n6\t  recordItem,\n7\t  type WorkItemRecord,\n8\t} from \"../../tech-utils/work-queue/index.js\";\n9\timport type { EventKind } from \"../intake-stream/index.js\";\n10\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n11\timport { transition } from \"./internal/state-machine.js\";\n12\t\n13\t// The pure rule table, re-exported for the golden supplemental suite (the\n14\t// test plan's one sanctioned direct entry besides the tokenizer); production\n15\t// callers go through applyEvent.\n16\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n17\timport {\n18\t  closeTurn,\n19\t  insertOpenTurn,\n20\t  nextTurnOrder,\n21\t  readTurns,\n22\t  selectOpenTurnIds,\n23\t} from \"./internal/store.js\";\n24\t\n25\texport interface TurnRecord {\n26\t  turnId: string;\n27\t  status: \"open\" | \"closed\";\n28\t  memberMessageIds: string[];\n29\t  openedAtEventOrder: number;\n30\t  closedAtEventOrder?: number;\n31\t}\n32\t\n33\texport interface TurnTransitionOutcome {\n34\t  // Transitions in occurrence order: a close_then_open reports the close\n35\t  // first, then the open, exactly as the batch result surfaces them.\n36\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n37\t  // Turn state after the transition — the stamp for this event's message.\n38\t  // Prompts see the turn they just opened (transition first, then stamp);\n39\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n40\t  openTurnId: string | null;\n41\t  // Work queued by this transition: one turn_derivation item per closed\n42\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\n43\t  queuedWork: WorkItemRecord[];\n44\t}\n45\t\n46\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n47\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n48\t// writes turn state, so more than one open turn means external interference.\n49\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n50\t  return selectOpenTurnIds(ctx.db);\n51\t}\n52\t\n53\t// Closing a turn — by either close path — durably queues that turn's\n54\t// derivation work in the same transaction (AC-3.6): the close update and the\n55\t// work item commit or roll back together.\n56\tfunction closeTurnAndQueueWork(\n57\t  ctx: OperationContext,\n58\t  turnId: string,\n59\t  eventOrder: number,\n60\t): WorkItemRecord {\n61\t  closeTurn(ctx.db, turnId, eventOrder);\n62\t  return recordItem(\n63\t    ctx.db,\n64\t    { owner: \"turns\", kind: \"turn_derivation\", sourceRef: { turnId } },\n65\t    ctx.clock().toISOString(),\n66\t  );\n67\t}\n68\t\n69\t// Cross-domain surface, called by intake-stream inside the batch transaction\n70\t// for every recorded event. Synchronous and throwing by design, like\n71\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n72\texport function applyEvent(\n73\t  ctx: OperationContext,\n74\t  eventKind: EventKind,\n75\t  eventOrder: number,\n76\t): TurnTransitionOutcome {\n77\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n78\t  const effect = transition({ openTurnId }, eventKind);\n79\t  switch (effect.kind) {\n80\t    case \"none\":\n81\t      return { transitions: [], openTurnId, queuedWork: [] };\n82\t    case \"open\": {\n83\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n84\t      return {\n85\t        transitions: [{ action: \"opened\", turnId }],\n86\t        openTurnId: turnId,\n87\t        queuedWork: [],\n88\t      };\n89\t    }\n90\t    case \"close\": {\n91\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n92\t      return {\n93\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n94\t        openTurnId: null,\n95\t        queuedWork: [item],\n96\t      };\n97\t    }\n98\t    case \"close_then_open\": {\n99\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n100\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n101\t      return {\n102\t        transitions: [\n103\t          { action: \"closed\", turnId: openTurnId as string },\n104\t          { action: \"opened\", turnId },\n105\t        ],\n106\t        openTurnId: turnId,\n107\t        queuedWork: [item],\n108\t      };\n109\t    }\n110\t  }\n111\t}\n112\t\n113\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n114\t  return {\n115\t    ok: false,\n116\t    error: {\n117\t      errorClass: \"caller_error\",\n118\t      code: \"thread_not_found\",\n119\t      reason: `no thread file exists at ${filePath}`,\n120\t    },\n121\t  };\n122\t}\n123\t\n124\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n125\t  const resolved = await resolveThreadRef(thread);\n126\t  if (!resolved.ok) return resolved;\n127\t  const { filePath } = resolved.value;\n128\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n129\t\n130\t  const opened = openThreadDatabase(filePath);\n131\t  if (!opened.ok) return opened;\n132\t  const db = opened.value;\n133\t  try {\n134\t    return { ok: true, value: readTurns(db) };\n135\t  } catch (cause) {\n136\t    const reason = cause instanceof Error ? cause.message : String(cause);\n137\t    return storageFailure(`turn read-back failed: ${reason}`);\n138\t  } finally {\n139\t    db.close();\n140\t  }\n141\t}\n142\t\n143\texport async function listQueuedWork(\n144\t  thread: ThreadRef,\n145\t): Promise<OpResult<WorkItemRecord[]>> {\n146\t  const resolved = await resolveThreadRef(thread);\n147\t  if (!resolved.ok) return resolved;\n148\t  const { filePath } = resolved.value;\n149\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n150\t\n151\t  const opened = openThreadDatabase(filePath);\n152\t  if (!opened.ok) return opened;\n153\t  const db = opened.value;\n154\t  try {\n155\t    return { ok: true, value: listItems(db, \"turns\") };\n156\t  } catch (cause) {\n157\t    const reason = cause instanceof Error ? cause.message : String(cause);\n158\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n159\t  } finally {\n160\t    db.close();\n161\t  }\n162\t}\n163\t"}]},"parent_tool_use_id":null,"session_id":"7698513f-2c28-4ac5-bcaf-f544bbac5176","uuid":"1313f690-1540-414f-936f-70db9fa6ad07","timestamp":"2026-06-11T03:02:55.697Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/index.ts","content":"import { existsSync } from \"node:fs\";\nimport type { OperationContext } from \"../../shared/context.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  listItems,\n  recordItem,\n  type WorkItemRecord,\n} from \"../../tech-utils/work-queue/index.js\";\nimport type { EventKind } from \"../intake-stream/index.js\";\nimport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\nimport { transition } from \"./internal/state-machine.js\";\n\n// The pure rule table, re-exported for the golden supplemental suite (the\n// test plan's one sanctioned direct entry besides the tokenizer); production\n// callers go through applyEvent.\nexport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\nimport {\n  closeTurn,\n  insertOpenTurn,\n  nextTurnOrder,\n  readTurns,\n  selectOpenTurnIds,\n} from \"./internal/store.js\";\n\nexport interface TurnRecord {\n  turnId: string;\n  status: \"open\" | \"closed\";\n  memberMessageIds: string[];\n  openedAtEventOrder: number;\n  closedAtEventOrder?: number;\n}\n\nexport interface TurnTransitionOutcome {\n  // Transitions in occurrence order: a close_then_open reports the close\n  // first, then the open, exactly as the batch result surfaces them.\n  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n  // Turn state after the transition — the stamp for this event's message.\n  // Prompts see the turn they just opened (transition first, then stamp);\n  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n  openTurnId: string | null;\n  // Work queued by this transition: one turn_derivation item per closed\n  // turn, by either close path (AC-3.6). Empty when nothing closed.\n  queuedWork: WorkItemRecord[];\n}\n\n// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n// IMMEDIATE and before any event is processed. Only the batch pipeline\n// writes turn state, so more than one open turn means external interference.\nexport function listOpenTurnIds(ctx: OperationContext): string[] {\n  return selectOpenTurnIds(ctx.db);\n}\n\n// Closing a turn — by either close path — durably queues that turn's\n// derivation work in the same transaction (AC-3.6): the close update and the\n// work item commit or roll back together.\nfunction closeTurnAndQueueWork(\n  ctx: OperationContext,\n  turnId: string,\n  eventOrder: number,\n): WorkItemRecord {\n  closeTurn(ctx.db, turnId, eventOrder);\n  return recordItem(\n    ctx.db,\n    { owner: \"turns\", kind: \"turn_derivation\", sourceRef: { turnId } },\n    ctx.clock().toISOString(),\n  );\n}\n\n// Cross-domain surface, called by intake-stream inside the batch transaction\n// for every recorded event. Synchronous and throwing by design, like\n// messages.createFromEvent: a turn-storage failure rejects the whole batch.\nexport function applyEvent(\n  ctx: OperationContext,\n  eventKind: EventKind,\n  eventOrder: number,\n): TurnTransitionOutcome {\n  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n  const effect = transition({ openTurnId }, eventKind);\n  switch (effect.kind) {\n    case \"none\":\n      return { transitions: [], openTurnId, queuedWork: [] };\n    case \"open\": {\n      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n      return {\n        transitions: [{ action: \"opened\", turnId }],\n        openTurnId: turnId,\n        queuedWork: [],\n      };\n    }\n    case \"close\": {\n      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n      return {\n        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n        openTurnId: null,\n        queuedWork: [item],\n      };\n    }\n    case \"close_then_open\": {\n      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n      return {\n        transitions: [\n          { action: \"closed\", turnId: openTurnId as string },\n          { action: \"opened\", turnId },\n        ],\n        openTurnId: turnId,\n        queuedWork: [item],\n      };\n    }\n  }\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nexport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: readTurns(db) };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`turn read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport async function listQueuedWork(\n  thread: ThreadRef,\n): Promise<OpResult<WorkItemRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: listItems(db, \"turns\") };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`queued-work read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":163,"startLine":1,"totalLines":163}}}

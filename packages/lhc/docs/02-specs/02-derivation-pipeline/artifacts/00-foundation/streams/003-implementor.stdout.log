{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MRtzADF5Hk7ugDmZhdHJ4E","type":"tool_result","content":"1\timport { randomBytes } from \"node:crypto\";\n2\timport { rmSync } from \"node:fs\";\n3\timport { DatabaseSync } from \"node:sqlite\";\n4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n5\timport {\n6\t  getSchemaVersion,\n7\t  openDatabase,\n8\t  runMigrations,\n9\t  type Migration,\n10\t} from \"../../../shared/storage.js\";\n11\timport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n12\t\n13\t// The one random id: its uniqueness scope is global across files and\n14\t// registries (design decision 7).\n15\texport function generateThreadId(): string {\n16\t  return `th_${randomBytes(8).toString(\"hex\")}`;\n17\t}\n18\t\n19\t// The thread-file schema as a versioned history, never rewritten in place:\n20\t// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n21\t// each later story appends a version. Existing files upgrade lazily through\n22\t// openThreadDatabase, so a file recorded under an earlier story is always\n23\t// usable by a later one (F-03-001).\n24\t//\n25\t// Creation-time metadata values are interpolated through buildThreadMigrations\n26\t// for new files only; existing files already hold their metadata row and the\n27\t// upgrade path never touches it.\n28\tfunction buildThreadMigrations(\n29\t  metadata?: { threadId: string; createdAt: string },\n30\t): Migration[] {\n31\t  const metadataInsert =\n32\t    metadata === undefined\n33\t      ? []\n34\t      : [\n35\t          // Interpolated values are all generated by us (hex id, ISO\n36\t          // timestamp, estimator constant) — never caller input.\n37\t          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n38\t           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n39\t        ];\n40\t  return [\n41\t    {\n42\t      version: 1,\n43\t      statements: [\n44\t        `CREATE TABLE thread_metadata (\n45\t          id INTEGER PRIMARY KEY CHECK (id = 1),\n46\t          thread_id TEXT NOT NULL,\n47\t          created_at TEXT NOT NULL,\n48\t          token_estimator TEXT NOT NULL\n49\t        );`,\n50\t        ...metadataInsert,\n51\t        `CREATE TABLE event (\n52\t          event_order INTEGER PRIMARY KEY,\n53\t          event_kind TEXT NOT NULL,\n54\t          idempotency_key TEXT NOT NULL UNIQUE,\n55\t          actor TEXT NOT NULL,\n56\t          harness TEXT NOT NULL,\n57\t          payload TEXT NOT NULL,\n58\t          recorded_at TEXT NOT NULL\n59\t        );`,\n60\t      ],\n61\t    },\n62\t    {\n63\t      version: 2, // Story 3: message projection\n64\t      statements: [\n65\t        `CREATE TABLE message (\n66\t          message_id TEXT PRIMARY KEY,\n67\t          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n68\t          kind TEXT NOT NULL,\n69\t          token_estimate INTEGER NOT NULL,\n70\t          actor TEXT NOT NULL,\n71\t          harness TEXT NOT NULL,\n72\t          turn_id TEXT\n73\t        );`,\n74\t        `CREATE TABLE message_block (\n75\t          message_id TEXT NOT NULL REFERENCES message(message_id),\n76\t          block_index INTEGER NOT NULL,\n77\t          block_type TEXT NOT NULL,\n78\t          content TEXT NOT NULL,\n79\t          PRIMARY KEY (message_id, block_index)\n80\t        );`,\n81\t      ],\n82\t    },\n83\t    {\n84\t      version: 3, // Story 4: turn state machine\n85\t      statements: [\n86\t        `CREATE TABLE turns (\n87\t          turn_id TEXT PRIMARY KEY,\n88\t          turn_order INTEGER NOT NULL UNIQUE,\n89\t          status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n90\t          opened_at_event_order INTEGER NOT NULL,\n91\t          closed_at_event_order INTEGER\n92\t        );`,\n93\t      ],\n94\t    },\n95\t    {\n96\t      version: 4, // Story 5: derivation work queueing\n97\t      statements: [\n98\t        // Work items live in the thread file and commit with the batch —\n99\t        // not a separate database, not a separate transaction. status is\n100\t        // unconstrained TEXT: this epic only ever writes 'queued'; the\n101\t        // claim/lease statuses are Epic 02's to add.\n102\t        `CREATE TABLE work_item (\n103\t          work_item_id TEXT PRIMARY KEY,\n104\t          owner TEXT NOT NULL,\n105\t          kind TEXT NOT NULL,\n106\t          source_ref TEXT NOT NULL,\n107\t          status TEXT NOT NULL,\n108\t          queued_at TEXT NOT NULL\n109\t        );`,\n110\t      ],\n111\t    },\n112\t  ];\n113\t}\n114\t\n115\tfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n116\t  return {\n117\t    ok: false,\n118\t    error: {\n119\t      errorClass: \"caller_error\",\n120\t      code: \"thread_not_found\",\n121\t      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n122\t    },\n123\t  };\n124\t}\n125\t\n126\tfunction errorDetail(cause: unknown): string {\n127\t  return cause instanceof Error ? cause.message : String(cause);\n128\t}\n129\t\n130\t// Identity check before any migration runs, on a read-only handle so an\n131\t// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n132\t// file always carries schema version >= 1 and the thread_metadata singleton\n133\t// row that creation wrote transactionally. Anything else — an empty\n134\t// database, an unrelated SQLite file, a non-database file — is rejected as a\n135\t// caller error, never adopted.\n136\tfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n137\t  let db: DatabaseSync | undefined;\n138\t  try {\n139\t    db = new DatabaseSync(filePath, { readOnly: true });\n140\t    if (getSchemaVersion(db) < 1) {\n141\t      return notAThreadFile(filePath, \"no lhc schema version\");\n142\t    }\n143\t    const table = db\n144\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n145\t      .get();\n146\t    if (table === undefined) {\n147\t      return notAThreadFile(filePath, \"no thread_metadata table\");\n148\t    }\n149\t    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n150\t    if (row === undefined) {\n151\t      return notAThreadFile(filePath, \"no thread metadata row\");\n152\t    }\n153\t    return { ok: true };\n154\t  } catch (cause) {\n155\t    const detail = errorDetail(cause);\n156\t    // SQLite refusing the file as a database is an identity failure, not an\n157\t    // environment failure; everything else stays a system error.\n158\t    if (detail.includes(\"not a database\")) {\n159\t      return notAThreadFile(filePath, detail);\n160\t    }\n161\t    return storageFailure(`could not inspect thread file: ${detail}`);\n162\t  } finally {\n163\t    db?.close();\n164\t  }\n165\t}\n166\t\n167\t// Opens a thread file and brings its schema to the current version before\n168\t// returning the handle. Every SDK operation on an existing thread file goes\n169\t// through here, so a pre-Story-3 file gains the message tables on its first\n170\t// open by newer code — but only after the file proves it is a thread file;\n171\t// migration never creates lhc schema on an arbitrary existing file. Each\n172\t// migration runs in its own transaction (storage helper), completing before\n173\t// any caller transaction begins.\n174\texport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n175\t  const valid = validateThreadFile(filePath);\n176\t  if (!valid.ok) return valid;\n177\t  let db: DatabaseSync;\n178\t  try {\n179\t    db = openDatabase(filePath);\n180\t  } catch (cause) {\n181\t    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n182\t  }\n183\t  try {\n184\t    runMigrations(db, buildThreadMigrations());\n185\t  } catch (cause) {\n186\t    db.close();\n187\t    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n188\t  }\n189\t  return { ok: true, value: db };\n190\t}\n191\t\n192\t// Schema v1 plus the metadata row land in one migration transaction, so the\n193\t// file either has its full schema and metadata row or creation fails whole.\n194\texport function createThreadFile(\n195\t  filePath: string,\n196\t  threadId: string,\n197\t  createdAt: string,\n198\t): void {\n199\t  const db = openDatabase(filePath);\n200\t  try {\n201\t    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n202\t  } finally {\n203\t    db.close();\n204\t  }\n205\t}\n206\t\n207\t// Compensation: removes the thread file and its WAL companions. Used when the\n208\t// registry insert fails after file creation (no registry row without its\n209\t// file) and when file creation itself fails partway.\n210\texport function deleteThreadFile(filePath: string): void {\n211\t  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n212\t    rmSync(`${filePath}${suffix}`, { force: true });\n213\t  }\n214\t}\n215\t"}]},"parent_tool_use_id":null,"session_id":"7698513f-2c28-4ac5-bcaf-f544bbac5176","uuid":"aa096c35-609c-41ad-9345-de5b16e1b12d","timestamp":"2026-06-11T03:02:23.799Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/threads/internal/create.ts","content":"import { randomBytes } from \"node:crypto\";\nimport { rmSync } from \"node:fs\";\nimport { DatabaseSync } from \"node:sqlite\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\nimport {\n  getSchemaVersion,\n  openDatabase,\n  runMigrations,\n  type Migration,\n} from \"../../../shared/storage.js\";\nimport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n\n// The one random id: its uniqueness scope is global across files and\n// registries (design decision 7).\nexport function generateThreadId(): string {\n  return `th_${randomBytes(8).toString(\"hex\")}`;\n}\n\n// The thread-file schema as a versioned history, never rewritten in place:\n// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n// each later story appends a version. Existing files upgrade lazily through\n// openThreadDatabase, so a file recorded under an earlier story is always\n// usable by a later one (F-03-001).\n//\n// Creation-time metadata values are interpolated through buildThreadMigrations\n// for new files only; existing files already hold their metadata row and the\n// upgrade path never touches it.\nfunction buildThreadMigrations(\n  metadata?: { threadId: string; createdAt: string },\n): Migration[] {\n  const metadataInsert =\n    metadata === undefined\n      ? []\n      : [\n          // Interpolated values are all generated by us (hex id, ISO\n          // timestamp, estimator constant) — never caller input.\n          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n        ];\n  return [\n    {\n      version: 1,\n      statements: [\n        `CREATE TABLE thread_metadata (\n          id INTEGER PRIMARY KEY CHECK (id = 1),\n          thread_id TEXT NOT NULL,\n          created_at TEXT NOT NULL,\n          token_estimator TEXT NOT NULL\n        );`,\n        ...metadataInsert,\n        `CREATE TABLE event (\n          event_order INTEGER PRIMARY KEY,\n          event_kind TEXT NOT NULL,\n          idempotency_key TEXT NOT NULL UNIQUE,\n          actor TEXT NOT NULL,\n          harness TEXT NOT NULL,\n          payload TEXT NOT NULL,\n          recorded_at TEXT NOT NULL\n        );`,\n      ],\n    },\n    {\n      version: 2, // Story 3: message projection\n      statements: [\n        `CREATE TABLE message (\n          message_id TEXT PRIMARY KEY,\n          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n          kind TEXT NOT NULL,\n          token_estimate INTEGER NOT NULL,\n          actor TEXT NOT NULL,\n          harness TEXT NOT NULL,\n          turn_id TEXT\n        );`,\n        `CREATE TABLE message_block (\n          message_id TEXT NOT NULL REFERENCES message(message_id),\n          block_index INTEGER NOT NULL,\n          block_type TEXT NOT NULL,\n          content TEXT NOT NULL,\n          PRIMARY KEY (message_id, block_index)\n        );`,\n      ],\n    },\n    {\n      version: 3, // Story 4: turn state machine\n      statements: [\n        `CREATE TABLE turns (\n          turn_id TEXT PRIMARY KEY,\n          turn_order INTEGER NOT NULL UNIQUE,\n          status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n          opened_at_event_order INTEGER NOT NULL,\n          closed_at_event_order INTEGER\n        );`,\n      ],\n    },\n    {\n      version: 4, // Story 5: derivation work queueing\n      statements: [\n        // Work items live in the thread file and commit with the batch —\n        // not a separate database, not a separate transaction. status is\n        // unconstrained TEXT: this epic only ever writes 'queued'; the\n        // claim/lease statuses are Epic 02's to add.\n        `CREATE TABLE work_item (\n          work_item_id TEXT PRIMARY KEY,\n          owner TEXT NOT NULL,\n          kind TEXT NOT NULL,\n          source_ref TEXT NOT NULL,\n          status TEXT NOT NULL,\n          queued_at TEXT NOT NULL\n        );`,\n      ],\n    },\n  ];\n}\n\nfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n    },\n  };\n}\n\nfunction errorDetail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n// Identity check before any migration runs, on a read-only handle so an\n// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n// file always carries schema version >= 1 and the thread_metadata singleton\n// row that creation wrote transactionally. Anything else — an empty\n// database, an unrelated SQLite file, a non-database file — is rejected as a\n// caller error, never adopted.\nfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n  let db: DatabaseSync | undefined;\n  try {\n    db = new DatabaseSync(filePath, { readOnly: true });\n    if (getSchemaVersion(db) < 1) {\n      return notAThreadFile(filePath, \"no lhc schema version\");\n    }\n    const table = db\n      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n      .get();\n    if (table === undefined) {\n      return notAThreadFile(filePath, \"no thread_metadata table\");\n    }\n    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n    if (row === undefined) {\n      return notAThreadFile(filePath, \"no thread metadata row\");\n    }\n    return { ok: true };\n  } catch (cause) {\n    const detail = errorDetail(cause);\n    // SQLite refusing the file as a database is an identity failure, not an\n    // environment failure; everything else stays a system error.\n    if (detail.includes(\"not a database\")) {\n      return notAThreadFile(filePath, detail);\n    }\n    return storageFailure(`could not inspect thread file: ${detail}`);\n  } finally {\n    db?.close();\n  }\n}\n\n// Opens a thread file and brings its schema to the current version before\n// returning the handle. Every SDK operation on an existing thread file goes\n// through here, so a pre-Story-3 file gains the message tables on its first\n// open by newer code — but only after the file proves it is a thread file;\n// migration never creates lhc schema on an arbitrary existing file. Each\n// migration runs in its own transaction (storage helper), completing before\n// any caller transaction begins.\nexport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n  const valid = validateThreadFile(filePath);\n  if (!valid.ok) return valid;\n  let db: DatabaseSync;\n  try {\n    db = openDatabase(filePath);\n  } catch (cause) {\n    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n  }\n  try {\n    runMigrations(db, buildThreadMigrations());\n  } catch (cause) {\n    db.close();\n    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n  }\n  return { ok: true, value: db };\n}\n\n// Schema v1 plus the metadata row land in one migration transaction, so the\n// file either has its full schema and metadata row or creation fails whole.\nexport function createThreadFile(\n  filePath: string,\n  threadId: string,\n  createdAt: string,\n): void {\n  const db = openDatabase(filePath);\n  try {\n    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n  } finally {\n    db.close();\n  }\n}\n\n// Compensation: removes the thread file and its WAL companions. Used when the\n// registry insert fails after file creation (no registry row without its\n// file) and when file creation itself fails partway.\nexport function deleteThreadFile(filePath: string): void {\n  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n    rmSync(`${filePath}${suffix}`, { force: true });\n  }\n}\n","numLines":215,"startLine":1,"totalLines":215}}}

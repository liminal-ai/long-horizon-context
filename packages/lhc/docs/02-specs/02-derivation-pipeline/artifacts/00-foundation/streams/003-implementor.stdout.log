{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VZBfxVPiY2vbD5Wbpx4KfH","type":"tool_result","content":"1\t// Builds a thread file with the accepted Story 2 on-disk schema (commit\n2\t// 7c8623d): thread_metadata + event tables only, PRAGMA user_version = 1.\n3\t// Current code can no longer create this shape — that is the point: the\n4\t// fixture stands in for a real file recorded before Story 3 shipped, so the\n5\t// lazy upgrade path (F-03-001) is exercised against the true legacy layout.\n6\t// Below-SDK writer, sanctioned for the same reason corrupt.ts is: the state\n7\t// is unreachable through the current SDK.\n8\timport { DatabaseSync } from \"node:sqlite\";\n9\t\n10\texport interface LegacyRecordedEvent {\n11\t  eventOrder: number;\n12\t  eventKind: string;\n13\t  idempotencyKey: string;\n14\t  actor: string;\n15\t  harness: string;\n16\t  payload: Record<string, unknown>;\n17\t  recordedAt: string;\n18\t}\n19\t\n20\texport function legacyStory2ThreadFile(\n21\t  filePath: string,\n22\t  threadId: string,\n23\t  recordedEvents: readonly LegacyRecordedEvent[] = [],\n24\t): void {\n25\t  const db = new DatabaseSync(filePath);\n26\t  try {\n27\t    db.exec(\"PRAGMA journal_mode = WAL;\");\n28\t    db.exec(\"BEGIN IMMEDIATE;\");\n29\t    db.exec(`CREATE TABLE thread_metadata (\n30\t      id INTEGER PRIMARY KEY CHECK (id = 1),\n31\t      thread_id TEXT NOT NULL,\n32\t      created_at TEXT NOT NULL,\n33\t      token_estimator TEXT NOT NULL\n34\t    );`);\n35\t    db.prepare(\n36\t      `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n37\t       VALUES (1, ?, ?, 'js-tiktoken:o200k_base')`,\n38\t    ).run(threadId, \"2026-06-01T00:00:00.000Z\");\n39\t    db.exec(`CREATE TABLE event (\n40\t      event_order INTEGER PRIMARY KEY,\n41\t      event_kind TEXT NOT NULL,\n42\t      idempotency_key TEXT NOT NULL UNIQUE,\n43\t      actor TEXT NOT NULL,\n44\t      harness TEXT NOT NULL,\n45\t      payload TEXT NOT NULL,\n46\t      recorded_at TEXT NOT NULL\n47\t    );`);\n48\t    const insert = db.prepare(\n49\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n50\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n51\t    );\n52\t    for (const event of recordedEvents) {\n53\t      insert.run(\n54\t        event.eventOrder,\n55\t        event.eventKind,\n56\t        event.idempotencyKey,\n57\t        event.actor,\n58\t        event.harness,\n59\t        JSON.stringify(event.payload),\n60\t        event.recordedAt,\n61\t      );\n62\t    }\n63\t    db.exec(\"PRAGMA user_version = 1;\");\n64\t    db.exec(\"COMMIT;\");\n65\t  } finally {\n66\t    db.close();\n67\t  }\n68\t}\n69\t\n70\texport function schemaVersionOf(filePath: string): number {\n71\t  const db = new DatabaseSync(filePath);\n72\t  try {\n73\t    const row = db.prepare(\"PRAGMA user_version\").get() as\n74\t      | { user_version: number | bigint }\n75\t      | undefined;\n76\t    return Number(row?.user_version ?? 0);\n77\t  } finally {\n78\t    db.close();\n79\t  }\n80\t}\n81\t"}]},"parent_tool_use_id":null,"session_id":"7698513f-2c28-4ac5-bcaf-f544bbac5176","uuid":"f298514a-be7f-4b69-9f07-d21a6fb03c7f","timestamp":"2026-06-11T03:04:39.330Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/legacy.ts","content":"// Builds a thread file with the accepted Story 2 on-disk schema (commit\n// 7c8623d): thread_metadata + event tables only, PRAGMA user_version = 1.\n// Current code can no longer create this shape — that is the point: the\n// fixture stands in for a real file recorded before Story 3 shipped, so the\n// lazy upgrade path (F-03-001) is exercised against the true legacy layout.\n// Below-SDK writer, sanctioned for the same reason corrupt.ts is: the state\n// is unreachable through the current SDK.\nimport { DatabaseSync } from \"node:sqlite\";\n\nexport interface LegacyRecordedEvent {\n  eventOrder: number;\n  eventKind: string;\n  idempotencyKey: string;\n  actor: string;\n  harness: string;\n  payload: Record<string, unknown>;\n  recordedAt: string;\n}\n\nexport function legacyStory2ThreadFile(\n  filePath: string,\n  threadId: string,\n  recordedEvents: readonly LegacyRecordedEvent[] = [],\n): void {\n  const db = new DatabaseSync(filePath);\n  try {\n    db.exec(\"PRAGMA journal_mode = WAL;\");\n    db.exec(\"BEGIN IMMEDIATE;\");\n    db.exec(`CREATE TABLE thread_metadata (\n      id INTEGER PRIMARY KEY CHECK (id = 1),\n      thread_id TEXT NOT NULL,\n      created_at TEXT NOT NULL,\n      token_estimator TEXT NOT NULL\n    );`);\n    db.prepare(\n      `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n       VALUES (1, ?, ?, 'js-tiktoken:o200k_base')`,\n    ).run(threadId, \"2026-06-01T00:00:00.000Z\");\n    db.exec(`CREATE TABLE event (\n      event_order INTEGER PRIMARY KEY,\n      event_kind TEXT NOT NULL,\n      idempotency_key TEXT NOT NULL UNIQUE,\n      actor TEXT NOT NULL,\n      harness TEXT NOT NULL,\n      payload TEXT NOT NULL,\n      recorded_at TEXT NOT NULL\n    );`);\n    const insert = db.prepare(\n      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    );\n    for (const event of recordedEvents) {\n      insert.run(\n        event.eventOrder,\n        event.eventKind,\n        event.idempotencyKey,\n        event.actor,\n        event.harness,\n        JSON.stringify(event.payload),\n        event.recordedAt,\n      );\n    }\n    db.exec(\"PRAGMA user_version = 1;\");\n    db.exec(\"COMMIT;\");\n  } finally {\n    db.close();\n  }\n}\n\nexport function schemaVersionOf(filePath: string): number {\n  const db = new DatabaseSync(filePath);\n  try {\n    const row = db.prepare(\"PRAGMA user_version\").get() as\n      | { user_version: number | bigint }\n      | undefined;\n    return Number(row?.user_version ?? 0);\n  } finally {\n    db.close();\n  }\n}\n","numLines":81,"startLine":1,"totalLines":81}}}

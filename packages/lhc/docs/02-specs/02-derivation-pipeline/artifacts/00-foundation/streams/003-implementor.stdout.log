{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FE29P5ZaMPCHCmnNjXyre4","type":"tool_result","content":"1\texport type ErrorClass = \"caller_error\" | \"state_corruption\" | \"system_error\";\n2\t\n3\texport type ErrorCode =\n4\t  | \"path_exists\"\n5\t  | \"thread_not_found\"\n6\t  | \"invalid_thread_ref\" // empty/blank file path or otherwise unusable reference\n7\t  | \"invalid_event\"\n8\t  | \"empty_batch\"\n9\t  | \"empty_stdin\" // CLI adapter only, emitted before any SDK call\n10\t  | \"turn_state_corrupt\"\n11\t  | \"storage_failure\";\n12\t\n13\texport interface ErrorResult {\n14\t  errorClass: ErrorClass;\n15\t  code: ErrorCode;\n16\t  reason: string; // human-readable; machine logic switches on code\n17\t  eventIndex?: number; // present on batch validation failures\n18\t}\n19\t\n20\t// Expected operational failures — caller errors, corruption, environment\n21\t// failures — are always returned as OpResult errors, never thrown.\n22\t// Programmer bugs inside lhc may still throw; callers are not expected\n23\t// to handle throws as contract outcomes.\n24\texport type OpResult<T> =\n25\t  | { ok: true; value: T }\n26\t  | { ok: false; error: ErrorResult };\n27\t\n28\t// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n29\t// caught at the operation boundary and wrapped with the underlying detail.\n30\texport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n31\t  return {\n32\t    ok: false,\n33\t    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n34\t  };\n35\t}\n36\t"}]},"parent_tool_use_id":null,"session_id":"7698513f-2c28-4ac5-bcaf-f544bbac5176","uuid":"6d22d297-56ae-47ca-88e7-7fa5eed99f10","timestamp":"2026-06-11T03:02:10.264Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/errors.ts","content":"export type ErrorClass = \"caller_error\" | \"state_corruption\" | \"system_error\";\n\nexport type ErrorCode =\n  | \"path_exists\"\n  | \"thread_not_found\"\n  | \"invalid_thread_ref\" // empty/blank file path or otherwise unusable reference\n  | \"invalid_event\"\n  | \"empty_batch\"\n  | \"empty_stdin\" // CLI adapter only, emitted before any SDK call\n  | \"turn_state_corrupt\"\n  | \"storage_failure\";\n\nexport interface ErrorResult {\n  errorClass: ErrorClass;\n  code: ErrorCode;\n  reason: string; // human-readable; machine logic switches on code\n  eventIndex?: number; // present on batch validation failures\n}\n\n// Expected operational failures — caller errors, corruption, environment\n// failures — are always returned as OpResult errors, never thrown.\n// Programmer bugs inside lhc may still throw; callers are not expected\n// to handle throws as contract outcomes.\nexport type OpResult<T> =\n  | { ok: true; value: T }\n  | { ok: false; error: ErrorResult };\n\n// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n// caught at the operation boundary and wrapped with the underlying detail.\nexport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n  };\n}\n","numLines":36,"startLine":1,"totalLines":36}}}

{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/messages/index.ts'","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport type { OperationContext } from \"../../shared/context.js\";\n     3\timport type { FormKind, WorkHandler } from \"../../shared/derivation.js\";\n     4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     5\timport {\n     6\t  enqueue,\n     7\t  listItems,\n     8\t  type WorkItemRecord,\n     9\t  type WorkKind,\n    10\t} from \"../../tech-utils/work-queue/index.js\";\n    11\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n    12\timport {\n    13\t  openThreadDatabase,\n    14\t  resolveThreadRef,\n    15\t  type ThreadRef,\n    16\t} from \"../threads/index.js\";\n    17\timport { projectEvent } from \"./internal/project.js\";\n    18\timport { insertMessage, readMessages } from \"./internal/store.js\";\n    19\t\n    20\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n    21\t\n    22\texport interface Block {\n    23\t  blockType: BlockType;\n    24\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n    25\t}\n    26\t\n    27\texport interface MessageRecord {\n    28\t  messageId: string;\n    29\t  sourceEventOrder: number;\n    30\t  kind: Exclude<EventKind, \"turn_end\">;\n    31\t  blocks: Block[];\n    32\t  tokenEstimate: number;\n    33\t  actor: string;\n    34\t  harness: string;\n    35\t  turnId?: string;\n    36\t}\n    37\t\n    38\t// The event as the walk holds it after recording: the validated input plus\n    39\t// its server-stamped order and timestamp.\n    40\texport type RecordedEvent = EventRecord;\n    41\t\n    42\texport type MessageCreated = {\n    43\t  messageId: string;\n    44\t  kind: Exclude<EventKind, \"turn_end\">;\n    45\t} | null;\n    46\t\n    47\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    48\t// (the first such call through the operation context; turns.applyEvent\n    49\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n    50\t// projection failure propagates to the pipeline's catch and rejects the\n    51\t// whole batch — recorded events without messages is the stranded state the\n    52\t// transaction exists to prevent. Returns null for turn_end (no message).\n    53\t// turnId is the membership stamp, settled by the pipeline before this call:\n    54\t// the turn open *after* this event's transition (so a prompt belongs to the\n    55\t// turn it just opened), or null in a gap — written once, never updated.\n    56\texport function createFromEvent(\n    57\t  ctx: OperationContext,\n    58\t  event: RecordedEvent,\n    59\t  turnId: string | null,\n    60\t): MessageCreated {\n    61\t  const projected = projectEvent(event);\n    62\t  if (projected === null) return null;\n    63\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n    64\t  const messageId = `m${event.eventOrder}`;\n    65\t  insertMessage(ctx.db, {\n    66\t    messageId,\n    67\t    sourceEventOrder: event.eventOrder,\n    68\t    kind,\n    69\t    tokenEstimate: projected.tokenEstimate,\n    70\t    actor: event.actor,\n    71\t    harness: event.harness,\n    72\t    turnId,\n    73\t    blocks: projected.blocks,\n    74\t  });\n    75\t  return { messageId, kind };\n    76\t}\n    77\t\n    78\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n    79\t// result queues tool_result_summary, nothing else queues anything — text,\n    80\t// thinking, and note messages are not derivation sources (AC-2.8, AC-2.7's\n    81\t// TC-2.9 half). Cross-domain surface, called by intake-stream inside the\n    82\t// batch transaction for every recorded message, so the item commits (or\n    83\t// rolls back) with the batch.\n    84\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n    85\t  user_prompt: \"prompt_smoothing\",\n    86\t  tool_result: \"tool_result_summary\",\n    87\t};\n    88\t\n    89\t// Which derived form each message-owned kind produces — the owning domain's\n    90\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n    91\t// rides the same transaction (DD-5).\n    92\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n    93\t  prompt_smoothing: \"smoothed_prompt\",\n    94\t  tool_call_summary: \"tool_call_summary\",\n    95\t  tool_result_summary: \"tool_result_summary\",\n    96\t};\n    97\t\n    98\t// Message-owned work handlers, merged into the SDK's dispatch map at\n    99\t// construction (DD-6). Empty until Story 2 lands prompt smoothing and the\n   100\t// two tool summaries.\n   101\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {};\n   102\t\n   103\texport function queueMessageWork(\n   104\t  ctx: OperationContext,\n   105\t  message: MessageCreated,\n   106\t): WorkItemRecord[] {\n   107\t  if (message === null) return [];\n   108\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n   109\t  if (kind === undefined) return [];\n   110\t  const form = MESSAGE_WORK_FORMS[kind];\n   111\t  if (form === undefined) {\n   112\t    // Every queuing kind names its form above; a miss is a wiring bug.\n   113\t    throw new Error(`no derived form mapped for message work kind ${kind}`);\n   114\t  }\n   115\t  const item = enqueue(ctx, {\n   116\t    owner: \"messages\",\n   117\t    kind,\n   118\t    sourceRef: { messageId: message.messageId },\n   119\t    forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n   120\t  });\n   121\t  return [item];\n   122\t}\n   123\t\n   124\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   125\t  return {\n   126\t    ok: false,\n   127\t    error: {\n   128\t      errorClass: \"caller_error\",\n   129\t      code: \"thread_not_found\",\n   130\t      reason: `no thread file exists at ${filePath}`,\n   131\t    },\n   132\t  };\n   133\t}\n   134\t\n   135\texport async function listMessages(\n   136\t  thread: ThreadRef,\n   137\t): Promise<OpResult<MessageRecord[]>> {\n   138\t  const resolved = await resolveThreadRef(thread);\n   139\t  if (!resolved.ok) return resolved;\n   140\t  const { filePath } = resolved.value;\n   141\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   142\t\n   143\t  // openThreadDatabase verifies the file is a real thread file and migrates\n   144\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n   145\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n   146\t  // unmutated (F-03-002).\n   147\t  const opened = openThreadDatabase(filePath);\n   148\t  if (!opened.ok) return opened;\n   149\t  const db = opened.value;\n   150\t  try {\n   151\t    return { ok: true, value: readMessages(db) };\n   152\t  } catch (cause) {\n   153\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   154\t    return storageFailure(`message read-back failed: ${reason}`);\n   155\t  } finally {\n   156\t    db.close();\n   157\t  }\n   158\t}\n   159\t\n   160\texport async function listQueuedWork(\n   161\t  thread: ThreadRef,\n   162\t): Promise<OpResult<WorkItemRecord[]>> {\n   163\t  const resolved = await resolveThreadRef(thread);\n   164\t  if (!resolved.ok) return resolved;\n   165\t  const { filePath } = resolved.value;\n   166\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   167\t\n   168\t  const opened = openThreadDatabase(filePath);\n   169\t  if (!opened.ok) return opened;\n   170\t  const db = opened.value;\n   171\t  try {\n   172\t    return { ok: true, value: listItems(db, \"messages\") };\n   173\t  } catch (cause) {\n   174\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   175\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   176\t  } finally {\n   177\t    db.close();\n   178\t  }\n   179\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/turns/index.ts'","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport type { OperationContext } from \"../../shared/context.js\";\n     3\timport type { WorkHandler } from \"../../shared/derivation.js\";\n     4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     5\timport {\n     6\t  enqueue,\n     7\t  listItems,\n     8\t  type WorkItemRecord,\n     9\t  type WorkKind,\n    10\t} from \"../../tech-utils/work-queue/index.js\";\n    11\timport type { EventKind } from \"../intake-stream/index.js\";\n    12\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n    13\timport { transition } from \"./internal/state-machine.js\";\n    14\t\n    15\t// The pure rule table, re-exported for the golden supplemental suite (the\n    16\t// test plan's one sanctioned direct entry besides the tokenizer); production\n    17\t// callers go through applyEvent.\n    18\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n    19\timport {\n    20\t  closeTurn,\n    21\t  insertOpenTurn,\n    22\t  nextTurnOrder,\n    23\t  readTurns,\n    24\t  selectOpenTurnIds,\n    25\t} from \"./internal/store.js\";\n    26\t\n    27\texport interface TurnRecord {\n    28\t  turnId: string;\n    29\t  status: \"open\" | \"closed\";\n    30\t  memberMessageIds: string[];\n    31\t  openedAtEventOrder: number;\n    32\t  closedAtEventOrder?: number;\n    33\t}\n    34\t\n    35\texport interface TurnTransitionOutcome {\n    36\t  // Transitions in occurrence order: a close_then_open reports the close\n    37\t  // first, then the open, exactly as the batch result surfaces them.\n    38\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n    39\t  // Turn state after the transition — the stamp for this event's message.\n    40\t  // Prompts see the turn they just opened (transition first, then stamp);\n    41\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n    42\t  openTurnId: string | null;\n    43\t  // Work queued by this transition: one turn_derivation item per closed\n    44\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\n    45\t  queuedWork: WorkItemRecord[];\n    46\t}\n    47\t\n    48\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n    49\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n    50\t// writes turn state, so more than one open turn means external interference.\n    51\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n    52\t  return selectOpenTurnIds(ctx.db);\n    53\t}\n    54\t\n    55\t// Closing a turn — by either close path — durably queues that turn's\n    56\t// derivation work in the same transaction (AC-3.6): the close update and the\n    57\t// work item commit or roll back together.\n    58\tfunction closeTurnAndQueueWork(\n    59\t  ctx: OperationContext,\n    60\t  turnId: string,\n    61\t  eventOrder: number,\n    62\t): WorkItemRecord {\n    63\t  closeTurn(ctx.db, turnId, eventOrder);\n    64\t  // One work item, two derived forms: the turn_derivation handler (Story 3)\n    65\t  // lands the rendering and the lower-band projection as independent rows;\n    66\t  // both go pending with the enqueue (DD-5).\n    67\t  return enqueue(ctx, {\n    68\t    owner: \"turns\",\n    69\t    kind: \"turn_derivation\",\n    70\t    sourceRef: { turnId },\n    71\t    forms: [\n    72\t      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n    73\t      { subjectKind: \"turn\", subjectId: turnId, form: \"lower_band_projection\" },\n    74\t    ],\n    75\t  });\n    76\t}\n    77\t\n    78\t// Turn-owned work handlers, merged into the SDK's dispatch map at\n    79\t// construction (DD-6). Empty until Story 3 lands turn derivation and the\n    80\t// chunk summaries.\n    81\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {};\n    82\t\n    83\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    84\t// for every recorded event. Synchronous and throwing by design, like\n    85\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n    86\texport function applyEvent(\n    87\t  ctx: OperationContext,\n    88\t  eventKind: EventKind,\n    89\t  eventOrder: number,\n    90\t): TurnTransitionOutcome {\n    91\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n    92\t  const effect = transition({ openTurnId }, eventKind);\n    93\t  switch (effect.kind) {\n    94\t    case \"none\":\n    95\t      return { transitions: [], openTurnId, queuedWork: [] };\n    96\t    case \"open\": {\n    97\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n    98\t      return {\n    99\t        transitions: [{ action: \"opened\", turnId }],\n   100\t        openTurnId: turnId,\n   101\t        queuedWork: [],\n   102\t      };\n   103\t    }\n   104\t    case \"close\": {\n   105\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   106\t      return {\n   107\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n   108\t        openTurnId: null,\n   109\t        queuedWork: [item],\n   110\t      };\n   111\t    }\n   112\t    case \"close_then_open\": {\n   113\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   114\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   115\t      return {\n   116\t        transitions: [\n   117\t          { action: \"closed\", turnId: openTurnId as string },\n   118\t          { action: \"opened\", turnId },\n   119\t        ],\n   120\t        openTurnId: turnId,\n   121\t        queuedWork: [item],\n   122\t      };\n   123\t    }\n   124\t  }\n   125\t}\n   126\t\n   127\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   128\t  return {\n   129\t    ok: false,\n   130\t    error: {\n   131\t      errorClass: \"caller_error\",\n   132\t      code: \"thread_not_found\",\n   133\t      reason: `no thread file exists at ${filePath}`,\n   134\t    },\n   135\t  };\n   136\t}\n   137\t\n   138\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n   139\t  const resolved = await resolveThreadRef(thread);\n   140\t  if (!resolved.ok) return resolved;\n   141\t  const { filePath } = resolved.value;\n   142\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   143\t\n   144\t  const opened = openThreadDatabase(filePath);\n   145\t  if (!opened.ok) return opened;\n   146\t  const db = opened.value;\n   147\t  try {\n   148\t    return { ok: true, value: readTurns(db) };\n   149\t  } catch (cause) {\n   150\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   151\t    return storageFailure(`turn read-back failed: ${reason}`);\n   152\t  } finally {\n   153\t    db.close();\n   154\t  }\n   155\t}\n   156\t\n   157\texport async function listQueuedWork(\n   158\t  thread: ThreadRef,\n   159\t): Promise<OpResult<WorkItemRecord[]>> {\n   160\t  const resolved = await resolveThreadRef(thread);\n   161\t  if (!resolved.ok) return resolved;\n   162\t  const { filePath } = resolved.value;\n   163\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   164\t\n   165\t  const opened = openThreadDatabase(filePath);\n   166\t  if (!opened.ok) return opened;\n   167\t  const db = opened.value;\n   168\t  try {\n   169\t    return { ok: true, value: listItems(db, \"turns\") };\n   170\t  } catch (cause) {\n   171\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   172\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   173\t  } finally {\n   174\t    db.close();\n   175\t  }\n   176\t}\n","exit_code":0,"status":"completed"}}

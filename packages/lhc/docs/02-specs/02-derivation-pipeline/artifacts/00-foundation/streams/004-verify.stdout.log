{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/scheduler.ts'","aggregated_output":"     1\t// SDK-internal scheduler (DD-4) — Story 0 skeleton. Manual mode is complete\n     2\t// in this story: enqueue's onCommit poke fires (shared/context.ts owns the\n     3\t// poke seam), and the scheduler does nothing with it — draining is an\n     4\t// explicit caller operation. Background mode's single-flight / coalesce /\n     5\t// catch-up machinery is Story 1's; the mode flag exists now so createSdk\n     6\t// validates its config shape from day one. This module must import domain\n     7\t// surfaces only through domains/*/index.ts when Story 1 wires the drain.\n     8\texport type SchedulerMode = \"background\" | \"manual\";\n     9\t\n    10\texport interface Scheduler {\n    11\t  readonly mode: SchedulerMode;\n    12\t  // Post-commit nudge that work was queued for a thread. Manual mode: no-op\n    13\t  // by contract (DD-5). Background mode: drain scheduling lands in Story 1;\n    14\t  // until then the poke is received and deliberately not acted on — there is\n    15\t  // no drain to fake (fail-closed: no pretend scheduling).\n    16\t  poke(threadId: string): void;\n    17\t}\n    18\t\n    19\texport function createScheduler(mode: SchedulerMode): Scheduler {\n    20\t  return {\n    21\t    mode,\n    22\t    poke(_threadId: string): void {\n    23\t      // Story 1 fills this in for background mode.\n    24\t    },\n    25\t  };\n    26\t}\n","exit_code":0,"status":"completed"}}

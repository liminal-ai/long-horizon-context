{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/tech-utils/work-queue/index.ts'","aggregated_output":"     1\t// Durable work-item mechanics: recording, ordered listing, and the enqueue\n     2\t// wrapper that makes \"queueing is what schedules processing\" structural\n     3\t// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n     4\t// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n     5\t// a turn or a summary is; which kinds queue for which sources, and which\n     6\t// derived forms a kind produces, is the owning domains' business (callers\n     7\t// pass the form targets in). Writes run on the caller's handle inside the\n     8\t// ambient transaction, so items commit (or roll back) with the batch. No\n     9\t// public SDK surface: read-back reaches here only through the owning\n    10\t// domains' listQueuedWork.\n    11\timport type { DatabaseSync } from \"node:sqlite\";\n    12\timport { fireSchedulerPoke, type OperationContext } from \"../../shared/context.js\";\n    13\timport type { FormKind, SubjectKind } from \"../../shared/derivation.js\";\n    14\t\n    15\texport type WorkOwner = \"messages\" | \"turns\";\n    16\texport type WorkKind =\n    17\t  | \"prompt_smoothing\"\n    18\t  | \"tool_call_summary\"\n    19\t  | \"tool_result_summary\"\n    20\t  | \"turn_derivation\"\n    21\t  | \"chunk_summary_detailed\"\n    22\t  | \"chunk_summary_brief\";\n    23\texport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n    24\t\n    25\t// The work-kind registry: owner and sourceRef semantics per the epic's Work\n    26\t// Item contract. Mechanical metadata only — what a kind *means* stays with\n    27\t// the owning domain's handler (registered at SDK construction, DD-6).\n    28\texport const WORK_KIND_REGISTRY: Readonly<\n    29\t  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n    30\t> = {\n    31\t  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    32\t  tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    33\t  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    34\t  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n    35\t  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n    36\t  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n    37\t};\n    38\t\n    39\texport interface WorkItemRecord {\n    40\t  workItemId: string;\n    41\t  owner: WorkOwner;\n    42\t  kind: WorkKind;\n    43\t  sourceRef: WorkSourceRef;\n    44\t  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n    45\t  queuedAt: string;\n    46\t}\n    47\t\n    48\texport interface WorkItemInput {\n    49\t  owner: WorkOwner;\n    50\t  kind: WorkKind;\n    51\t  sourceRef: WorkSourceRef;\n    52\t  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n    53\t}\n    54\t\n    55\tfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n    56\t  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n    57\t  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n    58\t  return sourceRef.chunkId;\n    59\t}\n    60\t\n    61\t// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n    62\t// same kind for the same source *at the same version* is the same id —\n    63\t// natural idempotency for the repair path — while a post-mutation\n    64\t// replacement (next version) never collides with an in-flight pre-mutation\n    65\t// item.\n    66\texport function recordItem(\n    67\t  db: DatabaseSync,\n    68\t  input: WorkItemInput,\n    69\t  queuedAt: string,\n    70\t): WorkItemRecord {\n    71\t  const sourceVersion = input.sourceVersion ?? 1;\n    72\t  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n    73\t  db.prepare(\n    74\t    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n    75\t     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n    76\t  ).run(\n    77\t    workItemId,\n    78\t    input.owner,\n    79\t    input.kind,\n    80\t    JSON.stringify(input.sourceRef),\n    81\t    queuedAt,\n    82\t    JSON.stringify({ sourceVersion }),\n    83\t  );\n    84\t  return {\n    85\t    workItemId,\n    86\t    owner: input.owner,\n    87\t    kind: input.kind,\n    88\t    sourceRef: input.sourceRef,\n    89\t    status: \"queued\",\n    90\t    queuedAt,\n    91\t  };\n    92\t}\n    93\t\n    94\t// The derived forms an enqueue is scheduling work toward; the owning domain\n    95\t// names them (the util stays meaning-blind).\n    96\texport interface EnqueueFormTarget {\n    97\t  subjectKind: SubjectKind;\n    98\t  subjectId: string;\n    99\t  form: FormKind;\n   100\t}\n   101\t\n   102\texport interface EnqueueInput extends WorkItemInput {\n   103\t  forms: readonly EnqueueFormTarget[];\n   104\t}\n   105\t\n   106\t// The one way work is scheduled (DD-5): the work row, the form's `pending`\n   107\t// state row, and the scheduler poke all ride the ambient transaction — they\n   108\t// commit together or vanish together. Enqueue is the *only* place a\n   109\t// derived_form row is created (completion is UPDATE-only); re-enqueueing\n   110\t// resets an existing row to pending at the enqueued source version.\n   111\texport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n   112\t  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n   113\t  const sourceVersion = input.sourceVersion ?? 1;\n   114\t  const upsert = ctx.db.prepare(\n   115\t    `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n   116\t     VALUES (?, ?, ?, 'pending', ?)\n   117\t     ON CONFLICT (subject_kind, subject_id, form) DO UPDATE SET\n   118\t       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n   119\t       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n   120\t  );\n   121\t  for (const target of input.forms) {\n   122\t    upsert.run(target.subjectKind, target.subjectId, target.form, sourceVersion);\n   123\t  }\n   124\t  ctx.onCommit(() => fireSchedulerPoke(ctx.threadId));\n   125\t  return item;\n   126\t}\n   127\t\n   128\tinterface RawWorkItemRow {\n   129\t  work_item_id: string;\n   130\t  owner: string;\n   131\t  kind: string;\n   132\t  source_ref: string;\n   133\t  queued_at: string;\n   134\t}\n   135\t\n   136\t// Listing in queue order (insertion order within the walk); each owning\n   137\t// domain lists only its own items.\n   138\texport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n   139\t  const rows = db\n   140\t    .prepare(\n   141\t      `SELECT work_item_id, owner, kind, source_ref, queued_at\n   142\t       FROM work_item WHERE owner = ? ORDER BY rowid`,\n   143\t    )\n   144\t    .all(owner) as unknown as RawWorkItemRow[];\n   145\t  return rows.map((row) => ({\n   146\t    workItemId: row.work_item_id,\n   147\t    owner: row.owner as WorkOwner,\n   148\t    kind: row.kind as WorkKind,\n   149\t    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n   150\t    status: \"queued\",\n   151\t    queuedAt: row.queued_at,\n   152\t  }));\n   153\t}\n","exit_code":0,"status":"completed"}}

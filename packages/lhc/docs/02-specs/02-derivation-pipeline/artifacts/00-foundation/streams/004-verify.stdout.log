{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/shared/context.ts'","aggregated_output":"     1\timport type { DatabaseSync } from \"node:sqlite\";\n     2\t\n     3\texport interface OperationContext {\n     4\t  db: DatabaseSync; // open thread-file handle, inside the batch transaction\n     5\t  clock: () => Date; // injected for deterministic recordedAt/queuedAt in tests\n     6\t  threadId: string; // resolved identity of the thread being operated on\n     7\t  // Post-commit callback registration (DD-5): the transaction owner flushes\n     8\t  // the registered callbacks after its COMMIT succeeds and drops them on\n     9\t  // rollback, so anything registered here — the scheduler poke above all —\n    10\t  // is transactional by construction.\n    11\t  onCommit: (fn: () => void) => void;\n    12\t}\n    13\t\n    14\t// The callback list behind ctx.onCommit, owned by whoever owns the\n    15\t// transaction. Flush after COMMIT; never call flush on a rollback path —\n    16\t// dropping the hooks is simply not flushing them.\n    17\texport interface CommitHooks {\n    18\t  register: (fn: () => void) => void;\n    19\t  flush: () => void;\n    20\t}\n    21\t\n    22\texport function createCommitHooks(): CommitHooks {\n    23\t  const callbacks: Array<() => void> = [];\n    24\t  return {\n    25\t    register: (fn) => {\n    26\t      callbacks.push(fn);\n    27\t    },\n    28\t    flush: () => {\n    29\t      for (const fn of callbacks.splice(0)) fn();\n    30\t    },\n    31\t  };\n    32\t}\n    33\t\n    34\t// The scheduler poke seam (DD-5). The slot lives in shared/ so the queue\n    35\t// util can fire it without importing the scheduler module (which will import\n    36\t// domain handler tables from Story 1 on — a util→scheduler import would\n    37\t// cycle). The scheduler installs itself here; in manual mode, or before any\n    38\t// scheduler exists, firing is a no-op — onCommit still fires either way.\n    39\ttype SchedulerPoke = (threadId: string) => void;\n    40\tlet schedulerPoke: SchedulerPoke | null = null;\n    41\t\n    42\texport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n    43\t  schedulerPoke = poke;\n    44\t}\n    45\t\n    46\texport function fireSchedulerPoke(threadId: string): void {\n    47\t  schedulerPoke?.(threadId);\n    48\t}\n    49\t\n    50\t// Transaction owner for operations outside the intake pipeline (mutations,\n    51\t// repair re-queues, tests of enqueue atomicity): BEGIN IMMEDIATE, run the\n    52\t// body with a context whose onCommit registrations flush only after COMMIT\n    53\t// succeeds and drop whole on rollback.\n    54\texport function runInTransaction<T>(\n    55\t  db: DatabaseSync,\n    56\t  clock: () => Date,\n    57\t  threadId: string,\n    58\t  fn: (ctx: OperationContext) => T,\n    59\t): T {\n    60\t  const hooks = createCommitHooks();\n    61\t  db.exec(\"BEGIN IMMEDIATE;\");\n    62\t  let value: T;\n    63\t  try {\n    64\t    value = fn({ db, clock, threadId, onCommit: hooks.register });\n    65\t    db.exec(\"COMMIT;\");\n    66\t  } catch (cause) {\n    67\t    db.exec(\"ROLLBACK;\");\n    68\t    throw cause;\n    69\t  }\n    70\t  hooks.flush();\n    71\t  return value;\n    72\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/shared/derivation.ts'","aggregated_output":"     1\t// Epic 02 shared vocabulary: the derived-form state machine's types, the\n     2\t// provider seam, and the handler contract. Both owning domains (messages,\n     3\t// turns) consume these; neither owns them — the repair report, the mutation\n     4\t// cascade, and the drain all speak this vocabulary across domain lines, so it\n     5\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\n     6\timport type { DatabaseSync } from \"node:sqlite\";\n     7\t\n     8\texport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n     9\t\n    10\texport type FormKind =\n    11\t  | \"smoothed_prompt\"\n    12\t  | \"tool_call_summary\"\n    13\t  | \"tool_result_summary\"\n    14\t  | \"turn_rendering\"\n    15\t  | \"lower_band_projection\"\n    16\t  | \"chunk_summary_detailed\"\n    17\t  | \"chunk_summary_brief\";\n    18\t\n    19\texport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n    20\t\n    21\t// Outcome on tool-activity summaries — mechanically stamped from the record\n    22\t// (isError/presence), never authored by the provider (AC-2.4).\n    23\texport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n    24\t\n    25\t// A composed form's record of a dependency that fell back during composition:\n    26\t// names the source record and the form that was not ready (AC-3.2/3.3).\n    27\texport interface DependencyGap {\n    28\t  subjectKind: SubjectKind;\n    29\t  subjectId: string;\n    30\t  form: FormKind;\n    31\t}\n    32\t\n    33\t// The read shape for one derived form's state row (DD-2, DD-3).\n    34\texport interface DerivedForm {\n    35\t  subjectKind: SubjectKind;\n    36\t  subjectId: string;\n    37\t  form: FormKind;\n    38\t  state: DerivedFormState;\n    39\t  content?: string; // ready only\n    40\t  reason?: string; // failed | blocked\n    41\t  sourceVersion: number; // which version of the source this form derives from (DD-3)\n    42\t  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n    43\t  metadata?: { outcome?: ToolOutcome }; // mechanically stamped fields; never provider-authored\n    44\t  derivedAt?: string;\n    45\t}\n    46\t\n    47\t// ── provider seam (DD-7) ─────────────────────────────────────────\n    48\t// Every operation returns content or a structured failure carrying\n    49\t// retryable-or-not; classification is the adapter's duty.\n    50\texport type ProviderResult =\n    51\t  | { ok: true; text: string }\n    52\t  | { ok: false; retryable: boolean; reason: string };\n    53\t\n    54\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n    55\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n    56\t// rather than imported: shared/ may not import domains/.\n    57\texport type RenderingPartKind =\n    58\t  | \"user_prompt\"\n    59\t  | \"assistant_text\"\n    60\t  | \"assistant_thinking\"\n    61\t  | \"runtime_note\"\n    62\t  | \"tool_call\"\n    63\t  | \"tool_result\";\n    64\t\n    65\texport interface RenderingPart {\n    66\t  messageId: string;\n    67\t  kind: RenderingPartKind;\n    68\t  text: string; // ready form content, or raw/truncated fallback\n    69\t  fallback: boolean; // true ⇒ gap recorded\n    70\t  outcome?: ToolOutcome; // tool activity only\n    71\t}\n    72\t\n    73\texport interface DerivationProvider {\n    74\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n    75\t  summarizeToolCall(i: {\n    76\t    toolName: string;\n    77\t    argsJson: string;\n    78\t    pairedResult?: { content: string; isError: boolean };\n    79\t  }): Promise<ProviderResult>;\n    80\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n    81\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n    82\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n    83\t  summarizeChunkDetailed(i: { memberProjections: string[] }): Promise<ProviderResult>;\n    84\t  summarizeChunkBrief(i: { memberProjections: string[] }): Promise<ProviderResult>;\n    85\t}\n    86\t\n    87\texport const PROVIDER_OPERATIONS = [\n    88\t  \"smoothPrompt\",\n    89\t  \"summarizeToolCall\",\n    90\t  \"summarizeToolResult\",\n    91\t  \"composeTurnRendering\",\n    92\t  \"projectLowerBand\",\n    93\t  \"summarizeChunkDetailed\",\n    94\t  \"summarizeChunkBrief\",\n    95\t] as const;\n    96\t\n    97\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n    98\t\n    99\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n   100\texport interface SdkConfig {\n   101\t  provider: DerivationProvider;\n   102\t  mode: \"background\" | \"manual\";\n   103\t  clock?: () => Date;\n   104\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n   105\t  lease?: { durationMs: number }; // 120000\n   106\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n   107\t}\n   108\t\n   109\t// Every optional filled by createSdk's central defaults.\n   110\texport interface ResolvedSdkConfig {\n   111\t  provider: DerivationProvider;\n   112\t  mode: \"background\" | \"manual\";\n   113\t  clock: () => Date;\n   114\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n   115\t  lease: { durationMs: number };\n   116\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n   117\t}\n   118\t\n   119\t// ── handler contract (DD-6; the map's value type) ────────────────\n   120\texport interface HandlerRunContext {\n   121\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n   122\t  provider: DerivationProvider;\n   123\t  clock: () => Date;\n   124\t  config: ResolvedSdkConfig;\n   125\t}\n   126\t\n   127\texport type HandlerOutcome =\n   128\t  | { ok: true } // forms written by handler, version-checked\n   129\t  | { ok: false; retryable: boolean; reason: string }\n   130\t  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n   131\t\n   132\t// item is the queue util's WorkItemRecord; typed structurally here so the\n   133\t// shared layer does not depend on the util's module (and vice versa stays\n   134\t// one-directional: tech-utils imports shared).\n   135\texport type WorkHandler = (\n   136\t  run: HandlerRunContext,\n   137\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n   138\t) => Promise<HandlerOutcome>;\n","exit_code":0,"status":"completed"}}

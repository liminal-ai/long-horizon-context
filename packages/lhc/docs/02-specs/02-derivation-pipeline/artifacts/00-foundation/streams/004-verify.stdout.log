{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/domains/threads/internal/create.ts'","aggregated_output":"     1\timport { randomBytes } from \"node:crypto\";\n     2\timport { rmSync } from \"node:fs\";\n     3\timport { DatabaseSync } from \"node:sqlite\";\n     4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n     5\timport {\n     6\t  getSchemaVersion,\n     7\t  MIGRATION_V5_STATEMENTS,\n     8\t  openDatabase,\n     9\t  runMigrations,\n    10\t  type Migration,\n    11\t} from \"../../../shared/storage.js\";\n    12\timport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n    13\t\n    14\t// The one random id: its uniqueness scope is global across files and\n    15\t// registries (design decision 7).\n    16\texport function generateThreadId(): string {\n    17\t  return `th_${randomBytes(8).toString(\"hex\")}`;\n    18\t}\n    19\t\n    20\t// The thread-file schema as a versioned history, never rewritten in place:\n    21\t// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n    22\t// each later story appends a version. Existing files upgrade lazily through\n    23\t// openThreadDatabase, so a file recorded under an earlier story is always\n    24\t// usable by a later one (F-03-001).\n    25\t//\n    26\t// Creation-time metadata values are interpolated through buildThreadMigrations\n    27\t// for new files only; existing files already hold their metadata row and the\n    28\t// upgrade path never touches it.\n    29\tfunction buildThreadMigrations(\n    30\t  metadata?: { threadId: string; createdAt: string },\n    31\t): Migration[] {\n    32\t  const metadataInsert =\n    33\t    metadata === undefined\n    34\t      ? []\n    35\t      : [\n    36\t          // Interpolated values are all generated by us (hex id, ISO\n    37\t          // timestamp, estimator constant) — never caller input.\n    38\t          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n    39\t           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n    40\t        ];\n    41\t  return [\n    42\t    {\n    43\t      version: 1,\n    44\t      statements: [\n    45\t        `CREATE TABLE thread_metadata (\n    46\t          id INTEGER PRIMARY KEY CHECK (id = 1),\n    47\t          thread_id TEXT NOT NULL,\n    48\t          created_at TEXT NOT NULL,\n    49\t          token_estimator TEXT NOT NULL\n    50\t        );`,\n    51\t        ...metadataInsert,\n    52\t        `CREATE TABLE event (\n    53\t          event_order INTEGER PRIMARY KEY,\n    54\t          event_kind TEXT NOT NULL,\n    55\t          idempotency_key TEXT NOT NULL UNIQUE,\n    56\t          actor TEXT NOT NULL,\n    57\t          harness TEXT NOT NULL,\n    58\t          payload TEXT NOT NULL,\n    59\t          recorded_at TEXT NOT NULL\n    60\t        );`,\n    61\t      ],\n    62\t    },\n    63\t    {\n    64\t      version: 2, // Story 3: message projection\n    65\t      statements: [\n    66\t        `CREATE TABLE message (\n    67\t          message_id TEXT PRIMARY KEY,\n    68\t          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n    69\t          kind TEXT NOT NULL,\n    70\t          token_estimate INTEGER NOT NULL,\n    71\t          actor TEXT NOT NULL,\n    72\t          harness TEXT NOT NULL,\n    73\t          turn_id TEXT\n    74\t        );`,\n    75\t        `CREATE TABLE message_block (\n    76\t          message_id TEXT NOT NULL REFERENCES message(message_id),\n    77\t          block_index INTEGER NOT NULL,\n    78\t          block_type TEXT NOT NULL,\n    79\t          content TEXT NOT NULL,\n    80\t          PRIMARY KEY (message_id, block_index)\n    81\t        );`,\n    82\t      ],\n    83\t    },\n    84\t    {\n    85\t      version: 3, // Story 4: turn state machine\n    86\t      statements: [\n    87\t        `CREATE TABLE turns (\n    88\t          turn_id TEXT PRIMARY KEY,\n    89\t          turn_order INTEGER NOT NULL UNIQUE,\n    90\t          status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n    91\t          opened_at_event_order INTEGER NOT NULL,\n    92\t          closed_at_event_order INTEGER\n    93\t        );`,\n    94\t      ],\n    95\t    },\n    96\t    {\n    97\t      version: 4, // Story 5: derivation work queueing\n    98\t      statements: [\n    99\t        // Work items live in the thread file and commit with the batch —\n   100\t        // not a separate database, not a separate transaction. status is\n   101\t        // unconstrained TEXT: this epic only ever writes 'queued'; the\n   102\t        // claim/lease statuses are Epic 02's to add.\n   103\t        `CREATE TABLE work_item (\n   104\t          work_item_id TEXT PRIMARY KEY,\n   105\t          owner TEXT NOT NULL,\n   106\t          kind TEXT NOT NULL,\n   107\t          source_ref TEXT NOT NULL,\n   108\t          status TEXT NOT NULL,\n   109\t          queued_at TEXT NOT NULL\n   110\t        );`,\n   111\t      ],\n   112\t    },\n   113\t    {\n   114\t      version: 5, // Epic 02 Story 0: queue mechanical fields, derived_form,\n   115\t      // chunk tables, deleted_at stamps, F-02 pending-row backfill — the\n   116\t      // epic's single migration (tech design §Storage), statements owned by\n   117\t      // shared/storage.ts.\n   118\t      statements: MIGRATION_V5_STATEMENTS,\n   119\t    },\n   120\t  ];\n   121\t}\n   122\t\n   123\tfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n   124\t  return {\n   125\t    ok: false,\n   126\t    error: {\n   127\t      errorClass: \"caller_error\",\n   128\t      code: \"thread_not_found\",\n   129\t      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n   130\t    },\n   131\t  };\n   132\t}\n   133\t\n   134\tfunction errorDetail(cause: unknown): string {\n   135\t  return cause instanceof Error ? cause.message : String(cause);\n   136\t}\n   137\t\n   138\t// Identity check before any migration runs, on a read-only handle so an\n   139\t// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n   140\t// file always carries schema version >= 1 and the thread_metadata singleton\n   141\t// row that creation wrote transactionally. Anything else — an empty\n   142\t// database, an unrelated SQLite file, a non-database file — is rejected as a\n   143\t// caller error, never adopted.\n   144\tfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n   145\t  let db: DatabaseSync | undefined;\n   146\t  try {\n   147\t    db = new DatabaseSync(filePath, { readOnly: true });\n   148\t    if (getSchemaVersion(db) < 1) {\n   149\t      return notAThreadFile(filePath, \"no lhc schema version\");\n   150\t    }\n   151\t    const table = db\n   152\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n   153\t      .get();\n   154\t    if (table === undefined) {\n   155\t      return notAThreadFile(filePath, \"no thread_metadata table\");\n   156\t    }\n   157\t    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n   158\t    if (row === undefined) {\n   159\t      return notAThreadFile(filePath, \"no thread metadata row\");\n   160\t    }\n   161\t    return { ok: true };\n   162\t  } catch (cause) {\n   163\t    const detail = errorDetail(cause);\n   164\t    // SQLite refusing the file as a database is an identity failure, not an\n   165\t    // environment failure; everything else stays a system error.\n   166\t    if (detail.includes(\"not a database\")) {\n   167\t      return notAThreadFile(filePath, detail);\n   168\t    }\n   169\t    return storageFailure(`could not inspect thread file: ${detail}`);\n   170\t  } finally {\n   171\t    db?.close();\n   172\t  }\n   173\t}\n   174\t\n   175\t// Opens a thread file and brings its schema to the current version before\n   176\t// returning the handle. Every SDK operation on an existing thread file goes\n   177\t// through here, so a pre-Story-3 file gains the message tables on its first\n   178\t// open by newer code — but only after the file proves it is a thread file;\n   179\t// migration never creates lhc schema on an arbitrary existing file. Each\n   180\t// migration runs in its own transaction (storage helper), completing before\n   181\t// any caller transaction begins.\n   182\texport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n   183\t  const valid = validateThreadFile(filePath);\n   184\t  if (!valid.ok) return valid;\n   185\t  let db: DatabaseSync;\n   186\t  try {\n   187\t    db = openDatabase(filePath);\n   188\t  } catch (cause) {\n   189\t    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n   190\t  }\n   191\t  try {\n   192\t    runMigrations(db, buildThreadMigrations());\n   193\t  } catch (cause) {\n   194\t    db.close();\n   195\t    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n   196\t  }\n   197\t  return { ok: true, value: db };\n   198\t}\n   199\t\n   200\t// Schema v1 plus the metadata row land in one migration transaction, so the\n   201\t// file either has its full schema and metadata row or creation fails whole.\n   202\texport function createThreadFile(\n   203\t  filePath: string,\n   204\t  threadId: string,\n   205\t  createdAt: string,\n   206\t): void {\n   207\t  const db = openDatabase(filePath);\n   208\t  try {\n   209\t    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n   210\t  } finally {\n   211\t    db.close();\n   212\t  }\n   213\t}\n   214\t\n   215\t// Compensation: removes the thread file and its WAL companions. Used when the\n   216\t// registry insert fails after file creation (no registry row without its\n   217\t// file) and when file creation itself fails partway.\n   218\texport function deleteThreadFile(filePath: string): void {\n   219\t  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n   220\t    rmSync(`${filePath}${suffix}`, { force: true });\n   221\t  }\n   222\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/fixtures/legacy.ts'","aggregated_output":"     1\t// Builds a thread file with the accepted Story 2 on-disk schema (commit\n     2\t// 7c8623d): thread_metadata + event tables only, PRAGMA user_version = 1.\n     3\t// Current code can no longer create this shape — that is the point: the\n     4\t// fixture stands in for a real file recorded before Story 3 shipped, so the\n     5\t// lazy upgrade path (F-03-001) is exercised against the true legacy layout.\n     6\t// Below-SDK writer, sanctioned for the same reason corrupt.ts is: the state\n     7\t// is unreachable through the current SDK.\n     8\timport { DatabaseSync } from \"node:sqlite\";\n     9\t\n    10\texport interface LegacyRecordedEvent {\n    11\t  eventOrder: number;\n    12\t  eventKind: string;\n    13\t  idempotencyKey: string;\n    14\t  actor: string;\n    15\t  harness: string;\n    16\t  payload: Record<string, unknown>;\n    17\t  recordedAt: string;\n    18\t}\n    19\t\n    20\texport function legacyStory2ThreadFile(\n    21\t  filePath: string,\n    22\t  threadId: string,\n    23\t  recordedEvents: readonly LegacyRecordedEvent[] = [],\n    24\t): void {\n    25\t  const db = new DatabaseSync(filePath);\n    26\t  try {\n    27\t    db.exec(\"PRAGMA journal_mode = WAL;\");\n    28\t    db.exec(\"BEGIN IMMEDIATE;\");\n    29\t    db.exec(`CREATE TABLE thread_metadata (\n    30\t      id INTEGER PRIMARY KEY CHECK (id = 1),\n    31\t      thread_id TEXT NOT NULL,\n    32\t      created_at TEXT NOT NULL,\n    33\t      token_estimator TEXT NOT NULL\n    34\t    );`);\n    35\t    db.prepare(\n    36\t      `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n    37\t       VALUES (1, ?, ?, 'js-tiktoken:o200k_base')`,\n    38\t    ).run(threadId, \"2026-06-01T00:00:00.000Z\");\n    39\t    db.exec(`CREATE TABLE event (\n    40\t      event_order INTEGER PRIMARY KEY,\n    41\t      event_kind TEXT NOT NULL,\n    42\t      idempotency_key TEXT NOT NULL UNIQUE,\n    43\t      actor TEXT NOT NULL,\n    44\t      harness TEXT NOT NULL,\n    45\t      payload TEXT NOT NULL,\n    46\t      recorded_at TEXT NOT NULL\n    47\t    );`);\n    48\t    const insert = db.prepare(\n    49\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n    50\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    51\t    );\n    52\t    for (const event of recordedEvents) {\n    53\t      insert.run(\n    54\t        event.eventOrder,\n    55\t        event.eventKind,\n    56\t        event.idempotencyKey,\n    57\t        event.actor,\n    58\t        event.harness,\n    59\t        JSON.stringify(event.payload),\n    60\t        event.recordedAt,\n    61\t      );\n    62\t    }\n    63\t    db.exec(\"PRAGMA user_version = 1;\");\n    64\t    db.exec(\"COMMIT;\");\n    65\t  } finally {\n    66\t    db.close();\n    67\t  }\n    68\t}\n    69\t\n    70\t// Builds a thread file with the accepted Epic 01 on-disk schema (v4: the\n    71\t// Story 5 work_item table, pre-Epic-02 column set, unversioned work-item\n    72\t// ids), populated with a recorded conversation and live queued work. Current\n    73\t// code can no longer create this shape — migration v5 runs at every open —\n    74\t// so the fixture stands in for a real Epic 01 file at upgrade time (FC-0.5,\n    75\t// F-02 backfill). Below-SDK writer, sanctioned like legacyStory2ThreadFile.\n    76\texport function legacyEpic01ThreadFile(filePath: string, threadId: string): void {\n    77\t  const db = new DatabaseSync(filePath);\n    78\t  const recordedAt = \"2026-06-09T00:00:00.000Z\";\n    79\t  try {\n    80\t    db.exec(\"PRAGMA journal_mode = WAL;\");\n    81\t    db.exec(\"BEGIN IMMEDIATE;\");\n    82\t    db.exec(`CREATE TABLE thread_metadata (\n    83\t      id INTEGER PRIMARY KEY CHECK (id = 1),\n    84\t      thread_id TEXT NOT NULL,\n    85\t      created_at TEXT NOT NULL,\n    86\t      token_estimator TEXT NOT NULL\n    87\t    );`);\n    88\t    db.prepare(\n    89\t      `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n    90\t       VALUES (1, ?, ?, 'js-tiktoken:o200k_base')`,\n    91\t    ).run(threadId, recordedAt);\n    92\t    db.exec(`CREATE TABLE event (\n    93\t      event_order INTEGER PRIMARY KEY,\n    94\t      event_kind TEXT NOT NULL,\n    95\t      idempotency_key TEXT NOT NULL UNIQUE,\n    96\t      actor TEXT NOT NULL,\n    97\t      harness TEXT NOT NULL,\n    98\t      payload TEXT NOT NULL,\n    99\t      recorded_at TEXT NOT NULL\n   100\t    );`);\n   101\t    db.exec(`CREATE TABLE message (\n   102\t      message_id TEXT PRIMARY KEY,\n   103\t      source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n   104\t      kind TEXT NOT NULL,\n   105\t      token_estimate INTEGER NOT NULL,\n   106\t      actor TEXT NOT NULL,\n   107\t      harness TEXT NOT NULL,\n   108\t      turn_id TEXT\n   109\t    );`);\n   110\t    db.exec(`CREATE TABLE message_block (\n   111\t      message_id TEXT NOT NULL REFERENCES message(message_id),\n   112\t      block_index INTEGER NOT NULL,\n   113\t      block_type TEXT NOT NULL,\n   114\t      content TEXT NOT NULL,\n   115\t      PRIMARY KEY (message_id, block_index)\n   116\t    );`);\n   117\t    db.exec(`CREATE TABLE turns (\n   118\t      turn_id TEXT PRIMARY KEY,\n   119\t      turn_order INTEGER NOT NULL UNIQUE,\n   120\t      status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n   121\t      opened_at_event_order INTEGER NOT NULL,\n   122\t      closed_at_event_order INTEGER\n   123\t    );`);\n   124\t    db.exec(`CREATE TABLE work_item (\n   125\t      work_item_id TEXT PRIMARY KEY,\n   126\t      owner TEXT NOT NULL,\n   127\t      kind TEXT NOT NULL,\n   128\t      source_ref TEXT NOT NULL,\n   129\t      status TEXT NOT NULL,\n   130\t      queued_at TEXT NOT NULL\n   131\t    );`);\n   132\t\n   133\t    const insertEvent = db.prepare(\n   134\t      `INSERT INTO event (event_order, event_kind, idempotency_key, actor, harness, payload, recorded_at)\n   135\t       VALUES (?, ?, ?, ?, ?, ?, ?)`,\n   136\t    );\n   137\t    const events: Array<[number, string, Record<string, unknown>]> = [\n   138\t      [1, \"user_prompt\", { text: \"legacy prompt recorded under epic 01\" }],\n   139\t      [2, \"tool_call\", { toolCallId: \"call-legacy-1\", toolName: \"read_file\", arguments: { path: \"n.txt\" } }],\n   140\t      [3, \"tool_result\", { toolCallId: \"call-legacy-1\", content: \"legacy tool output\", isError: false }],\n   141\t      [4, \"turn_end\", {}],\n   142\t    ];\n   143\t    for (const [order, kind, payload] of events) {\n   144\t      insertEvent.run(\n   145\t        order,\n   146\t        kind,\n   147\t        `legacy-epic01-key-${order}`,\n   148\t        \"legacy-actor\",\n   149\t        \"legacy-harness\",\n   150\t        JSON.stringify(payload),\n   151\t        recordedAt,\n   152\t      );\n   153\t    }\n   154\t\n   155\t    const insertMessage = db.prepare(\n   156\t      `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\n   157\t       VALUES (?, ?, ?, ?, 'legacy-actor', 'legacy-harness', 't1')`,\n   158\t    );\n   159\t    insertMessage.run(\"m1\", 1, \"user_prompt\", 9);\n   160\t    insertMessage.run(\"m2\", 2, \"tool_call\", 12);\n   161\t    insertMessage.run(\"m3\", 3, \"tool_result\", 7);\n   162\t    const insertBlock = db.prepare(\n   163\t      `INSERT INTO message_block (message_id, block_index, block_type, content)\n   164\t       VALUES (?, 0, ?, ?)`,\n   165\t    );\n   166\t    insertBlock.run(\"m1\", \"text\", JSON.stringify({ text: \"legacy prompt recorded under epic 01\" }));\n   167\t    insertBlock.run(\n   168\t      \"m2\",\n   169\t      \"tool_call\",\n   170\t      JSON.stringify({ toolCallId: \"call-legacy-1\", toolName: \"read_file\", arguments: { path: \"n.txt\" } }),\n   171\t    );\n   172\t    insertBlock.run(\n   173\t      \"m3\",\n   174\t      \"tool_result\",\n   175\t      JSON.stringify({ toolCallId: \"call-legacy-1\", content: \"legacy tool output\", isError: false }),\n   176\t    );\n   177\t\n   178\t    db.prepare(\n   179\t      `INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order, closed_at_event_order)\n   180\t       VALUES ('t1', 1, 'closed', 1, 4)`,\n   181\t    ).run();\n   182\t\n   183\t    // Live queued items with Epic 01's unversioned ids — exactly what the\n   184\t    // F-02 backfill must cover with pending derived_form rows at version 1.\n   185\t    const insertItem = db.prepare(\n   186\t      `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at)\n   187\t       VALUES (?, ?, ?, ?, 'queued', ?)`,\n   188\t    );\n   189\t    insertItem.run(\n   190\t      \"w-m1-prompt_smoothing\",\n   191\t      \"messages\",\n   192\t      \"prompt_smoothing\",\n   193\t      JSON.stringify({ messageId: \"m1\" }),\n   194\t      recordedAt,\n   195\t    );\n   196\t    insertItem.run(\n   197\t      \"w-m3-tool_result_summary\",\n   198\t      \"messages\",\n   199\t      \"tool_result_summary\",\n   200\t      JSON.stringify({ messageId: \"m3\" }),\n   201\t      recordedAt,\n   202\t    );\n   203\t    insertItem.run(\n   204\t      \"w-t1-turn_derivation\",\n   205\t      \"turns\",\n   206\t      \"turn_derivation\",\n   207\t      JSON.stringify({ turnId: \"t1\" }),\n   208\t      recordedAt,\n   209\t    );\n   210\t\n   211\t    db.exec(\"PRAGMA user_version = 4;\");\n   212\t    db.exec(\"COMMIT;\");\n   213\t  } finally {\n   214\t    db.close();\n   215\t  }\n   216\t}\n   217\t\n   218\texport function schemaVersionOf(filePath: string): number {\n   219\t  const db = new DatabaseSync(filePath);\n   220\t  try {\n   221\t    const row = db.prepare(\"PRAGMA user_version\").get() as\n   222\t      | { user_version: number | bigint }\n   223\t      | undefined;\n   224\t    return Number(row?.user_version ?? 0);\n   225\t  } finally {\n   226\t    db.close();\n   227\t  }\n   228\t}\n","exit_code":0,"status":"completed"}}

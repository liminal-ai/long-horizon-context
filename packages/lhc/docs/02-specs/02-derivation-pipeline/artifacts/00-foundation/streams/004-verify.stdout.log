{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/sdk.ts'","aggregated_output":"     1\texport * as threads from \"./domains/threads/index.js\";\n     2\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n     3\texport * as messages from \"./domains/messages/index.js\";\n     4\texport * as turns from \"./domains/turns/index.js\";\n     5\t\n     6\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n     7\timport * as messagesDomain from \"./domains/messages/index.js\";\n     8\timport * as threadsDomain from \"./domains/threads/index.js\";\n     9\timport * as turnsDomain from \"./domains/turns/index.js\";\n    10\timport { createScheduler, type Scheduler } from \"./scheduler.js\";\n    11\timport {\n    12\t  PROVIDER_OPERATIONS,\n    13\t  type ResolvedSdkConfig,\n    14\t  type SdkConfig,\n    15\t  type WorkHandler,\n    16\t} from \"./shared/derivation.js\";\n    17\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n    18\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n    19\t\n    20\texport {\n    21\t  estimateTokens,\n    22\t  TOKEN_ESTIMATOR_ID,\n    23\t} from \"./tech-utils/token-counting/index.js\";\n    24\t\n    25\texport {\n    26\t  WORK_KIND_REGISTRY,\n    27\t  type WorkItemRecord,\n    28\t  type WorkKind,\n    29\t  type WorkOwner,\n    30\t  type WorkSourceRef,\n    31\t} from \"./tech-utils/work-queue/index.js\";\n    32\t\n    33\texport type {\n    34\t  ErrorClass,\n    35\t  ErrorCode,\n    36\t  ErrorResult,\n    37\t  OpResult,\n    38\t} from \"./shared/errors.js\";\n    39\texport {\n    40\t  runInTransaction,\n    41\t  setSchedulerPoke,\n    42\t  type OperationContext,\n    43\t} from \"./shared/context.js\";\n    44\t\n    45\texport type {\n    46\t  DependencyGap,\n    47\t  DerivationProvider,\n    48\t  DerivedForm,\n    49\t  DerivedFormState,\n    50\t  FormKind,\n    51\t  HandlerOutcome,\n    52\t  HandlerRunContext,\n    53\t  ProviderResult,\n    54\t  RenderingPart,\n    55\t  ResolvedSdkConfig,\n    56\t  SdkConfig,\n    57\t  SubjectKind,\n    58\t  ToolOutcome,\n    59\t  WorkHandler,\n    60\t} from \"./shared/derivation.js\";\n    61\texport type { Scheduler, SchedulerMode } from \"./scheduler.js\";\n    62\t\n    63\texport type { ThreadRef } from \"./domains/threads/index.js\";\n    64\texport type {\n    65\t  Block,\n    66\t  BlockType,\n    67\t  MessageRecord,\n    68\t} from \"./domains/messages/index.js\";\n    69\texport type { TurnRecord } from \"./domains/turns/index.js\";\n    70\texport type {\n    71\t  BatchResult,\n    72\t  EventKind,\n    73\t  EventRecord,\n    74\t  MessageEventInput,\n    75\t} from \"./domains/intake-stream/index.js\";\n    76\t\n    77\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n    78\t\n    79\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n    80\t\n    81\t// Merge per-domain handler tables into the one join between the queue's\n    82\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n    83\t// (each kind has exactly one owner) and throws at construction.\n    84\texport function assembleWorkHandlerMap(\n    85\t  tables: ReadonlyArray<WorkHandlerMap>,\n    86\t): WorkHandlerMap {\n    87\t  const map: WorkHandlerMap = {};\n    88\t  for (const table of tables) {\n    89\t    for (const [kind, handler] of Object.entries(table)) {\n    90\t      if (map[kind as WorkKind] !== undefined) {\n    91\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n    92\t      }\n    93\t      map[kind as WorkKind] = handler;\n    94\t    }\n    95\t  }\n    96\t  return map;\n    97\t}\n    98\t\n    99\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n   100\t  return {\n   101\t    ok: false,\n   102\t    error: {\n   103\t      errorClass: \"state_corruption\",\n   104\t      code: \"unknown_work_kind\",\n   105\t      reason: `no handler registered for work kind \"${kind}\"`,\n   106\t    },\n   107\t  };\n   108\t}\n   109\t\n   110\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n   111\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n   112\texport function lookupWorkHandler(\n   113\t  map: WorkHandlerMap,\n   114\t  kind: string,\n   115\t): OpResult<WorkHandler> {\n   116\t  const handler = map[kind as WorkKind];\n   117\t  if (handler === undefined) return unknownWorkKind(kind);\n   118\t  return { ok: true, value: handler };\n   119\t}\n   120\t\n   121\texport interface Lhc {\n   122\t  threads: typeof threadsDomain;\n   123\t  intakeStream: typeof intakeStreamDomain;\n   124\t  messages: typeof messagesDomain;\n   125\t  turns: typeof turnsDomain;\n   126\t  config: ResolvedSdkConfig;\n   127\t  scheduler: Scheduler;\n   128\t  workHandlers: WorkHandlerMap;\n   129\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n   130\t}\n   131\t\n   132\tfunction requirePositive(value: number, name: string): void {\n   133\t  if (!Number.isFinite(value) || value <= 0) {\n   134\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n   135\t  }\n   136\t}\n   137\t\n   138\tfunction requireNonNegative(value: number, name: string): void {\n   139\t  if (!Number.isFinite(value) || value < 0) {\n   140\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n   141\t  }\n   142\t}\n   143\t\n   144\t// The only assembly path: provider, mode, clock, and policy enter here.\n   145\t// Config mistakes are programmer errors at construction and throw; operating\n   146\t// failures after construction return OpResults per the error contract.\n   147\texport function createSdk(config: SdkConfig): Lhc {\n   148\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   149\t    throw new TypeError(\n   150\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   151\t    );\n   152\t  }\n   153\t  if (config.provider === null || typeof config.provider !== \"object\") {\n   154\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   155\t  }\n   156\t  for (const operation of PROVIDER_OPERATIONS) {\n   157\t    if (typeof config.provider[operation] !== \"function\") {\n   158\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   159\t    }\n   160\t  }\n   161\t\n   162\t  const resolved: ResolvedSdkConfig = {\n   163\t    provider: config.provider,\n   164\t    mode: config.mode,\n   165\t    clock: config.clock ?? (() => new Date()),\n   166\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   167\t    lease: config.lease ?? { durationMs: 120000 },\n   168\t    chunkPolicy:\n   169\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n   170\t  };\n   171\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n   172\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n   173\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n   174\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n   175\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n   176\t  }\n   177\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n   178\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n   179\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n   180\t    throw new TypeError(\n   181\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n   182\t    );\n   183\t  }\n   184\t\n   185\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n   186\t  // The tables are empty until Stories 2–3 land the real handlers; the\n   187\t  // assembly mechanics are production code from day one.\n   188\t  const workHandlers = assembleWorkHandlerMap([\n   189\t    messagesDomain.workHandlers,\n   190\t    turnsDomain.workHandlers,\n   191\t  ]);\n   192\t\n   193\t  return {\n   194\t    threads: threadsDomain,\n   195\t    intakeStream: intakeStreamDomain,\n   196\t    messages: messagesDomain,\n   197\t    turns: turnsDomain,\n   198\t    config: resolved,\n   199\t    scheduler: createScheduler(resolved.mode),\n   200\t    workHandlers,\n   201\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   202\t  };\n   203\t}\n","exit_code":0,"status":"completed"}}

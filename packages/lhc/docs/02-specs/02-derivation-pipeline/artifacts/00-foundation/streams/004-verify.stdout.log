{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/fixtures/provider-double.ts'","aggregated_output":"     1\t// Deterministic DerivationProvider double (DD-7, test plan §Test Substrate).\n     2\t// Injected at the same seam production adapters use — dependency injection,\n     3\t// not a mock of internals. Every operation returns marked, input-derived\n     4\t// output: `<marker>(<digest>:<prefix>)` where the digest and prefix are pure\n     5\t// functions of the input, so identical input to the same operation yields\n     6\t// identical output across double instances, and different operations are\n     7\t// distinguishable by marker. Scripting (failNext / failKind / delayKind /\n     8\t// captureInputs) is per-instance state and never leaks across tests that\n     9\t// construct their own double.\n    10\timport type {\n    11\t  DerivationProvider,\n    12\t  ProviderResult,\n    13\t  RenderingPart,\n    14\t} from \"../../src/index.js\";\n    15\t\n    16\texport type ProviderOpName =\n    17\t  | \"smoothPrompt\"\n    18\t  | \"summarizeToolCall\"\n    19\t  | \"summarizeToolResult\"\n    20\t  | \"composeTurnRendering\"\n    21\t  | \"projectLowerBand\"\n    22\t  | \"summarizeChunkDetailed\"\n    23\t  | \"summarizeChunkBrief\";\n    24\t\n    25\t// Tests script by work-kind / form-kind vocabulary (the test plan writes\n    26\t// `failKind(prompt_smoothing, …)`); the double accepts those aliases as well\n    27\t// as the operation names themselves.\n    28\tconst KIND_ALIASES: Record<string, ProviderOpName> = {\n    29\t  smoothPrompt: \"smoothPrompt\",\n    30\t  summarizeToolCall: \"summarizeToolCall\",\n    31\t  summarizeToolResult: \"summarizeToolResult\",\n    32\t  composeTurnRendering: \"composeTurnRendering\",\n    33\t  projectLowerBand: \"projectLowerBand\",\n    34\t  summarizeChunkDetailed: \"summarizeChunkDetailed\",\n    35\t  summarizeChunkBrief: \"summarizeChunkBrief\",\n    36\t  prompt_smoothing: \"smoothPrompt\",\n    37\t  smoothed_prompt: \"smoothPrompt\",\n    38\t  tool_call_summary: \"summarizeToolCall\",\n    39\t  tool_result_summary: \"summarizeToolResult\",\n    40\t  turn_rendering: \"composeTurnRendering\",\n    41\t  lower_band_projection: \"projectLowerBand\",\n    42\t  chunk_summary_detailed: \"summarizeChunkDetailed\",\n    43\t  chunk_summary_brief: \"summarizeChunkBrief\",\n    44\t};\n    45\t\n    46\tfunction resolveOpName(kind: string): ProviderOpName {\n    47\t  const op = KIND_ALIASES[kind];\n    48\t  if (op === undefined) throw new Error(`provider double: unknown operation/kind \"${kind}\"`);\n    49\t  return op;\n    50\t}\n    51\t\n    52\t// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\n    53\t// input-sensitive enough that distinct inputs mark distinct outputs.\n    54\tfunction digest(input: unknown): string {\n    55\t  const text = JSON.stringify(input);\n    56\t  let hash = 0x811c9dc5;\n    57\t  for (let i = 0; i < text.length; i += 1) {\n    58\t    hash ^= text.charCodeAt(i);\n    59\t    hash = Math.imul(hash, 0x01000193) >>> 0;\n    60\t  }\n    61\t  return hash.toString(16).padStart(8, \"0\");\n    62\t}\n    63\t\n    64\tfunction prefix40(text: string): string {\n    65\t  return text.slice(0, 40);\n    66\t}\n    67\t\n    68\tinterface FailScript {\n    69\t  remaining: number;\n    70\t  retryable: boolean;\n    71\t  reason: string;\n    72\t}\n    73\t\n    74\texport interface CapturedInput {\n    75\t  op: ProviderOpName;\n    76\t  input: unknown;\n    77\t}\n    78\t\n    79\texport class ProviderDouble implements DerivationProvider {\n    80\t  private failNextScript: FailScript | null = null;\n    81\t  private readonly failByOp = new Map<ProviderOpName, FailScript>();\n    82\t  private readonly delayByOp = new Map<ProviderOpName, number>();\n    83\t  private capturing = false;\n    84\t  private readonly captured: CapturedInput[] = [];\n    85\t\n    86\t  // Fail the next n calls to any operation, then succeed.\n    87\t  failNext(n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    88\t    this.failNextScript = {\n    89\t      remaining: n,\n    90\t      retryable: opts?.retryable ?? true,\n    91\t      reason: opts?.reason ?? \"scripted failure (failNext)\",\n    92\t    };\n    93\t  }\n    94\t\n    95\t  // Fail the next n calls to one operation (kind names and op names both\n    96\t  // accepted). retryable: false scripts a terminal failure.\n    97\t  failKind(kind: string, n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    98\t    const op = resolveOpName(kind);\n    99\t    this.failByOp.set(op, {\n   100\t      remaining: n,\n   101\t      retryable: opts?.retryable ?? true,\n   102\t      reason: opts?.reason ?? `scripted failure (${op})`,\n   103\t    });\n   104\t  }\n   105\t\n   106\t  delayKind(kind: string, ms: number): void {\n   107\t    this.delayByOp.set(resolveOpName(kind), ms);\n   108\t  }\n   109\t\n   110\t  // Start capturing inputs; returns the live log (appended in call order).\n   111\t  captureInputs(): readonly CapturedInput[] {\n   112\t    this.capturing = true;\n   113\t    return this.captured;\n   114\t  }\n   115\t\n   116\t  private async run(\n   117\t    op: ProviderOpName,\n   118\t    input: unknown,\n   119\t    text: string,\n   120\t  ): Promise<ProviderResult> {\n   121\t    if (this.capturing) this.captured.push({ op, input: structuredClone(input) });\n   122\t    const delay = this.delayByOp.get(op);\n   123\t    if (delay !== undefined && delay > 0) {\n   124\t      await new Promise((resolve) => setTimeout(resolve, delay));\n   125\t    }\n   126\t    const scripts = [this.failNextScript, this.failByOp.get(op) ?? null];\n   127\t    for (const script of scripts) {\n   128\t      if (script !== null && script.remaining > 0) {\n   129\t        script.remaining -= 1;\n   130\t        return { ok: false, retryable: script.retryable, reason: script.reason };\n   131\t      }\n   132\t    }\n   133\t    const markers: Record<ProviderOpName, string> = {\n   134\t      smoothPrompt: \"smoothed\",\n   135\t      summarizeToolCall: \"toolcall\",\n   136\t      summarizeToolResult: \"toolresult\",\n   137\t      composeTurnRendering: \"rendering\",\n   138\t      projectLowerBand: \"projection\",\n   139\t      summarizeChunkDetailed: \"detailed\",\n   140\t      summarizeChunkBrief: \"brief\",\n   141\t    };\n   142\t    return { ok: true, text: `${markers[op]}(${digest(input)}:${prefix40(text)})` };\n   143\t  }\n   144\t\n   145\t  smoothPrompt(i: { text: string }): Promise<ProviderResult> {\n   146\t    return this.run(\"smoothPrompt\", i, i.text);\n   147\t  }\n   148\t\n   149\t  summarizeToolCall(i: {\n   150\t    toolName: string;\n   151\t    argsJson: string;\n   152\t    pairedResult?: { content: string; isError: boolean };\n   153\t  }): Promise<ProviderResult> {\n   154\t    return this.run(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`);\n   155\t  }\n   156\t\n   157\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult> {\n   158\t    return this.run(\"summarizeToolResult\", i, i.content);\n   159\t  }\n   160\t\n   161\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult> {\n   162\t    return this.run(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \"));\n   163\t  }\n   164\t\n   165\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult> {\n   166\t    return this.run(\"projectLowerBand\", i, i.rendering);\n   167\t  }\n   168\t\n   169\t  summarizeChunkDetailed(i: { memberProjections: string[] }): Promise<ProviderResult> {\n   170\t    return this.run(\"summarizeChunkDetailed\", i, i.memberProjections.join(\" | \"));\n   171\t  }\n   172\t\n   173\t  summarizeChunkBrief(i: { memberProjections: string[] }): Promise<ProviderResult> {\n   174\t    return this.run(\"summarizeChunkBrief\", i, i.memberProjections.join(\" | \"));\n   175\t  }\n   176\t}\n   177\t\n   178\texport function createProviderDouble(): ProviderDouble {\n   179\t  return new ProviderDouble();\n   180\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/fixtures/threads.ts'","aggregated_output":"     1\t// Thread builders for Epic 02 (test plan §Test Substrate). All built through\n     2\t// real intake; the multi-state and damaged-source builders then apply the\n     3\t// sanctioned below-SDK writes for states the SDK cannot yet produce (drain\n     4\t// and handlers land in Stories 1–3) — Story 0 proves read-back of what the\n     5\t// builders wrote; Stories 2/4 confirm the states arise for real\n     6\t// (coverage.md cross-story debt).\n     7\timport { DatabaseSync } from \"node:sqlite\";\n     8\timport {\n     9\t  intakeStream,\n    10\t  runCli,\n    11\t  threads,\n    12\t  type DerivedForm,\n    13\t  type DerivedFormState,\n    14\t  type DependencyGap,\n    15\t  type FormKind,\n    16\t  type MessageEventInput,\n    17\t  type SubjectKind,\n    18\t  type ToolOutcome,\n    19\t} from \"../../src/index.js\";\n    20\timport { setIntakeClock } from \"./intake-seam.js\";\n    21\timport { corruptTwoOpenTurns } from \"./corrupt.js\";\n    22\timport { validEvent, type TempStore } from \"./index.js\";\n    23\t\n    24\tasync function newThreadFile(store: TempStore): Promise<string> {\n    25\t  const filePath = store.threadPath();\n    26\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n    27\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    28\t  return filePath;\n    29\t}\n    30\t\n    31\tasync function send(filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n    32\t  const result = await intakeStream.messageEvents({ filePath }, batch);\n    33\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n    34\t}\n    35\t\n    36\t// n closed turns, each prompt + assistant text + explicit end. Turn ids are\n    37\t// deterministic (t1..tn) per the turn store's id scheme.\n    38\texport async function threadWithClosedTurns(\n    39\t  store: TempStore,\n    40\t  n: number,\n    41\t): Promise<{ filePath: string; turnIds: string[] }> {\n    42\t  const filePath = await newThreadFile(store);\n    43\t  const turnIds: string[] = [];\n    44\t  for (let i = 1; i <= n; i += 1) {\n    45\t    await send(filePath, [\n    46\t      validEvent(\"user_prompt\", { payload: { text: `prompt for turn ${i}` } }),\n    47\t      validEvent(\"assistant_text\", { payload: { text: `answer for turn ${i}` } }),\n    48\t      validEvent(\"turn_end\"),\n    49\t    ]);\n    50\t    turnIds.push(`t${i}`);\n    51\t  }\n    52\t  return { filePath, turnIds };\n    53\t}\n    54\t\n    55\t// One closed turn containing a tool run: call + result pair by default;\n    56\t// error and missing-result variants per the epic's outcome vocabulary.\n    57\texport async function threadWithToolRun(\n    58\t  store: TempStore,\n    59\t  opts: { isError?: boolean; missingResult?: boolean; resultContent?: string } = {},\n    60\t): Promise<{ filePath: string; turnId: string }> {\n    61\t  const filePath = await newThreadFile(store);\n    62\t  const batch: MessageEventInput[] = [\n    63\t    validEvent(\"user_prompt\", { payload: { text: \"please run the tool\" } }),\n    64\t    validEvent(\"tool_call\", {\n    65\t      payload: { toolCallId: \"call-fixture-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n    66\t    }),\n    67\t  ];\n    68\t  if (opts.missingResult !== true) {\n    69\t    batch.push(\n    70\t      validEvent(\"tool_result\", {\n    71\t        payload: {\n    72\t          toolCallId: \"call-fixture-1\",\n    73\t          content: opts.resultContent ?? \"contents of notes.txt\",\n    74\t          isError: opts.isError ?? false,\n    75\t        },\n    76\t      }),\n    77\t    );\n    78\t  }\n    79\t  batch.push(validEvent(\"turn_end\"));\n    80\t  await send(filePath, batch);\n    81\t  return { filePath, turnId: \"t1\" };\n    82\t}\n    83\t\n    84\t// ── derived_form read-back and the sanctioned state writer ───────\n    85\t\n    86\tinterface RawFormRow {\n    87\t  subject_kind: string;\n    88\t  subject_id: string;\n    89\t  form: string;\n    90\t  state: string;\n    91\t  content: string | null;\n    92\t  reason: string | null;\n    93\t  metadata: string | null;\n    94\t  source_version: number | bigint;\n    95\t  gaps: string | null;\n    96\t  derived_at: string | null;\n    97\t}\n    98\t\n    99\texport function readDerivedForms(filePath: string): DerivedForm[] {\n   100\t  const db = new DatabaseSync(filePath);\n   101\t  try {\n   102\t    const rows = db\n   103\t      .prepare(\n   104\t        `SELECT subject_kind, subject_id, form, state, content, reason, metadata,\n   105\t                source_version, gaps, derived_at\n   106\t         FROM derived_form ORDER BY subject_kind, subject_id, form`,\n   107\t      )\n   108\t      .all() as unknown as RawFormRow[];\n   109\t    return rows.map((row) => {\n   110\t      const record: DerivedForm = {\n   111\t        subjectKind: row.subject_kind as SubjectKind,\n   112\t        subjectId: row.subject_id,\n   113\t        form: row.form as FormKind,\n   114\t        state: row.state as DerivedFormState,\n   115\t        sourceVersion: Number(row.source_version),\n   116\t      };\n   117\t      if (row.content !== null) record.content = row.content;\n   118\t      if (row.reason !== null) record.reason = row.reason;\n   119\t      if (row.metadata !== null) {\n   120\t        record.metadata = JSON.parse(row.metadata) as { outcome?: ToolOutcome };\n   121\t      }\n   122\t      if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n   123\t      if (row.derived_at !== null) record.derivedAt = row.derived_at;\n   124\t      return record;\n   125\t    });\n   126\t  } finally {\n   127\t    db.close();\n   128\t  }\n   129\t}\n   130\t\n   131\t// Below-SDK state writer, sanctioned like corrupt.ts: ready/failed/blocked\n   132\t// are unreachable through the SDK until the drain (Story 1) and handlers\n   133\t// (Stories 2–3) land. UPDATE-only on purpose — the pending row exists from\n   134\t// enqueue, mirroring the production completion contract.\n   135\texport function setFormState(\n   136\t  filePath: string,\n   137\t  target: { subjectKind: SubjectKind; subjectId: string; form: FormKind },\n   138\t  update: {\n   139\t    state: DerivedFormState;\n   140\t    content?: string;\n   141\t    reason?: string;\n   142\t    metadata?: { outcome?: ToolOutcome };\n   143\t    derivedAt?: string;\n   144\t  },\n   145\t): void {\n   146\t  const db = new DatabaseSync(filePath);\n   147\t  try {\n   148\t    const changed = db\n   149\t      .prepare(\n   150\t        `UPDATE derived_form\n   151\t         SET state = ?, content = ?, reason = ?, metadata = ?, derived_at = ?\n   152\t         WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n   153\t      )\n   154\t      .run(\n   155\t        update.state,\n   156\t        update.content ?? null,\n   157\t        update.reason ?? null,\n   158\t        update.metadata === undefined ? null : JSON.stringify(update.metadata),\n   159\t        update.derivedAt ?? null,\n   160\t        target.subjectKind,\n   161\t        target.subjectId,\n   162\t        target.form,\n   163\t      );\n   164\t    if (Number(changed.changes) !== 1) {\n   165\t      throw new Error(\n   166\t        `fixture setFormState hit ${String(changed.changes)} rows for ${target.subjectKind}/${target.subjectId}/${target.form}; expected the pending row from enqueue`,\n   167\t      );\n   168\t    }\n   169\t  } finally {\n   170\t    db.close();\n   171\t  }\n   172\t}\n   173\t\n   174\t// ── multi-state thread: every form state in one file ─────────────\n   175\t\n   176\texport interface MultiStateClaim {\n   177\t  subjectKind: SubjectKind;\n   178\t  subjectId: string;\n   179\t  form: FormKind;\n   180\t  state: DerivedFormState;\n   181\t}\n   182\t\n   183\texport async function multiStateThread(\n   184\t  store: TempStore,\n   185\t): Promise<{ filePath: string; expected: MultiStateClaim[] }> {\n   186\t  const filePath = await newThreadFile(store);\n   187\t  // Turn 1: prompt + tool run; turn 2: prompt. Intake's enqueue leaves every\n   188\t  // form pending; the writes below move a subset into the other three states.\n   189\t  await send(filePath, [\n   190\t    validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n   191\t    validEvent(\"assistant_text\", { payload: { text: \"working on it\" } }),\n   192\t    validEvent(\"tool_call\", {\n   193\t      payload: { toolCallId: \"call-ms-1\", toolName: \"read_file\", arguments: { path: \"a.txt\" } },\n   194\t    }),\n   195\t    validEvent(\"tool_result\", {\n   196\t      payload: { toolCallId: \"call-ms-1\", content: \"contents of a.txt\", isError: false },\n   197\t    }),\n   198\t    validEvent(\"turn_end\"),\n   199\t    validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n   200\t    validEvent(\"turn_end\"),\n   201\t  ]);\n   202\t  const derivedAt = \"2026-06-10T12:00:00.000Z\";\n   203\t  setFormState(\n   204\t    filePath,\n   205\t    { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n   206\t    { state: \"ready\", content: \"smoothed(fixture:first prompt)\", derivedAt },\n   207\t  );\n   208\t  // Tool-activity outcome lives in machine-readable metadata, never inside\n   209\t  // provider-authored content (FC-0.3).\n   210\t  setFormState(\n   211\t    filePath,\n   212\t    { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\" },\n   213\t    {\n   214\t      state: \"ready\",\n   215\t      content: \"toolresult(fixture:contents of a.txt)\",\n   216\t      metadata: { outcome: \"succeeded\" },\n   217\t      derivedAt,\n   218\t    },\n   219\t  );\n   220\t  setFormState(\n   221\t    filePath,\n   222\t    { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n   223\t    { state: \"failed\", reason: \"provider_failure: scripted exhaustion (fixture)\" },\n   224\t  );\n   225\t  setFormState(\n   226\t    filePath,\n   227\t    { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\" },\n   228\t    { state: \"blocked\", reason: \"source_damaged: manufactured damage (fixture)\" },\n   229\t  );\n   230\t  return {\n   231\t    filePath,\n   232\t    expected: [\n   233\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\", state: \"ready\" },\n   234\t      { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\", state: \"ready\" },\n   235\t      { subjectKind: \"message\", subjectId: \"m6\", form: \"smoothed_prompt\", state: \"pending\" },\n   236\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\", state: \"failed\" },\n   237\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\", state: \"pending\" },\n   238\t      { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\", state: \"blocked\" },\n   239\t      { subjectKind: \"turn\", subjectId: \"t2\", form: \"lower_band_projection\", state: \"pending\" },\n   240\t    ],\n   241\t  };\n   242\t}\n   243\t\n   244\t// ── damaged-source thread (Epic 01 corruption definition) ────────\n   245\t\n   246\t// A closed turn with its turn_derivation work queued, then the Epic 01\n   247\t// two-open-turns corruption — the damage a turn handler must find and the\n   248\t// intake pipeline refuses (turn_state_corrupt).\n   249\texport async function damagedSourceThread(\n   250\t  store: TempStore,\n   251\t): Promise<{ filePath: string; turnId: string }> {\n   252\t  const { filePath, turnIds } = await threadWithClosedTurns(store, 1);\n   253\t  // Open a second turn through real intake; the corruption writer then adds\n   254\t  // another open row — two open turns, the Epic 01 invariant violation.\n   255\t  await send(filePath, [validEvent(\"user_prompt\", { payload: { text: \"left open\" } })]);\n   256\t  corruptTwoOpenTurns(filePath);\n   257\t  const turnId = turnIds[0];\n   258\t  if (turnId === undefined) throw new Error(\"fixture invariant: one closed turn expected\");\n   259\t  return { filePath, turnId };\n   260\t}\n   261\t\n   262\t// ── twin SDK/CLI threads for parity tests ────────────────────────\n   263\t\n   264\t// The same batch recorded through the SDK entry and the in-process CLI\n   265\t// adapter, under one injected clock, so the two files are comparable\n   266\t// record-for-record. Distinct idempotency-key spaces are unnecessary: keys\n   267\t// scope per thread file.\n   268\texport async function twinThreads(\n   269\t  store: TempStore,\n   270\t  batch?: readonly MessageEventInput[],\n   271\t): Promise<{ sdkPath: string; cliPath: string; batch: readonly MessageEventInput[] }> {\n   272\t  const events =\n   273\t    batch ??\n   274\t    ([\n   275\t      validEvent(\"user_prompt\", { payload: { text: \"twin prompt\" } }),\n   276\t      validEvent(\"assistant_text\", { payload: { text: \"twin answer\" } }),\n   277\t      validEvent(\"tool_call\", {\n   278\t        payload: { toolCallId: \"call-twin-1\", toolName: \"read_file\", arguments: { path: \"t.txt\" } },\n   279\t      }),\n   280\t      validEvent(\"tool_result\", {\n   281\t        payload: { toolCallId: \"call-twin-1\", content: \"twin tool output\", isError: false },\n   282\t      }),\n   283\t      validEvent(\"turn_end\"),\n   284\t    ] as const);\n   285\t\n   286\t  setIntakeClock(() => new Date(\"2026-06-10T12:00:00.000Z\"));\n   287\t  try {\n   288\t    const sdkPath = await newThreadFile(store);\n   289\t    await send(sdkPath, events);\n   290\t\n   291\t    const cliPath = store.threadPath();\n   292\t    const created = await runCli([\n   293\t      \"threads\",\n   294\t      \"new-thread\",\n   295\t      \"--file-path\",\n   296\t      cliPath,\n   297\t      \"--registry\",\n   298\t      store.registryPath,\n   299\t    ]);\n   300\t    if (created.exitCode !== 0) {\n   301\t      throw new Error(`fixture CLI new-thread failed: ${created.stdout}`);\n   302\t    }\n   303\t    const recorded = await runCli(\n   304\t      [\"intake-stream\", \"message-events\", \"--file-path\", cliPath],\n   305\t      async () => JSON.stringify(events),\n   306\t    );\n   307\t    if (recorded.exitCode !== 0) {\n   308\t      throw new Error(`fixture CLI message-events failed: ${recorded.stdout}`);\n   309\t    }\n   310\t    return { sdkPath, cliPath, batch: events };\n   311\t  } finally {\n   312\t    setIntakeClock(null);\n   313\t  }\n   314\t}\n","exit_code":0,"status":"completed"}}

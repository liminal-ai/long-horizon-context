{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/thread-migration.test.ts'","aggregated_output":"     1\t// F-03-001: an existing valid Story 2 thread file (user_version=1, only\n     2\t// thread_metadata/event tables) must be migrated to the current schema before\n     3\t// any Story 3 message write or read. The fixture reproduces the accepted\n     4\t// Story 2 on-disk layout exactly; the assertions go through the production\n     5\t// entry points (messageEvents, listMessages, listEvents) plus below-SDK\n     6\t// schema-version reads.\n     7\t// F-03-002: the lazy opener must reject existing files that are not thread\n     8\t// files without creating lhc schema or bumping user_version on them.\n     9\timport { readFileSync, writeFileSync } from \"node:fs\";\n    10\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    11\timport { intakeStream, messages, turns } from \"../src/index.js\";\n    12\timport {\n    13\t  legacyEpic01ThreadFile,\n    14\t  legacyStory2ThreadFile,\n    15\t  openRaw,\n    16\t  readDerivedForms,\n    17\t  schemaVersionOf,\n    18\t  tempStore,\n    19\t  validEvent,\n    20\t  type TempStore,\n    21\t} from \"./fixtures/index.js\";\n    22\t\n    23\tlet store: TempStore;\n    24\tbeforeEach(() => {\n    25\t  store = tempStore();\n    26\t});\n    27\tafterEach(() => {\n    28\t  store.cleanup();\n    29\t});\n    30\t\n    31\tconst legacyEvent = {\n    32\t  eventOrder: 1,\n    33\t  eventKind: \"user_prompt\",\n    34\t  idempotencyKey: \"legacy-key-1\",\n    35\t  actor: \"legacy-actor\",\n    36\t  harness: \"legacy-harness\",\n    37\t  payload: { text: \"recorded before story 3 shipped\" },\n    38\t  recordedAt: \"2026-06-01T00:00:01.000Z\",\n    39\t};\n    40\t\n    41\tdescribe(\"F-03-001: Story 2 thread files migrate before message write/read\", () => {\n    42\t  it(\"messageEvents on a Story 2 file upgrades the schema, keeps the legacy record intact, and projects the new events\", async () => {\n    43\t    const filePath = store.threadPath();\n    44\t    legacyStory2ThreadFile(filePath, \"th_legacy01\", [legacyEvent]);\n    45\t    expect(schemaVersionOf(filePath)).toBe(1);\n    46\t\n    47\t    const result = await intakeStream.messageEvents({ filePath }, [\n    48\t      validEvent(\"assistant_text\", { payload: { text: \"answered after upgrade\" } }),\n    49\t      validEvent(\"turn_end\"),\n    50\t    ]);\n    51\t    expect(result.ok).toBe(true);\n    52\t    if (!result.ok) return;\n    53\t    expect(result.value.events.map((entry) => entry.outcome)).toEqual([\n    54\t      \"recorded\",\n    55\t      \"recorded\",\n    56\t    ]);\n    57\t    // The order counter continues from the legacy record; the new message id\n    58\t    // derives from the continued order.\n    59\t    expect(result.value.threadPosition.lastEventOrder).toBe(3);\n    60\t    expect(result.value.events[0]!.messageId).toBe(\"m2\");\n    61\t\n    62\t    expect(schemaVersionOf(filePath)).toBe(5);\n    63\t\n    64\t    // The legacy event survives the upgrade byte-for-byte at the SDK level.\n    65\t    const events = await intakeStream.listEvents({ filePath });\n    66\t    expect(events.ok).toBe(true);\n    67\t    if (!events.ok) return;\n    68\t    expect(events.value).toHaveLength(3);\n    69\t    expect(events.value[0]).toEqual({\n    70\t      eventKind: \"user_prompt\",\n    71\t      idempotencyKey: \"legacy-key-1\",\n    72\t      actor: \"legacy-actor\",\n    73\t      harness: \"legacy-harness\",\n    74\t      payload: { text: \"recorded before story 3 shipped\" },\n    75\t      eventOrder: 1,\n    76\t      recordedAt: \"2026-06-01T00:00:01.000Z\",\n    77\t    });\n    78\t\n    79\t    // Projection is intake-time, not retroactive: the new assistant_text\n    80\t    // projects; the legacy pre-Story-3 event stays event-only.\n    81\t    const projected = await messages.listMessages({ filePath });\n    82\t    expect(projected.ok).toBe(true);\n    83\t    if (!projected.ok) return;\n    84\t    expect(projected.value).toHaveLength(1);\n    85\t    expect(projected.value[0]!.messageId).toBe(\"m2\");\n    86\t    expect(projected.value[0]!.sourceEventOrder).toBe(2);\n    87\t    expect(projected.value[0]!.blocks).toEqual([\n    88\t      { blockType: \"text\", content: { text: \"answered after upgrade\" } },\n    89\t    ]);\n    90\t    expect(projected.value[0]!.tokenEstimate).toBeGreaterThan(0);\n    91\t  });\n    92\t\n    93\t  it(\"listMessages on an untouched Story 2 file migrates on read and returns an empty list\", async () => {\n    94\t    const filePath = store.threadPath();\n    95\t    legacyStory2ThreadFile(filePath, \"th_legacy02\", [legacyEvent]);\n    96\t    expect(schemaVersionOf(filePath)).toBe(1);\n    97\t\n    98\t    const projected = await messages.listMessages({ filePath });\n    99\t    expect(projected.ok).toBe(true);\n   100\t    if (!projected.ok) return;\n   101\t    expect(projected.value).toEqual([]);\n   102\t\n   103\t    expect(schemaVersionOf(filePath)).toBe(5);\n   104\t\n   105\t    // The read-path upgrade changed no record content.\n   106\t    const events = await intakeStream.listEvents({ filePath });\n   107\t    expect(events.ok).toBe(true);\n   108\t    if (!events.ok) return;\n   109\t    expect(events.value).toHaveLength(1);\n   110\t    expect(events.value[0]!.idempotencyKey).toBe(\"legacy-key-1\");\n   111\t  });\n   112\t\n   113\t  it(\"idempotency keys recorded under Story 2 still skip after the upgrade\", async () => {\n   114\t    const filePath = store.threadPath();\n   115\t    legacyStory2ThreadFile(filePath, \"th_legacy03\", [legacyEvent]);\n   116\t\n   117\t    const resend = await intakeStream.messageEvents({ filePath }, [\n   118\t      validEvent(\"user_prompt\", {\n   119\t        idempotencyKey: \"legacy-key-1\",\n   120\t        payload: { text: \"resent after upgrade\" },\n   121\t      }),\n   122\t    ]);\n   123\t    expect(resend.ok).toBe(true);\n   124\t    if (!resend.ok) return;\n   125\t    expect(resend.value.events[0]).toEqual({\n   126\t      idempotencyKey: \"legacy-key-1\",\n   127\t      outcome: \"skipped\",\n   128\t      skipReason: \"duplicate_idempotency_key\",\n   129\t    });\n   130\t\n   131\t    // No message was created for the skipped resend of the legacy event.\n   132\t    const projected = await messages.listMessages({ filePath });\n   133\t    expect(projected.ok).toBe(true);\n   134\t    if (!projected.ok) return;\n   135\t    expect(projected.value).toEqual([]);\n   136\t  });\n   137\t});\n   138\t\n   139\t// Tables present in a file, by name — asserts what schema (if any) the\n   140\t// rejected open left behind.\n   141\tfunction tableNames(filePath: string): string[] {\n   142\t  const db = openRaw(filePath);\n   143\t  try {\n   144\t    const rows = db\n   145\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' ORDER BY name\")\n   146\t      .all() as unknown as Array<{ name: string }>;\n   147\t    return rows.map((row) => row.name);\n   148\t  } finally {\n   149\t    db.close();\n   150\t  }\n   151\t}\n   152\t\n   153\tdescribe(\"F-03-002: non-thread files are rejected, not adopted\", () => {\n   154\t  it(\"listMessages against an existing empty database file fails without creating schema or bumping user_version\", async () => {\n   155\t    const filePath = store.threadPath();\n   156\t    writeFileSync(filePath, \"\"); // exists, zero bytes — a valid empty SQLite database\n   157\t\n   158\t    const result = await messages.listMessages({ filePath });\n   159\t    expect(result.ok).toBe(false);\n   160\t    if (result.ok) return;\n   161\t    expect(result.error.errorClass).toBe(\"caller_error\");\n   162\t    expect(result.error.code).toBe(\"thread_not_found\");\n   163\t    expect(result.error.reason).toContain(\"not an lhc thread file\");\n   164\t\n   165\t    expect(schemaVersionOf(filePath)).toBe(0);\n   166\t    expect(tableNames(filePath)).toEqual([]);\n   167\t  });\n   168\t\n   169\t  it(\"messageEvents against an unrelated SQLite database fails and leaves its content untouched\", async () => {\n   170\t    const filePath = store.threadPath();\n   171\t    const foreign = openRaw(filePath);\n   172\t    try {\n   173\t      foreign.exec(\"CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT NOT NULL);\");\n   174\t      foreign.prepare(\"INSERT INTO notes (id, body) VALUES (1, ?)\").run(\"not lhc data\");\n   175\t    } finally {\n   176\t      foreign.close();\n   177\t    }\n   178\t\n   179\t    const result = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n   180\t    expect(result.ok).toBe(false);\n   181\t    if (result.ok) return;\n   182\t    expect(result.error.errorClass).toBe(\"caller_error\");\n   183\t    expect(result.error.code).toBe(\"thread_not_found\");\n   184\t    expect(result.error.reason).toContain(\"not an lhc thread file\");\n   185\t\n   186\t    // No lhc tables were created, the version was not bumped, and the\n   187\t    // foreign data is intact.\n   188\t    expect(schemaVersionOf(filePath)).toBe(0);\n   189\t    expect(tableNames(filePath)).toEqual([\"notes\"]);\n   190\t    const db = openRaw(filePath);\n   191\t    try {\n   192\t      const row = db.prepare(\"SELECT body FROM notes WHERE id = 1\").get() as unknown as {\n   193\t        body: string;\n   194\t      };\n   195\t      expect(row.body).toBe(\"not lhc data\");\n   196\t    } finally {\n   197\t      db.close();\n   198\t    }\n   199\t  });\n   200\t\n   201\t  it(\"a non-SQLite file is rejected as a caller error with its bytes unchanged\", async () => {\n   202\t    const filePath = store.threadPath();\n   203\t    const original = \"just some text, definitely not a database\\n\";\n   204\t    writeFileSync(filePath, original);\n   205\t\n   206\t    const listed = await messages.listMessages({ filePath });\n   207\t    expect(listed.ok).toBe(false);\n   208\t    if (listed.ok) return;\n   209\t    expect(listed.error.errorClass).toBe(\"caller_error\");\n   210\t    expect(listed.error.code).toBe(\"thread_not_found\");\n   211\t\n   212\t    const batched = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n   213\t    expect(batched.ok).toBe(false);\n   214\t    if (batched.ok) return;\n   215\t    expect(batched.error.errorClass).toBe(\"caller_error\");\n   216\t    expect(batched.error.code).toBe(\"thread_not_found\");\n   217\t\n   218\t    expect(readFileSync(filePath, \"utf8\")).toBe(original);\n   219\t  });\n   220\t});\n   221\t\n   222\t// Story 0 (Epic 02), FC-0.5 + architecture risk \"migration on live data\":\n   223\t// v5 applies in place to a populated Epic 01 file — existing rows intact,\n   224\t// new columns defaulted, the F-02 backfill creating pending derived_form\n   225\t// rows for live queued items. A fresh-file migration test would pass while\n   226\t// breaking real threads; this one runs over real Epic 01 data.\n   227\tdescribe(\"FC-0.5: migration v5 over a populated Epic 01 thread file\", () => {\n   228\t  it(\"upgrades in place: records intact, queue columns defaulted, F-02 backfill pending rows present\", async () => {\n   229\t    const filePath = store.threadPath();\n   230\t    legacyEpic01ThreadFile(filePath, \"th_epic01\");\n   231\t    expect(schemaVersionOf(filePath)).toBe(4);\n   232\t\n   233\t    // Any SDK read migrates lazily; the read itself must succeed post-v5.\n   234\t    const projected = await messages.listMessages({ filePath });\n   235\t    expect(projected.ok).toBe(true);\n   236\t    if (!projected.ok) return;\n   237\t    expect(schemaVersionOf(filePath)).toBe(5);\n   238\t\n   239\t    // Existing records intact through the production read surfaces.\n   240\t    expect(projected.value.map((m) => m.messageId)).toEqual([\"m1\", \"m2\", \"m3\"]);\n   241\t    const events = await intakeStream.listEvents({ filePath });\n   242\t    expect(events.ok).toBe(true);\n   243\t    if (!events.ok) return;\n   244\t    expect(events.value).toHaveLength(4);\n   245\t    const turnRecords = await turns.listTurns({ filePath });\n   246\t    expect(turnRecords.ok).toBe(true);\n   247\t    if (!turnRecords.ok) return;\n   248\t    expect(turnRecords.value).toEqual([\n   249\t      {\n   250\t        turnId: \"t1\",\n   251\t        status: \"closed\",\n   252\t        memberMessageIds: [\"m1\", \"m2\", \"m3\"],\n   253\t        openedAtEventOrder: 1,\n   254\t        closedAtEventOrder: 4,\n   255\t      },\n   256\t    ]);\n   257\t\n   258\t    // Work rows survive with their pre-v5 ids; the queue's mechanical\n   259\t    // columns exist and default to not-claimed / immediately eligible.\n   260\t    const db = openRaw(filePath);\n   261\t    try {\n   262\t      const items = db\n   263\t        .prepare(\n   264\t          `SELECT work_item_id, status, attempts, last_error, claimed_at,\n   265\t                  claim_expires_at, eligible_at, payload\n   266\t           FROM work_item ORDER BY work_item_id`,\n   267\t        )\n   268\t        .all() as unknown as Array<Record<string, unknown>>;\n   269\t      expect(items.map((row) => row.work_item_id)).toEqual([\n   270\t        \"w-m1-prompt_smoothing\",\n   271\t        \"w-m3-tool_result_summary\",\n   272\t        \"w-t1-turn_derivation\",\n   273\t      ]);\n   274\t      for (const row of items) {\n   275\t        expect(row.status).toBe(\"queued\");\n   276\t        expect(Number(row.attempts)).toBe(0);\n   277\t        expect(row.last_error).toBeNull();\n   278\t        expect(row.claimed_at).toBeNull();\n   279\t        expect(row.claim_expires_at).toBeNull();\n   280\t        expect(row.eligible_at).toBeNull();\n   281\t        expect(row.payload).toBeNull();\n   282\t      }\n   283\t      // The epic's other v5 surfaces exist (schema ships whole): chunk\n   284\t      // tables empty, deleted_at stamps present and null.\n   285\t      const chunkCount = db.prepare(\"SELECT COUNT(*) AS n FROM chunk\").get() as { n: number | bigint };\n   286\t      expect(Number(chunkCount.n)).toBe(0);\n   287\t      const deleted = db\n   288\t        .prepare(\"SELECT COUNT(*) AS n FROM message WHERE deleted_at IS NOT NULL\")\n   289\t        .get() as { n: number | bigint };\n   290\t      expect(Number(deleted.n)).toBe(0);\n   291\t    } finally {\n   292\t      db.close();\n   293\t    }\n   294\t\n   295\t    // F-02 backfill: one pending row per live queued item, mapped per kind —\n   296\t    // turn_derivation fans out to both turn forms; all at source version 1.\n   297\t    expect(\n   298\t      readDerivedForms(filePath).map(({ subjectKind, subjectId, form, state, sourceVersion }) => ({\n   299\t        subjectKind,\n   300\t        subjectId,\n   301\t        form,\n   302\t        state,\n   303\t        sourceVersion,\n   304\t      })),\n   305\t    ).toEqual([\n   306\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\", state: \"pending\", sourceVersion: 1 },\n   307\t      { subjectKind: \"message\", subjectId: \"m3\", form: \"tool_result_summary\", state: \"pending\", sourceVersion: 1 },\n   308\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\", state: \"pending\", sourceVersion: 1 },\n   309\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\", state: \"pending\", sourceVersion: 1 },\n   310\t    ]);\n   311\t\n   312\t    // The migrated file keeps working through the Epic 01 write path: a new\n   313\t    // batch records, projects, and queues against the v5 schema.\n   314\t    const batch = await intakeStream.messageEvents({ filePath }, [\n   315\t      validEvent(\"user_prompt\", { payload: { text: \"recorded after the upgrade\" } }),\n   316\t      validEvent(\"turn_end\"),\n   317\t    ]);\n   318\t    expect(batch.ok).toBe(true);\n   319\t    if (!batch.ok) return;\n   320\t    expect(batch.value.events.map((entry) => entry.outcome)).toEqual([\"recorded\", \"recorded\"]);\n   321\t    expect(batch.value.queuedWork.map((item) => item.workItemId)).toEqual([\n   322\t      \"w-m5-prompt_smoothing-v1\",\n   323\t      \"w-t2-turn_derivation-v1\",\n   324\t    ]);\n   325\t  });\n   326\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/fixtures.test.ts'","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { describe, expect, it } from \"vitest\";\n     3\timport type { EventKind } from \"../src/index.js\";\n     4\timport {\n     5\t  conversationTurn,\n     6\t  eventBatch,\n     7\t  openRaw,\n     8\t  tempStore,\n     9\t  validEvent,\n    10\t} from \"./fixtures/index.js\";\n    11\t\n    12\tconst ALL_KINDS: readonly EventKind[] = [\n    13\t  \"user_prompt\",\n    14\t  \"assistant_text\",\n    15\t  \"assistant_thinking\",\n    16\t  \"runtime_note\",\n    17\t  \"tool_call\",\n    18\t  \"tool_result\",\n    19\t  \"turn_end\",\n    20\t];\n    21\t\n    22\tconst GOLDEN_PAYLOAD_KEYS: Record<EventKind, string[]> = {\n    23\t  user_prompt: [\"text\"],\n    24\t  assistant_text: [\"text\"],\n    25\t  assistant_thinking: [\"text\"],\n    26\t  runtime_note: [\"text\"],\n    27\t  tool_call: [\"toolCallId\", \"toolName\", \"arguments\"],\n    28\t  tool_result: [\"toolCallId\", \"content\", \"isError\"],\n    29\t  turn_end: [],\n    30\t};\n    31\t\n    32\tdescribe(\"FC-0.4: fixture builders\", () => {\n    33\t  it(\"validEvent produces a golden-shaped event for every kind\", () => {\n    34\t    for (const kind of ALL_KINDS) {\n    35\t      const event = validEvent(kind);\n    36\t      expect(event.eventKind).toBe(kind);\n    37\t      expect(event.idempotencyKey.length).toBeGreaterThan(0);\n    38\t      expect(event.actor.length).toBeGreaterThan(0);\n    39\t      expect(event.harness.length).toBeGreaterThan(0);\n    40\t      expect(Object.keys(event.payload).sort()).toEqual(\n    41\t        [...GOLDEN_PAYLOAD_KEYS[kind]].sort(),\n    42\t      );\n    43\t      expect(Object.keys(event).sort()).toEqual(\n    44\t        [\"actor\", \"eventKind\", \"harness\", \"idempotencyKey\", \"payload\"].sort(),\n    45\t      );\n    46\t    }\n    47\t  });\n    48\t\n    49\t  it(\"validEvent applies overrides without changing the kind\", () => {\n    50\t    const event = validEvent(\"user_prompt\", {\n    51\t      actor: \"custom-actor\",\n    52\t      payload: { text: \"custom prompt\" },\n    53\t    });\n    54\t    expect(event.eventKind).toBe(\"user_prompt\");\n    55\t    expect(event.actor).toBe(\"custom-actor\");\n    56\t    expect(event.payload.text).toBe(\"custom prompt\");\n    57\t  });\n    58\t\n    59\t  it(\"building an invalid kind/payload pairing requires an explicit cast\", () => {\n    60\t    const forced = validEvent(\"user_prompt\", {\n    61\t      // @ts-expect-error — a tool_call payload on a user_prompt event must not compile\n    62\t      payload: { toolCallId: \"x\", toolName: \"y\", arguments: {} },\n    63\t    });\n    64\t    expect(forced.eventKind).toBe(\"user_prompt\");\n    65\t  });\n    66\t\n    67\t  it(\"eventBatch yields unique idempotency keys in order\", () => {\n    68\t    const batch = eventBatch(ALL_KINDS);\n    69\t    expect(batch.map((e) => e.eventKind)).toEqual([...ALL_KINDS]);\n    70\t    const keys = new Set(batch.map((e) => e.idempotencyKey));\n    71\t    expect(keys.size).toBe(batch.length);\n    72\t  });\n    73\t\n    74\t  it(\"conversationTurn is one complete turn\", () => {\n    75\t    expect(conversationTurn().map((e) => e.eventKind)).toEqual([\n    76\t      \"user_prompt\",\n    77\t      \"assistant_text\",\n    78\t      \"tool_call\",\n    79\t      \"tool_result\",\n    80\t      \"turn_end\",\n    81\t    ]);\n    82\t  });\n    83\t\n    84\t  it(\"tempStore creates an isolated directory and cleans it up\", () => {\n    85\t    const store = tempStore();\n    86\t    expect(existsSync(store.dir)).toBe(true);\n    87\t    expect(store.registryPath.startsWith(store.dir)).toBe(true);\n    88\t    const a = store.threadPath();\n    89\t    const b = store.threadPath();\n    90\t    expect(a).not.toBe(b);\n    91\t    store.cleanup();\n    92\t    expect(existsSync(store.dir)).toBe(false);\n    93\t  });\n    94\t\n    95\t  it(\"openRaw opens a real sqlite handle for below-SDK assertions\", () => {\n    96\t    const store = tempStore();\n    97\t    const path = store.threadPath(\"raw\");\n    98\t    const writer = openRaw(path);\n    99\t    writer.exec(\"CREATE TABLE probe (id INTEGER PRIMARY KEY, note TEXT)\");\n   100\t    writer.exec(\"INSERT INTO probe (note) VALUES ('hello')\");\n   101\t    writer.close();\n   102\t    const reader = openRaw(path);\n   103\t    const row = reader.prepare(\"SELECT note FROM probe WHERE id = 1\").get() as\n   104\t      | { note: string }\n   105\t      | undefined;\n   106\t    expect(row?.note).toBe(\"hello\");\n   107\t    reader.close();\n   108\t    store.cleanup();\n   109\t  });\n   110\t});\n   111\t\n   112\t// ── Story 0 (Epic 02): provider double, shared types, fixture builders ──\n   113\t\n   114\timport { afterEach, beforeEach } from \"vitest\";\n   115\timport {\n   116\t  createSdk,\n   117\t  intakeStream,\n   118\t  messages,\n   119\t  turns,\n   120\t  type DerivationProvider,\n   121\t  type DerivedForm,\n   122\t  type ProviderResult,\n   123\t} from \"../src/index.js\";\n   124\timport {\n   125\t  createProviderDouble,\n   126\t  damagedSourceThread,\n   127\t  multiStateThread,\n   128\t  readDerivedForms,\n   129\t  threadWithClosedTurns,\n   130\t  threadWithToolRun,\n   131\t  twinThreads,\n   132\t  type TempStore,\n   133\t} from \"./fixtures/index.js\";\n   134\t\n   135\t// One call per operation with a fixed, distinct input — the seven-op sweep\n   136\t// FC-0.1/FC-0.2 iterate.\n   137\tfunction callAllSeven(double: DerivationProvider): Array<Promise<ProviderResult>> {\n   138\t  return [\n   139\t    double.smoothPrompt({ text: \"please smooth this prompt text\" }),\n   140\t    double.summarizeToolCall({\n   141\t      toolName: \"read_file\",\n   142\t      argsJson: JSON.stringify({ path: \"notes.txt\" }),\n   143\t      pairedResult: { content: \"file contents here\", isError: false },\n   144\t    }),\n   145\t    double.summarizeToolResult({ toolName: \"read_file\", content: \"tool result content\" }),\n   146\t    double.composeTurnRendering({\n   147\t      parts: [\n   148\t        { messageId: \"m1\", kind: \"user_prompt\", text: \"smoothed prompt\", fallback: false },\n   149\t      ],\n   150\t    }),\n   151\t    double.projectLowerBand({ rendering: \"the rendering text\" }),\n   152\t    double.summarizeChunkDetailed({ memberProjections: [\"projection one\", \"projection two\"] }),\n   153\t    double.summarizeChunkBrief({ memberProjections: [\"projection one\", \"projection two\"] }),\n   154\t  ];\n   155\t}\n   156\t\n   157\tconst SEVEN_MARKERS = [\n   158\t  \"smoothed\",\n   159\t  \"toolcall\",\n   160\t  \"toolresult\",\n   161\t  \"rendering\",\n   162\t  \"projection\",\n   163\t  \"detailed\",\n   164\t  \"brief\",\n   165\t] as const;\n   166\t\n   167\tdescribe(\"FC-0.1 / FC-0.2: deterministic provider double\", () => {\n   168\t  it(\"FC-0.1: implements all seven operations with marked, input-derived output\", async () => {\n   169\t    const results = await Promise.all(callAllSeven(createProviderDouble()));\n   170\t    for (const [index, result] of results.entries()) {\n   171\t      expect(result.ok).toBe(true);\n   172\t      if (!result.ok) continue;\n   173\t      expect(result.text.startsWith(`${SEVEN_MARKERS[index]}(`)).toBe(true);\n   174\t    }\n   175\t    // Input-derived, not canned: a different input to the same operation\n   176\t    // yields different marked output.\n   177\t    const double = createProviderDouble();\n   178\t    const a = await double.smoothPrompt({ text: \"first input\" });\n   179\t    const b = await double.smoothPrompt({ text: \"second input\" });\n   180\t    if (!a.ok || !b.ok) throw new Error(\"double failed unscripted\");\n   181\t    expect(a.text).not.toBe(b.text);\n   182\t    expect(a.text).toContain(\"first input\");\n   183\t  });\n   184\t\n   185\t  it(\"FC-0.2: identical input yields identical output across double instances; operations are distinguishable\", async () => {\n   186\t    const first = await Promise.all(callAllSeven(createProviderDouble()));\n   187\t    const second = await Promise.all(callAllSeven(createProviderDouble()));\n   188\t    expect(first).toEqual(second);\n   189\t    const texts = first.map((r) => (r.ok ? r.text : \"\"));\n   190\t    expect(new Set(texts).size).toBe(7);\n   191\t    expect(texts.map((t) => t.slice(0, t.indexOf(\"(\")))).toEqual([...SEVEN_MARKERS]);\n   192\t  });\n   193\t\n   194\t  it(\"FC-0.2: failNext drives fail-N-then-succeed with the scripted retryability\", async () => {\n   195\t    const double = createProviderDouble();\n   196\t    double.failNext(2, { retryable: true });\n   197\t    const r1 = await double.smoothPrompt({ text: \"x\" });\n   198\t    const r2 = await double.summarizeChunkBrief({ memberProjections: [\"y\"] });\n   199\t    const r3 = await double.smoothPrompt({ text: \"x\" });\n   200\t    expect(r1).toMatchObject({ ok: false, retryable: true });\n   201\t    expect(r2).toMatchObject({ ok: false, retryable: true });\n   202\t    expect(r3.ok).toBe(true);\n   203\t    // ...and exactly N calls consumed the script: the recovered output is\n   204\t    // the deterministic one a fresh double produces.\n   205\t    const fresh = await createProviderDouble().smoothPrompt({ text: \"x\" });\n   206\t    expect(r3).toEqual(fresh);\n   207\t  });\n   208\t\n   209\t  it(\"FC-0.2: failKind scripts terminal failure per operation, by kind alias, without touching other kinds\", async () => {\n   210\t    const double = createProviderDouble();\n   211\t    double.failKind(\"prompt_smoothing\", 99, { retryable: false, reason: \"content refusal\" });\n   212\t    const failed = await double.smoothPrompt({ text: \"x\" });\n   213\t    expect(failed).toEqual({ ok: false, retryable: false, reason: \"content refusal\" });\n   214\t    const other = await double.summarizeToolResult({ toolName: \"t\", content: \"c\" });\n   215\t    expect(other.ok).toBe(true);\n   216\t  });\n   217\t\n   218\t  it(\"FC-0.2: delayKind injects latency on the scripted operation\", async () => {\n   219\t    const double = createProviderDouble();\n   220\t    double.delayKind(\"chunk_summary_detailed\", 40);\n   221\t    const before = Date.now();\n   222\t    const result = await double.summarizeChunkDetailed({ memberProjections: [\"p\"] });\n   223\t    const elapsed = Date.now() - before;\n   224\t    expect(result.ok).toBe(true);\n   225\t    expect(elapsed).toBeGreaterThanOrEqual(35);\n   226\t  });\n   227\t\n   228\t  it(\"scripting and capture state are per-instance — nothing leaks across doubles\", async () => {\n   229\t    const scripted = createProviderDouble();\n   230\t    const clean = createProviderDouble();\n   231\t    const capturedScripted = scripted.captureInputs();\n   232\t    scripted.failNext(1);\n   233\t    const cleanResult = await clean.smoothPrompt({ text: \"untouched\" });\n   234\t    expect(cleanResult.ok).toBe(true);\n   235\t    expect(capturedScripted).toHaveLength(0);\n   236\t    const capturedClean = clean.captureInputs();\n   237\t    await clean.projectLowerBand({ rendering: \"r\" });\n   238\t    expect(capturedClean).toEqual([{ op: \"projectLowerBand\", input: { rendering: \"r\" } }]);\n   239\t    expect(capturedScripted).toHaveLength(0);\n   240\t    const scriptedResult = await scripted.smoothPrompt({ text: \"untouched\" });\n   241\t    expect(scriptedResult.ok).toBe(false);\n   242\t    expect(capturedScripted).toEqual([{ op: \"smoothPrompt\", input: { text: \"untouched\" } }]);\n   243\t  });\n   244\t});\n   245\t\n   246\tdescribe(\"FC-0.1 (production seam): createSdk assembles with the double injected where production adapters go\", () => {\n   247\t  it(\"resolves config defaults centrally and carries the injected provider and mode\", () => {\n   248\t    const double = createProviderDouble();\n   249\t    const sdk = createSdk({ provider: double, mode: \"manual\" });\n   250\t    expect(sdk.config.provider).toBe(double);\n   251\t    expect(sdk.config.mode).toBe(\"manual\");\n   252\t    expect(sdk.config.retry).toEqual({ budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 });\n   253\t    expect(sdk.config.lease).toEqual({ durationMs: 120000 });\n   254\t    expect(sdk.config.chunkPolicy).toEqual({\n   255\t      targetProjectedTokens: 2200,\n   256\t      maxProjectedTokens: 4400,\n   257\t    });\n   258\t    expect(sdk.scheduler.mode).toBe(\"manual\");\n   259\t    // The Epic 01 surfaces ride the assembled SDK.\n   260\t    expect(sdk.threads.newThread).toBeTypeOf(\"function\");\n   261\t    expect(sdk.intakeStream.messageEvents).toBeTypeOf(\"function\");\n   262\t  });\n   263\t\n   264\t  it(\"background mode is a validated construction option (behavior lands in Story 1)\", () => {\n   265\t    const sdk = createSdk({ provider: createProviderDouble(), mode: \"background\" });\n   266\t    expect(sdk.scheduler.mode).toBe(\"background\");\n   267\t    expect(() => sdk.scheduler.poke(\"th_x\")).not.toThrow();\n   268\t  });\n   269\t\n   270\t  it(\"rejects malformed config at construction: bad mode, incomplete provider, bad policy values\", () => {\n   271\t    const double = createProviderDouble();\n   272\t    expect(() =>\n   273\t      createSdk({ provider: double, mode: \"later\" as unknown as \"manual\" }),\n   274\t    ).toThrow(/mode/);\n   275\t    const incomplete = { smoothPrompt: double.smoothPrompt.bind(double) };\n   276\t    expect(() =>\n   277\t      createSdk({ provider: incomplete as unknown as DerivationProvider, mode: \"manual\" }),\n   278\t    ).toThrow(/missing operation/);\n   279\t    expect(() =>\n   280\t      createSdk({\n   281\t        provider: double,\n   282\t        mode: \"manual\",\n   283\t        chunkPolicy: { targetProjectedTokens: 4400, maxProjectedTokens: 2200 },\n   284\t      }),\n   285\t    ).toThrow(/chunkPolicy/);\n   286\t    expect(() =>\n   287\t      createSdk({\n   288\t        provider: double,\n   289\t        mode: \"manual\",\n   290\t        retry: { budget: 0, backoffBaseMs: 0, backoffCapMs: 0 },\n   291\t      }),\n   292\t    ).toThrow(/retry.budget/);\n   293\t  });\n   294\t});\n   295\t\n   296\tdescribe(\"FC-0.3 / FC-0.6: derived-form vocabulary and thread builders, verified by read-back\", () => {\n   297\t  let store: TempStore;\n   298\t  beforeEach(() => {\n   299\t    store = tempStore();\n   300\t  });\n   301\t  afterEach(() => {\n   302\t    store.cleanup();\n   303\t  });\n   304\t\n   305\t  it(\"threadWithClosedTurns: n closed turns read back closed with their members\", async () => {\n   306\t    const { filePath, turnIds } = await threadWithClosedTurns(store, 2);\n   307\t    expect(turnIds).toEqual([\"t1\", \"t2\"]);\n   308\t    const listed = await turns.listTurns({ filePath });\n   309\t    expect(listed.ok).toBe(true);\n   310\t    if (!listed.ok) return;\n   311\t    expect(listed.value.map((t) => [t.turnId, t.status])).toEqual([\n   312\t      [\"t1\", \"closed\"],\n   313\t      [\"t2\", \"closed\"],\n   314\t    ]);\n   315\t    expect(listed.value.every((t) => t.memberMessageIds.length === 2)).toBe(true);\n   316\t  });\n   317\t\n   318\t  it(\"threadWithToolRun: call+result pair recorded; error and missing-result variants hold their shapes\", async () => {\n   319\t    const paired = await threadWithToolRun(store);\n   320\t    const pairedMessages = await messages.listMessages({ filePath: paired.filePath });\n   321\t    expect(pairedMessages.ok).toBe(true);\n   322\t    if (!pairedMessages.ok) return;\n   323\t    expect(pairedMessages.value.map((m) => m.kind)).toEqual([\n   324\t      \"user_prompt\",\n   325\t      \"tool_call\",\n   326\t      \"tool_result\",\n   327\t    ]);\n   328\t\n   329\t    const errored = await threadWithToolRun(store, { isError: true });\n   330\t    const erroredMessages = await messages.listMessages({ filePath: errored.filePath });\n   331\t    expect(erroredMessages.ok).toBe(true);\n   332\t    if (!erroredMessages.ok) return;\n   333\t    const resultBlock = erroredMessages.value[2]?.blocks[0];\n   334\t    expect(resultBlock?.content.isError).toBe(true);\n   335\t\n   336\t    const missing = await threadWithToolRun(store, { missingResult: true });\n   337\t    const missingMessages = await messages.listMessages({ filePath: missing.filePath });\n   338\t    expect(missingMessages.ok).toBe(true);\n   339\t    if (!missingMessages.ok) return;\n   340\t    expect(missingMessages.value.map((m) => m.kind)).toEqual([\"user_prompt\", \"tool_call\"]);\n   341\t  });\n   342\t\n   343\t  it(\"FC-0.6: the multi-state thread reads back every claimed state — all four in one file\", async () => {\n   344\t    const { filePath, expected } = await multiStateThread(store);\n   345\t    const forms = readDerivedForms(filePath);\n   346\t    for (const claim of expected) {\n   347\t      const match = forms.find(\n   348\t        (f) =>\n   349\t          f.subjectKind === claim.subjectKind &&\n   350\t          f.subjectId === claim.subjectId &&\n   351\t          f.form === claim.form,\n   352\t      );\n   353\t      expect(match, `${claim.subjectKind}/${claim.subjectId}/${claim.form}`).toBeDefined();\n   354\t      expect(match?.state).toBe(claim.state);\n   355\t    }\n   356\t    const states = new Set(forms.map((f) => f.state));\n   357\t    expect([...states].sort()).toEqual([\"blocked\", \"failed\", \"pending\", \"ready\"]);\n   358\t    // State-shape contract: ready carries content, failed/blocked carry\n   359\t    // reasons, pending carries neither.\n   360\t    for (const form of forms) {\n   361\t      if (form.state === \"ready\") expect(form.content).toBeDefined();\n   362\t      if (form.state === \"failed\" || form.state === \"blocked\") {\n   363\t        expect(form.reason).toBeDefined();\n   364\t        expect(form.content).toBeUndefined();\n   365\t      }\n   366\t      if (form.state === \"pending\") {\n   367\t        expect(form.content).toBeUndefined();\n   368\t        expect(form.reason).toBeUndefined();\n   369\t      }\n   370\t    }\n   371\t  });\n   372\t\n   373\t  it(\"FC-0.3: tool-activity outcome lives in machine-readable metadata, never inside content\", async () => {\n   374\t    const { filePath } = await multiStateThread(store);\n   375\t    const toolForm = readDerivedForms(filePath).find((f) => f.form === \"tool_result_summary\");\n   376\t    expect(toolForm).toBeDefined();\n   377\t    expect(toolForm?.metadata).toEqual({ outcome: \"succeeded\" });\n   378\t    expect(toolForm?.content).not.toContain(\"succeeded\");\n   379\t    // The shared vocabulary is the compile-time contract both owning domains\n   380\t    // consume; this read shape is that type.\n   381\t    const typed: DerivedForm | undefined = toolForm;\n   382\t    expect(typed?.state).toBe(\"ready\");\n   383\t  });\n   384\t\n   385\t  it(\"FC-0.6: the damaged-source thread reads back the corruption it claims (Epic 01 definition)\", async () => {\n   386\t    const { filePath, turnId } = await damagedSourceThread(store);\n   387\t    expect(turnId).toBe(\"t1\");\n   388\t    const db = openRaw(filePath);\n   389\t    try {\n   390\t      const open = db\n   391\t        .prepare(\"SELECT COUNT(*) AS n FROM turns WHERE status = 'open'\")\n   392\t        .get() as { n: number | bigint };\n   393\t      expect(Number(open.n)).toBe(2);\n   394\t    } finally {\n   395\t      db.close();\n   396\t    }\n   397\t    // The damage is live: intake refuses the file as corrupt, exactly as\n   398\t    // Epic 01 defines the state.\n   399\t    const rejected = await intakeStream.messageEvents({ filePath }, [validEvent(\"user_prompt\")]);\n   400\t    expect(rejected.ok).toBe(false);\n   401\t    if (rejected.ok) return;\n   402\t    expect(rejected.error.code).toBe(\"turn_state_corrupt\");\n   403\t    // The queued turn_derivation work the damage sits under is still there.\n   404\t    const queued = await turns.listQueuedWork({ filePath });\n   405\t    expect(queued.ok).toBe(true);\n   406\t    if (!queued.ok) return;\n   407\t    expect(queued.value.map((item) => item.kind)).toEqual([\"turn_derivation\"]);\n   408\t  });\n   409\t\n   410\t  it(\"FC-0.6: twin SDK/CLI threads read back identical records through every surface\", async () => {\n   411\t    const { sdkPath, cliPath } = await twinThreads(store);\n   412\t    const readBack = async (filePath: string) => {\n   413\t      const [events, projected, turnRecords, messageWork, turnWork] = await Promise.all([\n   414\t        intakeStream.listEvents({ filePath }),\n   415\t        messages.listMessages({ filePath }),\n   416\t        turns.listTurns({ filePath }),\n   417\t        messages.listQueuedWork({ filePath }),\n   418\t        turns.listQueuedWork({ filePath }),\n   419\t      ]);\n   420\t      if (!events.ok || !projected.ok || !turnRecords.ok || !messageWork.ok || !turnWork.ok) {\n   421\t        throw new Error(\"twin read-back failed\");\n   422\t      }\n   423\t      return {\n   424\t        events: events.value,\n   425\t        messages: projected.value,\n   426\t        turns: turnRecords.value,\n   427\t        messageWork: messageWork.value,\n   428\t        turnWork: turnWork.value,\n   429\t        forms: readDerivedForms(filePath),\n   430\t      };\n   431\t    };\n   432\t    const sdkSide = await readBack(sdkPath);\n   433\t    const cliSide = await readBack(cliPath);\n   434\t    expect(sdkSide).toEqual(cliSide);\n   435\t    // And the twins are non-trivial: a full turn with a tool run.\n   436\t    expect(sdkSide.events).toHaveLength(5);\n   437\t    expect(sdkSide.turns).toHaveLength(1);\n   438\t    expect(sdkSide.forms.length).toBeGreaterThan(0);\n   439\t  });\n   440\t});\n","exit_code":0,"status":"completed"}}

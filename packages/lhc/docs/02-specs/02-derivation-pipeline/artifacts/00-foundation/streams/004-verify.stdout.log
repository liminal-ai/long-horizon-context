{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/test/fixtures/index.ts'","aggregated_output":"     1\timport { mkdtempSync, rmSync } from \"node:fs\";\n     2\timport { tmpdir } from \"node:os\";\n     3\timport { join } from \"node:path\";\n     4\timport { DatabaseSync } from \"node:sqlite\";\n     5\timport type { EventKind, MessageEventInput } from \"../../src/index.js\";\n     6\t\n     7\texport type EventByKind<K extends EventKind> = Extract<\n     8\t  MessageEventInput,\n     9\t  { eventKind: K }\n    10\t>;\n    11\t\n    12\tlet keyCounter = 0;\n    13\t\n    14\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n    15\t  user_prompt: () => ({ text: \"please read the file\" }),\n    16\t  assistant_text: () => ({ text: \"here is what I found\" }),\n    17\t  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n    18\t  runtime_note: () => ({ text: \"harness restarted mid-turn\" }),\n    19\t  tool_call: () => ({\n    20\t    toolCallId: \"call-1\",\n    21\t    toolName: \"read_file\",\n    22\t    arguments: { path: \"notes.txt\" },\n    23\t  }),\n    24\t  tool_result: () => ({\n    25\t    toolCallId: \"call-1\",\n    26\t    content: \"contents of notes.txt\",\n    27\t    isError: false,\n    28\t  }),\n    29\t  turn_end: () => ({}),\n    30\t};\n    31\t\n    32\t// Returns the discriminated MessageEventInput member for its kind, so a\n    33\t// kind/payload mismatch in test code is a compile error — building an invalid\n    34\t// pairing requires an explicit cast at the call site.\n    35\texport function validEvent<K extends EventKind>(\n    36\t  kind: K,\n    37\t  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n    38\t): EventByKind<K> {\n    39\t  keyCounter += 1;\n    40\t  const base = {\n    41\t    eventKind: kind,\n    42\t    idempotencyKey: `fixture-key-${keyCounter}`,\n    43\t    actor: \"fixture-actor\",\n    44\t    harness: \"fixture-harness\",\n    45\t    payload: defaultPayloads[kind](),\n    46\t  };\n    47\t  // The fields are built per-kind above (payload is typed EventByKind<K>[\"payload\"]),\n    48\t  // but TS can't reduce a structural spread to the deferred Extract<…, { eventKind: K }>,\n    49\t  // so the final reconciliation goes through unknown. Call-site safety lives in the\n    50\t  // parameter types, not this assertion.\n    51\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\n    52\t}\n    53\t\n    54\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n    55\t  return kinds.map((kind) => validEvent(kind));\n    56\t}\n    57\t\n    58\texport function conversationTurn(): MessageEventInput[] {\n    59\t  return eventBatch([\n    60\t    \"user_prompt\",\n    61\t    \"assistant_text\",\n    62\t    \"tool_call\",\n    63\t    \"tool_result\",\n    64\t    \"turn_end\",\n    65\t  ]);\n    66\t}\n    67\t\n    68\texport interface TempStore {\n    69\t  dir: string;\n    70\t  registryPath: string;\n    71\t  threadPath: (name?: string) => string;\n    72\t  cleanup: () => void;\n    73\t}\n    74\t\n    75\texport function tempStore(): TempStore {\n    76\t  const dir = mkdtempSync(join(tmpdir(), \"lhc-test-\"));\n    77\t  let threadCounter = 0;\n    78\t  return {\n    79\t    dir,\n    80\t    registryPath: join(dir, \"registry.sqlite\"),\n    81\t    threadPath: (name) => {\n    82\t      threadCounter += 1;\n    83\t      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n    84\t    },\n    85\t    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n    86\t  };\n    87\t}\n    88\t\n    89\t// Direct node:sqlite handle for below-SDK assertions. Read-only use by\n    90\t// convention; fixtures/corrupt.ts is the one sanctioned writer.\n    91\texport function openRaw(path: string): DatabaseSync {\n    92\t  return new DatabaseSync(path);\n    93\t}\n    94\t\n    95\texport { corruptTwoOpenTurns } from \"./corrupt.js\";\n    96\texport {\n    97\t  legacyEpic01ThreadFile,\n    98\t  legacyStory2ThreadFile,\n    99\t  schemaVersionOf,\n   100\t  type LegacyRecordedEvent,\n   101\t} from \"./legacy.js\";\n   102\texport { setIntakeClock, setIntakeWalkHook, type IntakeWalkHook } from \"./intake-seam.js\";\n   103\texport {\n   104\t  createProviderDouble,\n   105\t  ProviderDouble,\n   106\t  type CapturedInput,\n   107\t  type ProviderOpName,\n   108\t} from \"./provider-double.js\";\n   109\texport {\n   110\t  damagedSourceThread,\n   111\t  multiStateThread,\n   112\t  readDerivedForms,\n   113\t  setFormState,\n   114\t  threadWithClosedTurns,\n   115\t  threadWithToolRun,\n   116\t  twinThreads,\n   117\t  type MultiStateClaim,\n   118\t} from \"./threads.js\";\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/shared/storage.ts'","aggregated_output":"     1\timport { DatabaseSync } from \"node:sqlite\";\n     2\t\n     3\texport interface Migration {\n     4\t  version: number; // 1-based, strictly increasing\n     5\t  statements: readonly string[];\n     6\t}\n     7\t\n     8\texport function openDatabase(path: string): DatabaseSync {\n     9\t  const db = new DatabaseSync(path);\n    10\t  db.exec(\"PRAGMA journal_mode = WAL;\");\n    11\t  db.exec(\"PRAGMA foreign_keys = ON;\");\n    12\t  db.exec(\"PRAGMA busy_timeout = 5000;\");\n    13\t  db.exec(\"PRAGMA synchronous = NORMAL;\");\n    14\t  return db;\n    15\t}\n    16\t\n    17\t// Epic 02's single migration (tech design §Storage): queue mechanical fields\n    18\t// on the existing work_item table, the derived_form state table, the chunk\n    19\t// tables, and the projection-level delete stamps. The whole epic's schema\n    20\t// lands in one version — behavior arrives story by story. Assembled into the\n    21\t// thread-file migration history by threads/internal/create.ts.\n    22\texport const MIGRATION_V5_STATEMENTS: readonly string[] = [\n    23\t  // claim mechanics on the existing table (DD-1: no disposition column —\n    24\t  // queue rows are live work only; terminal rows are deleted and their\n    25\t  // outcomes reported in-memory; durable outcome state lives on derived_form)\n    26\t  `ALTER TABLE work_item ADD COLUMN attempts INTEGER NOT NULL DEFAULT 0;`,\n    27\t  `ALTER TABLE work_item ADD COLUMN last_error TEXT;`,\n    28\t  `ALTER TABLE work_item ADD COLUMN claimed_at TEXT;`,\n    29\t  `ALTER TABLE work_item ADD COLUMN claim_expires_at TEXT;`,\n    30\t  `ALTER TABLE work_item ADD COLUMN eligible_at TEXT;`, // backoff gate; NULL = immediately eligible\n    31\t  `ALTER TABLE work_item ADD COLUMN payload TEXT;`, // JSON: { sourceVersion?, form? }; id format includes sourceVersion\n    32\t  // Tech design sketches (status, eligible_at, rowid); SQLite forbids rowid\n    33\t  // inside an index definition, so the index covers the two real columns and\n    34\t  // claimNext's ORDER BY rowid walks the head as before.\n    35\t  `CREATE INDEX idx_work_item_queue ON work_item (status, eligible_at);`,\n    36\t  `CREATE TABLE derived_form (\n    37\t    subject_kind TEXT NOT NULL CHECK (subject_kind IN ('message','turn','chunk')),\n    38\t    subject_id   TEXT NOT NULL,\n    39\t    form         TEXT NOT NULL,\n    40\t    state        TEXT NOT NULL CHECK (state IN ('pending','ready','failed','blocked')),\n    41\t    content      TEXT,\n    42\t    reason       TEXT,\n    43\t    metadata     TEXT,\n    44\t    source_version INTEGER NOT NULL DEFAULT 1,\n    45\t    gaps         TEXT,\n    46\t    derived_at   TEXT,\n    47\t    PRIMARY KEY (subject_kind, subject_id, form)\n    48\t  );`,\n    49\t  `CREATE TABLE chunk (\n    50\t    chunk_id     TEXT PRIMARY KEY,\n    51\t    chunk_order  INTEGER NOT NULL UNIQUE,\n    52\t    status       TEXT NOT NULL CHECK (status IN ('open','closed')),\n    53\t    accumulated_projected_tokens INTEGER NOT NULL DEFAULT 0\n    54\t  );`,\n    55\t  `CREATE TABLE chunk_member (\n    56\t    chunk_id   TEXT NOT NULL REFERENCES chunk(chunk_id),\n    57\t    turn_id    TEXT NOT NULL UNIQUE REFERENCES turns(turn_id),\n    58\t    member_idx INTEGER NOT NULL,\n    59\t    PRIMARY KEY (chunk_id, member_idx)\n    60\t  );`,\n    61\t  // projection-level delete (the record keeps everything; reads filter)\n    62\t  `ALTER TABLE message ADD COLUMN deleted_at TEXT;`,\n    63\t  `ALTER TABLE turns   ADD COLUMN deleted_at TEXT;`,\n    64\t  // F-02 backfill: pending form rows for work queued before v5 existed, so\n    65\t  // UPDATE-only completion finds them (row missing must mean deleted).\n    66\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    67\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'smoothed_prompt', 'pending', 1\n    68\t    FROM work_item WHERE status = 'queued' AND kind = 'prompt_smoothing';`,\n    69\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    70\t    SELECT 'message', json_extract(source_ref, '$.messageId'), 'tool_result_summary', 'pending', 1\n    71\t    FROM work_item WHERE status = 'queued' AND kind = 'tool_result_summary';`,\n    72\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    73\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'turn_rendering', 'pending', 1\n    74\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n    75\t  `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n    76\t    SELECT 'turn', json_extract(source_ref, '$.turnId'), 'lower_band_projection', 'pending', 1\n    77\t    FROM work_item WHERE status = 'queued' AND kind = 'turn_derivation';`,\n    78\t];\n    79\t\n    80\texport function getSchemaVersion(db: DatabaseSync): number {\n    81\t  const row = db.prepare(\"PRAGMA user_version\").get() as\n    82\t    | { user_version: number | bigint }\n    83\t    | undefined;\n    84\t  return Number(row?.user_version ?? 0);\n    85\t}\n    86\t\n    87\texport function runMigrations(\n    88\t  db: DatabaseSync,\n    89\t  migrations: readonly Migration[],\n    90\t): void {\n    91\t  let current = getSchemaVersion(db);\n    92\t  const ordered = [...migrations].sort((a, b) => a.version - b.version);\n    93\t  for (const migration of ordered) {\n    94\t    if (migration.version <= current) continue;\n    95\t    db.exec(\"BEGIN IMMEDIATE;\");\n    96\t    try {\n    97\t      for (const statement of migration.statements) db.exec(statement);\n    98\t      db.exec(`PRAGMA user_version = ${migration.version};`);\n    99\t      db.exec(\"COMMIT;\");\n   100\t    } catch (cause) {\n   101\t      db.exec(\"ROLLBACK;\");\n   102\t      throw cause;\n   103\t    }\n   104\t    current = migration.version;\n   105\t  }\n   106\t}\n","exit_code":0,"status":"completed"}}

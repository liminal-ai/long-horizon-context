{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc 'nl -ba packages/lhc/src/shared/errors.ts'","aggregated_output":"     1\texport type ErrorClass = \"caller_error\" | \"state_corruption\" | \"system_error\";\n     2\t\n     3\texport type ErrorCode =\n     4\t  | \"path_exists\"\n     5\t  | \"thread_not_found\"\n     6\t  | \"invalid_thread_ref\" // empty/blank file path or otherwise unusable reference\n     7\t  | \"invalid_event\"\n     8\t  | \"empty_batch\"\n     9\t  | \"empty_stdin\" // CLI adapter only, emitted before any SDK call\n    10\t  | \"turn_state_corrupt\"\n    11\t  | \"storage_failure\"\n    12\t  // Epic 02 (tech design §Interfaces, issue 4):\n    13\t  | \"turn_open\" // caller_error — mutation against an open turn\n    14\t  | \"message_initiates_turn\" // caller_error — delete refused toward turns.delete\n    15\t  | \"message_not_found\" // caller_error\n    16\t  | \"turn_not_found\" // caller_error\n    17\t  | \"unknown_work_kind\" // state_corruption — unregistered kind at dispatch\n    18\t  | \"provider_failure\" // system_error — exhausted retries; form.reason carries detail\n    19\t  | \"source_damaged\"; // state_corruption — handler found corrupt source; form blocked\n    20\t\n    21\texport interface ErrorResult {\n    22\t  errorClass: ErrorClass;\n    23\t  code: ErrorCode;\n    24\t  reason: string; // human-readable; machine logic switches on code\n    25\t  eventIndex?: number; // present on batch validation failures\n    26\t}\n    27\t\n    28\t// Expected operational failures — caller errors, corruption, environment\n    29\t// failures — are always returned as OpResult errors, never thrown.\n    30\t// Programmer bugs inside lhc may still throw; callers are not expected\n    31\t// to handle throws as contract outcomes.\n    32\texport type OpResult<T> =\n    33\t  | { ok: true; value: T }\n    34\t  | { ok: false; error: ErrorResult };\n    35\t\n    36\t// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n    37\t// caught at the operation boundary and wrapped with the underlying detail.\n    38\texport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n    39\t  return {\n    40\t    ok: false,\n    41\t    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n    42\t  };\n    43\t}\n","exit_code":0,"status":"completed"}}

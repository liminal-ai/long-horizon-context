{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"sed -n '501,618p' packages/lhc/test/work-queue.test.ts | nl -ba -v501\"","aggregated_output":"   501\t      { key: \"turn/t1/turn_rendering\", state: \"pending\" },\n   502\t    ]);\n   503\t  });\n   504\t\n   505\t  it(\"an induced rollback after enqueue drops the work row, the pending form row, and the poke\", async () => {\n   506\t    const filePath = await createThread();\n   507\t    const pokes: string[] = [];\n   508\t    setSchedulerPoke((threadId) => pokes.push(threadId));\n   509\t\n   510\t    // The prompt's enqueue has already run inside the walk when the hook\n   511\t    // fires on the second event and rejects the batch (production rollback\n   512\t    // path, same seam Epic 01's atomicity tests use).\n   513\t    setIntakeWalkHook((_db, eventIndex) => {\n   514\t      if (eventIndex === 1) throw new Error(\"induced mid-walk failure after enqueue\");\n   515\t    });\n   516\t    const rejected = await intakeStream.messageEvents({ filePath }, [\n   517\t      validEvent(\"user_prompt\"),\n   518\t      validEvent(\"assistant_text\"),\n   519\t    ]);\n   520\t    expect(rejected.ok).toBe(false);\n   521\t\n   522\t    expect(rawWorkItemCount(filePath)).toBe(0);\n   523\t    expect(rawFormRows(filePath)).toEqual([]);\n   524\t    expect(pokes).toEqual([]);\n   525\t  });\n   526\t\n   527\t  it(\"enqueue via runInTransaction: rollback drops all three effects; commit lands them and then pokes\", async () => {\n   528\t    const filePath = await createThread();\n   529\t    const opened = threads.openThreadDatabase(filePath);\n   530\t    expect(opened.ok).toBe(true);\n   531\t    if (!opened.ok) return;\n   532\t    const db = opened.value;\n   533\t    const pokes: string[] = [];\n   534\t    setSchedulerPoke((threadId) => pokes.push(threadId));\n   535\t    const clock = () => new Date(FIXED_INSTANT);\n   536\t\n   537\t    try {\n   538\t      // Rollback leg: the body enqueues, then throws.\n   539\t      expect(() =>\n   540\t        runInTransaction(db, clock, \"th_direct\", (ctx) => {\n   541\t          enqueue(ctx, {\n   542\t            owner: \"turns\",\n   543\t            kind: \"chunk_summary_brief\",\n   544\t            sourceRef: { chunkId: \"c1\" },\n   545\t            forms: [{ subjectKind: \"chunk\", subjectId: \"c1\", form: \"chunk_summary_brief\" }],\n   546\t          });\n   547\t          throw new Error(\"induced rollback\");\n   548\t        }),\n   549\t      ).toThrow(\"induced rollback\");\n   550\t      expect(rawWorkItemCount(filePath)).toBe(0);\n   551\t      expect(rawFormRows(filePath)).toEqual([]);\n   552\t      expect(pokes).toEqual([]);\n   553\t\n   554\t      // Commit leg: same enqueue, no failure — and the poke fires after the\n   555\t      // body, not inside it.\n   556\t      const item = runInTransaction(db, clock, \"th_direct\", (ctx) => {\n   557\t        const record = enqueue(ctx, {\n   558\t          owner: \"turns\",\n   559\t          kind: \"chunk_summary_brief\",\n   560\t          sourceRef: { chunkId: \"c1\" },\n   561\t          forms: [{ subjectKind: \"chunk\", subjectId: \"c1\", form: \"chunk_summary_brief\" }],\n   562\t        });\n   563\t        expect(pokes).toEqual([]); // not yet committed\n   564\t        return record;\n   565\t      });\n   566\t      expect(item.workItemId).toBe(\"w-c1-chunk_summary_brief-v1\");\n   567\t      expect(pokes).toEqual([\"th_direct\"]);\n   568\t      expect(rawFormRows(filePath)).toEqual([\n   569\t        { key: \"chunk/c1/chunk_summary_brief\", state: \"pending\" },\n   570\t      ]);\n   571\t    } finally {\n   572\t      db.close();\n   573\t    }\n   574\t  });\n   575\t\n   576\t  it(\"re-enqueueing at a later source version resets the form row to pending at that version\", async () => {\n   577\t    const filePath = await createThread();\n   578\t    const opened = threads.openThreadDatabase(filePath);\n   579\t    expect(opened.ok).toBe(true);\n   580\t    if (!opened.ok) return;\n   581\t    const db = opened.value;\n   582\t    const clock = () => new Date(FIXED_INSTANT);\n   583\t    try {\n   584\t      runInTransaction(db, clock, \"th_direct\", (ctx) => {\n   585\t        enqueue(ctx, {\n   586\t          owner: \"messages\",\n   587\t          kind: \"prompt_smoothing\",\n   588\t          sourceRef: { messageId: \"mx\" },\n   589\t          forms: [{ subjectKind: \"message\", subjectId: \"mx\", form: \"smoothed_prompt\" }],\n   590\t        });\n   591\t      });\n   592\t      // Versioned ids let the replacement coexist with (not collide into)\n   593\t      // the version-1 item (DD-1/DD-3).\n   594\t      const replacement = runInTransaction(db, clock, \"th_direct\", (ctx) =>\n   595\t        enqueue(ctx, {\n   596\t          owner: \"messages\",\n   597\t          kind: \"prompt_smoothing\",\n   598\t          sourceRef: { messageId: \"mx\" },\n   599\t          sourceVersion: 2,\n   600\t          forms: [{ subjectKind: \"message\", subjectId: \"mx\", form: \"smoothed_prompt\" }],\n   601\t        }),\n   602\t      );\n   603\t      expect(replacement.workItemId).toBe(\"w-mx-prompt_smoothing-v2\");\n   604\t      const forms = readDerivedForms(filePath);\n   605\t      expect(forms).toHaveLength(1);\n   606\t      expect(forms[0]).toMatchObject({\n   607\t        subjectKind: \"message\",\n   608\t        subjectId: \"mx\",\n   609\t        form: \"smoothed_prompt\",\n   610\t        state: \"pending\",\n   611\t        sourceVersion: 2,\n   612\t      });\n   613\t      expect(rawWorkItemCount(filePath)).toBe(2);\n   614\t    } finally {\n   615\t      db.close();\n   616\t    }\n   617\t  });\n   618\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,500p' packages/lhc/test/work-queue.test.ts | nl -ba\"","aggregated_output":"     1\t// Story 5 (Chunk 5): derivation work queueing. TC-2.6 (complete batch\n     2\t// result), TC-2.7/TC-2.9 (message-owned work and its kind gate), the work\n     3\t// halves of TC-3.3/TC-3.6 (Story 4's named debt, paid here), TC-3.8's\n     4\t// two-work-items assertion, TC-5.4's no-work-item clause, and the two\n     5\t// architecture-risk regressions: restart survival extended to work items and\n     6\t// the complete-surface rollback. Work items are asserted through the owning\n     7\t// domains' listQueuedWork read-back and openRaw — never through the batch\n     8\t// result alone. The work-queue util has no public SDK surface; everything\n     9\t// here enters through the SDK or the in-process CLI.\n    10\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    11\timport {\n    12\t  intakeStream,\n    13\t  messages,\n    14\t  runCli,\n    15\t  threads,\n    16\t  turns,\n    17\t  type MessageEventInput,\n    18\t  type WorkItemRecord,\n    19\t} from \"../src/index.js\";\n    20\timport {\n    21\t  openRaw,\n    22\t  setIntakeClock,\n    23\t  tempStore,\n    24\t  validEvent,\n    25\t  type TempStore,\n    26\t} from \"./fixtures/index.js\";\n    27\t\n    28\tlet store: TempStore;\n    29\tbeforeEach(() => {\n    30\t  store = tempStore();\n    31\t});\n    32\tafterEach(() => {\n    33\t  store.cleanup();\n    34\t  setIntakeClock(null);\n    35\t});\n    36\t\n    37\tasync function createThread(): Promise<string> {\n    38\t  const filePath = store.threadPath();\n    39\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n    40\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    41\t  return filePath;\n    42\t}\n    43\t\n    44\tasync function send(filePath: string, batch: MessageEventInput[]) {\n    45\t  const result = await intakeStream.messageEvents({ filePath }, batch);\n    46\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n    47\t  return result.value;\n    48\t}\n    49\t\n    50\tasync function queuedFor(\n    51\t  filePath: string,\n    52\t  owner: \"messages\" | \"turns\",\n    53\t): Promise<WorkItemRecord[]> {\n    54\t  const result =\n    55\t    owner === \"messages\"\n    56\t      ? await messages.listQueuedWork({ filePath })\n    57\t      : await turns.listQueuedWork({ filePath });\n    58\t  if (!result.ok) throw new Error(`queued-work read-back failed: ${result.error.reason}`);\n    59\t  return result.value;\n    60\t}\n    61\t\n    62\t// Below-SDK count of durable work-item rows: the batch result alone is not\n    63\t// proof of durability (anti-shim requirement).\n    64\tfunction rawWorkItemCount(filePath: string): number {\n    65\t  const db = openRaw(filePath);\n    66\t  try {\n    67\t    const row = db.prepare(\"SELECT COUNT(*) AS n FROM work_item\").get() as { n: number | bigint };\n    68\t    return Number(row.n);\n    69\t  } finally {\n    70\t    db.close();\n    71\t  }\n    72\t}\n    73\t\n    74\t// Full logical read-back across every record kind the epic owns — the\n    75\t// complete-surface rollback regression compares this whole.\n    76\tasync function readBack(filePath: string) {\n    77\t  const [events, projected, turnRecords, messageWork, turnWork] = await Promise.all([\n    78\t    intakeStream.listEvents({ filePath }),\n    79\t    messages.listMessages({ filePath }),\n    80\t    turns.listTurns({ filePath }),\n    81\t    messages.listQueuedWork({ filePath }),\n    82\t    turns.listQueuedWork({ filePath }),\n    83\t  ]);\n    84\t  if (!events.ok || !projected.ok || !turnRecords.ok || !messageWork.ok || !turnWork.ok) {\n    85\t    throw new Error(\"read-back failed\");\n    86\t  }\n    87\t  return {\n    88\t    events: events.value,\n    89\t    messages: projected.value,\n    90\t    turns: turnRecords.value,\n    91\t    messageWork: messageWork.value,\n    92\t    turnWork: turnWork.value,\n    93\t  };\n    94\t}\n    95\t\n    96\tconst FIXED_INSTANT = \"2026-06-10T12:00:00.000Z\";\n    97\t\n    98\tdescribe(\"Flow 2 (SDK): message-owned work queueing\", () => {\n    99\t  it(\"TC-2.7: a prompt and a tool result each durably queue their kind, owner messages (AC-2.8)\", async () => {\n   100\t    setIntakeClock(() => new Date(FIXED_INSTANT));\n   101\t    const filePath = await createThread();\n   102\t    const result = await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"tool_result\")]);\n   103\t\n   104\t    // The batch result reports both items with full identity.\n   105\t    expect(result.queuedWork).toContainEqual({\n   106\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n   107\t      owner: \"messages\",\n   108\t      kind: \"prompt_smoothing\",\n   109\t      sourceRef: { messageId: \"m1\" },\n   110\t    });\n   111\t    expect(result.queuedWork).toContainEqual({\n   112\t      workItemId: \"w-m2-tool_result_summary-v1\",\n   113\t      owner: \"messages\",\n   114\t      kind: \"tool_result_summary\",\n   115\t      sourceRef: { messageId: \"m2\" },\n   116\t    });\n   117\t\n   118\t    // Durable read-back through the owning domain: deterministic ids, status\n   119\t    // queued, queuedAt from the injected clock.\n   120\t    expect(await queuedFor(filePath, \"messages\")).toEqual([\n   121\t      {\n   122\t        workItemId: \"w-m1-prompt_smoothing-v1\",\n   123\t        owner: \"messages\",\n   124\t        kind: \"prompt_smoothing\",\n   125\t        sourceRef: { messageId: \"m1\" },\n   126\t        status: \"queued\",\n   127\t        queuedAt: FIXED_INSTANT,\n   128\t      },\n   129\t      {\n   130\t        workItemId: \"w-m2-tool_result_summary-v1\",\n   131\t        owner: \"messages\",\n   132\t        kind: \"tool_result_summary\",\n   133\t        sourceRef: { messageId: \"m2\" },\n   134\t        status: \"queued\",\n   135\t        queuedAt: FIXED_INSTANT,\n   136\t      },\n   137\t    ]);\n   138\t\n   139\t    // The prompt opened a turn that is still open: no turn-owned work yet,\n   140\t    // and each domain reads back only its own items.\n   141\t    expect(await queuedFor(filePath, \"turns\")).toEqual([]);\n   142\t    expect(rawWorkItemCount(filePath)).toBe(2);\n   143\t  });\n   144\t\n   145\t  it(\"TC-2.9: text, thinking, and note messages queue nothing — the kind gate is exact (AC-2.8)\", async () => {\n   146\t    const filePath = await createThread();\n   147\t    const result = await send(filePath, [\n   148\t      validEvent(\"assistant_text\"),\n   149\t      validEvent(\"assistant_thinking\"),\n   150\t      validEvent(\"runtime_note\"),\n   151\t    ]);\n   152\t    expect(result.queuedWork).toEqual([]);\n   153\t    expect(await queuedFor(filePath, \"messages\")).toEqual([]);\n   154\t    expect(await queuedFor(filePath, \"turns\")).toEqual([]);\n   155\t    expect(rawWorkItemCount(filePath)).toBe(0);\n   156\t  });\n   157\t\n   158\t  it(\"TC-2.6: a mixed batch's result is complete — outcomes, messageIds, transitions, queuedWork, position (AC-2.7)\", async () => {\n   159\t    const filePath = await createThread();\n   160\t    const original = validEvent(\"user_prompt\");\n   161\t    await send(filePath, [original]);\n   162\t\n   163\t    const result = await send(filePath, [\n   164\t      original, // duplicate: skipped\n   165\t      validEvent(\"assistant_text\"),\n   166\t      validEvent(\"turn_end\"),\n   167\t    ]);\n   168\t\n   169\t    expect(result.events).toEqual([\n   170\t      {\n   171\t        idempotencyKey: original.idempotencyKey,\n   172\t        outcome: \"skipped\",\n   173\t        skipReason: \"duplicate_idempotency_key\",\n   174\t      },\n   175\t      expect.objectContaining({ outcome: \"recorded\", messageId: \"m2\" }),\n   176\t      expect.objectContaining({ outcome: \"recorded\" }),\n   177\t    ]);\n   178\t    // turn_end produces no message.\n   179\t    expect(result.events[2]).not.toHaveProperty(\"messageId\");\n   180\t    expect(result.turnTransitions).toEqual([{ action: \"closed\", turnId: \"t1\" }]);\n   181\t    expect(result.queuedWork).toEqual([\n   182\t      {\n   183\t        workItemId: \"w-t1-turn_derivation-v1\",\n   184\t        owner: \"turns\",\n   185\t        kind: \"turn_derivation\",\n   186\t        sourceRef: { turnId: \"t1\" },\n   187\t      },\n   188\t    ]);\n   189\t    expect(result.threadPosition).toEqual({ lastEventOrder: 3 });\n   190\t  });\n   191\t});\n   192\t\n   193\tdescribe(\"Flow 3 (SDK): turn-owned work queueing — Story 4's debt paid\", () => {\n   194\t  it(\"TC-3.3 (work half): explicit close durably queues w-t1-turn_derivation, owner turns (AC-3.4, AC-3.6)\", async () => {\n   195\t    setIntakeClock(() => new Date(FIXED_INSTANT));\n   196\t    const filePath = await createThread();\n   197\t    const result = await send(filePath, [\n   198\t      validEvent(\"user_prompt\"),\n   199\t      validEvent(\"assistant_text\"),\n   200\t      validEvent(\"turn_end\"),\n   201\t    ]);\n   202\t\n   203\t    expect(result.queuedWork).toContainEqual({\n   204\t      workItemId: \"w-t1-turn_derivation-v1\",\n   205\t      owner: \"turns\",\n   206\t      kind: \"turn_derivation\",\n   207\t      sourceRef: { turnId: \"t1\" },\n   208\t    });\n   209\t    expect(await queuedFor(filePath, \"turns\")).toEqual([\n   210\t      {\n   211\t        workItemId: \"w-t1-turn_derivation-v1\",\n   212\t        owner: \"turns\",\n   213\t        kind: \"turn_derivation\",\n   214\t        sourceRef: { turnId: \"t1\" },\n   215\t        status: \"queued\",\n   216\t        queuedAt: FIXED_INSTANT,\n   217\t      },\n   218\t    ]);\n   219\t  });\n   220\t\n   221\t  it(\"TC-3.6 (work half): implicit close queues the same work-item contract as the explicit path (AC-3.6)\", async () => {\n   222\t    const explicitPath = await createThread();\n   223\t    await send(explicitPath, [validEvent(\"user_prompt\"), validEvent(\"assistant_text\")]);\n   224\t    await send(explicitPath, [validEvent(\"turn_end\")]);\n   225\t\n   226\t    const implicitPath = await createThread();\n   227\t    await send(implicitPath, [validEvent(\"user_prompt\"), validEvent(\"assistant_text\")]);\n   228\t    await send(implicitPath, [validEvent(\"user_prompt\")]);\n   229\t\n   230\t    const explicitItems = await queuedFor(explicitPath, \"turns\");\n   231\t    const implicitItems = await queuedFor(implicitPath, \"turns\");\n   232\t    expect(explicitItems).toHaveLength(1);\n   233\t    // Same item contract modulo queuedAt (wall clock differs between runs).\n   234\t    const contract = (items: WorkItemRecord[]) =>\n   235\t      items.map(({ queuedAt: _queuedAt, ...rest }) => rest);\n   236\t    expect(contract(implicitItems)).toEqual(contract(explicitItems));\n   237\t    expect(contract(explicitItems)).toEqual([\n   238\t      {\n   239\t        workItemId: \"w-t1-turn_derivation-v1\",\n   240\t        owner: \"turns\",\n   241\t        kind: \"turn_derivation\",\n   242\t        sourceRef: { turnId: \"t1\" },\n   243\t        status: \"queued\",\n   244\t      },\n   245\t    ]);\n   246\t  });\n   247\t\n   248\t  it(\"TC-3.8 (work count): a multi-turn batch queues one turn_derivation item per closed turn (AC-3.6)\", async () => {\n   249\t    const filePath = await createThread();\n   250\t    await send(filePath, [\n   251\t      validEvent(\"user_prompt\"),\n   252\t      validEvent(\"assistant_text\"),\n   253\t      validEvent(\"user_prompt\"),\n   254\t      validEvent(\"assistant_text\"),\n   255\t      validEvent(\"turn_end\"),\n   256\t    ]);\n   257\t\n   258\t    const turnWork = await queuedFor(filePath, \"turns\");\n   259\t    expect(turnWork.map((item) => item.workItemId)).toEqual([\n   260\t      \"w-t1-turn_derivation-v1\",\n   261\t      \"w-t2-turn_derivation-v1\",\n   262\t    ]);\n   263\t    expect(turnWork.every((item) => item.kind === \"turn_derivation\")).toBe(true);\n   264\t    expect(turnWork.every((item) => item.status === \"queued\")).toBe(true);\n   265\t  });\n   266\t\n   267\t  it(\"TC-5.4 (no-work-item clause): a skipped event queues nothing (AC-5.4)\", async () => {\n   268\t    const filePath = await createThread();\n   269\t    const prompt = validEvent(\"user_prompt\");\n   270\t    const end = validEvent(\"turn_end\");\n   271\t    await send(filePath, [prompt, validEvent(\"assistant_text\"), end]);\n   272\t    await send(filePath, [validEvent(\"user_prompt\")]); // t2 now open\n   273\t    const baseline = await readBack(filePath);\n   274\t    const baselineCount = rawWorkItemCount(filePath);\n   275\t\n   276\t    const resend = await send(filePath, [prompt, end]);\n   277\t    expect(resend.events.map((entry) => entry.outcome)).toEqual([\"skipped\", \"skipped\"]);\n   278\t    expect(resend.queuedWork).toEqual([]);\n   279\t    expect(await readBack(filePath)).toEqual(baseline);\n   280\t    expect(rawWorkItemCount(filePath)).toBe(baselineCount);\n   281\t  });\n   282\t});\n   283\t\n   284\tdescribe(\"architecture-risk: durability and rollback over the complete record surface\", () => {\n   285\t  it(\"restart survival: a reopened thread file holds its work items intact, status queued\", async () => {\n   286\t    const filePath = await createThread();\n   287\t    await send(filePath, [\n   288\t      validEvent(\"user_prompt\"),\n   289\t      validEvent(\"tool_call\"),\n   290\t      validEvent(\"tool_result\"),\n   291\t      validEvent(\"turn_end\"),\n   292\t    ]);\n   293\t    const before = await readBack(filePath);\n   294\t    expect(before.messageWork).toHaveLength(2);\n   295\t    expect(before.turnWork).toHaveLength(1);\n   296\t\n   297\t    // Every SDK operation opens and closes its own handle, so a fresh\n   298\t    // read-back is a real reopen of the real file. The raw scan proves the\n   299\t    // rows live in the thread file itself — not an in-memory queue.\n   300\t    const db = openRaw(filePath);\n   301\t    try {\n   302\t      const rows = db\n   303\t        .prepare(\"SELECT work_item_id, status FROM work_item ORDER BY work_item_id\")\n   304\t        .all() as unknown as Array<{ work_item_id: string; status: string }>;\n   305\t      expect(rows).toEqual([\n   306\t        { work_item_id: \"w-m1-prompt_smoothing-v1\", status: \"queued\" },\n   307\t        { work_item_id: \"w-m3-tool_result_summary-v1\", status: \"queued\" },\n   308\t        { work_item_id: \"w-t1-turn_derivation-v1\", status: \"queued\" },\n   309\t      ]);\n   310\t    } finally {\n   311\t      db.close();\n   312\t    }\n   313\t    expect(await readBack(filePath)).toEqual(before);\n   314\t  });\n   315\t\n   316\t  it(\"complete-surface rollback: a rejected batch leaves events, messages, turns, and work items at baseline (AC-4.6)\", async () => {\n   317\t    const filePath = await createThread();\n   318\t    await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"tool_result\"), validEvent(\"turn_end\")]);\n   319\t    const baseline = await readBack(filePath);\n   320\t    const baselineCount = rawWorkItemCount(filePath);\n   321\t\n   322\t    // A valid prefix that would queue work, then one invalid event: the\n   323\t    // batch must reject whole and queue nothing.\n   324\t    const rejected = await intakeStream.messageEvents({ filePath }, [\n   325\t      validEvent(\"user_prompt\"),\n   326\t      { ...validEvent(\"user_prompt\"), eventKind: \"bogus\" } as unknown as MessageEventInput,\n   327\t    ]);\n   328\t    expect(rejected.ok).toBe(false);\n   329\t    if (rejected.ok) return;\n   330\t    expect(rejected.error.code).toBe(\"invalid_event\");\n   331\t\n   332\t    expect(await readBack(filePath)).toEqual(baseline);\n   333\t    expect(rawWorkItemCount(filePath)).toBe(baselineCount);\n   334\t  });\n   335\t});\n   336\t\n   337\tdescribe(\"CLI in-process: list-queued-work on both owning domains\", () => {\n   338\t  it(\"messages list-queued-work and turns list-queued-work each return only their owner's items\", async () => {\n   339\t    const filePath = await createThread();\n   340\t    await send(filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n   341\t\n   342\t    const messagesListed = await runCli([\"messages\", \"list-queued-work\", \"--file-path\", filePath]);\n   343\t    expect(messagesListed.exitCode).toBe(0);\n   344\t    const messagesParsed = JSON.parse(messagesListed.stdout) as {\n   345\t      ok: boolean;\n   346\t      value: WorkItemRecord[];\n   347\t    };\n   348\t    expect(messagesParsed.ok).toBe(true);\n   349\t    expect(messagesParsed.value).toHaveLength(1);\n   350\t    expect(messagesParsed.value[0]).toMatchObject({\n   351\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n   352\t      owner: \"messages\",\n   353\t      kind: \"prompt_smoothing\",\n   354\t      sourceRef: { messageId: \"m1\" },\n   355\t      status: \"queued\",\n   356\t    });\n   357\t\n   358\t    const turnsListed = await runCli([\"turns\", \"list-queued-work\", \"--file-path\", filePath]);\n   359\t    expect(turnsListed.exitCode).toBe(0);\n   360\t    const turnsParsed = JSON.parse(turnsListed.stdout) as {\n   361\t      ok: boolean;\n   362\t      value: WorkItemRecord[];\n   363\t    };\n   364\t    expect(turnsParsed.ok).toBe(true);\n   365\t    expect(turnsParsed.value).toHaveLength(1);\n   366\t    expect(turnsParsed.value[0]).toMatchObject({\n   367\t      workItemId: \"w-t1-turn_derivation-v1\",\n   368\t      owner: \"turns\",\n   369\t      kind: \"turn_derivation\",\n   370\t      sourceRef: { turnId: \"t1\" },\n   371\t      status: \"queued\",\n   372\t    });\n   373\t  });\n   374\t\n   375\t  it(\"list-queued-work on an unknown thread id fails with thread_not_found\", async () => {\n   376\t    const listed = await runCli([\n   377\t      \"messages\",\n   378\t      \"list-queued-work\",\n   379\t      \"--thread-id\",\n   380\t      \"th_nope\",\n   381\t      \"--registry\",\n   382\t      store.registryPath,\n   383\t    ]);\n   384\t    expect(listed.exitCode).toBe(1);\n   385\t    const parsed = JSON.parse(listed.stdout) as { ok: boolean; error: { code: string } };\n   386\t    expect(parsed.ok).toBe(false);\n   387\t    expect(parsed.error.code).toBe(\"thread_not_found\");\n   388\t  });\n   389\t});\n   390\t\n   391\t// ── Story 0 (Epic 02): work-kind registry, handler-map assembly, and the\n   392\t// enqueue wrapper's atomicity. The registry and map are FC-0.4; atomicity is\n   393\t// Chunk 0's named architecture risk — row + pending form + poke all drop on\n   394\t// rollback, because every later queue site (intake, cascade, repair) leans\n   395\t// on that invariant.\n   396\timport {\n   397\t  assembleWorkHandlerMap,\n   398\t  createSdk,\n   399\t  lookupWorkHandler,\n   400\t  runInTransaction,\n   401\t  setSchedulerPoke,\n   402\t  WORK_KIND_REGISTRY,\n   403\t  type WorkHandler,\n   404\t} from \"../src/index.js\";\n   405\timport { enqueue } from \"../src/tech-utils/work-queue/index.js\";\n   406\timport {\n   407\t  createProviderDouble,\n   408\t  readDerivedForms,\n   409\t  setIntakeWalkHook,\n   410\t} from \"./fixtures/index.js\";\n   411\t\n   412\t// Below-SDK read of derived_form rows — enqueue's pending rows are asserted\n   413\t// durably, not through the batch result.\n   414\tfunction rawFormRows(filePath: string): Array<{ key: string; state: string }> {\n   415\t  const db = openRaw(filePath);\n   416\t  try {\n   417\t    return db\n   418\t      .prepare(\n   419\t        `SELECT subject_kind || '/' || subject_id || '/' || form AS key, state\n   420\t         FROM derived_form ORDER BY key`,\n   421\t      )\n   422\t      .all() as unknown as Array<{ key: string; state: string }>;\n   423\t  } finally {\n   424\t    db.close();\n   425\t  }\n   426\t}\n   427\t\n   428\tdescribe(\"FC-0.4: work-kind registry and handler-map assembly\", () => {\n   429\t  it(\"the registry covers all six kinds with owner and sourceRef semantics per the Work Item contract\", () => {\n   430\t    expect(WORK_KIND_REGISTRY).toEqual({\n   431\t      prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n   432\t      tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n   433\t      tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n   434\t      turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n   435\t      chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n   436\t      chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n   437\t    });\n   438\t  });\n   439\t\n   440\t  it(\"createSdk assembles the handler map from domain tables; an unregistered kind reports the miss explicitly\", () => {\n   441\t    const sdk = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n   442\t    // Domain tables are empty until Stories 2–3; assembly itself is live.\n   443\t    expect(sdk.workHandlers).toEqual({});\n   444\t    // The miss is reported as a structured result — not a throw, not silence.\n   445\t    const missed = sdk.lookupWorkHandler(\"prompt_smoothing\");\n   446\t    expect(missed.ok).toBe(false);\n   447\t    if (missed.ok) return;\n   448\t    expect(missed.error.errorClass).toBe(\"state_corruption\");\n   449\t    expect(missed.error.code).toBe(\"unknown_work_kind\");\n   450\t    expect(missed.error.reason).toContain(\"prompt_smoothing\");\n   451\t  });\n   452\t\n   453\t  it(\"assembly merges per-domain tables, dispatch finds a registered handler, and a doubly-claimed kind is refused\", () => {\n   454\t    const handler: WorkHandler = async () => ({ ok: true });\n   455\t    const map = assembleWorkHandlerMap([\n   456\t      { prompt_smoothing: handler },\n   457\t      { turn_derivation: handler },\n   458\t    ]);\n   459\t    const found = lookupWorkHandler(map, \"prompt_smoothing\");\n   460\t    expect(found.ok).toBe(true);\n   461\t    if (!found.ok) return;\n   462\t    expect(found.value).toBe(handler);\n   463\t    const missed = lookupWorkHandler(map, \"chunk_summary_brief\");\n   464\t    expect(missed.ok).toBe(false);\n   465\t    // One owner per kind: a second table claiming the same kind is a wiring\n   466\t    // bug surfaced at construction.\n   467\t    expect(() =>\n   468\t      assembleWorkHandlerMap([{ prompt_smoothing: handler }, { prompt_smoothing: handler }]),\n   469\t    ).toThrow(/prompt_smoothing/);\n   470\t  });\n   471\t});\n   472\t\n   473\tdescribe(\"architecture-risk: enqueue atomicity — row, pending form, poke commit or vanish together\", () => {\n   474\t  afterEach(() => {\n   475\t    setSchedulerPoke(null);\n   476\t    setIntakeWalkHook(null);\n   477\t  });\n   478\t\n   479\t  it(\"a committed intake batch durably writes work rows + pending forms and pokes once per enqueue, after commit\", async () => {\n   480\t    const filePath = await createThread();\n   481\t    const pokes: string[] = [];\n   482\t    setSchedulerPoke((threadId) => pokes.push(threadId));\n   483\t\n   484\t    const result = await send(filePath, [\n   485\t      validEvent(\"user_prompt\"),\n   486\t      validEvent(\"assistant_text\"),\n   487\t      validEvent(\"turn_end\"),\n   488\t    ]);\n   489\t    // Two enqueues (prompt smoothing + turn derivation) → two pokes, both\n   490\t    // carrying the thread's resolved id, fired only after COMMIT.\n   491\t    expect(pokes).toHaveLength(2);\n   492\t    expect(new Set(pokes).size).toBe(1);\n   493\t    expect(pokes[0]).toMatch(/^th_/);\n   494\t    expect(result.queuedWork).toHaveLength(2);\n   495\t\n   496\t    // The pending state rows rode the same transaction (DD-5): one for the\n   497\t    // prompt's form, two for the turn's rendering + projection.\n   498\t    expect(rawFormRows(filePath)).toEqual([\n   499\t      { key: \"message/m1/smoothed_prompt\", state: \"pending\" },\n   500\t      { key: \"turn/t1/lower_band_projection\", state: \"pending\" },\n","exit_code":0,"status":"completed"}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SLwZzmmS6j1RTHRji7CnXK","type":"tool_result","content":"280\t    expect(rebuilt?.gaps).toBeUndefined();\n281\t    expect(rebuilt?.content).not.toBe(gapped?.content);\n282\t    // Rebuild keeps placement: membership is never re-cut by derivation —\n283\t    // the turn sits exactly where its first placement put it.\n284\t    expect(readChunks(filePath)).toEqual(placedBefore);\n285\t  });\n286\t});\n287\t\n288\tdescribe(\"TC-3.4 / AC-3.4: tool runs compose as outcome-explicit accounts; a state-changing call's outcome survives\", () => {\n289\t  it(\"a three-call edit run with one isError carries per-call outcomes into the composition input, from the forms\", async () => {\n290\t    const double = createProviderDouble();\n291\t    const captured = double.captureInputs();\n292\t    const sdk = manualSdk(double);\n293\t    const filePath = await newThread();\n294\t    const call = (id: string, path: string) =>\n295\t      validEvent(\"tool_call\", {\n296\t        payload: { toolCallId: id, toolName: \"edit_file\", arguments: { path } },\n297\t      });\n298\t    const result = (id: string, content: string, isError: boolean) =>\n299\t      validEvent(\"tool_result\", { payload: { toolCallId: id, content, isError } });\n300\t    await send(sdk, filePath, [\n301\t      validEvent(\"user_prompt\", { payload: { text: \"edit three files\" } }),\n302\t      call(\"call-a\", \"a.txt\"),\n303\t      result(\"call-a\", \"edited a.txt\", false),\n304\t      call(\"call-b\", \"b.txt\"),\n305\t      result(\"call-b\", \"permission denied\", true),\n306\t      call(\"call-c\", \"c.txt\"),\n307\t      result(\"call-c\", \"edited c.txt\", false),\n308\t      validEvent(\"turn_end\"),\n309\t    ]);\n310\t\n311\t    await drain(sdk, filePath);\n312\t    expect(formOf(filePath, \"t1\", \"turn_rendering\")?.state).toBe(\"ready\");\n313\t\n314\t    const composed = captured.filter((entry) => entry.op === \"composeTurnRendering\");\n315\t    expect(composed).toHaveLength(1);\n316\t    const parts = (composed[0]?.input as { parts: RenderingPart[] }).parts;\n317\t    expect(parts.map((part) => part.messageId)).toEqual([\n318\t      \"m1\", \"m2\", \"m3\", \"m4\", \"m5\", \"m6\", \"m7\",\n319\t    ]);\n320\t    // The run's account is the consecutive tool parts in message order, each\n321\t    // stating its outcome — the failed edit's outcome is present on both\n322\t    // halves of its pair and cannot be lost in composition.\n323\t    expect(parts.map((part) => part.outcome ?? null)).toEqual([\n324\t      null,\n325\t      \"succeeded\", \"succeeded\",\n326\t      \"failed\", \"failed\",\n327\t      \"succeeded\", \"succeeded\",\n328\t    ]);\n329\t    // Composition consumed the ready forms, not the raw record: every tool\n330\t    // part's text is its summary form's stored content, verbatim.\n331\t    for (const part of parts.slice(1)) {\n332\t      expect(part.fallback).toBe(false);\n333\t      expect(part.text).toBe(formOf(filePath, part.messageId, `${part.kind}_summary`)?.content);\n334\t    }\n335\t  });\n336\t});\n337\t\n338\tdescribe(\"TC-3.5 / AC-3.5: placement is recorded with the turn and readable through turns\", () => {\n339\t  it(\"draining a closed turn shows chunkId and memberIdx on the turn read-back\", async () => {\n340\t    const double = createProviderDouble();\n341\t    const sdk = manualSdk(double);\n342\t    const filePath = await newThread();\n343\t    await sendTurn(sdk, filePath, \"place me\", \"placed\");\n344\t\n345\t    await drain(sdk, filePath);\n346\t    const turns = await sdk.turns.listTurns({ filePath });\n347\t    expect(turns.ok).toBe(true);\n348\t    if (!turns.ok) return;\n349\t    expect(turns.value).toEqual([\n350\t      expect.objectContaining({ turnId: \"t1\", status: \"closed\", chunkId: \"c1\", memberIdx: 0 }),\n351\t    ]);\n352\t  });\n353\t});\n354\t\n355\tdescribe(\"TC-3.6 / AC-3.6 (architecture risk): the accumulated close rule — the crossing turn is excluded\", () => {\n356\t  const PROJ = \"alpha bravo charlie delta echo foxtrot golf hotel india juliet\";\n357\t\n358\t  it(\"three turns at ~equal size: the third's placement closes the chunk holding two, and the third opens chunk 2\", async () => {\n359\t    const per = estimateTokens(PROJ);\n360\t    const double = createProviderDouble();\n361\t    const provider = withScriptedProjections(double, () => PROJ);\n362\t    const sdk = manualSdk(provider, {\n363\t      targetProjectedTokens: 2 * per + 1,\n364\t      maxProjectedTokens: 100 * per,\n365\t    });\n366\t    const filePath = await newThread();\n367\t    for (let i = 1; i <= 3; i += 1) await sendTurn(sdk, filePath, `prompt ${i}`, `answer ${i}`);\n368\t\n369\t    await drain(sdk, filePath);\n370\t    const snapshot = readChunks(filePath);\n371\t    expect(snapshot.chunks).toEqual([\n372\t      { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: 2 * per },\n373\t      { chunkId: \"c2\", chunkOrder: 2, status: \"open\", accumulatedProjectedTokens: per },\n374\t    ]);\n375\t    expect(snapshot.members).toEqual([\n376\t      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n377\t      { chunkId: \"c1\", turnId: \"t2\", memberIdx: 1 },\n378\t      { chunkId: \"c2\", turnId: \"t3\", memberIdx: 0 },\n379\t    ]);\n380\t    // The close queued both summary kinds for c1 and the drain ran them;\n381\t    // the still-open c2 has none.\n382\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n383\t    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n384\t    expect(formOf(filePath, \"c2\", \"chunk_summary_detailed\")).toBeUndefined();\n385\t    expect(liveCount(filePath)).toBe(0);\n386\t  });\n387\t\n388\t  it(\"threshold exactness: accumulated + incoming equal to the target closes (inclusive), holding only the prior member\", async () => {\n389\t    const per = estimateTokens(PROJ);\n390\t    const double = createProviderDouble();\n391\t    const provider = withScriptedProjections(double, () => PROJ);\n392\t    const sdk = manualSdk(provider, {\n393\t      targetProjectedTokens: 2 * per,\n394\t      maxProjectedTokens: 100 * per,\n395\t    });\n396\t    const filePath = await newThread();\n397\t    await sendTurn(sdk, filePath, \"first\", \"one\");\n398\t    await sendTurn(sdk, filePath, \"second\", \"two\");\n399\t\n400\t    await drain(sdk, filePath);\n401\t    const snapshot = readChunks(filePath);\n402\t    expect(snapshot.members).toEqual([\n403\t      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n404\t      { chunkId: \"c2\", turnId: \"t2\", memberIdx: 0 },\n405\t    ]);\n406\t    expect(snapshot.chunks.map((chunk) => [chunk.chunkId, chunk.status])).toEqual([\n407\t      [\"c1\", \"closed\"],\n408\t      [\"c2\", \"open\"],\n409\t    ]);\n410\t  });\n411\t});\n412\t\n413\tdescribe(\"TC-3.7 / AC-3.7: a single projection at or above the max forms its own chunk, closed immediately\", () => {\n414\t  const BIG = \"omega \".repeat(120).trim();\n415\t\n416\t  it(\"one oversized turn → its own closed chunk with both summaries derived\", async () => {\n417\t    const big = estimateTokens(BIG);\n418\t    const double = createProviderDouble();\n419\t    const provider = withScriptedProjections(double, () => BIG);\n420\t    const sdk = manualSdk(provider, {\n421\t      targetProjectedTokens: big,\n422\t      maxProjectedTokens: big,\n423\t    });\n424\t    const filePath = await newThread();\n425\t    await sendTurn(sdk, filePath, \"huge turn\", \"huge answer\");\n426\t\n427\t    await drain(sdk, filePath);\n428\t    expect(readChunks(filePath)).toEqual({\n429\t      chunks: [\n430\t        { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: big },\n431\t      ],\n432\t      members: [{ chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 }],\n433\t    });\n434\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n435\t    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n436\t  });\n437\t\n438\t  it(\"an oversized turn arriving behind an open chunk closes both: the open chunk without it, its own chunk with it\", async () => {\n439\t    const SMALL = \"tiny projection text\";\n440\t    const big = estimateTokens(BIG);\n441\t    const projections = [SMALL, BIG];\n442\t    const double = createProviderDouble();\n443\t    const provider = withScriptedProjections(double, () => {\n444\t      const next = projections.shift();\n445\t      if (next === undefined) throw new Error(\"scripted projections exhausted\");\n446\t      return next;\n447\t    });\n448\t    // target = max = big: the small turn sits safely under both; the big\n449\t    // turn's arrival crosses the target (small + big ≥ big) and its own\n450\t    // projection meets the max.\n451\t    const sdk = manualSdk(provider, {\n452\t      targetProjectedTokens: big,\n453\t      maxProjectedTokens: big,\n454\t    });\n455\t    const filePath = await newThread();\n456\t    await sendTurn(sdk, filePath, \"small turn\", \"small answer\");\n457\t    await sendTurn(sdk, filePath, \"huge turn\", \"huge answer\");\n458\t\n459\t    await drain(sdk, filePath);\n460\t    const snapshot = readChunks(filePath);\n461\t    expect(snapshot.chunks.map((chunk) => [chunk.chunkId, chunk.status])).toEqual([\n462\t      [\"c1\", \"closed\"],\n463\t      [\"c2\", \"closed\"],\n464\t    ]);\n465\t    expect(snapshot.members).toEqual([\n466\t      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n467\t      { chunkId: \"c2\", turnId: \"t2\", memberIdx: 0 },\n468\t    ]);\n469\t    for (const chunkId of [\"c1\", \"c2\"]) {\n470\t      expect(formOf(filePath, chunkId, \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n471\t      expect(formOf(filePath, chunkId, \"chunk_summary_brief\")?.state).toBe(\"ready\");\n472\t    }\n473\t  });\n474\t});\n475\t\n476\tdescribe(\"TC-3.8 / AC-3.8: chunk close queues two summary work items with independent lifecycles\", () => {\n477\t  // target=max=1: every turn self-chunks and closes immediately, the\n478\t  // smallest deterministic way to manufacture closed chunks.\n479\t  const SELF_CHUNK = { targetProjectedTokens: 1, maxProjectedTokens: 1 };\n480\t\n481\t  it(\"both summaries land ready as distinct chunk-level forms\", async () => {\n482\t    const double = createProviderDouble();\n483\t    const sdk = manualSdk(double, SELF_CHUNK);\n484\t    const filePath = await newThread();\n485\t    await sendTurn(sdk, filePath, \"summarize me\", \"summarized\");\n486\t\n487\t    const report = await drain(sdk, filePath);\n488\t    expect(report.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n489\t      [\"prompt_smoothing\", \"done\"],\n490\t      [\"turn_derivation\", \"done\"],\n491\t      [\"chunk_summary_detailed\", \"done\"],\n492\t      [\"chunk_summary_brief\", \"done\"],\n493\t    ]);\n494\t    const detailed = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n495\t    const brief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n496\t    expect(detailed?.state).toBe(\"ready\");\n497\t    expect(brief?.state).toBe(\"ready\");\n498\t    // Double-marked content distinguishes the two kinds: each went through\n499\t    // its own provider operation, detailed over projections + receipts,\n500\t    // brief over projections + outcomes (empty here — no tool activity).\n501\t    const memberProjections = [formOf(filePath, \"t1\", \"lower_band_projection\")?.content ?? \"\"];\n502\t    expect(detailed?.content).toBe(\n503\t      deterministicText(\n504\t        \"summarizeChunkDetailed\",\n505\t        { memberProjections, memberReceipts: [[]] },\n506\t        memberProjections.join(\" | \"),\n507\t      ),\n508\t    );\n509\t    expect(brief?.content).toBe(\n510\t      deterministicText(\n511\t        \"summarizeChunkBrief\",\n512\t        { memberProjections, memberOutcomes: [[]] },\n513\t        memberProjections.join(\" | \"),\n514\t      ),\n515\t    );\n516\t    expect(detailed?.content).not.toBe(brief?.content);\n517\t  });\n518\t\n519\t  it(\"detailed preserves the tool-run receipts; brief strips them to outcomes only (SV-3.8-001)\", async () => {\n520\t    const double = createProviderDouble();\n521\t    const captured = double.captureInputs();\n522\t    const sdk = manualSdk(double, SELF_CHUNK);\n523\t    const filePath = await newThread();\n524\t    // The run-receipts fixture: a two-call edit run, one isError, closing\n525\t    // into its own chunk so both summaries derive over it.\n526\t    await send(sdk, filePath, [\n527\t      validEvent(\"user_prompt\", { payload: { text: \"edit two files\" } }),\n528\t      validEvent(\"tool_call\", {\n529\t        payload: { toolCallId: \"rcpt-a\", toolName: \"edit_file\", arguments: { path: \"ok.txt\" } },\n530\t      }),\n531\t      validEvent(\"tool_result\", {\n532\t        payload: { toolCallId: \"rcpt-a\", content: \"edited ok.txt\", isError: false },\n533\t      }),\n534\t      validEvent(\"tool_call\", {\n535\t        payload: { toolCallId: \"rcpt-b\", toolName: \"edit_file\", arguments: { path: \"ro.txt\" } },\n536\t      }),\n537\t      validEvent(\"tool_result\", {\n538\t        payload: { toolCallId: \"rcpt-b\", content: \"read-only file\", isError: true },\n539\t      }),\n540\t      validEvent(\"turn_end\"),\n541\t    ]);\n542\t    await drain(sdk, filePath);\n543\t\n544\t    // The receipts are mechanically stamped on the rendering: account text\n545\t    // = each tool message's ready summary form content, outcome from the\n546\t    // record — the material the detailed summary must preserve.\n547\t    const expectedReceipts = ([\"m2\", \"m3\", \"m4\", \"m5\"] as const).map((messageId, index) => ({\n548\t      messageId,\n549\t      activity: index % 2 === 0 ? \"tool_call\" : \"tool_result\",\n550\t      account: formOf(filePath, messageId, index % 2 === 0 ? \"tool_call_summary\" : \"tool_result_summary\")?.content,\n551\t      outcome: index < 2 ? \"succeeded\" : \"failed\",\n552\t    }));\n553\t    expect(formOf(filePath, \"t1\", \"turn_rendering\")?.metadata?.receipts).toEqual(expectedReceipts);\n554\t\n555\t    // Seam evidence: the detailed call received the full receipts; the\n556\t    // brief call received outcomes only — no receipt account text anywhere\n557\t    // in its input, so brief structurally cannot preserve more than\n558\t    // outcomes.\n559\t    const detailedInput = captured.find((entry) => entry.op === \"summarizeChunkDetailed\")?.input;\n560\t    const briefInput = captured.find((entry) => entry.op === \"summarizeChunkBrief\")?.input;\n561\t    expect((detailedInput as { memberReceipts: unknown }).memberReceipts).toEqual([\n562\t      expectedReceipts,\n563\t    ]);\n564\t    expect(briefInput).toEqual({\n565\t      memberProjections: [formOf(filePath, \"t1\", \"lower_band_projection\")?.content],\n566\t      memberOutcomes: [[\"succeeded\", \"succeeded\", \"failed\", \"failed\"]],\n567\t    });\n568\t    for (const receipt of expectedReceipts) {\n569\t      expect(JSON.stringify(briefInput)).not.toContain(receipt.account as string);\n570\t    }\n571\t\n572\t    // Artifact evidence: the detailed summary carries every receipt's\n573\t    // account and outcome; the brief summary carries the outcomes and none\n574\t    // of the receipt content.\n575\t    const detailed = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n576\t    const brief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n577\t    expect(detailed?.state).toBe(\"ready\");\n578\t    expect(brief?.state).toBe(\"ready\");\n579\t    for (const receipt of expectedReceipts) {\n580\t      expect(detailed?.content).toContain(`${receipt.account as string}=>${receipt.outcome}`);\n581\t    }\n582\t    expect(brief?.content).toContain(\"[outcomes succeeded,succeeded,failed,failed]\");\n583\t    expect(brief?.content).not.toContain(\"toolcall(\");\n584\t    expect(brief?.content).not.toContain(\"toolresult(\");\n585\t  });\n586\t\n587\t  it(\"the brief item fails past budget alone: detailed ready, brief failed, brief re-queueable by itself\", async () => {\n588\t    const double = createProviderDouble();\n589\t    const sdk = manualSdk(double, SELF_CHUNK);\n590\t    const filePath = await newThread();\n591\t    double.failKind(\"chunk_summary_brief\", 3, {\n592\t      retryable: true,\n593\t      reason: \"scripted brief failure\",\n594\t    });\n595\t    await sendTurn(sdk, filePath, \"independent retry\", \"answer\");\n596\t\n597\t    const report = await drain(sdk, filePath);\n598\t    expect(report.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n599\t      [\"prompt_smoothing\", \"done\"],"}]},"parent_tool_use_id":null,"session_id":"d9c65f8a-2769-45ee-8250-eab6f8fa0e38","uuid":"12c8994b-e3d4-47a7-b28f-6530b21c8f65","timestamp":"2026-06-11T09:57:08.483Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/derivation-turns.test.ts","content":"    expect(rebuilt?.gaps).toBeUndefined();\n    expect(rebuilt?.content).not.toBe(gapped?.content);\n    // Rebuild keeps placement: membership is never re-cut by derivation —\n    // the turn sits exactly where its first placement put it.\n    expect(readChunks(filePath)).toEqual(placedBefore);\n  });\n});\n\ndescribe(\"TC-3.4 / AC-3.4: tool runs compose as outcome-explicit accounts; a state-changing call's outcome survives\", () => {\n  it(\"a three-call edit run with one isError carries per-call outcomes into the composition input, from the forms\", async () => {\n    const double = createProviderDouble();\n    const captured = double.captureInputs();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    const call = (id: string, path: string) =>\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: id, toolName: \"edit_file\", arguments: { path } },\n      });\n    const result = (id: string, content: string, isError: boolean) =>\n      validEvent(\"tool_result\", { payload: { toolCallId: id, content, isError } });\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"edit three files\" } }),\n      call(\"call-a\", \"a.txt\"),\n      result(\"call-a\", \"edited a.txt\", false),\n      call(\"call-b\", \"b.txt\"),\n      result(\"call-b\", \"permission denied\", true),\n      call(\"call-c\", \"c.txt\"),\n      result(\"call-c\", \"edited c.txt\", false),\n      validEvent(\"turn_end\"),\n    ]);\n\n    await drain(sdk, filePath);\n    expect(formOf(filePath, \"t1\", \"turn_rendering\")?.state).toBe(\"ready\");\n\n    const composed = captured.filter((entry) => entry.op === \"composeTurnRendering\");\n    expect(composed).toHaveLength(1);\n    const parts = (composed[0]?.input as { parts: RenderingPart[] }).parts;\n    expect(parts.map((part) => part.messageId)).toEqual([\n      \"m1\", \"m2\", \"m3\", \"m4\", \"m5\", \"m6\", \"m7\",\n    ]);\n    // The run's account is the consecutive tool parts in message order, each\n    // stating its outcome — the failed edit's outcome is present on both\n    // halves of its pair and cannot be lost in composition.\n    expect(parts.map((part) => part.outcome ?? null)).toEqual([\n      null,\n      \"succeeded\", \"succeeded\",\n      \"failed\", \"failed\",\n      \"succeeded\", \"succeeded\",\n    ]);\n    // Composition consumed the ready forms, not the raw record: every tool\n    // part's text is its summary form's stored content, verbatim.\n    for (const part of parts.slice(1)) {\n      expect(part.fallback).toBe(false);\n      expect(part.text).toBe(formOf(filePath, part.messageId, `${part.kind}_summary`)?.content);\n    }\n  });\n});\n\ndescribe(\"TC-3.5 / AC-3.5: placement is recorded with the turn and readable through turns\", () => {\n  it(\"draining a closed turn shows chunkId and memberIdx on the turn read-back\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    await sendTurn(sdk, filePath, \"place me\", \"placed\");\n\n    await drain(sdk, filePath);\n    const turns = await sdk.turns.listTurns({ filePath });\n    expect(turns.ok).toBe(true);\n    if (!turns.ok) return;\n    expect(turns.value).toEqual([\n      expect.objectContaining({ turnId: \"t1\", status: \"closed\", chunkId: \"c1\", memberIdx: 0 }),\n    ]);\n  });\n});\n\ndescribe(\"TC-3.6 / AC-3.6 (architecture risk): the accumulated close rule — the crossing turn is excluded\", () => {\n  const PROJ = \"alpha bravo charlie delta echo foxtrot golf hotel india juliet\";\n\n  it(\"three turns at ~equal size: the third's placement closes the chunk holding two, and the third opens chunk 2\", async () => {\n    const per = estimateTokens(PROJ);\n    const double = createProviderDouble();\n    const provider = withScriptedProjections(double, () => PROJ);\n    const sdk = manualSdk(provider, {\n      targetProjectedTokens: 2 * per + 1,\n      maxProjectedTokens: 100 * per,\n    });\n    const filePath = await newThread();\n    for (let i = 1; i <= 3; i += 1) await sendTurn(sdk, filePath, `prompt ${i}`, `answer ${i}`);\n\n    await drain(sdk, filePath);\n    const snapshot = readChunks(filePath);\n    expect(snapshot.chunks).toEqual([\n      { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: 2 * per },\n      { chunkId: \"c2\", chunkOrder: 2, status: \"open\", accumulatedProjectedTokens: per },\n    ]);\n    expect(snapshot.members).toEqual([\n      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n      { chunkId: \"c1\", turnId: \"t2\", memberIdx: 1 },\n      { chunkId: \"c2\", turnId: \"t3\", memberIdx: 0 },\n    ]);\n    // The close queued both summary kinds for c1 and the drain ran them;\n    // the still-open c2 has none.\n    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n    expect(formOf(filePath, \"c2\", \"chunk_summary_detailed\")).toBeUndefined();\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"threshold exactness: accumulated + incoming equal to the target closes (inclusive), holding only the prior member\", async () => {\n    const per = estimateTokens(PROJ);\n    const double = createProviderDouble();\n    const provider = withScriptedProjections(double, () => PROJ);\n    const sdk = manualSdk(provider, {\n      targetProjectedTokens: 2 * per,\n      maxProjectedTokens: 100 * per,\n    });\n    const filePath = await newThread();\n    await sendTurn(sdk, filePath, \"first\", \"one\");\n    await sendTurn(sdk, filePath, \"second\", \"two\");\n\n    await drain(sdk, filePath);\n    const snapshot = readChunks(filePath);\n    expect(snapshot.members).toEqual([\n      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n      { chunkId: \"c2\", turnId: \"t2\", memberIdx: 0 },\n    ]);\n    expect(snapshot.chunks.map((chunk) => [chunk.chunkId, chunk.status])).toEqual([\n      [\"c1\", \"closed\"],\n      [\"c2\", \"open\"],\n    ]);\n  });\n});\n\ndescribe(\"TC-3.7 / AC-3.7: a single projection at or above the max forms its own chunk, closed immediately\", () => {\n  const BIG = \"omega \".repeat(120).trim();\n\n  it(\"one oversized turn → its own closed chunk with both summaries derived\", async () => {\n    const big = estimateTokens(BIG);\n    const double = createProviderDouble();\n    const provider = withScriptedProjections(double, () => BIG);\n    const sdk = manualSdk(provider, {\n      targetProjectedTokens: big,\n      maxProjectedTokens: big,\n    });\n    const filePath = await newThread();\n    await sendTurn(sdk, filePath, \"huge turn\", \"huge answer\");\n\n    await drain(sdk, filePath);\n    expect(readChunks(filePath)).toEqual({\n      chunks: [\n        { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: big },\n      ],\n      members: [{ chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 }],\n    });\n    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n  });\n\n  it(\"an oversized turn arriving behind an open chunk closes both: the open chunk without it, its own chunk with it\", async () => {\n    const SMALL = \"tiny projection text\";\n    const big = estimateTokens(BIG);\n    const projections = [SMALL, BIG];\n    const double = createProviderDouble();\n    const provider = withScriptedProjections(double, () => {\n      const next = projections.shift();\n      if (next === undefined) throw new Error(\"scripted projections exhausted\");\n      return next;\n    });\n    // target = max = big: the small turn sits safely under both; the big\n    // turn's arrival crosses the target (small + big ≥ big) and its own\n    // projection meets the max.\n    const sdk = manualSdk(provider, {\n      targetProjectedTokens: big,\n      maxProjectedTokens: big,\n    });\n    const filePath = await newThread();\n    await sendTurn(sdk, filePath, \"small turn\", \"small answer\");\n    await sendTurn(sdk, filePath, \"huge turn\", \"huge answer\");\n\n    await drain(sdk, filePath);\n    const snapshot = readChunks(filePath);\n    expect(snapshot.chunks.map((chunk) => [chunk.chunkId, chunk.status])).toEqual([\n      [\"c1\", \"closed\"],\n      [\"c2\", \"closed\"],\n    ]);\n    expect(snapshot.members).toEqual([\n      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n      { chunkId: \"c2\", turnId: \"t2\", memberIdx: 0 },\n    ]);\n    for (const chunkId of [\"c1\", \"c2\"]) {\n      expect(formOf(filePath, chunkId, \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n      expect(formOf(filePath, chunkId, \"chunk_summary_brief\")?.state).toBe(\"ready\");\n    }\n  });\n});\n\ndescribe(\"TC-3.8 / AC-3.8: chunk close queues two summary work items with independent lifecycles\", () => {\n  // target=max=1: every turn self-chunks and closes immediately, the\n  // smallest deterministic way to manufacture closed chunks.\n  const SELF_CHUNK = { targetProjectedTokens: 1, maxProjectedTokens: 1 };\n\n  it(\"both summaries land ready as distinct chunk-level forms\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double, SELF_CHUNK);\n    const filePath = await newThread();\n    await sendTurn(sdk, filePath, \"summarize me\", \"summarized\");\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n      [\"prompt_smoothing\", \"done\"],\n      [\"turn_derivation\", \"done\"],\n      [\"chunk_summary_detailed\", \"done\"],\n      [\"chunk_summary_brief\", \"done\"],\n    ]);\n    const detailed = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n    const brief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n    expect(detailed?.state).toBe(\"ready\");\n    expect(brief?.state).toBe(\"ready\");\n    // Double-marked content distinguishes the two kinds: each went through\n    // its own provider operation, detailed over projections + receipts,\n    // brief over projections + outcomes (empty here — no tool activity).\n    const memberProjections = [formOf(filePath, \"t1\", \"lower_band_projection\")?.content ?? \"\"];\n    expect(detailed?.content).toBe(\n      deterministicText(\n        \"summarizeChunkDetailed\",\n        { memberProjections, memberReceipts: [[]] },\n        memberProjections.join(\" | \"),\n      ),\n    );\n    expect(brief?.content).toBe(\n      deterministicText(\n        \"summarizeChunkBrief\",\n        { memberProjections, memberOutcomes: [[]] },\n        memberProjections.join(\" | \"),\n      ),\n    );\n    expect(detailed?.content).not.toBe(brief?.content);\n  });\n\n  it(\"detailed preserves the tool-run receipts; brief strips them to outcomes only (SV-3.8-001)\", async () => {\n    const double = createProviderDouble();\n    const captured = double.captureInputs();\n    const sdk = manualSdk(double, SELF_CHUNK);\n    const filePath = await newThread();\n    // The run-receipts fixture: a two-call edit run, one isError, closing\n    // into its own chunk so both summaries derive over it.\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"edit two files\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"rcpt-a\", toolName: \"edit_file\", arguments: { path: \"ok.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"rcpt-a\", content: \"edited ok.txt\", isError: false },\n      }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"rcpt-b\", toolName: \"edit_file\", arguments: { path: \"ro.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"rcpt-b\", content: \"read-only file\", isError: true },\n      }),\n      validEvent(\"turn_end\"),\n    ]);\n    await drain(sdk, filePath);\n\n    // The receipts are mechanically stamped on the rendering: account text\n    // = each tool message's ready summary form content, outcome from the\n    // record — the material the detailed summary must preserve.\n    const expectedReceipts = ([\"m2\", \"m3\", \"m4\", \"m5\"] as const).map((messageId, index) => ({\n      messageId,\n      activity: index % 2 === 0 ? \"tool_call\" : \"tool_result\",\n      account: formOf(filePath, messageId, index % 2 === 0 ? \"tool_call_summary\" : \"tool_result_summary\")?.content,\n      outcome: index < 2 ? \"succeeded\" : \"failed\",\n    }));\n    expect(formOf(filePath, \"t1\", \"turn_rendering\")?.metadata?.receipts).toEqual(expectedReceipts);\n\n    // Seam evidence: the detailed call received the full receipts; the\n    // brief call received outcomes only — no receipt account text anywhere\n    // in its input, so brief structurally cannot preserve more than\n    // outcomes.\n    const detailedInput = captured.find((entry) => entry.op === \"summarizeChunkDetailed\")?.input;\n    const briefInput = captured.find((entry) => entry.op === \"summarizeChunkBrief\")?.input;\n    expect((detailedInput as { memberReceipts: unknown }).memberReceipts).toEqual([\n      expectedReceipts,\n    ]);\n    expect(briefInput).toEqual({\n      memberProjections: [formOf(filePath, \"t1\", \"lower_band_projection\")?.content],\n      memberOutcomes: [[\"succeeded\", \"succeeded\", \"failed\", \"failed\"]],\n    });\n    for (const receipt of expectedReceipts) {\n      expect(JSON.stringify(briefInput)).not.toContain(receipt.account as string);\n    }\n\n    // Artifact evidence: the detailed summary carries every receipt's\n    // account and outcome; the brief summary carries the outcomes and none\n    // of the receipt content.\n    const detailed = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n    const brief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n    expect(detailed?.state).toBe(\"ready\");\n    expect(brief?.state).toBe(\"ready\");\n    for (const receipt of expectedReceipts) {\n      expect(detailed?.content).toContain(`${receipt.account as string}=>${receipt.outcome}`);\n    }\n    expect(brief?.content).toContain(\"[outcomes succeeded,succeeded,failed,failed]\");\n    expect(brief?.content).not.toContain(\"toolcall(\");\n    expect(brief?.content).not.toContain(\"toolresult(\");\n  });\n\n  it(\"the brief item fails past budget alone: detailed ready, brief failed, brief re-queueable by itself\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double, SELF_CHUNK);\n    const filePath = await newThread();\n    double.failKind(\"chunk_summary_brief\", 3, {\n      retryable: true,\n      reason: \"scripted brief failure\",\n    });\n    await sendTurn(sdk, filePath, \"independent retry\", \"answer\");\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n      [\"prompt_smoothing\", \"done\"],","numLines":320,"startLine":280,"totalLines":664}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L42kbTivKboYkHmBGP3uPs","type":"tool_result","content":"1\t// Story 1 (Epic 02): queue execution and drain — Flow 1, in-process half.\n2\t// Claim/lease mechanics, queue-order dispatch, retry/backoff with the\n3\t// head-gates-queue rule, terminal dispositions (reported then deleted, DD-1),\n4\t// unknown-kind handling, both host modes, and coalesced background\n5\t// scheduling. The cross-process legs (TC-1.3 kill, TC-1.4 claim exclusion,\n6\t// CLI parity) live in cli-process-work.test.ts.\n7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n8\timport {\n9\t  countLiveItems,\n10\t  createSdk,\n11\t  intakeStream,\n12\t  queueDetail,\n13\t  setSchedulerPoke,\n14\t  setThreadTouch,\n15\t  threads,\n16\t  type DrainReport,\n17\t  type Lhc,\n18\t  type MessageEventInput,\n19\t} from \"../src/index.js\";\n20\timport {\n21\t  createProviderDouble,\n22\t  openRaw,\n23\t  readDerivedForms,\n24\t  registerTestWorkHandlers,\n25\t  tempStore,\n26\t  validEvent,\n27\t  type TempStore,\n28\t  type ProviderDouble,\n29\t} from \"./fixtures/index.js\";\n30\t\n31\tfunction sleep(ms: number): Promise<void> {\n32\t  return new Promise((resolve) => setTimeout(resolve, ms));\n33\t}\n34\t\n35\tlet store: TempStore;\n36\tbeforeEach(() => {\n37\t  store = tempStore();\n38\t});\n39\tafterEach(() => {\n40\t  // Background-mode SDKs install process-wide seams at construction; tests\n41\t  // must not leak them into each other.\n42\t  setSchedulerPoke(null);\n43\t  setThreadTouch(null);\n44\t  store.cleanup();\n45\t});\n46\t\n47\tasync function newThread(): Promise<{ threadId: string; filePath: string }> {\n48\t  const created = await threads.newThread({\n49\t    filePath: store.threadPath(),\n50\t    registryPath: store.registryPath,\n51\t  });\n52\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n53\t  return created.value;\n54\t}\n55\t\n56\tasync function send(\n57\t  sdk: Lhc,\n58\t  filePath: string,\n59\t  batch: readonly MessageEventInput[],\n60\t): Promise<void> {\n61\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n62\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n63\t}\n64\t\n65\tfunction manualSdk(\n66\t  double: ProviderDouble,\n67\t  overrides: {\n68\t    clock?: () => Date;\n69\t    retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n70\t  } = {},\n71\t): Lhc {\n72\t  const sdk = createSdk({\n73\t    provider: double,\n74\t    mode: \"manual\",\n75\t    clock: overrides.clock ?? (() => new Date()),\n76\t    retry: overrides.retry ?? { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n77\t    lease: { durationMs: 200 },\n78\t  });\n79\t  registerTestWorkHandlers(sdk, double);\n80\t  return sdk;\n81\t}\n82\t\n83\tasync function drain(\n84\t  sdk: Lhc,\n85\t  filePath: string,\n86\t  opts?: { maxItems?: number },\n87\t): Promise<DrainReport> {\n88\t  const result = await sdk.work.drain({ filePath }, opts);\n89\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n90\t  return result.value;\n91\t}\n92\t\n93\tfunction liveCount(filePath: string): number {\n94\t  const db = openRaw(filePath);\n95\t  try {\n96\t    return countLiveItems(db);\n97\t  } finally {\n98\t    db.close();\n99\t  }\n100\t}\n101\t\n102\tfunction liveDetail(filePath: string): ReturnType<typeof queueDetail> {\n103\t  const db = openRaw(filePath);\n104\t  try {\n105\t    return queueDetail(db);\n106\t  } finally {\n107\t    db.close();\n108\t  }\n109\t}\n110\t\n111\tdescribe(\"TC-1.1: a drain runs queued items one at a time, in queue order, and reports each disposition\", () => {\n112\t  // Epic 02 Story 2 (sanctioned amendment): tool_call now queues\n113\t  // tool_call_summary, so this batch yields four items, not three.\n114\t  it(\"four items across both owners run in order; rows are deleted at terminal transition; derivedAt is monotone\", async () => {\n115\t    const double = createProviderDouble();\n116\t    let tick = 0;\n117\t    const base = Date.parse(\"2026-06-10T12:00:00.000Z\");\n118\t    const sdk = manualSdk(double, { clock: () => new Date(base + 1000 * tick++) });\n119\t    const { filePath } = await newThread();\n120\t    await send(sdk, filePath, [\n121\t      validEvent(\"user_prompt\"),\n122\t      validEvent(\"tool_call\"),\n123\t      validEvent(\"tool_result\"),\n124\t      validEvent(\"turn_end\"),\n125\t    ]);\n126\t    expect(liveCount(filePath)).toBe(4);\n127\t\n128\t    const report = await drain(sdk, filePath);\n129\t    // Queue order across owners: m1's smoothing, m2's call summary, m3's\n130\t    // result summary, then the turn derivation queued at close — never\n131\t    // reordered.\n132\t    expect(report.ran.map((entry) => entry.workItemId)).toEqual([\n133\t      \"w-m1-prompt_smoothing-v1\",\n134\t      \"w-m2-tool_call_summary-v1\",\n135\t      \"w-m3-tool_result_summary-v1\",\n136\t      \"w-t1-turn_derivation-v1\",\n137\t    ]);\n138\t    expect(report.ran.map((entry) => entry.disposition)).toEqual([\n139\t      \"done\",\n140\t      \"done\",\n141\t      \"done\",\n142\t      \"done\",\n143\t    ]);\n144\t    expect(report.stoppedBecause).toBe(\"empty\");\n145\t    expect(report.remaining).toBe(0);\n146\t\n147\t    // DD-1 storage contract: terminal rows are gone — the report is the only\n148\t    // place the dispositions exist (raw zero-row read).\n149\t    expect(liveCount(filePath)).toBe(0);\n150\t    const db = openRaw(filePath);\n151\t    try {\n152\t      const rows = db.prepare(\"SELECT COUNT(*) AS n FROM work_item\").get() as {\n153\t        n: number | bigint;\n154\t      };\n155\t      expect(Number(rows.n)).toBe(0);\n156\t    } finally {\n157\t      db.close();\n158\t    }\n159\t\n160\t    // Artifacts landed in run order: derivedAt strictly monotone with the\n161\t    // injected clock from m1 to m3 to the turn's forms.\n162\t    const forms = readDerivedForms(filePath);\n163\t    expect(forms.map((form) => form.state)).toEqual([\n164\t      \"ready\",\n165\t      \"ready\",\n166\t      \"ready\",\n167\t      \"ready\",\n168\t      \"ready\",\n169\t    ]);\n170\t    const at = (subjectId: string, form: string): number => {\n171\t      const row = forms.find((f) => f.subjectId === subjectId && f.form === form);\n172\t      if (row?.derivedAt === undefined) throw new Error(`no derivedAt for ${subjectId}/${form}`);\n173\t      return Date.parse(row.derivedAt);\n174\t    };\n175\t    expect(at(\"m1\", \"smoothed_prompt\")).toBeLessThan(at(\"m3\", \"tool_result_summary\"));\n176\t    expect(at(\"m3\", \"tool_result_summary\")).toBeLessThan(at(\"t1\", \"turn_rendering\"));\n177\t    expect(at(\"t1\", \"turn_rendering\")).toBe(at(\"t1\", \"lower_band_projection\"));\n178\t  });\n179\t});\n180\t\n181\tdescribe(\"TC-1.2 / AC-1.2: mid-drain queueing coalesces into at most one further pass\", () => {\n182\t  it(\"a burst of two more batches during a slow in-flight drain yields exactly two passes and all artifacts\", async () => {\n183\t    const double = createProviderDouble();\n184\t    double.delayKind(\"prompt_smoothing\", 100);\n185\t    const sdk = createSdk({\n186\t      provider: double,\n187\t      mode: \"background\",\n188\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n189\t      lease: { durationMs: 1000 },\n190\t    });\n191\t    registerTestWorkHandlers(sdk, double);\n192\t    const { threadId, filePath } = await newThread();\n193\t\n194\t    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch A\" } })]);\n195\t    // Let the poked drain start (it defers one macrotask), then queue two\n196\t    // more batches while item A's slow handler is in flight.\n197\t    await sleep(10);\n198\t    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch B\" } })]);\n199\t    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch C\" } })]);\n200\t\n201\t    await sdk.drainSettled({ filePath });\n202\t\n203\t    // Everything queued mid-drain was processed before the cycle ended…\n204\t    expect(liveCount(filePath)).toBe(0);\n205\t    const smoothed = readDerivedForms(filePath).filter((f) => f.form === \"smoothed_prompt\");\n206\t    expect(smoothed.map((f) => f.state)).toEqual([\"ready\", \"ready\", \"ready\"]);\n207\t    // …and the burst coalesced: one initial pass plus exactly one follow-up,\n208\t    // not one pass per poke (the cost model is the assertion).\n209\t    expect(sdk.scheduler.testPassCount(threadId)).toBe(2);\n210\t  });\n211\t});\n212\t\n213\tdescribe(\"TC-1.5 / AC-1.5, AC-1.6: background mode — queueing is sufficient; first touch catches up\", () => {\n214\t  it(\"an intake batch is processed with no drain call; drainSettled is the completion signal\", async () => {\n215\t    const double = createProviderDouble();\n216\t    const sdk = createSdk({\n217\t      provider: double,\n218\t      mode: \"background\",\n219\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n220\t      lease: { durationMs: 1000 },\n221\t    });\n222\t    registerTestWorkHandlers(sdk, double);\n223\t    const { filePath } = await newThread();\n224\t\n225\t    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n226\t    await sdk.drainSettled({ filePath });\n227\t\n228\t    const forms = readDerivedForms(filePath);\n229\t    expect(forms.map((f) => `${f.subjectId}/${f.form}/${f.state}`).sort()).toEqual([\n230\t      \"m1/smoothed_prompt/ready\",\n231\t      \"t1/lower_band_projection/ready\",\n232\t      \"t1/turn_rendering/ready\",\n233\t    ]);\n234\t    expect(liveCount(filePath)).toBe(0);\n235\t  });\n236\t\n237\t  it(\"reopening a thread with leftover queued rows runs them on first touch — a read, not a write\", async () => {\n238\t    // Build the leftover state with no background scheduler installed: rows\n239\t    // accumulate exactly as a dead process would have left them.\n240\t    const { filePath } = await newThread();\n241\t    const seeded = await intakeStream.messageEvents({ filePath }, [\n242\t      validEvent(\"user_prompt\"),\n243\t      validEvent(\"turn_end\"),\n244\t    ]);\n245\t    expect(seeded.ok).toBe(true);\n246\t    expect(liveCount(filePath)).toBe(2);\n247\t\n248\t    const double = createProviderDouble();\n249\t    const sdk = createSdk({\n250\t      provider: double,\n251\t      mode: \"background\",\n252\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n253\t      lease: { durationMs: 1000 },\n254\t    });\n255\t    registerTestWorkHandlers(sdk, double);\n256\t\n257\t    // First touch of the thread in this process lifetime: a plain read.\n258\t    const read = await sdk.messages.listMessages({ filePath });\n259\t    expect(read.ok).toBe(true);\n260\t    await sdk.drainSettled({ filePath });\n261\t\n262\t    expect(liveCount(filePath)).toBe(0);\n263\t    const states = readDerivedForms(filePath).map((f) => f.state);\n264\t    expect(states).toEqual([\"ready\", \"ready\", \"ready\"]);\n265\t  });\n266\t});\n267\t\n268\tdescribe(\"TC-1.6 / AC-1.7: manual mode — rows accumulate durably and run only when drain is invoked\", () => {\n269\t  it(\"queued work sits until work.drain; artifacts land after\", async () => {\n270\t    const double = createProviderDouble();\n271\t    const sdk = manualSdk(double);\n272\t    const { filePath } = await newThread();\n273\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n274\t\n275\t    await sleep(100);\n276\t    expect(liveCount(filePath)).toBe(1);\n277\t    expect(liveDetail(filePath)[0]?.status).toBe(\"queued\");\n278\t    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\"pending\"]);\n279\t\n280\t    const report = await drain(sdk, filePath);\n281\t    expect(report.ran).toHaveLength(1);\n282\t    expect(report.ran[0]?.disposition).toBe(\"done\");\n283\t    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\"ready\"]);\n284\t    expect(liveCount(filePath)).toBe(0);\n285\t  });\n286\t});\n287\t\n288\tdescribe(\"TC-1.7 / AC-1.8: an unregistered kind lands failed_terminal with a stable reason and the drain continues\", () => {\n289\t  it(\"a bogus-kind row ahead of a valid item fails with unknown_work_kind; the valid item still runs\", async () => {\n290\t    const double = createProviderDouble();\n291\t    const sdk = manualSdk(double);\n292\t    const { filePath } = await newThread();\n293\t\n294\t    // Raw row with an unregistered kind, queued ahead of any valid work.\n295\t    const db = openRaw(filePath);\n296\t    try {\n297\t      db.prepare(\n298\t        `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at)\n299\t         VALUES ('w-mX-bogus_kind-v1', 'messages', 'bogus_kind', '{\"messageId\":\"mX\"}', 'queued',\n300\t                 '2026-06-10T11:00:00.000Z')`,\n301\t      ).run();\n302\t    } finally {\n303\t      db.close();\n304\t    }\n305\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n306\t\n307\t    const report = await drain(sdk, filePath);\n308\t    expect(report.ran).toHaveLength(2);\n309\t    expect(report.ran[0]).toMatchObject({\n310\t      workItemId: \"w-mX-bogus_kind-v1\",\n311\t      disposition: \"failed_terminal\",\n312\t      reason: \"unknown_work_kind\",\n313\t    });\n314\t    expect(report.ran[1]).toMatchObject({\n315\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n316\t      disposition: \"done\",\n317\t    });\n318\t    expect(report.stoppedBecause).toBe(\"empty\");\n319\t    expect(liveCount(filePath)).toBe(0);\n320\t    const smoothed = readDerivedForms(filePath).find((f) => f.subjectId === \"m1\");\n321\t    expect(smoothed?.state).toBe(\"ready\");\n322\t  });\n323\t});\n324\t\n325\tdescribe(\"TC-1.8 / AC-1.9: retry per policy, terminal exhaustion, and the backoff eligibility gate\", () => {\n326\t  it(\"fails twice then succeeds: artifact ready, report shows attempts=2\", async () => {\n327\t    const double = createProviderDouble();\n328\t    const sdk = manualSdk(double);\n329\t    const { filePath } = await newThread();\n330\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n331\t\n332\t    double.failNext(2, { retryable: true });\n333\t    const report = await drain(sdk, filePath);\n334\t    expect(report.ran).toHaveLength(1);\n335\t    expect(report.ran[0]).toMatchObject({\n336\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n337\t      disposition: \"done\",\n338\t      attempts: 2,\n339\t    });\n340\t    expect(readDerivedForms(filePath)[0]?.state).toBe(\"ready\");\n341\t    expect(liveCount(filePath)).toBe(0);\n342\t  });\n343\t\n344\t  it(\"exhausts the budget: form failed with the final provider reason; the next item still ran; row deleted\", async () => {\n345\t    const double = createProviderDouble();\n346\t    const sdk = manualSdk(double);\n347\t    const { filePath } = await newThread();\n348\t    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n349\t\n350\t    double.failKind(\"prompt_smoothing\", 99, {\n351\t      retryable: true,\n352\t      reason: \"scripted exhaustion (smoothPrompt)\",\n353\t    });\n354\t    const report = await drain(sdk, filePath);\n355\t    expect(report.ran).toHaveLength(2);\n356\t    expect(report.ran[0]).toMatchObject({\n357\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n358\t      disposition: \"failed_terminal\",\n359\t      attempts: 3,\n360\t      reason: \"scripted exhaustion (smoothPrompt)\",\n361\t    });\n362\t    expect(report.ran[1]).toMatchObject({\n363\t      workItemId: \"w-t1-turn_derivation-v1\",\n364\t      disposition: \"done\",\n365\t    });\n366\t\n367\t    const forms = readDerivedForms(filePath);\n368\t    const failed = forms.find((f) => f.form === \"smoothed_prompt\");\n369\t    expect(failed?.state).toBe(\"failed\");\n370\t    expect(failed?.reason).toBe(\"scripted exhaustion (smoothPrompt)\");\n371\t    // Final attempts/last-error copied onto the form at exhaustion (DD-1).\n372\t    expect(failed?.metadata?.attempts).toBe(3);\n373\t    expect(forms.find((f) => f.form === \"turn_rendering\")?.state).toBe(\"ready\");\n374\t    expect(liveCount(filePath)).toBe(0);\n375\t  });\n376\t\n377\t  it(\"backoff gates the head and the head gates the queue: waiting stop, waitingUntil, and no skip-ahead\", async () => {\n378\t    const double = createProviderDouble();\n379\t    let nowMs = Date.parse(\"2026-06-10T12:00:00.000Z\");\n380\t    const sdk = manualSdk(double, {\n381\t      clock: () => new Date(nowMs),\n382\t      retry: { budget: 3, backoffBaseMs: 50, backoffCapMs: 60000 },\n383\t    });\n384\t    const { filePath } = await newThread();\n385\t    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n386\t\n387\t    double.failNext(1, { retryable: true });\n388\t    const first = await drain(sdk, filePath);\n389\t    // The head failed once and is backing off: nothing terminal ran, the\n390\t    // drain stopped on the eligibility gate, and the queue behind the head\n391\t    // was not touched.\n392\t    expect(first.ran).toEqual([]);\n393\t    expect(first.stoppedBecause).toBe(\"waiting\");\n394\t    expect(first.remaining).toBe(2);\n395\t    expect(first.waitingUntil).toBeDefined();\n396\t    expect(Date.parse(first.waitingUntil ?? \"\")).toBeGreaterThan(nowMs);\n397\t\n398\t    const detail = liveDetail(filePath);\n399\t    expect(detail).toHaveLength(2);\n400\t    expect(detail[0]).toMatchObject({\n401\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n402\t      status: \"queued\",\n403\t      attempts: 1,\n404\t    });\n405\t    expect(detail[0]?.eligibleAt).toBe(first.waitingUntil);\n406\t    // Skip-ahead proof: the eligible item behind the backing-off head was\n407\t    // never claimed.\n408\t    expect(detail[1]).toMatchObject({\n409\t      workItemId: \"w-t1-turn_derivation-v1\",\n410\t      status: \"queued\",\n411\t      attempts: 0,\n412\t    });\n413\t    expect(detail[1]?.claimedAt).toBeUndefined();\n414\t\n415\t    // Pass the gate: the head becomes eligible and the queue drains in order.\n416\t    nowMs += 60000;\n417\t    const second = await drain(sdk, filePath);\n418\t    expect(second.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n419\t      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n420\t      [\"w-t1-turn_derivation-v1\", \"done\"],\n421\t    ]);\n422\t    expect(second.ran[0]?.attempts).toBe(1);\n423\t    expect(liveCount(filePath)).toBe(0);\n424\t  });\n425\t\n426\t  it(\"a non-retryable provider failure is terminal immediately\", async () => {\n427\t    const double = createProviderDouble();\n428\t    const sdk = manualSdk(double);\n429\t    const { filePath } = await newThread();\n430\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n431\t\n432\t    double.failNext(1, { retryable: false, reason: \"content refusal (scripted)\" });\n433\t    const report = await drain(sdk, filePath);\n434\t    expect(report.ran[0]).toMatchObject({\n435\t      disposition: \"failed_terminal\",\n436\t      attempts: 1,\n437\t      reason: \"content refusal (scripted)\",\n438\t    });\n439\t    expect(readDerivedForms(filePath)[0]?.state).toBe(\"failed\");\n440\t    expect(liveCount(filePath)).toBe(0);\n441\t  });\n442\t\n443\t  it(\"maxItems stops the drain with max_items and reports the remainder\", async () => {\n444\t    const double = createProviderDouble();\n445\t    const sdk = manualSdk(double);\n446\t    const { filePath } = await newThread();\n447\t    await send(sdk, filePath, [\n448\t      validEvent(\"user_prompt\"),\n449\t      validEvent(\"tool_call\"),\n450\t      validEvent(\"tool_result\"),\n451\t      validEvent(\"turn_end\"),\n452\t    ]);\n453\t\n454\t    const report = await drain(sdk, filePath, { maxItems: 1 });\n455\t    expect(report.ran).toHaveLength(1);\n456\t    expect(report.stoppedBecause).toBe(\"max_items\");\n457\t    // 3 behind the stop since Epic 02 Story 2: tool_call queues its summary\n458\t    // (sanctioned amendment — was 2).\n459\t    expect(report.remaining).toBe(3);\n460\t    expect(liveCount(filePath)).toBe(3);\n461\t  });\n462\t});\n463\t"}]},"parent_tool_use_id":null,"session_id":"d9c65f8a-2769-45ee-8250-eab6f8fa0e38","uuid":"48622c8e-cf08-4852-b13a-8ffc50bb8382","timestamp":"2026-06-11T09:55:39.130Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/work-execution.test.ts","content":"// Story 1 (Epic 02): queue execution and drain — Flow 1, in-process half.\n// Claim/lease mechanics, queue-order dispatch, retry/backoff with the\n// head-gates-queue rule, terminal dispositions (reported then deleted, DD-1),\n// unknown-kind handling, both host modes, and coalesced background\n// scheduling. The cross-process legs (TC-1.3 kill, TC-1.4 claim exclusion,\n// CLI parity) live in cli-process-work.test.ts.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  countLiveItems,\n  createSdk,\n  intakeStream,\n  queueDetail,\n  setSchedulerPoke,\n  setThreadTouch,\n  threads,\n  type DrainReport,\n  type Lhc,\n  type MessageEventInput,\n} from \"../src/index.js\";\nimport {\n  createProviderDouble,\n  openRaw,\n  readDerivedForms,\n  registerTestWorkHandlers,\n  tempStore,\n  validEvent,\n  type TempStore,\n  type ProviderDouble,\n} from \"./fixtures/index.js\";\n\nfunction sleep(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  // Background-mode SDKs install process-wide seams at construction; tests\n  // must not leak them into each other.\n  setSchedulerPoke(null);\n  setThreadTouch(null);\n  store.cleanup();\n});\n\nasync function newThread(): Promise<{ threadId: string; filePath: string }> {\n  const created = await threads.newThread({\n    filePath: store.threadPath(),\n    registryPath: store.registryPath,\n  });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n  return created.value;\n}\n\nasync function send(\n  sdk: Lhc,\n  filePath: string,\n  batch: readonly MessageEventInput[],\n): Promise<void> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n}\n\nfunction manualSdk(\n  double: ProviderDouble,\n  overrides: {\n    clock?: () => Date;\n    retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n  } = {},\n): Lhc {\n  const sdk = createSdk({\n    provider: double,\n    mode: \"manual\",\n    clock: overrides.clock ?? (() => new Date()),\n    retry: overrides.retry ?? { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    lease: { durationMs: 200 },\n  });\n  registerTestWorkHandlers(sdk, double);\n  return sdk;\n}\n\nasync function drain(\n  sdk: Lhc,\n  filePath: string,\n  opts?: { maxItems?: number },\n): Promise<DrainReport> {\n  const result = await sdk.work.drain({ filePath }, opts);\n  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n  return result.value;\n}\n\nfunction liveCount(filePath: string): number {\n  const db = openRaw(filePath);\n  try {\n    return countLiveItems(db);\n  } finally {\n    db.close();\n  }\n}\n\nfunction liveDetail(filePath: string): ReturnType<typeof queueDetail> {\n  const db = openRaw(filePath);\n  try {\n    return queueDetail(db);\n  } finally {\n    db.close();\n  }\n}\n\ndescribe(\"TC-1.1: a drain runs queued items one at a time, in queue order, and reports each disposition\", () => {\n  // Epic 02 Story 2 (sanctioned amendment): tool_call now queues\n  // tool_call_summary, so this batch yields four items, not three.\n  it(\"four items across both owners run in order; rows are deleted at terminal transition; derivedAt is monotone\", async () => {\n    const double = createProviderDouble();\n    let tick = 0;\n    const base = Date.parse(\"2026-06-10T12:00:00.000Z\");\n    const sdk = manualSdk(double, { clock: () => new Date(base + 1000 * tick++) });\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\"),\n      validEvent(\"tool_call\"),\n      validEvent(\"tool_result\"),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(liveCount(filePath)).toBe(4);\n\n    const report = await drain(sdk, filePath);\n    // Queue order across owners: m1's smoothing, m2's call summary, m3's\n    // result summary, then the turn derivation queued at close — never\n    // reordered.\n    expect(report.ran.map((entry) => entry.workItemId)).toEqual([\n      \"w-m1-prompt_smoothing-v1\",\n      \"w-m2-tool_call_summary-v1\",\n      \"w-m3-tool_result_summary-v1\",\n      \"w-t1-turn_derivation-v1\",\n    ]);\n    expect(report.ran.map((entry) => entry.disposition)).toEqual([\n      \"done\",\n      \"done\",\n      \"done\",\n      \"done\",\n    ]);\n    expect(report.stoppedBecause).toBe(\"empty\");\n    expect(report.remaining).toBe(0);\n\n    // DD-1 storage contract: terminal rows are gone — the report is the only\n    // place the dispositions exist (raw zero-row read).\n    expect(liveCount(filePath)).toBe(0);\n    const db = openRaw(filePath);\n    try {\n      const rows = db.prepare(\"SELECT COUNT(*) AS n FROM work_item\").get() as {\n        n: number | bigint;\n      };\n      expect(Number(rows.n)).toBe(0);\n    } finally {\n      db.close();\n    }\n\n    // Artifacts landed in run order: derivedAt strictly monotone with the\n    // injected clock from m1 to m3 to the turn's forms.\n    const forms = readDerivedForms(filePath);\n    expect(forms.map((form) => form.state)).toEqual([\n      \"ready\",\n      \"ready\",\n      \"ready\",\n      \"ready\",\n      \"ready\",\n    ]);\n    const at = (subjectId: string, form: string): number => {\n      const row = forms.find((f) => f.subjectId === subjectId && f.form === form);\n      if (row?.derivedAt === undefined) throw new Error(`no derivedAt for ${subjectId}/${form}`);\n      return Date.parse(row.derivedAt);\n    };\n    expect(at(\"m1\", \"smoothed_prompt\")).toBeLessThan(at(\"m3\", \"tool_result_summary\"));\n    expect(at(\"m3\", \"tool_result_summary\")).toBeLessThan(at(\"t1\", \"turn_rendering\"));\n    expect(at(\"t1\", \"turn_rendering\")).toBe(at(\"t1\", \"lower_band_projection\"));\n  });\n});\n\ndescribe(\"TC-1.2 / AC-1.2: mid-drain queueing coalesces into at most one further pass\", () => {\n  it(\"a burst of two more batches during a slow in-flight drain yields exactly two passes and all artifacts\", async () => {\n    const double = createProviderDouble();\n    double.delayKind(\"prompt_smoothing\", 100);\n    const sdk = createSdk({\n      provider: double,\n      mode: \"background\",\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n      lease: { durationMs: 1000 },\n    });\n    registerTestWorkHandlers(sdk, double);\n    const { threadId, filePath } = await newThread();\n\n    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch A\" } })]);\n    // Let the poked drain start (it defers one macrotask), then queue two\n    // more batches while item A's slow handler is in flight.\n    await sleep(10);\n    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch B\" } })]);\n    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch C\" } })]);\n\n    await sdk.drainSettled({ filePath });\n\n    // Everything queued mid-drain was processed before the cycle ended…\n    expect(liveCount(filePath)).toBe(0);\n    const smoothed = readDerivedForms(filePath).filter((f) => f.form === \"smoothed_prompt\");\n    expect(smoothed.map((f) => f.state)).toEqual([\"ready\", \"ready\", \"ready\"]);\n    // …and the burst coalesced: one initial pass plus exactly one follow-up,\n    // not one pass per poke (the cost model is the assertion).\n    expect(sdk.scheduler.testPassCount(threadId)).toBe(2);\n  });\n});\n\ndescribe(\"TC-1.5 / AC-1.5, AC-1.6: background mode — queueing is sufficient; first touch catches up\", () => {\n  it(\"an intake batch is processed with no drain call; drainSettled is the completion signal\", async () => {\n    const double = createProviderDouble();\n    const sdk = createSdk({\n      provider: double,\n      mode: \"background\",\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n      lease: { durationMs: 1000 },\n    });\n    registerTestWorkHandlers(sdk, double);\n    const { filePath } = await newThread();\n\n    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n    await sdk.drainSettled({ filePath });\n\n    const forms = readDerivedForms(filePath);\n    expect(forms.map((f) => `${f.subjectId}/${f.form}/${f.state}`).sort()).toEqual([\n      \"m1/smoothed_prompt/ready\",\n      \"t1/lower_band_projection/ready\",\n      \"t1/turn_rendering/ready\",\n    ]);\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"reopening a thread with leftover queued rows runs them on first touch — a read, not a write\", async () => {\n    // Build the leftover state with no background scheduler installed: rows\n    // accumulate exactly as a dead process would have left them.\n    const { filePath } = await newThread();\n    const seeded = await intakeStream.messageEvents({ filePath }, [\n      validEvent(\"user_prompt\"),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(seeded.ok).toBe(true);\n    expect(liveCount(filePath)).toBe(2);\n\n    const double = createProviderDouble();\n    const sdk = createSdk({\n      provider: double,\n      mode: \"background\",\n      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n      lease: { durationMs: 1000 },\n    });\n    registerTestWorkHandlers(sdk, double);\n\n    // First touch of the thread in this process lifetime: a plain read.\n    const read = await sdk.messages.listMessages({ filePath });\n    expect(read.ok).toBe(true);\n    await sdk.drainSettled({ filePath });\n\n    expect(liveCount(filePath)).toBe(0);\n    const states = readDerivedForms(filePath).map((f) => f.state);\n    expect(states).toEqual([\"ready\", \"ready\", \"ready\"]);\n  });\n});\n\ndescribe(\"TC-1.6 / AC-1.7: manual mode — rows accumulate durably and run only when drain is invoked\", () => {\n  it(\"queued work sits until work.drain; artifacts land after\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n\n    await sleep(100);\n    expect(liveCount(filePath)).toBe(1);\n    expect(liveDetail(filePath)[0]?.status).toBe(\"queued\");\n    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\"pending\"]);\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran).toHaveLength(1);\n    expect(report.ran[0]?.disposition).toBe(\"done\");\n    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\"ready\"]);\n    expect(liveCount(filePath)).toBe(0);\n  });\n});\n\ndescribe(\"TC-1.7 / AC-1.8: an unregistered kind lands failed_terminal with a stable reason and the drain continues\", () => {\n  it(\"a bogus-kind row ahead of a valid item fails with unknown_work_kind; the valid item still runs\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const { filePath } = await newThread();\n\n    // Raw row with an unregistered kind, queued ahead of any valid work.\n    const db = openRaw(filePath);\n    try {\n      db.prepare(\n        `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at)\n         VALUES ('w-mX-bogus_kind-v1', 'messages', 'bogus_kind', '{\"messageId\":\"mX\"}', 'queued',\n                 '2026-06-10T11:00:00.000Z')`,\n      ).run();\n    } finally {\n      db.close();\n    }\n    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran).toHaveLength(2);\n    expect(report.ran[0]).toMatchObject({\n      workItemId: \"w-mX-bogus_kind-v1\",\n      disposition: \"failed_terminal\",\n      reason: \"unknown_work_kind\",\n    });\n    expect(report.ran[1]).toMatchObject({\n      workItemId: \"w-m1-prompt_smoothing-v1\",\n      disposition: \"done\",\n    });\n    expect(report.stoppedBecause).toBe(\"empty\");\n    expect(liveCount(filePath)).toBe(0);\n    const smoothed = readDerivedForms(filePath).find((f) => f.subjectId === \"m1\");\n    expect(smoothed?.state).toBe(\"ready\");\n  });\n});\n\ndescribe(\"TC-1.8 / AC-1.9: retry per policy, terminal exhaustion, and the backoff eligibility gate\", () => {\n  it(\"fails twice then succeeds: artifact ready, report shows attempts=2\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n\n    double.failNext(2, { retryable: true });\n    const report = await drain(sdk, filePath);\n    expect(report.ran).toHaveLength(1);\n    expect(report.ran[0]).toMatchObject({\n      workItemId: \"w-m1-prompt_smoothing-v1\",\n      disposition: \"done\",\n      attempts: 2,\n    });\n    expect(readDerivedForms(filePath)[0]?.state).toBe(\"ready\");\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"exhausts the budget: form failed with the final provider reason; the next item still ran; row deleted\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n\n    double.failKind(\"prompt_smoothing\", 99, {\n      retryable: true,\n      reason: \"scripted exhaustion (smoothPrompt)\",\n    });\n    const report = await drain(sdk, filePath);\n    expect(report.ran).toHaveLength(2);\n    expect(report.ran[0]).toMatchObject({\n      workItemId: \"w-m1-prompt_smoothing-v1\",\n      disposition: \"failed_terminal\",\n      attempts: 3,\n      reason: \"scripted exhaustion (smoothPrompt)\",\n    });\n    expect(report.ran[1]).toMatchObject({\n      workItemId: \"w-t1-turn_derivation-v1\",\n      disposition: \"done\",\n    });\n\n    const forms = readDerivedForms(filePath);\n    const failed = forms.find((f) => f.form === \"smoothed_prompt\");\n    expect(failed?.state).toBe(\"failed\");\n    expect(failed?.reason).toBe(\"scripted exhaustion (smoothPrompt)\");\n    // Final attempts/last-error copied onto the form at exhaustion (DD-1).\n    expect(failed?.metadata?.attempts).toBe(3);\n    expect(forms.find((f) => f.form === \"turn_rendering\")?.state).toBe(\"ready\");\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"backoff gates the head and the head gates the queue: waiting stop, waitingUntil, and no skip-ahead\", async () => {\n    const double = createProviderDouble();\n    let nowMs = Date.parse(\"2026-06-10T12:00:00.000Z\");\n    const sdk = manualSdk(double, {\n      clock: () => new Date(nowMs),\n      retry: { budget: 3, backoffBaseMs: 50, backoffCapMs: 60000 },\n    });\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n\n    double.failNext(1, { retryable: true });\n    const first = await drain(sdk, filePath);\n    // The head failed once and is backing off: nothing terminal ran, the\n    // drain stopped on the eligibility gate, and the queue behind the head\n    // was not touched.\n    expect(first.ran).toEqual([]);\n    expect(first.stoppedBecause).toBe(\"waiting\");\n    expect(first.remaining).toBe(2);\n    expect(first.waitingUntil).toBeDefined();\n    expect(Date.parse(first.waitingUntil ?? \"\")).toBeGreaterThan(nowMs);\n\n    const detail = liveDetail(filePath);\n    expect(detail).toHaveLength(2);\n    expect(detail[0]).toMatchObject({\n      workItemId: \"w-m1-prompt_smoothing-v1\",\n      status: \"queued\",\n      attempts: 1,\n    });\n    expect(detail[0]?.eligibleAt).toBe(first.waitingUntil);\n    // Skip-ahead proof: the eligible item behind the backing-off head was\n    // never claimed.\n    expect(detail[1]).toMatchObject({\n      workItemId: \"w-t1-turn_derivation-v1\",\n      status: \"queued\",\n      attempts: 0,\n    });\n    expect(detail[1]?.claimedAt).toBeUndefined();\n\n    // Pass the gate: the head becomes eligible and the queue drains in order.\n    nowMs += 60000;\n    const second = await drain(sdk, filePath);\n    expect(second.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n      [\"w-t1-turn_derivation-v1\", \"done\"],\n    ]);\n    expect(second.ran[0]?.attempts).toBe(1);\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"a non-retryable provider failure is terminal immediately\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n\n    double.failNext(1, { retryable: false, reason: \"content refusal (scripted)\" });\n    const report = await drain(sdk, filePath);\n    expect(report.ran[0]).toMatchObject({\n      disposition: \"failed_terminal\",\n      attempts: 1,\n      reason: \"content refusal (scripted)\",\n    });\n    expect(readDerivedForms(filePath)[0]?.state).toBe(\"failed\");\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"maxItems stops the drain with max_items and reports the remainder\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\"),\n      validEvent(\"tool_call\"),\n      validEvent(\"tool_result\"),\n      validEvent(\"turn_end\"),\n    ]);\n\n    const report = await drain(sdk, filePath, { maxItems: 1 });\n    expect(report.ran).toHaveLength(1);\n    expect(report.stoppedBecause).toBe(\"max_items\");\n    // 3 behind the stop since Epic 02 Story 2: tool_call queues its summary\n    // (sanctioned amendment — was 2).\n    expect(report.remaining).toBe(3);\n    expect(liveCount(filePath)).toBe(3);\n  });\n});\n","numLines":463,"startLine":1,"totalLines":463}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0132ZdkKfoy2fhzhFaE6zRTW","type":"tool_result","content":"1\t// Epic 02 Fix Batch 001 — Green-phase regression suite for the canonical\n2\t// epic review's two blockers (impl-lead ruling epic-fix-001). New file: the\n3\t// Red-committed suites stay byte-identical except mutations-delete.test.ts\n4\t// TC-6.2, whose cascade-scope assertion the BLOCK-002b ruling corrects (and\n5\t// whose manifest hash was re-recorded to bless that one change).\n6\t//\n7\t//   - EPIC-02-BLOCK-001: per-SDK-instance poke/touch scoping — a manual SDK\n8\t//     never auto-drains, regardless of construction order, even with a live\n9\t//     background SDK in the same process on a different thread.\n10\t//   - EPIC-02-BLOCK-002a/b: the call/result pair is a source dependency — a\n11\t//     deleted tool_result re-queues its paired tool_call's summary, which\n12\t//     rebuilds outcome `unknown` because the deleted-read filter excludes the\n13\t//     dead result; unrelated summaries are untouched.\n14\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n15\timport {\n16\t  countLiveItems,\n17\t  createSdk,\n18\t  threads,\n19\t  type Lhc,\n20\t  type SdkConfig,\n21\t} from \"../src/index.js\";\n22\timport {\n23\t  createProviderDouble,\n24\t  openRaw,\n25\t  readDerivedForms,\n26\t  tempStore,\n27\t  validEvent,\n28\t  type ProviderDouble,\n29\t  type TempStore,\n30\t} from \"./fixtures/index.js\";\n31\t\n32\tlet store: TempStore;\n33\tbeforeEach(() => {\n34\t  store = tempStore();\n35\t});\n36\tafterEach(() => {\n37\t  store.cleanup();\n38\t});\n39\t\n40\tfunction sleep(ms: number): Promise<void> {\n41\t  return new Promise((resolve) => setTimeout(resolve, ms));\n42\t}\n43\t\n44\tasync function newThread(name: string): Promise<string> {\n45\t  const created = await threads.newThread({\n46\t    filePath: store.threadPath(name),\n47\t    registryPath: store.registryPath,\n48\t  });\n49\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n50\t  return created.value.filePath;\n51\t}\n52\t\n53\tfunction sdkFor(provider: ProviderDouble, mode: SdkConfig[\"mode\"]): Lhc {\n54\t  return createSdk({\n55\t    provider,\n56\t    mode,\n57\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n58\t    lease: { durationMs: 1000 },\n59\t  });\n60\t}\n61\t\n62\tfunction liveCount(filePath: string): number {\n63\t  const db = openRaw(filePath);\n64\t  try {\n65\t    return countLiveItems(db);\n66\t  } finally {\n67\t    db.close();\n68\t  }\n69\t}\n70\t\n71\tfunction formKey(form: { subjectKind: string; subjectId: string; form: string }): string {\n72\t  return `${form.subjectKind}/${form.subjectId}/${form.form}`;\n73\t}\n74\t\n75\t// ── EPIC-02-BLOCK-001: per-SDK-instance scheduler seam ────────────\n76\tdescribe(\"EPIC-02-BLOCK-001: a manual SDK never auto-drains alongside a background SDK\", () => {\n77\t  it(\"background-then-manual on different threads: the manual thread's rows stay queued until explicit drain\", async () => {\n78\t    // Construction order is the regression: the background SDK installs the\n79\t    // below-SDK default seam first; the manual SDK must still isolate its own\n80\t    // operations to a no-op so its queued work never auto-drains.\n81\t    const bgDouble = createProviderDouble();\n82\t    const sdkBg = sdkFor(bgDouble, \"background\");\n83\t    const manDouble = createProviderDouble();\n84\t    const sdkMan = sdkFor(manDouble, \"manual\");\n85\t\n86\t    const threadB = await newThread(\"bg\");\n87\t    const threadM = await newThread(\"man\");\n88\t\n89\t    // Manual SDK queues smoothing work on its own thread.\n90\t    const queued = await sdkMan.intakeStream.messageEvents({ filePath: threadM }, [\n91\t      validEvent(\"user_prompt\"),\n92\t    ]);\n93\t    expect(queued.ok).toBe(true);\n94\t\n95\t    // Positive control: the background SDK does drive its own thread — proving\n96\t    // its scheduler is live, not merely inert.\n97\t    const bgBatch = await sdkBg.intakeStream.messageEvents({ filePath: threadB }, [\n98\t      validEvent(\"user_prompt\"),\n99\t    ]);\n100\t    expect(bgBatch.ok).toBe(true);\n101\t    await sdkBg.drainSettled({ filePath: threadB });\n102\t\n103\t    // Give any erroneous background drain of the manual thread a chance to run\n104\t    // (a background drain defers one macrotask).\n105\t    await sleep(50);\n106\t\n107\t    // The manual thread's rows stayed queued — never poked, never touched, so\n108\t    // never auto-drained (AC-1.7).\n109\t    expect(liveCount(threadM)).toBe(1);\n110\t    expect(readDerivedForms(threadM).map((form) => form.state)).toEqual([\"pending\"]);\n111\t\n112\t    // The background thread WAS processed without an explicit drain (AC-1.5).\n113\t    expect(liveCount(threadB)).toBe(0);\n114\t    expect(readDerivedForms(threadB).map((form) => form.state)).toEqual([\"ready\"]);\n115\t\n116\t    // Explicit drain finally runs the manual thread's accumulated work.\n117\t    const report = await sdkMan.work.drain({ filePath: threadM });\n118\t    expect(report.ok).toBe(true);\n119\t    expect(liveCount(threadM)).toBe(0);\n120\t    expect(readDerivedForms(threadM).map((form) => form.state)).toEqual([\"ready\"]);\n121\t  });\n122\t\n123\t  it(\"manual-then-background isolates the manual SDK the same way\", async () => {\n124\t    // The reverse order: the manual SDK exists first, the background SDK\n125\t    // installs the default seam afterward; the manual SDK's operations still\n126\t    // deliver to its own no-op seam, not the freshly installed default.\n127\t    const manDouble = createProviderDouble();\n128\t    const sdkMan = sdkFor(manDouble, \"manual\");\n129\t    const bgDouble = createProviderDouble();\n130\t    const sdkBg = sdkFor(bgDouble, \"background\");\n131\t    expect(sdkBg.scheduler.mode).toBe(\"background\");\n132\t\n133\t    const threadM = await newThread(\"man\");\n134\t    const queued = await sdkMan.intakeStream.messageEvents({ filePath: threadM }, [\n135\t      validEvent(\"user_prompt\"),\n136\t    ]);\n137\t    expect(queued.ok).toBe(true);\n138\t\n139\t    await sleep(50);\n140\t    expect(liveCount(threadM)).toBe(1);\n141\t    expect(readDerivedForms(threadM).map((form) => form.state)).toEqual([\"pending\"]);\n142\t  });\n143\t});\n144\t\n145\t// ── EPIC-02-BLOCK-002a/b: pair counterpart joins the cascade ──────\n146\tdescribe(\"EPIC-02-BLOCK-002: the call/result pair is a source dependency\", () => {\n147\t  async function toolRunThread(sdk: Lhc): Promise<string> {\n148\t    const filePath = await newThread(\"toolrun\");\n149\t    const batch = await sdk.intakeStream.messageEvents({ filePath }, [\n150\t      validEvent(\"user_prompt\"),\n151\t      validEvent(\"tool_call\"),\n152\t      validEvent(\"tool_result\"),\n153\t      validEvent(\"assistant_text\"),\n154\t      validEvent(\"turn_end\"),\n155\t    ]);\n156\t    expect(batch.ok).toBe(true);\n157\t    const drained = await sdk.work.drain({ filePath });\n158\t    expect(drained.ok).toBe(true);\n159\t    return filePath;\n160\t  }\n161\t\n162\t  it(\"deleting a tool_result re-queues the paired tool_call summary; it rebuilds outcome unknown\", async () => {\n163\t    const double = createProviderDouble();\n164\t    const sdk = sdkFor(double, \"manual\");\n165\t    const filePath = await toolRunThread(sdk);\n166\t\n167\t    // Before: m2's call summary derived with a real outcome (the result is\n168\t    // present and clean), and the control prompt smoothing is ready at v1.\n169\t    const before = readDerivedForms(filePath);\n170\t    const callBefore = before.find(\n171\t      (form) => form.subjectId === \"m2\" && form.form === \"tool_call_summary\",\n172\t    );\n173\t    expect(callBefore?.state).toBe(\"ready\");\n174\t    expect(callBefore?.sourceVersion).toBe(1);\n175\t    expect(callBefore?.metadata?.outcome).toBe(\"succeeded\");\n176\t    const promptBefore = before.find(\n177\t      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n178\t    );\n179\t\n180\t    // Delete the tool_result (m3). The pair counterpart (m2) joins the cascade.\n181\t    const result = await sdk.messages.deleteMessage({ filePath }, { messageId: \"m3\" });\n182\t    expect(result.ok).toBe(true);\n183\t    if (!result.ok) return;\n184\t    expect(result.value.dropped.map(formKey)).toEqual([\"message/m3/tool_result_summary\"]);\n185\t    expect(result.value.cleared.map(formKey)).toContain(\"message/m2/tool_call_summary\");\n186\t    expect(result.value.queued.map((item) => item.workItemId)).toContain(\n187\t      \"w-m2-tool_call_summary-v2\",\n188\t    );\n189\t\n190\t    // After rebuild: the call summary is ready at the bumped version, and its\n191\t    // outcome reverts to `unknown` — the deleted-read filter (BLOCK-002a)\n192\t    // excludes the dead result, so the call derives no pair.\n193\t    const rebuild = await sdk.work.drain({ filePath });\n194\t    expect(rebuild.ok).toBe(true);\n195\t    const after = readDerivedForms(filePath);\n196\t    const callAfter = after.find(\n197\t      (form) => form.subjectId === \"m2\" && form.form === \"tool_call_summary\",\n198\t    );\n199\t    expect(callAfter?.state).toBe(\"ready\");\n200\t    expect(callAfter?.sourceVersion).toBe(2);\n201\t    expect(callAfter?.metadata?.outcome).toBe(\"unknown\");\n202\t\n203\t    // Control: the unrelated prompt smoothing is byte-stable, source version\n204\t    // included — the cascade reaches the pair, nothing else.\n205\t    const promptAfter = after.find(\n206\t      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n207\t    );\n208\t    expect(promptAfter).toEqual(promptBefore);\n209\t    expect(liveCount(filePath)).toBe(0);\n210\t  });\n211\t});\n212\t"}]},"parent_tool_use_id":null,"session_id":"d9c65f8a-2769-45ee-8250-eab6f8fa0e38","uuid":"07a609d4-648e-40d9-8ec7-e6ffca4a64fa","timestamp":"2026-06-11T09:55:54.214Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/epic-fix-02.test.ts","content":"// Epic 02 Fix Batch 001 — Green-phase regression suite for the canonical\n// epic review's two blockers (impl-lead ruling epic-fix-001). New file: the\n// Red-committed suites stay byte-identical except mutations-delete.test.ts\n// TC-6.2, whose cascade-scope assertion the BLOCK-002b ruling corrects (and\n// whose manifest hash was re-recorded to bless that one change).\n//\n//   - EPIC-02-BLOCK-001: per-SDK-instance poke/touch scoping — a manual SDK\n//     never auto-drains, regardless of construction order, even with a live\n//     background SDK in the same process on a different thread.\n//   - EPIC-02-BLOCK-002a/b: the call/result pair is a source dependency — a\n//     deleted tool_result re-queues its paired tool_call's summary, which\n//     rebuilds outcome `unknown` because the deleted-read filter excludes the\n//     dead result; unrelated summaries are untouched.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  countLiveItems,\n  createSdk,\n  threads,\n  type Lhc,\n  type SdkConfig,\n} from \"../src/index.js\";\nimport {\n  createProviderDouble,\n  openRaw,\n  readDerivedForms,\n  tempStore,\n  validEvent,\n  type ProviderDouble,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction sleep(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nasync function newThread(name: string): Promise<string> {\n  const created = await threads.newThread({\n    filePath: store.threadPath(name),\n    registryPath: store.registryPath,\n  });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n  return created.value.filePath;\n}\n\nfunction sdkFor(provider: ProviderDouble, mode: SdkConfig[\"mode\"]): Lhc {\n  return createSdk({\n    provider,\n    mode,\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    lease: { durationMs: 1000 },\n  });\n}\n\nfunction liveCount(filePath: string): number {\n  const db = openRaw(filePath);\n  try {\n    return countLiveItems(db);\n  } finally {\n    db.close();\n  }\n}\n\nfunction formKey(form: { subjectKind: string; subjectId: string; form: string }): string {\n  return `${form.subjectKind}/${form.subjectId}/${form.form}`;\n}\n\n// ── EPIC-02-BLOCK-001: per-SDK-instance scheduler seam ────────────\ndescribe(\"EPIC-02-BLOCK-001: a manual SDK never auto-drains alongside a background SDK\", () => {\n  it(\"background-then-manual on different threads: the manual thread's rows stay queued until explicit drain\", async () => {\n    // Construction order is the regression: the background SDK installs the\n    // below-SDK default seam first; the manual SDK must still isolate its own\n    // operations to a no-op so its queued work never auto-drains.\n    const bgDouble = createProviderDouble();\n    const sdkBg = sdkFor(bgDouble, \"background\");\n    const manDouble = createProviderDouble();\n    const sdkMan = sdkFor(manDouble, \"manual\");\n\n    const threadB = await newThread(\"bg\");\n    const threadM = await newThread(\"man\");\n\n    // Manual SDK queues smoothing work on its own thread.\n    const queued = await sdkMan.intakeStream.messageEvents({ filePath: threadM }, [\n      validEvent(\"user_prompt\"),\n    ]);\n    expect(queued.ok).toBe(true);\n\n    // Positive control: the background SDK does drive its own thread — proving\n    // its scheduler is live, not merely inert.\n    const bgBatch = await sdkBg.intakeStream.messageEvents({ filePath: threadB }, [\n      validEvent(\"user_prompt\"),\n    ]);\n    expect(bgBatch.ok).toBe(true);\n    await sdkBg.drainSettled({ filePath: threadB });\n\n    // Give any erroneous background drain of the manual thread a chance to run\n    // (a background drain defers one macrotask).\n    await sleep(50);\n\n    // The manual thread's rows stayed queued — never poked, never touched, so\n    // never auto-drained (AC-1.7).\n    expect(liveCount(threadM)).toBe(1);\n    expect(readDerivedForms(threadM).map((form) => form.state)).toEqual([\"pending\"]);\n\n    // The background thread WAS processed without an explicit drain (AC-1.5).\n    expect(liveCount(threadB)).toBe(0);\n    expect(readDerivedForms(threadB).map((form) => form.state)).toEqual([\"ready\"]);\n\n    // Explicit drain finally runs the manual thread's accumulated work.\n    const report = await sdkMan.work.drain({ filePath: threadM });\n    expect(report.ok).toBe(true);\n    expect(liveCount(threadM)).toBe(0);\n    expect(readDerivedForms(threadM).map((form) => form.state)).toEqual([\"ready\"]);\n  });\n\n  it(\"manual-then-background isolates the manual SDK the same way\", async () => {\n    // The reverse order: the manual SDK exists first, the background SDK\n    // installs the default seam afterward; the manual SDK's operations still\n    // deliver to its own no-op seam, not the freshly installed default.\n    const manDouble = createProviderDouble();\n    const sdkMan = sdkFor(manDouble, \"manual\");\n    const bgDouble = createProviderDouble();\n    const sdkBg = sdkFor(bgDouble, \"background\");\n    expect(sdkBg.scheduler.mode).toBe(\"background\");\n\n    const threadM = await newThread(\"man\");\n    const queued = await sdkMan.intakeStream.messageEvents({ filePath: threadM }, [\n      validEvent(\"user_prompt\"),\n    ]);\n    expect(queued.ok).toBe(true);\n\n    await sleep(50);\n    expect(liveCount(threadM)).toBe(1);\n    expect(readDerivedForms(threadM).map((form) => form.state)).toEqual([\"pending\"]);\n  });\n});\n\n// ── EPIC-02-BLOCK-002a/b: pair counterpart joins the cascade ──────\ndescribe(\"EPIC-02-BLOCK-002: the call/result pair is a source dependency\", () => {\n  async function toolRunThread(sdk: Lhc): Promise<string> {\n    const filePath = await newThread(\"toolrun\");\n    const batch = await sdk.intakeStream.messageEvents({ filePath }, [\n      validEvent(\"user_prompt\"),\n      validEvent(\"tool_call\"),\n      validEvent(\"tool_result\"),\n      validEvent(\"assistant_text\"),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(batch.ok).toBe(true);\n    const drained = await sdk.work.drain({ filePath });\n    expect(drained.ok).toBe(true);\n    return filePath;\n  }\n\n  it(\"deleting a tool_result re-queues the paired tool_call summary; it rebuilds outcome unknown\", async () => {\n    const double = createProviderDouble();\n    const sdk = sdkFor(double, \"manual\");\n    const filePath = await toolRunThread(sdk);\n\n    // Before: m2's call summary derived with a real outcome (the result is\n    // present and clean), and the control prompt smoothing is ready at v1.\n    const before = readDerivedForms(filePath);\n    const callBefore = before.find(\n      (form) => form.subjectId === \"m2\" && form.form === \"tool_call_summary\",\n    );\n    expect(callBefore?.state).toBe(\"ready\");\n    expect(callBefore?.sourceVersion).toBe(1);\n    expect(callBefore?.metadata?.outcome).toBe(\"succeeded\");\n    const promptBefore = before.find(\n      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n    );\n\n    // Delete the tool_result (m3). The pair counterpart (m2) joins the cascade.\n    const result = await sdk.messages.deleteMessage({ filePath }, { messageId: \"m3\" });\n    expect(result.ok).toBe(true);\n    if (!result.ok) return;\n    expect(result.value.dropped.map(formKey)).toEqual([\"message/m3/tool_result_summary\"]);\n    expect(result.value.cleared.map(formKey)).toContain(\"message/m2/tool_call_summary\");\n    expect(result.value.queued.map((item) => item.workItemId)).toContain(\n      \"w-m2-tool_call_summary-v2\",\n    );\n\n    // After rebuild: the call summary is ready at the bumped version, and its\n    // outcome reverts to `unknown` — the deleted-read filter (BLOCK-002a)\n    // excludes the dead result, so the call derives no pair.\n    const rebuild = await sdk.work.drain({ filePath });\n    expect(rebuild.ok).toBe(true);\n    const after = readDerivedForms(filePath);\n    const callAfter = after.find(\n      (form) => form.subjectId === \"m2\" && form.form === \"tool_call_summary\",\n    );\n    expect(callAfter?.state).toBe(\"ready\");\n    expect(callAfter?.sourceVersion).toBe(2);\n    expect(callAfter?.metadata?.outcome).toBe(\"unknown\");\n\n    // Control: the unrelated prompt smoothing is byte-stable, source version\n    // included — the cascade reaches the pair, nothing else.\n    const promptAfter = after.find(\n      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n    );\n    expect(promptAfter).toEqual(promptBefore);\n    expect(liveCount(filePath)).toBe(0);\n  });\n});\n","numLines":212,"startLine":1,"totalLines":212}}}

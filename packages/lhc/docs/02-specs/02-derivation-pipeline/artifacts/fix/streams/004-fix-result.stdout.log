{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016xrcSr3eBU9TtsnDxXxbaZ","type":"tool_result","content":"285\t    expect(listed.ok).toBe(true);\n286\t    if (!listed.ok) return;\n287\t    expect(listed.value).toHaveLength(1);\n288\t    expect(listed.value[0]?.blocks[0]?.content[\"text\"]).toBe(text);\n289\t  });\n290\t});\n291\t\n292\tdescribe(\"TC-2.7 / AC-2.7: kinds with no derivable form queue no work and carry no state rows\", () => {\n293\t  it(\"assistant text and a runtime note: no items, no derivation rows, an empty drain\", async () => {\n294\t    const double = createProviderDouble();\n295\t    const sdk = manualSdk(double);\n296\t    const filePath = await newThread();\n297\t\n298\t    const batch = await send(sdk, filePath, [\n299\t      validEvent(\"assistant_text\"),\n300\t      validEvent(\"runtime_note\"),\n301\t    ]);\n302\t    expect(batch.queuedWork).toEqual([]);\n303\t    expect(liveCount(filePath)).toBe(0);\n304\t\n305\t    const report = await drain(sdk, filePath);\n306\t    expect(report.ran).toEqual([]);\n307\t    expect(report.stoppedBecause).toBe(\"empty\");\n308\t    expect(readDerivedForms(filePath)).toEqual([]);\n309\t  });\n310\t});\n311\t\n312\tdescribe(\"TC-2.8 / AC-2.8 (architecture risk): a late result re-queues an unknown-outcome summary at intake\", () => {\n313\t  it(\"split batches: the result's intake re-queues the summary; the repair is a real queue round-trip\", async () => {\n314\t    const double = createProviderDouble();\n315\t    const sdk = manualSdk(double);\n316\t    const filePath = await newThread();\n317\t\n318\t    // Batch 1: the call alone. Its summary derives with no pair in sight.\n319\t    await send(sdk, filePath, [validEvent(\"tool_call\")]);\n320\t    await drain(sdk, filePath);\n321\t    const before = formOf(filePath, \"m1\", \"tool_call_summary\");\n322\t    expect(before?.state).toBe(\"ready\");\n323\t    expect(before?.metadata).toEqual({ outcome: \"unknown\" });\n324\t    expect(before?.sourceVersion).toBe(1);\n325\t\n326\t    // Batch 2: the paired result lands later. The intake result itself\n327\t    // reports the re-queued summary — repair is intake-time and visible,\n328\t    // not a read-time join.\n329\t    const batch = await send(sdk, filePath, [validEvent(\"tool_result\")]);\n330\t    expect(batch.queuedWork).toContainEqual({\n331\t      workItemId: \"w-m2-tool_result_summary-v1\",\n332\t      owner: \"messages\",\n333\t      kind: \"tool_result_summary\",\n334\t      sourceRef: { messageId: \"m2\" },\n335\t    });\n336\t    expect(batch.queuedWork).toContainEqual({\n337\t      workItemId: \"w-m1-tool_call_summary-v2\",\n338\t      owner: \"messages\",\n339\t      kind: \"tool_call_summary\",\n340\t      sourceRef: { messageId: \"m1\" },\n341\t    });\n342\t    // The clear half of clear-and-regenerate rode the batch transaction.\n343\t    const cleared = formOf(filePath, \"m1\", \"tool_call_summary\");\n344\t    expect(cleared?.state).toBe(\"pending\");"}]},"parent_tool_use_id":null,"session_id":"d9c65f8a-2769-45ee-8250-eab6f8fa0e38","uuid":"c567b459-b6ef-4555-9b00-76a7b3545c64","timestamp":"2026-06-11T10:06:36.493Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/derivation-messages.test.ts","content":"    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    expect(listed.value).toHaveLength(1);\n    expect(listed.value[0]?.blocks[0]?.content[\"text\"]).toBe(text);\n  });\n});\n\ndescribe(\"TC-2.7 / AC-2.7: kinds with no derivable form queue no work and carry no state rows\", () => {\n  it(\"assistant text and a runtime note: no items, no derivation rows, an empty drain\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n\n    const batch = await send(sdk, filePath, [\n      validEvent(\"assistant_text\"),\n      validEvent(\"runtime_note\"),\n    ]);\n    expect(batch.queuedWork).toEqual([]);\n    expect(liveCount(filePath)).toBe(0);\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran).toEqual([]);\n    expect(report.stoppedBecause).toBe(\"empty\");\n    expect(readDerivedForms(filePath)).toEqual([]);\n  });\n});\n\ndescribe(\"TC-2.8 / AC-2.8 (architecture risk): a late result re-queues an unknown-outcome summary at intake\", () => {\n  it(\"split batches: the result's intake re-queues the summary; the repair is a real queue round-trip\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n\n    // Batch 1: the call alone. Its summary derives with no pair in sight.\n    await send(sdk, filePath, [validEvent(\"tool_call\")]);\n    await drain(sdk, filePath);\n    const before = formOf(filePath, \"m1\", \"tool_call_summary\");\n    expect(before?.state).toBe(\"ready\");\n    expect(before?.metadata).toEqual({ outcome: \"unknown\" });\n    expect(before?.sourceVersion).toBe(1);\n\n    // Batch 2: the paired result lands later. The intake result itself\n    // reports the re-queued summary — repair is intake-time and visible,\n    // not a read-time join.\n    const batch = await send(sdk, filePath, [validEvent(\"tool_result\")]);\n    expect(batch.queuedWork).toContainEqual({\n      workItemId: \"w-m2-tool_result_summary-v1\",\n      owner: \"messages\",\n      kind: \"tool_result_summary\",\n      sourceRef: { messageId: \"m2\" },\n    });\n    expect(batch.queuedWork).toContainEqual({\n      workItemId: \"w-m1-tool_call_summary-v2\",\n      owner: \"messages\",\n      kind: \"tool_call_summary\",\n      sourceRef: { messageId: \"m1\" },\n    });\n    // The clear half of clear-and-regenerate rode the batch transaction.\n    const cleared = formOf(filePath, \"m1\", \"tool_call_summary\");\n    expect(cleared?.state).toBe(\"pending\");","numLines":60,"startLine":285,"totalLines":396}}}

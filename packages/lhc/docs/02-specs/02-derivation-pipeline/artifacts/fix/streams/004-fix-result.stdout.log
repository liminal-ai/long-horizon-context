{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012nmGwbVZTb2mCXhernkZRY","type":"tool_result","content":"292\texport function complete(\n293\t  db: DatabaseSync,\n294\t  item: ClaimedWorkItem,\n295\t  writes: readonly HandlerFormWrite[],\n296\t  derivedAt: string,\n297\t  onApplied?: (tx: CompletionTx) => void,\n298\t): \"done\" | \"stale_discarded\" {\n299\t  const hooks = createCommitHooks();\n300\t  db.exec(\"BEGIN IMMEDIATE;\");\n301\t  try {\n302\t    let hits = 0;\n303\t    const update = db.prepare(\n304\t      `UPDATE derived_form\n305\t       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = ?, derived_at = ?\n306\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n307\t    );\n308\t    for (const write of writes) {\n309\t      const changed = update.run(\n310\t        write.content,\n311\t        write.metadata === undefined ? null : JSON.stringify(write.metadata),\n312\t        write.gaps === undefined ? null : JSON.stringify(write.gaps),\n313\t        derivedAt,\n314\t        write.subjectKind,\n315\t        write.subjectId,\n316\t        write.form,\n317\t        item.sourceVersion,\n318\t      );\n319\t      hits += Number(changed.changes);\n320\t    }\n321\t    const stale = writes.length > 0 && hits === 0;\n322\t    if (!stale && onApplied !== undefined) {\n323\t      onApplied({ db, onCommit: hooks.register });\n324\t    }\n325\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n326\t    db.exec(\"COMMIT;\");\n327\t    hooks.flush();\n328\t    return stale ? \"stale_discarded\" : \"done\";\n329\t  } catch (cause) {\n330\t    db.exec(\"ROLLBACK;\");\n331\t    throw cause;"}]},"parent_tool_use_id":null,"session_id":"d9c65f8a-2769-45ee-8250-eab6f8fa0e38","uuid":"a7f886d2-03aa-4d85-85f1-13e8ac67ad79","timestamp":"2026-06-11T10:09:42.000Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/tech-utils/work-queue/index.ts","content":"export function complete(\n  db: DatabaseSync,\n  item: ClaimedWorkItem,\n  writes: readonly HandlerFormWrite[],\n  derivedAt: string,\n  onApplied?: (tx: CompletionTx) => void,\n): \"done\" | \"stale_discarded\" {\n  const hooks = createCommitHooks();\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    let hits = 0;\n    const update = db.prepare(\n      `UPDATE derived_form\n       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = ?, derived_at = ?\n       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n    );\n    for (const write of writes) {\n      const changed = update.run(\n        write.content,\n        write.metadata === undefined ? null : JSON.stringify(write.metadata),\n        write.gaps === undefined ? null : JSON.stringify(write.gaps),\n        derivedAt,\n        write.subjectKind,\n        write.subjectId,\n        write.form,\n        item.sourceVersion,\n      );\n      hits += Number(changed.changes);\n    }\n    const stale = writes.length > 0 && hits === 0;\n    if (!stale && onApplied !== undefined) {\n      onApplied({ db, onCommit: hooks.register });\n    }\n    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n    db.exec(\"COMMIT;\");\n    hooks.flush();\n    return stale ? \"stale_discarded\" : \"done\";\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;","numLines":40,"startLine":292,"totalLines":549}}}

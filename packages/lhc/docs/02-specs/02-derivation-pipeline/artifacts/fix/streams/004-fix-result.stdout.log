{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014gbfMv4b6ZATFzXdpdqUEb","type":"tool_result","content":"1\texport * as threads from \"./domains/threads/index.js\";\n2\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n3\texport * as messages from \"./domains/messages/index.js\";\n4\texport * as turns from \"./domains/turns/index.js\";\n5\t\n6\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n7\timport * as messagesDomain from \"./domains/messages/index.js\";\n8\timport * as threadsDomain from \"./domains/threads/index.js\";\n9\timport * as turnsDomain from \"./domains/turns/index.js\";\n10\timport {\n11\t  createScheduler,\n12\t  peekThreadId,\n13\t  runDrain,\n14\t  type DrainDeps,\n15\t  type DrainReport,\n16\t  type Scheduler,\n17\t} from \"./scheduler.js\";\n18\timport {\n19\t  runWithInstanceSeam,\n20\t  setSchedulerPoke as installSchedulerPoke,\n21\t  setThreadTouch,\n22\t  type InstanceSeam,\n23\t} from \"./shared/context.js\";\n24\timport {\n25\t  PROVIDER_OPERATIONS,\n26\t  type ResolvedSdkConfig,\n27\t  type SdkConfig,\n28\t  type WorkHandler,\n29\t} from \"./shared/derivation.js\";\n30\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n31\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n32\t\n33\texport {\n34\t  estimateTokens,\n35\t  TOKEN_ESTIMATOR_ID,\n36\t} from \"./tech-utils/token-counting/index.js\";\n37\t\n38\texport {\n39\t  WORK_KIND_REGISTRY,\n40\t  type WorkItemRecord,\n41\t  type WorkKind,\n42\t  type WorkOwner,\n43\t  type WorkSourceRef,\n44\t} from \"./tech-utils/work-queue/index.js\";\n45\t\n46\texport type {\n47\t  ErrorClass,\n48\t  ErrorCode,\n49\t  ErrorResult,\n50\t  OpResult,\n51\t} from \"./shared/errors.js\";\n52\texport {\n53\t  runInTransaction,\n54\t  setSchedulerPoke,\n55\t  setThreadTouch,\n56\t  type OperationContext,\n57\t} from \"./shared/context.js\";\n58\t\n59\texport {\n60\t  createDeterministicProvider,\n61\t  deterministicOutcomesSuffix,\n62\t  deterministicReceiptsSuffix,\n63\t  deterministicText,\n64\t  type DeterministicOpName,\n65\t} from \"./providers/deterministic.js\";\n66\texport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n67\t\n68\texport type {\n69\t  CompletionTx,\n70\t  DependencyGap,\n71\t  DerivationProvider,\n72\t  DerivedForm,\n73\t  DerivedFormMetadata,\n74\t  DerivedFormState,\n75\t  FormKind,\n76\t  FormReportEntry,\n77\t  HandlerFormWrite,\n78\t  HandlerOutcome,\n79\t  HandlerRunContext,\n80\t  ProviderResult,\n81\t  RenderingPart,\n82\t  ResolvedSdkConfig,\n83\t  SdkConfig,\n84\t  SubjectKind,\n85\t  ToolOutcome,\n86\t  ToolRunReceipt,\n87\t  WorkHandler,\n88\t} from \"./shared/derivation.js\";\n89\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n90\texport {\n91\t  countLiveItems,\n92\t  enqueue,\n93\t  queueDetail,\n94\t  supersedeQueued,\n95\t  type ClaimedWorkItem,\n96\t  type EnqueueFormTarget,\n97\t  type EnqueueInput,\n98\t  type QueueDetailRow,\n99\t} from \"./tech-utils/work-queue/index.js\";\n100\t\n101\texport type { ThreadRef } from \"./domains/threads/index.js\";\n102\texport type {\n103\t  Block,\n104\t  BlockType,\n105\t  MessageRecord,\n106\t  MutationResult,\n107\t} from \"./domains/messages/index.js\";\n108\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n109\texport type {\n110\t  BatchResult,\n111\t  EventKind,\n112\t  EventRecord,\n113\t  MessageEventInput,\n114\t} from \"./domains/intake-stream/index.js\";\n115\t\n116\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n117\t\n118\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n119\t\n120\t// Merge per-domain handler tables into the one join between the queue's\n121\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n122\t// (each kind has exactly one owner) and throws at construction.\n123\texport function assembleWorkHandlerMap(\n124\t  tables: ReadonlyArray<WorkHandlerMap>,\n125\t): WorkHandlerMap {\n126\t  const map: WorkHandlerMap = {};\n127\t  for (const table of tables) {\n128\t    for (const [kind, handler] of Object.entries(table)) {\n129\t      if (map[kind as WorkKind] !== undefined) {\n130\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n131\t      }\n132\t      map[kind as WorkKind] = handler;\n133\t    }\n134\t  }\n135\t  return map;\n136\t}\n137\t\n138\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n139\t  return {\n140\t    ok: false,\n141\t    error: {\n142\t      errorClass: \"state_corruption\",\n143\t      code: \"unknown_work_kind\",\n144\t      reason: `no handler registered for work kind \"${kind}\"`,\n145\t    },\n146\t  };\n147\t}\n148\t\n149\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n150\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n151\texport function lookupWorkHandler(\n152\t  map: WorkHandlerMap,\n153\t  kind: string,\n154\t): OpResult<WorkHandler> {\n155\t  const handler = map[kind as WorkKind];\n156\t  if (handler === undefined) return unknownWorkKind(kind);\n157\t  return { ok: true, value: handler };\n158\t}\n159\t\n160\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n161\t// requeue land in Story 4.\n162\texport interface WorkSurface {\n163\t  drain(\n164\t    ref: threadsDomain.ThreadRef,\n165\t    opts?: { maxItems?: number },\n166\t  ): Promise<OpResult<DrainReport>>;\n167\t}\n168\t\n169\texport interface Lhc {\n170\t  threads: typeof threadsDomain;\n171\t  intakeStream: typeof intakeStreamDomain;\n172\t  messages: typeof messagesDomain;\n173\t  turns: typeof turnsDomain;\n174\t  config: ResolvedSdkConfig;\n175\t  scheduler: Scheduler;\n176\t  workHandlers: WorkHandlerMap;\n177\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n178\t  work: WorkSurface;\n179\t  // Resolves when the scheduler has no running or pending drain for the\n180\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n181\t  // resolve in manual mode.\n182\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n183\t}\n184\t\n185\tfunction requirePositive(value: number, name: string): void {\n186\t  if (!Number.isFinite(value) || value <= 0) {\n187\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n188\t  }\n189\t}\n190\t\n191\tfunction requireNonNegative(value: number, name: string): void {\n192\t  if (!Number.isFinite(value) || value < 0) {\n193\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n194\t  }\n195\t}\n196\t\n197\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n198\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n199\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n200\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n201\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n202\t// object is the same shape as the namespace, so the public surface type holds.\n203\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n204\t  const scoped: Record<string, unknown> = {};\n205\t  for (const key of Object.keys(surface)) {\n206\t    const value = (surface as Record<string, unknown>)[key];\n207\t    scoped[key] =\n208\t      typeof value === \"function\"\n209\t        ? (...args: unknown[]): unknown =>\n210\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n211\t        : value;\n212\t  }\n213\t  return scoped as T;\n214\t}\n215\t\n216\t// The only assembly path: provider, mode, clock, and policy enter here.\n217\t// Config mistakes are programmer errors at construction and throw; operating\n218\t// failures after construction return OpResults per the error contract.\n219\texport function createSdk(config: SdkConfig): Lhc {\n220\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n221\t    throw new TypeError(\n222\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n223\t    );\n224\t  }\n225\t  if (config.provider === null || typeof config.provider !== \"object\") {\n226\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n227\t  }\n228\t  for (const operation of PROVIDER_OPERATIONS) {\n229\t    if (typeof config.provider[operation] !== \"function\") {\n230\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n231\t    }\n232\t  }\n233\t\n234\t  const resolved: ResolvedSdkConfig = {\n235\t    provider: config.provider,\n236\t    mode: config.mode,\n237\t    clock: config.clock ?? (() => new Date()),\n238\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n239\t    lease: config.lease ?? { durationMs: 120000 },\n240\t    chunkPolicy:\n241\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n242\t  };\n243\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n244\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n245\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n246\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n247\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n248\t  }\n249\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n250\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n251\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n252\t    throw new TypeError(\n253\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n254\t    );\n255\t  }\n256\t\n257\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n258\t  // The tables are empty until Stories 2–3 land the real handlers; the\n259\t  // assembly mechanics are production code from day one.\n260\t  const workHandlers = assembleWorkHandlerMap([\n261\t    messagesDomain.workHandlers,\n262\t    turnsDomain.workHandlers,\n263\t  ]);\n264\t\n265\t  const drainDeps: DrainDeps = {\n266\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n267\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n268\t    config: resolved,\n269\t  };\n270\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n271\t\n272\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n273\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n274\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n275\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n276\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n277\t  // the construction order, because its operations deliver to the no-op seam,\n278\t  // not to whatever a background SDK installed below.\n279\t  const seam: InstanceSeam =\n280\t    resolved.mode === \"background\"\n281\t      ? {\n282\t          poke: (threadId) => scheduler.poke(threadId),\n283\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n284\t        }\n285\t      : { poke: () => {}, touch: () => {} };\n286\t\n287\t  // Background mode also installs the below-SDK default seam so a direct\n288\t  // domain call made with no SDK scope — a top-level mutation in the\n289\t  // single-background \"production path\" — still reaches the one installed\n290\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n291\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n292\t  // leaves the default alone (pokes stay no-ops by contract).\n293\t  if (resolved.mode === \"background\") {\n294\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n295\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n296\t  }\n297\t\n298\t  const work: WorkSurface = {\n299\t    drain: (ref, opts) =>\n300\t      runWithInstanceSeam(seam, async () => {\n301\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n302\t        if (!resolvedRef.ok) return resolvedRef;\n303\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n304\t      }),\n305\t  };\n306\t\n307\t  return {\n308\t    threads: threadsDomain,\n309\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n310\t    messages: scopeSurface(messagesDomain, seam),\n311\t    turns: scopeSurface(turnsDomain, seam),\n312\t    config: resolved,\n313\t    scheduler,\n314\t    workHandlers,\n315\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n316\t    work,\n317\t    drainSettled: async (ref) => {\n318\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n319\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n320\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n321\t      if (threadId === null) return;\n322\t      return scheduler.drainSettled(threadId);\n323\t    },\n324\t  };\n325\t}\n326\t"}]},"parent_tool_use_id":null,"session_id":"d9c65f8a-2769-45ee-8250-eab6f8fa0e38","uuid":"67f38594-a713-466f-b0c4-edc5fefc484b","timestamp":"2026-06-11T09:55:26.840Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts","content":"export * as threads from \"./domains/threads/index.js\";\nexport * as intakeStream from \"./domains/intake-stream/index.js\";\nexport * as messages from \"./domains/messages/index.js\";\nexport * as turns from \"./domains/turns/index.js\";\n\nimport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\nimport * as messagesDomain from \"./domains/messages/index.js\";\nimport * as threadsDomain from \"./domains/threads/index.js\";\nimport * as turnsDomain from \"./domains/turns/index.js\";\nimport {\n  createScheduler,\n  peekThreadId,\n  runDrain,\n  type DrainDeps,\n  type DrainReport,\n  type Scheduler,\n} from \"./scheduler.js\";\nimport {\n  runWithInstanceSeam,\n  setSchedulerPoke as installSchedulerPoke,\n  setThreadTouch,\n  type InstanceSeam,\n} from \"./shared/context.js\";\nimport {\n  PROVIDER_OPERATIONS,\n  type ResolvedSdkConfig,\n  type SdkConfig,\n  type WorkHandler,\n} from \"./shared/derivation.js\";\nimport type { ErrorResult, OpResult } from \"./shared/errors.js\";\nimport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n\nexport {\n  estimateTokens,\n  TOKEN_ESTIMATOR_ID,\n} from \"./tech-utils/token-counting/index.js\";\n\nexport {\n  WORK_KIND_REGISTRY,\n  type WorkItemRecord,\n  type WorkKind,\n  type WorkOwner,\n  type WorkSourceRef,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type {\n  ErrorClass,\n  ErrorCode,\n  ErrorResult,\n  OpResult,\n} from \"./shared/errors.js\";\nexport {\n  runInTransaction,\n  setSchedulerPoke,\n  setThreadTouch,\n  type OperationContext,\n} from \"./shared/context.js\";\n\nexport {\n  createDeterministicProvider,\n  deterministicOutcomesSuffix,\n  deterministicReceiptsSuffix,\n  deterministicText,\n  type DeterministicOpName,\n} from \"./providers/deterministic.js\";\nexport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n\nexport type {\n  CompletionTx,\n  DependencyGap,\n  DerivationProvider,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  FormReportEntry,\n  HandlerFormWrite,\n  HandlerOutcome,\n  HandlerRunContext,\n  ProviderResult,\n  RenderingPart,\n  ResolvedSdkConfig,\n  SdkConfig,\n  SubjectKind,\n  ToolOutcome,\n  ToolRunReceipt,\n  WorkHandler,\n} from \"./shared/derivation.js\";\nexport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\nexport {\n  countLiveItems,\n  enqueue,\n  queueDetail,\n  supersedeQueued,\n  type ClaimedWorkItem,\n  type EnqueueFormTarget,\n  type EnqueueInput,\n  type QueueDetailRow,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type { ThreadRef } from \"./domains/threads/index.js\";\nexport type {\n  Block,\n  BlockType,\n  MessageRecord,\n  MutationResult,\n} from \"./domains/messages/index.js\";\nexport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\nexport type {\n  BatchResult,\n  EventKind,\n  EventRecord,\n  MessageEventInput,\n} from \"./domains/intake-stream/index.js\";\n\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n\n// Merge per-domain handler tables into the one join between the queue's\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n// (each kind has exactly one owner) and throws at construction.\nexport function assembleWorkHandlerMap(\n  tables: ReadonlyArray<WorkHandlerMap>,\n): WorkHandlerMap {\n  const map: WorkHandlerMap = {};\n  for (const table of tables) {\n    for (const [kind, handler] of Object.entries(table)) {\n      if (map[kind as WorkKind] !== undefined) {\n        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n      }\n      map[kind as WorkKind] = handler;\n    }\n  }\n  return map;\n}\n\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"state_corruption\",\n      code: \"unknown_work_kind\",\n      reason: `no handler registered for work kind \"${kind}\"`,\n    },\n  };\n}\n\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\nexport function lookupWorkHandler(\n  map: WorkHandlerMap,\n  kind: string,\n): OpResult<WorkHandler> {\n  const handler = map[kind as WorkKind];\n  if (handler === undefined) return unknownWorkKind(kind);\n  return { ok: true, value: handler };\n}\n\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n// requeue land in Story 4.\nexport interface WorkSurface {\n  drain(\n    ref: threadsDomain.ThreadRef,\n    opts?: { maxItems?: number },\n  ): Promise<OpResult<DrainReport>>;\n}\n\nexport interface Lhc {\n  threads: typeof threadsDomain;\n  intakeStream: typeof intakeStreamDomain;\n  messages: typeof messagesDomain;\n  turns: typeof turnsDomain;\n  config: ResolvedSdkConfig;\n  scheduler: Scheduler;\n  workHandlers: WorkHandlerMap;\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n  work: WorkSurface;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3) — the awaitable for background mode, and a no-op\n  // resolve in manual mode.\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n}\n\nfunction requirePositive(value: number, name: string): void {\n  if (!Number.isFinite(value) || value <= 0) {\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n  }\n}\n\nfunction requireNonNegative(value: number, name: string): void {\n  if (!Number.isFinite(value) || value < 0) {\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n  }\n}\n\n// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n// (background) or a no-op (manual) — never another SDK's. Non-function exports\n// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n// object is the same shape as the namespace, so the public surface type holds.\nfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n  const scoped: Record<string, unknown> = {};\n  for (const key of Object.keys(surface)) {\n    const value = (surface as Record<string, unknown>)[key];\n    scoped[key] =\n      typeof value === \"function\"\n        ? (...args: unknown[]): unknown =>\n            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n        : value;\n  }\n  return scoped as T;\n}\n\n// The only assembly path: provider, mode, clock, and policy enter here.\n// Config mistakes are programmer errors at construction and throw; operating\n// failures after construction return OpResults per the error contract.\nexport function createSdk(config: SdkConfig): Lhc {\n  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n    throw new TypeError(\n      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n    );\n  }\n  if (config.provider === null || typeof config.provider !== \"object\") {\n    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n  }\n  for (const operation of PROVIDER_OPERATIONS) {\n    if (typeof config.provider[operation] !== \"function\") {\n      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n    }\n  }\n\n  const resolved: ResolvedSdkConfig = {\n    provider: config.provider,\n    mode: config.mode,\n    clock: config.clock ?? (() => new Date()),\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n    lease: config.lease ?? { durationMs: 120000 },\n    chunkPolicy:\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n  };\n  requirePositive(resolved.retry.budget, \"retry.budget\");\n  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n  }\n  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n    throw new TypeError(\n      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n    );\n  }\n\n  // Handler maps merge from per-domain contributions at construction (DD-6).\n  // The tables are empty until Stories 2–3 land the real handlers; the\n  // assembly mechanics are production code from day one.\n  const workHandlers = assembleWorkHandlerMap([\n    messagesDomain.workHandlers,\n    turnsDomain.workHandlers,\n  ]);\n\n  const drainDeps: DrainDeps = {\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n    config: resolved,\n  };\n  const scheduler = createScheduler(resolved.mode, drainDeps);\n\n  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n  // background mode, or a no-op in manual mode — isolated from any other SDK\n  // alive in the process. A manual SDK therefore never auto-drains, whatever\n  // the construction order, because its operations deliver to the no-op seam,\n  // not to whatever a background SDK installed below.\n  const seam: InstanceSeam =\n    resolved.mode === \"background\"\n      ? {\n          poke: (threadId) => scheduler.poke(threadId),\n          touch: (filePath, db) => scheduler.touch(filePath, db),\n        }\n      : { poke: () => {}, touch: () => {} };\n\n  // Background mode also installs the below-SDK default seam so a direct\n  // domain call made with no SDK scope — a top-level mutation in the\n  // single-background \"production path\" — still reaches the one installed\n  // scheduler. The per-instance scoping above overrides this for every sdk.*\n  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n  // leaves the default alone (pokes stay no-ops by contract).\n  if (resolved.mode === \"background\") {\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n  }\n\n  const work: WorkSurface = {\n    drain: (ref, opts) =>\n      runWithInstanceSeam(seam, async () => {\n        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n        if (!resolvedRef.ok) return resolvedRef;\n        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n      }),\n  };\n\n  return {\n    threads: threadsDomain,\n    intakeStream: scopeSurface(intakeStreamDomain, seam),\n    messages: scopeSurface(messagesDomain, seam),\n    turns: scopeSurface(turnsDomain, seam),\n    config: resolved,\n    scheduler,\n    workHandlers,\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    work,\n    drainSettled: async (ref) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n      const threadId = peekThreadId(resolvedRef.value.filePath);\n      if (threadId === null) return;\n      return scheduler.drainSettled(threadId);\n    },\n  };\n}\n","numLines":326,"startLine":1,"totalLines":326}}}

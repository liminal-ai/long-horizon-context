t waiting for ${what}`);\n    await sleep(5);\n  }\n}\n\nfunction liveDetail(filePath: string): ReturnType<typeof queueDetail> {\n  const db = openRaw(filePath);\n  try {\n    return queueDetail(db);\n  } finally {\n    db.close();\n  }\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":308,"cache_creation_input_tokens":308,"cache_read_input_tokens":224897,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":308},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"d9c65f8a-2769-45ee-8250-eab6f8fa0e38","uuid":"417d5a7d-7c87-47bb-9e8c-e40331f63a1b","request_id":"req_011CbwJNp2jSFYQT1ijV72dW"}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012QNkbCza3QBjSj7xjwavqg","type":"tool_result","content":"1\t// The mutation cascade (DD-8, Flows 5/6): walk the derivation chain upward\n2\t// from the mutated subject — the message's own forms, its turn's rendering\n3\t// and projection, the containing chunk's two summaries — clearing each to\n4\t// `pending` at the next source version and enqueueing replacement work, all\n5\t// inside the caller's mutation transaction. The clear-set is derived from\n6\t// the record's structure (the message → turn → chunk walk over the rows that\n7\t// actually exist), never from a hardcoded form list: a future form on any\n8\t// subject in the chain cascades without this module changing. Still-queued\n9\t// old-version items are supersede-deleted (tech design issue 1) and reported\n10\t// on the MutationResult; claimed items are deliberately left to the\n11\t// source-version check (DD-3) — their stale completions discard. The two\n12\t// close paths share one core walk parameterized drop-vs-clear: edit clears\n13\t// the whole chain, delete *drops* the deleted subject's own forms (state\n14\t// rows removed — a deleted source has nothing to rebuild) and clears\n15\t// everything upward for minus-one composition. Turn delete enters at the\n16\t// turn level, dropping the turn's and all live members' forms; a chunk left\n17\t// with no live members drops its summary forms too — dropped, never failed,\n18\t// and no rebuild queued (AC-6.6).\n19\timport type { DatabaseSync } from \"node:sqlite\";\n20\timport type { OperationContext } from \"../../../shared/context.js\";\n21\timport type { FormKind, SubjectKind } from \"../../../shared/derivation.js\";\n22\timport {\n23\t  enqueue,\n24\t  supersedeQueued,\n25\t  WORK_KIND_REGISTRY,\n26\t  type EnqueueFormTarget,\n27\t  type WorkKind,\n28\t  type WorkSourceRef,\n29\t} from \"../../../tech-utils/work-queue/index.js\";\n30\t\n31\t// Each form's rebuild queue-site — the owning domains' enqueue mappings,\n32\t// gathered here because the cascade is the one place that re-queues across\n33\t// the whole chain (module responsibility matrix: replacement enqueues for\n34\t// all three mutations live with the cascade). Both turn forms ride the one\n35\t// turn_derivation item; every other form rides its same-named kind.\n36\tconst FORM_REBUILD_KINDS: Record<FormKind, WorkKind> = {\n37\t  smoothed_prompt: \"prompt_smoothing\",\n38\t  tool_call_summary: \"tool_call_summary\",\n39\t  tool_result_summary: \"tool_result_summary\",\n40\t  turn_rendering: \"turn_derivation\",\n41\t  lower_band_projection: \"turn_derivation\",\n42\t  chunk_summary_detailed: \"chunk_summary_detailed\",\n43\t  chunk_summary_brief: \"chunk_summary_brief\",\n44\t};\n45\t\n46\texport interface CascadeClear {\n47\t  subjectKind: SubjectKind;\n48\t  subjectId: string;\n49\t  form: FormKind;\n50\t}\n51\t\n52\texport interface CascadeOutcome {\n53\t  cleared: CascadeClear[];\n54\t  dropped: CascadeClear[];\n55\t  queued: Array<{ workItemId: string; kind: WorkKind }>;\n56\t  superseded: string[];\n57\t}\n58\t\n59\tinterface ChainSubject {\n60\t  subjectKind: SubjectKind;\n61\t  subjectId: string;\n62\t}\n63\t\n64\tfunction sourceRefFor(subject: ChainSubject): WorkSourceRef {\n65\t  switch (subject.subjectKind) {\n66\t    case \"message\":\n67\t      return { messageId: subject.subjectId };\n68\t    case \"turn\":\n69\t      return { turnId: subject.subjectId };\n70\t    case \"chunk\":\n71\t      return { chunkId: subject.subjectId };\n72\t  }\n73\t}\n74\t\n75\t// The structural walk: the mutated message's turn from its membership stamp,\n76\t// the turn's chunk from its placement row. Either link may be absent — a gap\n77\t// message has no turn, an unplaced turn no chunk — and the chain simply\n78\t// stops there; reach is structural, not configured. Deliberately unfiltered:\n79\t// the walk runs after a delete stamps its subject, and the chain above a\n80\t// just-deleted record is exactly what must still cascade.\n81\tfunction chainSubjects(db: DatabaseSync, messageId: string): ChainSubject[] {\n82\t  const subjects: ChainSubject[] = [{ subjectKind: \"message\", subjectId: messageId }];\n83\t  const turnRow = db\n84\t    .prepare(`SELECT turn_id FROM message WHERE message_id = ?`)\n85\t    .get(messageId) as unknown as { turn_id: string | null } | undefined;\n86\t  const turnId = turnRow?.turn_id ?? null;\n87\t  if (turnId === null) return subjects;\n88\t  subjects.push({ subjectKind: \"turn\", subjectId: turnId });\n89\t  const chunkRow = db\n90\t    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n91\t    .get(turnId) as unknown as { chunk_id: string } | undefined;\n92\t  if (chunkRow !== undefined) {\n93\t    subjects.push({ subjectKind: \"chunk\", subjectId: chunkRow.chunk_id });\n94\t  }\n95\t  return subjects;\n96\t}\n97\t\n98\tinterface RebuildGroup {\n99\t  subject: ChainSubject;\n100\t  kind: WorkKind;\n101\t  forms: EnqueueFormTarget[];\n102\t  maxSourceVersion: number;\n103\t}\n104\t\n105\tfunction rebuildKindFor(form: string): WorkKind {\n106\t  const kind = FORM_REBUILD_KINDS[form as FormKind];\n107\t  if (kind === undefined) {\n108\t    // Every form names its queue site above; a miss is a wiring bug.\n109\t    throw new Error(`no rebuild work kind mapped for derived form ${form}`);\n110\t  }\n111\t  return kind;\n112\t}\n113\t\n114\t// The shared core (DD-8's one cascade, parameterized): drop subjects lose\n115\t// their form rows outright; clear subjects go pending at the next source\n116\t// version with replacement work enqueued. Supersede-deletes land before the\n117\t// replacement enqueues so a tidied id can never collide, and queued items\n118\t// against dropped subjects are tidied with no replacement — dead work for a\n119\t// source that no longer reads.\n120\tfunction runCascade(\n121\t  ctx: OperationContext,\n122\t  dropSubjects: readonly ChainSubject[],\n123\t  clearSubjects: readonly ChainSubject[],\n124\t): CascadeOutcome {\n125\t  const readForms = ctx.db.prepare(\n126\t    `SELECT form, source_version FROM derived_form\n127\t     WHERE subject_kind = ? AND subject_id = ? ORDER BY form`,\n128\t  );\n129\t\n130\t  const dropped: CascadeClear[] = [];\n131\t  const supersedeTargets: Array<{ kind: WorkKind; sourceRef: WorkSourceRef }> = [];\n132\t  const dropRows = ctx.db.prepare(\n133\t    `DELETE FROM derived_form WHERE subject_kind = ? AND subject_id = ?`,\n134\t  );\n135\t  for (const subject of dropSubjects) {\n136\t    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n137\t      form: string;\n138\t    }>;\n139\t    const kinds = new Set<WorkKind>();\n140\t    for (const row of rows) {\n141\t      dropped.push({ ...subject, form: row.form as FormKind });\n142\t      kinds.add(rebuildKindFor(row.form));\n143\t    }\n144\t    for (const kind of kinds) {\n145\t      supersedeTargets.push({ kind, sourceRef: sourceRefFor(subject) });\n146\t    }\n147\t    dropRows.run(subject.subjectKind, subject.subjectId);\n148\t  }\n149\t\n150\t  const cleared: CascadeClear[] = [];\n151\t  const groups = new Map<string, RebuildGroup>();\n152\t  for (const subject of clearSubjects) {\n153\t    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n154\t      form: string;\n155\t      source_version: number | bigint;\n156\t    }>;\n157\t    for (const row of rows) {\n158\t      const form = row.form as FormKind;\n159\t      cleared.push({ ...subject, form });\n160\t      const kind = rebuildKindFor(row.form);\n161\t      const key = `${subject.subjectKind}:${subject.subjectId}:${kind}`;\n162\t      const group = groups.get(key) ?? {\n163\t        subject,\n164\t        kind,\n165\t        forms: [],\n166\t        maxSourceVersion: 0,\n167\t      };\n168\t      group.forms.push({ subjectKind: subject.subjectKind, subjectId: subject.subjectId, form });\n169\t      group.maxSourceVersion = Math.max(group.maxSourceVersion, Number(row.source_version));\n170\t      groups.set(key, group);\n171\t    }\n172\t  }\n173\t\n174\t  const superseded = supersedeQueued(ctx.db, [\n175\t    ...supersedeTargets,\n176\t    ...[...groups.values()].map((group) => ({\n177\t      kind: group.kind,\n178\t      sourceRef: sourceRefFor(group.subject),\n179\t    })),\n180\t  ]);\n181\t\n182\t  const queued = [...groups.values()].map((group) => {\n183\t    const item = enqueue(ctx, {\n184\t      owner: WORK_KIND_REGISTRY[group.kind].owner,\n185\t      kind: group.kind,\n186\t      sourceRef: sourceRefFor(group.subject),\n187\t      sourceVersion: group.maxSourceVersion + 1,\n188\t      forms: group.forms,\n189\t    });\n190\t    return { workItemId: item.workItemId, kind: group.kind };\n191\t  });\n192\t\n193\t  return { cleared, dropped, queued, superseded };\n194\t}\n195\t\n196\t// Edit's close path: clear-and-requeue for the full chain above (and\n197\t// including) the edited message, inside the mutation's ambient transaction.\n198\texport function cascadeFromMessage(\n199\t  ctx: OperationContext,\n200\t  messageId: string,\n201\t): CascadeOutcome {\n202\t  return runCascade(ctx, [], chainSubjects(ctx.db, messageId));\n203\t}\n204\t\n205\t// Message delete's close path (Flow 6): the deleted message's own forms\n206\t// drop; its turn and chunk clear and re-queue for minus-one composition.\n207\t// The message-delete validation refuses turn-initiating prompts, so the turn\n208\t// always keeps members and never empties through this path.\n209\texport function cascadeMessageDelete(\n210\t  ctx: OperationContext,\n211\t  messageId: string,\n212\t): CascadeOutcome {\n213\t  const [own, ...upward] = chainSubjects(ctx.db, messageId);\n214\t  return runCascade(ctx, own === undefined ? [] : [own], upward);\n215\t}\n216\t\n217\t// Turn delete's close path (Flow 6): the turn's forms and every live\n218\t// member's forms drop — the drop-set walk goes down as well as up — and the\n219\t// containing chunk clears and re-queues from its remaining live members.\n220\t// A chunk left empty drops its summary forms instead: nothing remains to\n221\t// summarize, so the forms are removed, never failed, and no rebuild queues\n222\t// (AC-6.6). Runs after the delete stamps land, so the live-member count\n223\t// already excludes the deleted turn. Membership rows are untouched —\n224\t// shrink-only: reads filter deleted turns; boundaries never re-cut.\n225\texport function cascadeTurnDelete(\n226\t  ctx: OperationContext,\n227\t  turnId: string,\n228\t  memberMessageIds: readonly string[],\n229\t): CascadeOutcome {\n230\t  const drop: ChainSubject[] = [\n231\t    ...memberMessageIds.map((messageId): ChainSubject => ({\n232\t      subjectKind: \"message\",\n233\t      subjectId: messageId,\n234\t    })),\n235\t    { subjectKind: \"turn\", subjectId: turnId },\n236\t  ];\n237\t  const chunkRow = ctx.db\n238\t    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n239\t    .get(turnId) as unknown as { chunk_id: string } | undefined;\n240\t  if (chunkRow === undefined) return runCascade(ctx, drop, []);\n241\t  const chunk: ChainSubject = { subjectKind: \"chunk\", subjectId: chunkRow.chunk_id };\n242\t  const remaining = ctx.db\n243\t    .prepare(\n244\t      `SELECT COUNT(*) AS n FROM chunk_member cm\n245\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n246\t       WHERE cm.chunk_id = ?`,\n247\t    )\n248\t    .get(chunkRow.chunk_id) as unknown as { n: number | bigint };\n249\t  return Number(remaining.n) > 0\n250\t    ? runCascade(ctx, drop, [chunk])\n251\t    : runCascade(ctx, [...drop, chunk], []);\n252\t}\n253\t"}]},"parent_tool_use_id":null,"session_id":"95041db0-678c-4668-af35-a470e7c7fb38","uuid":"57d20fb0-72ac-424e-a77f-0a6bc72fcffc","timestamp":"2026-06-11T09:00:30.110Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/cascade.ts","content":"// The mutation cascade (DD-8, Flows 5/6): walk the derivation chain upward\n// from the mutated subject — the message's own forms, its turn's rendering\n// and projection, the containing chunk's two summaries — clearing each to\n// `pending` at the next source version and enqueueing replacement work, all\n// inside the caller's mutation transaction. The clear-set is derived from\n// the record's structure (the message → turn → chunk walk over the rows that\n// actually exist), never from a hardcoded form list: a future form on any\n// subject in the chain cascades without this module changing. Still-queued\n// old-version items are supersede-deleted (tech design issue 1) and reported\n// on the MutationResult; claimed items are deliberately left to the\n// source-version check (DD-3) — their stale completions discard. The two\n// close paths share one core walk parameterized drop-vs-clear: edit clears\n// the whole chain, delete *drops* the deleted subject's own forms (state\n// rows removed — a deleted source has nothing to rebuild) and clears\n// everything upward for minus-one composition. Turn delete enters at the\n// turn level, dropping the turn's and all live members' forms; a chunk left\n// with no live members drops its summary forms too — dropped, never failed,\n// and no rebuild queued (AC-6.6).\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { OperationContext } from \"../../../shared/context.js\";\nimport type { FormKind, SubjectKind } from \"../../../shared/derivation.js\";\nimport {\n  enqueue,\n  supersedeQueued,\n  WORK_KIND_REGISTRY,\n  type EnqueueFormTarget,\n  type WorkKind,\n  type WorkSourceRef,\n} from \"../../../tech-utils/work-queue/index.js\";\n\n// Each form's rebuild queue-site — the owning domains' enqueue mappings,\n// gathered here because the cascade is the one place that re-queues across\n// the whole chain (module responsibility matrix: replacement enqueues for\n// all three mutations live with the cascade). Both turn forms ride the one\n// turn_derivation item; every other form rides its same-named kind.\nconst FORM_REBUILD_KINDS: Record<FormKind, WorkKind> = {\n  smoothed_prompt: \"prompt_smoothing\",\n  tool_call_summary: \"tool_call_summary\",\n  tool_result_summary: \"tool_result_summary\",\n  turn_rendering: \"turn_derivation\",\n  lower_band_projection: \"turn_derivation\",\n  chunk_summary_detailed: \"chunk_summary_detailed\",\n  chunk_summary_brief: \"chunk_summary_brief\",\n};\n\nexport interface CascadeClear {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n}\n\nexport interface CascadeOutcome {\n  cleared: CascadeClear[];\n  dropped: CascadeClear[];\n  queued: Array<{ workItemId: string; kind: WorkKind }>;\n  superseded: string[];\n}\n\ninterface ChainSubject {\n  subjectKind: SubjectKind;\n  subjectId: string;\n}\n\nfunction sourceRefFor(subject: ChainSubject): WorkSourceRef {\n  switch (subject.subjectKind) {\n    case \"message\":\n      return { messageId: subject.subjectId };\n    case \"turn\":\n      return { turnId: subject.subjectId };\n    case \"chunk\":\n      return { chunkId: subject.subjectId };\n  }\n}\n\n// The structural walk: the mutated message's turn from its membership stamp,\n// the turn's chunk from its placement row. Either link may be absent — a gap\n// message has no turn, an unplaced turn no chunk — and the chain simply\n// stops there; reach is structural, not configured. Deliberately unfiltered:\n// the walk runs after a delete stamps its subject, and the chain above a\n// just-deleted record is exactly what must still cascade.\nfunction chainSubjects(db: DatabaseSync, messageId: string): ChainSubject[] {\n  const subjects: ChainSubject[] = [{ subjectKind: \"message\", subjectId: messageId }];\n  const turnRow = db\n    .prepare(`SELECT turn_id FROM message WHERE message_id = ?`)\n    .get(messageId) as unknown as { turn_id: string | null } | undefined;\n  const turnId = turnRow?.turn_id ?? null;\n  if (turnId === null) return subjects;\n  subjects.push({ subjectKind: \"turn\", subjectId: turnId });\n  const chunkRow = db\n    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n    .get(turnId) as unknown as { chunk_id: string } | undefined;\n  if (chunkRow !== undefined) {\n    subjects.push({ subjectKind: \"chunk\", subjectId: chunkRow.chunk_id });\n  }\n  return subjects;\n}\n\ninterface RebuildGroup {\n  subject: ChainSubject;\n  kind: WorkKind;\n  forms: EnqueueFormTarget[];\n  maxSourceVersion: number;\n}\n\nfunction rebuildKindFor(form: string): WorkKind {\n  const kind = FORM_REBUILD_KINDS[form as FormKind];\n  if (kind === undefined) {\n    // Every form names its queue site above; a miss is a wiring bug.\n    throw new Error(`no rebuild work kind mapped for derived form ${form}`);\n  }\n  return kind;\n}\n\n// The shared core (DD-8's one cascade, parameterized): drop subjects lose\n// their form rows outright; clear subjects go pending at the next source\n// version with replacement work enqueued. Supersede-deletes land before the\n// replacement enqueues so a tidied id can never collide, and queued items\n// against dropped subjects are tidied with no replacement — dead work for a\n// source that no longer reads.\nfunction runCascade(\n  ctx: OperationContext,\n  dropSubjects: readonly ChainSubject[],\n  clearSubjects: readonly ChainSubject[],\n): CascadeOutcome {\n  const readForms = ctx.db.prepare(\n    `SELECT form, source_version FROM derived_form\n     WHERE subject_kind = ? AND subject_id = ? ORDER BY form`,\n  );\n\n  const dropped: CascadeClear[] = [];\n  const supersedeTargets: Array<{ kind: WorkKind; sourceRef: WorkSourceRef }> = [];\n  const dropRows = ctx.db.prepare(\n    `DELETE FROM derived_form WHERE subject_kind = ? AND subject_id = ?`,\n  );\n  for (const subject of dropSubjects) {\n    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n      form: string;\n    }>;\n    const kinds = new Set<WorkKind>();\n    for (const row of rows) {\n      dropped.push({ ...subject, form: row.form as FormKind });\n      kinds.add(rebuildKindFor(row.form));\n    }\n    for (const kind of kinds) {\n      supersedeTargets.push({ kind, sourceRef: sourceRefFor(subject) });\n    }\n    dropRows.run(subject.subjectKind, subject.subjectId);\n  }\n\n  const cleared: CascadeClear[] = [];\n  const groups = new Map<string, RebuildGroup>();\n  for (const subject of clearSubjects) {\n    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n      form: string;\n      source_version: number | bigint;\n    }>;\n    for (const row of rows) {\n      const form = row.form as FormKind;\n      cleared.push({ ...subject, form });\n      const kind = rebuildKindFor(row.form);\n      const key = `${subject.subjectKind}:${subject.subjectId}:${kind}`;\n      const group = groups.get(key) ?? {\n        subject,\n        kind,\n        forms: [],\n        maxSourceVersion: 0,\n      };\n      group.forms.push({ subjectKind: subject.subjectKind, subjectId: subject.subjectId, form });\n      group.maxSourceVersion = Math.max(group.maxSourceVersion, Number(row.source_version));\n      groups.set(key, group);\n    }\n  }\n\n  const superseded = supersedeQueued(ctx.db, [\n    ...supersedeTargets,\n    ...[...groups.values()].map((group) => ({\n      kind: group.kind,\n      sourceRef: sourceRefFor(group.subject),\n    })),\n  ]);\n\n  const queued = [...groups.values()].map((group) => {\n    const item = enqueue(ctx, {\n      owner: WORK_KIND_REGISTRY[group.kind].owner,\n      kind: group.kind,\n      sourceRef: sourceRefFor(group.subject),\n      sourceVersion: group.maxSourceVersion + 1,\n      forms: group.forms,\n    });\n    return { workItemId: item.workItemId, kind: group.kind };\n  });\n\n  return { cleared, dropped, queued, superseded };\n}\n\n// Edit's close path: clear-and-requeue for the full chain above (and\n// including) the edited message, inside the mutation's ambient transaction.\nexport function cascadeFromMessage(\n  ctx: OperationContext,\n  messageId: string,\n): CascadeOutcome {\n  return runCascade(ctx, [], chainSubjects(ctx.db, messageId));\n}\n\n// Message delete's close path (Flow 6): the deleted message's own forms\n// drop; its turn and chunk clear and re-queue for minus-one composition.\n// The message-delete validation refuses turn-initiating prompts, so the turn\n// always keeps members and never empties through this path.\nexport function cascadeMessageDelete(\n  ctx: OperationContext,\n  messageId: string,\n): CascadeOutcome {\n  const [own, ...upward] = chainSubjects(ctx.db, messageId);\n  return runCascade(ctx, own === undefined ? [] : [own], upward);\n}\n\n// Turn delete's close path (Flow 6): the turn's forms and every live\n// member's forms drop — the drop-set walk goes down as well as up — and the\n// containing chunk clears and re-queues from its remaining live members.\n// A chunk left empty drops its summary forms instead: nothing remains to\n// summarize, so the forms are removed, never failed, and no rebuild queues\n// (AC-6.6). Runs after the delete stamps land, so the live-member count\n// already excludes the deleted turn. Membership rows are untouched —\n// shrink-only: reads filter deleted turns; boundaries never re-cut.\nexport function cascadeTurnDelete(\n  ctx: OperationContext,\n  turnId: string,\n  memberMessageIds: readonly string[],\n): CascadeOutcome {\n  const drop: ChainSubject[] = [\n    ...memberMessageIds.map((messageId): ChainSubject => ({\n      subjectKind: \"message\",\n      subjectId: messageId,\n    })),\n    { subjectKind: \"turn\", subjectId: turnId },\n  ];\n  const chunkRow = ctx.db\n    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n    .get(turnId) as unknown as { chunk_id: string } | undefined;\n  if (chunkRow === undefined) return runCascade(ctx, drop, []);\n  const chunk: ChainSubject = { subjectKind: \"chunk\", subjectId: chunkRow.chunk_id };\n  const remaining = ctx.db\n    .prepare(\n      `SELECT COUNT(*) AS n FROM chunk_member cm\n       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n       WHERE cm.chunk_id = ?`,\n    )\n    .get(chunkRow.chunk_id) as unknown as { n: number | bigint };\n  return Number(remaining.n) > 0\n    ? runCascade(ctx, drop, [chunk])\n    : runCascade(ctx, [...drop, chunk], []);\n}\n","numLines":253,"startLine":1,"totalLines":253}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018WFwuCzF5HoLL96DrUM7tJ","type":"tool_result","content":"1\t// Mechanical ToolOutcome stamping (AC-2.4): the outcome on a tool-activity\n2\t// summary is a pure function of the record — paired-result presence and its\n3\t// isError flag — and nothing else. The signature takes no provider text on\n4\t// purpose (anti-shim: the violation is unrepresentable); the handler stamps\n5\t// the returned value into derived_form.metadata, apart from provider prose.\n6\timport type { ToolOutcome } from \"../../../shared/derivation.js\";\n7\t\n8\texport function deriveToolOutcome(\n9\t  pairedResult: { isError: boolean } | undefined,\n10\t): ToolOutcome {\n11\t  if (pairedResult === undefined) return \"unknown\";\n12\t  return pairedResult.isError ? \"failed\" : \"succeeded\";\n13\t}\n14\t"}]},"parent_tool_use_id":null,"session_id":"95041db0-678c-4668-af35-a470e7c7fb38","uuid":"4dd23f3c-43bd-4634-875c-b1308606f10a","timestamp":"2026-06-11T09:10:27.495Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/outcome.ts","content":"// Mechanical ToolOutcome stamping (AC-2.4): the outcome on a tool-activity\n// summary is a pure function of the record — paired-result presence and its\n// isError flag — and nothing else. The signature takes no provider text on\n// purpose (anti-shim: the violation is unrepresentable); the handler stamps\n// the returned value into derived_form.metadata, apart from provider prose.\nimport type { ToolOutcome } from \"../../../shared/derivation.js\";\n\nexport function deriveToolOutcome(\n  pairedResult: { isError: boolean } | undefined,\n): ToolOutcome {\n  if (pairedResult === undefined) return \"unknown\";\n  return pairedResult.isError ? \"failed\" : \"succeeded\";\n}\n","numLines":14,"startLine":1,"totalLines":14}}}

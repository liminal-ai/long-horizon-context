{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01S2S7y1mLzXabYf4Se5fNzz","type":"tool_result","content":"56\tasync function send(\n57\t  sdk: Lhc,\n58\t  filePath: string,\n59\t  batch: readonly MessageEventInput[],\n60\t): Promise<void> {\n61\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n62\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n63\t}\n64\t\n65\tfunction manualSdk(\n66\t  double: ProviderDouble,\n67\t  overrides: {\n68\t    clock?: () => Date;\n69\t    retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n70\t  } = {},\n71\t): Lhc {\n72\t  const sdk = createSdk({\n73\t    provider: double,\n74\t    mode: \"manual\",\n75\t    clock: overrides.clock ?? (() => new Date()),\n76\t    retry: overrides.retry ?? { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n77\t    lease: { durationMs: 200 },\n78\t  });\n79\t  registerTestWorkHandlers(sdk, double);\n80\t  return sdk;\n81\t}\n82\t\n83\tasync function drain(\n84\t  sdk: Lhc,\n85\t  filePath: string,\n86\t  opts?: { maxItems?: number },\n87\t): Promise<DrainReport> {\n88\t  const result = await sdk.work.drain({ filePath }, opts);\n89\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n90\t  return result.value;\n91\t}\n92\t\n93\tfunction liveCount(filePath: string): number {\n94\t  const db = openRaw(filePath);\n95\t  try {\n96\t    return countLiveItems(db);\n97\t  } finally {\n98\t    db.close();\n99\t  }\n100\t}\n101\t\n102\tfunction liveDetail(filePath: string): ReturnType<typeof queueDetail> {\n103\t  const db = openRaw(filePath);\n104\t  try {\n105\t    return queueDetail(db);\n106\t  } finally {\n107\t    db.close();\n108\t  }\n109\t}\n110\t\n111\tdescribe(\"TC-1.1: a drain runs queued items one at a time, in queue order, and reports each disposition\", () => {\n112\t  // Epic 02 Story 2 (sanctioned amendment): tool_call now queues\n113\t  // tool_call_summary, so this batch yields four items, not three.\n114\t  it(\"four items across both owners run in order; rows are deleted at terminal transition; derivedAt is monotone\", async () => {\n115\t    const double = createProviderDouble();\n116\t    let tick = 0;\n117\t    const base = Date.parse(\"2026-06-10T12:00:00.000Z\");\n118\t    const sdk = manualSdk(double, { clock: () => new Date(base + 1000 * tick++) });\n119\t    const { filePath } = await newThread();\n120\t    await send(sdk, filePath, [\n121\t      validEvent(\"user_prompt\"),\n122\t      validEvent(\"tool_call\"),\n123\t      validEvent(\"tool_result\"),\n124\t      validEvent(\"turn_end\"),\n125\t    ]);\n126\t    expect(liveCount(filePath)).toBe(4);\n127\t\n128\t    const report = await drain(sdk, filePath);\n129\t    // Queue order across owners: m1's smoothing, m2's call summary, m3's\n130\t    // result summary, then the turn derivation queued at close — never\n131\t    // reordered.\n132\t    expect(report.ran.map((entry) => entry.workItemId)).toEqual([\n133\t      \"w-m1-prompt_smoothing-v1\",\n134\t      \"w-m2-tool_call_summary-v1\",\n135\t      \"w-m3-tool_result_summary-v1\",\n136\t      \"w-t1-turn_derivation-v1\",\n137\t    ]);\n138\t    expect(report.ran.map((entry) => entry.disposition)).toEqual([\n139\t      \"done\",\n140\t      \"done\",\n141\t      \"done\",\n142\t      \"done\",\n143\t    ]);\n144\t    expect(report.stoppedBecause).toBe(\"empty\");\n145\t    expect(report.remaining).toBe(0);\n146\t\n147\t    // DD-1 storage contract: terminal rows are gone — the report is the only\n148\t    // place the dispositions exist (raw zero-row read).\n149\t    expect(liveCount(filePath)).toBe(0);\n150\t    const db = openRaw(filePath);\n151\t    try {\n152\t      const rows = db.prepare(\"SELECT COUNT(*) AS n FROM work_item\").get() as {\n153\t        n: number | bigint;\n154\t      };\n155\t      expect(Number(rows.n)).toBe(0);\n156\t    } finally {\n157\t      db.close();\n158\t    }\n159\t\n160\t    // Artifacts landed in run order: derivedAt strictly monotone with the\n161\t    // injected clock from m1 to m3 to the turn's forms.\n162\t    const forms = readDerivedForms(filePath);\n163\t    expect(forms.map((form) => form.state)).toEqual([\n164\t      \"ready\",\n165\t      \"ready\",\n166\t      \"ready\",\n167\t      \"ready\",\n168\t      \"ready\",\n169\t    ]);\n170\t    const at = (subjectId: string, form: string): number => {\n171\t      const row = forms.find((f) => f.subjectId === subjectId && f.form === form);\n172\t      if (row?.derivedAt === undefined) throw new Error(`no derivedAt for ${subjectId}/${form}`);\n173\t      return Date.parse(row.derivedAt);\n174\t    };\n175\t    expect(at(\"m1\", \"smoothed_prompt\")).toBeLessThan(at(\"m3\", \"tool_result_summary\"));\n176\t    expect(at(\"m3\", \"tool_result_summary\")).toBeLessThan(at(\"t1\", \"turn_rendering\"));\n177\t    expect(at(\"t1\", \"turn_rendering\")).toBe(at(\"t1\", \"lower_band_projection\"));\n178\t  });\n179\t});\n180\t\n181\tdescribe(\"TC-1.2 / AC-1.2: mid-drain queueing coalesces into at most one further pass\", () => {\n182\t  it(\"a burst of two more batches during a slow in-flight drain yields exactly two passes and all artifacts\", async () => {\n183\t    const double = createProviderDouble();\n184\t    double.delayKind(\"prompt_smoothing\", 100);\n185\t    const sdk = createSdk({"}]},"parent_tool_use_id":null,"session_id":"95041db0-678c-4668-af35-a470e7c7fb38","uuid":"476ee549-2646-45a0-8ae0-0c836abf622f","timestamp":"2026-06-11T08:52:02.708Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/work-execution.test.ts","content":"async function send(\n  sdk: Lhc,\n  filePath: string,\n  batch: readonly MessageEventInput[],\n): Promise<void> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n}\n\nfunction manualSdk(\n  double: ProviderDouble,\n  overrides: {\n    clock?: () => Date;\n    retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n  } = {},\n): Lhc {\n  const sdk = createSdk({\n    provider: double,\n    mode: \"manual\",\n    clock: overrides.clock ?? (() => new Date()),\n    retry: overrides.retry ?? { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    lease: { durationMs: 200 },\n  });\n  registerTestWorkHandlers(sdk, double);\n  return sdk;\n}\n\nasync function drain(\n  sdk: Lhc,\n  filePath: string,\n  opts?: { maxItems?: number },\n): Promise<DrainReport> {\n  const result = await sdk.work.drain({ filePath }, opts);\n  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n  return result.value;\n}\n\nfunction liveCount(filePath: string): number {\n  const db = openRaw(filePath);\n  try {\n    return countLiveItems(db);\n  } finally {\n    db.close();\n  }\n}\n\nfunction liveDetail(filePath: string): ReturnType<typeof queueDetail> {\n  const db = openRaw(filePath);\n  try {\n    return queueDetail(db);\n  } finally {\n    db.close();\n  }\n}\n\ndescribe(\"TC-1.1: a drain runs queued items one at a time, in queue order, and reports each disposition\", () => {\n  // Epic 02 Story 2 (sanctioned amendment): tool_call now queues\n  // tool_call_summary, so this batch yields four items, not three.\n  it(\"four items across both owners run in order; rows are deleted at terminal transition; derivedAt is monotone\", async () => {\n    const double = createProviderDouble();\n    let tick = 0;\n    const base = Date.parse(\"2026-06-10T12:00:00.000Z\");\n    const sdk = manualSdk(double, { clock: () => new Date(base + 1000 * tick++) });\n    const { filePath } = await newThread();\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\"),\n      validEvent(\"tool_call\"),\n      validEvent(\"tool_result\"),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(liveCount(filePath)).toBe(4);\n\n    const report = await drain(sdk, filePath);\n    // Queue order across owners: m1's smoothing, m2's call summary, m3's\n    // result summary, then the turn derivation queued at close — never\n    // reordered.\n    expect(report.ran.map((entry) => entry.workItemId)).toEqual([\n      \"w-m1-prompt_smoothing-v1\",\n      \"w-m2-tool_call_summary-v1\",\n      \"w-m3-tool_result_summary-v1\",\n      \"w-t1-turn_derivation-v1\",\n    ]);\n    expect(report.ran.map((entry) => entry.disposition)).toEqual([\n      \"done\",\n      \"done\",\n      \"done\",\n      \"done\",\n    ]);\n    expect(report.stoppedBecause).toBe(\"empty\");\n    expect(report.remaining).toBe(0);\n\n    // DD-1 storage contract: terminal rows are gone — the report is the only\n    // place the dispositions exist (raw zero-row read).\n    expect(liveCount(filePath)).toBe(0);\n    const db = openRaw(filePath);\n    try {\n      const rows = db.prepare(\"SELECT COUNT(*) AS n FROM work_item\").get() as {\n        n: number | bigint;\n      };\n      expect(Number(rows.n)).toBe(0);\n    } finally {\n      db.close();\n    }\n\n    // Artifacts landed in run order: derivedAt strictly monotone with the\n    // injected clock from m1 to m3 to the turn's forms.\n    const forms = readDerivedForms(filePath);\n    expect(forms.map((form) => form.state)).toEqual([\n      \"ready\",\n      \"ready\",\n      \"ready\",\n      \"ready\",\n      \"ready\",\n    ]);\n    const at = (subjectId: string, form: string): number => {\n      const row = forms.find((f) => f.subjectId === subjectId && f.form === form);\n      if (row?.derivedAt === undefined) throw new Error(`no derivedAt for ${subjectId}/${form}`);\n      return Date.parse(row.derivedAt);\n    };\n    expect(at(\"m1\", \"smoothed_prompt\")).toBeLessThan(at(\"m3\", \"tool_result_summary\"));\n    expect(at(\"m3\", \"tool_result_summary\")).toBeLessThan(at(\"t1\", \"turn_rendering\"));\n    expect(at(\"t1\", \"turn_rendering\")).toBe(at(\"t1\", \"lower_band_projection\"));\n  });\n});\n\ndescribe(\"TC-1.2 / AC-1.2: mid-drain queueing coalesces into at most one further pass\", () => {\n  it(\"a burst of two more batches during a slow in-flight drain yields exactly two passes and all artifacts\", async () => {\n    const double = createProviderDouble();\n    double.delayKind(\"prompt_smoothing\", 100);\n    const sdk = createSdk({","numLines":130,"startLine":56,"totalLines":463}}}

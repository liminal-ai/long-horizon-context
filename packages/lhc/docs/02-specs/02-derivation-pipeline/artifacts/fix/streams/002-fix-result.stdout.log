{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CC362m6kMb3w7L4EzotmD6","type":"tool_result","content":"125\t}\n126\t\n127\t// One closed turn carrying a full tool run — m1 prompt, m2 tool_call,\n128\t// m3 tool_result, m4 assistant_text — drained ready. Under the default\n129\t// chunk policy t1's chunk stays open, so no chunk summary rows exist.\n130\tasync function toolRunThread(sdk: Lhc): Promise<string> {\n131\t  const filePath = await newThread();\n132\t  await send(sdk, filePath, [\n133\t    validEvent(\"user_prompt\", { payload: { text: \"use the tool\" } }),\n134\t    validEvent(\"tool_call\"),\n135\t    validEvent(\"tool_result\"),\n136\t    validEvent(\"assistant_text\", { payload: { text: \"tool run done\" } }),\n137\t    validEvent(\"turn_end\"),\n138\t  ]);\n139\t  await drain(sdk, filePath);\n140\t  return filePath;\n141\t}\n142\t\n143\t// Scripted lower-band projections of a fixed size, every other operation on\n144\t// the deterministic double — the TC-3.6 pattern for exact chunk membership.\n145\tconst PROJ = \"alpha bravo charlie delta echo foxtrot golf hotel india juliet\";\n146\tfunction withScriptedProjections(base: DerivationProvider): DerivationProvider {\n147\t  return {\n148\t    smoothPrompt: (i) => base.smoothPrompt(i),\n149\t    summarizeToolCall: (i) => base.summarizeToolCall(i),\n150\t    summarizeToolResult: (i) => base.summarizeToolResult(i),\n151\t    composeTurnRendering: (i) => base.composeTurnRendering(i),\n152\t    projectLowerBand: (): Promise<ProviderResult> =>\n153\t      Promise.resolve({ ok: true, text: PROJ }),\n154\t    summarizeChunkDetailed: (i) => base.summarizeChunkDetailed(i),\n155\t    summarizeChunkBrief: (i) => base.summarizeChunkBrief(i),\n156\t  };\n157\t}\n158\t\n159\t// Prompt+answer turns sized so chunks close at exactly two members:\n160\t// target 2·per+1 means the third turn's placement closes the chunk holding\n161\t// the first two (TC-3.6's golden case, reused as this story's fixture).\n162\tfunction twoTurnChunkSdk(double: DerivationProvider): Lhc {\n163\t  const per = estimateTokens(PROJ);\n164\t  return manualSdk(withScriptedProjections(double), {\n165\t    chunkPolicy: { targetProjectedTokens: 2 * per + 1, maxProjectedTokens: 100 * per },\n166\t  });\n167\t}\n168\t\n169\tasync function sendPromptTurn(sdk: Lhc, filePath: string, n: number): Promise<void> {\n170\t  await send(sdk, filePath, [\n171\t    validEvent(\"user_prompt\", { payload: { text: `prompt ${n}` } }),\n172\t    validEvent(\"assistant_text\", { payload: { text: `answer ${n}` } }),\n173\t    validEvent(\"turn_end\"),\n174\t  ]);\n175\t}\n176\t\n177\tdescribe(\"TC-6.1 / AC-6.1: a deleted message leaves reads and membership; its events remain\", () => {\n178\t  it(\"deleting a tool-result message removes it from message reads and turn membership, not from event read-back\", async () => {\n179\t    const double = createProviderDouble();\n180\t    const sdk = manualSdk(double);\n181\t    const filePath = await toolRunThread(sdk);\n182\t    const eventsBefore = unwrap(await intakeStream.listEvents({ filePath }));\n183\t\n184\t    const result = await messages.deleteMessage({ filePath }, { messageId: \"m3\" });\n185\t    expect(result.ok).toBe(true);\n186\t    if (!result.ok) return;\n187\t    expect(result.value.changed).toEqual({ messageIds: [\"m3\"], turnIds: [] });\n188\t\n189\t    // Message reads exclude the deleted record.\n190\t    const records = unwrap(await messages.listMessages({ filePath }));\n191\t    expect(records.map((record) => record.messageId)).toEqual([\"m1\", \"m2\", \"m4\"]);\n192\t\n193\t    // Turn membership shrinks in place — the turn row and its boundaries\n194\t    // untouched, the deleted member filtered out.\n195\t    const turnRecords = unwrap(await turns.listTurns({ filePath }));\n196\t    expect(turnRecords).toHaveLength(1);\n197\t    expect(turnRecords[0]?.memberMessageIds).toEqual([\"m1\", \"m2\", \"m4\"]);\n198\t\n199\t    // The audit surface is deliberately unfiltered: every source event,\n200\t    // byte-identical, including the deleted message's.\n201\t    expect(unwrap(await intakeStream.listEvents({ filePath }))).toEqual(eventsBefore);\n202\t    expect(eventsBefore.some((event) => event.eventKind === \"tool_result\")).toBe(true);\n203\t  });\n204\t});\n205\t\n206\tdescribe(\"TC-6.2 / AC-6.2 (architecture risk): delete drops own forms, re-queues upward, stops at the chunk\", () => {\n207\t  it(\"the deleted message's forms are gone, its turn and chunk re-queue, chunk 2 is byte-stable\", async () => {\n208\t    const double = createProviderDouble();\n209\t    // max=1: every turn forms its own immediately closed chunk — two\n210\t    // chunks, both with summaries (the TC-5.2 reach fixture).\n211\t    const sdk = manualSdk(double, {\n212\t      chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 1 },\n213\t    });\n214\t    const filePath = await newThread();\n215\t    await send(sdk, filePath, [\n216\t      validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n217\t      validEvent(\"tool_call\"),\n218\t      validEvent(\"tool_result\"),\n219\t      validEvent(\"assistant_text\", { payload: { text: \"first answer\" } }),\n220\t      validEvent(\"turn_end\"),\n221\t    ]);\n222\t    await send(sdk, filePath, [\n223\t      validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n224\t      validEvent(\"assistant_text\", { payload: { text: \"second answer\" } }),\n225\t      validEvent(\"turn_end\"),\n226\t    ]);\n227\t    await drain(sdk, filePath);\n228\t    const before = readDerivedForms(filePath);\n229\t    expect(before.every((form) => form.state === \"ready\")).toBe(true);\n230\t\n231\t    const result = await messages.deleteMessage({ filePath }, { messageId: \"m3\" });\n232\t    expect(result.ok).toBe(true);\n233\t    if (!result.ok) return;\n234\t\n235\t    // The subject's own forms drop; the chain above clears — and nothing\n236\t    // outside the chain is named.\n237\t    expect(result.value.dropped.map(clearKey)).toEqual([\"message/m3/tool_result_summary\"]);\n238\t    expect(result.value.cleared.map(clearKey).sort()).toEqual(\n239\t      [\n240\t        \"turn/t1/lower_band_projection\",\n241\t        \"turn/t1/turn_rendering\",\n242\t        \"chunk/c1/chunk_summary_brief\",\n243\t        \"chunk/c1/chunk_summary_detailed\",\n244\t      ].sort(),\n245\t    );\n246\t    expect(result.value.queued.map((item) => item.workItemId).sort()).toEqual([\n247\t      \"w-c1-chunk_summary_brief-v2\",\n248\t      \"w-c1-chunk_summary_detailed-v2\",\n249\t      \"w-t1-turn_derivation-v2\",\n250\t    ]);\n251\t\n252\t    // Dropped means rows removed — no ghost row in any state.\n253\t    const after = readDerivedForms(filePath);\n254\t    expect(after.some((form) => form.subjectId === \"m3\")).toBe(false);"}]},"parent_tool_use_id":null,"session_id":"95041db0-678c-4668-af35-a470e7c7fb38","uuid":"6b9e7d34-cdc4-4ecd-b491-147b26d1c2d0","timestamp":"2026-06-11T09:02:12.311Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/mutations-delete.test.ts","content":"}\n\n// One closed turn carrying a full tool run — m1 prompt, m2 tool_call,\n// m3 tool_result, m4 assistant_text — drained ready. Under the default\n// chunk policy t1's chunk stays open, so no chunk summary rows exist.\nasync function toolRunThread(sdk: Lhc): Promise<string> {\n  const filePath = await newThread();\n  await send(sdk, filePath, [\n    validEvent(\"user_prompt\", { payload: { text: \"use the tool\" } }),\n    validEvent(\"tool_call\"),\n    validEvent(\"tool_result\"),\n    validEvent(\"assistant_text\", { payload: { text: \"tool run done\" } }),\n    validEvent(\"turn_end\"),\n  ]);\n  await drain(sdk, filePath);\n  return filePath;\n}\n\n// Scripted lower-band projections of a fixed size, every other operation on\n// the deterministic double — the TC-3.6 pattern for exact chunk membership.\nconst PROJ = \"alpha bravo charlie delta echo foxtrot golf hotel india juliet\";\nfunction withScriptedProjections(base: DerivationProvider): DerivationProvider {\n  return {\n    smoothPrompt: (i) => base.smoothPrompt(i),\n    summarizeToolCall: (i) => base.summarizeToolCall(i),\n    summarizeToolResult: (i) => base.summarizeToolResult(i),\n    composeTurnRendering: (i) => base.composeTurnRendering(i),\n    projectLowerBand: (): Promise<ProviderResult> =>\n      Promise.resolve({ ok: true, text: PROJ }),\n    summarizeChunkDetailed: (i) => base.summarizeChunkDetailed(i),\n    summarizeChunkBrief: (i) => base.summarizeChunkBrief(i),\n  };\n}\n\n// Prompt+answer turns sized so chunks close at exactly two members:\n// target 2·per+1 means the third turn's placement closes the chunk holding\n// the first two (TC-3.6's golden case, reused as this story's fixture).\nfunction twoTurnChunkSdk(double: DerivationProvider): Lhc {\n  const per = estimateTokens(PROJ);\n  return manualSdk(withScriptedProjections(double), {\n    chunkPolicy: { targetProjectedTokens: 2 * per + 1, maxProjectedTokens: 100 * per },\n  });\n}\n\nasync function sendPromptTurn(sdk: Lhc, filePath: string, n: number): Promise<void> {\n  await send(sdk, filePath, [\n    validEvent(\"user_prompt\", { payload: { text: `prompt ${n}` } }),\n    validEvent(\"assistant_text\", { payload: { text: `answer ${n}` } }),\n    validEvent(\"turn_end\"),\n  ]);\n}\n\ndescribe(\"TC-6.1 / AC-6.1: a deleted message leaves reads and membership; its events remain\", () => {\n  it(\"deleting a tool-result message removes it from message reads and turn membership, not from event read-back\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await toolRunThread(sdk);\n    const eventsBefore = unwrap(await intakeStream.listEvents({ filePath }));\n\n    const result = await messages.deleteMessage({ filePath }, { messageId: \"m3\" });\n    expect(result.ok).toBe(true);\n    if (!result.ok) return;\n    expect(result.value.changed).toEqual({ messageIds: [\"m3\"], turnIds: [] });\n\n    // Message reads exclude the deleted record.\n    const records = unwrap(await messages.listMessages({ filePath }));\n    expect(records.map((record) => record.messageId)).toEqual([\"m1\", \"m2\", \"m4\"]);\n\n    // Turn membership shrinks in place — the turn row and its boundaries\n    // untouched, the deleted member filtered out.\n    const turnRecords = unwrap(await turns.listTurns({ filePath }));\n    expect(turnRecords).toHaveLength(1);\n    expect(turnRecords[0]?.memberMessageIds).toEqual([\"m1\", \"m2\", \"m4\"]);\n\n    // The audit surface is deliberately unfiltered: every source event,\n    // byte-identical, including the deleted message's.\n    expect(unwrap(await intakeStream.listEvents({ filePath }))).toEqual(eventsBefore);\n    expect(eventsBefore.some((event) => event.eventKind === \"tool_result\")).toBe(true);\n  });\n});\n\ndescribe(\"TC-6.2 / AC-6.2 (architecture risk): delete drops own forms, re-queues upward, stops at the chunk\", () => {\n  it(\"the deleted message's forms are gone, its turn and chunk re-queue, chunk 2 is byte-stable\", async () => {\n    const double = createProviderDouble();\n    // max=1: every turn forms its own immediately closed chunk — two\n    // chunks, both with summaries (the TC-5.2 reach fixture).\n    const sdk = manualSdk(double, {\n      chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 1 },\n    });\n    const filePath = await newThread();\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n      validEvent(\"tool_call\"),\n      validEvent(\"tool_result\"),\n      validEvent(\"assistant_text\", { payload: { text: \"first answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"second answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    await drain(sdk, filePath);\n    const before = readDerivedForms(filePath);\n    expect(before.every((form) => form.state === \"ready\")).toBe(true);\n\n    const result = await messages.deleteMessage({ filePath }, { messageId: \"m3\" });\n    expect(result.ok).toBe(true);\n    if (!result.ok) return;\n\n    // The subject's own forms drop; the chain above clears — and nothing\n    // outside the chain is named.\n    expect(result.value.dropped.map(clearKey)).toEqual([\"message/m3/tool_result_summary\"]);\n    expect(result.value.cleared.map(clearKey).sort()).toEqual(\n      [\n        \"turn/t1/lower_band_projection\",\n        \"turn/t1/turn_rendering\",\n        \"chunk/c1/chunk_summary_brief\",\n        \"chunk/c1/chunk_summary_detailed\",\n      ].sort(),\n    );\n    expect(result.value.queued.map((item) => item.workItemId).sort()).toEqual([\n      \"w-c1-chunk_summary_brief-v2\",\n      \"w-c1-chunk_summary_detailed-v2\",\n      \"w-t1-turn_derivation-v2\",\n    ]);\n\n    // Dropped means rows removed — no ghost row in any state.\n    const after = readDerivedForms(filePath);\n    expect(after.some((form) => form.subjectId === \"m3\")).toBe(false);","numLines":130,"startLine":125,"totalLines":604}}}

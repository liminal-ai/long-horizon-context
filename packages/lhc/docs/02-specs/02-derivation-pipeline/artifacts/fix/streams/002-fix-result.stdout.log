h: string, db: DatabaseSync) => void;"," let threadTouch: ThreadTouch | null = null;"," "]},{"oldStart":70,"oldLines":7,"newStart":79,"newLines":29,"lines":["   threadTouch = touch;"," }"," ","+// The poke target for a context built now: the running SDK's seam if one is","+// in scope, else the below-SDK default (null-safe). Captured onto ctx.poke so","+// the enqueue carries its target rather than reading a shared slot at fire","+// time — except, deliberately, through the default fallback for direct calls.","+export function resolveInstancePoke(): (threadId: string) => void {","+  const seam = seamStore.getStore();","+  if (seam !== undefined) return seam.poke;","+  return (threadId) => {","+    schedulerPoke?.(threadId);","+  };","+}","+","+// Thread-file open announcement (DD-10): openThreadDatabase fires this on","+// every open, before any caller transaction begins. Delivers to the SDK seam","+// in scope if any (background → first-touch catch-up; manual → no-op), else","+// the below-SDK default. The background scheduler learns threadId→filePath","+// and runs the first-touch catch-up off this seam."," export function fireThreadTouch(filePath: string, db: DatabaseSync): void {","+  const seam = seamStore.getStore();","+  if (seam !== undefined) {","+    seam.touch(filePath, db);","+    return;","+  }","   threadTouch?.(filePath, db);"," }"," "]}],"userModified":false,"replaceAll":false}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0117tMHfVLCNn7f2DcvpQ8BC","type":"tool_result","content":"556\t    const sdk = manualSdk(double);\n557\t    const filePath = await newThread();\n558\t    await send(sdk, filePath, [\n559\t      validEvent(\"user_prompt\", { payload: { text: \"the prompt\" } }),\n560\t      validEvent(\"assistant_text\", { payload: { text: \"answer one\" } }),\n561\t      validEvent(\"assistant_text\", { payload: { text: \"answer two\" } }),\n562\t      validEvent(\"turn_end\"),\n563\t    ]);\n564\t    await drain(sdk, filePath);\n565\t    expect((await messages.deleteMessage({ filePath }, { messageId: \"m2\" })).ok).toBe(true);\n566\t\n567\t    const result = await turns.deleteTurn({ filePath }, { turnId: \"t1\" });\n568\t    expect(result.ok).toBe(true);\n569\t    if (!result.ok) return;\n570\t    // Only the still-live members are stamped now; the earlier delete\n571\t    // already removed m2 and dropped its forms.\n572\t    expect(result.value.changed).toEqual({ messageIds: [\"m1\", \"m3\"], turnIds: [\"t1\"] });\n573\t    expect(unwrap(await messages.listMessages({ filePath }))).toEqual([]);\n574\t    expect(unwrap(await turns.listTurns({ filePath }))).toEqual([]);\n575\t  });\n576\t});\n577\t\n578\tdescribe(\"background mode: delete-and-walk-away (production path)\", () => {\n579\t  it(\"the cascade's enqueue pokes ride the commit; the minus-one rebuild runs with no further call\", async () => {\n580\t    const double = createProviderDouble();\n581\t    const sdk = manualSdk(double, { mode: \"background\" });\n582\t    const filePath = await newThread();\n583\t    await send(sdk, filePath, [\n584\t      validEvent(\"user_prompt\", { payload: { text: \"the prompt\" } }),\n585\t      validEvent(\"tool_call\"),\n586\t      validEvent(\"tool_result\"),\n587\t      validEvent(\"turn_end\"),\n588\t    ]);\n589\t    await sdk.drainSettled({ filePath });\n590\t    expect(readDerivedForms(filePath).every((form) => form.state === \"ready\")).toBe(true);\n591\t\n592\t    const result = await messages.deleteMessage({ filePath }, { messageId: \"m3\" });\n593\t    expect(result.ok).toBe(true);\n594\t    await sdk.drainSettled({ filePath });\n595\t\n596\t    const turnForms = readDerivedForms(filePath).filter((form) => form.subjectId === \"t1\");\n597\t    expect(turnForms).toHaveLength(2);\n598\t    expect(turnForms.every((form) => form.state === \"ready\" && form.sourceVersion === 2)).toBe(\n599\t      true,\n600\t    );\n601\t    expect(rawDetail(filePath)).toEqual([]);\n602\t  });\n603\t});\n604\t"}]},"parent_tool_use_id":null,"session_id":"95041db0-678c-4668-af35-a470e7c7fb38","uuid":"db128824-8e14-40ae-bd10-11c8b25e91a1","timestamp":"2026-06-11T09:04:57.253Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/mutations-delete.test.ts","content":"    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"the prompt\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"answer one\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"answer two\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    await drain(sdk, filePath);\n    expect((await messages.deleteMessage({ filePath }, { messageId: \"m2\" })).ok).toBe(true);\n\n    const result = await turns.deleteTurn({ filePath }, { turnId: \"t1\" });\n    expect(result.ok).toBe(true);\n    if (!result.ok) return;\n    // Only the still-live members are stamped now; the earlier delete\n    // already removed m2 and dropped its forms.\n    expect(result.value.changed).toEqual({ messageIds: [\"m1\", \"m3\"], turnIds: [\"t1\"] });\n    expect(unwrap(await messages.listMessages({ filePath }))).toEqual([]);\n    expect(unwrap(await turns.listTurns({ filePath }))).toEqual([]);\n  });\n});\n\ndescribe(\"background mode: delete-and-walk-away (production path)\", () => {\n  it(\"the cascade's enqueue pokes ride the commit; the minus-one rebuild runs with no further call\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double, { mode: \"background\" });\n    const filePath = await newThread();\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"the prompt\" } }),\n      validEvent(\"tool_call\"),\n      validEvent(\"tool_result\"),\n      validEvent(\"turn_end\"),\n    ]);\n    await sdk.drainSettled({ filePath });\n    expect(readDerivedForms(filePath).every((form) => form.state === \"ready\")).toBe(true);\n\n    const result = await messages.deleteMessage({ filePath }, { messageId: \"m3\" });\n    expect(result.ok).toBe(true);\n    await sdk.drainSettled({ filePath });\n\n    const turnForms = readDerivedForms(filePath).filter((form) => form.subjectId === \"t1\");\n    expect(turnForms).toHaveLength(2);\n    expect(turnForms.every((form) => form.state === \"ready\" && form.sourceVersion === 2)).toBe(\n      true,\n    );\n    expect(rawDetail(filePath)).toEqual([]);\n  });\n});\n","numLines":49,"startLine":556,"totalLines":604}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015VptMLkaJdfXHnC7hxKiJt","type":"tool_result","content":"1\t// Story 1 (Epic 02): queue execution and drain — Flow 1, in-process half.\n2\t// Claim/lease mechanics, queue-order dispatch, retry/backoff with the\n3\t// head-gates-queue rule, terminal dispositions (reported then deleted, DD-1),\n4\t// unknown-kind handling, both host modes, and coalesced background\n5\t// scheduling. The cross-process legs (TC-1.3 kill, TC-1.4 claim exclusion,\n6\t// CLI parity) live in cli-process-work.test.ts.\n7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n8\timport {\n9\t  countLiveItems,\n10\t  createSdk,\n11\t  intakeStream,\n12\t  queueDetail,\n13\t  setSchedulerPoke,\n14\t  setThreadTouch,\n15\t  threads,\n16\t  type DrainReport,\n17\t  type Lhc,\n18\t  type MessageEventInput,\n19\t} from \"../src/index.js\";\n20\timport {\n21\t  createProviderDouble,\n22\t  openRaw,\n23\t  readDerivedForms,\n24\t  registerTestWorkHandlers,\n25\t  tempStore,\n26\t  validEvent,\n27\t  type TempStore,\n28\t  type ProviderDouble,\n29\t} from \"./fixtures/index.js\";\n30\t\n31\tfunction sleep(ms: number): Promise<void> {\n32\t  return new Promise((resolve) => setTimeout(resolve, ms));\n33\t}\n34\t\n35\tlet store: TempStore;\n36\tbeforeEach(() => {\n37\t  store = tempStore();\n38\t});\n39\tafterEach(() => {\n40\t  // Background-mode SDKs install process-wide seams at construction; tests\n41\t  // must not leak them into each other.\n42\t  setSchedulerPoke(null);\n43\t  setThreadTouch(null);\n44\t  store.cleanup();\n45\t});\n46\t\n47\tasync function newThread(): Promise<{ threadId: string; filePath: string }> {\n48\t  const created = await threads.newThread({\n49\t    filePath: store.threadPath(),\n50\t    registryPath: store.registryPath,\n51\t  });\n52\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n53\t  return created.value;\n54\t}\n55\t\n56\tasync function send(\n57\t  sdk: Lhc,\n58\t  filePath: string,\n59\t  batch: readonly MessageEventInput[],\n60\t): Promise<void> {"}]},"parent_tool_use_id":null,"session_id":"95041db0-678c-4668-af35-a470e7c7fb38","uuid":"27bb4fa3-01f5-4f97-86c5-ad10d040fa05","timestamp":"2026-06-11T08:51:56.616Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/work-execution.test.ts","content":"// Story 1 (Epic 02): queue execution and drain — Flow 1, in-process half.\n// Claim/lease mechanics, queue-order dispatch, retry/backoff with the\n// head-gates-queue rule, terminal dispositions (reported then deleted, DD-1),\n// unknown-kind handling, both host modes, and coalesced background\n// scheduling. The cross-process legs (TC-1.3 kill, TC-1.4 claim exclusion,\n// CLI parity) live in cli-process-work.test.ts.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  countLiveItems,\n  createSdk,\n  intakeStream,\n  queueDetail,\n  setSchedulerPoke,\n  setThreadTouch,\n  threads,\n  type DrainReport,\n  type Lhc,\n  type MessageEventInput,\n} from \"../src/index.js\";\nimport {\n  createProviderDouble,\n  openRaw,\n  readDerivedForms,\n  registerTestWorkHandlers,\n  tempStore,\n  validEvent,\n  type TempStore,\n  type ProviderDouble,\n} from \"./fixtures/index.js\";\n\nfunction sleep(ms: number): Promise<void> {\n  return new Promise((resolve) => setTimeout(resolve, ms));\n}\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  // Background-mode SDKs install process-wide seams at construction; tests\n  // must not leak them into each other.\n  setSchedulerPoke(null);\n  setThreadTouch(null);\n  store.cleanup();\n});\n\nasync function newThread(): Promise<{ threadId: string; filePath: string }> {\n  const created = await threads.newThread({\n    filePath: store.threadPath(),\n    registryPath: store.registryPath,\n  });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n  return created.value;\n}\n\nasync function send(\n  sdk: Lhc,\n  filePath: string,\n  batch: readonly MessageEventInput[],\n): Promise<void> {","numLines":60,"startLine":1,"totalLines":463}}}

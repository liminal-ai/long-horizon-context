{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01971GhcVdQyhrYWVfJcJadp","type":"tool_result","content":"1\t// Story 3 (Epic 02): turn composition and chunk formation — Flow 3. The\n2\t// turn_derivation handler composing from message forms with recorded\n3\t// fallback gaps (TC-3.2), the no-auto-cascade rule (TC-3.3, architecture\n4\t// risk), outcome-explicit tool-run accounts (TC-3.4), placement in the\n5\t// completion transaction (TC-3.5), the accumulated close policy's golden\n6\t// cases (TC-3.6/3.7, architecture risk), the two summary kinds with\n7\t// independent lifecycles (TC-3.8), and determinism under replay (TC-3.9,\n8\t// architecture risk). Every drain dispatches the production handlers\n9\t// registered by the turns domain at createSdk; the TC-3.3/TC-3.8 re-queues\n10\t// drive the queue util directly per the story note (the public re-queue\n11\t// surface is Story 4's).\n12\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n13\timport {\n14\t  countLiveItems,\n15\t  createSdk,\n16\t  deterministicText,\n17\t  enqueue,\n18\t  estimateTokens,\n19\t  runInTransaction,\n20\t  threads,\n21\t  type BatchResult,\n22\t  type DerivationProvider,\n23\t  type DrainReport,\n24\t  type EnqueueInput,\n25\t  type Lhc,\n26\t  type MessageEventInput,\n27\t  type ProviderResult,\n28\t  type RenderingPart,\n29\t  type SdkConfig,\n30\t} from \"../src/index.js\";\n31\timport {\n32\t  createProviderDouble,\n33\t  openRaw,\n34\t  readChunks,\n35\t  readDerivedForms,\n36\t  tempStore,\n37\t  validEvent,\n38\t  type TempStore,\n39\t} from \"./fixtures/index.js\";\n40\t\n41\tlet store: TempStore;\n42\tbeforeEach(() => {\n43\t  store = tempStore();\n44\t});\n45\tafterEach(() => {\n46\t  store.cleanup();\n47\t});\n48\t\n49\tasync function newThread(): Promise<string> {\n50\t  const created = await threads.newThread({\n51\t    filePath: store.threadPath(),\n52\t    registryPath: store.registryPath,\n53\t  });\n54\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n55\t  return created.value.filePath;\n56\t}\n57\t\n58\tfunction manualSdk(\n59\t  provider: DerivationProvider,\n60\t  chunkPolicy?: SdkConfig[\"chunkPolicy\"],\n61\t): Lhc {\n62\t  const config: SdkConfig = {\n63\t    provider,\n64\t    mode: \"manual\",\n65\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n66\t    lease: { durationMs: 200 },\n67\t  };\n68\t  if (chunkPolicy !== undefined) config.chunkPolicy = chunkPolicy;\n69\t  return createSdk(config);\n70\t}\n71\t\n72\tasync function send(\n73\t  sdk: Lhc,\n74\t  filePath: string,\n75\t  batch: readonly MessageEventInput[],\n76\t): Promise<BatchResult> {\n77\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n78\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n79\t  return result.value;\n80\t}\n81\t\n82\tasync function drain(sdk: Lhc, filePath: string): Promise<DrainReport> {\n83\t  const result = await sdk.work.drain({ filePath });\n84\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n85\t  return result.value;\n86\t}\n87\t\n88\t// One closed prompt+answer turn through real intake.\n89\tasync function sendTurn(\n90\t  sdk: Lhc,\n91\t  filePath: string,\n92\t  prompt: string,\n93\t  answer: string,\n94\t): Promise<void> {\n95\t  await send(sdk, filePath, [\n96\t    validEvent(\"user_prompt\", { payload: { text: prompt } }),\n97\t    validEvent(\"assistant_text\", { payload: { text: answer } }),\n98\t    validEvent(\"turn_end\"),\n99\t  ]);\n100\t}\n101\t\n102\tfunction formOf(filePath: string, subjectId: string, form: string) {\n103\t  return readDerivedForms(filePath).find(\n104\t    (f) => f.subjectId === subjectId && f.form === form,\n105\t  );\n106\t}\n107\t\n108\tfunction liveCount(filePath: string): number {\n109\t  const db = openRaw(filePath);\n110\t  try {\n111\t    return countLiveItems(db);\n112\t  } finally {\n113\t    db.close();\n114\t  }\n115\t}\n116\t\n117\t// The story-sanctioned re-queue path for TC-3.3/TC-3.8: the Story 1 queue\n118\t// util driven directly inside a real transaction (the public re-queue\n119\t// operation with refusal/idempotency semantics is Story 4's surface).\n120\tfunction requeueDirect(filePath: string, input: EnqueueInput): void {\n121\t  const db = openRaw(filePath);\n122\t  try {\n123\t    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as {\n124\t      thread_id: string;\n125\t    };\n126\t    runInTransaction(db, () => new Date(), row.thread_id, (ctx) => enqueue(ctx, input));\n127\t  } finally {\n128\t    db.close();\n129\t  }\n130\t}\n131\t\n132\t// A provider that delegates to the deterministic double except for scripted\n133\t// lower-band projections — the seam tests use to pin projected token counts\n134\t// for the placement golden cases (the projection content is what placement\n135\t// arithmetic measures, exactly once, at landing).\n136\tfunction withScriptedProjections(\n137\t  base: DerivationProvider,\n138\t  next: () => string,\n139\t): DerivationProvider {\n140\t  return {\n141\t    smoothPrompt: (i) => base.smoothPrompt(i),\n142\t    summarizeToolCall: (i) => base.summarizeToolCall(i),\n143\t    summarizeToolResult: (i) => base.summarizeToolResult(i),\n144\t    composeTurnRendering: (i) => base.composeTurnRendering(i),\n145\t    projectLowerBand: (): Promise<ProviderResult> =>\n146\t      Promise.resolve({ ok: true, text: next() }),\n147\t    summarizeChunkDetailed: (i) => base.summarizeChunkDetailed(i),\n148\t    summarizeChunkBrief: (i) => base.summarizeChunkBrief(i),\n149\t  };\n150\t}\n151\t\n152\tdescribe(\"TC-3.1 / AC-3.1: a closed turn lands a rendering and a lower-band projection as independent rows\", () => {\n153\t  it(\"all message forms ready → both turn forms ready, composed from the forms, each its own state row\", async () => {\n154\t    const double = createProviderDouble();\n155\t    const sdk = manualSdk(double);\n156\t    const filePath = await newThread();\n157\t    const prompt = \"compose this turn\";\n158\t    const answer = \"the composed answer\";\n159\t    await sendTurn(sdk, filePath, prompt, answer);\n160\t\n161\t    const report = await drain(sdk, filePath);\n162\t    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n163\t      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n164\t      [\"w-t1-turn_derivation-v1\", \"done\"],\n165\t    ]);\n166\t\n167\t    // Reconstruct the exact composition: the smoothed form verbatim, the\n168\t    // assistant text raw (never had a form) — proof the rendering consumed\n169\t    // forms, not raw re-derivation.\n170\t    const smoothed = deterministicText(\"smoothPrompt\", { text: prompt }, prompt);\n171\t    const parts: RenderingPart[] = [\n172\t      { messageId: \"m1\", kind: \"user_prompt\", text: smoothed, fallback: false },\n173\t      { messageId: \"m2\", kind: \"assistant_text\", text: answer, fallback: false },\n174\t    ];\n175\t    const renderingText = deterministicText(\n176\t      \"composeTurnRendering\",\n177\t      { parts },\n178\t      `${smoothed} | ${answer}`,\n179\t    );\n180\t    const rendering = formOf(filePath, \"t1\", \"turn_rendering\");\n181\t    const projection = formOf(filePath, \"t1\", \"lower_band_projection\");\n182\t    expect(rendering).toMatchObject({\n183\t      subjectKind: \"turn\",\n184\t      state: \"ready\",\n185\t      content: renderingText,\n186\t      sourceVersion: 1,\n187\t    });\n188\t    expect(rendering?.gaps).toBeUndefined();\n189\t    expect(projection).toMatchObject({\n190\t      subjectKind: \"turn\",\n191\t      state: \"ready\",\n192\t      content: deterministicText(\"projectLowerBand\", { rendering: renderingText }, renderingText),\n193\t      sourceVersion: 1,\n194\t    });\n195\t    expect(liveCount(filePath)).toBe(0);\n196\t  });\n197\t});\n198\t\n199\tdescribe(\"TC-3.2 / AC-3.2: a non-ready message form falls back and records a gap; the rendering still lands ready\", () => {\n200\t  it(\"failed smoothing → rendering ready with the raw prompt text and a gap naming message and form\", async () => {\n201\t    const double = createProviderDouble();\n202\t    const sdk = manualSdk(double);\n203\t    const filePath = await newThread();\n204\t    double.failKind(\"prompt_smoothing\", 3, { retryable: true, reason: \"scripted smoothing failure\" });\n205\t    await sendTurn(sdk, filePath, \"raw prompt one\", \"answer text\");\n206\t\n207\t    const report = await drain(sdk, filePath);\n208\t    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n209\t      [\"w-m1-prompt_smoothing-v1\", \"failed_terminal\"],\n210\t      [\"w-t1-turn_derivation-v1\", \"done\"],\n211\t    ]);\n212\t\n213\t    // Message-form gaps degrade the rendering's inputs; they do not fail\n214\t    // the turn: ready, raw text composed, the gap a recorded fact.\n215\t    const rendering = formOf(filePath, \"t1\", \"turn_rendering\");\n216\t    expect(rendering?.state).toBe(\"ready\");\n217\t    expect(rendering?.content).toContain(\"raw prompt one\");\n218\t    expect(rendering?.gaps).toEqual([\n219\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n220\t    ]);\n221\t    expect(formOf(filePath, \"t1\", \"lower_band_projection\")?.state).toBe(\"ready\");\n222\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")?.state).toBe(\"failed\");\n223\t  });\n224\t});\n225\t\n226\tdescribe(\"TC-3.3 / AC-3.3 (architecture risk): gaps stand after dependency repair; only an explicit rebuild clears them\", () => {\n227\t  it(\"repairing the smoothing changes nothing; re-queueing the rendering rebuilds it without the gap at the next source version\", async () => {\n228\t    const double = createProviderDouble();\n229\t    const sdk = manualSdk(double);\n230\t    const filePath = await newThread();\n231\t    double.failKind(\"prompt_smoothing\", 3, { retryable: true, reason: \"scripted smoothing failure\" });\n232\t    await sendTurn(sdk, filePath, \"gapped prompt\", \"gapped answer\");\n233\t    await drain(sdk, filePath);\n234\t    const gapped = formOf(filePath, \"t1\", \"turn_rendering\");\n235\t    expect(gapped?.state).toBe(\"ready\");\n236\t    expect(gapped?.gaps).toEqual([\n237\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n238\t    ]);\n239\t    const placedBefore = readChunks(filePath);\n240\t\n241\t    // Leg 1: repair the failed smoothing through the queue util (now\n242\t    // healthy — the script above is consumed). The dependent must not move:\n243\t    // no live link, no auto-cascade, no queued turn work.\n244\t    requeueDirect(filePath, {\n245\t      owner: \"messages\",\n246\t      kind: \"prompt_smoothing\",\n247\t      sourceRef: { messageId: \"m1\" },\n248\t      forms: [{ subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" }],\n249\t    });\n250\t    const repairReport = await drain(sdk, filePath);\n251\t    expect(repairReport.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n252\t      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n253\t    ]);\n254\t    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")?.state).toBe(\"ready\");\n255\t    // Byte-for-byte: the gapped rendering is exactly the row that landed —\n256\t    // content, gaps, derivedAt, source version, all of it.\n257\t    expect(formOf(filePath, \"t1\", \"turn_rendering\")).toEqual(gapped);\n258\t    expect(liveCount(filePath)).toBe(0);\n259\t\n260\t    // Leg 2: the explicit rebuild — turn_derivation re-queued at the next\n261\t    // source version through the queue util. Gaps recompute from current\n262\t    // dependency states: the smoothing is ready now, so the gap clears.\n263\t    requeueDirect(filePath, {\n264\t      owner: \"turns\",\n265\t      kind: \"turn_derivation\",\n266\t      sourceRef: { turnId: \"t1\" },\n267\t      sourceVersion: 2,\n268\t      forms: [\n269\t        { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n270\t        { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\" },\n271\t      ],\n272\t    });\n273\t    const rebuildReport = await drain(sdk, filePath);\n274\t    expect(rebuildReport.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n275\t      [\"w-t1-turn_derivation-v2\", \"done\"],\n276\t    ]);\n277\t    const rebuilt = formOf(filePath, \"t1\", \"turn_rendering\");\n278\t    expect(rebuilt?.state).toBe(\"ready\");\n279\t    expect(rebuilt?.sourceVersion).toBe(2);\n280\t    expect(rebuilt?.gaps).toBeUndefined();\n281\t    expect(rebuilt?.content).not.toBe(gapped?.content);\n282\t    // Rebuild keeps placement: membership is never re-cut by derivation —\n283\t    // the turn sits exactly where its first placement put it.\n284\t    expect(readChunks(filePath)).toEqual(placedBefore);\n285\t  });\n286\t});\n287\t\n288\tdescribe(\"TC-3.4 / AC-3.4: tool runs compose as outcome-explicit accounts; a state-changing call's outcome survives\", () => {\n289\t  it(\"a three-call edit run with one isError carries per-call outcomes into the composition input, from the forms\", async () => {\n290\t    const double = createProviderDouble();\n291\t    const captured = double.captureInputs();\n292\t    const sdk = manualSdk(double);\n293\t    const filePath = await newThread();\n294\t    const call = (id: string, path: string) =>\n295\t      validEvent(\"tool_call\", {\n296\t        payload: { toolCallId: id, toolName: \"edit_file\", arguments: { path } },\n297\t      });\n298\t    const result = (id: string, content: string, isError: boolean) =>\n299\t      validEvent(\"tool_result\", { payload: { toolCallId: id, content, isError } });\n300\t    await send(sdk, filePath, [\n301\t      validEvent(\"user_prompt\", { payload: { text: \"edit three files\" } }),\n302\t      call(\"call-a\", \"a.txt\"),\n303\t      result(\"call-a\", \"edited a.txt\", false),\n304\t      call(\"call-b\", \"b.txt\"),\n305\t      result(\"call-b\", \"permission denied\", true),\n306\t      call(\"call-c\", \"c.txt\"),\n307\t      result(\"call-c\", \"edited c.txt\", false),\n308\t      validEvent(\"turn_end\"),\n309\t    ]);\n310\t\n311\t    await drain(sdk, filePath);\n312\t    expect(formOf(filePath, \"t1\", \"turn_rendering\")?.state).toBe(\"ready\");\n313\t\n314\t    const composed = captured.filter((entry) => entry.op === \"composeTurnRendering\");\n315\t    expect(composed).toHaveLength(1);\n316\t    const parts = (composed[0]?.input as { parts: RenderingPart[] }).parts;\n317\t    expect(parts.map((part) => part.messageId)).toEqual([\n318\t      \"m1\", \"m2\", \"m3\", \"m4\", \"m5\", \"m6\", \"m7\",\n319\t    ]);\n320\t    // The run's account is the consecutive tool parts in message order, each\n321\t    // stating its outcome — the failed edit's outcome is present on both\n322\t    // halves of its pair and cannot be lost in composition.\n323\t    expect(parts.map((part) => part.outcome ?? null)).toEqual([\n324\t      null,\n325\t      \"succeeded\", \"succeeded\",\n326\t      \"failed\", \"failed\",\n327\t      \"succeeded\", \"succeeded\",\n328\t    ]);\n329\t    // Composition consumed the ready forms, not the raw record: every tool\n330\t    // part's text is its summary form's stored content, verbatim.\n331\t    for (const part of parts.slice(1)) {\n332\t      expect(part.fallback).toBe(false);\n333\t      expect(part.text).toBe(formOf(filePath, part.messageId, `${part.kind}_summary`)?.content);\n334\t    }\n335\t  });\n336\t});\n337\t\n338\tdescribe(\"TC-3.5 / AC-3.5: placement is recorded with the turn and readable through turns\", () => {\n339\t  it(\"draining a closed turn shows chunkId and memberIdx on the turn read-back\", async () => {\n340\t    const double = createProviderDouble();\n341\t    const sdk = manualSdk(double);\n342\t    const filePath = await newThread();\n343\t    await sendTurn(sdk, filePath, \"place me\", \"placed\");\n344\t\n345\t    await drain(sdk, filePath);\n346\t    const turns = await sdk.turns.listTurns({ filePath });\n347\t    expect(turns.ok).toBe(true);\n348\t    if (!turns.ok) return;\n349\t    expect(turns.value).toEqual([\n350\t      expect.objectContaining({ turnId: \"t1\", status: \"closed\", chunkId: \"c1\", memberIdx: 0 }),\n351\t    ]);\n352\t  });\n353\t});\n354\t\n355\tdescribe(\"TC-3.6 / AC-3.6 (architecture risk): the accumulated close rule — the crossing turn is excluded\", () => {\n356\t  const PROJ = \"alpha bravo charlie delta echo foxtrot golf hotel india juliet\";\n357\t\n358\t  it(\"three turns at ~equal size: the third's placement closes the chunk holding two, and the third opens chunk 2\", async () => {\n359\t    const per = estimateTokens(PROJ);\n360\t    const double = createProviderDouble();\n361\t    const provider = withScriptedProjections(double, () => PROJ);\n362\t    const sdk = manualSdk(provider, {\n363\t      targetProjectedTokens: 2 * per + 1,\n364\t      maxProjectedTokens: 100 * per,\n365\t    });\n366\t    const filePath = await newThread();\n367\t    for (let i = 1; i <= 3; i += 1) await sendTurn(sdk, filePath, `prompt ${i}`, `answer ${i}`);\n368\t\n369\t    await drain(sdk, filePath);\n370\t    const snapshot = readChunks(filePath);\n371\t    expect(snapshot.chunks).toEqual([\n372\t      { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: 2 * per },\n373\t      { chunkId: \"c2\", chunkOrder: 2, status: \"open\", accumulatedProjectedTokens: per },\n374\t    ]);\n375\t    expect(snapshot.members).toEqual([\n376\t      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n377\t      { chunkId: \"c1\", turnId: \"t2\", memberIdx: 1 },\n378\t      { chunkId: \"c2\", turnId: \"t3\", memberIdx: 0 },\n379\t    ]);\n380\t    // The close queued both summary kinds for c1 and the drain ran them;\n381\t    // the still-open c2 has none.\n382\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n383\t    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n384\t    expect(formOf(filePath, \"c2\", \"chunk_summary_detailed\")).toBeUndefined();\n385\t    expect(liveCount(filePath)).toBe(0);\n386\t  });\n387\t\n388\t  it(\"threshold exactness: accumulated + incoming equal to the target closes (inclusive), holding only the prior member\", async () => {\n389\t    const per = estimateTokens(PROJ);\n390\t    const double = createProviderDouble();\n391\t    const provider = withScriptedProjections(double, () => PROJ);\n392\t    const sdk = manualSdk(provider, {\n393\t      targetProjectedTokens: 2 * per,\n394\t      maxProjectedTokens: 100 * per,\n395\t    });\n396\t    const filePath = await newThread();\n397\t    await sendTurn(sdk, filePath, \"first\", \"one\");\n398\t    await sendTurn(sdk, filePath, \"second\", \"two\");\n399\t\n400\t    await drain(sdk, filePath);\n401\t    const snapshot = readChunks(filePath);\n402\t    expect(snapshot.members).toEqual([\n403\t      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n404\t      { chunkId: \"c2\", turnId: \"t2\", memberIdx: 0 },\n405\t    ]);\n406\t    expect(snapshot.chunks.map((chunk) => [chunk.chunkId, chunk.status])).toEqual([\n407\t      [\"c1\", \"closed\"],\n408\t      [\"c2\", \"open\"],\n409\t    ]);\n410\t  });\n411\t});\n412\t\n413\tdescribe(\"TC-3.7 / AC-3.7: a single projection at or above the max forms its own chunk, closed immediately\", () => {\n414\t  const BIG = \"omega \".repeat(120).trim();\n415\t\n416\t  it(\"one oversized turn → its own closed chunk with both summaries derived\", async () => {\n417\t    const big = estimateTokens(BIG);\n418\t    const double = createProviderDouble();\n419\t    const provider = withScriptedProjections(double, () => BIG);\n420\t    const sdk = manualSdk(provider, {\n421\t      targetProjectedTokens: big,\n422\t      maxProjectedTokens: big,\n423\t    });\n424\t    const filePath = await newThread();\n425\t    await sendTurn(sdk, filePath, \"huge turn\", \"huge answer\");\n426\t\n427\t    await drain(sdk, filePath);\n428\t    expect(readChunks(filePath)).toEqual({\n429\t      chunks: [\n430\t        { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: big },\n431\t      ],\n432\t      members: [{ chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 }],\n433\t    });\n434\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n435\t    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n436\t  });\n437\t\n438\t  it(\"an oversized turn arriving behind an open chunk closes both: the open chunk without it, its own chunk with it\", async () => {\n439\t    const SMALL = \"tiny projection text\";\n440\t    const big = estimateTokens(BIG);\n441\t    const projections = [SMALL, BIG];\n442\t    const double = createProviderDouble();\n443\t    const provider = withScriptedProjections(double, () => {\n444\t      const next = projections.shift();\n445\t      if (next === undefined) throw new Error(\"scripted projections exhausted\");\n446\t      return next;\n447\t    });\n448\t    // target = max = big: the small turn sits safely under both; the big\n449\t    // turn's arrival crosses the target (small + big ≥ big) and its own\n450\t    // projection meets the max.\n451\t    const sdk = manualSdk(provider, {\n452\t      targetProjectedTokens: big,\n453\t      maxProjectedTokens: big,\n454\t    });\n455\t    const filePath = await newThread();\n456\t    await sendTurn(sdk, filePath, \"small turn\", \"small answer\");\n457\t    await sendTurn(sdk, filePath, \"huge turn\", \"huge answer\");\n458\t\n459\t    await drain(sdk, filePath);\n460\t    const snapshot = readChunks(filePath);\n461\t    expect(snapshot.chunks.map((chunk) => [chunk.chunkId, chunk.status])).toEqual([\n462\t      [\"c1\", \"closed\"],\n463\t      [\"c2\", \"closed\"],\n464\t    ]);\n465\t    expect(snapshot.members).toEqual([\n466\t      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n467\t      { chunkId: \"c2\", turnId: \"t2\", memberIdx: 0 },\n468\t    ]);\n469\t    for (const chunkId of [\"c1\", \"c2\"]) {\n470\t      expect(formOf(filePath, chunkId, \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n471\t      expect(formOf(filePath, chunkId, \"chunk_summary_brief\")?.state).toBe(\"ready\");\n472\t    }\n473\t  });\n474\t});\n475\t\n476\tdescribe(\"TC-3.8 / AC-3.8: chunk close queues two summary work items with independent lifecycles\", () => {\n477\t  // target=max=1: every turn self-chunks and closes immediately, the\n478\t  // smallest deterministic way to manufacture closed chunks.\n479\t  const SELF_CHUNK = { targetProjectedTokens: 1, maxProjectedTokens: 1 };\n480\t\n481\t  it(\"both summaries land ready as distinct chunk-level forms\", async () => {\n482\t    const double = createProviderDouble();\n483\t    const sdk = manualSdk(double, SELF_CHUNK);\n484\t    const filePath = await newThread();\n485\t    await sendTurn(sdk, filePath, \"summarize me\", \"summarized\");\n486\t\n487\t    const report = await drain(sdk, filePath);\n488\t    expect(report.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n489\t      [\"prompt_smoothing\", \"done\"],\n490\t      [\"turn_derivation\", \"done\"],\n491\t      [\"chunk_summary_detailed\", \"done\"],\n492\t      [\"chunk_summary_brief\", \"done\"],\n493\t    ]);\n494\t    const detailed = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n495\t    const brief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n496\t    expect(detailed?.state).toBe(\"ready\");\n497\t    expect(brief?.state).toBe(\"ready\");\n498\t    // Double-marked content distinguishes the two kinds: each went through\n499\t    // its own provider operation, detailed over projections + receipts,\n500\t    // brief over projections + outcomes (empty here — no tool activity).\n501\t    const memberProjections = [formOf(filePath, \"t1\", \"lower_band_projection\")?.content ?? \"\"];\n502\t    expect(detailed?.content).toBe(\n503\t      deterministicText(\n504\t        \"summarizeChunkDetailed\",\n505\t        { memberProjections, memberReceipts: [[]] },\n506\t        memberProjections.join(\" | \"),\n507\t      ),\n508\t    );\n509\t    expect(brief?.content).toBe(\n510\t      deterministicText(\n511\t        \"summarizeChunkBrief\",\n512\t        { memberProjections, memberOutcomes: [[]] },\n513\t        memberProjections.join(\" | \"),\n514\t      ),\n515\t    );\n516\t    expect(detailed?.content).not.toBe(brief?.content);\n517\t  });\n518\t\n519\t  it(\"detailed preserves the tool-run receipts; brief strips them to outcomes only (SV-3.8-001)\", async () => {\n520\t    const double = createProviderDouble();\n521\t    const captured = double.captureInputs();\n522\t    const sdk = manualSdk(double, SELF_CHUNK);\n523\t    const filePath = await newThread();\n524\t    // The run-receipts fixture: a two-call edit run, one isError, closing\n525\t    // into its own chunk so both summaries derive over it.\n526\t    await send(sdk, filePath, [\n527\t      validEvent(\"user_prompt\", { payload: { text: \"edit two files\" } }),\n528\t      validEvent(\"tool_call\", {\n529\t        payload: { toolCallId: \"rcpt-a\", toolName: \"edit_file\", arguments: { path: \"ok.txt\" } },\n530\t      }),\n531\t      validEvent(\"tool_result\", {\n532\t        payload: { toolCallId: \"rcpt-a\", content: \"edited ok.txt\", isError: false },\n533\t      }),\n534\t      validEvent(\"tool_call\", {\n535\t        payload: { toolCallId: \"rcpt-b\", toolName: \"edit_file\", arguments: { path: \"ro.txt\" } },\n536\t      }),\n537\t      validEvent(\"tool_result\", {\n538\t        payload: { toolCallId: \"rcpt-b\", content: \"read-only file\", isError: true },\n539\t      }),\n540\t      validEvent(\"turn_end\"),\n541\t    ]);\n542\t    await drain(sdk, filePath);\n543\t\n544\t    // The receipts are mechanically stamped on the rendering: account text\n545\t    // = each tool message's ready summary form content, outcome from the\n546\t    // record — the material the detailed summary must preserve.\n547\t    const expectedReceipts = ([\"m2\", \"m3\", \"m4\", \"m5\"] as const).map((messageId, index) => ({\n548\t      messageId,\n549\t      activity: index % 2 === 0 ? \"tool_call\" : \"tool_result\",\n550\t      account: formOf(filePath, messageId, index % 2 === 0 ? \"tool_call_summary\" : \"tool_result_summary\")?.content,\n551\t      outcome: index < 2 ? \"succeeded\" : \"failed\",\n552\t    }));\n553\t    expect(formOf(filePath, \"t1\", \"turn_rendering\")?.metadata?.receipts).toEqual(expectedReceipts);\n554\t\n555\t    // Seam evidence: the detailed call received the full receipts; the\n556\t    // brief call received outcomes only — no receipt account text anywhere\n557\t    // in its input, so brief structurally cannot preserve more than\n558\t    // outcomes.\n559\t    const detailedInput = captured.find((entry) => entry.op === \"summarizeChunkDetailed\")?.input;\n560\t    const briefInput = captured.find((entry) => entry.op === \"summarizeChunkBrief\")?.input;\n561\t    expect((detailedInput as { memberReceipts: unknown }).memberReceipts).toEqual([\n562\t      expectedReceipts,\n563\t    ]);\n564\t    expect(briefInput).toEqual({\n565\t      memberProjections: [formOf(filePath, \"t1\", \"lower_band_projection\")?.content],\n566\t      memberOutcomes: [[\"succeeded\", \"succeeded\", \"failed\", \"failed\"]],\n567\t    });\n568\t    for (const receipt of expectedReceipts) {\n569\t      expect(JSON.stringify(briefInput)).not.toContain(receipt.account as string);\n570\t    }\n571\t\n572\t    // Artifact evidence: the detailed summary carries every receipt's\n573\t    // account and outcome; the brief summary carries the outcomes and none\n574\t    // of the receipt content.\n575\t    const detailed = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n576\t    const brief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n577\t    expect(detailed?.state).toBe(\"ready\");\n578\t    expect(brief?.state).toBe(\"ready\");\n579\t    for (const receipt of expectedReceipts) {\n580\t      expect(detailed?.content).toContain(`${receipt.account as string}=>${receipt.outcome}`);\n581\t    }\n582\t    expect(brief?.content).toContain(\"[outcomes succeeded,succeeded,failed,failed]\");\n583\t    expect(brief?.content).not.toContain(\"toolcall(\");\n584\t    expect(brief?.content).not.toContain(\"toolresult(\");\n585\t  });\n586\t\n587\t  it(\"the brief item fails past budget alone: detailed ready, brief failed, brief re-queueable by itself\", async () => {\n588\t    const double = createProviderDouble();\n589\t    const sdk = manualSdk(double, SELF_CHUNK);\n590\t    const filePath = await newThread();\n591\t    double.failKind(\"chunk_summary_brief\", 3, {\n592\t      retryable: true,\n593\t      reason: \"scripted brief failure\",\n594\t    });\n595\t    await sendTurn(sdk, filePath, \"independent retry\", \"answer\");\n596\t\n597\t    const report = await drain(sdk, filePath);\n598\t    expect(report.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n599\t      [\"prompt_smoothing\", \"done\"],\n600\t      [\"turn_derivation\", \"done\"],\n601\t      [\"chunk_summary_detailed\", \"done\"],\n602\t      [\"chunk_summary_brief\", \"failed_terminal\"],\n603\t    ]);\n604\t    const detailedBefore = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n605\t    expect(detailedBefore?.state).toBe(\"ready\");\n606\t    const failedBrief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n607\t    expect(failedBrief?.state).toBe(\"failed\");\n608\t    expect(failedBrief?.reason).toBe(\"scripted brief failure\");\n609\t\n610\t    // Re-queue the brief alone through the queue util (Story 4 owns the\n611\t    // public surface); the detailed form must not move.\n612\t    requeueDirect(filePath, {\n613\t      owner: \"turns\",\n614\t      kind: \"chunk_summary_brief\",\n615\t      sourceRef: { chunkId: \"c1\" },\n616\t      forms: [{ subjectKind: \"chunk\", subjectId: \"c1\", form: \"chunk_summary_brief\" }],\n617\t    });\n618\t    const requeued = await drain(sdk, filePath);\n619\t    expect(requeued.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n620\t      [\"chunk_summary_brief\", \"done\"],\n621\t    ]);\n622\t    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n623\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")).toEqual(detailedBefore);\n624\t  });\n625\t});\n626\t\n627\tdescribe(\"TC-3.9 / AC-3.9 (architecture risk): chunk boundaries are deterministic under replay\", () => {\n628\t  it(\"the same event stream into a fresh thread re-chunks identically — membership and boundaries deep-equal\", async () => {\n629\t    const policy = { targetProjectedTokens: 60, maxProjectedTokens: 4400 };\n630\t    const turnsContent: Array<[string, string]> = [\n631\t      [\"first prompt about the parser\", \"parser answer with detail\"],\n632\t      [\"second prompt about the cache\", \"cache answer, longer, with extra words\"],\n633\t      [\"third prompt about the index rebuild\", \"index answer\"],\n634\t      [\"fourth prompt, short\", \"fourth answer, also short\"],\n635\t      [\"fifth prompt to push past one chunk\", \"fifth answer closing things out\"],\n636\t    ];\n637\t\n638\t    async function buildAndDrain(): Promise<string> {\n639\t      const double = createProviderDouble();\n640\t      const sdk = manualSdk(double, policy);\n641\t      const filePath = await newThread();\n642\t      for (const [prompt, answer] of turnsContent) await sendTurn(sdk, filePath, prompt, answer);\n643\t      await drain(sdk, filePath);\n644\t      return filePath;\n645\t    }\n646\t\n647\t    const first = await buildAndDrain();\n648\t    const second = await buildAndDrain();\n649\t\n650\t    const firstSnapshot = readChunks(first);\n651\t    expect(firstSnapshot).toEqual(readChunks(second));\n652\t    // The replay claim is only meaningful if the policy actually cut: the\n653\t    // stream must span more than one chunk.\n654\t    expect(firstSnapshot.chunks.length).toBeGreaterThan(1);\n655\t    // No inference joined placement anywhere: the closed chunks' summary\n656\t    // artifacts are byte-identical across the two records too.\n657\t    const summariesOf = (filePath: string) =>\n658\t      readDerivedForms(filePath)\n659\t        .filter((form) => form.subjectKind === \"chunk\")\n660\t        .map((form) => [form.subjectId, form.form, form.state, form.content]);\n661\t    expect(summariesOf(first)).toEqual(summariesOf(second));\n662\t  });\n663\t});\n664\t"}]},"parent_tool_use_id":null,"session_id":"1b388d14-2b35-4b36-8c72-7c338ac5cd77","uuid":"b9ecb278-7469-497a-81b5-a44f1ea251fa","timestamp":"2026-06-11T09:43:21.677Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/derivation-turns.test.ts","content":"// Story 3 (Epic 02): turn composition and chunk formation — Flow 3. The\n// turn_derivation handler composing from message forms with recorded\n// fallback gaps (TC-3.2), the no-auto-cascade rule (TC-3.3, architecture\n// risk), outcome-explicit tool-run accounts (TC-3.4), placement in the\n// completion transaction (TC-3.5), the accumulated close policy's golden\n// cases (TC-3.6/3.7, architecture risk), the two summary kinds with\n// independent lifecycles (TC-3.8), and determinism under replay (TC-3.9,\n// architecture risk). Every drain dispatches the production handlers\n// registered by the turns domain at createSdk; the TC-3.3/TC-3.8 re-queues\n// drive the queue util directly per the story note (the public re-queue\n// surface is Story 4's).\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  countLiveItems,\n  createSdk,\n  deterministicText,\n  enqueue,\n  estimateTokens,\n  runInTransaction,\n  threads,\n  type BatchResult,\n  type DerivationProvider,\n  type DrainReport,\n  type EnqueueInput,\n  type Lhc,\n  type MessageEventInput,\n  type ProviderResult,\n  type RenderingPart,\n  type SdkConfig,\n} from \"../src/index.js\";\nimport {\n  createProviderDouble,\n  openRaw,\n  readChunks,\n  readDerivedForms,\n  tempStore,\n  validEvent,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nasync function newThread(): Promise<string> {\n  const created = await threads.newThread({\n    filePath: store.threadPath(),\n    registryPath: store.registryPath,\n  });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n  return created.value.filePath;\n}\n\nfunction manualSdk(\n  provider: DerivationProvider,\n  chunkPolicy?: SdkConfig[\"chunkPolicy\"],\n): Lhc {\n  const config: SdkConfig = {\n    provider,\n    mode: \"manual\",\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    lease: { durationMs: 200 },\n  };\n  if (chunkPolicy !== undefined) config.chunkPolicy = chunkPolicy;\n  return createSdk(config);\n}\n\nasync function send(\n  sdk: Lhc,\n  filePath: string,\n  batch: readonly MessageEventInput[],\n): Promise<BatchResult> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n  return result.value;\n}\n\nasync function drain(sdk: Lhc, filePath: string): Promise<DrainReport> {\n  const result = await sdk.work.drain({ filePath });\n  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n  return result.value;\n}\n\n// One closed prompt+answer turn through real intake.\nasync function sendTurn(\n  sdk: Lhc,\n  filePath: string,\n  prompt: string,\n  answer: string,\n): Promise<void> {\n  await send(sdk, filePath, [\n    validEvent(\"user_prompt\", { payload: { text: prompt } }),\n    validEvent(\"assistant_text\", { payload: { text: answer } }),\n    validEvent(\"turn_end\"),\n  ]);\n}\n\nfunction formOf(filePath: string, subjectId: string, form: string) {\n  return readDerivedForms(filePath).find(\n    (f) => f.subjectId === subjectId && f.form === form,\n  );\n}\n\nfunction liveCount(filePath: string): number {\n  const db = openRaw(filePath);\n  try {\n    return countLiveItems(db);\n  } finally {\n    db.close();\n  }\n}\n\n// The story-sanctioned re-queue path for TC-3.3/TC-3.8: the Story 1 queue\n// util driven directly inside a real transaction (the public re-queue\n// operation with refusal/idempotency semantics is Story 4's surface).\nfunction requeueDirect(filePath: string, input: EnqueueInput): void {\n  const db = openRaw(filePath);\n  try {\n    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as {\n      thread_id: string;\n    };\n    runInTransaction(db, () => new Date(), row.thread_id, (ctx) => enqueue(ctx, input));\n  } finally {\n    db.close();\n  }\n}\n\n// A provider that delegates to the deterministic double except for scripted\n// lower-band projections — the seam tests use to pin projected token counts\n// for the placement golden cases (the projection content is what placement\n// arithmetic measures, exactly once, at landing).\nfunction withScriptedProjections(\n  base: DerivationProvider,\n  next: () => string,\n): DerivationProvider {\n  return {\n    smoothPrompt: (i) => base.smoothPrompt(i),\n    summarizeToolCall: (i) => base.summarizeToolCall(i),\n    summarizeToolResult: (i) => base.summarizeToolResult(i),\n    composeTurnRendering: (i) => base.composeTurnRendering(i),\n    projectLowerBand: (): Promise<ProviderResult> =>\n      Promise.resolve({ ok: true, text: next() }),\n    summarizeChunkDetailed: (i) => base.summarizeChunkDetailed(i),\n    summarizeChunkBrief: (i) => base.summarizeChunkBrief(i),\n  };\n}\n\ndescribe(\"TC-3.1 / AC-3.1: a closed turn lands a rendering and a lower-band projection as independent rows\", () => {\n  it(\"all message forms ready → both turn forms ready, composed from the forms, each its own state row\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    const prompt = \"compose this turn\";\n    const answer = \"the composed answer\";\n    await sendTurn(sdk, filePath, prompt, answer);\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n      [\"w-t1-turn_derivation-v1\", \"done\"],\n    ]);\n\n    // Reconstruct the exact composition: the smoothed form verbatim, the\n    // assistant text raw (never had a form) — proof the rendering consumed\n    // forms, not raw re-derivation.\n    const smoothed = deterministicText(\"smoothPrompt\", { text: prompt }, prompt);\n    const parts: RenderingPart[] = [\n      { messageId: \"m1\", kind: \"user_prompt\", text: smoothed, fallback: false },\n      { messageId: \"m2\", kind: \"assistant_text\", text: answer, fallback: false },\n    ];\n    const renderingText = deterministicText(\n      \"composeTurnRendering\",\n      { parts },\n      `${smoothed} | ${answer}`,\n    );\n    const rendering = formOf(filePath, \"t1\", \"turn_rendering\");\n    const projection = formOf(filePath, \"t1\", \"lower_band_projection\");\n    expect(rendering).toMatchObject({\n      subjectKind: \"turn\",\n      state: \"ready\",\n      content: renderingText,\n      sourceVersion: 1,\n    });\n    expect(rendering?.gaps).toBeUndefined();\n    expect(projection).toMatchObject({\n      subjectKind: \"turn\",\n      state: \"ready\",\n      content: deterministicText(\"projectLowerBand\", { rendering: renderingText }, renderingText),\n      sourceVersion: 1,\n    });\n    expect(liveCount(filePath)).toBe(0);\n  });\n});\n\ndescribe(\"TC-3.2 / AC-3.2: a non-ready message form falls back and records a gap; the rendering still lands ready\", () => {\n  it(\"failed smoothing → rendering ready with the raw prompt text and a gap naming message and form\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    double.failKind(\"prompt_smoothing\", 3, { retryable: true, reason: \"scripted smoothing failure\" });\n    await sendTurn(sdk, filePath, \"raw prompt one\", \"answer text\");\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n      [\"w-m1-prompt_smoothing-v1\", \"failed_terminal\"],\n      [\"w-t1-turn_derivation-v1\", \"done\"],\n    ]);\n\n    // Message-form gaps degrade the rendering's inputs; they do not fail\n    // the turn: ready, raw text composed, the gap a recorded fact.\n    const rendering = formOf(filePath, \"t1\", \"turn_rendering\");\n    expect(rendering?.state).toBe(\"ready\");\n    expect(rendering?.content).toContain(\"raw prompt one\");\n    expect(rendering?.gaps).toEqual([\n      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n    ]);\n    expect(formOf(filePath, \"t1\", \"lower_band_projection\")?.state).toBe(\"ready\");\n    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")?.state).toBe(\"failed\");\n  });\n});\n\ndescribe(\"TC-3.3 / AC-3.3 (architecture risk): gaps stand after dependency repair; only an explicit rebuild clears them\", () => {\n  it(\"repairing the smoothing changes nothing; re-queueing the rendering rebuilds it without the gap at the next source version\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    double.failKind(\"prompt_smoothing\", 3, { retryable: true, reason: \"scripted smoothing failure\" });\n    await sendTurn(sdk, filePath, \"gapped prompt\", \"gapped answer\");\n    await drain(sdk, filePath);\n    const gapped = formOf(filePath, \"t1\", \"turn_rendering\");\n    expect(gapped?.state).toBe(\"ready\");\n    expect(gapped?.gaps).toEqual([\n      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n    ]);\n    const placedBefore = readChunks(filePath);\n\n    // Leg 1: repair the failed smoothing through the queue util (now\n    // healthy — the script above is consumed). The dependent must not move:\n    // no live link, no auto-cascade, no queued turn work.\n    requeueDirect(filePath, {\n      owner: \"messages\",\n      kind: \"prompt_smoothing\",\n      sourceRef: { messageId: \"m1\" },\n      forms: [{ subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" }],\n    });\n    const repairReport = await drain(sdk, filePath);\n    expect(repairReport.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n    ]);\n    expect(formOf(filePath, \"m1\", \"smoothed_prompt\")?.state).toBe(\"ready\");\n    // Byte-for-byte: the gapped rendering is exactly the row that landed —\n    // content, gaps, derivedAt, source version, all of it.\n    expect(formOf(filePath, \"t1\", \"turn_rendering\")).toEqual(gapped);\n    expect(liveCount(filePath)).toBe(0);\n\n    // Leg 2: the explicit rebuild — turn_derivation re-queued at the next\n    // source version through the queue util. Gaps recompute from current\n    // dependency states: the smoothing is ready now, so the gap clears.\n    requeueDirect(filePath, {\n      owner: \"turns\",\n      kind: \"turn_derivation\",\n      sourceRef: { turnId: \"t1\" },\n      sourceVersion: 2,\n      forms: [\n        { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n        { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\" },\n      ],\n    });\n    const rebuildReport = await drain(sdk, filePath);\n    expect(rebuildReport.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n      [\"w-t1-turn_derivation-v2\", \"done\"],\n    ]);\n    const rebuilt = formOf(filePath, \"t1\", \"turn_rendering\");\n    expect(rebuilt?.state).toBe(\"ready\");\n    expect(rebuilt?.sourceVersion).toBe(2);\n    expect(rebuilt?.gaps).toBeUndefined();\n    expect(rebuilt?.content).not.toBe(gapped?.content);\n    // Rebuild keeps placement: membership is never re-cut by derivation —\n    // the turn sits exactly where its first placement put it.\n    expect(readChunks(filePath)).toEqual(placedBefore);\n  });\n});\n\ndescribe(\"TC-3.4 / AC-3.4: tool runs compose as outcome-explicit accounts; a state-changing call's outcome survives\", () => {\n  it(\"a three-call edit run with one isError carries per-call outcomes into the composition input, from the forms\", async () => {\n    const double = createProviderDouble();\n    const captured = double.captureInputs();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    const call = (id: string, path: string) =>\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: id, toolName: \"edit_file\", arguments: { path } },\n      });\n    const result = (id: string, content: string, isError: boolean) =>\n      validEvent(\"tool_result\", { payload: { toolCallId: id, content, isError } });\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"edit three files\" } }),\n      call(\"call-a\", \"a.txt\"),\n      result(\"call-a\", \"edited a.txt\", false),\n      call(\"call-b\", \"b.txt\"),\n      result(\"call-b\", \"permission denied\", true),\n      call(\"call-c\", \"c.txt\"),\n      result(\"call-c\", \"edited c.txt\", false),\n      validEvent(\"turn_end\"),\n    ]);\n\n    await drain(sdk, filePath);\n    expect(formOf(filePath, \"t1\", \"turn_rendering\")?.state).toBe(\"ready\");\n\n    const composed = captured.filter((entry) => entry.op === \"composeTurnRendering\");\n    expect(composed).toHaveLength(1);\n    const parts = (composed[0]?.input as { parts: RenderingPart[] }).parts;\n    expect(parts.map((part) => part.messageId)).toEqual([\n      \"m1\", \"m2\", \"m3\", \"m4\", \"m5\", \"m6\", \"m7\",\n    ]);\n    // The run's account is the consecutive tool parts in message order, each\n    // stating its outcome — the failed edit's outcome is present on both\n    // halves of its pair and cannot be lost in composition.\n    expect(parts.map((part) => part.outcome ?? null)).toEqual([\n      null,\n      \"succeeded\", \"succeeded\",\n      \"failed\", \"failed\",\n      \"succeeded\", \"succeeded\",\n    ]);\n    // Composition consumed the ready forms, not the raw record: every tool\n    // part's text is its summary form's stored content, verbatim.\n    for (const part of parts.slice(1)) {\n      expect(part.fallback).toBe(false);\n      expect(part.text).toBe(formOf(filePath, part.messageId, `${part.kind}_summary`)?.content);\n    }\n  });\n});\n\ndescribe(\"TC-3.5 / AC-3.5: placement is recorded with the turn and readable through turns\", () => {\n  it(\"draining a closed turn shows chunkId and memberIdx on the turn read-back\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    await sendTurn(sdk, filePath, \"place me\", \"placed\");\n\n    await drain(sdk, filePath);\n    const turns = await sdk.turns.listTurns({ filePath });\n    expect(turns.ok).toBe(true);\n    if (!turns.ok) return;\n    expect(turns.value).toEqual([\n      expect.objectContaining({ turnId: \"t1\", status: \"closed\", chunkId: \"c1\", memberIdx: 0 }),\n    ]);\n  });\n});\n\ndescribe(\"TC-3.6 / AC-3.6 (architecture risk): the accumulated close rule — the crossing turn is excluded\", () => {\n  const PROJ = \"alpha bravo charlie delta echo foxtrot golf hotel india juliet\";\n\n  it(\"three turns at ~equal size: the third's placement closes the chunk holding two, and the third opens chunk 2\", async () => {\n    const per = estimateTokens(PROJ);\n    const double = createProviderDouble();\n    const provider = withScriptedProjections(double, () => PROJ);\n    const sdk = manualSdk(provider, {\n      targetProjectedTokens: 2 * per + 1,\n      maxProjectedTokens: 100 * per,\n    });\n    const filePath = await newThread();\n    for (let i = 1; i <= 3; i += 1) await sendTurn(sdk, filePath, `prompt ${i}`, `answer ${i}`);\n\n    await drain(sdk, filePath);\n    const snapshot = readChunks(filePath);\n    expect(snapshot.chunks).toEqual([\n      { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: 2 * per },\n      { chunkId: \"c2\", chunkOrder: 2, status: \"open\", accumulatedProjectedTokens: per },\n    ]);\n    expect(snapshot.members).toEqual([\n      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n      { chunkId: \"c1\", turnId: \"t2\", memberIdx: 1 },\n      { chunkId: \"c2\", turnId: \"t3\", memberIdx: 0 },\n    ]);\n    // The close queued both summary kinds for c1 and the drain ran them;\n    // the still-open c2 has none.\n    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n    expect(formOf(filePath, \"c2\", \"chunk_summary_detailed\")).toBeUndefined();\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"threshold exactness: accumulated + incoming equal to the target closes (inclusive), holding only the prior member\", async () => {\n    const per = estimateTokens(PROJ);\n    const double = createProviderDouble();\n    const provider = withScriptedProjections(double, () => PROJ);\n    const sdk = manualSdk(provider, {\n      targetProjectedTokens: 2 * per,\n      maxProjectedTokens: 100 * per,\n    });\n    const filePath = await newThread();\n    await sendTurn(sdk, filePath, \"first\", \"one\");\n    await sendTurn(sdk, filePath, \"second\", \"two\");\n\n    await drain(sdk, filePath);\n    const snapshot = readChunks(filePath);\n    expect(snapshot.members).toEqual([\n      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n      { chunkId: \"c2\", turnId: \"t2\", memberIdx: 0 },\n    ]);\n    expect(snapshot.chunks.map((chunk) => [chunk.chunkId, chunk.status])).toEqual([\n      [\"c1\", \"closed\"],\n      [\"c2\", \"open\"],\n    ]);\n  });\n});\n\ndescribe(\"TC-3.7 / AC-3.7: a single projection at or above the max forms its own chunk, closed immediately\", () => {\n  const BIG = \"omega \".repeat(120).trim();\n\n  it(\"one oversized turn → its own closed chunk with both summaries derived\", async () => {\n    const big = estimateTokens(BIG);\n    const double = createProviderDouble();\n    const provider = withScriptedProjections(double, () => BIG);\n    const sdk = manualSdk(provider, {\n      targetProjectedTokens: big,\n      maxProjectedTokens: big,\n    });\n    const filePath = await newThread();\n    await sendTurn(sdk, filePath, \"huge turn\", \"huge answer\");\n\n    await drain(sdk, filePath);\n    expect(readChunks(filePath)).toEqual({\n      chunks: [\n        { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: big },\n      ],\n      members: [{ chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 }],\n    });\n    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n  });\n\n  it(\"an oversized turn arriving behind an open chunk closes both: the open chunk without it, its own chunk with it\", async () => {\n    const SMALL = \"tiny projection text\";\n    const big = estimateTokens(BIG);\n    const projections = [SMALL, BIG];\n    const double = createProviderDouble();\n    const provider = withScriptedProjections(double, () => {\n      const next = projections.shift();\n      if (next === undefined) throw new Error(\"scripted projections exhausted\");\n      return next;\n    });\n    // target = max = big: the small turn sits safely under both; the big\n    // turn's arrival crosses the target (small + big ≥ big) and its own\n    // projection meets the max.\n    const sdk = manualSdk(provider, {\n      targetProjectedTokens: big,\n      maxProjectedTokens: big,\n    });\n    const filePath = await newThread();\n    await sendTurn(sdk, filePath, \"small turn\", \"small answer\");\n    await sendTurn(sdk, filePath, \"huge turn\", \"huge answer\");\n\n    await drain(sdk, filePath);\n    const snapshot = readChunks(filePath);\n    expect(snapshot.chunks.map((chunk) => [chunk.chunkId, chunk.status])).toEqual([\n      [\"c1\", \"closed\"],\n      [\"c2\", \"closed\"],\n    ]);\n    expect(snapshot.members).toEqual([\n      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n      { chunkId: \"c2\", turnId: \"t2\", memberIdx: 0 },\n    ]);\n    for (const chunkId of [\"c1\", \"c2\"]) {\n      expect(formOf(filePath, chunkId, \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n      expect(formOf(filePath, chunkId, \"chunk_summary_brief\")?.state).toBe(\"ready\");\n    }\n  });\n});\n\ndescribe(\"TC-3.8 / AC-3.8: chunk close queues two summary work items with independent lifecycles\", () => {\n  // target=max=1: every turn self-chunks and closes immediately, the\n  // smallest deterministic way to manufacture closed chunks.\n  const SELF_CHUNK = { targetProjectedTokens: 1, maxProjectedTokens: 1 };\n\n  it(\"both summaries land ready as distinct chunk-level forms\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double, SELF_CHUNK);\n    const filePath = await newThread();\n    await sendTurn(sdk, filePath, \"summarize me\", \"summarized\");\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n      [\"prompt_smoothing\", \"done\"],\n      [\"turn_derivation\", \"done\"],\n      [\"chunk_summary_detailed\", \"done\"],\n      [\"chunk_summary_brief\", \"done\"],\n    ]);\n    const detailed = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n    const brief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n    expect(detailed?.state).toBe(\"ready\");\n    expect(brief?.state).toBe(\"ready\");\n    // Double-marked content distinguishes the two kinds: each went through\n    // its own provider operation, detailed over projections + receipts,\n    // brief over projections + outcomes (empty here — no tool activity).\n    const memberProjections = [formOf(filePath, \"t1\", \"lower_band_projection\")?.content ?? \"\"];\n    expect(detailed?.content).toBe(\n      deterministicText(\n        \"summarizeChunkDetailed\",\n        { memberProjections, memberReceipts: [[]] },\n        memberProjections.join(\" | \"),\n      ),\n    );\n    expect(brief?.content).toBe(\n      deterministicText(\n        \"summarizeChunkBrief\",\n        { memberProjections, memberOutcomes: [[]] },\n        memberProjections.join(\" | \"),\n      ),\n    );\n    expect(detailed?.content).not.toBe(brief?.content);\n  });\n\n  it(\"detailed preserves the tool-run receipts; brief strips them to outcomes only (SV-3.8-001)\", async () => {\n    const double = createProviderDouble();\n    const captured = double.captureInputs();\n    const sdk = manualSdk(double, SELF_CHUNK);\n    const filePath = await newThread();\n    // The run-receipts fixture: a two-call edit run, one isError, closing\n    // into its own chunk so both summaries derive over it.\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"edit two files\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"rcpt-a\", toolName: \"edit_file\", arguments: { path: \"ok.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"rcpt-a\", content: \"edited ok.txt\", isError: false },\n      }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"rcpt-b\", toolName: \"edit_file\", arguments: { path: \"ro.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"rcpt-b\", content: \"read-only file\", isError: true },\n      }),\n      validEvent(\"turn_end\"),\n    ]);\n    await drain(sdk, filePath);\n\n    // The receipts are mechanically stamped on the rendering: account text\n    // = each tool message's ready summary form content, outcome from the\n    // record — the material the detailed summary must preserve.\n    const expectedReceipts = ([\"m2\", \"m3\", \"m4\", \"m5\"] as const).map((messageId, index) => ({\n      messageId,\n      activity: index % 2 === 0 ? \"tool_call\" : \"tool_result\",\n      account: formOf(filePath, messageId, index % 2 === 0 ? \"tool_call_summary\" : \"tool_result_summary\")?.content,\n      outcome: index < 2 ? \"succeeded\" : \"failed\",\n    }));\n    expect(formOf(filePath, \"t1\", \"turn_rendering\")?.metadata?.receipts).toEqual(expectedReceipts);\n\n    // Seam evidence: the detailed call received the full receipts; the\n    // brief call received outcomes only — no receipt account text anywhere\n    // in its input, so brief structurally cannot preserve more than\n    // outcomes.\n    const detailedInput = captured.find((entry) => entry.op === \"summarizeChunkDetailed\")?.input;\n    const briefInput = captured.find((entry) => entry.op === \"summarizeChunkBrief\")?.input;\n    expect((detailedInput as { memberReceipts: unknown }).memberReceipts).toEqual([\n      expectedReceipts,\n    ]);\n    expect(briefInput).toEqual({\n      memberProjections: [formOf(filePath, \"t1\", \"lower_band_projection\")?.content],\n      memberOutcomes: [[\"succeeded\", \"succeeded\", \"failed\", \"failed\"]],\n    });\n    for (const receipt of expectedReceipts) {\n      expect(JSON.stringify(briefInput)).not.toContain(receipt.account as string);\n    }\n\n    // Artifact evidence: the detailed summary carries every receipt's\n    // account and outcome; the brief summary carries the outcomes and none\n    // of the receipt content.\n    const detailed = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n    const brief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n    expect(detailed?.state).toBe(\"ready\");\n    expect(brief?.state).toBe(\"ready\");\n    for (const receipt of expectedReceipts) {\n      expect(detailed?.content).toContain(`${receipt.account as string}=>${receipt.outcome}`);\n    }\n    expect(brief?.content).toContain(\"[outcomes succeeded,succeeded,failed,failed]\");\n    expect(brief?.content).not.toContain(\"toolcall(\");\n    expect(brief?.content).not.toContain(\"toolresult(\");\n  });\n\n  it(\"the brief item fails past budget alone: detailed ready, brief failed, brief re-queueable by itself\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double, SELF_CHUNK);\n    const filePath = await newThread();\n    double.failKind(\"chunk_summary_brief\", 3, {\n      retryable: true,\n      reason: \"scripted brief failure\",\n    });\n    await sendTurn(sdk, filePath, \"independent retry\", \"answer\");\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n      [\"prompt_smoothing\", \"done\"],\n      [\"turn_derivation\", \"done\"],\n      [\"chunk_summary_detailed\", \"done\"],\n      [\"chunk_summary_brief\", \"failed_terminal\"],\n    ]);\n    const detailedBefore = formOf(filePath, \"c1\", \"chunk_summary_detailed\");\n    expect(detailedBefore?.state).toBe(\"ready\");\n    const failedBrief = formOf(filePath, \"c1\", \"chunk_summary_brief\");\n    expect(failedBrief?.state).toBe(\"failed\");\n    expect(failedBrief?.reason).toBe(\"scripted brief failure\");\n\n    // Re-queue the brief alone through the queue util (Story 4 owns the\n    // public surface); the detailed form must not move.\n    requeueDirect(filePath, {\n      owner: \"turns\",\n      kind: \"chunk_summary_brief\",\n      sourceRef: { chunkId: \"c1\" },\n      forms: [{ subjectKind: \"chunk\", subjectId: \"c1\", form: \"chunk_summary_brief\" }],\n    });\n    const requeued = await drain(sdk, filePath);\n    expect(requeued.ran.map((entry) => [entry.kind, entry.disposition])).toEqual([\n      [\"chunk_summary_brief\", \"done\"],\n    ]);\n    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")).toEqual(detailedBefore);\n  });\n});\n\ndescribe(\"TC-3.9 / AC-3.9 (architecture risk): chunk boundaries are deterministic under replay\", () => {\n  it(\"the same event stream into a fresh thread re-chunks identically — membership and boundaries deep-equal\", async () => {\n    const policy = { targetProjectedTokens: 60, maxProjectedTokens: 4400 };\n    const turnsContent: Array<[string, string]> = [\n      [\"first prompt about the parser\", \"parser answer with detail\"],\n      [\"second prompt about the cache\", \"cache answer, longer, with extra words\"],\n      [\"third prompt about the index rebuild\", \"index answer\"],\n      [\"fourth prompt, short\", \"fourth answer, also short\"],\n      [\"fifth prompt to push past one chunk\", \"fifth answer closing things out\"],\n    ];\n\n    async function buildAndDrain(): Promise<string> {\n      const double = createProviderDouble();\n      const sdk = manualSdk(double, policy);\n      const filePath = await newThread();\n      for (const [prompt, answer] of turnsContent) await sendTurn(sdk, filePath, prompt, answer);\n      await drain(sdk, filePath);\n      return filePath;\n    }\n\n    const first = await buildAndDrain();\n    const second = await buildAndDrain();\n\n    const firstSnapshot = readChunks(first);\n    expect(firstSnapshot).toEqual(readChunks(second));\n    // The replay claim is only meaningful if the policy actually cut: the\n    // stream must span more than one chunk.\n    expect(firstSnapshot.chunks.length).toBeGreaterThan(1);\n    // No inference joined placement anywhere: the closed chunks' summary\n    // artifacts are byte-identical across the two records too.\n    const summariesOf = (filePath: string) =>\n      readDerivedForms(filePath)\n        .filter((form) => form.subjectKind === \"chunk\")\n        .map((form) => [form.subjectId, form.form, form.state, form.content]);\n    expect(summariesOf(first)).toEqual(summariesOf(second));\n  });\n});\n","numLines":664,"startLine":1,"totalLines":664}}}

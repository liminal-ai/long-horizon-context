{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lfz8TYjDNnoaKAzMgQnDVW","type":"tool_result","content":"1\t// The deterministic provider: marked, input-derived output for every seam\n2\t// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\n3\t// functions of the input. It backs the named-provider registry's\n4\t// \"deterministic\" entry (DD-11) so spawned-CLI tests exercise the production\n5\t// resolution seam, and the test double reuses these helpers so in-process and\n6\t// spawned runs produce byte-identical artifacts. It is selectable only by\n7\t// explicit name — never a production default.\n8\timport type {\n9\t  DerivationProvider,\n10\t  ProviderResult,\n11\t  RenderingPart,\n12\t  ToolOutcome,\n13\t  ToolRunReceipt,\n14\t} from \"../shared/derivation.js\";\n15\t\n16\texport type DeterministicOpName =\n17\t  | \"smoothPrompt\"\n18\t  | \"summarizeToolCall\"\n19\t  | \"summarizeToolResult\"\n20\t  | \"composeTurnRendering\"\n21\t  | \"projectLowerBand\"\n22\t  | \"summarizeChunkDetailed\"\n23\t  | \"summarizeChunkBrief\";\n24\t\n25\texport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\n26\t  smoothPrompt: \"smoothed\",\n27\t  summarizeToolCall: \"toolcall\",\n28\t  summarizeToolResult: \"toolresult\",\n29\t  composeTurnRendering: \"rendering\",\n30\t  projectLowerBand: \"projection\",\n31\t  summarizeChunkDetailed: \"detailed\",\n32\t  summarizeChunkBrief: \"brief\",\n33\t};\n34\t\n35\t// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\n36\t// input-sensitive enough that distinct inputs mark distinct outputs.\n37\texport function deterministicDigest(input: unknown): string {\n38\t  const text = JSON.stringify(input);\n39\t  let hash = 0x811c9dc5;\n40\t  for (let i = 0; i < text.length; i += 1) {\n41\t    hash ^= text.charCodeAt(i);\n42\t    hash = Math.imul(hash, 0x01000193) >>> 0;\n43\t  }\n44\t  return hash.toString(16).padStart(8, \"0\");\n45\t}\n46\t\n47\texport function deterministicText(\n48\t  op: DeterministicOpName,\n49\t  input: unknown,\n50\t  text: string,\n51\t): string {\n52\t  return `${DETERMINISTIC_MARKERS[op]}(${deterministicDigest(input)}:${text.slice(0, 40)})`;\n53\t}\n54\t\n55\tfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\n56\t  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\n57\t}\n58\t\n59\t// The chunk-summary contract made visible in deterministic output (AC-3.8):\n60\t// the detailed summary's artifact carries the members' tool-run receipts —\n61\t// account and outcome — verbatim; the brief summary's carries outcomes\n62\t// only. Pure suffixes over the input fields, shared with the test double so\n63\t// in-process and spawned artifacts stay byte-identical; empty receipt sets\n64\t// add nothing, keeping receipt-less output unchanged.\n65\texport function deterministicReceiptsSuffix(memberReceipts?: ToolRunReceipt[][]): string {\n66\t  const receipts = (memberReceipts ?? []).flat();\n67\t  if (receipts.length === 0) return \"\";\n68\t  return `[receipts ${receipts.map((r) => `${r.account}=>${r.outcome}`).join(\"; \")}]`;\n69\t}\n70\t\n71\texport function deterministicOutcomesSuffix(memberOutcomes?: ToolOutcome[][]): string {\n72\t  const outcomes = (memberOutcomes ?? []).flat();\n73\t  if (outcomes.length === 0) return \"\";\n74\t  return `[outcomes ${outcomes.join(\",\")}]`;\n75\t}\n76\t\n77\texport function createDeterministicProvider(): DerivationProvider {\n78\t  return {\n79\t    smoothPrompt: (i: { text: string }) => ok(\"smoothPrompt\", i, i.text),\n80\t    summarizeToolCall: (i: {\n81\t      toolName: string;\n82\t      argsJson: string;\n83\t      pairedResult?: { content: string; isError: boolean };\n84\t    }) => ok(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`),\n85\t    summarizeToolResult: (i: { toolName: string; content: string }) =>\n86\t      ok(\"summarizeToolResult\", i, i.content),\n87\t    composeTurnRendering: (i: { parts: RenderingPart[] }) =>\n88\t      ok(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \")),\n89\t    projectLowerBand: (i: { rendering: string }) => ok(\"projectLowerBand\", i, i.rendering),\n90\t    summarizeChunkDetailed: async (i: {\n91\t      memberProjections: string[];\n92\t      memberReceipts?: ToolRunReceipt[][];\n93\t    }) => {\n94\t      const base = await ok(\"summarizeChunkDetailed\", i, i.memberProjections.join(\" | \"));\n95\t      if (!base.ok) return base;\n96\t      return { ok: true, text: base.text + deterministicReceiptsSuffix(i.memberReceipts) };\n97\t    },\n98\t    summarizeChunkBrief: async (i: {\n99\t      memberProjections: string[];\n100\t      memberOutcomes?: ToolOutcome[][];\n101\t    }) => {\n102\t      const base = await ok(\"summarizeChunkBrief\", i, i.memberProjections.join(\" | \"));\n103\t      if (!base.ok) return base;\n104\t      return { ok: true, text: base.text + deterministicOutcomesSuffix(i.memberOutcomes) };\n105\t    },\n106\t  };\n107\t}\n108\t"}]},"parent_tool_use_id":null,"session_id":"1b388d14-2b35-4b36-8c72-7c338ac5cd77","uuid":"122d1ed3-b62d-40c6-aec3-27930e0af504","timestamp":"2026-06-11T09:42:05.793Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/providers/deterministic.ts","content":"// The deterministic provider: marked, input-derived output for every seam\n// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\n// functions of the input. It backs the named-provider registry's\n// \"deterministic\" entry (DD-11) so spawned-CLI tests exercise the production\n// resolution seam, and the test double reuses these helpers so in-process and\n// spawned runs produce byte-identical artifacts. It is selectable only by\n// explicit name — never a production default.\nimport type {\n  DerivationProvider,\n  ProviderResult,\n  RenderingPart,\n  ToolOutcome,\n  ToolRunReceipt,\n} from \"../shared/derivation.js\";\n\nexport type DeterministicOpName =\n  | \"smoothPrompt\"\n  | \"summarizeToolCall\"\n  | \"summarizeToolResult\"\n  | \"composeTurnRendering\"\n  | \"projectLowerBand\"\n  | \"summarizeChunkDetailed\"\n  | \"summarizeChunkBrief\";\n\nexport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\n  smoothPrompt: \"smoothed\",\n  summarizeToolCall: \"toolcall\",\n  summarizeToolResult: \"toolresult\",\n  composeTurnRendering: \"rendering\",\n  projectLowerBand: \"projection\",\n  summarizeChunkDetailed: \"detailed\",\n  summarizeChunkBrief: \"brief\",\n};\n\n// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\n// input-sensitive enough that distinct inputs mark distinct outputs.\nexport function deterministicDigest(input: unknown): string {\n  const text = JSON.stringify(input);\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < text.length; i += 1) {\n    hash ^= text.charCodeAt(i);\n    hash = Math.imul(hash, 0x01000193) >>> 0;\n  }\n  return hash.toString(16).padStart(8, \"0\");\n}\n\nexport function deterministicText(\n  op: DeterministicOpName,\n  input: unknown,\n  text: string,\n): string {\n  return `${DETERMINISTIC_MARKERS[op]}(${deterministicDigest(input)}:${text.slice(0, 40)})`;\n}\n\nfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\n  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\n}\n\n// The chunk-summary contract made visible in deterministic output (AC-3.8):\n// the detailed summary's artifact carries the members' tool-run receipts —\n// account and outcome — verbatim; the brief summary's carries outcomes\n// only. Pure suffixes over the input fields, shared with the test double so\n// in-process and spawned artifacts stay byte-identical; empty receipt sets\n// add nothing, keeping receipt-less output unchanged.\nexport function deterministicReceiptsSuffix(memberReceipts?: ToolRunReceipt[][]): string {\n  const receipts = (memberReceipts ?? []).flat();\n  if (receipts.length === 0) return \"\";\n  return `[receipts ${receipts.map((r) => `${r.account}=>${r.outcome}`).join(\"; \")}]`;\n}\n\nexport function deterministicOutcomesSuffix(memberOutcomes?: ToolOutcome[][]): string {\n  const outcomes = (memberOutcomes ?? []).flat();\n  if (outcomes.length === 0) return \"\";\n  return `[outcomes ${outcomes.join(\",\")}]`;\n}\n\nexport function createDeterministicProvider(): DerivationProvider {\n  return {\n    smoothPrompt: (i: { text: string }) => ok(\"smoothPrompt\", i, i.text),\n    summarizeToolCall: (i: {\n      toolName: string;\n      argsJson: string;\n      pairedResult?: { content: string; isError: boolean };\n    }) => ok(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`),\n    summarizeToolResult: (i: { toolName: string; content: string }) =>\n      ok(\"summarizeToolResult\", i, i.content),\n    composeTurnRendering: (i: { parts: RenderingPart[] }) =>\n      ok(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \")),\n    projectLowerBand: (i: { rendering: string }) => ok(\"projectLowerBand\", i, i.rendering),\n    summarizeChunkDetailed: async (i: {\n      memberProjections: string[];\n      memberReceipts?: ToolRunReceipt[][];\n    }) => {\n      const base = await ok(\"summarizeChunkDetailed\", i, i.memberProjections.join(\" | \"));\n      if (!base.ok) return base;\n      return { ok: true, text: base.text + deterministicReceiptsSuffix(i.memberReceipts) };\n    },\n    summarizeChunkBrief: async (i: {\n      memberProjections: string[];\n      memberOutcomes?: ToolOutcome[][];\n    }) => {\n      const base = await ok(\"summarizeChunkBrief\", i, i.memberProjections.join(\" | \"));\n      if (!base.ok) return base;\n      return { ok: true, text: base.text + deterministicOutcomesSuffix(i.memberOutcomes) };\n    },\n  };\n}\n","numLines":108,"startLine":1,"totalLines":108}}}

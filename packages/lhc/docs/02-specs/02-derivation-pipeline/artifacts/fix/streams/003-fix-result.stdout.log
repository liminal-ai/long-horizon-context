mbleWorkHandlerMap(\n124\t  tables: ReadonlyArray<WorkHandlerMap>,\n125\t): WorkHandlerMap {\n126\t  const map: WorkHandlerMap = {};\n127\t  for (const table of tables) {\n128\t    for (const [kind, handler] of Object.entries(table)) {\n129\t      if (map[kind as WorkKind] !== undefined) {\n130\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n131\t      }\n132\t      map[kind as WorkKind] = handler;\n133\t    }\n134\t  }\n135\t  return map;\n136\t}\n137\t\n138\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n139\t  return {\n140\t    ok: false,\n141\t    error: {\n142\t      errorClass: \"state_corruption\",\n143\t      code: \"unknown_work_kind\",\n144\t      reason: `no handler registered for work kind \"${kind}\"`,\n145\t    },\n146\t  };\n147\t}\n148\t\n149\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n150\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n151\texport function lookupWorkHandler(\n152\t  map: WorkHandlerMap,\n153\t  kind: string,\n154\t): OpResult<WorkHandler> {\n155\t  const handler = map[kind as WorkKind];\n156\t  if (handler === undefined) return unknownWorkKind(kind);\n157\t  return { ok: true, value: handler };\n158\t}\n159\t\n160\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n161\t// requeue land in Story 4.\n162\texport interface WorkSurface {\n163\t  drain(\n164\t    ref: threadsDomain.ThreadRef,\n165\t    opts?: { maxItems?: number },\n166\t  ): Promise<OpResult<DrainReport>>;\n167\t}\n168\t\n169\texport interface Lhc {\n170\t  threads: typeof threadsDomain;\n171\t  intakeStream: typeof intakeStreamDomain;\n172\t  messages: typeof messagesDomain;\n173\t  turns: typeof turnsDomain;\n174\t  config: ResolvedSdkConfig;\n175\t  scheduler: Scheduler;\n176\t  workHandlers: WorkHandlerMap;\n177\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n178\t  work: WorkSurface;\n179\t  // Resolves when the scheduler has no running or pending drain for the\n180\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n181\t  // resolve in manual mode.\n182\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n183\t}\n184\t\n185\tfunction requirePositive(value: number, name: string): void {\n186\t  if (!Number.isFinite(value) || value <= 0) {\n187\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n188\t  }\n189\t}\n190\t\n191\tfunction requireNonNegative(value: number, name: string): void {\n192\t  if (!Number.isFinite(value) || value < 0) {\n193\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n194\t  }\n195\t}\n196\t\n197\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n198\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n199\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n200\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n201\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n202\t// object is the same shape as the namespace, so the public surface type holds.\n203\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n204\t  const scoped: Record<string, unknown> = {};\n205\t  for (const key of Object.keys(surface)) {\n206\t    const value = (surface as Record<string, unknown>)[key];\n207\t    scoped[key] =\n208\t      typeof value === \"function\"\n209\t        ? (...args: unknown[]): unknown =>\n210\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n211\t        : value;\n212\t  }\n213\t  return scoped as T;\n214\t}\n215\t\n216\t// The only assembly path: provider, mode, clock, and policy enter here.\n217\t// Config mistakes are programmer errors at construction and throw; operating\n218\t// failures after construction return OpResults per the error contract.\n219\texport function createSdk(config: SdkConfig): Lhc {\n220\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n221\t    throw new TypeError(\n222\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n223\t    );\n224\t  }\n225\t  if (config.provider === null || typeof config.provider !== \"object\") {\n226\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n227\t  }\n228\t  for (const operation of PROVIDER_OPERATIONS) {\n229\t    if (typeof config.provider[operation] !== \"function\") {\n230\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n231\t    }\n232\t  }\n233\t\n234\t  const resolved: ResolvedSdkConfig = {\n235\t    provider: config.provider,\n236\t    mode: config.mode,\n237\t    clock: config.clock ?? (() => new Date()),\n238\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n239\t    lease: config.lease ?? { durationMs: 120000 },\n240\t    chunkPolicy:\n241\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n242\t  };\n243\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n244\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n245\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n246\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n247\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n248\t  }\n249\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n250\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n251\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n252\t    throw new TypeError(\n253\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n254\t    );\n255\t  }\n256\t\n257\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n258\t  // The tables are empty until Stories 2–3 land the real handlers; the\n259\t  // assembly mechanics are production code from day one.\n260\t  const workHandlers = assembleWorkHandlerMap([\n261\t    messagesDomain.workHandlers,\n262\t    turnsDomain.workHandlers,\n263\t  ]);\n264\t\n265\t  const drainDeps: DrainDeps = {\n266\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n267\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n268\t    config: resolved,\n269\t  };\n270\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n271\t\n272\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n273\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n274\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n275\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n276\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n277\t  // the construction order, because its operations deliver to the no-op seam,\n278\t  // not to whatever a background SDK installed below.\n279\t  const seam: InstanceSeam =\n280\t    resolved.mode === \"background\"\n281\t      ? {\n282\t          poke: (threadId) => scheduler.poke(threadId),\n283\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n284\t        }\n285\t      : { poke: () => {}, touch: () => {} };\n286\t\n287\t  // Background mode also installs the below-SDK default seam so a direct\n288\t  // domain call made with no SDK scope — a top-level mutation in the\n289\t  // single-background \"production path\" — still reaches the one installed\n290\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n291\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n292\t  // leaves the default alone (pokes stay no-ops by contract).\n293\t  if (resolved.mode === \"background\") {\n294\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n295\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n296\t  }\n297\t\n298\t  const work: WorkSurface = {\n299\t    drain: (ref, opts) =>\n300\t      runWithInstanceSeam(seam, async () => {\n301\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n302\t        if (!resolvedRef.ok) return resolvedRef;\n303\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n304\t      }),\n305\t  };\n306\t\n307\t  return {\n308\t    threads: threadsDomain,\n309\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n310\t    messages: scopeSurface(messagesDomain, seam),\n311\t    turns: scopeSurface(turnsDomain, seam),\n312\t    config: resolved,\n313\t    scheduler,\n314\t    workHandlers,\n315\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n316\t    work,\n317\t    drainSettled: async (ref) => {\n318\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n319\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n320\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n321\t      if (threadId === null) return;\n322\t      return scheduler.drainSettled(threadId);\n323\t    },\n324\t  };\n325\t}\n326\t"}]},"parent_tool_use_id":null,"session_id":"1b388d14-2b35-4b36-8c72-7c338ac5cd77","uuid":"abb0ec63-651c-49e9-a3f2-ce5c07cb7a75","timestamp":"2026-06-11T09:47:39.630Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts","content":"export * as threads from \"./domains/threads/index.js\";\nexport * as intakeStream from \"./domains/intake-stream/index.js\";\nexport * as messages from \"./domains/messages/index.js\";\nexport * as turns from \"./domains/turns/in
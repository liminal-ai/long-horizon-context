{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AQz879iAa4yhZgnh1sU4f2","type":"tool_result","content":"1\t// Rendering composition (Flow 3, AC-3.2–3.4): message-level forms become the\n2\t// ordered RenderingPart input for composeTurnRendering, with fallbacks and\n3\t// gap records where a form is not ready. Pure by anti-shim requirement —\n4\t// `(messages, forms) → { parts, gaps }` with no DB handle, no provider, no\n5\t// clock in the signature: determinism is structural, not disciplined.\n6\t//\n7\t// Tool activity stays in message order — runs are the consecutive tool\n8\t// messages exactly as recorded, never reordered to make accounts tidier —\n9\t// and every tool part carries its outcome, so a run containing a\n10\t// state-changing call structurally cannot lose its outcome in composition\n11\t// (AC-3.4: the outcome rides the part, not the prose).\n12\timport type {\n13\t  DependencyGap,\n14\t  DerivedFormMetadata,\n15\t  DerivedFormState,\n16\t  FormKind,\n17\t  RenderingPart,\n18\t  RenderingPartKind,\n19\t  ToolOutcome,\n20\t  ToolRunReceipt,\n21\t} from \"../../../shared/derivation.js\";\n22\t\n23\t// The member message as the composer sees it: kind plus projected blocks,\n24\t// verbatim from the record (already deleted-filtered by the caller's read).\n25\texport interface ComposeMessage {\n26\t  messageId: string;\n27\t  kind: RenderingPartKind;\n28\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n29\t}\n30\t\n31\t// One message-owned form row as composition input; keyed by the caller as\n32\t// `${messageId}/${form}`.\n33\texport interface ComposeFormRow {\n34\t  state: DerivedFormState;\n35\t  content?: string;\n36\t  metadata?: DerivedFormMetadata;\n37\t}\n38\t\n39\texport function composeFormKey(messageId: string, form: FormKind): string {\n40\t  return `${messageId}/${form}`;\n41\t}\n42\t\n43\texport interface CompositionInput {\n44\t  parts: RenderingPart[];\n45\t  gaps: DependencyGap[];\n46\t  // The turn's tool-run receipts (AC-3.8): the tool parts restated as\n47\t  // account + outcome, in message order — pure restatement of the\n48\t  // composition input, stamped on the rendering so chunk summaries read\n49\t  // receipts without re-deriving anything.\n50\t  receipts: ToolRunReceipt[];\n51\t}\n52\t\n53\t// Deterministic truncation for tool-activity fallbacks (AC-3.2's \"raw or\n54\t// truncated content\"): a fixed prefix plus an exact tail marker, a pure\n55\t// function of the input string alone.\n56\texport const FALLBACK_TRUNCATION_LIMIT = 200;\n57\t\n58\texport function truncateForFallback(text: string): string {\n59\t  if (text.length <= FALLBACK_TRUNCATION_LIMIT) return text;\n60\t  const dropped = text.length - FALLBACK_TRUNCATION_LIMIT;\n61\t  return `${text.slice(0, FALLBACK_TRUNCATION_LIMIT)}… [truncated ${dropped} chars]`;\n62\t}\n63\t\n64\tfunction textOf(message: ComposeMessage): string {\n65\t  const text = message.blocks[0]?.content[\"text\"];\n66\t  return typeof text === \"string\" ? text : \"\";\n67\t}\n68\t\n69\t// Mechanical outcome from the record alone (the AC-2.4 rule carried into\n70\t// composition): a tool call's outcome comes from its paired result among the\n71\t// turn's messages — present and clean, present and isError, or absent.\n72\tfunction recordOutcomes(messages: readonly ComposeMessage[]): Map<string, boolean> {\n73\t  const byCallId = new Map<string, boolean>();\n74\t  for (const message of messages) {\n75\t    if (message.kind !== \"tool_result\") continue;\n76\t    const block = message.blocks[0]?.content ?? {};\n77\t    const callId = block[\"toolCallId\"];\n78\t    if (typeof callId === \"string\") byCallId.set(callId, block[\"isError\"] === true);\n79\t  }\n80\t  return byCallId;\n81\t}\n82\t\n83\tfunction outcomeFromRecord(\n84\t  resultByCallId: Map<string, boolean>,\n85\t  callId: unknown,\n86\t): ToolOutcome {\n87\t  if (typeof callId !== \"string\") return \"unknown\";\n88\t  const isError = resultByCallId.get(callId);\n89\t  if (isError === undefined) return \"unknown\";\n90\t  return isError ? \"failed\" : \"succeeded\";\n91\t}\n92\t\n93\tinterface PartPlan {\n94\t  form?: FormKind; // the message-level form this kind composes from, if any\n95\t  fallbackText: (message: ComposeMessage) => string;\n96\t}\n97\t\n98\t// The fallback rules table (story Technical Notes): prompt → raw text; tool\n99\t// call/result → deterministic truncation; text/thinking/note → raw, no form\n100\t// to fall back from and therefore never a gap.\n101\tconst PART_PLANS: Record<RenderingPartKind, PartPlan> = {\n102\t  user_prompt: { form: \"smoothed_prompt\", fallbackText: textOf },\n103\t  assistant_text: { fallbackText: textOf },\n104\t  assistant_thinking: { fallbackText: textOf },\n105\t  runtime_note: { fallbackText: textOf },\n106\t  tool_call: {\n107\t    form: \"tool_call_summary\",\n108\t    fallbackText: (message) => {\n109\t      const block = message.blocks[0]?.content ?? {};\n110\t      const toolName = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n111\t      return truncateForFallback(`${toolName}(${JSON.stringify(block[\"arguments\"] ?? {})})`);\n112\t    },\n113\t  },\n114\t  tool_result: {\n115\t    form: \"tool_result_summary\",\n116\t    fallbackText: (message) => {\n117\t      const block = message.blocks[0]?.content ?? {};\n118\t      return truncateForFallback(typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\");\n119\t    },\n120\t  },\n121\t};\n122\t\n123\t// Ready forms verbatim; non-ready (pending | failed | blocked) fall back with\n124\t// one gap recorded per fallback naming the source record and the missing\n125\t// form (AC-3.2). Gaps are facts about this composition — the caller lands\n126\t// them on the rendering and they stay put until an explicit rebuild\n127\t// recomposes from current states (AC-3.3).\n128\texport function composeRenderingInput(\n129\t  messages: readonly ComposeMessage[],\n130\t  forms: ReadonlyMap<string, ComposeFormRow>,\n131\t): CompositionInput {\n132\t  const parts: RenderingPart[] = [];\n133\t  const gaps: DependencyGap[] = [];\n134\t  const receipts: ToolRunReceipt[] = [];\n135\t  const resultByCallId = recordOutcomes(messages);\n136\t\n137\t  for (const message of messages) {\n138\t    const plan = PART_PLANS[message.kind];\n139\t    const form = plan.form === undefined ? undefined : forms.get(composeFormKey(message.messageId, plan.form));\n140\t    const ready = form !== undefined && form.state === \"ready\" && form.content !== undefined;\n141\t\n142\t    const part: RenderingPart = {\n143\t      messageId: message.messageId,\n144\t      kind: message.kind,\n145\t      text: ready ? (form.content as string) : plan.fallbackText(message),\n146\t      fallback: plan.form !== undefined && !ready,\n147\t    };\n148\t    if (message.kind === \"tool_call\") {\n149\t      const callId = message.blocks[0]?.content[\"toolCallId\"];\n150\t      part.outcome =\n151\t        ready && form.metadata?.outcome !== undefined\n152\t          ? form.metadata.outcome\n153\t          : outcomeFromRecord(resultByCallId, callId);\n154\t    } else if (message.kind === \"tool_result\") {\n155\t      const block = message.blocks[0]?.content ?? {};\n156\t      part.outcome =\n157\t        ready && form.metadata?.outcome !== undefined\n158\t          ? form.metadata.outcome\n159\t          : block[\"isError\"] === true\n160\t            ? \"failed\"\n161\t            : \"succeeded\";\n162\t    }\n163\t    parts.push(part);\n164\t    if (part.fallback && plan.form !== undefined) {\n165\t      gaps.push({ subjectKind: \"message\", subjectId: message.messageId, form: plan.form });\n166\t    }\n167\t    if (message.kind === \"tool_call\" || message.kind === \"tool_result\") {\n168\t      receipts.push({\n169\t        messageId: message.messageId,\n170\t        activity: message.kind,\n171\t        account: part.text,\n172\t        outcome: part.outcome ?? \"unknown\",\n173\t      });\n174\t    }\n175\t  }\n176\t\n177\t  return { parts, gaps, receipts };\n178\t}\n179\t"}]},"parent_tool_use_id":null,"session_id":"1b388d14-2b35-4b36-8c72-7c338ac5cd77","uuid":"237dfda4-30e1-41db-92cb-46bcbb5a4e76","timestamp":"2026-06-11T09:41:37.921Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/compose.ts","content":"// Rendering composition (Flow 3, AC-3.2–3.4): message-level forms become the\n// ordered RenderingPart input for composeTurnRendering, with fallbacks and\n// gap records where a form is not ready. Pure by anti-shim requirement —\n// `(messages, forms) → { parts, gaps }` with no DB handle, no provider, no\n// clock in the signature: determinism is structural, not disciplined.\n//\n// Tool activity stays in message order — runs are the consecutive tool\n// messages exactly as recorded, never reordered to make accounts tidier —\n// and every tool part carries its outcome, so a run containing a\n// state-changing call structurally cannot lose its outcome in composition\n// (AC-3.4: the outcome rides the part, not the prose).\nimport type {\n  DependencyGap,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  RenderingPart,\n  RenderingPartKind,\n  ToolOutcome,\n  ToolRunReceipt,\n} from \"../../../shared/derivation.js\";\n\n// The member message as the composer sees it: kind plus projected blocks,\n// verbatim from the record (already deleted-filtered by the caller's read).\nexport interface ComposeMessage {\n  messageId: string;\n  kind: RenderingPartKind;\n  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n}\n\n// One message-owned form row as composition input; keyed by the caller as\n// `${messageId}/${form}`.\nexport interface ComposeFormRow {\n  state: DerivedFormState;\n  content?: string;\n  metadata?: DerivedFormMetadata;\n}\n\nexport function composeFormKey(messageId: string, form: FormKind): string {\n  return `${messageId}/${form}`;\n}\n\nexport interface CompositionInput {\n  parts: RenderingPart[];\n  gaps: DependencyGap[];\n  // The turn's tool-run receipts (AC-3.8): the tool parts restated as\n  // account + outcome, in message order — pure restatement of the\n  // composition input, stamped on the rendering so chunk summaries read\n  // receipts without re-deriving anything.\n  receipts: ToolRunReceipt[];\n}\n\n// Deterministic truncation for tool-activity fallbacks (AC-3.2's \"raw or\n// truncated content\"): a fixed prefix plus an exact tail marker, a pure\n// function of the input string alone.\nexport const FALLBACK_TRUNCATION_LIMIT = 200;\n\nexport function truncateForFallback(text: string): string {\n  if (text.length <= FALLBACK_TRUNCATION_LIMIT) return text;\n  const dropped = text.length - FALLBACK_TRUNCATION_LIMIT;\n  return `${text.slice(0, FALLBACK_TRUNCATION_LIMIT)}… [truncated ${dropped} chars]`;\n}\n\nfunction textOf(message: ComposeMessage): string {\n  const text = message.blocks[0]?.content[\"text\"];\n  return typeof text === \"string\" ? text : \"\";\n}\n\n// Mechanical outcome from the record alone (the AC-2.4 rule carried into\n// composition): a tool call's outcome comes from its paired result among the\n// turn's messages — present and clean, present and isError, or absent.\nfunction recordOutcomes(messages: readonly ComposeMessage[]): Map<string, boolean> {\n  const byCallId = new Map<string, boolean>();\n  for (const message of messages) {\n    if (message.kind !== \"tool_result\") continue;\n    const block = message.blocks[0]?.content ?? {};\n    const callId = block[\"toolCallId\"];\n    if (typeof callId === \"string\") byCallId.set(callId, block[\"isError\"] === true);\n  }\n  return byCallId;\n}\n\nfunction outcomeFromRecord(\n  resultByCallId: Map<string, boolean>,\n  callId: unknown,\n): ToolOutcome {\n  if (typeof callId !== \"string\") return \"unknown\";\n  const isError = resultByCallId.get(callId);\n  if (isError === undefined) return \"unknown\";\n  return isError ? \"failed\" : \"succeeded\";\n}\n\ninterface PartPlan {\n  form?: FormKind; // the message-level form this kind composes from, if any\n  fallbackText: (message: ComposeMessage) => string;\n}\n\n// The fallback rules table (story Technical Notes): prompt → raw text; tool\n// call/result → deterministic truncation; text/thinking/note → raw, no form\n// to fall back from and therefore never a gap.\nconst PART_PLANS: Record<RenderingPartKind, PartPlan> = {\n  user_prompt: { form: \"smoothed_prompt\", fallbackText: textOf },\n  assistant_text: { fallbackText: textOf },\n  assistant_thinking: { fallbackText: textOf },\n  runtime_note: { fallbackText: textOf },\n  tool_call: {\n    form: \"tool_call_summary\",\n    fallbackText: (message) => {\n      const block = message.blocks[0]?.content ?? {};\n      const toolName = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n      return truncateForFallback(`${toolName}(${JSON.stringify(block[\"arguments\"] ?? {})})`);\n    },\n  },\n  tool_result: {\n    form: \"tool_result_summary\",\n    fallbackText: (message) => {\n      const block = message.blocks[0]?.content ?? {};\n      return truncateForFallback(typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\");\n    },\n  },\n};\n\n// Ready forms verbatim; non-ready (pending | failed | blocked) fall back with\n// one gap recorded per fallback naming the source record and the missing\n// form (AC-3.2). Gaps are facts about this composition — the caller lands\n// them on the rendering and they stay put until an explicit rebuild\n// recomposes from current states (AC-3.3).\nexport function composeRenderingInput(\n  messages: readonly ComposeMessage[],\n  forms: ReadonlyMap<string, ComposeFormRow>,\n): CompositionInput {\n  const parts: RenderingPart[] = [];\n  const gaps: DependencyGap[] = [];\n  const receipts: ToolRunReceipt[] = [];\n  const resultByCallId = recordOutcomes(messages);\n\n  for (const message of messages) {\n    const plan = PART_PLANS[message.kind];\n    const form = plan.form === undefined ? undefined : forms.get(composeFormKey(message.messageId, plan.form));\n    const ready = form !== undefined && form.state === \"ready\" && form.content !== undefined;\n\n    const part: RenderingPart = {\n      messageId: message.messageId,\n      kind: message.kind,\n      text: ready ? (form.content as string) : plan.fallbackText(message),\n      fallback: plan.form !== undefined && !ready,\n    };\n    if (message.kind === \"tool_call\") {\n      const callId = message.blocks[0]?.content[\"toolCallId\"];\n      part.outcome =\n        ready && form.metadata?.outcome !== undefined\n          ? form.metadata.outcome\n          : outcomeFromRecord(resultByCallId, callId);\n    } else if (message.kind === \"tool_result\") {\n      const block = message.blocks[0]?.content ?? {};\n      part.outcome =\n        ready && form.metadata?.outcome !== undefined\n          ? form.metadata.outcome\n          : block[\"isError\"] === true\n            ? \"failed\"\n            : \"succeeded\";\n    }\n    parts.push(part);\n    if (part.fallback && plan.form !== undefined) {\n      gaps.push({ subjectKind: \"message\", subjectId: message.messageId, form: plan.form });\n    }\n    if (message.kind === \"tool_call\" || message.kind === \"tool_result\") {\n      receipts.push({\n        messageId: message.messageId,\n        activity: message.kind,\n        account: part.text,\n        outcome: part.outcome ?? \"unknown\",\n      });\n    }\n  }\n\n  return { parts, gaps, receipts };\n}\n","numLines":179,"startLine":1,"totalLines":179}}}

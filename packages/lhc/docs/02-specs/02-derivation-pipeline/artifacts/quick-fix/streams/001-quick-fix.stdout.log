{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DU4aWbfowDSyEsHmFG7hZr","type":"tool_result","content":"1\t// Event → message + typed blocks (Flow 2, projection half). Verbatim means\n2\t// verbatim: payload fields are copied into block content untouched — nothing\n3\t// here trims, normalizes, splits, or summarizes (AC-2.5 is the absence of\n4\t// such a code path). Token estimates come from the one counting util, called\n5\t// directly: it is pure and deterministic, so golden counts beat stubs.\n6\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n7\timport type { Block, RecordedEvent } from \"../index.js\";\n8\t\n9\texport interface ProjectedMessage {\n10\t  blocks: Block[];\n11\t  tokenEstimate: number;\n12\t}\n13\t\n14\t// turn_end is recorded in the event order but produces no message (AC-2.3).\n15\texport function projectEvent(event: RecordedEvent): ProjectedMessage | null {\n16\t  switch (event.eventKind) {\n17\t    case \"user_prompt\":\n18\t    case \"assistant_text\":\n19\t    case \"assistant_thinking\":\n20\t    case \"runtime_note\":\n21\t      return {\n22\t        blocks: [{ blockType: \"text\", content: { text: event.payload.text } }],\n23\t        tokenEstimate: estimateTokens(event.payload.text),\n24\t      };\n25\t    case \"tool_call\":\n26\t      return {\n27\t        blocks: [\n28\t          {\n29\t            blockType: \"tool_call\",\n30\t            content: {\n31\t              toolCallId: event.payload.toolCallId,\n32\t              toolName: event.payload.toolName,\n33\t              arguments: event.payload.arguments,\n34\t            },\n35\t          },\n36\t        ],\n37\t        // Tool calls count their serialized arguments (design: Flow 2).\n38\t        tokenEstimate: estimateTokens(JSON.stringify(event.payload.arguments)),\n39\t      };\n40\t    case \"tool_result\":\n41\t      return {\n42\t        blocks: [\n43\t          {\n44\t            blockType: \"tool_result\",\n45\t            content: {\n46\t              toolCallId: event.payload.toolCallId,\n47\t              content: event.payload.content,\n48\t              isError: event.payload.isError ?? false,\n49\t            },\n50\t          },\n51\t        ],\n52\t        // Tool results count the full content string — the same string the\n53\t        // block carries in full.\n54\t        tokenEstimate: estimateTokens(event.payload.content),\n55\t      };\n56\t    case \"turn_end\":\n57\t      return null;\n58\t  }\n59\t}\n60\t"}]},"parent_tool_use_id":null,"session_id":"c1de3f50-133a-4f79-8a5b-672d328b384b","uuid":"0f00def0-dc47-4238-8d04-453ea83c4535","timestamp":"2026-06-11T06:23:55.316Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/project.ts","content":"// Event → message + typed blocks (Flow 2, projection half). Verbatim means\n// verbatim: payload fields are copied into block content untouched — nothing\n// here trims, normalizes, splits, or summarizes (AC-2.5 is the absence of\n// such a code path). Token estimates come from the one counting util, called\n// directly: it is pure and deterministic, so golden counts beat stubs.\nimport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\nimport type { Block, RecordedEvent } from \"../index.js\";\n\nexport interface ProjectedMessage {\n  blocks: Block[];\n  tokenEstimate: number;\n}\n\n// turn_end is recorded in the event order but produces no message (AC-2.3).\nexport function projectEvent(event: RecordedEvent): ProjectedMessage | null {\n  switch (event.eventKind) {\n    case \"user_prompt\":\n    case \"assistant_text\":\n    case \"assistant_thinking\":\n    case \"runtime_note\":\n      return {\n        blocks: [{ blockType: \"text\", content: { text: event.payload.text } }],\n        tokenEstimate: estimateTokens(event.payload.text),\n      };\n    case \"tool_call\":\n      return {\n        blocks: [\n          {\n            blockType: \"tool_call\",\n            content: {\n              toolCallId: event.payload.toolCallId,\n              toolName: event.payload.toolName,\n              arguments: event.payload.arguments,\n            },\n          },\n        ],\n        // Tool calls count their serialized arguments (design: Flow 2).\n        tokenEstimate: estimateTokens(JSON.stringify(event.payload.arguments)),\n      };\n    case \"tool_result\":\n      return {\n        blocks: [\n          {\n            blockType: \"tool_result\",\n            content: {\n              toolCallId: event.payload.toolCallId,\n              content: event.payload.content,\n              isError: event.payload.isError ?? false,\n            },\n          },\n        ],\n        // Tool results count the full content string — the same string the\n        // block carries in full.\n        tokenEstimate: estimateTokens(event.payload.content),\n      };\n    case \"turn_end\":\n      return null;\n  }\n}\n","numLines":60,"startLine":1,"totalLines":60}}}

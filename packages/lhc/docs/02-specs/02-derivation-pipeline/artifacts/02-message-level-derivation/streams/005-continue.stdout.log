{"type":"stream_event","event":{"type":"message_delta","delta":{"stop_reason":"tool_use","stop_sequence":null,"stop_details":null},"usage":{"input_tokens":2,"cache_creation_input_tokens":1036,"cache_read_input_tokens":239805,"output_tokens":276,"output_tokens_details":{"thinking_tokens":0},"iterations":[{"input_tokens":2,"output_tokens":276,"cache_read_input_tokens":239805,"cache_creation_input_tokens":1036,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1036},"type":"message"}]},"context_management":{"applied_edits":[]}},"session_id":"c424e248-7c12-49e6-8ca7-162e1fb88490","parent_tool_use_id":null,"uuid":"4ac2d69f-2734-4fe0-a4eb-ff0ea103925b"}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019yg6i2uYPqLiZpBEEuwBUY","type":"tool_result","content":"380\t    expect(receipts).toHaveLength(1);\n381\t    const receipt = receipts?.[0];\n382\t    // The run reads failed at run level because one call failed; the account\n383\t    // keeps the success explicit (never collapsed) and names the failed result.\n384\t    expect(receipt?.outcome).toBe(\"failed\");\n385\t    expect(receipt?.account).toContain(\"1 succeeded, 1 failed\");\n386\t    const failedResult = readDerivedForms(filePath).find(\n387\t      (f) => f.subjectId === \"m5\" && f.form === \"tool_result_summary\",\n388\t    )?.content;\n389\t    expect(receipt?.account).toContain(`${failedResult} ⇒ failed`);\n390\t  });\n391\t});\n392\t\n393\t// ── REVERIFY-02-001: cascadeTurnDelete cascades to a cross-turn pair ──────────\n394\tdescribe(\"REVERIFY-02-001: cascadeTurnDelete clears a cross-turn pair counterpart\", () => {\n395\t  it(\"deleting the turn holding a late result reverts the earlier turn's call summary to unknown\", async () => {\n396\t    const double = createProviderDouble();\n397\t    const sdk = sdkFor(double, \"manual\");\n398\t    const filePath = await newThread(\"crossturn\");\n399\t\n400\t    // t1: a tool_call whose result has not arrived — its summary derives unknown.\n401\t    const b1 = await sdk.intakeStream.messageEvents({ filePath }, [\n402\t      validEvent(\"user_prompt\", { payload: { text: \"call now\" } }),\n403\t      validEvent(\"tool_call\", { payload: { toolCallId: \"x\", toolName: \"run_cmd\", arguments: {} } }),\n404\t      validEvent(\"turn_end\"),\n405\t    ]);\n406\t    expect(b1.ok).toBe(true);\n407\t    expect((await sdk.work.drain({ filePath })).ok).toBe(true);\n408\t    const callV1 = readDerivedForms(filePath).find(\n409\t      (f) => f.subjectId === \"m2\" && f.form === \"tool_call_summary\",\n410\t    );\n411\t    expect(callV1?.state).toBe(\"ready\");\n412\t    expect(callV1?.metadata?.outcome).toBe(\"unknown\");\n413\t\n414\t    // t2: the paired result lands in a LATER (prompt-initiated) turn. Its\n415\t    // intake re-queues m2's call summary (AC-2.8 cross-turn), rebuilt 'succeeded'.\n416\t    const b2 = await sdk.intakeStream.messageEvents({ filePath }, [\n417\t      validEvent(\"user_prompt\", { payload: { text: \"and the result\" } }),\n418\t      validEvent(\"tool_result\", { payload: { toolCallId: \"x\", content: \"done\", isError: false } }),\n419\t      validEvent(\"turn_end\"),\n420\t    ]);\n421\t    expect(b2.ok).toBe(true);\n422\t    expect((await sdk.work.drain({ filePath })).ok).toBe(true);\n423\t    const callV2 = readDerivedForms(filePath).find(\n424\t      (f) => f.subjectId === \"m2\" && f.form === \"tool_call_summary\",\n425\t    );\n426\t    expect(callV2?.state).toBe(\"ready\");\n427\t    expect(callV2?.metadata?.outcome).toBe(\"succeeded\");\n428\t    expect(callV2?.sourceVersion).toBe(2);\n429\t\n430\t    // Delete t2 (the result's turn). REVERIFY-02-001: the cross-turn counterpart\n431\t    // m2 joins the cascade — its call summary clears and re-queues.\n432\t    const deleted = await sdk.turns.deleteTurn({ filePath }, { turnId: \"t2\" });\n433\t    expect(deleted.ok).toBe(true);\n434\t    if (!deleted.ok) return;\n435\t    expect(deleted.value.cleared.map(formKey)).toContain(\"message/m2/tool_call_summary\");\n436\t    expect(deleted.value.queued.map((q) => q.workItemId)).toContain(\"w-m2-tool_call_summary-v3\");\n437\t\n438\t    // Rebuild: with the result gone (deleted-read filter), the call derives no\n439\t    // pair — its outcome reverts to unknown.\n440\t    expect((await sdk.work.drain({ filePath })).ok).toBe(true);\n441\t    const callV3 = readDerivedForms(filePath).find(\n442\t      (f) => f.subjectId === \"m2\" && f.form === \"tool_call_summary\",\n443\t    );\n444\t    expect(callV3?.state).toBe(\"ready\");\n445\t    expect(callV3?.metadata?.outcome).toBe(\"unknown\");\n446\t    expect(callV3?.sourceVersion).toBe(3);\n447\t    expect(liveCount(filePath)).toBe(0);\n448\t  });\n449\t});\n450\t\n451\t// ── Fix 3.3 (P3): a stale claimed item for a deleted target discards ──────────\n452\tdescribe(\"FIX-3.3: a claimed summary for a deleted message discards on completion\", () => {\n453\t  it(\"completing the straggler after the delete discards as stale_discarded; tombstone and cascade stand\", async () => {\n454\t    const double = createProviderDouble();\n455\t    const sdk = sdkFor(double, \"manual\");\n456\t    const filePath = await newThread(\"straggler\");\n457\t    const batch = await sdk.intakeStream.messageEvents({ filePath }, [\n458\t      validEvent(\"user_prompt\", { payload: { text: \"prompt\" } }),\n459\t      validEvent(\"tool_call\", { payload: { toolCallId: \"k\", toolName: \"run_cmd\", arguments: {} } }),\n460\t      validEvent(\"tool_result\", { payload: { toolCallId: \"k\", content: \"ok\", isError: false } }),\n461\t      validEvent(\"turn_end\"),\n462\t    ]);\n463\t    expect(batch.ok).toBe(true);\n464\t\n465\t    // Hold m2's tool_call_summary in flight: the drain claims it, the handler\n466\t    // awaits the delayed double, and the delete lands inside that window.\n467\t    double.delayKind(\"tool_call_summary\", 400);\n468\t    const captured = double.captureInputs();\n469\t    const drainPromise = sdk.work.drain({ filePath });\n470\t    await until(\n471\t      () => captured.some((c) => c.op === \"summarizeToolCall\"),\n472\t      \"m2's tool_call_summary to be claimed and in-handler\",\n473\t    );\n474\t\n475\t    // Delete m2 (the tool_call) while its summary item is claimed. Its own form\n476\t    // drops; the claimed item is left to the version check (DD-3).\n477\t    const deleted = await sdk.messages.deleteMessage({ filePath }, { messageId: \"m2\" });\n478\t    expect(deleted.ok).toBe(true);\n479\t    if (!deleted.ok) return;\n480\t    expect(deleted.value.dropped.map(formKey)).toContain(\"message/m2/tool_call_summary\");\n481\t\n482\t    const drained = await drainPromise;\n483\t    expect(drained.ok).toBe(true);\n484\t    if (!drained.ok) return;\n485\t    // The straggler completion is reported stale_discarded — not an error, not a\n486\t    // retry.\n487\t    const m2Item = drained.value.ran.find((r) => r.workItemId === \"w-m2-tool_call_summary-v1\");\n488\t    expect(m2Item?.disposition).toBe(\"stale_discarded\");\n489\t\n490\t    // Tombstone intact: m2 is gone from the live read and its summary form was\n491\t    // not resurrected by the stale completion.\n492\t    const listed = await sdk.messages.listMessages({ filePath });\n493\t    expect(listed.ok).toBe(true);\n494\t    if (!listed.ok) return;\n495\t    expect(listed.value.map((m) => m.messageId)).not.toContain(\"m2\");\n496\t    expect(readDerivedForms(filePath).some((f) => f.subjectId === \"m2\")).toBe(false);\n497\t    // Cascade stands: the counterpart re-queue and the turn rebuild drained\n498\t    // clean behind the discarded straggler.\n499\t    expect(liveCount(filePath)).toBe(0);\n500\t  });\n501\t});\n502\t"}]},"parent_tool_use_id":null,"session_id":"0237ebdd-fed4-43b7-aea6-2688595304fb","uuid":"91f3298e-c03e-41b2-8628-7c141d1bfb0b","timestamp":"2026-06-11T10:29:38.780Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/epic-fix-02.test.ts","content":"    expect(receipts).toHaveLength(1);\n    const receipt = receipts?.[0];\n    // The run reads failed at run level because one call failed; the account\n    // keeps the success explicit (never collapsed) and names the failed result.\n    expect(receipt?.outcome).toBe(\"failed\");\n    expect(receipt?.account).toContain(\"1 succeeded, 1 failed\");\n    const failedResult = readDerivedForms(filePath).find(\n      (f) => f.subjectId === \"m5\" && f.form === \"tool_result_summary\",\n    )?.content;\n    expect(receipt?.account).toContain(`${failedResult} ⇒ failed`);\n  });\n});\n\n// ── REVERIFY-02-001: cascadeTurnDelete cascades to a cross-turn pair ──────────\ndescribe(\"REVERIFY-02-001: cascadeTurnDelete clears a cross-turn pair counterpart\", () => {\n  it(\"deleting the turn holding a late result reverts the earlier turn's call summary to unknown\", async () => {\n    const double = createProviderDouble();\n    const sdk = sdkFor(double, \"manual\");\n    const filePath = await newThread(\"crossturn\");\n\n    // t1: a tool_call whose result has not arrived — its summary derives unknown.\n    const b1 = await sdk.intakeStream.messageEvents({ filePath }, [\n      validEvent(\"user_prompt\", { payload: { text: \"call now\" } }),\n      validEvent(\"tool_call\", { payload: { toolCallId: \"x\", toolName: \"run_cmd\", arguments: {} } }),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(b1.ok).toBe(true);\n    expect((await sdk.work.drain({ filePath })).ok).toBe(true);\n    const callV1 = readDerivedForms(filePath).find(\n      (f) => f.subjectId === \"m2\" && f.form === \"tool_call_summary\",\n    );\n    expect(callV1?.state).toBe(\"ready\");\n    expect(callV1?.metadata?.outcome).toBe(\"unknown\");\n\n    // t2: the paired result lands in a LATER (prompt-initiated) turn. Its\n    // intake re-queues m2's call summary (AC-2.8 cross-turn), rebuilt 'succeeded'.\n    const b2 = await sdk.intakeStream.messageEvents({ filePath }, [\n      validEvent(\"user_prompt\", { payload: { text: \"and the result\" } }),\n      validEvent(\"tool_result\", { payload: { toolCallId: \"x\", content: \"done\", isError: false } }),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(b2.ok).toBe(true);\n    expect((await sdk.work.drain({ filePath })).ok).toBe(true);\n    const callV2 = readDerivedForms(filePath).find(\n      (f) => f.subjectId === \"m2\" && f.form === \"tool_call_summary\",\n    );\n    expect(callV2?.state).toBe(\"ready\");\n    expect(callV2?.metadata?.outcome).toBe(\"succeeded\");\n    expect(callV2?.sourceVersion).toBe(2);\n\n    // Delete t2 (the result's turn). REVERIFY-02-001: the cross-turn counterpart\n    // m2 joins the cascade — its call summary clears and re-queues.\n    const deleted = await sdk.turns.deleteTurn({ filePath }, { turnId: \"t2\" });\n    expect(deleted.ok).toBe(true);\n    if (!deleted.ok) return;\n    expect(deleted.value.cleared.map(formKey)).toContain(\"message/m2/tool_call_summary\");\n    expect(deleted.value.queued.map((q) => q.workItemId)).toContain(\"w-m2-tool_call_summary-v3\");\n\n    // Rebuild: with the result gone (deleted-read filter), the call derives no\n    // pair — its outcome reverts to unknown.\n    expect((await sdk.work.drain({ filePath })).ok).toBe(true);\n    const callV3 = readDerivedForms(filePath).find(\n      (f) => f.subjectId === \"m2\" && f.form === \"tool_call_summary\",\n    );\n    expect(callV3?.state).toBe(\"ready\");\n    expect(callV3?.metadata?.outcome).toBe(\"unknown\");\n    expect(callV3?.sourceVersion).toBe(3);\n    expect(liveCount(filePath)).toBe(0);\n  });\n});\n\n// ── Fix 3.3 (P3): a stale claimed item for a deleted target discards ──────────\ndescribe(\"FIX-3.3: a claimed summary for a deleted message discards on completion\", () => {\n  it(\"completing the straggler after the delete discards as stale_discarded; tombstone and cascade stand\", async () => {\n    const double = createProviderDouble();\n    const sdk = sdkFor(double, \"manual\");\n    const filePath = await newThread(\"straggler\");\n    const batch = await sdk.intakeStream.messageEvents({ filePath }, [\n      validEvent(\"user_prompt\", { payload: { text: \"prompt\" } }),\n      validEvent(\"tool_call\", { payload: { toolCallId: \"k\", toolName: \"run_cmd\", arguments: {} } }),\n      validEvent(\"tool_result\", { payload: { toolCallId: \"k\", content: \"ok\", isError: false } }),\n      validEvent(\"turn_end\"),\n    ]);\n    expect(batch.ok).toBe(true);\n\n    // Hold m2's tool_call_summary in flight: the drain claims it, the handler\n    // awaits the delayed double, and the delete lands inside that window.\n    double.delayKind(\"tool_call_summary\", 400);\n    const captured = double.captureInputs();\n    const drainPromise = sdk.work.drain({ filePath });\n    await until(\n      () => captured.some((c) => c.op === \"summarizeToolCall\"),\n      \"m2's tool_call_summary to be claimed and in-handler\",\n    );\n\n    // Delete m2 (the tool_call) while its summary item is claimed. Its own form\n    // drops; the claimed item is left to the version check (DD-3).\n    const deleted = await sdk.messages.deleteMessage({ filePath }, { messageId: \"m2\" });\n    expect(deleted.ok).toBe(true);\n    if (!deleted.ok) return;\n    expect(deleted.value.dropped.map(formKey)).toContain(\"message/m2/tool_call_summary\");\n\n    const drained = await drainPromise;\n    expect(drained.ok).toBe(true);\n    if (!drained.ok) return;\n    // The straggler completion is reported stale_discarded — not an error, not a\n    // retry.\n    const m2Item = drained.value.ran.find((r) => r.workItemId === \"w-m2-tool_call_summary-v1\");\n    expect(m2Item?.disposition).toBe(\"stale_discarded\");\n\n    // Tombstone intact: m2 is gone from the live read and its summary form was\n    // not resurrected by the stale completion.\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    expect(listed.value.map((m) => m.messageId)).not.toContain(\"m2\");\n    expect(readDerivedForms(filePath).some((f) => f.subjectId === \"m2\")).toBe(false);\n    // Cascade stands: the counterpart re-queue and the turn rebuild drained\n    // clean behind the discarded straggler.\n    expect(liveCount(filePath)).toBe(0);\n  });\n});\n","numLines":123,"startLine":380,"totalLines":502}}}

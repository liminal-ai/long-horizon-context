{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VeFCQ4NCJ2muC8fBzmXMQ8","type":"tool_result","content":"1\t// Epic 02 shared vocabulary: the derived-form state machine's types, the\n2\t// provider seam, and the handler contract. Both owning domains (messages,\n3\t// turns) consume these; neither owns them — the repair report, the mutation\n4\t// cascade, and the drain all speak this vocabulary across domain lines, so it\n5\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\n6\timport type { DatabaseSync } from \"node:sqlite\";\n7\t\n8\texport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n9\t\n10\texport type FormKind =\n11\t  | \"smoothed_prompt\"\n12\t  | \"tool_call_summary\"\n13\t  | \"tool_result_summary\"\n14\t  | \"turn_rendering\"\n15\t  | \"lower_band_projection\"\n16\t  | \"chunk_summary_detailed\"\n17\t  | \"chunk_summary_brief\";\n18\t\n19\texport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n20\t\n21\t// Outcome on tool-activity summaries — mechanically stamped from the record\n22\t// (isError/presence), never authored by the provider (AC-2.4).\n23\texport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n24\t\n25\t// A composed form's record of a dependency that fell back during composition:\n26\t// names the source record and the form that was not ready (AC-3.2/3.3).\n27\texport interface DependencyGap {\n28\t  subjectKind: SubjectKind;\n29\t  subjectId: string;\n30\t  form: FormKind;\n31\t}\n32\t\n33\t// The read shape for one derived form's state row (DD-2, DD-3).\n34\texport interface DerivedForm {\n35\t  subjectKind: SubjectKind;\n36\t  subjectId: string;\n37\t  form: FormKind;\n38\t  state: DerivedFormState;\n39\t  content?: string; // ready only\n40\t  reason?: string; // failed | blocked\n41\t  sourceVersion: number; // which version of the source this form derives from (DD-3)\n42\t  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n43\t  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\n44\t  derivedAt?: string;\n45\t}\n46\t\n47\t// One tool call's or result's receipt within a turn's composed account\n48\t// (AC-3.8): the account text — what changed, as composed — plus the\n49\t// mechanically derived outcome. Derived from the composition input, never\n50\t// from provider prose; stamped on the turn_rendering form so the chunk\n51\t// summaries can read receipts machine-readably in turn order.\n52\texport interface ToolRunReceipt {\n53\t  messageId: string;\n54\t  activity: \"tool_call\" | \"tool_result\";\n55\t  account: string;\n56\t  outcome: ToolOutcome;\n57\t}\n58\t\n59\t// Mechanically stamped form metadata: tool outcomes (AC-2.4), the turn\n60\t// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\n61\t// final attempts/last-error copied from the work item before its row is\n62\t// deleted (DD-1: the queue is not an audit table; durable outcome detail\n63\t// lives here).\n64\texport interface DerivedFormMetadata {\n65\t  outcome?: ToolOutcome;\n66\t  receipts?: ToolRunReceipt[];\n67\t  attempts?: number;\n68\t  lastError?: string;\n69\t}\n70\t\n71\t// One row of an owner's repair report (Flow 4): the form's durable state\n72\t// joined with the queue's mechanical detail for the live item still working\n73\t// toward it, if any. The five operational situations read from this one row:\n74\t// never-attempted (pending, no queue), retrying (pending + queue with\n75\t// attempts > 0), ready, failed (+ reason), blocked (+ reason) — no caller\n76\t// ever needs a queue API.\n77\texport interface FormReportEntry extends DerivedForm {\n78\t  queue?: {\n79\t    status: \"queued\" | \"claimed\";\n80\t    attempts: number;\n81\t    lastError?: string;\n82\t    eligibleAt?: string;\n83\t  };\n84\t}\n85\t\n86\t// ── provider seam (DD-7) ─────────────────────────────────────────\n87\t// Every operation returns content or a structured failure carrying\n88\t// retryable-or-not; classification is the adapter's duty.\n89\texport type ProviderResult =\n90\t  | { ok: true; text: string }\n91\t  | { ok: false; retryable: boolean; reason: string };\n92\t\n93\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n94\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n95\t// rather than imported: shared/ may not import domains/.\n96\texport type RenderingPartKind =\n97\t  | \"user_prompt\"\n98\t  | \"assistant_text\"\n99\t  | \"assistant_thinking\"\n100\t  | \"runtime_note\"\n101\t  | \"tool_call\"\n102\t  | \"tool_result\";\n103\t\n104\texport interface RenderingPart {\n105\t  messageId: string;\n106\t  kind: RenderingPartKind;\n107\t  text: string; // ready form content, or raw/truncated fallback\n108\t  fallback: boolean; // true ⇒ gap recorded\n109\t  outcome?: ToolOutcome; // tool activity only\n110\t}\n111\t\n112\texport interface DerivationProvider {\n113\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n114\t  summarizeToolCall(i: {\n115\t    toolName: string;\n116\t    argsJson: string;\n117\t    pairedResult?: { content: string; isError: boolean };\n118\t  }): Promise<ProviderResult>;\n119\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n120\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n121\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n122\t  // The two summary inputs differ by contract (AC-3.8): detailed receives\n123\t  // the members' tool-run receipts (what changed, outcome) alongside the\n124\t  // projections; brief receives outcomes only — receipt text is stripped\n125\t  // before the provider is called, so brief structurally cannot leak it.\n126\t  // The receipt fields are optional in the type for callers without member\n127\t  // context (the production chunk handlers always pass them).\n128\t  summarizeChunkDetailed(i: {\n129\t    memberProjections: string[];\n130\t    memberReceipts?: ToolRunReceipt[][];\n131\t  }): Promise<ProviderResult>;\n132\t  summarizeChunkBrief(i: {\n133\t    memberProjections: string[];\n134\t    memberOutcomes?: ToolOutcome[][];\n135\t  }): Promise<ProviderResult>;\n136\t}\n137\t\n138\texport const PROVIDER_OPERATIONS = [\n139\t  \"smoothPrompt\",\n140\t  \"summarizeToolCall\",\n141\t  \"summarizeToolResult\",\n142\t  \"composeTurnRendering\",\n143\t  \"projectLowerBand\",\n144\t  \"summarizeChunkDetailed\",\n145\t  \"summarizeChunkBrief\",\n146\t] as const;\n147\t\n148\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n149\t\n150\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n151\texport interface SdkConfig {\n152\t  provider: DerivationProvider;\n153\t  mode: \"background\" | \"manual\";\n154\t  clock?: () => Date;\n155\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n156\t  lease?: { durationMs: number }; // 120000\n157\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n158\t}\n159\t\n160\t// Every optional filled by createSdk's central defaults.\n161\texport interface ResolvedSdkConfig {\n162\t  provider: DerivationProvider;\n163\t  mode: \"background\" | \"manual\";\n164\t  clock: () => Date;\n165\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n166\t  lease: { durationMs: number };\n167\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n168\t}\n169\t\n170\t// ── handler contract (DD-6; the map's value type) ────────────────\n171\texport interface HandlerRunContext {\n172\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n173\t  provider: DerivationProvider;\n174\t  clock: () => Date;\n175\t  config: ResolvedSdkConfig;\n176\t}\n177\t\n178\t// A successful handler hands its derived-form content back as data; the\n179\t// drain's completion transaction performs the version-checked UPDATE and the\n180\t// item-row deletion atomically (tech design §Mechanics: completion is one\n181\t// short BEGIN IMMEDIATE doing the form write and the delete). The handler\n182\t// never opens that transaction itself, so the version check and the\n183\t// done/stale_discarded disposition stay in one place — the queue util.\n184\texport interface HandlerFormWrite {\n185\t  subjectKind: SubjectKind;\n186\t  subjectId: string;\n187\t  form: FormKind;\n188\t  content: string;\n189\t  metadata?: DerivedFormMetadata;\n190\t  gaps?: DependencyGap[];\n191\t}\n192\t\n193\t// The completion-transaction hook (Story 3): work that must land atomically\n194\t// with the version-checked form writes — chunk placement and the\n195\t// close→summary enqueues above all. The queue util invokes it inside the\n196\t// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\n197\t// (a stale completion must not place a turn or enqueue summaries); onCommit\n198\t// registrations flush after that COMMIT succeeds and drop on rollback, so a\n199\t// crash leaves either a placed turn with its enqueues or nothing — never a\n200\t// derived-but-unplaced turn.\n201\texport interface CompletionTx {\n202\t  db: DatabaseSync;\n203\t  onCommit: (fn: () => void) => void;\n204\t}\n205\t\n206\texport type HandlerOutcome =\n207\t  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\n208\t  | { ok: false; retryable: boolean; reason: string }\n209\t  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n210\t\n211\t// item is the queue util's WorkItemRecord; typed structurally here so the\n212\t// shared layer does not depend on the util's module (and vice versa stays\n213\t// one-directional: tech-utils imports shared).\n214\texport type WorkHandler = (\n215\t  run: HandlerRunContext,\n216\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n217\t) => Promise<HandlerOutcome>;\n218\t"}]},"parent_tool_use_id":null,"session_id":"1746f4bf-569a-4870-8bca-7c80d2cc25af","uuid":"45b5ea14-7907-4185-9600-f289e89a28cb","timestamp":"2026-06-11T08:01:02.364Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/derivation.ts","content":"// Epic 02 shared vocabulary: the derived-form state machine's types, the\n// provider seam, and the handler contract. Both owning domains (messages,\n// turns) consume these; neither owns them — the repair report, the mutation\n// cascade, and the drain all speak this vocabulary across domain lines, so it\n// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\nimport type { DatabaseSync } from \"node:sqlite\";\n\nexport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n\nexport type FormKind =\n  | \"smoothed_prompt\"\n  | \"tool_call_summary\"\n  | \"tool_result_summary\"\n  | \"turn_rendering\"\n  | \"lower_band_projection\"\n  | \"chunk_summary_detailed\"\n  | \"chunk_summary_brief\";\n\nexport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n\n// Outcome on tool-activity summaries — mechanically stamped from the record\n// (isError/presence), never authored by the provider (AC-2.4).\nexport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n\n// A composed form's record of a dependency that fell back during composition:\n// names the source record and the form that was not ready (AC-3.2/3.3).\nexport interface DependencyGap {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n}\n\n// The read shape for one derived form's state row (DD-2, DD-3).\nexport interface DerivedForm {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n  state: DerivedFormState;\n  content?: string; // ready only\n  reason?: string; // failed | blocked\n  sourceVersion: number; // which version of the source this form derives from (DD-3)\n  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\n  derivedAt?: string;\n}\n\n// One tool call's or result's receipt within a turn's composed account\n// (AC-3.8): the account text — what changed, as composed — plus the\n// mechanically derived outcome. Derived from the composition input, never\n// from provider prose; stamped on the turn_rendering form so the chunk\n// summaries can read receipts machine-readably in turn order.\nexport interface ToolRunReceipt {\n  messageId: string;\n  activity: \"tool_call\" | \"tool_result\";\n  account: string;\n  outcome: ToolOutcome;\n}\n\n// Mechanically stamped form metadata: tool outcomes (AC-2.4), the turn\n// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\n// final attempts/last-error copied from the work item before its row is\n// deleted (DD-1: the queue is not an audit table; durable outcome detail\n// lives here).\nexport interface DerivedFormMetadata {\n  outcome?: ToolOutcome;\n  receipts?: ToolRunReceipt[];\n  attempts?: number;\n  lastError?: string;\n}\n\n// One row of an owner's repair report (Flow 4): the form's durable state\n// joined with the queue's mechanical detail for the live item still working\n// toward it, if any. The five operational situations read from this one row:\n// never-attempted (pending, no queue), retrying (pending + queue with\n// attempts > 0), ready, failed (+ reason), blocked (+ reason) — no caller\n// ever needs a queue API.\nexport interface FormReportEntry extends DerivedForm {\n  queue?: {\n    status: \"queued\" | \"claimed\";\n    attempts: number;\n    lastError?: string;\n    eligibleAt?: string;\n  };\n}\n\n// ── provider seam (DD-7) ─────────────────────────────────────────\n// Every operation returns content or a structured failure carrying\n// retryable-or-not; classification is the adapter's duty.\nexport type ProviderResult =\n  | { ok: true; text: string }\n  | { ok: false; retryable: boolean; reason: string };\n\n// Message kinds a rendering part can carry — mirrors the intake event-kind\n// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n// rather than imported: shared/ may not import domains/.\nexport type RenderingPartKind =\n  | \"user_prompt\"\n  | \"assistant_text\"\n  | \"assistant_thinking\"\n  | \"runtime_note\"\n  | \"tool_call\"\n  | \"tool_result\";\n\nexport interface RenderingPart {\n  messageId: string;\n  kind: RenderingPartKind;\n  text: string; // ready form content, or raw/truncated fallback\n  fallback: boolean; // true ⇒ gap recorded\n  outcome?: ToolOutcome; // tool activity only\n}\n\nexport interface DerivationProvider {\n  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n  summarizeToolCall(i: {\n    toolName: string;\n    argsJson: string;\n    pairedResult?: { content: string; isError: boolean };\n  }): Promise<ProviderResult>;\n  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n  // The two summary inputs differ by contract (AC-3.8): detailed receives\n  // the members' tool-run receipts (what changed, outcome) alongside the\n  // projections; brief receives outcomes only — receipt text is stripped\n  // before the provider is called, so brief structurally cannot leak it.\n  // The receipt fields are optional in the type for callers without member\n  // context (the production chunk handlers always pass them).\n  summarizeChunkDetailed(i: {\n    memberProjections: string[];\n    memberReceipts?: ToolRunReceipt[][];\n  }): Promise<ProviderResult>;\n  summarizeChunkBrief(i: {\n    memberProjections: string[];\n    memberOutcomes?: ToolOutcome[][];\n  }): Promise<ProviderResult>;\n}\n\nexport const PROVIDER_OPERATIONS = [\n  \"smoothPrompt\",\n  \"summarizeToolCall\",\n  \"summarizeToolResult\",\n  \"composeTurnRendering\",\n  \"projectLowerBand\",\n  \"summarizeChunkDetailed\",\n  \"summarizeChunkBrief\",\n] as const;\n\nexport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n\n// ── SDK assembly config (tech design §Interfaces) ────────────────\nexport interface SdkConfig {\n  provider: DerivationProvider;\n  mode: \"background\" | \"manual\";\n  clock?: () => Date;\n  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n  lease?: { durationMs: number }; // 120000\n  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n}\n\n// Every optional filled by createSdk's central defaults.\nexport interface ResolvedSdkConfig {\n  provider: DerivationProvider;\n  mode: \"background\" | \"manual\";\n  clock: () => Date;\n  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n  lease: { durationMs: number };\n  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n}\n\n// ── handler contract (DD-6; the map's value type) ────────────────\nexport interface HandlerRunContext {\n  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n  provider: DerivationProvider;\n  clock: () => Date;\n  config: ResolvedSdkConfig;\n}\n\n// A successful handler hands its derived-form content back as data; the\n// drain's completion transaction performs the version-checked UPDATE and the\n// item-row deletion atomically (tech design §Mechanics: completion is one\n// short BEGIN IMMEDIATE doing the form write and the delete). The handler\n// never opens that transaction itself, so the version check and the\n// done/stale_discarded disposition stay in one place — the queue util.\nexport interface HandlerFormWrite {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n  content: string;\n  metadata?: DerivedFormMetadata;\n  gaps?: DependencyGap[];\n}\n\n// The completion-transaction hook (Story 3): work that must land atomically\n// with the version-checked form writes — chunk placement and the\n// close→summary enqueues above all. The queue util invokes it inside the\n// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\n// (a stale completion must not place a turn or enqueue summaries); onCommit\n// registrations flush after that COMMIT succeeds and drop on rollback, so a\n// crash leaves either a placed turn with its enqueues or nothing — never a\n// derived-but-unplaced turn.\nexport interface CompletionTx {\n  db: DatabaseSync;\n  onCommit: (fn: () => void) => void;\n}\n\nexport type HandlerOutcome =\n  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\n  | { ok: false; retryable: boolean; reason: string }\n  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n\n// item is the queue util's WorkItemRecord; typed structurally here so the\n// shared layer does not depend on the util's module (and vice versa stays\n// one-directional: tech-utils imports shared).\nexport type WorkHandler = (\n  run: HandlerRunContext,\n  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n) => Promise<HandlerOutcome>;\n","numLines":218,"startLine":1,"totalLines":218}}}

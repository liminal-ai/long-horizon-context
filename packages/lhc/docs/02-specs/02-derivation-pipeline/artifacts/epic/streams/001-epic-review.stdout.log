{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ArqYBqa47b439BnDY87SUG","type":"tool_result","content":"1\t// The named-provider registry (DD-11). SDK hosts inject a provider at\n2\t// createSdk; the CLI — which has no construction step — resolves one here\n3\t// from `--provider <name>` or LHC_PROVIDER. No default: a provider-needing\n4\t// command without a resolvable name fails with provider_not_configured,\n5\t// never a silent no-op.\n6\timport type { DerivationProvider } from \"../shared/derivation.js\";\n7\timport { createDeterministicProvider } from \"./deterministic.js\";\n8\t\n9\tconst REGISTRY: Record<string, () => DerivationProvider> = {\n10\t  deterministic: createDeterministicProvider,\n11\t};\n12\t\n13\texport function resolveNamedProvider(name: string): DerivationProvider | undefined {\n14\t  return REGISTRY[name]?.();\n15\t}\n16\t\n17\texport function registeredProviderNames(): string[] {\n18\t  return Object.keys(REGISTRY);\n19\t}\n20\t"}]},"parent_tool_use_id":null,"session_id":"1746f4bf-569a-4870-8bca-7c80d2cc25af","uuid":"e5b989ee-5da8-464d-8904-82b4082e4ca3","timestamp":"2026-06-11T08:01:27.404Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/providers/registry.ts","content":"// The named-provider registry (DD-11). SDK hosts inject a provider at\n// createSdk; the CLI — which has no construction step — resolves one here\n// from `--provider <name>` or LHC_PROVIDER. No default: a provider-needing\n// command without a resolvable name fails with provider_not_configured,\n// never a silent no-op.\nimport type { DerivationProvider } from \"../shared/derivation.js\";\nimport { createDeterministicProvider } from \"./deterministic.js\";\n\nconst REGISTRY: Record<string, () => DerivationProvider> = {\n  deterministic: createDeterministicProvider,\n};\n\nexport function resolveNamedProvider(name: string): DerivationProvider | undefined {\n  return REGISTRY[name]?.();\n}\n\nexport function registeredProviderNames(): string[] {\n  return Object.keys(REGISTRY);\n}\n","numLines":20,"startLine":1,"totalLines":20}}}

{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/derivation.ts | sed -n '1,280p'\"","aggregated_output":"     1\t// Epic 02 shared vocabulary: the derived-form state machine's types, the\n     2\t// provider seam, and the handler contract. Both owning domains (messages,\n     3\t// turns) consume these; neither owns them — the repair report, the mutation\n     4\t// cascade, and the drain all speak this vocabulary across domain lines, so it\n     5\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\n     6\timport type { DatabaseSync } from \"node:sqlite\";\n     7\t\n     8\texport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n     9\t\n    10\texport type FormKind =\n    11\t  | \"smoothed_prompt\"\n    12\t  | \"tool_call_summary\"\n    13\t  | \"tool_result_summary\"\n    14\t  | \"turn_rendering\"\n    15\t  | \"lower_band_projection\"\n    16\t  | \"chunk_summary_detailed\"\n    17\t  | \"chunk_summary_brief\";\n    18\t\n    19\texport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n    20\t\n    21\t// Outcome on tool-activity summaries — mechanically stamped from the record\n    22\t// (isError/presence), never authored by the provider (AC-2.4).\n    23\texport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n    24\t\n    25\t// A composed form's record of a dependency that fell back during composition:\n    26\t// names the source record and the form that was not ready (AC-3.2/3.3).\n    27\texport interface DependencyGap {\n    28\t  subjectKind: SubjectKind;\n    29\t  subjectId: string;\n    30\t  form: FormKind;\n    31\t}\n    32\t\n    33\t// The read shape for one derived form's state row (DD-2, DD-3).\n    34\texport interface DerivedForm {\n    35\t  subjectKind: SubjectKind;\n    36\t  subjectId: string;\n    37\t  form: FormKind;\n    38\t  state: DerivedFormState;\n    39\t  content?: string; // ready only\n    40\t  reason?: string; // failed | blocked\n    41\t  sourceVersion: number; // which version of the source this form derives from (DD-3)\n    42\t  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n    43\t  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\n    44\t  derivedAt?: string;\n    45\t}\n    46\t\n    47\t// One tool call's or result's receipt within a turn's composed account\n    48\t// (AC-3.8): the account text — what changed, as composed — plus the\n    49\t// mechanically derived outcome. Derived from the composition input, never\n    50\t// from provider prose; stamped on the turn_rendering form so the chunk\n    51\t// summaries can read receipts machine-readably in turn order.\n    52\texport interface ToolRunReceipt {\n    53\t  messageId: string;\n    54\t  activity: \"tool_call\" | \"tool_result\";\n    55\t  account: string;\n    56\t  outcome: ToolOutcome;\n    57\t}\n    58\t\n    59\t// Mechanically stamped form metadata: tool outcomes (AC-2.4), the turn\n    60\t// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\n    61\t// final attempts/last-error copied from the work item before its row is\n    62\t// deleted (DD-1: the queue is not an audit table; durable outcome detail\n    63\t// lives here).\n    64\texport interface DerivedFormMetadata {\n    65\t  outcome?: ToolOutcome;\n    66\t  receipts?: ToolRunReceipt[];\n    67\t  attempts?: number;\n    68\t  lastError?: string;\n    69\t}\n    70\t\n    71\t// One row of an owner's repair report (Flow 4): the form's durable state\n    72\t// joined with the queue's mechanical detail for the live item still working\n    73\t// toward it, if any. The five operational situations read from this one row:\n    74\t// never-attempted (pending, no queue), retrying (pending + queue with\n    75\t// attempts > 0), ready, failed (+ reason), blocked (+ reason) — no caller\n    76\t// ever needs a queue API.\n    77\texport interface FormReportEntry extends DerivedForm {\n    78\t  queue?: {\n    79\t    status: \"queued\" | \"claimed\";\n    80\t    attempts: number;\n    81\t    lastError?: string;\n    82\t    eligibleAt?: string;\n    83\t  };\n    84\t}\n    85\t\n    86\t// ── provider seam (DD-7) ─────────────────────────────────────────\n    87\t// Every operation returns content or a structured failure carrying\n    88\t// retryable-or-not; classification is the adapter's duty.\n    89\texport type ProviderResult =\n    90\t  | { ok: true; text: string }\n    91\t  | { ok: false; retryable: boolean; reason: string };\n    92\t\n    93\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n    94\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n    95\t// rather than imported: shared/ may not import domains/.\n    96\texport type RenderingPartKind =\n    97\t  | \"user_prompt\"\n    98\t  | \"assistant_text\"\n    99\t  | \"assistant_thinking\"\n   100\t  | \"runtime_note\"\n   101\t  | \"tool_call\"\n   102\t  | \"tool_result\";\n   103\t\n   104\texport interface RenderingPart {\n   105\t  messageId: string;\n   106\t  kind: RenderingPartKind;\n   107\t  text: string; // ready form content, or raw/truncated fallback\n   108\t  fallback: boolean; // true ⇒ gap recorded\n   109\t  outcome?: ToolOutcome; // tool activity only\n   110\t}\n   111\t\n   112\texport interface DerivationProvider {\n   113\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n   114\t  summarizeToolCall(i: {\n   115\t    toolName: string;\n   116\t    argsJson: string;\n   117\t    pairedResult?: { content: string; isError: boolean };\n   118\t  }): Promise<ProviderResult>;\n   119\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n   120\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n   121\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n   122\t  // The two summary inputs differ by contract (AC-3.8): detailed receives\n   123\t  // the members' tool-run receipts (what changed, outcome) alongside the\n   124\t  // projections; brief receives outcomes only — receipt text is stripped\n   125\t  // before the provider is called, so brief structurally cannot leak it.\n   126\t  // The receipt fields are optional in the type for callers without member\n   127\t  // context (the production chunk handlers always pass them).\n   128\t  summarizeChunkDetailed(i: {\n   129\t    memberProjections: string[];\n   130\t    memberReceipts?: ToolRunReceipt[][];\n   131\t  }): Promise<ProviderResult>;\n   132\t  summarizeChunkBrief(i: {\n   133\t    memberProjections: string[];\n   134\t    memberOutcomes?: ToolOutcome[][];\n   135\t  }): Promise<ProviderResult>;\n   136\t}\n   137\t\n   138\texport const PROVIDER_OPERATIONS = [\n   139\t  \"smoothPrompt\",\n   140\t  \"summarizeToolCall\",\n   141\t  \"summarizeToolResult\",\n   142\t  \"composeTurnRendering\",\n   143\t  \"projectLowerBand\",\n   144\t  \"summarizeChunkDetailed\",\n   145\t  \"summarizeChunkBrief\",\n   146\t] as const;\n   147\t\n   148\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n   149\t\n   150\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n   151\texport interface SdkConfig {\n   152\t  provider: DerivationProvider;\n   153\t  mode: \"background\" | \"manual\";\n   154\t  clock?: () => Date;\n   155\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n   156\t  lease?: { durationMs: number }; // 120000\n   157\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n   158\t}\n   159\t\n   160\t// Every optional filled by createSdk's central defaults.\n   161\texport interface ResolvedSdkConfig {\n   162\t  provider: DerivationProvider;\n   163\t  mode: \"background\" | \"manual\";\n   164\t  clock: () => Date;\n   165\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n   166\t  lease: { durationMs: number };\n   167\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n   168\t}\n   169\t\n   170\t// ── handler contract (DD-6; the map's value type) ────────────────\n   171\texport interface HandlerRunContext {\n   172\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n   173\t  provider: DerivationProvider;\n   174\t  clock: () => Date;\n   175\t  config: ResolvedSdkConfig;\n   176\t}\n   177\t\n   178\t// A successful handler hands its derived-form content back as data; the\n   179\t// drain's completion transaction performs the version-checked UPDATE and the\n   180\t// item-row deletion atomically (tech design §Mechanics: completion is one\n   181\t// short BEGIN IMMEDIATE doing the form write and the delete). The handler\n   182\t// never opens that transaction itself, so the version check and the\n   183\t// done/stale_discarded disposition stay in one place — the queue util.\n   184\texport interface HandlerFormWrite {\n   185\t  subjectKind: SubjectKind;\n   186\t  subjectId: string;\n   187\t  form: FormKind;\n   188\t  content: string;\n   189\t  metadata?: DerivedFormMetadata;\n   190\t  gaps?: DependencyGap[];\n   191\t}\n   192\t\n   193\t// The completion-transaction hook (Story 3): work that must land atomically\n   194\t// with the version-checked form writes — chunk placement and the\n   195\t// close→summary enqueues above all. The queue util invokes it inside the\n   196\t// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\n   197\t// (a stale completion must not place a turn or enqueue summaries); onCommit\n   198\t// registrations flush after that COMMIT succeeds and drop on rollback, so a\n   199\t// crash leaves either a placed turn with its enqueues or nothing — never a\n   200\t// derived-but-unplaced turn.\n   201\texport interface CompletionTx {\n   202\t  db: DatabaseSync;\n   203\t  onCommit: (fn: () => void) => void;\n   204\t}\n   205\t\n   206\texport type HandlerOutcome =\n   207\t  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\n   208\t  | { ok: false; retryable: boolean; reason: string }\n   209\t  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n   210\t\n   211\t// item is the queue util's WorkItemRecord; typed structurally here so the\n   212\t// shared layer does not depend on the util's module (and vice versa stays\n   213\t// one-directional: tech-utils imports shared).\n   214\texport type WorkHandler = (\n   215\t  run: HandlerRunContext,\n   216\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n   217\t) => Promise<HandlerOutcome>;\n","exit_code":0,"status":"completed"}}

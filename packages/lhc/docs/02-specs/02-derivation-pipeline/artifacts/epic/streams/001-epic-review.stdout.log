{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SU6c39fQbucT15V2n6MWVP","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n3\timport type {\n4\t  FormKind,\n5\t  FormReportEntry,\n6\t  WorkHandler,\n7\t} from \"../../shared/derivation.js\";\n8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n9\timport {\n10\t  enqueue,\n11\t  hasLiveItem,\n12\t  listItems,\n13\t  type EnqueueFormTarget,\n14\t  type WorkItemRecord,\n15\t  type WorkKind,\n16\t  type WorkSourceRef,\n17\t} from \"../../tech-utils/work-queue/index.js\";\n18\timport type { EventKind } from \"../intake-stream/index.js\";\n19\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n20\timport { transition } from \"./internal/state-machine.js\";\n21\t\n22\t// The pure rule table, re-exported for the golden supplemental suite (the\n23\t// test plan's one sanctioned direct entry besides the tokenizer); production\n24\t// callers go through applyEvent.\n25\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n26\timport type { DerivedForm } from \"../../shared/derivation.js\";\n27\timport { turnWorkHandlers } from \"./internal/derive.js\";\n28\timport {\n29\t  readChunkRows,\n30\t  readOwnedForms,\n31\t  readTurnFormRow,\n32\t  reportTurnForms,\n33\t} from \"./internal/forms.js\";\n34\timport {\n35\t  applyTurnDeleteCascade,\n36\t  type MutationResult,\n37\t} from \"../messages/index.js\";\n38\timport {\n39\t  closeTurn,\n40\t  insertOpenTurn,\n41\t  markTurnDeleted,\n42\t  nextTurnOrder,\n43\t  readMutableTurn,\n44\t  readTurns,\n45\t  selectOpenTurnIds,\n46\t} from \"./internal/store.js\";\n47\t\n48\texport interface TurnRecord {\n49\t  turnId: string;\n50\t  status: \"open\" | \"closed\";\n51\t  memberMessageIds: string[];\n52\t  openedAtEventOrder: number;\n53\t  closedAtEventOrder?: number;\n54\t  // Chunk placement (Epic 02 Story 3, AC-3.5): present once the turn's\n55\t  // derivation placed it — stored values read back, never recomputed.\n56\t  chunkId?: string;\n57\t  memberIdx?: number;\n58\t  // The turn's derived forms as stored (Epic 02 Story 4, AC-4.7 ruling 012):\n59\t  // present only when rows exist — a closed turn carries them from the\n60\t  // moment its derivation queues. Stored state returned verbatim, mirroring\n61\t  // the message read's forms key; reads degrade, never block.\n62\t  forms?: DerivedForm[];\n63\t}\n64\t\n65\t// Chunk read-back (Epic 02 Story 4, AC-4.7 ruling 012): the stored chunk\n66\t// record with live membership and its summary forms' states attached —\n67\t// the chunk leg of \"reading a message, turn, or chunk returns the record\n68\t// with form states\".\n69\texport interface ChunkRecord {\n70\t  chunkId: string;\n71\t  chunkOrder: number;\n72\t  status: \"open\" | \"closed\";\n73\t  accumulatedProjectedTokens: number;\n74\t  memberTurnIds: string[];\n75\t  forms?: DerivedForm[];\n76\t}\n77\t\n78\texport interface TurnTransitionOutcome {\n79\t  // Transitions in occurrence order: a close_then_open reports the close\n80\t  // first, then the open, exactly as the batch result surfaces them.\n81\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n82\t  // Turn state after the transition — the stamp for this event's message.\n83\t  // Prompts see the turn they just opened (transition first, then stamp);\n84\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n85\t  openTurnId: string | null;\n86\t  // Work queued by this transition: one turn_derivation item per closed\n87\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\n88\t  queuedWork: WorkItemRecord[];\n89\t}\n90\t\n91\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n92\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n93\t// writes turn state, so more than one open turn means external interference.\n94\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n95\t  return selectOpenTurnIds(ctx.db);\n96\t}\n97\t\n98\t// Closing a turn — by either close path — durably queues that turn's\n99\t// derivation work in the same transaction (AC-3.6): the close update and the\n100\t// work item commit or roll back together.\n101\tfunction closeTurnAndQueueWork(\n102\t  ctx: OperationContext,\n103\t  turnId: string,\n104\t  eventOrder: number,\n105\t): WorkItemRecord {\n106\t  closeTurn(ctx.db, turnId, eventOrder);\n107\t  // One work item, two derived forms: the turn_derivation handler (Story 3)\n108\t  // lands the rendering and the lower-band projection as independent rows;\n109\t  // both go pending with the enqueue (DD-5).\n110\t  return enqueue(ctx, {\n111\t    owner: \"turns\",\n112\t    kind: \"turn_derivation\",\n113\t    sourceRef: { turnId },\n114\t    forms: [\n115\t      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n116\t      { subjectKind: \"turn\", subjectId: turnId, form: \"lower_band_projection\" },\n117\t    ],\n118\t  });\n119\t}\n120\t\n121\t// Turn-owned work handlers, merged into the SDK's dispatch map at\n122\t// construction (DD-6): turn derivation and the two chunk summaries.\n123\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n124\t  turnWorkHandlers;\n125\t\n126\t// Cross-domain surface, called by intake-stream inside the batch transaction\n127\t// for every recorded event. Synchronous and throwing by design, like\n128\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n129\texport function applyEvent(\n130\t  ctx: OperationContext,\n131\t  eventKind: EventKind,\n132\t  eventOrder: number,\n133\t): TurnTransitionOutcome {\n134\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n135\t  const effect = transition({ openTurnId }, eventKind);\n136\t  switch (effect.kind) {\n137\t    case \"none\":\n138\t      return { transitions: [], openTurnId, queuedWork: [] };\n139\t    case \"open\": {\n140\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n141\t      return {\n142\t        transitions: [{ action: \"opened\", turnId }],\n143\t        openTurnId: turnId,\n144\t        queuedWork: [],\n145\t      };\n146\t    }\n147\t    case \"close\": {\n148\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n149\t      return {\n150\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n151\t        openTurnId: null,\n152\t        queuedWork: [item],\n153\t      };\n154\t    }\n155\t    case \"close_then_open\": {\n156\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n157\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n158\t      return {\n159\t        transitions: [\n160\t          { action: \"closed\", turnId: openTurnId as string },\n161\t          { action: \"opened\", turnId },\n162\t        ],\n163\t        openTurnId: turnId,\n164\t        queuedWork: [item],\n165\t      };\n166\t    }\n167\t  }\n168\t}\n169\t\n170\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n171\t  return {\n172\t    ok: false,\n173\t    error: {\n174\t      errorClass: \"caller_error\",\n175\t      code: \"thread_not_found\",\n176\t      reason: `no thread file exists at ${filePath}`,\n177\t    },\n178\t  };\n179\t}\n180\t\n181\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n182\t  const resolved = await resolveThreadRef(thread);\n183\t  if (!resolved.ok) return resolved;\n184\t  const { filePath } = resolved.value;\n185\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n186\t\n187\t  const opened = openThreadDatabase(filePath);\n188\t  if (!opened.ok) return opened;\n189\t  const db = opened.value;\n190\t  try {\n191\t    // Form read-back rides the turn read (AC-4.7): each record carries its\n192\t    // stored derived forms, attached from one grouped query — mirroring the\n193\t    // message read's production path for \"readable alongside the record\".\n194\t    const formsByTurn = readOwnedForms(db, \"turn\");\n195\t    const records = readTurns(db).map((record) => {\n196\t      const forms = formsByTurn.get(record.turnId);\n197\t      return forms === undefined ? record : { ...record, forms };\n198\t    });\n199\t    return { ok: true, value: records };\n200\t  } catch (cause) {\n201\t    const reason = cause instanceof Error ? cause.message : String(cause);\n202\t    return storageFailure(`turn read-back failed: ${reason}`);\n203\t  } finally {\n204\t    db.close();\n205\t  }\n206\t}\n207\t\n208\t// Chunk read-back with summary-form states attached (AC-4.7 ruling 012):\n209\t// returns stored records whatever the forms' states — reads degrade, never\n210\t// block. Forms attach only where rows exist (a freshly opened chunk has no\n211\t// summary rows until close queues them).\n212\texport async function listChunks(thread: ThreadRef): Promise<OpResult<ChunkRecord[]>> {\n213\t  const resolved = await resolveThreadRef(thread);\n214\t  if (!resolved.ok) return resolved;\n215\t  const { filePath } = resolved.value;\n216\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n217\t\n218\t  const opened = openThreadDatabase(filePath);\n219\t  if (!opened.ok) return opened;\n220\t  const db = opened.value;\n221\t  try {\n222\t    const formsByChunk = readOwnedForms(db, \"chunk\");\n223\t    const records: ChunkRecord[] = readChunkRows(db).map((row) => {\n224\t      const forms = formsByChunk.get(row.chunkId);\n225\t      return forms === undefined ? row : { ...row, forms };\n226\t    });\n227\t    return { ok: true, value: records };\n228\t  } catch (cause) {\n229\t    const reason = cause instanceof Error ? cause.message : String(cause);\n230\t    return storageFailure(`chunk read-back failed: ${reason}`);\n231\t  } finally {\n232\t    db.close();\n233\t  }\n234\t}\n235\t\n236\texport async function listQueuedWork(\n237\t  thread: ThreadRef,\n238\t): Promise<OpResult<WorkItemRecord[]>> {\n239\t  const resolved = await resolveThreadRef(thread);\n240\t  if (!resolved.ok) return resolved;\n241\t  const { filePath } = resolved.value;\n242\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n243\t\n244\t  const opened = openThreadDatabase(filePath);\n245\t  if (!opened.ok) return opened;\n246\t  const db = opened.value;\n247\t  try {\n248\t    return { ok: true, value: listItems(db, \"turns\") };\n249\t  } catch (cause) {\n250\t    const reason = cause instanceof Error ? cause.message : String(cause);\n251\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n252\t  } finally {\n253\t    db.close();\n254\t  }\n255\t}\n256\t\n257\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n258\t\n259\t// This owner's repair report: every turn- and chunk-owned form's durable\n260\t// state joined with live queue detail in one query. Needs no provider;\n261\t// reads degrade, never block.\n262\texport async function report(\n263\t  thread: ThreadRef,\n264\t  opts?: { notReady?: boolean; turnId?: string; chunkId?: string },\n265\t): Promise<OpResult<FormReportEntry[]>> {\n266\t  const resolved = await resolveThreadRef(thread);\n267\t  if (!resolved.ok) return resolved;\n268\t  const { filePath } = resolved.value;\n269\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n270\t\n271\t  const opened = openThreadDatabase(filePath);\n272\t  if (!opened.ok) return opened;\n273\t  const db = opened.value;\n274\t  try {\n275\t    return { ok: true, value: reportTurnForms(db, opts ?? {}) };\n276\t  } catch (cause) {\n277\t    const reason = cause instanceof Error ? cause.message : String(cause);\n278\t    return storageFailure(`report read failed: ${reason}`);\n279\t  } finally {\n280\t    db.close();\n281\t  }\n282\t}\n283\t\n284\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n285\t\n286\t// The queue site each turn-owned form rebuilds through. Both turn forms ride\n287\t// the one turn_derivation item (the handler lands rendering and projection\n288\t// together, so a rebuild of either re-derives both — the rebuild rule from\n289\t// Flow 3); each chunk summary rides its same-named kind alone (AC-3.8's\n290\t// independent lifecycles).\n291\tfunction turnRequeueTarget(target: {\n292\t  subjectKind: \"turn\" | \"chunk\";\n293\t  subjectId: string;\n294\t  form: FormKind;\n295\t}): { kind: WorkKind; sourceRef: WorkSourceRef; forms: EnqueueFormTarget[] } | undefined {\n296\t  if (\n297\t    target.subjectKind === \"turn\" &&\n298\t    (target.form === \"turn_rendering\" || target.form === \"lower_band_projection\")\n299\t  ) {\n300\t    return {\n301\t      kind: \"turn_derivation\",\n302\t      sourceRef: { turnId: target.subjectId },\n303\t      forms: [\n304\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"turn_rendering\" },\n305\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"lower_band_projection\" },\n306\t      ],\n307\t    };\n308\t  }\n309\t  if (\n310\t    target.subjectKind === \"chunk\" &&\n311\t    (target.form === \"chunk_summary_detailed\" || target.form === \"chunk_summary_brief\")\n312\t  ) {\n313\t    return {\n314\t      kind: target.form,\n315\t      sourceRef: { chunkId: target.subjectId },\n316\t      forms: [{ subjectKind: \"chunk\", subjectId: target.subjectId, form: target.form }],\n317\t    };\n318\t  }\n319\t  return undefined;\n320\t}\n321\t\n322\t// Explicit re-queue through the owning surface (AC-4.4): same contract as\n323\t// messages.requeue — blocked refused with the stored damage reason, missing\n324\t// rows refused, no-op against live work at the current source version, and\n325\t// the no-op check + enqueue in one transaction. A successful requeue rebuilds\n326\t// at the next source version: composed forms recompute their gaps from\n327\t// current dependency states (Flow 3's rebuild rule).\n328\texport async function requeue(\n329\t  thread: ThreadRef,\n330\t  target: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: FormKind },\n331\t): Promise<OpResult<RequeueOutcome>> {\n332\t  const mapped = turnRequeueTarget(target);\n333\t  if (mapped === undefined) {\n334\t    return {\n335\t      ok: false,\n336\t      error: {\n337\t        errorClass: \"caller_error\",\n338\t        code: \"turn_not_found\",\n339\t        reason: `form ${target.form} is not a ${target.subjectKind}-owned form; turns.requeue repairs turn_rendering and lower_band_projection (turn) or chunk_summary_detailed and chunk_summary_brief (chunk)`,\n340\t      },\n341\t    };\n342\t  }\n343\t  const resolved = await resolveThreadRef(thread);\n344\t  if (!resolved.ok) return resolved;\n345\t  const { filePath } = resolved.value;\n346\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n347\t\n348\t  const opened = openThreadDatabase(filePath);\n349\t  if (!opened.ok) return opened;\n350\t  const db = opened.value;\n351\t  try {\n352\t    const meta = db\n353\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n354\t      .get() as { thread_id: string } | undefined;\n355\t    const threadId = meta?.thread_id ?? \"\";\n356\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n357\t      const row = readTurnFormRow(ctx.db, target.subjectKind, target.subjectId, target.form);\n358\t      if (row === undefined) {\n359\t        return {\n360\t          ok: false,\n361\t          error: {\n362\t            errorClass: \"caller_error\",\n363\t            code: \"turn_not_found\",\n364\t            reason: `no derived form ${target.form} exists for ${target.subjectKind} ${target.subjectId}`,\n365\t          },\n366\t        };\n367\t      }\n368\t      if (row.state === \"blocked\") {\n369\t        // The refusal carries the form's stored reason — the damage named at\n370\t        // blocking time, not a generic string (AC-4.6).\n371\t        return {\n372\t          ok: false,\n373\t          error: {\n374\t            errorClass: \"state_corruption\",\n375\t            code: \"source_damaged\",\n376\t            reason:\n377\t              row.reason ??\n378\t              `form ${target.form} for ${target.subjectKind} ${target.subjectId} is blocked`,\n379\t          },\n380\t        };\n381\t      }\n382\t      if (hasLiveItem(ctx.db, mapped.kind, mapped.sourceRef, row.sourceVersion)) {\n383\t        return { ok: true, value: { noop: \"already_queued\" } };\n384\t      }\n385\t      const item = enqueue(ctx, {\n386\t        owner: \"turns\",\n387\t        kind: mapped.kind,\n388\t        sourceRef: mapped.sourceRef,\n389\t        sourceVersion: row.sourceVersion + 1,\n390\t        forms: mapped.forms,\n391\t      });\n392\t      return { ok: true, value: { workItemId: item.workItemId } };\n393\t    });\n394\t  } catch (cause) {\n395\t    const reason = cause instanceof Error ? cause.message : String(cause);\n396\t    return storageFailure(`requeue failed: ${reason}`);\n397\t  } finally {\n398\t    db.close();\n399\t  }\n400\t}\n401\t\n402\t// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\n403\t\n404\t// The whole-exchange removal (AC-6.4–6.7): \"that exchange was a dead end —\n405\t// kill it.\" One transaction stamps the turn and all its live member\n406\t// messages deleted, drops the turn's and members' derived forms, and\n407\t// re-queues the containing chunk's summaries from the remaining live\n408\t// members — or drops them when the chunk empties out (AC-6.6). The shared\n409\t// machinery is the messages domain's cascade module (DD-8, one cascade,\n410\t// two callers), reached through its public surface; this operation owns\n411\t// the turn-side validation and the turn-row stamp. Source events are never\n412\t// touched; chunk membership rows are never moved or re-cut — reads filter\n413\t// the deleted turn out, shrinking the chunk in place. Refusals read the\n414\t// filtered view: a missing, deleted, or double-deleted turn is\n415\t// turn_not_found; an open turn is turn_open; a refusal changes nothing.\n416\texport async function deleteTurn(\n417\t  thread: ThreadRef,\n418\t  input: { turnId: string },\n419\t): Promise<OpResult<MutationResult>> {\n420\t  const resolved = await resolveThreadRef(thread);\n421\t  if (!resolved.ok) return resolved;\n422\t  const { filePath } = resolved.value;\n423\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n424\t\n425\t  const opened = openThreadDatabase(filePath);\n426\t  if (!opened.ok) return opened;\n427\t  const db = opened.value;\n428\t  try {\n429\t    const meta = db\n430\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n431\t      .get() as { thread_id: string } | undefined;\n432\t    const threadId = meta?.thread_id ?? \"\";\n433\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n434\t      const target = readMutableTurn(ctx.db, input.turnId);\n435\t      if (target === undefined) {\n436\t        return {\n437\t          ok: false,\n438\t          error: {\n439\t            errorClass: \"caller_error\",\n440\t            code: \"turn_not_found\",\n441\t            reason: `no turn ${input.turnId} exists in this thread`,\n442\t          },\n443\t        };\n444\t      }\n445\t      if (target.status !== \"closed\") {\n446\t        return {\n447\t          ok: false,\n448\t          error: {\n449\t            errorClass: \"caller_error\",\n450\t            code: \"turn_open\",\n451\t            reason: `turn ${input.turnId} is open; open turns cannot be deleted (v1 boundary)`,\n452\t          },\n453\t        };\n454\t      }\n455\t      markTurnDeleted(ctx.db, input.turnId, ctx.clock().toISOString());\n456\t      const cascade = applyTurnDeleteCascade(ctx, input.turnId);\n457\t      return {\n458\t        ok: true,\n459\t        value: {\n460\t          changed: { messageIds: cascade.memberMessageIds, turnIds: [input.turnId] },\n461\t          cleared: cascade.cleared,\n462\t          dropped: cascade.dropped,\n463\t          queued: cascade.queued,\n464\t          superseded: cascade.superseded,\n465\t        },\n466\t      };\n467\t    });\n468\t  } catch (cause) {\n469\t    const reason = cause instanceof Error ? cause.message : String(cause);\n470\t    return storageFailure(`delete failed: ${reason}`);\n471\t  } finally {\n472\t    db.close();\n473\t  }\n474\t}\n475\t"}]},"parent_tool_use_id":null,"session_id":"1746f4bf-569a-4870-8bca-7c80d2cc25af","uuid":"165f3f3f-793f-40bf-a012-7e99bece9480","timestamp":"2026-06-11T08:02:51.237Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/index.ts","content":"import { existsSync } from \"node:fs\";\nimport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\nimport type {\n  FormKind,\n  FormReportEntry,\n  WorkHandler,\n} from \"../../shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  enqueue,\n  hasLiveItem,\n  listItems,\n  type EnqueueFormTarget,\n  type WorkItemRecord,\n  type WorkKind,\n  type WorkSourceRef,\n} from \"../../tech-utils/work-queue/index.js\";\nimport type { EventKind } from \"../intake-stream/index.js\";\nimport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\nimport { transition } from \"./internal/state-machine.js\";\n\n// The pure rule table, re-exported for the golden supplemental suite (the\n// test plan's one sanctioned direct entry besides the tokenizer); production\n// callers go through applyEvent.\nexport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\nimport type { DerivedForm } from \"../../shared/derivation.js\";\nimport { turnWorkHandlers } from \"./internal/derive.js\";\nimport {\n  readChunkRows,\n  readOwnedForms,\n  readTurnFormRow,\n  reportTurnForms,\n} from \"./internal/forms.js\";\nimport {\n  applyTurnDeleteCascade,\n  type MutationResult,\n} from \"../messages/index.js\";\nimport {\n  closeTurn,\n  insertOpenTurn,\n  markTurnDeleted,\n  nextTurnOrder,\n  readMutableTurn,\n  readTurns,\n  selectOpenTurnIds,\n} from \"./internal/store.js\";\n\nexport interface TurnRecord {\n  turnId: string;\n  status: \"open\" | \"closed\";\n  memberMessageIds: string[];\n  openedAtEventOrder: number;\n  closedAtEventOrder?: number;\n  // Chunk placement (Epic 02 Story 3, AC-3.5): present once the turn's\n  // derivation placed it — stored values read back, never recomputed.\n  chunkId?: string;\n  memberIdx?: number;\n  // The turn's derived forms as stored (Epic 02 Story 4, AC-4.7 ruling 012):\n  // present only when rows exist — a closed turn carries them from the\n  // moment its derivation queues. Stored state returned verbatim, mirroring\n  // the message read's forms key; reads degrade, never block.\n  forms?: DerivedForm[];\n}\n\n// Chunk read-back (Epic 02 Story 4, AC-4.7 ruling 012): the stored chunk\n// record with live membership and its summary forms' states attached —\n// the chunk leg of \"reading a message, turn, or chunk returns the record\n// with form states\".\nexport interface ChunkRecord {\n  chunkId: string;\n  chunkOrder: number;\n  status: \"open\" | \"closed\";\n  accumulatedProjectedTokens: number;\n  memberTurnIds: string[];\n  forms?: DerivedForm[];\n}\n\nexport interface TurnTransitionOutcome {\n  // Transitions in occurrence order: a close_then_open reports the close\n  // first, then the open, exactly as the batch result surfaces them.\n  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n  // Turn state after the transition — the stamp for this event's message.\n  // Prompts see the turn they just opened (transition first, then stamp);\n  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n  openTurnId: string | null;\n  // Work queued by this transition: one turn_derivation item per closed\n  // turn, by either close path (AC-3.6). Empty when nothing closed.\n  queuedWork: WorkItemRecord[];\n}\n\n// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n// IMMEDIATE and before any event is processed. Only the batch pipeline\n// writes turn state, so more than one open turn means external interference.\nexport function listOpenTurnIds(ctx: OperationContext): string[] {\n  return selectOpenTurnIds(ctx.db);\n}\n\n// Closing a turn — by either close path — durably queues that turn's\n// derivation work in the same transaction (AC-3.6): the close update and the\n// work item commit or roll back together.\nfunction closeTurnAndQueueWork(\n  ctx: OperationContext,\n  turnId: string,\n  eventOrder: number,\n): WorkItemRecord {\n  closeTurn(ctx.db, turnId, eventOrder);\n  // One work item, two derived forms: the turn_derivation handler (Story 3)\n  // lands the rendering and the lower-band projection as independent rows;\n  // both go pending with the enqueue (DD-5).\n  return enqueue(ctx, {\n    owner: \"turns\",\n    kind: \"turn_derivation\",\n    sourceRef: { turnId },\n    forms: [\n      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n      { subjectKind: \"turn\", subjectId: turnId, form: \"lower_band_projection\" },\n    ],\n  });\n}\n\n// Turn-owned work handlers, merged into the SDK's dispatch map at\n// construction (DD-6): turn derivation and the two chunk summaries.\nexport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n  turnWorkHandlers;\n\n// Cross-domain surface, called by intake-stream inside the batch transaction\n// for every recorded event. Synchronous and throwing by design, like\n// messages.createFromEvent: a turn-storage failure rejects the whole batch.\nexport function applyEvent(\n  ctx: OperationContext,\n  eventKind: EventKind,\n  eventOrder: number,\n): TurnTransitionOutcome {\n  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n  const effect = transition({ openTurnId }, eventKind);\n  switch (effect.kind) {\n    case \"none\":\n      return { transitions: [], openTurnId, queuedWork: [] };\n    case \"open\": {\n      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n      return {\n        transitions: [{ action: \"opened\", turnId }],\n        openTurnId: turnId,\n        queuedWork: [],\n      };\n    }\n    case \"close\": {\n      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n      return {\n        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n        openTurnId: null,\n        queuedWork: [item],\n      };\n    }\n    case \"close_then_open\": {\n      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n      return {\n        transitions: [\n          { action: \"closed\", turnId: openTurnId as string },\n          { action: \"opened\", turnId },\n        ],\n        openTurnId: turnId,\n        queuedWork: [item],\n      };\n    }\n  }\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nexport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    // Form read-back rides the turn read (AC-4.7): each record carries its\n    // stored derived forms, attached from one grouped query — mirroring the\n    // message read's production path for \"readable alongside the record\".\n    const formsByTurn = readOwnedForms(db, \"turn\");\n    const records = readTurns(db).map((record) => {\n      const forms = formsByTurn.get(record.turnId);\n      return forms === undefined ? record : { ...record, forms };\n    });\n    return { ok: true, value: records };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`turn read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\n// Chunk read-back with summary-form states attached (AC-4.7 ruling 012):\n// returns stored records whatever the forms' states — reads degrade, never\n// block. Forms attach only where rows exist (a freshly opened chunk has no\n// summary rows until close queues them).\nexport async function listChunks(thread: ThreadRef): Promise<OpResult<ChunkRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const formsByChunk = readOwnedForms(db, \"chunk\");\n    const records: ChunkRecord[] = readChunkRows(db).map((row) => {\n      const forms = formsByChunk.get(row.chunkId);\n      return forms === undefined ? row : { ...row, forms };\n    });\n    return { ok: true, value: records };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`chunk read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport async function listQueuedWork(\n  thread: ThreadRef,\n): Promise<OpResult<WorkItemRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: listItems(db, \"turns\") };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`queued-work read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n\n// This owner's repair report: every turn- and chunk-owned form's durable\n// state joined with live queue detail in one query. Needs no provider;\n// reads degrade, never block.\nexport async function report(\n  thread: ThreadRef,\n  opts?: { notReady?: boolean; turnId?: string; chunkId?: string },\n): Promise<OpResult<FormReportEntry[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: reportTurnForms(db, opts ?? {}) };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`report read failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n\n// The queue site each turn-owned form rebuilds through. Both turn forms ride\n// the one turn_derivation item (the handler lands rendering and projection\n// together, so a rebuild of either re-derives both — the rebuild rule from\n// Flow 3); each chunk summary rides its same-named kind alone (AC-3.8's\n// independent lifecycles).\nfunction turnRequeueTarget(target: {\n  subjectKind: \"turn\" | \"chunk\";\n  subjectId: string;\n  form: FormKind;\n}): { kind: WorkKind; sourceRef: WorkSourceRef; forms: EnqueueFormTarget[] } | undefined {\n  if (\n    target.subjectKind === \"turn\" &&\n    (target.form === \"turn_rendering\" || target.form === \"lower_band_projection\")\n  ) {\n    return {\n      kind: \"turn_derivation\",\n      sourceRef: { turnId: target.subjectId },\n      forms: [\n        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"turn_rendering\" },\n        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"lower_band_projection\" },\n      ],\n    };\n  }\n  if (\n    target.subjectKind === \"chunk\" &&\n    (target.form === \"chunk_summary_detailed\" || target.form === \"chunk_summary_brief\")\n  ) {\n    return {\n      kind: target.form,\n      sourceRef: { chunkId: target.subjectId },\n      forms: [{ subjectKind: \"chunk\", subjectId: target.subjectId, form: target.form }],\n    };\n  }\n  return undefined;\n}\n\n// Explicit re-queue through the owning surface (AC-4.4): same contract as\n// messages.requeue — blocked refused with the stored damage reason, missing\n// rows refused, no-op against live work at the current source version, and\n// the no-op check + enqueue in one transaction. A successful requeue rebuilds\n// at the next source version: composed forms recompute their gaps from\n// current dependency states (Flow 3's rebuild rule).\nexport async function requeue(\n  thread: ThreadRef,\n  target: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: FormKind },\n): Promise<OpResult<RequeueOutcome>> {\n  const mapped = turnRequeueTarget(target);\n  if (mapped === undefined) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"caller_error\",\n        code: \"turn_not_found\",\n        reason: `form ${target.form} is not a ${target.subjectKind}-owned form; turns.requeue repairs turn_rendering and lower_band_projection (turn) or chunk_summary_detailed and chunk_summary_brief (chunk)`,\n      },\n    };\n  }\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const meta = db\n      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n      .get() as { thread_id: string } | undefined;\n    const threadId = meta?.thread_id ?? \"\";\n    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n      const row = readTurnFormRow(ctx.db, target.subjectKind, target.subjectId, target.form);\n      if (row === undefined) {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"turn_not_found\",\n            reason: `no derived form ${target.form} exists for ${target.subjectKind} ${target.subjectId}`,\n          },\n        };\n      }\n      if (row.state === \"blocked\") {\n        // The refusal carries the form's stored reason — the damage named at\n        // blocking time, not a generic string (AC-4.6).\n        return {\n          ok: false,\n          error: {\n            errorClass: \"state_corruption\",\n            code: \"source_damaged\",\n            reason:\n              row.reason ??\n              `form ${target.form} for ${target.subjectKind} ${target.subjectId} is blocked`,\n          },\n        };\n      }\n      if (hasLiveItem(ctx.db, mapped.kind, mapped.sourceRef, row.sourceVersion)) {\n        return { ok: true, value: { noop: \"already_queued\" } };\n      }\n      const item = enqueue(ctx, {\n        owner: \"turns\",\n        kind: mapped.kind,\n        sourceRef: mapped.sourceRef,\n        sourceVersion: row.sourceVersion + 1,\n        forms: mapped.forms,\n      });\n      return { ok: true, value: { workItemId: item.workItemId } };\n    });\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`requeue failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\n\n// The whole-exchange removal (AC-6.4–6.7): \"that exchange was a dead end —\n// kill it.\" One transaction stamps the turn and all its live member\n// messages deleted, drops the turn's and members' derived forms, and\n// re-queues the containing chunk's summaries from the remaining live\n// members — or drops them when the chunk empties out (AC-6.6). The shared\n// machinery is the messages domain's cascade module (DD-8, one cascade,\n// two callers), reached through its public surface; this operation owns\n// the turn-side validation and the turn-row stamp. Source events are never\n// touched; chunk membership rows are never moved or re-cut — reads filter\n// the deleted turn out, shrinking the chunk in place. Refusals read the\n// filtered view: a missing, deleted, or double-deleted turn is\n// turn_not_found; an open turn is turn_open; a refusal changes nothing.\nexport async function deleteTurn(\n  thread: ThreadRef,\n  input: { turnId: string },\n): Promise<OpResult<MutationResult>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const meta = db\n      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n      .get() as { thread_id: string } | undefined;\n    const threadId = meta?.thread_id ?? \"\";\n    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n      const target = readMutableTurn(ctx.db, input.turnId);\n      if (target === undefined) {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"turn_not_found\",\n            reason: `no turn ${input.turnId} exists in this thread`,\n          },\n        };\n      }\n      if (target.status !== \"closed\") {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"turn_open\",\n            reason: `turn ${input.turnId} is open; open turns cannot be deleted (v1 boundary)`,\n          },\n        };\n      }\n      markTurnDeleted(ctx.db, input.turnId, ctx.clock().toISOString());\n      const cascade = applyTurnDeleteCascade(ctx, input.turnId);\n      return {\n        ok: true,\n        value: {\n          changed: { messageIds: cascade.memberMessageIds, turnIds: [input.turnId] },\n          cleared: cascade.cleared,\n          dropped: cascade.dropped,\n          queued: cascade.queued,\n          superseded: cascade.superseded,\n        },\n      };\n    });\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`delete failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":475,"startLine":1,"totalLines":475}}}

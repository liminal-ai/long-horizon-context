{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/chunks.ts | sed -n '1,240p'\"","aggregated_output":"     1\t// Chunk mechanics (Flow 3, DD-9): open-chunk append, the accumulated close\n     2\t// policy, and the close→summary enqueues. Placement is pure arithmetic over\n     3\t// stored projected token counts — the caller hands in the incoming turn's\n     4\t// count, the open chunk carries its accumulated count durably — so identical\n     5\t// streams re-chunk identically (AC-3.9): no clock, no inference, no\n     6\t// re-estimation at placement time. Everything here runs inside the\n     7\t// turn-derivation completion transaction; a crash leaves either a placed\n     8\t// turn (with any close's summary enqueues) or nothing.\n     9\timport type { DatabaseSync } from \"node:sqlite\";\n    10\timport type { OperationContext } from \"../../../shared/context.js\";\n    11\timport { enqueue, type WorkItemRecord } from \"../../../tech-utils/work-queue/index.js\";\n    12\t\n    13\texport interface ChunkPolicy {\n    14\t  targetProjectedTokens: number;\n    15\t  maxProjectedTokens: number;\n    16\t}\n    17\t\n    18\texport interface PlacementResult {\n    19\t  chunkId: string;\n    20\t  memberIdx: number;\n    21\t  // Chunks closed by this placement, in close order: at most the previous\n    22\t  // open chunk (accumulation rule) and then the incoming turn's own chunk\n    23\t  // (max rule) — a turn ≥ max arriving behind an open chunk closes both.\n    24\t  closedChunkIds: string[];\n    25\t  // An explicitly rebuilt turn keeps its placement (membership shrinks only\n    26\t  // through Story 6's sanctioned mutation, never re-cuts): a turn already a\n    27\t  // member is left exactly where it is and nothing closes.\n    28\t  alreadyPlaced: boolean;\n    29\t}\n    30\t\n    31\tinterface OpenChunkRow {\n    32\t  chunk_id: string;\n    33\t  accumulated_projected_tokens: number | bigint;\n    34\t}\n    35\t\n    36\tfunction memberCount(db: DatabaseSync, chunkId: string): number {\n    37\t  const row = db\n    38\t    .prepare(`SELECT COUNT(*) AS n FROM chunk_member WHERE chunk_id = ?`)\n    39\t    .get(chunkId) as unknown as { n: number | bigint };\n    40\t  return Number(row.n);\n    41\t}\n    42\t\n    43\tfunction closeChunk(db: DatabaseSync, chunkId: string): void {\n    44\t  db.prepare(`UPDATE chunk SET status = 'closed' WHERE chunk_id = ?`).run(chunkId);\n    45\t}\n    46\t\n    47\tfunction openNextChunk(db: DatabaseSync): string {\n    48\t  const row = db.prepare(`SELECT MAX(chunk_order) AS max_order FROM chunk`).get() as\n    49\t    | { max_order: number | bigint | null }\n    50\t    | undefined;\n    51\t  const order = Number(row?.max_order ?? 0) + 1;\n    52\t  const chunkId = `c${order}`;\n    53\t  db.prepare(\n    54\t    `INSERT INTO chunk (chunk_id, chunk_order, status, accumulated_projected_tokens)\n    55\t     VALUES (?, ?, 'open', 0)`,\n    56\t  ).run(chunkId, order);\n    57\t  return chunkId;\n    58\t}\n    59\t\n    60\t// The close policy, golden cases exact (DD-9): when the open chunk's\n    61\t// accumulated count plus the incoming turn's would reach the target\n    62\t// (inclusive — equality closes), the chunk closes holding its current\n    63\t// members and the incoming turn opens the next chunk; a single projection\n    64\t// ≥ max closes its own chunk immediately. An empty open chunk always accepts\n    65\t// the incoming turn — a chunk never closes empty.\n    66\texport function placeTurn(\n    67\t  db: DatabaseSync,\n    68\t  turnId: string,\n    69\t  projectedTokens: number,\n    70\t  policy: ChunkPolicy,\n    71\t): PlacementResult {\n    72\t  const existing = db\n    73\t    .prepare(`SELECT chunk_id, member_idx FROM chunk_member WHERE turn_id = ?`)\n    74\t    .get(turnId) as unknown as { chunk_id: string; member_idx: number | bigint } | undefined;\n    75\t  if (existing !== undefined) {\n    76\t    return {\n    77\t      chunkId: existing.chunk_id,\n    78\t      memberIdx: Number(existing.member_idx),\n    79\t      closedChunkIds: [],\n    80\t      alreadyPlaced: true,\n    81\t    };\n    82\t  }\n    83\t\n    84\t  const closedChunkIds: string[] = [];\n    85\t  let open = db\n    86\t    .prepare(\n    87\t      `SELECT chunk_id, accumulated_projected_tokens FROM chunk\n    88\t       WHERE status = 'open' ORDER BY chunk_order DESC LIMIT 1`,\n    89\t    )\n    90\t    .get() as unknown as OpenChunkRow | undefined;\n    91\t\n    92\t  if (\n    93\t    open !== undefined &&\n    94\t    memberCount(db, open.chunk_id) > 0 &&\n    95\t    Number(open.accumulated_projected_tokens) + projectedTokens >= policy.targetProjectedTokens\n    96\t  ) {\n    97\t    // Crossing closes *without* the incoming turn — the v1 bug's fix: the\n    98\t    // decision weighs accumulated + incoming, and the incoming turn starts\n    99\t    // the next chunk (AC-3.6).\n   100\t    closeChunk(db, open.chunk_id);\n   101\t    closedChunkIds.push(open.chunk_id);\n   102\t    open = undefined;\n   103\t  }\n   104\t\n   105\t  const chunkId = open?.chunk_id ?? openNextChunk(db);\n   106\t  const memberIdx = memberCount(db, chunkId);\n   107\t  db.prepare(`INSERT INTO chunk_member (chunk_id, turn_id, member_idx) VALUES (?, ?, ?)`).run(\n   108\t    chunkId,\n   109\t    turnId,\n   110\t    memberIdx,\n   111\t  );\n   112\t  db.prepare(\n   113\t    `UPDATE chunk SET accumulated_projected_tokens = accumulated_projected_tokens + ?\n   114\t     WHERE chunk_id = ?`,\n   115\t  ).run(projectedTokens, chunkId);\n   116\t\n   117\t  if (projectedTokens >= policy.maxProjectedTokens) {\n   118\t    // Max rule (AC-3.7): the projection alone meets the maximum, so the\n   119\t    // turn's chunk closes immediately, whatever it holds.\n   120\t    closeChunk(db, chunkId);\n   121\t    closedChunkIds.push(chunkId);\n   122\t  }\n   123\t\n   124\t  return { chunkId, memberIdx, closedChunkIds, alreadyPlaced: false };\n   125\t}\n   126\t\n   127\t// Closing queues the two summary kinds as two work items with independent\n   128\t// retry, states, and re-queue (AC-3.8); both enqueues ride the caller's\n   129\t// ambient transaction — the completion commit — per DD-5.\n   130\texport function enqueueChunkSummaries(\n   131\t  ctx: OperationContext,\n   132\t  chunkId: string,\n   133\t): WorkItemRecord[] {\n   134\t  return ([\"chunk_summary_detailed\", \"chunk_summary_brief\"] as const).map((kind) =>\n   135\t    enqueue(ctx, {\n   136\t      owner: \"turns\",\n   137\t      kind,\n   138\t      sourceRef: { chunkId },\n   139\t      forms: [{ subjectKind: \"chunk\", subjectId: chunkId, form: kind }],\n   140\t    }),\n   141\t  );\n   142\t}\n   143\t\n   144\t// Placement read-back for the turns surface (AC-3.5): chunkId + memberIdx by\n   145\t// turn, one query, stored values only.\n   146\texport function readPlacements(\n   147\t  db: DatabaseSync,\n   148\t): Map<string, { chunkId: string; memberIdx: number }> {\n   149\t  const rows = db\n   150\t    .prepare(`SELECT turn_id, chunk_id, member_idx FROM chunk_member`)\n   151\t    .all() as unknown as Array<{\n   152\t    turn_id: string;\n   153\t    chunk_id: string;\n   154\t    member_idx: number | bigint;\n   155\t  }>;\n   156\t  const byTurn = new Map<string, { chunkId: string; memberIdx: number }>();\n   157\t  for (const row of rows) {\n   158\t    byTurn.set(row.turn_id, { chunkId: row.chunk_id, memberIdx: Number(row.member_idx) });\n   159\t  }\n   160\t  return byTurn;\n   161\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/compose.ts | sed -n '1,240p'\"","aggregated_output":"     1\t// Rendering composition (Flow 3, AC-3.2–3.4): message-level forms become the\n     2\t// ordered RenderingPart input for composeTurnRendering, with fallbacks and\n     3\t// gap records where a form is not ready. Pure by anti-shim requirement —\n     4\t// `(messages, forms) → { parts, gaps }` with no DB handle, no provider, no\n     5\t// clock in the signature: determinism is structural, not disciplined.\n     6\t//\n     7\t// Tool activity stays in message order — runs are the consecutive tool\n     8\t// messages exactly as recorded, never reordered to make accounts tidier —\n     9\t// and every tool part carries its outcome, so a run containing a\n    10\t// state-changing call structurally cannot lose its outcome in composition\n    11\t// (AC-3.4: the outcome rides the part, not the prose).\n    12\timport type {\n    13\t  DependencyGap,\n    14\t  DerivedFormMetadata,\n    15\t  DerivedFormState,\n    16\t  FormKind,\n    17\t  RenderingPart,\n    18\t  RenderingPartKind,\n    19\t  ToolOutcome,\n    20\t  ToolRunReceipt,\n    21\t} from \"../../../shared/derivation.js\";\n    22\t\n    23\t// The member message as the composer sees it: kind plus projected blocks,\n    24\t// verbatim from the record (already deleted-filtered by the caller's read).\n    25\texport interface ComposeMessage {\n    26\t  messageId: string;\n    27\t  kind: RenderingPartKind;\n    28\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n    29\t}\n    30\t\n    31\t// One message-owned form row as composition input; keyed by the caller as\n    32\t// `${messageId}/${form}`.\n    33\texport interface ComposeFormRow {\n    34\t  state: DerivedFormState;\n    35\t  content?: string;\n    36\t  metadata?: DerivedFormMetadata;\n    37\t}\n    38\t\n    39\texport function composeFormKey(messageId: string, form: FormKind): string {\n    40\t  return `${messageId}/${form}`;\n    41\t}\n    42\t\n    43\texport interface CompositionInput {\n    44\t  parts: RenderingPart[];\n    45\t  gaps: DependencyGap[];\n    46\t  // The turn's tool-run receipts (AC-3.8): the tool parts restated as\n    47\t  // account + outcome, in message order — pure restatement of the\n    48\t  // composition input, stamped on the rendering so chunk summaries read\n    49\t  // receipts without re-deriving anything.\n    50\t  receipts: ToolRunReceipt[];\n    51\t}\n    52\t\n    53\t// Deterministic truncation for tool-activity fallbacks (AC-3.2's \"raw or\n    54\t// truncated content\"): a fixed prefix plus an exact tail marker, a pure\n    55\t// function of the input string alone.\n    56\texport const FALLBACK_TRUNCATION_LIMIT = 200;\n    57\t\n    58\texport function truncateForFallback(text: string): string {\n    59\t  if (text.length <= FALLBACK_TRUNCATION_LIMIT) return text;\n    60\t  const dropped = text.length - FALLBACK_TRUNCATION_LIMIT;\n    61\t  return `${text.slice(0, FALLBACK_TRUNCATION_LIMIT)}… [truncated ${dropped} chars]`;\n    62\t}\n    63\t\n    64\tfunction textOf(message: ComposeMessage): string {\n    65\t  const text = message.blocks[0]?.content[\"text\"];\n    66\t  return typeof text === \"string\" ? text : \"\";\n    67\t}\n    68\t\n    69\t// Mechanical outcome from the record alone (the AC-2.4 rule carried into\n    70\t// composition): a tool call's outcome comes from its paired result among the\n    71\t// turn's messages — present and clean, present and isError, or absent.\n    72\tfunction recordOutcomes(messages: readonly ComposeMessage[]): Map<string, boolean> {\n    73\t  const byCallId = new Map<string, boolean>();\n    74\t  for (const message of messages) {\n    75\t    if (message.kind !== \"tool_result\") continue;\n    76\t    const block = message.blocks[0]?.content ?? {};\n    77\t    const callId = block[\"toolCallId\"];\n    78\t    if (typeof callId === \"string\") byCallId.set(callId, block[\"isError\"] === true);\n    79\t  }\n    80\t  return byCallId;\n    81\t}\n    82\t\n    83\tfunction outcomeFromRecord(\n    84\t  resultByCallId: Map<string, boolean>,\n    85\t  callId: unknown,\n    86\t): ToolOutcome {\n    87\t  if (typeof callId !== \"string\") return \"unknown\";\n    88\t  const isError = resultByCallId.get(callId);\n    89\t  if (isError === undefined) return \"unknown\";\n    90\t  return isError ? \"failed\" : \"succeeded\";\n    91\t}\n    92\t\n    93\tinterface PartPlan {\n    94\t  form?: FormKind; // the message-level form this kind composes from, if any\n    95\t  fallbackText: (message: ComposeMessage) => string;\n    96\t}\n    97\t\n    98\t// The fallback rules table (story Technical Notes): prompt → raw text; tool\n    99\t// call/result → deterministic truncation; text/thinking/note → raw, no form\n   100\t// to fall back from and therefore never a gap.\n   101\tconst PART_PLANS: Record<RenderingPartKind, PartPlan> = {\n   102\t  user_prompt: { form: \"smoothed_prompt\", fallbackText: textOf },\n   103\t  assistant_text: { fallbackText: textOf },\n   104\t  assistant_thinking: { fallbackText: textOf },\n   105\t  runtime_note: { fallbackText: textOf },\n   106\t  tool_call: {\n   107\t    form: \"tool_call_summary\",\n   108\t    fallbackText: (message) => {\n   109\t      const block = message.blocks[0]?.content ?? {};\n   110\t      const toolName = typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"unknown_tool\";\n   111\t      return truncateForFallback(`${toolName}(${JSON.stringify(block[\"arguments\"] ?? {})})`);\n   112\t    },\n   113\t  },\n   114\t  tool_result: {\n   115\t    form: \"tool_result_summary\",\n   116\t    fallbackText: (message) => {\n   117\t      const block = message.blocks[0]?.content ?? {};\n   118\t      return truncateForFallback(typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\");\n   119\t    },\n   120\t  },\n   121\t};\n   122\t\n   123\t// Ready forms verbatim; non-ready (pending | failed | blocked) fall back with\n   124\t// one gap recorded per fallback naming the source record and the missing\n   125\t// form (AC-3.2). Gaps are facts about this composition — the caller lands\n   126\t// them on the rendering and they stay put until an explicit rebuild\n   127\t// recomposes from current states (AC-3.3).\n   128\texport function composeRenderingInput(\n   129\t  messages: readonly ComposeMessage[],\n   130\t  forms: ReadonlyMap<string, ComposeFormRow>,\n   131\t): CompositionInput {\n   132\t  const parts: RenderingPart[] = [];\n   133\t  const gaps: DependencyGap[] = [];\n   134\t  const receipts: ToolRunReceipt[] = [];\n   135\t  const resultByCallId = recordOutcomes(messages);\n   136\t\n   137\t  for (const message of messages) {\n   138\t    const plan = PART_PLANS[message.kind];\n   139\t    const form = plan.form === undefined ? undefined : forms.get(composeFormKey(message.messageId, plan.form));\n   140\t    const ready = form !== undefined && form.state === \"ready\" && form.content !== undefined;\n   141\t\n   142\t    const part: RenderingPart = {\n   143\t      messageId: message.messageId,\n   144\t      kind: message.kind,\n   145\t      text: ready ? (form.content as string) : plan.fallbackText(message),\n   146\t      fallback: plan.form !== undefined && !ready,\n   147\t    };\n   148\t    if (message.kind === \"tool_call\") {\n   149\t      const callId = message.blocks[0]?.content[\"toolCallId\"];\n   150\t      part.outcome =\n   151\t        ready && form.metadata?.outcome !== undefined\n   152\t          ? form.metadata.outcome\n   153\t          : outcomeFromRecord(resultByCallId, callId);\n   154\t    } else if (message.kind === \"tool_result\") {\n   155\t      const block = message.blocks[0]?.content ?? {};\n   156\t      part.outcome =\n   157\t        ready && form.metadata?.outcome !== undefined\n   158\t          ? form.metadata.outcome\n   159\t          : block[\"isError\"] === true\n   160\t            ? \"failed\"\n   161\t            : \"succeeded\";\n   162\t    }\n   163\t    parts.push(part);\n   164\t    if (part.fallback && plan.form !== undefined) {\n   165\t      gaps.push({ subjectKind: \"message\", subjectId: message.messageId, form: plan.form });\n   166\t    }\n   167\t    if (message.kind === \"tool_call\" || message.kind === \"tool_result\") {\n   168\t      receipts.push({\n   169\t        messageId: message.messageId,\n   170\t        activity: message.kind,\n   171\t        account: part.text,\n   172\t        outcome: part.outcome ?? \"unknown\",\n   173\t      });\n   174\t    }\n   175\t  }\n   176\t\n   177\t  return { parts, gaps, receipts };\n   178\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/derive.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n     2\t// biggest single handler — and the two chunk summaries. turn_derivation\n     3\t// composes the rendering from message-level forms (compose.ts), sends it\n     4\t// through composeTurnRendering then projectLowerBand, hands both forms back\n     5\t// for the version-checked completion write, and runs placement in that same\n     6\t// completion transaction via the onApplied hook: open-chunk append, the\n     7\t// accumulated close policy, and any close's summary enqueues all ride the\n     8\t// one commit (anti-shim: a crash leaves either a placed turn with queued\n     9\t// summaries or an open chunk — nothing between).\n    10\timport type {\n    11\t  DependencyGap,\n    12\t  HandlerOutcome,\n    13\t  HandlerRunContext,\n    14\t  WorkHandler,\n    15\t} from \"../../../shared/derivation.js\";\n    16\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n    17\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n    18\timport { composeRenderingInput } from \"./compose.js\";\n    19\timport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\n    20\timport {\n    21\t  chunkExists,\n    22\t  readMemberMessages,\n    23\t  readMemberProjections,\n    24\t  readMessageFormRows,\n    25\t  readTurnSource,\n    26\t} from \"./forms.js\";\n    27\timport { selectOpenTurnIds } from \"./store.js\";\n    28\t\n    29\tfunction sourceDamaged(reason: string): HandlerOutcome {\n    30\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n    31\t}\n    32\t\n    33\tfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n    34\t  return { ok: false, retryable: result.retryable, reason: result.reason };\n    35\t}\n    36\t\n    37\tfunction readThreadId(run: HandlerRunContext): string {\n    38\t  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n    39\t    | { thread_id: string }\n    40\t    | undefined;\n    41\t  return row?.thread_id ?? \"\";\n    42\t}\n    43\t\n    44\tconst turnDerivationHandler: WorkHandler = async (run, item) => {\n    45\t  const turnId = item.sourceRef[\"turnId\"];\n    46\t  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n    47\t  const db = run.openDb();\n    48\t  const turn = readTurnSource(db, turnId);\n    49\t  if (turn === undefined || turn.deleted) {\n    50\t    // A deleted turn's form rows were dropped with it, so a blocked stamp\n    51\t    // would hit nothing; either way the item is terminal against a source\n    52\t    // that cannot improve.\n    53\t    return sourceDamaged(`turn ${turnId} not found`);\n    54\t  }\n    55\t  if (turn.status !== \"closed\") {\n    56\t    // Derivation is queued only at close; an open turn under a queued item\n    57\t    // means the record was interfered with.\n    58\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n    59\t  }\n    60\t  // Epic 01's corruption definition (AC-3.9 there, TC-4.6 here): only the\n    61\t  // batch pipeline writes turn state and it never leaves two turns open, so\n    62\t  // more than one open turn means the record was damaged below the SDK. A\n    63\t  // handler must not compose against a membership it cannot trust; the form\n    64\t  // lands blocked naming the damage, and requeue refuses with that reason\n    65\t  // until the source reads clean (Story 4).\n    66\t  const openTurnIds = selectOpenTurnIds(db);\n    67\t  if (openTurnIds.length > 1) {\n    68\t    return sourceDamaged(\n    69\t      `turn state corrupt: ${openTurnIds.length} turns open (${openTurnIds.join(\", \")})`,\n    70\t    );\n    71\t  }\n    72\t\n    73\t  // Compose from current message-form states: ready forms verbatim,\n    74\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n    75\t  // before any provider call, and no transaction is held across them.\n    76\t  const messages = readMemberMessages(db, turnId);\n    77\t  const forms = readMessageFormRows(\n    78\t    db,\n    79\t    messages.map((message) => message.messageId),\n    80\t  );\n    81\t  const { parts, gaps, receipts } = composeRenderingInput(messages, forms);\n    82\t\n    83\t  const rendering = await run.provider.composeTurnRendering({ parts });\n    84\t  if (!rendering.ok) return providerFailed(rendering);\n    85\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n    86\t  if (!projection.ok) return providerFailed(projection);\n    87\t\n    88\t  // The projection's token count is estimated exactly once, here, as the\n    89\t  // artifact lands; placement reads this stored arithmetic and never\n    90\t  // re-counts (AC-3.9's determinism input).\n    91\t  const projectedTokens = estimateTokens(projection.text);\n    92\t  const threadId = readThreadId(run);\n    93\t  const renderingGaps: DependencyGap[] | undefined = gaps.length > 0 ? gaps : undefined;\n    94\t\n    95\t  return {\n    96\t    ok: true,\n    97\t    forms: [\n    98\t      {\n    99\t        subjectKind: \"turn\",\n   100\t        subjectId: turnId,\n   101\t        form: \"turn_rendering\",\n   102\t        content: rendering.text,\n   103\t        ...(renderingGaps === undefined ? {} : { gaps: renderingGaps }),\n   104\t        // Tool-run receipts ride the rendering's metadata, mechanically\n   105\t        // restated from the composition input (AC-3.8) — the chunk\n   106\t        // summaries read them from here, never from provider prose.\n   107\t        ...(receipts.length > 0 ? { metadata: { receipts } } : {}),\n   108\t      },\n   109\t      {\n   110\t        subjectKind: \"turn\",\n   111\t        subjectId: turnId,\n   112\t        form: \"lower_band_projection\",\n   113\t        content: projection.text,\n   114\t      },\n   115\t    ],\n   116\t    onApplied: (tx) => {\n   117\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n   118\t      for (const chunkId of placement.closedChunkIds) {\n   119\t        enqueueChunkSummaries(\n   120\t          { db: tx.db, clock: run.clock, threadId, onCommit: tx.onCommit },\n   121\t          chunkId,\n   122\t        );\n   123\t      }\n   124\t    },\n   125\t  };\n   126\t};\n   127\t\n   128\t// One read for both summary kinds — member projections in turn order — but\n   129\t// two contracts at the provider seam (AC-3.8): detailed receives the\n   130\t// members' tool-run receipts (what changed, outcome) read from the\n   131\t// renderings' stamped metadata; brief receives outcomes only, the receipt\n   132\t// text stripped here so the brief provider call structurally cannot carry\n   133\t// it. Two work items, two handlers' runs, independent retry and states. A\n   134\t// member whose projection is not ready falls back to nothing and records a\n   135\t// gap, mirroring the rendering's fallback rule.\n   136\tfunction chunkSummaryHandler(\n   137\t  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n   138\t): WorkHandler {\n   139\t  return async (run, item) => {\n   140\t    const chunkId = item.sourceRef[\"chunkId\"];\n   141\t    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n   142\t    const db = run.openDb();\n   143\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n   144\t\n   145\t    const members = readMemberProjections(db, chunkId);\n   146\t    const memberProjections: string[] = [];\n   147\t    const gaps: DependencyGap[] = [];\n   148\t    for (const member of members) {\n   149\t      if (member.state === \"ready\" && member.content !== undefined) {\n   150\t        memberProjections.push(member.content);\n   151\t      } else {\n   152\t        memberProjections.push(\"\");\n   153\t        gaps.push({\n   154\t          subjectKind: \"turn\",\n   155\t          subjectId: member.turnId,\n   156\t          form: \"lower_band_projection\",\n   157\t        });\n   158\t      }\n   159\t    }\n   160\t\n   161\t    const result =\n   162\t      kind === \"chunk_summary_detailed\"\n   163\t        ? await run.provider.summarizeChunkDetailed({\n   164\t            memberProjections,\n   165\t            memberReceipts: members.map((member) => member.receipts),\n   166\t          })\n   167\t        : await run.provider.summarizeChunkBrief({\n   168\t            memberProjections,\n   169\t            memberOutcomes: members.map((member) =>\n   170\t              member.receipts.map((receipt) => receipt.outcome),\n   171\t            ),\n   172\t          });\n   173\t    if (!result.ok) return providerFailed(result);\n   174\t\n   175\t    return {\n   176\t      ok: true,\n   177\t      forms: [\n   178\t        {\n   179\t          subjectKind: \"chunk\",\n   180\t          subjectId: chunkId,\n   181\t          form: kind,\n   182\t          content: result.text,\n   183\t          ...(gaps.length > 0 ? { gaps } : {}),\n   184\t        },\n   185\t      ],\n   186\t    };\n   187\t  };\n   188\t}\n   189\t\n   190\t// The domain's handler table, merged into the SDK dispatch map at\n   191\t// construction (DD-6).\n   192\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n   193\t  turn_derivation: turnDerivationHandler,\n   194\t  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n   195\t  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n   196\t};\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/index.ts | sed -n '1,560p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n     3\timport type {\n     4\t  FormKind,\n     5\t  FormReportEntry,\n     6\t  WorkHandler,\n     7\t} from \"../../shared/derivation.js\";\n     8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     9\timport {\n    10\t  enqueue,\n    11\t  hasLiveItem,\n    12\t  listItems,\n    13\t  type EnqueueFormTarget,\n    14\t  type WorkItemRecord,\n    15\t  type WorkKind,\n    16\t  type WorkSourceRef,\n    17\t} from \"../../tech-utils/work-queue/index.js\";\n    18\timport type { EventKind } from \"../intake-stream/index.js\";\n    19\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n    20\timport { transition } from \"./internal/state-machine.js\";\n    21\t\n    22\t// The pure rule table, re-exported for the golden supplemental suite (the\n    23\t// test plan's one sanctioned direct entry besides the tokenizer); production\n    24\t// callers go through applyEvent.\n    25\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n    26\timport type { DerivedForm } from \"../../shared/derivation.js\";\n    27\timport { turnWorkHandlers } from \"./internal/derive.js\";\n    28\timport {\n    29\t  readChunkRows,\n    30\t  readOwnedForms,\n    31\t  readTurnFormRow,\n    32\t  reportTurnForms,\n    33\t} from \"./internal/forms.js\";\n    34\timport {\n    35\t  applyTurnDeleteCascade,\n    36\t  type MutationResult,\n    37\t} from \"../messages/index.js\";\n    38\timport {\n    39\t  closeTurn,\n    40\t  insertOpenTurn,\n    41\t  markTurnDeleted,\n    42\t  nextTurnOrder,\n    43\t  readMutableTurn,\n    44\t  readTurns,\n    45\t  selectOpenTurnIds,\n    46\t} from \"./internal/store.js\";\n    47\t\n    48\texport interface TurnRecord {\n    49\t  turnId: string;\n    50\t  status: \"open\" | \"closed\";\n    51\t  memberMessageIds: string[];\n    52\t  openedAtEventOrder: number;\n    53\t  closedAtEventOrder?: number;\n    54\t  // Chunk placement (Epic 02 Story 3, AC-3.5): present once the turn's\n    55\t  // derivation placed it — stored values read back, never recomputed.\n    56\t  chunkId?: string;\n    57\t  memberIdx?: number;\n    58\t  // The turn's derived forms as stored (Epic 02 Story 4, AC-4.7 ruling 012):\n    59\t  // present only when rows exist — a closed turn carries them from the\n    60\t  // moment its derivation queues. Stored state returned verbatim, mirroring\n    61\t  // the message read's forms key; reads degrade, never block.\n    62\t  forms?: DerivedForm[];\n    63\t}\n    64\t\n    65\t// Chunk read-back (Epic 02 Story 4, AC-4.7 ruling 012): the stored chunk\n    66\t// record with live membership and its summary forms' states attached —\n    67\t// the chunk leg of \"reading a message, turn, or chunk returns the record\n    68\t// with form states\".\n    69\texport interface ChunkRecord {\n    70\t  chunkId: string;\n    71\t  chunkOrder: number;\n    72\t  status: \"open\" | \"closed\";\n    73\t  accumulatedProjectedTokens: number;\n    74\t  memberTurnIds: string[];\n    75\t  forms?: DerivedForm[];\n    76\t}\n    77\t\n    78\texport interface TurnTransitionOutcome {\n    79\t  // Transitions in occurrence order: a close_then_open reports the close\n    80\t  // first, then the open, exactly as the batch result surfaces them.\n    81\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n    82\t  // Turn state after the transition — the stamp for this event's message.\n    83\t  // Prompts see the turn they just opened (transition first, then stamp);\n    84\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n    85\t  openTurnId: string | null;\n    86\t  // Work queued by this transition: one turn_derivation item per closed\n    87\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\n    88\t  queuedWork: WorkItemRecord[];\n    89\t}\n    90\t\n    91\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n    92\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n    93\t// writes turn state, so more than one open turn means external interference.\n    94\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n    95\t  return selectOpenTurnIds(ctx.db);\n    96\t}\n    97\t\n    98\t// Closing a turn — by either close path — durably queues that turn's\n    99\t// derivation work in the same transaction (AC-3.6): the close update and the\n   100\t// work item commit or roll back together.\n   101\tfunction closeTurnAndQueueWork(\n   102\t  ctx: OperationContext,\n   103\t  turnId: string,\n   104\t  eventOrder: number,\n   105\t): WorkItemRecord {\n   106\t  closeTurn(ctx.db, turnId, eventOrder);\n   107\t  // One work item, two derived forms: the turn_derivation handler (Story 3)\n   108\t  // lands the rendering and the lower-band projection as independent rows;\n   109\t  // both go pending with the enqueue (DD-5).\n   110\t  return enqueue(ctx, {\n   111\t    owner: \"turns\",\n   112\t    kind: \"turn_derivation\",\n   113\t    sourceRef: { turnId },\n   114\t    forms: [\n   115\t      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n   116\t      { subjectKind: \"turn\", subjectId: turnId, form: \"lower_band_projection\" },\n   117\t    ],\n   118\t  });\n   119\t}\n   120\t\n   121\t// Turn-owned work handlers, merged into the SDK's dispatch map at\n   122\t// construction (DD-6): turn derivation and the two chunk summaries.\n   123\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   124\t  turnWorkHandlers;\n   125\t\n   126\t// Cross-domain surface, called by intake-stream inside the batch transaction\n   127\t// for every recorded event. Synchronous and throwing by design, like\n   128\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n   129\texport function applyEvent(\n   130\t  ctx: OperationContext,\n   131\t  eventKind: EventKind,\n   132\t  eventOrder: number,\n   133\t): TurnTransitionOutcome {\n   134\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n   135\t  const effect = transition({ openTurnId }, eventKind);\n   136\t  switch (effect.kind) {\n   137\t    case \"none\":\n   138\t      return { transitions: [], openTurnId, queuedWork: [] };\n   139\t    case \"open\": {\n   140\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   141\t      return {\n   142\t        transitions: [{ action: \"opened\", turnId }],\n   143\t        openTurnId: turnId,\n   144\t        queuedWork: [],\n   145\t      };\n   146\t    }\n   147\t    case \"close\": {\n   148\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   149\t      return {\n   150\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n   151\t        openTurnId: null,\n   152\t        queuedWork: [item],\n   153\t      };\n   154\t    }\n   155\t    case \"close_then_open\": {\n   156\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   157\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   158\t      return {\n   159\t        transitions: [\n   160\t          { action: \"closed\", turnId: openTurnId as string },\n   161\t          { action: \"opened\", turnId },\n   162\t        ],\n   163\t        openTurnId: turnId,\n   164\t        queuedWork: [item],\n   165\t      };\n   166\t    }\n   167\t  }\n   168\t}\n   169\t\n   170\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   171\t  return {\n   172\t    ok: false,\n   173\t    error: {\n   174\t      errorClass: \"caller_error\",\n   175\t      code: \"thread_not_found\",\n   176\t      reason: `no thread file exists at ${filePath}`,\n   177\t    },\n   178\t  };\n   179\t}\n   180\t\n   181\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n   182\t  const resolved = await resolveThreadRef(thread);\n   183\t  if (!resolved.ok) return resolved;\n   184\t  const { filePath } = resolved.value;\n   185\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   186\t\n   187\t  const opened = openThreadDatabase(filePath);\n   188\t  if (!opened.ok) return opened;\n   189\t  const db = opened.value;\n   190\t  try {\n   191\t    // Form read-back rides the turn read (AC-4.7): each record carries its\n   192\t    // stored derived forms, attached from one grouped query — mirroring the\n   193\t    // message read's production path for \"readable alongside the record\".\n   194\t    const formsByTurn = readOwnedForms(db, \"turn\");\n   195\t    const records = readTurns(db).map((record) => {\n   196\t      const forms = formsByTurn.get(record.turnId);\n   197\t      return forms === undefined ? record : { ...record, forms };\n   198\t    });\n   199\t    return { ok: true, value: records };\n   200\t  } catch (cause) {\n   201\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   202\t    return storageFailure(`turn read-back failed: ${reason}`);\n   203\t  } finally {\n   204\t    db.close();\n   205\t  }\n   206\t}\n   207\t\n   208\t// Chunk read-back with summary-form states attached (AC-4.7 ruling 012):\n   209\t// returns stored records whatever the forms' states — reads degrade, never\n   210\t// block. Forms attach only where rows exist (a freshly opened chunk has no\n   211\t// summary rows until close queues them).\n   212\texport async function listChunks(thread: ThreadRef): Promise<OpResult<ChunkRecord[]>> {\n   213\t  const resolved = await resolveThreadRef(thread);\n   214\t  if (!resolved.ok) return resolved;\n   215\t  const { filePath } = resolved.value;\n   216\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   217\t\n   218\t  const opened = openThreadDatabase(filePath);\n   219\t  if (!opened.ok) return opened;\n   220\t  const db = opened.value;\n   221\t  try {\n   222\t    const formsByChunk = readOwnedForms(db, \"chunk\");\n   223\t    const records: ChunkRecord[] = readChunkRows(db).map((row) => {\n   224\t      const forms = formsByChunk.get(row.chunkId);\n   225\t      return forms === undefined ? row : { ...row, forms };\n   226\t    });\n   227\t    return { ok: true, value: records };\n   228\t  } catch (cause) {\n   229\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   230\t    return storageFailure(`chunk read-back failed: ${reason}`);\n   231\t  } finally {\n   232\t    db.close();\n   233\t  }\n   234\t}\n   235\t\n   236\texport async function listQueuedWork(\n   237\t  thread: ThreadRef,\n   238\t): Promise<OpResult<WorkItemRecord[]>> {\n   239\t  const resolved = await resolveThreadRef(thread);\n   240\t  if (!resolved.ok) return resolved;\n   241\t  const { filePath } = resolved.value;\n   242\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   243\t\n   244\t  const opened = openThreadDatabase(filePath);\n   245\t  if (!opened.ok) return opened;\n   246\t  const db = opened.value;\n   247\t  try {\n   248\t    return { ok: true, value: listItems(db, \"turns\") };\n   249\t  } catch (cause) {\n   250\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   251\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   252\t  } finally {\n   253\t    db.close();\n   254\t  }\n   255\t}\n   256\t\n   257\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   258\t\n   259\t// This owner's repair report: every turn- and chunk-owned form's durable\n   260\t// state joined with live queue detail in one query. Needs no provider;\n   261\t// reads degrade, never block.\n   262\texport async function report(\n   263\t  thread: ThreadRef,\n   264\t  opts?: { notReady?: boolean; turnId?: string; chunkId?: string },\n   265\t): Promise<OpResult<FormReportEntry[]>> {\n   266\t  const resolved = await resolveThreadRef(thread);\n   267\t  if (!resolved.ok) return resolved;\n   268\t  const { filePath } = resolved.value;\n   269\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   270\t\n   271\t  const opened = openThreadDatabase(filePath);\n   272\t  if (!opened.ok) return opened;\n   273\t  const db = opened.value;\n   274\t  try {\n   275\t    return { ok: true, value: reportTurnForms(db, opts ?? {}) };\n   276\t  } catch (cause) {\n   277\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   278\t    return storageFailure(`report read failed: ${reason}`);\n   279\t  } finally {\n   280\t    db.close();\n   281\t  }\n   282\t}\n   283\t\n   284\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n   285\t\n   286\t// The queue site each turn-owned form rebuilds through. Both turn forms ride\n   287\t// the one turn_derivation item (the handler lands rendering and projection\n   288\t// together, so a rebuild of either re-derives both — the rebuild rule from\n   289\t// Flow 3); each chunk summary rides its same-named kind alone (AC-3.8's\n   290\t// independent lifecycles).\n   291\tfunction turnRequeueTarget(target: {\n   292\t  subjectKind: \"turn\" | \"chunk\";\n   293\t  subjectId: string;\n   294\t  form: FormKind;\n   295\t}): { kind: WorkKind; sourceRef: WorkSourceRef; forms: EnqueueFormTarget[] } | undefined {\n   296\t  if (\n   297\t    target.subjectKind === \"turn\" &&\n   298\t    (target.form === \"turn_rendering\" || target.form === \"lower_band_projection\")\n   299\t  ) {\n   300\t    return {\n   301\t      kind: \"turn_derivation\",\n   302\t      sourceRef: { turnId: target.subjectId },\n   303\t      forms: [\n   304\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"turn_rendering\" },\n   305\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"lower_band_projection\" },\n   306\t      ],\n   307\t    };\n   308\t  }\n   309\t  if (\n   310\t    target.subjectKind === \"chunk\" &&\n   311\t    (target.form === \"chunk_summary_detailed\" || target.form === \"chunk_summary_brief\")\n   312\t  ) {\n   313\t    return {\n   314\t      kind: target.form,\n   315\t      sourceRef: { chunkId: target.subjectId },\n   316\t      forms: [{ subjectKind: \"chunk\", subjectId: target.subjectId, form: target.form }],\n   317\t    };\n   318\t  }\n   319\t  return undefined;\n   320\t}\n   321\t\n   322\t// Explicit re-queue through the owning surface (AC-4.4): same contract as\n   323\t// messages.requeue — blocked refused with the stored damage reason, missing\n   324\t// rows refused, no-op against live work at the current source version, and\n   325\t// the no-op check + enqueue in one transaction. A successful requeue rebuilds\n   326\t// at the next source version: composed forms recompute their gaps from\n   327\t// current dependency states (Flow 3's rebuild rule).\n   328\texport async function requeue(\n   329\t  thread: ThreadRef,\n   330\t  target: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: FormKind },\n   331\t): Promise<OpResult<RequeueOutcome>> {\n   332\t  const mapped = turnRequeueTarget(target);\n   333\t  if (mapped === undefined) {\n   334\t    return {\n   335\t      ok: false,\n   336\t      error: {\n   337\t        errorClass: \"caller_error\",\n   338\t        code: \"turn_not_found\",\n   339\t        reason: `form ${target.form} is not a ${target.subjectKind}-owned form; turns.requeue repairs turn_rendering and lower_band_projection (turn) or chunk_summary_detailed and chunk_summary_brief (chunk)`,\n   340\t      },\n   341\t    };\n   342\t  }\n   343\t  const resolved = await resolveThreadRef(thread);\n   344\t  if (!resolved.ok) return resolved;\n   345\t  const { filePath } = resolved.value;\n   346\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   347\t\n   348\t  const opened = openThreadDatabase(filePath);\n   349\t  if (!opened.ok) return opened;\n   350\t  const db = opened.value;\n   351\t  try {\n   352\t    const meta = db\n   353\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   354\t      .get() as { thread_id: string } | undefined;\n   355\t    const threadId = meta?.thread_id ?? \"\";\n   356\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   357\t      const row = readTurnFormRow(ctx.db, target.subjectKind, target.subjectId, target.form);\n   358\t      if (row === undefined) {\n   359\t        return {\n   360\t          ok: false,\n   361\t          error: {\n   362\t            errorClass: \"caller_error\",\n   363\t            code: \"turn_not_found\",\n   364\t            reason: `no derived form ${target.form} exists for ${target.subjectKind} ${target.subjectId}`,\n   365\t          },\n   366\t        };\n   367\t      }\n   368\t      if (row.state === \"blocked\") {\n   369\t        // The refusal carries the form's stored reason — the damage named at\n   370\t        // blocking time, not a generic string (AC-4.6).\n   371\t        return {\n   372\t          ok: false,\n   373\t          error: {\n   374\t            errorClass: \"state_corruption\",\n   375\t            code: \"source_damaged\",\n   376\t            reason:\n   377\t              row.reason ??\n   378\t              `form ${target.form} for ${target.subjectKind} ${target.subjectId} is blocked`,\n   379\t          },\n   380\t        };\n   381\t      }\n   382\t      if (hasLiveItem(ctx.db, mapped.kind, mapped.sourceRef, row.sourceVersion)) {\n   383\t        return { ok: true, value: { noop: \"already_queued\" } };\n   384\t      }\n   385\t      const item = enqueue(ctx, {\n   386\t        owner: \"turns\",\n   387\t        kind: mapped.kind,\n   388\t        sourceRef: mapped.sourceRef,\n   389\t        sourceVersion: row.sourceVersion + 1,\n   390\t        forms: mapped.forms,\n   391\t      });\n   392\t      return { ok: true, value: { workItemId: item.workItemId } };\n   393\t    });\n   394\t  } catch (cause) {\n   395\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   396\t    return storageFailure(`requeue failed: ${reason}`);\n   397\t  } finally {\n   398\t    db.close();\n   399\t  }\n   400\t}\n   401\t\n   402\t// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\n   403\t\n   404\t// The whole-exchange removal (AC-6.4–6.7): \"that exchange was a dead end —\n   405\t// kill it.\" One transaction stamps the turn and all its live member\n   406\t// messages deleted, drops the turn's and members' derived forms, and\n   407\t// re-queues the containing chunk's summaries from the remaining live\n   408\t// members — or drops them when the chunk empties out (AC-6.6). The shared\n   409\t// machinery is the messages domain's cascade module (DD-8, one cascade,\n   410\t// two callers), reached through its public surface; this operation owns\n   411\t// the turn-side validation and the turn-row stamp. Source events are never\n   412\t// touched; chunk membership rows are never moved or re-cut — reads filter\n   413\t// the deleted turn out, shrinking the chunk in place. Refusals read the\n   414\t// filtered view: a missing, deleted, or double-deleted turn is\n   415\t// turn_not_found; an open turn is turn_open; a refusal changes nothing.\n   416\texport async function deleteTurn(\n   417\t  thread: ThreadRef,\n   418\t  input: { turnId: string },\n   419\t): Promise<OpResult<MutationResult>> {\n   420\t  const resolved = await resolveThreadRef(thread);\n   421\t  if (!resolved.ok) return resolved;\n   422\t  const { filePath } = resolved.value;\n   423\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   424\t\n   425\t  const opened = openThreadDatabase(filePath);\n   426\t  if (!opened.ok) return opened;\n   427\t  const db = opened.value;\n   428\t  try {\n   429\t    const meta = db\n   430\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   431\t      .get() as { thread_id: string } | undefined;\n   432\t    const threadId = meta?.thread_id ?? \"\";\n   433\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n   434\t      const target = readMutableTurn(ctx.db, input.turnId);\n   435\t      if (target === undefined) {\n   436\t        return {\n   437\t          ok: false,\n   438\t          error: {\n   439\t            errorClass: \"caller_error\",\n   440\t            code: \"turn_not_found\",\n   441\t            reason: `no turn ${input.turnId} exists in this thread`,\n   442\t          },\n   443\t        };\n   444\t      }\n   445\t      if (target.status !== \"closed\") {\n   446\t        return {\n   447\t          ok: false,\n   448\t          error: {\n   449\t            errorClass: \"caller_error\",\n   450\t            code: \"turn_open\",\n   451\t            reason: `turn ${input.turnId} is open; open turns cannot be deleted (v1 boundary)`,\n   452\t          },\n   453\t        };\n   454\t      }\n   455\t      markTurnDeleted(ctx.db, input.turnId, ctx.clock().toISOString());\n   456\t      const cascade = applyTurnDeleteCascade(ctx, input.turnId);\n   457\t      return {\n   458\t        ok: true,\n   459\t        value: {\n   460\t          changed: { messageIds: cascade.memberMessageIds, turnIds: [input.turnId] },\n   461\t          cleared: cascade.cleared,\n   462\t          dropped: cascade.dropped,\n   463\t          queued: cascade.queued,\n   464\t          superseded: cascade.superseded,\n   465\t        },\n   466\t      };\n   467\t    });\n   468\t  } catch (cause) {\n   469\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   470\t    return storageFailure(`delete failed: ${reason}`);\n   471\t  } finally {\n   472\t    db.close();\n   473\t  }\n   474\t}\n","exit_code":0,"status":"completed"}}

ascade.memberMessageIds, turnIds: [input.turnId] },\\n+          cleared: cascade.cleared,\\n+          dropped: cascade.dropped,\\n+          queued: cascade.queued,\\n+          superseded: cascade.superseded,\\n+        },\\n+      };\\n+    });\\n+  } catch (cause) {\\n+    const reason = cause instanceof Error ? cause.message : String(cause);\\n+    return storageFailure(`delete failed: ${reason}`);\\n+  } finally {\\n+    db.close();\\n+  }\\n+}\\ndiff --git a/packages/lhc/src/domains/turns/internal/store.ts b/packages/lhc/src/domains/turns/internal/store.ts\\nindex 72a8c86..6d88140 100644\\n--- a/packages/lhc/src/domains/turns/internal/store.ts\\n+++ b/packages/lhc/src/domains/turns/internal/store.ts\\n@@ -39,6 +39,28 @@ export function closeTurn(db: DatabaseSync, turnId: string, closedAtEventOrder:\\n   ).run(closedAtEventOrder, turnId);\\n }\\n \\n+// The turn delete's validation read (Flow 6): the live (deleted-filtered)\\n+// turn row. A deleted or missing target misses here and refuses as\\n+// turn_not_found — the filtered view is the refusal's read, so a double\\n+// delete is a refusal, never a silent success (AC-6.7).\\n+export function readMutableTurn(\\n+  db: DatabaseSync,\\n+  turnId: string,\\n+): { turnId: string; status: \\\"open\\\" | \\\"closed\\\" } | undefined {\\n+  const row = db\\n+    .prepare(`SELECT status FROM turns WHERE turn_id = ? AND deleted_at IS NULL`)\\n+    .get(turnId) as unknown as { status: string } | undefined;\\n+  if (row === undefined) return undefined;\\n+  return { turnId, status: row.status as \\\"open\\\" | \\\"closed\\\" };\\n+}\\n+\\n+// The turn delete's record apply: a projection-level tombstone on the turn\\n+// row, mirroring the message stamp. Events and membership rows are never\\n+// touched — reads filter; boundaries never re-cut (shrink-only membership).\\n+export function markTurnDeleted(db: DatabaseSync, turnId: string, deletedAt: string): void {\\n+  db.prepare(`UPDATE turns SET deleted_at = ? WHERE turn_id = ?`).run(deletedAt, turnId);\\n+}\\n+\\n interface RawTurnRow {\\n   turn_id: string;\\n   status: string;\\n@@ -48,12 +70,15 @@ interface RawTurnRow {\\n \\n // Membership is stored on the member (message.turn_id), never as a list on\\n // the turn: memberMessageIds is a query, ordered by event order, so there is\\n-// exactly one source of truth.\\n+// exactly one source of truth. Both halves read deleted-filtered (tech\\n+// design §Mechanics): a deleted turn leaves the listing entirely, and a\\n+// deleted message leaves its turn's membership — the membership shrinks in\\n+// place, the turn row and its boundaries untouched.\\n export function readTurns(db: DatabaseSync): TurnRecord[] {\\n   const memberRows = db\\n     .prepare(\\n       `SELECT message_id, turn_id FROM message\\n-       WHERE turn_id IS NOT NULL ORDER BY source_event_order`,\\n+       WHERE turn_id IS NOT NULL AND deleted_at IS NULL ORDER BY source_event_order`,\\n     )\\n     .all() as unknown as Array<{ message_id: string; turn_id: string }>;\\n   const membersByTurn = new Map<string, string[]>();\\n@@ -66,7 +91,7 @@ export function readTurns(db: DatabaseSync): TurnRecord[] {\\n   const turnRows = db\\n     .prepare(\\n       `SELECT turn_id, status, opened_at_event_order, closed_at_event_order\\n-       FROM turns ORDER BY turn_order`,\\n+       FROM turns WHERE deleted_at IS NULL ORDER BY turn_order`,\\n     )\\n     .all() as unknown as RawTurnRow[];\\n   // Chunk placement rides the turn read-back (Epic 02 AC-3.5): stored\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\npackages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/06-message-turn-delete/streams/005-implementor.stdout.log:337:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01JEhadNVBAftzAwh74wKFQr\",\"type\":\"tool_result\",\"content\":\"1\\t// Turn-domain reads for derivation (Flow 3): the turn handler's view of its\\n2\\t// source turn, the member messages it composes (deleted-filtered — the\\n3\\t// shared read-filter rule lives here, once for this domain), the\\n4\\t// message-level form rows composition consumes, and the member projections\\n5\\t// the chunk summaries read. Completion writes for turn- and chunk-owned\\n6\\t// forms ride the work-queue util's `complete` (UPDATE-only, version-checked)\\n7\\t// — no write path here.\\n8\\timport type { DatabaseSync } from \\\"node:sqlite\\\";\\n9\\timport type {\\n10\\t  DependencyGap,\\n11\\t  DerivedForm,\\n12\\t  DerivedFormMetadata,\\n13\\t  DerivedFormState,\\n14\\t  FormReportEntry,\\n15\\t  RenderingPartKind,\\n16\\t  ToolRunReceipt,\\n17\\t} from \\\"../../../shared/derivation.js\\\";\\n18\\timport { reportEntryFromRow, type RawReportRow } from \\\"../../../shared/report.js\\\";\\n19\\timport type { ComposeFormRow, ComposeMessage } from \\\"./compose.js\\\";\\n20\\timport { composeFormKey } from \\\"./compose.js\\\";\\n21\\timport type { FormKind, SubjectKind } from \\\"../../../shared/derivation.js\\\";\\n22\\t\\n23\\texport interface TurnSource {\\n24\\t  turnId: string;\\n25\\t  status: \\\"open\\\" | \\\"closed\\\";\\n26\\t  deleted: boolean;\\n27\\t}\\n28\\t\\n29\\texport function readTurnSource(db: DatabaseSync, turnId: string): TurnSource | undefined {\\n30\\t  const row = db\\n31\\t    .prepare(`SELECT status, deleted_at FROM turns WHERE turn_id = ?`)\\n32\\t    .get(turnId) as unknown as { status: string; deleted_at: string | null } | undefined;\\n33\\t  if (row === undefined) return undefined;\\n34\\t  return {\\n35\\t    turnId,\\n36\\t    status: row.status as TurnSource[\\\"status\\\"],\\n37\\t    deleted: row.deleted_at !== null,\\n38\\t  };\\n39\\t}\\n40\\t\\n41\\t// Member messages in message order, blocks attached, deleted messages\\n42\\t// filtered (tech design §Mechanics: composition's member enumeration reads\\n43\\t// the live projection only).\\n44\\texport function readMemberMessages(db: DatabaseSync, turnId: string): ComposeMessage[] {\\n45\\t  const messages = db\\n46\\t    .prepare(\\n47\\t      `SELECT message_id, kind FROM message\\n48\\t       WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\\n49\\t    )\\n50\\t    .all(turnId) as unknown as Array<{ message_id: string; kind: string }>;\\n51\\t  const blockStmt = db.prepare(\\n52\\t    `SELECT block_type, content FROM message_block\\n53\\t     WHERE message_id = ? ORDER BY block_index`,\\n54\\t  );\\n55\\t  return messages.map((message) => {\\n56\\t    const blocks = blockStmt.all(message.message_id) as unknown as Array<{\\n57\\t      block_type: string;\\n58\\t      content: string;\\n59\\t    }>;\\n60\\t    return {\\n61\\t      messageId: message.message_id,\\n62\\t      kind: message.kind as RenderingPartKind,\\n63\\t      blocks: blocks.map((block) => ({\\n64\\t        blockType: block.block_type,\\n65\\t        content: JSON.parse(block.content) as Record<string, unknown>,\\n66\\t      })),\\n67\\t    };\\n68\\t  });\\n69\\t}\\n70\\t\\n71\\t// The message-owned form rows for a set of member messages, keyed for\\n72\\t// composition. A cross-owner *read* by design: composition consumes message\\n73\\t// forms; only message handlers ever write them (DD-2 ownership is a write\\n74\\t// rule).\\n75\\texport function readMessageFormRows(\\n76\\t  db: DatabaseSync,\\n77\\t  messageIds: readonly string[],\\n78\\t): Map<string, ComposeFormRow> {\\n79\\t  const rows = new Map<string, ComposeFormRow>();\\n80\\t  if (messageIds.length === 0) return rows;\\n81\\t  const placeholders = messageIds.map(() => \\\"?\\\").join(\\\", \\\");\\n82\\t  const raw = db\\n83\\t    .prepare(\\n84\\t      `SELECT subject_id, form, state, content, metadata FROM derived_form\\n85\\t       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\\n86\\t    )\\n87\\t    .all(...messageIds) as unknown as Array<{\\n88\\t    subject_id: string;\\n89\\t    form: string;\\n90\\t    state: string;\\n91\\t    content: string | null;\\n92\\t    metadata: string | null;\\n93\\t  }>;\\n94\\t  for (const row of raw) {\\n95\\t    const view: ComposeFormRow = { state: row.state as ComposeFormRow[\\\"state\\\"] };\\n96\\t    if (row.content !== null) view.content = row.content;\\n97\\t    if (row.metadata !== null) {\\n98\\t      view.metadata = JSON.parse(row.metadata) as NonNullable<ComposeFormRow[\\\"metadata\\\"]>;\\n99\\t    }\\n100\\t    rows.set(composeFormKey(row.subject_id, row.form as FormKind), view);\\n101\\t  }\\n102\\t  return rows;\\n103\\t}\\n104\\t\\n105\\t// Member projections in turn order for the chunk summaries: member rows by\\n106\\t// member_idx, deleted turns filtered, each joined to its stored\\n107\\t// lower_band_projection row (state + content as landed — never re-derived)\\n108\\t// and to its turn_rendering's mechanically stamped tool-run receipts\\n109\\t// (AC-3.8: the detailed summary's receipt material, read not re-derived).\\n110\\texport interface MemberProjection {\\n111\\t  turnId: string;\\n112\\t  state?: string; // undefined: no projection row exists for the member\\n113\\t  content?: string;\\n114\\t  receipts: ToolRunReceipt[]; // empty when the member turn had no tool activity\\n115\\t}\\n116\\t\\n117\\texport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\\n118\\t  const rows = db\\n119\\t    .prepare(\\n120\\t      `SELECT cm.turn_id, df.state, df.content, rf.metadata AS rendering_metadata\\n121\\t       FROM chunk_member cm\\n122\\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\\n123\\t       LEFT JOIN derived_form df ON df.subject_kind = 'turn'\\n124\\t         AND df.subject_id = cm.turn_id AND df.form = 'lower_band_projection'\\n125\\t       LEFT JOIN derived_form rf ON rf.subject_kind = 'turn'\\n126\\t         AND rf.subject_id = cm.turn_id AND rf.form = 'turn_rendering'\\n127\\t       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\\n128\\t    )\\n129\\t    .all(chunkId) as unknown as Array<{\\n130\\t    turn_id: string;\\n131\\t    state: string | null;\\n132\\t    content: string | null;\\n133\\t    rendering_metadata: string | null;\\n134\\t  }>;\\n135\\t  return rows.map((row) => {\\n136\\t    const metadata =\\n137\\t      row.rendering_metadata === null\\n138\\t        ? undefined\\n139\\t        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\\n140\\t    const projection: MemberProjection = {\\n141\\t      turnId: row.turn_id,\\n142\\t      receipts: metadata?.receipts ?? [],\\n143\\t    };\\n144\\t    if (row.state !== null) projection.state = row.state;\\n145\\t    if (row.content !== null) projection.content = row.content;\\n146\\t    return projection;\\n147\\t  });\\n148\\t}\\n149\\t\\n150\\tinterface RawOwnedFormRow {\\n151\\t  subject_id: string;\\n152\\t  form: string;\\n153\\t  state: string;\\n154\\t  content: string | null;\\n155\\t  reason: string | null;\\n156\\t  metadata: string | null;\\n157\\t  source_version: number | bigint;\\n158\\t  gaps: string | null;\\n159\\t  derived_at: string | null;\\n160\\t}\\n161\\t\\n162\\t// Every form row this owner holds for one subject kind, grouped by subject\\n163\\t// id — the form read-back joined onto turn and chunk reads (AC-4.7's\\n164\\t// \\\"record with form states\\\", mirroring messages.readMessageForms). Rows come\\n165\\t// back exactly as the pipeline landed them; nothing is derived at read time.\\n166\\texport function readOwnedForms(\\n167\\t  db: DatabaseSync,\\n168\\t  subjectKind: \\\"turn\\\" | \\\"chunk\\\",\\n169\\t): Map<string, DerivedForm[]> {\\n170\\t  const rows = db\\n171\\t    .prepare(\\n172\\t      `SELECT subject_id, form, state, content, reason, metadata,\\n173\\t              source_version, gaps, derived_at\\n174\\t       FROM derived_form WHERE subject_kind = ?\\n175\\t       ORDER BY subject_id, form`,\\n176\\t    )\\n177\\t    .all(subjectKind) as unknown as RawOwnedFormRow[];\\n178\\t  const bySubject = new Map<string, DerivedForm[]>();\\n179\\t  for (const row of rows) {\\n180\\t    const record: DerivedForm = {\\n181\\t      subjectKind,\\n182\\t      subjectId: row.subject_id,\\n183\\t      form: row.form as FormKind,\\n184\\t      state: row.state as DerivedFormState,\\n185\\t      sourceVersion: Number(row.source_version),\\n186\\t    };\\n187\\t    if (row.content !== null) record.content = row.content;\\n188\\t    if (row.reason !== null) record.reason = row.reason;\\n189\\t    if (row.metadata !== null) {\\n190\\t      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\\n191\\t    }\\n192\\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\\n193\\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\\n194\\t    const forms = bySubject.get(row.subject_id) ?? [];\\n195\\t    forms.push(record);\\n196\\t    bySubject.set(row.subject_id, forms);\\n197\\t  }\\n198\\t  return bySubject;\\n199\\t}\\n200\\t\\n201\\t// Chunk read-back rows for the listChunks surface: stored chunk state plus\\n202\\t// live (deleted-filtered) membership in member order.\\n203\\texport interface ChunkReadRow {\\n204\\t  chunkId: string;\\n205\\t  chunkOrder: number;\\n206\\t  status: \\\"open\\\" | \\\"closed\\\";\\n207\\t  accumulatedProjectedTokens: number;\\n208\\t  memberTurnIds: string[];\\n209\\t}\\n210\\t\\n211\\texport function readChunkRows(db: DatabaseSync): ChunkReadRow[] {\\n212\\t  const chunks = db\\n213\\t    .prepare(\\n214\\t      `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\\n215\\t       FROM chunk ORDER BY chunk_order`,\\n216\\t    )\\n217\\t    .all() as unknown as Array<{\\n218\\t    chunk_id: string;\\n219\\t    chunk_order: number | bigint;\\n220\\t    status: string;\\n221\\t    accumulated_projected_tokens: number | bigint;\\n222\\t  }>;\\n223\\t  const memberStmt = db.prepare(\\n224\\t    `SELECT cm.turn_id FROM chunk_member cm\\n225\\t     JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\\n226\\t     WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\\n227\\t  );\\n228\\t  return chunks.map((row) => ({\\n229\\t    chunkId: row.chunk_id,\\n230\\t    chunkOrder: Number(row.chunk_order),\\n231\\t    status: row.status as \\\"open\\\" | \\\"closed\\\",\\n232\\t    accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\\n233\\t    memberTurnIds: (memberStmt.all(row.chunk_id) as unknown as Array<{ turn_id: string }>).map(\\n234\\t      (member) => member.turn_id,\\n235\\t    ),\\n236\\t  }));\\n237\\t}\\n238\\t\\n239\\t// One form row by exact key for this owner's subjects — the requeue\\n240\\t// operation's refusal read (missing row, blocked state, current version).\\n241\\texport function readTurnFormRow(\\n242\\t  db: DatabaseSync,\\n243\\t  subjectKind: \\\"turn\\\" | \\\"chunk\\\",\\n244\\t  subjectId: string,\\n245\\t  form: FormKind,\\n246\\t): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\\n247\\t  const row = db\\n248\\t    .prepare(\\n249\\t      `SELECT state, reason, source_version FROM derived_form\\n250\\t       WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\\n251\\t    )\\n252\\t    .get(subjectKind, subjectId, form) as unknown as\\n253\\t    | { state: string; reason: string | null; source_version: number | bigint }\\n254\\t    | undefined;\\n255\\t  if (row === undefined) return undefined;\\n256\\t  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\\n257\\t    state: row.state as DerivedFormState,\\n258\\t    sourceVersion: Number(row.source_version),\\n259\\t  };\\n260\\t  if (row.reason !== null) view.reason = row.reason;\\n261\\t  return view;\\n262\\t}\\n263\\t\\n264\\t// The turns owner's report (Flow 4): one query over turn- and chunk-owned\\n265\\t// form rows LEFT JOINed with the live work_item targeting each form at its\\n266\\t// current source version. Both turn forms map to the one turn_derivation\\n267\\t// kind; the chunk summary forms map to their same-named kinds — the CASE is\\n268\\t// this owner's queue-site mapping inverted, mirroring the messages report.\\n269\\texport function reportTurnForms(\\n270\\t  db: DatabaseSync,\\n271\\t  opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {},\\n272\\t): FormReportEntry[] {\\n273\\t  const conditions = [\\\"df.subject_kind IN ('turn', 'chunk')\\\"];\\n274\\t  const params: string[] = [];\\n275\\t  const subjectFilters: string[] = [];\\n276\\t  if (opts.turnId !== undefined) {\\n277\\t    subjectFilters.push(\\\"(df.subject_kind = 'turn' AND df.subject_id = ?)\\\");\\n278\\t    params.push(opts.turnId);\\n279\\t  }\\n280\\t  if (opts.chunkId !== undefined) {\\n281\\t    subjectFilters.push(\\\"(df.subject_kind = 'chunk' AND df.subject_id = ?)\\\");\\n282\\t    params.push(opts.chunkId);\\n283\\t  }\\n284\\t  if (subjectFilters.length > 0) conditions.push(`(${subjectFilters.join(\\\" OR \\\")})`);\\n285\\t  // notReady is exact set equality by construction: every state but ready.\\n286\\t  if (opts.notReady === true) conditions.push(\\\"df.state <> 'ready'\\\");\\n287\\t  const rows = db\\n288\\t    .prepare(\\n289\\t      `SELECT df.subject_kind, df.subject_id, df.form, df.state, df.content, df.reason,\\n290\\t              df.metadata, df.source_version, df.gaps, df.derived_at,\\n291\\t              w.status AS queue_status, w.attempts AS queue_attempts,\\n292\\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\\n293\\t       FROM derived_form df\\n294\\t       LEFT JOIN work_item w\\n295\\t         ON w.status IN ('queued', 'claimed')\\n296\\t        AND w.kind = CASE WHEN df.subject_kind = 'turn' THEN 'turn_derivation' ELSE df.form END\\n297\\t        AND json_extract(\\n298\\t              w.source_ref,\\n299\\t              CASE WHEN df.subject_kind = 'turn' THEN '$.turnId' ELSE '$.chunkId' END\\n300\\t            ) = df.subject_id\\n301\\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\\n302\\t       WHERE ${conditions.join(\\\" AND \\\")}\\n303\\t       ORDER BY df.subject_kind DESC, df.subject_id, df.form`,\\n304\\t    )\\n305\\t    .all(...params) as unknown as Array<RawReportRow & { subject_kind: string }>;\\n306\\t  return rows.map((row) => reportEntryFromRow(row.subject_kind as SubjectKind, row));\\n307\\t}\\n308\\t\\n309\\texport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\\n310\\t  return (\\n311\\t    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\\n312\\t  );\\n313\\t}\\n314\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0b78a89b-de9b-459e-9df3-9832eb021204\",\"uuid\":\"02d06b96-db65-4d01-8473-d909b41975b3\",\"timestamp\":\"2026-06-11T07:48:56.302Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/forms.ts\",\"content\":\"// Turn-domain reads for derivation (Flow 3): the turn handler's view of its\\n// source turn, the member messages it composes (deleted-filtered — the\\n// shared read-filter rule lives here, once for this domain), the\\n// message-level form rows composition consumes, and the member projections\\n// the chunk summaries read. Completion writes for turn- and chunk-owned\\n// forms ride the work-queue util's `complete` (UPDATE-only, version-checked)\\n// — no write path here.\\nimport type { DatabaseSync } from \\\"node:sqlite\\\";\\nimport type {\\n  DependencyGap,\\n  DerivedForm,\\n  DerivedFormMetadata,\\n  DerivedFormState,\\n  FormReportEntry,\\n  RenderingPartKind,\\n  ToolRunReceipt,\\n} from \\\"../../../shared/derivation.js\\\";\\nimport { reportEntryFromRow, type RawReportRow } from \\\"../../../shared/report.js\\\";\\nimport type { ComposeFormRow, ComposeMessage } from \\\"./compose.js\\\";\\nimport { composeFormKey } from \\\"./compose.js\\\";\\nimport type { FormKind, SubjectKind } from \\\"../../../shared/derivation.js\\\";\\n\\nexport interface TurnSource {\\n  turnId: string;\\n  status: \\\"open\\\" | \\\"closed\\\";\\n  deleted: boolean;\\n}\\n\\nexport function readTurnSource(db: DatabaseSync, turnId: string): TurnSource | undefined {\\n  const row = db\\n    .prepare(`SELECT status, deleted_at FROM turns WHERE turn_id = ?`)\\n    .get(turnId) as unknown as { status: string; deleted_at: string | null } | undefined;\\n  if (row === undefined) return undefined;\\n  return {\\n    turnId,\\n    status: row.status as TurnSource[\\\"status\\\"],\\n    deleted: row.deleted_at !== null,\\n  };\\n}\\n\\n// Member messages in message order, blocks attached, deleted messages\\n// filtered (tech design §Mechanics: composition's member enumeration reads\\n// the live projection only).\\nexport function readMemberMessages(db: DatabaseSync, turnId: string): ComposeMessage[] {\\n  const messages = db\\n    .prepare(\\n      `SELECT message_id, kind FROM message\\n       WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\\n    )\\n    .all(turnId) as unknown as Array<{ message_id: string; kind: string }>;\\n  const blockStmt = db.prepare(\\n    `SELECT block_type, content FROM message_block\\n     WHERE message_id = ? ORDER BY block_index`,\\n  );\\n  return messages.map((message) => {\\n    const blocks = blockStmt.all(message.message_id) as unknown as Array<{\\n      block_type: string;\\n      content: string;\\n    }>;\\n    return {\\n      messageId: message.message_id,\\n      kind: message.kind as RenderingPartKind,\\n      blocks: blocks.map((block) => ({\\n        blockType: block.block_type,\\n        content: JSON.parse(block.content) as Record<string, unknown>,\\n      })),\\n    };\\n  });\\n}\\n\\n// The message-owned form rows for a set of member messages, keyed for\\n// composition. A cross-owner *read* by design: composition consumes message\\n// forms; only message handlers ever write them (DD-2 ownership is a write\\n// rule).\\nexport function readMessageFormRows(\\n  db: DatabaseSync,\\n  messageIds: readonly string[],\\n): Map<string, ComposeFormRow> {\\n  const rows = new Map<string, ComposeFormRow>();\\n  if (messageIds.length === 0) return rows;\\n  const placeholders = messageIds.map(() => \\\"?\\\").join(\\\", \\\");\\n  const raw = db\\n    .prepare(\\n      `SELECT subject_id, form, state, content, metadata FROM derived_form\\n       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\\n    )\\n    .all(...messageIds) as unknown as Array<{\\n    subject_id: string;\\n    form: string;\\n    state: string;\\n    content: string | null;\\n    metadata: string | null;\\n  }>;\\n  for (const row of raw) {\\n    const view: ComposeFormRow = { state: row.state as ComposeFormRow[\\\"state\\\"] };\\n    if (row.content !== null) view.content = row.content;\\n    if (row.metadata !== null) {\\n      view.metadata = JSON.parse(row.metadata) as NonNullable<ComposeFormRow[\\\"metadata\\\"]>;\\n    }\\n    rows.set(composeFormKey(row.subject_id, row.form as FormKind), view);\\n  }\\n  return rows;\\n}\\n\\n// Member projections in turn order for the chunk summaries: member rows by\\n// member_idx, deleted turns filtered, each joined to its stored\\n// lower_band_projection row (state + content as landed — never re-derived)\\n// and to its turn_rendering's mechanically stamped tool-run receipts\\n// (AC-3.8: the detailed summary's receipt material, read not re-derived).\\nexport interface MemberProjection {\\n  turnId: string;\\n  state?: string; // undefined: no projection row exists for the member\\n  content?: string;\\n  receipts: ToolRunReceipt[]; // empty when the member turn had no tool activity\\n}\\n\\nexport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\\n  const rows = db\\n    .prepare(\\n      `SELECT cm.turn_id, df.state, df.content, rf.metadata AS rendering_metadata\\n       FROM chunk_member cm\\n       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\\n       LEFT JOIN derived_form df ON df.subject_kind = 'turn'\\n         AND df.subject_id = cm.turn_id AND df.form = 'lower_band_projection'\\n       LEFT JOIN derived_form rf ON rf.subject_kind = 'turn'\\n         AND rf.subject_id = cm.turn_id AND rf.form = 'turn_rendering'\\n       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\\n    )\\n    .all(chunkId) as unknown as Array<{\\n    turn_id: string;\\n    state: string | null;\\n    content: string | null;\\n    rendering_metadata: string | null;\\n  }>;\\n  return rows.map((row) => {\\n    const metadata =\\n      row.rendering_metadata === null\\n        ? undefined\\n        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\\n    const projection: MemberProjection = {\\n      turnId: row.turn_id,\\n      receipts: metadata?.receipts ?? [],\\n    };\\n    if (row.state !== null) projection.state = row.state;\\n    if (row.content !== null) projection.content = row.content;\\n    return projection;\\n  });\\n}\\n\\ninterface RawOwnedFormRow {\\n  subject_id: string;\\n  form: string;\\n  state: string;\\n  content: string | null;\\n  reason: string | null;\\n  metadata: string | null;\\n  source_version: number | bigint;\\n  gaps: string | null;\\n  derived_at: string | null;\\n}\\n\\n// Every form row this owner holds for one subject kind, grouped by subject\\n// id — the form read-back joined onto turn and chunk reads (AC-4.7's\\n// \\\"record with form states\\\", mirroring messages.readMessageForms). Rows come\\n// back exactly as the pipeline landed them; nothing is derived at read time.\\nexport function readOwnedForms(\\n  db: DatabaseSync,\\n  subjectKind: \\\"turn\\\" | \\\"chunk\\\",\\n): Map<string, DerivedForm[]> {\\n  const rows = db\\n    .prepare(\\n      `SELECT subject_id, form, state, content, reason, metadata,\\n              source_version, gaps, derived_at\\n       FROM derived_form WHERE subject_kind = ?\\n       ORDER BY subject_id, form`,\\n    )\\n    .all(subjectKind) as unknown as RawOwnedFormRow[];\\n  const bySubject = new Map<string, DerivedForm[]>();\\n  for (const row of rows) {\\n    const record: DerivedForm = {\\n      subjectKind,\\n      subjectId: row.subject_id,\\n      form: row.form as FormKind,\\n      state: row.state as DerivedFormState,\\n      sourceVersion: Number(row.source_version),\\n    };\\n    if (row.content !== null) record.content = row.content;\\n    if (row.reason !== null) record.reason = row.reason;\\n    if (row.metadata !== null) {\\n      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\\n    }\\n    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\\n    if (row.derived_at !== null) record.derivedAt = row.derived_at;\\n    const forms = bySubject.get(row.subject_id) ?? [];\\n    forms.push(record);\\n    bySubject.set(row.subject_id, forms);\\n  }\\n  return bySubject;\\n}\\n\\n// Chunk read-back rows for the listChunks surface: stored chunk state plus\\n// live (deleted-filtered) membership in member order.\\nexport interface ChunkReadRow {\\n  chunkId: string;\\n  chunkOrder: number;\\n  status: \\\"open\\\" | \\\"closed\\\";\\n  accumulatedProjectedTokens: number;\\n  memberTurnIds: string[];\\n}\\n\\nexport function readChunkRows(db: DatabaseSync): ChunkReadRow[] {\\n  const chunks = db\\n    .prepare(\\n      `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\\n       FROM chunk ORDER BY chunk_order`,\\n    )\\n    .all() as unknown as Array<{\\n    chunk_id: string;\\n    chunk_order: number | bigint;\\n    status: string;\\n    accumulated_projected_tokens: number | bigint;\\n  }>;\\n  const memberStmt = db.prepare(\\n    `SELECT cm.turn_id FROM chunk_member cm\\n     JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\\n     WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\\n  );\\n  return chunks.map((row) => ({\\n    chunkId: row.chunk_id,\\n    chunkOrder: Number(row.chunk_order),\\n    status: row.status as \\\"open\\\" | \\\"closed\\\",\\n    accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\\n    memberTurnIds: (memberStmt.all(row.chunk_id) as unknown as Array<{ turn_id: string }>).map(\\n      (member) => member.turn_id,\\n    ),\\n  }));\\n}\\n\\n// One form row by exact key for this owner's subjects — the requeue\\n// operation's refusal read (missing row, blocked state, current version).\\nexport function readTurnFormRow(\\n  db: DatabaseSync,\\n  subjectKind: \\\"turn\\\" | \\\"chunk\\\",\\n  subjectId: string,\\n  form: FormKind,\\n): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\\n  const row = db\\n    .prepare(\\n      `SELECT state, reason, source_version FROM derived_form\\n       WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\\n    )\\n    .get(subjectKind, subjectId, form) as unknown as\\n    | { state: string; reason: string | null; source_version: number | bigint }\\n    | undefined;\\n  if (row === undefined) return undefined;\\n  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\\n    state: row.state as DerivedFormState,\\n    sourceVersion: Number(row.source_version),\\n  };\\n  if (row.reason !== null) view.reason = row.reason;\\n  return view;\\n}\\n\\n// The turns owner's report (Flow 4): one query over turn- and chunk-owned\\n// form rows LEFT JOINed with the live work_item targeting each form at its\\n// current source version. Both turn forms map to the one turn_derivation\\n// kind; the chunk summary forms map to their same-named kinds — the CASE is\\n// this owner's queue-site mapping inverted, mirroring the messages report.\\nexport function reportTurnForms(\\n  db: DatabaseSync,\\n  opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {},\\n): FormReportEntry[] {\\n  const conditions = [\\\"df.subject_kind IN ('turn', 'chunk')\\\"];\\n  const params: string[] = [];\\n  const subjectFilters: string[] = [];\\n  if (opts.turnId !== undefined) {\\n    subjectFilters.push(\\\"(df.subject_kind = 'turn' AND df.subject_id = ?)\\\");\\n    params.push(opts.turnId);\\n  }\\n  if (opts.chunkId !== undefined) {\\n    subjectFilters.push(\\\"(df.subject_kind = 'chunk' AND df.subject_id = ?)\\\");\\n    params.push(opts.chunkId);\\n  }\\n  if (subjectFilters.length > 0) conditions.push(`(${subjectFilters.join(\\\" OR \\\")})`);\\n  // notReady is exact set equality by construction: every state but ready.\\n  if (opts.notReady === true) conditions.push(\\\"df.state <> 'ready'\\\");\\n  const rows = db\\n    .prepare(\\n      `SELECT df.subject_kind, df.subject_id, df.form, df.state, df.content, df.reason,\\n              df.metadata, df.source_version, df.gaps, df.derived_at,\\n              w.status AS queue_status, w.attempts AS queue_attempts,\\n              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\\n       FROM derived_form df\\n       LEFT JOIN work_item w\\n         ON w.status IN ('queued', 'claimed')\\n        AND w.kind = CASE WHEN df.subject_kind = 'turn' THEN 'turn_derivation' ELSE df.form END\\n        AND json_extract(\\n              w.source_ref,\\n              CASE WHEN df.subject_kind = 'turn' THEN '$.turnId' ELSE '$.chunkId' END\\n            ) = df.subject_id\\n        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\\n       WHERE ${conditions.join(\\\" AND \\\")}\\n       ORDER BY df.subject_kind DESC, df.subject_id, df.form`,\\n    )\\n    .all(...params) as unknown as Array<RawReportRow & { subject_kind: string }>;\\n  return rows.map((row) => reportEntryFromRow(row.subject_kind as SubjectKind, row));\\n}\\n\\nexport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\\n  return (\\n    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\\n  );\\n}\\n\",\"numLines\":314,\"startLine\":1,\"totalLines\":314}}}\npackages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/06-message-turn-delete/streams/005-implementor.stdout.log:379:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01NGSbei8MCK6ocG8pqeuKfJ\",\"type\":\"tool_result\",\"content\":\"     603 test/mutations-delete.test.ts\\n     208 test/cli-process-mutations-delete.test.ts\\n     536 test/mutations.test.ts\\n     171 test/cli-process-mutations.test.ts\\n    1518 total\\n4:// the Epic 01 read-back (TC-6.1); its own forms drop while the turn and\\n6:// exactly at the chunk (TC-6.2). Prompt protection routes whole-exchange\\n7:// intent to the turn surface (TC-6.3), where deleteTurn removes the turn\\n8:// and all its messages from reads and chunk membership (TC-6.4), re-derives\\n10:// boundary (TC-6.5, architecture risk: the captureInputs assertion proves\\n13:// (TC-6.6, architecture risk). Refusals — open turn, missing id, double\\n15:// (TC-6.7). The CLI parity leg (TC-6.8) lives in\\n18:import { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n177:describe(\\\"TC-6.1 / AC-6.1: a deleted message leaves reads and membership; its events remain\\\", () => {\\n178:  it(\\\"deleting a tool-result message removes it from message reads and turn membership, not from event read-back\\\", async () => {\\n206:describe(\\\"TC-6.2 / AC-6.2 (architecture risk): delete drops own forms, re-queues upward, stops at the chunk\\\", () => {\\n207:  it(\\\"the deleted message's forms are gone, its turn and chunk re-queue, chunk 2 is byte-stable\\\", async () => {\\n282:describe(\\\"TC-6.3 / AC-6.3 (architecture risk): prompt protection routes to the turn surface\\\", () => {\\n283:  it(\\\"deleting a turn-initiating prompt is refused naming the turn and the turns-delete path; nothing changes\\\", async () => {\\n303:describe(\\\"TC-6.4 / AC-6.4: turn delete removes the turn and its messages from reads; events remain\\\", () => {\\n304:  it(\\\"a three-message turn leaves turn reads, message reads, and chunk membership; event read-back is byte-stable\\\", async () => {\\n348:describe(\\\"TC-6.5 / AC-6.5 (architecture risk): the chunk re-derives from remaining members; boundaries never move\\\", () => {\\n349:  it(\\\"deleting one of chunk 1's two turns rebuilds its summaries from the survivor; chunk 2 and all boundaries are identical\\\", async () => {\\n419:describe(\\\"TC-6.6 / AC-6.6 (architecture risk): an emptied chunk drops its summaries — absent, never failed\\\", () => {\\n420:  it(\\\"deleting every turn in a chunk leaves an empty chunk with no summary rows, no queued rebuild, and clean reads\\\", async () => {\\n433:    // One member left: the chunk clears and re-queues (the TC-6.5 path).\\n475:describe(\\\"TC-6.7 / AC-6.7: refusals are stable and change nothing — double delete included\\\", () => {\\n476:  it(\\\"open-turn target, bogus id, and a second delete of the same id refuse with stable codes; the record is identical after each\\\", async () => {\\n519:  it(\\\"the turn surface refuses the same way: open turn, bogus id, double delete\\\", async () => {\\n554:  it(\\\"deleting a turn whose messages were individually deleted first still works (live-row membership walk)\\\", async () => {\\n578:describe(\\\"background mode: delete-and-walk-away (production path)\\\", () => {\\n579:  it(\\\"the cascade's enqueue pokes ride the commit; the minus-one rebuild runs with no further call\\\", async () => {\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"0b78a89b-de9b-459e-9df3-9832eb021204\",\"uuid\":\"6187db97-5faf-4a48-b06e-5aa519b2f8cc\",\"timestamp\":\"2026-06-11T07:49:16.119Z\",\"tool_use_result\":{\"stdout\":\"     603 test/mutations-delete.test.ts\\n     208 test/cli-process-mutations-delete.test.ts\\n     536 test/mutations.test.ts\\n     171 test/cli-process-mutations.test.ts\\n    1518 total\\n4:// the Epic 01 read-back (TC-6.1); its own forms drop while the turn and\\n6:// exactly at the chunk (TC-6.2). Prompt protection routes whole-exchange\\n7:// intent to the turn surface (TC-6.3), where deleteTurn removes the turn\\n8:// and all its messages from reads and chunk membership (TC-6.4), re-derives\\n10:// boundary (TC-6.5, architecture risk: the captureInputs assertion proves\\n13:// (TC-6.6, architecture risk). Refusals — open turn, missing id, double\\n15:// (TC-6.7). The CLI parity leg (TC-6.8) lives in\\n18:import { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n177:describe(\\\"TC-6.1 / AC-6.1: a deleted message leaves reads and membership; its events remain\\\", () => {\\n178:  it(\\\"deleting a tool-result message removes it from message reads and turn membership, not from event read-back\\\", async () => {\\n206:describe(\\\"TC-6.2 / AC-6.2 (architecture risk): delete drops own forms, re-queues upward, stops at the chunk\\\", () => {\\n207:  it(\\\"the deleted message's forms are gone, its turn and chunk re-queue, chunk 2 is byte-stable\\\", async () => {\\n282:describe(\\\"TC-6.3 / AC-6.3 (architecture risk): prompt protection routes to the turn surface\\\", () => {\\n283:  it(\\\"deleting a turn-initiating prompt is refused naming the turn and the turns-delete path; nothing changes\\\", async () => {\\n303:describe(\\\"TC-6.4 / AC-6.4: turn delete removes the turn and its messages from reads; events remain\\\", () => {\\n304:  it(\\\"a three-message turn leaves turn reads, message reads, and chunk membership; event read-back is byte-stable\\\", async () => {\\n348:describe(\\\"TC-6.5 / AC-6.5 (architecture risk): the chunk re-derives from remaining members; boundaries never move\\\", () => {\\n349:  it(\\\"deleting one of chunk 1's two turns rebuilds its summaries from the survivor; chunk 2 and all boundaries are identical\\\", async () => {\\n419:describe(\\\"TC-6.6 / AC-6.6 (architecture risk): an emptied chunk drops its summaries — absent, never failed\\\", () => {\\n420:  it(\\\"deleting every turn in a chunk leaves an empty chunk with no summary rows, no queued rebuild, and clean reads\\\", async () => {\\n433:    // One member left: the chunk clears and re-queues (the TC-6.5 path).\\n475:describe(\\\"TC-6.7 / AC-6.7: refusals are stable and change nothing — double delete included\\\", () => {\\n476:  it(\\\"open-turn target, bogus id, and a second delete of the same id refuse with stable codes; the record is identical after each\\\", async () => {\\n519:  it(\\\"the turn surface refuses the same way: open turn, bogus id, double delete\\\", async () => {\\n554:  it(\\\"deleting a turn whose messages were individually deleted first still works (live-row membership walk)\\\", async () => {\\n578:describe(\\\"background mode: delete-and-walk-away (production path)\\\", () => {\\n579:  it(\\\"the cascade's enqueue pokes ride the commit; the minus-one rebuild runs with no further call\\\", async () => {\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\npackages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/06-message-turn-delete/streams/005-implementor.stdout.log:458:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01TTTEGevrZrGTJiSU8RJibA\",\"type\":\"tool_result\",\"content\":\"test/cli-process-mutations-delete.test.ts:2:// and `lhc turns delete` through the spawned dist/cli.js have full parity\\ntest/cli-process-mutations-delete.test.ts:11:import { spawnSync } from \\\"node:child_process\\\";\\ntest/cli-process-mutations-delete.test.ts:31:const cliPath = path.join(pkgRoot, \\\"dist\\\", \\\"cli.js\\\");\\ntest/cli-process-mutations-delete.test.ts:34:  const result = spawnSync(process.execPath, [cliPath, ...args], {\\ntest/cli-process-mutations-delete.test.ts:127:  it(\\\"the same message delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\\\", async () => {\\ntest/cli-process-mutations-delete.test.ts:148:  it(\\\"the same turn delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\\\", async () => {\\ntest/fixtures/provider-double.ts:7:// distinguishable by marker. Scripting (failNext / failKind / delayKind /\\ntest/fixtures/provider-double.ts:125:    // artifacts across in-process and spawned runs; the chunk-summary\\ntest/fixtures/threads.ts:371:): Promise<{ sdkPath: string; cliPath: string; batch: readonly MessageEventInput[] }> {\\ntest/fixtures/threads.ts:391:    const cliPath = store.threadPath();\\ntest/fixtures/threads.ts:396:      cliPath,\\ntest/fixtures/threads.ts:404:      [\\\"intake-stream\\\", \\\"message-events\\\", \\\"--file-path\\\", cliPath],\\ntest/fixtures/threads.ts:410:    return { sdkPath, cliPath, batch: events };\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"0b78a89b-de9b-459e-9df3-9832eb021204\",\"uuid\":\"bab4a61e-3715-4456-8611-6cd71a2fc9b9\",\"timestamp\":\"2026-06-11T07:49:43.472Z\",\"tool_use_result\":{\"stdout\":\"test/cli-process-mutations-delete.test.ts:2:// and `lhc turns delete` through the spawned dist/cli.js have full parity\\ntest/cli-process-mutations-delete.test.ts:11:import { spawnSync } from \\\"node:child_process\\\";\\ntest/cli-process-mutations-delete.test.ts:31:const cliPath = path.join(pkgRoot, \\\"dist\\\", \\\"cli.js\\\");\\ntest/cli-process-mutations-delete.test.ts:34:  const result = spawnSync(process.execPath, [cliPath, ...args], {\\ntest/cli-process-mutations-delete.test.ts:127:  it(\\\"the same message delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\\\", async () => {\\ntest/cli-process-mutations-delete.test.ts:148:  it(\\\"the same turn delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\\\", async () => {\\ntest/fixtures/provider-double.ts:7:// distinguishable by marker. Scripting (failNext / failKind / delayKind /\\ntest/fixtures/provider-double.ts:125:    // artifacts across in-process and spawned runs; the chunk-summary\\ntest/fixtures/threads.ts:371:): Promise<{ sdkPath: string; cliPath: string; batch: readonly MessageEventInput[] }> {\\ntest/fixtures/threads.ts:391:    const cliPath = store.threadPath();\\ntest/fixtures/threads.ts:396:      cliPath,\\ntest/fixtures/threads.ts:404:      [\\\"intake-stream\\\", \\\"message-events\\\", \\\"--file-path\\\", cliPath],\\ntest/fixtures/threads.ts:410:    return { sdkPath, cliPath, batch: events };\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\npackages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/06-message-turn-delete/streams/005-implementor.stdout.log:560:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":0,\"delta\":{\"type\":\"signature_delta\",\"signature\":\"\"}},\"session_id\":\"0b78a89b-de9b-459e-9df3-9832eb021204\",\"parent_tool_use_id\":null,\"uuid\":\"92dc78e9-dc5b-4902-bc00-e6ac4b49b4ab\"}\npackages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/06-message-turn-delete/streams/005-implementor.stdout.log:561:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-fable-5\",\"id\":\"msg_01GpbXRDjYnmrZgUWRGEUNeH\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1320,\"cache_read_input_tokens\":89914,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1320},\"output_tokens\":4,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"0b78a89b-de9b-459e-9df3-9832eb021204\",\"uuid\":\"633ff2a4-992c-49a5-a7be-1d5ce9ff7b86\",\"request_id\":\"req_011Cbw78hj3k2G5whBDUwdTi\"}\npackages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/06-message-turn-delete/streams/005-implementor.stdout.log:627:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01LmDuLBq2tLt1sChMYX7DSZ\",\"type\":\"tool_result\",\"content\":\"1\\t// Story 6 (Epic 02): messages.deleteMessage and turns.deleteTurn — Flow 6.\\n2\\t// Projection-level removal with the event log intact: a deleted message\\n3\\t// leaves reads and its turn's membership while its source events stay in\\n4\\t// the Epic 01 read-back (TC-6.1); its own forms drop while the turn and\\n5\\t// chunk clear and re-queue for minus-one composition, the cascade stopping\\n6\\t// exactly at the chunk (TC-6.2). Prompt protection routes whole-exchange\\n7\\t// intent to the turn surface (TC-6.3), where deleteTurn removes the turn\\n8\\t// and all its messages from reads and chunk membership (TC-6.4), re-derives\\n9\\t// the chunk's summaries from the remaining members without moving a\\n10\\t// boundary (TC-6.5, architecture risk: the captureInputs assertion proves\\n11\\t// the composition read path is deleted-filtered), and an emptied-out chunk\\n12\\t// drops its summary forms — absent, never failed, no rebuild queued\\n13\\t// (TC-6.6, architecture risk). Refusals — open turn, missing id, double\\n14\\t// delete through the filtered view — are stable and change nothing\\n15\\t// (TC-6.7). The CLI parity leg (TC-6.8) lives in\\n16\\t// cli-process-mutations-delete.test.ts (process suite). New file by the\\n17\\t// red-manifest rule: mutations.test.ts is hash-locked by Story 5.\\n18\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n19\\timport {\\n20\\t  createSdk,\\n21\\t  estimateTokens,\\n22\\t  intakeStream,\\n23\\t  messages,\\n24\\t  queueDetail,\\n25\\t  setSchedulerPoke,\\n26\\t  setThreadTouch,\\n27\\t  threads,\\n28\\t  turns,\\n29\\t  type DerivationProvider,\\n30\\t  type DrainReport,\\n31\\t  type Lhc,\\n32\\t  type MessageEventInput,\\n33\\t  type ProviderResult,\\n34\\t  type SdkConfig,\\n35\\t  type OpResult,\\n36\\t} from \\\"../src/index.js\\\";\\n37\\timport {\\n38\\t  createProviderDouble,\\n39\\t  openRaw,\\n40\\t  readChunks,\\n41\\t  readDerivedForms,\\n42\\t  tempStore,\\n43\\t  validEvent,\\n44\\t  type TempStore,\\n45\\t} from \\\"./fixtures/index.js\\\";\\n46\\t\\n47\\tlet store: TempStore;\\n48\\tbeforeEach(() => {\\n49\\t  store = tempStore();\\n50\\t});\\n51\\tafterEach(() => {\\n52\\t  store.cleanup();\\n53\\t  setSchedulerPoke(null);\\n54\\t  setThreadTouch(null);\\n55\\t});\\n56\\t\\n57\\tasync function newThread(): Promise<string> {\\n58\\t  const created = await threads.newThread({\\n59\\t    filePath: store.threadPath(),\\n60\\t    registryPath: store.registryPath,\\n61\\t  });\\n62\\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\\n63\\t  return created.value.filePath;\\n64\\t}\\n65\\t\\n66\\tfunction manualSdk(\\n67\\t  provider: DerivationProvider,\\n68\\t  overrides: Partial<Pick<SdkConfig, \\\"chunkPolicy\\\" | \\\"clock\\\" | \\\"mode\\\">> = {},\\n69\\t): Lhc {\\n70\\t  const config: SdkConfig = {\\n71\\t    provider,\\n72\\t    mode: overrides.mode ?? \\\"manual\\\",\\n73\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n74\\t    lease: { durationMs: 5000 },\\n75\\t  };\\n76\\t  if (overrides.chunkPolicy !== undefined) config.chunkPolicy = overrides.chunkPolicy;\\n77\\t  if (overrides.clock !== undefined) config.clock = overrides.clock;\\n78\\t  return createSdk(config);\\n79\\t}\\n80\\t\\n81\\tasync function send(\\n82\\t  sdk: Lhc,\\n83\\t  filePath: string,\\n84\\t  batch: readonly MessageEventInput[],\\n85\\t): Promise<void> {\\n86\\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n87\\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\\n88\\t}\\n89\\t\\n90\\tasync function drain(sdk: Lhc, filePath: string): Promise<DrainReport> {\\n91\\t  const result = await sdk.work.drain({ filePath });\\n92\\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\\n93\\t  return result.value;\\n94\\t}\\n95\\t\\n96\\tfunction rawDetail(filePath: string): ReturnType<typeof queueDetail> {\\n97\\t  const db = openRaw(filePath);\\n98\\t  try {\\n99\\t    return queueDetail(db);\\n100\\t  } finally {\\n101\\t    db.close();\\n102\\t  }\\n103\\t}\\n104\\t\\n105\\tfunction clearKey(entry: { subjectKind: string; subjectId: string; form: string }): string {\\n106\\t  return `${entry.subjectKind}/${entry.subjectId}/${entry.form}`;\\n107\\t}\\n108\\t\\n109\\tfunction unwrap<T>(result: OpResult<T>): T {\\n110\\t  if (!result.ok) throw new Error(`expected ok result, got ${result.error.code}`);\\n111\\t  return result.value;\\n112\\t}\\n113\\t\\n114\\t// The full mutation read-back surface in one snapshot — record, membership,\\n115\\t// chunks, events, forms, queue — for refusal-changes-nothing assertions.\\n116\\tasync function snapshot(filePath: string): Promise<unknown> {\\n117\\t  return {\\n118\\t    messages: unwrap(await messages.listMessages({ filePath })),\\n119\\t    turns: unwrap(await turns.listTurns({ filePath })),\\n120\\t    chunks: unwrap(await turns.listChunks({ filePath })),\\n121\\t    events: unwrap(await intakeStream.listEvents({ filePath })),\\n122\\t    forms: readDerivedForms(filePath),\\n123\\t    queue: rawDetail(filePath),\\n124\\t  };\\n125\\t}\\n126\\t\\n127\\t// One closed turn carrying a full tool run — m1 prompt, m2 tool_call,\\n128\\t// m3 tool_result, m4 assistant_text — drained ready. Under the default\\n129\\t// chunk policy t1's chunk stays open, so no chunk summary rows exist.\\n130\\tasync function toolRunThread(sdk: Lhc): Promise<string> {\\n131\\t  const filePath = await newThread();\\n132\\t  await send(sdk, filePath, [\\n133\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"use the tool\\\" } }),\\n134\\t    validEvent(\\\"tool_call\\\"),\\n135\\t    validEvent(\\\"tool_result\\\"),\\n136\\t    validEvent(\\\"assistant_text\\\", { payload: { text: \\\"tool run done\\\" } }),\\n137\\t    validEvent(\\\"turn_end\\\"),\\n138\\t  ]);\\n139\\t  await drain(sdk, filePath);\\n140\\t  return filePath;\\n141\\t}\\n142\\t\\n143\\t// Scripted lower-band projections of a fixed size, every other operation on\\n144\\t// the deterministic double — the TC-3.6 pattern for exact chunk membership.\\n145\\tconst PROJ = \\\"alpha bravo charlie delta echo foxtrot golf hotel india juliet\\\";\\n146\\tfunction withScriptedProjections(base: DerivationProvider): DerivationProvider {\\n147\\t  return {\\n148\\t    smoothPrompt: (i) => base.smoothPrompt(i),\\n149\\t    summarizeToolCall: (i) => base.summarizeToolCall(i),\\n150\\t    summarizeToolResult: (i) => base.summarizeToolResult(i),\\n151\\t    composeTurnRendering: (i) => base.composeTurnRendering(i),\\n152\\t    projectLowerBand: (): Promise<ProviderResult> =>\\n153\\t      Promise.resolve({ ok: true, text: PROJ }),\\n154\\t    summarizeChunkDetailed: (i) => base.summarizeChunkDetailed(i),\\n155\\t    summarizeChunkBrief: (i) => base.summarizeChunkBrief(i),\\n156\\t  };\\n157\\t}\\n158\\t\\n159\\t// Prompt+answer turns sized so chunks close at exactly two members:\\n160\\t// target 2·per+1 means the third turn's placement closes the chunk holding\\n161\\t// the first two (TC-3.6's golden case, reused as this story's fixture).\\n162\\tfunction twoTurnChunkSdk(double: DerivationProvider): Lhc {\\n163\\t  const per = estimateTokens(PROJ);\\n164\\t  return manualSdk(withScriptedProjections(double), {\\n165\\t    chunkPolicy: { targetProjectedTokens: 2 * per + 1, maxProjectedTokens: 100 * per },\\n166\\t  });\\n167\\t}\\n168\\t\\n169\\tasync function sendPromptTurn(sdk: Lhc, filePath: string, n: number): Promise<void> {\\n170\\t  await send(sdk, filePath, [\\n171\\t    validEvent(\\\"user_prompt\\\", { payload: { text: `prompt ${n}` } }),\\n172\\t    validEvent(\\\"assistant_text\\\", { payload: { text: `answer ${n}` } }),\\n173\\t    validEvent(\\\"turn_end\\\"),\\n174\\t  ]);\\n175\\t}\\n176\\t\\n177\\tdescribe(\\\"TC-6.1 / AC-6.1: a deleted message leaves reads and membership; its events remain\\\", () => {\\n178\\t  it(\\\"deleting a tool-result message removes it from message reads and turn membership, not from event read-back\\\", async () => {\\n179\\t    const double = createProviderDouble();\\n180\\t    const sdk = manualSdk(double);\\n181\\t    const filePath = await toolRunThread(sdk);\\n182\\t    const eventsBefore = unwrap(await intakeStream.listEvents({ filePath }));\\n183\\t\\n184\\t    const result = await messages.deleteMessage({ filePath }, { messageId: \\\"m3\\\" });\\n185\\t    expect(result.ok).toBe(true);\\n186\\t    if (!result.ok) return;\\n187\\t    expect(result.value.changed).toEqual({ messageIds: [\\\"m3\\\"], turnIds: [] });\\n188\\t\\n189\\t    // Message reads exclude the deleted record.\\n190\\t    const records = unwrap(await messages.listMessages({ filePath }));\\n191\\t    expect(records.map((record) => record.messageId)).toEqual([\\\"m1\\\", \\\"m2\\\", \\\"m4\\\"]);\\n192\\t\\n193\\t    // Turn membership shrinks in place — the turn row and its boundaries\\n194\\t    // untouched, the deleted member filtered out.\\n195\\t    const turnRecords = unwrap(await turns.listTurns({ filePath }));\\n196\\t    expect(turnRecords).toHaveLength(1);\\n197\\t    expect(turnRecords[0]?.memberMessageIds).toEqual([\\\"m1\\\", \\\"m2\\\", \\\"m4\\\"]);\\n198\\t\\n199\\t    // The audit surface is deliberately unfiltered: every source event,\\n200\\t    // byte-identical, including the deleted message's.\\n201\\t    expect(unwrap(await intakeStream.listEvents({ filePath }))).toEqual(eventsBefore);\\n202\\t    expect(eventsBefore.some((event) => event.eventKind === \\\"tool_result\\\")).toBe(true);\\n203\\t  });\\n204\\t});\\n205\\t\\n206\\tdescribe(\\\"TC-6.2 / AC-6.2 (architecture risk): delete drops own forms, re-queues upward, stops at the chunk\\\", () => {\\n207\\t  it(\\\"the deleted message's forms are gone, its turn and chunk re-queue, chunk 2 is byte-stable\\\", async () => {\\n208\\t    const double = createProviderDouble();\\n209\\t    // max=1: every turn forms its own immediately closed chunk — two\\n210\\t    // chunks, both with summaries (the TC-5.2 reach fixture).\\n211\\t    const sdk = manualSdk(double, {\\n212\\t      chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 1 },\\n213\\t    });\\n214\\t    const filePath = await newThread();\\n215\\t    await send(sdk, filePath, [\\n216\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"first prompt\\\" } }),\\n217\\t      validEvent(\\\"tool_call\\\"),\\n218\\t      validEvent(\\\"tool_result\\\"),\\n219\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"first answer\\\" } }),\\n220\\t      validEvent(\\\"turn_end\\\"),\\n221\\t    ]);\\n222\\t    await send(sdk, filePath, [\\n223\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"second prompt\\\" } }),\\n224\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"second answer\\\" } }),\\n225\\t      validEvent(\\\"turn_end\\\"),\\n226\\t    ]);\\n227\\t    await drain(sdk, filePath);\\n228\\t    const before = readDerivedForms(filePath);\\n229\\t    expect(before.every((form) => form.state === \\\"ready\\\")).toBe(true);\\n230\\t\\n231\\t    const result = await messages.deleteMessage({ filePath }, { messageId: \\\"m3\\\" });\\n232\\t    expect(result.ok).toBe(true);\\n233\\t    if (!result.ok) return;\\n234\\t\\n235\\t    // The subject's own forms drop; the chain above clears — and nothing\\n236\\t    // outside the chain is named.\\n237\\t    expect(result.value.dropped.map(clearKey)).toEqual([\\\"message/m3/tool_result_summary\\\"]);\\n238\\t    expect(result.value.cleared.map(clearKey).sort()).toEqual(\\n239\\t      [\\n240\\t        \\\"turn/t1/lower_band_projection\\\",\\n241\\t        \\\"turn/t1/turn_rendering\\\",\\n242\\t        \\\"chunk/c1/chunk_summary_brief\\\",\\n243\\t        \\\"chunk/c1/chunk_summary_detailed\\\",\\n244\\t      ].sort(),\\n245\\t    );\\n246\\t    expect(result.value.queued.map((item) => item.workItemId).sort()).toEqual([\\n247\\t      \\\"w-c1-chunk_summary_brief-v2\\\",\\n248\\t      \\\"w-c1-chunk_summary_detailed-v2\\\",\\n249\\t      \\\"w-t1-turn_derivation-v2\\\",\\n250\\t    ]);\\n251\\t\\n252\\t    // Dropped means rows removed — no ghost row in any state.\\n253\\t    const after = readDerivedForms(filePath);\\n254\\t    expect(after.some((form) => form.subjectId === \\\"m3\\\")).toBe(false);\\n255\\t    // The cleared half sits pending at the bumped version and queued.\\n256\\t    const clearedSet = new Set(result.value.cleared.map(clearKey));\\n257\\t    for (const form of after.filter((candidate) => clearedSet.has(clearKey(candidate)))) {\\n258\\t      expect(form.state).toBe(\\\"pending\\\");\\n259\\t      expect(form.sourceVersion).toBe(2);\\n260\\t    }\\n261\\t    // Everything else — m1's and m2's message forms, t2's forms, chunk 2's\\n262\\t    // summaries — deep-equals its pre-delete row, source version included.\\n263\\t    expect(after.filter((form) => !clearedSet.has(clearKey(form)))).toEqual(\\n264\\t      before.filter(\\n265\\t        (form) => !clearedSet.has(clearKey(form)) && form.subjectId !== \\\"m3\\\",\\n266\\t      ),\\n267\\t    );\\n268\\t\\n269\\t    // The rebuild composes minus-one: the production compose path\\n270\\t    // enumerates live members only (the filter at composition, proven by\\n271\\t    // the capture log, not by a read API).\\n272\\t    const captured = double.captureInputs();\\n273\\t    await drain(sdk, filePath);\\n274\\t    expect(readDerivedForms(filePath).every((form) => form.state === \\\"ready\\\")).toBe(true);\\n275\\t    const recompose = captured.filter((call) => call.op === \\\"composeTurnRendering\\\");\\n276\\t    expect(recompose).toHaveLength(1);\\n277\\t    const parts = (recompose[0]?.input as { parts: Array<{ messageId: string }> }).parts;\\n278\\t    expect(parts.map((part) => part.messageId)).toEqual([\\\"m1\\\", \\\"m2\\\", \\\"m4\\\"]);\\n279\\t  });\\n280\\t});\\n281\\t\\n282\\tdescribe(\\\"TC-6.3 / AC-6.3 (architecture risk): prompt protection routes to the turn surface\\\", () => {\\n283\\t  it(\\\"deleting a turn-initiating prompt is refused naming the turn and the turns-delete path; nothing changes\\\", async () => {\\n284\\t    const double = createProviderDouble();\\n285\\t    const sdk = manualSdk(double);\\n286\\t    const filePath = await toolRunThread(sdk);\\n287\\t    const before = await snapshot(filePath);\\n288\\t\\n289\\t    const result = await messages.deleteMessage({ filePath }, { messageId: \\\"m1\\\" });\\n290\\t    expect(result.ok).toBe(false);\\n291\\t    if (result.ok) return;\\n292\\t    expect(result.error.errorClass).toBe(\\\"caller_error\\\");\\n293\\t    expect(result.error.code).toBe(\\\"message_initiates_turn\\\");\\n294\\t    // The error names the turn and points at the turn-delete operation.\\n295\\t    expect(result.error.reason).toContain(\\\"t1\\\");\\n296\\t    expect(result.error.reason).toContain(\\\"turns.deleteTurn\\\");\\n297\\t    expect(result.error.reason).toContain(\\\"turns delete\\\");\\n298\\t\\n299\\t    expect(await snapshot(filePath)).toEqual(before);\\n300\\t  });\\n301\\t});\\n302\\t\\n303\\tdescribe(\\\"TC-6.4 / AC-6.4: turn delete removes the turn and its messages from reads; events remain\\\", () => {\\n304\\t  it(\\\"a three-message turn leaves turn reads, message reads, and chunk membership; event read-back is byte-stable\\\", async () => {\\n305\\t    const double = createProviderDouble();\\n306\\t    const sdk = manualSdk(double);\\n307\\t    const filePath = await newThread();\\n308\\t    await send(sdk, filePath, [\\n309\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"kill this exchange\\\" } }),\\n310\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"dead end, part one\\\" } }),\\n311\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"dead end, part two\\\" } }),\\n312\\t      validEvent(\\\"turn_end\\\"),\\n313\\t    ]);\\n314\\t    await drain(sdk, filePath);\\n315\\t    const eventsBefore = unwrap(await intakeStream.listEvents({ filePath }));\\n316\\t    expect(unwrap(await turns.listTurns({ filePath }))[0]?.chunkId).toBe(\\\"c1\\\");\\n317\\t\\n318\\t    const result = await turns.deleteTurn({ filePath }, { turnId: \\\"t1\\\" });\\n319\\t    expect(result.ok).toBe(true);\\n320\\t    if (!result.ok) return;\\n321\\t    expect(result.value.changed).toEqual({\\n322\\t      messageIds: [\\\"m1\\\", \\\"m2\\\", \\\"m3\\\"],\\n323\\t      turnIds: [\\\"t1\\\"],\\n324\\t    });\\n325\\t    // The drop-set walk goes down as well as up: the turn's two forms and\\n326\\t    // every member's own forms are rows-removed.\\n327\\t    expect(result.value.dropped.map(clearKey).sort()).toEqual(\\n328\\t      [\\n329\\t        \\\"message/m1/smoothed_prompt\\\",\\n330\\t        \\\"turn/t1/lower_band_projection\\\",\\n331\\t        \\\"turn/t1/turn_rendering\\\",\\n332\\t      ].sort(),\\n333\\t    );\\n334\\t\\n335\\t    expect(unwrap(await messages.listMessages({ filePath }))).toEqual([]);\\n336\\t    expect(unwrap(await turns.listTurns({ filePath }))).toEqual([]);\\n337\\t    // Chunk membership shrinks in place: the chunk row remains, its member\\n338\\t    // listing empties, no boundary moves.\\n339\\t    const chunks = unwrap(await turns.listChunks({ filePath }));\\n340\\t    expect(chunks).toHaveLength(1);\\n341\\t    expect(chunks[0]?.memberTurnIds).toEqual([]);\\n342\\t\\n343\\t    expect(unwrap(await intakeStream.listEvents({ filePath }))).toEqual(eventsBefore);\\n344\\t    expect(eventsBefore).toHaveLength(4);\\n345\\t  });\\n346\\t});\\n347\\t\\n348\\tdescribe(\\\"TC-6.5 / AC-6.5 (architecture risk): the chunk re-derives from remaining members; boundaries never move\\\", () => {\\n349\\t  it(\\\"deleting one of chunk 1's two turns rebuilds its summaries from the survivor; chunk 2 and all boundaries are identical\\\", async () => {\\n350\\t    const double = createProviderDouble();\\n351\\t    const sdk = twoTurnChunkSdk(double);\\n352\\t    const filePath = await newThread();\\n353\\t    for (let n = 1; n <= 5; n += 1) await sendPromptTurn(sdk, filePath, n);\\n354\\t    await drain(sdk, filePath);\\n355\\t\\n356\\t    // Fixture sanity: c1{t1,t2} and c2{t3,t4} closed with summaries, c3{t5}\\n357\\t    // still open — exact membership by the scripted projection size.\\n358\\t    const chunksBefore = readChunks(filePath);\\n359\\t    expect(chunksBefore.members).toEqual([\\n360\\t      { chunkId: \\\"c1\\\", turnId: \\\"t1\\\", memberIdx: 0 },\\n361\\t      { chunkId: \\\"c1\\\", turnId: \\\"t2\\\", memberIdx: 1 },\\n362\\t      { chunkId: \\\"c2\\\", turnId: \\\"t3\\\", memberIdx: 0 },\\n363\\t      { chunkId: \\\"c2\\\", turnId: \\\"t4\\\", memberIdx: 1 },\\n364\\t      { chunkId: \\\"c3\\\", turnId: \\\"t5\\\", memberIdx: 0 },\\n365\\t    ]);\\n366\\t    const formsBefore = readDerivedForms(filePath);\\n367\\t\\n368\\t    const result = await turns.deleteTurn({ filePath }, { turnId: \\\"t1\\\" });\\n369\\t    expect(result.ok).toBe(true);\\n370\\t    if (!result.ok) return;\\n371\\t    expect(result.value.cleared.map(clearKey).sort()).toEqual([\\n372\\t      \\\"chunk/c1/chunk_summary_brief\\\",\\n373\\t      \\\"chunk/c1/chunk_summary_detailed\\\",\\n374\\t    ]);\\n375\\t    expect(result.value.queued.map((item) => item.workItemId).sort()).toEqual([\\n376\\t      \\\"w-c1-chunk_summary_brief-v2\\\",\\n377\\t      \\\"w-c1-chunk_summary_detailed-v2\\\",\\n378\\t    ]);\\n379\\t\\n380\\t    const captured = double.captureInputs();\\n381\\t    await drain(sdk, filePath);\\n382\\t\\n383\\t    // The rebuilt summaries read exactly one member projection — the\\n384\\t    // double-input fixture proves the composition input excludes the\\n385\\t    // deleted turn (the read path a read-API assertion would miss).\\n386\\t    const detailed = captured.filter((call) => call.op === \\\"summarizeChunkDetailed\\\");\\n387\\t    const brief = captured.filter((call) => call.op === \\\"summarizeChunkBrief\\\");\\n388\\t    expect(detailed).toHaveLength(1);\\n389\\t    expect(brief).toHaveLength(1);\\n390\\t    expect((detailed[0]?.input as { memberProjections: string[] }).memberProjections).toEqual([\\n391\\t      PROJ,\\n392\\t    ]);\\n393\\t    expect((brief[0]?.input as { memberProjections: string[] }).memberProjections).toEqual([\\n394\\t      PROJ,\\n395\\t    ]);\\n396\\t\\n397\\t    const after = readDerivedForms(filePath);\\n398\\t    // Chunk 1's summaries are ready again at the next source version.\\n399\\t    for (const form of after.filter((candidate) => candidate.subjectId === \\\"c1\\\")) {\\n400\\t      expect(form.state).toBe(\\\"ready\\\");\\n401\\t      expect(form.sourceVersion).toBe(2);\\n402\\t    }\\n403\\t    // No other chunk's membership or derivations changed: every form\\n404\\t    // outside the deleted turn's chain — the other turns', the other\\n405\\t    // messages', chunk 2's — byte-equals its pre-delete row, and the raw\\n406\\t    // chunk/member tables — the boundaries — are identical (membership\\n407\\t    // only ever shrinks through reads).\\n408\\t    const touched = new Set([\\\"m1\\\", \\\"t1\\\", \\\"c1\\\"]);\\n409\\t    expect(after.filter((form) => !touched.has(form.subjectId))).toEqual(\\n410\\t      formsBefore.filter((form) => !touched.has(form.subjectId)),\\n411\\t    );\\n412\\t    expect(readChunks(filePath)).toEqual(chunksBefore);\\n413\\t    // The live read shrinks: chunk 1 lists only the survivor.\\n414\\t    const liveChunks = unwrap(await turns.listChunks({ filePath }));\\n415\\t    expect(liveChunks.find((chunk) => chunk.chunkId === \\\"c1\\\")?.memberTurnIds).toEqual([\\\"t2\\\"]);\\n416\\t  });\\n417\\t});\\n418\\t\\n419\\tdescribe(\\\"TC-6.6 / AC-6.6 (architecture risk): an emptied chunk drops its summaries — absent, never failed\\\", () => {\\n420\\t  it(\\\"deleting every turn in a chunk leaves an empty chunk with no summary rows, no queued rebuild, and clean reads\\\", async () => {\\n421\\t    const double = createProviderDouble();\\n422\\t    const sdk = twoTurnChunkSdk(double);\\n423\\t    const filePath = await newThread();\\n424\\t    for (let n = 1; n <= 3; n += 1) await sendPromptTurn(sdk, filePath, n);\\n425\\t    await drain(sdk, filePath);\\n426\\t    expect(readChunks(filePath).members.filter((member) => member.chunkId === \\\"c1\\\")).toHaveLength(\\n427\\t      2,\\n428\\t    );\\n429\\t\\n430\\t    const first = await turns.deleteTurn({ filePath }, { turnId: \\\"t1\\\" });\\n431\\t    expect(first.ok).toBe(true);\\n432\\t    if (!first.ok) return;\\n433\\t    // One member left: the chunk clears and re-queues (the TC-6.5 path).\\n434\\t    expect(first.value.queued.map((item) => item.workItemId).sort()).toEqual([\\n435\\t      \\\"w-c1-chunk_summary_brief-v2\\\",\\n436\\t      \\\"w-c1-chunk_summary_detailed-v2\\\",\\n437\\t    ]);\\n438\\t\\n439\\t    const second = await turns.deleteTurn({ filePath }, { turnId: \\\"t2\\\" });\\n440\\t    expect(second.ok).toBe(true);\\n441\\t    if (!second.ok) return;\\n442\\t    // Empties out: the summary forms drop with the last member — and the\\n443\\t    // first delete's still-queued rebuilds are superseded, not run.\\n444\\t    expect(second.value.cleared).toEqual([]);\\n445\\t    expect(second.value.queued).toEqual([]);\\n446\\t    expect(\\n447\\t      second.value.dropped.filter((entry) => entry.subjectKind === \\\"chunk\\\").map(clearKey).sort(),\\n448\\t    ).toEqual([\\\"chunk/c1/chunk_summary_brief\\\", \\\"chunk/c1/chunk_summary_detailed\\\"]);\\n449\\t    expect([...second.value.superseded].sort()).toEqual([\\n450\\t      \\\"w-c1-chunk_summary_brief-v2\\\",\\n451\\t      \\\"w-c1-chunk_summary_detailed-v2\\\",\\n452\\t    ]);\\n453\\t\\n454\\t    // Dropped, never failed: no c1 rows in any state, no failed form\\n455\\t    // anywhere, no live work targeting the empty chunk.\\n456\\t    const forms = readDerivedForms(filePath);\\n457\\t    expect(forms.some((form) => form.subjectId === \\\"c1\\\")).toBe(false);\\n458\\t    expect(forms.some((form) => form.state === \\\"failed\\\")).toBe(false);\\n459\\t    expect(rawDetail(filePath)).toEqual([]);\\n460\\t\\n461\\t    // Reads skip the empty chunk without error: it lists with zero members\\n462\\t    // and no form states; a drain finds nothing to do.\\n463\\t    const chunks = unwrap(await turns.listChunks({ filePath }));\\n464\\t    const emptied = chunks.find((chunk) => chunk.chunkId === \\\"c1\\\");\\n465\\t    expect(emptied?.memberTurnIds).toEqual([]);\\n466\\t    expect(emptied?.forms).toBeUndefined();\\n467\\t    expect(unwrap(await turns.listTurns({ filePath })).map((turn) => turn.turnId)).toEqual([\\n468\\t      \\\"t3\\\",\\n469\\t    ]);\\n470\\t    const report = await drain(sdk, filePath);\\n471\\t    expect(report.ran).toEqual([]);\\n472\\t  });\\n473\\t});\\n474\\t\\n475\\tdescribe(\\\"TC-6.7 / AC-6.7: refusals are stable and change nothing — double delete included\\\", () => {\\n476\\t  it(\\\"open-turn target, bogus id, and a second delete of the same id refuse with stable codes; the record is identical after each\\\", async () => {\\n477\\t    const double = createProviderDouble();\\n478\\t    const sdk = manualSdk(double);\\n479\\t    const filePath = await newThread();\\n480\\t    // t1 closed {m1 prompt, m2 answer}; t2 open {m4 prompt}.\\n481\\t    await send(sdk, filePath, [\\n482\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"closed prompt\\\" } }),\\n483\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"closed answer\\\" } }),\\n484\\t      validEvent(\\\"turn_end\\\"),\\n485\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"open prompt\\\" } }),\\n486\\t    ]);\\n487\\t    await drain(sdk, filePath);\\n488\\t    const before = await snapshot(filePath);\\n489\\t\\n490\\t    // Open-turn message: refused under the closed-turn boundary.\\n491\\t    const openTurn = await messages.deleteMessage({ filePath }, { messageId: \\\"m4\\\" });\\n492\\t    expect(openTurn.ok).toBe(false);\\n493\\t    if (openTurn.ok) return;\\n494\\t    expect(openTurn.error.errorClass).toBe(\\\"caller_error\\\");\\n495\\t    expect(openTurn.error.code).toBe(\\\"turn_open\\\");\\n496\\t    expect(await snapshot(filePath)).toEqual(before);\\n497\\t\\n498\\t    // Unknown id.\\n499\\t    const missing = await messages.deleteMessage({ filePath }, { messageId: \\\"m99\\\" });\\n500\\t    expect(missing.ok).toBe(false);\\n501\\t    if (missing.ok) return;\\n502\\t    expect(missing.error.code).toBe(\\\"message_not_found\\\");\\n503\\t    expect(await snapshot(filePath)).toEqual(before);\\n504\\t\\n505\\t    // Double delete: the first succeeds; the second reads the filtered view\\n506\\t    // and refuses as message_not_found — a refusal, not a silent success,\\n507\\t    // and not a tombstone-aware error branch.\\n508\\t    const firstDelete = await messages.deleteMessage({ filePath }, { messageId: \\\"m2\\\" });\\n509\\t    expect(firstDelete.ok).toBe(true);\\n510\\t    const afterDelete = await snapshot(filePath);\\n511\\t    const secondDelete = await messages.deleteMessage({ filePath }, { messageId: \\\"m2\\\" });\\n512\\t    expect(secondDelete.ok).toBe(false);\\n513\\t    if (secondDelete.ok) return;\\n514\\t    expect(secondDelete.error.errorClass).toBe(\\\"caller_error\\\");\\n515\\t    expect(secondDelete.error.code).toBe(\\\"message_not_found\\\");\\n516\\t    expect(await snapshot(filePath)).toEqual(afterDelete);\\n517\\t  });\\n518\\t\\n519\\t  it(\\\"the turn surface refuses the same way: open turn, bogus id, double delete\\\", async () => {\\n520\\t    const double = createProviderDouble();\\n521\\t    const sdk = manualSdk(double);\\n522\\t    const filePath = await newThread();\\n523\\t    await send(sdk, filePath, [\\n524\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"closed prompt\\\" } }),\\n525\\t      validEvent(\\\"turn_end\\\"),\\n526\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"open prompt\\\" } }),\\n527\\t    ]);\\n528\\t    await drain(sdk, filePath);\\n529\\t    const before = await snapshot(filePath);\\n530\\t\\n531\\t    const openTurn = await turns.deleteTurn({ filePath }, { turnId: \\\"t2\\\" });\\n532\\t    expect(openTurn.ok).toBe(false);\\n533\\t    if (openTurn.ok) return;\\n534\\t    expect(openTurn.error.errorClass).toBe(\\\"caller_error\\\");\\n535\\t    expect(openTurn.error.code).toBe(\\\"turn_open\\\");\\n536\\t    expect(await snapshot(filePath)).toEqual(before);\\n537\\t\\n538\\t    const missing = await turns.deleteTurn({ filePath }, { turnId: \\\"t99\\\" });\\n539\\t    expect(missing.ok).toBe(false);\\n540\\t    if (missing.ok) return;\\n541\\t    expect(missing.error.code).toBe(\\\"turn_not_found\\\");\\n542\\t    expect(await snapshot(filePath)).toEqual(before);\\n543\\t\\n544\\t    const firstDelete = await turns.deleteTurn({ filePath }, { turnId: \\\"t1\\\" });\\n545\\t    expect(firstDelete.ok).toBe(true);\\n546\\t    const afterDelete = await snapshot(filePath);\\n547\\t    const secondDelete = await turns.deleteTurn({ filePath }, { turnId: \\\"t1\\\" });\\n548\\t    expect(secondDelete.ok).toBe(false);\\n549\\t    if (secondDelete.ok) return;\\n550\\t    expect(secondDelete.error.code).toBe(\\\"turn_not_found\\\");\\n551\\t    expect(await snapshot(filePath)).toEqual(afterDelete);\\n552\\t  });\\n553\\t\\n554\\t  it(\\\"deleting a turn whose messages were individually deleted first still works (live-row membership walk)\\\", async () => {\\n555\\t    const double = createProviderDouble();\\n556\\t    const sdk = manualSdk(double);\\n557\\t    const filePath = await newThread();\\n558\\t    await send(sdk, filePath, [\\n559\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"the prompt\\\" } }),\\n560\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"answer one\\\" } }),\\n561\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"answer two\\\" } }),\\n562\\t      validEvent(\\\"turn_end\\\"),\\n563\\t    ]);\\n564\\t    await drain(sdk, filePath);\\n565\\t    expect((await messages.deleteMessage({ filePath }, { messageId: \\\"m2\\\" })).ok).toBe(true);\\n566\\t\\n567\\t    const result = await turns.deleteTurn({ filePath }, { turnId: \\\"t1\\\" });\\n568\\t    expect(result.ok).toBe(true);\\n569\\t    if (!result.ok) return;\\n570\\t    // Only the still-live members are stamped now; the earlier delete\\n571\\t    // already removed m2 and dropped its forms.\\n572\\t    expect(result.value.changed).toEqual({ messageIds: [\\\"m1\\\", \\\"m3\\\"], turnIds: [\\\"t1\\\"] });\\n573\\t    expect(unwrap(await messages.listMessages({ filePath }))).toEqual([]);\\n574\\t    expect(unwrap(await turns.listTurns({ filePath }))).toEqual([]);\\n575\\t  });\\n576\\t});\\n577\\t\\n578\\tdescribe(\\\"background mode: delete-and-walk-away (production path)\\\", () => {\\n579\\t  it(\\\"the cascade's enqueue pokes ride the commit; the minus-one rebuild runs with no further call\\\", async () => {\\n580\\t    const double = createProviderDouble();\\n581\\t    const sdk = manualSdk(double, { mode: \\\"background\\\" });\\n582\\t    const filePath = await newThread();\\n583\\t    await send(sdk, filePath, [\\n584\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"the prompt\\\" } }),\\n585\\t      validEvent(\\\"tool_call\\\"),\\n586\\t      validEvent(\\\"tool_result\\\"),\\n587\\t      validEvent(\\\"turn_end\\\"),\\n588\\t    ]);\\n589\\t    await sdk.drainSettled({ filePath });\\n590\\t    expect(readDerivedForms(filePath).every((form) => form.state === \\\"ready\\\")).toBe(true);\\n591\\t\\n592\\t    const result = await messages.deleteMessage({ filePath }, { messageId: \\\"m3\\\" });\\n593\\t    expect(result.ok).toBe(true);\\n594\\t    await sdk.drainSettled({ filePath });\\n595\\t\\n596\\t    const turnForms = readDerivedForms(filePath).filter((form) => form.subjectId === \\\"t1\\\");\\n597\\t    expect(turnForms).toHaveLength(2);\\n598\\t    expect(turnForms.every((form) => form.state === \\\"ready\\\" && form.sourceVersion === 2)).toBe(\\n599\\t      true,\\n600\\t    );\\n601\\t    expect(rawDetail(filePath)).toEqual([]);\\n602\\t  });\\n603\\t});\\n604\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0b78a89b-de9b-459e-9df3-9832eb021204\",\"uuid\":\"b4a55ec6-315e-4838-8ddf-ecaba1af1459\",\"timestamp\":\"2026-06-11T07:50:44.533Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/mutations-delete.test.ts\",\"content\":\"// Story 6 (Epic 02): messages.deleteMessage and turns.deleteTurn — Flow 6.\\n// Projection-level removal with the event log intact: a deleted message\\n// leaves reads and its turn's membership while its source events stay in\\n// the Epic 01 read-back (TC-6.1); its own forms drop while the turn and\\n// chunk clear and re-queue for minus-one composition, the cascade stopping\\n// exactly at the chunk (TC-6.2). Prompt protection routes whole-exchange\\n// intent to the turn surface (TC-6.3), where deleteTurn removes the turn\\n// and all its messages from reads and chunk membership (TC-6.4), re-derives\\n// the chunk's summaries from the remaining members without moving a\\n// boundary (TC-6.5, architecture risk: the captureInputs assertion proves\\n// the composition read path is deleted-filtered), and an emptied-out chunk\\n// drops its summary forms — absent, never failed, no rebuild queued\\n// (TC-6.6, architecture risk). Refusals — open turn, missing id, double\\n// delete through the filtered view — are stable and change nothing\\n// (TC-6.7). The CLI parity leg (TC-6.8) lives in\\n// cli-process-mutations-delete.test.ts (process suite). New file by the\\n// red-manifest rule: mutations.test.ts is hash-locked by Story 5.\\nimport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  createSdk,\\n  estimateTokens,\\n  intakeStream,\\n  messages,\\n  queueDetail,\\n  setSchedulerPoke,\\n  setThreadTouch,\\n  threads,\\n  turns,\\n  type DerivationProvider,\\n  type DrainReport,\\n  type Lhc,\\n  type MessageEventInput,\\n  type ProviderResult,\\n  type SdkConfig,\\n  type OpResult,\\n} from \\\"../src/index.js\\\";\\nimport {\\n  createProviderDouble,\\n  openRaw,\\n  readChunks,\\n  readDerivedForms,\\n  tempStore,\\n  validEvent,\\n  type TempStore,\\n} from \\\"./fixtures/index.js\\\";\\n\\nlet store: TempStore;\\nbeforeEach(() => {\\n  store = tempStore();\\n});\\nafterEach(() => {\\n  store.cleanup();\\n  setSchedulerPoke(null);\\n  setThreadTouch(null);\\n});\\n\\nasync function newThread(): Promise<string> {\\n  const created = await threads.newThread({\\n    filePath: store.threadPath(),\\n    registryPath: store.registryPath,\\n  });\\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\\n  return created.value.filePath;\\n}\\n\\nfunction manualSdk(\\n  provider: DerivationProvider,\\n  overrides: Partial<Pick<SdkConfig, \\\"chunkPolicy\\\" | \\\"clock\\\" | \\\"mode\\\">> = {},\\n): Lhc {\\n  const config: SdkConfig = {\\n    provider,\\n    mode: overrides.mode ?? \\\"manual\\\",\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    lease: { durationMs: 5000 },\\n  };\\n  if (overrides.chunkPolicy !== undefined) config.chunkPolicy = overrides.chunkPolicy;\\n  if (overrides.clock !== undefined) config.clock = overrides.clock;\\n  return createSdk(config);\\n}\\n\\nasync function send(\\n  sdk: Lhc,\\n  filePath: string,\\n  batch: readonly MessageEventInput[],\\n): Promise<void> {\\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\\n}\\n\\nasync function drain(sdk: Lhc, filePath: string): Promise<DrainReport> {\\n  const result = await sdk.work.drain({ filePath });\\n  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\\n  return result.value;\\n}\\n\\nfunction rawDetail(filePath: string): ReturnType<typeof queueDetail> {\\n  const db = openRaw(filePath);\\n  try {\\n    return queueDetail(db);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nfunction clearKey(entry: { subjectKind: string; subjectId: string; form: string }): string {\\n  return `${entry.subjectKind}/${entry.subjectId}/${entry.form}`;\\n}\\n\\nfunction unwrap<T>(result: OpResult<T>): T {\\n  if (!result.ok) throw new Error(`expected ok result, got ${result.error.code}`);\\n  return result.value;\\n}\\n\\n// The full mutation read-back surface in one snapshot — record, membership,\\n// chunks, events, forms, queue — for refusal-changes-nothing assertions.\\nasync function snapshot(filePath: string): Promise<unknown> {\\n  return {\\n    messages: unwrap(await messages.listMessages({ filePath })),\\n    turns: unwrap(await turns.listTurns({ filePath })),\\n    chunks: unwrap(await turns.listChunks({ filePath })),\\n    events: unwrap(await intakeStream.listEvents({ filePath })),\\n    forms: readDerivedForms(filePath),\\n    queue: rawDetail(filePath),\\n  };\\n}\\n\\n// One closed turn carrying a full tool run — m1 prompt, m2 tool_call,\\n// m3 tool_result, m4 assistant_text — drained ready. Under the default\\n// chunk policy t1's chunk stays open, so no chunk summary rows exist.\\nasync function toolRunThread(sdk: Lhc): Promise<string> {\\n  const filePath = await newThread();\\n  await send(sdk, filePath, [\\n    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"use the tool\\\" } }),\\n    validEvent(\\\"tool_call\\\"),\\n    validEvent(\\\"tool_result\\\"),\\n    validEvent(\\\"assistant_text\\\", { payload: { text: \\\"tool run done\\\" } }),\\n    validEvent(\\\"turn_end\\\"),\\n  ]);\\n  await drain(sdk, filePath);\\n  return filePath;\\n}\\n\\n// Scripted lower-band projections of a fixed size, every other operation on\\n// the deterministic double — the TC-3.6 pattern for exact chunk membership.\\nconst PROJ = \\\"alpha bravo charlie delta echo foxtrot golf hotel india juliet\\\";\\nfunction withScriptedProjections(base: DerivationProvider): DerivationProvider {\\n  return {\\n    smoothPrompt: (i) => base.smoothPrompt(i),\\n    summarizeToolCall: (i) => base.summarizeToolCall(i),\\n    summarizeToolResult: (i) => base.summarizeToolResult(i),\\n    composeTurnRendering: (i) => base.composeTurnRendering(i),\\n    projectLowerBand: (): Promise<ProviderResult> =>\\n      Promise.resolve({ ok: true, text: PROJ }),\\n    summarizeChunkDetailed: (i) => base.summarizeChunkDetailed(i),\\n    summarizeChunkBrief: (i) => base.summarizeChunkBrief(i),\\n  };\\n}\\n\\n// Prompt+answer turns sized so chunks close at exactly two members:\\n// target 2·per+1 means the third turn's placement closes the chunk holding\\n// the first two (TC-3.6's golden case, reused as this story's fixture).\\nfunction twoTurnChunkSdk(double: DerivationProvider): Lhc {\\n  const per = estimateTokens(PROJ);\\n  return manualSdk(withScriptedProjections(double), {\\n    chunkPolicy: { targetProjectedTokens: 2 * per + 1, maxProjectedTokens: 100 * per },\\n  });\\n}\\n\\nasync function sendPromptTurn(sdk: Lhc, filePath: string, n: number): Promise<void> {\\n  await send(sdk, filePath, [\\n    validEvent(\\\"user_prompt\\\", { payload: { text: `prompt ${n}` } }),\\n    validEvent(\\\"assistant_text\\\", { payload: { text: `answer ${n}` } }),\\n    validEvent(\\\"turn_end\\\"),\\n  ]);\\n}\\n\\ndescribe(\\\"TC-6.1 / AC-6.1: a deleted message leaves reads and membership; its events remain\\\", () => {\\n  it(\\\"deleting a tool-result message removes it from message reads and turn membership, not from event read-back\\\", async () => {\\n    const double = createProviderDouble();\\n    const sdk = manualSdk(double);\\n    const filePath = await toolRunThread(sdk);\\n    const eventsBefore = unwrap(await intakeStream.listEvents({ filePath }));\\n\\n    const result = await messages.deleteMessage({ filePath }, { messageId: \\\"m3\\\" });\\n    expect(result.ok).toBe(true);\\n    if (!result.ok) return;\\n    expect(result.value.changed).toEqual({ messageIds: [\\\"m3\\\"], turnIds: [] });\\n\\n    // Message reads exclude the deleted record.\\n    const records = unwrap(await messages.listMessages({ filePath }));\\n    expect(records.map((record) => record.messageId)).toEqual([\\\"m1\\\", \\\"m2\\\", \\\"m4\\\"]);\\n\\n    // Turn membership shrinks in place — the turn row and its boundaries\\n    // untouched, the deleted member filtered out.\\n    const turnRecords = unwrap(await turns.listTurns({ filePath }));\\n    expect(turnRecords).toHaveLength(1);\\n    expect(turnRecords[0]?.memberMessageIds).toEqual([\\\"m1\\\", \\\"m2\\\", \\\"m4\\\"]);\\n\\n    // The audit surface is deliberately unfiltered: every source event,\\n    // byte-identical, including the deleted message's.\\n    expect(unwrap(await intakeStream.listEvents({ filePath }))).toEqual(eventsBefore);\\n    expect(eventsBefore.some((event) => event.eventKind === \\\"tool_result\\\")).toBe(true);\\n  });\\n});\\n\\ndescribe(\\\"TC-6.2 / AC-6.2 (architecture risk): delete drops own forms, re-queues upward, stops at the chunk\\\", () => {\\n  it(\\\"the deleted message's forms are gone, its turn and chunk re-queue, chunk 2 is byte-stable\\\", async () => {\\n    const double = createProviderDouble();\\n    // max=1: every turn forms its own immediately closed chunk — two\\n    // chunks, both with summaries (the TC-5.2 reach fixture).\\n    const sdk = manualSdk(double, {\\n      chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 1 },\\n    });\\n    const filePath = await newThread();\\n    await send(sdk, filePath, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"first prompt\\\" } }),\\n      validEvent(\\\"tool_call\\\"),\\n      validEvent(\\\"tool_result\\\"),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"first answer\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    await send(sdk, filePath, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"second prompt\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"second answer\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    await drain(sdk, filePath);\\n    const before = readDerivedForms(filePath);\\n    expect(before.every((form) => form.state === \\\"ready\\\")).toBe(true);\\n\\n    const result = await messages.deleteMessage({ filePath }, { messageId: \\\"m3\\\" });\\n    expect(result.ok).toBe(true);\\n    if (!result.ok) return;\\n\\n    // The subject's own forms drop; the chain above clears — and nothing\\n    // outside the chain is named.\\n    expect(result.value.dropped.map(clearKey)).toEqual([\\\"message/m3/tool_result_summary\\\"]);\\n    expect(result.value.cleared.map(clearKey).sort()).toEqual(\\n      [\\n        \\\"turn/t1/lower_band_projection\\\",\\n        \\\"turn/t1/turn_rendering\\\",\\n        \\\"chunk/c1/chunk_summary_brief\\\",\\n        \\\"chunk/c1/chunk_summary_detailed\\\",\\n      ].sort(),\\n    );\\n    expect(result.value.queued.map((item) => item.workItemId).sort()).toEqual([\\n      \\\"w-c1-chunk_summary_brief-v2\\\",\\n      \\\"w-c1-chunk_summary_detailed-v2\\\",\\n      \\\"w-t1-turn_derivation-v2\\\",\\n    ]);\\n\\n    // Dropped means rows removed — no ghost row in any state.\\n    const after = readDerivedForms(filePath);\\n    expect(after.some((form) => form.subjectId === \\\"m3\\\")).toBe(false);\\n    // The cleared half sits pending at the bumped version and queued.\\n    const clearedSet = new Set(result.value.cleared.map(clearKey));\\n    for (const form of after.filter((candidate) => clearedSet.has(clearKey(candidate)))) {\\n      expect(form.state).toBe(\\\"pending\\\");\\n      expect(form.sourceVersion).toBe(2);\\n    }\\n    // Everything else — m1's and m2's message forms, t2's forms, chunk 2's\\n    // summaries — deep-equals its pre-delete row, source version included.\\n    expect(after.filter((form) => !clearedSet.has(clearKey(form)))).toEqual(\\n      before.filter(\\n        (form) => !clearedSet.has(clearKey(form)) && form.subjectId !== \\\"m3\\\",\\n      ),\\n    );\\n\\n    // The rebuild composes minus-one: the production compose path\\n    // enumerates live members only (the filter at composition, proven by\\n    // the capture log, not by a read API).\\n    const captured = double.captureInputs();\\n    await drain(sdk, filePath);\\n    expect(readDerivedForms(filePath).every((form) => form.state === \\\"ready\\\")).toBe(true);\\n    const recompose = captured.filter((call) => call.op === \\\"composeTurnRendering\\\");\\n    expect(recompose).toHaveLength(1);\\n    const parts = (recompose[0]?.input as { parts: Array<{ messageId: string }> }).parts;\\n    expect(parts.map((part) => part.messageId)).toEqual([\\\"m1\\\", \\\"m2\\\", \\\"m4\\\"]);\\n  });\\n});\\n\\ndescribe(\\\"TC-6.3 / AC-6.3 (architecture risk): prompt protection routes to the turn surface\\\", () => {\\n  it(\\\"deleting a turn-initiating prompt is refused naming the turn and the turns-delete path; nothing changes\\\", async () => {\\n    const double = createProviderDouble();\\n    const sdk = manualSdk(double);\\n    const filePath = await toolRunThread(sdk);\\n    const before = await snapshot(filePath);\\n\\n    const result = await messages.deleteMessage({ filePath }, { messageId: \\\"m1\\\" });\\n    expect(result.ok).toBe(false);\\n    if (result.ok) return;\\n    expect(result.error.errorClass).toBe(\\\"caller_error\\\");\\n    expect(result.error.code).toBe(\\\"message_initiates_turn\\\");\\n    // The error names the turn and points at the turn-delete operation.\\n    expect(result.error.reason).toContain(\\\"t1\\\");\\n    expect(result.error.reason).toContain(\\\"turns.deleteTurn\\\");\\n    expect(result.error.reason).toContain(\\\"turns delete\\\");\\n\\n    expect(await snapshot(filePath)).toEqual(before);\\n  });\\n});\\n\\ndescribe(\\\"TC-6.4 / AC-6.4: turn delete removes the turn and its messages from reads; events remain\\\", () => {\\n  it(\\\"a three-message turn leaves turn reads, message reads, and chunk membership; event read-back is byte-stable\\\", async () => {\\n    const double = createProviderDouble();\\n    const sdk = manualSdk(double);\\n    const filePath = await newThread();\\n    await send(sdk, filePath, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"kill this exchange\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"dead end, part one\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"dead end, part two\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    await drain(sdk, filePath);\\n    const eventsBefore = unwrap(await intakeStream.listEvents({ filePath }));\\n    expect(unwrap(await turns.listTurns({ filePath }))[0]?.chunkId).toBe(\\\"c1\\\");\\n\\n    const result = await turns.deleteTurn({ filePath }, { turnId: \\\"t1\\\" });\\n    expect(result.ok).toBe(true);\\n    if (!result.ok) return;\\n    expect(result.value.changed).toEqual({\\n      messageIds: [\\\"m1\\\", \\\"m2\\\", \\\"m3\\\"],\\n      turnIds: [\\\"t1\\\"],\\n    });\\n    // The drop-set walk goes down as well as up: the turn's two forms and\\n    // every member's own forms are rows-removed.\\n    expect(result.value.dropped.map(clearKey).sort()).toEqual(\\n      [\\n        \\\"message/m1/smoothed_prompt\\\",\\n        \\\"turn/t1/lower_band_projection\\\",\\n        \\\"turn/t1/turn_rendering\\\",\\n      ].sort(),\\n    );\\n\\n    expect(unwrap(await messages.listMessages({ filePath }))).toEqual([]);\\n    expect(unwrap(await turns.listTurns({ filePath }))).toEqual([]);\\n    // Chunk membership shrinks in place: the chunk row remains, its member\\n    // listing empties, no boundary moves.\\n    const chunks = unwrap(await turns.listChunks({ filePath }));\\n    expect(chunks).toHaveLength(1);\\n    expect(chunks[0]?.memberTurnIds).toEqual([]);\\n\\n    expect(unwrap(await intakeStream.listEvents({ filePath }))).toEqual(eventsBefore);\\n    expect(eventsBefore).toHaveLength(4);\\n  });\\n});\\n\\ndescribe(\\\"TC-6.5 / AC-6.5 (architecture risk): the chunk re-derives from remaining members; boundaries never move\\\", () => {\\n  it(\\\"deleting one of chunk 1's two turns rebuilds its summaries from the survivor; chunk 2 and all boundaries are identical\\\", async () => {\\n    const double = createProviderDouble();\\n    const sdk = twoTurnChunkSdk(double);\\n    const filePath = await newThread();\\n    for (let n = 1; n <= 5; n += 1) await sendPromptTurn(sdk, filePath, n);\\n    await drain(sdk, filePath);\\n\\n    // Fixture sanity: c1{t1,t2} and c2{t3,t4} closed with summaries, c3{t5}\\n    // still open — exact membership by the scripted projection size.\\n    const chunksBefore = readChunks(filePath);\\n    expect(chunksBefore.members).toEqual([\\n      { chunkId: \\\"c1\\\", turnId: \\\"t1\\\", memberIdx: 0 },\\n      { chunkId: \\\"c1\\\", turnId: \\\"t2\\\", memberIdx: 1 },\\n      { chunkId: \\\"c2\\\", turnId: \\\"t3\\\", memberIdx: 0 },\\n      { chunkId: \\\"c2\\\", turnId: \\\"t4\\\", memberIdx: 1 },\\n      { chunkId: \\\"c3\\\", turnId: \\\"t5\\\", memberIdx: 0 },\\n    ]);\\n    const formsBefore = readDerivedForms(filePath);\\n\\n    const result = await turns.deleteTurn({ filePath }, { turnId: \\\"t1\\\" });\\n    expect(result.ok).toBe(true);\\n    if (!result.ok) return;\\n    expect(result.value.cleared.map(clearKey).sort()).toEqual([\\n      \\\"chunk/c1/chunk_summary_brief\\\",\\n      \\\"chunk/c1/chunk_summary_detailed\\\",\\n    ]);\\n    expect(result.value.queued.map((item) => item.workItemId).sort()).toEqual([\\n      \\\"w-c1-chunk_summary_brief-v2\\\",\\n      \\\"w-c1-chunk_summary_detailed-v2\\\",\\n    ]);\\n\\n    const captured = double.captureInputs();\\n    await drain(sdk, filePath);\\n\\n    // The rebuilt summaries read exactly one member projection — the\\n    // double-input fixture proves the composition input excludes the\\n    // deleted turn (the read path a read-API assertion would miss).\\n    const detailed = captured.filter((call) => call.op === \\\"summarizeChunkDetailed\\\");\\n    const brief = captured.filter((call) => call.op === \\\"summarizeChunkBrief\\\");\\n    expect(detailed).toHaveLength(1);\\n    expect(brief).toHaveLength(1);\\n    expect((detailed[0]?.input as { memberProjections: string[] }).memberProjections).toEqual([\\n      PROJ,\\n    ]);\\n    expect((brief[0]?.input as { memberProjections: string[] }).memberProjections).toEqual([\\n      PROJ,\\n    ]);\\n\\n    const after = readDerivedForms(filePath);\\n    // Chunk 1's summaries are ready again at the next source version.\\n    for (const form of after.filter((candidate) => candidate.subjectId === \\\"c1\\\")) {\\n      expect(form.state).toBe(\\\"ready\\\");\\n      expect(form.sourceVersion).toBe(2);\\n    }\\n    // No other chunk's membership or derivations changed: every form\\n    // outside the deleted turn's chain — the other turns', the other\\n    // messages', chunk 2's — byte-equals its pre-delete row, and the raw\\n    // chunk/member tables — the boundaries — are identical (membership\\n    // only ever shrinks through reads).\\n    const touched = new Set([\\\"m1\\\", \\\"t1\\\", \\\"c1\\\"]);\\n    expect(after.filter((form) => !touched.has(form.subjectId))).toEqual(\\n      formsBefore.filter((form) => !touched.has(form.subjectId)),\\n    );\\n    expect(readChunks(filePath)).toEqual(chunksBefore);\\n    // The live read shrinks: chunk 1 lists only the survivor.\\n    const liveChunks = unwrap(await turns.listChunks({ filePath }));\\n    expect(liveChunks.find((chunk) => chunk.chunkId === \\\"c1\\\")?.memberTurnIds).toEqual([\\\"t2\\\"]);\\n  });\\n});\\n\\ndescribe(\\\"TC-6.6 / AC-6.6 (architecture risk): an emptied chunk drops its summaries — absent, never failed\\\", () => {\\n  it(\\\"deleting every turn in a chunk leaves an empty chunk with no summary rows, no queued rebuild, and clean reads\\\", async () => {\\n    const double = createProviderDouble();\\n    const sdk = twoTurnChunkSdk(double);\\n    const filePath = await newThread();\\n    for (let n = 1; n <= 3; n += 1) await sendPromptTurn(sdk, filePath, n);\\n    await drain(sdk, filePath);\\n    expect(readChunks(filePath).members.filter((member) => member.chunkId === \\\"c1\\\")).toHaveLength(\\n      2,\\n    );\\n\\n    const first = await turns.deleteTurn({ filePath }, { turnId: \\\"t1\\\" });\\n    expect(first.ok).toBe(true);\\n    if (!first.ok) return;\\n    // One member left: the chunk clears and re-queues (the TC-6.5 path).\\n    expect(first.value.queued.map((item) => item.workItemId).sort()).toEqual([\\n      \\\"w-c1-chunk_summary_brief-v2\\\",\\n      \\\"w-c1-chunk_summary_detailed-v2\\\",\\n    ]);\\n\\n    const second = await turns.deleteTurn({ filePath }, { turnId: \\\"t2\\\" });\\n    expect(second.ok).toBe(true);\\n    if (!second.ok) return;\\n    // Empties out: the summary forms drop with the last member — and the\\n    // first delete's still-queued rebuilds are superseded, not run.\\n    expect(second.value.cleared).toEqual([]);\\n    expect(second.value.queued).toEqual([]);\\n    expect(\\n      second.value.dropped.filter((entry) => entry.subjectKind === \\\"chunk\\\").map(clearKey).sort(),\\n    ).toEqual([\\\"chunk/c1/chunk_summary_brief\\\", \\\"chunk/c1/chunk_summary_detailed\\\"]);\\n    expect([...second.value.superseded].sort()).toEqual([\\n      \\\"w-c1-chunk_summary_brief-v2\\\",\\n      \\\"w-c1-chunk_summary_detailed-v2\\\",\\n    ]);\\n\\n    // Dropped, never failed: no c1 rows in any state, no failed form\\n    // anywhere, no live work targeting the empty chunk.\\n    const forms = readDerivedForms(filePath);\\n    expect(forms.some((form) => form.subjectId === \\\"c1\\\")).toBe(false);\\n    expect(forms.some((form) => form.state === \\\"failed\\\")).toBe(false);\\n    expect(rawDetail(filePath)).toEqual([]);\\n\\n    // Reads skip the empty chunk without error: it lists with zero members\\n    // and no form states; a drain finds nothing to do.\\n    const chunks = unwrap(await turns.listChunks({ filePath }));\\n    const emptied = chunks.find((chunk) => chunk.chunkId === \\\"c1\\\");\\n    expect(emptied?.memberTurnIds).toEqual([]);\\n    expect(emptied?.forms).toBeUndefined();\\n    expect(unwrap(await turns.listTurns({ filePath })).map((turn) => turn.turnId)).toEqual([\\n      \\\"t3\\\",\\n    ]);\\n    const report = await drain(sdk, filePath);\\n    expect(report.ran).toEqual([]);\\n  });\\n});\\n\\ndescribe(\\\"TC-6.7 / AC-6.7: refusals are stable and change nothing — double delete included\\\", () => {\\n  it(\\\"open-turn target, bogus id, and a second delete of the same id refuse with stable codes; the record is identical after each\\\", async () => {\\n    const double = createProviderDouble();\\n    const sdk = manualSdk(double);\\n    const filePath = await newThread();\\n    // t1 closed {m1 prompt, m2 answer}; t2 open {m4 prompt}.\\n    await send(sdk, filePath, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"closed prompt\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"closed answer\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"open prompt\\\" } }),\\n    ]);\\n    await drain(sdk, filePath);\\n    const before = await snapshot(filePath);\\n\\n    // Open-turn message: refused under the closed-turn boundary.\\n    const openTurn = await messages.deleteMessage({ filePath }, { messageId: \\\"m4\\\" });\\n    expect(openTurn.ok).toBe(false);\\n    if (openTurn.ok) return;\\n    expect(openTurn.error.errorClass).toBe(\\\"caller_error\\\");\\n    expect(openTurn.error.code).toBe(\\\"turn_open\\\");\\n    expect(await snapshot(filePath)).toEqual(before);\\n\\n    // Unknown id.\\n    const missing = await messages.deleteMessage({ filePath }, { messageId: \\\"m99\\\" });\\n    expect(missing.ok).toBe(false);\\n    if (missing.ok) return;\\n    expect(missing.error.code).toBe(\\\"message_not_found\\\");\\n    expect(await snapshot(filePath)).toEqual(before);\\n\\n    // Double delete: the first succeeds; the second reads the filtered view\\n    // and refuses as message_not_found — a refusal, not a silent success,\\n    // and not a tombstone-aware error branch.\\n    const firstDelete = await messages.deleteMessage({ filePath }, { messageId: \\\"m2\\\" });\\n    expect(firstDelete.ok).toBe(true);\\n    const afterDelete = await snapshot(filePath);\\n    const secondDelete = await messages.deleteMessage({ filePath }, { messageId: \\\"m2\\\" });\\n    expect(secondDelete.ok).toBe(false);\\n    if (secondDelete.ok) return;\\n    expect(secondDelete.error.errorClass).toBe(\\\"caller_error\\\");\\n    expect(secondDelete.error.code).toBe(\\\"message_not_found\\\");\\n    expect(await snapshot(filePath)).toEqual(afterDelete);\\n  });\\n\\n  it(\\\"the turn surface refuses the same way: open turn, bogus id, double delete\\\", async () => {\\n    const double = createProviderDouble();\\n    const sdk = manualSdk(double);\\n    const filePath = await newThread();\\n    await send(sdk, filePath, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"closed prompt\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"open prompt\\\" } }),\\n    ]);\\n    await drain(sdk, filePath);\\n    const before = await snapshot(filePath);\\n\\n    const openTurn = await turns.deleteTurn({ filePath }, { turnId: \\\"t2\\\" });\\n    expect(openTurn.ok).toBe(false);\\n    if (openTurn.ok) return;\\n    expect(openTurn.error.errorClass).toBe(\\\"caller_error\\\");\\n    expect(openTurn.error.code).toBe(\\\"turn_open\\\");\\n    expect(await snapshot(filePath)).toEqual(before);\\n\\n    const missing = await turns.deleteTurn({ filePath }, { turnId: \\\"t99\\\" });\\n    expect(missing.ok).toBe(false);\\n    if (missing.ok) return;\\n    expect(missing.error.code).toBe(\\\"turn_not_found\\\");\\n    expect(await snapshot(filePath)).toEqual(before);\\n\\n    const firstDelete = await turns.deleteTurn({ filePath }, { turnId: \\\"t1\\\" });\\n    expect(firstDelete.ok).toBe(true);\\n    const afterDelete = await snapshot(filePath);\\n    const secondDelete = await turns.deleteTurn({ filePath }, { turnId: \\\"t1\\\" });\\n    expect(secondDelete.ok).toBe(false);\\n    if (secondDelete.ok) return;\\n    expect(secondDelete.error.code).toBe(\\\"turn_not_found\\\");\\n    expect(await snapshot(filePath)).toEqual(afterDelete);\\n  });\\n\\n  it(\\\"deleting a turn whose messages were individually deleted first still works (live-row membership walk)\\\", async () => {\\n    const double = createProviderDouble();\\n    const sdk = manualSdk(double);\\n    const filePath = await newThread();\\n    await send(sdk, filePath, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"the prompt\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"answer one\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"answer two\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    await drain(sdk, filePath);\\n    expect((await messages.deleteMessage({ filePath }, { messageId: \\\"m2\\\" })).ok).toBe(true);\\n\\n    const result = await turns.deleteTurn({ filePath }, { turnId: \\\"t1\\\" });\\n    expect(result.ok).toBe(true);\\n    if (!result.ok) return;\\n    // Only the still-live members are stamped now; the earlier delete\\n    // already removed m2 and dropped its forms.\\n    expect(result.value.changed).toEqual({ messageIds: [\\\"m1\\\", \\\"m3\\\"], turnIds: [\\\"t1\\\"] });\\n    expect(unwrap(await messages.listMessages({ filePath }))).toEqual([]);\\n    expect(unwrap(await turns.listTurns({ filePath }))).toEqual([]);\\n  });\\n});\\n\\ndescribe(\\\"background mode: delete-and-walk-away (production path)\\\", () => {\\n  it(\\\"the cascade's enqueue pokes ride the commit; the minus-one rebuild runs with no further call\\\", async () => {\\n    const double = createProviderDouble();\\n    const sdk = manualSdk(double, { mode: \\\"background\\\" });\\n    const filePath = await newThread();\\n    await send(sdk, filePath, [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"the prompt\\\" } }),\\n      validEvent(\\\"tool_call\\\"),\\n      validEvent(\\\"tool_result\\\"),\\n      validEvent(\\\"turn_end\\\"),\\n    ]);\\n    await sdk.drainSettled({ filePath });\\n    expect(readDerivedForms(filePath).every((form) => form.state === \\\"ready\\\")).toBe(true);\\n\\n    const result = await messages.deleteMessage({ filePath }, { messageId: \\\"m3\\\" });\\n    expect(result.ok).toBe(true);\\n    await sdk.drainSettled({ filePath });\\n\\n    const turnForms = readDerivedForms(filePath).filter((form) => form.subjectId === \\\"t1\\\");\\n    expect(turnForms).toHaveLength(2);\\n    expect(turnForms.every((form) => form.state === \\\"ready\\\" && form.sourceVersion === 2)).toBe(\\n      true,\\n    );\\n    expect(rawDetail(filePath)).toEqual([]);\\n  });\\n});\\n\",\"numLines\":604,\"startLine\":1,\"totalLines\":604}}}\npackages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/06-message-turn-delete/streams/005-implementor.stdout.log:648:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01LHW5egoqWXbsP8yfS4kJMi\",\"type\":\"tool_result\",\"content\":\"1\\t// Story 6 (Epic 02), process-boundary suite: TC-6.8 — `lhc messages delete`\\n2\\t// and `lhc turns delete` through the spawned dist/cli.js have full parity\\n3\\t// with messages.deleteMessage / turns.deleteTurn on twin fixtures: identical\\n4\\t// result JSON, identical cascade (queue rows), identical read-back —\\n5\\t// including the unfiltered event read-back, the audit surface every delete\\n6\\t// variant must leave byte-stable. Mutations need no provider (DD-11) — only\\n7\\t// the twin-building drains resolve one, in-process through the same registry\\n8\\t// the CLI uses. Runs under verify-all only (LHC_PROCESS_SUITE=1). New file\\n9\\t// by the red-manifest rule: cli-process-mutations.test.ts is hash-locked by\\n10\\t// Story 5 (the Story 4 precedent — green may add files, not edit).\\n11\\timport { spawnSync } from \\\"node:child_process\\\";\\n12\\timport { mkdtempSync, rmSync } from \\\"node:fs\\\";\\n13\\timport { tmpdir } from \\\"node:os\\\";\\n14\\timport path from \\\"node:path\\\";\\n15\\timport { fileURLToPath } from \\\"node:url\\\";\\n16\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n17\\timport {\\n18\\t  createSdk,\\n19\\t  intakeStream,\\n20\\t  messages,\\n21\\t  queueDetail,\\n22\\t  resolveNamedProvider,\\n23\\t  threads,\\n24\\t  turns,\\n25\\t  type MutationResult,\\n26\\t  type OpResult,\\n27\\t} from \\\"../src/index.js\\\";\\n28\\timport { openRaw, readDerivedForms, validEvent } from \\\"./fixtures/index.js\\\";\\n29\\t\\n30\\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \\\"..\\\");\\n31\\tconst cliPath = path.join(pkgRoot, \\\"dist\\\", \\\"cli.js\\\");\\n32\\t\\n33\\tfunction runBinary(args: string[]): { status: number | null; stdout: string; stderr: string } {\\n34\\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\\n35\\t    encoding: \\\"utf8\\\",\\n36\\t    env: { ...process.env, LHC_PROVIDER: undefined },\\n37\\t  });\\n38\\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\\n39\\t}\\n40\\t\\n41\\tlet dir: string;\\n42\\tbeforeEach(() => {\\n43\\t  dir = mkdtempSync(path.join(tmpdir(), \\\"lhc-proc-delete-\\\"));\\n44\\t});\\n45\\tafterEach(() => {\\n46\\t  rmSync(dir, { recursive: true, force: true });\\n47\\t});\\n48\\t\\n49\\tasync function newThreadFile(name: string): Promise<string> {\\n50\\t  const filePath = path.join(dir, `${name}.sqlite`);\\n51\\t  const created = await threads.newThread({\\n52\\t    filePath,\\n53\\t    registryPath: path.join(dir, \\\"registry.sqlite\\\"),\\n54\\t  });\\n55\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n56\\t  return filePath;\\n57\\t}\\n58\\t\\n59\\t// One closed turn with a tool run, identical on both twins: fixed\\n60\\t// idempotency keys make the records comparable; the drains run in-process\\n61\\t// under one injected clock so derived timestamps match byte-for-byte.\\n62\\tasync function seedTwin(filePath: string): Promise<void> {\\n63\\t  const batch = [\\n64\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"twin delete prompt\\\" } }),\\n65\\t    validEvent(\\\"tool_call\\\"),\\n66\\t    validEvent(\\\"tool_result\\\"),\\n67\\t    validEvent(\\\"assistant_text\\\", { payload: { text: \\\"twin delete answer\\\" } }),\\n68\\t    validEvent(\\\"turn_end\\\"),\\n69\\t  ].map((event, index) => ({ ...event, idempotencyKey: `twin-delete-${index}` }));\\n70\\t  const seeded = await intakeStream.messageEvents({ filePath }, batch);\\n71\\t  if (!seeded.ok) throw new Error(`fixture batch failed: ${seeded.error.reason}`);\\n72\\t}\\n73\\t\\n74\\tasync function drainTwins(paths: string[]): Promise<void> {\\n75\\t  const provider = resolveNamedProvider(\\\"deterministic\\\");\\n76\\t  if (provider === undefined) throw new Error(\\\"deterministic provider not registered\\\");\\n77\\t  const sdk = createSdk({\\n78\\t    provider,\\n79\\t    mode: \\\"manual\\\",\\n80\\t    clock: () => new Date(\\\"2026-06-11T00:00:00.000Z\\\"),\\n81\\t  });\\n82\\t  for (const filePath of paths) {\\n83\\t    const drained = await sdk.work.drain({ filePath });\\n84\\t    if (!drained.ok) throw new Error(`twin drain failed: ${drained.error.reason}`);\\n85\\t  }\\n86\\t}\\n87\\t\\n88\\tfunction rawDetailStripped(\\n89\\t  filePath: string,\\n90\\t): Array<Omit<ReturnType<typeof queueDetail>[number], \\\"queuedAt\\\">> {\\n91\\t  const db = openRaw(filePath);\\n92\\t  try {\\n93\\t    return queueDetail(db).map(({ queuedAt: _queuedAt, ...rest }) => rest);\\n94\\t  } finally {\\n95\\t    db.close();\\n96\\t  }\\n97\\t}\\n98\\t\\n99\\t// The twin comparison surface: every read path the delete touches plus the\\n100\\t// one it must not — message reads, turn reads with membership, chunk\\n101\\t// membership, derived forms, the live queue, and the unfiltered events.\\n102\\tasync function readBack(filePath: string): Promise<unknown> {\\n103\\t  const messageRecords = await messages.listMessages({ filePath });\\n104\\t  const turnRecords = await turns.listTurns({ filePath });\\n105\\t  const chunkRecords = await turns.listChunks({ filePath });\\n106\\t  const events = await intakeStream.listEvents({ filePath });\\n107\\t  if (!messageRecords.ok || !turnRecords.ok || !chunkRecords.ok || !events.ok) {\\n108\\t    throw new Error(\\\"read-back failed\\\");\\n109\\t  }\\n110\\t  return {\\n111\\t    messages: messageRecords.value,\\n112\\t    turns: turnRecords.value,\\n113\\t    chunks: chunkRecords.value,\\n114\\t    // Events carry recordedAt stamps from the twins' separate intake walls;\\n115\\t    // compare order, kind, and payload — the audit content.\\n116\\t    events: events.value.map((event) => ({\\n117\\t      eventOrder: event.eventOrder,\\n118\\t      eventKind: event.eventKind,\\n119\\t      payload: event.payload,\\n120\\t    })),\\n121\\t    forms: readDerivedForms(filePath),\\n122\\t    queue: rawDetailStripped(filePath),\\n123\\t  };\\n124\\t}\\n125\\t\\n126\\tdescribe(\\\"TC-6.8 / AC-6.8: message delete and turn delete have SDK/CLI parity on twin fixtures\\\", () => {\\n127\\t  it(\\\"the same message delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\\\", async () => {\\n128\\t    const cliThread = await newThreadFile(\\\"cli-msg-delete\\\");\\n129\\t    const sdkThread = await newThreadFile(\\\"sdk-msg-delete\\\");\\n130\\t    await seedTwin(cliThread);\\n131\\t    await seedTwin(sdkThread);\\n132\\t    await drainTwins([cliThread, sdkThread]);\\n133\\t    expect(readDerivedForms(cliThread)).toEqual(readDerivedForms(sdkThread));\\n134\\t\\n135\\t    const viaSdk = await messages.deleteMessage({ filePath: sdkThread }, { messageId: \\\"m3\\\" });\\n136\\t    expect(viaSdk.ok).toBe(true);\\n137\\t\\n138\\t    const viaCli = runBinary([\\\"messages\\\", \\\"delete\\\", \\\"--file-path\\\", cliThread, \\\"--message\\\", \\\"m3\\\"]);\\n139\\t    expect(viaCli.status).toBe(0);\\n140\\t    const parsed = JSON.parse(viaCli.stdout) as OpResult<MutationResult>;\\n141\\t    expect(parsed.ok).toBe(true);\\n142\\t    if (!parsed.ok || !viaSdk.ok) return;\\n143\\t\\n144\\t    expect(parsed.value).toEqual(viaSdk.value);\\n145\\t    expect(await readBack(cliThread)).toEqual(await readBack(sdkThread));\\n146\\t  });\\n147\\t\\n148\\t  it(\\\"the same turn delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\\\", async () => {\\n149\\t    const cliThread = await newThreadFile(\\\"cli-turn-delete\\\");\\n150\\t    const sdkThread = await newThreadFile(\\\"sdk-turn-delete\\\");\\n151\\t    await seedTwin(cliThread);\\n152\\t    await seedTwin(sdkThread);\\n153\\t    await drainTwins([cliThread, sdkThread]);\\n154\\t\\n155\\t    const viaSdk = await turns.deleteTurn({ filePath: sdkThread }, { turnId: \\\"t1\\\" });\\n156\\t    expect(viaSdk.ok).toBe(true);\\n157\\t\\n158\\t    const viaCli = runBinary([\\\"turns\\\", \\\"delete\\\", \\\"--file-path\\\", cliThread, \\\"--turn\\\", \\\"t1\\\"]);\\n159\\t    expect(viaCli.status).toBe(0);\\n160\\t    const parsed = JSON.parse(viaCli.stdout) as OpResult<MutationResult>;\\n161\\t    expect(parsed.ok).toBe(true);\\n162\\t    if (!parsed.ok || !viaSdk.ok) return;\\n163\\t\\n164\\t    expect(parsed.value).toEqual(viaSdk.value);\\n165\\t    expect(await readBack(cliThread)).toEqual(await readBack(sdkThread));\\n166\\t  });\\n167\\t\\n168\\t  it(\\\"refusals carry the same stable codes through the CLI, exit 1, and change nothing\\\", async () => {\\n169\\t    const threadPath = await newThreadFile(\\\"cli-delete-refusal\\\");\\n170\\t    await seedTwin(threadPath);\\n171\\t    await drainTwins([threadPath]);\\n172\\t    const before = await readBack(threadPath);\\n173\\t\\n174\\t    // Prompt protection through the CLI: the refusal names the turn and the\\n175\\t    // turn-delete path, matching the SDK code and class exactly.\\n176\\t    const protectedPrompt = runBinary([\\n177\\t      \\\"messages\\\",\\n178\\t      \\\"delete\\\",\\n179\\t      \\\"--file-path\\\",\\n180\\t      threadPath,\\n181\\t      \\\"--message\\\",\\n182\\t      \\\"m1\\\",\\n183\\t    ]);\\n184\\t    expect(protectedPrompt.status).toBe(1);\\n185\\t    const promptParsed = JSON.parse(protectedPrompt.stdout) as {\\n186\\t      ok: boolean;\\n187\\t      error: { errorClass: string; code: string; reason: string };\\n188\\t    };\\n189\\t    expect(promptParsed.ok).toBe(false);\\n190\\t    expect(promptParsed.error.code).toBe(\\\"message_initiates_turn\\\");\\n191\\t    expect(promptParsed.error.errorClass).toBe(\\\"caller_error\\\");\\n192\\t    expect(promptParsed.error.reason).toContain(\\\"t1\\\");\\n193\\t    expect(promptParsed.error.reason).toContain(\\\"turns delete\\\");\\n194\\t\\n195\\t    const viaSdk = await messages.deleteMessage({ filePath: threadPath }, { messageId: \\\"m1\\\" });\\n196\\t    expect(viaSdk.ok).toBe(false);\\n197\\t    if (viaSdk.ok) return;\\n198\\t    expect(viaSdk.error.code).toBe(\\\"message_initiates_turn\\\");\\n199\\t\\n200\\t    const missingTurn = runBinary([\\\"turns\\\", \\\"delete\\\", \\\"--file-path\\\", threadPath, \\\"--turn\\\", \\\"t9\\\"]);\\n201\\t    expect(missingTurn.status).toBe(1);\\n202\\t    const turnParsed = JSON.parse(missingTurn.stdout) as { ok: boolean; error: { code: string } };\\n203\\t    expect(turnParsed.ok).toBe(false);\\n204\\t    expect(turnParsed.error.code).toBe(\\\"turn_not_found\\\");\\n205\\t\\n206\\t    expect(await readBack(threadPath)).toEqual(before);\\n207\\t  });\\n208\\t});\\n209\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0b78a89b-de9b-459e-9df3-9832eb021204\",\"uuid\":\"42de82f4-0356-4f25-9a57-1d48b5356b94\",\"timestamp\":\"2026-06-11T07:50:51.470Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/cli-process-mutations-delete.test.ts\",\"content\":\"// Story 6 (Epic 02), process-boundary suite: TC-6.8 — `lhc messages delete`\\n// and `lhc turns delete` through the spawned dist/cli.js have full parity\\n// with messages.deleteMessage / turns.deleteTurn on twin fixtures: identical\\n// result JSON, identical cascade (queue rows), identical read-back —\\n// including the unfiltered event read-back, the audit surface every delete\\n// variant must leave byte-stable. Mutations need no provider (DD-11) — only\\n// the twin-building drains resolve one, in-process through the same registry\\n// the CLI uses. Runs under verify-all only (LHC_PROCESS_SUITE=1). New file\\n// by the red-manifest rule: cli-process-mutations.test.ts is hash-locked by\\n// Story 5 (the Story 4 precedent — green may add files, not edit).\\nimport { spawnSync } from \\\"node:child_process\\\";\\nimport { mkdtempSync, rmSync } from \\\"node:fs\\\";\\nimport { tmpdir } from \\\"node:os\\\";\\nimport path from \\\"node:path\\\";\\nimport { fileURLToPath } from \\\"node:url\\\";\\nimport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  createSdk,\\n  intakeStream,\\n  messages,\\n  queueDetail,\\n  resolveNamedProvider,\\n  threads,\\n  turns,\\n  type MutationResult,\\n  type OpResult,\\n} from \\\"../src/index.js\\\";\\nimport { openRaw, readDerivedForms, validEvent } from \\\"./fixtures/index.js\\\";\\n\\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \\\"..\\\");\\nconst cliPath = path.join(pkgRoot, \\\"dist\\\", \\\"cli.js\\\");\\n\\nfunction runBinary(args: string[]): { status: number | null; stdout: string; stderr: string } {\\n  const result = spawnSync(process.execPath, [cliPath, ...args], {\\n    encoding: \\\"utf8\\\",\\n    env: { ...process.env, LHC_PROVIDER: undefined },\\n  });\\n  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\\n}\\n\\nlet dir: string;\\nbeforeEach(() => {\\n  dir = mkdtempSync(path.join(tmpdir(), \\\"lhc-proc-delete-\\\"));\\n});\\nafterEach(() => {\\n  rmSync(dir, { recursive: true, force: true });\\n});\\n\\nasync function newThreadFile(name: string): Promise<string> {\\n  const filePath = path.join(dir, `${name}.sqlite`);\\n  const created = await threads.newThread({\\n    filePath,\\n    registryPath: path.join(dir, \\\"registry.sqlite\\\"),\\n  });\\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n  return filePath;\\n}\\n\\n// One closed turn with a tool run, identical on both twins: fixed\\n// idempotency keys make the records comparable; the drains run in-process\\n// under one injected clock so derived timestamps match byte-for-byte.\\nasync function seedTwin(filePath: string): Promise<void> {\\n  const batch = [\\n    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"twin delete prompt\\\" } }),\\n    validEvent(\\\"tool_call\\\"),\\n    validEvent(\\\"tool_result\\\"),\\n    validEvent(\\\"assistant_text\\\", { payload: { text: \\\"twin delete answer\\\" } }),\\n    validEvent(\\\"turn_end\\\"),\\n  ].map((event, index) => ({ ...event, idempotencyKey: `twin-delete-${index}` }));\\n  const seeded = await intakeStream.messageEvents({ filePath }, batch);\\n  if (!seeded.ok) throw new Error(`fixture batch failed: ${seeded.error.reason}`);\\n}\\n\\nasync function drainTwins(paths: string[]): Promise<void> {\\n  const provider = resolveNamedProvider(\\\"deterministic\\\");\\n  if (provider === undefined) throw new Error(\\\"deterministic provider not registered\\\");\\n  const sdk = createSdk({\\n    provider,\\n    mode: \\\"manual\\\",\\n    clock: () => new Date(\\\"2026-06-11T00:00:00.000Z\\\"),\\n  });\\n  for (const filePath of paths) {\\n    const drained = await sdk.work.drain({ filePath });\\n    if (!drained.ok) throw new Error(`twin drain failed: ${drained.error.reason}`);\\n  }\\n}\\n\\nfunction rawDetailStripped(\\n  filePath: string,\\n): Array<Omit<ReturnType<typeof queueDetail>[number], \\\"queuedAt\\\">> {\\n  const db = openRaw(filePath);\\n  try {\\n    return queueDetail(db).map(({ queuedAt: _queuedAt, ...rest }) => rest);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\n// The twin comparison surface: every read path the delete touches plus the\\n// one it must not — message reads, turn reads with membership, chunk\\n// membership, derived forms, the live queue, and the unfiltered events.\\nasync function readBack(filePath: string): Promise<unknown> {\\n  const messageRecords = await messages.listMessages({ filePath });\\n  const turnRecords = await turns.listTurns({ filePath });\\n  const chunkRecords = await turns.listChunks({ filePath });\\n  const events = await intakeStream.listEvents({ filePath });\\n  if (!messageRecords.ok || !turnRecords.ok || !chunkRecords.ok || !events.ok) {\\n    throw new Error(\\\"read-back failed\\\");\\n  }\\n  return {\\n    messages: messageRecords.value,\\n    turns: turnRecords.value,\\n    chunks: chunkRecords.value,\\n    // Events carry recordedAt stamps from the twins' separate intake walls;\\n    // compare order, kind, and payload — the audit content.\\n    events: events.value.map((event) => ({\\n      eventOrder: event.eventOrder,\\n      eventKind: event.eventKind,\\n      payload: event.payload,\\n    })),\\n    forms: readDerivedForms(filePath),\\n    queue: rawDetailStripped(filePath),\\n  };\\n}\\n\\ndescribe(\\\"TC-6.8 / AC-6.8: message delete and turn delete have SDK/CLI parity on twin fixtures\\\", () => {\\n  it(\\\"the same message delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\\\", async () => {\\n    const cliThread = await newThreadFile(\\\"cli-msg-delete\\\");\\n    const sdkThread = await newThreadFile(\\\"sdk-msg-delete\\\");\\n    await seedTwin(cliThread);\\n    await seedTwin(sdkThread);\\n    await drainTwins([cliThread, sdkThread]);\\n    expect(readDerivedForms(cliThread)).toEqual(readDerivedForms(sdkThread));\\n\\n    const viaSdk = await messages.deleteMessage({ filePath: sdkThread }, { messageId: \\\"m3\\\" });\\n    expect(viaSdk.ok).toBe(true);\\n\\n    const viaCli = runBinary([\\\"messages\\\", \\\"delete\\\", \\\"--file-path\\\", cliThread, \\\"--message\\\", \\\"m3\\\"]);\\n    expect(viaCli.status).toBe(0);\\n    const parsed = JSON.parse(viaCli.stdout) as OpResult<MutationResult>;\\n    expect(parsed.ok).toBe(true);\\n    if (!parsed.ok || !viaSdk.ok) return;\\n\\n    expect(parsed.value).toEqual(viaSdk.value);\\n    expect(await readBack(cliThread)).toEqual(await readBack(sdkThread));\\n  });\\n\\n  it(\\\"the same turn delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\\\", async () => {\\n    const cliThread = await newThreadFile(\\\"cli-turn-delete\\\");\\n    const sdkThread = await newThreadFile(\\\"sdk-turn-delete\\\");\\n    await seedTwin(cliThread);\\n    await seedTwin(sdkThread);\\n    await drainTwins([cliThread, sdkThread]);\\n\\n    const viaSdk = await turns.deleteTurn({ filePath: sdkThread }, { turnId: \\\"t1\\\" });\\n    expect(viaSdk.ok).toBe(true);\\n\\n    const viaCli = runBinary([\\\"turns\\\", \\\"delete\\\", \\\"--file-path\\\", cliThread, \\\"--turn\\\", \\\"t1\\\"]);\\n    expect(viaCli.status).toBe(0);\\n    const parsed = JSON.parse(viaCli.stdout) as OpResult<MutationResult>;\\n    expect(parsed.ok).toBe(true);\\n    if (!parsed.ok || !viaSdk.ok) return;\\n\\n    expect(parsed.value).toEqual(viaSdk.value);\\n    expect(await readBack(cliThread)).toEqual(await readBack(sdkThread));\\n  });\\n\\n  it(\\\"refusals carry the same stable codes through the CLI, exit 1, and change nothing\\\", async () => {\\n    const threadPath = await newThreadFile(\\\"cli-delete-refusal\\\");\\n    await seedTwin(threadPath);\\n    await drainTwins([threadPath]);\\n    const before = await readBack(threadPath);\\n\\n    // Prompt protection through the CLI: the refusal names the turn and the\\n    // turn-delete path, matching the SDK code and class exactly.\\n    const protectedPrompt = runBinary([\\n      \\\"messages\\\",\\n      \\\"delete\\\",\\n      \\\"--file-path\\\",\\n      threadPath,\\n      \\\"--message\\\",\\n      \\\"m1\\\",\\n    ]);\\n    expect(protectedPrompt.status).toBe(1);\\n    const promptParsed = JSON.parse(protectedPrompt.stdout) as {\\n      ok: boolean;\\n      error: { errorClass: string; code: string; reason: string };\\n    };\\n    expect(promptParsed.ok).toBe(false);\\n    expect(promptParsed.error.code).toBe(\\\"message_initiates_turn\\\");\\n    expect(promptParsed.error.errorClass).toBe(\\\"caller_error\\\");\\n    expect(promptParsed.error.reason).toContain(\\\"t1\\\");\\n    expect(promptParsed.error.reason).toContain(\\\"turns delete\\\");\\n\\n    const viaSdk = await messages.deleteMessage({ filePath: threadPath }, { messageId: \\\"m1\\\" });\\n    expect(viaSdk.ok).toBe(false);\\n    if (viaSdk.ok) return;\\n    expect(viaSdk.error.code).toBe(\\\"message_initiates_turn\\\");\\n\\n    const missingTurn = runBinary([\\\"turns\\\", \\\"delete\\\", \\\"--file-path\\\", threadPath, \\\"--turn\\\", \\\"t9\\\"]);\\n    expect(missingTurn.status).toBe(1);\\n    const turnParsed = JSON.parse(missingTurn.stdout) as { ok: boolean; error: { code: string } };\\n    expect(turnParsed.ok).toBe(false);\\n    expect(turnParsed.error.code).toBe(\\\"turn_not_found\\\");\\n\\n    expect(await readBack(threadPath)).toEqual(before);\\n  });\\n});\\n\",\"numLines\":209,\"startLine\":1,\"totalLines\":209}}}\npackages/lhc/docs/02-specs/02-derivation-pipeline/artifacts/06-message-turn-delete/streams/005-implementor.stdout.log:679:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01BeFWRRqLCd6zbwFgxGJFxF\",\"type\":\"tool_result\",\"content\":\"recorded test/mutations-delete.test.ts\\nrecorded test/cli-process-mutations-delete.test.ts\\n#### RECEIPT — 04-derivation-state-report-repair (ACCEPTED 2026-06-11T05:57Z)\\n- Implementor: 003-implementor.json + story-continue. Verifier: 004 (block) → 008 (pass, openFindings []).\\n- Gates by impl-lead: green-verify PASS (186 tests, immutability OK 23 red files); verify-all PASS (208 tests).\\n- Baseline: 195 → 208 (no regression).\\n- Dispositions: SV-04-001 fixed (after rejected deviation). Deviations: final set approved. Accepted-risk/defer: none. Open risks: none.\\n\\n### 05-message-edit-cascade\\n- run 05:58Z; implementor ~18min; verifier initial F-05-001 (open-turn enforcement) → fixed with regression test; verifier follow-up pass (openFindings []).\\n- 06:37Z needs-ruling (spec-deviation). 06:38Z impl-lead APPROVED 4 deviations: CLI parity in new cli-process-mutations.test.ts (Story 1 file hash-locked, Story 4 precedent); TC-5.4 via held manual-drain promise — real claimed pre-edit item across the edit, stale_discarded directly asserted (anti-shim satisfied); --message/--message-id aliases; tool_call edit content-verbatim noted for Story 6.\\n- Two planner payload glitches (Codex schema drift) required plain resumes; final terminal accept-story, all acceptance checks pass.\\n\\n#### RECEIPT — 05-message-edit-cascade (ACCEPTED 2026-06-11T06:40Z)\\n- Implementor: 003-implementor.json. Verifier: initial + follow-up pass.\\n- Gates by impl-lead: green-verify PASS (194 tests, immutability OK 25 red files); verify-all PASS (218 tests).\\n- Baseline: 208 → 218 (no regression). 
{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/zsh -lc \"pnpm --filter lhc exec tsx -e '\nimport { mkdtempSync, rmSync } from \\\"node:fs\\\";\nimport { tmpdir } from \\\"node:os\\\";\nimport { join } from \\\"node:path\\\";\nimport { createSdk, threads, messages, createDeterministicProvider, setSchedulerPoke, setThreadTouch } from \\\"./src/index.ts\\\";\nasync function main(){\n const dir = mkdtempSync(join(tmpdir(), \\\"lhc-review-\\\"));\n try {\n  const filePath = join(dir, \\\"thread.db\\\");\n  createSdk({ provider: createDeterministicProvider(), mode: \\\"background\\\", retry:{budget:3, backoffBaseMs:0, backoffCapMs:0}, lease:{durationMs:5000} });\n  const manual = createSdk({ provider: createDeterministicProvider(), mode: \\\"manual\\\", retry:{budget:3, backoffBaseMs:0, backoffCapMs:0}, lease:{durationMs:5000} });\n  const created = await threads.newThread({ filePath });\n  if (\"'!created.ok) throw new Error(created.error.reason);\n  const batch = await manual.intakeStream.messageEvents({filePath}, [{eventKind:\"user_prompt\", idempotencyKey:\"k1\", actor:\"u\", harness:\"h\", payload:{text:\"hello\"}}]);\n  if (!batch.ok) throw new Error(batch.error.reason);\n  console.log(\"queuedAtReturn\", batch.value.queuedWork.map(w=>w.workItemId));\n  console.log(\"queuedImmediately\", (await messages.listQueuedWork({filePath})).ok && (await messages.listQueuedWork({filePath})).value?.map(w=>w.workItemId));\n  await new Promise(r => setTimeout(r, 200));\n  const queued = await messages.listQueuedWork({filePath});\n  const records = await messages.listMessages({filePath});\n  console.log(\"queuedAfterWait\", queued.ok ? queued.value.map(w=>w.workItemId) : queued.error);\n  console.log(\"formsAfterWait\", records.ok ? records.value.flatMap(m=>m.forms ?? []).map(f=>({form:f.form,state:f.state,content:f.content})) : records.error);\n } finally { setSchedulerPoke(null); setThreadTouch(null); rmSync(dir,{recursive:true,force:true}); }\n}\nmain().catch(e=>{ console.error(e); process.exit(1); });\n'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

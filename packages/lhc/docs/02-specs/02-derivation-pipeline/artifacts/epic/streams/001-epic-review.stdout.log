{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/handlers.ts | sed -n '1,280p'\"","aggregated_output":"     1\t// The three message-level derivation handlers (Flow 2): prompt smoothing,\n     2\t// tool-call summary, tool-result summary. One shape throughout — read the\n     3\t// source message (a tool-activity handler additionally joins its call-id\n     4\t// pair, nothing more: AC-2.5), call exactly one provider operation, hand the\n     5\t// form content back through HandlerOutcome. The drain's completion\n     6\t// transaction performs the version-checked UPDATE-only write (Story 1), so a\n     7\t// stale or deleted source discards here exactly as everywhere else. Outcomes\n     8\t// on tool-activity summaries come from outcome.ts — the record, never the\n     9\t// provider's text (AC-2.4) — and land in form metadata apart from content.\n    10\timport type {\n    11\t  HandlerFormWrite,\n    12\t  HandlerOutcome,\n    13\t  HandlerRunContext,\n    14\t  WorkHandler,\n    15\t} from \"../../../shared/derivation.js\";\n    16\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n    17\timport { deriveToolOutcome } from \"./outcome.js\";\n    18\timport {\n    19\t  findPairedToolCall,\n    20\t  findPairedToolResult,\n    21\t  readMessageSource,\n    22\t  type MessageSource,\n    23\t} from \"./forms.js\";\n    24\t\n    25\t// A handler that cannot read its source coherently has found source damage:\n    26\t// terminal, form blocked with the reason (never a retry loop against a\n    27\t// record that cannot improve). A *deleted* source never reaches this — its\n    28\t// form row is gone and the completion write would discard — so a miss here\n    29\t// is genuine corruption.\n    30\tfunction sourceDamaged(reason: string): HandlerOutcome {\n    31\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n    32\t}\n    33\t\n    34\tfunction loadSource(\n    35\t  run: HandlerRunContext,\n    36\t  item: { sourceRef: Record<string, string> },\n    37\t  expectedKind: string,\n    38\t):\n    39\t  | { ok: true; messageId: string; source: MessageSource }\n    40\t  | { ok: false; outcome: HandlerOutcome } {\n    41\t  const messageId = item.sourceRef[\"messageId\"];\n    42\t  if (messageId === undefined) {\n    43\t    return { ok: false, outcome: sourceDamaged(\"work item carries no messageId\") };\n    44\t  }\n    45\t  const source = readMessageSource(run.openDb(), messageId);\n    46\t  if (source === undefined) {\n    47\t    return { ok: false, outcome: sourceDamaged(`message ${messageId} not found`) };\n    48\t  }\n    49\t  if (source.kind !== expectedKind) {\n    50\t    return {\n    51\t      ok: false,\n    52\t      outcome: sourceDamaged(\n    53\t        `message ${messageId} is kind ${source.kind}, expected ${expectedKind}`,\n    54\t      ),\n    55\t    };\n    56\t  }\n    57\t  return { ok: true, messageId, source };\n    58\t}\n    59\t\n    60\tfunction landForm(\n    61\t  write: HandlerFormWrite,\n    62\t  result: { ok: true; text: string } | { ok: false; retryable: boolean; reason: string },\n    63\t): HandlerOutcome {\n    64\t  if (!result.ok) return { ok: false, retryable: result.retryable, reason: result.reason };\n    65\t  return { ok: true, forms: [{ ...write, content: result.text }] };\n    66\t}\n    67\t\n    68\tconst smoothPromptHandler: WorkHandler = async (run, item) => {\n    69\t  const loaded = loadSource(run, item, \"user_prompt\");\n    70\t  if (!loaded.ok) return loaded.outcome;\n    71\t  const text = loaded.source.blocks[0]?.content[\"text\"];\n    72\t  if (typeof text !== \"string\") {\n    73\t    return sourceDamaged(`prompt ${loaded.messageId} has no text block`);\n    74\t  }\n    75\t  return landForm(\n    76\t    {\n    77\t      subjectKind: \"message\",\n    78\t      subjectId: loaded.messageId,\n    79\t      form: \"smoothed_prompt\",\n    80\t      content: \"\",\n    81\t    },\n    82\t    await run.provider.smoothPrompt({ text }),\n    83\t  );\n    84\t};\n    85\t\n    86\tconst toolCallSummaryHandler: WorkHandler = async (run, item) => {\n    87\t  const loaded = loadSource(run, item, \"tool_call\");\n    88\t  if (!loaded.ok) return loaded.outcome;\n    89\t  const block = loaded.source.blocks[0]?.content ?? {};\n    90\t  const toolCallId = block[\"toolCallId\"];\n    91\t  const toolName = block[\"toolName\"];\n    92\t  if (typeof toolCallId !== \"string\" || typeof toolName !== \"string\") {\n    93\t    return sourceDamaged(`tool call ${loaded.messageId} has no tool_call block`);\n    94\t  }\n    95\t  // The handler's one reach beyond its message: the paired result by call id\n    96\t  // (AC-2.5). Outcome is stamped from that pairing mechanically — present and\n    97\t  // clean, present and isError, or absent — before the provider ever runs.\n    98\t  const paired = findPairedToolResult(run.openDb(), toolCallId);\n    99\t  const outcome = deriveToolOutcome(paired);\n   100\t  const input: Parameters<typeof run.provider.summarizeToolCall>[0] = {\n   101\t    toolName,\n   102\t    argsJson: JSON.stringify(block[\"arguments\"] ?? {}),\n   103\t  };\n   104\t  if (paired !== undefined) {\n   105\t    input.pairedResult = { content: paired.content, isError: paired.isError };\n   106\t  }\n   107\t  return landForm(\n   108\t    {\n   109\t      subjectKind: \"message\",\n   110\t      subjectId: loaded.messageId,\n   111\t      form: \"tool_call_summary\",\n   112\t      content: \"\",\n   113\t      metadata: { outcome },\n   114\t    },\n   115\t    await run.provider.summarizeToolCall(input),\n   116\t  );\n   117\t};\n   118\t\n   119\tconst toolResultSummaryHandler: WorkHandler = async (run, item) => {\n   120\t  const loaded = loadSource(run, item, \"tool_result\");\n   121\t  if (!loaded.ok) return loaded.outcome;\n   122\t  const block = loaded.source.blocks[0]?.content ?? {};\n   123\t  const content = block[\"content\"];\n   124\t  if (typeof content !== \"string\") {\n   125\t    return sourceDamaged(`tool result ${loaded.messageId} has no tool_result block`);\n   126\t  }\n   127\t  const toolCallId = block[\"toolCallId\"];\n   128\t  const pairedCall =\n   129\t    typeof toolCallId === \"string\"\n   130\t      ? findPairedToolCall(run.openDb(), toolCallId)\n   131\t      : undefined;\n   132\t  // The summary abbreviates; the full result content stays untouched in the\n   133\t  // record (AC-2.3) — nothing here writes back to message_block. The result\n   134\t  // is tool activity, so its outcome is stamped from its own isError flag.\n   135\t  return landForm(\n   136\t    {\n   137\t      subjectKind: \"message\",\n   138\t      subjectId: loaded.messageId,\n   139\t      form: \"tool_result_summary\",\n   140\t      content: \"\",\n   141\t      metadata: { outcome: deriveToolOutcome({ isError: block[\"isError\"] === true }) },\n   142\t    },\n   143\t    await run.provider.summarizeToolResult({\n   144\t      toolName: pairedCall?.toolName ?? \"unknown_tool\",\n   145\t      content,\n   146\t    }),\n   147\t  );\n   148\t};\n   149\t\n   150\t// The domain's handler table, merged into the SDK dispatch map at\n   151\t// construction (DD-6). Turn-owned kinds stay with the turns domain.\n   152\texport const messageWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n   153\t  prompt_smoothing: smoothPromptHandler,\n   154\t  tool_call_summary: toolCallSummaryHandler,\n   155\t  tool_result_summary: toolResultSummaryHandler,\n   156\t};\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/forms.ts | sed -n '1,280p'\"","aggregated_output":"     1\t// Message-domain reads for derivation (Flow 2): the handler's view of its\n     2\t// source message and the call-id pairing reads — the only reach a\n     3\t// message-level handler has beyond its own message (AC-2.5). Also the\n     4\t// late-result repair lookup intake's projection step runs (AC-2.8): one\n     5\t// indexed query by call id, never a scan (the v5 expression index on\n     6\t// message_block covers it) and never a drain-time sweep or read-time join.\n     7\t// Completion writes for message forms ride the work-queue util's `complete`\n     8\t// (Story 1): UPDATE-only with the source-version check — no write path here.\n     9\t// Read-back of message-owned form rows (the listMessages join) also lives\n    10\t// here: stored state returned as stored — never re-derived on read.\n    11\timport type { DatabaseSync } from \"node:sqlite\";\n    12\timport type {\n    13\t  DependencyGap,\n    14\t  DerivedForm,\n    15\t  DerivedFormMetadata,\n    16\t  DerivedFormState,\n    17\t  FormKind,\n    18\t  FormReportEntry,\n    19\t} from \"../../../shared/derivation.js\";\n    20\timport { reportEntryFromRow, type RawReportRow } from \"../../../shared/report.js\";\n    21\t\n    22\texport interface MessageSource {\n    23\t  messageId: string;\n    24\t  kind: string;\n    25\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n    26\t}\n    27\t\n    28\texport function readMessageSource(\n    29\t  db: DatabaseSync,\n    30\t  messageId: string,\n    31\t): MessageSource | undefined {\n    32\t  const row = db\n    33\t    .prepare(`SELECT kind FROM message WHERE message_id = ?`)\n    34\t    .get(messageId) as unknown as { kind: string } | undefined;\n    35\t  if (row === undefined) return undefined;\n    36\t  const blocks = db\n    37\t    .prepare(\n    38\t      `SELECT block_type, content FROM message_block\n    39\t       WHERE message_id = ? ORDER BY block_index`,\n    40\t    )\n    41\t    .all(messageId) as unknown as Array<{ block_type: string; content: string }>;\n    42\t  return {\n    43\t    messageId,\n    44\t    kind: row.kind,\n    45\t    blocks: blocks.map((block) => ({\n    46\t      blockType: block.block_type,\n    47\t      content: JSON.parse(block.content) as Record<string, unknown>,\n    48\t    })),\n    49\t  };\n    50\t}\n    51\t\n    52\tinterface RawFormRow {\n    53\t  subject_id: string;\n    54\t  form: string;\n    55\t  state: string;\n    56\t  content: string | null;\n    57\t  reason: string | null;\n    58\t  metadata: string | null;\n    59\t  source_version: number | bigint;\n    60\t  gaps: string | null;\n    61\t  derived_at: string | null;\n    62\t}\n    63\t\n    64\t// Every message-owned derived-form row, grouped by message id — the form\n    65\t// read-back joined onto message reads (AC-2.1's \"readable alongside the\n    66\t// message\"). Rows come back exactly as the queue landed them: state, content,\n    67\t// reason, mechanically stamped metadata; nothing is derived at read time.\n    68\texport function readMessageForms(db: DatabaseSync): Map<string, DerivedForm[]> {\n    69\t  const rows = db\n    70\t    .prepare(\n    71\t      `SELECT subject_id, form, state, content, reason, metadata,\n    72\t              source_version, gaps, derived_at\n    73\t       FROM derived_form WHERE subject_kind = 'message'\n    74\t       ORDER BY subject_id, form`,\n    75\t    )\n    76\t    .all() as unknown as RawFormRow[];\n    77\t  const byMessage = new Map<string, DerivedForm[]>();\n    78\t  for (const row of rows) {\n    79\t    const record: DerivedForm = {\n    80\t      subjectKind: \"message\",\n    81\t      subjectId: row.subject_id,\n    82\t      form: row.form as FormKind,\n    83\t      state: row.state as DerivedFormState,\n    84\t      sourceVersion: Number(row.source_version),\n    85\t    };\n    86\t    if (row.content !== null) record.content = row.content;\n    87\t    if (row.reason !== null) record.reason = row.reason;\n    88\t    if (row.metadata !== null) {\n    89\t      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\n    90\t    }\n    91\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n    92\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n    93\t    const forms = byMessage.get(row.subject_id) ?? [];\n    94\t    forms.push(record);\n    95\t    byMessage.set(row.subject_id, forms);\n    96\t  }\n    97\t  return byMessage;\n    98\t}\n    99\t\n   100\t// One form row by exact key — the requeue operation's refusal read (missing\n   101\t// row, blocked state, current source version). State returned as stored.\n   102\texport function readMessageFormRow(\n   103\t  db: DatabaseSync,\n   104\t  messageId: string,\n   105\t  form: FormKind,\n   106\t): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\n   107\t  const row = db\n   108\t    .prepare(\n   109\t      `SELECT state, reason, source_version FROM derived_form\n   110\t       WHERE subject_kind = 'message' AND subject_id = ? AND form = ?`,\n   111\t    )\n   112\t    .get(messageId, form) as unknown as\n   113\t    | { state: string; reason: string | null; source_version: number | bigint }\n   114\t    | undefined;\n   115\t  if (row === undefined) return undefined;\n   116\t  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\n   117\t    state: row.state as DerivedFormState,\n   118\t    sourceVersion: Number(row.source_version),\n   119\t  };\n   120\t  if (row.reason !== null) view.reason = row.reason;\n   121\t  return view;\n   122\t}\n   123\t\n   124\t// The message owner's report (Flow 4): one query — message-owned form rows\n   125\t// LEFT JOINed with the live work_item still targeting each form at its\n   126\t// current source version, if any (DD-1: only live rows exist; terminal\n   127\t// outcomes already live on the form). No N+1, no in-memory assembly beyond\n   128\t// row mapping. The form→kind CASE is the owner's own queue-site mapping\n   129\t// (MESSAGE_WORK_FORMS) inverted.\n   130\texport function reportMessageForms(\n   131\t  db: DatabaseSync,\n   132\t  opts: { notReady?: boolean; messageId?: string } = {},\n   133\t): FormReportEntry[] {\n   134\t  const conditions = [\"df.subject_kind = 'message'\"];\n   135\t  const params: string[] = [];\n   136\t  if (opts.messageId !== undefined) {\n   137\t    conditions.push(\"df.subject_id = ?\");\n   138\t    params.push(opts.messageId);\n   139\t  }\n   140\t  // notReady is exact set equality by construction: every state but ready.\n   141\t  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n   142\t  const rows = db\n   143\t    .prepare(\n   144\t      `SELECT df.subject_id, df.form, df.state, df.content, df.reason, df.metadata,\n   145\t              df.source_version, df.gaps, df.derived_at,\n   146\t              w.status AS queue_status, w.attempts AS queue_attempts,\n   147\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n   148\t       FROM derived_form df\n   149\t       LEFT JOIN work_item w\n   150\t         ON w.status IN ('queued', 'claimed')\n   151\t        AND w.kind = CASE df.form WHEN 'smoothed_prompt' THEN 'prompt_smoothing' ELSE df.form END\n   152\t        AND json_extract(w.source_ref, '$.messageId') = df.subject_id\n   153\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n   154\t       WHERE ${conditions.join(\" AND \")}\n   155\t       ORDER BY df.subject_id, df.form`,\n   156\t    )\n   157\t    .all(...params) as unknown as RawReportRow[];\n   158\t  return rows.map((row) => reportEntryFromRow(\"message\", row));\n   159\t}\n   160\t\n   161\t// The call-id pairing reads. Earliest-recorded block wins if a call id were\n   162\t// ever repeated; in a well-formed record the pair is unique.\n   163\tfunction findPairedBlock(\n   164\t  db: DatabaseSync,\n   165\t  blockType: \"tool_call\" | \"tool_result\",\n   166\t  toolCallId: string,\n   167\t): Record<string, unknown> | undefined {\n   168\t  const row = db\n   169\t    .prepare(\n   170\t      `SELECT b.content FROM message_block b\n   171\t       JOIN message m ON m.message_id = b.message_id\n   172\t       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n   173\t       ORDER BY m.source_event_order LIMIT 1`,\n   174\t    )\n   175\t    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\n   176\t  if (row === undefined) return undefined;\n   177\t  return JSON.parse(row.content) as Record<string, unknown>;\n   178\t}\n   179\t\n   180\texport function findPairedToolResult(\n   181\t  db: DatabaseSync,\n   182\t  toolCallId: string,\n   183\t): { content: string; isError: boolean } | undefined {\n   184\t  const block = findPairedBlock(db, \"tool_result\", toolCallId);\n   185\t  if (block === undefined) return undefined;\n   186\t  return {\n   187\t    content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n   188\t    isError: block[\"isError\"] === true,\n   189\t  };\n   190\t}\n   191\t\n   192\texport function findPairedToolCall(\n   193\t  db: DatabaseSync,\n   194\t  toolCallId: string,\n   195\t): { toolName: string } | undefined {\n   196\t  const block = findPairedBlock(db, \"tool_call\", toolCallId);\n   197\t  if (block === undefined) return undefined;\n   198\t  return { toolName: typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"\" };\n   199\t}\n   200\t\n   201\t// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\n   202\t// outcome \"unknown\"? Pending rows carry NULL metadata and never match, so the\n   203\t// common case — call and result in one batch, summary not yet run — never\n   204\t// triggers a requeue. Returns the call's message id and the form's current\n   205\t// source version (the requeue enqueues at version + 1: the pair is the\n   206\t// summary's source, and a source completing follows clear-and-regenerate).\n   207\texport function findUnknownOutcomeCallSummary(\n   208\t  db: DatabaseSync,\n   209\t  toolCallId: string,\n   210\t): { messageId: string; sourceVersion: number } | undefined {\n   211\t  const row = db\n   212\t    .prepare(\n   213\t      `SELECT df.subject_id, df.source_version FROM message_block b\n   214\t       JOIN derived_form df ON df.subject_kind = 'message'\n   215\t         AND df.subject_id = b.message_id AND df.form = 'tool_call_summary'\n   216\t       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\n   217\t         AND json_extract(df.metadata, '$.outcome') = 'unknown'\n   218\t       LIMIT 1`,\n   219\t    )\n   220\t    .get(toolCallId) as unknown as\n   221\t    | { subject_id: string; source_version: number | bigint }\n   222\t    | undefined;\n   223\t  if (row === undefined) return undefined;\n   224\t  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\n   225\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/cascade.ts | sed -n '1,320p'\"","aggregated_output":"     1\t// The mutation cascade (DD-8, Flows 5/6): walk the derivation chain upward\n     2\t// from the mutated subject — the message's own forms, its turn's rendering\n     3\t// and projection, the containing chunk's two summaries — clearing each to\n     4\t// `pending` at the next source version and enqueueing replacement work, all\n     5\t// inside the caller's mutation transaction. The clear-set is derived from\n     6\t// the record's structure (the message → turn → chunk walk over the rows that\n     7\t// actually exist), never from a hardcoded form list: a future form on any\n     8\t// subject in the chain cascades without this module changing. Still-queued\n     9\t// old-version items are supersede-deleted (tech design issue 1) and reported\n    10\t// on the MutationResult; claimed items are deliberately left to the\n    11\t// source-version check (DD-3) — their stale completions discard. The two\n    12\t// close paths share one core walk parameterized drop-vs-clear: edit clears\n    13\t// the whole chain, delete *drops* the deleted subject's own forms (state\n    14\t// rows removed — a deleted source has nothing to rebuild) and clears\n    15\t// everything upward for minus-one composition. Turn delete enters at the\n    16\t// turn level, dropping the turn's and all live members' forms; a chunk left\n    17\t// with no live members drops its summary forms too — dropped, never failed,\n    18\t// and no rebuild queued (AC-6.6).\n    19\timport type { DatabaseSync } from \"node:sqlite\";\n    20\timport type { OperationContext } from \"../../../shared/context.js\";\n    21\timport type { FormKind, SubjectKind } from \"../../../shared/derivation.js\";\n    22\timport {\n    23\t  enqueue,\n    24\t  supersedeQueued,\n    25\t  WORK_KIND_REGISTRY,\n    26\t  type EnqueueFormTarget,\n    27\t  type WorkKind,\n    28\t  type WorkSourceRef,\n    29\t} from \"../../../tech-utils/work-queue/index.js\";\n    30\t\n    31\t// Each form's rebuild queue-site — the owning domains' enqueue mappings,\n    32\t// gathered here because the cascade is the one place that re-queues across\n    33\t// the whole chain (module responsibility matrix: replacement enqueues for\n    34\t// all three mutations live with the cascade). Both turn forms ride the one\n    35\t// turn_derivation item; every other form rides its same-named kind.\n    36\tconst FORM_REBUILD_KINDS: Record<FormKind, WorkKind> = {\n    37\t  smoothed_prompt: \"prompt_smoothing\",\n    38\t  tool_call_summary: \"tool_call_summary\",\n    39\t  tool_result_summary: \"tool_result_summary\",\n    40\t  turn_rendering: \"turn_derivation\",\n    41\t  lower_band_projection: \"turn_derivation\",\n    42\t  chunk_summary_detailed: \"chunk_summary_detailed\",\n    43\t  chunk_summary_brief: \"chunk_summary_brief\",\n    44\t};\n    45\t\n    46\texport interface CascadeClear {\n    47\t  subjectKind: SubjectKind;\n    48\t  subjectId: string;\n    49\t  form: FormKind;\n    50\t}\n    51\t\n    52\texport interface CascadeOutcome {\n    53\t  cleared: CascadeClear[];\n    54\t  dropped: CascadeClear[];\n    55\t  queued: Array<{ workItemId: string; kind: WorkKind }>;\n    56\t  superseded: string[];\n    57\t}\n    58\t\n    59\tinterface ChainSubject {\n    60\t  subjectKind: SubjectKind;\n    61\t  subjectId: string;\n    62\t}\n    63\t\n    64\tfunction sourceRefFor(subject: ChainSubject): WorkSourceRef {\n    65\t  switch (subject.subjectKind) {\n    66\t    case \"message\":\n    67\t      return { messageId: subject.subjectId };\n    68\t    case \"turn\":\n    69\t      return { turnId: subject.subjectId };\n    70\t    case \"chunk\":\n    71\t      return { chunkId: subject.subjectId };\n    72\t  }\n    73\t}\n    74\t\n    75\t// The structural walk: the mutated message's turn from its membership stamp,\n    76\t// the turn's chunk from its placement row. Either link may be absent — a gap\n    77\t// message has no turn, an unplaced turn no chunk — and the chain simply\n    78\t// stops there; reach is structural, not configured. Deliberately unfiltered:\n    79\t// the walk runs after a delete stamps its subject, and the chain above a\n    80\t// just-deleted record is exactly what must still cascade.\n    81\tfunction chainSubjects(db: DatabaseSync, messageId: string): ChainSubject[] {\n    82\t  const subjects: ChainSubject[] = [{ subjectKind: \"message\", subjectId: messageId }];\n    83\t  const turnRow = db\n    84\t    .prepare(`SELECT turn_id FROM message WHERE message_id = ?`)\n    85\t    .get(messageId) as unknown as { turn_id: string | null } | undefined;\n    86\t  const turnId = turnRow?.turn_id ?? null;\n    87\t  if (turnId === null) return subjects;\n    88\t  subjects.push({ subjectKind: \"turn\", subjectId: turnId });\n    89\t  const chunkRow = db\n    90\t    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n    91\t    .get(turnId) as unknown as { chunk_id: string } | undefined;\n    92\t  if (chunkRow !== undefined) {\n    93\t    subjects.push({ subjectKind: \"chunk\", subjectId: chunkRow.chunk_id });\n    94\t  }\n    95\t  return subjects;\n    96\t}\n    97\t\n    98\tinterface RebuildGroup {\n    99\t  subject: ChainSubject;\n   100\t  kind: WorkKind;\n   101\t  forms: EnqueueFormTarget[];\n   102\t  maxSourceVersion: number;\n   103\t}\n   104\t\n   105\tfunction rebuildKindFor(form: string): WorkKind {\n   106\t  const kind = FORM_REBUILD_KINDS[form as FormKind];\n   107\t  if (kind === undefined) {\n   108\t    // Every form names its queue site above; a miss is a wiring bug.\n   109\t    throw new Error(`no rebuild work kind mapped for derived form ${form}`);\n   110\t  }\n   111\t  return kind;\n   112\t}\n   113\t\n   114\t// The shared core (DD-8's one cascade, parameterized): drop subjects lose\n   115\t// their form rows outright; clear subjects go pending at the next source\n   116\t// version with replacement work enqueued. Supersede-deletes land before the\n   117\t// replacement enqueues so a tidied id can never collide, and queued items\n   118\t// against dropped subjects are tidied with no replacement — dead work for a\n   119\t// source that no longer reads.\n   120\tfunction runCascade(\n   121\t  ctx: OperationContext,\n   122\t  dropSubjects: readonly ChainSubject[],\n   123\t  clearSubjects: readonly ChainSubject[],\n   124\t): CascadeOutcome {\n   125\t  const readForms = ctx.db.prepare(\n   126\t    `SELECT form, source_version FROM derived_form\n   127\t     WHERE subject_kind = ? AND subject_id = ? ORDER BY form`,\n   128\t  );\n   129\t\n   130\t  const dropped: CascadeClear[] = [];\n   131\t  const supersedeTargets: Array<{ kind: WorkKind; sourceRef: WorkSourceRef }> = [];\n   132\t  const dropRows = ctx.db.prepare(\n   133\t    `DELETE FROM derived_form WHERE subject_kind = ? AND subject_id = ?`,\n   134\t  );\n   135\t  for (const subject of dropSubjects) {\n   136\t    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n   137\t      form: string;\n   138\t    }>;\n   139\t    const kinds = new Set<WorkKind>();\n   140\t    for (const row of rows) {\n   141\t      dropped.push({ ...subject, form: row.form as FormKind });\n   142\t      kinds.add(rebuildKindFor(row.form));\n   143\t    }\n   144\t    for (const kind of kinds) {\n   145\t      supersedeTargets.push({ kind, sourceRef: sourceRefFor(subject) });\n   146\t    }\n   147\t    dropRows.run(subject.subjectKind, subject.subjectId);\n   148\t  }\n   149\t\n   150\t  const cleared: CascadeClear[] = [];\n   151\t  const groups = new Map<string, RebuildGroup>();\n   152\t  for (const subject of clearSubjects) {\n   153\t    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n   154\t      form: string;\n   155\t      source_version: number | bigint;\n   156\t    }>;\n   157\t    for (const row of rows) {\n   158\t      const form = row.form as FormKind;\n   159\t      cleared.push({ ...subject, form });\n   160\t      const kind = rebuildKindFor(row.form);\n   161\t      const key = `${subject.subjectKind}:${subject.subjectId}:${kind}`;\n   162\t      const group = groups.get(key) ?? {\n   163\t        subject,\n   164\t        kind,\n   165\t        forms: [],\n   166\t        maxSourceVersion: 0,\n   167\t      };\n   168\t      group.forms.push({ subjectKind: subject.subjectKind, subjectId: subject.subjectId, form });\n   169\t      group.maxSourceVersion = Math.max(group.maxSourceVersion, Number(row.source_version));\n   170\t      groups.set(key, group);\n   171\t    }\n   172\t  }\n   173\t\n   174\t  const superseded = supersedeQueued(ctx.db, [\n   175\t    ...supersedeTargets,\n   176\t    ...[...groups.values()].map((group) => ({\n   177\t      kind: group.kind,\n   178\t      sourceRef: sourceRefFor(group.subject),\n   179\t    })),\n   180\t  ]);\n   181\t\n   182\t  const queued = [...groups.values()].map((group) => {\n   183\t    const item = enqueue(ctx, {\n   184\t      owner: WORK_KIND_REGISTRY[group.kind].owner,\n   185\t      kind: group.kind,\n   186\t      sourceRef: sourceRefFor(group.subject),\n   187\t      sourceVersion: group.maxSourceVersion + 1,\n   188\t      forms: group.forms,\n   189\t    });\n   190\t    return { workItemId: item.workItemId, kind: group.kind };\n   191\t  });\n   192\t\n   193\t  return { cleared, dropped, queued, superseded };\n   194\t}\n   195\t\n   196\t// Edit's close path: clear-and-requeue for the full chain above (and\n   197\t// including) the edited message, inside the mutation's ambient transaction.\n   198\texport function cascadeFromMessage(\n   199\t  ctx: OperationContext,\n   200\t  messageId: string,\n   201\t): CascadeOutcome {\n   202\t  return runCascade(ctx, [], chainSubjects(ctx.db, messageId));\n   203\t}\n   204\t\n   205\t// Message delete's close path (Flow 6): the deleted message's own forms\n   206\t// drop; its turn and chunk clear and re-queue for minus-one composition.\n   207\t// The message-delete validation refuses turn-initiating prompts, so the turn\n   208\t// always keeps members and never empties through this path.\n   209\texport function cascadeMessageDelete(\n   210\t  ctx: OperationContext,\n   211\t  messageId: string,\n   212\t): CascadeOutcome {\n   213\t  const [own, ...upward] = chainSubjects(ctx.db, messageId);\n   214\t  return runCascade(ctx, own === undefined ? [] : [own], upward);\n   215\t}\n   216\t\n   217\t// Turn delete's close path (Flow 6): the turn's forms and every live\n   218\t// member's forms drop — the drop-set walk goes down as well as up — and the\n   219\t// containing chunk clears and re-queues from its remaining live members.\n   220\t// A chunk left empty drops its summary forms instead: nothing remains to\n   221\t// summarize, so the forms are removed, never failed, and no rebuild queues\n   222\t// (AC-6.6). Runs after the delete stamps land, so the live-member count\n   223\t// already excludes the deleted turn. Membership rows are untouched —\n   224\t// shrink-only: reads filter deleted turns; boundaries never re-cut.\n   225\texport function cascadeTurnDelete(\n   226\t  ctx: OperationContext,\n   227\t  turnId: string,\n   228\t  memberMessageIds: readonly string[],\n   229\t): CascadeOutcome {\n   230\t  const drop: ChainSubject[] = [\n   231\t    ...memberMessageIds.map((messageId): ChainSubject => ({\n   232\t      subjectKind: \"message\",\n   233\t      subjectId: messageId,\n   234\t    })),\n   235\t    { subjectKind: \"turn\", subjectId: turnId },\n   236\t  ];\n   237\t  const chunkRow = ctx.db\n   238\t    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n   239\t    .get(turnId) as unknown as { chunk_id: string } | undefined;\n   240\t  if (chunkRow === undefined) return runCascade(ctx, drop, []);\n   241\t  const chunk: ChainSubject = { subjectKind: \"chunk\", subjectId: chunkRow.chunk_id };\n   242\t  const remaining = ctx.db\n   243\t    .prepare(\n   244\t      `SELECT COUNT(*) AS n FROM chunk_member cm\n   245\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n   246\t       WHERE cm.chunk_id = ?`,\n   247\t    )\n   248\t    .get(chunkRow.chunk_id) as unknown as { n: number | bigint };\n   249\t  return Number(remaining.n) > 0\n   250\t    ? runCascade(ctx, drop, [chunk])\n   251\t    : runCascade(ctx, [...drop, chunk], []);\n   252\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/index.ts | sed -n '1,620p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n     3\timport type { FormKind, FormReportEntry, WorkHandler } from \"../../shared/derivation.js\";\n     4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     5\timport {\n     6\t  enqueue,\n     7\t  hasLiveItem,\n     8\t  listItems,\n     9\t  type WorkItemRecord,\n    10\t  type WorkKind,\n    11\t} from \"../../tech-utils/work-queue/index.js\";\n    12\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n    13\timport {\n    14\t  openThreadDatabase,\n    15\t  resolveThreadRef,\n    16\t  type ThreadRef,\n    17\t} from \"../threads/index.js\";\n    18\timport type { DerivedForm } from \"../../shared/derivation.js\";\n    19\timport {\n    20\t  findUnknownOutcomeCallSummary,\n    21\t  readMessageFormRow,\n    22\t  readMessageForms,\n    23\t  reportMessageForms,\n    24\t} from \"./internal/forms.js\";\n    25\timport { messageWorkHandlers } from \"./internal/handlers.js\";\n    26\timport { projectEvent } from \"./internal/project.js\";\n    27\timport {\n    28\t  cascadeFromMessage,\n    29\t  cascadeMessageDelete,\n    30\t  cascadeTurnDelete,\n    31\t  type CascadeClear,\n    32\t  type CascadeOutcome,\n    33\t} from \"./internal/cascade.js\";\n    34\timport {\n    35\t  applyMessageEdit,\n    36\t  insertMessage,\n    37\t  markMessageDeleted,\n    38\t  markTurnMessagesDeleted,\n    39\t  readMessages,\n    40\t  readMutableMessage,\n    41\t} from \"./internal/store.js\";\n    42\t\n    43\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n    44\t\n    45\texport interface Block {\n    46\t  blockType: BlockType;\n    47\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n    48\t}\n    49\t\n    50\texport interface MessageRecord {\n    51\t  messageId: string;\n    52\t  sourceEventOrder: number;\n    53\t  kind: Exclude<EventKind, \"turn_end\">;\n    54\t  blocks: Block[];\n    55\t  tokenEstimate: number;\n    56\t  actor: string;\n    57\t  harness: string;\n    58\t  turnId?: string;\n    59\t  // The message's derived forms as stored (Epic 02 Story 2): present only\n    60\t  // for messages that are derivation sources — kinds with no derivable form\n    61\t  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n    62\t  // never re-derived on read.\n    63\t  forms?: DerivedForm[];\n    64\t}\n    65\t\n    66\t// The event as the walk holds it after recording: the validated input plus\n    67\t// its server-stamped order and timestamp.\n    68\texport type RecordedEvent = EventRecord;\n    69\t\n    70\texport type MessageCreated = {\n    71\t  messageId: string;\n    72\t  kind: Exclude<EventKind, \"turn_end\">;\n    73\t  // Carried for tool activity only: the pairing key the queue sites need —\n    74\t  // tool_result projection runs the AC-2.8 late-result lookup against it.\n    75\t  toolCallId?: string;\n    76\t} | null;\n    77\t\n    78\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    79\t// (the first such call through the operation context; turns.applyEvent\n    80\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n    81\t// projection failure propagates to the pipeline's catch and rejects the\n    82\t// whole batch — recorded events without messages is the stranded state the\n    83\t// transaction exists to prevent. Returns null for turn_end (no message).\n    84\t// turnId is the membership stamp, settled by the pipeline before this call:\n    85\t// the turn open *after* this event's transition (so a prompt belongs to the\n    86\t// turn it just opened), or null in a gap — written once, never updated.\n    87\texport function createFromEvent(\n    88\t  ctx: OperationContext,\n    89\t  event: RecordedEvent,\n    90\t  turnId: string | null,\n    91\t): MessageCreated {\n    92\t  const projected = projectEvent(event);\n    93\t  if (projected === null) return null;\n    94\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n    95\t  const messageId = `m${event.eventOrder}`;\n    96\t  insertMessage(ctx.db, {\n    97\t    messageId,\n    98\t    sourceEventOrder: event.eventOrder,\n    99\t    kind,\n   100\t    tokenEstimate: projected.tokenEstimate,\n   101\t    actor: event.actor,\n   102\t    harness: event.harness,\n   103\t    turnId,\n   104\t    blocks: projected.blocks,\n   105\t  });\n   106\t  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n   107\t    return { messageId, kind, toolCallId: event.payload.toolCallId };\n   108\t  }\n   109\t  return { messageId, kind };\n   110\t}\n   111\t\n   112\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n   113\t// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n   114\t// tool result queues tool_result_summary, nothing else queues anything —\n   115\t// text, thinking, and note messages are not derivation sources (Epic 01\n   116\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n   117\t// intake-stream inside the batch transaction for every recorded message, so\n   118\t// the item commits (or rolls back) with the batch.\n   119\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n   120\t  user_prompt: \"prompt_smoothing\",\n   121\t  tool_call: \"tool_call_summary\",\n   122\t  tool_result: \"tool_result_summary\",\n   123\t};\n   124\t\n   125\t// Which derived form each message-owned kind produces — the owning domain's\n   126\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n   127\t// rides the same transaction (DD-5).\n   128\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n   129\t  prompt_smoothing: \"smoothed_prompt\",\n   130\t  tool_call_summary: \"tool_call_summary\",\n   131\t  tool_result_summary: \"tool_result_summary\",\n   132\t};\n   133\t\n   134\t// Message-owned work handlers, merged into the SDK's dispatch map at\n   135\t// construction (DD-6): prompt smoothing and the two tool-activity summaries.\n   136\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   137\t  messageWorkHandlers;\n   138\t\n   139\texport function queueMessageWork(\n   140\t  ctx: OperationContext,\n   141\t  message: MessageCreated,\n   142\t): WorkItemRecord[] {\n   143\t  if (message === null) return [];\n   144\t  const items: WorkItemRecord[] = [];\n   145\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n   146\t  if (kind !== undefined) {\n   147\t    const form = MESSAGE_WORK_FORMS[kind];\n   148\t    if (form === undefined) {\n   149\t      // Every queuing kind names its form above; a miss is a wiring bug.\n   150\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n   151\t    }\n   152\t    items.push(\n   153\t      enqueue(ctx, {\n   154\t        owner: \"messages\",\n   155\t        kind,\n   156\t        sourceRef: { messageId: message.messageId },\n   157\t        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n   158\t      }),\n   159\t    );\n   160\t  }\n   161\t  // Late-result repair (AC-2.8): a tool result landing after its call's\n   162\t  // summary already derived with outcome \"unknown\" means the summary's\n   163\t  // source — the call+result pair — completed underneath it; clear and\n   164\t  // regenerate at the next source version, in this same batch transaction.\n   165\t  // One indexed lookup; pending summaries (metadata NULL) never match, so\n   166\t  // the common call-and-result-in-one-batch case never triggers, and the\n   167\t  // version-scoped item id keeps the requeue idempotent.\n   168\t  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n   169\t    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n   170\t    if (stale !== undefined) {\n   171\t      items.push(\n   172\t        enqueue(ctx, {\n   173\t          owner: \"messages\",\n   174\t          kind: \"tool_call_summary\",\n   175\t          sourceRef: { messageId: stale.messageId },\n   176\t          sourceVersion: stale.sourceVersion + 1,\n   177\t          forms: [\n   178\t            {\n   179\t              subjectKind: \"message\",\n   180\t              subjectId: stale.messageId,\n   181\t              form: \"tool_call_summary\",\n   182\t            },\n   183\t          ],\n   184\t        }),\n   185\t      );\n   186\t    }\n   187\t  }\n   188\t  return items;\n   189\t}\n   190\t\n   191\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   192\t  return {\n   193\t    ok: false,\n   194\t    error: {\n   195\t      errorClass: \"caller_error\",\n   196\t      code: \"thread_not_found\",\n   197\t      reason: `no thread file exists at ${filePath}`,\n   198\t    },\n   199\t  };\n   200\t}\n   201\t\n   202\texport async function listMessages(\n   203\t  thread: ThreadRef,\n   204\t): Promise<OpResult<MessageRecord[]>> {\n   205\t  const resolved = await resolveThreadRef(thread);\n   206\t  if (!resolved.ok) return resolved;\n   207\t  const { filePath } = resolved.value;\n   208\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   209\t\n   210\t  // openThreadDatabase verifies the file is a real thread file and migrates\n   211\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n   212\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n   213\t  // unmutated (F-03-002).\n   214\t  const opened = openThreadDatabase(filePath);\n   215\t  if (!opened.ok) return opened;\n   216\t  const db = opened.value;\n   217\t  try {\n   218\t    // Form read-back rides the message read (AC-2.1): each record carries\n   219\t    // its stored derived forms, attached from one grouped query — the\n   220\t    // production path for \"readable alongside the message\".\n   221\t    const formsByMessage = readMessageForms(db);\n   222\t    const records = readMessages(db).map((record) => {\n   223\t      const forms = formsByMessage.get(record.messageId);\n   224\t      return forms === undefined ? record : { ...record, forms };\n   225\t    });\n   226\t    return { ok: true, value: records };\n   227\t  } catch (cause) {\n   228\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   229\t    return storageFailure(`message read-back failed: ${reason}`);\n   230\t  } finally {\n   231\t    db.close();\n   232\t  }\n   233\t}\n   234\t\n   235\texport async function listQueuedWork(\n   236\t  thread: ThreadRef,\n   237\t): Promise<OpResult<WorkItemRecord[]>> {\n   238\t  const resolved = await resolveThreadRef(thread);\n   239\t  if (!resolved.ok) return resolved;\n   240\t  const { filePath } = resolved.value;\n   241\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   242\t\n   243\t  const opened = openThreadDatabase(filePath);\n   244\t  if (!opened.ok) return opened;\n   245\t  const db = opened.value;\n   246\t  try {\n   247\t    return { ok: true, value: listItems(db, \"messages\") };\n   248\t  } catch (cause) {\n   249\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   250\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   251\t  } finally {\n   252\t    db.close();\n   253\t  }\n   254\t}\n   255\t\n   256\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   257\t\n   258\t// This owner's repair report: every message-owned form's durable state\n   259\t// joined with live queue detail in one query — the five operational\n   260\t// situations (waiting, retrying, ready, failed, blocked) read from the rows\n   261\t// without any queue API. Needs no provider; reads degrade, never block.\n   262\texport async function report(\n   263\t  thread: ThreadRef,\n   264\t  opts?: { notReady?: boolean; messageId?: string },\n   265\t): Promise<OpResult<FormReportEntry[]>> {\n   266\t  const resolved = await resolveThreadRef(thread);\n   267\t  if (!resolved.ok) return resolved;\n   268\t  const { filePath } = resolved.value;\n   269\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   270\t\n   271\t  const opened = openThreadDatabase(filePath);\n   272\t  if (!opened.ok) return opened;\n   273\t  const db = opened.value;\n   274\t  try {\n   275\t    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\n   276\t  } catch (cause) {\n   277\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   278\t    return storageFailure(`report read failed: ${reason}`);\n   279\t  } finally {\n   280\t    db.close();\n   281\t  }\n   282\t}\n   283\t\n   284\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n   285\t\n   286\t// Which work kind rebuilds each message-owned form — MESSAGE_WORK_FORMS\n   287\t// inverted; the requeue's join from the named form back to its queue site.\n   288\tconst MESSAGE_FORM_KINDS: Partial<Record<FormKind, WorkKind>> = {\n   289\t  smoothed_prompt: \"prompt_smoothing\",\n   290\t  tool_call_summary: \"tool_call_summary\",\n   291\t  tool_result_summary: \"tool_result_summary\",\n   292\t};\n   293\t\n   294\t// Explicit re-queue through the owning surface (AC-4.4): the public,\n   295\t// supported rebuild act. Refused for blocked forms with the form's stored\n   296\t// damage reason (AC-4.6) and for missing rows; a no-op against work already\n   297\t// queued or in flight at the form's current source version (AC-4.5).\n   298\t// Otherwise the form clears to pending and re-enqueues at the next source\n   299\t// version — the same enqueue path intake uses, poke-on-commit included, so\n   300\t// background mode processes the repair with no further call. The no-op check\n   301\t// and the enqueue commit in one transaction (anti-shim: a split would\n   302\t// reintroduce the duplicate-work race).\n   303\texport async function requeue(\n   304\t  thread: ThreadRef,\n   305\t  target: { messageId: string; form: FormKind },\n   306\t): Promise<OpResult<RequeueOutcome>> {\n   307\t  const kind = MESSAGE_FORM_KINDS[target.form];\n   308\t  if (kind === undefined) {\n   309\t    return {\n   310\t      ok: false,\n   311\t      error: {\n   312\t        errorClass: \"caller_error\",\n   313\t        code: \"message_not_found\",\n   314\t        reason: `form ${target.form} is not message-owned; messages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\n   315\t      },\n   316\t    };\n   317\t  }\n   318\t  const resolved = await resolveThreadRef(thread);\n   319\t  if (!resolved.ok) return resolved;\n   320\t  const { filePath } = resolved.value;\n   321\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   322\t\n   323\t  const opened = openThreadDatabase(filePath);\n   324\t  if (!opened.ok) return opened;\n   325\t  const db = opened.value;\n   326\t  try {\n   327\t    const meta = db\n   328\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   329\t      .get() as { thread_id: string } | undefined;\n   330\t    const threadId = meta?.thread_id ?? \"\";\n   331\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   332\t      const row = readMessageFormRow(ctx.db, target.messageId, target.form);\n   333\t      if (row === undefined) {\n   334\t        return {\n   335\t          ok: false,\n   336\t          error: {\n   337\t            errorClass: \"caller_error\",\n   338\t            code: \"message_not_found\",\n   339\t            reason: `no derived form ${target.form} exists for message ${target.messageId}`,\n   340\t          },\n   341\t        };\n   342\t      }\n   343\t      if (row.state === \"blocked\") {\n   344\t        // The refusal carries the form's stored reason — the damage named at\n   345\t        // blocking time, not a generic string (AC-4.6).\n   346\t        return {\n   347\t          ok: false,\n   348\t          error: {\n   349\t            errorClass: \"state_corruption\",\n   350\t            code: \"source_damaged\",\n   351\t            reason: row.reason ?? `form ${target.form} for message ${target.messageId} is blocked`,\n   352\t          },\n   353\t        };\n   354\t      }\n   355\t      const sourceRef = { messageId: target.messageId };\n   356\t      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\n   357\t        return { ok: true, value: { noop: \"already_queued\" } };\n   358\t      }\n   359\t      const item = enqueue(ctx, {\n   360\t        owner: \"messages\",\n   361\t        kind,\n   362\t        sourceRef,\n   363\t        sourceVersion: row.sourceVersion + 1,\n   364\t        forms: [{ subjectKind: \"message\", subjectId: target.messageId, form: target.form }],\n   365\t      });\n   366\t      return { ok: true, value: { workItemId: item.workItemId } };\n   367\t    });\n   368\t  } catch (cause) {\n   369\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   370\t    return storageFailure(`requeue failed: ${reason}`);\n   371\t  } finally {\n   372\t    db.close();\n   373\t  }\n   374\t}\n   375\t\n   376\t// ── mutations (Epic 02 Story 5, Flow 5) ──────────────────────────\n   377\t\n   378\t// The mutation result contract (tech design §Interfaces): what changed in\n   379\t// the record, which dependent forms cleared, which dropped (delete only),\n   380\t// what replacement work queued, and which still-queued old items the cascade\n   381\t// tidied away (issue 1). Shared by edit and the Story 6 deletes.\n   382\texport interface MutationResult {\n   383\t  changed: { messageIds: string[]; turnIds: string[] };\n   384\t  cleared: CascadeClear[];\n   385\t  dropped: CascadeClear[];\n   386\t  queued: Array<{ workItemId: string; kind: WorkKind }>;\n   387\t  superseded: string[];\n   388\t}\n   389\t\n   390\t// The record's first sanctioned mutation (AC-5.1–5.5): change a closed-turn\n   391\t// message's content and blocks, re-stamp the token estimate, and walk the\n   392\t// full dependent chain — clear to pending, supersede queued old work,\n   393\t// enqueue replacements at the next source version — in one transaction.\n   394\t// Synchronous and local by contract: everything above commits before this\n   395\t// returns; the re-queued rebuilds run through the normal drain (background\n   396\t// mode needs no further call — the enqueue pokes ride the commit). Events\n   397\t// are never touched (projection-level mutation, DD-12), and no generated\n   398\t// thread-view is either — visibility arrives at the next compact/rebuild.\n   399\t// Refusals read through the deleted-filtered view and enforce the closed-turn\n   400\t// target boundary: only a message in a closed turn is editable, so an\n   401\t// open-turn *or* a turnless (no-membership) gap target is refused turn_open —\n   402\t// the boundary's one stable code — a missing or deleted message is\n   403\t// message_not_found, and a refusal changes nothing.\n   404\texport async function edit(\n   405\t  thread: ThreadRef,\n   406\t  input: { messageId: string; content: string },\n   407\t): Promise<OpResult<MutationResult>> {\n   408\t  const resolved = await resolveThreadRef(thread);\n   409\t  if (!resolved.ok) return resolved;\n   410\t  const { filePath } = resolved.value;\n   411\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   412\t\n   413\t  const opened = openThreadDatabase(filePath);\n   414\t  if (!opened.ok) return opened;\n   415\t  const db = opened.value;\n   416\t  try {\n   417\t    const meta = db\n   418\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   419\t      .get() as { thread_id: string } | undefined;\n   420\t    const threadId = meta?.thread_id ?? \"\";\n   421\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n   422\t      const target = readMutableMessage(ctx.db, input.messageId);\n   423\t      if (target === undefined) {\n   424\t        return {\n   425\t          ok: false,\n   426\t          error: {\n   427\t            errorClass: \"caller_error\",\n   428\t            code: \"message_not_found\",\n   429\t            reason: `no message ${input.messageId} exists in this thread`,\n   430\t          },\n   431\t        };\n   432\t      }\n   433\t      // The closed-turn target boundary (story scope; AC-5.1): the edit's\n   434\t      // editable class is a message in a *closed* turn. Both failing cases —\n   435\t      // an open turn and a turnless gap message (no membership) — refuse under\n   436\t      // the one stable code; the reason distinguishes them so the open-turn\n   437\t      // message reads exactly as before. A deleted/missing target never gets\n   438\t      // here (it misses the filtered read above as message_not_found).\n   439\t      if (target.turnStatus !== \"closed\") {\n   440\t        return {\n   441\t          ok: false,\n   442\t          error: {\n   443\t            errorClass: \"caller_error\",\n   444\t            code: \"turn_open\",\n   445\t            reason:\n   446\t              target.turnStatus === \"open\"\n   447\t                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \"\"}; open-turn messages cannot be edited (v1 boundary)`\n   448\t                : `message ${input.messageId} has no turn membership; only closed-turn messages can be edited (v1 boundary)`,\n   449\t          },\n   450\t        };\n   451\t      }\n   452\t      applyMessageEdit(ctx.db, input.messageId, input.content);\n   453\t      const cascade = cascadeFromMessage(ctx, input.messageId);\n   454\t      return {\n   455\t        ok: true,\n   456\t        value: {\n   457\t          changed: { messageIds: [input.messageId], turnIds: [] },\n   458\t          cleared: cascade.cleared,\n   459\t          dropped: cascade.dropped,\n   460\t          queued: cascade.queued,\n   461\t          superseded: cascade.superseded,\n   462\t        },\n   463\t      };\n   464\t    });\n   465\t  } catch (cause) {\n   466\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   467\t    return storageFailure(`edit failed: ${reason}`);\n   468\t  } finally {\n   469\t    db.close();\n   470\t  }\n   471\t}\n   472\t\n   473\t// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\n   474\t\n   475\t// The record's removal mutation for one message (AC-6.1–6.3, 6.7):\n   476\t// projection-level delete — the deleted_at stamp plus the delete cascade\n   477\t// (own forms dropped, turn and chunk cleared and re-queued for minus-one\n   478\t// composition) in one transaction. The source events are never touched;\n   479\t// event read-back keeps returning them (the audit surface). Validation\n   480\t// reads the same filtered view as edit, so a missing, deleted, or\n   481\t// double-deleted target is message_not_found and an open-turn or turnless\n   482\t// gap target is turn_open. The one delete-specific refusal is prompt\n   483\t// protection: a turn is a prompt and what came back for it, so deleting the\n   484\t// turn's initiating prompt is refused toward turns.deleteTurn — the error\n   485\t// names the turn and that path (AC-6.3).\n   486\texport async function deleteMessage(\n   487\t  thread: ThreadRef,\n   488\t  input: { messageId: string },\n   489\t): Promise<OpResult<MutationResult>> {\n   490\t  const resolved = await resolveThreadRef(thread);\n   491\t  if (!resolved.ok) return resolved;\n   492\t  const { filePath } = resolved.value;\n   493\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   494\t\n   495\t  const opened = openThreadDatabase(filePath);\n   496\t  if (!opened.ok) return opened;\n   497\t  const db = opened.value;\n   498\t  try {\n   499\t    const meta = db\n   500\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   501\t      .get() as { thread_id: string } | undefined;\n   502\t    const threadId = meta?.thread_id ?? \"\";\n   503\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n   504\t      const target = readMutableMessage(ctx.db, input.messageId);\n   505\t      if (target === undefined) {\n   506\t        return {\n   507\t          ok: false,\n   508\t          error: {\n   509\t            errorClass: \"caller_error\",\n   510\t            code: \"message_not_found\",\n   511\t            reason: `no message ${input.messageId} exists in this thread`,\n   512\t          },\n   513\t        };\n   514\t      }\n   515\t      if (target.turnStatus !== \"closed\") {\n   516\t        return {\n   517\t          ok: false,\n   518\t          error: {\n   519\t            errorClass: \"caller_error\",\n   520\t            code: \"turn_open\",\n   521\t            reason:\n   522\t              target.turnStatus === \"open\"\n   523\t                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \"\"}; open-turn messages cannot be deleted (v1 boundary)`\n   524\t                : `message ${input.messageId} has no turn membership; only closed-turn messages can be deleted (v1 boundary)`,\n   525\t          },\n   526\t        };\n   527\t      }\n   528\t      if (target.initiatesTurn) {\n   529\t        return {\n   530\t          ok: false,\n   531\t          error: {\n   532\t            errorClass: \"caller_error\",\n   533\t            code: \"message_initiates_turn\",\n   534\t            reason: `message ${input.messageId} is the prompt that initiates turn ${target.turnId ?? \"\"}; a turn is a prompt and what came back for it — delete the whole exchange with turns.deleteTurn (lhc turns delete --turn-id ${target.turnId ?? \"\"})`,\n   535\t          },\n   536\t        };\n   537\t      }\n   538\t      markMessageDeleted(ctx.db, input.messageId, ctx.clock().toISOString());\n   539\t      const cascade = cascadeMessageDelete(ctx, input.messageId);\n   540\t      return {\n   541\t        ok: true,\n   542\t        value: {\n   543\t          changed: { messageIds: [input.messageId], turnIds: [] },\n   544\t          cleared: cascade.cleared,\n   545\t          dropped: cascade.dropped,\n   546\t          queued: cascade.queued,\n   547\t          superseded: cascade.superseded,\n   548\t        },\n   549\t      };\n   550\t    });\n   551\t  } catch (cause) {\n   552\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   553\t    return storageFailure(`delete failed: ${reason}`);\n   554\t  } finally {\n   555\t    db.close();\n   556\t  }\n   557\t}\n   558\t\n   559\t// Cross-domain surface for turns.deleteTurn (DD-8: one cascade module, two\n   560\t// callers), called inside the turn delete's transaction after the turn row\n   561\t// is stamped. The messages domain owns the message-table write — the member\n   562\t// stamp, scoped to live rows — and the shared cascade entry; the turns\n   563\t// operation owns its own validation and turn-row stamp. Returns the cascade\n   564\t// outcome plus the member ids stamped now (record order), which the turn\n   565\t// delete reports as its changed messages.\n   566\texport function applyTurnDeleteCascade(\n   567\t  ctx: OperationContext,\n   568\t  turnId: string,\n   569\t): CascadeOutcome & { memberMessageIds: string[] } {\n   570\t  const memberMessageIds = markTurnMessagesDeleted(\n   571\t    ctx.db,\n   572\t    turnId,\n   573\t    ctx.clock().toISOString(),\n   574\t  );\n   575\t  return { ...cascadeTurnDelete(ctx, turnId, memberMessageIds), memberMessageIds };\n   576\t}\n","exit_code":0,"status":"completed"}}

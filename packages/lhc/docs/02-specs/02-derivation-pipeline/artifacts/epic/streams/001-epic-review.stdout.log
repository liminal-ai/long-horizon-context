{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0189ThAND6ppPFY8KtzDKNv8","type":"tool_result","content":"1\texport * as threads from \"./domains/threads/index.js\";\n2\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n3\texport * as messages from \"./domains/messages/index.js\";\n4\texport * as turns from \"./domains/turns/index.js\";\n5\t\n6\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n7\timport * as messagesDomain from \"./domains/messages/index.js\";\n8\timport * as threadsDomain from \"./domains/threads/index.js\";\n9\timport * as turnsDomain from \"./domains/turns/index.js\";\n10\timport {\n11\t  createScheduler,\n12\t  peekThreadId,\n13\t  runDrain,\n14\t  type DrainDeps,\n15\t  type DrainReport,\n16\t  type Scheduler,\n17\t} from \"./scheduler.js\";\n18\timport { setSchedulerPoke as installSchedulerPoke, setThreadTouch } from \"./shared/context.js\";\n19\timport {\n20\t  PROVIDER_OPERATIONS,\n21\t  type ResolvedSdkConfig,\n22\t  type SdkConfig,\n23\t  type WorkHandler,\n24\t} from \"./shared/derivation.js\";\n25\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n26\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n27\t\n28\texport {\n29\t  estimateTokens,\n30\t  TOKEN_ESTIMATOR_ID,\n31\t} from \"./tech-utils/token-counting/index.js\";\n32\t\n33\texport {\n34\t  WORK_KIND_REGISTRY,\n35\t  type WorkItemRecord,\n36\t  type WorkKind,\n37\t  type WorkOwner,\n38\t  type WorkSourceRef,\n39\t} from \"./tech-utils/work-queue/index.js\";\n40\t\n41\texport type {\n42\t  ErrorClass,\n43\t  ErrorCode,\n44\t  ErrorResult,\n45\t  OpResult,\n46\t} from \"./shared/errors.js\";\n47\texport {\n48\t  runInTransaction,\n49\t  setSchedulerPoke,\n50\t  setThreadTouch,\n51\t  type OperationContext,\n52\t} from \"./shared/context.js\";\n53\t\n54\texport {\n55\t  createDeterministicProvider,\n56\t  deterministicOutcomesSuffix,\n57\t  deterministicReceiptsSuffix,\n58\t  deterministicText,\n59\t  type DeterministicOpName,\n60\t} from \"./providers/deterministic.js\";\n61\texport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n62\t\n63\texport type {\n64\t  CompletionTx,\n65\t  DependencyGap,\n66\t  DerivationProvider,\n67\t  DerivedForm,\n68\t  DerivedFormMetadata,\n69\t  DerivedFormState,\n70\t  FormKind,\n71\t  FormReportEntry,\n72\t  HandlerFormWrite,\n73\t  HandlerOutcome,\n74\t  HandlerRunContext,\n75\t  ProviderResult,\n76\t  RenderingPart,\n77\t  ResolvedSdkConfig,\n78\t  SdkConfig,\n79\t  SubjectKind,\n80\t  ToolOutcome,\n81\t  ToolRunReceipt,\n82\t  WorkHandler,\n83\t} from \"./shared/derivation.js\";\n84\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n85\texport {\n86\t  countLiveItems,\n87\t  enqueue,\n88\t  queueDetail,\n89\t  supersedeQueued,\n90\t  type ClaimedWorkItem,\n91\t  type EnqueueFormTarget,\n92\t  type EnqueueInput,\n93\t  type QueueDetailRow,\n94\t} from \"./tech-utils/work-queue/index.js\";\n95\t\n96\texport type { ThreadRef } from \"./domains/threads/index.js\";\n97\texport type {\n98\t  Block,\n99\t  BlockType,\n100\t  MessageRecord,\n101\t  MutationResult,\n102\t} from \"./domains/messages/index.js\";\n103\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n104\texport type {\n105\t  BatchResult,\n106\t  EventKind,\n107\t  EventRecord,\n108\t  MessageEventInput,\n109\t} from \"./domains/intake-stream/index.js\";\n110\t\n111\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n112\t\n113\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n114\t\n115\t// Merge per-domain handler tables into the one join between the queue's\n116\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n117\t// (each kind has exactly one owner) and throws at construction.\n118\texport function assembleWorkHandlerMap(\n119\t  tables: ReadonlyArray<WorkHandlerMap>,\n120\t): WorkHandlerMap {\n121\t  const map: WorkHandlerMap = {};\n122\t  for (const table of tables) {\n123\t    for (const [kind, handler] of Object.entries(table)) {\n124\t      if (map[kind as WorkKind] !== undefined) {\n125\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n126\t      }\n127\t      map[kind as WorkKind] = handler;\n128\t    }\n129\t  }\n130\t  return map;\n131\t}\n132\t\n133\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n134\t  return {\n135\t    ok: false,\n136\t    error: {\n137\t      errorClass: \"state_corruption\",\n138\t      code: \"unknown_work_kind\",\n139\t      reason: `no handler registered for work kind \"${kind}\"`,\n140\t    },\n141\t  };\n142\t}\n143\t\n144\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n145\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n146\texport function lookupWorkHandler(\n147\t  map: WorkHandlerMap,\n148\t  kind: string,\n149\t): OpResult<WorkHandler> {\n150\t  const handler = map[kind as WorkKind];\n151\t  if (handler === undefined) return unknownWorkKind(kind);\n152\t  return { ok: true, value: handler };\n153\t}\n154\t\n155\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n156\t// requeue land in Story 4.\n157\texport interface WorkSurface {\n158\t  drain(\n159\t    ref: threadsDomain.ThreadRef,\n160\t    opts?: { maxItems?: number },\n161\t  ): Promise<OpResult<DrainReport>>;\n162\t}\n163\t\n164\texport interface Lhc {\n165\t  threads: typeof threadsDomain;\n166\t  intakeStream: typeof intakeStreamDomain;\n167\t  messages: typeof messagesDomain;\n168\t  turns: typeof turnsDomain;\n169\t  config: ResolvedSdkConfig;\n170\t  scheduler: Scheduler;\n171\t  workHandlers: WorkHandlerMap;\n172\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n173\t  work: WorkSurface;\n174\t  // Resolves when the scheduler has no running or pending drain for the\n175\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n176\t  // resolve in manual mode.\n177\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n178\t}\n179\t\n180\tfunction requirePositive(value: number, name: string): void {\n181\t  if (!Number.isFinite(value) || value <= 0) {\n182\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n183\t  }\n184\t}\n185\t\n186\tfunction requireNonNegative(value: number, name: string): void {\n187\t  if (!Number.isFinite(value) || value < 0) {\n188\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n189\t  }\n190\t}\n191\t\n192\t// The only assembly path: provider, mode, clock, and policy enter here.\n193\t// Config mistakes are programmer errors at construction and throw; operating\n194\t// failures after construction return OpResults per the error contract.\n195\texport function createSdk(config: SdkConfig): Lhc {\n196\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n197\t    throw new TypeError(\n198\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n199\t    );\n200\t  }\n201\t  if (config.provider === null || typeof config.provider !== \"object\") {\n202\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n203\t  }\n204\t  for (const operation of PROVIDER_OPERATIONS) {\n205\t    if (typeof config.provider[operation] !== \"function\") {\n206\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n207\t    }\n208\t  }\n209\t\n210\t  const resolved: ResolvedSdkConfig = {\n211\t    provider: config.provider,\n212\t    mode: config.mode,\n213\t    clock: config.clock ?? (() => new Date()),\n214\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n215\t    lease: config.lease ?? { durationMs: 120000 },\n216\t    chunkPolicy:\n217\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n218\t  };\n219\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n220\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n221\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n222\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n223\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n224\t  }\n225\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n226\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n227\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n228\t    throw new TypeError(\n229\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n230\t    );\n231\t  }\n232\t\n233\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n234\t  // The tables are empty until Stories 2–3 land the real handlers; the\n235\t  // assembly mechanics are production code from day one.\n236\t  const workHandlers = assembleWorkHandlerMap([\n237\t    messagesDomain.workHandlers,\n238\t    turnsDomain.workHandlers,\n239\t  ]);\n240\t\n241\t  const drainDeps: DrainDeps = {\n242\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n243\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n244\t    config: resolved,\n245\t  };\n246\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n247\t\n248\t  // Background mode wires the scheduler into the process-wide seams: enqueue\n249\t  // pokes (DD-5) and thread-file touches (DD-10) reach it from then on, and\n250\t  // queueing alone causes processing (AC-1.5). The slots hold one scheduler;\n251\t  // constructing a later background SDK supersedes an earlier one (the\n252\t  // displaced scheduler's in-memory state was advisory — the rows remain).\n253\t  // Manual mode leaves the slots alone: pokes stay no-ops by contract.\n254\t  if (resolved.mode === \"background\") {\n255\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n256\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n257\t  }\n258\t\n259\t  const work: WorkSurface = {\n260\t    drain: async (ref, opts) => {\n261\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n262\t      if (!resolvedRef.ok) return resolvedRef;\n263\t      return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n264\t    },\n265\t  };\n266\t\n267\t  return {\n268\t    threads: threadsDomain,\n269\t    intakeStream: intakeStreamDomain,\n270\t    messages: messagesDomain,\n271\t    turns: turnsDomain,\n272\t    config: resolved,\n273\t    scheduler,\n274\t    workHandlers,\n275\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n276\t    work,\n277\t    drainSettled: async (ref) => {\n278\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n279\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n280\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n281\t      if (threadId === null) return;\n282\t      return scheduler.drainSettled(threadId);\n283\t    },\n284\t  };\n285\t}\n286\t"}]},"parent_tool_use_id":null,"session_id":"966b484c-2144-4e17-9e11-a73523d7f0c4","uuid":"7c78ae8d-0352-40fb-aafd-5506e93d5a39","timestamp":"2026-06-11T08:06:55.636Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts","content":"export * as threads from \"./domains/threads/index.js\";\nexport * as intakeStream from \"./domains/intake-stream/index.js\";\nexport * as messages from \"./domains/messages/index.js\";\nexport * as turns from \"./domains/turns/index.js\";\n\nimport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\nimport * as messagesDomain from \"./domains/messages/index.js\";\nimport * as threadsDomain from \"./domains/threads/index.js\";\nimport * as turnsDomain from \"./domains/turns/index.js\";\nimport {\n  createScheduler,\n  peekThreadId,\n  runDrain,\n  type DrainDeps,\n  type DrainReport,\n  type Scheduler,\n} from \"./scheduler.js\";\nimport { setSchedulerPoke as installSchedulerPoke, setThreadTouch } from \"./shared/context.js\";\nimport {\n  PROVIDER_OPERATIONS,\n  type ResolvedSdkConfig,\n  type SdkConfig,\n  type WorkHandler,\n} from \"./shared/derivation.js\";\nimport type { ErrorResult, OpResult } from \"./shared/errors.js\";\nimport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n\nexport {\n  estimateTokens,\n  TOKEN_ESTIMATOR_ID,\n} from \"./tech-utils/token-counting/index.js\";\n\nexport {\n  WORK_KIND_REGISTRY,\n  type WorkItemRecord,\n  type WorkKind,\n  type WorkOwner,\n  type WorkSourceRef,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type {\n  ErrorClass,\n  ErrorCode,\n  ErrorResult,\n  OpResult,\n} from \"./shared/errors.js\";\nexport {\n  runInTransaction,\n  setSchedulerPoke,\n  setThreadTouch,\n  type OperationContext,\n} from \"./shared/context.js\";\n\nexport {\n  createDeterministicProvider,\n  deterministicOutcomesSuffix,\n  deterministicReceiptsSuffix,\n  deterministicText,\n  type DeterministicOpName,\n} from \"./providers/deterministic.js\";\nexport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n\nexport type {\n  CompletionTx,\n  DependencyGap,\n  DerivationProvider,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  FormReportEntry,\n  HandlerFormWrite,\n  HandlerOutcome,\n  HandlerRunContext,\n  ProviderResult,\n  RenderingPart,\n  ResolvedSdkConfig,\n  SdkConfig,\n  SubjectKind,\n  ToolOutcome,\n  ToolRunReceipt,\n  WorkHandler,\n} from \"./shared/derivation.js\";\nexport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\nexport {\n  countLiveItems,\n  enqueue,\n  queueDetail,\n  supersedeQueued,\n  type ClaimedWorkItem,\n  type EnqueueFormTarget,\n  type EnqueueInput,\n  type QueueDetailRow,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type { ThreadRef } from \"./domains/threads/index.js\";\nexport type {\n  Block,\n  BlockType,\n  MessageRecord,\n  MutationResult,\n} from \"./domains/messages/index.js\";\nexport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\nexport type {\n  BatchResult,\n  EventKind,\n  EventRecord,\n  MessageEventInput,\n} from \"./domains/intake-stream/index.js\";\n\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n\n// Merge per-domain handler tables into the one join between the queue's\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n// (each kind has exactly one owner) and throws at construction.\nexport function assembleWorkHandlerMap(\n  tables: ReadonlyArray<WorkHandlerMap>,\n): WorkHandlerMap {\n  const map: WorkHandlerMap = {};\n  for (const table of tables) {\n    for (const [kind, handler] of Object.entries(table)) {\n      if (map[kind as WorkKind] !== undefined) {\n        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n      }\n      map[kind as WorkKind] = handler;\n    }\n  }\n  return map;\n}\n\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"state_corruption\",\n      code: \"unknown_work_kind\",\n      reason: `no handler registered for work kind \"${kind}\"`,\n    },\n  };\n}\n\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\nexport function lookupWorkHandler(\n  map: WorkHandlerMap,\n  kind: string,\n): OpResult<WorkHandler> {\n  const handler = map[kind as WorkKind];\n  if (handler === undefined) return unknownWorkKind(kind);\n  return { ok: true, value: handler };\n}\n\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n// requeue land in Story 4.\nexport interface WorkSurface {\n  drain(\n    ref: threadsDomain.ThreadRef,\n    opts?: { maxItems?: number },\n  ): Promise<OpResult<DrainReport>>;\n}\n\nexport interface Lhc {\n  threads: typeof threadsDomain;\n  intakeStream: typeof intakeStreamDomain;\n  messages: typeof messagesDomain;\n  turns: typeof turnsDomain;\n  config: ResolvedSdkConfig;\n  scheduler: Scheduler;\n  workHandlers: WorkHandlerMap;\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n  work: WorkSurface;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3) — the awaitable for background mode, and a no-op\n  // resolve in manual mode.\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n}\n\nfunction requirePositive(value: number, name: string): void {\n  if (!Number.isFinite(value) || value <= 0) {\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n  }\n}\n\nfunction requireNonNegative(value: number, name: string): void {\n  if (!Number.isFinite(value) || value < 0) {\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n  }\n}\n\n// The only assembly path: provider, mode, clock, and policy enter here.\n// Config mistakes are programmer errors at construction and throw; operating\n// failures after construction return OpResults per the error contract.\nexport function createSdk(config: SdkConfig): Lhc {\n  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n    throw new TypeError(\n      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n    );\n  }\n  if (config.provider === null || typeof config.provider !== \"object\") {\n    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n  }\n  for (const operation of PROVIDER_OPERATIONS) {\n    if (typeof config.provider[operation] !== \"function\") {\n      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n    }\n  }\n\n  const resolved: ResolvedSdkConfig = {\n    provider: config.provider,\n    mode: config.mode,\n    clock: config.clock ?? (() => new Date()),\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n    lease: config.lease ?? { durationMs: 120000 },\n    chunkPolicy:\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n  };\n  requirePositive(resolved.retry.budget, \"retry.budget\");\n  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n  }\n  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n    throw new TypeError(\n      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n    );\n  }\n\n  // Handler maps merge from per-domain contributions at construction (DD-6).\n  // The tables are empty until Stories 2–3 land the real handlers; the\n  // assembly mechanics are production code from day one.\n  const workHandlers = assembleWorkHandlerMap([\n    messagesDomain.workHandlers,\n    turnsDomain.workHandlers,\n  ]);\n\n  const drainDeps: DrainDeps = {\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n    config: resolved,\n  };\n  const scheduler = createScheduler(resolved.mode, drainDeps);\n\n  // Background mode wires the scheduler into the process-wide seams: enqueue\n  // pokes (DD-5) and thread-file touches (DD-10) reach it from then on, and\n  // queueing alone causes processing (AC-1.5). The slots hold one scheduler;\n  // constructing a later background SDK supersedes an earlier one (the\n  // displaced scheduler's in-memory state was advisory — the rows remain).\n  // Manual mode leaves the slots alone: pokes stay no-ops by contract.\n  if (resolved.mode === \"background\") {\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n  }\n\n  const work: WorkSurface = {\n    drain: async (ref, opts) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return resolvedRef;\n      return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n    },\n  };\n\n  return {\n    threads: threadsDomain,\n    intakeStream: intakeStreamDomain,\n    messages: messagesDomain,\n    turns: turnsDomain,\n    config: resolved,\n    scheduler,\n    workHandlers,\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    work,\n    drainSettled: async (ref) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n      const threadId = peekThreadId(resolvedRef.value.filePath);\n      if (threadId === null) return;\n      return scheduler.drainSettled(threadId);\n    },\n  };\n}\n","numLines":286,"startLine":1,"totalLines":286}}}

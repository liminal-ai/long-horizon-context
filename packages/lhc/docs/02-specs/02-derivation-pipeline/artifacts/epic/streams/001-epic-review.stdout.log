{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0126MdK9Dug1QHV4sbiYemA9","type":"tool_result","content":"1\t// Turn row operations. Writes run on the caller's handle inside the batch\n2\t// transaction; reads run on a fresh handle per operation. A closed turn has\n3\t// no writer anywhere in this module — frozenness (AC-3.7) is the absence of\n4\t// any UPDATE that touches a closed row.\n5\timport type { DatabaseSync } from \"node:sqlite\";\n6\timport type { TurnRecord } from \"../index.js\";\n7\timport { readPlacements } from \"./chunks.js\";\n8\t\n9\texport function selectOpenTurnIds(db: DatabaseSync): string[] {\n10\t  const rows = db\n11\t    .prepare(\"SELECT turn_id FROM turns WHERE status = 'open' ORDER BY turn_order\")\n12\t    .all() as unknown as Array<{ turn_id: string }>;\n13\t  return rows.map((row) => row.turn_id);\n14\t}\n15\t\n16\texport function nextTurnOrder(db: DatabaseSync): number {\n17\t  const row = db.prepare(\"SELECT MAX(turn_order) AS max_order FROM turns\").get() as\n18\t    | { max_order: number | bigint | null }\n19\t    | undefined;\n20\t  return Number(row?.max_order ?? 0) + 1;\n21\t}\n22\t\n23\texport function insertOpenTurn(\n24\t  db: DatabaseSync,\n25\t  turnOrder: number,\n26\t  openedAtEventOrder: number,\n27\t): string {\n28\t  const turnId = `t${turnOrder}`;\n29\t  db.prepare(\n30\t    `INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order)\n31\t     VALUES (?, ?, 'open', ?)`,\n32\t  ).run(turnId, turnOrder, openedAtEventOrder);\n33\t  return turnId;\n34\t}\n35\t\n36\texport function closeTurn(db: DatabaseSync, turnId: string, closedAtEventOrder: number): void {\n37\t  db.prepare(\n38\t    \"UPDATE turns SET status = 'closed', closed_at_event_order = ? WHERE turn_id = ? AND status = 'open'\",\n39\t  ).run(closedAtEventOrder, turnId);\n40\t}\n41\t\n42\t// The turn delete's validation read (Flow 6): the live (deleted-filtered)\n43\t// turn row. A deleted or missing target misses here and refuses as\n44\t// turn_not_found — the filtered view is the refusal's read, so a double\n45\t// delete is a refusal, never a silent success (AC-6.7).\n46\texport function readMutableTurn(\n47\t  db: DatabaseSync,\n48\t  turnId: string,\n49\t): { turnId: string; status: \"open\" | \"closed\" } | undefined {\n50\t  const row = db\n51\t    .prepare(`SELECT status FROM turns WHERE turn_id = ? AND deleted_at IS NULL`)\n52\t    .get(turnId) as unknown as { status: string } | undefined;\n53\t  if (row === undefined) return undefined;\n54\t  return { turnId, status: row.status as \"open\" | \"closed\" };\n55\t}\n56\t\n57\t// The turn delete's record apply: a projection-level tombstone on the turn\n58\t// row, mirroring the message stamp. Events and membership rows are never\n59\t// touched — reads filter; boundaries never re-cut (shrink-only membership).\n60\texport function markTurnDeleted(db: DatabaseSync, turnId: string, deletedAt: string): void {\n61\t  db.prepare(`UPDATE turns SET deleted_at = ? WHERE turn_id = ?`).run(deletedAt, turnId);\n62\t}\n63\t\n64\tinterface RawTurnRow {\n65\t  turn_id: string;\n66\t  status: string;\n67\t  opened_at_event_order: number | bigint;\n68\t  closed_at_event_order: number | bigint | null;\n69\t}\n70\t\n71\t// Membership is stored on the member (message.turn_id), never as a list on\n72\t// the turn: memberMessageIds is a query, ordered by event order, so there is\n73\t// exactly one source of truth. Both halves read deleted-filtered (tech\n74\t// design §Mechanics): a deleted turn leaves the listing entirely, and a\n75\t// deleted message leaves its turn's membership — the membership shrinks in\n76\t// place, the turn row and its boundaries untouched.\n77\texport function readTurns(db: DatabaseSync): TurnRecord[] {\n78\t  const memberRows = db\n79\t    .prepare(\n80\t      `SELECT message_id, turn_id FROM message\n81\t       WHERE turn_id IS NOT NULL AND deleted_at IS NULL ORDER BY source_event_order`,\n82\t    )\n83\t    .all() as unknown as Array<{ message_id: string; turn_id: string }>;\n84\t  const membersByTurn = new Map<string, string[]>();\n85\t  for (const row of memberRows) {\n86\t    const members = membersByTurn.get(row.turn_id) ?? [];\n87\t    members.push(row.message_id);\n88\t    membersByTurn.set(row.turn_id, members);\n89\t  }\n90\t\n91\t  const turnRows = db\n92\t    .prepare(\n93\t      `SELECT turn_id, status, opened_at_event_order, closed_at_event_order\n94\t       FROM turns WHERE deleted_at IS NULL ORDER BY turn_order`,\n95\t    )\n96\t    .all() as unknown as RawTurnRow[];\n97\t  // Chunk placement rides the turn read-back (Epic 02 AC-3.5): stored\n98\t  // chunk_member values, absent until the turn's derivation placed it.\n99\t  const placements = readPlacements(db);\n100\t  return turnRows.map((row) => {\n101\t    const record: TurnRecord = {\n102\t      turnId: row.turn_id,\n103\t      status: row.status as TurnRecord[\"status\"],\n104\t      memberMessageIds: membersByTurn.get(row.turn_id) ?? [],\n105\t      openedAtEventOrder: Number(row.opened_at_event_order),\n106\t    };\n107\t    if (row.closed_at_event_order !== null) {\n108\t      record.closedAtEventOrder = Number(row.closed_at_event_order);\n109\t    }\n110\t    const placement = placements.get(row.turn_id);\n111\t    if (placement !== undefined) {\n112\t      record.chunkId = placement.chunkId;\n113\t      record.memberIdx = placement.memberIdx;\n114\t    }\n115\t    return record;\n116\t  });\n117\t}\n118\t"}]},"parent_tool_use_id":null,"session_id":"1746f4bf-569a-4870-8bca-7c80d2cc25af","uuid":"a02ee246-3fc1-49b4-9bef-a2c431f952b2","timestamp":"2026-06-11T08:04:19.484Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/store.ts","content":"// Turn row operations. Writes run on the caller's handle inside the batch\n// transaction; reads run on a fresh handle per operation. A closed turn has\n// no writer anywhere in this module — frozenness (AC-3.7) is the absence of\n// any UPDATE that touches a closed row.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { TurnRecord } from \"../index.js\";\nimport { readPlacements } from \"./chunks.js\";\n\nexport function selectOpenTurnIds(db: DatabaseSync): string[] {\n  const rows = db\n    .prepare(\"SELECT turn_id FROM turns WHERE status = 'open' ORDER BY turn_order\")\n    .all() as unknown as Array<{ turn_id: string }>;\n  return rows.map((row) => row.turn_id);\n}\n\nexport function nextTurnOrder(db: DatabaseSync): number {\n  const row = db.prepare(\"SELECT MAX(turn_order) AS max_order FROM turns\").get() as\n    | { max_order: number | bigint | null }\n    | undefined;\n  return Number(row?.max_order ?? 0) + 1;\n}\n\nexport function insertOpenTurn(\n  db: DatabaseSync,\n  turnOrder: number,\n  openedAtEventOrder: number,\n): string {\n  const turnId = `t${turnOrder}`;\n  db.prepare(\n    `INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order)\n     VALUES (?, ?, 'open', ?)`,\n  ).run(turnId, turnOrder, openedAtEventOrder);\n  return turnId;\n}\n\nexport function closeTurn(db: DatabaseSync, turnId: string, closedAtEventOrder: number): void {\n  db.prepare(\n    \"UPDATE turns SET status = 'closed', closed_at_event_order = ? WHERE turn_id = ? AND status = 'open'\",\n  ).run(closedAtEventOrder, turnId);\n}\n\n// The turn delete's validation read (Flow 6): the live (deleted-filtered)\n// turn row. A deleted or missing target misses here and refuses as\n// turn_not_found — the filtered view is the refusal's read, so a double\n// delete is a refusal, never a silent success (AC-6.7).\nexport function readMutableTurn(\n  db: DatabaseSync,\n  turnId: string,\n): { turnId: string; status: \"open\" | \"closed\" } | undefined {\n  const row = db\n    .prepare(`SELECT status FROM turns WHERE turn_id = ? AND deleted_at IS NULL`)\n    .get(turnId) as unknown as { status: string } | undefined;\n  if (row === undefined) return undefined;\n  return { turnId, status: row.status as \"open\" | \"closed\" };\n}\n\n// The turn delete's record apply: a projection-level tombstone on the turn\n// row, mirroring the message stamp. Events and membership rows are never\n// touched — reads filter; boundaries never re-cut (shrink-only membership).\nexport function markTurnDeleted(db: DatabaseSync, turnId: string, deletedAt: string): void {\n  db.prepare(`UPDATE turns SET deleted_at = ? WHERE turn_id = ?`).run(deletedAt, turnId);\n}\n\ninterface RawTurnRow {\n  turn_id: string;\n  status: string;\n  opened_at_event_order: number | bigint;\n  closed_at_event_order: number | bigint | null;\n}\n\n// Membership is stored on the member (message.turn_id), never as a list on\n// the turn: memberMessageIds is a query, ordered by event order, so there is\n// exactly one source of truth. Both halves read deleted-filtered (tech\n// design §Mechanics): a deleted turn leaves the listing entirely, and a\n// deleted message leaves its turn's membership — the membership shrinks in\n// place, the turn row and its boundaries untouched.\nexport function readTurns(db: DatabaseSync): TurnRecord[] {\n  const memberRows = db\n    .prepare(\n      `SELECT message_id, turn_id FROM message\n       WHERE turn_id IS NOT NULL AND deleted_at IS NULL ORDER BY source_event_order`,\n    )\n    .all() as unknown as Array<{ message_id: string; turn_id: string }>;\n  const membersByTurn = new Map<string, string[]>();\n  for (const row of memberRows) {\n    const members = membersByTurn.get(row.turn_id) ?? [];\n    members.push(row.message_id);\n    membersByTurn.set(row.turn_id, members);\n  }\n\n  const turnRows = db\n    .prepare(\n      `SELECT turn_id, status, opened_at_event_order, closed_at_event_order\n       FROM turns WHERE deleted_at IS NULL ORDER BY turn_order`,\n    )\n    .all() as unknown as RawTurnRow[];\n  // Chunk placement rides the turn read-back (Epic 02 AC-3.5): stored\n  // chunk_member values, absent until the turn's derivation placed it.\n  const placements = readPlacements(db);\n  return turnRows.map((row) => {\n    const record: TurnRecord = {\n      turnId: row.turn_id,\n      status: row.status as TurnRecord[\"status\"],\n      memberMessageIds: membersByTurn.get(row.turn_id) ?? [],\n      openedAtEventOrder: Number(row.opened_at_event_order),\n    };\n    if (row.closed_at_event_order !== null) {\n      record.closedAtEventOrder = Number(row.closed_at_event_order);\n    }\n    const placement = placements.get(row.turn_id);\n    if (placement !== undefined) {\n      record.chunkId = placement.chunkId;\n      record.memberIdx = placement.memberIdx;\n    }\n    return record;\n  });\n}\n","numLines":118,"startLine":1,"totalLines":118}}}

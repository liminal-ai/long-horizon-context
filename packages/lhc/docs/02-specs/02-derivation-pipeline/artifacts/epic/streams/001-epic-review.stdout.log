{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/tech-utils/work-queue/index.ts | sed -n '1,620p'\"","aggregated_output":"     1\t// Durable work-item mechanics: recording, ordered listing, and the enqueue\n     2\t// wrapper that makes \"queueing is what schedules processing\" structural\n     3\t// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n     4\t// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n     5\t// a turn or a summary is; which kinds queue for which sources, and which\n     6\t// derived forms a kind produces, is the owning domains' business (callers\n     7\t// pass the form targets in). Writes run on the caller's handle inside the\n     8\t// ambient transaction, so items commit (or roll back) with the batch. No\n     9\t// public SDK surface: read-back reaches here only through the owning\n    10\t// domains' listQueuedWork.\n    11\timport type { DatabaseSync } from \"node:sqlite\";\n    12\timport {\n    13\t  createCommitHooks,\n    14\t  fireSchedulerPoke,\n    15\t  type OperationContext,\n    16\t} from \"../../shared/context.js\";\n    17\timport type {\n    18\t  CompletionTx,\n    19\t  FormKind,\n    20\t  HandlerFormWrite,\n    21\t  SubjectKind,\n    22\t} from \"../../shared/derivation.js\";\n    23\t\n    24\texport type WorkOwner = \"messages\" | \"turns\";\n    25\texport type WorkKind =\n    26\t  | \"prompt_smoothing\"\n    27\t  | \"tool_call_summary\"\n    28\t  | \"tool_result_summary\"\n    29\t  | \"turn_derivation\"\n    30\t  | \"chunk_summary_detailed\"\n    31\t  | \"chunk_summary_brief\";\n    32\texport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n    33\t\n    34\t// The work-kind registry: owner and sourceRef semantics per the epic's Work\n    35\t// Item contract. Mechanical metadata only — what a kind *means* stays with\n    36\t// the owning domain's handler (registered at SDK construction, DD-6).\n    37\texport const WORK_KIND_REGISTRY: Readonly<\n    38\t  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n    39\t> = {\n    40\t  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    41\t  tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    42\t  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    43\t  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n    44\t  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n    45\t  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n    46\t};\n    47\t\n    48\texport interface WorkItemRecord {\n    49\t  workItemId: string;\n    50\t  owner: WorkOwner;\n    51\t  kind: WorkKind;\n    52\t  sourceRef: WorkSourceRef;\n    53\t  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n    54\t  queuedAt: string;\n    55\t}\n    56\t\n    57\t// The derived forms an enqueue is scheduling work toward; the owning domain\n    58\t// names them (the util stays meaning-blind). Stored in the row's payload so\n    59\t// the drain's terminal paths (retry exhaustion, blocked source) can land the\n    60\t// form's failed/blocked state without asking any domain what a kind means.\n    61\texport interface EnqueueFormTarget {\n    62\t  subjectKind: SubjectKind;\n    63\t  subjectId: string;\n    64\t  form: FormKind;\n    65\t}\n    66\t\n    67\texport interface WorkItemInput {\n    68\t  owner: WorkOwner;\n    69\t  kind: WorkKind;\n    70\t  sourceRef: WorkSourceRef;\n    71\t  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n    72\t  forms?: readonly EnqueueFormTarget[]; // carried in payload for the drain's terminal paths\n    73\t}\n    74\t\n    75\tfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n    76\t  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n    77\t  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n    78\t  return sourceRef.chunkId;\n    79\t}\n    80\t\n    81\t// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n    82\t// same kind for the same source *at the same version* is the same id —\n    83\t// natural idempotency for the repair path — while a post-mutation\n    84\t// replacement (next version) never collides with an in-flight pre-mutation\n    85\t// item.\n    86\texport function recordItem(\n    87\t  db: DatabaseSync,\n    88\t  input: WorkItemInput,\n    89\t  queuedAt: string,\n    90\t): WorkItemRecord {\n    91\t  const sourceVersion = input.sourceVersion ?? 1;\n    92\t  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n    93\t  db.prepare(\n    94\t    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n    95\t     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n    96\t  ).run(\n    97\t    workItemId,\n    98\t    input.owner,\n    99\t    input.kind,\n   100\t    JSON.stringify(input.sourceRef),\n   101\t    queuedAt,\n   102\t    JSON.stringify({ sourceVersion, forms: input.forms ?? [] }),\n   103\t  );\n   104\t  return {\n   105\t    workItemId,\n   106\t    owner: input.owner,\n   107\t    kind: input.kind,\n   108\t    sourceRef: input.sourceRef,\n   109\t    status: \"queued\",\n   110\t    queuedAt,\n   111\t  };\n   112\t}\n   113\t\n   114\texport interface EnqueueInput extends WorkItemInput {\n   115\t  forms: readonly EnqueueFormTarget[];\n   116\t}\n   117\t\n   118\t// The one way work is scheduled (DD-5): the work row, the form's `pending`\n   119\t// state row, and the scheduler poke all ride the ambient transaction — they\n   120\t// commit together or vanish together. Enqueue is the *only* place a\n   121\t// derived_form row is created (completion is UPDATE-only); re-enqueueing\n   122\t// resets an existing row to pending at the enqueued source version.\n   123\texport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n   124\t  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n   125\t  const sourceVersion = input.sourceVersion ?? 1;\n   126\t  const upsert = ctx.db.prepare(\n   127\t    `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n   128\t     VALUES (?, ?, ?, 'pending', ?)\n   129\t     ON CONFLICT (subject_kind, subject_id, form) DO UPDATE SET\n   130\t       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n   131\t       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n   132\t  );\n   133\t  for (const target of input.forms) {\n   134\t    upsert.run(target.subjectKind, target.subjectId, target.form, sourceVersion);\n   135\t  }\n   136\t  ctx.onCommit(() => fireSchedulerPoke(ctx.threadId));\n   137\t  return item;\n   138\t}\n   139\t\n   140\tinterface RawWorkItemRow {\n   141\t  work_item_id: string;\n   142\t  owner: string;\n   143\t  kind: string;\n   144\t  source_ref: string;\n   145\t  queued_at: string;\n   146\t}\n   147\t\n   148\t// ── claim mechanics (Epic 02 Story 1, tech design §Mechanics) ─────\n   149\t// All pure SQL against the caller's open handle, domain-blind. Claim,\n   150\t// complete, and the terminal half of failAttempt each own one short\n   151\t// BEGIN IMMEDIATE; the handler in between runs with no open transaction.\n   152\t\n   153\t// The claimed row as the drain holds it: mechanical fields plus the payload's\n   154\t// source version and form targets. `kind` is a plain string here — a raw row\n   155\t// with an unregistered kind must still be claimable so the drain can land it\n   156\t// failed_terminal instead of skipping it (AC-1.8).\n   157\texport interface ClaimedWorkItem {\n   158\t  workItemId: string;\n   159\t  owner: WorkOwner;\n   160\t  kind: string;\n   161\t  sourceRef: WorkSourceRef;\n   162\t  attempts: number;\n   163\t  queuedAt: string;\n   164\t  sourceVersion: number;\n   165\t  forms: EnqueueFormTarget[];\n   166\t}\n   167\t\n   168\texport type ClaimOutcome =\n   169\t  | { outcome: \"claimed\"; item: ClaimedWorkItem }\n   170\t  | { outcome: \"empty\" }\n   171\t  | { outcome: \"in_flight\"; claimExpiresAt: string }\n   172\t  | { outcome: \"waiting\"; waitingUntil: string };\n   173\t\n   174\tinterface RawClaimRow {\n   175\t  work_item_id: string;\n   176\t  owner: string;\n   177\t  kind: string;\n   178\t  source_ref: string;\n   179\t  attempts: number | bigint;\n   180\t  queued_at: string;\n   181\t  payload: string | null;\n   182\t}\n   183\t\n   184\t// Form targets for pre-v5 rows, whose payload is NULL (Epic 01 wrote no\n   185\t// payload column). Exactly the F-02 backfill's kind→form mapping (migration\n   186\t// v5, shared/storage.ts): the backfill created pending derived_form rows at\n   187\t// source version 1 for these kinds, and a terminal failure must find them —\n   188\t// otherwise exhaustion would delete the work row and strand the backfilled\n   189\t// form as pending forever, breaking AC-1.9/DD-1 for upgraded threads.\n   190\tconst LEGACY_KIND_FORMS: Partial<\n   191\t  Record<string, ReadonlyArray<{ subjectKind: SubjectKind; form: FormKind }>>\n   192\t> = {\n   193\t  prompt_smoothing: [{ subjectKind: \"message\", form: \"smoothed_prompt\" }],\n   194\t  tool_result_summary: [{ subjectKind: \"message\", form: \"tool_result_summary\" }],\n   195\t  turn_derivation: [\n   196\t    { subjectKind: \"turn\", form: \"turn_rendering\" },\n   197\t    { subjectKind: \"turn\", form: \"lower_band_projection\" },\n   198\t  ],\n   199\t};\n   200\t\n   201\tfunction legacyFormTargets(kind: string, sourceRef: WorkSourceRef): EnqueueFormTarget[] {\n   202\t  const mapped = LEGACY_KIND_FORMS[kind];\n   203\t  if (mapped === undefined) return [];\n   204\t  const subjectId = sourceIdOf(sourceRef);\n   205\t  return mapped.map((target) => ({ ...target, subjectId }));\n   206\t}\n   207\t\n   208\tfunction toClaimedItem(row: RawClaimRow): ClaimedWorkItem {\n   209\t  const sourceRef = JSON.parse(row.source_ref) as WorkSourceRef;\n   210\t  const payload =\n   211\t    row.payload === null\n   212\t      ? // Pre-v5 row: version 1 (matching the backfill) and form targets\n   213\t        // reconstructed from the backfill's own mapping.\n   214\t        { sourceVersion: 1, forms: legacyFormTargets(row.kind, sourceRef) }\n   215\t      : (JSON.parse(row.payload) as { sourceVersion?: number; forms?: EnqueueFormTarget[] });\n   216\t  return {\n   217\t    workItemId: row.work_item_id,\n   218\t    owner: row.owner as WorkOwner,\n   219\t    kind: row.kind,\n   220\t    sourceRef,\n   221\t    attempts: Number(row.attempts),\n   222\t    queuedAt: row.queued_at,\n   223\t    sourceVersion: payload.sourceVersion ?? 1,\n   224\t    forms: payload.forms ?? [],\n   225\t  };\n   226\t}\n   227\t\n   228\t// Head-first, never skip-ahead: the claim decision is made against the oldest\n   229\t// live row only — a later eligible row is never considered while an older\n   230\t// live row exists. One atomic UPDATE under BEGIN IMMEDIATE (no read-then-\n   231\t// write split: the race window is the bug class). The CASE increments\n   232\t// `attempts` only when reclaiming an expired claimed row — a reclaim means a\n   233\t// run died or hung, and the increment makes the crash visible in the report\n   234\t// and counts it against the retry budget; normal claims never touch it.\n   235\texport function claimNext(db: DatabaseSync, now: string, leaseDurationMs: number): ClaimOutcome {\n   236\t  const expiresAt = new Date(Date.parse(now) + leaseDurationMs).toISOString();\n   237\t  db.exec(\"BEGIN IMMEDIATE;\");\n   238\t  try {\n   239\t    const claimed = db\n   240\t      .prepare(\n   241\t        `UPDATE work_item SET status = 'claimed', claimed_at = ?, claim_expires_at = ?,\n   242\t           attempts = attempts + CASE WHEN status = 'claimed' THEN 1 ELSE 0 END\n   243\t         WHERE work_item_id = (\n   244\t           SELECT work_item_id FROM (\n   245\t             SELECT work_item_id, status, eligible_at, claim_expires_at\n   246\t             FROM work_item WHERE status IN ('queued', 'claimed')\n   247\t             ORDER BY rowid LIMIT 1\n   248\t           )\n   249\t           WHERE (status = 'queued' AND (eligible_at IS NULL OR eligible_at <= ?))\n   250\t              OR (status = 'claimed' AND claim_expires_at <= ?)\n   251\t         )\n   252\t         RETURNING work_item_id, owner, kind, source_ref, attempts, queued_at, payload`,\n   253\t      )\n   254\t      .get(now, expiresAt, now, now) as unknown as RawClaimRow | undefined;\n   255\t    if (claimed !== undefined) {\n   256\t      db.exec(\"COMMIT;\");\n   257\t      return { outcome: \"claimed\", item: toClaimedItem(claimed) };\n   258\t    }\n   259\t    // No row claimable: re-read the head inside the same transaction to\n   260\t    // classify the stop. A claimed head with a live lease gates the queue\n   261\t    // (in_flight, AC-1.4); a queued head still backing off gates it too\n   262\t    // (waiting) — strict ordering, never reordered around the head.\n   263\t    const head = db\n   264\t      .prepare(\n   265\t        `SELECT status, eligible_at, claim_expires_at\n   266\t         FROM work_item WHERE status IN ('queued', 'claimed')\n   267\t         ORDER BY rowid LIMIT 1`,\n   268\t      )\n   269\t      .get() as unknown as\n   270\t      | { status: string; eligible_at: string | null; claim_expires_at: string | null }\n   271\t      | undefined;\n   272\t    db.exec(\"COMMIT;\");\n   273\t    if (head === undefined) return { outcome: \"empty\" };\n   274\t    if (head.status === \"claimed\") {\n   275\t      return { outcome: \"in_flight\", claimExpiresAt: head.claim_expires_at ?? \"\" };\n   276\t    }\n   277\t    return { outcome: \"waiting\", waitingUntil: head.eligible_at ?? \"\" };\n   278\t  } catch (cause) {\n   279\t    db.exec(\"ROLLBACK;\");\n   280\t    throw cause;\n   281\t  }\n   282\t}\n   283\t\n   284\t// Completion: the version-checked form writes and the item row's deletion in\n   285\t// one short transaction (DD-1: terminal transition deletes the row; the\n   286\t// disposition is reported in-memory, never stored). UPDATE-only, never\n   287\t// upsert — the pending row exists from enqueue; a write that finds no row at\n   288\t// the item's source version is discarded as stale (DD-3 truth table). The\n   289\t// optional onApplied hook (Story 3) runs inside this same transaction, after\n   290\t// the form writes and only when they landed — chunk placement and the\n   291\t// close→summary enqueues ride the completion commit; its onCommit\n   292\t// registrations (the enqueue pokes) flush after COMMIT and drop on rollback.\n   293\texport function complete(\n   294\t  db: DatabaseSync,\n   295\t  item: ClaimedWorkItem,\n   296\t  writes: readonly HandlerFormWrite[],\n   297\t  derivedAt: string,\n   298\t  onApplied?: (tx: CompletionTx) => void,\n   299\t): \"done\" | \"stale_discarded\" {\n   300\t  const hooks = createCommitHooks();\n   301\t  db.exec(\"BEGIN IMMEDIATE;\");\n   302\t  try {\n   303\t    let hits = 0;\n   304\t    const update = db.prepare(\n   305\t      `UPDATE derived_form\n   306\t       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = ?, derived_at = ?\n   307\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n   308\t    );\n   309\t    for (const write of writes) {\n   310\t      const changed = update.run(\n   311\t        write.content,\n   312\t        write.metadata === undefined ? null : JSON.stringify(write.metadata),\n   313\t        write.gaps === undefined ? null : JSON.stringify(write.gaps),\n   314\t        derivedAt,\n   315\t        write.subjectKind,\n   316\t        write.subjectId,\n   317\t        write.form,\n   318\t        item.sourceVersion,\n   319\t      );\n   320\t      hits += Number(changed.changes);\n   321\t    }\n   322\t    const stale = writes.length > 0 && hits === 0;\n   323\t    if (!stale && onApplied !== undefined) {\n   324\t      onApplied({ db, onCommit: hooks.register });\n   325\t    }\n   326\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n   327\t    db.exec(\"COMMIT;\");\n   328\t    hooks.flush();\n   329\t    return stale ? \"stale_discarded\" : \"done\";\n   330\t  } catch (cause) {\n   331\t    db.exec(\"ROLLBACK;\");\n   332\t    throw cause;\n   333\t  }\n   334\t}\n   335\t\n   336\texport interface RetryPolicy {\n   337\t  budget: number;\n   338\t  backoffBaseMs: number;\n   339\t  backoffCapMs: number;\n   340\t}\n   341\t\n   342\texport type FailAttemptResult =\n   343\t  | { terminal: false; attempts: number; eligibleAt: string }\n   344\t  | { terminal: true; attempts: number };\n   345\t\n   346\t// Terminal failure: the form rows land `failed` (or `blocked` for source\n   347\t// damage) carrying the final reason plus attempts/last-error copied onto the\n   348\t// form's metadata, and the item row is deleted — one transaction (DD-1).\n   349\t// Form writes stay version-checked: if a mutation moved the source since this\n   350\t// item was queued, the stale failure must not stamp the rebuilt form.\n   351\texport function failTerminal(\n   352\t  db: DatabaseSync,\n   353\t  item: ClaimedWorkItem,\n   354\t  opts: { reason: string; formState: \"failed\" | \"blocked\"; attempts: number; now: string },\n   355\t): void {\n   356\t  db.exec(\"BEGIN IMMEDIATE;\");\n   357\t  try {\n   358\t    const update = db.prepare(\n   359\t      `UPDATE derived_form\n   360\t       SET state = ?, content = NULL, reason = ?, metadata = ?, gaps = NULL, derived_at = ?\n   361\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n   362\t    );\n   363\t    const metadata = JSON.stringify({ attempts: opts.attempts, lastError: opts.reason });\n   364\t    for (const target of item.forms) {\n   365\t      update.run(\n   366\t        opts.formState,\n   367\t        opts.reason,\n   368\t        metadata,\n   369\t        opts.now,\n   370\t        target.subjectKind,\n   371\t        target.subjectId,\n   372\t        target.form,\n   373\t        item.sourceVersion,\n   374\t      );\n   375\t    }\n   376\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n   377\t    db.exec(\"COMMIT;\");\n   378\t  } catch (cause) {\n   379\t    db.exec(\"ROLLBACK;\");\n   380\t    throw cause;\n   381\t  }\n   382\t}\n   383\t\n   384\t// A failed run counts itself. Under budget and retryable: the row goes back\n   385\t// to `queued` with attempts incremented and eligibility pushed out by backoff\n   386\t// (min(base × 2^attempts, cap)) — retry is not a status (DD-1). At budget, or\n   387\t// on a non-retryable failure, the item is terminal: form `failed` with the\n   388\t// final reason, row deleted (AC-1.9).\n   389\texport function failAttempt(\n   390\t  db: DatabaseSync,\n   391\t  item: ClaimedWorkItem,\n   392\t  opts: { reason: string; retryable: boolean; now: string; retry: RetryPolicy },\n   393\t): FailAttemptResult {\n   394\t  const attempts = item.attempts + 1;\n   395\t  if (opts.retryable && attempts < opts.retry.budget) {\n   396\t    const backoffMs = Math.min(\n   397\t      opts.retry.backoffBaseMs * 2 ** attempts,\n   398\t      opts.retry.backoffCapMs,\n   399\t    );\n   400\t    const eligibleAt = new Date(Date.parse(opts.now) + backoffMs).toISOString();\n   401\t    db.exec(\"BEGIN IMMEDIATE;\");\n   402\t    try {\n   403\t      db.prepare(\n   404\t        `UPDATE work_item\n   405\t         SET status = 'queued', attempts = ?, last_error = ?,\n   406\t             claimed_at = NULL, claim_expires_at = NULL, eligible_at = ?\n   407\t         WHERE work_item_id = ?`,\n   408\t      ).run(attempts, opts.reason, eligibleAt, item.workItemId);\n   409\t      db.exec(\"COMMIT;\");\n   410\t    } catch (cause) {\n   411\t      db.exec(\"ROLLBACK;\");\n   412\t      throw cause;\n   413\t    }\n   414\t    return { terminal: false, attempts, eligibleAt };\n   415\t  }\n   416\t  failTerminal(db, item, { reason: opts.reason, formState: \"failed\", attempts, now: opts.now });\n   417\t  return { terminal: true, attempts };\n   418\t}\n   419\t\n   420\t// Cascade tidy (tech design issue 1): delete still-queued items for the given\n   421\t// (kind, sourceRef) targets, returning the deleted ids for the mutation\n   422\t// result's `superseded` list. Runs inside the caller's ambient transaction —\n   423\t// the cascade owns the BEGIN/COMMIT — so no transaction is opened here.\n   424\t// Claimed items are deliberately left alone: the source-version check (DD-3)\n   425\t// discards their stale completions. Ships here as mechanics; its only caller\n   426\t// is Story 5's cascade.\n   427\texport function supersedeQueued(\n   428\t  db: DatabaseSync,\n   429\t  targets: ReadonlyArray<{ kind: WorkKind; sourceRef: WorkSourceRef }>,\n   430\t): string[] {\n   431\t  const ids: string[] = [];\n   432\t  const remove = db.prepare(\n   433\t    `DELETE FROM work_item WHERE status = 'queued' AND kind = ? AND source_ref = ?\n   434\t     RETURNING work_item_id`,\n   435\t  );\n   436\t  for (const target of targets) {\n   437\t    const rows = remove.all(target.kind, JSON.stringify(target.sourceRef)) as unknown as Array<{\n   438\t      work_item_id: string;\n   439\t    }>;\n   440\t    for (const row of rows) ids.push(row.work_item_id);\n   441\t  }\n   442\t  return ids;\n   443\t}\n   444\t\n   445\t// The requeue no-op rule's EXISTS check (AC-4.5): is there a live item —\n   446\t// queued or in flight — for this kind and source at this source version?\n   447\t// Runs inside the caller's requeue transaction so the check and the enqueue\n   448\t// commit together (anti-shim: a check-then-enqueue split across transactions\n   449\t// reintroduces the duplicate-work race). Version-scoped on purpose: a\n   450\t// claimed pre-mutation item at an older version is dying work whose\n   451\t// completion DD-3 will discard — it must not block the repair.\n   452\texport function hasLiveItem(\n   453\t  db: DatabaseSync,\n   454\t  kind: WorkKind,\n   455\t  sourceRef: WorkSourceRef,\n   456\t  sourceVersion: number,\n   457\t): boolean {\n   458\t  const row = db\n   459\t    .prepare(\n   460\t      `SELECT 1 FROM work_item\n   461\t       WHERE status IN ('queued', 'claimed') AND kind = ? AND source_ref = ?\n   462\t         AND COALESCE(json_extract(payload, '$.sourceVersion'), 1) = ?\n   463\t       LIMIT 1`,\n   464\t    )\n   465\t    .get(kind, JSON.stringify(sourceRef), sourceVersion);\n   466\t  return row !== undefined;\n   467\t}\n   468\t\n   469\t// Live items left in the queue — the drain report's `remaining` and the\n   470\t// repair report's join source (Story 4).\n   471\texport function countLiveItems(db: DatabaseSync): number {\n   472\t  const row = db\n   473\t    .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE status IN ('queued', 'claimed')`)\n   474\t    .get() as unknown as { n: number | bigint };\n   475\t  return Number(row.n);\n   476\t}\n   477\t\n   478\texport interface QueueDetailRow {\n   479\t  workItemId: string;\n   480\t  owner: WorkOwner;\n   481\t  kind: string;\n   482\t  sourceRef: WorkSourceRef;\n   483\t  status: \"queued\" | \"claimed\";\n   484\t  attempts: number;\n   485\t  lastError?: string;\n   486\t  eligibleAt?: string;\n   487\t  claimedAt?: string;\n   488\t  claimExpiresAt?: string;\n   489\t  queuedAt: string;\n   490\t  sourceVersion: number;\n   491\t}\n   492\t\n   493\t// Mechanical detail of every live row in queue order — what the repair\n   494\t// report joins against derived_form (Flow 4) and what tests read to assert\n   495\t// lease/backoff state without raw SQL at every call site.\n   496\texport function queueDetail(db: DatabaseSync): QueueDetailRow[] {\n   497\t  const rows = db\n   498\t    .prepare(\n   499\t      `SELECT work_item_id, owner, kind, source_ref, status, attempts, last_error,\n   500\t              eligible_at, claimed_at, claim_expires_at, queued_at, payload\n   501\t       FROM work_item ORDER BY rowid`,\n   502\t    )\n   503\t    .all() as unknown as Array<\n   504\t    RawClaimRow & {\n   505\t      status: string;\n   506\t      last_error: string | null;\n   507\t      eligible_at: string | null;\n   508\t      claimed_at: string | null;\n   509\t      claim_expires_at: string | null;\n   510\t    }\n   511\t  >;\n   512\t  return rows.map((row) => {\n   513\t    const item = toClaimedItem(row);\n   514\t    const detail: QueueDetailRow = {\n   515\t      workItemId: item.workItemId,\n   516\t      owner: item.owner,\n   517\t      kind: item.kind,\n   518\t      sourceRef: item.sourceRef,\n   519\t      status: row.status as \"queued\" | \"claimed\",\n   520\t      attempts: item.attempts,\n   521\t      queuedAt: item.queuedAt,\n   522\t      sourceVersion: item.sourceVersion,\n   523\t    };\n   524\t    if (row.last_error !== null) detail.lastError = row.last_error;\n   525\t    if (row.eligible_at !== null) detail.eligibleAt = row.eligible_at;\n   526\t    if (row.claimed_at !== null) detail.claimedAt = row.claimed_at;\n   527\t    if (row.claim_expires_at !== null) detail.claimExpiresAt = row.claim_expires_at;\n   528\t    return detail;\n   529\t  });\n   530\t}\n   531\t\n   532\t// Listing in queue order (insertion order within the walk); each owning\n   533\t// domain lists only its own items.\n   534\texport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n   535\t  const rows = db\n   536\t    .prepare(\n   537\t      `SELECT work_item_id, owner, kind, source_ref, queued_at\n   538\t       FROM work_item WHERE owner = ? ORDER BY rowid`,\n   539\t    )\n   540\t    .all(owner) as unknown as RawWorkItemRow[];\n   541\t  return rows.map((row) => ({\n   542\t    workItemId: row.work_item_id,\n   543\t    owner: row.owner as WorkOwner,\n   544\t    kind: row.kind as WorkKind,\n   545\t    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n   546\t    status: \"queued\",\n   547\t    queuedAt: row.queued_at,\n   548\t  }));\n   549\t}\n","exit_code":0,"status":"completed"}}

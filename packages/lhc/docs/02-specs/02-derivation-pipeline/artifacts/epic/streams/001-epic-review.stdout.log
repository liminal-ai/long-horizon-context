{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HwTHgaBKfc8z8xofzBnWbs","type":"tool_result","content":"1\t// Mechanical ToolOutcome stamping (AC-2.4): the outcome on a tool-activity\n2\t// summary is a pure function of the record — paired-result presence and its\n3\t// isError flag — and nothing else. The signature takes no provider text on\n4\t// purpose (anti-shim: the violation is unrepresentable); the handler stamps\n5\t// the returned value into derived_form.metadata, apart from provider prose.\n6\timport type { ToolOutcome } from \"../../../shared/derivation.js\";\n7\t\n8\texport function deriveToolOutcome(\n9\t  pairedResult: { isError: boolean } | undefined,\n10\t): ToolOutcome {\n11\t  if (pairedResult === undefined) return \"unknown\";\n12\t  return pairedResult.isError ? \"failed\" : \"succeeded\";\n13\t}\n14\t"}]},"parent_tool_use_id":null,"session_id":"1746f4bf-569a-4870-8bca-7c80d2cc25af","uuid":"9ca5ac9a-e9d8-4921-b67c-789c7b273232","timestamp":"2026-06-11T08:01:39.180Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/outcome.ts","content":"// Mechanical ToolOutcome stamping (AC-2.4): the outcome on a tool-activity\n// summary is a pure function of the record — paired-result presence and its\n// isError flag — and nothing else. The signature takes no provider text on\n// purpose (anti-shim: the violation is unrepresentable); the handler stamps\n// the returned value into derived_form.metadata, apart from provider prose.\nimport type { ToolOutcome } from \"../../../shared/derivation.js\";\n\nexport function deriveToolOutcome(\n  pairedResult: { isError: boolean } | undefined,\n): ToolOutcome {\n  if (pairedResult === undefined) return \"unknown\";\n  return pairedResult.isError ? \"failed\" : \"succeeded\";\n}\n","numLines":14,"startLine":1,"totalLines":14}}}

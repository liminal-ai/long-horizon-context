rue}); }\n}\nmain().catch(e=>{ console.error(e); process.exit(1); });\n'\"'\"","aggregated_output":"queuedAtReturn [ 'w-m1-prompt_smoothing-v1' ]\nqueuedImmediately [ 'w-m1-prompt_smoothing-v1' ]\n(node:58528) ExperimentalWarning: SQLite is an experimental feature and might change at any time\n(Use `node --trace-warnings ...` to show where the warning was created)\nqueuedAfterWait []\nformsAfterWait [\n  {\n    form: 'smoothed_prompt',\n    state: 'ready',\n    content: 'smoothed(89b5f018:hello)'\n  }\n]\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/context.ts | sed -n '34,66p'\"","aggregated_output":"    34\t// The scheduler poke seam (DD-5). The slot lives in shared/ so the queue\n    35\t// util can fire it without importing the scheduler module (which will import\n    36\t// domain handler tables from Story 1 on — a util→scheduler import would\n    37\t// cycle). The scheduler installs itself here; in manual mode, or before any\n    38\t// scheduler exists, firing is a no-op — onCommit still fires either way.\n    39\ttype SchedulerPoke = (threadId: string) => void;\n    40\tlet schedulerPoke: SchedulerPoke | null = null;\n    41\t\n    42\texport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n    43\t  schedulerPoke = poke;\n    44\t}\n    45\t\n    46\texport function fireSchedulerPoke(threadId: string): void {\n    47\t  schedulerPoke?.(threadId);\n    48\t}\n    49\t\n    50\t// The thread-touch seam (DD-10). openThreadDatabase announces every open of a\n    51\t// thread file here, before any caller transaction begins. The background\n    52\t// scheduler installs a listener to learn threadId→filePath and to run the\n    53\t// first-touch catch-up check (one indexed query on the already-open handle);\n    54\t// with no listener installed — manual mode, or no SDK constructed — firing is\n    55\t// free. Lives in shared/ for the same reason as the poke slot: the threads\n    56\t// domain may not import the scheduler module.\n    57\ttype ThreadTouch = (filePath: string, db: DatabaseSync) => void;\n    58\tlet threadTouch: ThreadTouch | null = null;\n    59\t\n    60\texport function setThreadTouch(touch: ThreadTouch | null): void {\n    61\t  threadTouch = touch;\n    62\t}\n    63\t\n    64\texport function fireThreadTouch(filePath: string, db: DatabaseSync): void {\n    65\t  threadTouch?.(filePath, db);\n    66\t}\n","exit_code":0,"status":"completed"}}

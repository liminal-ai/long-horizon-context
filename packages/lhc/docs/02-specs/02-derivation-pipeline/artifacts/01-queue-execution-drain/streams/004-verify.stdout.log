ummary\",\n      \"messages\",\n      \"tool_result_summary\",\n      JSON.stringify({ messageId: \"m3\" }),\n      recordedAt,\n    );\n    insertItem.run(\n      \"w-t1-turn_derivation\",\n      \"turns\",\n      \"turn_derivation\",\n      JSON.stringify({ turnId: \"t1\" }),\n      recordedAt,\n    );\n\n    db.exec(\"PRAGMA user_version = 4;\");\n    db.exec(\"COMMIT;\");\n  } finally {\n    db.close();\n  }\n}\n\nexport function schemaVersionOf(filePath: string): number {\n  const db = new DatabaseSync(filePath);\n  try {\n    const row = db.prepare(\"PRAGMA user_version\").get() as\n      | { user_version: number | bigint }\n      | undefined;\n    return Number(row?.user_version ?? 0);\n  } finally {\n    db.close();\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/zsh -lc \"pnpm exec tsx -e '\nimport { mkdtempSync, rmSync } from \\\"node:fs\\\";\nimport { tmpdir } from \\\"node:os\\\";\nimport path from \\\"node:path\\\";\nimport { createSdk, countLiveItems, queueDetail, messages } from \\\"./src/index.ts\\\";\nimport { createProviderDouble, legacyEpic01ThreadFile, registerTestWorkHandlers, openRaw, readDerivedForms } from \\\"./test/fixtures/index.ts\\\";\nasync function main() {\nconst dir = mkdtempSync(path.join(tmpdir(), \\\"lhc-legacy-fail-\\\"));\ntry {\n  const filePath = path.join(dir, \\\"legacy.sqlite\\\");\n  legacyEpic01ThreadFile(filePath, \\\"th_legacy\\\");\n  const migrated = await messages.listMessages({ filePath });\n  if (\"'!migrated.ok) throw new Error(migrated.error.reason);\n  const before = readDerivedForms(filePath).filter(f => f.subjectId === \"m1\" && f.form === \"smoothed_prompt\")[0];\n  const double = createProviderDouble();\n  double.failKind(\"prompt_smoothing\", 99, { retryable: true, reason: \"legacy exhaustion\" });\n  const sdk = createSdk({ provider: double, mode: \"manual\", retry: { budget: 1, backoffBaseMs: 0, backoffCapMs: 0 }, lease: { durationMs: 1000 } });\n  registerTestWorkHandlers(sdk, double);\n  const report = await sdk.work.drain({ filePath }, { maxItems: 1 });\n  if (!report.ok) throw new Error(report.error.reason);\n  const after = readDerivedForms(filePath).filter(f => f.subjectId === \"m1\" && f.form === \"smoothed_prompt\")[0];\n  const db = openRaw(filePath);\n  try { console.log(JSON.stringify({ before, ran: report.value.ran, after, live: countLiveItems(db), detail: queueDetail(db) })); } finally { db.close(); }\n} finally { rmSync(dir, { recursive: true, force: true }); }\n}\nmain();\n'\"'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

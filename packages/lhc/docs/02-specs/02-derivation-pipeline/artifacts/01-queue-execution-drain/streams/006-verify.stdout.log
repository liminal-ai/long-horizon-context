{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/work-execution-legacy.test.ts | sed -n '41,124p'\"","aggregated_output":"    41\tfunction liveCount(filePath: string): number {\n    42\t  const db = openRaw(filePath);\n    43\t  try {\n    44\t    return countLiveItems(db);\n    45\t  } finally {\n    46\t    db.close();\n    47\t  }\n    48\t}\n    49\t\n    50\tdescribe(\"01F-001: terminal failure on pre-v5 queued rows lands the backfilled form failed, never stranded pending\", () => {\n    51\t  it(\"retry exhaustion on a legacy row marks its backfilled form failed with final reason and attempts, row deleted; the rest of the legacy queue still runs\", async () => {\n    52\t    const filePath = store.threadPath();\n    53\t    legacyEpic01ThreadFile(filePath, \"th_legacy_terminal\");\n    54\t    const double = createProviderDouble();\n    55\t    const sdk = manualSdk(double);\n    56\t\n    57\t    double.failKind(\"prompt_smoothing\", 99, {\n    58\t      retryable: true,\n    59\t      reason: \"scripted legacy exhaustion (smoothPrompt)\",\n    60\t    });\n    61\t    const drained = await sdk.work.drain({ filePath });\n    62\t    expect(drained.ok).toBe(true);\n    63\t    if (!drained.ok) return;\n    64\t\n    65\t    // The legacy queue ran whole, unversioned ids and all: the smoothing\n    66\t    // item exhausted its budget, the other two completed.\n    67\t    expect(drained.value.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n    68\t      [\"w-m1-prompt_smoothing\", \"failed_terminal\"],\n    69\t      [\"w-m3-tool_result_summary\", \"done\"],\n    70\t      [\"w-t1-turn_derivation\", \"done\"],\n    71\t    ]);\n    72\t    expect(drained.value.ran[0]?.attempts).toBe(3);\n    73\t    expect(drained.value.ran[0]?.reason).toBe(\"scripted legacy exhaustion (smoothPrompt)\");\n    74\t\n    75\t    // DD-1 for upgraded rows: the work rows are gone AND the backfilled\n    76\t    // pending form was found by the terminal write — failed with the final\n    77\t    // reason and attempts copied, not stranded pending.\n    78\t    expect(liveCount(filePath)).toBe(0);\n    79\t    const forms = readDerivedForms(filePath);\n    80\t    const failed = forms.find((form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\");\n    81\t    expect(failed?.state).toBe(\"failed\");\n    82\t    expect(failed?.reason).toBe(\"scripted legacy exhaustion (smoothPrompt)\");\n    83\t    expect(failed?.metadata?.attempts).toBe(3);\n    84\t    expect(failed?.sourceVersion).toBe(1);\n    85\t    // No form anywhere is left pending after the drain.\n    86\t    expect(forms.map((form) => `${form.subjectId}/${form.form}/${form.state}`).sort()).toEqual([\n    87\t      \"m1/smoothed_prompt/failed\",\n    88\t      \"m3/tool_result_summary/ready\",\n    89\t      \"t1/lower_band_projection/ready\",\n    90\t      \"t1/turn_rendering/ready\",\n    91\t    ]);\n    92\t  });\n    93\t\n    94\t  it(\"a non-retryable failure on a legacy two-form item (turn_derivation) marks both backfilled forms failed\", async () => {\n    95\t    const filePath = store.threadPath();\n    96\t    legacyEpic01ThreadFile(filePath, \"th_legacy_blocked\");\n    97\t    const double = createProviderDouble();\n    98\t    const sdk = manualSdk(double);\n    99\t\n   100\t    // Scripted on the handler's first provider operation (the double keys by\n   101\t    // provider op / form-kind aliases, not the work kind).\n   102\t    double.failKind(\"turn_rendering\", 1, {\n   103\t      retryable: false,\n   104\t      reason: \"scripted legacy refusal (composeTurnRendering)\",\n   105\t    });\n   106\t    const drained = await sdk.work.drain({ filePath });\n   107\t    expect(drained.ok).toBe(true);\n   108\t    if (!drained.ok) return;\n   109\t    expect(drained.value.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n   110\t      [\"w-m1-prompt_smoothing\", \"done\"],\n   111\t      [\"w-m3-tool_result_summary\", \"done\"],\n   112\t      [\"w-t1-turn_derivation\", \"failed_terminal\"],\n   113\t    ]);\n   114\t\n   115\t    expect(liveCount(filePath)).toBe(0);\n   116\t    const forms = readDerivedForms(filePath);\n   117\t    const turnForms = forms.filter((form) => form.subjectId === \"t1\");\n   118\t    expect(turnForms.map((form) => form.state)).toEqual([\"failed\", \"failed\"]);\n   119\t    for (const form of turnForms) {\n   120\t      expect(form.reason).toBe(\"scripted legacy refusal (composeTurnRendering)\");\n   121\t      expect(form.metadata?.attempts).toBe(1);\n   122\t    }\n   123\t  });\n   124\t});\n","exit_code":0,"status":"completed"}}

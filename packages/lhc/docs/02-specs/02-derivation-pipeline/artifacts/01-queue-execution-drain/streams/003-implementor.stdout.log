{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q5oYqwJr1Uzx6MwscGNQWM","type":"tool_result","content":"1\t// CLI process-boundary suite for work queueing: the production-path proof\n2\t// for `lhc turns list-queued-work` and the queuedWork half of the batch\n3\t// result — a real conversation goes in through real stdin and the queued\n4\t// work items come back as JSON through the spawned binary. Runs under\n5\t// verify-all only.\n6\timport { spawnSync } from \"node:child_process\";\n7\timport { mkdtempSync, rmSync } from \"node:fs\";\n8\timport { tmpdir } from \"node:os\";\n9\timport path from \"node:path\";\n10\timport { fileURLToPath } from \"node:url\";\n11\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n12\timport type { BatchResult, WorkItemRecord } from \"../src/index.js\";\n13\timport { validEvent } from \"./fixtures/index.js\";\n14\t\n15\tconst cliPath = path.resolve(\n16\t  path.dirname(fileURLToPath(import.meta.url)),\n17\t  \"../dist/cli.js\",\n18\t);\n19\t\n20\tfunction runBinary(\n21\t  args: string[],\n22\t  input?: string,\n23\t): { status: number | null; stdout: string; stderr: string } {\n24\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n25\t    encoding: \"utf8\",\n26\t    ...(input === undefined ? {} : { input }),\n27\t  });\n28\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n29\t}\n30\t\n31\tlet dir: string;\n32\tlet threadPath: string;\n33\tbeforeEach(() => {\n34\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-work-\"));\n35\t  threadPath = path.join(dir, \"thread.sqlite\");\n36\t  const created = runBinary([\n37\t    \"threads\",\n38\t    \"new-thread\",\n39\t    \"--file-path\",\n40\t    threadPath,\n41\t    \"--registry\",\n42\t    path.join(dir, \"registry.sqlite\"),\n43\t  ]);\n44\t  if (created.status !== 0) throw new Error(`fixture new-thread failed: ${created.stdout}`);\n45\t});\n46\tafterEach(() => {\n47\t  rmSync(dir, { recursive: true, force: true });\n48\t});\n49\t\n50\tdescribe(\"Story 5 (process boundary): queued work through the spawned binary\", () => {\n51\t  it(\"a closed turn's work item reads back via turns list-queued-work\", () => {\n52\t    const batch = [validEvent(\"user_prompt\"), validEvent(\"assistant_text\"), validEvent(\"turn_end\")];\n53\t    const recorded = runBinary(\n54\t      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n55\t      JSON.stringify(batch),\n56\t    );\n57\t    expect(recorded.status).toBe(0);\n58\t    const batchResult = JSON.parse(recorded.stdout) as { ok: boolean; value: BatchResult };\n59\t    expect(batchResult.ok).toBe(true);\n60\t    expect(batchResult.value.queuedWork).toContainEqual({\n61\t      workItemId: \"w-t1-turn_derivation-v1\",\n62\t      owner: \"turns\",\n63\t      kind: \"turn_derivation\",\n64\t      sourceRef: { turnId: \"t1\" },\n65\t    });\n66\t\n67\t    const listed = runBinary([\"turns\", \"list-queued-work\", \"--file-path\", threadPath]);\n68\t    expect(listed.status).toBe(0);\n69\t    const parsed = JSON.parse(listed.stdout) as { ok: boolean; value: WorkItemRecord[] };\n70\t    expect(parsed.ok).toBe(true);\n71\t    expect(parsed.value).toHaveLength(1);\n72\t    expect(parsed.value[0]).toMatchObject({\n73\t      workItemId: \"w-t1-turn_derivation-v1\",\n74\t      owner: \"turns\",\n75\t      kind: \"turn_derivation\",\n76\t      sourceRef: { turnId: \"t1\" },\n77\t      status: \"queued\",\n78\t    });\n79\t  });\n80\t});\n81\t"}]},"parent_tool_use_id":null,"session_id":"b93e566a-c98e-4b05-8100-3f1a70ca0688","uuid":"93e47036-0f7f-4fde-92c3-1c0b1bf4a747","timestamp":"2026-06-11T03:38:00.510Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/cli-process-work-queue.test.ts","content":"// CLI process-boundary suite for work queueing: the production-path proof\n// for `lhc turns list-queued-work` and the queuedWork half of the batch\n// result — a real conversation goes in through real stdin and the queued\n// work items come back as JSON through the spawned binary. Runs under\n// verify-all only.\nimport { spawnSync } from \"node:child_process\";\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport type { BatchResult, WorkItemRecord } from \"../src/index.js\";\nimport { validEvent } from \"./fixtures/index.js\";\n\nconst cliPath = path.resolve(\n  path.dirname(fileURLToPath(import.meta.url)),\n  \"../dist/cli.js\",\n);\n\nfunction runBinary(\n  args: string[],\n  input?: string,\n): { status: number | null; stdout: string; stderr: string } {\n  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    encoding: \"utf8\",\n    ...(input === undefined ? {} : { input }),\n  });\n  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n}\n\nlet dir: string;\nlet threadPath: string;\nbeforeEach(() => {\n  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-work-\"));\n  threadPath = path.join(dir, \"thread.sqlite\");\n  const created = runBinary([\n    \"threads\",\n    \"new-thread\",\n    \"--file-path\",\n    threadPath,\n    \"--registry\",\n    path.join(dir, \"registry.sqlite\"),\n  ]);\n  if (created.status !== 0) throw new Error(`fixture new-thread failed: ${created.stdout}`);\n});\nafterEach(() => {\n  rmSync(dir, { recursive: true, force: true });\n});\n\ndescribe(\"Story 5 (process boundary): queued work through the spawned binary\", () => {\n  it(\"a closed turn's work item reads back via turns list-queued-work\", () => {\n    const batch = [validEvent(\"user_prompt\"), validEvent(\"assistant_text\"), validEvent(\"turn_end\")];\n    const recorded = runBinary(\n      [\"intake-stream\", \"message-events\", \"--file-path\", threadPath],\n      JSON.stringify(batch),\n    );\n    expect(recorded.status).toBe(0);\n    const batchResult = JSON.parse(recorded.stdout) as { ok: boolean; value: BatchResult };\n    expect(batchResult.ok).toBe(true);\n    expect(batchResult.value.queuedWork).toContainEqual({\n      workItemId: \"w-t1-turn_derivation-v1\",\n      owner: \"turns\",\n      kind: \"turn_derivation\",\n      sourceRef: { turnId: \"t1\" },\n    });\n\n    const listed = runBinary([\"turns\", \"list-queued-work\", \"--file-path\", threadPath]);\n    expect(listed.status).toBe(0);\n    const parsed = JSON.parse(listed.stdout) as { ok: boolean; value: WorkItemRecord[] };\n    expect(parsed.ok).toBe(true);\n    expect(parsed.value).toHaveLength(1);\n    expect(parsed.value[0]).toMatchObject({\n      workItemId: \"w-t1-turn_derivation-v1\",\n      owner: \"turns\",\n      kind: \"turn_derivation\",\n      sourceRef: { turnId: \"t1\" },\n      status: \"queued\",\n    });\n  });\n});\n","numLines":81,"startLine":1,"totalLines":81}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y9owXpizric3sS5mcb1xUi","type":"tool_result","content":"    const clean = createProviderDouble();\n    const capturedScripted = scripted.captureInputs();\n    scripted.failNext(1);\n    const cleanResult = await clean.smoothPrompt({ text: \"untouched\" });\n    expect(cleanResult.ok).toBe(true);\n    expect(capturedScripted).toHaveLength(0);\n    const capturedClean = clean.captureInputs();\n    await clean.projectLowerBand({ rendering: \"r\" });\n    expect(capturedClean).toEqual([{ op: \"projectLowerBand\", input: { rendering: \"r\" } }]);\n    expect(capturedScripted).toHaveLength(0);\n    const scriptedResult = await scripted.smoothPrompt({ text: \"untouched\" });\n    expect(scriptedResult.ok).toBe(false);\n    expect(capturedScripted).toEqual([{ op: \"smoothPrompt\", input: { text: \"untouched\" } }]);\n  });\n});\n\ndescribe(\"FC-0.1 (production seam): createSdk assembles with the double injected where production adapters go\", () => {\n  it(\"resolves config defaults centrally and carries the injected provider and mode\", () => {\n    const double = createProviderDouble();\n    const sdk = createSdk({ provider: double, mode: \"manual\" });\n    expect(sdk.config.provider).toBe(double);\n    expect(sdk.config.mode).toBe(\"manual\");\n    expect(sdk.config.retry).toEqual({ budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 });\n    expect(sdk.config.lease).toEqual({ durationMs: 120000 });\n    expect(sdk.config.chunkPolicy).toEqual({\n      targetProjectedTokens: 2200,\n      maxProjectedTokens: 4400,\n    });\n    expect(sdk.scheduler.mode).toBe(\"manual\");\n    // The Epic 01 surfaces ride the assembled SDK.\n    expect(sdk.threads.newThread).toBeTypeOf(\"function\");\n    expect(sdk.intakeStream.messageEvents).toBeTypeOf(\"function\");\n  });\n\n  it(\"background mode is a validated construction option (behavior lands in Story 1)\", () => {\n    const sdk = createSdk({ provider: createProviderDouble(), mode: \"background\" });\n    expect(sdk.scheduler.mode).toBe(\"background\");\n    expect(() => sdk.scheduler.poke(\"th_x\")).not.toThrow();\n  });\n\n  it(\"rejects malformed config at construction: bad mode, incomplete provider, bad policy values\", () => {\n    const double = createProviderDouble();\n    expect(() =>\n      createSdk({ provider: double, mode: \"later\" as unknown as \"manual\" }),\n    ).toThrow(/mode/);\n    const incomplete = { smoothPrompt: double.smoothPrompt.bind(double) };\n    expect(() =>\n      createSdk({ provider: incomplete as unknown as DerivationProvider, mode: \"manual\" }),\n    ).toThrow(/missing operation/);\n    expect(() =>\n      createSdk({\n        provider: double,\n        mode: \"manual\",\n        chunkPolicy: { targetProjectedTokens: 4400, maxProjectedTokens: 2200 },\n      }),\n    ).toThrow(/chunkPolicy/);\n    expect(() =>\n      createSdk({\n        provider: double,\n        mode: \"manual\",\n        retry: { budget: 0, backoffBaseMs: 0, backoffCapMs: 0 },\n      }),\n    ).toThrow(/retry.budget/);\n  });\n});\n\ndescribe(\"FC-0.3 / FC-0.6: derived-form vocabulary and thread builders, verified by read-back\", () => {\n  let store: TempStore;\n  beforeEach(() => {\n    store = tempStore();\n  });\n2:import { describe, expect, it } from \"vitest\";\n32:describe(\"FC-0.4: fixture builders\", () => {\n33:  it(\"validEvent produces a golden-shaped event for every kind\", () => {\n49:  it(\"validEvent applies overrides without changing the kind\", () => {\n59:  it(\"building an invalid kind/payload pairing requires an explicit cast\", () => {\n67:  it(\"eventBatch yields unique idempotency keys in order\", () => {\n74:  it(\"conversationTurn is one complete turn\", () => {\n84:  it(\"tempStore creates an isolated directory and cleans it up\", () => {\n95:  it(\"openRaw opens a real sqlite handle for below-SDK assertions\", () => {\n167:describe(\"FC-0.1 / FC-0.2: deterministic provider double\", () => {\n168:  it(\"FC-0.1: implements all seven operations with marked, input-derived output\", async () => {\n185:  it(\"FC-0.2: identical input yields identical output across double instances; operations are distinguishable\", async () => {\n194:  it(\"FC-0.2: failNext drives fail-N-then-succeed with the scripted retryability\", async () => {\n209:  it(\"FC-0.2: failKind scripts terminal failure per operation, by kind alias, without touching other kinds\", async () => {\n218:  it(\"FC-0.2: delayKind injects latency on the scripted operation\", async () => {\n228:  it(\"scripting and capture state are per-instance — nothing leaks across doubles\", async () => {\n246:describe(\"FC-0.1 (production seam): createSdk assembles with the double injected where production adapters go\", () => {\n247:  it(\"resolves config defaults centrally and carries the injected provider and mode\", () => {\n264:  it(\"background mode is a validated construction option (behavior lands in Story 1)\", () => {\n270:  it(\"rejects malformed config at construction: bad mode, incomplete provider, bad policy values\", () => {\n296:describe(\"FC-0.3 / FC-0.6: derived-form vocabulary and thread builders, verified by read-back\", () => {\n305:  it(\"threadWithClosedTurns: n closed turns read back closed with their members\", async () => {\n318:  it(\"threadWithToolRun: call+result pair recorded; error and missing-result variants hold their shapes\", async () => {\n343:  it(\"FC-0.6: the multi-state thread reads back every claimed state — all four in one file\", async () => {\n373:  it(\"FC-0.3: tool-activity outcome lives in machine-readable metadata, never inside content\", async () => {\n385:  it(\"FC-0.6: the damaged-source thread reads back the corruption it claims (Epic 01 definition)\", async () => {\n410:  it(\"FC-0.6: twin SDK/CLI threads read back identical records through every surface\", async () => {","is_error":false}]},"parent_tool_use_id":null,"session_id":"b93e566a-c98e-4b05-8100-
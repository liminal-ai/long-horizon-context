{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019BtpqG3HUuWdriHfU7RgWd","type":"tool_result","content":"1\timport { randomBytes } from \"node:crypto\";\n2\timport { rmSync } from \"node:fs\";\n3\timport { DatabaseSync } from \"node:sqlite\";\n4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\n5\timport {\n6\t  getSchemaVersion,\n7\t  MIGRATION_V5_STATEMENTS,\n8\t  openDatabase,\n9\t  runMigrations,\n10\t  type Migration,\n11\t} from \"../../../shared/storage.js\";\n12\timport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n13\t\n14\t// The one random id: its uniqueness scope is global across files and\n15\t// registries (design decision 7).\n16\texport function generateThreadId(): string {\n17\t  return `th_${randomBytes(8).toString(\"hex\")}`;\n18\t}\n19\t\n20\t// The thread-file schema as a versioned history, never rewritten in place:\n21\t// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n22\t// each later story appends a version. Existing files upgrade lazily through\n23\t// openThreadDatabase, so a file recorded under an earlier story is always\n24\t// usable by a later one (F-03-001).\n25\t//\n26\t// Creation-time metadata values are interpolated through buildThreadMigrations\n27\t// for new files only; existing files already hold their metadata row and the\n28\t// upgrade path never touches it.\n29\tfunction buildThreadMigrations(\n30\t  metadata?: { threadId: string; createdAt: string },\n31\t): Migration[] {\n32\t  const metadataInsert =\n33\t    metadata === undefined\n34\t      ? []\n35\t      : [\n36\t          // Interpolated values are all generated by us (hex id, ISO\n37\t          // timestamp, estimator constant) — never caller input.\n38\t          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n39\t           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n40\t        ];\n41\t  return [\n42\t    {\n43\t      version: 1,\n44\t      statements: [\n45\t        `CREATE TABLE thread_metadata (\n46\t          id INTEGER PRIMARY KEY CHECK (id = 1),\n47\t          thread_id TEXT NOT NULL,\n48\t          created_at TEXT NOT NULL,\n49\t          token_estimator TEXT NOT NULL\n50\t        );`,\n51\t        ...metadataInsert,\n52\t        `CREATE TABLE event (\n53\t          event_order INTEGER PRIMARY KEY,\n54\t          event_kind TEXT NOT NULL,\n55\t          idempotency_key TEXT NOT NULL UNIQUE,\n56\t          actor TEXT NOT NULL,\n57\t          harness TEXT NOT NULL,\n58\t          payload TEXT NOT NULL,\n59\t          recorded_at TEXT NOT NULL\n60\t        );`,\n61\t      ],\n62\t    },\n63\t    {\n64\t      version: 2, // Story 3: message projection\n65\t      statements: [\n66\t        `CREATE TABLE message (\n67\t          message_id TEXT PRIMARY KEY,\n68\t          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n69\t          kind TEXT NOT NULL,\n70\t          token_estimate INTEGER NOT NULL,\n71\t          actor TEXT NOT NULL,\n72\t          harness TEXT NOT NULL,\n73\t          turn_id TEXT\n74\t        );`,\n75\t        `CREATE TABLE message_block (\n76\t          message_id TEXT NOT NULL REFERENCES message(message_id),\n77\t          block_index INTEGER NOT NULL,\n78\t          block_type TEXT NOT NULL,\n79\t          content TEXT NOT NULL,\n80\t          PRIMARY KEY (message_id, block_index)\n81\t        );`,\n82\t      ],\n83\t    },\n84\t    {\n85\t      version: 3, // Story 4: turn state machine\n86\t      statements: [\n87\t        `CREATE TABLE turns (\n88\t          turn_id TEXT PRIMARY KEY,\n89\t          turn_order INTEGER NOT NULL UNIQUE,\n90\t          status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n91\t          opened_at_event_order INTEGER NOT NULL,\n92\t          closed_at_event_order INTEGER\n93\t        );`,\n94\t      ],\n95\t    },\n96\t    {\n97\t      version: 4, // Story 5: derivation work queueing\n98\t      statements: [\n99\t        // Work items live in the thread file and commit with the batch —\n100\t        // not a separate database, not a separate transaction. status is\n101\t        // unconstrained TEXT: this epic only ever writes 'queued'; the\n102\t        // claim/lease statuses are Epic 02's to add.\n103\t        `CREATE TABLE work_item (\n104\t          work_item_id TEXT PRIMARY KEY,\n105\t          owner TEXT NOT NULL,\n106\t          kind TEXT NOT NULL,\n107\t          source_ref TEXT NOT NULL,\n108\t          status TEXT NOT NULL,\n109\t          queued_at TEXT NOT NULL\n110\t        );`,\n111\t      ],\n112\t    },\n113\t    {\n114\t      version: 5, // Epic 02 Story 0: queue mechanical fields, derived_form,\n115\t      // chunk tables, deleted_at stamps, F-02 pending-row backfill — the\n116\t      // epic's single migration (tech design §Storage), statements owned by\n117\t      // shared/storage.ts.\n118\t      statements: MIGRATION_V5_STATEMENTS,\n119\t    },\n120\t  ];\n121\t}\n122\t\n123\tfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n124\t  return {\n125\t    ok: false,\n126\t    error: {\n127\t      errorClass: \"caller_error\",\n128\t      code: \"thread_not_found\",\n129\t      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n130\t    },\n131\t  };\n132\t}\n133\t\n134\tfunction errorDetail(cause: unknown): string {\n135\t  return cause instanceof Error ? cause.message : String(cause);\n136\t}\n137\t\n138\t// Identity check before any migration runs, on a read-only handle so an\n139\t// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n140\t// file always carries schema version >= 1 and the thread_metadata singleton\n141\t// row that creation wrote transactionally. Anything else — an empty\n142\t// database, an unrelated SQLite file, a non-database file — is rejected as a\n143\t// caller error, never adopted.\n144\tfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n145\t  let db: DatabaseSync | undefined;\n146\t  try {\n147\t    db = new DatabaseSync(filePath, { readOnly: true });\n148\t    if (getSchemaVersion(db) < 1) {\n149\t      return notAThreadFile(filePath, \"no lhc schema version\");\n150\t    }\n151\t    const table = db\n152\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n153\t      .get();\n154\t    if (table === undefined) {\n155\t      return notAThreadFile(filePath, \"no thread_metadata table\");\n156\t    }\n157\t    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n158\t    if (row === undefined) {\n159\t      return notAThreadFile(filePath, \"no thread metadata row\");\n160\t    }\n161\t    return { ok: true };\n162\t  } catch (cause) {\n163\t    const detail = errorDetail(cause);\n164\t    // SQLite refusing the file as a database is an identity failure, not an\n165\t    // environment failure; everything else stays a system error.\n166\t    if (detail.includes(\"not a database\")) {\n167\t      return notAThreadFile(filePath, detail);\n168\t    }\n169\t    return storageFailure(`could not inspect thread file: ${detail}`);\n170\t  } finally {\n171\t    db?.close();\n172\t  }\n173\t}\n174\t\n175\t// Opens a thread file and brings its schema to the current version before\n176\t// returning the handle. Every SDK operation on an existing thread file goes\n177\t// through here, so a pre-Story-3 file gains the message tables on its first\n178\t// open by newer code — but only after the file proves it is a thread file;\n179\t// migration never creates lhc schema on an arbitrary existing file. Each\n180\t// migration runs in its own transaction (storage helper), completing before\n181\t// any caller transaction begins.\n182\texport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n183\t  const valid = validateThreadFile(filePath);\n184\t  if (!valid.ok) return valid;\n185\t  let db: DatabaseSync;\n186\t  try {\n187\t    db = openDatabase(filePath);\n188\t  } catch (cause) {\n189\t    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n190\t  }\n191\t  try {\n192\t    runMigrations(db, buildThreadMigrations());\n193\t  } catch (cause) {\n194\t    db.close();\n195\t    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n196\t  }\n197\t  return { ok: true, value: db };\n198\t}\n199\t\n200\t// Schema v1 plus the metadata row land in one migration transaction, so the\n201\t// file either has its full schema and metadata row or creation fails whole.\n202\texport function createThreadFile(\n203\t  filePath: string,\n204\t  threadId: string,\n205\t  createdAt: string,\n206\t): void {\n207\t  const db = openDatabase(filePath);\n208\t  try {\n209\t    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n210\t  } finally {\n211\t    db.close();\n212\t  }\n213\t}\n214\t\n215\t// Compensation: removes the thread file and its WAL companions. Used when the\n216\t// registry insert fails after file creation (no registry row without its\n217\t// file) and when file creation itself fails partway.\n218\texport function deleteThreadFile(filePath: string): void {\n219\t  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n220\t    rmSync(`${filePath}${suffix}`, { force: true });\n221\t  }\n222\t}\n223\t"}]},"parent_tool_use_id":null,"session_id":"b93e566a-c98e-4b05-8100-3f1a70ca0688","uuid":"65602f25-74ba-4b03-bc8d-03032195054a","timestamp":"2026-06-11T03:37:35.434Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/threads/internal/create.ts","content":"import { randomBytes } from \"node:crypto\";\nimport { rmSync } from \"node:fs\";\nimport { DatabaseSync } from \"node:sqlite\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../../shared/errors.js\";\nimport {\n  getSchemaVersion,\n  MIGRATION_V5_STATEMENTS,\n  openDatabase,\n  runMigrations,\n  type Migration,\n} from \"../../../shared/storage.js\";\nimport { TOKEN_ESTIMATOR_ID } from \"../../../tech-utils/token-counting/index.js\";\n\n// The one random id: its uniqueness scope is global across files and\n// registries (design decision 7).\nexport function generateThreadId(): string {\n  return `th_${randomBytes(8).toString(\"hex\")}`;\n}\n\n// The thread-file schema as a versioned history, never rewritten in place:\n// v1 is the Story 2 schema exactly as accepted (thread_metadata + event), and\n// each later story appends a version. Existing files upgrade lazily through\n// openThreadDatabase, so a file recorded under an earlier story is always\n// usable by a later one (F-03-001).\n//\n// Creation-time metadata values are interpolated through buildThreadMigrations\n// for new files only; existing files already hold their metadata row and the\n// upgrade path never touches it.\nfunction buildThreadMigrations(\n  metadata?: { threadId: string; createdAt: string },\n): Migration[] {\n  const metadataInsert =\n    metadata === undefined\n      ? []\n      : [\n          // Interpolated values are all generated by us (hex id, ISO\n          // timestamp, estimator constant) — never caller input.\n          `INSERT INTO thread_metadata (id, thread_id, created_at, token_estimator)\n           VALUES (1, '${metadata.threadId}', '${metadata.createdAt}', '${TOKEN_ESTIMATOR_ID}');`,\n        ];\n  return [\n    {\n      version: 1,\n      statements: [\n        `CREATE TABLE thread_metadata (\n          id INTEGER PRIMARY KEY CHECK (id = 1),\n          thread_id TEXT NOT NULL,\n          created_at TEXT NOT NULL,\n          token_estimator TEXT NOT NULL\n        );`,\n        ...metadataInsert,\n        `CREATE TABLE event (\n          event_order INTEGER PRIMARY KEY,\n          event_kind TEXT NOT NULL,\n          idempotency_key TEXT NOT NULL UNIQUE,\n          actor TEXT NOT NULL,\n          harness TEXT NOT NULL,\n          payload TEXT NOT NULL,\n          recorded_at TEXT NOT NULL\n        );`,\n      ],\n    },\n    {\n      version: 2, // Story 3: message projection\n      statements: [\n        `CREATE TABLE message (\n          message_id TEXT PRIMARY KEY,\n          source_event_order INTEGER NOT NULL UNIQUE REFERENCES event(event_order),\n          kind TEXT NOT NULL,\n          token_estimate INTEGER NOT NULL,\n          actor TEXT NOT NULL,\n          harness TEXT NOT NULL,\n          turn_id TEXT\n        );`,\n        `CREATE TABLE message_block (\n          message_id TEXT NOT NULL REFERENCES message(message_id),\n          block_index INTEGER NOT NULL,\n          block_type TEXT NOT NULL,\n          content TEXT NOT NULL,\n          PRIMARY KEY (message_id, block_index)\n        );`,\n      ],\n    },\n    {\n      version: 3, // Story 4: turn state machine\n      statements: [\n        `CREATE TABLE turns (\n          turn_id TEXT PRIMARY KEY,\n          turn_order INTEGER NOT NULL UNIQUE,\n          status TEXT NOT NULL CHECK (status IN ('open', 'closed')),\n          opened_at_event_order INTEGER NOT NULL,\n          closed_at_event_order INTEGER\n        );`,\n      ],\n    },\n    {\n      version: 4, // Story 5: derivation work queueing\n      statements: [\n        // Work items live in the thread file and commit with the batch —\n        // not a separate database, not a separate transaction. status is\n        // unconstrained TEXT: this epic only ever writes 'queued'; the\n        // claim/lease statuses are Epic 02's to add.\n        `CREATE TABLE work_item (\n          work_item_id TEXT PRIMARY KEY,\n          owner TEXT NOT NULL,\n          kind TEXT NOT NULL,\n          source_ref TEXT NOT NULL,\n          status TEXT NOT NULL,\n          queued_at TEXT NOT NULL\n        );`,\n      ],\n    },\n    {\n      version: 5, // Epic 02 Story 0: queue mechanical fields, derived_form,\n      // chunk tables, deleted_at stamps, F-02 pending-row backfill — the\n      // epic's single migration (tech design §Storage), statements owned by\n      // shared/storage.ts.\n      statements: MIGRATION_V5_STATEMENTS,\n    },\n  ];\n}\n\nfunction notAThreadFile(filePath: string, detail: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n    },\n  };\n}\n\nfunction errorDetail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n// Identity check before any migration runs, on a read-only handle so an\n// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n// file always carries schema version >= 1 and the thread_metadata singleton\n// row that creation wrote transactionally. Anything else — an empty\n// database, an unrelated SQLite file, a non-database file — is rejected as a\n// caller error, never adopted.\nfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n  let db: DatabaseSync | undefined;\n  try {\n    db = new DatabaseSync(filePath, { readOnly: true });\n    if (getSchemaVersion(db) < 1) {\n      return notAThreadFile(filePath, \"no lhc schema version\");\n    }\n    const table = db\n      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n      .get();\n    if (table === undefined) {\n      return notAThreadFile(filePath, \"no thread_metadata table\");\n    }\n    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n    if (row === undefined) {\n      return notAThreadFile(filePath, \"no thread metadata row\");\n    }\n    return { ok: true };\n  } catch (cause) {\n    const detail = errorDetail(cause);\n    // SQLite refusing the file as a database is an identity failure, not an\n    // environment failure; everything else stays a system error.\n    if (detail.includes(\"not a database\")) {\n      return notAThreadFile(filePath, detail);\n    }\n    return storageFailure(`could not inspect thread file: ${detail}`);\n  } finally {\n    db?.close();\n  }\n}\n\n// Opens a thread file and brings its schema to the current version before\n// returning the handle. Every SDK operation on an existing thread file goes\n// through here, so a pre-Story-3 file gains the message tables on its first\n// open by newer code — but only after the file proves it is a thread file;\n// migration never creates lhc schema on an arbitrary existing file. Each\n// migration runs in its own transaction (storage helper), completing before\n// any caller transaction begins.\nexport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n  const valid = validateThreadFile(filePath);\n  if (!valid.ok) return valid;\n  let db: DatabaseSync;\n  try {\n    db = openDatabase(filePath);\n  } catch (cause) {\n    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n  }\n  try {\n    runMigrations(db, buildThreadMigrations());\n  } catch (cause) {\n    db.close();\n    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n  }\n  return { ok: true, value: db };\n}\n\n// Schema v1 plus the metadata row land in one migration transaction, so the\n// file either has its full schema and metadata row or creation fails whole.\nexport function createThreadFile(\n  filePath: string,\n  threadId: string,\n  createdAt: string,\n): void {\n  const db = openDatabase(filePath);\n  try {\n    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n  } finally {\n    db.close();\n  }\n}\n\n// Compensation: removes the thread file and its WAL companions. Used when the\n// registry insert fails after file creation (no registry row without its\n// file) and when file creation itself fails partway.\nexport function deleteThreadFile(filePath: string): void {\n  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n    rmSync(`${filePath}${suffix}`, { force: true });\n  }\n}\n","numLines":223,"startLine":1,"totalLines":223}}}

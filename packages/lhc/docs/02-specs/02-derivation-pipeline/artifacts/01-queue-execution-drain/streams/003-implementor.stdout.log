{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HNaYgdqMWVnXN2uSMSG1mD","type":"tool_result","content":"1\t// Durable work-item mechanics: recording, ordered listing, and the enqueue\n2\t// wrapper that makes \"queueing is what schedules processing\" structural\n3\t// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n4\t// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n5\t// a turn or a summary is; which kinds queue for which sources, and which\n6\t// derived forms a kind produces, is the owning domains' business (callers\n7\t// pass the form targets in). Writes run on the caller's handle inside the\n8\t// ambient transaction, so items commit (or roll back) with the batch. No\n9\t// public SDK surface: read-back reaches here only through the owning\n10\t// domains' listQueuedWork.\n11\timport type { DatabaseSync } from \"node:sqlite\";\n12\timport { fireSchedulerPoke, type OperationContext } from \"../../shared/context.js\";\n13\timport type { FormKind, SubjectKind } from \"../../shared/derivation.js\";\n14\t\n15\texport type WorkOwner = \"messages\" | \"turns\";\n16\texport type WorkKind =\n17\t  | \"prompt_smoothing\"\n18\t  | \"tool_call_summary\"\n19\t  | \"tool_result_summary\"\n20\t  | \"turn_derivation\"\n21\t  | \"chunk_summary_detailed\"\n22\t  | \"chunk_summary_brief\";\n23\texport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n24\t\n25\t// The work-kind registry: owner and sourceRef semantics per the epic's Work\n26\t// Item contract. Mechanical metadata only — what a kind *means* stays with\n27\t// the owning domain's handler (registered at SDK construction, DD-6).\n28\texport const WORK_KIND_REGISTRY: Readonly<\n29\t  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n30\t> = {\n31\t  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n32\t  tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n33\t  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n34\t  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n35\t  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n36\t  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n37\t};\n38\t\n39\texport interface WorkItemRecord {\n40\t  workItemId: string;\n41\t  owner: WorkOwner;\n42\t  kind: WorkKind;\n43\t  sourceRef: WorkSourceRef;\n44\t  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n45\t  queuedAt: string;\n46\t}\n47\t\n48\texport interface WorkItemInput {\n49\t  owner: WorkOwner;\n50\t  kind: WorkKind;\n51\t  sourceRef: WorkSourceRef;\n52\t  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n53\t}\n54\t\n55\tfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n56\t  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n57\t  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n58\t  return sourceRef.chunkId;\n59\t}\n60\t\n61\t// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n62\t// same kind for the same source *at the same version* is the same id —\n63\t// natural idempotency for the repair path — while a post-mutation\n64\t// replacement (next version) never collides with an in-flight pre-mutation\n65\t// item.\n66\texport function recordItem(\n67\t  db: DatabaseSync,\n68\t  input: WorkItemInput,\n69\t  queuedAt: string,\n70\t): WorkItemRecord {\n71\t  const sourceVersion = input.sourceVersion ?? 1;\n72\t  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n73\t  db.prepare(\n74\t    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n75\t     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n76\t  ).run(\n77\t    workItemId,\n78\t    input.owner,\n79\t    input.kind,\n80\t    JSON.stringify(input.sourceRef),\n81\t    queuedAt,\n82\t    JSON.stringify({ sourceVersion }),\n83\t  );\n84\t  return {\n85\t    workItemId,\n86\t    owner: input.owner,\n87\t    kind: input.kind,\n88\t    sourceRef: input.sourceRef,\n89\t    status: \"queued\",\n90\t    queuedAt,\n91\t  };\n92\t}\n93\t\n94\t// The derived forms an enqueue is scheduling work toward; the owning domain\n95\t// names them (the util stays meaning-blind).\n96\texport interface EnqueueFormTarget {\n97\t  subjectKind: SubjectKind;\n98\t  subjectId: string;\n99\t  form: FormKind;\n100\t}\n101\t\n102\texport interface EnqueueInput extends WorkItemInput {\n103\t  forms: readonly EnqueueFormTarget[];\n104\t}\n105\t\n106\t// The one way work is scheduled (DD-5): the work row, the form's `pending`\n107\t// state row, and the scheduler poke all ride the ambient transaction — they\n108\t// commit together or vanish together. Enqueue is the *only* place a\n109\t// derived_form row is created (completion is UPDATE-only); re-enqueueing\n110\t// resets an existing row to pending at the enqueued source version.\n111\texport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n112\t  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n113\t  const sourceVersion = input.sourceVersion ?? 1;\n114\t  const upsert = ctx.db.prepare(\n115\t    `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n116\t     VALUES (?, ?, ?, 'pending', ?)\n117\t     ON CONFLICT (subject_kind, subject_id, form) DO UPDATE SET\n118\t       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n119\t       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n120\t  );\n121\t  for (const target of input.forms) {\n122\t    upsert.run(target.subjectKind, target.subjectId, target.form, sourceVersion);\n123\t  }\n124\t  ctx.onCommit(() => fireSchedulerPoke(ctx.threadId));\n125\t  return item;\n126\t}\n127\t\n128\tinterface RawWorkItemRow {\n129\t  work_item_id: string;\n130\t  owner: string;\n131\t  kind: string;\n132\t  source_ref: string;\n133\t  queued_at: string;\n134\t}\n135\t\n136\t// Listing in queue order (insertion order within the walk); each owning\n137\t// domain lists only its own items.\n138\texport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n139\t  const rows = db\n140\t    .prepare(\n141\t      `SELECT work_item_id, owner, kind, source_ref, queued_at\n142\t       FROM work_item WHERE owner = ? ORDER BY rowid`,\n143\t    )\n144\t    .all(owner) as unknown as RawWorkItemRow[];\n145\t  return rows.map((row) => ({\n146\t    workItemId: row.work_item_id,\n147\t    owner: row.owner as WorkOwner,\n148\t    kind: row.kind as WorkKind,\n149\t    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n150\t    status: \"queued\",\n151\t    queuedAt: row.queued_at,\n152\t  }));\n153\t}\n154\t"}]},"parent_tool_use_id":null,"session_id":"b93e566a-c98e-4b05-8100-3f1a70ca0688","uuid":"c85ddb57-34d2-4f83-b659-5125d4c15ca8","timestamp":"2026-06-11T03:33:02.140Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/tech-utils/work-queue/index.ts","content":"// Durable work-item mechanics: recording, ordered listing, and the enqueue\n// wrapper that makes \"queueing is what schedules processing\" structural\n// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n// a turn or a summary is; which kinds queue for which sources, and which\n// derived forms a kind produces, is the owning domains' business (callers\n// pass the form targets in). Writes run on the caller's handle inside the\n// ambient transaction, so items commit (or roll back) with the batch. No\n// public SDK surface: read-back reaches here only through the owning\n// domains' listQueuedWork.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport { fireSchedulerPoke, type OperationContext } from \"../../shared/context.js\";\nimport type { FormKind, SubjectKind } from \"../../shared/derivation.js\";\n\nexport type WorkOwner = \"messages\" | \"turns\";\nexport type WorkKind =\n  | \"prompt_smoothing\"\n  | \"tool_call_summary\"\n  | \"tool_result_summary\"\n  | \"turn_derivation\"\n  | \"chunk_summary_detailed\"\n  | \"chunk_summary_brief\";\nexport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n\n// The work-kind registry: owner and sourceRef semantics per the epic's Work\n// Item contract. Mechanical metadata only — what a kind *means* stays with\n// the owning domain's handler (registered at SDK construction, DD-6).\nexport const WORK_KIND_REGISTRY: Readonly<\n  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n> = {\n  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n  tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n};\n\nexport interface WorkItemRecord {\n  workItemId: string;\n  owner: WorkOwner;\n  kind: WorkKind;\n  sourceRef: WorkSourceRef;\n  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n  queuedAt: string;\n}\n\nexport interface WorkItemInput {\n  owner: WorkOwner;\n  kind: WorkKind;\n  sourceRef: WorkSourceRef;\n  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n}\n\nfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n  return sourceRef.chunkId;\n}\n\n// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n// same kind for the same source *at the same version* is the same id —\n// natural idempotency for the repair path — while a post-mutation\n// replacement (next version) never collides with an in-flight pre-mutation\n// item.\nexport function recordItem(\n  db: DatabaseSync,\n  input: WorkItemInput,\n  queuedAt: string,\n): WorkItemRecord {\n  const sourceVersion = input.sourceVersion ?? 1;\n  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n  db.prepare(\n    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n  ).run(\n    workItemId,\n    input.owner,\n    input.kind,\n    JSON.stringify(input.sourceRef),\n    queuedAt,\n    JSON.stringify({ sourceVersion }),\n  );\n  return {\n    workItemId,\n    owner: input.owner,\n    kind: input.kind,\n    sourceRef: input.sourceRef,\n    status: \"queued\",\n    queuedAt,\n  };\n}\n\n// The derived forms an enqueue is scheduling work toward; the owning domain\n// names them (the util stays meaning-blind).\nexport interface EnqueueFormTarget {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n}\n\nexport interface EnqueueInput extends WorkItemInput {\n  forms: readonly EnqueueFormTarget[];\n}\n\n// The one way work is scheduled (DD-5): the work row, the form's `pending`\n// state row, and the scheduler poke all ride the ambient transaction — they\n// commit together or vanish together. Enqueue is the *only* place a\n// derived_form row is created (completion is UPDATE-only); re-enqueueing\n// resets an existing row to pending at the enqueued source version.\nexport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n  const sourceVersion = input.sourceVersion ?? 1;\n  const upsert = ctx.db.prepare(\n    `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n     VALUES (?, ?, ?, 'pending', ?)\n     ON CONFLICT (subject_kind, subject_id, form) DO UPDATE SET\n       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n  );\n  for (const target of input.forms) {\n    upsert.run(target.subjectKind, target.subjectId, target.form, sourceVersion);\n  }\n  ctx.onCommit(() => fireSchedulerPoke(ctx.threadId));\n  return item;\n}\n\ninterface RawWorkItemRow {\n  work_item_id: string;\n  owner: string;\n  kind: string;\n  source_ref: string;\n  queued_at: string;\n}\n\n// Listing in queue order (insertion order within the walk); each owning\n// domain lists only its own items.\nexport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n  const rows = db\n    .prepare(\n      `SELECT work_item_id, owner, kind, source_ref, queued_at\n       FROM work_item WHERE owner = ? ORDER BY rowid`,\n    )\n    .all(owner) as unknown as RawWorkItemRow[];\n  return rows.map((row) => ({\n    workItemId: row.work_item_id,\n    owner: row.owner as WorkOwner,\n    kind: row.kind as WorkKind,\n    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n    status: \"queued\",\n    queuedAt: row.queued_at,\n  }));\n}\n","numLines":154,"startLine":1,"totalLines":154}}}

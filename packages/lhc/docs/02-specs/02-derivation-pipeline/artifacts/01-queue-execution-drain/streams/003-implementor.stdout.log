t TS can't reduce a structural spread to the deferred Extract<…, { eventKind: K }>,\n49\t  // so the final reconciliation goes through unknown. Call-site safety lives in the\n50\t  // parameter types, not this assertion.\n51\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\n52\t}\n53\t\n54\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n55\t  return kinds.map((kind) => validEvent(kind));\n56\t}\n57\t\n58\texport function conversationTurn(): MessageEventInput[] {\n59\t  return eventBatch([\n60\t    \"user_prompt\",\n61\t    \"assistant_text\",\n62\t    \"tool_call\",\n63\t    \"tool_result\",\n64\t    \"turn_end\",\n65\t  ]);\n66\t}\n67\t\n68\texport interface TempStore {\n69\t  dir: string;\n70\t  registryPath: string;\n71\t  threadPath: (name?: string) => string;\n72\t  cleanup: () => void;\n73\t}\n74\t\n75\texport function tempStore(): TempStore {\n76\t  const dir = mkdtempSync(join(tmpdir(), \"lhc-test-\"));\n77\t  let threadCounter = 0;\n78\t  return {\n79\t    dir,\n80\t    registryPath: join(dir, \"registry.sqlite\"),\n81\t    threadPath: (name) => {\n82\t      threadCounter += 1;\n83\t      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n84\t    },\n85\t    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n86\t  };\n87\t}\n88\t\n89\t// Direct node:sqlite handle for below-SDK assertions. Read-only use by\n90\t// convention; fixtures/corrupt.ts is the one sanctioned writer.\n91\texport function openRaw(path: string): DatabaseSync {\n92\t  return new DatabaseSync(path);\n93\t}\n94\t\n95\texport { corruptTwoOpenTurns } from \"./corrupt.js\";\n96\texport {\n97\t  legacyEpic01ThreadFile,\n98\t  legacyStory2ThreadFile,\n99\t  schemaVersionOf,\n100\t  type LegacyRecordedEvent,\n101\t} from \"./legacy.js\";\n102\texport { setIntakeClock, setIntakeWalkHook, type IntakeWalkHook } from \"./intake-seam.js\";\n103\texport {\n104\t  createProviderDouble,\n105\t  ProviderDouble,\n106\t  type CapturedInput,\n107\t  type ProviderOpName,\n108\t} from \"./provider-double.js\";\n109\texport {\n110\t  damagedSourceThread,\n111\t  multiStateThread,\n112\t  readDerivedForms,\n113\t  setFormState,\n114\t  threadWithClosedTurns,\n115\t  threadWithToolRun,\n116\t  twinThreads,\n117\t  type MultiStateClaim,\n118\t} from \"./threads.js\";\n119\t"}]},"parent_tool_use_id":null,"session_id":"b93e566a-c98e-4b05-8100-3f1a70ca0688","uuid":"f857dccf-fd66-42f2-b972-f5b06b9fe9fa","timestamp":"2026-06-11T03:38:07.947Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/index.ts","content":"import { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { DatabaseSync } from \"node:sqlite\";\nimport type { EventKind, MessageEventInput } from \"../../src/index.js\";\n\nexport type EventByKind<K extends EventKind> = Extract<\n  MessageEventInput,\n  { eventKind: K }\n>;\n\nlet keyCounter = 0;\n\nconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n  user_prompt: () => ({ text: \"please read the file\" }),\n  assistant_text: () => ({ text: \"here is what I found\" }),\n  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n  runtime_note: () => ({ text: \"harness restarted mid-turn\" }),\n  tool_call: () => ({\n    toolCallId: \"call-1\",\n    toolName: \"read_file\",\n    arguments: { path: \"notes.txt\" },\n  }),\n  tool_result: () => ({\n    toolCallId: \"call-1\",\n    content: \"contents of notes.txt\",\n    isError: false,\n  }),\n  turn_end: () => ({}),\n};\n\n// Returns the discriminated MessageEventInput member for its kind, so a\n// kind/payload mismatch in test code is a compile error — building an invalid\n// pairing requires an explicit cast at the call site.\nexport function validEvent<K extends EventKind>(\n  kind: K,\n  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n): EventByKind<K> {\n  keyCounter += 1;\n  const base = {\n    eventKind: kind,\n    idempotencyKey: `fixture-key-${keyCounter}`,\n    actor: \"fixture-actor\",\n    harness: \"fixture-harness\",\n    payload: defaultPayloads[kind](),\n  };\n  // The fields are built per-kind above (payload is typed EventByKind<K>[\"payload\"]),\n  // but TS can't reduce a structural spread to the deferred Extract<…, { eventKind: K }>,\n  // so the final reconciliation goes through unknown. Call-site safety lives in the\n  // parameter types, not this assertion.\n  return { ...base, ...overrides } as unknown as EventByKind<K>;\n}\n\nexport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n  return kinds.map((kind) => validEvent(kind));\n}\n\nexport function conversationTurn(): MessageEventInput[] {\n  return eventBatch([\n    \"user_prompt\",\n    \"assistant_text\",\n    \"tool_call\",\n    \"tool_result\",\n    \"turn_end\",\n  ]);\n}\n\nexport interface TempStore {\n  dir: string;\n  registryPath: string;\n  threadPath: (name?: string) => string;\n  cleanup: () => void;\n}\n\nexport function tempStore(): TempStore {\n  const dir = mkdtempSync(join(tmpdir(), \"lhc-test-\"));\n  let threadCounter = 0;\n  return {\n    dir,\n    registryPath: join(dir, \"registry.sqlite\"),\n    threadPath: (name) => {\n      threadCounter += 1;\n      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n    },\n    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n  };\n}\n\n// Direct node:sqlite handle for below-SDK assertions. Read-only use by\n// convention; fixtures/corrupt.ts is the one sanctioned writer.\nexport function openRaw(path: string): DatabaseSync {\n  return new DatabaseSync(path);\n}\n\nexport { corruptTwoOpenTurns } from \"./corrupt.js\";\nexport {\n  legacyEpic01ThreadFile,\n  legacyStory2ThreadFile,\n  schemaVersionOf,\n  type LegacyRecordedEvent,\n} from \"./legacy.js\";\nexport { setIntakeClock, setIntakeWalkHook, type IntakeWalkHook } from \"./intake-seam.js\";\nexport {\n  createProviderDouble,\n  ProviderDouble,\n  type CapturedInput,\n  type ProviderOpName,\n} from \"./provider-double.js\";\nexport {\n  damagedSourceThread,\n  multiStateThread,\n  readDerivedForms,\n  setFormState,\n  threadWithClosedTurns,\n  threadWithToolRun,\n  twinThreads,\n  type MultiStateClaim,\n} from \"./threads.js\";\n","numLines":119,"startLine":1,"totalLines":119}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014zGTFxvsGhKpAD4d6B7pWx","type":"tool_result","content":"1\t// SDK-internal scheduler (DD-4) — Story 0 skeleton. Manual mode is complete\n2\t// in this story: enqueue's onCommit poke fires (shared/context.ts owns the\n3\t// poke seam), and the scheduler does nothing with it — draining is an\n4\t// explicit caller operation. Background mode's single-flight / coalesce /\n5\t// catch-up machinery is Story 1's; the mode flag exists now so createSdk\n6\t// validates its config shape from day one. This module must import domain\n7\t// surfaces only through domains/*/index.ts when Story 1 wires the drain.\n8\texport type SchedulerMode = \"background\" | \"manual\";\n9\t\n10\texport interface Scheduler {\n11\t  readonly mode: SchedulerMode;\n12\t  // Post-commit nudge that work was queued for a thread. Manual mode: no-op\n13\t  // by contract (DD-5). Background mode: drain scheduling lands in Story 1;\n14\t  // until then the poke is received and deliberately not acted on — there is\n15\t  // no drain to fake (fail-closed: no pretend scheduling).\n16\t  poke(threadId: string): void;\n17\t}\n18\t\n19\texport function createScheduler(mode: SchedulerMode): Scheduler {\n20\t  return {\n21\t    mode,\n22\t    poke(_threadId: string): void {\n23\t      // Story 1 fills this in for background mode.\n24\t    },\n25\t  };\n26\t}\n27\t"}]},"parent_tool_use_id":null,"session_id":"b93e566a-c98e-4b05-8100-3f1a70ca0688","uuid":"8a0e40fe-5d74-4058-a354-9a585df4fae6","timestamp":"2026-06-11T03:33:02.600Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/scheduler.ts","content":"// SDK-internal scheduler (DD-4) — Story 0 skeleton. Manual mode is complete\n// in this story: enqueue's onCommit poke fires (shared/context.ts owns the\n// poke seam), and the scheduler does nothing with it — draining is an\n// explicit caller operation. Background mode's single-flight / coalesce /\n// catch-up machinery is Story 1's; the mode flag exists now so createSdk\n// validates its config shape from day one. This module must import domain\n// surfaces only through domains/*/index.ts when Story 1 wires the drain.\nexport type SchedulerMode = \"background\" | \"manual\";\n\nexport interface Scheduler {\n  readonly mode: SchedulerMode;\n  // Post-commit nudge that work was queued for a thread. Manual mode: no-op\n  // by contract (DD-5). Background mode: drain scheduling lands in Story 1;\n  // until then the poke is received and deliberately not acted on — there is\n  // no drain to fake (fail-closed: no pretend scheduling).\n  poke(threadId: string): void;\n}\n\nexport function createScheduler(mode: SchedulerMode): Scheduler {\n  return {\n    mode,\n    poke(_threadId: string): void {\n      // Story 1 fills this in for background mode.\n    },\n  };\n}\n","numLines":27,"startLine":1,"totalLines":27}}}

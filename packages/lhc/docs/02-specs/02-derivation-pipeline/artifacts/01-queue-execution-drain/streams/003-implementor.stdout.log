{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ArTz1PQ1tj7g2oAA8FvUCn","type":"tool_result","content":"export * from \"./sdk.js\";\nexport { runCli } from \"./cli/index.js\";\nexport type { CliResult } from \"./cli/render.js\";\ntest/cli-process-projection.test.ts:55:      validEvent(\"user_prompt\", { payload: { text: \"run the big tool\" } }),\ntest/cli-process-projection.test.ts:57:        payload: { toolCallId: \"proc-big\", content: bigContent, isError: false },\ntest/idempotency.test.ts:146:  it(\"TC-5.5: key wins over content — original payload intact, resent payload stored nowhere\", async () => {\ntest/idempotency.test.ts:150:      payload: { text: \"PAYLOAD-A-ORIGINAL\" },\ntest/idempotency.test.ts:157:      payload: { text: \"PAYLOAD-B-MUST-VANISH\" },\ntest/idempotency.test.ts:170:    expect(events[0]!.payload).toEqual({ text: \"PAYLOAD-A-ORIGINAL\" });\ntest/idempotency.test.ts:172:    // openRaw scan: payload B appears in no table at all.\ntest/fixtures.test.ts:40:      expect(Object.keys(event.payload).sort()).toEqual(\ntest/fixtures.test.ts:44:        [\"actor\", \"eventKind\", \"harness\", \"idempotencyKey\", \"payload\"].sort(),\ntest/fixtures.test.ts:52:      payload: { text: \"custom prompt\" },\ntest/fixtures.test.ts:56:    expect(event.payload.text).toBe(\"custom prompt\");\ntest/fixtures.test.ts:59:  it(\"building an invalid kind/payload pairing requires an explicit cast\", () => {\ntest/fixtures.test.ts:61:      // @ts-expect-error — a tool_call payload on a user_prompt event must not compile\ntest/fixtures.test.ts:62:      payload: { toolCallId: \"x\", toolName: \"y\", arguments: {} },\ntest/thread-migration.test.ts:37:  payload: { text: \"recorded before story 3 shipped\" },\ntest/thread-migration.test.ts:48:      validEvent(\"assistant_text\", { payload: { text: \"answered after upgrade\" } }),\ntest/thread-migration.test.ts:74:      payload: { text: \"recorded before story 3 shipped\" },\ntest/thread-migration.
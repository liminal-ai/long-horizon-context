{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VTduUJqZQycnkhJDHurbTw","type":"tool_result","content":"1\t// Deterministic DerivationProvider double (DD-7, test plan §Test Substrate).\n2\t// Injected at the same seam production adapters use — dependency injection,\n3\t// not a mock of internals. Every operation returns marked, input-derived\n4\t// output: `<marker>(<digest>:<prefix>)` where the digest and prefix are pure\n5\t// functions of the input, so identical input to the same operation yields\n6\t// identical output across double instances, and different operations are\n7\t// distinguishable by marker. Scripting (failNext / failKind / delayKind /\n8\t// captureInputs) is per-instance state and never leaks across tests that\n9\t// construct their own double.\n10\timport type {\n11\t  DerivationProvider,\n12\t  ProviderResult,\n13\t  RenderingPart,\n14\t} from \"../../src/index.js\";\n15\t\n16\texport type ProviderOpName =\n17\t  | \"smoothPrompt\"\n18\t  | \"summarizeToolCall\"\n19\t  | \"summarizeToolResult\"\n20\t  | \"composeTurnRendering\"\n21\t  | \"projectLowerBand\"\n22\t  | \"summarizeChunkDetailed\"\n23\t  | \"summarizeChunkBrief\";\n24\t\n25\t// Tests script by work-kind / form-kind vocabulary (the test plan writes\n26\t// `failKind(prompt_smoothing, …)`); the double accepts those aliases as well\n27\t// as the operation names themselves.\n28\tconst KIND_ALIASES: Record<string, ProviderOpName> = {\n29\t  smoothPrompt: \"smoothPrompt\",\n30\t  summarizeToolCall: \"summarizeToolCall\",\n31\t  summarizeToolResult: \"summarizeToolResult\",\n32\t  composeTurnRendering: \"composeTurnRendering\",\n33\t  projectLowerBand: \"projectLowerBand\",\n34\t  summarizeChunkDetailed: \"summarizeChunkDetailed\",\n35\t  summarizeChunkBrief: \"summarizeChunkBrief\",\n36\t  prompt_smoothing: \"smoothPrompt\",\n37\t  smoothed_prompt: \"smoothPrompt\",\n38\t  tool_call_summary: \"summarizeToolCall\",\n39\t  tool_result_summary: \"summarizeToolResult\",\n40\t  turn_rendering: \"composeTurnRendering\",\n41\t  lower_band_projection: \"projectLowerBand\",\n42\t  chunk_summary_detailed: \"summarizeChunkDetailed\",\n43\t  chunk_summary_brief: \"summarizeChunkBrief\",\n44\t};\n45\t\n46\tfunction resolveOpName(kind: string): ProviderOpName {\n47\t  const op = KIND_ALIASES[kind];\n48\t  if (op === undefined) throw new Error(`provider double: unknown operation/kind \"${kind}\"`);\n49\t  return op;\n50\t}\n51\t\n52\t// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\n53\t// input-sensitive enough that distinct inputs mark distinct outputs.\n54\tfunction digest(input: unknown): string {\n55\t  const text = JSON.stringify(input);\n56\t  let hash = 0x811c9dc5;\n57\t  for (let i = 0; i < text.length; i += 1) {\n58\t    hash ^= text.charCodeAt(i);\n59\t    hash = Math.imul(hash, 0x01000193) >>> 0;\n60\t  }\n61\t  return hash.toString(16).padStart(8, \"0\");\n62\t}\n63\t\n64\tfunction prefix40(text: string): string {\n65\t  return text.slice(0, 40);\n66\t}\n67\t\n68\tinterface FailScript {\n69\t  remaining: number;\n70\t  retryable: boolean;\n71\t  reason: string;\n72\t}\n73\t\n74\texport interface CapturedInput {\n75\t  op: ProviderOpName;\n76\t  input: unknown;\n77\t}\n78\t\n79\texport class ProviderDouble implements DerivationProvider {\n80\t  private failNextScript: FailScript | null = null;\n81\t  private readonly failByOp = new Map<ProviderOpName, FailScript>();\n82\t  private readonly delayByOp = new Map<ProviderOpName, number>();\n83\t  private capturing = false;\n84\t  private readonly captured: CapturedInput[] = [];\n85\t\n86\t  // Fail the next n calls to any operation, then succeed.\n87\t  failNext(n: number, opts?: { retryable?: boolean; reason?: string }): void {\n88\t    this.failNextScript = {\n89\t      remaining: n,\n90\t      retryable: opts?.retryable ?? true,\n91\t      reason: opts?.reason ?? \"scripted failure (failNext)\",\n92\t    };\n93\t  }\n94\t\n95\t  // Fail the next n calls to one operation (kind names and op names both\n96\t  // accepted). retryable: false scripts a terminal failure.\n97\t  failKind(kind: string, n: number, opts?: { retryable?: boolean; reason?: string }): void {\n98\t    const op = resolveOpName(kind);\n99\t    this.failByOp.set(op, {\n100\t      remaining: n,\n101\t      retryable: opts?.retryable ?? true,\n102\t      reason: opts?.reason ?? `scripted failure (${op})`,\n103\t    });\n104\t  }\n105\t\n106\t  delayKind(kind: string, ms: number): void {\n107\t    this.delayByOp.set(resolveOpName(kind), ms);\n108\t  }\n109\t\n110\t  // Start capturing inputs; returns the live log (appended in call order).\n111\t  captureInputs(): readonly CapturedInput[] {\n112\t    this.capturing = true;\n113\t    return this.captured;\n114\t  }\n115\t\n116\t  private async run(\n117\t    op: ProviderOpName,\n118\t    input: unknown,\n119\t    text: string,\n120\t  ): Promise<ProviderResult> {\n121\t    if (this.capturing) this.captured.push({ op, input: structuredClone(input) });\n122\t    const delay = this.delayByOp.get(op);\n123\t    if (delay !== undefined && delay > 0) {\n124\t      await new Promise((resolve) => setTimeout(resolve, delay));\n125\t    }\n126\t    const scripts = [this.failNextScript, this.failByOp.get(op) ?? null];\n127\t    for (const script of scripts) {\n128\t      if (script !== null && script.remaining > 0) {\n129\t        script.remaining -= 1;\n130\t        return { ok: false, retryable: script.retryable, reason: script.reason };\n131\t      }\n132\t    }\n133\t    const markers: Record<ProviderOpName, string> = {\n134\t      smoothPrompt: \"smoothed\",\n135\t      summarizeToolCall: \"toolcall\",\n136\t      summarizeToolResult: \"toolresult\",\n137\t      composeTurnRendering: \"rendering\",\n138\t      projectLowerBand: \"projection\",\n139\t      summarizeChunkDetailed: \"detailed\",\n140\t      summarizeChunkBrief: \"brief\",\n141\t    };\n142\t    return { ok: true, text: `${markers[op]}(${digest(input)}:${prefix40(text)})` };\n143\t  }\n144\t\n145\t  smoothPrompt(i: { text: string }): Promise<ProviderResult> {\n146\t    return this.run(\"smoothPrompt\", i, i.text);\n147\t  }\n148\t\n149\t  summarizeToolCall(i: {\n150\t    toolName: string;\n151\t    argsJson: string;\n152\t    pairedResult?: { content: string; isError: boolean };\n153\t  }): Promise<ProviderResult> {\n154\t    return this.run(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`);\n155\t  }\n156\t\n157\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult> {\n158\t    return this.run(\"summarizeToolResult\", i, i.content);\n159\t  }\n160\t\n161\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult> {\n162\t    return this.run(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \"));\n163\t  }\n164\t\n165\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult> {\n166\t    return this.run(\"projectLowerBand\", i, i.rendering);\n167\t  }\n168\t\n169\t  summarizeChunkDetailed(i: { memberProjections: string[] }): Promise<ProviderResult> {\n170\t    return this.run(\"summarizeChunkDetailed\", i, i.memberProjections.join(\" | \"));\n171\t  }\n172\t\n173\t  summarizeChunkBrief(i: { memberProjections: string[] }): Promise<ProviderResult> {\n174\t    return this.run(\"summarizeChunkBrief\", i, i.memberProjections.join(\" | \"));\n175\t  }\n176\t}\n177\t\n178\texport function createProviderDouble(): ProviderDouble {\n179\t  return new ProviderDouble();\n180\t}\n181\t"}]},"parent_tool_use_id":null,"session_id":"b93e566a-c98e-4b05-8100-3f1a70ca0688","uuid":"2adc5d4a-5392-4a07-919d-539f7dfac799","timestamp":"2026-06-11T03:33:19.895Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/provider-double.ts","content":"// Deterministic DerivationProvider double (DD-7, test plan §Test Substrate).\n// Injected at the same seam production adapters use — dependency injection,\n// not a mock of internals. Every operation returns marked, input-derived\n// output: `<marker>(<digest>:<prefix>)` where the digest and prefix are pure\n// functions of the input, so identical input to the same operation yields\n// identical output across double instances, and different operations are\n// distinguishable by marker. Scripting (failNext / failKind / delayKind /\n// captureInputs) is per-instance state and never leaks across tests that\n// construct their own double.\nimport type {\n  DerivationProvider,\n  ProviderResult,\n  RenderingPart,\n} from \"../../src/index.js\";\n\nexport type ProviderOpName =\n  | \"smoothPrompt\"\n  | \"summarizeToolCall\"\n  | \"summarizeToolResult\"\n  | \"composeTurnRendering\"\n  | \"projectLowerBand\"\n  | \"summarizeChunkDetailed\"\n  | \"summarizeChunkBrief\";\n\n// Tests script by work-kind / form-kind vocabulary (the test plan writes\n// `failKind(prompt_smoothing, …)`); the double accepts those aliases as well\n// as the operation names themselves.\nconst KIND_ALIASES: Record<string, ProviderOpName> = {\n  smoothPrompt: \"smoothPrompt\",\n  summarizeToolCall: \"summarizeToolCall\",\n  summarizeToolResult: \"summarizeToolResult\",\n  composeTurnRendering: \"composeTurnRendering\",\n  projectLowerBand: \"projectLowerBand\",\n  summarizeChunkDetailed: \"summarizeChunkDetailed\",\n  summarizeChunkBrief: \"summarizeChunkBrief\",\n  prompt_smoothing: \"smoothPrompt\",\n  smoothed_prompt: \"smoothPrompt\",\n  tool_call_summary: \"summarizeToolCall\",\n  tool_result_summary: \"summarizeToolResult\",\n  turn_rendering: \"composeTurnRendering\",\n  lower_band_projection: \"projectLowerBand\",\n  chunk_summary_detailed: \"summarizeChunkDetailed\",\n  chunk_summary_brief: \"summarizeChunkBrief\",\n};\n\nfunction resolveOpName(kind: string): ProviderOpName {\n  const op = KIND_ALIASES[kind];\n  if (op === undefined) throw new Error(`provider double: unknown operation/kind \"${kind}\"`);\n  return op;\n}\n\n// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\n// input-sensitive enough that distinct inputs mark distinct outputs.\nfunction digest(input: unknown): string {\n  const text = JSON.stringify(input);\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < text.length; i += 1) {\n    hash ^= text.charCodeAt(i);\n    hash = Math.imul(hash, 0x01000193) >>> 0;\n  }\n  return hash.toString(16).padStart(8, \"0\");\n}\n\nfunction prefix40(text: string): string {\n  return text.slice(0, 40);\n}\n\ninterface FailScript {\n  remaining: number;\n  retryable: boolean;\n  reason: string;\n}\n\nexport interface CapturedInput {\n  op: ProviderOpName;\n  input: unknown;\n}\n\nexport class ProviderDouble implements DerivationProvider {\n  private failNextScript: FailScript | null = null;\n  private readonly failByOp = new Map<ProviderOpName, FailScript>();\n  private readonly delayByOp = new Map<ProviderOpName, number>();\n  private capturing = false;\n  private readonly captured: CapturedInput[] = [];\n\n  // Fail the next n calls to any operation, then succeed.\n  failNext(n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    this.failNextScript = {\n      remaining: n,\n      retryable: opts?.retryable ?? true,\n      reason: opts?.reason ?? \"scripted failure (failNext)\",\n    };\n  }\n\n  // Fail the next n calls to one operation (kind names and op names both\n  // accepted). retryable: false scripts a terminal failure.\n  failKind(kind: string, n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    const op = resolveOpName(kind);\n    this.failByOp.set(op, {\n      remaining: n,\n      retryable: opts?.retryable ?? true,\n      reason: opts?.reason ?? `scripted failure (${op})`,\n    });\n  }\n\n  delayKind(kind: string, ms: number): void {\n    this.delayByOp.set(resolveOpName(kind), ms);\n  }\n\n  // Start capturing inputs; returns the live log (appended in call order).\n  captureInputs(): readonly CapturedInput[] {\n    this.capturing = true;\n    return this.captured;\n  }\n\n  private async run(\n    op: ProviderOpName,\n    input: unknown,\n    text: string,\n  ): Promise<ProviderResult> {\n    if (this.capturing) this.captured.push({ op, input: structuredClone(input) });\n    const delay = this.delayByOp.get(op);\n    if (delay !== undefined && delay > 0) {\n      await new Promise((resolve) => setTimeout(resolve, delay));\n    }\n    const scripts = [this.failNextScript, this.failByOp.get(op) ?? null];\n    for (const script of scripts) {\n      if (script !== null && script.remaining > 0) {\n        script.remaining -= 1;\n        return { ok: false, retryable: script.retryable, reason: script.reason };\n      }\n    }\n    const markers: Record<ProviderOpName, string> = {\n      smoothPrompt: \"smoothed\",\n      summarizeToolCall: \"toolcall\",\n      summarizeToolResult: \"toolresult\",\n      composeTurnRendering: \"rendering\",\n      projectLowerBand: \"projection\",\n      summarizeChunkDetailed: \"detailed\",\n      summarizeChunkBrief: \"brief\",\n    };\n    return { ok: true, text: `${markers[op]}(${digest(input)}:${prefix40(text)})` };\n  }\n\n  smoothPrompt(i: { text: string }): Promise<ProviderResult> {\n    return this.run(\"smoothPrompt\", i, i.text);\n  }\n\n  summarizeToolCall(i: {\n    toolName: string;\n    argsJson: string;\n    pairedResult?: { content: string; isError: boolean };\n  }): Promise<ProviderResult> {\n    return this.run(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`);\n  }\n\n  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult> {\n    return this.run(\"summarizeToolResult\", i, i.content);\n  }\n\n  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult> {\n    return this.run(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \"));\n  }\n\n  projectLowerBand(i: { rendering: string }): Promise<ProviderResult> {\n    return this.run(\"projectLowerBand\", i, i.rendering);\n  }\n\n  summarizeChunkDetailed(i: { memberProjections: string[] }): Promise<ProviderResult> {\n    return this.run(\"summarizeChunkDetailed\", i, i.memberProjections.join(\" | \"));\n  }\n\n  summarizeChunkBrief(i: { memberProjections: string[] }): Promise<ProviderResult> {\n    return this.run(\"summarizeChunkBrief\", i, i.memberProjections.join(\" | \"));\n  }\n}\n\nexport function createProviderDouble(): ProviderDouble {\n  return new ProviderDouble();\n}\n","numLines":181,"startLine":1,"totalLines":181}}}

rkHandler> {\n116\t  const handler = map[kind as WorkKind];\n117\t  if (handler === undefined) return unknownWorkKind(kind);\n118\t  return { ok: true, value: handler };\n119\t}\n120\t\n121\texport interface Lhc {\n122\t  threads: typeof threadsDomain;\n123\t  intakeStream: typeof intakeStreamDomain;\n124\t  messages: typeof messagesDomain;\n125\t  turns: typeof turnsDomain;\n126\t  config: ResolvedSdkConfig;\n127\t  scheduler: Scheduler;\n128\t  workHandlers: WorkHandlerMap;\n129\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n130\t}\n131\t\n132\tfunction requirePositive(value: number, name: string): void {\n133\t  if (!Number.isFinite(value) || value <= 0) {\n134\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n135\t  }\n136\t}\n137\t\n138\tfunction requireNonNegative(value: number, name: string): void {\n139\t  if (!Number.isFinite(value) || value < 0) {\n140\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n141\t  }\n142\t}\n143\t\n144\t// The only assembly path: provider, mode, clock, and policy enter here.\n145\t// Config mistakes are programmer errors at construction and throw; operating\n146\t// failures after construction return OpResults per the error contract.\n147\texport function createSdk(config: SdkConfig): Lhc {\n148\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n149\t    throw new TypeError(\n150\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n151\t    );\n152\t  }\n153\t  if (config.provider === null || typeof config.provider !== \"object\") {\n154\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n155\t  }\n156\t  for (const operation of PROVIDER_OPERATIONS) {\n157\t    if (typeof config.provider[operation] !== \"function\") {\n158\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n159\t    }\n160\t  }\n161\t\n162\t  const resolved: ResolvedSdkConfig = {\n163\t    provider: config.provider,\n164\t    mode: config.mode,\n165\t    clock: config.clock ?? (() => new Date()),\n166\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n167\t    lease: config.lease ?? { durationMs: 120000 },\n168\t    chunkPolicy:\n169\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n170\t  };\n171\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n172\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n173\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n174\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n175\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n176\t  }\n177\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n178\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n179\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n180\t    throw new TypeError(\n181\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n182\t    );\n183\t  }\n184\t\n185\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n186\t  // The tables are empty until Stories 2–3 land the real handlers; the\n187\t  // assembly mechanics are production code from day one.\n188\t  const workHandlers = assembleWorkHandlerMap([\n189\t    messagesDomain.workHandlers,\n190\t    turnsDomain.workHandlers,\n191\t  ]);\n192\t\n193\t  return {\n194\t    threads: threadsDomain,\n195\t    intakeStream: intakeStreamDomain,\n196\t    messages: messagesDomain,\n197\t    turns: turnsDomain,\n198\t    config: resolved,\n199\t    scheduler: createScheduler(resolved.mode),\n200\t    workHandlers,\n201\t    lookupWorkHandle
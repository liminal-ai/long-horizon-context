{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ApEzzLGVorjh4widkSbRTu","type":"tool_result","content":"1\t// Thread builders for Epic 02 (test plan §Test Substrate). All built through\n2\t// real intake; the multi-state and damaged-source builders then apply the\n3\t// sanctioned below-SDK writes for states the SDK cannot yet produce (drain\n4\t// and handlers land in Stories 1–3) — Story 0 proves read-back of what the\n5\t// builders wrote; Stories 2/4 confirm the states arise for real\n6\t// (coverage.md cross-story debt).\n7\timport { DatabaseSync } from \"node:sqlite\";\n8\timport {\n9\t  intakeStream,\n10\t  runCli,\n11\t  threads,\n12\t  type DerivedForm,\n13\t  type DerivedFormState,\n14\t  type DependencyGap,\n15\t  type FormKind,\n16\t  type MessageEventInput,\n17\t  type SubjectKind,\n18\t  type ToolOutcome,\n19\t} from \"../../src/index.js\";\n20\timport { setIntakeClock } from \"./intake-seam.js\";\n21\timport { corruptTwoOpenTurns } from \"./corrupt.js\";\n22\timport { validEvent, type TempStore } from \"./index.js\";\n23\t\n24\tasync function newThreadFile(store: TempStore): Promise<string> {\n25\t  const filePath = store.threadPath();\n26\t  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n27\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n28\t  return filePath;\n29\t}\n30\t\n31\tasync function send(filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n32\t  const result = await intakeStream.messageEvents({ filePath }, batch);\n33\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n34\t}\n35\t\n36\t// n closed turns, each prompt + assistant text + explicit end. Turn ids are\n37\t// deterministic (t1..tn) per the turn store's id scheme.\n38\texport async function threadWithClosedTurns(\n39\t  store: TempStore,\n40\t  n: number,\n41\t): Promise<{ filePath: string; turnIds: string[] }> {\n42\t  const filePath = await newThreadFile(store);\n43\t  const turnIds: string[] = [];\n44\t  for (let i = 1; i <= n; i += 1) {\n45\t    await send(filePath, [\n46\t      validEvent(\"user_prompt\", { payload: { text: `prompt for turn ${i}` } }),\n47\t      validEvent(\"assistant_text\", { payload: { text: `answer for turn ${i}` } }),\n48\t      validEvent(\"turn_end\"),\n49\t    ]);\n50\t    turnIds.push(`t${i}`);\n51\t  }\n52\t  return { filePath, turnIds };\n53\t}\n54\t\n55\t// One closed turn containing a tool run: call + result pair by default;\n56\t// error and missing-result variants per the epic's outcome vocabulary.\n57\texport async function threadWithToolRun(\n58\t  store: TempStore,\n59\t  opts: { isError?: boolean; missingResult?: boolean; resultContent?: string } = {},\n60\t): Promise<{ filePath: string; turnId: string }> {\n61\t  const filePath = await newThreadFile(store);\n62\t  const batch: MessageEventInput[] = [\n63\t    validEvent(\"user_prompt\", { payload: { text: \"please run the tool\" } }),\n64\t    validEvent(\"tool_call\", {\n65\t      payload: { toolCallId: \"call-fixture-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n66\t    }),\n67\t  ];\n68\t  if (opts.missingResult !== true) {\n69\t    batch.push(\n70\t      validEvent(\"tool_result\", {\n71\t        payload: {\n72\t          toolCallId: \"call-fixture-1\",\n73\t          content: opts.resultContent ?? \"contents of notes.txt\",\n74\t          isError: opts.isError ?? false,\n75\t        },\n76\t      }),\n77\t    );\n78\t  }\n79\t  batch.push(validEvent(\"turn_end\"));\n80\t  await send(filePath, batch);\n81\t  return { filePath, turnId: \"t1\" };\n82\t}\n83\t\n84\t// ── derived_form read-back and the sanctioned state writer ───────\n85\t\n86\tinterface RawFormRow {\n87\t  subject_kind: string;\n88\t  subject_id: string;\n89\t  form: string;\n90\t  state: string;\n91\t  content: string | null;\n92\t  reason: string | null;\n93\t  metadata: string | null;\n94\t  source_version: number | bigint;\n95\t  gaps: string | null;\n96\t  derived_at: string | null;\n97\t}\n98\t\n99\texport function readDerivedForms(filePath: string): DerivedForm[] {\n100\t  const db = new DatabaseSync(filePath);\n101\t  try {\n102\t    const rows = db\n103\t      .prepare(\n104\t        `SELECT subject_kind, subject_id, form, state, content, reason, metadata,\n105\t                source_version, gaps, derived_at\n106\t         FROM derived_form ORDER BY subject_kind, subject_id, form`,\n107\t      )\n108\t      .all() as unknown as RawFormRow[];\n109\t    return rows.map((row) => {\n110\t      const record: DerivedForm = {\n111\t        subjectKind: row.subject_kind as SubjectKind,\n112\t        subjectId: row.subject_id,\n113\t        form: row.form as FormKind,\n114\t        state: row.state as DerivedFormState,\n115\t        sourceVersion: Number(row.source_version),\n116\t      };\n117\t      if (row.content !== null) record.content = row.content;\n118\t      if (row.reason !== null) record.reason = row.reason;\n119\t      if (row.metadata !== null) {\n120\t        record.metadata = JSON.parse(row.metadata) as { outcome?: ToolOutcome };\n121\t      }\n122\t      if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n123\t      if (row.derived_at !== null) record.derivedAt = row.derived_at;\n124\t      return record;\n125\t    });\n126\t  } finally {\n127\t    db.close();\n128\t  }\n129\t}\n130\t\n131\t// Below-SDK state writer, sanctioned like corrupt.ts: ready/failed/blocked\n132\t// are unreachable through the SDK until the drain (Story 1) and handlers\n133\t// (Stories 2–3) land. UPDATE-only on purpose — the pending row exists from\n134\t// enqueue, mirroring the production completion contract.\n135\texport function setFormState(\n136\t  filePath: string,\n137\t  target: { subjectKind: SubjectKind; subjectId: string; form: FormKind },\n138\t  update: {\n139\t    state: DerivedFormState;\n140\t    content?: string;\n141\t    reason?: string;\n142\t    metadata?: { outcome?: ToolOutcome };\n143\t    derivedAt?: string;\n144\t  },\n145\t): void {\n146\t  const db = new DatabaseSync(filePath);\n147\t  try {\n148\t    const changed = db\n149\t      .prepare(\n150\t        `UPDATE derived_form\n151\t         SET state = ?, content = ?, reason = ?, metadata = ?, derived_at = ?\n152\t         WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n153\t      )\n154\t      .run(\n155\t        update.state,\n156\t        update.content ?? null,\n157\t        update.reason ?? null,\n158\t        update.metadata === undefined ? null : JSON.stringify(update.metadata),\n159\t        update.derivedAt ?? null,\n160\t        target.subjectKind,\n161\t        target.subjectId,\n162\t        target.form,\n163\t      );\n164\t    if (Number(changed.changes) !== 1) {\n165\t      throw new Error(\n166\t        `fixture setFormState hit ${String(changed.changes)} rows for ${target.subjectKind}/${target.subjectId}/${target.form}; expected the pending row from enqueue`,\n167\t      );\n168\t    }\n169\t  } finally {\n170\t    db.close();\n171\t  }\n172\t}\n173\t\n174\t// ── multi-state thread: every form state in one file ─────────────\n175\t\n176\texport interface MultiStateClaim {\n177\t  subjectKind: SubjectKind;\n178\t  subjectId: string;\n179\t  form: FormKind;\n180\t  state: DerivedFormState;\n181\t}\n182\t\n183\texport async function multiStateThread(\n184\t  store: TempStore,\n185\t): Promise<{ filePath: string; expected: MultiStateClaim[] }> {\n186\t  const filePath = await newThreadFile(store);\n187\t  // Turn 1: prompt + tool run; turn 2: prompt. Intake's enqueue leaves every\n188\t  // form pending; the writes below move a subset into the other three states.\n189\t  await send(filePath, [\n190\t    validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n191\t    validEvent(\"assistant_text\", { payload: { text: \"working on it\" } }),\n192\t    validEvent(\"tool_call\", {\n193\t      payload: { toolCallId: \"call-ms-1\", toolName: \"read_file\", arguments: { path: \"a.txt\" } },\n194\t    }),\n195\t    validEvent(\"tool_result\", {\n196\t      payload: { toolCallId: \"call-ms-1\", content: \"contents of a.txt\", isError: false },\n197\t    }),\n198\t    validEvent(\"turn_end\"),\n199\t    validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n200\t    validEvent(\"turn_end\"),\n201\t  ]);\n202\t  const derivedAt = \"2026-06-10T12:00:00.000Z\";\n203\t  setFormState(\n204\t    filePath,\n205\t    { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n206\t    { state: \"ready\", content: \"smoothed(fixture:first prompt)\", derivedAt },\n207\t  );\n208\t  // Tool-activity outcome lives in machine-readable metadata, never inside\n209\t  // provider-authored content (FC-0.3).\n210\t  setFormState(\n211\t    filePath,\n212\t    { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\" },\n213\t    {\n214\t      state: \"ready\",\n215\t      content: \"toolresult(fixture:contents of a.txt)\",\n216\t      metadata: { outcome: \"succeeded\" },\n217\t      derivedAt,\n218\t    },\n219\t  );\n220\t  setFormState(\n221\t    filePath,\n222\t    { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n223\t    { state: \"failed\", reason: \"provider_failure: scripted exhaustion (fixture)\" },\n224\t  );\n225\t  setFormState(\n226\t    filePath,\n227\t    { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\" },\n228\t    { state: \"blocked\", reason: \"source_damaged: manufactured damage (fixture)\" },\n229\t  );\n230\t  return {\n231\t    filePath,\n232\t    expected: [\n233\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\", state: \"ready\" },\n234\t      { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\", state: \"ready\" },\n235\t      { subjectKind: \"message\", subjectId: \"m6\", form: \"smoothed_prompt\", state: \"pending\" },\n236\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\", state: \"failed\" },\n237\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\", state: \"pending\" },\n238\t      { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\", state: \"blocked\" },\n239\t      { subjectKind: \"turn\", subjectId: \"t2\", form: \"lower_band_projection\", state: \"pending\" },\n240\t    ],\n241\t  };\n242\t}\n243\t\n244\t// ── damaged-source thread (Epic 01 corruption definition) ────────\n245\t\n246\t// A closed turn with its turn_derivation work queued, then the Epic 01\n247\t// two-open-turns corruption — the damage a turn handler must find and the\n248\t// intake pipeline refuses (turn_state_corrupt).\n249\texport async function damagedSourceThread(\n250\t  store: TempStore,\n251\t): Promise<{ filePath: string; turnId: string }> {\n252\t  const { filePath, turnIds } = await threadWithClosedTurns(store, 1);\n253\t  // Open a second turn through real intake; the corruption writer then adds\n254\t  // another open row — two open turns, the Epic 01 invariant violation.\n255\t  await send(filePath, [validEvent(\"user_prompt\", { payload: { text: \"left open\" } })]);\n256\t  corruptTwoOpenTurns(filePath);\n257\t  const turnId = turnIds[0];\n258\t  if (turnId === undefined) throw new Error(\"fixture invariant: one closed turn expected\");\n259\t  return { filePath, turnId };\n260\t}\n261\t\n262\t// ── twin SDK/CLI threads for parity tests ────────────────────────\n263\t\n264\t// The same batch recorded through the SDK entry and the in-process CLI\n265\t// adapter, under one injected clock, so the two files are comparable\n266\t// record-for-record. Distinct idempotency-key spaces are unnecessary: keys\n267\t// scope per thread file.\n268\texport async function twinThreads(\n269\t  store: TempStore,\n270\t  batch?: readonly MessageEventInput[],\n271\t): Promise<{ sdkPath: string; cliPath: string; batch: readonly MessageEventInput[] }> {\n272\t  const events =\n273\t    batch ??\n274\t    ([\n275\t      validEvent(\"user_prompt\", { payload: { text: \"twin prompt\" } }),\n276\t      validEvent(\"assistant_text\", { payload: { text: \"twin answer\" } }),\n277\t      validEvent(\"tool_call\", {\n278\t        payload: { toolCallId: \"call-twin-1\", toolName: \"read_file\", arguments: { path: \"t.txt\" } },\n279\t      }),\n280\t      validEvent(\"tool_result\", {\n281\t        payload: { toolCallId: \"call-twin-1\", content: \"twin tool output\", isError: false },\n282\t      }),\n283\t      validEvent(\"turn_end\"),\n284\t    ] as const);\n285\t\n286\t  setIntakeClock(() => new Date(\"2026-06-10T12:00:00.000Z\"));\n287\t  try {\n288\t    const sdkPath = await newThreadFile(store);\n289\t    await send(sdkPath, events);\n290\t\n291\t    const cliPath = store.threadPath();\n292\t    const created = await runCli([\n293\t      \"threads\",\n294\t      \"new-thread\",\n295\t      \"--file-path\",\n296\t      cliPath,\n297\t      \"--registry\",\n298\t      store.registryPath,\n299\t    ]);\n300\t    if (created.exitCode !== 0) {\n301\t      throw new Error(`fixture CLI new-thread failed: ${created.stdout}`);\n302\t    }\n303\t    const recorded = await runCli(\n304\t      [\"intake-stream\", \"message-events\", \"--file-path\", cliPath],\n305\t      async () => JSON.stringify(events),\n306\t    );\n307\t    if (recorded.exitCode !== 0) {\n308\t      throw new Error(`fixture CLI message-events failed: ${recorded.stdout}`);\n309\t    }\n310\t    return { sdkPath, cliPath, batch: events };\n311\t  } finally {\n312\t    setIntakeClock(null);\n313\t  }\n314\t}\n315\t"}]},"parent_tool_use_id":null,"session_id":"b93e566a-c98e-4b05-8100-3f1a70ca0688","uuid":"88543be6-ec1e-42b2-9f38-2ac069282673","timestamp":"2026-06-11T03:38:07.480Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/threads.ts","content":"// Thread builders for Epic 02 (test plan §Test Substrate). All built through\n// real intake; the multi-state and damaged-source builders then apply the\n// sanctioned below-SDK writes for states the SDK cannot yet produce (drain\n// and handlers land in Stories 1–3) — Story 0 proves read-back of what the\n// builders wrote; Stories 2/4 confirm the states arise for real\n// (coverage.md cross-story debt).\nimport { DatabaseSync } from \"node:sqlite\";\nimport {\n  intakeStream,\n  runCli,\n  threads,\n  type DerivedForm,\n  type DerivedFormState,\n  type DependencyGap,\n  type FormKind,\n  type MessageEventInput,\n  type SubjectKind,\n  type ToolOutcome,\n} from \"../../src/index.js\";\nimport { setIntakeClock } from \"./intake-seam.js\";\nimport { corruptTwoOpenTurns } from \"./corrupt.js\";\nimport { validEvent, type TempStore } from \"./index.js\";\n\nasync function newThreadFile(store: TempStore): Promise<string> {\n  const filePath = store.threadPath();\n  const created = await threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nasync function send(filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n  const result = await intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n}\n\n// n closed turns, each prompt + assistant text + explicit end. Turn ids are\n// deterministic (t1..tn) per the turn store's id scheme.\nexport async function threadWithClosedTurns(\n  store: TempStore,\n  n: number,\n): Promise<{ filePath: string; turnIds: string[] }> {\n  const filePath = await newThreadFile(store);\n  const turnIds: string[] = [];\n  for (let i = 1; i <= n; i += 1) {\n    await send(filePath, [\n      validEvent(\"user_prompt\", { payload: { text: `prompt for turn ${i}` } }),\n      validEvent(\"assistant_text\", { payload: { text: `answer for turn ${i}` } }),\n      validEvent(\"turn_end\"),\n    ]);\n    turnIds.push(`t${i}`);\n  }\n  return { filePath, turnIds };\n}\n\n// One closed turn containing a tool run: call + result pair by default;\n// error and missing-result variants per the epic's outcome vocabulary.\nexport async function threadWithToolRun(\n  store: TempStore,\n  opts: { isError?: boolean; missingResult?: boolean; resultContent?: string } = {},\n): Promise<{ filePath: string; turnId: string }> {\n  const filePath = await newThreadFile(store);\n  const batch: MessageEventInput[] = [\n    validEvent(\"user_prompt\", { payload: { text: \"please run the tool\" } }),\n    validEvent(\"tool_call\", {\n      payload: { toolCallId: \"call-fixture-1\", toolName: \"read_file\", arguments: { path: \"notes.txt\" } },\n    }),\n  ];\n  if (opts.missingResult !== true) {\n    batch.push(\n      validEvent(\"tool_result\", {\n        payload: {\n          toolCallId: \"call-fixture-1\",\n          content: opts.resultContent ?? \"contents of notes.txt\",\n          isError: opts.isError ?? false,\n        },\n      }),\n    );\n  }\n  batch.push(validEvent(\"turn_end\"));\n  await send(filePath, batch);\n  return { filePath, turnId: \"t1\" };\n}\n\n// ── derived_form read-back and the sanctioned state writer ───────\n\ninterface RawFormRow {\n  subject_kind: string;\n  subject_id: string;\n  form: string;\n  state: string;\n  content: string | null;\n  reason: string | null;\n  metadata: string | null;\n  source_version: number | bigint;\n  gaps: string | null;\n  derived_at: string | null;\n}\n\nexport function readDerivedForms(filePath: string): DerivedForm[] {\n  const db = new DatabaseSync(filePath);\n  try {\n    const rows = db\n      .prepare(\n        `SELECT subject_kind, subject_id, form, state, content, reason, metadata,\n                source_version, gaps, derived_at\n         FROM derived_form ORDER BY subject_kind, subject_id, form`,\n      )\n      .all() as unknown as RawFormRow[];\n    return rows.map((row) => {\n      const record: DerivedForm = {\n        subjectKind: row.subject_kind as SubjectKind,\n        subjectId: row.subject_id,\n        form: row.form as FormKind,\n        state: row.state as DerivedFormState,\n        sourceVersion: Number(row.source_version),\n      };\n      if (row.content !== null) record.content = row.content;\n      if (row.reason !== null) record.reason = row.reason;\n      if (row.metadata !== null) {\n        record.metadata = JSON.parse(row.metadata) as { outcome?: ToolOutcome };\n      }\n      if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n      if (row.derived_at !== null) record.derivedAt = row.derived_at;\n      return record;\n    });\n  } finally {\n    db.close();\n  }\n}\n\n// Below-SDK state writer, sanctioned like corrupt.ts: ready/failed/blocked\n// are unreachable through the SDK until the drain (Story 1) and handlers\n// (Stories 2–3) land. UPDATE-only on purpose — the pending row exists from\n// enqueue, mirroring the production completion contract.\nexport function setFormState(\n  filePath: string,\n  target: { subjectKind: SubjectKind; subjectId: string; form: FormKind },\n  update: {\n    state: DerivedFormState;\n    content?: string;\n    reason?: string;\n    metadata?: { outcome?: ToolOutcome };\n    derivedAt?: string;\n  },\n): void {\n  const db = new DatabaseSync(filePath);\n  try {\n    const changed = db\n      .prepare(\n        `UPDATE derived_form\n         SET state = ?, content = ?, reason = ?, metadata = ?, derived_at = ?\n         WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n      )\n      .run(\n        update.state,\n        update.content ?? null,\n        update.reason ?? null,\n        update.metadata === undefined ? null : JSON.stringify(update.metadata),\n        update.derivedAt ?? null,\n        target.subjectKind,\n        target.subjectId,\n        target.form,\n      );\n    if (Number(changed.changes) !== 1) {\n      throw new Error(\n        `fixture setFormState hit ${String(changed.changes)} rows for ${target.subjectKind}/${target.subjectId}/${target.form}; expected the pending row from enqueue`,\n      );\n    }\n  } finally {\n    db.close();\n  }\n}\n\n// ── multi-state thread: every form state in one file ─────────────\n\nexport interface MultiStateClaim {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n  state: DerivedFormState;\n}\n\nexport async function multiStateThread(\n  store: TempStore,\n): Promise<{ filePath: string; expected: MultiStateClaim[] }> {\n  const filePath = await newThreadFile(store);\n  // Turn 1: prompt + tool run; turn 2: prompt. Intake's enqueue leaves every\n  // form pending; the writes below move a subset into the other three states.\n  await send(filePath, [\n    validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n    validEvent(\"assistant_text\", { payload: { text: \"working on it\" } }),\n    validEvent(\"tool_call\", {\n      payload: { toolCallId: \"call-ms-1\", toolName: \"read_file\", arguments: { path: \"a.txt\" } },\n    }),\n    validEvent(\"tool_result\", {\n      payload: { toolCallId: \"call-ms-1\", content: \"contents of a.txt\", isError: false },\n    }),\n    validEvent(\"turn_end\"),\n    validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n    validEvent(\"turn_end\"),\n  ]);\n  const derivedAt = \"2026-06-10T12:00:00.000Z\";\n  setFormState(\n    filePath,\n    { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n    { state: \"ready\", content: \"smoothed(fixture:first prompt)\", derivedAt },\n  );\n  // Tool-activity outcome lives in machine-readable metadata, never inside\n  // provider-authored content (FC-0.3).\n  setFormState(\n    filePath,\n    { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\" },\n    {\n      state: \"ready\",\n      content: \"toolresult(fixture:contents of a.txt)\",\n      metadata: { outcome: \"succeeded\" },\n      derivedAt,\n    },\n  );\n  setFormState(\n    filePath,\n    { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n    { state: \"failed\", reason: \"provider_failure: scripted exhaustion (fixture)\" },\n  );\n  setFormState(\n    filePath,\n    { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\" },\n    { state: \"blocked\", reason: \"source_damaged: manufactured damage (fixture)\" },\n  );\n  return {\n    filePath,\n    expected: [\n      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\", state: \"ready\" },\n      { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\", state: \"ready\" },\n      { subjectKind: \"message\", subjectId: \"m6\", form: \"smoothed_prompt\", state: \"pending\" },\n      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\", state: \"failed\" },\n      { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\", state: \"pending\" },\n      { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\", state: \"blocked\" },\n      { subjectKind: \"turn\", subjectId: \"t2\", form: \"lower_band_projection\", state: \"pending\" },\n    ],\n  };\n}\n\n// ── damaged-source thread (Epic 01 corruption definition) ────────\n\n// A closed turn with its turn_derivation work queued, then the Epic 01\n// two-open-turns corruption — the damage a turn handler must find and the\n// intake pipeline refuses (turn_state_corrupt).\nexport async function damagedSourceThread(\n  store: TempStore,\n): Promise<{ filePath: string; turnId: string }> {\n  const { filePath, turnIds } = await threadWithClosedTurns(store, 1);\n  // Open a second turn through real intake; the corruption writer then adds\n  // another open row — two open turns, the Epic 01 invariant violation.\n  await send(filePath, [validEvent(\"user_prompt\", { payload: { text: \"left open\" } })]);\n  corruptTwoOpenTurns(filePath);\n  const turnId = turnIds[0];\n  if (turnId === undefined) throw new Error(\"fixture invariant: one closed turn expected\");\n  return { filePath, turnId };\n}\n\n// ── twin SDK/CLI threads for parity tests ────────────────────────\n\n// The same batch recorded through the SDK entry and the in-process CLI\n// adapter, under one injected clock, so the two files are comparable\n// record-for-record. Distinct idempotency-key spaces are unnecessary: keys\n// scope per thread file.\nexport async function twinThreads(\n  store: TempStore,\n  batch?: readonly MessageEventInput[],\n): Promise<{ sdkPath: string; cliPath: string; batch: readonly MessageEventInput[] }> {\n  const events =\n    batch ??\n    ([\n      validEvent(\"user_prompt\", { payload: { text: \"twin prompt\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"twin answer\" } }),\n      validEvent(\"tool_call\", {\n        payload: { toolCallId: \"call-twin-1\", toolName: \"read_file\", arguments: { path: \"t.txt\" } },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"call-twin-1\", content: \"twin tool output\", isError: false },\n      }),\n      validEvent(\"turn_end\"),\n    ] as const);\n\n  setIntakeClock(() => new Date(\"2026-06-10T12:00:00.000Z\"));\n  try {\n    const sdkPath = await newThreadFile(store);\n    await send(sdkPath, events);\n\n    const cliPath = store.threadPath();\n    const created = await runCli([\n      \"threads\",\n      \"new-thread\",\n      \"--file-path\",\n      cliPath,\n      \"--registry\",\n      store.registryPath,\n    ]);\n    if (created.exitCode !== 0) {\n      throw new Error(`fixture CLI new-thread failed: ${created.stdout}`);\n    }\n    const recorded = await runCli(\n      [\"intake-stream\", \"message-events\", \"--file-path\", cliPath],\n      async () => JSON.stringify(events),\n    );\n    if (recorded.exitCode !== 0) {\n      throw new Error(`fixture CLI message-events failed: ${recorded.stdout}`);\n    }\n    return { sdkPath, cliPath, batch: events };\n  } finally {\n    setIntakeClock(null);\n  }\n}\n","numLines":315,"startLine":1,"totalLines":315}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018tiEB7e7tsyy6hFVV2TCDi","type":"tool_result","content":"1\t// Epic 02 shared vocabulary: the derived-form state machine's types, the\n2\t// provider seam, and the handler contract. Both owning domains (messages,\n3\t// turns) consume these; neither owns them — the repair report, the mutation\n4\t// cascade, and the drain all speak this vocabulary across domain lines, so it\n5\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\n6\timport type { DatabaseSync } from \"node:sqlite\";\n7\t\n8\texport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n9\t\n10\texport type FormKind =\n11\t  | \"smoothed_prompt\"\n12\t  | \"tool_call_summary\"\n13\t  | \"tool_result_summary\"\n14\t  | \"turn_rendering\"\n15\t  | \"lower_band_projection\"\n16\t  | \"chunk_summary_detailed\"\n17\t  | \"chunk_summary_brief\";\n18\t\n19\texport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n20\t\n21\t// Outcome on tool-activity summaries — mechanically stamped from the record\n22\t// (isError/presence), never authored by the provider (AC-2.4).\n23\texport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n24\t\n25\t// A composed form's record of a dependency that fell back during composition:\n26\t// names the source record and the form that was not ready (AC-3.2/3.3).\n27\texport interface DependencyGap {\n28\t  subjectKind: SubjectKind;\n29\t  subjectId: string;\n30\t  form: FormKind;\n31\t}\n32\t\n33\t// The read shape for one derived form's state row (DD-2, DD-3).\n34\texport interface DerivedForm {\n35\t  subjectKind: SubjectKind;\n36\t  subjectId: string;\n37\t  form: FormKind;\n38\t  state: DerivedFormState;\n39\t  content?: string; // ready only\n40\t  reason?: string; // failed | blocked\n41\t  sourceVersion: number; // which version of the source this form derives from (DD-3)\n42\t  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n43\t  metadata?: { outcome?: ToolOutcome }; // mechanically stamped fields; never provider-authored\n44\t  derivedAt?: string;\n45\t}\n46\t\n47\t// ── provider seam (DD-7) ─────────────────────────────────────────\n48\t// Every operation returns content or a structured failure carrying\n49\t// retryable-or-not; classification is the adapter's duty.\n50\texport type ProviderResult =\n51\t  | { ok: true; text: string }\n52\t  | { ok: false; retryable: boolean; reason: string };\n53\t\n54\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n55\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n56\t// rather than imported: shared/ may not import domains/.\n57\texport type RenderingPartKind =\n58\t  | \"user_prompt\"\n59\t  | \"assistant_text\"\n60\t  | \"assistant_thinking\"\n61\t  | \"runtime_note\"\n62\t  | \"tool_call\"\n63\t  | \"tool_result\";\n64\t\n65\texport interface RenderingPart {\n66\t  messageId: string;\n67\t  kind: RenderingPartKind;\n68\t  text: string; // ready form content, or raw/truncated fallback\n69\t  fallback: boolean; // true ⇒ gap recorded\n70\t  outcome?: ToolOutcome; // tool activity only\n71\t}\n72\t\n73\texport interface DerivationProvider {\n74\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n75\t  summarizeToolCall(i: {\n76\t    toolName: string;\n77\t    argsJson: string;\n78\t    pairedResult?: { content: string; isError: boolean };\n79\t  }): Promise<ProviderResult>;\n80\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n81\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n82\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n83\t  summarizeChunkDetailed(i: { memberProjections: string[] }): Promise<ProviderResult>;\n84\t  summarizeChunkBrief(i: { memberProjections: string[] }): Promise<ProviderResult>;\n85\t}\n86\t\n87\texport const PROVIDER_OPERATIONS = [\n88\t  \"smoothPrompt\",\n89\t  \"summarizeToolCall\",\n90\t  \"summarizeToolResult\",\n91\t  \"composeTurnRendering\",\n92\t  \"projectLowerBand\",\n93\t  \"summarizeChunkDetailed\",\n94\t  \"summarizeChunkBrief\",\n95\t] as const;\n96\t\n97\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n98\t\n99\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n100\texport interface SdkConfig {\n101\t  provider: DerivationProvider;\n102\t  mode: \"background\" | \"manual\";\n103\t  clock?: () => Date;\n104\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n105\t  lease?: { durationMs: number }; // 120000\n106\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n107\t}\n108\t\n109\t// Every optional filled by createSdk's central defaults.\n110\texport interface ResolvedSdkConfig {\n111\t  provider: DerivationProvider;\n112\t  mode: \"background\" | \"manual\";\n113\t  clock: () => Date;\n114\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n115\t  lease: { durationMs: number };\n116\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n117\t}\n118\t\n119\t// ── handler contract (DD-6; the map's value type) ────────────────\n120\texport interface HandlerRunContext {\n121\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n122\t  provider: DerivationProvider;\n123\t  clock: () => Date;\n124\t  config: ResolvedSdkConfig;\n125\t}\n126\t\n127\texport type HandlerOutcome =\n128\t  | { ok: true } // forms written by handler, version-checked\n129\t  | { ok: false; retryable: boolean; reason: string }\n130\t  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n131\t\n132\t// item is the queue util's WorkItemRecord; typed structurally here so the\n133\t// shared layer does not depend on the util's module (and vice versa stays\n134\t// one-directional: tech-utils imports shared).\n135\texport type WorkHandler = (\n136\t  run: HandlerRunContext,\n137\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n138\t) => Promise<HandlerOutcome>;\n139\t"}]},"parent_tool_use_id":null,"session_id":"b93e566a-c98e-4b05-8100-3f1a70ca0688","uuid":"3cd0ca87-9ffe-400d-a6b1-a7337915b57f","timestamp":"2026-06-11T03:33:13.583Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/derivation.ts","content":"// Epic 02 shared vocabulary: the derived-form state machine's types, the\n// provider seam, and the handler contract. Both owning domains (messages,\n// turns) consume these; neither owns them — the repair report, the mutation\n// cascade, and the drain all speak this vocabulary across domain lines, so it\n// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\nimport type { DatabaseSync } from \"node:sqlite\";\n\nexport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n\nexport type FormKind =\n  | \"smoothed_prompt\"\n  | \"tool_call_summary\"\n  | \"tool_result_summary\"\n  | \"turn_rendering\"\n  | \"lower_band_projection\"\n  | \"chunk_summary_detailed\"\n  | \"chunk_summary_brief\";\n\nexport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n\n// Outcome on tool-activity summaries — mechanically stamped from the record\n// (isError/presence), never authored by the provider (AC-2.4).\nexport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n\n// A composed form's record of a dependency that fell back during composition:\n// names the source record and the form that was not ready (AC-3.2/3.3).\nexport interface DependencyGap {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n}\n\n// The read shape for one derived form's state row (DD-2, DD-3).\nexport interface DerivedForm {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n  state: DerivedFormState;\n  content?: string; // ready only\n  reason?: string; // failed | blocked\n  sourceVersion: number; // which version of the source this form derives from (DD-3)\n  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n  metadata?: { outcome?: ToolOutcome }; // mechanically stamped fields; never provider-authored\n  derivedAt?: string;\n}\n\n// ── provider seam (DD-7) ─────────────────────────────────────────\n// Every operation returns content or a structured failure carrying\n// retryable-or-not; classification is the adapter's duty.\nexport type ProviderResult =\n  | { ok: true; text: string }\n  | { ok: false; retryable: boolean; reason: string };\n\n// Message kinds a rendering part can carry — mirrors the intake event-kind\n// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n// rather than imported: shared/ may not import domains/.\nexport type RenderingPartKind =\n  | \"user_prompt\"\n  | \"assistant_text\"\n  | \"assistant_thinking\"\n  | \"runtime_note\"\n  | \"tool_call\"\n  | \"tool_result\";\n\nexport interface RenderingPart {\n  messageId: string;\n  kind: RenderingPartKind;\n  text: string; // ready form content, or raw/truncated fallback\n  fallback: boolean; // true ⇒ gap recorded\n  outcome?: ToolOutcome; // tool activity only\n}\n\nexport interface DerivationProvider {\n  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n  summarizeToolCall(i: {\n    toolName: string;\n    argsJson: string;\n    pairedResult?: { content: string; isError: boolean };\n  }): Promise<ProviderResult>;\n  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n  summarizeChunkDetailed(i: { memberProjections: string[] }): Promise<ProviderResult>;\n  summarizeChunkBrief(i: { memberProjections: string[] }): Promise<ProviderResult>;\n}\n\nexport const PROVIDER_OPERATIONS = [\n  \"smoothPrompt\",\n  \"summarizeToolCall\",\n  \"summarizeToolResult\",\n  \"composeTurnRendering\",\n  \"projectLowerBand\",\n  \"summarizeChunkDetailed\",\n  \"summarizeChunkBrief\",\n] as const;\n\nexport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n\n// ── SDK assembly config (tech design §Interfaces) ────────────────\nexport interface SdkConfig {\n  provider: DerivationProvider;\n  mode: \"background\" | \"manual\";\n  clock?: () => Date;\n  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n  lease?: { durationMs: number }; // 120000\n  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n}\n\n// Every optional filled by createSdk's central defaults.\nexport interface ResolvedSdkConfig {\n  provider: DerivationProvider;\n  mode: \"background\" | \"manual\";\n  clock: () => Date;\n  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n  lease: { durationMs: number };\n  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n}\n\n// ── handler contract (DD-6; the map's value type) ────────────────\nexport interface HandlerRunContext {\n  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n  provider: DerivationProvider;\n  clock: () => Date;\n  config: ResolvedSdkConfig;\n}\n\nexport type HandlerOutcome =\n  | { ok: true } // forms written by handler, version-checked\n  | { ok: false; retryable: boolean; reason: string }\n  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n\n// item is the queue util's WorkItemRecord; typed structurally here so the\n// shared layer does not depend on the util's module (and vice versa stays\n// one-directional: tech-utils imports shared).\nexport type WorkHandler = (\n  run: HandlerRunContext,\n  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n) => Promise<HandlerOutcome>;\n","numLines":139,"startLine":1,"totalLines":139}}}

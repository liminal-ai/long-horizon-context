{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HnrEUhKEhvP7tMWVvA4zVH","type":"tool_result","content":"1\timport type { DatabaseSync } from \"node:sqlite\";\n2\t\n3\texport interface OperationContext {\n4\t  db: DatabaseSync; // open thread-file handle, inside the batch transaction\n5\t  clock: () => Date; // injected for deterministic recordedAt/queuedAt in tests\n6\t  threadId: string; // resolved identity of the thread being operated on\n7\t  // Post-commit callback registration (DD-5): the transaction owner flushes\n8\t  // the registered callbacks after its COMMIT succeeds and drops them on\n9\t  // rollback, so anything registered here — the scheduler poke above all —\n10\t  // is transactional by construction.\n11\t  onCommit: (fn: () => void) => void;\n12\t}\n13\t\n14\t// The callback list behind ctx.onCommit, owned by whoever owns the\n15\t// transaction. Flush after COMMIT; never call flush on a rollback path —\n16\t// dropping the hooks is simply not flushing them.\n17\texport interface CommitHooks {\n18\t  register: (fn: () => void) => void;\n19\t  flush: () => void;\n20\t}\n21\t\n22\texport function createCommitHooks(): CommitHooks {\n23\t  const callbacks: Array<() => void> = [];\n24\t  return {\n25\t    register: (fn) => {\n26\t      callbacks.push(fn);\n27\t    },\n28\t    flush: () => {\n29\t      for (const fn of callbacks.splice(0)) fn();\n30\t    },\n31\t  };\n32\t}\n33\t\n34\t// The scheduler poke seam (DD-5). The slot lives in shared/ so the queue\n35\t// util can fire it without importing the scheduler module (which will import\n36\t// domain handler tables from Story 1 on — a util→scheduler import would\n37\t// cycle). The scheduler installs itself here; in manual mode, or before any\n38\t// scheduler exists, firing is a no-op — onCommit still fires either way.\n39\ttype SchedulerPoke = (threadId: string) => void;\n40\tlet schedulerPoke: SchedulerPoke | null = null;\n41\t\n42\texport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n43\t  schedulerPoke = poke;\n44\t}\n45\t\n46\texport function fireSchedulerPoke(threadId: string): void {\n47\t  schedulerPoke?.(threadId);\n48\t}\n49\t\n50\t// Transaction owner for operations outside the intake pipeline (mutations,\n51\t// repair re-queues, tests of enqueue atomicity): BEGIN IMMEDIATE, run the\n52\t// body with a context whose onCommit registrations flush only after COMMIT\n53\t// succeeds and drop whole on rollback.\n54\texport function runInTransaction<T>(\n55\t  db: DatabaseSync,\n56\t  clock: () => Date,\n57\t  threadId: string,\n58\t  fn: (ctx: OperationContext) => T,\n59\t): T {\n60\t  const hooks = createCommitHooks();\n61\t  db.exec(\"BEGIN IMMEDIATE;\");\n62\t  let value: T;\n63\t  try {\n64\t    value = fn({ db, clock, threadId, onCommit: hooks.register });\n65\t    db.exec(\"COMMIT;\");\n66\t  } catch (cause) {\n67\t    db.exec(\"ROLLBACK;\");\n68\t    throw cause;\n69\t  }\n70\t  hooks.flush();\n71\t  return value;\n72\t}\n73\t"}]},"parent_tool_use_id":null,"session_id":"b93e566a-c98e-4b05-8100-3f1a70ca0688","uuid":"ce2c6c07-460f-413b-a882-b369ed665a98","timestamp":"2026-06-11T03:33:07.599Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/context.ts","content":"import type { DatabaseSync } from \"node:sqlite\";\n\nexport interface OperationContext {\n  db: DatabaseSync; // open thread-file handle, inside the batch transaction\n  clock: () => Date; // injected for deterministic recordedAt/queuedAt in tests\n  threadId: string; // resolved identity of the thread being operated on\n  // Post-commit callback registration (DD-5): the transaction owner flushes\n  // the registered callbacks after its COMMIT succeeds and drops them on\n  // rollback, so anything registered here — the scheduler poke above all —\n  // is transactional by construction.\n  onCommit: (fn: () => void) => void;\n}\n\n// The callback list behind ctx.onCommit, owned by whoever owns the\n// transaction. Flush after COMMIT; never call flush on a rollback path —\n// dropping the hooks is simply not flushing them.\nexport interface CommitHooks {\n  register: (fn: () => void) => void;\n  flush: () => void;\n}\n\nexport function createCommitHooks(): CommitHooks {\n  const callbacks: Array<() => void> = [];\n  return {\n    register: (fn) => {\n      callbacks.push(fn);\n    },\n    flush: () => {\n      for (const fn of callbacks.splice(0)) fn();\n    },\n  };\n}\n\n// The scheduler poke seam (DD-5). The slot lives in shared/ so the queue\n// util can fire it without importing the scheduler module (which will import\n// domain handler tables from Story 1 on — a util→scheduler import would\n// cycle). The scheduler installs itself here; in manual mode, or before any\n// scheduler exists, firing is a no-op — onCommit still fires either way.\ntype SchedulerPoke = (threadId: string) => void;\nlet schedulerPoke: SchedulerPoke | null = null;\n\nexport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n  schedulerPoke = poke;\n}\n\nexport function fireSchedulerPoke(threadId: string): void {\n  schedulerPoke?.(threadId);\n}\n\n// Transaction owner for operations outside the intake pipeline (mutations,\n// repair re-queues, tests of enqueue atomicity): BEGIN IMMEDIATE, run the\n// body with a context whose onCommit registrations flush only after COMMIT\n// succeeds and drop whole on rollback.\nexport function runInTransaction<T>(\n  db: DatabaseSync,\n  clock: () => Date,\n  threadId: string,\n  fn: (ctx: OperationContext) => T,\n): T {\n  const hooks = createCommitHooks();\n  db.exec(\"BEGIN IMMEDIATE;\");\n  let value: T;\n  try {\n    value = fn({ db, clock, threadId, onCommit: hooks.register });\n    db.exec(\"COMMIT;\");\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n  hooks.flush();\n  return value;\n}\n","numLines":73,"startLine":1,"totalLines":73}}}

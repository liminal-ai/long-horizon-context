{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0163nii2emXzuWgMxdiG8God","type":"tool_result","content":"1\t// Durable work-item mechanics: recording, ordered listing, and the enqueue\n2\t// wrapper that makes \"queueing is what schedules processing\" structural\n3\t// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n4\t// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n5\t// a turn or a summary is; which kinds queue for which sources, and which\n6\t// derived forms a kind produces, is the owning domains' business (callers\n7\t// pass the form targets in). Writes run on the caller's handle inside the\n8\t// ambient transaction, so items commit (or roll back) with the batch. No\n9\t// public SDK surface: read-back reaches here only through the owning\n10\t// domains' listQueuedWork.\n11\timport type { DatabaseSync } from \"node:sqlite\";\n12\timport { fireSchedulerPoke, type OperationContext } from \"../../shared/context.js\";\n13\timport type { FormKind, HandlerFormWrite, SubjectKind } from \"../../shared/derivation.js\";\n14\t\n15\texport type WorkOwner = \"messages\" | \"turns\";\n16\texport type WorkKind =\n17\t  | \"prompt_smoothing\"\n18\t  | \"tool_call_summary\"\n19\t  | \"tool_result_summary\"\n20\t  | \"turn_derivation\"\n21\t  | \"chunk_summary_detailed\"\n22\t  | \"chunk_summary_brief\";\n23\texport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n24\t\n25\t// The work-kind registry: owner and sourceRef semantics per the epic's Work\n26\t// Item contract. Mechanical metadata only — what a kind *means* stays with\n27\t// the owning domain's handler (registered at SDK construction, DD-6).\n28\texport const WORK_KIND_REGISTRY: Readonly<\n29\t  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n30\t> = {\n31\t  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n32\t  tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n33\t  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n34\t  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n35\t  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n36\t  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n37\t};\n38\t\n39\texport interface WorkItemRecord {\n40\t  workItemId: string;\n41\t  owner: WorkOwner;\n42\t  kind: WorkKind;\n43\t  sourceRef: WorkSourceRef;\n44\t  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n45\t  queuedAt: string;\n46\t}\n47\t\n48\t// The derived forms an enqueue is scheduling work toward; the owning domain\n49\t// names them (the util stays meaning-blind). Stored in the row's payload so\n50\t// the drain's terminal paths (retry exhaustion, blocked source) can land the\n51\t// form's failed/blocked state without asking any domain what a kind means.\n52\texport interface EnqueueFormTarget {\n53\t  subjectKind: SubjectKind;\n54\t  subjectId: string;\n55\t  form: FormKind;\n56\t}\n57\t\n58\texport interface WorkItemInput {\n59\t  owner: WorkOwner;\n60\t  kind: WorkKind;\n61\t  sourceRef: WorkSourceRef;\n62\t  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n63\t  forms?: readonly EnqueueFormTarget[]; // carried in payload for the drain's terminal paths\n64\t}\n65\t\n66\tfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n67\t  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n68\t  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n69\t  return sourceRef.chunkId;\n70\t}\n71\t\n72\t// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n73\t// same kind for the same source *at the same version* is the same id —\n74\t// natural idempotency for the repair path — while a post-mutation\n75\t// replacement (next version) never collides with an in-flight pre-mutation\n76\t// item.\n77\texport function recordItem(\n78\t  db: DatabaseSync,\n79\t  input: WorkItemInput,\n80\t  queuedAt: string,\n81\t): WorkItemRecord {\n82\t  const sourceVersion = input.sourceVersion ?? 1;\n83\t  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n84\t  db.prepare(\n85\t    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n86\t     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n87\t  ).run(\n88\t    workItemId,\n89\t    input.owner,\n90\t    input.kind,\n91\t    JSON.stringify(input.sourceRef),\n92\t    queuedAt,\n93\t    JSON.stringify({ sourceVersion, forms: input.forms ?? [] }),\n94\t  );\n95\t  return {\n96\t    workItemId,\n97\t    owner: input.owner,\n98\t    kind: input.kind,\n99\t    sourceRef: input.sourceRef,\n100\t    status: \"queued\",\n101\t    queuedAt,\n102\t  };\n103\t}\n104\t\n105\texport interface EnqueueInput extends WorkItemInput {\n106\t  forms: readonly EnqueueFormTarget[];\n107\t}\n108\t\n109\t// The one way work is scheduled (DD-5): the work row, the form's `pending`\n110\t// state row, and the scheduler poke all ride the ambient transaction — they\n111\t// commit together or vanish together. Enqueue is the *only* place a\n112\t// derived_form row is created (completion is UPDATE-only); re-enqueueing\n113\t// resets an existing row to pending at the enqueued source version.\n114\texport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n115\t  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n116\t  const sourceVersion = input.sourceVersion ?? 1;\n117\t  const upsert = ctx.db.prepare(\n118\t    `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n119\t     VALUES (?, ?, ?, 'pending', ?)\n120\t     ON CONFLICT (subject_kind, subject_id, form) DO UPDATE SET\n121\t       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n122\t       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n123\t  );\n124\t  for (const target of input.forms) {\n125\t    upsert.run(target.subjectKind, target.subjectId, target.form, sourceVersion);\n126\t  }\n127\t  ctx.onCommit(() => fireSchedulerPoke(ctx.threadId));\n128\t  return item;\n129\t}\n130\t\n131\tinterface RawWorkItemRow {\n132\t  work_item_id: string;\n133\t  owner: string;\n134\t  kind: string;\n135\t  source_ref: string;\n136\t  queued_at: string;\n137\t}\n138\t\n139\t// ── claim mechanics (Epic 02 Story 1, tech design §Mechanics) ─────\n140\t// All pure SQL against the caller's open handle, domain-blind. Claim,\n141\t// complete, and the terminal half of failAttempt each own one short\n142\t// BEGIN IMMEDIATE; the handler in between runs with no open transaction.\n143\t\n144\t// The claimed row as the drain holds it: mechanical fields plus the payload's\n145\t// source version and form targets. `kind` is a plain string here — a raw row\n146\t// with an unregistered kind must still be claimable so the drain can land it\n147\t// failed_terminal instead of skipping it (AC-1.8).\n148\texport interface ClaimedWorkItem {\n149\t  workItemId: string;\n150\t  owner: WorkOwner;\n151\t  kind: string;\n152\t  sourceRef: WorkSourceRef;\n153\t  attempts: number;\n154\t  queuedAt: string;\n155\t  sourceVersion: number;\n156\t  forms: EnqueueFormTarget[];\n157\t}\n158\t\n159\texport type ClaimOutcome =\n160\t  | { outcome: \"claimed\"; item: ClaimedWorkItem }\n161\t  | { outcome: \"empty\" }\n162\t  | { outcome: \"in_flight\"; claimExpiresAt: string }\n163\t  | { outcome: \"waiting\"; waitingUntil: string };\n164\t\n165\tinterface RawClaimRow {\n166\t  work_item_id: string;\n167\t  owner: string;\n168\t  kind: string;\n169\t  source_ref: string;\n170\t  attempts: number | bigint;\n171\t  queued_at: string;\n172\t  payload: string | null;\n173\t}\n174\t\n175\t// Form targets for pre-v5 rows, whose payload is NULL (Epic 01 wrote no\n176\t// payload column). Exactly the F-02 backfill's kind→form mapping (migration\n177\t// v5, shared/storage.ts): the backfill created pending derived_form rows at\n178\t// source version 1 for these kinds, and a terminal failure must find them —\n179\t// otherwise exhaustion would delete the work row and strand the backfilled\n180\t// form as pending forever, breaking AC-1.9/DD-1 for upgraded threads.\n181\tconst LEGACY_KIND_FORMS: Partial<\n182\t  Record<string, ReadonlyArray<{ subjectKind: SubjectKind; form: FormKind }>>\n183\t> = {\n184\t  prompt_smoothing: [{ subjectKind: \"message\", form: \"smoothed_prompt\" }],\n185\t  tool_result_summary: [{ subjectKind: \"message\", form: \"tool_result_summary\" }],\n186\t  turn_derivation: [\n187\t    { subjectKind: \"turn\", form: \"turn_rendering\" },\n188\t    { subjectKind: \"turn\", form: \"lower_band_projection\" },\n189\t  ],\n190\t};\n191\t\n192\tfunction legacyFormTargets(kind: string, sourceRef: WorkSourceRef): EnqueueFormTarget[] {\n193\t  const mapped = LEGACY_KIND_FORMS[kind];\n194\t  if (mapped === undefined) return [];\n195\t  const subjectId = sourceIdOf(sourceRef);\n196\t  return mapped.map((target) => ({ ...target, subjectId }));\n197\t}\n198\t\n199\tfunction toClaimedItem(row: RawClaimRow): ClaimedWorkItem {\n200\t  const sourceRef = JSON.parse(row.source_ref) as WorkSourceRef;\n201\t  const payload =\n202\t    row.payload === null\n203\t      ? // Pre-v5 row: version 1 (matching the backfill) and form targets\n204\t        // reconstructed from the backfill's own mapping.\n205\t        { sourceVersion: 1, forms: legacyFormTargets(row.kind, sourceRef) }\n206\t      : (JSON.parse(row.payload) as { sourceVersion?: number; forms?: EnqueueFormTarget[] });\n207\t  return {\n208\t    workItemId: row.work_item_id,\n209\t    owner: row.owner as WorkOwner,\n210\t    kind: row.kind,\n211\t    sourceRef,\n212\t    attempts: Number(row.attempts),\n213\t    queuedAt: row.queued_at,\n214\t    sourceVersion: payload.sourceVersion ?? 1,\n215\t    forms: payload.forms ?? [],\n216\t  };\n217\t}\n218\t\n219\t// Head-first, never skip-ahead: the claim decision is made against the oldest\n220\t// live row only — a later eligible row is never considered while an older\n221\t// live row exists. One atomic UPDATE under BEGIN IMMEDIATE (no read-then-\n222\t// write split: the race window is the bug class). The CASE increments\n223\t// `attempts` only when reclaiming an expired claimed row — a reclaim means a\n224\t// run died or hung, and the increment makes the crash visible in the report\n225\t// and counts it against the retry budget; normal claims never touch it.\n226\texport function claimNext(db: DatabaseSync, now: string, leaseDurationMs: number): ClaimOutcome {\n227\t  const expiresAt = new Date(Date.parse(now) + leaseDurationMs).toISOString();\n228\t  db.exec(\"BEGIN IMMEDIATE;\");\n229\t  try {\n230\t    const claimed = db\n231\t      .prepare(\n232\t        `UPDATE work_item SET status = 'claimed', claimed_at = ?, claim_expires_at = ?,\n233\t           attempts = attempts + CASE WHEN status = 'claimed' THEN 1 ELSE 0 END\n234\t         WHERE work_item_id = (\n235\t           SELECT work_item_id FROM (\n236\t             SELECT work_item_id, status, eligible_at, claim_expires_at\n237\t             FROM work_item WHERE status IN ('queued', 'claimed')\n238\t             ORDER BY rowid LIMIT 1\n239\t           )\n240\t           WHERE (status = 'queued' AND (eligible_at IS NULL OR eligible_at <= ?))\n241\t              OR (status = 'claimed' AND claim_expires_at <= ?)\n242\t         )\n243\t         RETURNING work_item_id, owner, kind, source_ref, attempts, queued_at, payload`,\n244\t      )\n245\t      .get(now, expiresAt, now, now) as unknown as RawClaimRow | undefined;\n246\t    if (claimed !== undefined) {\n247\t      db.exec(\"COMMIT;\");\n248\t      return { outcome: \"claimed\", item: toClaimedItem(claimed) };\n249\t    }\n250\t    // No row claimable: re-read the head inside the same transaction to\n251\t    // classify the stop. A claimed head with a live lease gates the queue\n252\t    // (in_flight, AC-1.4); a queued head still backing off gates it too\n253\t    // (waiting) — strict ordering, never reordered around the head.\n254\t    const head = db\n255\t      .prepare(\n256\t        `SELECT status, eligible_at, claim_expires_at\n257\t         FROM work_item WHERE status IN ('queued', 'claimed')\n258\t         ORDER BY rowid LIMIT 1`,\n259\t      )\n260\t      .get() as unknown as\n261\t      | { status: string; eligible_at: string | null; claim_expires_at: string | null }\n262\t      | undefined;\n263\t    db.exec(\"COMMIT;\");\n264\t    if (head === undefined) return { outcome: \"empty\" };\n265\t    if (head.status === \"claimed\") {\n266\t      return { outcome: \"in_flight\", claimExpiresAt: head.claim_expires_at ?? \"\" };\n267\t    }\n268\t    return { outcome: \"waiting\", waitingUntil: head.eligible_at ?? \"\" };\n269\t  } catch (cause) {\n270\t    db.exec(\"ROLLBACK;\");\n271\t    throw cause;\n272\t  }\n273\t}\n274\t\n275\t// Completion: the version-checked form writes and the item row's deletion in\n276\t// one short transaction (DD-1: terminal transition deletes the row; the\n277\t// disposition is reported in-memory, never stored). UPDATE-only, never\n278\t// upsert — the pending row exists from enqueue; a write that finds no row at\n279\t// the item's source version is discarded as stale (DD-3 truth table).\n280\texport function complete(\n281\t  db: DatabaseSync,\n282\t  item: ClaimedWorkItem,\n283\t  writes: readonly HandlerFormWrite[],\n284\t  derivedAt: string,\n285\t): \"done\" | \"stale_discarded\" {\n286\t  db.exec(\"BEGIN IMMEDIATE;\");\n287\t  try {\n288\t    let hits = 0;\n289\t    const update = db.prepare(\n290\t      `UPDATE derived_form\n291\t       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = ?, derived_at = ?\n292\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n293\t    );\n294\t    for (const write of writes) {\n295\t      const changed = update.run(\n296\t        write.content,\n297\t        write.metadata === undefined ? null : JSON.stringify(write.metadata),\n298\t        write.gaps === undefined ? null : JSON.stringify(write.gaps),\n299\t        derivedAt,\n300\t        write.subjectKind,\n301\t        write.subjectId,\n302\t        write.form,\n303\t        item.sourceVersion,\n304\t      );\n305\t      hits += Number(changed.changes);\n306\t    }\n307\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n308\t    db.exec(\"COMMIT;\");\n309\t    return writes.length > 0 && hits === 0 ? \"stale_discarded\" : \"done\";\n310\t  } catch (cause) {\n311\t    db.exec(\"ROLLBACK;\");\n312\t    throw cause;\n313\t  }\n314\t}\n315\t\n316\texport interface RetryPolicy {\n317\t  budget: number;\n318\t  backoffBaseMs: number;\n319\t  backoffCapMs: number;\n320\t}\n321\t\n322\texport type FailAttemptResult =\n323\t  | { terminal: false; attempts: number; eligibleAt: string }\n324\t  | { terminal: true; attempts: number };\n325\t\n326\t// Terminal failure: the form rows land `failed` (or `blocked` for source\n327\t// damage) carrying the final reason plus attempts/last-error copied onto the\n328\t// form's metadata, and the item row is deleted — one transaction (DD-1).\n329\t// Form writes stay version-checked: if a mutation moved the source since this\n330\t// item was queued, the stale failure must not stamp the rebuilt form.\n331\texport function failTerminal(\n332\t  db: DatabaseSync,\n333\t  item: ClaimedWorkItem,\n334\t  opts: { reason: string; formState: \"failed\" | \"blocked\"; attempts: number; now: string },\n335\t): void {\n336\t  db.exec(\"BEGIN IMMEDIATE;\");\n337\t  try {\n338\t    const update = db.prepare(\n339\t      `UPDATE derived_form\n340\t       SET state = ?, content = NULL, reason = ?, metadata = ?, gaps = NULL, derived_at = ?\n341\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n342\t    );\n343\t    const metadata = JSON.stringify({ attempts: opts.attempts, lastError: opts.reason });\n344\t    for (const target of item.forms) {\n345\t      update.run(\n346\t        opts.formState,\n347\t        opts.reason,\n348\t        metadata,\n349\t        opts.now,\n350\t        target.subjectKind,\n351\t        target.subjectId,\n352\t        target.form,\n353\t        item.sourceVersion,\n354\t      );\n355\t    }\n356\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n357\t    db.exec(\"COMMIT;\");\n358\t  } catch (cause) {\n359\t    db.exec(\"ROLLBACK;\");\n360\t    throw cause;\n361\t  }\n362\t}\n363\t\n364\t// A failed run counts itself. Under budget and retryable: the row goes back\n365\t// to `queued` with attempts incremented and eligibility pushed out by backoff\n366\t// (min(base × 2^attempts, cap)) — retry is not a status (DD-1). At budget, or\n367\t// on a non-retryable failure, the item is terminal: form `failed` with the\n368\t// final reason, row deleted (AC-1.9).\n369\texport function failAttempt(\n370\t  db: DatabaseSync,\n371\t  item: ClaimedWorkItem,\n372\t  opts: { reason: string; retryable: boolean; now: string; retry: RetryPolicy },\n373\t): FailAttemptResult {\n374\t  const attempts = item.attempts + 1;\n375\t  if (opts.retryable && attempts < opts.retry.budget) {\n376\t    const backoffMs = Math.min(\n377\t      opts.retry.backoffBaseMs * 2 ** attempts,\n378\t      opts.retry.backoffCapMs,\n379\t    );\n380\t    const eligibleAt = new Date(Date.parse(opts.now) + backoffMs).toISOString();\n381\t    db.exec(\"BEGIN IMMEDIATE;\");\n382\t    try {\n383\t      db.prepare(\n384\t        `UPDATE work_item\n385\t         SET status = 'queued', attempts = ?, last_error = ?,\n386\t             claimed_at = NULL, claim_expires_at = NULL, eligible_at = ?\n387\t         WHERE work_item_id = ?`,\n388\t      ).run(attempts, opts.reason, eligibleAt, item.workItemId);\n389\t      db.exec(\"COMMIT;\");\n390\t    } catch (cause) {\n391\t      db.exec(\"ROLLBACK;\");\n392\t      throw cause;\n393\t    }\n394\t    return { terminal: false, attempts, eligibleAt };\n395\t  }\n396\t  failTerminal(db, item, { reason: opts.reason, formState: \"failed\", attempts, now: opts.now });\n397\t  return { terminal: true, attempts };\n398\t}\n399\t\n400\t// Cascade tidy (tech design issue 1): delete still-queued items for the given\n401\t// (kind, sourceRef) targets, returning the deleted ids for the mutation\n402\t// result's `superseded` list. Runs inside the caller's ambient transaction —\n403\t// the cascade owns the BEGIN/COMMIT — so no transaction is opened here.\n404\t// Claimed items are deliberately left alone: the source-version check (DD-3)\n405\t// discards their stale completions. Ships here as mechanics; its only caller\n406\t// is Story 5's cascade.\n407\texport function supersedeQueued(\n408\t  db: DatabaseSync,\n409\t  targets: ReadonlyArray<{ kind: WorkKind; sourceRef: WorkSourceRef }>,\n410\t): string[] {\n411\t  const ids: string[] = [];\n412\t  const remove = db.prepare(\n413\t    `DELETE FROM work_item WHERE status = 'queued' AND kind = ? AND source_ref = ?\n414\t     RETURNING work_item_id`,\n415\t  );\n416\t  for (const target of targets) {\n417\t    const rows = remove.all(target.kind, JSON.stringify(target.sourceRef)) as unknown as Array<{\n418\t      work_item_id: string;\n419\t    }>;\n420\t    for (const row of rows) ids.push(row.work_item_id);\n421\t  }\n422\t  return ids;\n423\t}\n424\t\n425\t// Live items left in the queue — the drain report's `remaining` and the\n426\t// repair report's join source (Story 4).\n427\texport function countLiveItems(db: DatabaseSync): number {\n428\t  const row = db\n429\t    .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE status IN ('queued', 'claimed')`)\n430\t    .get() as unknown as { n: number | bigint };\n431\t  return Number(row.n);\n432\t}\n433\t\n434\texport interface QueueDetailRow {\n435\t  workItemId: string;\n436\t  owner: WorkOwner;\n437\t  kind: string;\n438\t  sourceRef: WorkSourceRef;\n439\t  status: \"queued\" | \"claimed\";\n440\t  attempts: number;\n441\t  lastError?: string;\n442\t  eligibleAt?: string;\n443\t  claimedAt?: string;\n444\t  claimExpiresAt?: string;\n445\t  queuedAt: string;\n446\t  sourceVersion: number;\n447\t}\n448\t\n449\t// Mechanical detail of every live row in queue order — what the repair\n450\t// report joins against derived_form (Flow 4) and what tests read to assert\n451\t// lease/backoff state without raw SQL at every call site.\n452\texport function queueDetail(db: DatabaseSync): QueueDetailRow[] {\n453\t  const rows = db\n454\t    .prepare(\n455\t      `SELECT work_item_id, owner, kind, source_ref, status, attempts, last_error,\n456\t              eligible_at, claimed_at, claim_expires_at, queued_at, payload\n457\t       FROM work_item ORDER BY rowid`,\n458\t    )\n459\t    .all() as unknown as Array<\n460\t    RawClaimRow & {\n461\t      status: string;\n462\t      last_error: string | null;\n463\t      eligible_at: string | null;\n464\t      claimed_at: string | null;\n465\t      claim_expires_at: string | null;\n466\t    }\n467\t  >;\n468\t  return rows.map((row) => {\n469\t    const item = toClaimedItem(row);\n470\t    const detail: QueueDetailRow = {\n471\t      workItemId: item.workItemId,\n472\t      owner: item.owner,\n473\t      kind: item.kind,\n474\t      sourceRef: item.sourceRef,\n475\t      status: row.status as \"queued\" | \"claimed\",\n476\t      attempts: item.attempts,\n477\t      queuedAt: item.queuedAt,\n478\t      sourceVersion: item.sourceVersion,\n479\t    };\n480\t    if (row.last_error !== null) detail.lastError = row.last_error;\n481\t    if (row.eligible_at !== null) detail.eligibleAt = row.eligible_at;\n482\t    if (row.claimed_at !== null) detail.claimedAt = row.claimed_at;\n483\t    if (row.claim_expires_at !== null) detail.claimExpiresAt = row.claim_expires_at;\n484\t    return detail;\n485\t  });\n486\t}\n487\t\n488\t// Listing in queue order (insertion order within the walk); each owning\n489\t// domain lists only its own items.\n490\texport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n491\t  const rows = db\n492\t    .prepare(\n493\t      `SELECT work_item_id, owner, kind, source_ref, queued_at\n494\t       FROM work_item WHERE owner = ? ORDER BY rowid`,\n495\t    )\n496\t    .all(owner) as unknown as RawWorkItemRow[];\n497\t  return rows.map((row) => ({\n498\t    workItemId: row.work_item_id,\n499\t    owner: row.owner as WorkOwner,\n500\t    kind: row.kind as WorkKind,\n501\t    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n502\t    status: \"queued\",\n503\t    queuedAt: row.queued_at,\n504\t  }));\n505\t}\n506\t"}]},"parent_tool_use_id":null,"session_id":"ba70f466-14e7-455b-b784-68aa93368849","uuid":"84d72b94-71b0-46b7-a4d8-8219e4fa8573","timestamp":"2026-06-11T04:44:30.357Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/tech-utils/work-queue/index.ts","content":"// Durable work-item mechanics: recording, ordered listing, and the enqueue\n// wrapper that makes \"queueing is what schedules processing\" structural\n// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n// a turn or a summary is; which kinds queue for which sources, and which\n// derived forms a kind produces, is the owning domains' business (callers\n// pass the form targets in). Writes run on the caller's handle inside the\n// ambient transaction, so items commit (or roll back) with the batch. No\n// public SDK surface: read-back reaches here only through the owning\n// domains' listQueuedWork.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport { fireSchedulerPoke, type OperationContext } from \"../../shared/context.js\";\nimport type { FormKind, HandlerFormWrite, SubjectKind } from \"../../shared/derivation.js\";\n\nexport type WorkOwner = \"messages\" | \"turns\";\nexport type WorkKind =\n  | \"prompt_smoothing\"\n  | \"tool_call_summary\"\n  | \"tool_result_summary\"\n  | \"turn_derivation\"\n  | \"chunk_summary_detailed\"\n  | \"chunk_summary_brief\";\nexport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n\n// The work-kind registry: owner and sourceRef semantics per the epic's Work\n// Item contract. Mechanical metadata only — what a kind *means* stays with\n// the owning domain's handler (registered at SDK construction, DD-6).\nexport const WORK_KIND_REGISTRY: Readonly<\n  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n> = {\n  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n  tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n};\n\nexport interface WorkItemRecord {\n  workItemId: string;\n  owner: WorkOwner;\n  kind: WorkKind;\n  sourceRef: WorkSourceRef;\n  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n  queuedAt: string;\n}\n\n// The derived forms an enqueue is scheduling work toward; the owning domain\n// names them (the util stays meaning-blind). Stored in the row's payload so\n// the drain's terminal paths (retry exhaustion, blocked source) can land the\n// form's failed/blocked state without asking any domain what a kind means.\nexport interface EnqueueFormTarget {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n}\n\nexport interface WorkItemInput {\n  owner: WorkOwner;\n  kind: WorkKind;\n  sourceRef: WorkSourceRef;\n  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n  forms?: readonly EnqueueFormTarget[]; // carried in payload for the drain's terminal paths\n}\n\nfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n  return sourceRef.chunkId;\n}\n\n// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n// same kind for the same source *at the same version* is the same id —\n// natural idempotency for the repair path — while a post-mutation\n// replacement (next version) never collides with an in-flight pre-mutation\n// item.\nexport function recordItem(\n  db: DatabaseSync,\n  input: WorkItemInput,\n  queuedAt: string,\n): WorkItemRecord {\n  const sourceVersion = input.sourceVersion ?? 1;\n  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n  db.prepare(\n    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n  ).run(\n    workItemId,\n    input.owner,\n    input.kind,\n    JSON.stringify(input.sourceRef),\n    queuedAt,\n    JSON.stringify({ sourceVersion, forms: input.forms ?? [] }),\n  );\n  return {\n    workItemId,\n    owner: input.owner,\n    kind: input.kind,\n    sourceRef: input.sourceRef,\n    status: \"queued\",\n    queuedAt,\n  };\n}\n\nexport interface EnqueueInput extends WorkItemInput {\n  forms: readonly EnqueueFormTarget[];\n}\n\n// The one way work is scheduled (DD-5): the work row, the form's `pending`\n// state row, and the scheduler poke all ride the ambient transaction — they\n// commit together or vanish together. Enqueue is the *only* place a\n// derived_form row is created (completion is UPDATE-only); re-enqueueing\n// resets an existing row to pending at the enqueued source version.\nexport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n  const sourceVersion = input.sourceVersion ?? 1;\n  const upsert = ctx.db.prepare(\n    `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n     VALUES (?, ?, ?, 'pending', ?)\n     ON CONFLICT (subject_kind, subject_id, form) DO UPDATE SET\n       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n  );\n  for (const target of input.forms) {\n    upsert.run(target.subjectKind, target.subjectId, target.form, sourceVersion);\n  }\n  ctx.onCommit(() => fireSchedulerPoke(ctx.threadId));\n  return item;\n}\n\ninterface RawWorkItemRow {\n  work_item_id: string;\n  owner: string;\n  kind: string;\n  source_ref: string;\n  queued_at: string;\n}\n\n// ── claim mechanics (Epic 02 Story 1, tech design §Mechanics) ─────\n// All pure SQL against the caller's open handle, domain-blind. Claim,\n// complete, and the terminal half of failAttempt each own one short\n// BEGIN IMMEDIATE; the handler in between runs with no open transaction.\n\n// The claimed row as the drain holds it: mechanical fields plus the payload's\n// source version and form targets. `kind` is a plain string here — a raw row\n// with an unregistered kind must still be claimable so the drain can land it\n// failed_terminal instead of skipping it (AC-1.8).\nexport interface ClaimedWorkItem {\n  workItemId: string;\n  owner: WorkOwner;\n  kind: string;\n  sourceRef: WorkSourceRef;\n  attempts: number;\n  queuedAt: string;\n  sourceVersion: number;\n  forms: EnqueueFormTarget[];\n}\n\nexport type ClaimOutcome =\n  | { outcome: \"claimed\"; item: ClaimedWorkItem }\n  | { outcome: \"empty\" }\n  | { outcome: \"in_flight\"; claimExpiresAt: string }\n  | { outcome: \"waiting\"; waitingUntil: string };\n\ninterface RawClaimRow {\n  work_item_id: string;\n  owner: string;\n  kind: string;\n  source_ref: string;\n  attempts: number | bigint;\n  queued_at: string;\n  payload: string | null;\n}\n\n// Form targets for pre-v5 rows, whose payload is NULL (Epic 01 wrote no\n// payload column). Exactly the F-02 backfill's kind→form mapping (migration\n// v5, shared/storage.ts): the backfill created pending derived_form rows at\n// source version 1 for these kinds, and a terminal failure must find them —\n// otherwise exhaustion would delete the work row and strand the backfilled\n// form as pending forever, breaking AC-1.9/DD-1 for upgraded threads.\nconst LEGACY_KIND_FORMS: Partial<\n  Record<string, ReadonlyArray<{ subjectKind: SubjectKind; form: FormKind }>>\n> = {\n  prompt_smoothing: [{ subjectKind: \"message\", form: \"smoothed_prompt\" }],\n  tool_result_summary: [{ subjectKind: \"message\", form: \"tool_result_summary\" }],\n  turn_derivation: [\n    { subjectKind: \"turn\", form: \"turn_rendering\" },\n    { subjectKind: \"turn\", form: \"lower_band_projection\" },\n  ],\n};\n\nfunction legacyFormTargets(kind: string, sourceRef: WorkSourceRef): EnqueueFormTarget[] {\n  const mapped = LEGACY_KIND_FORMS[kind];\n  if (mapped === undefined) return [];\n  const subjectId = sourceIdOf(sourceRef);\n  return mapped.map((target) => ({ ...target, subjectId }));\n}\n\nfunction toClaimedItem(row: RawClaimRow): ClaimedWorkItem {\n  const sourceRef = JSON.parse(row.source_ref) as WorkSourceRef;\n  const payload =\n    row.payload === null\n      ? // Pre-v5 row: version 1 (matching the backfill) and form targets\n        // reconstructed from the backfill's own mapping.\n        { sourceVersion: 1, forms: legacyFormTargets(row.kind, sourceRef) }\n      : (JSON.parse(row.payload) as { sourceVersion?: number; forms?: EnqueueFormTarget[] });\n  return {\n    workItemId: row.work_item_id,\n    owner: row.owner as WorkOwner,\n    kind: row.kind,\n    sourceRef,\n    attempts: Number(row.attempts),\n    queuedAt: row.queued_at,\n    sourceVersion: payload.sourceVersion ?? 1,\n    forms: payload.forms ?? [],\n  };\n}\n\n// Head-first, never skip-ahead: the claim decision is made against the oldest\n// live row only — a later eligible row is never considered while an older\n// live row exists. One atomic UPDATE under BEGIN IMMEDIATE (no read-then-\n// write split: the race window is the bug class). The CASE increments\n// `attempts` only when reclaiming an expired claimed row — a reclaim means a\n// run died or hung, and the increment makes the crash visible in the report\n// and counts it against the retry budget; normal claims never touch it.\nexport function claimNext(db: DatabaseSync, now: string, leaseDurationMs: number): ClaimOutcome {\n  const expiresAt = new Date(Date.parse(now) + leaseDurationMs).toISOString();\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    const claimed = db\n      .prepare(\n        `UPDATE work_item SET status = 'claimed', claimed_at = ?, claim_expires_at = ?,\n           attempts = attempts + CASE WHEN status = 'claimed' THEN 1 ELSE 0 END\n         WHERE work_item_id = (\n           SELECT work_item_id FROM (\n             SELECT work_item_id, status, eligible_at, claim_expires_at\n             FROM work_item WHERE status IN ('queued', 'claimed')\n             ORDER BY rowid LIMIT 1\n           )\n           WHERE (status = 'queued' AND (eligible_at IS NULL OR eligible_at <= ?))\n              OR (status = 'claimed' AND claim_expires_at <= ?)\n         )\n         RETURNING work_item_id, owner, kind, source_ref, attempts, queued_at, payload`,\n      )\n      .get(now, expiresAt, now, now) as unknown as RawClaimRow | undefined;\n    if (claimed !== undefined) {\n      db.exec(\"COMMIT;\");\n      return { outcome: \"claimed\", item: toClaimedItem(claimed) };\n    }\n    // No row claimable: re-read the head inside the same transaction to\n    // classify the stop. A claimed head with a live lease gates the queue\n    // (in_flight, AC-1.4); a queued head still backing off gates it too\n    // (waiting) — strict ordering, never reordered around the head.\n    const head = db\n      .prepare(\n        `SELECT status, eligible_at, claim_expires_at\n         FROM work_item WHERE status IN ('queued', 'claimed')\n         ORDER BY rowid LIMIT 1`,\n      )\n      .get() as unknown as\n      | { status: string; eligible_at: string | null; claim_expires_at: string | null }\n      | undefined;\n    db.exec(\"COMMIT;\");\n    if (head === undefined) return { outcome: \"empty\" };\n    if (head.status === \"claimed\") {\n      return { outcome: \"in_flight\", claimExpiresAt: head.claim_expires_at ?? \"\" };\n    }\n    return { outcome: \"waiting\", waitingUntil: head.eligible_at ?? \"\" };\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n}\n\n// Completion: the version-checked form writes and the item row's deletion in\n// one short transaction (DD-1: terminal transition deletes the row; the\n// disposition is reported in-memory, never stored). UPDATE-only, never\n// upsert — the pending row exists from enqueue; a write that finds no row at\n// the item's source version is discarded as stale (DD-3 truth table).\nexport function complete(\n  db: DatabaseSync,\n  item: ClaimedWorkItem,\n  writes: readonly HandlerFormWrite[],\n  derivedAt: string,\n): \"done\" | \"stale_discarded\" {\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    let hits = 0;\n    const update = db.prepare(\n      `UPDATE derived_form\n       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = ?, derived_at = ?\n       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n    );\n    for (const write of writes) {\n      const changed = update.run(\n        write.content,\n        write.metadata === undefined ? null : JSON.stringify(write.metadata),\n        write.gaps === undefined ? null : JSON.stringify(write.gaps),\n        derivedAt,\n        write.subjectKind,\n        write.subjectId,\n        write.form,\n        item.sourceVersion,\n      );\n      hits += Number(changed.changes);\n    }\n    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n    db.exec(\"COMMIT;\");\n    return writes.length > 0 && hits === 0 ? \"stale_discarded\" : \"done\";\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n}\n\nexport interface RetryPolicy {\n  budget: number;\n  backoffBaseMs: number;\n  backoffCapMs: number;\n}\n\nexport type FailAttemptResult =\n  | { terminal: false; attempts: number; eligibleAt: string }\n  | { terminal: true; attempts: number };\n\n// Terminal failure: the form rows land `failed` (or `blocked` for source\n// damage) carrying the final reason plus attempts/last-error copied onto the\n// form's metadata, and the item row is deleted — one transaction (DD-1).\n// Form writes stay version-checked: if a mutation moved the source since this\n// item was queued, the stale failure must not stamp the rebuilt form.\nexport function failTerminal(\n  db: DatabaseSync,\n  item: ClaimedWorkItem,\n  opts: { reason: string; formState: \"failed\" | \"blocked\"; attempts: number; now: string },\n): void {\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    const update = db.prepare(\n      `UPDATE derived_form\n       SET state = ?, content = NULL, reason = ?, metadata = ?, gaps = NULL, derived_at = ?\n       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n    );\n    const metadata = JSON.stringify({ attempts: opts.attempts, lastError: opts.reason });\n    for (const target of item.forms) {\n      update.run(\n        opts.formState,\n        opts.reason,\n        metadata,\n        opts.now,\n        target.subjectKind,\n        target.subjectId,\n        target.form,\n        item.sourceVersion,\n      );\n    }\n    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n    db.exec(\"COMMIT;\");\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n}\n\n// A failed run counts itself. Under budget and retryable: the row goes back\n// to `queued` with attempts incremented and eligibility pushed out by backoff\n// (min(base × 2^attempts, cap)) — retry is not a status (DD-1). At budget, or\n// on a non-retryable failure, the item is terminal: form `failed` with the\n// final reason, row deleted (AC-1.9).\nexport function failAttempt(\n  db: DatabaseSync,\n  item: ClaimedWorkItem,\n  opts: { reason: string; retryable: boolean; now: string; retry: RetryPolicy },\n): FailAttemptResult {\n  const attempts = item.attempts + 1;\n  if (opts.retryable && attempts < opts.retry.budget) {\n    const backoffMs = Math.min(\n      opts.retry.backoffBaseMs * 2 ** attempts,\n      opts.retry.backoffCapMs,\n    );\n    const eligibleAt = new Date(Date.parse(opts.now) + backoffMs).toISOString();\n    db.exec(\"BEGIN IMMEDIATE;\");\n    try {\n      db.prepare(\n        `UPDATE work_item\n         SET status = 'queued', attempts = ?, last_error = ?,\n             claimed_at = NULL, claim_expires_at = NULL, eligible_at = ?\n         WHERE work_item_id = ?`,\n      ).run(attempts, opts.reason, eligibleAt, item.workItemId);\n      db.exec(\"COMMIT;\");\n    } catch (cause) {\n      db.exec(\"ROLLBACK;\");\n      throw cause;\n    }\n    return { terminal: false, attempts, eligibleAt };\n  }\n  failTerminal(db, item, { reason: opts.reason, formState: \"failed\", attempts, now: opts.now });\n  return { terminal: true, attempts };\n}\n\n// Cascade tidy (tech design issue 1): delete still-queued items for the given\n// (kind, sourceRef) targets, returning the deleted ids for the mutation\n// result's `superseded` list. Runs inside the caller's ambient transaction —\n// the cascade owns the BEGIN/COMMIT — so no transaction is opened here.\n// Claimed items are deliberately left alone: the source-version check (DD-3)\n// discards their stale completions. Ships here as mechanics; its only caller\n// is Story 5's cascade.\nexport function supersedeQueued(\n  db: DatabaseSync,\n  targets: ReadonlyArray<{ kind: WorkKind; sourceRef: WorkSourceRef }>,\n): string[] {\n  const ids: string[] = [];\n  const remove = db.prepare(\n    `DELETE FROM work_item WHERE status = 'queued' AND kind = ? AND source_ref = ?\n     RETURNING work_item_id`,\n  );\n  for (const target of targets) {\n    const rows = remove.all(target.kind, JSON.stringify(target.sourceRef)) as unknown as Array<{\n      work_item_id: string;\n    }>;\n    for (const row of rows) ids.push(row.work_item_id);\n  }\n  return ids;\n}\n\n// Live items left in the queue — the drain report's `remaining` and the\n// repair report's join source (Story 4).\nexport function countLiveItems(db: DatabaseSync): number {\n  const row = db\n    .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE status IN ('queued', 'claimed')`)\n    .get() as unknown as { n: number | bigint };\n  return Number(row.n);\n}\n\nexport interface QueueDetailRow {\n  workItemId: string;\n  owner: WorkOwner;\n  kind: string;\n  sourceRef: WorkSourceRef;\n  status: \"queued\" | \"claimed\";\n  attempts: number;\n  lastError?: string;\n  eligibleAt?: string;\n  claimedAt?: string;\n  claimExpiresAt?: string;\n  queuedAt: string;\n  sourceVersion: number;\n}\n\n// Mechanical detail of every live row in queue order — what the repair\n// report joins against derived_form (Flow 4) and what tests read to assert\n// lease/backoff state without raw SQL at every call site.\nexport function queueDetail(db: DatabaseSync): QueueDetailRow[] {\n  const rows = db\n    .prepare(\n      `SELECT work_item_id, owner, kind, source_ref, status, attempts, last_error,\n              eligible_at, claimed_at, claim_expires_at, queued_at, payload\n       FROM work_item ORDER BY rowid`,\n    )\n    .all() as unknown as Array<\n    RawClaimRow & {\n      status: string;\n      last_error: string | null;\n      eligible_at: string | null;\n      claimed_at: string | null;\n      claim_expires_at: string | null;\n    }\n  >;\n  return rows.map((row) => {\n    const item = toClaimedItem(row);\n    const detail: QueueDetailRow = {\n      workItemId: item.workItemId,\n      owner: item.owner,\n      kind: item.kind,\n      sourceRef: item.sourceRef,\n      status: row.status as \"queued\" | \"claimed\",\n      attempts: item.attempts,\n      queuedAt: item.queuedAt,\n      sourceVersion: item.sourceVersion,\n    };\n    if (row.last_error !== null) detail.lastError = row.last_error;\n    if (row.eligible_at !== null) detail.eligibleAt = row.eligible_at;\n    if (row.claimed_at !== null) detail.claimedAt = row.claimed_at;\n    if (row.claim_expires_at !== null) detail.claimExpiresAt = row.claim_expires_at;\n    return detail;\n  });\n}\n\n// Listing in queue order (insertion order within the walk); each owning\n// domain lists only its own items.\nexport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n  const rows = db\n    .prepare(\n      `SELECT work_item_id, owner, kind, source_ref, queued_at\n       FROM work_item WHERE owner = ? ORDER BY rowid`,\n    )\n    .all(owner) as unknown as RawWorkItemRow[];\n  return rows.map((row) => ({\n    workItemId: row.work_item_id,\n    owner: row.owner as WorkOwner,\n    kind: row.kind as WorkKind,\n    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n    status: \"queued\",\n    queuedAt: row.queued_at,\n  }));\n}\n","numLines":506,"startLine":1,"totalLines":506}}}

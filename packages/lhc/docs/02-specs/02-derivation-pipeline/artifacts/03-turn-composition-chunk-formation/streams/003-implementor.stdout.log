{"type":"assistant","message":{"model":"claude-fable-5","id":"msg_01CkjCRuEAFzYKTkjbdTwPwL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014YQsZCTTb1yN3ukFy9oAfu","name":"Edit","input":{"replace_all":false,"file_path":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/work-queue.test.ts","old_string":"    const sdk = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n    // Story 2 registered the three message-owned handlers; the turn-owned\n    // kinds arrive in Story 3 (amended from the empty-map assertion when the\n    // messages table was populated).\n    expect(Object.keys(sdk.workHandlers).sort()).toEqual([\n      \"prompt_smoothing\",\n      \"tool_call_summary\",\n      \"tool_result_summary\",\n    ]);\n    // The miss is reported as a structured result — not a throw, not silence.\n    const missed = sdk.lookupWorkHandler(\"turn_derivation\");\n    expect(missed.ok).toBe(false);\n    if (missed.ok) return;\n    expect(missed.error.errorClass).toBe(\"state_corruption\");\n    expect(missed.error.code).toBe(\"unknown_work_kind\");\n    expect(missed.error.reason).toContain(\"turn_derivation\");","new_string":"    const sdk = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n    // All six kinds registered: Story 2's message-owned handlers plus\n    // Story 3's turn-owned ones (amended each story as the domain tables\n    // populated — Story 0 asserted an empty map, Story 2 the three message\n    // kinds).\n    expect(Object.keys(sdk.workHandlers).sort()).toEqual([\n      \"chunk_summary_brief\",\n      \"chunk_summary_detailed\",\n      \"prompt_smoothing\",\n      \"tool_call_summary\",\n      \"tool_result_summary\",\n      \"turn_derivation\",\n    ]);\n    // The miss is reported as a structured result — not a throw, not silence.\n    const missed = sdk.lookupWorkHandler(\"bogus_kind\");\n    expect(missed.ok).toBe(false);\n    if (missed.ok) return;\n    expect(missed.error.errorClass).toBe(\"state_corruption\");\n    expect(missed.error.code).toBe(\"unknown_work_kind\");\n    expect(missed.error.reason).toContain(\"bogus_kind\");"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":192,"cache_read_input_tokens":205029,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":192},"output_tokens":55,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ba70f466-14e7-455b-b784-68aa93368849","uuid":"db22c583-b6dc-475f-8950-36f13b7a4627","request_id":"req_011Cbvt4moVeQ89BHbdJd44S"}

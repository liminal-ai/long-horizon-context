{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MuZ2SAHkzg2VHDqyZoHDRR","type":"tool_result","content":"1\t// Deterministic DerivationProvider double (DD-7, test plan §Test Substrate).\n2\t// Injected at the same seam production adapters use — dependency injection,\n3\t// not a mock of internals. Every operation returns marked, input-derived\n4\t// output: `<marker>(<digest>:<prefix>)` where the digest and prefix are pure\n5\t// functions of the input, so identical input to the same operation yields\n6\t// identical output across double instances, and different operations are\n7\t// distinguishable by marker. Scripting (failNext / failKind / delayKind /\n8\t// captureInputs) is per-instance state and never leaks across tests that\n9\t// construct their own double.\n10\timport {\n11\t  deterministicText,\n12\t  type DerivationProvider,\n13\t  type ProviderResult,\n14\t  type RenderingPart,\n15\t} from \"../../src/index.js\";\n16\t\n17\texport type ProviderOpName =\n18\t  | \"smoothPrompt\"\n19\t  | \"summarizeToolCall\"\n20\t  | \"summarizeToolResult\"\n21\t  | \"composeTurnRendering\"\n22\t  | \"projectLowerBand\"\n23\t  | \"summarizeChunkDetailed\"\n24\t  | \"summarizeChunkBrief\";\n25\t\n26\t// Tests script by work-kind / form-kind vocabulary (the test plan writes\n27\t// `failKind(prompt_smoothing, …)`); the double accepts those aliases as well\n28\t// as the operation names themselves.\n29\tconst KIND_ALIASES: Record<string, ProviderOpName> = {\n30\t  smoothPrompt: \"smoothPrompt\",\n31\t  summarizeToolCall: \"summarizeToolCall\",\n32\t  summarizeToolResult: \"summarizeToolResult\",\n33\t  composeTurnRendering: \"composeTurnRendering\",\n34\t  projectLowerBand: \"projectLowerBand\",\n35\t  summarizeChunkDetailed: \"summarizeChunkDetailed\",\n36\t  summarizeChunkBrief: \"summarizeChunkBrief\",\n37\t  prompt_smoothing: \"smoothPrompt\",\n38\t  smoothed_prompt: \"smoothPrompt\",\n39\t  tool_call_summary: \"summarizeToolCall\",\n40\t  tool_result_summary: \"summarizeToolResult\",\n41\t  turn_rendering: \"composeTurnRendering\",\n42\t  lower_band_projection: \"projectLowerBand\",\n43\t  chunk_summary_detailed: \"summarizeChunkDetailed\",\n44\t  chunk_summary_brief: \"summarizeChunkBrief\",\n45\t};\n46\t\n47\tfunction resolveOpName(kind: string): ProviderOpName {\n48\t  const op = KIND_ALIASES[kind];\n49\t  if (op === undefined) throw new Error(`provider double: unknown operation/kind \"${kind}\"`);\n50\t  return op;\n51\t}\n52\t\n53\tinterface FailScript {\n54\t  remaining: number;\n55\t  retryable: boolean;\n56\t  reason: string;\n57\t}\n58\t\n59\texport interface CapturedInput {\n60\t  op: ProviderOpName;\n61\t  input: unknown;\n62\t}\n63\t\n64\texport class ProviderDouble implements DerivationProvider {\n65\t  private failNextScript: FailScript | null = null;\n66\t  private readonly failByOp = new Map<ProviderOpName, FailScript>();\n67\t  private readonly delayByOp = new Map<ProviderOpName, number>();\n68\t  private capturing = false;\n69\t  private readonly captured: CapturedInput[] = [];\n70\t\n71\t  // Fail the next n calls to any operation, then succeed.\n72\t  failNext(n: number, opts?: { retryable?: boolean; reason?: string }): void {\n73\t    this.failNextScript = {\n74\t      remaining: n,\n75\t      retryable: opts?.retryable ?? true,\n76\t      reason: opts?.reason ?? \"scripted failure (failNext)\",\n77\t    };\n78\t  }\n79\t\n80\t  // Fail the next n calls to one operation (kind names and op names both\n81\t  // accepted). retryable: false scripts a terminal failure.\n82\t  failKind(kind: string, n: number, opts?: { retryable?: boolean; reason?: string }): void {\n83\t    const op = resolveOpName(kind);\n84\t    this.failByOp.set(op, {\n85\t      remaining: n,\n86\t      retryable: opts?.retryable ?? true,\n87\t      reason: opts?.reason ?? `scripted failure (${op})`,\n88\t    });\n89\t  }\n90\t\n91\t  delayKind(kind: string, ms: number): void {\n92\t    this.delayByOp.set(resolveOpName(kind), ms);\n93\t  }\n94\t\n95\t  // Start capturing inputs; returns the live log (appended in call order).\n96\t  captureInputs(): readonly CapturedInput[] {\n97\t    this.capturing = true;\n98\t    return this.captured;\n99\t  }\n100\t\n101\t  private async run(\n102\t    op: ProviderOpName,\n103\t    input: unknown,\n104\t    text: string,\n105\t  ): Promise<ProviderResult> {\n106\t    if (this.capturing) this.captured.push({ op, input: structuredClone(input) });\n107\t    const delay = this.delayByOp.get(op);\n108\t    if (delay !== undefined && delay > 0) {\n109\t      await new Promise((resolve) => setTimeout(resolve, delay));\n110\t    }\n111\t    const scripts = [this.failNextScript, this.failByOp.get(op) ?? null];\n112\t    for (const script of scripts) {\n113\t      if (script !== null && script.remaining > 0) {\n114\t        script.remaining -= 1;\n115\t        return { ok: false, retryable: script.retryable, reason: script.reason };\n116\t      }\n117\t    }\n118\t    // Output format shared with src/providers/deterministic.ts so the double\n119\t    // and the registry's \"deterministic\" provider produce byte-identical\n120\t    // artifacts across in-process and spawned runs.\n121\t    return { ok: true, text: deterministicText(op, input, text) };\n122\t  }\n123\t\n124\t  smoothPrompt(i: { text: string }): Promise<ProviderResult> {\n125\t    return this.run(\"smoothPrompt\", i, i.text);\n126\t  }\n127\t\n128\t  summarizeToolCall(i: {\n129\t    toolName: string;\n130\t    argsJson: string;\n131\t    pairedResult?: { content: string; isError: boolean };\n132\t  }): Promise<ProviderResult> {\n133\t    return this.run(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`);\n134\t  }\n135\t\n136\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult> {\n137\t    return this.run(\"summarizeToolResult\", i, i.content);\n138\t  }\n139\t\n140\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult> {\n141\t    return this.run(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \"));\n142\t  }\n143\t\n144\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult> {\n145\t    return this.run(\"projectLowerBand\", i, i.rendering);\n146\t  }\n147\t\n148\t  summarizeChunkDetailed(i: { memberProjections: string[] }): Promise<ProviderResult> {\n149\t    return this.run(\"summarizeChunkDetailed\", i, i.memberProjections.join(\" | \"));\n150\t  }\n151\t\n152\t  summarizeChunkBrief(i: { memberProjections: string[] }): Promise<ProviderResult> {\n153\t    return this.run(\"summarizeChunkBrief\", i, i.memberProjections.join(\" | \"));\n154\t  }\n155\t}\n156\t\n157\texport function createProviderDouble(): ProviderDouble {\n158\t  return new ProviderDouble();\n159\t}\n160\t"}]},"parent_tool_use_id":null,"session_id":"ba70f466-14e7-455b-b784-68aa93368849","uuid":"984ee94a-7b49-4865-b59e-675501ab8304","timestamp":"2026-06-11T04:45:22.499Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/provider-double.ts","content":"// Deterministic DerivationProvider double (DD-7, test plan §Test Substrate).\n// Injected at the same seam production adapters use — dependency injection,\n// not a mock of internals. Every operation returns marked, input-derived\n// output: `<marker>(<digest>:<prefix>)` where the digest and prefix are pure\n// functions of the input, so identical input to the same operation yields\n// identical output across double instances, and different operations are\n// distinguishable by marker. Scripting (failNext / failKind / delayKind /\n// captureInputs) is per-instance state and never leaks across tests that\n// construct their own double.\nimport {\n  deterministicText,\n  type DerivationProvider,\n  type ProviderResult,\n  type RenderingPart,\n} from \"../../src/index.js\";\n\nexport type ProviderOpName =\n  | \"smoothPrompt\"\n  | \"summarizeToolCall\"\n  | \"summarizeToolResult\"\n  | \"composeTurnRendering\"\n  | \"projectLowerBand\"\n  | \"summarizeChunkDetailed\"\n  | \"summarizeChunkBrief\";\n\n// Tests script by work-kind / form-kind vocabulary (the test plan writes\n// `failKind(prompt_smoothing, …)`); the double accepts those aliases as well\n// as the operation names themselves.\nconst KIND_ALIASES: Record<string, ProviderOpName> = {\n  smoothPrompt: \"smoothPrompt\",\n  summarizeToolCall: \"summarizeToolCall\",\n  summarizeToolResult: \"summarizeToolResult\",\n  composeTurnRendering: \"composeTurnRendering\",\n  projectLowerBand: \"projectLowerBand\",\n  summarizeChunkDetailed: \"summarizeChunkDetailed\",\n  summarizeChunkBrief: \"summarizeChunkBrief\",\n  prompt_smoothing: \"smoothPrompt\",\n  smoothed_prompt: \"smoothPrompt\",\n  tool_call_summary: \"summarizeToolCall\",\n  tool_result_summary: \"summarizeToolResult\",\n  turn_rendering: \"composeTurnRendering\",\n  lower_band_projection: \"projectLowerBand\",\n  chunk_summary_detailed: \"summarizeChunkDetailed\",\n  chunk_summary_brief: \"summarizeChunkBrief\",\n};\n\nfunction resolveOpName(kind: string): ProviderOpName {\n  const op = KIND_ALIASES[kind];\n  if (op === undefined) throw new Error(`provider double: unknown operation/kind \"${kind}\"`);\n  return op;\n}\n\ninterface FailScript {\n  remaining: number;\n  retryable: boolean;\n  reason: string;\n}\n\nexport interface CapturedInput {\n  op: ProviderOpName;\n  input: unknown;\n}\n\nexport class ProviderDouble implements DerivationProvider {\n  private failNextScript: FailScript | null = null;\n  private readonly failByOp = new Map<ProviderOpName, FailScript>();\n  private readonly delayByOp = new Map<ProviderOpName, number>();\n  private capturing = false;\n  private readonly captured: CapturedInput[] = [];\n\n  // Fail the next n calls to any operation, then succeed.\n  failNext(n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    this.failNextScript = {\n      remaining: n,\n      retryable: opts?.retryable ?? true,\n      reason: opts?.reason ?? \"scripted failure (failNext)\",\n    };\n  }\n\n  // Fail the next n calls to one operation (kind names and op names both\n  // accepted). retryable: false scripts a terminal failure.\n  failKind(kind: string, n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    const op = resolveOpName(kind);\n    this.failByOp.set(op, {\n      remaining: n,\n      retryable: opts?.retryable ?? true,\n      reason: opts?.reason ?? `scripted failure (${op})`,\n    });\n  }\n\n  delayKind(kind: string, ms: number): void {\n    this.delayByOp.set(resolveOpName(kind), ms);\n  }\n\n  // Start capturing inputs; returns the live log (appended in call order).\n  captureInputs(): readonly CapturedInput[] {\n    this.capturing = true;\n    return this.captured;\n  }\n\n  private async run(\n    op: ProviderOpName,\n    input: unknown,\n    text: string,\n  ): Promise<ProviderResult> {\n    if (this.capturing) this.captured.push({ op, input: structuredClone(input) });\n    const delay = this.delayByOp.get(op);\n    if (delay !== undefined && delay > 0) {\n      await new Promise((resolve) => setTimeout(resolve, delay));\n    }\n    const scripts = [this.failNextScript, this.failByOp.get(op) ?? null];\n    for (const script of scripts) {\n      if (script !== null && script.remaining > 0) {\n        script.remaining -= 1;\n        return { ok: false, retryable: script.retryable, reason: script.reason };\n      }\n    }\n    // Output format shared with src/providers/deterministic.ts so the double\n    // and the registry's \"deterministic\" provider produce byte-identical\n    // artifacts across in-process and spawned runs.\n    return { ok: true, text: deterministicText(op, input, text) };\n  }\n\n  smoothPrompt(i: { text: string }): Promise<ProviderResult> {\n    return this.run(\"smoothPrompt\", i, i.text);\n  }\n\n  summarizeToolCall(i: {\n    toolName: string;\n    argsJson: string;\n    pairedResult?: { content: string; isError: boolean };\n  }): Promise<ProviderResult> {\n    return this.run(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`);\n  }\n\n  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult> {\n    return this.run(\"summarizeToolResult\", i, i.content);\n  }\n\n  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult> {\n    return this.run(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \"));\n  }\n\n  projectLowerBand(i: { rendering: string }): Promise<ProviderResult> {\n    return this.run(\"projectLowerBand\", i, i.rendering);\n  }\n\n  summarizeChunkDetailed(i: { memberProjections: string[] }): Promise<ProviderResult> {\n    return this.run(\"summarizeChunkDetailed\", i, i.memberProjections.join(\" | \"));\n  }\n\n  summarizeChunkBrief(i: { memberProjections: string[] }): Promise<ProviderResult> {\n    return this.run(\"summarizeChunkBrief\", i, i.memberProjections.join(\" | \"));\n  }\n}\n\nexport function createProviderDouble(): ProviderDouble {\n  return new ProviderDouble();\n}\n","numLines":160,"startLine":1,"totalLines":160}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VCJrqsWGsADzeUuL4PBEsX","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport type { OperationContext } from \"../../shared/context.js\";\n3\timport type { WorkHandler } from \"../../shared/derivation.js\";\n4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n5\timport {\n6\t  enqueue,\n7\t  listItems,\n8\t  type WorkItemRecord,\n9\t  type WorkKind,\n10\t} from \"../../tech-utils/work-queue/index.js\";\n11\timport type { EventKind } from \"../intake-stream/index.js\";\n12\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n13\timport { transition } from \"./internal/state-machine.js\";\n14\t\n15\t// The pure rule table, re-exported for the golden supplemental suite (the\n16\t// test plan's one sanctioned direct entry besides the tokenizer); production\n17\t// callers go through applyEvent.\n18\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n19\timport {\n20\t  closeTurn,\n21\t  insertOpenTurn,\n22\t  nextTurnOrder,\n23\t  readTurns,\n24\t  selectOpenTurnIds,\n25\t} from \"./internal/store.js\";\n26\t\n27\texport interface TurnRecord {\n28\t  turnId: string;\n29\t  status: \"open\" | \"closed\";\n30\t  memberMessageIds: string[];\n31\t  openedAtEventOrder: number;\n32\t  closedAtEventOrder?: number;\n33\t}\n34\t\n35\texport interface TurnTransitionOutcome {\n36\t  // Transitions in occurrence order: a close_then_open reports the close\n37\t  // first, then the open, exactly as the batch result surfaces them.\n38\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n39\t  // Turn state after the transition — the stamp for this event's message.\n40\t  // Prompts see the turn they just opened (transition first, then stamp);\n41\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n42\t  openTurnId: string | null;\n43\t  // Work queued by this transition: one turn_derivation item per closed\n44\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\n45\t  queuedWork: WorkItemRecord[];\n46\t}\n47\t\n48\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n49\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n50\t// writes turn state, so more than one open turn means external interference.\n51\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n52\t  return selectOpenTurnIds(ctx.db);\n53\t}\n54\t\n55\t// Closing a turn — by either close path — durably queues that turn's\n56\t// derivation work in the same transaction (AC-3.6): the close update and the\n57\t// work item commit or roll back together.\n58\tfunction closeTurnAndQueueWork(\n59\t  ctx: OperationContext,\n60\t  turnId: string,\n61\t  eventOrder: number,\n62\t): WorkItemRecord {\n63\t  closeTurn(ctx.db, turnId, eventOrder);\n64\t  // One work item, two derived forms: the turn_derivation handler (Story 3)\n65\t  // lands the rendering and the lower-band projection as independent rows;\n66\t  // both go pending with the enqueue (DD-5).\n67\t  return enqueue(ctx, {\n68\t    owner: \"turns\",\n69\t    kind: \"turn_derivation\",\n70\t    sourceRef: { turnId },\n71\t    forms: [\n72\t      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n73\t      { subjectKind: \"turn\", subjectId: turnId, form: \"lower_band_projection\" },\n74\t    ],\n75\t  });\n76\t}\n77\t\n78\t// Turn-owned work handlers, merged into the SDK's dispatch map at\n79\t// construction (DD-6). Empty until Story 3 lands turn derivation and the\n80\t// chunk summaries.\n81\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {};\n82\t\n83\t// Cross-domain surface, called by intake-stream inside the batch transaction\n84\t// for every recorded event. Synchronous and throwing by design, like\n85\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n86\texport function applyEvent(\n87\t  ctx: OperationContext,\n88\t  eventKind: EventKind,\n89\t  eventOrder: number,\n90\t): TurnTransitionOutcome {\n91\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n92\t  const effect = transition({ openTurnId }, eventKind);\n93\t  switch (effect.kind) {\n94\t    case \"none\":\n95\t      return { transitions: [], openTurnId, queuedWork: [] };\n96\t    case \"open\": {\n97\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n98\t      return {\n99\t        transitions: [{ action: \"opened\", turnId }],\n100\t        openTurnId: turnId,\n101\t        queuedWork: [],\n102\t      };\n103\t    }\n104\t    case \"close\": {\n105\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n106\t      return {\n107\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n108\t        openTurnId: null,\n109\t        queuedWork: [item],\n110\t      };\n111\t    }\n112\t    case \"close_then_open\": {\n113\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n114\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n115\t      return {\n116\t        transitions: [\n117\t          { action: \"closed\", turnId: openTurnId as string },\n118\t          { action: \"opened\", turnId },\n119\t        ],\n120\t        openTurnId: turnId,\n121\t        queuedWork: [item],\n122\t      };\n123\t    }\n124\t  }\n125\t}\n126\t\n127\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n128\t  return {\n129\t    ok: false,\n130\t    error: {\n131\t      errorClass: \"caller_error\",\n132\t      code: \"thread_not_found\",\n133\t      reason: `no thread file exists at ${filePath}`,\n134\t    },\n135\t  };\n136\t}\n137\t\n138\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n139\t  const resolved = await resolveThreadRef(thread);\n140\t  if (!resolved.ok) return resolved;\n141\t  const { filePath } = resolved.value;\n142\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n143\t\n144\t  const opened = openThreadDatabase(filePath);\n145\t  if (!opened.ok) return opened;\n146\t  const db = opened.value;\n147\t  try {\n148\t    return { ok: true, value: readTurns(db) };\n149\t  } catch (cause) {\n150\t    const reason = cause instanceof Error ? cause.message : String(cause);\n151\t    return storageFailure(`turn read-back failed: ${reason}`);\n152\t  } finally {\n153\t    db.close();\n154\t  }\n155\t}\n156\t\n157\texport async function listQueuedWork(\n158\t  thread: ThreadRef,\n159\t): Promise<OpResult<WorkItemRecord[]>> {\n160\t  const resolved = await resolveThreadRef(thread);\n161\t  if (!resolved.ok) return resolved;\n162\t  const { filePath } = resolved.value;\n163\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n164\t\n165\t  const opened = openThreadDatabase(filePath);\n166\t  if (!opened.ok) return opened;\n167\t  const db = opened.value;\n168\t  try {\n169\t    return { ok: true, value: listItems(db, \"turns\") };\n170\t  } catch (cause) {\n171\t    const reason = cause instanceof Error ? cause.message : String(cause);\n172\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n173\t  } finally {\n174\t    db.close();\n175\t  }\n176\t}\n177\t"}]},"parent_tool_use_id":null,"session_id":"ba70f466-14e7-455b-b784-68aa93368849","uuid":"9b551bb1-eb94-49a1-9ea6-382428e487e2","timestamp":"2026-06-11T04:45:18.690Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/index.ts","content":"import { existsSync } from \"node:fs\";\nimport type { OperationContext } from \"../../shared/context.js\";\nimport type { WorkHandler } from \"../../shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  enqueue,\n  listItems,\n  type WorkItemRecord,\n  type WorkKind,\n} from \"../../tech-utils/work-queue/index.js\";\nimport type { EventKind } from \"../intake-stream/index.js\";\nimport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\nimport { transition } from \"./internal/state-machine.js\";\n\n// The pure rule table, re-exported for the golden supplemental suite (the\n// test plan's one sanctioned direct entry besides the tokenizer); production\n// callers go through applyEvent.\nexport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\nimport {\n  closeTurn,\n  insertOpenTurn,\n  nextTurnOrder,\n  readTurns,\n  selectOpenTurnIds,\n} from \"./internal/store.js\";\n\nexport interface TurnRecord {\n  turnId: string;\n  status: \"open\" | \"closed\";\n  memberMessageIds: string[];\n  openedAtEventOrder: number;\n  closedAtEventOrder?: number;\n}\n\nexport interface TurnTransitionOutcome {\n  // Transitions in occurrence order: a close_then_open reports the close\n  // first, then the open, exactly as the batch result surfaces them.\n  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n  // Turn state after the transition — the stamp for this event's message.\n  // Prompts see the turn they just opened (transition first, then stamp);\n  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n  openTurnId: string | null;\n  // Work queued by this transition: one turn_derivation item per closed\n  // turn, by either close path (AC-3.6). Empty when nothing closed.\n  queuedWork: WorkItemRecord[];\n}\n\n// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n// IMMEDIATE and before any event is processed. Only the batch pipeline\n// writes turn state, so more than one open turn means external interference.\nexport function listOpenTurnIds(ctx: OperationContext): string[] {\n  return selectOpenTurnIds(ctx.db);\n}\n\n// Closing a turn — by either close path — durably queues that turn's\n// derivation work in the same transaction (AC-3.6): the close update and the\n// work item commit or roll back together.\nfunction closeTurnAndQueueWork(\n  ctx: OperationContext,\n  turnId: string,\n  eventOrder: number,\n): WorkItemRecord {\n  closeTurn(ctx.db, turnId, eventOrder);\n  // One work item, two derived forms: the turn_derivation handler (Story 3)\n  // lands the rendering and the lower-band projection as independent rows;\n  // both go pending with the enqueue (DD-5).\n  return enqueue(ctx, {\n    owner: \"turns\",\n    kind: \"turn_derivation\",\n    sourceRef: { turnId },\n    forms: [\n      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n      { subjectKind: \"turn\", subjectId: turnId, form: \"lower_band_projection\" },\n    ],\n  });\n}\n\n// Turn-owned work handlers, merged into the SDK's dispatch map at\n// construction (DD-6). Empty until Story 3 lands turn derivation and the\n// chunk summaries.\nexport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {};\n\n// Cross-domain surface, called by intake-stream inside the batch transaction\n// for every recorded event. Synchronous and throwing by design, like\n// messages.createFromEvent: a turn-storage failure rejects the whole batch.\nexport function applyEvent(\n  ctx: OperationContext,\n  eventKind: EventKind,\n  eventOrder: number,\n): TurnTransitionOutcome {\n  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n  const effect = transition({ openTurnId }, eventKind);\n  switch (effect.kind) {\n    case \"none\":\n      return { transitions: [], openTurnId, queuedWork: [] };\n    case \"open\": {\n      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n      return {\n        transitions: [{ action: \"opened\", turnId }],\n        openTurnId: turnId,\n        queuedWork: [],\n      };\n    }\n    case \"close\": {\n      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n      return {\n        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n        openTurnId: null,\n        queuedWork: [item],\n      };\n    }\n    case \"close_then_open\": {\n      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n      return {\n        transitions: [\n          { action: \"closed\", turnId: openTurnId as string },\n          { action: \"opened\", turnId },\n        ],\n        openTurnId: turnId,\n        queuedWork: [item],\n      };\n    }\n  }\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nexport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: readTurns(db) };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`turn read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport async function listQueuedWork(\n  thread: ThreadRef,\n): Promise<OpResult<WorkItemRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: listItems(db, \"turns\") };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`queued-work read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":177,"startLine":1,"totalLines":177}}}

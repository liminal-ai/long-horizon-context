{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RXgarMR4SCS5oiLSpcwauZ","type":"tool_result","content":"1\t// SDK-internal scheduler and drain (DD-4): the one component holding\n2\t// cross-operation in-memory state. The drain loop lives here per the tech\n3\t// design's placement — claim under BEGIN IMMEDIATE, dispatch through the\n4\t// handler map with no open transaction (the provider call lives there),\n5\t// complete in a second short transaction. Background mode adds per-thread\n6\t// single-flight with pending-flag coalescing, post-commit pokes, first-touch\n7\t// catch-up (DD-10), and drainSettled (issue 3). The in-memory state is\n8\t// advisory only: cross-process safety comes from the durable lease alone, so\n9\t// a fresh handle sees identical drain behavior — the queue is the rows.\n10\timport { existsSync } from \"node:fs\";\n11\timport { setImmediate as scheduleMacrotask } from \"node:timers\";\n12\timport { DatabaseSync } from \"node:sqlite\";\n13\timport { openThreadDatabase } from \"./domains/threads/index.js\";\n14\timport type {\n15\t  HandlerOutcome,\n16\t  ResolvedSdkConfig,\n17\t  WorkHandler,\n18\t} from \"./shared/derivation.js\";\n19\timport { storageFailure, type ErrorResult, type OpResult } from \"./shared/errors.js\";\n20\timport {\n21\t  claimNext,\n22\t  complete,\n23\t  countLiveItems,\n24\t  failAttempt,\n25\t  failTerminal,\n26\t  type ClaimedWorkItem,\n27\t  type WorkKind,\n28\t  type WorkSourceRef,\n29\t} from \"./tech-utils/work-queue/index.js\";\n30\t\n31\texport type SchedulerMode = \"background\" | \"manual\";\n32\t\n33\t// Report shape per tech design §Interfaces. `superseded` never appears here:\n34\t// the cascade deletes superseded items and reports them on the mutation\n35\t// result; a drain never sees them.\n36\texport interface DrainReport {\n37\t  ran: Array<{\n38\t    workItemId: string;\n39\t    kind: WorkKind;\n40\t    sourceRef: WorkSourceRef;\n41\t    disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\";\n42\t    attempts: number;\n43\t    reason?: string;\n44\t  }>;\n45\t  stoppedBecause: \"empty\" | \"in_flight\" | \"waiting\" | \"max_items\";\n46\t  waitingUntil?: string; // head's eligible_at when stoppedBecause = \"waiting\"\n47\t  remaining: number; // live items left behind the stop point\n48\t}\n49\t\n50\texport interface DrainDeps {\n51\t  lookupHandler: (kind: string) => OpResult<WorkHandler>;\n52\t  // Whether any handler is registered at all. Background scheduling is gated\n53\t  // on this, fail-closed: with an empty map a background drain could only\n54\t  // turn queued rows into failed_terminal — destruction, not processing — so\n55\t  // pokes and catch-up stay inert until a handler table is populated\n56\t  // (Stories 2–3 in production; explicit registration in tests).\n57\t  hasAnyHandler: () => boolean;\n58\t  config: ResolvedSdkConfig;\n59\t}\n60\t\n61\tfunction ranEntry(\n62\t  item: ClaimedWorkItem,\n63\t  disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\",\n64\t  attempts: number,\n65\t  reason?: string,\n66\t): DrainReport[\"ran\"][number] {\n67\t  const entry: DrainReport[\"ran\"][number] = {\n68\t    workItemId: item.workItemId,\n69\t    kind: item.kind as WorkKind,\n70\t    sourceRef: item.sourceRef,\n71\t    disposition,\n72\t    attempts,\n73\t  };\n74\t  if (reason !== undefined) entry.reason = reason;\n75\t  return entry;\n76\t}\n77\t\n78\t// The drain loop against an open handle. Claim → dispatch → complete, one\n79\t// item at a time, until the head stops it (empty / in_flight / waiting) or\n80\t// maxItems is reached. The handler runs with NO open transaction; the only\n81\t// exits from a handler failure are failAttempt and the terminal paths — the\n82\t// drain never catches an error and records success.\n83\texport async function drainOpenDb(\n84\t  db: DatabaseSync,\n85\t  deps: DrainDeps,\n86\t  opts?: { maxItems?: number },\n87\t): Promise<DrainReport> {\n88\t  const { clock, lease, retry, provider } = deps.config;\n89\t  const ran: DrainReport[\"ran\"] = [];\n90\t  let stoppedBecause: DrainReport[\"stoppedBecause\"];\n91\t  let waitingUntil: string | undefined;\n92\t\n93\t  for (;;) {\n94\t    if (opts?.maxItems !== undefined && ran.length >= opts.maxItems) {\n95\t      stoppedBecause = \"max_items\";\n96\t      break;\n97\t    }\n98\t    const claim = claimNext(db, clock().toISOString(), lease.durationMs);\n99\t    if (claim.outcome === \"empty\") {\n100\t      stoppedBecause = \"empty\";\n101\t      break;\n102\t    }\n103\t    if (claim.outcome === \"in_flight\") {\n104\t      stoppedBecause = \"in_flight\";\n105\t      break;\n106\t    }\n107\t    if (claim.outcome === \"waiting\") {\n108\t      stoppedBecause = \"waiting\";\n109\t      waitingUntil = claim.waitingUntil;\n110\t      break;\n111\t    }\n112\t    const item = claim.item;\n113\t\n114\t    const lookedUp = deps.lookupHandler(item.kind);\n115\t    if (!lookedUp.ok) {\n116\t      // Unregistered kind: the normal terminal transaction, not a try/catch\n117\t      // skip — failed_terminal with the stable code, form (if resolvable\n118\t      // from the payload) lands failed, and the drain continues (AC-1.8).\n119\t      failTerminal(db, item, {\n120\t        reason: lookedUp.error.code,\n121\t        formState: \"failed\",\n122\t        attempts: item.attempts,\n123\t        now: clock().toISOString(),\n124\t      });\n125\t      ran.push(ranEntry(item, \"failed_terminal\", item.attempts, lookedUp.error.code));\n126\t      continue;\n127\t    }\n128\t\n129\t    let outcome: HandlerOutcome;\n130\t    try {\n131\t      outcome = await lookedUp.value(\n132\t        { openDb: () => db, provider, clock, config: deps.config },\n133\t        {\n134\t          workItemId: item.workItemId,\n135\t          kind: item.kind,\n136\t          sourceRef: item.sourceRef as unknown as Record<string, string>,\n137\t        },\n138\t      );\n139\t    } catch (cause) {\n140\t      // A throwing handler is a bug by the error contract, but the queue\n141\t      // must not wedge on it: route it through the normal retry path so it\n142\t      // counts attempts and exhausts visibly.\n143\t      const detail = cause instanceof Error ? cause.message : String(cause);\n144\t      outcome = { ok: false, retryable: true, reason: `handler threw: ${detail}` };\n145\t    }\n146\t\n147\t    if (outcome.ok) {\n148\t      const disposition = complete(db, item, outcome.forms ?? [], clock().toISOString());\n149\t      ran.push(ranEntry(item, disposition, item.attempts));\n150\t      continue;\n151\t    }\n152\t    if (\"blocked\" in outcome) {\n153\t      failTerminal(db, item, {\n154\t        reason: outcome.reason,\n155\t        formState: \"blocked\",\n156\t        attempts: item.attempts + 1,\n157\t        now: clock().toISOString(),\n158\t      });\n159\t      ran.push(ranEntry(item, \"failed_terminal\", item.attempts + 1, outcome.reason));\n160\t      continue;\n161\t    }\n162\t    const failed = failAttempt(db, item, {\n163\t      reason: outcome.reason,\n164\t      retryable: outcome.retryable,\n165\t      now: clock().toISOString(),\n166\t      retry,\n167\t    });\n168\t    if (failed.terminal) {\n169\t      ran.push(ranEntry(item, \"failed_terminal\", failed.attempts, outcome.reason));\n170\t    }\n171\t    // Under budget the item went back to queued (possibly backing off); the\n172\t    // next claimNext re-reads the head — a backing-off head ends the drain\n173\t    // with \"waiting\" and gates everything behind it.\n174\t  }\n175\t\n176\t  const report: DrainReport = { ran, stoppedBecause, remaining: countLiveItems(db) };\n177\t  if (waitingUntil !== undefined) report.waitingUntil = waitingUntil;\n178\t  return report;\n179\t}\n180\t\n181\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n182\t  return {\n183\t    ok: false,\n184\t    error: {\n185\t      errorClass: \"caller_error\",\n186\t      code: \"thread_not_found\",\n187\t      reason: `no thread file exists at ${filePath}`,\n188\t    },\n189\t  };\n190\t}\n191\t\n192\t// The drain operation against a thread file: open (validates + migrates),\n193\t// drain, close. Both the SDK's work.drain and the background loop's passes\n194\t// run through here — manual and background modes share one drain.\n195\texport async function runDrain(\n196\t  filePath: string,\n197\t  deps: DrainDeps,\n198\t  opts?: { maxItems?: number },\n199\t): Promise<OpResult<DrainReport>> {\n200\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n201\t  const opened = openThreadDatabase(filePath);\n202\t  if (!opened.ok) return opened;\n203\t  const db = opened.value;\n204\t  try {\n205\t    return { ok: true, value: await drainOpenDb(db, deps, opts) };\n206\t  } catch (cause) {\n207\t    const detail = cause instanceof Error ? cause.message : String(cause);\n208\t    return storageFailure(`drain failed: ${detail}`);\n209\t  } finally {\n210\t    db.close();\n211\t  }\n212\t}\n213\t\n214\tinterface ThreadDrainState {\n215\t  filePath: string;\n216\t  running: boolean;\n217\t  pending: boolean;\n218\t  passes: number; // test-only observability (TC-1.2); must not become API\n219\t  waiters: Array<() => void>;\n220\t}\n221\t\n222\texport interface Scheduler {\n223\t  readonly mode: SchedulerMode;\n224\t  // Post-commit nudge that work was queued for a thread (DD-5). Manual mode:\n225\t  // no-op by contract. Background mode: starts a drain, or coalesces into\n226\t  // the pending flag if one is already running for the thread (AC-1.2).\n227\t  poke(threadId: string): void;\n228\t  // Thread-file open announcement (DD-10): learns threadId → filePath and,\n229\t  // on the first touch of a thread this process lifetime, schedules a\n230\t  // catch-up drain if the queue has leftover live work (AC-1.6).\n231\t  touch(filePath: string, db: DatabaseSync): void;\n232\t  // Resolves when the scheduler has no running or pending drain for the\n233\t  // thread (issue 3). Manual mode resolves immediately.\n234\t  drainSettled(threadId: string): Promise<void>;\n235\t  // Test-only observability for coalescing exactness (TC-1.2): drain passes\n236\t  // started for a thread. Named as a test hook on purpose — not API.\n237\t  testPassCount(threadId: string): number;\n238\t}\n239\t\n240\tfunction readThreadId(db: DatabaseSync): string | null {\n241\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n242\t    | { thread_id: string }\n243\t    | undefined;\n244\t  return row?.thread_id ?? null;\n245\t}\n246\t\n247\t// Read a thread file's id without side effects (no migration, no touch) —\n248\t// drainSettled must observe scheduler state, never schedule work.\n249\texport function peekThreadId(filePath: string): string | null {\n250\t  if (!existsSync(filePath)) return null;\n251\t  let db: DatabaseSync | undefined;\n252\t  try {\n253\t    db = new DatabaseSync(filePath, { readOnly: true });\n254\t    return readThreadId(db);\n255\t  } catch {\n256\t    return null;\n257\t  } finally {\n258\t    db?.close();\n259\t  }\n260\t}\n261\t\n262\texport function createScheduler(mode: SchedulerMode, deps: DrainDeps): Scheduler {\n263\t  const states = new Map<string, ThreadDrainState>();\n264\t  const seen = new Set<string>(); // first-touch catch-up guard, process lifetime\n265\t\n266\t  function stateFor(threadId: string): ThreadDrainState {\n267\t    let st = states.get(threadId);\n268\t    if (st === undefined) {\n269\t      st = { filePath: \"\", running: false, pending: false, passes: 0, waiters: [] };\n270\t      states.set(threadId, st);\n271\t    }\n272\t    return st;\n273\t  }\n274\t\n275\t  async function runLoop(st: ThreadDrainState): Promise<void> {\n276\t    // Defer past the committing operation's synchronous tail so the drain\n277\t    // never contends with the transaction whose commit scheduled it.\n278\t    await new Promise((resolve) => scheduleMacrotask(resolve));\n279\t    try {\n280\t      do {\n281\t        st.pending = false;\n282\t        st.passes += 1;\n283\t        // A failed pass (storage error) has no caller to report to in\n284\t        // background mode; the durable rows are untouched and the next poke\n285\t        // or touch retries. A pass stopping on \"waiting\" likewise leaves the\n286\t        // backing-off head for the next nudge — the lease and eligibility\n287\t        // gates are durable, not timer state.\n288\t        await runDrain(st.filePath, deps);\n289\t      } while (st.pending);\n290\t    } finally {\n291\t      st.running = false;\n292\t      for (const waiter of st.waiters.splice(0)) waiter();\n293\t    }\n294\t  }\n295\t\n296\t  function schedule(threadId: string): void {\n297\t    const st = stateFor(threadId);\n298\t    if (st.filePath === \"\") return; // never touched here: no path to drain\n299\t    if (st.running) {\n300\t      st.pending = true; // burst coalesce: at most one further pass (AC-1.2)\n301\t      return;\n302\t    }\n303\t    st.running = true;\n304\t    void runLoop(st);\n305\t  }\n306\t\n307\t  return {\n308\t    mode,\n309\t    poke(threadId: string): void {\n310\t      if (mode !== \"background\") return;\n311\t      if (!deps.hasAnyHandler()) return;\n312\t      schedule(threadId);\n313\t    },\n314\t    touch(filePath: string, db: DatabaseSync): void {\n315\t      if (mode !== \"background\") return;\n316\t      const threadId = readThreadId(db);\n317\t      if (threadId === null) return;\n318\t      const st = stateFor(threadId);\n319\t      st.filePath = filePath;\n320\t      if (seen.has(threadId)) return;\n321\t      seen.add(threadId);\n322\t      // Catch-up (DD-10): leftover live work from a previous process runs on\n323\t      // first touch. One indexed query on the already-open handle keeps the\n324\t      // empty-queue case cheap.\n325\t      if (deps.hasAnyHandler() && countLiveItems(db) > 0) schedule(threadId);\n326\t    },\n327\t    drainSettled(threadId: string): Promise<void> {\n328\t      const st = states.get(threadId);\n329\t      if (st === undefined || (!st.running && !st.pending)) return Promise.resolve();\n330\t      return new Promise((resolve) => st.waiters.push(resolve));\n331\t    },\n332\t    testPassCount(threadId: string): number {\n333\t      return states.get(threadId)?.passes ?? 0;\n334\t    },\n335\t  };\n336\t}\n337\t"}]},"parent_tool_use_id":null,"session_id":"ba70f466-14e7-455b-b784-68aa93368849","uuid":"bf19ae37-482c-4e11-b4b3-c1dfc42470df","timestamp":"2026-06-11T04:44:37.055Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/scheduler.ts","content":"// SDK-internal scheduler and drain (DD-4): the one component holding\n// cross-operation in-memory state. The drain loop lives here per the tech\n// design's placement — claim under BEGIN IMMEDIATE, dispatch through the\n// handler map with no open transaction (the provider call lives there),\n// complete in a second short transaction. Background mode adds per-thread\n// single-flight with pending-flag coalescing, post-commit pokes, first-touch\n// catch-up (DD-10), and drainSettled (issue 3). The in-memory state is\n// advisory only: cross-process safety comes from the durable lease alone, so\n// a fresh handle sees identical drain behavior — the queue is the rows.\nimport { existsSync } from \"node:fs\";\nimport { setImmediate as scheduleMacrotask } from \"node:timers\";\nimport { DatabaseSync } from \"node:sqlite\";\nimport { openThreadDatabase } from \"./domains/threads/index.js\";\nimport type {\n  HandlerOutcome,\n  ResolvedSdkConfig,\n  WorkHandler,\n} from \"./shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"./shared/errors.js\";\nimport {\n  claimNext,\n  complete,\n  countLiveItems,\n  failAttempt,\n  failTerminal,\n  type ClaimedWorkItem,\n  type WorkKind,\n  type WorkSourceRef,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type SchedulerMode = \"background\" | \"manual\";\n\n// Report shape per tech design §Interfaces. `superseded` never appears here:\n// the cascade deletes superseded items and reports them on the mutation\n// result; a drain never sees them.\nexport interface DrainReport {\n  ran: Array<{\n    workItemId: string;\n    kind: WorkKind;\n    sourceRef: WorkSourceRef;\n    disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\";\n    attempts: number;\n    reason?: string;\n  }>;\n  stoppedBecause: \"empty\" | \"in_flight\" | \"waiting\" | \"max_items\";\n  waitingUntil?: string; // head's eligible_at when stoppedBecause = \"waiting\"\n  remaining: number; // live items left behind the stop point\n}\n\nexport interface DrainDeps {\n  lookupHandler: (kind: string) => OpResult<WorkHandler>;\n  // Whether any handler is registered at all. Background scheduling is gated\n  // on this, fail-closed: with an empty map a background drain could only\n  // turn queued rows into failed_terminal — destruction, not processing — so\n  // pokes and catch-up stay inert until a handler table is populated\n  // (Stories 2–3 in production; explicit registration in tests).\n  hasAnyHandler: () => boolean;\n  config: ResolvedSdkConfig;\n}\n\nfunction ranEntry(\n  item: ClaimedWorkItem,\n  disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\",\n  attempts: number,\n  reason?: string,\n): DrainReport[\"ran\"][number] {\n  const entry: DrainReport[\"ran\"][number] = {\n    workItemId: item.workItemId,\n    kind: item.kind as WorkKind,\n    sourceRef: item.sourceRef,\n    disposition,\n    attempts,\n  };\n  if (reason !== undefined) entry.reason = reason;\n  return entry;\n}\n\n// The drain loop against an open handle. Claim → dispatch → complete, one\n// item at a time, until the head stops it (empty / in_flight / waiting) or\n// maxItems is reached. The handler runs with NO open transaction; the only\n// exits from a handler failure are failAttempt and the terminal paths — the\n// drain never catches an error and records success.\nexport async function drainOpenDb(\n  db: DatabaseSync,\n  deps: DrainDeps,\n  opts?: { maxItems?: number },\n): Promise<DrainReport> {\n  const { clock, lease, retry, provider } = deps.config;\n  const ran: DrainReport[\"ran\"] = [];\n  let stoppedBecause: DrainReport[\"stoppedBecause\"];\n  let waitingUntil: string | undefined;\n\n  for (;;) {\n    if (opts?.maxItems !== undefined && ran.length >= opts.maxItems) {\n      stoppedBecause = \"max_items\";\n      break;\n    }\n    const claim = claimNext(db, clock().toISOString(), lease.durationMs);\n    if (claim.outcome === \"empty\") {\n      stoppedBecause = \"empty\";\n      break;\n    }\n    if (claim.outcome === \"in_flight\") {\n      stoppedBecause = \"in_flight\";\n      break;\n    }\n    if (claim.outcome === \"waiting\") {\n      stoppedBecause = \"waiting\";\n      waitingUntil = claim.waitingUntil;\n      break;\n    }\n    const item = claim.item;\n\n    const lookedUp = deps.lookupHandler(item.kind);\n    if (!lookedUp.ok) {\n      // Unregistered kind: the normal terminal transaction, not a try/catch\n      // skip — failed_terminal with the stable code, form (if resolvable\n      // from the payload) lands failed, and the drain continues (AC-1.8).\n      failTerminal(db, item, {\n        reason: lookedUp.error.code,\n        formState: \"failed\",\n        attempts: item.attempts,\n        now: clock().toISOString(),\n      });\n      ran.push(ranEntry(item, \"failed_terminal\", item.attempts, lookedUp.error.code));\n      continue;\n    }\n\n    let outcome: HandlerOutcome;\n    try {\n      outcome = await lookedUp.value(\n        { openDb: () => db, provider, clock, config: deps.config },\n        {\n          workItemId: item.workItemId,\n          kind: item.kind,\n          sourceRef: item.sourceRef as unknown as Record<string, string>,\n        },\n      );\n    } catch (cause) {\n      // A throwing handler is a bug by the error contract, but the queue\n      // must not wedge on it: route it through the normal retry path so it\n      // counts attempts and exhausts visibly.\n      const detail = cause instanceof Error ? cause.message : String(cause);\n      outcome = { ok: false, retryable: true, reason: `handler threw: ${detail}` };\n    }\n\n    if (outcome.ok) {\n      const disposition = complete(db, item, outcome.forms ?? [], clock().toISOString());\n      ran.push(ranEntry(item, disposition, item.attempts));\n      continue;\n    }\n    if (\"blocked\" in outcome) {\n      failTerminal(db, item, {\n        reason: outcome.reason,\n        formState: \"blocked\",\n        attempts: item.attempts + 1,\n        now: clock().toISOString(),\n      });\n      ran.push(ranEntry(item, \"failed_terminal\", item.attempts + 1, outcome.reason));\n      continue;\n    }\n    const failed = failAttempt(db, item, {\n      reason: outcome.reason,\n      retryable: outcome.retryable,\n      now: clock().toISOString(),\n      retry,\n    });\n    if (failed.terminal) {\n      ran.push(ranEntry(item, \"failed_terminal\", failed.attempts, outcome.reason));\n    }\n    // Under budget the item went back to queued (possibly backing off); the\n    // next claimNext re-reads the head — a backing-off head ends the drain\n    // with \"waiting\" and gates everything behind it.\n  }\n\n  const report: DrainReport = { ran, stoppedBecause, remaining: countLiveItems(db) };\n  if (waitingUntil !== undefined) report.waitingUntil = waitingUntil;\n  return report;\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\n// The drain operation against a thread file: open (validates + migrates),\n// drain, close. Both the SDK's work.drain and the background loop's passes\n// run through here — manual and background modes share one drain.\nexport async function runDrain(\n  filePath: string,\n  deps: DrainDeps,\n  opts?: { maxItems?: number },\n): Promise<OpResult<DrainReport>> {\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: await drainOpenDb(db, deps, opts) };\n  } catch (cause) {\n    const detail = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`drain failed: ${detail}`);\n  } finally {\n    db.close();\n  }\n}\n\ninterface ThreadDrainState {\n  filePath: string;\n  running: boolean;\n  pending: boolean;\n  passes: number; // test-only observability (TC-1.2); must not become API\n  waiters: Array<() => void>;\n}\n\nexport interface Scheduler {\n  readonly mode: SchedulerMode;\n  // Post-commit nudge that work was queued for a thread (DD-5). Manual mode:\n  // no-op by contract. Background mode: starts a drain, or coalesces into\n  // the pending flag if one is already running for the thread (AC-1.2).\n  poke(threadId: string): void;\n  // Thread-file open announcement (DD-10): learns threadId → filePath and,\n  // on the first touch of a thread this process lifetime, schedules a\n  // catch-up drain if the queue has leftover live work (AC-1.6).\n  touch(filePath: string, db: DatabaseSync): void;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3). Manual mode resolves immediately.\n  drainSettled(threadId: string): Promise<void>;\n  // Test-only observability for coalescing exactness (TC-1.2): drain passes\n  // started for a thread. Named as a test hook on purpose — not API.\n  testPassCount(threadId: string): number;\n}\n\nfunction readThreadId(db: DatabaseSync): string | null {\n  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n    | { thread_id: string }\n    | undefined;\n  return row?.thread_id ?? null;\n}\n\n// Read a thread file's id without side effects (no migration, no touch) —\n// drainSettled must observe scheduler state, never schedule work.\nexport function peekThreadId(filePath: string): string | null {\n  if (!existsSync(filePath)) return null;\n  let db: DatabaseSync | undefined;\n  try {\n    db = new DatabaseSync(filePath, { readOnly: true });\n    return readThreadId(db);\n  } catch {\n    return null;\n  } finally {\n    db?.close();\n  }\n}\n\nexport function createScheduler(mode: SchedulerMode, deps: DrainDeps): Scheduler {\n  const states = new Map<string, ThreadDrainState>();\n  const seen = new Set<string>(); // first-touch catch-up guard, process lifetime\n\n  function stateFor(threadId: string): ThreadDrainState {\n    let st = states.get(threadId);\n    if (st === undefined) {\n      st = { filePath: \"\", running: false, pending: false, passes: 0, waiters: [] };\n      states.set(threadId, st);\n    }\n    return st;\n  }\n\n  async function runLoop(st: ThreadDrainState): Promise<void> {\n    // Defer past the committing operation's synchronous tail so the drain\n    // never contends with the transaction whose commit scheduled it.\n    await new Promise((resolve) => scheduleMacrotask(resolve));\n    try {\n      do {\n        st.pending = false;\n        st.passes += 1;\n        // A failed pass (storage error) has no caller to report to in\n        // background mode; the durable rows are untouched and the next poke\n        // or touch retries. A pass stopping on \"waiting\" likewise leaves the\n        // backing-off head for the next nudge — the lease and eligibility\n        // gates are durable, not timer state.\n        await runDrain(st.filePath, deps);\n      } while (st.pending);\n    } finally {\n      st.running = false;\n      for (const waiter of st.waiters.splice(0)) waiter();\n    }\n  }\n\n  function schedule(threadId: string): void {\n    const st = stateFor(threadId);\n    if (st.filePath === \"\") return; // never touched here: no path to drain\n    if (st.running) {\n      st.pending = true; // burst coalesce: at most one further pass (AC-1.2)\n      return;\n    }\n    st.running = true;\n    void runLoop(st);\n  }\n\n  return {\n    mode,\n    poke(threadId: string): void {\n      if (mode !== \"background\") return;\n      if (!deps.hasAnyHandler()) return;\n      schedule(threadId);\n    },\n    touch(filePath: string, db: DatabaseSync): void {\n      if (mode !== \"background\") return;\n      const threadId = readThreadId(db);\n      if (threadId === null) return;\n      const st = stateFor(threadId);\n      st.filePath = filePath;\n      if (seen.has(threadId)) return;\n      seen.add(threadId);\n      // Catch-up (DD-10): leftover live work from a previous process runs on\n      // first touch. One indexed query on the already-open handle keeps the\n      // empty-queue case cheap.\n      if (deps.hasAnyHandler() && countLiveItems(db) > 0) schedule(threadId);\n    },\n    drainSettled(threadId: string): Promise<void> {\n      const st = states.get(threadId);\n      if (st === undefined || (!st.running && !st.pending)) return Promise.resolve();\n      return new Promise((resolve) => st.waiters.push(resolve));\n    },\n    testPassCount(threadId: string): number {\n      return states.get(threadId)?.passes ?? 0;\n    },\n  };\n}\n","numLines":337,"startLine":1,"totalLines":337}}}

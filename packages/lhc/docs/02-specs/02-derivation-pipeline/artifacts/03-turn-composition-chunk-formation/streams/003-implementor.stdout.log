{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0129Ro67AUNJEw8SqE963TBF","type":"tool_result","content":"1\t// Story 2 (Epic 02): message-level derivation — Flow 2. The three real\n2\t// handlers (prompt smoothing, tool-call summary, tool-result summary) through\n3\t// Story 1's drain, mechanical outcome stamping (TC-2.4's identical-text\n4\t// fixture is the architecture-risk proof that provider text never drives the\n5\t// outcome), the hot-path locality assertion (TC-2.2: intake returns before\n6\t// any provider call), and the AC-2.8 late-result repair with its\n7\t// control leg. No registerTestWorkHandlers here: every drain dispatches the\n8\t// production handlers registered by the messages domain at createSdk.\n9\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n10\timport {\n11\t  countLiveItems,\n12\t  createSdk,\n13\t  deterministicText,\n14\t  threads,\n15\t  type BatchResult,\n16\t  type DerivationProvider,\n17\t  type DrainReport,\n18\t  type Lhc,\n19\t  type MessageEventInput,\n20\t} from \"../src/index.js\";\n21\timport {\n22\t  createProviderDouble,\n23\t  openRaw,\n24\t  readDerivedForms,\n25\t  tempStore,\n26\t  threadWithToolRun,\n27\t  validEvent,\n28\t  type TempStore,\n29\t} from \"./fixtures/index.js\";\n30\t\n31\tlet store: TempStore;\n32\tbeforeEach(() => {\n33\t  store = tempStore();\n34\t});\n35\tafterEach(() => {\n36\t  store.cleanup();\n37\t});\n38\t\n39\tasync function newThread(): Promise<string> {\n40\t  const created = await threads.newThread({\n41\t    filePath: store.threadPath(),\n42\t    registryPath: store.registryPath,\n43\t  });\n44\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n45\t  return created.value.filePath;\n46\t}\n47\t\n48\tfunction manualSdk(provider: DerivationProvider): Lhc {\n49\t  return createSdk({\n50\t    provider,\n51\t    mode: \"manual\",\n52\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n53\t    lease: { durationMs: 200 },\n54\t  });\n55\t}\n56\t\n57\tasync function send(\n58\t  sdk: Lhc,\n59\t  filePath: string,\n60\t  batch: readonly MessageEventInput[],\n61\t): Promise<BatchResult> {\n62\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n63\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n64\t  return result.value;\n65\t}\n66\t\n67\tasync function drain(sdk: Lhc, filePath: string): Promise<DrainReport> {\n68\t  const result = await sdk.work.drain({ filePath });\n69\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n70\t  return result.value;\n71\t}\n72\t\n73\tfunction liveCount(filePath: string): number {\n74\t  const db = openRaw(filePath);\n75\t  try {\n76\t    return countLiveItems(db);\n77\t  } finally {\n78\t    db.close();\n79\t  }\n80\t}\n81\t\n82\tfunction formOf(filePath: string, subjectId: string, form: string) {\n83\t  return readDerivedForms(filePath).find(\n84\t    (f) => f.subjectId === subjectId && f.form === form,\n85\t  );\n86\t}\n87\t\n88\tdescribe(\"TC-2.1 / AC-2.1: prompt smoothing lands a ready form readable alongside the message\", () => {\n89\t  it(\"intake a prompt, drain → smoothed form ready with the double's deterministic output\", async () => {\n90\t    const double = createProviderDouble();\n91\t    const sdk = manualSdk(double);\n92\t    const filePath = await newThread();\n93\t    const text = \"please smooth this prompt\";\n94\t    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text } })]);\n95\t\n96\t    const report = await drain(sdk, filePath);\n97\t    expect(report.ran).toEqual([\n98\t      expect.objectContaining({\n99\t        workItemId: \"w-m1-prompt_smoothing-v1\",\n100\t        disposition: \"done\",\n101\t      }),\n102\t    ]);\n103\t\n104\t    // Readable alongside the message through the production read surface\n105\t    // (02F-001): listMessages carries the stored form on the message record —\n106\t    // not a fixture read of derived_form.\n107\t    const listed = await sdk.messages.listMessages({ filePath });\n108\t    expect(listed.ok).toBe(true);\n109\t    if (!listed.ok) return;\n110\t    const message = listed.value[0];\n111\t    expect(message?.blocks[0]?.content[\"text\"]).toBe(text);\n112\t    expect(message?.forms).toEqual([\n113\t      expect.objectContaining({\n114\t        subjectKind: \"message\",\n115\t        subjectId: \"m1\",\n116\t        form: \"smoothed_prompt\",\n117\t        state: \"ready\",\n118\t        // The content is the double's pure function of the prompt text — the\n119\t        // production smoothPrompt input shape, nothing else mixed in.\n120\t        content: deterministicText(\"smoothPrompt\", { text }, text),\n121\t        sourceVersion: 1,\n122\t      }),\n123\t    ]);\n124\t\n125\t    // The raw row agrees with the surfaced read: stored state, not a\n126\t    // read-time derivation.\n127\t    const raw = formOf(filePath, \"m1\", \"smoothed_prompt\");\n128\t    expect(raw?.state).toBe(\"ready\");\n129\t    expect(raw?.content).toBe(deterministicText(\"smoothPrompt\", { text }, text));\n130\t  });\n131\t});\n132\t\n133\tdescribe(\"TC-2.2 / AC-2.2: tool_call queues its summary additively; intake returns before any handler runs\", () => {\n134\t  it(\"the batch reports the queued item with the capture log still empty; the drained summary names tool and args\", async () => {\n135\t    const double = createProviderDouble();\n136\t    const captured = double.captureInputs();\n137\t    const sdk = manualSdk(double);\n138\t    const filePath = await newThread();\n139\t\n140\t    const batch = await send(sdk, filePath, [validEvent(\"tool_call\")]);\n141\t    // Hot-path NFR made testable: the intake result is in hand and the\n142\t    // provider has never been called — queueing and derivation are decoupled\n143\t    // in time, not just in code.\n144\t    expect(captured).toHaveLength(0);\n145\t    expect(batch.queuedWork).toEqual([\n146\t      {\n147\t        workItemId: \"w-m1-tool_call_summary-v1\",\n148\t        owner: \"messages\",\n149\t        kind: \"tool_call_summary\",\n150\t        sourceRef: { messageId: \"m1\" },\n151\t      },\n152\t    ]);\n153\t\n154\t    const report = await drain(sdk, filePath);\n155\t    expect(report.ran).toEqual([\n156\t      expect.objectContaining({\n157\t        workItemId: \"w-m1-tool_call_summary-v1\",\n158\t        disposition: \"done\",\n159\t      }),\n160\t    ]);\n161\t    const form = formOf(filePath, \"m1\", \"tool_call_summary\");\n162\t    expect(form?.state).toBe(\"ready\");\n163\t    // Names the tool and describes its arguments (fixture default payload).\n164\t    expect(form?.content).toContain(\"read_file\");\n165\t    expect(form?.content).toContain('{\"path\":\"notes.txt\"}');\n166\t    // No paired result intaken: outcome stamped unknown, in metadata.\n167\t    expect(form?.metadata).toEqual({ outcome: \"unknown\" });\n168\t  });\n169\t});\n170\t\n171\tdescribe(\"TC-2.3 / AC-2.3: the result summary abbreviates; the full content stays byte-identical in the record\", () => {\n172\t  it(\"a 300KB result drains to a bounded summary and reads back whole through the Epic 01 surface\", async () => {\n173\t    const big = \"result-bytes \".repeat(24000); // ~300KB\n174\t    const double = createProviderDouble();\n175\t    const sdk = manualSdk(double);\n176\t    const { filePath } = await threadWithToolRun(store, { resultContent: big });\n177\t\n178\t    await drain(sdk, filePath);\n179\t    const summary = formOf(filePath, \"m3\", \"tool_result_summary\");\n180\t    expect(summary?.state).toBe(\"ready\");\n181\t    expect(summary?.content?.startsWith(\"toolresult(\")).toBe(true);\n182\t    // Summarized means abbreviated: marker + digest + 40-char prefix.\n183\t    expect(summary?.content?.length ?? 0).toBeLessThan(100);\n184\t    expect(summary?.metadata).toEqual({ outcome: \"succeeded\" });\n185\t\n186\t    const listed = await sdk.messages.listMessages({ filePath });\n187\t    expect(listed.ok).toBe(true);\n188\t    if (!listed.ok) return;\n189\t    const resultMessage = listed.value.find((m) => m.kind === \"tool_result\");\n190\t    expect(resultMessage?.blocks[0]?.content[\"content\"]).toBe(big);\n191\t  });\n192\t});\n193\t\n194\tdescribe(\"TC-2.4 / AC-2.4 (architecture risk): outcome is stamped from the record, never from provider text\", () => {\n195\t  it(\"three variants with identical provider text land succeeded / failed / unknown from metadata alone\", async () => {\n196\t    // The identical-text fixture: summarizeToolCall returns one constant\n197\t    // string no matter the input, at the same production seam. If any code\n198\t    // path inferred outcome from text, all three variants would agree.\n199\t    const constantText = \"the tool was invoked with some arguments\";\n200\t    const double = createProviderDouble();\n201\t    const provider: DerivationProvider = {\n202\t      smoothPrompt: (i) => double.smoothPrompt(i),\n203\t      summarizeToolCall: () => Promise.resolve({ ok: true, text: constantText }),\n204\t      summarizeToolResult: (i) => double.summarizeToolResult(i),\n205\t      composeTurnRendering: (i) => double.composeTurnRendering(i),\n206\t      projectLowerBand: (i) => double.projectLowerBand(i),\n207\t      summarizeChunkDetailed: (i) => double.summarizeChunkDetailed(i),\n208\t      summarizeChunkBrief: (i) => double.summarizeChunkBrief(i),\n209\t    };\n210\t    const sdk = manualSdk(provider);\n211\t\n212\t    const ok = await threadWithToolRun(store);\n213\t    const errored = await threadWithToolRun(store, { isError: true });\n214\t    const missing = await threadWithToolRun(store, { missingResult: true });\n215\t    for (const { filePath } of [ok, errored, missing]) await drain(sdk, filePath);\n216\t\n217\t    const summaries = [ok, errored, missing].map(({ filePath }) =>\n218\t      formOf(filePath, \"m2\", \"tool_call_summary\"),\n219\t    );\n220\t    expect(summaries.map((f) => f?.state)).toEqual([\"ready\", \"ready\", \"ready\"]);\n221\t    // Text identical across all three…\n222\t    expect(summaries.map((f) => f?.content)).toEqual([\n223\t      constantText,\n224\t      constantText,\n225\t      constantText,\n226\t    ]);\n227\t    // …while the outcome differs, read from metadata — machine-readable\n228\t    // apart from the provider's prose, which mentions no outcome at all.\n229\t    expect(summaries.map((f) => f?.metadata?.outcome)).toEqual([\n230\t      \"succeeded\",\n231\t      \"failed\",\n232\t      \"unknown\",\n233\t    ]);\n234\t  });\n235\t});\n236\t\n237\tdescribe(\"TC-2.5 / AC-2.5: message-level input discipline — the message and its call-id pair only\", () => {\n238\t  it(\"the captured tool-call summary input is exactly the call plus its paired result\", async () => {\n239\t    const double = createProviderDouble();\n240\t    const captured = double.captureInputs();\n241\t    const sdk = manualSdk(double);\n242\t    const { filePath } = await threadWithToolRun(store);\n243\t\n244\t    await drain(sdk, filePath);\n245\t    const inputs = captured.filter((entry) => entry.op === \"summarizeToolCall\");\n246\t    expect(inputs).toHaveLength(1);\n247\t    // Exact equality: no turn ids, no membership, no chunk context — the\n248\t    // production seam receives the pair and nothing else.\n249\t    expect(inputs[0]?.input).toEqual({\n250\t      toolName: \"read_file\",\n251\t      argsJson: '{\"path\":\"notes.txt\"}',\n252\t      pairedResult: { content: \"contents of notes.txt\", isError: false },\n253\t    });\n254\t  });\n255\t});\n256\t\n257\tdescribe(\"TC-2.6 / AC-2.6: provider exhaustion lands the form failed; the message stays readable\", () => {\n258\t  it(\"smoothing exhausts the retry budget → form failed with the provider's reason; read-back unaffected\", async () => {\n259\t    const double = createProviderDouble();\n260\t    const sdk = manualSdk(double);\n261\t    const filePath = await newThread();\n262\t    const text = \"this prompt will never smooth\";\n263\t    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text } })]);\n264\t\n265\t    double.failKind(\"prompt_smoothing\", 99, {\n266\t      retryable: true,\n267\t      reason: \"scripted exhaustion (smoothPrompt)\",\n268\t    });\n269\t    const report = await drain(sdk, filePath);\n270\t    expect(report.ran).toEqual([\n271\t      expect.objectContaining({\n272\t        workItemId: \"w-m1-prompt_smoothing-v1\",\n273\t        disposition: \"failed_terminal\",\n274\t        attempts: 3,\n275\t        reason: \"scripted exhaustion (smoothPrompt)\",\n276\t      }),\n277\t    ]);\n278\t\n279\t    const form = formOf(filePath, \"m1\", \"smoothed_prompt\");\n280\t    expect(form?.state).toBe(\"failed\");\n281\t    expect(form?.reason).toBe(\"scripted exhaustion (smoothPrompt)\");\n282\t    expect(form?.content).toBeUndefined();\n283\t\n284\t    const listed = await sdk.messages.listMessages({ filePath });\n285\t    expect(listed.ok).toBe(true);\n286\t    if (!listed.ok) return;\n287\t    expect(listed.value).toHaveLength(1);\n288\t    expect(listed.value[0]?.blocks[0]?.content[\"text\"]).toBe(text);\n289\t  });\n290\t});\n291\t\n292\tdescribe(\"TC-2.7 / AC-2.7: kinds with no derivable form queue no work and carry no state rows\", () => {\n293\t  it(\"assistant text and a runtime note: no items, no derivation rows, an empty drain\", async () => {\n294\t    const double = createProviderDouble();\n295\t    const sdk = manualSdk(double);\n296\t    const filePath = await newThread();\n297\t\n298\t    const batch = await send(sdk, filePath, [\n299\t      validEvent(\"assistant_text\"),\n300\t      validEvent(\"runtime_note\"),\n301\t    ]);\n302\t    expect(batch.queuedWork).toEqual([]);\n303\t    expect(liveCount(filePath)).toBe(0);\n304\t\n305\t    const report = await drain(sdk, filePath);\n306\t    expect(report.ran).toEqual([]);\n307\t    expect(report.stoppedBecause).toBe(\"empty\");\n308\t    expect(readDerivedForms(filePath)).toEqual([]);\n309\t  });\n310\t});\n311\t\n312\tdescribe(\"TC-2.8 / AC-2.8 (architecture risk): a late result re-queues an unknown-outcome summary at intake\", () => {\n313\t  it(\"split batches: the result's intake re-queues the summary; the repair is a real queue round-trip\", async () => {\n314\t    const double = createProviderDouble();\n315\t    const sdk = manualSdk(double);\n316\t    const filePath = await newThread();\n317\t\n318\t    // Batch 1: the call alone. Its summary derives with no pair in sight.\n319\t    await send(sdk, filePath, [validEvent(\"tool_call\")]);\n320\t    await drain(sdk, filePath);\n321\t    const before = formOf(filePath, \"m1\", \"tool_call_summary\");\n322\t    expect(before?.state).toBe(\"ready\");\n323\t    expect(before?.metadata).toEqual({ outcome: \"unknown\" });\n324\t    expect(before?.sourceVersion).toBe(1);\n325\t\n326\t    // Batch 2: the paired result lands later. The intake result itself\n327\t    // reports the re-queued summary — repair is intake-time and visible,\n328\t    // not a read-time join.\n329\t    const batch = await send(sdk, filePath, [validEvent(\"tool_result\")]);\n330\t    expect(batch.queuedWork).toContainEqual({\n331\t      workItemId: \"w-m2-tool_result_summary-v1\",\n332\t      owner: \"messages\",\n333\t      kind: \"tool_result_summary\",\n334\t      sourceRef: { messageId: \"m2\" },\n335\t    });\n336\t    expect(batch.queuedWork).toContainEqual({\n337\t      workItemId: \"w-m1-tool_call_summary-v2\",\n338\t      owner: \"messages\",\n339\t      kind: \"tool_call_summary\",\n340\t      sourceRef: { messageId: \"m1\" },\n341\t    });\n342\t    // The clear half of clear-and-regenerate rode the batch transaction.\n343\t    const cleared = formOf(filePath, \"m1\", \"tool_call_summary\");\n344\t    expect(cleared?.state).toBe(\"pending\");\n345\t    expect(cleared?.sourceVersion).toBe(2);\n346\t\n347\t    const report = await drain(sdk, filePath);\n348\t    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n349\t      [\"w-m2-tool_result_summary-v1\", \"done\"],\n350\t      [\"w-m1-tool_call_summary-v2\", \"done\"],\n351\t    ]);\n352\t\n353\t    // One summary form, outcome repaired, source version advanced — the\n354\t    // proof the artifact was re-derived through the queue, not patched.\n355\t    const summaries = readDerivedForms(filePath).filter(\n356\t      (f) => f.form === \"tool_call_summary\",\n357\t    );\n358\t    expect(summaries).toHaveLength(1);\n359\t    expect(summaries[0]).toMatchObject({\n360\t      subjectId: \"m1\",\n361\t      state: \"ready\",\n362\t      sourceVersion: 2,\n363\t      metadata: { outcome: \"succeeded\" },\n364\t    });\n365\t    expect(liveCount(filePath)).toBe(0);\n366\t  });\n367\t\n368\t  it(\"control: call and result in one batch never trigger the re-queue; the summary runs exactly once\", async () => {\n369\t    const double = createProviderDouble();\n370\t    const captured = double.captureInputs();\n371\t    const sdk = manualSdk(double);\n372\t    const filePath = await newThread();\n373\t\n374\t    const batch = await send(sdk, filePath, [\n375\t      validEvent(\"tool_call\"),\n376\t      validEvent(\"tool_result\"),\n377\t    ]);\n378\t    const summaryItems = batch.queuedWork.filter((item) => item.kind === \"tool_call_summary\");\n379\t    expect(summaryItems.map((item) => item.workItemId)).toEqual([\n380\t      \"w-m1-tool_call_summary-v1\",\n381\t    ]);\n382\t\n383\t    await drain(sdk, filePath);\n384\t    // The capture log proves the summary ran once — after both halves of its\n385\t    // pair landed, so it saw the result and stamped succeeded directly.\n386\t    expect(captured.filter((entry) => entry.op === \"summarizeToolCall\")).toHaveLength(1);\n387\t    const form = formOf(filePath, \"m1\", \"tool_call_summary\");\n388\t    expect(form).toMatchObject({\n389\t      state: \"ready\",\n390\t      sourceVersion: 1,\n391\t      metadata: { outcome: \"succeeded\" },\n392\t    });\n393\t    expect(liveCount(filePath)).toBe(0);\n394\t  });\n395\t});\n396\t"}]},"parent_tool_use_id":null,"session_id":"ba70f466-14e7-455b-b784-68aa93368849","uuid":"652f5778-25fe-499c-9f91-79299290aa27","timestamp":"2026-06-11T04:45:32.478Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/derivation-messages.test.ts","content":"// Story 2 (Epic 02): message-level derivation — Flow 2. The three real\n// handlers (prompt smoothing, tool-call summary, tool-result summary) through\n// Story 1's drain, mechanical outcome stamping (TC-2.4's identical-text\n// fixture is the architecture-risk proof that provider text never drives the\n// outcome), the hot-path locality assertion (TC-2.2: intake returns before\n// any provider call), and the AC-2.8 late-result repair with its\n// control leg. No registerTestWorkHandlers here: every drain dispatches the\n// production handlers registered by the messages domain at createSdk.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  countLiveItems,\n  createSdk,\n  deterministicText,\n  threads,\n  type BatchResult,\n  type DerivationProvider,\n  type DrainReport,\n  type Lhc,\n  type MessageEventInput,\n} from \"../src/index.js\";\nimport {\n  createProviderDouble,\n  openRaw,\n  readDerivedForms,\n  tempStore,\n  threadWithToolRun,\n  validEvent,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nasync function newThread(): Promise<string> {\n  const created = await threads.newThread({\n    filePath: store.threadPath(),\n    registryPath: store.registryPath,\n  });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n  return created.value.filePath;\n}\n\nfunction manualSdk(provider: DerivationProvider): Lhc {\n  return createSdk({\n    provider,\n    mode: \"manual\",\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    lease: { durationMs: 200 },\n  });\n}\n\nasync function send(\n  sdk: Lhc,\n  filePath: string,\n  batch: readonly MessageEventInput[],\n): Promise<BatchResult> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n  return result.value;\n}\n\nasync function drain(sdk: Lhc, filePath: string): Promise<DrainReport> {\n  const result = await sdk.work.drain({ filePath });\n  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n  return result.value;\n}\n\nfunction liveCount(filePath: string): number {\n  const db = openRaw(filePath);\n  try {\n    return countLiveItems(db);\n  } finally {\n    db.close();\n  }\n}\n\nfunction formOf(filePath: string, subjectId: string, form: string) {\n  return readDerivedForms(filePath).find(\n    (f) => f.subjectId === subjectId && f.form === form,\n  );\n}\n\ndescribe(\"TC-2.1 / AC-2.1: prompt smoothing lands a ready form readable alongside the message\", () => {\n  it(\"intake a prompt, drain → smoothed form ready with the double's deterministic output\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    const text = \"please smooth this prompt\";\n    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text } })]);\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran).toEqual([\n      expect.objectContaining({\n        workItemId: \"w-m1-prompt_smoothing-v1\",\n        disposition: \"done\",\n      }),\n    ]);\n\n    // Readable alongside the message through the production read surface\n    // (02F-001): listMessages carries the stored form on the message record —\n    // not a fixture read of derived_form.\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const message = listed.value[0];\n    expect(message?.blocks[0]?.content[\"text\"]).toBe(text);\n    expect(message?.forms).toEqual([\n      expect.objectContaining({\n        subjectKind: \"message\",\n        subjectId: \"m1\",\n        form: \"smoothed_prompt\",\n        state: \"ready\",\n        // The content is the double's pure function of the prompt text — the\n        // production smoothPrompt input shape, nothing else mixed in.\n        content: deterministicText(\"smoothPrompt\", { text }, text),\n        sourceVersion: 1,\n      }),\n    ]);\n\n    // The raw row agrees with the surfaced read: stored state, not a\n    // read-time derivation.\n    const raw = formOf(filePath, \"m1\", \"smoothed_prompt\");\n    expect(raw?.state).toBe(\"ready\");\n    expect(raw?.content).toBe(deterministicText(\"smoothPrompt\", { text }, text));\n  });\n});\n\ndescribe(\"TC-2.2 / AC-2.2: tool_call queues its summary additively; intake returns before any handler runs\", () => {\n  it(\"the batch reports the queued item with the capture log still empty; the drained summary names tool and args\", async () => {\n    const double = createProviderDouble();\n    const captured = double.captureInputs();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n\n    const batch = await send(sdk, filePath, [validEvent(\"tool_call\")]);\n    // Hot-path NFR made testable: the intake result is in hand and the\n    // provider has never been called — queueing and derivation are decoupled\n    // in time, not just in code.\n    expect(captured).toHaveLength(0);\n    expect(batch.queuedWork).toEqual([\n      {\n        workItemId: \"w-m1-tool_call_summary-v1\",\n        owner: \"messages\",\n        kind: \"tool_call_summary\",\n        sourceRef: { messageId: \"m1\" },\n      },\n    ]);\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran).toEqual([\n      expect.objectContaining({\n        workItemId: \"w-m1-tool_call_summary-v1\",\n        disposition: \"done\",\n      }),\n    ]);\n    const form = formOf(filePath, \"m1\", \"tool_call_summary\");\n    expect(form?.state).toBe(\"ready\");\n    // Names the tool and describes its arguments (fixture default payload).\n    expect(form?.content).toContain(\"read_file\");\n    expect(form?.content).toContain('{\"path\":\"notes.txt\"}');\n    // No paired result intaken: outcome stamped unknown, in metadata.\n    expect(form?.metadata).toEqual({ outcome: \"unknown\" });\n  });\n});\n\ndescribe(\"TC-2.3 / AC-2.3: the result summary abbreviates; the full content stays byte-identical in the record\", () => {\n  it(\"a 300KB result drains to a bounded summary and reads back whole through the Epic 01 surface\", async () => {\n    const big = \"result-bytes \".repeat(24000); // ~300KB\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const { filePath } = await threadWithToolRun(store, { resultContent: big });\n\n    await drain(sdk, filePath);\n    const summary = formOf(filePath, \"m3\", \"tool_result_summary\");\n    expect(summary?.state).toBe(\"ready\");\n    expect(summary?.content?.startsWith(\"toolresult(\")).toBe(true);\n    // Summarized means abbreviated: marker + digest + 40-char prefix.\n    expect(summary?.content?.length ?? 0).toBeLessThan(100);\n    expect(summary?.metadata).toEqual({ outcome: \"succeeded\" });\n\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const resultMessage = listed.value.find((m) => m.kind === \"tool_result\");\n    expect(resultMessage?.blocks[0]?.content[\"content\"]).toBe(big);\n  });\n});\n\ndescribe(\"TC-2.4 / AC-2.4 (architecture risk): outcome is stamped from the record, never from provider text\", () => {\n  it(\"three variants with identical provider text land succeeded / failed / unknown from metadata alone\", async () => {\n    // The identical-text fixture: summarizeToolCall returns one constant\n    // string no matter the input, at the same production seam. If any code\n    // path inferred outcome from text, all three variants would agree.\n    const constantText = \"the tool was invoked with some arguments\";\n    const double = createProviderDouble();\n    const provider: DerivationProvider = {\n      smoothPrompt: (i) => double.smoothPrompt(i),\n      summarizeToolCall: () => Promise.resolve({ ok: true, text: constantText }),\n      summarizeToolResult: (i) => double.summarizeToolResult(i),\n      composeTurnRendering: (i) => double.composeTurnRendering(i),\n      projectLowerBand: (i) => double.projectLowerBand(i),\n      summarizeChunkDetailed: (i) => double.summarizeChunkDetailed(i),\n      summarizeChunkBrief: (i) => double.summarizeChunkBrief(i),\n    };\n    const sdk = manualSdk(provider);\n\n    const ok = await threadWithToolRun(store);\n    const errored = await threadWithToolRun(store, { isError: true });\n    const missing = await threadWithToolRun(store, { missingResult: true });\n    for (const { filePath } of [ok, errored, missing]) await drain(sdk, filePath);\n\n    const summaries = [ok, errored, missing].map(({ filePath }) =>\n      formOf(filePath, \"m2\", \"tool_call_summary\"),\n    );\n    expect(summaries.map((f) => f?.state)).toEqual([\"ready\", \"ready\", \"ready\"]);\n    // Text identical across all three…\n    expect(summaries.map((f) => f?.content)).toEqual([\n      constantText,\n      constantText,\n      constantText,\n    ]);\n    // …while the outcome differs, read from metadata — machine-readable\n    // apart from the provider's prose, which mentions no outcome at all.\n    expect(summaries.map((f) => f?.metadata?.outcome)).toEqual([\n      \"succeeded\",\n      \"failed\",\n      \"unknown\",\n    ]);\n  });\n});\n\ndescribe(\"TC-2.5 / AC-2.5: message-level input discipline — the message and its call-id pair only\", () => {\n  it(\"the captured tool-call summary input is exactly the call plus its paired result\", async () => {\n    const double = createProviderDouble();\n    const captured = double.captureInputs();\n    const sdk = manualSdk(double);\n    const { filePath } = await threadWithToolRun(store);\n\n    await drain(sdk, filePath);\n    const inputs = captured.filter((entry) => entry.op === \"summarizeToolCall\");\n    expect(inputs).toHaveLength(1);\n    // Exact equality: no turn ids, no membership, no chunk context — the\n    // production seam receives the pair and nothing else.\n    expect(inputs[0]?.input).toEqual({\n      toolName: \"read_file\",\n      argsJson: '{\"path\":\"notes.txt\"}',\n      pairedResult: { content: \"contents of notes.txt\", isError: false },\n    });\n  });\n});\n\ndescribe(\"TC-2.6 / AC-2.6: provider exhaustion lands the form failed; the message stays readable\", () => {\n  it(\"smoothing exhausts the retry budget → form failed with the provider's reason; read-back unaffected\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    const text = \"this prompt will never smooth\";\n    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text } })]);\n\n    double.failKind(\"prompt_smoothing\", 99, {\n      retryable: true,\n      reason: \"scripted exhaustion (smoothPrompt)\",\n    });\n    const report = await drain(sdk, filePath);\n    expect(report.ran).toEqual([\n      expect.objectContaining({\n        workItemId: \"w-m1-prompt_smoothing-v1\",\n        disposition: \"failed_terminal\",\n        attempts: 3,\n        reason: \"scripted exhaustion (smoothPrompt)\",\n      }),\n    ]);\n\n    const form = formOf(filePath, \"m1\", \"smoothed_prompt\");\n    expect(form?.state).toBe(\"failed\");\n    expect(form?.reason).toBe(\"scripted exhaustion (smoothPrompt)\");\n    expect(form?.content).toBeUndefined();\n\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    expect(listed.value).toHaveLength(1);\n    expect(listed.value[0]?.blocks[0]?.content[\"text\"]).toBe(text);\n  });\n});\n\ndescribe(\"TC-2.7 / AC-2.7: kinds with no derivable form queue no work and carry no state rows\", () => {\n  it(\"assistant text and a runtime note: no items, no derivation rows, an empty drain\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n\n    const batch = await send(sdk, filePath, [\n      validEvent(\"assistant_text\"),\n      validEvent(\"runtime_note\"),\n    ]);\n    expect(batch.queuedWork).toEqual([]);\n    expect(liveCount(filePath)).toBe(0);\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran).toEqual([]);\n    expect(report.stoppedBecause).toBe(\"empty\");\n    expect(readDerivedForms(filePath)).toEqual([]);\n  });\n});\n\ndescribe(\"TC-2.8 / AC-2.8 (architecture risk): a late result re-queues an unknown-outcome summary at intake\", () => {\n  it(\"split batches: the result's intake re-queues the summary; the repair is a real queue round-trip\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n\n    // Batch 1: the call alone. Its summary derives with no pair in sight.\n    await send(sdk, filePath, [validEvent(\"tool_call\")]);\n    await drain(sdk, filePath);\n    const before = formOf(filePath, \"m1\", \"tool_call_summary\");\n    expect(before?.state).toBe(\"ready\");\n    expect(before?.metadata).toEqual({ outcome: \"unknown\" });\n    expect(before?.sourceVersion).toBe(1);\n\n    // Batch 2: the paired result lands later. The intake result itself\n    // reports the re-queued summary — repair is intake-time and visible,\n    // not a read-time join.\n    const batch = await send(sdk, filePath, [validEvent(\"tool_result\")]);\n    expect(batch.queuedWork).toContainEqual({\n      workItemId: \"w-m2-tool_result_summary-v1\",\n      owner: \"messages\",\n      kind: \"tool_result_summary\",\n      sourceRef: { messageId: \"m2\" },\n    });\n    expect(batch.queuedWork).toContainEqual({\n      workItemId: \"w-m1-tool_call_summary-v2\",\n      owner: \"messages\",\n      kind: \"tool_call_summary\",\n      sourceRef: { messageId: \"m1\" },\n    });\n    // The clear half of clear-and-regenerate rode the batch transaction.\n    const cleared = formOf(filePath, \"m1\", \"tool_call_summary\");\n    expect(cleared?.state).toBe(\"pending\");\n    expect(cleared?.sourceVersion).toBe(2);\n\n    const report = await drain(sdk, filePath);\n    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n      [\"w-m2-tool_result_summary-v1\", \"done\"],\n      [\"w-m1-tool_call_summary-v2\", \"done\"],\n    ]);\n\n    // One summary form, outcome repaired, source version advanced — the\n    // proof the artifact was re-derived through the queue, not patched.\n    const summaries = readDerivedForms(filePath).filter(\n      (f) => f.form === \"tool_call_summary\",\n    );\n    expect(summaries).toHaveLength(1);\n    expect(summaries[0]).toMatchObject({\n      subjectId: \"m1\",\n      state: \"ready\",\n      sourceVersion: 2,\n      metadata: { outcome: \"succeeded\" },\n    });\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"control: call and result in one batch never trigger the re-queue; the summary runs exactly once\", async () => {\n    const double = createProviderDouble();\n    const captured = double.captureInputs();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n\n    const batch = await send(sdk, filePath, [\n      validEvent(\"tool_call\"),\n      validEvent(\"tool_result\"),\n    ]);\n    const summaryItems = batch.queuedWork.filter((item) => item.kind === \"tool_call_summary\");\n    expect(summaryItems.map((item) => item.workItemId)).toEqual([\n      \"w-m1-tool_call_summary-v1\",\n    ]);\n\n    await drain(sdk, filePath);\n    // The capture log proves the summary ran once — after both halves of its\n    // pair landed, so it saw the result and stamped succeeded directly.\n    expect(captured.filter((entry) => entry.op === \"summarizeToolCall\")).toHaveLength(1);\n    const form = formOf(filePath, \"m1\", \"tool_call_summary\");\n    expect(form).toMatchObject({\n      state: \"ready\",\n      sourceVersion: 1,\n      metadata: { outcome: \"succeeded\" },\n    });\n    expect(liveCount(filePath)).toBe(0);\n  });\n});\n","numLines":396,"startLine":1,"totalLines":396}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017TDJ4xcrq3LgDrmdGtnLSr","type":"tool_result","content":"1\texport * as threads from \"./domains/threads/index.js\";\n2\texport * as intakeStream from \"./domains/intake-stream/index.js\";\n3\texport * as messages from \"./domains/messages/index.js\";\n4\texport * as turns from \"./domains/turns/index.js\";\n5\t\n6\timport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\n7\timport * as messagesDomain from \"./domains/messages/index.js\";\n8\timport * as threadsDomain from \"./domains/threads/index.js\";\n9\timport * as turnsDomain from \"./domains/turns/index.js\";\n10\timport {\n11\t  createScheduler,\n12\t  peekThreadId,\n13\t  runDrain,\n14\t  type DrainDeps,\n15\t  type DrainReport,\n16\t  type Scheduler,\n17\t} from \"./scheduler.js\";\n18\timport { setSchedulerPoke as installSchedulerPoke, setThreadTouch } from \"./shared/context.js\";\n19\timport {\n20\t  PROVIDER_OPERATIONS,\n21\t  type ResolvedSdkConfig,\n22\t  type SdkConfig,\n23\t  type WorkHandler,\n24\t} from \"./shared/derivation.js\";\n25\timport type { ErrorResult, OpResult } from \"./shared/errors.js\";\n26\timport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n27\t\n28\texport {\n29\t  estimateTokens,\n30\t  TOKEN_ESTIMATOR_ID,\n31\t} from \"./tech-utils/token-counting/index.js\";\n32\t\n33\texport {\n34\t  WORK_KIND_REGISTRY,\n35\t  type WorkItemRecord,\n36\t  type WorkKind,\n37\t  type WorkOwner,\n38\t  type WorkSourceRef,\n39\t} from \"./tech-utils/work-queue/index.js\";\n40\t\n41\texport type {\n42\t  ErrorClass,\n43\t  ErrorCode,\n44\t  ErrorResult,\n45\t  OpResult,\n46\t} from \"./shared/errors.js\";\n47\texport {\n48\t  runInTransaction,\n49\t  setSchedulerPoke,\n50\t  setThreadTouch,\n51\t  type OperationContext,\n52\t} from \"./shared/context.js\";\n53\t\n54\texport {\n55\t  createDeterministicProvider,\n56\t  deterministicText,\n57\t  type DeterministicOpName,\n58\t} from \"./providers/deterministic.js\";\n59\texport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n60\t\n61\texport type {\n62\t  DependencyGap,\n63\t  DerivationProvider,\n64\t  DerivedForm,\n65\t  DerivedFormMetadata,\n66\t  DerivedFormState,\n67\t  FormKind,\n68\t  HandlerFormWrite,\n69\t  HandlerOutcome,\n70\t  HandlerRunContext,\n71\t  ProviderResult,\n72\t  RenderingPart,\n73\t  ResolvedSdkConfig,\n74\t  SdkConfig,\n75\t  SubjectKind,\n76\t  ToolOutcome,\n77\t  WorkHandler,\n78\t} from \"./shared/derivation.js\";\n79\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n80\texport {\n81\t  countLiveItems,\n82\t  queueDetail,\n83\t  supersedeQueued,\n84\t  type ClaimedWorkItem,\n85\t  type QueueDetailRow,\n86\t} from \"./tech-utils/work-queue/index.js\";\n87\t\n88\texport type { ThreadRef } from \"./domains/threads/index.js\";\n89\texport type {\n90\t  Block,\n91\t  BlockType,\n92\t  MessageRecord,\n93\t} from \"./domains/messages/index.js\";\n94\texport type { TurnRecord } from \"./domains/turns/index.js\";\n95\texport type {\n96\t  BatchResult,\n97\t  EventKind,\n98\t  EventRecord,\n99\t  MessageEventInput,\n100\t} from \"./domains/intake-stream/index.js\";\n101\t\n102\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n103\t\n104\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n105\t\n106\t// Merge per-domain handler tables into the one join between the queue's\n107\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n108\t// (each kind has exactly one owner) and throws at construction.\n109\texport function assembleWorkHandlerMap(\n110\t  tables: ReadonlyArray<WorkHandlerMap>,\n111\t): WorkHandlerMap {\n112\t  const map: WorkHandlerMap = {};\n113\t  for (const table of tables) {\n114\t    for (const [kind, handler] of Object.entries(table)) {\n115\t      if (map[kind as WorkKind] !== undefined) {\n116\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n117\t      }\n118\t      map[kind as WorkKind] = handler;\n119\t    }\n120\t  }\n121\t  return map;\n122\t}\n123\t\n124\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n125\t  return {\n126\t    ok: false,\n127\t    error: {\n128\t      errorClass: \"state_corruption\",\n129\t      code: \"unknown_work_kind\",\n130\t      reason: `no handler registered for work kind \"${kind}\"`,\n131\t    },\n132\t  };\n133\t}\n134\t\n135\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n136\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n137\texport function lookupWorkHandler(\n138\t  map: WorkHandlerMap,\n139\t  kind: string,\n140\t): OpResult<WorkHandler> {\n141\t  const handler = map[kind as WorkKind];\n142\t  if (handler === undefined) return unknownWorkKind(kind);\n143\t  return { ok: true, value: handler };\n144\t}\n145\t\n146\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n147\t// requeue land in Story 4.\n148\texport interface WorkSurface {\n149\t  drain(\n150\t    ref: threadsDomain.ThreadRef,\n151\t    opts?: { maxItems?: number },\n152\t  ): Promise<OpResult<DrainReport>>;\n153\t}\n154\t\n155\texport interface Lhc {\n156\t  threads: typeof threadsDomain;\n157\t  intakeStream: typeof intakeStreamDomain;\n158\t  messages: typeof messagesDomain;\n159\t  turns: typeof turnsDomain;\n160\t  config: ResolvedSdkConfig;\n161\t  scheduler: Scheduler;\n162\t  workHandlers: WorkHandlerMap;\n163\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n164\t  work: WorkSurface;\n165\t  // Resolves when the scheduler has no running or pending drain for the\n166\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n167\t  // resolve in manual mode.\n168\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n169\t}\n170\t\n171\tfunction requirePositive(value: number, name: string): void {\n172\t  if (!Number.isFinite(value) || value <= 0) {\n173\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n174\t  }\n175\t}\n176\t\n177\tfunction requireNonNegative(value: number, name: string): void {\n178\t  if (!Number.isFinite(value) || value < 0) {\n179\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n180\t  }\n181\t}\n182\t\n183\t// The only assembly path: provider, mode, clock, and policy enter here.\n184\t// Config mistakes are programmer errors at construction and throw; operating\n185\t// failures after construction return OpResults per the error contract.\n186\texport function createSdk(config: SdkConfig): Lhc {\n187\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n188\t    throw new TypeError(\n189\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n190\t    );\n191\t  }\n192\t  if (config.provider === null || typeof config.provider !== \"object\") {\n193\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n194\t  }\n195\t  for (const operation of PROVIDER_OPERATIONS) {\n196\t    if (typeof config.provider[operation] !== \"function\") {\n197\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n198\t    }\n199\t  }\n200\t\n201\t  const resolved: ResolvedSdkConfig = {\n202\t    provider: config.provider,\n203\t    mode: config.mode,\n204\t    clock: config.clock ?? (() => new Date()),\n205\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n206\t    lease: config.lease ?? { durationMs: 120000 },\n207\t    chunkPolicy:\n208\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n209\t  };\n210\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n211\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n212\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n213\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n214\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n215\t  }\n216\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n217\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n218\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n219\t    throw new TypeError(\n220\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n221\t    );\n222\t  }\n223\t\n224\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n225\t  // The tables are empty until Stories 2–3 land the real handlers; the\n226\t  // assembly mechanics are production code from day one.\n227\t  const workHandlers = assembleWorkHandlerMap([\n228\t    messagesDomain.workHandlers,\n229\t    turnsDomain.workHandlers,\n230\t  ]);\n231\t\n232\t  const drainDeps: DrainDeps = {\n233\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n234\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n235\t    config: resolved,\n236\t  };\n237\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n238\t\n239\t  // Background mode wires the scheduler into the process-wide seams: enqueue\n240\t  // pokes (DD-5) and thread-file touches (DD-10) reach it from then on, and\n241\t  // queueing alone causes processing (AC-1.5). The slots hold one scheduler;\n242\t  // constructing a later background SDK supersedes an earlier one (the\n243\t  // displaced scheduler's in-memory state was advisory — the rows remain).\n244\t  // Manual mode leaves the slots alone: pokes stay no-ops by contract.\n245\t  if (resolved.mode === \"background\") {\n246\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n247\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n248\t  }\n249\t\n250\t  const work: WorkSurface = {\n251\t    drain: async (ref, opts) => {\n252\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n253\t      if (!resolvedRef.ok) return resolvedRef;\n254\t      return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n255\t    },\n256\t  };\n257\t\n258\t  return {\n259\t    threads: threadsDomain,\n260\t    intakeStream: intakeStreamDomain,\n261\t    messages: messagesDomain,\n262\t    turns: turnsDomain,\n263\t    config: resolved,\n264\t    scheduler,\n265\t    workHandlers,\n266\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n267\t    work,\n268\t    drainSettled: async (ref) => {\n269\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n270\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n271\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n272\t      if (threadId === null) return;\n273\t      return scheduler.drainSettled(threadId);\n274\t    },\n275\t  };\n276\t}\n277\t"}]},"parent_tool_use_id":null,"session_id":"ba70f466-14e7-455b-b784-68aa93368849","uuid":"77db52a9-f23d-40ac-83f6-cb67d24f64a5","timestamp":"2026-06-11T04:44:36.892Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts","content":"export * as threads from \"./domains/threads/index.js\";\nexport * as intakeStream from \"./domains/intake-stream/index.js\";\nexport * as messages from \"./domains/messages/index.js\";\nexport * as turns from \"./domains/turns/index.js\";\n\nimport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\nimport * as messagesDomain from \"./domains/messages/index.js\";\nimport * as threadsDomain from \"./domains/threads/index.js\";\nimport * as turnsDomain from \"./domains/turns/index.js\";\nimport {\n  createScheduler,\n  peekThreadId,\n  runDrain,\n  type DrainDeps,\n  type DrainReport,\n  type Scheduler,\n} from \"./scheduler.js\";\nimport { setSchedulerPoke as installSchedulerPoke, setThreadTouch } from \"./shared/context.js\";\nimport {\n  PROVIDER_OPERATIONS,\n  type ResolvedSdkConfig,\n  type SdkConfig,\n  type WorkHandler,\n} from \"./shared/derivation.js\";\nimport type { ErrorResult, OpResult } from \"./shared/errors.js\";\nimport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n\nexport {\n  estimateTokens,\n  TOKEN_ESTIMATOR_ID,\n} from \"./tech-utils/token-counting/index.js\";\n\nexport {\n  WORK_KIND_REGISTRY,\n  type WorkItemRecord,\n  type WorkKind,\n  type WorkOwner,\n  type WorkSourceRef,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type {\n  ErrorClass,\n  ErrorCode,\n  ErrorResult,\n  OpResult,\n} from \"./shared/errors.js\";\nexport {\n  runInTransaction,\n  setSchedulerPoke,\n  setThreadTouch,\n  type OperationContext,\n} from \"./shared/context.js\";\n\nexport {\n  createDeterministicProvider,\n  deterministicText,\n  type DeterministicOpName,\n} from \"./providers/deterministic.js\";\nexport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n\nexport type {\n  DependencyGap,\n  DerivationProvider,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  HandlerFormWrite,\n  HandlerOutcome,\n  HandlerRunContext,\n  ProviderResult,\n  RenderingPart,\n  ResolvedSdkConfig,\n  SdkConfig,\n  SubjectKind,\n  ToolOutcome,\n  WorkHandler,\n} from \"./shared/derivation.js\";\nexport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\nexport {\n  countLiveItems,\n  queueDetail,\n  supersedeQueued,\n  type ClaimedWorkItem,\n  type QueueDetailRow,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type { ThreadRef } from \"./domains/threads/index.js\";\nexport type {\n  Block,\n  BlockType,\n  MessageRecord,\n} from \"./domains/messages/index.js\";\nexport type { TurnRecord } from \"./domains/turns/index.js\";\nexport type {\n  BatchResult,\n  EventKind,\n  EventRecord,\n  MessageEventInput,\n} from \"./domains/intake-stream/index.js\";\n\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n\n// Merge per-domain handler tables into the one join between the queue's\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n// (each kind has exactly one owner) and throws at construction.\nexport function assembleWorkHandlerMap(\n  tables: ReadonlyArray<WorkHandlerMap>,\n): WorkHandlerMap {\n  const map: WorkHandlerMap = {};\n  for (const table of tables) {\n    for (const [kind, handler] of Object.entries(table)) {\n      if (map[kind as WorkKind] !== undefined) {\n        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n      }\n      map[kind as WorkKind] = handler;\n    }\n  }\n  return map;\n}\n\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"state_corruption\",\n      code: \"unknown_work_kind\",\n      reason: `no handler registered for work kind \"${kind}\"`,\n    },\n  };\n}\n\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\nexport function lookupWorkHandler(\n  map: WorkHandlerMap,\n  kind: string,\n): OpResult<WorkHandler> {\n  const handler = map[kind as WorkKind];\n  if (handler === undefined) return unknownWorkKind(kind);\n  return { ok: true, value: handler };\n}\n\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n// requeue land in Story 4.\nexport interface WorkSurface {\n  drain(\n    ref: threadsDomain.ThreadRef,\n    opts?: { maxItems?: number },\n  ): Promise<OpResult<DrainReport>>;\n}\n\nexport interface Lhc {\n  threads: typeof threadsDomain;\n  intakeStream: typeof intakeStreamDomain;\n  messages: typeof messagesDomain;\n  turns: typeof turnsDomain;\n  config: ResolvedSdkConfig;\n  scheduler: Scheduler;\n  workHandlers: WorkHandlerMap;\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n  work: WorkSurface;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3) — the awaitable for background mode, and a no-op\n  // resolve in manual mode.\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n}\n\nfunction requirePositive(value: number, name: string): void {\n  if (!Number.isFinite(value) || value <= 0) {\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n  }\n}\n\nfunction requireNonNegative(value: number, name: string): void {\n  if (!Number.isFinite(value) || value < 0) {\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n  }\n}\n\n// The only assembly path: provider, mode, clock, and policy enter here.\n// Config mistakes are programmer errors at construction and throw; operating\n// failures after construction return OpResults per the error contract.\nexport function createSdk(config: SdkConfig): Lhc {\n  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n    throw new TypeError(\n      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n    );\n  }\n  if (config.provider === null || typeof config.provider !== \"object\") {\n    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n  }\n  for (const operation of PROVIDER_OPERATIONS) {\n    if (typeof config.provider[operation] !== \"function\") {\n      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n    }\n  }\n\n  const resolved: ResolvedSdkConfig = {\n    provider: config.provider,\n    mode: config.mode,\n    clock: config.clock ?? (() => new Date()),\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n    lease: config.lease ?? { durationMs: 120000 },\n    chunkPolicy:\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n  };\n  requirePositive(resolved.retry.budget, \"retry.budget\");\n  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n  }\n  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n    throw new TypeError(\n      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n    );\n  }\n\n  // Handler maps merge from per-domain contributions at construction (DD-6).\n  // The tables are empty until Stories 2–3 land the real handlers; the\n  // assembly mechanics are production code from day one.\n  const workHandlers = assembleWorkHandlerMap([\n    messagesDomain.workHandlers,\n    turnsDomain.workHandlers,\n  ]);\n\n  const drainDeps: DrainDeps = {\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n    config: resolved,\n  };\n  const scheduler = createScheduler(resolved.mode, drainDeps);\n\n  // Background mode wires the scheduler into the process-wide seams: enqueue\n  // pokes (DD-5) and thread-file touches (DD-10) reach it from then on, and\n  // queueing alone causes processing (AC-1.5). The slots hold one scheduler;\n  // constructing a later background SDK supersedes an earlier one (the\n  // displaced scheduler's in-memory state was advisory — the rows remain).\n  // Manual mode leaves the slots alone: pokes stay no-ops by contract.\n  if (resolved.mode === \"background\") {\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n  }\n\n  const work: WorkSurface = {\n    drain: async (ref, opts) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return resolvedRef;\n      return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n    },\n  };\n\n  return {\n    threads: threadsDomain,\n    intakeStream: intakeStreamDomain,\n    messages: messagesDomain,\n    turns: turnsDomain,\n    config: resolved,\n    scheduler,\n    workHandlers,\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    work,\n    drainSettled: async (ref) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n      const threadId = peekThreadId(resolvedRef.value.filePath);\n      if (threadId === null) return;\n      return scheduler.drainSettled(threadId);\n    },\n  };\n}\n","numLines":277,"startLine":1,"totalLines":277}}}

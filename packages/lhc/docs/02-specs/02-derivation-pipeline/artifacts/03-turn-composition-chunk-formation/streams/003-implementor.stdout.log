{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016x2UxEFVeJmuvq3YEFQfsU","type":"tool_result","content":"1\t// Message-domain reads for derivation (Flow 2): the handler's view of its\n2\t// source message and the call-id pairing reads — the only reach a\n3\t// message-level handler has beyond its own message (AC-2.5). Also the\n4\t// late-result repair lookup intake's projection step runs (AC-2.8): one\n5\t// indexed query by call id, never a scan (the v5 expression index on\n6\t// message_block covers it) and never a drain-time sweep or read-time join.\n7\t// Completion writes for message forms ride the work-queue util's `complete`\n8\t// (Story 1): UPDATE-only with the source-version check — no write path here.\n9\t// Read-back of message-owned form rows (the listMessages join) also lives\n10\t// here: stored state returned as stored — never re-derived on read.\n11\timport type { DatabaseSync } from \"node:sqlite\";\n12\timport type {\n13\t  DependencyGap,\n14\t  DerivedForm,\n15\t  DerivedFormMetadata,\n16\t  DerivedFormState,\n17\t  FormKind,\n18\t} from \"../../../shared/derivation.js\";\n19\t\n20\texport interface MessageSource {\n21\t  messageId: string;\n22\t  kind: string;\n23\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n24\t}\n25\t\n26\texport function readMessageSource(\n27\t  db: DatabaseSync,\n28\t  messageId: string,\n29\t): MessageSource | undefined {\n30\t  const row = db\n31\t    .prepare(`SELECT kind FROM message WHERE message_id = ?`)\n32\t    .get(messageId) as unknown as { kind: string } | undefined;\n33\t  if (row === undefined) return undefined;\n34\t  const blocks = db\n35\t    .prepare(\n36\t      `SELECT block_type, content FROM message_block\n37\t       WHERE message_id = ? ORDER BY block_index`,\n38\t    )\n39\t    .all(messageId) as unknown as Array<{ block_type: string; content: string }>;\n40\t  return {\n41\t    messageId,\n42\t    kind: row.kind,\n43\t    blocks: blocks.map((block) => ({\n44\t      blockType: block.block_type,\n45\t      content: JSON.parse(block.content) as Record<string, unknown>,\n46\t    })),\n47\t  };\n48\t}\n49\t\n50\tinterface RawFormRow {\n51\t  subject_id: string;\n52\t  form: string;\n53\t  state: string;\n54\t  content: string | null;\n55\t  reason: string | null;\n56\t  metadata: string | null;\n57\t  source_version: number | bigint;\n58\t  gaps: string | null;\n59\t  derived_at: string | null;\n60\t}\n61\t\n62\t// Every message-owned derived-form row, grouped by message id — the form\n63\t// read-back joined onto message reads (AC-2.1's \"readable alongside the\n64\t// message\"). Rows come back exactly as the queue landed them: state, content,\n65\t// reason, mechanically stamped metadata; nothing is derived at read time.\n66\texport function readMessageForms(db: DatabaseSync): Map<string, DerivedForm[]> {\n67\t  const rows = db\n68\t    .prepare(\n69\t      `SELECT subject_id, form, state, content, reason, metadata,\n70\t              source_version, gaps, derived_at\n71\t       FROM derived_form WHERE subject_kind = 'message'\n72\t       ORDER BY subject_id, form`,\n73\t    )\n74\t    .all() as unknown as RawFormRow[];\n75\t  const byMessage = new Map<string, DerivedForm[]>();\n76\t  for (const row of rows) {\n77\t    const record: DerivedForm = {\n78\t      subjectKind: \"message\",\n79\t      subjectId: row.subject_id,\n80\t      form: row.form as FormKind,\n81\t      state: row.state as DerivedFormState,\n82\t      sourceVersion: Number(row.source_version),\n83\t    };\n84\t    if (row.content !== null) record.content = row.content;\n85\t    if (row.reason !== null) record.reason = row.reason;\n86\t    if (row.metadata !== null) {\n87\t      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\n88\t    }\n89\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n90\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n91\t    const forms = byMessage.get(row.subject_id) ?? [];\n92\t    forms.push(record);\n93\t    byMessage.set(row.subject_id, forms);\n94\t  }\n95\t  return byMessage;\n96\t}\n97\t\n98\t// The call-id pairing reads. Earliest-recorded block wins if a call id were\n99\t// ever repeated; in a well-formed record the pair is unique.\n100\tfunction findPairedBlock(\n101\t  db: DatabaseSync,\n102\t  blockType: \"tool_call\" | \"tool_result\",\n103\t  toolCallId: string,\n104\t): Record<string, unknown> | undefined {\n105\t  const row = db\n106\t    .prepare(\n107\t      `SELECT b.content FROM message_block b\n108\t       JOIN message m ON m.message_id = b.message_id\n109\t       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n110\t       ORDER BY m.source_event_order LIMIT 1`,\n111\t    )\n112\t    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\n113\t  if (row === undefined) return undefined;\n114\t  return JSON.parse(row.content) as Record<string, unknown>;\n115\t}\n116\t\n117\texport function findPairedToolResult(\n118\t  db: DatabaseSync,\n119\t  toolCallId: string,\n120\t): { content: string; isError: boolean } | undefined {\n121\t  const block = findPairedBlock(db, \"tool_result\", toolCallId);\n122\t  if (block === undefined) return undefined;\n123\t  return {\n124\t    content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n125\t    isError: block[\"isError\"] === true,\n126\t  };\n127\t}\n128\t\n129\texport function findPairedToolCall(\n130\t  db: DatabaseSync,\n131\t  toolCallId: string,\n132\t): { toolName: string } | undefined {\n133\t  const block = findPairedBlock(db, \"tool_call\", toolCallId);\n134\t  if (block === undefined) return undefined;\n135\t  return { toolName: typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"\" };\n136\t}\n137\t\n138\t// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\n139\t// outcome \"unknown\"? Pending rows carry NULL metadata and never match, so the\n140\t// common case — call and result in one batch, summary not yet run — never\n141\t// triggers a requeue. Returns the call's message id and the form's current\n142\t// source version (the requeue enqueues at version + 1: the pair is the\n143\t// summary's source, and a source completing follows clear-and-regenerate).\n144\texport function findUnknownOutcomeCallSummary(\n145\t  db: DatabaseSync,\n146\t  toolCallId: string,\n147\t): { messageId: string; sourceVersion: number } | undefined {\n148\t  const row = db\n149\t    .prepare(\n150\t      `SELECT df.subject_id, df.source_version FROM message_block b\n151\t       JOIN derived_form df ON df.subject_kind = 'message'\n152\t         AND df.subject_id = b.message_id AND df.form = 'tool_call_summary'\n153\t       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\n154\t         AND json_extract(df.metadata, '$.outcome') = 'unknown'\n155\t       LIMIT 1`,\n156\t    )\n157\t    .get(toolCallId) as unknown as\n158\t    | { subject_id: string; source_version: number | bigint }\n159\t    | undefined;\n160\t  if (row === undefined) return undefined;\n161\t  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\n162\t}\n163\t"}]},"parent_tool_use_id":null,"session_id":"ba70f466-14e7-455b-b784-68aa93368849","uuid":"2c7785ad-b679-4ea3-a68c-62481e15a5c1","timestamp":"2026-06-11T04:45:18.078Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/forms.ts","content":"// Message-domain reads for derivation (Flow 2): the handler's view of its\n// source message and the call-id pairing reads — the only reach a\n// message-level handler has beyond its own message (AC-2.5). Also the\n// late-result repair lookup intake's projection step runs (AC-2.8): one\n// indexed query by call id, never a scan (the v5 expression index on\n// message_block covers it) and never a drain-time sweep or read-time join.\n// Completion writes for message forms ride the work-queue util's `complete`\n// (Story 1): UPDATE-only with the source-version check — no write path here.\n// Read-back of message-owned form rows (the listMessages join) also lives\n// here: stored state returned as stored — never re-derived on read.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type {\n  DependencyGap,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n} from \"../../../shared/derivation.js\";\n\nexport interface MessageSource {\n  messageId: string;\n  kind: string;\n  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n}\n\nexport function readMessageSource(\n  db: DatabaseSync,\n  messageId: string,\n): MessageSource | undefined {\n  const row = db\n    .prepare(`SELECT kind FROM message WHERE message_id = ?`)\n    .get(messageId) as unknown as { kind: string } | undefined;\n  if (row === undefined) return undefined;\n  const blocks = db\n    .prepare(\n      `SELECT block_type, content FROM message_block\n       WHERE message_id = ? ORDER BY block_index`,\n    )\n    .all(messageId) as unknown as Array<{ block_type: string; content: string }>;\n  return {\n    messageId,\n    kind: row.kind,\n    blocks: blocks.map((block) => ({\n      blockType: block.block_type,\n      content: JSON.parse(block.content) as Record<string, unknown>,\n    })),\n  };\n}\n\ninterface RawFormRow {\n  subject_id: string;\n  form: string;\n  state: string;\n  content: string | null;\n  reason: string | null;\n  metadata: string | null;\n  source_version: number | bigint;\n  gaps: string | null;\n  derived_at: string | null;\n}\n\n// Every message-owned derived-form row, grouped by message id — the form\n// read-back joined onto message reads (AC-2.1's \"readable alongside the\n// message\"). Rows come back exactly as the queue landed them: state, content,\n// reason, mechanically stamped metadata; nothing is derived at read time.\nexport function readMessageForms(db: DatabaseSync): Map<string, DerivedForm[]> {\n  const rows = db\n    .prepare(\n      `SELECT subject_id, form, state, content, reason, metadata,\n              source_version, gaps, derived_at\n       FROM derived_form WHERE subject_kind = 'message'\n       ORDER BY subject_id, form`,\n    )\n    .all() as unknown as RawFormRow[];\n  const byMessage = new Map<string, DerivedForm[]>();\n  for (const row of rows) {\n    const record: DerivedForm = {\n      subjectKind: \"message\",\n      subjectId: row.subject_id,\n      form: row.form as FormKind,\n      state: row.state as DerivedFormState,\n      sourceVersion: Number(row.source_version),\n    };\n    if (row.content !== null) record.content = row.content;\n    if (row.reason !== null) record.reason = row.reason;\n    if (row.metadata !== null) {\n      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\n    }\n    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n    const forms = byMessage.get(row.subject_id) ?? [];\n    forms.push(record);\n    byMessage.set(row.subject_id, forms);\n  }\n  return byMessage;\n}\n\n// The call-id pairing reads. Earliest-recorded block wins if a call id were\n// ever repeated; in a well-formed record the pair is unique.\nfunction findPairedBlock(\n  db: DatabaseSync,\n  blockType: \"tool_call\" | \"tool_result\",\n  toolCallId: string,\n): Record<string, unknown> | undefined {\n  const row = db\n    .prepare(\n      `SELECT b.content FROM message_block b\n       JOIN message m ON m.message_id = b.message_id\n       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n       ORDER BY m.source_event_order LIMIT 1`,\n    )\n    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\n  if (row === undefined) return undefined;\n  return JSON.parse(row.content) as Record<string, unknown>;\n}\n\nexport function findPairedToolResult(\n  db: DatabaseSync,\n  toolCallId: string,\n): { content: string; isError: boolean } | undefined {\n  const block = findPairedBlock(db, \"tool_result\", toolCallId);\n  if (block === undefined) return undefined;\n  return {\n    content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n    isError: block[\"isError\"] === true,\n  };\n}\n\nexport function findPairedToolCall(\n  db: DatabaseSync,\n  toolCallId: string,\n): { toolName: string } | undefined {\n  const block = findPairedBlock(db, \"tool_call\", toolCallId);\n  if (block === undefined) return undefined;\n  return { toolName: typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"\" };\n}\n\n// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\n// outcome \"unknown\"? Pending rows carry NULL metadata and never match, so the\n// common case — call and result in one batch, summary not yet run — never\n// triggers a requeue. Returns the call's message id and the form's current\n// source version (the requeue enqueues at version + 1: the pair is the\n// summary's source, and a source completing follows clear-and-regenerate).\nexport function findUnknownOutcomeCallSummary(\n  db: DatabaseSync,\n  toolCallId: string,\n): { messageId: string; sourceVersion: number } | undefined {\n  const row = db\n    .prepare(\n      `SELECT df.subject_id, df.source_version FROM message_block b\n       JOIN derived_form df ON df.subject_kind = 'message'\n         AND df.subject_id = b.message_id AND df.form = 'tool_call_summary'\n       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\n         AND json_extract(df.metadata, '$.outcome') = 'unknown'\n       LIMIT 1`,\n    )\n    .get(toolCallId) as unknown as\n    | { subject_id: string; source_version: number | bigint }\n    | undefined;\n  if (row === undefined) return undefined;\n  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\n}\n","numLines":163,"startLine":1,"totalLines":163}}}

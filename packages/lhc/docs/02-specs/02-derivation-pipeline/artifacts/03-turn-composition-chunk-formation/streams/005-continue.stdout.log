{"type":"stream_event","event":{"type":"message_delta","delta":{"stop_reason":"tool_use","stop_sequence":null,"stop_details":null},"usage":{"input_tokens":2,"cache_creation_input_tokens":724,"cache_read_input_tokens":230519,"output_tokens":378,"output_tokens_details":{"thinking_tokens":0},"iterations":[{"input_tokens":2,"output_tokens":378,"cache_read_input_tokens":230519,"cache_creation_input_tokens":724,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":724},"type":"message"}]},"context_management":{"applied_edits":[]}},"session_id":"ba70f466-14e7-455b-b784-68aa93368849","parent_tool_use_id":null,"uuid":"f78877ce-7c18-487c-898e-424d74b04890"}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DkbmR9JjwkPfkdgyxqnJeC","type":"tool_result","content":"1\t// The deterministic provider: marked, input-derived output for every seam\n2\t// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\n3\t// functions of the input. It backs the named-provider registry's\n4\t// \"deterministic\" entry (DD-11) so spawned-CLI tests exercise the production\n5\t// resolution seam, and the test double reuses these helpers so in-process and\n6\t// spawned runs produce byte-identical artifacts. It is selectable only by\n7\t// explicit name — never a production default.\n8\timport type {\n9\t  DerivationProvider,\n10\t  ProviderResult,\n11\t  RenderingPart,\n12\t} from \"../shared/derivation.js\";\n13\t\n14\texport type DeterministicOpName =\n15\t  | \"smoothPrompt\"\n16\t  | \"summarizeToolCall\"\n17\t  | \"summarizeToolResult\"\n18\t  | \"composeTurnRendering\"\n19\t  | \"projectLowerBand\"\n20\t  | \"summarizeChunkDetailed\"\n21\t  | \"summarizeChunkBrief\";\n22\t\n23\texport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\n24\t  smoothPrompt: \"smoothed\",\n25\t  summarizeToolCall: \"toolcall\",\n26\t  summarizeToolResult: \"toolresult\",\n27\t  composeTurnRendering: \"rendering\",\n28\t  projectLowerBand: \"projection\",\n29\t  summarizeChunkDetailed: \"detailed\",\n30\t  summarizeChunkBrief: \"brief\","}]},"parent_tool_use_id":null,"session_id":"ba70f466-14e7-455b-b784-68aa93368849","uuid":"19ca32b5-3dfe-4964-b03d-90281f1d07b9","timestamp":"2026-06-11T05:09:39.849Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/providers/deterministic.ts","content":"// The deterministic provider: marked, input-derived output for every seam\n// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\n// functions of the input. It backs the named-provider registry's\n// \"deterministic\" entry (DD-11) so spawned-CLI tests exercise the production\n// resolution seam, and the test double reuses these helpers so in-process and\n// spawned runs produce byte-identical artifacts. It is selectable only by\n// explicit name — never a production default.\nimport type {\n  DerivationProvider,\n  ProviderResult,\n  RenderingPart,\n} from \"../shared/derivation.js\";\n\nexport type DeterministicOpName =\n  | \"smoothPrompt\"\n  | \"summarizeToolCall\"\n  | \"summarizeToolResult\"\n  | \"composeTurnRendering\"\n  | \"projectLowerBand\"\n  | \"summarizeChunkDetailed\"\n  | \"summarizeChunkBrief\";\n\nexport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\n  smoothPrompt: \"smoothed\",\n  summarizeToolCall: \"toolcall\",\n  summarizeToolResult: \"toolresult\",\n  composeTurnRendering: \"rendering\",\n  projectLowerBand: \"projection\",\n  summarizeChunkDetailed: \"detailed\",\n  summarizeChunkBrief: \"brief\",","numLines":30,"startLine":1,"totalLines":76}}}

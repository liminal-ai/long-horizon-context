{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L8NPhwxFUt8GzWW2UWUbsq","type":"tool_result","content":"1\timport { mkdtempSync, rmSync } from \"node:fs\";\n2\timport { tmpdir } from \"node:os\";\n3\timport { join } from \"node:path\";\n4\timport { DatabaseSync } from \"node:sqlite\";\n5\timport type { EventKind, MessageEventInput } from \"../../src/index.js\";\n6\t\n7\texport type EventByKind<K extends EventKind> = Extract<\n8\t  MessageEventInput,\n9\t  { eventKind: K }\n10\t>;\n11\t\n12\tlet keyCounter = 0;\n13\t\n14\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n15\t  user_prompt: () => ({ text: \"please read the file\" }),\n16\t  assistant_text: () => ({ text: \"here is what I found\" }),\n17\t  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n18\t  runtime_note: () => ({ text: \"harness restarted mid-turn\" }),\n19\t  tool_call: () => ({\n20\t    toolCallId: \"call-1\",\n21\t    toolName: \"read_file\",\n22\t    arguments: { path: \"notes.txt\" },\n23\t  }),\n24\t  tool_result: () => ({\n25\t    toolCallId: \"call-1\",\n26\t    content: \"contents of notes.txt\",\n27\t    isError: false,\n28\t  }),\n29\t  turn_end: () => ({}),\n30\t};\n31\t\n32\t// Returns the discriminated MessageEventInput member for its kind, so a\n33\t// kind/payload mismatch in test code is a compile error — building an invalid\n34\t// pairing requires an explicit cast at the call site.\n35\texport function validEvent<K extends EventKind>(\n36\t  kind: K,\n37\t  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n38\t): EventByKind<K> {\n39\t  keyCounter += 1;\n40\t  const base = {\n41\t    eventKind: kind,\n42\t    idempotencyKey: `fixture-key-${keyCounter}`,\n43\t    actor: \"fixture-actor\",\n44\t    harness: \"fixture-harness\",\n45\t    payload: defaultPayloads[kind](),\n46\t  };\n47\t  // The fields are built per-kind above (payload is typed EventByKind<K>[\"payload\"]),\n48\t  // but TS can't reduce a structural spread to the deferred Extract<…, { eventKind: K }>,\n49\t  // so the final reconciliation goes through unknown. Call-site safety lives in the\n50\t  // parameter types, not this assertion.\n51\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\n52\t}\n53\t\n54\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n55\t  return kinds.map((kind) => validEvent(kind));\n56\t}\n57\t\n58\texport function conversationTurn(): MessageEventInput[] {\n59\t  return eventBatch([\n60\t    \"user_prompt\",\n61\t    \"assistant_text\",\n62\t    \"tool_call\",\n63\t    \"tool_result\",\n64\t    \"turn_end\",\n65\t  ]);\n66\t}"}]},"parent_tool_use_id":null,"session_id":"91a5247d-d939-443d-a5c4-7c2ee5826722","uuid":"517df4ef-6d13-4e11-8c4b-4a5f7d270b39","timestamp":"2026-06-11T06:50:48.470Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/index.ts","content":"import { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { DatabaseSync } from \"node:sqlite\";\nimport type { EventKind, MessageEventInput } from \"../../src/index.js\";\n\nexport type EventByKind<K extends EventKind> = Extract<\n  MessageEventInput,\n  { eventKind: K }\n>;\n\nlet keyCounter = 0;\n\nconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n  user_prompt: () => ({ text: \"please read the file\" }),\n  assistant_text: () => ({ text: \"here is what I found\" }),\n  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n  runtime_note: () => ({ text: \"harness restarted mid-turn\" }),\n  tool_call: () => ({\n    toolCallId: \"call-1\",\n    toolName: \"read_file\",\n    arguments: { path: \"notes.txt\" },\n  }),\n  tool_result: () => ({\n    toolCallId: \"call-1\",\n    content: \"contents of notes.txt\",\n    isError: false,\n  }),\n  turn_end: () => ({}),\n};\n\n// Returns the discriminated MessageEventInput member for its kind, so a\n// kind/payload mismatch in test code is a compile error — building an invalid\n// pairing requires an explicit cast at the call site.\nexport function validEvent<K extends EventKind>(\n  kind: K,\n  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n): EventByKind<K> {\n  keyCounter += 1;\n  const base = {\n    eventKind: kind,\n    idempotencyKey: `fixture-key-${keyCounter}`,\n    actor: \"fixture-actor\",\n    harness: \"fixture-harness\",\n    payload: defaultPayloads[kind](),\n  };\n  // The fields are built per-kind above (payload is typed EventByKind<K>[\"payload\"]),\n  // but TS can't reduce a structural spread to the deferred Extract<…, { eventKind: K }>,\n  // so the final reconciliation goes through unknown. Call-site safety lives in the\n  // parameter types, not this assertion.\n  return { ...base, ...overrides } as unknown as EventByKind<K>;\n}\n\nexport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n  return kinds.map((kind) => validEvent(kind));\n}\n\nexport function conversationTurn(): MessageEventInput[] {\n  return eventBatch([\n    \"user_prompt\",\n    \"assistant_text\",\n    \"tool_call\",\n    \"tool_result\",\n    \"turn_end\",\n  ]);\n}","numLines":66,"startLine":1,"totalLines":128}}}

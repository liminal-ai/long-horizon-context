{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012LPnJhxTKbD3GsWCFaRkVb","type":"tool_result","content":"330\t    // part's text is its summary form's stored content, verbatim.\n331\t    for (const part of parts.slice(1)) {\n332\t      expect(part.fallback).toBe(false);\n333\t      expect(part.text).toBe(formOf(filePath, part.messageId, `${part.kind}_summary`)?.content);\n334\t    }\n335\t  });\n336\t});\n337\t\n338\tdescribe(\"TC-3.5 / AC-3.5: placement is recorded with the turn and readable through turns\", () => {\n339\t  it(\"draining a closed turn shows chunkId and memberIdx on the turn read-back\", async () => {\n340\t    const double = createProviderDouble();\n341\t    const sdk = manualSdk(double);\n342\t    const filePath = await newThread();\n343\t    await sendTurn(sdk, filePath, \"place me\", \"placed\");\n344\t\n345\t    await drain(sdk, filePath);\n346\t    const turns = await sdk.turns.listTurns({ filePath });\n347\t    expect(turns.ok).toBe(true);\n348\t    if (!turns.ok) return;\n349\t    expect(turns.value).toEqual([\n350\t      expect.objectContaining({ turnId: \"t1\", status: \"closed\", chunkId: \"c1\", memberIdx: 0 }),\n351\t    ]);\n352\t  });\n353\t});\n354\t\n355\tdescribe(\"TC-3.6 / AC-3.6 (architecture risk): the accumulated close rule — the crossing turn is excluded\", () => {\n356\t  const PROJ = \"alpha bravo charlie delta echo foxtrot golf hotel india juliet\";\n357\t\n358\t  it(\"three turns at ~equal size: the third's placement closes the chunk holding two, and the third opens chunk 2\", async () => {\n359\t    const per = estimateTokens(PROJ);\n360\t    const double = createProviderDouble();\n361\t    const provider = withScriptedProjections(double, () => PROJ);\n362\t    const sdk = manualSdk(provider, {\n363\t      targetProjectedTokens: 2 * per + 1,\n364\t      maxProjectedTokens: 100 * per,\n365\t    });\n366\t    const filePath = await newThread();\n367\t    for (let i = 1; i <= 3; i += 1) await sendTurn(sdk, filePath, `prompt ${i}`, `answer ${i}`);\n368\t\n369\t    await drain(sdk, filePath);\n370\t    const snapshot = readChunks(filePath);\n371\t    expect(snapshot.chunks).toEqual([\n372\t      { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: 2 * per },\n373\t      { chunkId: \"c2\", chunkOrder: 2, status: \"open\", accumulatedProjectedTokens: per },\n374\t    ]);\n375\t    expect(snapshot.members).toEqual([\n376\t      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n377\t      { chunkId: \"c1\", turnId: \"t2\", memberIdx: 1 },\n378\t      { chunkId: \"c2\", turnId: \"t3\", memberIdx: 0 },\n379\t    ]);\n380\t    // The close queued both summary kinds for c1 and the drain ran them;\n381\t    // the still-open c2 has none.\n382\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n383\t    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n384\t    expect(formOf(filePath, \"c2\", \"chunk_summary_detailed\")).toBeUndefined();\n385\t    expect(liveCount(filePath)).toBe(0);\n386\t  });\n387\t\n388\t  it(\"threshold exactness: accumulated + incoming equal to the target closes (inclusive), holding only the prior member\", async () => {\n389\t    const per = estimateTokens(PROJ);\n390\t    const double = createProviderDouble();\n391\t    const provider = withScriptedProjections(double, () => PROJ);\n392\t    const sdk = manualSdk(provider, {\n393\t      targetProjectedTokens: 2 * per,\n394\t      maxProjectedTokens: 100 * per,\n395\t    });\n396\t    const filePath = await newThread();\n397\t    await sendTurn(sdk, filePath, \"first\", \"one\");\n398\t    await sendTurn(sdk, filePath, \"second\", \"two\");\n399\t\n400\t    await drain(sdk, filePath);\n401\t    const snapshot = readChunks(filePath);\n402\t    expect(snapshot.members).toEqual([\n403\t      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n404\t      { chunkId: \"c2\", turnId: \"t2\", memberIdx: 0 },\n405\t    ]);\n406\t    expect(snapshot.chunks.map((chunk) => [chunk.chunkId, chunk.status])).toEqual([\n407\t      [\"c1\", \"closed\"],\n408\t      [\"c2\", \"open\"],\n409\t    ]);\n410\t  });\n411\t});\n412\t\n413\tdescribe(\"TC-3.7 / AC-3.7: a single projection at or above the max forms its own chunk, closed immediately\", () => {\n414\t  const BIG = \"omega \".repeat(120).trim();\n415\t\n416\t  it(\"one oversized turn → its own closed chunk with both summaries derived\", async () => {\n417\t    const big = estimateTokens(BIG);\n418\t    const double = createProviderDouble();\n419\t    const provider = withScriptedProjections(double, () => BIG);\n420\t    const sdk = manualSdk(provider, {\n421\t      targetProjectedTokens: big,\n422\t      maxProjectedTokens: big,\n423\t    });\n424\t    const filePath = await newThread();\n425\t    await sendTurn(sdk, filePath, \"huge turn\", \"huge answer\");\n426\t\n427\t    await drain(sdk, filePath);\n428\t    expect(readChunks(filePath)).toEqual({\n429\t      chunks: [\n430\t        { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: big },\n431\t      ],\n432\t      members: [{ chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 }],\n433\t    });\n434\t    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n435\t    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n436\t  });\n437\t\n438\t  it(\"an oversized turn arriving behind an open chunk closes both: the open chunk without it, its own chunk with it\", async () => {\n439\t    const SMALL = \"tiny projection text\";\n440\t    const big = estimateTokens(BIG);\n441\t    const projections = [SMALL, BIG];\n442\t    const double = createProviderDouble();\n443\t    const provider = withScriptedProjections(double, () => {\n444\t      const next = projections.shift();\n445\t      if (next === undefined) throw new Error(\"scripted projections exhausted\");\n446\t      return next;\n447\t    });\n448\t    // target = max = big: the small turn sits safely under both; the big\n449\t    // turn's arrival crosses the target (small + big ≥ big) and its own"}]},"parent_tool_use_id":null,"session_id":"91a5247d-d939-443d-a5c4-7c2ee5826722","uuid":"f3724a7f-35df-4bdf-8cb5-34b9d2f5dc28","timestamp":"2026-06-11T06:45:06.313Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/derivation-turns.test.ts","content":"    // part's text is its summary form's stored content, verbatim.\n    for (const part of parts.slice(1)) {\n      expect(part.fallback).toBe(false);\n      expect(part.text).toBe(formOf(filePath, part.messageId, `${part.kind}_summary`)?.content);\n    }\n  });\n});\n\ndescribe(\"TC-3.5 / AC-3.5: placement is recorded with the turn and readable through turns\", () => {\n  it(\"draining a closed turn shows chunkId and memberIdx on the turn read-back\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    await sendTurn(sdk, filePath, \"place me\", \"placed\");\n\n    await drain(sdk, filePath);\n    const turns = await sdk.turns.listTurns({ filePath });\n    expect(turns.ok).toBe(true);\n    if (!turns.ok) return;\n    expect(turns.value).toEqual([\n      expect.objectContaining({ turnId: \"t1\", status: \"closed\", chunkId: \"c1\", memberIdx: 0 }),\n    ]);\n  });\n});\n\ndescribe(\"TC-3.6 / AC-3.6 (architecture risk): the accumulated close rule — the crossing turn is excluded\", () => {\n  const PROJ = \"alpha bravo charlie delta echo foxtrot golf hotel india juliet\";\n\n  it(\"three turns at ~equal size: the third's placement closes the chunk holding two, and the third opens chunk 2\", async () => {\n    const per = estimateTokens(PROJ);\n    const double = createProviderDouble();\n    const provider = withScriptedProjections(double, () => PROJ);\n    const sdk = manualSdk(provider, {\n      targetProjectedTokens: 2 * per + 1,\n      maxProjectedTokens: 100 * per,\n    });\n    const filePath = await newThread();\n    for (let i = 1; i <= 3; i += 1) await sendTurn(sdk, filePath, `prompt ${i}`, `answer ${i}`);\n\n    await drain(sdk, filePath);\n    const snapshot = readChunks(filePath);\n    expect(snapshot.chunks).toEqual([\n      { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: 2 * per },\n      { chunkId: \"c2\", chunkOrder: 2, status: \"open\", accumulatedProjectedTokens: per },\n    ]);\n    expect(snapshot.members).toEqual([\n      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n      { chunkId: \"c1\", turnId: \"t2\", memberIdx: 1 },\n      { chunkId: \"c2\", turnId: \"t3\", memberIdx: 0 },\n    ]);\n    // The close queued both summary kinds for c1 and the drain ran them;\n    // the still-open c2 has none.\n    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n    expect(formOf(filePath, \"c2\", \"chunk_summary_detailed\")).toBeUndefined();\n    expect(liveCount(filePath)).toBe(0);\n  });\n\n  it(\"threshold exactness: accumulated + incoming equal to the target closes (inclusive), holding only the prior member\", async () => {\n    const per = estimateTokens(PROJ);\n    const double = createProviderDouble();\n    const provider = withScriptedProjections(double, () => PROJ);\n    const sdk = manualSdk(provider, {\n      targetProjectedTokens: 2 * per,\n      maxProjectedTokens: 100 * per,\n    });\n    const filePath = await newThread();\n    await sendTurn(sdk, filePath, \"first\", \"one\");\n    await sendTurn(sdk, filePath, \"second\", \"two\");\n\n    await drain(sdk, filePath);\n    const snapshot = readChunks(filePath);\n    expect(snapshot.members).toEqual([\n      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n      { chunkId: \"c2\", turnId: \"t2\", memberIdx: 0 },\n    ]);\n    expect(snapshot.chunks.map((chunk) => [chunk.chunkId, chunk.status])).toEqual([\n      [\"c1\", \"closed\"],\n      [\"c2\", \"open\"],\n    ]);\n  });\n});\n\ndescribe(\"TC-3.7 / AC-3.7: a single projection at or above the max forms its own chunk, closed immediately\", () => {\n  const BIG = \"omega \".repeat(120).trim();\n\n  it(\"one oversized turn → its own closed chunk with both summaries derived\", async () => {\n    const big = estimateTokens(BIG);\n    const double = createProviderDouble();\n    const provider = withScriptedProjections(double, () => BIG);\n    const sdk = manualSdk(provider, {\n      targetProjectedTokens: big,\n      maxProjectedTokens: big,\n    });\n    const filePath = await newThread();\n    await sendTurn(sdk, filePath, \"huge turn\", \"huge answer\");\n\n    await drain(sdk, filePath);\n    expect(readChunks(filePath)).toEqual({\n      chunks: [\n        { chunkId: \"c1\", chunkOrder: 1, status: \"closed\", accumulatedProjectedTokens: big },\n      ],\n      members: [{ chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 }],\n    });\n    expect(formOf(filePath, \"c1\", \"chunk_summary_detailed\")?.state).toBe(\"ready\");\n    expect(formOf(filePath, \"c1\", \"chunk_summary_brief\")?.state).toBe(\"ready\");\n  });\n\n  it(\"an oversized turn arriving behind an open chunk closes both: the open chunk without it, its own chunk with it\", async () => {\n    const SMALL = \"tiny projection text\";\n    const big = estimateTokens(BIG);\n    const projections = [SMALL, BIG];\n    const double = createProviderDouble();\n    const provider = withScriptedProjections(double, () => {\n      const next = projections.shift();\n      if (next === undefined) throw new Error(\"scripted projections exhausted\");\n      return next;\n    });\n    // target = max = big: the small turn sits safely under both; the big\n    // turn's arrival crosses the target (small + big ≥ big) and its own","numLines":120,"startLine":330,"totalLines":664}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019zf659mto9HTyhQxxJzk4q","type":"tool_result","content":"1\timport { parseArgs } from \"node:util\";\n2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n3\timport * as messages from \"../domains/messages/index.js\";\n4\timport * as threads from \"../domains/threads/index.js\";\n5\timport * as turns from \"../domains/turns/index.js\";\n6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n8\timport type { OpResult } from \"../shared/errors.js\";\n9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n10\timport { runMessagesEdit } from \"./messages-mutate.js\";\n11\timport {\n12\t  runMessagesReport,\n13\t  runMessagesRequeue,\n14\t  runTurnsReport,\n15\t  runTurnsRequeue,\n16\t  runWorkDrain,\n17\t} from \"./work.js\";\n18\t\n19\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n20\t// process stdin. null means interactive (TTY) — distinct from empty input\n21\t// only in how it arises; both are refused with empty_stdin before any SDK\n22\t// call (the SDK itself can never return that code).\n23\texport type StdinReader = () => Promise<string | null>;\n24\t\n25\tasync function readProcessStdin(): Promise<string | null> {\n26\t  if (process.stdin.isTTY) return null;\n27\t  process.stdin.setEncoding(\"utf8\");\n28\t  let data = \"\";\n29\t  for await (const chunk of process.stdin) data += String(chunk);\n30\t  return data;\n31\t}\n32\t\n33\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n34\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n35\t}\n36\t\n37\tconst HELP = `lhc — Long Horizon Context CLI\n38\t\n39\tUsage:\n40\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n41\t  lhc threads resolve --thread-id <id> [--registry <r>]\n42\t  lhc threads list [--registry <r>]\n43\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n44\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n45\t  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n46\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n47\t  lhc messages report (--thread-id <id> | --file-path <p>) [--not-ready] [--message-id <id>] [--registry <r>]\n48\t  lhc messages requeue (--thread-id <id> | --file-path <p>) --message-id <id> --form <form> [--registry <r>]\n49\t  lhc messages edit (--thread-id <id> | --file-path <p>) --message <id> --content <text> [--registry <r>]\n50\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n51\t  lhc turns list-chunks (--thread-id <id> | --file-path <p>) [--registry <r>]\n52\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n53\t  lhc turns report (--thread-id <id> | --file-path <p>) [--not-ready] [--turn-id <id>] [--chunk-id <id>] [--registry <r>]\n54\t  lhc turns requeue (--thread-id <id> | --file-path <p>) --subject-kind (turn|chunk) --subject-id <id> --form <form> [--registry <r>]\n55\t  lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n56\t\n57\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n58\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n59\t`;\n60\t\n61\tinterface ParsedFlags {\n62\t  threadId?: string;\n63\t  filePath?: string;\n64\t  title?: string;\n65\t  registryPath?: string;\n66\t  maxItems?: string;\n67\t  provider?: string;\n68\t  notReady?: boolean;\n69\t  messageId?: string;\n70\t  turnId?: string;\n71\t  chunkId?: string;\n72\t  form?: string;\n73\t  subjectKind?: string;\n74\t  subjectId?: string;\n75\t  content?: string;\n76\t}\n77\t\n78\t// strict parse rejects unknown/misspelled flags so they are named back to the\n79\t// caller, never silently dropped — the CLI boundary matching the SDK's\n80\t// closed-contract strictness. The failure is returned as data (not thrown) so\n81\t// runCli can render it as the structured usage error.\n82\ttype ParseFlagsResult =\n83\t  | { ok: true; flags: ParsedFlags }\n84\t  | { ok: false; unknownFlag: string };\n85\t\n86\tfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n87\t  let values;\n88\t  try {\n89\t    ({ values } = parseArgs({\n90\t      args: [...args],\n91\t      options: {\n92\t        \"thread-id\": { type: \"string\" },\n93\t        \"file-path\": { type: \"string\" },\n94\t        title: { type: \"string\" },\n95\t        registry: { type: \"string\" },\n96\t        \"max-items\": { type: \"string\" },\n97\t        provider: { type: \"string\" },\n98\t        \"not-ready\": { type: \"boolean\" },\n99\t        \"message-id\": { type: \"string\" },\n100\t        \"turn-id\": { type: \"string\" },\n101\t        \"chunk-id\": { type: \"string\" },\n102\t        form: { type: \"string\" },\n103\t        \"subject-kind\": { type: \"string\" },\n104\t        \"subject-id\": { type: \"string\" },\n105\t        // `--message` is the edit command's spelling (story/tech design);\n106\t        // it parses into the same messageId slot as `--message-id`.\n107\t        message: { type: \"string\" },\n108\t        content: { type: \"string\" },\n109\t      },\n110\t      strict: true,\n111\t      allowPositionals: true,\n112\t    }));\n113\t  } catch (cause) {\n114\t    const message = cause instanceof Error ? cause.message : String(cause);\n115\t    // parseArgs names the offending option in single quotes (e.g. Unknown\n116\t    // option '--file-pth'); surface that token, falling back to the message.\n117\t    const named = /'([^']+)'/.exec(message);\n118\t    return { ok: false, unknownFlag: named?.[1] ?? message };\n119\t  }\n120\t  const flags: ParsedFlags = {};\n121\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n122\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n123\t  if (typeof values.title === \"string\") flags.title = values.title;\n124\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n125\t  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n126\t  if (typeof values.provider === \"string\") flags.provider = values.provider;\n127\t  if (values[\"not-ready\"] === true) flags.notReady = true;\n128\t  if (typeof values[\"message-id\"] === \"string\") flags.messageId = values[\"message-id\"];\n129\t  if (typeof values.message === \"string\") flags.messageId = values.message;\n130\t  if (typeof values.content === \"string\") flags.content = values.content;\n131\t  if (typeof values[\"turn-id\"] === \"string\") flags.turnId = values[\"turn-id\"];\n132\t  if (typeof values[\"chunk-id\"] === \"string\") flags.chunkId = values[\"chunk-id\"];\n133\t  if (typeof values.form === \"string\") flags.form = values.form;\n134\t  if (typeof values[\"subject-kind\"] === \"string\") flags.subjectKind = values[\"subject-kind\"];\n135\t  if (typeof values[\"subject-id\"] === \"string\") flags.subjectId = values[\"subject-id\"];\n136\t  return { ok: true, flags };\n137\t}\n138\t\n139\t// The read commands take a thread reference but no stdin; a missing reference\n140\t// is a usage error named before any SDK call, matching the intake commands.\n141\tfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n142\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n143\t    return renderCliError(\n144\t      \"caller_error\",\n145\t      \"missing_flag\",\n146\t      `${command} requires --thread-id or --file-path`,\n147\t    );\n148\t  }\n149\t  return undefined;\n150\t}\n151\t\n152\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n153\t  if (flags.threadId !== undefined) {\n154\t    return flags.registryPath !== undefined\n155\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n156\t      : { threadId: flags.threadId };\n157\t  }\n158\t  return { filePath: flags.filePath ?? \"\" };\n159\t}\n160\t\n161\texport async function runCli(\n162\t  argv: readonly string[],\n163\t  readStdin: StdinReader = readProcessStdin,\n164\t): Promise<CliResult> {\n165\t  if (argv.length === 0) {\n166\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n167\t  }\n168\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n169\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n170\t  }\n171\t\n172\t  const [group, command, ...rest] = argv;\n173\t  const key = command === undefined ? group : `${group} ${command}`;\n174\t  const parsed = parseFlags(command === undefined ? [] : rest);\n175\t  if (!parsed.ok) {\n176\t    return renderCliError(\n177\t      \"caller_error\",\n178\t      \"unknown_flag\",\n179\t      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n180\t    );\n181\t  }\n182\t  const flags = parsed.flags;\n183\t\n184\t  switch (key) {\n185\t    case \"threads new-thread\": {\n186\t      // Guard here: an empty path reaching node:sqlite opens a temp database\n187\t      // instead of failing, so the adapter refuses before any SDK call.\n188\t      if (flags.filePath === undefined) {\n189\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n190\t      }\n191\t      const input: Parameters<typeof threads.newThread>[0] = {\n192\t        filePath: flags.filePath,\n193\t      };\n194\t      if (flags.title !== undefined) input.title = flags.title;\n195\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n196\t      return renderResult(await threads.newThread(input));\n197\t    }\n198\t    case \"threads resolve\": {\n199\t      if (flags.threadId === undefined) {\n200\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n201\t      }\n202\t      const input: Parameters<typeof threads.resolve>[0] = {\n203\t        threadId: flags.threadId,\n204\t      };\n205\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n206\t      return renderResult(await threads.resolve(input));\n207\t    }\n208\t    case \"threads list\": {\n209\t      return renderResult(\n210\t        await threads.listThreads(\n211\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n212\t        ),\n213\t      );\n214\t    }\n215\t    case \"intake-stream message-events\": {\n216\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n217\t        return renderCliError(\n218\t          \"caller_error\",\n219\t          \"missing_flag\",\n220\t          \"intake-stream message-events requires --thread-id or --file-path\",\n221\t        );\n222\t      }\n223\t      const text = await readStdin();\n224\t      if (text === null || text.trim() === \"\") {\n225\t        return renderResult(\n226\t          stdinCallerError(\n227\t            \"empty_stdin\",\n228\t            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n229\t          ),\n230\t        );\n231\t      }\n232\t      let parsed: unknown;\n233\t      try {\n234\t        parsed = JSON.parse(text);\n235\t      } catch (cause) {\n236\t        const detail = cause instanceof Error ? cause.message : String(cause);\n237\t        return renderResult(\n238\t          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n239\t        );\n240\t      }\n241\t      if (!Array.isArray(parsed)) {\n242\t        return renderResult(\n243\t          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n244\t        );\n245\t      }\n246\t      return renderResult(\n247\t        await intakeStream.messageEvents(\n248\t          threadRefFrom(flags),\n249\t          parsed as readonly MessageEventInput[],\n250\t        ),\n251\t      );\n252\t    }\n253\t    case \"intake-stream list-events\": {\n254\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n255\t        return renderCliError(\n256\t          \"caller_error\",\n257\t          \"missing_flag\",\n258\t          \"intake-stream list-events requires --thread-id or --file-path\",\n259\t        );\n260\t      }\n261\t      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n262\t    }\n263\t    case \"messages list\":\n264\t      return (\n265\t        requireThreadRef(flags, \"messages list\") ??\n266\t        renderResult(await messages.listMessages(threadRefFrom(flags)))\n267\t      );\n268\t    case \"messages list-queued-work\":\n269\t      return (\n270\t        requireThreadRef(flags, \"messages list-queued-work\") ??\n271\t        renderResult(await messages.listQueuedWork(threadRefFrom(flags)))\n272\t      );\n273\t    case \"messages report\": {\n274\t      const missingRef = requireThreadRef(flags, \"messages report\");\n275\t      if (missingRef !== undefined) return missingRef;\n276\t      const reportFlags: { notReady?: boolean; messageId?: string } = {};\n277\t      if (flags.notReady === true) reportFlags.notReady = true;\n278\t      if (flags.messageId !== undefined) reportFlags.messageId = flags.messageId;\n279\t      return runMessagesReport(threadRefFrom(flags), reportFlags);\n280\t    }\n281\t    case \"messages requeue\": {\n282\t      const missingRef = requireThreadRef(flags, \"messages requeue\");\n283\t      if (missingRef !== undefined) return missingRef;\n284\t      if (flags.messageId === undefined || flags.form === undefined) {\n285\t        return renderCliError(\n286\t          \"caller_error\",\n287\t          \"missing_flag\",\n288\t          \"messages requeue requires --message-id and --form\",\n289\t        );\n290\t      }\n291\t      return runMessagesRequeue(threadRefFrom(flags), {\n292\t        messageId: flags.messageId,\n293\t        form: flags.form,\n294\t      });\n295\t    }\n296\t    case \"messages edit\": {\n297\t      const missingRef = requireThreadRef(flags, \"messages edit\");\n298\t      if (missingRef !== undefined) return missingRef;\n299\t      if (flags.messageId === undefined || flags.content === undefined) {\n300\t        return renderCliError(\n301\t          \"caller_error\",\n302\t          \"missing_flag\",\n303\t          \"messages edit requires --message (or --message-id) and --content\",\n304\t        );\n305\t      }\n306\t      return runMessagesEdit(threadRefFrom(flags), {\n307\t        messageId: flags.messageId,\n308\t        content: flags.content,\n309\t      });\n310\t    }\n311\t    case \"turns list\":\n312\t      return (\n313\t        requireThreadRef(flags, \"turns list\") ??\n314\t        renderResult(await turns.listTurns(threadRefFrom(flags)))\n315\t      );\n316\t    case \"turns list-chunks\":\n317\t      return (\n318\t        requireThreadRef(flags, \"turns list-chunks\") ??\n319\t        renderResult(await turns.listChunks(threadRefFrom(flags)))\n320\t      );\n321\t    case \"turns list-queued-work\":\n322\t      return (\n323\t        requireThreadRef(flags, \"turns list-queued-work\") ??\n324\t        renderResult(await turns.listQueuedWork(threadRefFrom(flags)))\n325\t      );\n326\t    case \"turns report\": {\n327\t      const missingRef = requireThreadRef(flags, \"turns report\");\n328\t      if (missingRef !== undefined) return missingRef;\n329\t      const reportFlags: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n330\t      if (flags.notReady === true) reportFlags.notReady = true;\n331\t      if (flags.turnId !== undefined) reportFlags.turnId = flags.turnId;\n332\t      if (flags.chunkId !== undefined) reportFlags.chunkId = flags.chunkId;\n333\t      return runTurnsReport(threadRefFrom(flags), reportFlags);\n334\t    }\n335\t    case \"turns requeue\": {\n336\t      const missingRef = requireThreadRef(flags, \"turns requeue\");\n337\t      if (missingRef !== undefined) return missingRef;\n338\t      if (\n339\t        flags.subjectKind === undefined ||\n340\t        flags.subjectId === undefined ||\n341\t        flags.form === undefined\n342\t      ) {\n343\t        return renderCliError(\n344\t          \"caller_error\",\n345\t          \"missing_flag\",\n346\t          \"turns requeue requires --subject-kind, --subject-id, and --form\",\n347\t        );\n348\t      }\n349\t      if (flags.subjectKind !== \"turn\" && flags.subjectKind !== \"chunk\") {\n350\t        return renderCliError(\n351\t          \"caller_error\",\n352\t          \"missing_flag\",\n353\t          `--subject-kind must be \"turn\" or \"chunk\", got ${flags.subjectKind}`,\n354\t        );\n355\t      }\n356\t      return runTurnsRequeue(threadRefFrom(flags), {\n357\t        subjectKind: flags.subjectKind,\n358\t        subjectId: flags.subjectId,\n359\t        form: flags.form,\n360\t      });\n361\t    }\n362\t    case \"work drain\": {\n363\t      const missingRef = requireThreadRef(flags, \"work drain\");\n364\t      if (missingRef !== undefined) return missingRef;\n365\t      const drainFlags: { provider?: string; maxItems?: number } = {};\n366\t      if (flags.provider !== undefined) drainFlags.provider = flags.provider;\n367\t      if (flags.maxItems !== undefined) {\n368\t        const maxItems = Number(flags.maxItems);\n369\t        if (!Number.isInteger(maxItems) || maxItems <= 0) {\n370\t          return renderCliError(\n371\t            \"caller_error\",\n372\t            \"missing_flag\",\n373\t            `--max-items must be a positive integer, got ${flags.maxItems}`,\n374\t          );\n375\t        }\n376\t        drainFlags.maxItems = maxItems;\n377\t      }\n378\t      return runWorkDrain(threadRefFrom(flags), drainFlags);\n379\t    
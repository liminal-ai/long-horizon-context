{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bn1ehHDtu41CpSQgpbPkaA","type":"tool_result","content":"1\t// Message and block row operations. Writes run on the caller's handle inside\n2\t// the batch transaction (insert failures propagate so the pipeline rejects\n3\t// the whole batch); reads run on a fresh handle per operation. The mutation\n4\t// half (Epic 02 Story 5) — the edit's validation read and content apply —\n5\t// also lives here: row-level mechanics, no policy.\n6\timport type { DatabaseSync } from \"node:sqlite\";\n7\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n8\timport type { Block, MessageRecord } from \"../index.js\";\n9\t\n10\texport interface MessageRow {\n11\t  messageId: string;\n12\t  sourceEventOrder: number;\n13\t  kind: MessageRecord[\"kind\"];\n14\t  tokenEstimate: number;\n15\t  actor: string;\n16\t  harness: string;\n17\t  // Membership stamp, settled at intake: the turn open after this event's\n18\t  // transition, or null in a gap. Written once here, never updated — a null\n19\t  // gap stamp stays null forever (AC-3.8), a closed turn's members never\n20\t  // change (AC-3.7).\n21\t  turnId: string | null;\n22\t  blocks: Block[];\n23\t}\n24\t\n25\texport function insertMessage(db: DatabaseSync, row: MessageRow): void {\n26\t  db.prepare(\n27\t    `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\n28\t     VALUES (?, ?, ?, ?, ?, ?, ?)`,\n29\t  ).run(\n30\t    row.messageId,\n31\t    row.sourceEventOrder,\n32\t    row.kind,\n33\t    row.tokenEstimate,\n34\t    row.actor,\n35\t    row.harness,\n36\t    row.turnId,\n37\t  );\n38\t\n39\t  const insertBlock = db.prepare(\n40\t    `INSERT INTO message_block (message_id, block_index, block_type, content)\n41\t     VALUES (?, ?, ?, ?)`,\n42\t  );\n43\t  for (const [index, block] of row.blocks.entries()) {\n44\t    insertBlock.run(row.messageId, index, block.blockType, JSON.stringify(block.content));\n45\t  }\n46\t}\n47\t\n48\t// The edit operation's validation read (Flow 5): the live (deleted-filtered)\n49\t// message joined to its turn's status. A deleted target misses here and\n50\t// refuses as message_not_found — the filtered view is the refusal's read by\n51\t// design (never a distinct error for deleted). turnStatus is null for a gap\n52\t// message (no membership); the edit's closed-turn target boundary refuses it\n53\t// the same as an open turn — only a closed turn is an editable target.\n54\texport interface MutableMessageView {\n55\t  messageId: string;\n56\t  kind: string;\n57\t  turnId: string | null;\n58\t  turnStatus: \"open\" | \"closed\" | null;\n59\t}\n60\t\n61\texport function readMutableMessage(\n62\t  db: DatabaseSync,\n63\t  messageId: string,\n64\t): MutableMessageView | undefined {\n65\t  const row = db\n66\t    .prepare(\n67\t      `SELECT m.message_id, m.kind, m.turn_id, t.status AS turn_status\n68\t       FROM message m LEFT JOIN turns t ON t.turn_id = m.turn_id\n69\t       WHERE m.message_id = ? AND m.deleted_at IS NULL`,\n70\t    )\n71\t    .get(messageId) as unknown as\n72\t    | { message_id: string; kind: string; turn_id: string | null; turn_status: string | null }\n73\t    | undefined;\n74\t  if (row === undefined) return undefined;\n75\t  return {\n76\t    messageId: row.message_id,\n77\t    kind: row.kind,\n78\t    turnId: row.turn_id,\n79\t    turnStatus: row.turn_status as MutableMessageView[\"turnStatus\"],\n80\t  };\n81\t}\n82\t\n83\t// The edit's record apply (AC-5.1): the new content lands in each block's\n84\t// content-bearing field — the same field per block type the projection wrote\n85\t// and counted (internal/project.ts) — and the token estimate re-stamps from\n86\t// the same estimator, so placement arithmetic stays current after edits.\n87\t// Events are untouched: this is projection-level mutation; the log keeps the\n88\t// original (DD-12).\n89\texport function applyMessageEdit(db: DatabaseSync, messageId: string, content: string): void {\n90\t  const blocks = db\n91\t    .prepare(\n92\t      `SELECT block_index, block_type, content FROM message_block\n93\t       WHERE message_id = ? ORDER BY block_index`,\n94\t    )\n95\t    .all(messageId) as unknown as Array<{\n96\t    block_index: number | bigint;\n97\t    block_type: string;\n98\t    content: string;\n99\t  }>;\n100\t  const update = db.prepare(\n101\t    `UPDATE message_block SET content = ? WHERE message_id = ? AND block_index = ?`,\n102\t  );\n103\t  let tokenEstimate = estimateTokens(content);\n104\t  for (const block of blocks) {\n105\t    const parsed = JSON.parse(block.content) as Record<string, unknown>;\n106\t    switch (block.block_type) {\n107\t      case \"text\":\n108\t        parsed[\"text\"] = content;\n109\t        break;\n110\t      case \"tool_result\":\n111\t        parsed[\"content\"] = content;\n112\t        break;\n113\t      case \"tool_call\":\n114\t        // Arguments are the call's counted content; the edit's string lands\n115\t        // verbatim as the new arguments value, mirroring projection's\n116\t        // serialized-arguments estimate.\n117\t        parsed[\"arguments\"] = content;\n118\t        tokenEstimate = estimateTokens(JSON.stringify(content));\n119\t        break;\n120\t      default:\n121\t        throw new Error(`message ${messageId} carries unknown block type ${block.block_type}`);\n122\t    }\n123\t    update.run(JSON.stringify(parsed), messageId, Number(block.block_index));\n124\t  }\n125\t  db.prepare(`UPDATE message SET token_estimate = ? WHERE message_id = ?`).run(\n126\t    tokenEstimate,\n127\t    messageId,\n128\t  );\n129\t}\n130\t\n131\tinterface RawMessageRow {\n132\t  message_id: string;\n133\t  source_event_order: number | bigint;\n134\t  kind: string;\n135\t  token_estimate: number | bigint;\n136\t  actor: string;\n137\t  harness: string;\n138\t  turn_id: string | null;\n139\t}\n140\t\n141\tinterface RawBlockRow {\n142\t  message_id: string;\n143\t  block_type: string;\n144\t  content: string;\n145\t}\n146\t\n147\texport function readMessages(db: DatabaseSync): MessageRecord[] {\n148\t  const blockRows = db\n149\t    .prepare(\n150\t      `SELECT message_id, block_type, content FROM message_block\n151\t       ORDER BY message_id, block_index`,\n152\t    )\n153\t    .all() as unknown as RawBlockRow[];\n154\t  const blocksByMessage = new Map<string, Block[]>();\n155\t  for (const row of blockRows) {\n156\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n157\t    blocks.push({\n158\t      blockType: row.block_type as Block[\"blockType\"],\n159\t      content: JSON.parse(row.content) as Record<string, unknown>,\n160\t    });\n161\t    blocksByMessage.set(row.message_id, blocks);\n162\t  }\n163\t\n164\t  const messageRows = db\n165\t    .prepare(\n166\t      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id\n167\t       FROM message ORDER BY source_event_order`,\n168\t    )\n169\t    .all() as unknown as RawMessageRow[];\n170\t  return messageRows.map((row) => {\n171\t    const record: MessageRecord = {\n172\t      messageId: row.message_id,\n173\t      sourceEventOrder: Number(row.source_event_order),\n174\t      kind: row.kind as MessageRecord[\"kind\"],\n175\t      blocks: blocksByMessage.get(row.message_id) ?? [],\n176\t      tokenEstimate: Number(row.token_estimate),\n177\t      actor: row.actor,\n178\t      harness: row.harness,\n179\t    };\n180\t    if (row.turn_id !== null) record.turnId = row.turn_id;\n181\t    return record;\n182\t  });\n183\t}\n184\t"}]},"parent_tool_use_id":null,"session_id":"91a5247d-d939-443d-a5c4-7c2ee5826722","uuid":"5ca2d11a-81e9-498c-9f80-43d4cd3715ef","timestamp":"2026-06-11T06:40:43.821Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/store.ts","content":"// Message and block row operations. Writes run on the caller's handle inside\n// the batch transaction (insert failures propagate so the pipeline rejects\n// the whole batch); reads run on a fresh handle per operation. The mutation\n// half (Epic 02 Story 5) — the edit's validation read and content apply —\n// also lives here: row-level mechanics, no policy.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\nimport type { Block, MessageRecord } from \"../index.js\";\n\nexport interface MessageRow {\n  messageId: string;\n  sourceEventOrder: number;\n  kind: MessageRecord[\"kind\"];\n  tokenEstimate: number;\n  actor: string;\n  harness: string;\n  // Membership stamp, settled at intake: the turn open after this event's\n  // transition, or null in a gap. Written once here, never updated — a null\n  // gap stamp stays null forever (AC-3.8), a closed turn's members never\n  // change (AC-3.7).\n  turnId: string | null;\n  blocks: Block[];\n}\n\nexport function insertMessage(db: DatabaseSync, row: MessageRow): void {\n  db.prepare(\n    `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\n     VALUES (?, ?, ?, ?, ?, ?, ?)`,\n  ).run(\n    row.messageId,\n    row.sourceEventOrder,\n    row.kind,\n    row.tokenEstimate,\n    row.actor,\n    row.harness,\n    row.turnId,\n  );\n\n  const insertBlock = db.prepare(\n    `INSERT INTO message_block (message_id, block_index, block_type, content)\n     VALUES (?, ?, ?, ?)`,\n  );\n  for (const [index, block] of row.blocks.entries()) {\n    insertBlock.run(row.messageId, index, block.blockType, JSON.stringify(block.content));\n  }\n}\n\n// The edit operation's validation read (Flow 5): the live (deleted-filtered)\n// message joined to its turn's status. A deleted target misses here and\n// refuses as message_not_found — the filtered view is the refusal's read by\n// design (never a distinct error for deleted). turnStatus is null for a gap\n// message (no membership); the edit's closed-turn target boundary refuses it\n// the same as an open turn — only a closed turn is an editable target.\nexport interface MutableMessageView {\n  messageId: string;\n  kind: string;\n  turnId: string | null;\n  turnStatus: \"open\" | \"closed\" | null;\n}\n\nexport function readMutableMessage(\n  db: DatabaseSync,\n  messageId: string,\n): MutableMessageView | undefined {\n  const row = db\n    .prepare(\n      `SELECT m.message_id, m.kind, m.turn_id, t.status AS turn_status\n       FROM message m LEFT JOIN turns t ON t.turn_id = m.turn_id\n       WHERE m.message_id = ? AND m.deleted_at IS NULL`,\n    )\n    .get(messageId) as unknown as\n    | { message_id: string; kind: string; turn_id: string | null; turn_status: string | null }\n    | undefined;\n  if (row === undefined) return undefined;\n  return {\n    messageId: row.message_id,\n    kind: row.kind,\n    turnId: row.turn_id,\n    turnStatus: row.turn_status as MutableMessageView[\"turnStatus\"],\n  };\n}\n\n// The edit's record apply (AC-5.1): the new content lands in each block's\n// content-bearing field — the same field per block type the projection wrote\n// and counted (internal/project.ts) — and the token estimate re-stamps from\n// the same estimator, so placement arithmetic stays current after edits.\n// Events are untouched: this is projection-level mutation; the log keeps the\n// original (DD-12).\nexport function applyMessageEdit(db: DatabaseSync, messageId: string, content: string): void {\n  const blocks = db\n    .prepare(\n      `SELECT block_index, block_type, content FROM message_block\n       WHERE message_id = ? ORDER BY block_index`,\n    )\n    .all(messageId) as unknown as Array<{\n    block_index: number | bigint;\n    block_type: string;\n    content: string;\n  }>;\n  const update = db.prepare(\n    `UPDATE message_block SET content = ? WHERE message_id = ? AND block_index = ?`,\n  );\n  let tokenEstimate = estimateTokens(content);\n  for (const block of blocks) {\n    const parsed = JSON.parse(block.content) as Record<string, unknown>;\n    switch (block.block_type) {\n      case \"text\":\n        parsed[\"text\"] = content;\n        break;\n      case \"tool_result\":\n        parsed[\"content\"] = content;\n        break;\n      case \"tool_call\":\n        // Arguments are the call's counted content; the edit's string lands\n        // verbatim as the new arguments value, mirroring projection's\n        // serialized-arguments estimate.\n        parsed[\"arguments\"] = content;\n        tokenEstimate = estimateTokens(JSON.stringify(content));\n        break;\n      default:\n        throw new Error(`message ${messageId} carries unknown block type ${block.block_type}`);\n    }\n    update.run(JSON.stringify(parsed), messageId, Number(block.block_index));\n  }\n  db.prepare(`UPDATE message SET token_estimate = ? WHERE message_id = ?`).run(\n    tokenEstimate,\n    messageId,\n  );\n}\n\ninterface RawMessageRow {\n  message_id: string;\n  source_event_order: number | bigint;\n  kind: string;\n  token_estimate: number | bigint;\n  actor: string;\n  harness: string;\n  turn_id: string | null;\n}\n\ninterface RawBlockRow {\n  message_id: string;\n  block_type: string;\n  content: string;\n}\n\nexport function readMessages(db: DatabaseSync): MessageRecord[] {\n  const blockRows = db\n    .prepare(\n      `SELECT message_id, block_type, content FROM message_block\n       ORDER BY message_id, block_index`,\n    )\n    .all() as unknown as RawBlockRow[];\n  const blocksByMessage = new Map<string, Block[]>();\n  for (const row of blockRows) {\n    const blocks = blocksByMessage.get(row.message_id) ?? [];\n    blocks.push({\n      blockType: row.block_type as Block[\"blockType\"],\n      content: JSON.parse(row.content) as Record<string, unknown>,\n    });\n    blocksByMessage.set(row.message_id, blocks);\n  }\n\n  const messageRows = db\n    .prepare(\n      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id\n       FROM message ORDER BY source_event_order`,\n    )\n    .all() as unknown as RawMessageRow[];\n  return messageRows.map((row) => {\n    const record: MessageRecord = {\n      messageId: row.message_id,\n      sourceEventOrder: Number(row.source_event_order),\n      kind: row.kind as MessageRecord[\"kind\"],\n      blocks: blocksByMessage.get(row.message_id) ?? [],\n      tokenEstimate: Number(row.token_estimate),\n      actor: row.actor,\n      harness: row.harness,\n    };\n    if (row.turn_id !== null) record.turnId = row.turn_id;\n    return record;\n  });\n}\n","numLines":184,"startLine":1,"totalLines":184}}}

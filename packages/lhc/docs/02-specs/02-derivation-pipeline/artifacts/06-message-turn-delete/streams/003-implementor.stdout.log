{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MkBMfnshyygUFqR3QH6j6d","type":"tool_result","content":"1\t// Story 5 (Epic 02): messages.edit and the mutation cascade — Flow 5's edit\n2\t// half. One synchronous transaction carries the content change, the token\n3\t// re-stamp, and the full dependent-chain clear-and-requeue (TC-5.1), with\n4\t// induced-failure atomicity proving a failing cascade step rolls back the\n5\t// content change too (architecture risk). Cascade reach is proven in both\n6\t// directions — exactly the chain cleared, everything outside it byte-stable\n7\t// including source versions (TC-5.2, architecture risk). Post-return no\n8\t// pre-edit derivation is ready and replacements sit queued at the new source\n9\t// version, with superseded queued ids reported and their rows gone (TC-5.3).\n10\t// TC-5.4 is the epic's named architecture-risk test: a claimed pre-edit item\n11\t// held across the edit by the delayed double completes after the post-edit\n12\t// rebuild is queued, discards on the source-version mismatch as\n13\t// stale_discarded, and the post-edit artifact stands. Refusals (open turn,\n14\t// turnless no-membership target, missing id, deleted target through the\n15\t// filtered view) change nothing (TC-5.5). The CLI parity leg of TC-5.6 lives in\n16\t// cli-process-mutations.test.ts (process suite).\n17\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n18\timport {\n19\t  createSdk,\n20\t  deterministicText,\n21\t  estimateTokens,\n22\t  messages,\n23\t  queueDetail,\n24\t  setSchedulerPoke,\n25\t  setThreadTouch,\n26\t  threads,\n27\t  type DerivationProvider,\n28\t  type DrainReport,\n29\t  type Lhc,\n30\t  type MessageEventInput,\n31\t  type MutationResult,\n32\t  type OpResult,\n33\t  type SdkConfig,\n34\t} from \"../src/index.js\";\n35\timport {\n36\t  createProviderDouble,\n37\t  openRaw,\n38\t  readDerivedForms,\n39\t  tempStore,\n40\t  validEvent,\n41\t  type TempStore,\n42\t} from \"./fixtures/index.js\";\n43\t\n44\tlet store: TempStore;\n45\tbeforeEach(() => {\n46\t  store = tempStore();\n47\t});\n48\tafterEach(() => {\n49\t  store.cleanup();\n50\t  setSchedulerPoke(null);\n51\t  setThreadTouch(null);\n52\t});\n53\t\n54\tasync function newThread(): Promise<string> {\n55\t  const created = await threads.newThread({\n56\t    filePath: store.threadPath(),\n57\t    registryPath: store.registryPath,\n58\t  });\n59\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n60\t  return created.value.filePath;\n61\t}\n62\t\n63\tfunction manualSdk(\n64\t  provider: DerivationProvider,\n65\t  overrides: Partial<Pick<SdkConfig, \"chunkPolicy\" | \"clock\" | \"mode\">> = {},\n66\t): Lhc {\n67\t  const config: SdkConfig = {\n68\t    provider,\n69\t    mode: overrides.mode ?? \"manual\",\n70\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n71\t    lease: { durationMs: 5000 },\n72\t  };\n73\t  if (overrides.chunkPolicy !== undefined) config.chunkPolicy = overrides.chunkPolicy;\n74\t  if (overrides.clock !== undefined) config.clock = overrides.clock;\n75\t  return createSdk(config);\n76\t}\n77\t\n78\tasync function send(\n79\t  sdk: Lhc,\n80\t  filePath: string,\n81\t  batch: readonly MessageEventInput[],\n82\t): Promise<void> {\n83\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n84\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n85\t}\n86\t\n87\tasync function drain(sdk: Lhc, filePath: string): Promise<DrainReport> {\n88\t  const result = await sdk.work.drain({ filePath });\n89\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n90\t  return result.value;\n91\t}\n92\t\n93\tfunction rawDetail(filePath: string): ReturnType<typeof queueDetail> {\n94\t  const db = openRaw(filePath);\n95\t  try {\n96\t    return queueDetail(db);\n97\t  } finally {\n98\t    db.close();\n99\t  }\n100\t}\n101\t\n102\tfunction clearKey(entry: { subjectKind: string; subjectId: string; form: string }): string {\n103\t  return `${entry.subjectKind}/${entry.subjectId}/${entry.form}`;\n104\t}\n105\t\n106\tfunction unwrap<T>(result: OpResult<T>): T {\n107\t  if (!result.ok) throw new Error(`expected ok result, got ${result.error.code}`);\n108\t  return result.value;\n109\t}\n110\t\n111\t// One closed prompt+answer turn (m1 prompt, t1), drained ready. Under the\n112\t// default chunk policy t1's chunk stays open, so no chunk summary rows exist.\n113\tasync function readyTurnThread(sdk: Lhc): Promise<string> {\n114\t  const filePath = await newThread();\n115\t  await send(sdk, filePath, [\n116\t    validEvent(\"user_prompt\", { payload: { text: \"original prompt\" } }),\n117\t    validEvent(\"assistant_text\", { payload: { text: \"the original answer\" } }),\n118\t    validEvent(\"turn_end\"),\n119\t  ]);\n120\t  await drain(sdk, filePath);\n121\t  return filePath;\n122\t}\n123\t\n124\t// The full mutation read-back surface in one snapshot: record, forms, queue.\n125\tasync function snapshot(filePath: string): Promise<unknown> {\n126\t  return {\n127\t    messages: unwrap(await messages.listMessages({ filePath })),\n128\t    forms: readDerivedForms(filePath),\n129\t    queue: rawDetail(filePath),\n130\t  };\n131\t}\n132\t\n133\tasync function until(cond: () => boolean, what: string, timeoutMs = 5000): Promise<void> {\n134\t  const start = Date.now();\n135\t  while (!cond()) {\n136\t    if (Date.now() - start > timeoutMs) throw new Error(`timed out waiting for ${what}`);\n137\t    await new Promise((resolve) => setTimeout(resolve, 5));\n138\t  }\n139\t}\n140\t\n141\tdescribe(\"TC-5.1 / AC-5.1: edit updates content, blocks, and estimate synchronously, reporting the cascade\", () => {\n142\t  it(\"changes the record in the edit's transaction and names cleared forms and queued items\", async () => {\n143\t    const double = createProviderDouble();\n144\t    const sdk = manualSdk(double);\n145\t    const filePath = await readyTurnThread(sdk);\n146\t\n147\t    const result = await messages.edit(\n148\t      { filePath },\n149\t      { messageId: \"m1\", content: \"edited prompt\" },\n150\t    );\n151\t    expect(result.ok).toBe(true);\n152\t    if (!result.ok) return;\n153\t    expect(result.value.changed).toEqual({ messageIds: [\"m1\"], turnIds: [] });\n154\t    expect(result.value.dropped).toEqual([]);\n155\t    // The chain above m1: its own smoothing and t1's two forms. t1's chunk is\n156\t    // still open — no summary rows exist, so none are named.\n157\t    expect(result.value.cleared.map(clearKey).sort()).toEqual(\n158\t      [\n159\t        \"message/m1/smoothed_prompt\",\n160\t        \"turn/t1/lower_band_projection\",\n161\t        \"turn/t1/turn_rendering\",\n162\t      ].sort(),\n163\t    );\n164\t    expect([...result.value.queued].sort((a, b) => a.workItemId.localeCompare(b.workItemId)))\n165\t      .toEqual([\n166\t        { workItemId: \"w-m1-prompt_smoothing-v2\", kind: \"prompt_smoothing\" },\n167\t        { workItemId: \"w-t1-turn_derivation-v2\", kind: \"turn_derivation\" },\n168\t      ]);\n169\t    expect(result.value.superseded).toEqual([]);\n170\t\n171\t    // Synchronous, before any drain: content, blocks, and the re-stamped\n172\t    // estimate read back changed.\n173\t    const m1 = unwrap(await messages.listMessages({ filePath })).find(\n174\t      (record) => record.messageId === \"m1\",\n175\t    );\n176\t    expect(m1?.blocks).toEqual([{ blockType: \"text\", content: { text: \"edited prompt\" } }]);\n177\t    expect(m1?.tokenEstimate).toBe(estimateTokens(\"edited prompt\"));\n178\t\n179\t    // The queued rebuilds run through the normal drain and derive from the\n180\t    // edited content.\n181\t    await drain(sdk, filePath);\n182\t    const smoothing = readDerivedForms(filePath).find(\n183\t      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n184\t    );\n185\t    expect(smoothing?.state).toBe(\"ready\");\n186\t    expect(smoothing?.content).toBe(\n187\t      deterministicText(\"smoothPrompt\", { text: \"edited prompt\" }, \"edited prompt\"),\n188\t    );\n189\t  });\n190\t\n191\t  it(\"induced cascade failure rolls back the content change too (atomicity, architecture risk)\", async () => {\n192\t    const double = createProviderDouble();\n193\t    const sdk = manualSdk(double);\n194\t    const filePath = await readyTurnThread(sdk);\n195\t\n196\t    // Plant a claimed row at the exact id the cascade's replacement enqueue\n197\t    // will insert. Supersede only deletes queued rows, so the insert hits a\n198\t    // primary-key conflict mid-cascade — after the content apply — and the\n199\t    // transaction must roll back whole.\n200\t    const db = openRaw(filePath);\n201\t    db.prepare(\n202\t      `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n203\t       VALUES (?, 'messages', 'prompt_smoothing', ?, 'claimed', ?, ?)`,\n204\t    ).run(\n205\t      \"w-m1-prompt_smoothing-v2\",\n206\t      JSON.stringify({ messageId: \"m1\" }),\n207\t      \"2026-06-11T00:00:00.000Z\",\n208\t      JSON.stringify({ sourceVersion: 2, forms: [] }),\n209\t    );\n210\t    db.close();\n211\t\n212\t    const before = await snapshot(filePath);\n213\t    const result = await messages.edit(\n214\t      { filePath },\n215\t      { messageId: \"m1\", content: \"edited prompt\" },\n216\t    );\n217\t    expect(result.ok).toBe(false);\n218\t    if (result.ok) return;\n219\t    expect(result.error.code).toBe(\"storage_failure\");\n220\t    // Nothing changed: not the message content, not the estimate, not a\n221\t    // single form state or source version, not the queue.\n222\t    expect(await snapshot(filePath)).toEqual(before);\n223\t  });\n224\t});\n225\t\n226\tdescribe(\"TC-5.2 / AC-5.2 (architecture risk): cascade reach is exact in both directions\", () => {\n227\t  it(\"clears exactly the edited message's chain; the second chunk's forms are byte-stable\", async () => {\n228\t    const double = createProviderDouble();\n229\t    // max=1: every turn's projection meets the maximum, so each turn forms\n230\t    // its own immediately closed chunk — two chunks, both with summaries.\n231\t    const sdk = manualSdk(double, {\n232\t      chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 1 },\n233\t    });\n234\t    const filePath = await newThread();\n235\t    await send(sdk, filePath, [\n236\t      validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n237\t      validEvent(\"assistant_text\", { payload: { text: \"first answer\" } }),\n238\t      validEvent(\"turn_end\"),\n239\t    ]);\n240\t    await send(sdk, filePath, [\n241\t      validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n242\t      validEvent(\"assistant_text\", { payload: { text: \"second answer\" } }),\n243\t      validEvent(\"turn_end\"),\n244\t    ]);\n245\t    await drain(sdk, filePath);\n246\t\n247\t    const before = readDerivedForms(filePath);\n248\t    // Fixture sanity: both chunks closed with every form ready.\n249\t    expect(before.map((form) => clearKey(form)).sort()).toEqual(\n250\t      [\n251\t        \"message/m1/smoothed_prompt\",\n252\t        \"message/m4/smoothed_prompt\",\n253\t        \"turn/t1/lower_band_projection\",\n254\t        \"turn/t1/turn_rendering\",\n255\t        \"turn/t2/lower_band_projection\",\n256\t        \"turn/t2/turn_rendering\",\n257\t        \"chunk/c1/chunk_summary_brief\",\n258\t        \"chunk/c1/chunk_summary_detailed\",\n259\t        \"chunk/c2/chunk_summary_brief\",\n260\t        \"chunk/c2/chunk_summary_detailed\",\n261\t      ].sort(),\n262\t    );\n263\t    expect(before.every((form) => form.state === \"ready\")).toBe(true);\n264\t\n265\t    const result = await messages.edit(\n266\t      { filePath },\n267\t      { messageId: \"m1\", content: \"rewritten first prompt\" },\n268\t    );\n269\t    expect(result.ok).toBe(true);\n270\t    if (!result.ok) return;\n271\t\n272\t    // The cleared set is exactly the chain: m1's forms, t1's two, c1's two.\n273\t    expect(result.value.cleared.map(clearKey).sort()).toEqual(\n274\t      [\n275\t        \"message/m1/smoothed_prompt\",\n276\t        \"turn/t1/lower_band_projection\",\n277\t        \"turn/t1/turn_rendering\",\n278\t        \"chunk/c1/chunk_summary_brief\",\n279\t        \"chunk/c1/chunk_summary_detailed\",\n280\t      ].sort(),\n281\t    );\n282\t\n283\t    // The untouched-set half: every form outside the chain — chunk 2's\n284\t    // summaries, t2's forms, m4's smoothing — deep-equal their pre-edit rows,\n285\t    // state and source version included.\n286\t    const clearedSet = new Set(result.value.cleared.map(clearKey));\n287\t    const after = readDerivedForms(filePath);\n288\t    expect(after.filter((form) => !clearedSet.has(clearKey(form)))).toEqual(\n289\t      before.filter((form) => !clearedSet.has(clearKey(form))),\n290\t    );\n291\t    // And the cleared half sits pending at the bumped version.\n292\t    for (const form of after.filter((candidate) => clearedSet.has(clearKey(candidate)))) {\n293\t      expect(form.state).toBe(\"pending\");\n294\t      expect(form.sourceVersion).toBe(2);\n295\t      expect(form.content).toBeUndefined();\n296\t    }\n297\t  });\n298\t});\n299\t\n300\tdescribe(\"TC-5.3 / AC-5.3: post-return, nothing pre-edit is ready; replacements queued at the new version; superseded reported\", () => {\n301\t  it(\"clears to pending with version-scoped replacement ids, and a second edit supersedes the still-queued first wave\", async () => {\n302\t    const double = createProviderDouble();\n303\t    const sdk = manualSdk(double, {\n304\t      chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 1 },\n305\t    });\n306\t    const filePath = await newThread();\n307\t    await send(sdk, filePath, [\n308\t      validEvent(\"user_prompt\", { payload: { text: \"original prompt\" } }),\n309\t      validEvent(\"assistant_text\", { payload: { text: \"the answer\" } }),\n310\t      validEvent(\"turn_end\"),\n311\t    ]);\n312\t    await drain(sdk, filePath);\n313\t    expect(readDerivedForms(filePath).every((form) => form.state === \"ready\")).toBe(true);\n314\t\n315\t    const firstWaveIds = [\n316\t      \"w-c1-chunk_summary_brief-v2\",\n317\t      \"w-c1-chunk_summary_detailed-v2\",\n318\t      \"w-m1-prompt_smoothing-v2\",\n319\t      \"w-t1-turn_derivation-v2\",\n320\t    ];\n321\t\n322\t    // Edit while everything is ready: every dependent form leaves ready in\n323\t    // the edit's transaction, replacement items carry the new source version\n324\t    // in their ids and payloads, and nothing was queued to supersede.\n325\t    const first = await messages.edit({ filePath }, { messageId: \"m1\", content: \"first edit\" });\n326\t    expect(first.ok).toBe(true);\n327\t    if (!first.ok) return;\n328\t    expect(first.value.superseded).toEqual([]);\n329\t    expect(first.value.queued.map((item) => item.workItemId).sort()).toEqual(firstWaveIds);\n330\t    const formsAfterFirst = readDerivedForms(filePath);\n331\t    expect(formsAfterFirst.every((form) => form.state === \"pending\")).toBe(true);\n332\t    expect(formsAfterFirst.every((form) => form.sourceVersion === 2)).toBe(true);\n333\t    const queueAfterFirst = rawDetail(filePath);\n334\t    expect(queueAfterFirst.map((row) => row.workItemId).sort()).toEqual(firstWaveIds);\n335\t    expect(queueAfterFirst.every((row) => row.status === \"queued\" && row.sourceVersion === 2)).toBe(\n336\t      true,\n337\t    );\n338\t\n339\t    // Second edit before any drain: the still-queued first wave is\n340\t    // supersede-deleted in the cascade transaction and reported; the queue\n341\t    // holds only the v3 replacements.\n342\t    const second = await messages.edit({ filePath }, { messageId: \"m1\", content: \"second edit\" });\n343\t    expect(second.ok).toBe(true);\n344\t    if (!second.ok) return;\n345\t    expect([...second.value.superseded].sort()).toEqual(firstWaveIds);\n346\t    const queueAfterSecond = rawDetail(filePath);\n347\t    expect(queueAfterSecond.map((row) => row.workItemId).sort()).toEqual([\n348\t      \"w-c1-chunk_summary_brief-v3\",\n349\t      \"w-c1-chunk_summary_detailed-v3\",\n350\t      \"w-m1-prompt_smoothing-v3\",\n351\t      \"w-t1-turn_derivation-v3\",\n352\t    ]);\n353\t    expect(\n354\t      readDerivedForms(filePath).every(\n355\t        (form) => form.state === \"pending\" && form.sourceVersion === 3,\n356\t      ),\n357\t    ).toBe(true);\n358\t\n359\t    // And the drain rebuilds the whole chain from the second edit's content.\n360\t    await drain(sdk, filePath);\n361\t    const smoothing = readDerivedForms(filePath).find(\n362\t      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n363\t    );\n364\t    expect(smoothing?.state).toBe(\"ready\");\n365\t    expect(smoothing?.content).toBe(\n366\t      deterministicText(\"smoothPrompt\", { text: \"second edit\" }, \"second edit\"),\n367\t    );\n368\t  });\n369\t});\n370\t\n371\tdescribe(\"TC-5.4 / AC-5.4 (architecture risk): the version check beats the straggler\", () => {\n372\t  it(\"a claimed pre-edit item completing after the edit discards as stale_discarded; the post-edit artifact wins\", async () => {\n373\t    const double = createProviderDouble();\n374\t    const sdk = manualSdk(double);\n375\t    const filePath = await newThread();\n376\t    await send(sdk, filePath, [\n377\t      validEvent(\"user_prompt\", { payload: { text: \"original prompt\" } }),\n378\t      validEvent(\"turn_end\"),\n379\t    ]);\n380\t\n381\t    // Hold the old-content smoothing in flight: the drain claims it, the\n382\t    // handler awaits the delayed double, and the edit lands inside that\n383\t    // window — a real claimed old-version item held across the edit, not a\n384\t    // simulated version poke.\n385\t    double.delayKind(\"prompt_smoothing\", 400);\n386\t    const captured = double.captureInputs();\n387\t    const drainPromise = sdk.work.drain({ filePath });\n388\t    await until(\n389\t      () => captured.some((call) => call.op === \"smoothPrompt\"),\n390\t      \"the old-content smoothing to be claimed and in-handler\",\n391\t    );\n392\t\n393\t    const edited = await messages.edit(\n394\t      { filePath },\n395\t      { messageId: \"m1\", content: \"edited prompt\" },\n396\t    );\n397\t    expect(edited.ok).toBe(true);\n398\t    if (!edited.ok) return;\n399\t    // The still-queued turn derivation behind the claimed head was\n400\t    // superseded; the claimed item was left to the version check.\n401\t    expect(edited.value.superseded).toEqual([\"w-t1-turn_derivation-v1\"]);\n402\t\n403\t    // Old claimed item and post-edit replacement coexist — ids include the\n404\t    // source version, so they never collide.\n405\t    const mid = rawDetail(filePath);\n406\t    expect(mid.map((row) => [row.workItemId, row.status])).toEqual([\n407\t      [\"w-m1-prompt_smoothing-v1\", \"claimed\"],\n408\t      [\"w-m1-prompt_smoothing-v2\", \"queued\"],\n409\t      [\"w-t1-turn_derivation-v2\", \"queued\"],\n410\t    ]);\n411\t\n412\t    // Let both complete. The straggler's completion is a normal completion\n413\t    // reported stale_discarded — not an error, not a retry — and the drain\n414\t    // continues into the replacement work.\n415\t    const drained = await drainPromise;\n416\t    expect(drained.ok).toBe(true);\n417\t    if (!drained.ok) return;\n418\t    expect(drained.value.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n419\t      [\"w-m1-prompt_smoothing-v1\", \"stale_discarded\"],\n420\t      [\"w-m1-prompt_smoothing-v2\", \"done\"],\n421\t      [\"w-t1-turn_derivation-v2\", \"done\"],\n422\t    ]);\n423\t\n424\t    // Exactly one ready smoothing row, derived from the post-edit content at\n425\t    // the post-edit source version — regardless of completion order.\n426\t    const rows = readDerivedForms(filePath).filter(\n427\t      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n428\t    );\n429\t    expect(rows).toHaveLength(1);\n430\t    expect(rows[0]).toMatchObject({ state: \"ready\", sourceVersion: 2 });\n431\t    expect(rows[0]?.content).toBe(\n432\t      deterministicText(\"smoothPrompt\", { text: \"edited prompt\" }, \"edited prompt\"),\n433\t    );\n434\t    expect(rawDetail(filePath)).toEqual([]);\n435\t  }, 15000);\n436\t});\n437\t\n438\tdescribe(\"TC-5.5 / AC-5.5: refusals are stable and change nothing\", () => {\n439\t  it(\"refuses open-turn, missing, and deleted targets; read-back identical after each\", async () => {\n440\t    const double = createProviderDouble();\n441\t    const sdk = manualSdk(double);\n442\t    const filePath = await newThread();\n443\t    // m1 in closed t1; m3 in open t2.\n444\t    await send(sdk, filePath, [\n445\t      validEvent(\"user_prompt\", { payload: { text: \"closed prompt\" } }),\n446\t      validEvent(\"turn_end\"),\n447\t      validEvent(\"user_prompt\", { payload: { text: \"open prompt\" } }),\n448\t    ]);\n449\t    const before = await snapshot(filePath);\n450\t\n451\t    const openTurn = await messages.edit({ filePath }, { messageId: \"m3\", content: \"nope\" });\n452\t    expect(openTurn.ok).toBe(false);\n453\t    if (openTurn.ok) return;\n454\t    expect(openTurn.error.errorClass).toBe(\"caller_error\");\n455\t    expect(openTurn.error.code).toBe(\"turn_open\");\n456\t    expect(await snapshot(filePath)).toEqual(before);\n457\t\n458\t    const missing = await messages.edit({ filePath }, { messageId: \"m99\", content: \"nope\" });\n459\t    expect(missing.ok).toBe(false);\n460\t    if (missing.ok) return;\n461\t    expect(missing.error.errorClass).toBe(\"caller_error\");\n462\t    expect(missing.error.code).toBe(\"message_not_found\");\n463\t    expect(await snapshot(filePath)).toEqual(before);\n464\t\n465\t    // A deleted target reads as message_not_found through the filtered view\n466\t    // — never a distinct error. (deleted_at stamped below the SDK: the\n467\t    // delete operation itself is Story 6.)\n468\t    const db = openRaw(filePath);\n469\t    db.prepare(`UPDATE message SET deleted_at = ? WHERE message_id = 'm1'`).run(\n470\t      \"2026-06-11T00:00:00.000Z\",\n471\t    );\n472\t    db.close();\n473\t    const afterStamp = await snapshot(filePath);\n474\t    const deleted = await messages.edit({ filePath }, { messageId: \"m1\", content: \"nope\" });\n475\t    expect(deleted.ok).toBe(false);\n476\t    if (deleted.ok) return;\n477\t    expect(deleted.error.code).toBe(\"message_not_found\");\n478\t    expect(await snapshot(filePath)).toEqual(afterStamp);\n479\t  });\n480\t\n481\t  it(\"refuses a turnless (no-membership) target under the closed-turn boundary; read-back unchanged\", async () => {\n482\t    const double = createProviderDouble();\n483\t    const sdk = manualSdk(double);\n484\t    const filePath = await newThread();\n485\t    // A note before any prompt opens a turn lands in a gap: m1 with no turn\n486\t    // membership (turnId null). It exists and isn't deleted, so neither the\n487\t    // open-turn nor the message_not_found refusal would catch it — the\n488\t    // closed-turn boundary is the only gate that does.\n489\t    await send(sdk, filePath, [\n490\t      validEvent(\"runtime_note\", { payload: { text: \"a note before any turn\" } }),\n491\t    ]);\n492\t    const m1 = unwrap(await messages.listMessages({ filePath })).find(\n493\t      (record) => record.messageId === \"m1\",\n494\t    );\n495\t    expect(m1?.turnId).toBeUndefined();\n496\t\n497\t    const before = await snapshot(filePath);\n498\t    const turnless = await messages.edit({ filePath }, { messageId: \"m1\", content: \"nope\" });\n499\t    expect(turnless.ok).toBe(false);\n500\t    if (turnless.ok) return;\n501\t    expect(turnless.error.errorClass).toBe(\"caller_error\");\n502\t    expect(turnless.error.code).toBe(\"turn_open\");\n503\t    expect(await snapshot(filePath)).toEqual(before);\n504\t  });\n505\t});\n506\t\n507\tdescribe(\"background mode: edit-and-walk-away (production path)\", () => {\n508\t  it(\"the cascade's enqueue pokes ride the commit; rebuilds run with no further call\", async () => {\n509\t    const double = createProviderDouble();\n510\t    const sdk = manualSdk(double, { mode: \"background\" });\n511\t    const filePath = await newThread();\n512\t    await send(sdk, filePath, [\n513\t      validEvent(\"user_prompt\", { payload: { text: \"original prompt\" } }),\n514\t      validEvent(\"assistant_text\", { payload: { text: \"the answer\" } }),\n515\t      validEvent(\"turn_end\"),\n516\t    ]);\n517\t    await sdk.drainSettled({ filePath });\n518\t    expect(readDerivedForms(filePath).every((form) => form.state === \"ready\")).toBe(true);\n519\t\n520\t    const result: OpResult<MutationResult> = await messages.edit(\n521\t      { filePath },\n522\t      { messageId: \"m1\", content: \"edited prompt\" },\n523\t    );\n524\t    expect(result.ok).toBe(true);\n525\t    await sdk.drainSettled({ filePath });\n526\t\n527\t    const smoothing = readDerivedForms(filePath).find(\n528\t      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n529\t    );\n530\t    expect(smoothing).toMatchObject({ state: \"ready\", sourceVersion: 2 });\n531\t    expect(smoothing?.content).toBe(\n532\t      deterministicText(\"smoothPrompt\", { text: \"edited prompt\" }, \"edited prompt\"),\n533\t    );\n534\t    expect(rawDetail(filePath)).toEqual([]);\n535\t  });\n536\t});\n537\t"}]},"parent_tool_use_id":null,"session_id":"91a5247d-d939-443d-a5c4-7c2ee5826722","uuid":"520604ae-8df0-42f3-a952-2ddd46de6b9f","timestamp":"2026-06-11T06:41:02.075Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/mutations.test.ts","content":"// Story 5 (Epic 02): messages.edit and the mutation cascade — Flow 5's edit\n// half. One synchronous transaction carries the content change, the token\n// re-stamp, and the full dependent-chain clear-and-requeue (TC-5.1), with\n// induced-failure atomicity proving a failing cascade step rolls back the\n// content change too (architecture risk). Cascade reach is proven in both\n// directions — exactly the chain cleared, everything outside it byte-stable\n// including source versions (TC-5.2, architecture risk). Post-return no\n// pre-edit derivation is ready and replacements sit queued at the new source\n// version, with superseded queued ids reported and their rows gone (TC-5.3).\n// TC-5.4 is the epic's named architecture-risk test: a claimed pre-edit item\n// held across the edit by the delayed double completes after the post-edit\n// rebuild is queued, discards on the source-version mismatch as\n// stale_discarded, and the post-edit artifact stands. Refusals (open turn,\n// turnless no-membership target, missing id, deleted target through the\n// filtered view) change nothing (TC-5.5). The CLI parity leg of TC-5.6 lives in\n// cli-process-mutations.test.ts (process suite).\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createSdk,\n  deterministicText,\n  estimateTokens,\n  messages,\n  queueDetail,\n  setSchedulerPoke,\n  setThreadTouch,\n  threads,\n  type DerivationProvider,\n  type DrainReport,\n  type Lhc,\n  type MessageEventInput,\n  type MutationResult,\n  type OpResult,\n  type SdkConfig,\n} from \"../src/index.js\";\nimport {\n  createProviderDouble,\n  openRaw,\n  readDerivedForms,\n  tempStore,\n  validEvent,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n  setSchedulerPoke(null);\n  setThreadTouch(null);\n});\n\nasync function newThread(): Promise<string> {\n  const created = await threads.newThread({\n    filePath: store.threadPath(),\n    registryPath: store.registryPath,\n  });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n  return created.value.filePath;\n}\n\nfunction manualSdk(\n  provider: DerivationProvider,\n  overrides: Partial<Pick<SdkConfig, \"chunkPolicy\" | \"clock\" | \"mode\">> = {},\n): Lhc {\n  const config: SdkConfig = {\n    provider,\n    mode: overrides.mode ?? \"manual\",\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    lease: { durationMs: 5000 },\n  };\n  if (overrides.chunkPolicy !== undefined) config.chunkPolicy = overrides.chunkPolicy;\n  if (overrides.clock !== undefined) config.clock = overrides.clock;\n  return createSdk(config);\n}\n\nasync function send(\n  sdk: Lhc,\n  filePath: string,\n  batch: readonly MessageEventInput[],\n): Promise<void> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n}\n\nasync function drain(sdk: Lhc, filePath: string): Promise<DrainReport> {\n  const result = await sdk.work.drain({ filePath });\n  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n  return result.value;\n}\n\nfunction rawDetail(filePath: string): ReturnType<typeof queueDetail> {\n  const db = openRaw(filePath);\n  try {\n    return queueDetail(db);\n  } finally {\n    db.close();\n  }\n}\n\nfunction clearKey(entry: { subjectKind: string; subjectId: string; form: string }): string {\n  return `${entry.subjectKind}/${entry.subjectId}/${entry.form}`;\n}\n\nfunction unwrap<T>(result: OpResult<T>): T {\n  if (!result.ok) throw new Error(`expected ok result, got ${result.error.code}`);\n  return result.value;\n}\n\n// One closed prompt+answer turn (m1 prompt, t1), drained ready. Under the\n// default chunk policy t1's chunk stays open, so no chunk summary rows exist.\nasync function readyTurnThread(sdk: Lhc): Promise<string> {\n  const filePath = await newThread();\n  await send(sdk, filePath, [\n    validEvent(\"user_prompt\", { payload: { text: \"original prompt\" } }),\n    validEvent(\"assistant_text\", { payload: { text: \"the original answer\" } }),\n    validEvent(\"turn_end\"),\n  ]);\n  await drain(sdk, filePath);\n  return filePath;\n}\n\n// The full mutation read-back surface in one snapshot: record, forms, queue.\nasync function snapshot(filePath: string): Promise<unknown> {\n  return {\n    messages: unwrap(await messages.listMessages({ filePath })),\n    forms: readDerivedForms(filePath),\n    queue: rawDetail(filePath),\n  };\n}\n\nasync function until(cond: () => boolean, what: string, timeoutMs = 5000): Promise<void> {\n  const start = Date.now();\n  while (!cond()) {\n    if (Date.now() - start > timeoutMs) throw new Error(`timed out waiting for ${what}`);\n    await new Promise((resolve) => setTimeout(resolve, 5));\n  }\n}\n\ndescribe(\"TC-5.1 / AC-5.1: edit updates content, blocks, and estimate synchronously, reporting the cascade\", () => {\n  it(\"changes the record in the edit's transaction and names cleared forms and queued items\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await readyTurnThread(sdk);\n\n    const result = await messages.edit(\n      { filePath },\n      { messageId: \"m1\", content: \"edited prompt\" },\n    );\n    expect(result.ok).toBe(true);\n    if (!result.ok) return;\n    expect(result.value.changed).toEqual({ messageIds: [\"m1\"], turnIds: [] });\n    expect(result.value.dropped).toEqual([]);\n    // The chain above m1: its own smoothing and t1's two forms. t1's chunk is\n    // still open — no summary rows exist, so none are named.\n    expect(result.value.cleared.map(clearKey).sort()).toEqual(\n      [\n        \"message/m1/smoothed_prompt\",\n        \"turn/t1/lower_band_projection\",\n        \"turn/t1/turn_rendering\",\n      ].sort(),\n    );\n    expect([...result.value.queued].sort((a, b) => a.workItemId.localeCompare(b.workItemId)))\n      .toEqual([\n        { workItemId: \"w-m1-prompt_smoothing-v2\", kind: \"prompt_smoothing\" },\n        { workItemId: \"w-t1-turn_derivation-v2\", kind: \"turn_derivation\" },\n      ]);\n    expect(result.value.superseded).toEqual([]);\n\n    // Synchronous, before any drain: content, blocks, and the re-stamped\n    // estimate read back changed.\n    const m1 = unwrap(await messages.listMessages({ filePath })).find(\n      (record) => record.messageId === \"m1\",\n    );\n    expect(m1?.blocks).toEqual([{ blockType: \"text\", content: { text: \"edited prompt\" } }]);\n    expect(m1?.tokenEstimate).toBe(estimateTokens(\"edited prompt\"));\n\n    // The queued rebuilds run through the normal drain and derive from the\n    // edited content.\n    await drain(sdk, filePath);\n    const smoothing = readDerivedForms(filePath).find(\n      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n    );\n    expect(smoothing?.state).toBe(\"ready\");\n    expect(smoothing?.content).toBe(\n      deterministicText(\"smoothPrompt\", { text: \"edited prompt\" }, \"edited prompt\"),\n    );\n  });\n\n  it(\"induced cascade failure rolls back the content change too (atomicity, architecture risk)\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await readyTurnThread(sdk);\n\n    // Plant a claimed row at the exact id the cascade's replacement enqueue\n    // will insert. Supersede only deletes queued rows, so the insert hits a\n    // primary-key conflict mid-cascade — after the content apply — and the\n    // transaction must roll back whole.\n    const db = openRaw(filePath);\n    db.prepare(\n      `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n       VALUES (?, 'messages', 'prompt_smoothing', ?, 'claimed', ?, ?)`,\n    ).run(\n      \"w-m1-prompt_smoothing-v2\",\n      JSON.stringify({ messageId: \"m1\" }),\n      \"2026-06-11T00:00:00.000Z\",\n      JSON.stringify({ sourceVersion: 2, forms: [] }),\n    );\n    db.close();\n\n    const before = await snapshot(filePath);\n    const result = await messages.edit(\n      { filePath },\n      { messageId: \"m1\", content: \"edited prompt\" },\n    );\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.code).toBe(\"storage_failure\");\n    // Nothing changed: not the message content, not the estimate, not a\n    // single form state or source version, not the queue.\n    expect(await snapshot(filePath)).toEqual(before);\n  });\n});\n\ndescribe(\"TC-5.2 / AC-5.2 (architecture risk): cascade reach is exact in both directions\", () => {\n  it(\"clears exactly the edited message's chain; the second chunk's forms are byte-stable\", async () => {\n    const double = createProviderDouble();\n    // max=1: every turn's projection meets the maximum, so each turn forms\n    // its own immediately closed chunk — two chunks, both with summaries.\n    const sdk = manualSdk(double, {\n      chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 1 },\n    });\n    const filePath = await newThread();\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"first answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"second answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    await drain(sdk, filePath);\n\n    const before = readDerivedForms(filePath);\n    // Fixture sanity: both chunks closed with every form ready.\n    expect(before.map((form) => clearKey(form)).sort()).toEqual(\n      [\n        \"message/m1/smoothed_prompt\",\n        \"message/m4/smoothed_prompt\",\n        \"turn/t1/lower_band_projection\",\n        \"turn/t1/turn_rendering\",\n        \"turn/t2/lower_band_projection\",\n        \"turn/t2/turn_rendering\",\n        \"chunk/c1/chunk_summary_brief\",\n        \"chunk/c1/chunk_summary_detailed\",\n        \"chunk/c2/chunk_summary_brief\",\n        \"chunk/c2/chunk_summary_detailed\",\n      ].sort(),\n    );\n    expect(before.every((form) => form.state === \"ready\")).toBe(true);\n\n    const result = await messages.edit(\n      { filePath },\n      { messageId: \"m1\", content: \"rewritten first prompt\" },\n    );\n    expect(result.ok).toBe(true);\n    if (!result.ok) return;\n\n    // The cleared set is exactly the chain: m1's forms, t1's two, c1's two.\n    expect(result.value.cleared.map(clearKey).sort()).toEqual(\n      [\n        \"message/m1/smoothed_prompt\",\n        \"turn/t1/lower_band_projection\",\n        \"turn/t1/turn_rendering\",\n        \"chunk/c1/chunk_summary_brief\",\n        \"chunk/c1/chunk_summary_detailed\",\n      ].sort(),\n    );\n\n    // The untouched-set half: every form outside the chain — chunk 2's\n    // summaries, t2's forms, m4's smoothing — deep-equal their pre-edit rows,\n    // state and source version included.\n    const clearedSet = new Set(result.value.cleared.map(clearKey));\n    const after = readDerivedForms(filePath);\n    expect(after.filter((form) => !clearedSet.has(clearKey(form)))).toEqual(\n      before.filter((form) => !clearedSet.has(clearKey(form))),\n    );\n    // And the cleared half sits pending at the bumped version.\n    for (const form of after.filter((candidate) => clearedSet.has(clearKey(candidate)))) {\n      expect(form.state).toBe(\"pending\");\n      expect(form.sourceVersion).toBe(2);\n      expect(form.content).toBeUndefined();\n    }\n  });\n});\n\ndescribe(\"TC-5.3 / AC-5.3: post-return, nothing pre-edit is ready; replacements queued at the new version; superseded reported\", () => {\n  it(\"clears to pending with version-scoped replacement ids, and a second edit supersedes the still-queued first wave\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double, {\n      chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 1 },\n    });\n    const filePath = await newThread();\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"original prompt\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"the answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    await drain(sdk, filePath);\n    expect(readDerivedForms(filePath).every((form) => form.state === \"ready\")).toBe(true);\n\n    const firstWaveIds = [\n      \"w-c1-chunk_summary_brief-v2\",\n      \"w-c1-chunk_summary_detailed-v2\",\n      \"w-m1-prompt_smoothing-v2\",\n      \"w-t1-turn_derivation-v2\",\n    ];\n\n    // Edit while everything is ready: every dependent form leaves ready in\n    // the edit's transaction, replacement items carry the new source version\n    // in their ids and payloads, and nothing was queued to supersede.\n    const first = await messages.edit({ filePath }, { messageId: \"m1\", content: \"first edit\" });\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    expect(first.value.superseded).toEqual([]);\n    expect(first.value.queued.map((item) => item.workItemId).sort()).toEqual(firstWaveIds);\n    const formsAfterFirst = readDerivedForms(filePath);\n    expect(formsAfterFirst.every((form) => form.state === \"pending\")).toBe(true);\n    expect(formsAfterFirst.every((form) => form.sourceVersion === 2)).toBe(true);\n    const queueAfterFirst = rawDetail(filePath);\n    expect(queueAfterFirst.map((row) => row.workItemId).sort()).toEqual(firstWaveIds);\n    expect(queueAfterFirst.every((row) => row.status === \"queued\" && row.sourceVersion === 2)).toBe(\n      true,\n    );\n\n    // Second edit before any drain: the still-queued first wave is\n    // supersede-deleted in the cascade transaction and reported; the queue\n    // holds only the v3 replacements.\n    const second = await messages.edit({ filePath }, { messageId: \"m1\", content: \"second edit\" });\n    expect(second.ok).toBe(true);\n    if (!second.ok) return;\n    expect([...second.value.superseded].sort()).toEqual(firstWaveIds);\n    const queueAfterSecond = rawDetail(filePath);\n    expect(queueAfterSecond.map((row) => row.workItemId).sort()).toEqual([\n      \"w-c1-chunk_summary_brief-v3\",\n      \"w-c1-chunk_summary_detailed-v3\",\n      \"w-m1-prompt_smoothing-v3\",\n      \"w-t1-turn_derivation-v3\",\n    ]);\n    expect(\n      readDerivedForms(filePath).every(\n        (form) => form.state === \"pending\" && form.sourceVersion === 3,\n      ),\n    ).toBe(true);\n\n    // And the drain rebuilds the whole chain from the second edit's content.\n    await drain(sdk, filePath);\n    const smoothing = readDerivedForms(filePath).find(\n      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n    );\n    expect(smoothing?.state).toBe(\"ready\");\n    expect(smoothing?.content).toBe(\n      deterministicText(\"smoothPrompt\", { text: \"second edit\" }, \"second edit\"),\n    );\n  });\n});\n\ndescribe(\"TC-5.4 / AC-5.4 (architecture risk): the version check beats the straggler\", () => {\n  it(\"a claimed pre-edit item completing after the edit discards as stale_discarded; the post-edit artifact wins\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"original prompt\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n\n    // Hold the old-content smoothing in flight: the drain claims it, the\n    // handler awaits the delayed double, and the edit lands inside that\n    // window — a real claimed old-version item held across the edit, not a\n    // simulated version poke.\n    double.delayKind(\"prompt_smoothing\", 400);\n    const captured = double.captureInputs();\n    const drainPromise = sdk.work.drain({ filePath });\n    await until(\n      () => captured.some((call) => call.op === \"smoothPrompt\"),\n      \"the old-content smoothing to be claimed and in-handler\",\n    );\n\n    const edited = await messages.edit(\n      { filePath },\n      { messageId: \"m1\", content: \"edited prompt\" },\n    );\n    expect(edited.ok).toBe(true);\n    if (!edited.ok) return;\n    // The still-queued turn derivation behind the claimed head was\n    // superseded; the claimed item was left to the version check.\n    expect(edited.value.superseded).toEqual([\"w-t1-turn_derivation-v1\"]);\n\n    // Old claimed item and post-edit replacement coexist — ids include the\n    // source version, so they never collide.\n    const mid = rawDetail(filePath);\n    expect(mid.map((row) => [row.workItemId, row.status])).toEqual([\n      [\"w-m1-prompt_smoothing-v1\", \"claimed\"],\n      [\"w-m1-prompt_smoothing-v2\", \"queued\"],\n      [\"w-t1-turn_derivation-v2\", \"queued\"],\n    ]);\n\n    // Let both complete. The straggler's completion is a normal completion\n    // reported stale_discarded — not an error, not a retry — and the drain\n    // continues into the replacement work.\n    const drained = await drainPromise;\n    expect(drained.ok).toBe(true);\n    if (!drained.ok) return;\n    expect(drained.value.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n      [\"w-m1-prompt_smoothing-v1\", \"stale_discarded\"],\n      [\"w-m1-prompt_smoothing-v2\", \"done\"],\n      [\"w-t1-turn_derivation-v2\", \"done\"],\n    ]);\n\n    // Exactly one ready smoothing row, derived from the post-edit content at\n    // the post-edit source version — regardless of completion order.\n    const rows = readDerivedForms(filePath).filter(\n      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n    );\n    expect(rows).toHaveLength(1);\n    expect(rows[0]).toMatchObject({ state: \"ready\", sourceVersion: 2 });\n    expect(rows[0]?.content).toBe(\n      deterministicText(\"smoothPrompt\", { text: \"edited prompt\" }, \"edited prompt\"),\n    );\n    expect(rawDetail(filePath)).toEqual([]);\n  }, 15000);\n});\n\ndescribe(\"TC-5.5 / AC-5.5: refusals are stable and change nothing\", () => {\n  it(\"refuses open-turn, missing, and deleted targets; read-back identical after each\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    // m1 in closed t1; m3 in open t2.\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"closed prompt\" } }),\n      validEvent(\"turn_end\"),\n      validEvent(\"user_prompt\", { payload: { text: \"open prompt\" } }),\n    ]);\n    const before = await snapshot(filePath);\n\n    const openTurn = await messages.edit({ filePath }, { messageId: \"m3\", content: \"nope\" });\n    expect(openTurn.ok).toBe(false);\n    if (openTurn.ok) return;\n    expect(openTurn.error.errorClass).toBe(\"caller_error\");\n    expect(openTurn.error.code).toBe(\"turn_open\");\n    expect(await snapshot(filePath)).toEqual(before);\n\n    const missing = await messages.edit({ filePath }, { messageId: \"m99\", content: \"nope\" });\n    expect(missing.ok).toBe(false);\n    if (missing.ok) return;\n    expect(missing.error.errorClass).toBe(\"caller_error\");\n    expect(missing.error.code).toBe(\"message_not_found\");\n    expect(await snapshot(filePath)).toEqual(before);\n\n    // A deleted target reads as message_not_found through the filtered view\n    // — never a distinct error. (deleted_at stamped below the SDK: the\n    // delete operation itself is Story 6.)\n    const db = openRaw(filePath);\n    db.prepare(`UPDATE message SET deleted_at = ? WHERE message_id = 'm1'`).run(\n      \"2026-06-11T00:00:00.000Z\",\n    );\n    db.close();\n    const afterStamp = await snapshot(filePath);\n    const deleted = await messages.edit({ filePath }, { messageId: \"m1\", content: \"nope\" });\n    expect(deleted.ok).toBe(false);\n    if (deleted.ok) return;\n    expect(deleted.error.code).toBe(\"message_not_found\");\n    expect(await snapshot(filePath)).toEqual(afterStamp);\n  });\n\n  it(\"refuses a turnless (no-membership) target under the closed-turn boundary; read-back unchanged\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double);\n    const filePath = await newThread();\n    // A note before any prompt opens a turn lands in a gap: m1 with no turn\n    // membership (turnId null). It exists and isn't deleted, so neither the\n    // open-turn nor the message_not_found refusal would catch it — the\n    // closed-turn boundary is the only gate that does.\n    await send(sdk, filePath, [\n      validEvent(\"runtime_note\", { payload: { text: \"a note before any turn\" } }),\n    ]);\n    const m1 = unwrap(await messages.listMessages({ filePath })).find(\n      (record) => record.messageId === \"m1\",\n    );\n    expect(m1?.turnId).toBeUndefined();\n\n    const before = await snapshot(filePath);\n    const turnless = await messages.edit({ filePath }, { messageId: \"m1\", content: \"nope\" });\n    expect(turnless.ok).toBe(false);\n    if (turnless.ok) return;\n    expect(turnless.error.errorClass).toBe(\"caller_error\");\n    expect(turnless.error.code).toBe(\"turn_open\");\n    expect(await snapshot(filePath)).toEqual(before);\n  });\n});\n\ndescribe(\"background mode: edit-and-walk-away (production path)\", () => {\n  it(\"the cascade's enqueue pokes ride the commit; rebuilds run with no further call\", async () => {\n    const double = createProviderDouble();\n    const sdk = manualSdk(double, { mode: \"background\" });\n    const filePath = await newThread();\n    await send(sdk, filePath, [\n      validEvent(\"user_prompt\", { payload: { text: \"original prompt\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"the answer\" } }),\n      validEvent(\"turn_end\"),\n    ]);\n    await sdk.drainSettled({ filePath });\n    expect(readDerivedForms(filePath).every((form) => form.state === \"ready\")).toBe(true);\n\n    const result: OpResult<MutationResult> = await messages.edit(\n      { filePath },\n      { messageId: \"m1\", content: \"edited prompt\" },\n    );\n    expect(result.ok).toBe(true);\n    await sdk.drainSettled({ filePath });\n\n    const smoothing = readDerivedForms(filePath).find(\n      (form) => form.subjectId === \"m1\" && form.form === \"smoothed_prompt\",\n    );\n    expect(smoothing).toMatchObject({ state: \"ready\", sourceVersion: 2 });\n    expect(smoothing?.content).toBe(\n      deterministicText(\"smoothPrompt\", { text: \"edited prompt\" }, \"edited prompt\"),\n    );\n    expect(rawDetail(filePath)).toEqual([]);\n  });\n});\n","numLines":537,"startLine":1,"totalLines":537}}}

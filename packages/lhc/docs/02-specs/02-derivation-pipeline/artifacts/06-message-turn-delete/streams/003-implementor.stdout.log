{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rrkq57wQ2YTCxCtGMNc5Pb","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n3\timport type {\n4\t  FormKind,\n5\t  FormReportEntry,\n6\t  WorkHandler,\n7\t} from \"../../shared/derivation.js\";\n8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n9\timport {\n10\t  enqueue,\n11\t  hasLiveItem,\n12\t  listItems,\n13\t  type EnqueueFormTarget,\n14\t  type WorkItemRecord,\n15\t  type WorkKind,\n16\t  type WorkSourceRef,\n17\t} from \"../../tech-utils/work-queue/index.js\";\n18\timport type { EventKind } from \"../intake-stream/index.js\";\n19\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n20\timport { transition } from \"./internal/state-machine.js\";\n21\t\n22\t// The pure rule table, re-exported for the golden supplemental suite (the\n23\t// test plan's one sanctioned direct entry besides the tokenizer); production\n24\t// callers go through applyEvent.\n25\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n26\timport type { DerivedForm } from \"../../shared/derivation.js\";\n27\timport { turnWorkHandlers } from \"./internal/derive.js\";\n28\timport {\n29\t  readChunkRows,\n30\t  readOwnedForms,\n31\t  readTurnFormRow,\n32\t  reportTurnForms,\n33\t} from \"./internal/forms.js\";\n34\timport {\n35\t  closeTurn,\n36\t  insertOpenTurn,\n37\t  nextTurnOrder,\n38\t  readTurns,\n39\t  selectOpenTurnIds,\n40\t} from \"./internal/store.js\";\n41\t\n42\texport interface TurnRecord {\n43\t  turnId: string;\n44\t  status: \"open\" | \"closed\";\n45\t  memberMessageIds: string[];\n46\t  openedAtEventOrder: number;\n47\t  closedAtEventOrder?: number;\n48\t  // Chunk placement (Epic 02 Story 3, AC-3.5): present once the turn's\n49\t  // derivation placed it — stored values read back, never recomputed.\n50\t  chunkId?: string;\n51\t  memberIdx?: number;\n52\t  // The turn's derived forms as stored (Epic 02 Story 4, AC-4.7 ruling 012):\n53\t  // present only when rows exist — a closed turn carries them from the\n54\t  // moment its derivation queues. Stored state returned verbatim, mirroring\n55\t  // the message read's forms key; reads degrade, never block.\n56\t  forms?: DerivedForm[];\n57\t}\n58\t\n59\t// Chunk read-back (Epic 02 Story 4, AC-4.7 ruling 012): the stored chunk\n60\t// record with live membership and its summary forms' states attached —\n61\t// the chunk leg of \"reading a message, turn, or chunk returns the record\n62\t// with form states\".\n63\texport interface ChunkRecord {\n64\t  chunkId: string;\n65\t  chunkOrder: number;\n66\t  status: \"open\" | \"closed\";\n67\t  accumulatedProjectedTokens: number;\n68\t  memberTurnIds: string[];\n69\t  forms?: DerivedForm[];\n70\t}\n71\t\n72\texport interface TurnTransitionOutcome {\n73\t  // Transitions in occurrence order: a close_then_open reports the close\n74\t  // first, then the open, exactly as the batch result surfaces them.\n75\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n76\t  // Turn state after the transition — the stamp for this event's message.\n77\t  // Prompts see the turn they just opened (transition first, then stamp);\n78\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n79\t  openTurnId: string | null;\n80\t  // Work queued by this transition: one turn_derivation item per closed\n81\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\n82\t  queuedWork: WorkItemRecord[];\n83\t}\n84\t\n85\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n86\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n87\t// writes turn state, so more than one open turn means external interference.\n88\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n89\t  return selectOpenTurnIds(ctx.db);\n90\t}\n91\t\n92\t// Closing a turn — by either close path — durably queues that turn's\n93\t// derivation work in the same transaction (AC-3.6): the close update and the\n94\t// work item commit or roll back together.\n95\tfunction closeTurnAndQueueWork(\n96\t  ctx: OperationContext,\n97\t  turnId: string,\n98\t  eventOrder: number,\n99\t): WorkItemRecord {\n100\t  closeTurn(ctx.db, turnId, eventOrder);\n101\t  // One work item, two derived forms: the turn_derivation handler (Story 3)\n102\t  // lands the rendering and the lower-band projection as independent rows;\n103\t  // both go pending with the enqueue (DD-5).\n104\t  return enqueue(ctx, {\n105\t    owner: \"turns\",\n106\t    kind: \"turn_derivation\",\n107\t    sourceRef: { turnId },\n108\t    forms: [\n109\t      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n110\t      { subjectKind: \"turn\", subjectId: turnId, form: \"lower_band_projection\" },\n111\t    ],\n112\t  });\n113\t}\n114\t\n115\t// Turn-owned work handlers, merged into the SDK's dispatch map at\n116\t// construction (DD-6): turn derivation and the two chunk summaries.\n117\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n118\t  turnWorkHandlers;\n119\t\n120\t// Cross-domain surface, called by intake-stream inside the batch transaction\n121\t// for every recorded event. Synchronous and throwing by design, like\n122\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n123\texport function applyEvent(\n124\t  ctx: OperationContext,\n125\t  eventKind: EventKind,\n126\t  eventOrder: number,\n127\t): TurnTransitionOutcome {\n128\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n129\t  const effect = transition({ openTurnId }, eventKind);\n130\t  switch (effect.kind) {\n131\t    case \"none\":\n132\t      return { transitions: [], openTurnId, queuedWork: [] };\n133\t    case \"open\": {\n134\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n135\t      return {\n136\t        transitions: [{ action: \"opened\", turnId }],\n137\t        openTurnId: turnId,\n138\t        queuedWork: [],\n139\t      };\n140\t    }\n141\t    case \"close\": {\n142\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n143\t      return {\n144\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n145\t        openTurnId: null,\n146\t        queuedWork: [item],\n147\t      };\n148\t    }\n149\t    case \"close_then_open\": {\n150\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n151\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n152\t      return {\n153\t        transitions: [\n154\t          { action: \"closed\", turnId: openTurnId as string },\n155\t          { action: \"opened\", turnId },\n156\t        ],\n157\t        openTurnId: turnId,\n158\t        queuedWork: [item],\n159\t      };\n160\t    }\n161\t  }\n162\t}\n163\t\n164\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n165\t  return {\n166\t    ok: false,\n167\t    error: {\n168\t      errorClass: \"caller_error\",\n169\t      code: \"thread_not_found\",\n170\t      reason: `no thread file exists at ${filePath}`,\n171\t    },\n172\t  };\n173\t}\n174\t\n175\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n176\t  const resolved = await resolveThreadRef(thread);\n177\t  if (!resolved.ok) return resolved;\n178\t  const { filePath } = resolved.value;\n179\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n180\t\n181\t  const opened = openThreadDatabase(filePath);\n182\t  if (!opened.ok) return opened;\n183\t  const db = opened.value;\n184\t  try {\n185\t    // Form read-back rides the turn read (AC-4.7): each record carries its\n186\t    // stored derived forms, attached from one grouped query — mirroring the\n187\t    // message read's production path for \"readable alongside the record\".\n188\t    const formsByTurn = readOwnedForms(db, \"turn\");\n189\t    const records = readTurns(db).map((record) => {\n190\t      const forms = formsByTurn.get(record.turnId);\n191\t      return forms === undefined ? record : { ...record, forms };\n192\t    });\n193\t    return { ok: true, value: records };\n194\t  } catch (cause) {\n195\t    const reason = cause instanceof Error ? cause.message : String(cause);\n196\t    return storageFailure(`turn read-back failed: ${reason}`);\n197\t  } finally {\n198\t    db.close();\n199\t  }\n200\t}\n201\t\n202\t// Chunk read-back with summary-form states attached (AC-4.7 ruling 012):\n203\t// returns stored records whatever the forms' states — reads degrade, never\n204\t// block. Forms attach only where rows exist (a freshly opened chunk has no\n205\t// summary rows until close queues them).\n206\texport async function listChunks(thread: ThreadRef): Promise<OpResult<ChunkRecord[]>> {\n207\t  const resolved = await resolveThreadRef(thread);\n208\t  if (!resolved.ok) return resolved;\n209\t  const { filePath } = resolved.value;\n210\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n211\t\n212\t  const opened = openThreadDatabase(filePath);\n213\t  if (!opened.ok) return opened;\n214\t  const db = opened.value;\n215\t  try {\n216\t    const formsByChunk = readOwnedForms(db, \"chunk\");\n217\t    const records: ChunkRecord[] = readChunkRows(db).map((row) => {\n218\t      const forms = formsByChunk.get(row.chunkId);\n219\t      return forms === undefined ? row : { ...row, forms };\n220\t    });\n221\t    return { ok: true, value: records };\n222\t  } catch (cause) {\n223\t    const reason = cause instanceof Error ? cause.message : String(cause);\n224\t    return storageFailure(`chunk read-back failed: ${reason}`);\n225\t  } finally {\n226\t    db.close();\n227\t  }\n228\t}\n229\t\n230\texport async function listQueuedWork(\n231\t  thread: ThreadRef,\n232\t): Promise<OpResult<WorkItemRecord[]>> {\n233\t  const resolved = await resolveThreadRef(thread);\n234\t  if (!resolved.ok) return resolved;\n235\t  const { filePath } = resolved.value;\n236\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n237\t\n238\t  const opened = openThreadDatabase(filePath);\n239\t  if (!opened.ok) return opened;\n240\t  const db = opened.value;\n241\t  try {\n242\t    return { ok: true, value: listItems(db, \"turns\") };\n243\t  } catch (cause) {\n244\t    const reason = cause instanceof Error ? cause.message : String(cause);\n245\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n246\t  } finally {\n247\t    db.close();\n248\t  }\n249\t}\n250\t\n251\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n252\t\n253\t// This owner's repair report: every turn- and chunk-owned form's durable\n254\t// state joined with live queue detail in one query. Needs no provider;\n255\t// reads degrade, never block.\n256\texport async function report(\n257\t  thread: ThreadRef,\n258\t  opts?: { notReady?: boolean; turnId?: string; chunkId?: string },\n259\t): Promise<OpResult<FormReportEntry[]>> {\n260\t  const resolved = await resolveThreadRef(thread);\n261\t  if (!resolved.ok) return resolved;\n262\t  const { filePath } = resolved.value;\n263\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n264\t\n265\t  const opened = openThreadDatabase(filePath);\n266\t  if (!opened.ok) return opened;\n267\t  const db = opened.value;\n268\t  try {\n269\t    return { ok: true, value: reportTurnForms(db, opts ?? {}) };\n270\t  } catch (cause) {\n271\t    const reason = cause instanceof Error ? cause.message : String(cause);\n272\t    return storageFailure(`report read failed: ${reason}`);\n273\t  } finally {\n274\t    db.close();\n275\t  }\n276\t}\n277\t\n278\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n279\t\n280\t// The queue site each turn-owned form rebuilds through. Both turn forms ride\n281\t// the one turn_derivation item (the handler lands rendering and projection\n282\t// together, so a rebuild of either re-derives both — the rebuild rule from\n283\t// Flow 3); each chunk summary rides its same-named kind alone (AC-3.8's\n284\t// independent lifecycles).\n285\tfunction turnRequeueTarget(target: {\n286\t  subjectKind: \"turn\" | \"chunk\";\n287\t  subjectId: string;\n288\t  form: FormKind;\n289\t}): { kind: WorkKind; sourceRef: WorkSourceRef; forms: EnqueueFormTarget[] } | undefined {\n290\t  if (\n291\t    target.subjectKind === \"turn\" &&\n292\t    (target.form === \"turn_rendering\" || target.form === \"lower_band_projection\")\n293\t  ) {\n294\t    return {\n295\t      kind: \"turn_derivation\",\n296\t      sourceRef: { turnId: target.subjectId },\n297\t      forms: [\n298\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"turn_rendering\" },\n299\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"lower_band_projection\" },\n300\t      ],\n301\t    };\n302\t  }\n303\t  if (\n304\t    target.subjectKind === \"chunk\" &&\n305\t    (target.form === \"chunk_summary_detailed\" || target.form === \"chunk_summary_brief\")\n306\t  ) {\n307\t    return {\n308\t      kind: target.form,\n309\t      sourceRef: { chunkId: target.subjectId },\n310\t      forms: [{ subjectKind: \"chunk\", subjectId: target.subjectId, form: target.form }],\n311\t    };\n312\t  }\n313\t  return undefined;\n314\t}\n315\t\n316\t// Explicit re-queue through the owning surface (AC-4.4): same contract as\n317\t// messages.requeue — blocked refused with the stored damage reason, missing\n318\t// rows refused, no-op against live work at the current source version, and\n319\t// the no-op check + enqueue in one transaction. A successful requeue rebuilds\n320\t// at the next source version: composed forms recompute their gaps from\n321\t// current dependency states (Flow 3's rebuild rule).\n322\texport async function requeue(\n323\t  thread: ThreadRef,\n324\t  target: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: FormKind },\n325\t): Promise<OpResult<RequeueOutcome>> {\n326\t  const mapped = turnRequeueTarget(target);\n327\t  if (mapped === undefined) {\n328\t    return {\n329\t      ok: false,\n330\t      error: {\n331\t        errorClass: \"caller_error\",\n332\t        code: \"turn_not_found\",\n333\t        reason: `form ${target.form} is not a ${target.subjectKind}-owned form; turns.requeue repairs turn_rendering and lower_band_projection (turn) or chunk_summary_detailed and chunk_summary_brief (chunk)`,\n334\t      },\n335\t    };\n336\t  }\n337\t  const resolved = await resolveThreadRef(thread);\n338\t  if (!resolved.ok) return resolved;\n339\t  const { filePath } = resolved.value;\n340\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n341\t\n342\t  const opened = openThreadDatabase(filePath);\n343\t  if (!opened.ok) return opened;\n344\t  const db = opened.value;\n345\t  try {\n346\t    const meta = db\n347\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n348\t      .get() as { thread_id: string } | undefined;\n349\t    const threadId = meta?.thread_id ?? \"\";\n350\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n351\t      const row = readTurnFormRow(ctx.db, target.subjectKind, target.subjectId, target.form);\n352\t      if (row === undefined) {\n353\t        return {\n354\t          ok: false,\n355\t          error: {\n356\t            errorClass: \"caller_error\",\n357\t            code: \"turn_not_found\",\n358\t            reason: `no derived form ${target.form} exists for ${target.subjectKind} ${target.subjectId}`,\n359\t          },\n360\t        };\n361\t      }\n362\t      if (row.state === \"blocked\") {\n363\t        // The refusal carries the form's stored reason — the damage named at\n364\t        // blocking time, not a generic string (AC-4.6).\n365\t        return {\n366\t          ok: false,\n367\t          error: {\n368\t            errorClass: \"state_corruption\",\n369\t            code: \"source_damaged\",\n370\t            reason:\n371\t              row.reason ??\n372\t              `form ${target.form} for ${target.subjectKind} ${target.subjectId} is blocked`,\n373\t          },\n374\t        };\n375\t      }\n376\t      if (hasLiveItem(ctx.db, mapped.kind, mapped.sourceRef, row.sourceVersion)) {\n377\t        return { ok: true, value: { noop: \"already_queued\" } };\n378\t      }\n379\t      const item = enqueue(ctx, {\n380\t        owner: \"turns\",\n381\t        kind: mapped.kind,\n382\t        sourceRef: mapped.sourceRef,\n383\t        sourceVersion: row.sourceVersion + 1,\n384\t        forms: mapped.forms,\n385\t      });\n386\t      return { ok: true, value: { workItemId: item.workItemId } };\n387\t    });\n388\t  } catch (cause) {\n389\t    const reason = cause instanceof Error ? cause.message : String(cause);\n390\t    return storageFailure(`requeue failed: ${reason}`);\n391\t  } finally {\n392\t    db.close();\n393\t  }\n394\t}\n395\t"}]},"parent_tool_use_id":null,"session_id":"91a5247d-d939-443d-a5c4-7c2ee5826722","uuid":"5c04e525-ad1c-4d7e-ab1a-175f7612d2c1","timestamp":"2026-06-11T06:40:43.958Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/index.ts","content":"import { existsSync } from \"node:fs\";\nimport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\nimport type {\n  FormKind,\n  FormReportEntry,\n  WorkHandler,\n} from \"../../shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  enqueue,\n  hasLiveItem,\n  listItems,\n  type EnqueueFormTarget,\n  type WorkItemRecord,\n  type WorkKind,\n  type WorkSourceRef,\n} from \"../../tech-utils/work-queue/index.js\";\nimport type { EventKind } from \"../intake-stream/index.js\";\nimport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\nimport { transition } from \"./internal/state-machine.js\";\n\n// The pure rule table, re-exported for the golden supplemental suite (the\n// test plan's one sanctioned direct entry besides the tokenizer); production\n// callers go through applyEvent.\nexport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\nimport type { DerivedForm } from \"../../shared/derivation.js\";\nimport { turnWorkHandlers } from \"./internal/derive.js\";\nimport {\n  readChunkRows,\n  readOwnedForms,\n  readTurnFormRow,\n  reportTurnForms,\n} from \"./internal/forms.js\";\nimport {\n  closeTurn,\n  insertOpenTurn,\n  nextTurnOrder,\n  readTurns,\n  selectOpenTurnIds,\n} from \"./internal/store.js\";\n\nexport interface TurnRecord {\n  turnId: string;\n  status: \"open\" | \"closed\";\n  memberMessageIds: string[];\n  openedAtEventOrder: number;\n  closedAtEventOrder?: number;\n  // Chunk placement (Epic 02 Story 3, AC-3.5): present once the turn's\n  // derivation placed it — stored values read back, never recomputed.\n  chunkId?: string;\n  memberIdx?: number;\n  // The turn's derived forms as stored (Epic 02 Story 4, AC-4.7 ruling 012):\n  // present only when rows exist — a closed turn carries them from the\n  // moment its derivation queues. Stored state returned verbatim, mirroring\n  // the message read's forms key; reads degrade, never block.\n  forms?: DerivedForm[];\n}\n\n// Chunk read-back (Epic 02 Story 4, AC-4.7 ruling 012): the stored chunk\n// record with live membership and its summary forms' states attached —\n// the chunk leg of \"reading a message, turn, or chunk returns the record\n// with form states\".\nexport interface ChunkRecord {\n  chunkId: string;\n  chunkOrder: number;\n  status: \"open\" | \"closed\";\n  accumulatedProjectedTokens: number;\n  memberTurnIds: string[];\n  forms?: DerivedForm[];\n}\n\nexport interface TurnTransitionOutcome {\n  // Transitions in occurrence order: a close_then_open reports the close\n  // first, then the open, exactly as the batch result surfaces them.\n  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n  // Turn state after the transition — the stamp for this event's message.\n  // Prompts see the turn they just opened (transition first, then stamp);\n  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n  openTurnId: string | null;\n  // Work queued by this transition: one turn_derivation item per closed\n  // turn, by either close path (AC-3.6). Empty when nothing closed.\n  queuedWork: WorkItemRecord[];\n}\n\n// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n// IMMEDIATE and before any event is processed. Only the batch pipeline\n// writes turn state, so more than one open turn means external interference.\nexport function listOpenTurnIds(ctx: OperationContext): string[] {\n  return selectOpenTurnIds(ctx.db);\n}\n\n// Closing a turn — by either close path — durably queues that turn's\n// derivation work in the same transaction (AC-3.6): the close update and the\n// work item commit or roll back together.\nfunction closeTurnAndQueueWork(\n  ctx: OperationContext,\n  turnId: string,\n  eventOrder: number,\n): WorkItemRecord {\n  closeTurn(ctx.db, turnId, eventOrder);\n  // One work item, two derived forms: the turn_derivation handler (Story 3)\n  // lands the rendering and the lower-band projection as independent rows;\n  // both go pending with the enqueue (DD-5).\n  return enqueue(ctx, {\n    owner: \"turns\",\n    kind: \"turn_derivation\",\n    sourceRef: { turnId },\n    forms: [\n      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n      { subjectKind: \"turn\", subjectId: turnId, form: \"lower_band_projection\" },\n    ],\n  });\n}\n\n// Turn-owned work handlers, merged into the SDK's dispatch map at\n// construction (DD-6): turn derivation and the two chunk summaries.\nexport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n  turnWorkHandlers;\n\n// Cross-domain surface, called by intake-stream inside the batch transaction\n// for every recorded event. Synchronous and throwing by design, like\n// messages.createFromEvent: a turn-storage failure rejects the whole batch.\nexport function applyEvent(\n  ctx: OperationContext,\n  eventKind: EventKind,\n  eventOrder: number,\n): TurnTransitionOutcome {\n  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n  const effect = transition({ openTurnId }, eventKind);\n  switch (effect.kind) {\n    case \"none\":\n      return { transitions: [], openTurnId, queuedWork: [] };\n    case \"open\": {\n      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n      return {\n        transitions: [{ action: \"opened\", turnId }],\n        openTurnId: turnId,\n        queuedWork: [],\n      };\n    }\n    case \"close\": {\n      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n      return {\n        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n        openTurnId: null,\n        queuedWork: [item],\n      };\n    }\n    case \"close_then_open\": {\n      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n      return {\n        transitions: [\n          { action: \"closed\", turnId: openTurnId as string },\n          { action: \"opened\", turnId },\n        ],\n        openTurnId: turnId,\n        queuedWork: [item],\n      };\n    }\n  }\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nexport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    // Form read-back rides the turn read (AC-4.7): each record carries its\n    // stored derived forms, attached from one grouped query — mirroring the\n    // message read's production path for \"readable alongside the record\".\n    const formsByTurn = readOwnedForms(db, \"turn\");\n    const records = readTurns(db).map((record) => {\n      const forms = formsByTurn.get(record.turnId);\n      return forms === undefined ? record : { ...record, forms };\n    });\n    return { ok: true, value: records };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`turn read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\n// Chunk read-back with summary-form states attached (AC-4.7 ruling 012):\n// returns stored records whatever the forms' states — reads degrade, never\n// block. Forms attach only where rows exist (a freshly opened chunk has no\n// summary rows until close queues them).\nexport async function listChunks(thread: ThreadRef): Promise<OpResult<ChunkRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const formsByChunk = readOwnedForms(db, \"chunk\");\n    const records: ChunkRecord[] = readChunkRows(db).map((row) => {\n      const forms = formsByChunk.get(row.chunkId);\n      return forms === undefined ? row : { ...row, forms };\n    });\n    return { ok: true, value: records };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`chunk read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport async function listQueuedWork(\n  thread: ThreadRef,\n): Promise<OpResult<WorkItemRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: listItems(db, \"turns\") };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`queued-work read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n\n// This owner's repair report: every turn- and chunk-owned form's durable\n// state joined with live queue detail in one query. Needs no provider;\n// reads degrade, never block.\nexport async function report(\n  thread: ThreadRef,\n  opts?: { notReady?: boolean; turnId?: string; chunkId?: string },\n): Promise<OpResult<FormReportEntry[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: reportTurnForms(db, opts ?? {}) };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`report read failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n\n// The queue site each turn-owned form rebuilds through. Both turn forms ride\n// the one turn_derivation item (the handler lands rendering and projection\n// together, so a rebuild of either re-derives both — the rebuild rule from\n// Flow 3); each chunk summary rides its same-named kind alone (AC-3.8's\n// independent lifecycles).\nfunction turnRequeueTarget(target: {\n  subjectKind: \"turn\" | \"chunk\";\n  subjectId: string;\n  form: FormKind;\n}): { kind: WorkKind; sourceRef: WorkSourceRef; forms: EnqueueFormTarget[] } | undefined {\n  if (\n    target.subjectKind === \"turn\" &&\n    (target.form === \"turn_rendering\" || target.form === \"lower_band_projection\")\n  ) {\n    return {\n      kind: \"turn_derivation\",\n      sourceRef: { turnId: target.subjectId },\n      forms: [\n        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"turn_rendering\" },\n        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"lower_band_projection\" },\n      ],\n    };\n  }\n  if (\n    target.subjectKind === \"chunk\" &&\n    (target.form === \"chunk_summary_detailed\" || target.form === \"chunk_summary_brief\")\n  ) {\n    return {\n      kind: target.form,\n      sourceRef: { chunkId: target.subjectId },\n      forms: [{ subjectKind: \"chunk\", subjectId: target.subjectId, form: target.form }],\n    };\n  }\n  return undefined;\n}\n\n// Explicit re-queue through the owning surface (AC-4.4): same contract as\n// messages.requeue — blocked refused with the stored damage reason, missing\n// rows refused, no-op against live work at the current source version, and\n// the no-op check + enqueue in one transaction. A successful requeue rebuilds\n// at the next source version: composed forms recompute their gaps from\n// current dependency states (Flow 3's rebuild rule).\nexport async function requeue(\n  thread: ThreadRef,\n  target: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: FormKind },\n): Promise<OpResult<RequeueOutcome>> {\n  const mapped = turnRequeueTarget(target);\n  if (mapped === undefined) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"caller_error\",\n        code: \"turn_not_found\",\n        reason: `form ${target.form} is not a ${target.subjectKind}-owned form; turns.requeue repairs turn_rendering and lower_band_projection (turn) or chunk_summary_detailed and chunk_summary_brief (chunk)`,\n      },\n    };\n  }\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const meta = db\n      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n      .get() as { thread_id: string } | undefined;\n    const threadId = meta?.thread_id ?? \"\";\n    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n      const row = readTurnFormRow(ctx.db, target.subjectKind, target.subjectId, target.form);\n      if (row === undefined) {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"turn_not_found\",\n            reason: `no derived form ${target.form} exists for ${target.subjectKind} ${target.subjectId}`,\n          },\n        };\n      }\n      if (row.state === \"blocked\") {\n        // The refusal carries the form's stored reason — the damage named at\n        // blocking time, not a generic string (AC-4.6).\n        return {\n          ok: false,\n          error: {\n            errorClass: \"state_corruption\",\n            code: \"source_damaged\",\n            reason:\n              row.reason ??\n              `form ${target.form} for ${target.subjectKind} ${target.subjectId} is blocked`,\n          },\n        };\n      }\n      if (hasLiveItem(ctx.db, mapped.kind, mapped.sourceRef, row.sourceVersion)) {\n        return { ok: true, value: { noop: \"already_queued\" } };\n      }\n      const item = enqueue(ctx, {\n        owner: \"turns\",\n        kind: mapped.kind,\n        sourceRef: mapped.sourceRef,\n        sourceVersion: row.sourceVersion + 1,\n        forms: mapped.forms,\n      });\n      return { ok: true, value: { workItemId: item.workItemId } };\n    });\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`requeue failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":395,"startLine":1,"totalLines":395}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019zYHr5m8KjbSzJ3SHW1XdQ","type":"tool_result","content":"1\t// The mutation cascade (DD-8, Flows 5/6): walk the derivation chain upward\n2\t// from the mutated subject — the message's own forms, its turn's rendering\n3\t// and projection, the containing chunk's two summaries — clearing each to\n4\t// `pending` at the next source version and enqueueing replacement work, all\n5\t// inside the caller's mutation transaction. The clear-set is derived from\n6\t// the record's structure (the message → turn → chunk walk over the rows that\n7\t// actually exist), never from a hardcoded form list: a future form on any\n8\t// subject in the chain cascades without this module changing. Still-queued\n9\t// old-version items are supersede-deleted (tech design issue 1) and reported\n10\t// on the MutationResult; claimed items are deliberately left to the\n11\t// source-version check (DD-3) — their stale completions discard. Two close\n12\t// paths share this walk by design: edit re-queues the subject's own forms,\n13\t// delete (Story 6) drops them and starts the clear at the turn level.\n14\timport type { DatabaseSync } from \"node:sqlite\";\n15\timport type { OperationContext } from \"../../../shared/context.js\";\n16\timport type { FormKind, SubjectKind } from \"../../../shared/derivation.js\";\n17\timport {\n18\t  enqueue,\n19\t  supersedeQueued,\n20\t  WORK_KIND_REGISTRY,\n21\t  type EnqueueFormTarget,\n22\t  type WorkKind,\n23\t  type WorkSourceRef,\n24\t} from \"../../../tech-utils/work-queue/index.js\";\n25\t\n26\t// Each form's rebuild queue-site — the owning domains' enqueue mappings,\n27\t// gathered here because the cascade is the one place that re-queues across\n28\t// the whole chain (module responsibility matrix: replacement enqueues for\n29\t// all three mutations live with the cascade). Both turn forms ride the one\n30\t// turn_derivation item; every other form rides its same-named kind.\n31\tconst FORM_REBUILD_KINDS: Record<FormKind, WorkKind> = {\n32\t  smoothed_prompt: \"prompt_smoothing\",\n33\t  tool_call_summary: \"tool_call_summary\",\n34\t  tool_result_summary: \"tool_result_summary\",\n35\t  turn_rendering: \"turn_derivation\",\n36\t  lower_band_projection: \"turn_derivation\",\n37\t  chunk_summary_detailed: \"chunk_summary_detailed\",\n38\t  chunk_summary_brief: \"chunk_summary_brief\",\n39\t};\n40\t\n41\texport interface CascadeClear {\n42\t  subjectKind: SubjectKind;\n43\t  subjectId: string;\n44\t  form: FormKind;\n45\t}\n46\t\n47\texport interface CascadeOutcome {\n48\t  cleared: CascadeClear[];\n49\t  queued: Array<{ workItemId: string; kind: WorkKind }>;\n50\t  superseded: string[];\n51\t}\n52\t\n53\tinterface ChainSubject {\n54\t  subjectKind: SubjectKind;\n55\t  subjectId: string;\n56\t}\n57\t\n58\tfunction sourceRefFor(subject: ChainSubject): WorkSourceRef {\n59\t  switch (subject.subjectKind) {\n60\t    case \"message\":\n61\t      return { messageId: subject.subjectId };\n62\t    case \"turn\":\n63\t      return { turnId: subject.subjectId };\n64\t    case \"chunk\":\n65\t      return { chunkId: subject.subjectId };\n66\t  }\n67\t}\n68\t\n69\t// The structural walk: the edited message's turn from its membership stamp,\n70\t// the turn's chunk from its placement row. Either link may be absent — a gap\n71\t// message has no turn, an unplaced turn no chunk — and the chain simply\n72\t// stops there; reach is structural, not configured.\n73\tfunction chainSubjects(db: DatabaseSync, messageId: string): ChainSubject[] {\n74\t  const subjects: ChainSubject[] = [{ subjectKind: \"message\", subjectId: messageId }];\n75\t  const turnRow = db\n76\t    .prepare(`SELECT turn_id FROM message WHERE message_id = ?`)\n77\t    .get(messageId) as unknown as { turn_id: string | null } | undefined;\n78\t  const turnId = turnRow?.turn_id ?? null;\n79\t  if (turnId === null) return subjects;\n80\t  subjects.push({ subjectKind: \"turn\", subjectId: turnId });\n81\t  const chunkRow = db\n82\t    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n83\t    .get(turnId) as unknown as { chunk_id: string } | undefined;\n84\t  if (chunkRow !== undefined) {\n85\t    subjects.push({ subjectKind: \"chunk\", subjectId: chunkRow.chunk_id });\n86\t  }\n87\t  return subjects;\n88\t}\n89\t\n90\tinterface RebuildGroup {\n91\t  subject: ChainSubject;\n92\t  kind: WorkKind;\n93\t  forms: EnqueueFormTarget[];\n94\t  maxSourceVersion: number;\n95\t}\n96\t\n97\t// Clear-and-requeue for the full chain above (and including) the edited\n98\t// message. Runs inside the mutation's ambient transaction: the enqueue's\n99\t// pending upsert is the clear (state pending, content/reason/gaps/metadata\n100\t// reset, source version bumped past every version seen in the group), the\n101\t// work row and the commit poke ride the same transaction, and the supersede\n102\t// delete lands before the replacements so a tidied id can never collide.\n103\texport function cascadeFromMessage(\n104\t  ctx: OperationContext,\n105\t  messageId: string,\n106\t): CascadeOutcome {\n107\t  const subjects = chainSubjects(ctx.db, messageId);\n108\t  const cleared: CascadeClear[] = [];\n109\t  const groups = new Map<string, RebuildGroup>();\n110\t  const readForms = ctx.db.prepare(\n111\t    `SELECT form, source_version FROM derived_form\n112\t     WHERE subject_kind = ? AND subject_id = ? ORDER BY form`,\n113\t  );\n114\t  for (const subject of subjects) {\n115\t    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n116\t      form: string;\n117\t      source_version: number | bigint;\n118\t    }>;\n119\t    for (const row of rows) {\n120\t      const form = row.form as FormKind;\n121\t      cleared.push({ ...subject, form });\n122\t      const kind = FORM_REBUILD_KINDS[form];\n123\t      if (kind === undefined) {\n124\t        // Every form names its queue site above; a miss is a wiring bug.\n125\t        throw new Error(`no rebuild work kind mapped for derived form ${row.form}`);\n126\t      }\n127\t      const key = `${subject.subjectKind}:${subject.subjectId}:${kind}`;\n128\t      const group = groups.get(key) ?? {\n129\t        subject,\n130\t        kind,\n131\t        forms: [],\n132\t        maxSourceVersion: 0,\n133\t      };\n134\t      group.forms.push({ subjectKind: subject.subjectKind, subjectId: subject.subjectId, form });\n135\t      group.maxSourceVersion = Math.max(group.maxSourceVersion, Number(row.source_version));\n136\t      groups.set(key, group);\n137\t    }\n138\t  }\n139\t\n140\t  const superseded = supersedeQueued(\n141\t    ctx.db,\n142\t    [...groups.values()].map((group) => ({\n143\t      kind: group.kind,\n144\t      sourceRef: sourceRefFor(group.subject),\n145\t    })),\n146\t  );\n147\t\n148\t  const queued = [...groups.values()].map((group) => {\n149\t    const item = enqueue(ctx, {\n150\t      owner: WORK_KIND_REGISTRY[group.kind].owner,\n151\t      kind: group.kind,\n152\t      sourceRef: sourceRefFor(group.subject),\n153\t      sourceVersion: group.maxSourceVersion + 1,\n154\t      forms: group.forms,\n155\t    });\n156\t    return { workItemId: item.workItemId, kind: group.kind };\n157\t  });\n158\t\n159\t  return { cleared, queued, superseded };\n160\t}\n161\t"}]},"parent_tool_use_id":null,"session_id":"91a5247d-d939-443d-a5c4-7c2ee5826722","uuid":"62092dc5-1e4c-49db-af80-b26fb7318828","timestamp":"2026-06-11T06:40:39.871Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/cascade.ts","content":"// The mutation cascade (DD-8, Flows 5/6): walk the derivation chain upward\n// from the mutated subject — the message's own forms, its turn's rendering\n// and projection, the containing chunk's two summaries — clearing each to\n// `pending` at the next source version and enqueueing replacement work, all\n// inside the caller's mutation transaction. The clear-set is derived from\n// the record's structure (the message → turn → chunk walk over the rows that\n// actually exist), never from a hardcoded form list: a future form on any\n// subject in the chain cascades without this module changing. Still-queued\n// old-version items are supersede-deleted (tech design issue 1) and reported\n// on the MutationResult; claimed items are deliberately left to the\n// source-version check (DD-3) — their stale completions discard. Two close\n// paths share this walk by design: edit re-queues the subject's own forms,\n// delete (Story 6) drops them and starts the clear at the turn level.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { OperationContext } from \"../../../shared/context.js\";\nimport type { FormKind, SubjectKind } from \"../../../shared/derivation.js\";\nimport {\n  enqueue,\n  supersedeQueued,\n  WORK_KIND_REGISTRY,\n  type EnqueueFormTarget,\n  type WorkKind,\n  type WorkSourceRef,\n} from \"../../../tech-utils/work-queue/index.js\";\n\n// Each form's rebuild queue-site — the owning domains' enqueue mappings,\n// gathered here because the cascade is the one place that re-queues across\n// the whole chain (module responsibility matrix: replacement enqueues for\n// all three mutations live with the cascade). Both turn forms ride the one\n// turn_derivation item; every other form rides its same-named kind.\nconst FORM_REBUILD_KINDS: Record<FormKind, WorkKind> = {\n  smoothed_prompt: \"prompt_smoothing\",\n  tool_call_summary: \"tool_call_summary\",\n  tool_result_summary: \"tool_result_summary\",\n  turn_rendering: \"turn_derivation\",\n  lower_band_projection: \"turn_derivation\",\n  chunk_summary_detailed: \"chunk_summary_detailed\",\n  chunk_summary_brief: \"chunk_summary_brief\",\n};\n\nexport interface CascadeClear {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n}\n\nexport interface CascadeOutcome {\n  cleared: CascadeClear[];\n  queued: Array<{ workItemId: string; kind: WorkKind }>;\n  superseded: string[];\n}\n\ninterface ChainSubject {\n  subjectKind: SubjectKind;\n  subjectId: string;\n}\n\nfunction sourceRefFor(subject: ChainSubject): WorkSourceRef {\n  switch (subject.subjectKind) {\n    case \"message\":\n      return { messageId: subject.subjectId };\n    case \"turn\":\n      return { turnId: subject.subjectId };\n    case \"chunk\":\n      return { chunkId: subject.subjectId };\n  }\n}\n\n// The structural walk: the edited message's turn from its membership stamp,\n// the turn's chunk from its placement row. Either link may be absent — a gap\n// message has no turn, an unplaced turn no chunk — and the chain simply\n// stops there; reach is structural, not configured.\nfunction chainSubjects(db: DatabaseSync, messageId: string): ChainSubject[] {\n  const subjects: ChainSubject[] = [{ subjectKind: \"message\", subjectId: messageId }];\n  const turnRow = db\n    .prepare(`SELECT turn_id FROM message WHERE message_id = ?`)\n    .get(messageId) as unknown as { turn_id: string | null } | undefined;\n  const turnId = turnRow?.turn_id ?? null;\n  if (turnId === null) return subjects;\n  subjects.push({ subjectKind: \"turn\", subjectId: turnId });\n  const chunkRow = db\n    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n    .get(turnId) as unknown as { chunk_id: string } | undefined;\n  if (chunkRow !== undefined) {\n    subjects.push({ subjectKind: \"chunk\", subjectId: chunkRow.chunk_id });\n  }\n  return subjects;\n}\n\ninterface RebuildGroup {\n  subject: ChainSubject;\n  kind: WorkKind;\n  forms: EnqueueFormTarget[];\n  maxSourceVersion: number;\n}\n\n// Clear-and-requeue for the full chain above (and including) the edited\n// message. Runs inside the mutation's ambient transaction: the enqueue's\n// pending upsert is the clear (state pending, content/reason/gaps/metadata\n// reset, source version bumped past every version seen in the group), the\n// work row and the commit poke ride the same transaction, and the supersede\n// delete lands before the replacements so a tidied id can never collide.\nexport function cascadeFromMessage(\n  ctx: OperationContext,\n  messageId: string,\n): CascadeOutcome {\n  const subjects = chainSubjects(ctx.db, messageId);\n  const cleared: CascadeClear[] = [];\n  const groups = new Map<string, RebuildGroup>();\n  const readForms = ctx.db.prepare(\n    `SELECT form, source_version FROM derived_form\n     WHERE subject_kind = ? AND subject_id = ? ORDER BY form`,\n  );\n  for (const subject of subjects) {\n    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n      form: string;\n      source_version: number | bigint;\n    }>;\n    for (const row of rows) {\n      const form = row.form as FormKind;\n      cleared.push({ ...subject, form });\n      const kind = FORM_REBUILD_KINDS[form];\n      if (kind === undefined) {\n        // Every form names its queue site above; a miss is a wiring bug.\n        throw new Error(`no rebuild work kind mapped for derived form ${row.form}`);\n      }\n      const key = `${subject.subjectKind}:${subject.subjectId}:${kind}`;\n      const group = groups.get(key) ?? {\n        subject,\n        kind,\n        forms: [],\n        maxSourceVersion: 0,\n      };\n      group.forms.push({ subjectKind: subject.subjectKind, subjectId: subject.subjectId, form });\n      group.maxSourceVersion = Math.max(group.maxSourceVersion, Number(row.source_version));\n      groups.set(key, group);\n    }\n  }\n\n  const superseded = supersedeQueued(\n    ctx.db,\n    [...groups.values()].map((group) => ({\n      kind: group.kind,\n      sourceRef: sourceRefFor(group.subject),\n    })),\n  );\n\n  const queued = [...groups.values()].map((group) => {\n    const item = enqueue(ctx, {\n      owner: WORK_KIND_REGISTRY[group.kind].owner,\n      kind: group.kind,\n      sourceRef: sourceRefFor(group.subject),\n      sourceVersion: group.maxSourceVersion + 1,\n      forms: group.forms,\n    });\n    return { workItemId: item.workItemId, kind: group.kind };\n  });\n\n  return { cleared, queued, superseded };\n}\n","numLines":161,"startLine":1,"totalLines":161}}}

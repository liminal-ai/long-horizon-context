{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XVZ9gBxPLqfHHZYjb1AsLm","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n3\timport type { FormKind, FormReportEntry, WorkHandler } from \"../../shared/derivation.js\";\n4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n5\timport {\n6\t  enqueue,\n7\t  hasLiveItem,\n8\t  listItems,\n9\t  type WorkItemRecord,\n10\t  type WorkKind,\n11\t} from \"../../tech-utils/work-queue/index.js\";\n12\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n13\timport {\n14\t  openThreadDatabase,\n15\t  resolveThreadRef,\n16\t  type ThreadRef,\n17\t} from \"../threads/index.js\";\n18\timport type { DerivedForm } from \"../../shared/derivation.js\";\n19\timport {\n20\t  findUnknownOutcomeCallSummary,\n21\t  readMessageFormRow,\n22\t  readMessageForms,\n23\t  reportMessageForms,\n24\t} from \"./internal/forms.js\";\n25\timport { messageWorkHandlers } from \"./internal/handlers.js\";\n26\timport { projectEvent } from \"./internal/project.js\";\n27\timport { cascadeFromMessage, type CascadeClear } from \"./internal/cascade.js\";\n28\timport {\n29\t  applyMessageEdit,\n30\t  insertMessage,\n31\t  readMessages,\n32\t  readMutableMessage,\n33\t} from \"./internal/store.js\";\n34\t\n35\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n36\t\n37\texport interface Block {\n38\t  blockType: BlockType;\n39\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n40\t}\n41\t\n42\texport interface MessageRecord {\n43\t  messageId: string;\n44\t  sourceEventOrder: number;\n45\t  kind: Exclude<EventKind, \"turn_end\">;\n46\t  blocks: Block[];\n47\t  tokenEstimate: number;\n48\t  actor: string;\n49\t  harness: string;\n50\t  turnId?: string;\n51\t  // The message's derived forms as stored (Epic 02 Story 2): present only\n52\t  // for messages that are derivation sources — kinds with no derivable form\n53\t  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n54\t  // never re-derived on read.\n55\t  forms?: DerivedForm[];\n56\t}\n57\t\n58\t// The event as the walk holds it after recording: the validated input plus\n59\t// its server-stamped order and timestamp.\n60\texport type RecordedEvent = EventRecord;\n61\t\n62\texport type MessageCreated = {\n63\t  messageId: string;\n64\t  kind: Exclude<EventKind, \"turn_end\">;\n65\t  // Carried for tool activity only: the pairing key the queue sites need —\n66\t  // tool_result projection runs the AC-2.8 late-result lookup against it.\n67\t  toolCallId?: string;\n68\t} | null;\n69\t\n70\t// Cross-domain surface, called by intake-stream inside the batch transaction\n71\t// (the first such call through the operation context; turns.applyEvent\n72\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n73\t// projection failure propagates to the pipeline's catch and rejects the\n74\t// whole batch — recorded events without messages is the stranded state the\n75\t// transaction exists to prevent. Returns null for turn_end (no message).\n76\t// turnId is the membership stamp, settled by the pipeline before this call:\n77\t// the turn open *after* this event's transition (so a prompt belongs to the\n78\t// turn it just opened), or null in a gap — written once, never updated.\n79\texport function createFromEvent(\n80\t  ctx: OperationContext,\n81\t  event: RecordedEvent,\n82\t  turnId: string | null,\n83\t): MessageCreated {\n84\t  const projected = projectEvent(event);\n85\t  if (projected === null) return null;\n86\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n87\t  const messageId = `m${event.eventOrder}`;\n88\t  insertMessage(ctx.db, {\n89\t    messageId,\n90\t    sourceEventOrder: event.eventOrder,\n91\t    kind,\n92\t    tokenEstimate: projected.tokenEstimate,\n93\t    actor: event.actor,\n94\t    harness: event.harness,\n95\t    turnId,\n96\t    blocks: projected.blocks,\n97\t  });\n98\t  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n99\t    return { messageId, kind, toolCallId: event.payload.toolCallId };\n100\t  }\n101\t  return { messageId, kind };\n102\t}\n103\t\n104\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n105\t// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n106\t// tool result queues tool_result_summary, nothing else queues anything —\n107\t// text, thinking, and note messages are not derivation sources (Epic 01\n108\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n109\t// intake-stream inside the batch transaction for every recorded message, so\n110\t// the item commits (or rolls back) with the batch.\n111\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n112\t  user_prompt: \"prompt_smoothing\",\n113\t  tool_call: \"tool_call_summary\",\n114\t  tool_result: \"tool_result_summary\",\n115\t};\n116\t\n117\t// Which derived form each message-owned kind produces — the owning domain's\n118\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n119\t// rides the same transaction (DD-5).\n120\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n121\t  prompt_smoothing: \"smoothed_prompt\",\n122\t  tool_call_summary: \"tool_call_summary\",\n123\t  tool_result_summary: \"tool_result_summary\",\n124\t};\n125\t\n126\t// Message-owned work handlers, merged into the SDK's dispatch map at\n127\t// construction (DD-6): prompt smoothing and the two tool-activity summaries.\n128\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n129\t  messageWorkHandlers;\n130\t\n131\texport function queueMessageWork(\n132\t  ctx: OperationContext,\n133\t  message: MessageCreated,\n134\t): WorkItemRecord[] {\n135\t  if (message === null) return [];\n136\t  const items: WorkItemRecord[] = [];\n137\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n138\t  if (kind !== undefined) {\n139\t    const form = MESSAGE_WORK_FORMS[kind];\n140\t    if (form === undefined) {\n141\t      // Every queuing kind names its form above; a miss is a wiring bug.\n142\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n143\t    }\n144\t    items.push(\n145\t      enqueue(ctx, {\n146\t        owner: \"messages\",\n147\t        kind,\n148\t        sourceRef: { messageId: message.messageId },\n149\t        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n150\t      }),\n151\t    );\n152\t  }\n153\t  // Late-result repair (AC-2.8): a tool result landing after its call's\n154\t  // summary already derived with outcome \"unknown\" means the summary's\n155\t  // source — the call+result pair — completed underneath it; clear and\n156\t  // regenerate at the next source version, in this same batch transaction.\n157\t  // One indexed lookup; pending summaries (metadata NULL) never match, so\n158\t  // the common call-and-result-in-one-batch case never triggers, and the\n159\t  // version-scoped item id keeps the requeue idempotent.\n160\t  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n161\t    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n162\t    if (stale !== undefined) {\n163\t      items.push(\n164\t        enqueue(ctx, {\n165\t          owner: \"messages\",\n166\t          kind: \"tool_call_summary\",\n167\t          sourceRef: { messageId: stale.messageId },\n168\t          sourceVersion: stale.sourceVersion + 1,\n169\t          forms: [\n170\t            {\n171\t              subjectKind: \"message\",\n172\t              subjectId: stale.messageId,\n173\t              form: \"tool_call_summary\",\n174\t            },\n175\t          ],\n176\t        }),\n177\t      );\n178\t    }\n179\t  }\n180\t  return items;\n181\t}\n182\t\n183\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n184\t  return {\n185\t    ok: false,\n186\t    error: {\n187\t      errorClass: \"caller_error\",\n188\t      code: \"thread_not_found\",\n189\t      reason: `no thread file exists at ${filePath}`,\n190\t    },\n191\t  };\n192\t}\n193\t\n194\texport async function listMessages(\n195\t  thread: ThreadRef,\n196\t): Promise<OpResult<MessageRecord[]>> {\n197\t  const resolved = await resolveThreadRef(thread);\n198\t  if (!resolved.ok) return resolved;\n199\t  const { filePath } = resolved.value;\n200\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n201\t\n202\t  // openThreadDatabase verifies the file is a real thread file and migrates\n203\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n204\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n205\t  // unmutated (F-03-002).\n206\t  const opened = openThreadDatabase(filePath);\n207\t  if (!opened.ok) return opened;\n208\t  const db = opened.value;\n209\t  try {\n210\t    // Form read-back rides the message read (AC-2.1): each record carries\n211\t    // its stored derived forms, attached from one grouped query — the\n212\t    // production path for \"readable alongside the message\".\n213\t    const formsByMessage = readMessageForms(db);\n214\t    const records = readMessages(db).map((record) => {\n215\t      const forms = formsByMessage.get(record.messageId);\n216\t      return forms === undefined ? record : { ...record, forms };\n217\t    });\n218\t    return { ok: true, value: records };\n219\t  } catch (cause) {\n220\t    const reason = cause instanceof Error ? cause.message : String(cause);\n221\t    return storageFailure(`message read-back failed: ${reason}`);\n222\t  } finally {\n223\t    db.close();\n224\t  }\n225\t}\n226\t\n227\texport async function listQueuedWork(\n228\t  thread: ThreadRef,\n229\t): Promise<OpResult<WorkItemRecord[]>> {\n230\t  const resolved = await resolveThreadRef(thread);\n231\t  if (!resolved.ok) return resolved;\n232\t  const { filePath } = resolved.value;\n233\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n234\t\n235\t  const opened = openThreadDatabase(filePath);\n236\t  if (!opened.ok) return opened;\n237\t  const db = opened.value;\n238\t  try {\n239\t    return { ok: true, value: listItems(db, \"messages\") };\n240\t  } catch (cause) {\n241\t    const reason = cause instanceof Error ? cause.message : String(cause);\n242\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n243\t  } finally {\n244\t    db.close();\n245\t  }\n246\t}\n247\t\n248\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n249\t\n250\t// This owner's repair report: every message-owned form's durable state\n251\t// joined with live queue detail in one query — the five operational\n252\t// situations (waiting, retrying, ready, failed, blocked) read from the rows\n253\t// without any queue API. Needs no provider; reads degrade, never block.\n254\texport async function report(\n255\t  thread: ThreadRef,\n256\t  opts?: { notReady?: boolean; messageId?: string },\n257\t): Promise<OpResult<FormReportEntry[]>> {\n258\t  const resolved = await resolveThreadRef(thread);\n259\t  if (!resolved.ok) return resolved;\n260\t  const { filePath } = resolved.value;\n261\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n262\t\n263\t  const opened = openThreadDatabase(filePath);\n264\t  if (!opened.ok) return opened;\n265\t  const db = opened.value;\n266\t  try {\n267\t    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\n268\t  } catch (cause) {\n269\t    const reason = cause instanceof Error ? cause.message : String(cause);\n270\t    return storageFailure(`report read failed: ${reason}`);\n271\t  } finally {\n272\t    db.close();\n273\t  }\n274\t}\n275\t\n276\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n277\t\n278\t// Which work kind rebuilds each message-owned form — MESSAGE_WORK_FORMS\n279\t// inverted; the requeue's join from the named form back to its queue site.\n280\tconst MESSAGE_FORM_KINDS: Partial<Record<FormKind, WorkKind>> = {\n281\t  smoothed_prompt: \"prompt_smoothing\",\n282\t  tool_call_summary: \"tool_call_summary\",\n283\t  tool_result_summary: \"tool_result_summary\",\n284\t};\n285\t\n286\t// Explicit re-queue through the owning surface (AC-4.4): the public,\n287\t// supported rebuild act. Refused for blocked forms with the form's stored\n288\t// damage reason (AC-4.6) and for missing rows; a no-op against work already\n289\t// queued or in flight at the form's current source version (AC-4.5).\n290\t// Otherwise the form clears to pending and re-enqueues at the next source\n291\t// version — the same enqueue path intake uses, poke-on-commit included, so\n292\t// background mode processes the repair with no further call. The no-op check\n293\t// and the enqueue commit in one transaction (anti-shim: a split would\n294\t// reintroduce the duplicate-work race).\n295\texport async function requeue(\n296\t  thread: ThreadRef,\n297\t  target: { messageId: string; form: FormKind },\n298\t): Promise<OpResult<RequeueOutcome>> {\n299\t  const kind = MESSAGE_FORM_KINDS[target.form];\n300\t  if (kind === undefined) {\n301\t    return {\n302\t      ok: false,\n303\t      error: {\n304\t        errorClass: \"caller_error\",\n305\t        code: \"message_not_found\",\n306\t        reason: `form ${target.form} is not message-owned; messages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\n307\t      },\n308\t    };\n309\t  }\n310\t  const resolved = await resolveThreadRef(thread);\n311\t  if (!resolved.ok) return resolved;\n312\t  const { filePath } = resolved.value;\n313\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n314\t\n315\t  const opened = openThreadDatabase(filePath);\n316\t  if (!opened.ok) return opened;\n317\t  const db = opened.value;\n318\t  try {\n319\t    const meta = db\n320\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n321\t      .get() as { thread_id: string } | undefined;\n322\t    const threadId = meta?.thread_id ?? \"\";\n323\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n324\t      const row = readMessageFormRow(ctx.db, target.messageId, target.form);\n325\t      if (row === undefined) {\n326\t        return {\n327\t          ok: false,\n328\t          error: {\n329\t            errorClass: \"caller_error\",\n330\t            code: \"message_not_found\",\n331\t            reason: `no derived form ${target.form} exists for message ${target.messageId}`,\n332\t          },\n333\t        };\n334\t      }\n335\t      if (row.state === \"blocked\") {\n336\t        // The refusal carries the form's stored reason — the damage named at\n337\t        // blocking time, not a generic string (AC-4.6).\n338\t        return {\n339\t          ok: false,\n340\t          error: {\n341\t            errorClass: \"state_corruption\",\n342\t            code: \"source_damaged\",\n343\t            reason: row.reason ?? `form ${target.form} for message ${target.messageId} is blocked`,\n344\t          },\n345\t        };\n346\t      }\n347\t      const sourceRef = { messageId: target.messageId };\n348\t      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\n349\t        return { ok: true, value: { noop: \"already_queued\" } };\n350\t      }\n351\t      const item = enqueue(ctx, {\n352\t        owner: \"messages\",\n353\t        kind,\n354\t        sourceRef,\n355\t        sourceVersion: row.sourceVersion + 1,\n356\t        forms: [{ subjectKind: \"message\", subjectId: target.messageId, form: target.form }],\n357\t      });\n358\t      return { ok: true, value: { workItemId: item.workItemId } };\n359\t    });\n360\t  } catch (cause) {\n361\t    const reason = cause instanceof Error ? cause.message : String(cause);\n362\t    return storageFailure(`requeue failed: ${reason}`);\n363\t  } finally {\n364\t    db.close();\n365\t  }\n366\t}\n367\t\n368\t// ── mutations (Epic 02 Story 5, Flow 5) ──────────────────────────\n369\t\n370\t// The mutation result contract (tech design §Interfaces): what changed in\n371\t// the record, which dependent forms cleared, which dropped (delete only),\n372\t// what replacement work queued, and which still-queued old items the cascade\n373\t// tidied away (issue 1). Shared by edit and the Story 6 deletes.\n374\texport interface MutationResult {\n375\t  changed: { messageIds: string[]; turnIds: string[] };\n376\t  cleared: CascadeClear[];\n377\t  dropped: CascadeClear[];\n378\t  queued: Array<{ workItemId: string; kind: WorkKind }>;\n379\t  superseded: string[];\n380\t}\n381\t\n382\t// The record's first sanctioned mutation (AC-5.1–5.5): change a closed-turn\n383\t// message's content and blocks, re-stamp the token estimate, and walk the\n384\t// full dependent chain — clear to pending, supersede queued old work,\n385\t// enqueue replacements at the next source version — in one transaction.\n386\t// Synchronous and local by contract: everything above commits before this\n387\t// returns; the re-queued rebuilds run through the normal drain (background\n388\t// mode needs no further call — the enqueue pokes ride the commit). Events\n389\t// are never touched (projection-level mutation, DD-12), and no generated\n390\t// thread-view is either — visibility arrives at the next compact/rebuild.\n391\t// Refusals read through the deleted-filtered view and enforce the closed-turn\n392\t// target boundary: only a message in a closed turn is editable, so an\n393\t// open-turn *or* a turnless (no-membership) gap target is refused turn_open —\n394\t// the boundary's one stable code — a missing or deleted message is\n395\t// message_not_found, and a refusal changes nothing.\n396\texport async function edit(\n397\t  thread: ThreadRef,\n398\t  input: { messageId: string; content: string },\n399\t): Promise<OpResult<MutationResult>> {\n400\t  const resolved = await resolveThreadRef(thread);\n401\t  if (!resolved.ok) return resolved;\n402\t  const { filePath } = resolved.value;\n403\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n404\t\n405\t  const opened = openThreadDatabase(filePath);\n406\t  if (!opened.ok) return opened;\n407\t  const db = opened.value;\n408\t  try {\n409\t    const meta = db\n410\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n411\t      .get() as { thread_id: string } | undefined;\n412\t    const threadId = meta?.thread_id ?? \"\";\n413\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n414\t      const target = readMutableMessage(ctx.db, input.messageId);\n415\t      if (target === undefined) {\n416\t        return {\n417\t          ok: false,\n418\t          error: {\n419\t            errorClass: \"caller_error\",\n420\t            code: \"message_not_found\",\n421\t            reason: `no message ${input.messageId} exists in this thread`,\n422\t          },\n423\t        };\n424\t      }\n425\t      // The closed-turn target boundary (story scope; AC-5.1): the edit's\n426\t      // editable class is a message in a *closed* turn. Both failing cases —\n427\t      // an open turn and a turnless gap message (no membership) — refuse under\n428\t      // the one stable code; the reason distinguishes them so the open-turn\n429\t      // message reads exactly as before. A deleted/missing target never gets\n430\t      // here (it misses the filtered read above as message_not_found).\n431\t      if (target.turnStatus !== \"closed\") {\n432\t        return {\n433\t          ok: false,\n434\t          error: {\n435\t            errorClass: \"caller_error\",\n436\t            code: \"turn_open\",\n437\t            reason:\n438\t              target.turnStatus === \"open\"\n439\t                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \"\"}; open-turn messages cannot be edited (v1 boundary)`\n440\t                : `message ${input.messageId} has no turn membership; only closed-turn messages can be edited (v1 boundary)`,\n441\t          },\n442\t        };\n443\t      }\n444\t      applyMessageEdit(ctx.db, input.messageId, input.content);\n445\t      const cascade = cascadeFromMessage(ctx, input.messageId);\n446\t      return {\n447\t        ok: true,\n448\t        value: {\n449\t          changed: { messageIds: [input.messageId], turnIds: [] },\n450\t          cleared: cascade.cleared,\n451\t          dropped: [],\n452\t          queued: cascade.queued,\n453\t          superseded: cascade.superseded,\n454\t        },\n455\t      };\n456\t    });\n457\t  } catch (cause) {\n458\t    const reason = cause instanceof Error ? cause.message : String(cause);\n459\t    return storageFailure(`edit failed: ${reason}`);\n460\t  } finally {\n461\t    db.close();\n462\t  }\n463\t}\n464\t"}]},"parent_tool_use_id":null,"session_id":"91a5247d-d939-443d-a5c4-7c2ee5826722","uuid":"90faeafb-b775-4e81-bb92-d78884592a05","timestamp":"2026-06-11T06:40:40.369Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/index.ts","content":"import { existsSync } from \"node:fs\";\nimport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\nimport type { FormKind, FormReportEntry, WorkHandler } from \"../../shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  enqueue,\n  hasLiveItem,\n  listItems,\n  type WorkItemRecord,\n  type WorkKind,\n} from \"../../tech-utils/work-queue/index.js\";\nimport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\nimport {\n  openThreadDatabase,\n  resolveThreadRef,\n  type ThreadRef,\n} from \"../threads/index.js\";\nimport type { DerivedForm } from \"../../shared/derivation.js\";\nimport {\n  findUnknownOutcomeCallSummary,\n  readMessageFormRow,\n  readMessageForms,\n  reportMessageForms,\n} from \"./internal/forms.js\";\nimport { messageWorkHandlers } from \"./internal/handlers.js\";\nimport { projectEvent } from \"./internal/project.js\";\nimport { cascadeFromMessage, type CascadeClear } from \"./internal/cascade.js\";\nimport {\n  applyMessageEdit,\n  insertMessage,\n  readMessages,\n  readMutableMessage,\n} from \"./internal/store.js\";\n\nexport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n\nexport interface Block {\n  blockType: BlockType;\n  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n}\n\nexport interface MessageRecord {\n  messageId: string;\n  sourceEventOrder: number;\n  kind: Exclude<EventKind, \"turn_end\">;\n  blocks: Block[];\n  tokenEstimate: number;\n  actor: string;\n  harness: string;\n  turnId?: string;\n  // The message's derived forms as stored (Epic 02 Story 2): present only\n  // for messages that are derivation sources — kinds with no derivable form\n  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n  // never re-derived on read.\n  forms?: DerivedForm[];\n}\n\n// The event as the walk holds it after recording: the validated input plus\n// its server-stamped order and timestamp.\nexport type RecordedEvent = EventRecord;\n\nexport type MessageCreated = {\n  messageId: string;\n  kind: Exclude<EventKind, \"turn_end\">;\n  // Carried for tool activity only: the pairing key the queue sites need —\n  // tool_result projection runs the AC-2.8 late-result lookup against it.\n  toolCallId?: string;\n} | null;\n\n// Cross-domain surface, called by intake-stream inside the batch transaction\n// (the first such call through the operation context; turns.applyEvent\n// follows the pattern in Story 4). Synchronous and throwing by design: a\n// projection failure propagates to the pipeline's catch and rejects the\n// whole batch — recorded events without messages is the stranded state the\n// transaction exists to prevent. Returns null for turn_end (no message).\n// turnId is the membership stamp, settled by the pipeline before this call:\n// the turn open *after* this event's transition (so a prompt belongs to the\n// turn it just opened), or null in a gap — written once, never updated.\nexport function createFromEvent(\n  ctx: OperationContext,\n  event: RecordedEvent,\n  turnId: string | null,\n): MessageCreated {\n  const projected = projectEvent(event);\n  if (projected === null) return null;\n  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n  const messageId = `m${event.eventOrder}`;\n  insertMessage(ctx.db, {\n    messageId,\n    sourceEventOrder: event.eventOrder,\n    kind,\n    tokenEstimate: projected.tokenEstimate,\n    actor: event.actor,\n    harness: event.harness,\n    turnId,\n    blocks: projected.blocks,\n  });\n  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n    return { messageId, kind, toolCallId: event.payload.toolCallId };\n  }\n  return { messageId, kind };\n}\n\n// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n// tool result queues tool_result_summary, nothing else queues anything —\n// text, thinking, and note messages are not derivation sources (Epic 01\n// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n// intake-stream inside the batch transaction for every recorded message, so\n// the item commits (or rolls back) with the batch.\nconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n  user_prompt: \"prompt_smoothing\",\n  tool_call: \"tool_call_summary\",\n  tool_result: \"tool_result_summary\",\n};\n\n// Which derived form each message-owned kind produces — the owning domain's\n// knowledge, handed to the meaning-blind enqueue so the form's pending row\n// rides the same transaction (DD-5).\nconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n  prompt_smoothing: \"smoothed_prompt\",\n  tool_call_summary: \"tool_call_summary\",\n  tool_result_summary: \"tool_result_summary\",\n};\n\n// Message-owned work handlers, merged into the SDK's dispatch map at\n// construction (DD-6): prompt smoothing and the two tool-activity summaries.\nexport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n  messageWorkHandlers;\n\nexport function queueMessageWork(\n  ctx: OperationContext,\n  message: MessageCreated,\n): WorkItemRecord[] {\n  if (message === null) return [];\n  const items: WorkItemRecord[] = [];\n  const kind = MESSAGE_WORK_KINDS[message.kind];\n  if (kind !== undefined) {\n    const form = MESSAGE_WORK_FORMS[kind];\n    if (form === undefined) {\n      // Every queuing kind names its form above; a miss is a wiring bug.\n      throw new Error(`no derived form mapped for message work kind ${kind}`);\n    }\n    items.push(\n      enqueue(ctx, {\n        owner: \"messages\",\n        kind,\n        sourceRef: { messageId: message.messageId },\n        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n      }),\n    );\n  }\n  // Late-result repair (AC-2.8): a tool result landing after its call's\n  // summary already derived with outcome \"unknown\" means the summary's\n  // source — the call+result pair — completed underneath it; clear and\n  // regenerate at the next source version, in this same batch transaction.\n  // One indexed lookup; pending summaries (metadata NULL) never match, so\n  // the common call-and-result-in-one-batch case never triggers, and the\n  // version-scoped item id keeps the requeue idempotent.\n  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n    if (stale !== undefined) {\n      items.push(\n        enqueue(ctx, {\n          owner: \"messages\",\n          kind: \"tool_call_summary\",\n          sourceRef: { messageId: stale.messageId },\n          sourceVersion: stale.sourceVersion + 1,\n          forms: [\n            {\n              subjectKind: \"message\",\n              subjectId: stale.messageId,\n              form: \"tool_call_summary\",\n            },\n          ],\n        }),\n      );\n    }\n  }\n  return items;\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nexport async function listMessages(\n  thread: ThreadRef,\n): Promise<OpResult<MessageRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  // openThreadDatabase verifies the file is a real thread file and migrates\n  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n  // story lists cleanly (F-03-001) and a non-thread file is rejected\n  // unmutated (F-03-002).\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    // Form read-back rides the message read (AC-2.1): each record carries\n    // its stored derived forms, attached from one grouped query — the\n    // production path for \"readable alongside the message\".\n    const formsByMessage = readMessageForms(db);\n    const records = readMessages(db).map((record) => {\n      const forms = formsByMessage.get(record.messageId);\n      return forms === undefined ? record : { ...record, forms };\n    });\n    return { ok: true, value: records };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`message read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport async function listQueuedWork(\n  thread: ThreadRef,\n): Promise<OpResult<WorkItemRecord[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: listItems(db, \"messages\") };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`queued-work read-back failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n\n// This owner's repair report: every message-owned form's durable state\n// joined with live queue detail in one query — the five operational\n// situations (waiting, retrying, ready, failed, blocked) read from the rows\n// without any queue API. Needs no provider; reads degrade, never block.\nexport async function report(\n  thread: ThreadRef,\n  opts?: { notReady?: boolean; messageId?: string },\n): Promise<OpResult<FormReportEntry[]>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`report read failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\nexport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n\n// Which work kind rebuilds each message-owned form — MESSAGE_WORK_FORMS\n// inverted; the requeue's join from the named form back to its queue site.\nconst MESSAGE_FORM_KINDS: Partial<Record<FormKind, WorkKind>> = {\n  smoothed_prompt: \"prompt_smoothing\",\n  tool_call_summary: \"tool_call_summary\",\n  tool_result_summary: \"tool_result_summary\",\n};\n\n// Explicit re-queue through the owning surface (AC-4.4): the public,\n// supported rebuild act. Refused for blocked forms with the form's stored\n// damage reason (AC-4.6) and for missing rows; a no-op against work already\n// queued or in flight at the form's current source version (AC-4.5).\n// Otherwise the form clears to pending and re-enqueues at the next source\n// version — the same enqueue path intake uses, poke-on-commit included, so\n// background mode processes the repair with no further call. The no-op check\n// and the enqueue commit in one transaction (anti-shim: a split would\n// reintroduce the duplicate-work race).\nexport async function requeue(\n  thread: ThreadRef,\n  target: { messageId: string; form: FormKind },\n): Promise<OpResult<RequeueOutcome>> {\n  const kind = MESSAGE_FORM_KINDS[target.form];\n  if (kind === undefined) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"caller_error\",\n        code: \"message_not_found\",\n        reason: `form ${target.form} is not message-owned; messages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\n      },\n    };\n  }\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const meta = db\n      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n      .get() as { thread_id: string } | undefined;\n    const threadId = meta?.thread_id ?? \"\";\n    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n      const row = readMessageFormRow(ctx.db, target.messageId, target.form);\n      if (row === undefined) {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"message_not_found\",\n            reason: `no derived form ${target.form} exists for message ${target.messageId}`,\n          },\n        };\n      }\n      if (row.state === \"blocked\") {\n        // The refusal carries the form's stored reason — the damage named at\n        // blocking time, not a generic string (AC-4.6).\n        return {\n          ok: false,\n          error: {\n            errorClass: \"state_corruption\",\n            code: \"source_damaged\",\n            reason: row.reason ?? `form ${target.form} for message ${target.messageId} is blocked`,\n          },\n        };\n      }\n      const sourceRef = { messageId: target.messageId };\n      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\n        return { ok: true, value: { noop: \"already_queued\" } };\n      }\n      const item = enqueue(ctx, {\n        owner: \"messages\",\n        kind,\n        sourceRef,\n        sourceVersion: row.sourceVersion + 1,\n        forms: [{ subjectKind: \"message\", subjectId: target.messageId, form: target.form }],\n      });\n      return { ok: true, value: { workItemId: item.workItemId } };\n    });\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`requeue failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── mutations (Epic 02 Story 5, Flow 5) ──────────────────────────\n\n// The mutation result contract (tech design §Interfaces): what changed in\n// the record, which dependent forms cleared, which dropped (delete only),\n// what replacement work queued, and which still-queued old items the cascade\n// tidied away (issue 1). Shared by edit and the Story 6 deletes.\nexport interface MutationResult {\n  changed: { messageIds: string[]; turnIds: string[] };\n  cleared: CascadeClear[];\n  dropped: CascadeClear[];\n  queued: Array<{ workItemId: string; kind: WorkKind }>;\n  superseded: string[];\n}\n\n// The record's first sanctioned mutation (AC-5.1–5.5): change a closed-turn\n// message's content and blocks, re-stamp the token estimate, and walk the\n// full dependent chain — clear to pending, supersede queued old work,\n// enqueue replacements at the next source version — in one transaction.\n// Synchronous and local by contract: everything above commits before this\n// returns; the re-queued rebuilds run through the normal drain (background\n// mode needs no further call — the enqueue pokes ride the commit). Events\n// are never touched (projection-level mutation, DD-12), and no generated\n// thread-view is either — visibility arrives at the next compact/rebuild.\n// Refusals read through the deleted-filtered view and enforce the closed-turn\n// target boundary: only a message in a closed turn is editable, so an\n// open-turn *or* a turnless (no-membership) gap target is refused turn_open —\n// the boundary's one stable code — a missing or deleted message is\n// message_not_found, and a refusal changes nothing.\nexport async function edit(\n  thread: ThreadRef,\n  input: { messageId: string; content: string },\n): Promise<OpResult<MutationResult>> {\n  const resolved = await resolveThreadRef(thread);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const meta = db\n      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n      .get() as { thread_id: string } | undefined;\n    const threadId = meta?.thread_id ?? \"\";\n    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n      const target = readMutableMessage(ctx.db, input.messageId);\n      if (target === undefined) {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"message_not_found\",\n            reason: `no message ${input.messageId} exists in this thread`,\n          },\n        };\n      }\n      // The closed-turn target boundary (story scope; AC-5.1): the edit's\n      // editable class is a message in a *closed* turn. Both failing cases —\n      // an open turn and a turnless gap message (no membership) — refuse under\n      // the one stable code; the reason distinguishes them so the open-turn\n      // message reads exactly as before. A deleted/missing target never gets\n      // here (it misses the filtered read above as message_not_found).\n      if (target.turnStatus !== \"closed\") {\n        return {\n          ok: false,\n          error: {\n            errorClass: \"caller_error\",\n            code: \"turn_open\",\n            reason:\n              target.turnStatus === \"open\"\n                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \"\"}; open-turn messages cannot be edited (v1 boundary)`\n                : `message ${input.messageId} has no turn membership; only closed-turn messages can be edited (v1 boundary)`,\n          },\n        };\n      }\n      applyMessageEdit(ctx.db, input.messageId, input.content);\n      const cascade = cascadeFromMessage(ctx, input.messageId);\n      return {\n        ok: true,\n        value: {\n          changed: { messageIds: [input.messageId], turnIds: [] },\n          cleared: cascade.cleared,\n          dropped: [],\n          queued: cascade.queued,\n          superseded: cascade.superseded,\n        },\n      };\n    });\n  } catch (cause) {\n    const reason = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`edit failed: ${reason}`);\n  } finally {\n    db.close();\n  }\n}\n","numLines":464,"startLine":1,"totalLines":464}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01D9rSFYfvSCGiRvKFtEBGrf","type":"tool_result","content":"1\t// Durable work-item mechanics: recording, ordered listing, and the enqueue\n2\t// wrapper that makes \"queueing is what schedules processing\" structural\n3\t// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n4\t// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n5\t// a turn or a summary is; which kinds queue for which sources, and which\n6\t// derived forms a kind produces, is the owning domains' business (callers\n7\t// pass the form targets in). Writes run on the caller's handle inside the\n8\t// ambient transaction, so items commit (or roll back) with the batch. No\n9\t// public SDK surface: read-back reaches here only through the owning\n10\t// domains' listQueuedWork.\n11\timport type { DatabaseSync } from \"node:sqlite\";\n12\timport {\n13\t  createCommitHooks,\n14\t  fireSchedulerPoke,\n15\t  type OperationContext,\n16\t} from \"../../shared/context.js\";\n17\timport type {\n18\t  CompletionTx,\n19\t  FormKind,\n20\t  HandlerFormWrite,\n21\t  SubjectKind,\n22\t} from \"../../shared/derivation.js\";\n23\t\n24\texport type WorkOwner = \"messages\" | \"turns\";\n25\texport type WorkKind =\n26\t  | \"prompt_smoothing\"\n27\t  | \"tool_call_summary\"\n28\t  | \"tool_result_summary\"\n29\t  | \"turn_derivation\"\n30\t  | \"chunk_summary_detailed\"\n31\t  | \"chunk_summary_brief\";\n32\texport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n33\t\n34\t// The work-kind registry: owner and sourceRef semantics per the epic's Work\n35\t// Item contract. Mechanical metadata only — what a kind *means* stays with\n36\t// the owning domain's handler (registered at SDK construction, DD-6).\n37\texport const WORK_KIND_REGISTRY: Readonly<\n38\t  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n39\t> = {\n40\t  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n41\t  tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n42\t  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n43\t  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n44\t  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n45\t  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n46\t};\n47\t\n48\texport interface WorkItemRecord {\n49\t  workItemId: string;\n50\t  owner: WorkOwner;\n51\t  kind: WorkKind;\n52\t  sourceRef: WorkSourceRef;\n53\t  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n54\t  queuedAt: string;\n55\t}\n56\t\n57\t// The derived forms an enqueue is scheduling work toward; the owning domain\n58\t// names them (the util stays meaning-blind). Stored in the row's payload so\n59\t// the drain's terminal paths (retry exhaustion, blocked source) can land the\n60\t// form's failed/blocked state without asking any domain what a kind means.\n61\texport interface EnqueueFormTarget {\n62\t  subjectKind: SubjectKind;\n63\t  subjectId: string;\n64\t  form: FormKind;\n65\t}\n66\t\n67\texport interface WorkItemInput {\n68\t  owner: WorkOwner;\n69\t  kind: WorkKind;\n70\t  sourceRef: WorkSourceRef;\n71\t  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n72\t  forms?: readonly EnqueueFormTarget[]; // carried in payload for the drain's terminal paths\n73\t}\n74\t\n75\tfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n76\t  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n77\t  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n78\t  return sourceRef.chunkId;\n79\t}\n80\t\n81\t// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n82\t// same kind for the same source *at the same version* is the same id —\n83\t// natural idempotency for the repair path — while a post-mutation\n84\t// replacement (next version) never collides with an in-flight pre-mutation\n85\t// item.\n86\texport function recordItem(\n87\t  db: DatabaseSync,\n88\t  input: WorkItemInput,\n89\t  queuedAt: string,\n90\t): WorkItemRecord {\n91\t  const sourceVersion = input.sourceVersion ?? 1;\n92\t  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n93\t  db.prepare(\n94\t    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n95\t     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n96\t  ).run(\n97\t    workItemId,\n98\t    input.owner,\n99\t    input.kind,\n100\t    JSON.stringify(input.sourceRef),\n101\t    queuedAt,\n102\t    JSON.stringify({ sourceVersion, forms: input.forms ?? [] }),\n103\t  );\n104\t  return {\n105\t    workItemId,\n106\t    owner: input.owner,\n107\t    kind: input.kind,\n108\t    sourceRef: input.sourceRef,\n109\t    status: \"queued\",\n110\t    queuedAt,\n111\t  };\n112\t}\n113\t\n114\texport interface EnqueueInput extends WorkItemInput {\n115\t  forms: readonly EnqueueFormTarget[];\n116\t}\n117\t\n118\t// The one way work is scheduled (DD-5): the work row, the form's `pending`\n119\t// state row, and the scheduler poke all ride the ambient transaction — they\n120\t// commit together or vanish together. Enqueue is the *only* place a\n121\t// derived_form row is created (completion is UPDATE-only); re-enqueueing\n122\t// resets an existing row to pending at the enqueued source version.\n123\texport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n124\t  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n125\t  const sourceVersion = input.sourceVersion ?? 1;\n126\t  const upsert = ctx.db.prepare(\n127\t    `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n128\t     VALUES (?, ?, ?, 'pending', ?)\n129\t     ON CONFLICT (subject_kind, subject_id, form) DO UPDATE SET\n130\t       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n131\t       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n132\t  );\n133\t  for (const target of input.forms) {\n134\t    upsert.run(target.subjectKind, target.subjectId, target.form, sourceVersion);\n135\t  }\n136\t  ctx.onCommit(() => fireSchedulerPoke(ctx.threadId));\n137\t  return item;\n138\t}\n139\t\n140\tinterface RawWorkItemRow {\n141\t  work_item_id: string;\n142\t  owner: string;\n143\t  kind: string;\n144\t  source_ref: string;\n145\t  queued_at: string;\n146\t}\n147\t\n148\t// ── claim mechanics (Epic 02 Story 1, tech design §Mechanics) ─────\n149\t// All pure SQL against the caller's open handle, domain-blind. Claim,\n150\t// complete, and the terminal half of failAttempt each own one short\n151\t// BEGIN IMMEDIATE; the handler in between runs with no open transaction.\n152\t\n153\t// The claimed row as the drain holds it: mechanical fields plus the payload's\n154\t// source version and form targets. `kind` is a plain string here — a raw row\n155\t// with an unregistered kind must still be claimable so the drain can land it\n156\t// failed_terminal instead of skipping it (AC-1.8).\n157\texport interface ClaimedWorkItem {\n158\t  workItemId: string;\n159\t  owner: WorkOwner;\n160\t  kind: string;\n161\t  sourceRef: WorkSourceRef;\n162\t  attempts: number;\n163\t  queuedAt: string;\n164\t  sourceVersion: number;\n165\t  forms: EnqueueFormTarget[];\n166\t}\n167\t\n168\texport type ClaimOutcome =\n169\t  | { outcome: \"claimed\"; item: ClaimedWorkItem }\n170\t  | { outcome: \"empty\" }\n171\t  | { outcome: \"in_flight\"; claimExpiresAt: string }\n172\t  | { outcome: \"waiting\"; waitingUntil: string };\n173\t\n174\tinterface RawClaimRow {\n175\t  work_item_id: string;\n176\t  owner: string;\n177\t  kind: string;\n178\t  source_ref: string;\n179\t  attempts: number | bigint;\n180\t  queued_at: string;\n181\t  payload: string | null;\n182\t}\n183\t\n184\t// Form targets for pre-v5 rows, whose payload is NULL (Epic 01 wrote no\n185\t// payload column). Exactly the F-02 backfill's kind→form mapping (migration\n186\t// v5, shared/storage.ts): the backfill created pending derived_form rows at\n187\t// source version 1 for these kinds, and a terminal failure must find them —\n188\t// otherwise exhaustion would delete the work row and strand the backfilled\n189\t// form as pending forever, breaking AC-1.9/DD-1 for upgraded threads.\n190\tconst LEGACY_KIND_FORMS: Partial<\n191\t  Record<string, ReadonlyArray<{ subjectKind: SubjectKind; form: FormKind }>>\n192\t> = {\n193\t  prompt_smoothing: [{ subjectKind: \"message\", form: \"smoothed_prompt\" }],\n194\t  tool_result_summary: [{ subjectKind: \"message\", form: \"tool_result_summary\" }],\n195\t  turn_derivation: [\n196\t    { subjectKind: \"turn\", form: \"turn_rendering\" },\n197\t    { subjectKind: \"turn\", form: \"lower_band_projection\" },\n198\t  ],\n199\t};\n200\t\n201\tfunction legacyFormTargets(kind: string, sourceRef: WorkSourceRef): EnqueueFormTarget[] {\n202\t  const mapped = LEGACY_KIND_FORMS[kind];\n203\t  if (mapped === undefined) return [];\n204\t  const subjectId = sourceIdOf(sourceRef);\n205\t  return mapped.map((target) => ({ ...target, subjectId }));\n206\t}\n207\t\n208\tfunction toClaimedItem(row: RawClaimRow): ClaimedWorkItem {\n209\t  const sourceRef = JSON.parse(row.source_ref) as WorkSourceRef;\n210\t  const payload =\n211\t    row.payload === null\n212\t      ? // Pre-v5 row: version 1 (matching the backfill) and form targets\n213\t        // reconstructed from the backfill's own mapping.\n214\t        { sourceVersion: 1, forms: legacyFormTargets(row.kind, sourceRef) }\n215\t      : (JSON.parse(row.payload) as { sourceVersion?: number; forms?: EnqueueFormTarget[] });\n216\t  return {\n217\t    workItemId: row.work_item_id,\n218\t    owner: row.owner as WorkOwner,\n219\t    kind: row.kind,\n220\t    sourceRef,\n221\t    attempts: Number(row.attempts),\n222\t    queuedAt: row.queued_at,\n223\t    sourceVersion: payload.sourceVersion ?? 1,\n224\t    forms: payload.forms ?? [],\n225\t  };\n226\t}\n227\t\n228\t// Head-first, never skip-ahead: the claim decision is made against the oldest\n229\t// live row only — a later eligible row is never considered while an older\n230\t// live row exists. One atomic UPDATE under BEGIN IMMEDIATE (no read-then-\n231\t// write split: the race window is the bug class). The CASE increments\n232\t// `attempts` only when reclaiming an expired claimed row — a reclaim means a\n233\t// run died or hung, and the increment makes the crash visible in the report\n234\t// and counts it against the retry budget; normal claims never touch it.\n235\texport function claimNext(db: DatabaseSync, now: string, leaseDurationMs: number): ClaimOutcome {\n236\t  const expiresAt = new Date(Date.parse(now) + leaseDurationMs).toISOString();\n237\t  db.exec(\"BEGIN IMMEDIATE;\");\n238\t  try {\n239\t    const claimed = db\n240\t      .prepare(\n241\t        `UPDATE work_item SET status = 'claimed', claimed_at = ?, claim_expires_at = ?,\n242\t           attempts = attempts + CASE WHEN status = 'claimed' THEN 1 ELSE 0 END\n243\t         WHERE work_item_id = (\n244\t           SELECT work_item_id FROM (\n245\t             SELECT work_item_id, status, eligible_at, claim_expires_at\n246\t             FROM work_item WHERE status IN ('queued', 'claimed')\n247\t             ORDER BY rowid LIMIT 1\n248\t           )\n249\t           WHERE (status = 'queued' AND (eligible_at IS NULL OR eligible_at <= ?))\n250\t              OR (status = 'claimed' AND claim_expires_at <= ?)\n251\t         )\n252\t         RETURNING work_item_id, owner, kind, source_ref, attempts, queued_at, payload`,\n253\t      )\n254\t      .get(now, expiresAt, now, now) as unknown as RawClaimRow | undefined;\n255\t    if (claimed !== undefined) {\n256\t      db.exec(\"COMMIT;\");\n257\t      return { outcome: \"claimed\", item: toClaimedItem(claimed) };\n258\t    }\n259\t    // No row claimable: re-read the head inside the same transaction to\n260\t    // classify the stop. A claimed head with a live lease gates the queue\n261\t    // (in_flight, AC-1.4); a queued head still backing off gates it too\n262\t    // (waiting) — strict ordering, never reordered around the head.\n263\t    const head = db\n264\t      .prepare(\n265\t        `SELECT status, eligible_at, claim_expires_at\n266\t         FROM work_item WHERE status IN ('queued', 'claimed')\n267\t         ORDER BY rowid LIMIT 1`,\n268\t      )\n269\t      .get() as unknown as\n270\t      | { status: string; eligible_at: string | null; claim_expires_at: string | null }\n271\t      | undefined;\n272\t    db.exec(\"COMMIT;\");\n273\t    if (head === undefined) return { outcome: \"empty\" };\n274\t    if (head.status === \"claimed\") {\n275\t      return { outcome: \"in_flight\", claimExpiresAt: head.claim_expires_at ?? \"\" };\n276\t    }\n277\t    return { outcome: \"waiting\", waitingUntil: head.eligible_at ?? \"\" };\n278\t  } catch (cause) {\n279\t    db.exec(\"ROLLBACK;\");\n280\t    throw cause;\n281\t  }\n282\t}\n283\t\n284\t// Completion: the version-checked form writes and the item row's deletion in\n285\t// one short transaction (DD-1: terminal transition deletes the row; the\n286\t// disposition is reported in-memory, never stored). UPDATE-only, never\n287\t// upsert — the pending row exists from enqueue; a write that finds no row at\n288\t// the item's source version is discarded as stale (DD-3 truth table). The\n289\t// optional onApplied hook (Story 3) runs inside this same transaction, after\n290\t// the form writes and only when they landed — chunk placement and the\n291\t// close→summary enqueues ride the completion commit; its onCommit\n292\t// registrations (the enqueue pokes) flush after COMMIT and drop on rollback.\n293\texport function complete(\n294\t  db: DatabaseSync,\n295\t  item: ClaimedWorkItem,\n296\t  writes: readonly HandlerFormWrite[],\n297\t  derivedAt: string,\n298\t  onApplied?: (tx: CompletionTx) => void,\n299\t): \"done\" | \"stale_discarded\" {\n300\t  const hooks = createCommitHooks();\n301\t  db.exec(\"BEGIN IMMEDIATE;\");\n302\t  try {\n303\t    let hits = 0;\n304\t    const update = db.prepare(\n305\t      `UPDATE derived_form\n306\t       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = ?, derived_at = ?\n307\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n308\t    );\n309\t    for (const write of writes) {\n310\t      const changed = update.run(\n311\t        write.content,\n312\t        write.metadata === undefined ? null : JSON.stringify(write.metadata),\n313\t        write.gaps === undefined ? null : JSON.stringify(write.gaps),\n314\t        derivedAt,\n315\t        write.subjectKind,\n316\t        write.subjectId,\n317\t        write.form,\n318\t        item.sourceVersion,\n319\t      );\n320\t      hits += Number(changed.changes);\n321\t    }\n322\t    const stale = writes.length > 0 && hits === 0;\n323\t    if (!stale && onApplied !== undefined) {\n324\t      onApplied({ db, onCommit: hooks.register });\n325\t    }\n326\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n327\t    db.exec(\"COMMIT;\");\n328\t    hooks.flush();\n329\t    return stale ? \"stale_discarded\" : \"done\";\n330\t  } catch (cause) {\n331\t    db.exec(\"ROLLBACK;\");\n332\t    throw cause;\n333\t  }\n334\t}\n335\t\n336\texport interface RetryPolicy {\n337\t  budget: number;\n338\t  backoffBaseMs: number;\n339\t  backoffCapMs: number;\n340\t}\n341\t\n342\texport type FailAttemptResult =\n343\t  | { terminal: false; attempts: number; eligibleAt: string }\n344\t  | { terminal: true; attempts: number };\n345\t\n346\t// Terminal failure: the form rows land `failed` (or `blocked` for source\n347\t// damage) carrying the final reason plus attempts/last-error copied onto the\n348\t// form's metadata, and the item row is deleted — one transaction (DD-1).\n349\t// Form writes stay version-checked: if a mutation moved the source since this\n350\t// item was queued, the stale failure must not stamp the rebuilt form.\n351\texport function failTerminal(\n352\t  db: DatabaseSync,\n353\t  item: ClaimedWorkItem,\n354\t  opts: { reason: string; formState: \"failed\" | \"blocked\"; attempts: number; now: string },\n355\t): void {\n356\t  db.exec(\"BEGIN IMMEDIATE;\");\n357\t  try {\n358\t    const update = db.prepare(\n359\t      `UPDATE derived_form\n360\t       SET state = ?, content = NULL, reason = ?, metadata = ?, gaps = NULL, derived_at = ?\n361\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n362\t    );\n363\t    const metadata = JSON.stringify({ attempts: opts.attempts, lastError: opts.reason });\n364\t    for (const target of item.forms) {\n365\t      update.run(\n366\t        opts.formState,\n367\t        opts.reason,\n368\t        metadata,\n369\t        opts.now,\n370\t        target.subjectKind,\n371\t        target.subjectId,\n372\t        target.form,\n373\t        item.sourceVersion,\n374\t      );\n375\t    }\n376\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n377\t    db.exec(\"COMMIT;\");\n378\t  } catch (cause) {\n379\t    db.exec(\"ROLLBACK;\");\n380\t    throw cause;\n381\t  }\n382\t}\n383\t\n384\t// A failed run counts itself. Under budget and retryable: the row goes back\n385\t// to `queued` with attempts incremented and eligibility pushed out by backoff\n386\t// (min(base × 2^attempts, cap)) — retry is not a status (DD-1). At budget, or\n387\t// on a non-retryable failure, the item is terminal: form `failed` with the\n388\t// final reason, row deleted (AC-1.9).\n389\texport function failAttempt(\n390\t  db: DatabaseSync,\n391\t  item: ClaimedWorkItem,\n392\t  opts: { reason: string; retryable: boolean; now: string; retry: RetryPolicy },\n393\t): FailAttemptResult {\n394\t  const attempts = item.attempts + 1;\n395\t  if (opts.retryable && attempts < opts.retry.budget) {\n396\t    const backoffMs = Math.min(\n397\t      opts.retry.backoffBaseMs * 2 ** attempts,\n398\t      opts.retry.backoffCapMs,\n399\t    );\n400\t    const eligibleAt = new Date(Date.parse(opts.now) + backoffMs).toISOString();\n401\t    db.exec(\"BEGIN IMMEDIATE;\");\n402\t    try {\n403\t      db.prepare(\n404\t        `UPDATE work_item\n405\t         SET status = 'queued', attempts = ?, last_error = ?,\n406\t             claimed_at = NULL, claim_expires_at = NULL, eligible_at = ?\n407\t         WHERE work_item_id = ?`,\n408\t      ).run(attempts, opts.reason, eligibleAt, item.workItemId);\n409\t      db.exec(\"COMMIT;\");\n410\t    } catch (cause) {\n411\t      db.exec(\"ROLLBACK;\");\n412\t      throw cause;\n413\t    }\n414\t    return { terminal: false, attempts, eligibleAt };\n415\t  }\n416\t  failTerminal(db, item, { reason: opts.reason, formState: \"failed\", attempts, now: opts.now });\n417\t  return { terminal: true, attempts };\n418\t}\n419\t\n420\t// Cascade tidy (tech design issue 1): delete still-queued items for the given\n421\t// (kind, sourceRef) targets, returning the deleted ids for the mutation\n422\t// result's `superseded` list. Runs inside the caller's ambient transaction —\n423\t// the cascade owns the BEGIN/COMMIT — so no transaction is opened here.\n424\t// Claimed items are deliberately left alone: the source-version check (DD-3)\n425\t// discards their stale completions. Ships here as mechanics; its only caller\n426\t// is Story 5's cascade.\n427\texport function supersedeQueued(\n428\t  db: DatabaseSync,\n429\t  targets: ReadonlyArray<{ kind: WorkKind; sourceRef: WorkSourceRef }>,\n430\t): string[] {\n431\t  const ids: string[] = [];\n432\t  const remove = db.prepare(\n433\t    `DELETE FROM work_item WHERE status = 'queued' AND kind = ? AND source_ref = ?\n434\t     RETURNING work_item_id`,\n435\t  );\n436\t  for (const target of targets) {\n437\t    const rows = remove.all(target.kind, JSON.stringify(target.sourceRef)) as unknown as Array<{\n438\t      work_item_id: string;\n439\t    }>;\n440\t    for (const row of rows) ids.push(row.work_item_id);\n441\t  }\n442\t  return ids;\n443\t}\n444\t\n445\t// The requeue no-op rule's EXISTS check (AC-4.5): is there a live item —\n446\t// queued or in flight — for this kind and source at this source version?\n447\t// Runs inside the caller's requeue transaction so the check and the enqueue\n448\t// commit together (anti-shim: a check-then-enqueue split across transactions\n449\t// reintroduces the duplicate-work race). Version-scoped on purpose: a\n450\t// claimed pre-mutation item at an older version is dying work whose\n451\t// completion DD-3 will discard — it must not block the repair.\n452\texport function hasLiveItem(\n453\t  db: DatabaseSync,\n454\t  kind: WorkKind,\n455\t  sourceRef: WorkSourceRef,\n456\t  sourceVersion: number,\n457\t): boolean {\n458\t  const row = db\n459\t    .prepare(\n460\t      `SELECT 1 FROM work_item\n461\t       WHERE status IN ('queued', 'claimed') AND kind = ? AND source_ref = ?\n462\t         AND COALESCE(json_extract(payload, '$.sourceVersion'), 1) = ?\n463\t       LIMIT 1`,\n464\t    )\n465\t    .get(kind, JSON.stringify(sourceRef), sourceVersion);\n466\t  return row !== undefined;\n467\t}\n468\t\n469\t// Live items left in the queue — the drain report's `remaining` and the\n470\t// repair report's join source (Story 4).\n471\texport function countLiveItems(db: DatabaseSync): number {\n472\t  const row = db\n473\t    .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE status IN ('queued', 'claimed')`)\n474\t    .get() as unknown as { n: number | bigint };\n475\t  return Number(row.n);\n476\t}\n477\t\n478\texport interface QueueDetailRow {\n479\t  workItemId: string;\n480\t  owner: WorkOwner;\n481\t  kind: string;\n482\t  sourceRef: WorkSourceRef;\n483\t  status: \"queued\" | \"claimed\";\n484\t  attempts: number;\n485\t  lastError?: string;\n486\t  eligibleAt?: string;\n487\t  claimedAt?: string;\n488\t  claimExpiresAt?: string;\n489\t  queuedAt: string;\n490\t  sourceVersion: number;\n491\t}\n492\t\n493\t// Mechanical detail of every live row in queue order — what the repair\n494\t// report joins against derived_form (Flow 4) and what tests read to assert\n495\t// lease/backoff state without raw SQL at every call site.\n496\texport function queueDetail(db: DatabaseSync): QueueDetailRow[] {\n497\t  const rows = db\n498\t    .prepare(\n499\t      `SELECT work_item_id, owner, kind, source_ref, status, attempts, last_error,\n500\t              eligible_at, claimed_at, claim_expires_at, queued_at, payload\n501\t       FROM work_item ORDER BY rowid`,\n502\t    )\n503\t    .all() as unknown as Array<\n504\t    RawClaimRow & {\n505\t      status: string;\n506\t      last_error: string | null;\n507\t      eligible_at: string | null;\n508\t      claimed_at: string | null;\n509\t      claim_expires_at: string | null;\n510\t    }\n511\t  >;\n512\t  return rows.map((row) => {\n513\t    const item = toClaimedItem(row);\n514\t    const detail: QueueDetailRow = {\n515\t      workItemId: item.workItemId,\n516\t      owner: item.owner,\n517\t      kind: item.kind,\n518\t      sourceRef: item.sourceRef,\n519\t      status: row.status as \"queued\" | \"claimed\",\n520\t      attempts: item.attempts,\n521\t      queuedAt: item.queuedAt,\n522\t      sourceVersion: item.sourceVersion,\n523\t    };\n524\t    if (row.last_error !== null) detail.lastError = row.last_error;\n525\t    if (row.eligible_at !== null) detail.eligibleAt = row.eligible_at;\n526\t    if (row.claimed_at !== null) detail.claimedAt = row.claimed_at;\n527\t    if (row.claim_expires_at !== null) detail.claimExpiresAt = row.claim_expires_at;\n528\t    return detail;\n529\t  });\n530\t}\n531\t\n532\t// Listing in queue order (insertion order within the walk); each owning\n533\t// domain lists only its own items.\n534\texport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n535\t  const rows = db\n536\t    .prepare(\n537\t      `SELECT work_item_id, owner, kind, source_ref, queued_at\n538\t       FROM work_item WHERE owner = ? ORDER BY rowid`,\n539\t    )\n540\t    .all(owner) as unknown as RawWorkItemRow[];\n541\t  return rows.map((row) => ({\n542\t    workItemId: row.work_item_id,\n543\t    owner: row.owner as WorkOwner,\n544\t    kind: row.kind as WorkKind,\n545\t    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n546\t    status: \"queued\",\n547\t    queuedAt: row.queued_at,\n548\t  }));\n549\t}\n550\t"}]},"parent_tool_use_id":null,"session_id":"91a5247d-d939-443d-a5c4-7c2ee5826722","uuid":"254754bb-6f19-4cf7-93ac-1445cc9f44ac","timestamp":"2026-06-11T06:42:01.065Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/tech-utils/work-queue/index.ts","content":"// Durable work-item mechanics: recording, ordered listing, and the enqueue\n// wrapper that makes \"queueing is what schedules processing\" structural\n// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n// a turn or a summary is; which kinds queue for which sources, and which\n// derived forms a kind produces, is the owning domains' business (callers\n// pass the form targets in). Writes run on the caller's handle inside the\n// ambient transaction, so items commit (or roll back) with the batch. No\n// public SDK surface: read-back reaches here only through the owning\n// domains' listQueuedWork.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport {\n  createCommitHooks,\n  fireSchedulerPoke,\n  type OperationContext,\n} from \"../../shared/context.js\";\nimport type {\n  CompletionTx,\n  FormKind,\n  HandlerFormWrite,\n  SubjectKind,\n} from \"../../shared/derivation.js\";\n\nexport type WorkOwner = \"messages\" | \"turns\";\nexport type WorkKind =\n  | \"prompt_smoothing\"\n  | \"tool_call_summary\"\n  | \"tool_result_summary\"\n  | \"turn_derivation\"\n  | \"chunk_summary_detailed\"\n  | \"chunk_summary_brief\";\nexport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n\n// The work-kind registry: owner and sourceRef semantics per the epic's Work\n// Item contract. Mechanical metadata only — what a kind *means* stays with\n// the owning domain's handler (registered at SDK construction, DD-6).\nexport const WORK_KIND_REGISTRY: Readonly<\n  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n> = {\n  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n  tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n};\n\nexport interface WorkItemRecord {\n  workItemId: string;\n  owner: WorkOwner;\n  kind: WorkKind;\n  sourceRef: WorkSourceRef;\n  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n  queuedAt: string;\n}\n\n// The derived forms an enqueue is scheduling work toward; the owning domain\n// names them (the util stays meaning-blind). Stored in the row's payload so\n// the drain's terminal paths (retry exhaustion, blocked source) can land the\n// form's failed/blocked state without asking any domain what a kind means.\nexport interface EnqueueFormTarget {\n  subjectKind: SubjectKind;\n  subjectId: string;\n  form: FormKind;\n}\n\nexport interface WorkItemInput {\n  owner: WorkOwner;\n  kind: WorkKind;\n  sourceRef: WorkSourceRef;\n  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n  forms?: readonly EnqueueFormTarget[]; // carried in payload for the drain's terminal paths\n}\n\nfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n  return sourceRef.chunkId;\n}\n\n// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n// same kind for the same source *at the same version* is the same id —\n// natural idempotency for the repair path — while a post-mutation\n// replacement (next version) never collides with an in-flight pre-mutation\n// item.\nexport function recordItem(\n  db: DatabaseSync,\n  input: WorkItemInput,\n  queuedAt: string,\n): WorkItemRecord {\n  const sourceVersion = input.sourceVersion ?? 1;\n  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n  db.prepare(\n    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n  ).run(\n    workItemId,\n    input.owner,\n    input.kind,\n    JSON.stringify(input.sourceRef),\n    queuedAt,\n    JSON.stringify({ sourceVersion, forms: input.forms ?? [] }),\n  );\n  return {\n    workItemId,\n    owner: input.owner,\n    kind: input.kind,\n    sourceRef: input.sourceRef,\n    status: \"queued\",\n    queuedAt,\n  };\n}\n\nexport interface EnqueueInput extends WorkItemInput {\n  forms: readonly EnqueueFormTarget[];\n}\n\n// The one way work is scheduled (DD-5): the work row, the form's `pending`\n// state row, and the scheduler poke all ride the ambient transaction — they\n// commit together or vanish together. Enqueue is the *only* place a\n// derived_form row is created (completion is UPDATE-only); re-enqueueing\n// resets an existing row to pending at the enqueued source version.\nexport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n  const sourceVersion = input.sourceVersion ?? 1;\n  const upsert = ctx.db.prepare(\n    `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n     VALUES (?, ?, ?, 'pending', ?)\n     ON CONFLICT (subject_kind, subject_id, form) DO UPDATE SET\n       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n  );\n  for (const target of input.forms) {\n    upsert.run(target.subjectKind, target.subjectId, target.form, sourceVersion);\n  }\n  ctx.onCommit(() => fireSchedulerPoke(ctx.threadId));\n  return item;\n}\n\ninterface RawWorkItemRow {\n  work_item_id: string;\n  owner: string;\n  kind: string;\n  source_ref: string;\n  queued_at: string;\n}\n\n// ── claim mechanics (Epic 02 Story 1, tech design §Mechanics) ─────\n// All pure SQL against the caller's open handle, domain-blind. Claim,\n// complete, and the terminal half of failAttempt each own one short\n// BEGIN IMMEDIATE; the handler in between runs with no open transaction.\n\n// The claimed row as the drain holds it: mechanical fields plus the payload's\n// source version and form targets. `kind` is a plain string here — a raw row\n// with an unregistered kind must still be claimable so the drain can land it\n// failed_terminal instead of skipping it (AC-1.8).\nexport interface ClaimedWorkItem {\n  workItemId: string;\n  owner: WorkOwner;\n  kind: string;\n  sourceRef: WorkSourceRef;\n  attempts: number;\n  queuedAt: string;\n  sourceVersion: number;\n  forms: EnqueueFormTarget[];\n}\n\nexport type ClaimOutcome =\n  | { outcome: \"claimed\"; item: ClaimedWorkItem }\n  | { outcome: \"empty\" }\n  | { outcome: \"in_flight\"; claimExpiresAt: string }\n  | { outcome: \"waiting\"; waitingUntil: string };\n\ninterface RawClaimRow {\n  work_item_id: string;\n  owner: string;\n  kind: string;\n  source_ref: string;\n  attempts: number | bigint;\n  queued_at: string;\n  payload: string | null;\n}\n\n// Form targets for pre-v5 rows, whose payload is NULL (Epic 01 wrote no\n// payload column). Exactly the F-02 backfill's kind→form mapping (migration\n// v5, shared/storage.ts): the backfill created pending derived_form rows at\n// source version 1 for these kinds, and a terminal failure must find them —\n// otherwise exhaustion would delete the work row and strand the backfilled\n// form as pending forever, breaking AC-1.9/DD-1 for upgraded threads.\nconst LEGACY_KIND_FORMS: Partial<\n  Record<string, ReadonlyArray<{ subjectKind: SubjectKind; form: FormKind }>>\n> = {\n  prompt_smoothing: [{ subjectKind: \"message\", form: \"smoothed_prompt\" }],\n  tool_result_summary: [{ subjectKind: \"message\", form: \"tool_result_summary\" }],\n  turn_derivation: [\n    { subjectKind: \"turn\", form: \"turn_rendering\" },\n    { subjectKind: \"turn\", form: \"lower_band_projection\" },\n  ],\n};\n\nfunction legacyFormTargets(kind: string, sourceRef: WorkSourceRef): EnqueueFormTarget[] {\n  const mapped = LEGACY_KIND_FORMS[kind];\n  if (mapped === undefined) return [];\n  const subjectId = sourceIdOf(sourceRef);\n  return mapped.map((target) => ({ ...target, subjectId }));\n}\n\nfunction toClaimedItem(row: RawClaimRow): ClaimedWorkItem {\n  const sourceRef = JSON.parse(row.source_ref) as WorkSourceRef;\n  const payload =\n    row.payload === null\n      ? // Pre-v5 row: version 1 (matching the backfill) and form targets\n        // reconstructed from the backfill's own mapping.\n        { sourceVersion: 1, forms: legacyFormTargets(row.kind, sourceRef) }\n      : (JSON.parse(row.payload) as { sourceVersion?: number; forms?: EnqueueFormTarget[] });\n  return {\n    workItemId: row.work_item_id,\n    owner: row.owner as WorkOwner,\n    kind: row.kind,\n    sourceRef,\n    attempts: Number(row.attempts),\n    queuedAt: row.queued_at,\n    sourceVersion: payload.sourceVersion ?? 1,\n    forms: payload.forms ?? [],\n  };\n}\n\n// Head-first, never skip-ahead: the claim decision is made against the oldest\n// live row only — a later eligible row is never considered while an older\n// live row exists. One atomic UPDATE under BEGIN IMMEDIATE (no read-then-\n// write split: the race window is the bug class). The CASE increments\n// `attempts` only when reclaiming an expired claimed row — a reclaim means a\n// run died or hung, and the increment makes the crash visible in the report\n// and counts it against the retry budget; normal claims never touch it.\nexport function claimNext(db: DatabaseSync, now: string, leaseDurationMs: number): ClaimOutcome {\n  const expiresAt = new Date(Date.parse(now) + leaseDurationMs).toISOString();\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    const claimed = db\n      .prepare(\n        `UPDATE work_item SET status = 'claimed', claimed_at = ?, claim_expires_at = ?,\n           attempts = attempts + CASE WHEN status = 'claimed' THEN 1 ELSE 0 END\n         WHERE work_item_id = (\n           SELECT work_item_id FROM (\n             SELECT work_item_id, status, eligible_at, claim_expires_at\n             FROM work_item WHERE status IN ('queued', 'claimed')\n             ORDER BY rowid LIMIT 1\n           )\n           WHERE (status = 'queued' AND (eligible_at IS NULL OR eligible_at <= ?))\n              OR (status = 'claimed' AND claim_expires_at <= ?)\n         )\n         RETURNING work_item_id, owner, kind, source_ref, attempts, queued_at, payload`,\n      )\n      .get(now, expiresAt, now, now) as unknown as RawClaimRow | undefined;\n    if (claimed !== undefined) {\n      db.exec(\"COMMIT;\");\n      return { outcome: \"claimed\", item: toClaimedItem(claimed) };\n    }\n    // No row claimable: re-read the head inside the same transaction to\n    // classify the stop. A claimed head with a live lease gates the queue\n    // (in_flight, AC-1.4); a queued head still backing off gates it too\n    // (waiting) — strict ordering, never reordered around the head.\n    const head = db\n      .prepare(\n        `SELECT status, eligible_at, claim_expires_at\n         FROM work_item WHERE status IN ('queued', 'claimed')\n         ORDER BY rowid LIMIT 1`,\n      )\n      .get() as unknown as\n      | { status: string; eligible_at: string | null; claim_expires_at: string | null }\n      | undefined;\n    db.exec(\"COMMIT;\");\n    if (head === undefined) return { outcome: \"empty\" };\n    if (head.status === \"claimed\") {\n      return { outcome: \"in_flight\", claimExpiresAt: head.claim_expires_at ?? \"\" };\n    }\n    return { outcome: \"waiting\", waitingUntil: head.eligible_at ?? \"\" };\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n}\n\n// Completion: the version-checked form writes and the item row's deletion in\n// one short transaction (DD-1: terminal transition deletes the row; the\n// disposition is reported in-memory, never stored). UPDATE-only, never\n// upsert — the pending row exists from enqueue; a write that finds no row at\n// the item's source version is discarded as stale (DD-3 truth table). The\n// optional onApplied hook (Story 3) runs inside this same transaction, after\n// the form writes and only when they landed — chunk placement and the\n// close→summary enqueues ride the completion commit; its onCommit\n// registrations (the enqueue pokes) flush after COMMIT and drop on rollback.\nexport function complete(\n  db: DatabaseSync,\n  item: ClaimedWorkItem,\n  writes: readonly HandlerFormWrite[],\n  derivedAt: string,\n  onApplied?: (tx: CompletionTx) => void,\n): \"done\" | \"stale_discarded\" {\n  const hooks = createCommitHooks();\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    let hits = 0;\n    const update = db.prepare(\n      `UPDATE derived_form\n       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = ?, derived_at = ?\n       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n    );\n    for (const write of writes) {\n      const changed = update.run(\n        write.content,\n        write.metadata === undefined ? null : JSON.stringify(write.metadata),\n        write.gaps === undefined ? null : JSON.stringify(write.gaps),\n        derivedAt,\n        write.subjectKind,\n        write.subjectId,\n        write.form,\n        item.sourceVersion,\n      );\n      hits += Number(changed.changes);\n    }\n    const stale = writes.length > 0 && hits === 0;\n    if (!stale && onApplied !== undefined) {\n      onApplied({ db, onCommit: hooks.register });\n    }\n    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n    db.exec(\"COMMIT;\");\n    hooks.flush();\n    return stale ? \"stale_discarded\" : \"done\";\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n}\n\nexport interface RetryPolicy {\n  budget: number;\n  backoffBaseMs: number;\n  backoffCapMs: number;\n}\n\nexport type FailAttemptResult =\n  | { terminal: false; attempts: number; eligibleAt: string }\n  | { terminal: true; attempts: number };\n\n// Terminal failure: the form rows land `failed` (or `blocked` for source\n// damage) carrying the final reason plus attempts/last-error copied onto the\n// form's metadata, and the item row is deleted — one transaction (DD-1).\n// Form writes stay version-checked: if a mutation moved the source since this\n// item was queued, the stale failure must not stamp the rebuilt form.\nexport function failTerminal(\n  db: DatabaseSync,\n  item: ClaimedWorkItem,\n  opts: { reason: string; formState: \"failed\" | \"blocked\"; attempts: number; now: string },\n): void {\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    const update = db.prepare(\n      `UPDATE derived_form\n       SET state = ?, content = NULL, reason = ?, metadata = ?, gaps = NULL, derived_at = ?\n       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n    );\n    const metadata = JSON.stringify({ attempts: opts.attempts, lastError: opts.reason });\n    for (const target of item.forms) {\n      update.run(\n        opts.formState,\n        opts.reason,\n        metadata,\n        opts.now,\n        target.subjectKind,\n        target.subjectId,\n        target.form,\n        item.sourceVersion,\n      );\n    }\n    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n    db.exec(\"COMMIT;\");\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n}\n\n// A failed run counts itself. Under budget and retryable: the row goes back\n// to `queued` with attempts incremented and eligibility pushed out by backoff\n// (min(base × 2^attempts, cap)) — retry is not a status (DD-1). At budget, or\n// on a non-retryable failure, the item is terminal: form `failed` with the\n// final reason, row deleted (AC-1.9).\nexport function failAttempt(\n  db: DatabaseSync,\n  item: ClaimedWorkItem,\n  opts: { reason: string; retryable: boolean; now: string; retry: RetryPolicy },\n): FailAttemptResult {\n  const attempts = item.attempts + 1;\n  if (opts.retryable && attempts < opts.retry.budget) {\n    const backoffMs = Math.min(\n      opts.retry.backoffBaseMs * 2 ** attempts,\n      opts.retry.backoffCapMs,\n    );\n    const eligibleAt = new Date(Date.parse(opts.now) + backoffMs).toISOString();\n    db.exec(\"BEGIN IMMEDIATE;\");\n    try {\n      db.prepare(\n        `UPDATE work_item\n         SET status = 'queued', attempts = ?, last_error = ?,\n             claimed_at = NULL, claim_expires_at = NULL, eligible_at = ?\n         WHERE work_item_id = ?`,\n      ).run(attempts, opts.reason, eligibleAt, item.workItemId);\n      db.exec(\"COMMIT;\");\n    } catch (cause) {\n      db.exec(\"ROLLBACK;\");\n      throw cause;\n    }\n    return { terminal: false, attempts, eligibleAt };\n  }\n  failTerminal(db, item, { reason: opts.reason, formState: \"failed\", attempts, now: opts.now });\n  return { terminal: true, attempts };\n}\n\n// Cascade tidy (tech design issue 1): delete still-queued items for the given\n// (kind, sourceRef) targets, returning the deleted ids for the mutation\n// result's `superseded` list. Runs inside the caller's ambient transaction —\n// the cascade owns the BEGIN/COMMIT — so no transaction is opened here.\n// Claimed items are deliberately left alone: the source-version check (DD-3)\n// discards their stale completions. Ships here as mechanics; its only caller\n// is Story 5's cascade.\nexport function supersedeQueued(\n  db: DatabaseSync,\n  targets: ReadonlyArray<{ kind: WorkKind; sourceRef: WorkSourceRef }>,\n): string[] {\n  const ids: string[] = [];\n  const remove = db.prepare(\n    `DELETE FROM work_item WHERE status = 'queued' AND kind = ? AND source_ref = ?\n     RETURNING work_item_id`,\n  );\n  for (const target of targets) {\n    const rows = remove.all(target.kind, JSON.stringify(target.sourceRef)) as unknown as Array<{\n      work_item_id: string;\n    }>;\n    for (const row of rows) ids.push(row.work_item_id);\n  }\n  return ids;\n}\n\n// The requeue no-op rule's EXISTS check (AC-4.5): is there a live item —\n// queued or in flight — for this kind and source at this source version?\n// Runs inside the caller's requeue transaction so the check and the enqueue\n// commit together (anti-shim: a check-then-enqueue split across transactions\n// reintroduces the duplicate-work race). Version-scoped on purpose: a\n// claimed pre-mutation item at an older version is dying work whose\n// completion DD-3 will discard — it must not block the repair.\nexport function hasLiveItem(\n  db: DatabaseSync,\n  kind: WorkKind,\n  sourceRef: WorkSourceRef,\n  sourceVersion: number,\n): boolean {\n  const row = db\n    .prepare(\n      `SELECT 1 FROM work_item\n       WHERE status IN ('queued', 'claimed') AND kind = ? AND source_ref = ?\n         AND COALESCE(json_extract(payload, '$.sourceVersion'), 1) = ?\n       LIMIT 1`,\n    )\n    .get(kind, JSON.stringify(sourceRef), sourceVersion);\n  return row !== undefined;\n}\n\n// Live items left in the queue — the drain report's `remaining` and the\n// repair report's join source (Story 4).\nexport function countLiveItems(db: DatabaseSync): number {\n  const row = db\n    .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE status IN ('queued', 'claimed')`)\n    .get() as unknown as { n: number | bigint };\n  return Number(row.n);\n}\n\nexport interface QueueDetailRow {\n  workItemId: string;\n  owner: WorkOwner;\n  kind: string;\n  sourceRef: WorkSourceRef;\n  status: \"queued\" | \"claimed\";\n  attempts: number;\n  lastError?: string;\n  eligibleAt?: string;\n  claimedAt?: string;\n  claimExpiresAt?: string;\n  queuedAt: string;\n  sourceVersion: number;\n}\n\n// Mechanical detail of every live row in queue order — what the repair\n// report joins against derived_form (Flow 4) and what tests read to assert\n// lease/backoff state without raw SQL at every call site.\nexport function queueDetail(db: DatabaseSync): QueueDetailRow[] {\n  const rows = db\n    .prepare(\n      `SELECT work_item_id, owner, kind, source_ref, status, attempts, last_error,\n              eligible_at, claimed_at, claim_expires_at, queued_at, payload\n       FROM work_item ORDER BY rowid`,\n    )\n    .all() as unknown as Array<\n    RawClaimRow & {\n      status: string;\n      last_error: string | null;\n      eligible_at: string | null;\n      claimed_at: string | null;\n      claim_expires_at: string | null;\n    }\n  >;\n  return rows.map((row) => {\n    const item = toClaimedItem(row);\n    const detail: QueueDetailRow = {\n      workItemId: item.workItemId,\n      owner: item.owner,\n      kind: item.kind,\n      sourceRef: item.sourceRef,\n      status: row.status as \"queued\" | \"claimed\",\n      attempts: item.attempts,\n      queuedAt: item.queuedAt,\n      sourceVersion: item.sourceVersion,\n    };\n    if (row.last_error !== null) detail.lastError = row.last_error;\n    if (row.eligible_at !== null) detail.eligibleAt = row.eligible_at;\n    if (row.claimed_at !== null) detail.claimedAt = row.claimed_at;\n    if (row.claim_expires_at !== null) detail.claimExpiresAt = row.claim_expires_at;\n    return detail;\n  });\n}\n\n// Listing in queue order (insertion order within the walk); each owning\n// domain lists only its own items.\nexport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n  const rows = db\n    .prepare(\n      `SELECT work_item_id, owner, kind, source_ref, queued_at\n       FROM work_item WHERE owner = ? ORDER BY rowid`,\n    )\n    .all(owner) as unknown as RawWorkItemRow[];\n  return rows.map((row) => ({\n    workItemId: row.work_item_id,\n    owner: row.owner as WorkOwner,\n    kind: row.kind as WorkKind,\n    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n    status: \"queued\",\n    queuedAt: row.queued_at,\n  }));\n}\n","numLines":550,"startLine":1,"totalLines":550}}}

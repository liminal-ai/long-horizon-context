{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VpbDVfb7gVFxtM1y3LSVyp","type":"tool_result","content":"1\t// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n2\t// biggest single handler — and the two chunk summaries. turn_derivation\n3\t// composes the rendering from message-level forms (compose.ts), sends it\n4\t// through composeTurnRendering then projectLowerBand, hands both forms back\n5\t// for the version-checked completion write, and runs placement in that same\n6\t// completion transaction via the onApplied hook: open-chunk append, the\n7\t// accumulated close policy, and any close's summary enqueues all ride the\n8\t// one commit (anti-shim: a crash leaves either a placed turn with queued\n9\t// summaries or an open chunk — nothing between).\n10\timport type {\n11\t  DependencyGap,\n12\t  HandlerOutcome,\n13\t  HandlerRunContext,\n14\t  WorkHandler,\n15\t} from \"../../../shared/derivation.js\";\n16\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n17\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n18\timport { composeRenderingInput } from \"./compose.js\";\n19\timport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\n20\timport {\n21\t  chunkExists,\n22\t  readMemberMessages,\n23\t  readMemberProjections,\n24\t  readMessageFormRows,\n25\t  readTurnSource,\n26\t} from \"./forms.js\";\n27\timport { selectOpenTurnIds } from \"./store.js\";\n28\t\n29\tfunction sourceDamaged(reason: string): HandlerOutcome {\n30\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n31\t}\n32\t\n33\tfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n34\t  return { ok: false, retryable: result.retryable, reason: result.reason };\n35\t}\n36\t\n37\tfunction readThreadId(run: HandlerRunContext): string {\n38\t  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n39\t    | { thread_id: string }\n40\t    | undefined;\n41\t  return row?.thread_id ?? \"\";\n42\t}\n43\t\n44\tconst turnDerivationHandler: WorkHandler = async (run, item) => {\n45\t  const turnId = item.sourceRef[\"turnId\"];\n46\t  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n47\t  const db = run.openDb();\n48\t  const turn = readTurnSource(db, turnId);\n49\t  if (turn === undefined || turn.deleted) {\n50\t    // A deleted turn's form rows were dropped with it, so a blocked stamp\n51\t    // would hit nothing; either way the item is terminal against a source\n52\t    // that cannot improve.\n53\t    return sourceDamaged(`turn ${turnId} not found`);\n54\t  }\n55\t  if (turn.status !== \"closed\") {\n56\t    // Derivation is queued only at close; an open turn under a queued item\n57\t    // means the record was interfered with.\n58\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n59\t  }\n60\t  // Epic 01's corruption definition (AC-3.9 there, TC-4.6 here): only the\n61\t  // batch pipeline writes turn state and it never leaves two turns open, so\n62\t  // more than one open turn means the record was damaged below the SDK. A\n63\t  // handler must not compose against a membership it cannot trust; the form\n64\t  // lands blocked naming the damage, and requeue refuses with that reason\n65\t  // until the source reads clean (Story 4).\n66\t  const openTurnIds = selectOpenTurnIds(db);\n67\t  if (openTurnIds.length > 1) {\n68\t    return sourceDamaged(\n69\t      `turn state corrupt: ${openTurnIds.length} turns open (${openTurnIds.join(\", \")})`,\n70\t    );\n71\t  }\n72\t\n73\t  // Compose from current message-form states: ready forms verbatim,\n74\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n75\t  // before any provider call, and no transaction is held across them.\n76\t  const messages = readMemberMessages(db, turnId);\n77\t  const forms = readMessageFormRows(\n78\t    db,\n79\t    messages.map((message) => message.messageId),\n80\t  );\n81\t  const { parts, gaps, receipts } = composeRenderingInput(messages, forms);\n82\t\n83\t  const rendering = await run.provider.composeTurnRendering({ parts });\n84\t  if (!rendering.ok) return providerFailed(rendering);\n85\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n86\t  if (!projection.ok) return providerFailed(projection);\n87\t\n88\t  // The projection's token count is estimated exactly once, here, as the\n89\t  // artifact lands; placement reads this stored arithmetic and never\n90\t  // re-counts (AC-3.9's determinism input).\n91\t  const projectedTokens = estimateTokens(projection.text);\n92\t  const threadId = readThreadId(run);\n93\t  const renderingGaps: DependencyGap[] | undefined = gaps.length > 0 ? gaps : undefined;\n94\t\n95\t  return {\n96\t    ok: true,\n97\t    forms: [\n98\t      {\n99\t        subjectKind: \"turn\",\n100\t        subjectId: turnId,\n101\t        form: \"turn_rendering\",\n102\t        content: rendering.text,\n103\t        ...(renderingGaps === undefined ? {} : { gaps: renderingGaps }),\n104\t        // Tool-run receipts ride the rendering's metadata, mechanically\n105\t        // restated from the composition input (AC-3.8) — the chunk\n106\t        // summaries read them from here, never from provider prose.\n107\t        ...(receipts.length > 0 ? { metadata: { receipts } } : {}),\n108\t      },\n109\t      {\n110\t        subjectKind: \"turn\",\n111\t        subjectId: turnId,\n112\t        form: \"lower_band_projection\",\n113\t        content: projection.text,\n114\t      },\n115\t    ],\n116\t    onApplied: (tx) => {\n117\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n118\t      for (const chunkId of placement.closedChunkIds) {\n119\t        enqueueChunkSummaries(\n120\t          { db: tx.db, clock: run.clock, threadId, onCommit: tx.onCommit },\n121\t          chunkId,\n122\t        );\n123\t      }\n124\t    },\n125\t  };\n126\t};\n127\t\n128\t// One read for both summary kinds — member projections in turn order — but\n129\t// two contracts at the provider seam (AC-3.8): detailed receives the\n130\t// members' tool-run receipts (what changed, outcome) read from the\n131\t// renderings' stamped metadata; brief receives outcomes only, the receipt\n132\t// text stripped here so the brief provider call structurally cannot carry\n133\t// it. Two work items, two handlers' runs, independent retry and states. A\n134\t// member whose projection is not ready falls back to nothing and records a\n135\t// gap, mirroring the rendering's fallback rule.\n136\tfunction chunkSummaryHandler(\n137\t  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n138\t): WorkHandler {\n139\t  return async (run, item) => {\n140\t    const chunkId = item.sourceRef[\"chunkId\"];\n141\t    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n142\t    const db = run.openDb();\n143\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n144\t\n145\t    const members = readMemberProjections(db, chunkId);\n146\t    const memberProjections: string[] = [];\n147\t    const gaps: DependencyGap[] = [];\n148\t    for (const member of members) {\n149\t      if (member.state === \"ready\" && member.content !== undefined) {\n150\t        memberProjections.push(member.content);\n151\t      } else {\n152\t        memberProjections.push(\"\");\n153\t        gaps.push({\n154\t          subjectKind: \"turn\",\n155\t          subjectId: member.turnId,\n156\t          form: \"lower_band_projection\",\n157\t        });\n158\t      }\n159\t    }\n160\t\n161\t    const result =\n162\t      kind === \"chunk_summary_detailed\"\n163\t        ? await run.provider.summarizeChunkDetailed({\n164\t            memberProjections,\n165\t            memberReceipts: members.map((member) => member.receipts),\n166\t          })\n167\t        : await run.provider.summarizeChunkBrief({\n168\t            memberProjections,\n169\t            memberOutcomes: members.map((member) =>\n170\t              member.receipts.map((receipt) => receipt.outcome),\n171\t            ),\n172\t          });\n173\t    if (!result.ok) return providerFailed(result);\n174\t\n175\t    return {\n176\t      ok: true,\n177\t      forms: [\n178\t        {\n179\t          subjectKind: \"chunk\",\n180\t          subjectId: chunkId,\n181\t          form: kind,\n182\t          content: result.text,\n183\t          ...(gaps.length > 0 ? { gaps } : {}),\n184\t        },\n185\t      ],\n186\t    };\n187\t  };\n188\t}\n189\t\n190\t// The domain's handler table, merged into the SDK dispatch map at\n191\t// construction (DD-6).\n192\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n193\t  turn_derivation: turnDerivationHandler,\n194\t  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n195\t  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n196\t};\n197\t"}]},"parent_tool_use_id":null,"session_id":"91a5247d-d939-443d-a5c4-7c2ee5826722","uuid":"541dfde3-05cb-4007-ad2e-c1a95cc99e18","timestamp":"2026-06-11T06:43:23.190Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/derive.ts","content":"// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n// biggest single handler — and the two chunk summaries. turn_derivation\n// composes the rendering from message-level forms (compose.ts), sends it\n// through composeTurnRendering then projectLowerBand, hands both forms back\n// for the version-checked completion write, and runs placement in that same\n// completion transaction via the onApplied hook: open-chunk append, the\n// accumulated close policy, and any close's summary enqueues all ride the\n// one commit (anti-shim: a crash leaves either a placed turn with queued\n// summaries or an open chunk — nothing between).\nimport type {\n  DependencyGap,\n  HandlerOutcome,\n  HandlerRunContext,\n  WorkHandler,\n} from \"../../../shared/derivation.js\";\nimport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\nimport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\nimport { composeRenderingInput } from \"./compose.js\";\nimport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\nimport {\n  chunkExists,\n  readMemberMessages,\n  readMemberProjections,\n  readMessageFormRows,\n  readTurnSource,\n} from \"./forms.js\";\nimport { selectOpenTurnIds } from \"./store.js\";\n\nfunction sourceDamaged(reason: string): HandlerOutcome {\n  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n}\n\nfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n  return { ok: false, retryable: result.retryable, reason: result.reason };\n}\n\nfunction readThreadId(run: HandlerRunContext): string {\n  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n    | { thread_id: string }\n    | undefined;\n  return row?.thread_id ?? \"\";\n}\n\nconst turnDerivationHandler: WorkHandler = async (run, item) => {\n  const turnId = item.sourceRef[\"turnId\"];\n  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n  const db = run.openDb();\n  const turn = readTurnSource(db, turnId);\n  if (turn === undefined || turn.deleted) {\n    // A deleted turn's form rows were dropped with it, so a blocked stamp\n    // would hit nothing; either way the item is terminal against a source\n    // that cannot improve.\n    return sourceDamaged(`turn ${turnId} not found`);\n  }\n  if (turn.status !== \"closed\") {\n    // Derivation is queued only at close; an open turn under a queued item\n    // means the record was interfered with.\n    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n  }\n  // Epic 01's corruption definition (AC-3.9 there, TC-4.6 here): only the\n  // batch pipeline writes turn state and it never leaves two turns open, so\n  // more than one open turn means the record was damaged below the SDK. A\n  // handler must not compose against a membership it cannot trust; the form\n  // lands blocked naming the damage, and requeue refuses with that reason\n  // until the source reads clean (Story 4).\n  const openTurnIds = selectOpenTurnIds(db);\n  if (openTurnIds.length > 1) {\n    return sourceDamaged(\n      `turn state corrupt: ${openTurnIds.length} turns open (${openTurnIds.join(\", \")})`,\n    );\n  }\n\n  // Compose from current message-form states: ready forms verbatim,\n  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n  // before any provider call, and no transaction is held across them.\n  const messages = readMemberMessages(db, turnId);\n  const forms = readMessageFormRows(\n    db,\n    messages.map((message) => message.messageId),\n  );\n  const { parts, gaps, receipts } = composeRenderingInput(messages, forms);\n\n  const rendering = await run.provider.composeTurnRendering({ parts });\n  if (!rendering.ok) return providerFailed(rendering);\n  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n  if (!projection.ok) return providerFailed(projection);\n\n  // The projection's token count is estimated exactly once, here, as the\n  // artifact lands; placement reads this stored arithmetic and never\n  // re-counts (AC-3.9's determinism input).\n  const projectedTokens = estimateTokens(projection.text);\n  const threadId = readThreadId(run);\n  const renderingGaps: DependencyGap[] | undefined = gaps.length > 0 ? gaps : undefined;\n\n  return {\n    ok: true,\n    forms: [\n      {\n        subjectKind: \"turn\",\n        subjectId: turnId,\n        form: \"turn_rendering\",\n        content: rendering.text,\n        ...(renderingGaps === undefined ? {} : { gaps: renderingGaps }),\n        // Tool-run receipts ride the rendering's metadata, mechanically\n        // restated from the composition input (AC-3.8) — the chunk\n        // summaries read them from here, never from provider prose.\n        ...(receipts.length > 0 ? { metadata: { receipts } } : {}),\n      },\n      {\n        subjectKind: \"turn\",\n        subjectId: turnId,\n        form: \"lower_band_projection\",\n        content: projection.text,\n      },\n    ],\n    onApplied: (tx) => {\n      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n      for (const chunkId of placement.closedChunkIds) {\n        enqueueChunkSummaries(\n          { db: tx.db, clock: run.clock, threadId, onCommit: tx.onCommit },\n          chunkId,\n        );\n      }\n    },\n  };\n};\n\n// One read for both summary kinds — member projections in turn order — but\n// two contracts at the provider seam (AC-3.8): detailed receives the\n// members' tool-run receipts (what changed, outcome) read from the\n// renderings' stamped metadata; brief receives outcomes only, the receipt\n// text stripped here so the brief provider call structurally cannot carry\n// it. Two work items, two handlers' runs, independent retry and states. A\n// member whose projection is not ready falls back to nothing and records a\n// gap, mirroring the rendering's fallback rule.\nfunction chunkSummaryHandler(\n  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n): WorkHandler {\n  return async (run, item) => {\n    const chunkId = item.sourceRef[\"chunkId\"];\n    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n    const db = run.openDb();\n    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n\n    const members = readMemberProjections(db, chunkId);\n    const memberProjections: string[] = [];\n    const gaps: DependencyGap[] = [];\n    for (const member of members) {\n      if (member.state === \"ready\" && member.content !== undefined) {\n        memberProjections.push(member.content);\n      } else {\n        memberProjections.push(\"\");\n        gaps.push({\n          subjectKind: \"turn\",\n          subjectId: member.turnId,\n          form: \"lower_band_projection\",\n        });\n      }\n    }\n\n    const result =\n      kind === \"chunk_summary_detailed\"\n        ? await run.provider.summarizeChunkDetailed({\n            memberProjections,\n            memberReceipts: members.map((member) => member.receipts),\n          })\n        : await run.provider.summarizeChunkBrief({\n            memberProjections,\n            memberOutcomes: members.map((member) =>\n              member.receipts.map((receipt) => receipt.outcome),\n            ),\n          });\n    if (!result.ok) return providerFailed(result);\n\n    return {\n      ok: true,\n      forms: [\n        {\n          subjectKind: \"chunk\",\n          subjectId: chunkId,\n          form: kind,\n          content: result.text,\n          ...(gaps.length > 0 ? { gaps } : {}),\n        },\n      ],\n    };\n  };\n}\n\n// The domain's handler table, merged into the SDK dispatch map at\n// construction (DD-6).\nexport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n  turn_derivation: turnDerivationHandler,\n  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n};\n","numLines":197,"startLine":1,"totalLines":197}}}

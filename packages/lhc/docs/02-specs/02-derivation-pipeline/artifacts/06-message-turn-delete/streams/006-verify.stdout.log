{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/cascade.ts | sed -n '100,270p'\"","aggregated_output":"   100\t  kind: WorkKind;\n   101\t  forms: EnqueueFormTarget[];\n   102\t  maxSourceVersion: number;\n   103\t}\n   104\t\n   105\tfunction rebuildKindFor(form: string): WorkKind {\n   106\t  const kind = FORM_REBUILD_KINDS[form as FormKind];\n   107\t  if (kind === undefined) {\n   108\t    // Every form names its queue site above; a miss is a wiring bug.\n   109\t    throw new Error(`no rebuild work kind mapped for derived form ${form}`);\n   110\t  }\n   111\t  return kind;\n   112\t}\n   113\t\n   114\t// The shared core (DD-8's one cascade, parameterized): drop subjects lose\n   115\t// their form rows outright; clear subjects go pending at the next source\n   116\t// version with replacement work enqueued. Supersede-deletes land before the\n   117\t// replacement enqueues so a tidied id can never collide, and queued items\n   118\t// against dropped subjects are tidied with no replacement — dead work for a\n   119\t// source that no longer reads.\n   120\tfunction runCascade(\n   121\t  ctx: OperationContext,\n   122\t  dropSubjects: readonly ChainSubject[],\n   123\t  clearSubjects: readonly ChainSubject[],\n   124\t): CascadeOutcome {\n   125\t  const readForms = ctx.db.prepare(\n   126\t    `SELECT form, source_version FROM derived_form\n   127\t     WHERE subject_kind = ? AND subject_id = ? ORDER BY form`,\n   128\t  );\n   129\t\n   130\t  const dropped: CascadeClear[] = [];\n   131\t  const supersedeTargets: Array<{ kind: WorkKind; sourceRef: WorkSourceRef }> = [];\n   132\t  const dropRows = ctx.db.prepare(\n   133\t    `DELETE FROM derived_form WHERE subject_kind = ? AND subject_id = ?`,\n   134\t  );\n   135\t  for (const subject of dropSubjects) {\n   136\t    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n   137\t      form: string;\n   138\t    }>;\n   139\t    const kinds = new Set<WorkKind>();\n   140\t    for (const row of rows) {\n   141\t      dropped.push({ ...subject, form: row.form as FormKind });\n   142\t      kinds.add(rebuildKindFor(row.form));\n   143\t    }\n   144\t    for (const kind of kinds) {\n   145\t      supersedeTargets.push({ kind, sourceRef: sourceRefFor(subject) });\n   146\t    }\n   147\t    dropRows.run(subject.subjectKind, subject.subjectId);\n   148\t  }\n   149\t\n   150\t  const cleared: CascadeClear[] = [];\n   151\t  const groups = new Map<string, RebuildGroup>();\n   152\t  for (const subject of clearSubjects) {\n   153\t    const rows = readForms.all(subject.subjectKind, subject.subjectId) as unknown as Array<{\n   154\t      form: string;\n   155\t      source_version: number | bigint;\n   156\t    }>;\n   157\t    for (const row of rows) {\n   158\t      const form = row.form as FormKind;\n   159\t      cleared.push({ ...subject, form });\n   160\t      const kind = rebuildKindFor(row.form);\n   161\t      const key = `${subject.subjectKind}:${subject.subjectId}:${kind}`;\n   162\t      const group = groups.get(key) ?? {\n   163\t        subject,\n   164\t        kind,\n   165\t        forms: [],\n   166\t        maxSourceVersion: 0,\n   167\t      };\n   168\t      group.forms.push({ subjectKind: subject.subjectKind, subjectId: subject.subjectId, form });\n   169\t      group.maxSourceVersion = Math.max(group.maxSourceVersion, Number(row.source_version));\n   170\t      groups.set(key, group);\n   171\t    }\n   172\t  }\n   173\t\n   174\t  const superseded = supersedeQueued(ctx.db, [\n   175\t    ...supersedeTargets,\n   176\t    ...[...groups.values()].map((group) => ({\n   177\t      kind: group.kind,\n   178\t      sourceRef: sourceRefFor(group.subject),\n   179\t    })),\n   180\t  ]);\n   181\t\n   182\t  const queued = [...groups.values()].map((group) => {\n   183\t    const item = enqueue(ctx, {\n   184\t      owner: WORK_KIND_REGISTRY[group.kind].owner,\n   185\t      kind: group.kind,\n   186\t      sourceRef: sourceRefFor(group.subject),\n   187\t      sourceVersion: group.maxSourceVersion + 1,\n   188\t      forms: group.forms,\n   189\t    });\n   190\t    return { workItemId: item.workItemId, kind: group.kind };\n   191\t  });\n   192\t\n   193\t  return { cleared, dropped, queued, superseded };\n   194\t}\n   195\t\n   196\t// Edit's close path: clear-and-requeue for the full chain above (and\n   197\t// including) the edited message, inside the mutation's ambient transaction.\n   198\texport function cascadeFromMessage(\n   199\t  ctx: OperationContext,\n   200\t  messageId: string,\n   201\t): CascadeOutcome {\n   202\t  return runCascade(ctx, [], chainSubjects(ctx.db, messageId));\n   203\t}\n   204\t\n   205\t// Message delete's close path (Flow 6): the deleted message's own forms\n   206\t// drop; its turn and chunk clear and re-queue for minus-one composition.\n   207\t// The message-delete validation refuses turn-initiating prompts, so the turn\n   208\t// always keeps members and never empties through this path.\n   209\texport function cascadeMessageDelete(\n   210\t  ctx: OperationContext,\n   211\t  messageId: string,\n   212\t): CascadeOutcome {\n   213\t  const [own, ...upward] = chainSubjects(ctx.db, messageId);\n   214\t  return runCascade(ctx, own === undefined ? [] : [own], upward);\n   215\t}\n   216\t\n   217\t// Turn delete's close path (Flow 6): the turn's forms and every live\n   218\t// member's forms drop — the drop-set walk goes down as well as up — and the\n   219\t// containing chunk clears and re-queues from its remaining live members.\n   220\t// A chunk left empty drops its summary forms instead: nothing remains to\n   221\t// summarize, so the forms are removed, never failed, and no rebuild queues\n   222\t// (AC-6.6). Runs after the delete stamps land, so the live-member count\n   223\t// already excludes the deleted turn. Membership rows are untouched —\n   224\t// shrink-only: reads filter deleted turns; boundaries never re-cut.\n   225\texport function cascadeTurnDelete(\n   226\t  ctx: OperationContext,\n   227\t  turnId: string,\n   228\t  memberMessageIds: readonly string[],\n   229\t): CascadeOutcome {\n   230\t  const drop: ChainSubject[] = [\n   231\t    ...memberMessageIds.map((messageId): ChainSubject => ({\n   232\t      subjectKind: \"message\",\n   233\t      subjectId: messageId,\n   234\t    })),\n   235\t    { subjectKind: \"turn\", subjectId: turnId },\n   236\t  ];\n   237\t  const chunkRow = ctx.db\n   238\t    .prepare(`SELECT chunk_id FROM chunk_member WHERE turn_id = ?`)\n   239\t    .get(turnId) as unknown as { chunk_id: string } | undefined;\n   240\t  if (chunkRow === undefined) return runCascade(ctx, drop, []);\n   241\t  const chunk: ChainSubject = { subjectKind: \"chunk\", subjectId: chunkRow.chunk_id };\n   242\t  const remaining = ctx.db\n   243\t    .prepare(\n   244\t      `SELECT COUNT(*) AS n FROM chunk_member cm\n   245\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n   246\t       WHERE cm.chunk_id = ?`,\n   247\t    )\n   248\t    .get(chunkRow.chunk_id) as unknown as { n: number | bigint };\n   249\t  return Number(remaining.n) > 0\n   250\t    ? runCascade(ctx, drop, [chunk])\n   251\t    : runCascade(ctx, [...drop, chunk], []);\n   252\t}\n","exit_code":0,"status":"completed"}}

  const threadId = meta?.thread_id ?? \"\";\n   433\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n   434\t      const target = readMutableTurn(ctx.db, input.turnId);\n   435\t      if (target === undefined) {\n   436\t        return {\n   437\t          ok: false,\n   438\t          error: {\n   439\t            errorClass: \"caller_error\",\n   440\t            code: \"turn_not_found\",\n   441\t            reason: `no turn ${input.turnId} exists in this thread`,\n   442\t          },\n   443\t        };\n   444\t      }\n   445\t      if (target.status !== \"closed\") {\n   446\t        return {\n   447\t          ok: false,\n   448\t          error: {\n   449\t            errorClass: \"caller_error\",\n   450\t            code: \"turn_open\",\n   451\t            reason: `turn ${input.turnId} is open; open turns cannot be deleted (v1 boundary)`,\n   452\t          },\n   453\t        };\n   454\t      }\n   455\t      markTurnDeleted(ctx.db, input.turnId, ctx.clock().toISOString());\n   456\t      const cascade = applyTurnDeleteCascade(ctx, input.turnId);\n   457\t      return {\n   458\t        ok: true,\n   459\t        value: {\n   460\t          changed: { messageIds: cascade.memberMessageIds, turnIds: [input.turnId] },\n   461\t          cleared: cascade.cleared,\n   462\t          dropped: cascade.dropped,\n   463\t          queued: cascade.queued,\n   464\t          superseded: cascade.superseded,\n   465\t        },\n   466\t      };\n   467\t    });\n   468\t  } catch (cause) {\n   469\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   470\t    return storageFailure(`delete failed: ${reason}`);\n","exit_code":0,"status":"completed"}}

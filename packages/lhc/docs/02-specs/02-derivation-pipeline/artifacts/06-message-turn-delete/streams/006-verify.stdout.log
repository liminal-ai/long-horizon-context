{"type":"item.completed","item":{"id":"item_71","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/mutations-delete.test.ts | sed -n '177,620p'\"","aggregated_output":"   177\tdescribe(\"TC-6.1 / AC-6.1: a deleted message leaves reads and membership; its events remain\", () => {\n   178\t  it(\"deleting a tool-result message removes it from message reads and turn membership, not from event read-back\", async () => {\n   179\t    const double = createProviderDouble();\n   180\t    const sdk = manualSdk(double);\n   181\t    const filePath = await toolRunThread(sdk);\n   182\t    const eventsBefore = unwrap(await intakeStream.listEvents({ filePath }));\n   183\t\n   184\t    const result = await messages.deleteMessage({ filePath }, { messageId: \"m3\" });\n   185\t    expect(result.ok).toBe(true);\n   186\t    if (!result.ok) return;\n   187\t    expect(result.value.changed).toEqual({ messageIds: [\"m3\"], turnIds: [] });\n   188\t\n   189\t    // Message reads exclude the deleted record.\n   190\t    const records = unwrap(await messages.listMessages({ filePath }));\n   191\t    expect(records.map((record) => record.messageId)).toEqual([\"m1\", \"m2\", \"m4\"]);\n   192\t\n   193\t    // Turn membership shrinks in place — the turn row and its boundaries\n   194\t    // untouched, the deleted member filtered out.\n   195\t    const turnRecords = unwrap(await turns.listTurns({ filePath }));\n   196\t    expect(turnRecords).toHaveLength(1);\n   197\t    expect(turnRecords[0]?.memberMessageIds).toEqual([\"m1\", \"m2\", \"m4\"]);\n   198\t\n   199\t    // The audit surface is deliberately unfiltered: every source event,\n   200\t    // byte-identical, including the deleted message's.\n   201\t    expect(unwrap(await intakeStream.listEvents({ filePath }))).toEqual(eventsBefore);\n   202\t    expect(eventsBefore.some((event) => event.eventKind === \"tool_result\")).toBe(true);\n   203\t  });\n   204\t});\n   205\t\n   206\tdescribe(\"TC-6.2 / AC-6.2 (architecture risk): delete drops own forms, re-queues upward, stops at the chunk\", () => {\n   207\t  it(\"the deleted message's forms are gone, its turn and chunk re-queue, chunk 2 is byte-stable\", async () => {\n   208\t    const double = createProviderDouble();\n   209\t    // max=1: every turn forms its own immediately closed chunk — two\n   210\t    // chunks, both with summaries (the TC-5.2 reach fixture).\n   211\t    const sdk = manualSdk(double, {\n   212\t      chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 1 },\n   213\t    });\n   214\t    const filePath = await newThread();\n   215\t    await send(sdk, filePath, [\n   216\t      validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n   217\t      validEvent(\"tool_call\"),\n   218\t      validEvent(\"tool_result\"),\n   219\t      validEvent(\"assistant_text\", { payload: { text: \"first answer\" } }),\n   220\t      validEvent(\"turn_end\"),\n   221\t    ]);\n   222\t    await send(sdk, filePath, [\n   223\t      validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n   224\t      validEvent(\"assistant_text\", { payload: { text: \"second answer\" } }),\n   225\t      validEvent(\"turn_end\"),\n   226\t    ]);\n   227\t    await drain(sdk, filePath);\n   228\t    const before = readDerivedForms(filePath);\n   229\t    expect(before.every((form) => form.state === \"ready\")).toBe(true);\n   230\t\n   231\t    const result = await messages.deleteMessage({ filePath }, { messageId: \"m3\" });\n   232\t    expect(result.ok).toBe(true);\n   233\t    if (!result.ok) return;\n   234\t\n   235\t    // The subject's own forms drop; the chain above clears — and nothing\n   236\t    // outside the chain is named.\n   237\t    expect(result.value.dropped.map(clearKey)).toEqual([\"message/m3/tool_result_summary\"]);\n   238\t    expect(result.value.cleared.map(clearKey).sort()).toEqual(\n   239\t      [\n   240\t        \"turn/t1/lower_band_projection\",\n   241\t        \"turn/t1/turn_rendering\",\n   242\t        \"chunk/c1/chunk_summary_brief\",\n   243\t        \"chunk/c1/chunk_summary_detailed\",\n   244\t      ].sort(),\n   245\t    );\n   246\t    expect(result.value.queued.map((item) => item.workItemId).sort()).toEqual([\n   247\t      \"w-c1-chunk_summary_brief-v2\",\n   248\t      \"w-c1-chunk_summary_detailed-v2\",\n   249\t      \"w-t1-turn_derivation-v2\",\n   250\t    ]);\n   251\t\n   252\t    // Dropped means rows removed — no ghost row in any state.\n   253\t    const after = readDerivedForms(filePath);\n   254\t    expect(after.some((form) => form.subjectId === \"m3\")).toBe(false);\n   255\t    // The cleared half sits pending at the bumped version and queued.\n   256\t    const clearedSet = new Set(result.value.cleared.map(clearKey));\n   257\t    for (const form of after.filter((candidate) => clearedSet.has(clearKey(candidate)))) {\n   258\t      expect(form.state).toBe(\"pending\");\n   259\t      expect(form.sourceVersion).toBe(2);\n   260\t    }\n   261\t    // Everything else — m1's and m2's message forms, t2's forms, chunk 2's\n   262\t    // summaries — deep-equals its pre-delete row, source version included.\n   263\t    expect(after.filter((form) => !clearedSet.has(clearKey(form)))).toEqual(\n   264\t      before.filter(\n   265\t        (form) => !clearedSet.has(clearKey(form)) && form.subjectId !== \"m3\",\n   266\t      ),\n   267\t    );\n   268\t\n   269\t    // The rebuild composes minus-one: the production compose path\n   270\t    // enumerates live members only (the filter at composition, proven by\n   271\t    // the capture log, not by a read API).\n   272\t    const captured = double.captureInputs();\n   273\t    await drain(sdk, filePath);\n   274\t    expect(readDerivedForms(filePath).every((form) => form.state === \"ready\")).toBe(true);\n   275\t    const recompose = captured.filter((call) => call.op === \"composeTurnRendering\");\n   276\t    expect(recompose).toHaveLength(1);\n   277\t    const parts = (recompose[0]?.input as { parts: Array<{ messageId: string }> }).parts;\n   278\t    expect(parts.map((part) => part.messageId)).toEqual([\"m1\", \"m2\", \"m4\"]);\n   279\t  });\n   280\t});\n   281\t\n   282\tdescribe(\"TC-6.3 / AC-6.3 (architecture risk): prompt protection routes to the turn surface\", () => {\n   283\t  it(\"deleting a turn-initiating prompt is refused naming the turn and the turns-delete path; nothing changes\", async () => {\n   284\t    const double = createProviderDouble();\n   285\t    const sdk = manualSdk(double);\n   286\t    const filePath = await toolRunThread(sdk);\n   287\t    const before = await snapshot(filePath);\n   288\t\n   289\t    const result = await messages.deleteMessage({ filePath }, { messageId: \"m1\" });\n   290\t    expect(result.ok).toBe(false);\n   291\t    if (result.ok) return;\n   292\t    expect(result.error.errorClass).toBe(\"caller_error\");\n   293\t    expect(result.error.code).toBe(\"message_initiates_turn\");\n   294\t    // The error names the turn and points at the turn-delete operation.\n   295\t    expect(result.error.reason).toContain(\"t1\");\n   296\t    expect(result.error.reason).toContain(\"turns.deleteTurn\");\n   297\t    expect(result.error.reason).toContain(\"turns delete\");\n   298\t\n   299\t    expect(await snapshot(filePath)).toEqual(before);\n   300\t  });\n   301\t});\n   302\t\n   303\tdescribe(\"TC-6.4 / AC-6.4: turn delete removes the turn and its messages from reads; events remain\", () => {\n   304\t  it(\"a three-message turn leaves turn reads, message reads, and chunk membership; event read-back is byte-stable\", async () => {\n   305\t    const double = createProviderDouble();\n   306\t    const sdk = manualSdk(double);\n   307\t    const filePath = await newThread();\n   308\t    await send(sdk, filePath, [\n   309\t      validEvent(\"user_prompt\", { payload: { text: \"kill this exchange\" } }),\n   310\t      validEvent(\"assistant_text\", { payload: { text: \"dead end, part one\" } }),\n   311\t      validEvent(\"assistant_text\", { payload: { text: \"dead end, part two\" } }),\n   312\t      validEvent(\"turn_end\"),\n   313\t    ]);\n   314\t    await drain(sdk, filePath);\n   315\t    const eventsBefore = unwrap(await intakeStream.listEvents({ filePath }));\n   316\t    expect(unwrap(await turns.listTurns({ filePath }))[0]?.chunkId).toBe(\"c1\");\n   317\t\n   318\t    const result = await turns.deleteTurn({ filePath }, { turnId: \"t1\" });\n   319\t    expect(result.ok).toBe(true);\n   320\t    if (!result.ok) return;\n   321\t    expect(result.value.changed).toEqual({\n   322\t      messageIds: [\"m1\", \"m2\", \"m3\"],\n   323\t      turnIds: [\"t1\"],\n   324\t    });\n   325\t    // The drop-set walk goes down as well as up: the turn's two forms and\n   326\t    // every member's own forms are rows-removed.\n   327\t    expect(result.value.dropped.map(clearKey).sort()).toEqual(\n   328\t      [\n   329\t        \"message/m1/smoothed_prompt\",\n   330\t        \"turn/t1/lower_band_projection\",\n   331\t        \"turn/t1/turn_rendering\",\n   332\t      ].sort(),\n   333\t    );\n   334\t\n   335\t    expect(unwrap(await messages.listMessages({ filePath }))).toEqual([]);\n   336\t    expect(unwrap(await turns.listTurns({ filePath }))).toEqual([]);\n   337\t    // Chunk membership shrinks in place: the chunk row remains, its member\n   338\t    // listing empties, no boundary moves.\n   339\t    const chunks = unwrap(await turns.listChunks({ filePath }));\n   340\t    expect(chunks).toHaveLength(1);\n   341\t    expect(chunks[0]?.memberTurnIds).toEqual([]);\n   342\t\n   343\t    expect(unwrap(await intakeStream.listEvents({ filePath }))).toEqual(eventsBefore);\n   344\t    expect(eventsBefore).toHaveLength(4);\n   345\t  });\n   346\t});\n   347\t\n   348\tdescribe(\"TC-6.5 / AC-6.5 (architecture risk): the chunk re-derives from remaining members; boundaries never move\", () => {\n   349\t  it(\"deleting one of chunk 1's two turns rebuilds its summaries from the survivor; chunk 2 and all boundaries are identical\", async () => {\n   350\t    const double = createProviderDouble();\n   351\t    const sdk = twoTurnChunkSdk(double);\n   352\t    const filePath = await newThread();\n   353\t    for (let n = 1; n <= 5; n += 1) await sendPromptTurn(sdk, filePath, n);\n   354\t    await drain(sdk, filePath);\n   355\t\n   356\t    // Fixture sanity: c1{t1,t2} and c2{t3,t4} closed with summaries, c3{t5}\n   357\t    // still open — exact membership by the scripted projection size.\n   358\t    const chunksBefore = readChunks(filePath);\n   359\t    expect(chunksBefore.members).toEqual([\n   360\t      { chunkId: \"c1\", turnId: \"t1\", memberIdx: 0 },\n   361\t      { chunkId: \"c1\", turnId: \"t2\", memberIdx: 1 },\n   362\t      { chunkId: \"c2\", turnId: \"t3\", memberIdx: 0 },\n   363\t      { chunkId: \"c2\", turnId: \"t4\", memberIdx: 1 },\n   364\t      { chunkId: \"c3\", turnId: \"t5\", memberIdx: 0 },\n   365\t    ]);\n   366\t    const formsBefore = readDerivedForms(filePath);\n   367\t\n   368\t    const result = await turns.deleteTurn({ filePath }, { turnId: \"t1\" });\n   369\t    expect(result.ok).toBe(true);\n   370\t    if (!result.ok) return;\n   371\t    expect(result.value.cleared.map(clearKey).sort()).toEqual([\n   372\t      \"chunk/c1/chunk_summary_brief\",\n   373\t      \"chunk/c1/chunk_summary_detailed\",\n   374\t    ]);\n   375\t    expect(result.value.queued.map((item) => item.workItemId).sort()).toEqual([\n   376\t      \"w-c1-chunk_summary_brief-v2\",\n   377\t      \"w-c1-chunk_summary_detailed-v2\",\n   378\t    ]);\n   379\t\n   380\t    const captured = double.captureInputs();\n   381\t    await drain(sdk, filePath);\n   382\t\n   383\t    // The rebuilt summaries read exactly one member projection — the\n   384\t    // double-input fixture proves the composition input excludes the\n   385\t    // deleted turn (the read path a read-API assertion would miss).\n   386\t    const detailed = captured.filter((call) => call.op === \"summarizeChunkDetailed\");\n   387\t    const brief = captured.filter((call) => call.op === \"summarizeChunkBrief\");\n   388\t    expect(detailed).toHaveLength(1);\n   389\t    expect(brief).toHaveLength(1);\n   390\t    expect((detailed[0]?.input as { memberProjections: string[] }).memberProjections).toEqual([\n   391\t      PROJ,\n   392\t    ]);\n   393\t    expect((brief[0]?.input as { memberProjections: string[] }).memberProjections).toEqual([\n   394\t      PROJ,\n   395\t    ]);\n   396\t\n   397\t    const after = readDerivedForms(filePath);\n   398\t    // Chunk 1's summaries are ready again at the next source version.\n   399\t    for (const form of after.filter((candidate) => candidate.subjectId === \"c1\")) {\n   400\t      expect(form.state).toBe(\"ready\");\n   401\t      expect(form.sourceVersion).toBe(2);\n   402\t    }\n   403\t    // No other chunk's membership or derivations changed: every form\n   404\t    // outside the deleted turn's chain — the other turns', the other\n   405\t    // messages', chunk 2's — byte-equals its pre-delete row, and the raw\n   406\t    // chunk/member tables — the boundaries — are identical (membership\n   407\t    // only ever shrinks through reads).\n   408\t    const touched = new Set([\"m1\", \"t1\", \"c1\"]);\n   409\t    expect(after.filter((form) => !touched.has(form.subjectId))).toEqual(\n   410\t      formsBefore.filter((form) => !touched.has(form.subjectId)),\n   411\t    );\n   412\t    expect(readChunks(filePath)).toEqual(chunksBefore);\n   413\t    // The live read shrinks: chunk 1 lists only the survivor.\n   414\t    const liveChunks = unwrap(await turns.listChunks({ filePath }));\n   415\t    expect(liveChunks.find((chunk) => chunk.chunkId === \"c1\")?.memberTurnIds).toEqual([\"t2\"]);\n   416\t  });\n   417\t});\n   418\t\n   419\tdescribe(\"TC-6.6 / AC-6.6 (architecture risk): an emptied chunk drops its summaries — absent, never failed\", () => {\n   420\t  it(\"deleting every turn in a chunk leaves an empty chunk with no summary rows, no queued rebuild, and clean reads\", async () => {\n   421\t    const double = createProviderDouble();\n   422\t    const sdk = twoTurnChunkSdk(double);\n   423\t    const filePath = await newThread();\n   424\t    for (let n = 1; n <= 3; n += 1) await sendPromptTurn(sdk, filePath, n);\n   425\t    await drain(sdk, filePath);\n   426\t    expect(readChunks(filePath).members.filter((member) => member.chunkId === \"c1\")).toHaveLength(\n   427\t      2,\n   428\t    );\n   429\t\n   430\t    const first = await turns.deleteTurn({ filePath }, { turnId: \"t1\" });\n   431\t    expect(first.ok).toBe(true);\n   432\t    if (!first.ok) return;\n   433\t    // One member left: the chunk clears and re-queues (the TC-6.5 path).\n   434\t    expect(first.value.queued.map((item) => item.workItemId).sort()).toEqual([\n   435\t      \"w-c1-chunk_summary_brief-v2\",\n   436\t      \"w-c1-chunk_summary_detailed-v2\",\n   437\t    ]);\n   438\t\n   439\t    const second = await turns.deleteTurn({ filePath }, { turnId: \"t2\" });\n   440\t    expect(second.ok).toBe(true);\n   441\t    if (!second.ok) return;\n   442\t    // Empties out: the summary forms drop with the last member — and the\n   443\t    // first delete's still-queued rebuilds are superseded, not run.\n   444\t    expect(second.value.cleared).toEqual([]);\n   445\t    expect(second.value.queued).toEqual([]);\n   446\t    expect(\n   447\t      second.value.dropped.filter((entry) => entry.subjectKind === \"chunk\").map(clearKey).sort(),\n   448\t    ).toEqual([\"chunk/c1/chunk_summary_brief\", \"chunk/c1/chunk_summary_detailed\"]);\n   449\t    expect([...second.value.superseded].sort()).toEqual([\n   450\t      \"w-c1-chunk_summary_brief-v2\",\n   451\t      \"w-c1-chunk_summary_detailed-v2\",\n   452\t    ]);\n   453\t\n   454\t    // Dropped, never failed: no c1 rows in any state, no failed form\n   455\t    // anywhere, no live work targeting the empty chunk.\n   456\t    const forms = readDerivedForms(filePath);\n   457\t    expect(forms.some((form) => form.subjectId === \"c1\")).toBe(false);\n   458\t    expect(forms.some((form) => form.state === \"failed\")).toBe(false);\n   459\t    expect(rawDetail(filePath)).toEqual([]);\n   460\t\n   461\t    // Reads skip the empty chunk without error: it lists with zero members\n   462\t    // and no form states; a drain finds nothing to do.\n   463\t    const chunks = unwrap(await turns.listChunks({ filePath }));\n   464\t    const emptied = chunks.find((chunk) => chunk.chunkId === \"c1\");\n   465\t    expect(emptied?.memberTurnIds).toEqual([]);\n   466\t    expect(emptied?.forms).toBeUndefined();\n   467\t    expect(unwrap(await turns.listTurns({ filePath })).map((turn) => turn.turnId)).toEqual([\n   468\t      \"t3\",\n   469\t    ]);\n   470\t    const report = await drain(sdk, filePath);\n   471\t    expect(report.ran).toEqual([]);\n   472\t  });\n   473\t});\n   474\t\n   475\tdescribe(\"TC-6.7 / AC-6.7: refusals are stable and change nothing — double delete included\", () => {\n   476\t  it(\"open-turn target, bogus id, and a second delete of the same id refuse with stable codes; the record is identical after each\", async () => {\n   477\t    const double = createProviderDouble();\n   478\t    const sdk = manualSdk(double);\n   479\t    const filePath = await newThread();\n   480\t    // t1 closed {m1 prompt, m2 answer}; t2 open {m4 prompt}.\n   481\t    await send(sdk, filePath, [\n   482\t      validEvent(\"user_prompt\", { payload: { text: \"closed prompt\" } }),\n   483\t      validEvent(\"assistant_text\", { payload: { text: \"closed answer\" } }),\n   484\t      validEvent(\"turn_end\"),\n   485\t      validEvent(\"user_prompt\", { payload: { text: \"open prompt\" } }),\n   486\t    ]);\n   487\t    await drain(sdk, filePath);\n   488\t    const before = await snapshot(filePath);\n   489\t\n   490\t    // Open-turn message: refused under the closed-turn boundary.\n   491\t    const openTurn = await messages.deleteMessage({ filePath }, { messageId: \"m4\" });\n   492\t    expect(openTurn.ok).toBe(false);\n   493\t    if (openTurn.ok) return;\n   494\t    expect(openTurn.error.errorClass).toBe(\"caller_error\");\n   495\t    expect(openTurn.error.code).toBe(\"turn_open\");\n   496\t    expect(await snapshot(filePath)).toEqual(before);\n   497\t\n   498\t    // Unknown id.\n   499\t    const missing = await messages.deleteMessage({ filePath }, { messageId: \"m99\" });\n   500\t    expect(missing.ok).toBe(false);\n   501\t    if (missing.ok) return;\n   502\t    expect(missing.error.code).toBe(\"message_not_found\");\n   503\t    expect(await snapshot(filePath)).toEqual(before);\n   504\t\n   505\t    // Double delete: the first succeeds; the second reads the filtered view\n   506\t    // and refuses as message_not_found — a refusal, not a silent success,\n   507\t    // and not a tombstone-aware error branch.\n   508\t    const firstDelete = await messages.deleteMessage({ filePath }, { messageId: \"m2\" });\n   509\t    expect(firstDelete.ok).toBe(true);\n   510\t    const afterDelete = await snapshot(filePath);\n   511\t    const secondDelete = await messages.deleteMessage({ filePath }, { messageId: \"m2\" });\n   512\t    expect(secondDelete.ok).toBe(false);\n   513\t    if (secondDelete.ok) return;\n   514\t    expect(secondDelete.error.errorClass).toBe(\"caller_error\");\n   515\t    expect(secondDelete.error.code).toBe(\"message_not_found\");\n   516\t    expect(await snapshot(filePath)).toEqual(afterDelete);\n   517\t  });\n   518\t\n   519\t  it(\"the turn surface refuses the same way: open turn, bogus id, double delete\", async () => {\n   520\t    const double = createProviderDouble();\n   521\t    const sdk = manualSdk(double);\n   522\t    const filePath = await newThread();\n   523\t    await send(sdk, filePath, [\n   524\t      validEvent(\"user_prompt\", { payload: { text: \"closed prompt\" } }),\n   525\t      validEvent(\"turn_end\"),\n   526\t      validEvent(\"user_prompt\", { payload: { text: \"open prompt\" } }),\n   527\t    ]);\n   528\t    await drain(sdk, filePath);\n   529\t    const before = await snapshot(filePath);\n   530\t\n   531\t    const openTurn = await turns.deleteTurn({ filePath }, { turnId: \"t2\" });\n   532\t    expect(openTurn.ok).toBe(false);\n   533\t    if (openTurn.ok) return;\n   534\t    expect(openTurn.error.errorClass).toBe(\"caller_error\");\n   535\t    expect(openTurn.error.code).toBe(\"turn_open\");\n   536\t    expect(await snapshot(filePath)).toEqual(before);\n   537\t\n   538\t    const missing = await turns.deleteTurn({ filePath }, { turnId: \"t99\" });\n   539\t    expect(missing.ok).toBe(false);\n   540\t    if (missing.ok) return;\n   541\t    expect(missing.error.code).toBe(\"turn_not_found\");\n   542\t    expect(await snapshot(filePath)).toEqual(before);\n   543\t\n   544\t    const firstDelete = await turns.deleteTurn({ filePath }, { turnId: \"t1\" });\n   545\t    expect(firstDelete.ok).toBe(true);\n   546\t    const afterDelete = await snapshot(filePath);\n   547\t    const secondDelete = await turns.deleteTurn({ filePath }, { turnId: \"t1\" });\n   548\t    expect(secondDelete.ok).toBe(false);\n   549\t    if (secondDelete.ok) return;\n   550\t    expect(secondDelete.error.code).toBe(\"turn_not_found\");\n   551\t    expect(await snapshot(filePath)).toEqual(afterDelete);\n   552\t  });\n   553\t\n   554\t  it(\"deleting a turn whose messages were individually deleted first still works (live-row membership walk)\", async () => {\n   555\t    const double = createProviderDouble();\n   556\t    const sdk = manualSdk(double);\n   557\t    const filePath = await newThread();\n   558\t    await send(sdk, filePath, [\n   559\t      validEvent(\"user_prompt\", { payload: { text: \"the prompt\" } }),\n   560\t      validEvent(\"assistant_text\", { payload: { text: \"answer one\" } }),\n   561\t      validEvent(\"assistant_text\", { payload: { text: \"answer two\" } }),\n   562\t      validEvent(\"turn_end\"),\n   563\t    ]);\n   564\t    await drain(sdk, filePath);\n   565\t    expect((await messages.deleteMessage({ filePath }, { messageId: \"m2\" })).ok).toBe(true);\n   566\t\n   567\t    const result = await turns.deleteTurn({ filePath }, { turnId: \"t1\" });\n   568\t    expect(result.ok).toBe(true);\n   569\t    if (!result.ok) return;\n   570\t    // Only the still-live members are stamped now; the earlier delete\n   571\t    // already removed m2 and dropped its forms.\n   572\t    expect(result.value.changed).toEqual({ messageIds: [\"m1\", \"m3\"], turnIds: [\"t1\"] });\n   573\t    expect(unwrap(await messages.listMessages({ filePath }))).toEqual([]);\n   574\t    expect(unwrap(await turns.listTurns({ filePath }))).toEqual([]);\n   575\t  });\n   576\t});\n   577\t\n   578\tdescribe(\"background mode: delete-and-walk-away (production path)\", () => {\n   579\t  it(\"the cascade's enqueue pokes ride the commit; the minus-one rebuild runs with no further call\", async () => {\n   580\t    const double = createProviderDouble();\n   581\t    const sdk = manualSdk(double, { mode: \"background\" });\n   582\t    const filePath = await newThread();\n   583\t    await send(sdk, filePath, [\n   584\t      validEvent(\"user_prompt\", { payload: { text: \"the prompt\" } }),\n   585\t      validEvent(\"tool_call\"),\n   586\t      validEvent(\"tool_result\"),\n   587\t      validEvent(\"turn_end\"),\n   588\t    ]);\n   589\t    await sdk.drainSettled({ filePath });\n   590\t    expect(readDerivedForms(filePath).every((form) => form.state === \"ready\")).toBe(true);\n   591\t\n   592\t    const result = await messages.deleteMessage({ filePath }, { messageId: \"m3\" });\n   593\t    expect(result.ok).toBe(true);\n   594\t    await sdk.drainSettled({ filePath });\n   595\t\n   596\t    const turnForms = readDerivedForms(filePath).filter((form) => form.subjectId === \"t1\");\n   597\t    expect(turnForms).toHaveLength(2);\n   598\t    expect(turnForms.every((form) => form.state === \"ready\" && form.sourceVersion === 2)).toBe(\n   599\t      true,\n   600\t    );\n   601\t    expect(rawDetail(filePath)).toEqual([]);\n   602\t  });\n   603\t});\n","exit_code":0,"status":"completed"}}

395\t      const drainFlags: { provider?: string; maxItems?: number } = {};\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_70","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/cli-process-mutations-delete.test.ts | sed -n '126,220p'\"","aggregated_output":"   126\tdescribe(\"TC-6.8 / AC-6.8: message delete and turn delete have SDK/CLI parity on twin fixtures\", () => {\n   127\t  it(\"the same message delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\", async () => {\n   128\t    const cliThread = await newThreadFile(\"cli-msg-delete\");\n   129\t    const sdkThread = await newThreadFile(\"sdk-msg-delete\");\n   130\t    await seedTwin(cliThread);\n   131\t    await seedTwin(sdkThread);\n   132\t    await drainTwins([cliThread, sdkThread]);\n   133\t    expect(readDerivedForms(cliThread)).toEqual(readDerivedForms(sdkThread));\n   134\t\n   135\t    const viaSdk = await messages.deleteMessage({ filePath: sdkThread }, { messageId: \"m3\" });\n   136\t    expect(viaSdk.ok).toBe(true);\n   137\t\n   138\t    const viaCli = runBinary([\"messages\", \"delete\", \"--file-path\", cliThread, \"--message\", \"m3\"]);\n   139\t    expect(viaCli.status).toBe(0);\n   140\t    const parsed = JSON.parse(viaCli.stdout) as OpResult<MutationResult>;\n   141\t    expect(parsed.ok).toBe(true);\n   142\t    if (!parsed.ok || !viaSdk.ok) return;\n   143\t\n   144\t    expect(parsed.value).toEqual(viaSdk.value);\n   145\t    expect(await readBack(cliThread)).toEqual(await readBack(sdkThread));\n   146\t  });\n   147\t\n   148\t  it(\"the same turn delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\", async () => {\n   149\t    const cliThread = await newThreadFile(\"cli-turn-delete\");\n   150\t    const sdkThread = await newThreadFile(\"sdk-turn-delete\");\n   151\t    await seedTwin(cliThread);\n   152\t    await seedTwin(sdkThread);\n   153\t    await drainTwins([cliThread, sdkThread]);\n   154\t\n   155\t    const viaSdk = await turns.deleteTurn({ filePath: sdkThread }, { turnId: \"t1\" });\n   156\t    expect(viaSdk.ok).toBe(true);\n   157\t\n   158\t    const viaCli = runBinary([\"turns\", \"delete\", \"--file-path\", cliThread, \"--turn\", \"t1\"]);\n   159\t    expect(viaCli.status).toBe(0);\n   160\t    const parsed = JSON.parse(viaCli.stdout) as OpResult<MutationResult>;\n   161\t    expect(parsed.ok).toBe(true);\n   162\t    if (!parsed.ok || !viaSdk.ok) return;\n   163\t\n   164\t    expect(parsed.value).toEqual(viaSdk.value);\n   165\t    expect(await readBack(cliThread)).toEqual(await readBack(sdkThread));\n   166\t  });\n   167\t\n   168\t  it(\"refusals carry the same stable codes through the CLI, exit 1, and change nothing\", async () => {\n   169\t    const threadPath = await newThreadFile(\"cli-delete-refusal\");\n   170\t    await seedTwin(threadPath);\n   171\t    await drainTwins([threadPath]);\n   172\t    const before = await readBack(threadPath);\n   173\t\n   174\t    // Prompt protection through the CLI: the refusal names the turn and the\n   175\t    // turn-delete path, matching the SDK code and class exactly.\n   176\t    const protectedPrompt = runBinary([\n   177\t      \"messages\",\n   178\t      \"delete\",\n   179\t      \"--file-path\",\n   180\t      threadPath,\n   181\t      \"--message\",\n   182\t      \"m1\",\n   183\t    ]);\n   184\t    expect(protectedPrompt.status).toBe(1);\n   185\t    const promptParsed = JSON.parse(protectedPrompt.stdout) as {\n   186\t      ok: boolean;\n   187\t      error: { errorClass: string; code: string; reason: string };\n   188\t    };\n   189\t    expect(promptParsed.ok).toBe(false);\n   190\t    expect(promptParsed.error.code).toBe(\"message_initiates_turn\");\n   191\t    expect(promptParsed.error.errorClass).toBe(\"caller_error\");\n   192\t    expect(promptParsed.error.reason).toContain(\"t1\");\n   193\t    expect(promptParsed.error.reason).toContain(\"turns delete\");\n   194\t\n   195\t    const viaSdk = await messages.deleteMessage({ filePath: threadPath }, { messageId: \"m1\" });\n   196\t    expect(viaSdk.ok).toBe(false);\n   197\t    if (viaSdk.ok) return;\n   198\t    expect(viaSdk.error.code).toBe(\"message_initiates_turn\");\n   199\t\n   200\t    const missingTurn = runBinary([\"turns\", \"delete\", \"--file-path\", threadPath, \"--turn\", \"t9\"]);\n   201\t    expect(missingTurn.status).toBe(1);\n   202\t    const turnParsed = JSON.parse(missingTurn.stdout) as { ok: boolean; error: { code: string } };\n   203\t    expect(turnParsed.ok).toBe(false);\n   204\t    expect(turnParsed.error.code).toBe(\"turn_not_found\");\n   205\t\n   206\t    expect(await readBack(threadPath)).toEqual(before);\n   207\t  });\n   208\t});\n","exit_code":0,"status":"completed"}}

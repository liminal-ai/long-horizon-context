{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/index.ts | sed -n '470,580p'\"","aggregated_output":"   470\t  }\n   471\t}\n   472\t\n   473\t// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\n   474\t\n   475\t// The record's removal mutation for one message (AC-6.1–6.3, 6.7):\n   476\t// projection-level delete — the deleted_at stamp plus the delete cascade\n   477\t// (own forms dropped, turn and chunk cleared and re-queued for minus-one\n   478\t// composition) in one transaction. The source events are never touched;\n   479\t// event read-back keeps returning them (the audit surface). Validation\n   480\t// reads the same filtered view as edit, so a missing, deleted, or\n   481\t// double-deleted target is message_not_found and an open-turn or turnless\n   482\t// gap target is turn_open. The one delete-specific refusal is prompt\n   483\t// protection: a turn is a prompt and what came back for it, so deleting the\n   484\t// turn's initiating prompt is refused toward turns.deleteTurn — the error\n   485\t// names the turn and that path (AC-6.3).\n   486\texport async function deleteMessage(\n   487\t  thread: ThreadRef,\n   488\t  input: { messageId: string },\n   489\t): Promise<OpResult<MutationResult>> {\n   490\t  const resolved = await resolveThreadRef(thread);\n   491\t  if (!resolved.ok) return resolved;\n   492\t  const { filePath } = resolved.value;\n   493\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   494\t\n   495\t  const opened = openThreadDatabase(filePath);\n   496\t  if (!opened.ok) return opened;\n   497\t  const db = opened.value;\n   498\t  try {\n   499\t    const meta = db\n   500\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   501\t      .get() as { thread_id: string } | undefined;\n   502\t    const threadId = meta?.thread_id ?? \"\";\n   503\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n   504\t      const target = readMutableMessage(ctx.db, input.messageId);\n   505\t      if (target === undefined) {\n   506\t        return {\n   507\t          ok: false,\n   508\t          error: {\n   509\t            errorClass: \"caller_error\",\n   510\t            code: \"message_not_found\",\n   511\t            reason: `no message ${input.messageId} exists in this thread`,\n   512\t          },\n   513\t        };\n   514\t      }\n   515\t      if (target.turnStatus !== \"closed\") {\n   516\t        return {\n   517\t          ok: false,\n   518\t          error: {\n   519\t            errorClass: \"caller_error\",\n   520\t            code: \"turn_open\",\n   521\t            reason:\n   522\t              target.turnStatus === \"open\"\n   523\t                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \"\"}; open-turn messages cannot be deleted (v1 boundary)`\n   524\t                : `message ${input.messageId} has no turn membership; only closed-turn messages can be deleted (v1 boundary)`,\n   525\t          },\n   526\t        };\n   527\t      }\n   528\t      if (target.initiatesTurn) {\n   529\t        return {\n   530\t          ok: false,\n   531\t          error: {\n   532\t            errorClass: \"caller_error\",\n   533\t            code: \"message_initiates_turn\",\n   534\t            reason: `message ${input.messageId} is the prompt that initiates turn ${target.turnId ?? \"\"}; a turn is a prompt and what came back for it — delete the whole exchange with turns.deleteTurn (lhc turns delete --turn-id ${target.turnId ?? \"\"})`,\n   535\t          },\n   536\t        };\n   537\t      }\n   538\t      markMessageDeleted(ctx.db, input.messageId, ctx.clock().toISOString());\n   539\t      const cascade = cascadeMessageDelete(ctx, input.messageId);\n   540\t      return {\n   541\t        ok: true,\n   542\t        value: {\n   543\t          changed: { messageIds: [input.messageId], turnIds: [] },\n   544\t          cleared: cascade.cleared,\n   545\t          dropped: cascade.dropped,\n   546\t          queued: cascade.queued,\n   547\t          superseded: cascade.superseded,\n   548\t        },\n   549\t      };\n   550\t    });\n   551\t  } catch (cause) {\n   552\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   553\t    return storageFailure(`delete failed: ${reason}`);\n   554\t  } finally {\n   555\t    db.close();\n   556\t  }\n   557\t}\n   558\t\n   559\t// Cross-domain surface for turns.deleteTurn (DD-8: one cascade module, two\n   560\t// callers), called inside the turn delete's transaction after the turn row\n   561\t// is stamped. The messages domain owns the message-table write — the member\n   562\t// stamp, scoped to live rows — and the shared cascade entry; the turns\n   563\t// operation owns its own validation and turn-row stamp. Returns the cascade\n   564\t// outcome plus the member ids stamped now (record order), which the turn\n   565\t// delete reports as its changed messages.\n   566\texport function applyTurnDeleteCascade(\n   567\t  ctx: OperationContext,\n   568\t  turnId: string,\n   569\t): CascadeOutcome & { memberMessageIds: string[] } {\n   570\t  const memberMessageIds = markTurnMessagesDeleted(\n   571\t    ctx.db,\n   572\t    turnId,\n   573\t    ctx.clock().toISOString(),\n   574\t  );\n   575\t  return { ...cascadeTurnDelete(ctx, turnId, memberMessageIds), memberMessageIds };\n   576\t}\n","exit_code":0,"status":"completed"}}

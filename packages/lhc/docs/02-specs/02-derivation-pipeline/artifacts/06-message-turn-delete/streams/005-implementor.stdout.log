{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JEhadNVBAftzAwh74wKFQr","type":"tool_result","content":"1\t// Turn-domain reads for derivation (Flow 3): the turn handler's view of its\n2\t// source turn, the member messages it composes (deleted-filtered — the\n3\t// shared read-filter rule lives here, once for this domain), the\n4\t// message-level form rows composition consumes, and the member projections\n5\t// the chunk summaries read. Completion writes for turn- and chunk-owned\n6\t// forms ride the work-queue util's `complete` (UPDATE-only, version-checked)\n7\t// — no write path here.\n8\timport type { DatabaseSync } from \"node:sqlite\";\n9\timport type {\n10\t  DependencyGap,\n11\t  DerivedForm,\n12\t  DerivedFormMetadata,\n13\t  DerivedFormState,\n14\t  FormReportEntry,\n15\t  RenderingPartKind,\n16\t  ToolRunReceipt,\n17\t} from \"../../../shared/derivation.js\";\n18\timport { reportEntryFromRow, type RawReportRow } from \"../../../shared/report.js\";\n19\timport type { ComposeFormRow, ComposeMessage } from \"./compose.js\";\n20\timport { composeFormKey } from \"./compose.js\";\n21\timport type { FormKind, SubjectKind } from \"../../../shared/derivation.js\";\n22\t\n23\texport interface TurnSource {\n24\t  turnId: string;\n25\t  status: \"open\" | \"closed\";\n26\t  deleted: boolean;\n27\t}\n28\t\n29\texport function readTurnSource(db: DatabaseSync, turnId: string): TurnSource | undefined {\n30\t  const row = db\n31\t    .prepare(`SELECT status, deleted_at FROM turns WHERE turn_id = ?`)\n32\t    .get(turnId) as unknown as { status: string; deleted_at: string | null } | undefined;\n33\t  if (row === undefined) return undefined;\n34\t  return {\n35\t    turnId,\n36\t    status: row.status as TurnSource[\"status\"],\n37\t    deleted: row.deleted_at !== null,\n38\t  };\n39\t}\n40\t\n41\t// Member messages in message order, blocks attached, deleted messages\n42\t// filtered (tech design §Mechanics: composition's member enumeration reads\n43\t// the live projection only).\n44\texport function readMemberMessages(db: DatabaseSync, turnId: string): ComposeMessage[] {\n45\t  const messages = db\n46\t    .prepare(\n47\t      `SELECT message_id, kind FROM message\n48\t       WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\n49\t    )\n50\t    .all(turnId) as unknown as Array<{ message_id: string; kind: string }>;\n51\t  const blockStmt = db.prepare(\n52\t    `SELECT block_type, content FROM message_block\n53\t     WHERE message_id = ? ORDER BY block_index`,\n54\t  );\n55\t  return messages.map((message) => {\n56\t    const blocks = blockStmt.all(message.message_id) as unknown as Array<{\n57\t      block_type: string;\n58\t      content: string;\n59\t    }>;\n60\t    return {\n61\t      messageId: message.message_id,\n62\t      kind: message.kind as RenderingPartKind,\n63\t      blocks: blocks.map((block) => ({\n64\t        blockType: block.block_type,\n65\t        content: JSON.parse(block.content) as Record<string, unknown>,\n66\t      })),\n67\t    };\n68\t  });\n69\t}\n70\t\n71\t// The message-owned form rows for a set of member messages, keyed for\n72\t// composition. A cross-owner *read* by design: composition consumes message\n73\t// forms; only message handlers ever write them (DD-2 ownership is a write\n74\t// rule).\n75\texport function readMessageFormRows(\n76\t  db: DatabaseSync,\n77\t  messageIds: readonly string[],\n78\t): Map<string, ComposeFormRow> {\n79\t  const rows = new Map<string, ComposeFormRow>();\n80\t  if (messageIds.length === 0) return rows;\n81\t  const placeholders = messageIds.map(() => \"?\").join(\", \");\n82\t  const raw = db\n83\t    .prepare(\n84\t      `SELECT subject_id, form, state, content, metadata FROM derived_form\n85\t       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\n86\t    )\n87\t    .all(...messageIds) as unknown as Array<{\n88\t    subject_id: string;\n89\t    form: string;\n90\t    state: string;\n91\t    content: string | null;\n92\t    metadata: string | null;\n93\t  }>;\n94\t  for (const row of raw) {\n95\t    const view: ComposeFormRow = { state: row.state as ComposeFormRow[\"state\"] };\n96\t    if (row.content !== null) view.content = row.content;\n97\t    if (row.metadata !== null) {\n98\t      view.metadata = JSON.parse(row.metadata) as NonNullable<ComposeFormRow[\"metadata\"]>;\n99\t    }\n100\t    rows.set(composeFormKey(row.subject_id, row.form as FormKind), view);\n101\t  }\n102\t  return rows;\n103\t}\n104\t\n105\t// Member projections in turn order for the chunk summaries: member rows by\n106\t// member_idx, deleted turns filtered, each joined to its stored\n107\t// lower_band_projection row (state + content as landed — never re-derived)\n108\t// and to its turn_rendering's mechanically stamped tool-run receipts\n109\t// (AC-3.8: the detailed summary's receipt material, read not re-derived).\n110\texport interface MemberProjection {\n111\t  turnId: string;\n112\t  state?: string; // undefined: no projection row exists for the member\n113\t  content?: string;\n114\t  receipts: ToolRunReceipt[]; // empty when the member turn had no tool activity\n115\t}\n116\t\n117\texport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\n118\t  const rows = db\n119\t    .prepare(\n120\t      `SELECT cm.turn_id, df.state, df.content, rf.metadata AS rendering_metadata\n121\t       FROM chunk_member cm\n122\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n123\t       LEFT JOIN derived_form df ON df.subject_kind = 'turn'\n124\t         AND df.subject_id = cm.turn_id AND df.form = 'lower_band_projection'\n125\t       LEFT JOIN derived_form rf ON rf.subject_kind = 'turn'\n126\t         AND rf.subject_id = cm.turn_id AND rf.form = 'turn_rendering'\n127\t       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n128\t    )\n129\t    .all(chunkId) as unknown as Array<{\n130\t    turn_id: string;\n131\t    state: string | null;\n132\t    content: string | null;\n133\t    rendering_metadata: string | null;\n134\t  }>;\n135\t  return rows.map((row) => {\n136\t    const metadata =\n137\t      row.rendering_metadata === null\n138\t        ? undefined\n139\t        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\n140\t    const projection: MemberProjection = {\n141\t      turnId: row.turn_id,\n142\t      receipts: metadata?.receipts ?? [],\n143\t    };\n144\t    if (row.state !== null) projection.state = row.state;\n145\t    if (row.content !== null) projection.content = row.content;\n146\t    return projection;\n147\t  });\n148\t}\n149\t\n150\tinterface RawOwnedFormRow {\n151\t  subject_id: string;\n152\t  form: string;\n153\t  state: string;\n154\t  content: string | null;\n155\t  reason: string | null;\n156\t  metadata: string | null;\n157\t  source_version: number | bigint;\n158\t  gaps: string | null;\n159\t  derived_at: string | null;\n160\t}\n161\t\n162\t// Every form row this owner holds for one subject kind, grouped by subject\n163\t// id — the form read-back joined onto turn and chunk reads (AC-4.7's\n164\t// \"record with form states\", mirroring messages.readMessageForms). Rows come\n165\t// back exactly as the pipeline landed them; nothing is derived at read time.\n166\texport function readOwnedForms(\n167\t  db: DatabaseSync,\n168\t  subjectKind: \"turn\" | \"chunk\",\n169\t): Map<string, DerivedForm[]> {\n170\t  const rows = db\n171\t    .prepare(\n172\t      `SELECT subject_id, form, state, content, reason, metadata,\n173\t              source_version, gaps, derived_at\n174\t       FROM derived_form WHERE subject_kind = ?\n175\t       ORDER BY subject_id, form`,\n176\t    )\n177\t    .all(subjectKind) as unknown as RawOwnedFormRow[];\n178\t  const bySubject = new Map<string, DerivedForm[]>();\n179\t  for (const row of rows) {\n180\t    const record: DerivedForm = {\n181\t      subjectKind,\n182\t      subjectId: row.subject_id,\n183\t      form: row.form as FormKind,\n184\t      state: row.state as DerivedFormState,\n185\t      sourceVersion: Number(row.source_version),\n186\t    };\n187\t    if (row.content !== null) record.content = row.content;\n188\t    if (row.reason !== null) record.reason = row.reason;\n189\t    if (row.metadata !== null) {\n190\t      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\n191\t    }\n192\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n193\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n194\t    const forms = bySubject.get(row.subject_id) ?? [];\n195\t    forms.push(record);\n196\t    bySubject.set(row.subject_id, forms);\n197\t  }\n198\t  return bySubject;\n199\t}\n200\t\n201\t// Chunk read-back rows for the listChunks surface: stored chunk state plus\n202\t// live (deleted-filtered) membership in member order.\n203\texport interface ChunkReadRow {\n204\t  chunkId: string;\n205\t  chunkOrder: number;\n206\t  status: \"open\" | \"closed\";\n207\t  accumulatedProjectedTokens: number;\n208\t  memberTurnIds: string[];\n209\t}\n210\t\n211\texport function readChunkRows(db: DatabaseSync): ChunkReadRow[] {\n212\t  const chunks = db\n213\t    .prepare(\n214\t      `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\n215\t       FROM chunk ORDER BY chunk_order`,\n216\t    )\n217\t    .all() as unknown as Array<{\n218\t    chunk_id: string;\n219\t    chunk_order: number | bigint;\n220\t    status: string;\n221\t    accumulated_projected_tokens: number | bigint;\n222\t  }>;\n223\t  const memberStmt = db.prepare(\n224\t    `SELECT cm.turn_id FROM chunk_member cm\n225\t     JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n226\t     WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n227\t  );\n228\t  return chunks.map((row) => ({\n229\t    chunkId: row.chunk_id,\n230\t    chunkOrder: Number(row.chunk_order),\n231\t    status: row.status as \"open\" | \"closed\",\n232\t    accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\n233\t    memberTurnIds: (memberStmt.all(row.chunk_id) as unknown as Array<{ turn_id: string }>).map(\n234\t      (member) => member.turn_id,\n235\t    ),\n236\t  }));\n237\t}\n238\t\n239\t// One form row by exact key for this owner's subjects — the requeue\n240\t// operation's refusal read (missing row, blocked state, current version).\n241\texport function readTurnFormRow(\n242\t  db: DatabaseSync,\n243\t  subjectKind: \"turn\" | \"chunk\",\n244\t  subjectId: string,\n245\t  form: FormKind,\n246\t): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\n247\t  const row = db\n248\t    .prepare(\n249\t      `SELECT state, reason, source_version FROM derived_form\n250\t       WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n251\t    )\n252\t    .get(subjectKind, subjectId, form) as unknown as\n253\t    | { state: string; reason: string | null; source_version: number | bigint }\n254\t    | undefined;\n255\t  if (row === undefined) return undefined;\n256\t  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\n257\t    state: row.state as DerivedFormState,\n258\t    sourceVersion: Number(row.source_version),\n259\t  };\n260\t  if (row.reason !== null) view.reason = row.reason;\n261\t  return view;\n262\t}\n263\t\n264\t// The turns owner's report (Flow 4): one query over turn- and chunk-owned\n265\t// form rows LEFT JOINed with the live work_item targeting each form at its\n266\t// current source version. Both turn forms map to the one turn_derivation\n267\t// kind; the chunk summary forms map to their same-named kinds — the CASE is\n268\t// this owner's queue-site mapping inverted, mirroring the messages report.\n269\texport function reportTurnForms(\n270\t  db: DatabaseSync,\n271\t  opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {},\n272\t): FormReportEntry[] {\n273\t  const conditions = [\"df.subject_kind IN ('turn', 'chunk')\"];\n274\t  const params: string[] = [];\n275\t  const subjectFilters: string[] = [];\n276\t  if (opts.turnId !== undefined) {\n277\t    subjectFilters.push(\"(df.subject_kind = 'turn' AND df.subject_id = ?)\");\n278\t    params.push(opts.turnId);\n279\t  }\n280\t  if (opts.chunkId !== undefined) {\n281\t    subjectFilters.push(\"(df.subject_kind = 'chunk' AND df.subject_id = ?)\");\n282\t    params.push(opts.chunkId);\n283\t  }\n284\t  if (subjectFilters.length > 0) conditions.push(`(${subjectFilters.join(\" OR \")})`);\n285\t  // notReady is exact set equality by construction: every state but ready.\n286\t  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n287\t  const rows = db\n288\t    .prepare(\n289\t      `SELECT df.subject_kind, df.subject_id, df.form, df.state, df.content, df.reason,\n290\t              df.metadata, df.source_version, df.gaps, df.derived_at,\n291\t              w.status AS queue_status, w.attempts AS queue_attempts,\n292\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n293\t       FROM derived_form df\n294\t       LEFT JOIN work_item w\n295\t         ON w.status IN ('queued', 'claimed')\n296\t        AND w.kind = CASE WHEN df.subject_kind = 'turn' THEN 'turn_derivation' ELSE df.form END\n297\t        AND json_extract(\n298\t              w.source_ref,\n299\t              CASE WHEN df.subject_kind = 'turn' THEN '$.turnId' ELSE '$.chunkId' END\n300\t            ) = df.subject_id\n301\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n302\t       WHERE ${conditions.join(\" AND \")}\n303\t       ORDER BY df.subject_kind DESC, df.subject_id, df.form`,\n304\t    )\n305\t    .all(...params) as unknown as Array<RawReportRow & { subject_kind: string }>;\n306\t  return rows.map((row) => reportEntryFromRow(row.subject_kind as SubjectKind, row));\n307\t}\n308\t\n309\texport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\n310\t  return (\n311\t    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\n312\t  );\n313\t}\n314\t"}]},"parent_tool_use_id":null,"session_id":"0b78a89b-de9b-459e-9df3-9832eb021204","uuid":"02d06b96-db65-4d01-8473-d909b41975b3","timestamp":"2026-06-11T07:48:56.302Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/turns/internal/forms.ts","content":"// Turn-domain reads for derivation (Flow 3): the turn handler's view of its\n// source turn, the member messages it composes (deleted-filtered — the\n// shared read-filter rule lives here, once for this domain), the\n// message-level form rows composition consumes, and the member projections\n// the chunk summaries read. Completion writes for turn- and chunk-owned\n// forms ride the work-queue util's `complete` (UPDATE-only, version-checked)\n// — no write path here.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type {\n  DependencyGap,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormReportEntry,\n  RenderingPartKind,\n  ToolRunReceipt,\n} from \"../../../shared/derivation.js\";\nimport { reportEntryFromRow, type RawReportRow } from \"../../../shared/report.js\";\nimport type { ComposeFormRow, ComposeMessage } from \"./compose.js\";\nimport { composeFormKey } from \"./compose.js\";\nimport type { FormKind, SubjectKind } from \"../../../shared/derivation.js\";\n\nexport interface TurnSource {\n  turnId: string;\n  status: \"open\" | \"closed\";\n  deleted: boolean;\n}\n\nexport function readTurnSource(db: DatabaseSync, turnId: string): TurnSource | undefined {\n  const row = db\n    .prepare(`SELECT status, deleted_at FROM turns WHERE turn_id = ?`)\n    .get(turnId) as unknown as { status: string; deleted_at: string | null } | undefined;\n  if (row === undefined) return undefined;\n  return {\n    turnId,\n    status: row.status as TurnSource[\"status\"],\n    deleted: row.deleted_at !== null,\n  };\n}\n\n// Member messages in message order, blocks attached, deleted messages\n// filtered (tech design §Mechanics: composition's member enumeration reads\n// the live projection only).\nexport function readMemberMessages(db: DatabaseSync, turnId: string): ComposeMessage[] {\n  const messages = db\n    .prepare(\n      `SELECT message_id, kind FROM message\n       WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\n    )\n    .all(turnId) as unknown as Array<{ message_id: string; kind: string }>;\n  const blockStmt = db.prepare(\n    `SELECT block_type, content FROM message_block\n     WHERE message_id = ? ORDER BY block_index`,\n  );\n  return messages.map((message) => {\n    const blocks = blockStmt.all(message.message_id) as unknown as Array<{\n      block_type: string;\n      content: string;\n    }>;\n    return {\n      messageId: message.message_id,\n      kind: message.kind as RenderingPartKind,\n      blocks: blocks.map((block) => ({\n        blockType: block.block_type,\n        content: JSON.parse(block.content) as Record<string, unknown>,\n      })),\n    };\n  });\n}\n\n// The message-owned form rows for a set of member messages, keyed for\n// composition. A cross-owner *read* by design: composition consumes message\n// forms; only message handlers ever write them (DD-2 ownership is a write\n// rule).\nexport function readMessageFormRows(\n  db: DatabaseSync,\n  messageIds: readonly string[],\n): Map<string, ComposeFormRow> {\n  const rows = new Map<string, ComposeFormRow>();\n  if (messageIds.length === 0) return rows;\n  const placeholders = messageIds.map(() => \"?\").join(\", \");\n  const raw = db\n    .prepare(\n      `SELECT subject_id, form, state, content, metadata FROM derived_form\n       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\n    )\n    .all(...messageIds) as unknown as Array<{\n    subject_id: string;\n    form: string;\n    state: string;\n    content: string | null;\n    metadata: string | null;\n  }>;\n  for (const row of raw) {\n    const view: ComposeFormRow = { state: row.state as ComposeFormRow[\"state\"] };\n    if (row.content !== null) view.content = row.content;\n    if (row.metadata !== null) {\n      view.metadata = JSON.parse(row.metadata) as NonNullable<ComposeFormRow[\"metadata\"]>;\n    }\n    rows.set(composeFormKey(row.subject_id, row.form as FormKind), view);\n  }\n  return rows;\n}\n\n// Member projections in turn order for the chunk summaries: member rows by\n// member_idx, deleted turns filtered, each joined to its stored\n// lower_band_projection row (state + content as landed — never re-derived)\n// and to its turn_rendering's mechanically stamped tool-run receipts\n// (AC-3.8: the detailed summary's receipt material, read not re-derived).\nexport interface MemberProjection {\n  turnId: string;\n  state?: string; // undefined: no projection row exists for the member\n  content?: string;\n  receipts: ToolRunReceipt[]; // empty when the member turn had no tool activity\n}\n\nexport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\n  const rows = db\n    .prepare(\n      `SELECT cm.turn_id, df.state, df.content, rf.metadata AS rendering_metadata\n       FROM chunk_member cm\n       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n       LEFT JOIN derived_form df ON df.subject_kind = 'turn'\n         AND df.subject_id = cm.turn_id AND df.form = 'lower_band_projection'\n       LEFT JOIN derived_form rf ON rf.subject_kind = 'turn'\n         AND rf.subject_id = cm.turn_id AND rf.form = 'turn_rendering'\n       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n    )\n    .all(chunkId) as unknown as Array<{\n    turn_id: string;\n    state: string | null;\n    content: string | null;\n    rendering_metadata: string | null;\n  }>;\n  return rows.map((row) => {\n    const metadata =\n      row.rendering_metadata === null\n        ? undefined\n        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\n    const projection: MemberProjection = {\n      turnId: row.turn_id,\n      receipts: metadata?.receipts ?? [],\n    };\n    if (row.state !== null) projection.state = row.state;\n    if (row.content !== null) projection.content = row.content;\n    return projection;\n  });\n}\n\ninterface RawOwnedFormRow {\n  subject_id: string;\n  form: string;\n  state: string;\n  content: string | null;\n  reason: string | null;\n  metadata: string | null;\n  source_version: number | bigint;\n  gaps: string | null;\n  derived_at: string | null;\n}\n\n// Every form row this owner holds for one subject kind, grouped by subject\n// id — the form read-back joined onto turn and chunk reads (AC-4.7's\n// \"record with form states\", mirroring messages.readMessageForms). Rows come\n// back exactly as the pipeline landed them; nothing is derived at read time.\nexport function readOwnedForms(\n  db: DatabaseSync,\n  subjectKind: \"turn\" | \"chunk\",\n): Map<string, DerivedForm[]> {\n  const rows = db\n    .prepare(\n      `SELECT subject_id, form, state, content, reason, metadata,\n              source_version, gaps, derived_at\n       FROM derived_form WHERE subject_kind = ?\n       ORDER BY subject_id, form`,\n    )\n    .all(subjectKind) as unknown as RawOwnedFormRow[];\n  const bySubject = new Map<string, DerivedForm[]>();\n  for (const row of rows) {\n    const record: DerivedForm = {\n      subjectKind,\n      subjectId: row.subject_id,\n      form: row.form as FormKind,\n      state: row.state as DerivedFormState,\n      sourceVersion: Number(row.source_version),\n    };\n    if (row.content !== null) record.content = row.content;\n    if (row.reason !== null) record.reason = row.reason;\n    if (row.metadata !== null) {\n      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\n    }\n    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n    const forms = bySubject.get(row.subject_id) ?? [];\n    forms.push(record);\n    bySubject.set(row.subject_id, forms);\n  }\n  return bySubject;\n}\n\n// Chunk read-back rows for the listChunks surface: stored chunk state plus\n// live (deleted-filtered) membership in member order.\nexport interface ChunkReadRow {\n  chunkId: string;\n  chunkOrder: number;\n  status: \"open\" | \"closed\";\n  accumulatedProjectedTokens: number;\n  memberTurnIds: string[];\n}\n\nexport function readChunkRows(db: DatabaseSync): ChunkReadRow[] {\n  const chunks = db\n    .prepare(\n      `SELECT chunk_id, chunk_order, status, accumulated_projected_tokens\n       FROM chunk ORDER BY chunk_order`,\n    )\n    .all() as unknown as Array<{\n    chunk_id: string;\n    chunk_order: number | bigint;\n    status: string;\n    accumulated_projected_tokens: number | bigint;\n  }>;\n  const memberStmt = db.prepare(\n    `SELECT cm.turn_id FROM chunk_member cm\n     JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n     WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n  );\n  return chunks.map((row) => ({\n    chunkId: row.chunk_id,\n    chunkOrder: Number(row.chunk_order),\n    status: row.status as \"open\" | \"closed\",\n    accumulatedProjectedTokens: Number(row.accumulated_projected_tokens),\n    memberTurnIds: (memberStmt.all(row.chunk_id) as unknown as Array<{ turn_id: string }>).map(\n      (member) => member.turn_id,\n    ),\n  }));\n}\n\n// One form row by exact key for this owner's subjects — the requeue\n// operation's refusal read (missing row, blocked state, current version).\nexport function readTurnFormRow(\n  db: DatabaseSync,\n  subjectKind: \"turn\" | \"chunk\",\n  subjectId: string,\n  form: FormKind,\n): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\n  const row = db\n    .prepare(\n      `SELECT state, reason, source_version FROM derived_form\n       WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n    )\n    .get(subjectKind, subjectId, form) as unknown as\n    | { state: string; reason: string | null; source_version: number | bigint }\n    | undefined;\n  if (row === undefined) return undefined;\n  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\n    state: row.state as DerivedFormState,\n    sourceVersion: Number(row.source_version),\n  };\n  if (row.reason !== null) view.reason = row.reason;\n  return view;\n}\n\n// The turns owner's report (Flow 4): one query over turn- and chunk-owned\n// form rows LEFT JOINed with the live work_item targeting each form at its\n// current source version. Both turn forms map to the one turn_derivation\n// kind; the chunk summary forms map to their same-named kinds — the CASE is\n// this owner's queue-site mapping inverted, mirroring the messages report.\nexport function reportTurnForms(\n  db: DatabaseSync,\n  opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {},\n): FormReportEntry[] {\n  const conditions = [\"df.subject_kind IN ('turn', 'chunk')\"];\n  const params: string[] = [];\n  const subjectFilters: string[] = [];\n  if (opts.turnId !== undefined) {\n    subjectFilters.push(\"(df.subject_kind = 'turn' AND df.subject_id = ?)\");\n    params.push(opts.turnId);\n  }\n  if (opts.chunkId !== undefined) {\n    subjectFilters.push(\"(df.subject_kind = 'chunk' AND df.subject_id = ?)\");\n    params.push(opts.chunkId);\n  }\n  if (subjectFilters.length > 0) conditions.push(`(${subjectFilters.join(\" OR \")})`);\n  // notReady is exact set equality by construction: every state but ready.\n  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n  const rows = db\n    .prepare(\n      `SELECT df.subject_kind, df.subject_id, df.form, df.state, df.content, df.reason,\n              df.metadata, df.source_version, df.gaps, df.derived_at,\n              w.status AS queue_status, w.attempts AS queue_attempts,\n              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n       FROM derived_form df\n       LEFT JOIN work_item w\n         ON w.status IN ('queued', 'claimed')\n        AND w.kind = CASE WHEN df.subject_kind = 'turn' THEN 'turn_derivation' ELSE df.form END\n        AND json_extract(\n              w.source_ref,\n              CASE WHEN df.subject_kind = 'turn' THEN '$.turnId' ELSE '$.chunkId' END\n            ) = df.subject_id\n        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n       WHERE ${conditions.join(\" AND \")}\n       ORDER BY df.subject_kind DESC, df.subject_id, df.form`,\n    )\n    .all(...params) as unknown as Array<RawReportRow & { subject_kind: string }>;\n  return rows.map((row) => reportEntryFromRow(row.subject_kind as SubjectKind, row));\n}\n\nexport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\n  return (\n    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\n  );\n}\n","numLines":314,"startLine":1,"totalLines":314}}}

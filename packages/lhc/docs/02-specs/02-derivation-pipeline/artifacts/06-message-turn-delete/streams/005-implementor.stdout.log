{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LHW5egoqWXbsP8yfS4kJMi","type":"tool_result","content":"1\t// Story 6 (Epic 02), process-boundary suite: TC-6.8 — `lhc messages delete`\n2\t// and `lhc turns delete` through the spawned dist/cli.js have full parity\n3\t// with messages.deleteMessage / turns.deleteTurn on twin fixtures: identical\n4\t// result JSON, identical cascade (queue rows), identical read-back —\n5\t// including the unfiltered event read-back, the audit surface every delete\n6\t// variant must leave byte-stable. Mutations need no provider (DD-11) — only\n7\t// the twin-building drains resolve one, in-process through the same registry\n8\t// the CLI uses. Runs under verify-all only (LHC_PROCESS_SUITE=1). New file\n9\t// by the red-manifest rule: cli-process-mutations.test.ts is hash-locked by\n10\t// Story 5 (the Story 4 precedent — green may add files, not edit).\n11\timport { spawnSync } from \"node:child_process\";\n12\timport { mkdtempSync, rmSync } from \"node:fs\";\n13\timport { tmpdir } from \"node:os\";\n14\timport path from \"node:path\";\n15\timport { fileURLToPath } from \"node:url\";\n16\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n17\timport {\n18\t  createSdk,\n19\t  intakeStream,\n20\t  messages,\n21\t  queueDetail,\n22\t  resolveNamedProvider,\n23\t  threads,\n24\t  turns,\n25\t  type MutationResult,\n26\t  type OpResult,\n27\t} from \"../src/index.js\";\n28\timport { openRaw, readDerivedForms, validEvent } from \"./fixtures/index.js\";\n29\t\n30\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n31\tconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\n32\t\n33\tfunction runBinary(args: string[]): { status: number | null; stdout: string; stderr: string } {\n34\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n35\t    encoding: \"utf8\",\n36\t    env: { ...process.env, LHC_PROVIDER: undefined },\n37\t  });\n38\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n39\t}\n40\t\n41\tlet dir: string;\n42\tbeforeEach(() => {\n43\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-delete-\"));\n44\t});\n45\tafterEach(() => {\n46\t  rmSync(dir, { recursive: true, force: true });\n47\t});\n48\t\n49\tasync function newThreadFile(name: string): Promise<string> {\n50\t  const filePath = path.join(dir, `${name}.sqlite`);\n51\t  const created = await threads.newThread({\n52\t    filePath,\n53\t    registryPath: path.join(dir, \"registry.sqlite\"),\n54\t  });\n55\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n56\t  return filePath;\n57\t}\n58\t\n59\t// One closed turn with a tool run, identical on both twins: fixed\n60\t// idempotency keys make the records comparable; the drains run in-process\n61\t// under one injected clock so derived timestamps match byte-for-byte.\n62\tasync function seedTwin(filePath: string): Promise<void> {\n63\t  const batch = [\n64\t    validEvent(\"user_prompt\", { payload: { text: \"twin delete prompt\" } }),\n65\t    validEvent(\"tool_call\"),\n66\t    validEvent(\"tool_result\"),\n67\t    validEvent(\"assistant_text\", { payload: { text: \"twin delete answer\" } }),\n68\t    validEvent(\"turn_end\"),\n69\t  ].map((event, index) => ({ ...event, idempotencyKey: `twin-delete-${index}` }));\n70\t  const seeded = await intakeStream.messageEvents({ filePath }, batch);\n71\t  if (!seeded.ok) throw new Error(`fixture batch failed: ${seeded.error.reason}`);\n72\t}\n73\t\n74\tasync function drainTwins(paths: string[]): Promise<void> {\n75\t  const provider = resolveNamedProvider(\"deterministic\");\n76\t  if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n77\t  const sdk = createSdk({\n78\t    provider,\n79\t    mode: \"manual\",\n80\t    clock: () => new Date(\"2026-06-11T00:00:00.000Z\"),\n81\t  });\n82\t  for (const filePath of paths) {\n83\t    const drained = await sdk.work.drain({ filePath });\n84\t    if (!drained.ok) throw new Error(`twin drain failed: ${drained.error.reason}`);\n85\t  }\n86\t}\n87\t\n88\tfunction rawDetailStripped(\n89\t  filePath: string,\n90\t): Array<Omit<ReturnType<typeof queueDetail>[number], \"queuedAt\">> {\n91\t  const db = openRaw(filePath);\n92\t  try {\n93\t    return queueDetail(db).map(({ queuedAt: _queuedAt, ...rest }) => rest);\n94\t  } finally {\n95\t    db.close();\n96\t  }\n97\t}\n98\t\n99\t// The twin comparison surface: every read path the delete touches plus the\n100\t// one it must not — message reads, turn reads with membership, chunk\n101\t// membership, derived forms, the live queue, and the unfiltered events.\n102\tasync function readBack(filePath: string): Promise<unknown> {\n103\t  const messageRecords = await messages.listMessages({ filePath });\n104\t  const turnRecords = await turns.listTurns({ filePath });\n105\t  const chunkRecords = await turns.listChunks({ filePath });\n106\t  const events = await intakeStream.listEvents({ filePath });\n107\t  if (!messageRecords.ok || !turnRecords.ok || !chunkRecords.ok || !events.ok) {\n108\t    throw new Error(\"read-back failed\");\n109\t  }\n110\t  return {\n111\t    messages: messageRecords.value,\n112\t    turns: turnRecords.value,\n113\t    chunks: chunkRecords.value,\n114\t    // Events carry recordedAt stamps from the twins' separate intake walls;\n115\t    // compare order, kind, and payload — the audit content.\n116\t    events: events.value.map((event) => ({\n117\t      eventOrder: event.eventOrder,\n118\t      eventKind: event.eventKind,\n119\t      payload: event.payload,\n120\t    })),\n121\t    forms: readDerivedForms(filePath),\n122\t    queue: rawDetailStripped(filePath),\n123\t  };\n124\t}\n125\t\n126\tdescribe(\"TC-6.8 / AC-6.8: message delete and turn delete have SDK/CLI parity on twin fixtures\", () => {\n127\t  it(\"the same message delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\", async () => {\n128\t    const cliThread = await newThreadFile(\"cli-msg-delete\");\n129\t    const sdkThread = await newThreadFile(\"sdk-msg-delete\");\n130\t    await seedTwin(cliThread);\n131\t    await seedTwin(sdkThread);\n132\t    await drainTwins([cliThread, sdkThread]);\n133\t    expect(readDerivedForms(cliThread)).toEqual(readDerivedForms(sdkThread));\n134\t\n135\t    const viaSdk = await messages.deleteMessage({ filePath: sdkThread }, { messageId: \"m3\" });\n136\t    expect(viaSdk.ok).toBe(true);\n137\t\n138\t    const viaCli = runBinary([\"messages\", \"delete\", \"--file-path\", cliThread, \"--message\", \"m3\"]);\n139\t    expect(viaCli.status).toBe(0);\n140\t    const parsed = JSON.parse(viaCli.stdout) as OpResult<MutationResult>;\n141\t    expect(parsed.ok).toBe(true);\n142\t    if (!parsed.ok || !viaSdk.ok) return;\n143\t\n144\t    expect(parsed.value).toEqual(viaSdk.value);\n145\t    expect(await readBack(cliThread)).toEqual(await readBack(sdkThread));\n146\t  });\n147\t\n148\t  it(\"the same turn delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\", async () => {\n149\t    const cliThread = await newThreadFile(\"cli-turn-delete\");\n150\t    const sdkThread = await newThreadFile(\"sdk-turn-delete\");\n151\t    await seedTwin(cliThread);\n152\t    await seedTwin(sdkThread);\n153\t    await drainTwins([cliThread, sdkThread]);\n154\t\n155\t    const viaSdk = await turns.deleteTurn({ filePath: sdkThread }, { turnId: \"t1\" });\n156\t    expect(viaSdk.ok).toBe(true);\n157\t\n158\t    const viaCli = runBinary([\"turns\", \"delete\", \"--file-path\", cliThread, \"--turn\", \"t1\"]);\n159\t    expect(viaCli.status).toBe(0);\n160\t    const parsed = JSON.parse(viaCli.stdout) as OpResult<MutationResult>;\n161\t    expect(parsed.ok).toBe(true);\n162\t    if (!parsed.ok || !viaSdk.ok) return;\n163\t\n164\t    expect(parsed.value).toEqual(viaSdk.value);\n165\t    expect(await readBack(cliThread)).toEqual(await readBack(sdkThread));\n166\t  });\n167\t\n168\t  it(\"refusals carry the same stable codes through the CLI, exit 1, and change nothing\", async () => {\n169\t    const threadPath = await newThreadFile(\"cli-delete-refusal\");\n170\t    await seedTwin(threadPath);\n171\t    await drainTwins([threadPath]);\n172\t    const before = await readBack(threadPath);\n173\t\n174\t    // Prompt protection through the CLI: the refusal names the turn and the\n175\t    // turn-delete path, matching the SDK code and class exactly.\n176\t    const protectedPrompt = runBinary([\n177\t      \"messages\",\n178\t      \"delete\",\n179\t      \"--file-path\",\n180\t      threadPath,\n181\t      \"--message\",\n182\t      \"m1\",\n183\t    ]);\n184\t    expect(protectedPrompt.status).toBe(1);\n185\t    const promptParsed = JSON.parse(protectedPrompt.stdout) as {\n186\t      ok: boolean;\n187\t      error: { errorClass: string; code: string; reason: string };\n188\t    };\n189\t    expect(promptParsed.ok).toBe(false);\n190\t    expect(promptParsed.error.code).toBe(\"message_initiates_turn\");\n191\t    expect(promptParsed.error.errorClass).toBe(\"caller_error\");\n192\t    expect(promptParsed.error.reason).toContain(\"t1\");\n193\t    expect(promptParsed.error.reason).toContain(\"turns delete\");\n194\t\n195\t    const viaSdk = await messages.deleteMessage({ filePath: threadPath }, { messageId: \"m1\" });\n196\t    expect(viaSdk.ok).toBe(false);\n197\t    if (viaSdk.ok) return;\n198\t    expect(viaSdk.error.code).toBe(\"message_initiates_turn\");\n199\t\n200\t    const missingTurn = runBinary([\"turns\", \"delete\", \"--file-path\", threadPath, \"--turn\", \"t9\"]);\n201\t    expect(missingTurn.status).toBe(1);\n202\t    const turnParsed = JSON.parse(missingTurn.stdout) as { ok: boolean; error: { code: string } };\n203\t    expect(turnParsed.ok).toBe(false);\n204\t    expect(turnParsed.error.code).toBe(\"turn_not_found\");\n205\t\n206\t    expect(await readBack(threadPath)).toEqual(before);\n207\t  });\n208\t});\n209\t"}]},"parent_tool_use_id":null,"session_id":"0b78a89b-de9b-459e-9df3-9832eb021204","uuid":"42de82f4-0356-4f25-9a57-1d48b5356b94","timestamp":"2026-06-11T07:50:51.470Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/cli-process-mutations-delete.test.ts","content":"// Story 6 (Epic 02), process-boundary suite: TC-6.8 — `lhc messages delete`\n// and `lhc turns delete` through the spawned dist/cli.js have full parity\n// with messages.deleteMessage / turns.deleteTurn on twin fixtures: identical\n// result JSON, identical cascade (queue rows), identical read-back —\n// including the unfiltered event read-back, the audit surface every delete\n// variant must leave byte-stable. Mutations need no provider (DD-11) — only\n// the twin-building drains resolve one, in-process through the same registry\n// the CLI uses. Runs under verify-all only (LHC_PROCESS_SUITE=1). New file\n// by the red-manifest rule: cli-process-mutations.test.ts is hash-locked by\n// Story 5 (the Story 4 precedent — green may add files, not edit).\nimport { spawnSync } from \"node:child_process\";\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createSdk,\n  intakeStream,\n  messages,\n  queueDetail,\n  resolveNamedProvider,\n  threads,\n  turns,\n  type MutationResult,\n  type OpResult,\n} from \"../src/index.js\";\nimport { openRaw, readDerivedForms, validEvent } from \"./fixtures/index.js\";\n\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\n\nfunction runBinary(args: string[]): { status: number | null; stdout: string; stderr: string } {\n  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    encoding: \"utf8\",\n    env: { ...process.env, LHC_PROVIDER: undefined },\n  });\n  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n}\n\nlet dir: string;\nbeforeEach(() => {\n  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-delete-\"));\n});\nafterEach(() => {\n  rmSync(dir, { recursive: true, force: true });\n});\n\nasync function newThreadFile(name: string): Promise<string> {\n  const filePath = path.join(dir, `${name}.sqlite`);\n  const created = await threads.newThread({\n    filePath,\n    registryPath: path.join(dir, \"registry.sqlite\"),\n  });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\n// One closed turn with a tool run, identical on both twins: fixed\n// idempotency keys make the records comparable; the drains run in-process\n// under one injected clock so derived timestamps match byte-for-byte.\nasync function seedTwin(filePath: string): Promise<void> {\n  const batch = [\n    validEvent(\"user_prompt\", { payload: { text: \"twin delete prompt\" } }),\n    validEvent(\"tool_call\"),\n    validEvent(\"tool_result\"),\n    validEvent(\"assistant_text\", { payload: { text: \"twin delete answer\" } }),\n    validEvent(\"turn_end\"),\n  ].map((event, index) => ({ ...event, idempotencyKey: `twin-delete-${index}` }));\n  const seeded = await intakeStream.messageEvents({ filePath }, batch);\n  if (!seeded.ok) throw new Error(`fixture batch failed: ${seeded.error.reason}`);\n}\n\nasync function drainTwins(paths: string[]): Promise<void> {\n  const provider = resolveNamedProvider(\"deterministic\");\n  if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n  const sdk = createSdk({\n    provider,\n    mode: \"manual\",\n    clock: () => new Date(\"2026-06-11T00:00:00.000Z\"),\n  });\n  for (const filePath of paths) {\n    const drained = await sdk.work.drain({ filePath });\n    if (!drained.ok) throw new Error(`twin drain failed: ${drained.error.reason}`);\n  }\n}\n\nfunction rawDetailStripped(\n  filePath: string,\n): Array<Omit<ReturnType<typeof queueDetail>[number], \"queuedAt\">> {\n  const db = openRaw(filePath);\n  try {\n    return queueDetail(db).map(({ queuedAt: _queuedAt, ...rest }) => rest);\n  } finally {\n    db.close();\n  }\n}\n\n// The twin comparison surface: every read path the delete touches plus the\n// one it must not — message reads, turn reads with membership, chunk\n// membership, derived forms, the live queue, and the unfiltered events.\nasync function readBack(filePath: string): Promise<unknown> {\n  const messageRecords = await messages.listMessages({ filePath });\n  const turnRecords = await turns.listTurns({ filePath });\n  const chunkRecords = await turns.listChunks({ filePath });\n  const events = await intakeStream.listEvents({ filePath });\n  if (!messageRecords.ok || !turnRecords.ok || !chunkRecords.ok || !events.ok) {\n    throw new Error(\"read-back failed\");\n  }\n  return {\n    messages: messageRecords.value,\n    turns: turnRecords.value,\n    chunks: chunkRecords.value,\n    // Events carry recordedAt stamps from the twins' separate intake walls;\n    // compare order, kind, and payload — the audit content.\n    events: events.value.map((event) => ({\n      eventOrder: event.eventOrder,\n      eventKind: event.eventKind,\n      payload: event.payload,\n    })),\n    forms: readDerivedForms(filePath),\n    queue: rawDetailStripped(filePath),\n  };\n}\n\ndescribe(\"TC-6.8 / AC-6.8: message delete and turn delete have SDK/CLI parity on twin fixtures\", () => {\n  it(\"the same message delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\", async () => {\n    const cliThread = await newThreadFile(\"cli-msg-delete\");\n    const sdkThread = await newThreadFile(\"sdk-msg-delete\");\n    await seedTwin(cliThread);\n    await seedTwin(sdkThread);\n    await drainTwins([cliThread, sdkThread]);\n    expect(readDerivedForms(cliThread)).toEqual(readDerivedForms(sdkThread));\n\n    const viaSdk = await messages.deleteMessage({ filePath: sdkThread }, { messageId: \"m3\" });\n    expect(viaSdk.ok).toBe(true);\n\n    const viaCli = runBinary([\"messages\", \"delete\", \"--file-path\", cliThread, \"--message\", \"m3\"]);\n    expect(viaCli.status).toBe(0);\n    const parsed = JSON.parse(viaCli.stdout) as OpResult<MutationResult>;\n    expect(parsed.ok).toBe(true);\n    if (!parsed.ok || !viaSdk.ok) return;\n\n    expect(parsed.value).toEqual(viaSdk.value);\n    expect(await readBack(cliThread)).toEqual(await readBack(sdkThread));\n  });\n\n  it(\"the same turn delete via SDK and spawned CLI yields identical result JSON, cascade, and read-back\", async () => {\n    const cliThread = await newThreadFile(\"cli-turn-delete\");\n    const sdkThread = await newThreadFile(\"sdk-turn-delete\");\n    await seedTwin(cliThread);\n    await seedTwin(sdkThread);\n    await drainTwins([cliThread, sdkThread]);\n\n    const viaSdk = await turns.deleteTurn({ filePath: sdkThread }, { turnId: \"t1\" });\n    expect(viaSdk.ok).toBe(true);\n\n    const viaCli = runBinary([\"turns\", \"delete\", \"--file-path\", cliThread, \"--turn\", \"t1\"]);\n    expect(viaCli.status).toBe(0);\n    const parsed = JSON.parse(viaCli.stdout) as OpResult<MutationResult>;\n    expect(parsed.ok).toBe(true);\n    if (!parsed.ok || !viaSdk.ok) return;\n\n    expect(parsed.value).toEqual(viaSdk.value);\n    expect(await readBack(cliThread)).toEqual(await readBack(sdkThread));\n  });\n\n  it(\"refusals carry the same stable codes through the CLI, exit 1, and change nothing\", async () => {\n    const threadPath = await newThreadFile(\"cli-delete-refusal\");\n    await seedTwin(threadPath);\n    await drainTwins([threadPath]);\n    const before = await readBack(threadPath);\n\n    // Prompt protection through the CLI: the refusal names the turn and the\n    // turn-delete path, matching the SDK code and class exactly.\n    const protectedPrompt = runBinary([\n      \"messages\",\n      \"delete\",\n      \"--file-path\",\n      threadPath,\n      \"--message\",\n      \"m1\",\n    ]);\n    expect(protectedPrompt.status).toBe(1);\n    const promptParsed = JSON.parse(protectedPrompt.stdout) as {\n      ok: boolean;\n      error: { errorClass: string; code: string; reason: string };\n    };\n    expect(promptParsed.ok).toBe(false);\n    expect(promptParsed.error.code).toBe(\"message_initiates_turn\");\n    expect(promptParsed.error.errorClass).toBe(\"caller_error\");\n    expect(promptParsed.error.reason).toContain(\"t1\");\n    expect(promptParsed.error.reason).toContain(\"turns delete\");\n\n    const viaSdk = await messages.deleteMessage({ filePath: threadPath }, { messageId: \"m1\" });\n    expect(viaSdk.ok).toBe(false);\n    if (viaSdk.ok) return;\n    expect(viaSdk.error.code).toBe(\"message_initiates_turn\");\n\n    const missingTurn = runBinary([\"turns\", \"delete\", \"--file-path\", threadPath, \"--turn\", \"t9\"]);\n    expect(missingTurn.status).toBe(1);\n    const turnParsed = JSON.parse(missingTurn.stdout) as { ok: boolean; error: { code: string } };\n    expect(turnParsed.ok).toBe(false);\n    expect(turnParsed.error.code).toBe(\"turn_not_found\");\n\n    expect(await readBack(threadPath)).toEqual(before);\n  });\n});\n","numLines":209,"startLine":1,"totalLines":209}}}

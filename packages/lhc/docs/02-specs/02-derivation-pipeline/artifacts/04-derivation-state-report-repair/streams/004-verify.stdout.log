{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/cli-process-report-repair.test.ts | sed -n '1,360p'\"","aggregated_output":"     1\t// Story 4 (Epic 02), process-boundary suite: CLI parity for the report and\n     2\t// requeue mirrors — `lhc messages report|requeue` and `lhc turns\n     3\t// report|requeue` through the spawned dist/cli.js produce the same result\n     4\t// JSON the SDK surfaces return (tech design CLI parity rule; supplemental\n     5\t// non-TC checks per the test plan). Report and requeue need no provider\n     6\t// (DD-11) — only the drain legs set LHC_PROVIDER. Runs under verify-all only\n     7\t// (LHC_PROCESS_SUITE=1). Lives in its own file because cli-process-work.test.ts\n     8\t// is hash-locked by the Story 1 red manifest; green may add files, not edit.\n     9\timport { spawnSync } from \"node:child_process\";\n    10\timport { mkdtempSync, rmSync } from \"node:fs\";\n    11\timport { tmpdir } from \"node:os\";\n    12\timport path from \"node:path\";\n    13\timport { fileURLToPath } from \"node:url\";\n    14\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    15\timport {\n    16\t  createSdk,\n    17\t  intakeStream,\n    18\t  messages,\n    19\t  resolveNamedProvider,\n    20\t  threads,\n    21\t  turns,\n    22\t  type FormReportEntry,\n    23\t  type OpResult,\n    24\t} from \"../src/index.js\";\n    25\timport { validEvent } from \"./fixtures/index.js\";\n    26\t\n    27\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n    28\tconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\n    29\t\n    30\tfunction runBinary(\n    31\t  args: string[],\n    32\t  env?: Record<string, string | undefined>,\n    33\t): { status: number | null; stdout: string; stderr: string } {\n    34\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    35\t    encoding: \"utf8\",\n    36\t    env: { ...process.env, ...env },\n    37\t  });\n    38\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n    39\t}\n    40\t\n    41\tlet dir: string;\n    42\tbeforeEach(() => {\n    43\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-report-\"));\n    44\t});\n    45\tafterEach(() => {\n    46\t  rmSync(dir, { recursive: true, force: true });\n    47\t});\n    48\t\n    49\tasync function newThreadFile(name: string): Promise<string> {\n    50\t  const filePath = path.join(dir, `${name}.sqlite`);\n    51\t  const created = await threads.newThread({\n    52\t    filePath,\n    53\t    registryPath: path.join(dir, \"registry.sqlite\"),\n    54\t  });\n    55\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    56\t  return filePath;\n    57\t}\n    58\t\n    59\t// One closed prompt+answer turn, identical on both twins (fixed idempotency\n    60\t// keys; report rows for an undrained thread carry no timestamps, so the twin\n    61\t// JSON compares byte-equal without clock control).\n    62\tasync function seedTwin(filePath: string): Promise<void> {\n    63\t  const batch = [\n    64\t    validEvent(\"user_prompt\", { payload: { text: \"twin report prompt\" } }),\n    65\t    validEvent(\"assistant_text\", { payload: { text: \"twin report answer\" } }),\n    66\t    validEvent(\"turn_end\"),\n    67\t  ].map((event, index) => ({ ...event, idempotencyKey: `twin-report-${index}` }));\n    68\t  const seeded = await intakeStream.messageEvents({ filePath }, batch);\n    69\t  if (!seeded.ok) throw new Error(`fixture batch failed: ${seeded.error.reason}`);\n    70\t}\n    71\t\n    72\tdescribe(\"CLI parity: report mirrors the SDK surfaces, no provider required\", () => {\n    73\t  it(\"messages and turns report JSON equals the SDK result on twin threads, including --not-ready\", async () => {\n    74\t    const cliThread = await newThreadFile(\"cli-report\");\n    75\t    const sdkThread = await newThreadFile(\"sdk-report\");\n    76\t    await seedTwin(cliThread);\n    77\t    await seedTwin(sdkThread);\n    78\t\n    79\t    const viaCli = runBinary([\"messages\", \"report\", \"--file-path\", cliThread], {\n    80\t      LHC_PROVIDER: undefined,\n    81\t    });\n    82\t    expect(viaCli.status).toBe(0);\n    83\t    const cliReport = JSON.parse(viaCli.stdout) as OpResult<FormReportEntry[]>;\n    84\t    const viaSdk = await messages.report({ filePath: sdkThread });\n    85\t    expect(cliReport).toEqual(viaSdk);\n    86\t\n    87\t    const viaCliTurns = runBinary(\n    88\t      [\"turns\", \"report\", \"--file-path\", cliThread, \"--not-ready\"],\n    89\t      { LHC_PROVIDER: undefined },\n    90\t    );\n    91\t    expect(viaCliTurns.status).toBe(0);\n    92\t    const cliTurnsReport = JSON.parse(viaCliTurns.stdout) as OpResult<FormReportEntry[]>;\n    93\t    const viaSdkTurns = await turns.report({ filePath: sdkThread }, { notReady: true });\n    94\t    expect(cliTurnsReport).toEqual(viaSdkTurns);\n    95\t    expect(cliTurnsReport.ok).toBe(true);\n    96\t    if (!cliTurnsReport.ok) return;\n    97\t    // The undrained twin is all pending with live queue detail in the rows.\n    98\t    expect(cliTurnsReport.value.map((entry) => [entry.form, entry.state])).toEqual([\n    99\t      [\"lower_band_projection\", \"pending\"],\n   100\t      [\"turn_rendering\", \"pending\"],\n   101\t    ]);\n   102\t    expect(cliTurnsReport.value[0]?.queue).toEqual({ status: \"queued\", attempts: 0 });\n   103\t  });\n   104\t\n   105\t  it(\"report on a missing thread exits 1 with thread_not_found\", async () => {\n   106\t    const missing = runBinary(\n   107\t      [\"messages\", \"report\", \"--file-path\", path.join(dir, \"nope.sqlite\")],\n   108\t      { LHC_PROVIDER: undefined },\n   109\t    );\n   110\t    expect(missing.status).toBe(1);\n   111\t    const parsed = JSON.parse(missing.stdout) as { ok: boolean; error: { code: string } };\n   112\t    expect(parsed.ok).toBe(false);\n   113\t    expect(parsed.error.code).toBe(\"thread_not_found\");\n   114\t  });\n   115\t});\n   116\t\n   117\tdescribe(\"CLI parity: requeue mirrors the SDK surfaces\", () => {\n   118\t  it(\"requeue through both owners returns identical result JSON on drained twins; the no-op and refusal legs match too\", async () => {\n   119\t    const cliThread = await newThreadFile(\"cli-requeue\");\n   120\t    const sdkThread = await newThreadFile(\"sdk-requeue\");\n   121\t    await seedTwin(cliThread);\n   122\t    await seedTwin(sdkThread);\n   123\t\n   124\t    // Drain both twins through the production provider registry (DD-11):\n   125\t    // the CLI twin via the spawned binary, the SDK twin via the same\n   126\t    // resolution seam in-process.\n   127\t    const drained = runBinary([\"work\", \"drain\", \"--file-path\", cliThread], {\n   128\t      LHC_PROVIDER: \"deterministic\",\n   129\t    });\n   130\t    expect(drained.status).toBe(0);\n   131\t    const provider = resolveNamedProvider(\"deterministic\");\n   132\t    if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n   133\t    const sdk = createSdk({ provider, mode: \"manual\" });\n   134\t    const sdkDrained = await sdk.work.drain({ filePath: sdkThread });\n   135\t    expect(sdkDrained.ok).toBe(true);\n   136\t\n   137\t    // messages.requeue parity: rebuild a ready smoothing at the next version.\n   138\t    const cliRequeue = runBinary(\n   139\t      [\n   140\t        \"messages\",\n   141\t        \"requeue\",\n   142\t        \"--file-path\",\n   143\t        cliThread,\n   144\t        \"--message-id\",\n   145\t        \"m1\",\n   146\t        \"--form\",\n   147\t        \"smoothed_prompt\",\n   148\t      ],\n   149\t      { LHC_PROVIDER: undefined },\n   150\t    );\n   151\t    expect(cliRequeue.status).toBe(0);\n   152\t    const sdkRequeue = await messages.requeue(\n   153\t      { filePath: sdkThread },\n   154\t      { messageId: \"m1\", form: \"smoothed_prompt\" },\n   155\t    );\n   156\t    expect(JSON.parse(cliRequeue.stdout)).toEqual(sdkRequeue);\n   157\t    expect(sdkRequeue.ok && sdkRequeue.value).toEqual({\n   158\t      workItemId: \"w-m1-prompt_smoothing-v2\",\n   159\t    });\n   160\t\n   161\t    // Idempotency through the CLI: the second ask is the explicit no-op.\n   162\t    const cliNoop = runBinary(\n   163\t      [\n   164\t        \"messages\",\n   165\t        \"requeue\",\n   166\t        \"--file-path\",\n   167\t        cliThread,\n   168\t        \"--message-id\",\n   169\t        \"m1\",\n   170\t        \"--form\",\n   171\t        \"smoothed_prompt\",\n   172\t      ],\n   173\t      { LHC_PROVIDER: undefined },\n   174\t    );\n   175\t    expect(cliNoop.status).toBe(0);\n   176\t    const sdkNoop = await messages.requeue(\n   177\t      { filePath: sdkThread },\n   178\t      { messageId: \"m1\", form: \"smoothed_prompt\" },\n   179\t    );\n   180\t    expect(JSON.parse(cliNoop.stdout)).toEqual(sdkNoop);\n   181\t    expect(sdkNoop.ok && sdkNoop.value).toEqual({ noop: \"already_queued\" });\n   182\t\n   183\t    // turns.requeue parity on the turn rebuild.\n   184\t    const cliTurn = runBinary(\n   185\t      [\n   186\t        \"turns\",\n   187\t        \"requeue\",\n   188\t        \"--file-path\",\n   189\t        cliThread,\n   190\t        \"--subject-kind\",\n   191\t        \"turn\",\n   192\t        \"--subject-id\",\n   193\t        \"t1\",\n   194\t        \"--form\",\n   195\t        \"turn_rendering\",\n   196\t      ],\n   197\t      { LHC_PROVIDER: undefined },\n   198\t    );\n   199\t    expect(cliTurn.status).toBe(0);\n   200\t    const sdkTurn = await turns.requeue(\n   201\t      { filePath: sdkThread },\n   202\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n   203\t    );\n   204\t    expect(JSON.parse(cliTurn.stdout)).toEqual(sdkTurn);\n   205\t    expect(sdkTurn.ok && sdkTurn.value).toEqual({ workItemId: \"w-t1-turn_derivation-v2\" });\n   206\t\n   207\t    // Refusal parity: a bogus target is the same caller error, exit 1.\n   208\t    const cliMissing = runBinary(\n   209\t      [\n   210\t        \"messages\",\n   211\t        \"requeue\",\n   212\t        \"--file-path\",\n   213\t        cliThread,\n   214\t        \"--message-id\",\n   215\t        \"m99\",\n   216\t        \"--form\",\n   217\t        \"smoothed_prompt\",\n   218\t      ],\n   219\t      { LHC_PROVIDER: undefined },\n   220\t    );\n   221\t    expect(cliMissing.status).toBe(1);\n   222\t    const sdkMissing = await messages.requeue(\n   223\t      { filePath: sdkThread },\n   224\t      { messageId: \"m99\", form: \"smoothed_prompt\" },\n   225\t    );\n   226\t    expect(JSON.parse(cliMissing.stdout)).toEqual(sdkMissing);\n   227\t    expect(!sdkMissing.ok && sdkMissing.error.code).toBe(\"message_not_found\");\n   228\t  });\n   229\t});\n","exit_code":0,"status":"completed"}}

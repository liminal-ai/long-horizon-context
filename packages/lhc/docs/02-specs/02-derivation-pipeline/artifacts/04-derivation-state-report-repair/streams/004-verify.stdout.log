{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/context.ts | sed -n '1,220p'\"","aggregated_output":"     1\timport type { DatabaseSync } from \"node:sqlite\";\n     2\t\n     3\texport interface OperationContext {\n     4\t  db: DatabaseSync; // open thread-file handle, inside the batch transaction\n     5\t  clock: () => Date; // injected for deterministic recordedAt/queuedAt in tests\n     6\t  threadId: string; // resolved identity of the thread being operated on\n     7\t  // Post-commit callback registration (DD-5): the transaction owner flushes\n     8\t  // the registered callbacks after its COMMIT succeeds and drops them on\n     9\t  // rollback, so anything registered here — the scheduler poke above all —\n    10\t  // is transactional by construction.\n    11\t  onCommit: (fn: () => void) => void;\n    12\t}\n    13\t\n    14\t// The callback list behind ctx.onCommit, owned by whoever owns the\n    15\t// transaction. Flush after COMMIT; never call flush on a rollback path —\n    16\t// dropping the hooks is simply not flushing them.\n    17\texport interface CommitHooks {\n    18\t  register: (fn: () => void) => void;\n    19\t  flush: () => void;\n    20\t}\n    21\t\n    22\texport function createCommitHooks(): CommitHooks {\n    23\t  const callbacks: Array<() => void> = [];\n    24\t  return {\n    25\t    register: (fn) => {\n    26\t      callbacks.push(fn);\n    27\t    },\n    28\t    flush: () => {\n    29\t      for (const fn of callbacks.splice(0)) fn();\n    30\t    },\n    31\t  };\n    32\t}\n    33\t\n    34\t// The scheduler poke seam (DD-5). The slot lives in shared/ so the queue\n    35\t// util can fire it without importing the scheduler module (which will import\n    36\t// domain handler tables from Story 1 on — a util→scheduler import would\n    37\t// cycle). The scheduler installs itself here; in manual mode, or before any\n    38\t// scheduler exists, firing is a no-op — onCommit still fires either way.\n    39\ttype SchedulerPoke = (threadId: string) => void;\n    40\tlet schedulerPoke: SchedulerPoke | null = null;\n    41\t\n    42\texport function setSchedulerPoke(poke: SchedulerPoke | null): void {\n    43\t  schedulerPoke = poke;\n    44\t}\n    45\t\n    46\texport function fireSchedulerPoke(threadId: string): void {\n    47\t  schedulerPoke?.(threadId);\n    48\t}\n    49\t\n    50\t// The thread-touch seam (DD-10). openThreadDatabase announces every open of a\n    51\t// thread file here, before any caller transaction begins. The background\n    52\t// scheduler installs a listener to learn threadId→filePath and to run the\n    53\t// first-touch catch-up check (one indexed query on the already-open handle);\n    54\t// with no listener installed — manual mode, or no SDK constructed — firing is\n    55\t// free. Lives in shared/ for the same reason as the poke slot: the threads\n    56\t// domain may not import the scheduler module.\n    57\ttype ThreadTouch = (filePath: string, db: DatabaseSync) => void;\n    58\tlet threadTouch: ThreadTouch | null = null;\n    59\t\n    60\texport function setThreadTouch(touch: ThreadTouch | null): void {\n    61\t  threadTouch = touch;\n    62\t}\n    63\t\n    64\texport function fireThreadTouch(filePath: string, db: DatabaseSync): void {\n    65\t  threadTouch?.(filePath, db);\n    66\t}\n    67\t\n    68\t// Transaction owner for operations outside the intake pipeline (mutations,\n    69\t// repair re-queues, tests of enqueue atomicity): BEGIN IMMEDIATE, run the\n    70\t// body with a context whose onCommit registrations flush only after COMMIT\n    71\t// succeeds and drop whole on rollback.\n    72\texport function runInTransaction<T>(\n    73\t  db: DatabaseSync,\n    74\t  clock: () => Date,\n    75\t  threadId: string,\n    76\t  fn: (ctx: OperationContext) => T,\n    77\t): T {\n    78\t  const hooks = createCommitHooks();\n    79\t  db.exec(\"BEGIN IMMEDIATE;\");\n    80\t  let value: T;\n    81\t  try {\n    82\t    value = fn({ db, clock, threadId, onCommit: hooks.register });\n    83\t    db.exec(\"COMMIT;\");\n    84\t  } catch (cause) {\n    85\t    db.exec(\"ROLLBACK;\");\n    86\t    throw cause;\n    87\t  }\n    88\t  hooks.flush();\n    89\t  return value;\n    90\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/sdk.ts | sed -n '220,420p'\"","aggregated_output":"   220\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n   221\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n   222\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n   223\t  }\n   224\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n   225\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n   226\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n   227\t    throw new TypeError(\n   228\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n   229\t    );\n   230\t  }\n   231\t\n   232\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n   233\t  // The tables are empty until Stories 2–3 land the real handlers; the\n   234\t  // assembly mechanics are production code from day one.\n   235\t  const workHandlers = assembleWorkHandlerMap([\n   236\t    messagesDomain.workHandlers,\n   237\t    turnsDomain.workHandlers,\n   238\t  ]);\n   239\t\n   240\t  const drainDeps: DrainDeps = {\n   241\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   242\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n   243\t    config: resolved,\n   244\t  };\n   245\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n   246\t\n   247\t  // Background mode wires the scheduler into the process-wide seams: enqueue\n   248\t  // pokes (DD-5) and thread-file touches (DD-10) reach it from then on, and\n   249\t  // queueing alone causes processing (AC-1.5). The slots hold one scheduler;\n   250\t  // constructing a later background SDK supersedes an earlier one (the\n   251\t  // displaced scheduler's in-memory state was advisory — the rows remain).\n   252\t  // Manual mode leaves the slots alone: pokes stay no-ops by contract.\n   253\t  if (resolved.mode === \"background\") {\n   254\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n   255\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n   256\t  }\n   257\t\n   258\t  const work: WorkSurface = {\n   259\t    drain: async (ref, opts) => {\n   260\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   261\t      if (!resolvedRef.ok) return resolvedRef;\n   262\t      return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n   263\t    },\n   264\t  };\n   265\t\n   266\t  return {\n   267\t    threads: threadsDomain,\n   268\t    intakeStream: intakeStreamDomain,\n   269\t    messages: messagesDomain,\n   270\t    turns: turnsDomain,\n   271\t    config: resolved,\n   272\t    scheduler,\n   273\t    workHandlers,\n   274\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   275\t    work,\n   276\t    drainSettled: async (ref) => {\n   277\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   278\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n   279\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n   280\t      if (threadId === null) return;\n   281\t      return scheduler.drainSettled(threadId);\n   282\t    },\n   283\t  };\n   284\t}\n","exit_code":0,"status":"completed"}}

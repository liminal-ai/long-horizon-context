{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/scheduler.ts | sed -n '1,300p'\"","aggregated_output":"     1\t// SDK-internal scheduler and drain (DD-4): the one component holding\n     2\t// cross-operation in-memory state. The drain loop lives here per the tech\n     3\t// design's placement — claim under BEGIN IMMEDIATE, dispatch through the\n     4\t// handler map with no open transaction (the provider call lives there),\n     5\t// complete in a second short transaction. Background mode adds per-thread\n     6\t// single-flight with pending-flag coalescing, post-commit pokes, first-touch\n     7\t// catch-up (DD-10), and drainSettled (issue 3). The in-memory state is\n     8\t// advisory only: cross-process safety comes from the durable lease alone, so\n     9\t// a fresh handle sees identical drain behavior — the queue is the rows.\n    10\timport { existsSync } from \"node:fs\";\n    11\timport { setImmediate as scheduleMacrotask } from \"node:timers\";\n    12\timport { DatabaseSync } from \"node:sqlite\";\n    13\timport { openThreadDatabase } from \"./domains/threads/index.js\";\n    14\timport type {\n    15\t  HandlerOutcome,\n    16\t  ResolvedSdkConfig,\n    17\t  WorkHandler,\n    18\t} from \"./shared/derivation.js\";\n    19\timport { storageFailure, type ErrorResult, type OpResult } from \"./shared/errors.js\";\n    20\timport {\n    21\t  claimNext,\n    22\t  complete,\n    23\t  countLiveItems,\n    24\t  failAttempt,\n    25\t  failTerminal,\n    26\t  type ClaimedWorkItem,\n    27\t  type WorkKind,\n    28\t  type WorkSourceRef,\n    29\t} from \"./tech-utils/work-queue/index.js\";\n    30\t\n    31\texport type SchedulerMode = \"background\" | \"manual\";\n    32\t\n    33\t// Report shape per tech design §Interfaces. `superseded` never appears here:\n    34\t// the cascade deletes superseded items and reports them on the mutation\n    35\t// result; a drain never sees them.\n    36\texport interface DrainReport {\n    37\t  ran: Array<{\n    38\t    workItemId: string;\n    39\t    kind: WorkKind;\n    40\t    sourceRef: WorkSourceRef;\n    41\t    disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\";\n    42\t    attempts: number;\n    43\t    reason?: string;\n    44\t  }>;\n    45\t  stoppedBecause: \"empty\" | \"in_flight\" | \"waiting\" | \"max_items\";\n    46\t  waitingUntil?: string; // head's eligible_at when stoppedBecause = \"waiting\"\n    47\t  remaining: number; // live items left behind the stop point\n    48\t}\n    49\t\n    50\texport interface DrainDeps {\n    51\t  lookupHandler: (kind: string) => OpResult<WorkHandler>;\n    52\t  // Whether any handler is registered at all. Background scheduling is gated\n    53\t  // on this, fail-closed: with an empty map a background drain could only\n    54\t  // turn queued rows into failed_terminal — destruction, not processing — so\n    55\t  // pokes and catch-up stay inert until a handler table is populated\n    56\t  // (Stories 2–3 in production; explicit registration in tests).\n    57\t  hasAnyHandler: () => boolean;\n    58\t  config: ResolvedSdkConfig;\n    59\t}\n    60\t\n    61\tfunction ranEntry(\n    62\t  item: ClaimedWorkItem,\n    63\t  disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\",\n    64\t  attempts: number,\n    65\t  reason?: string,\n    66\t): DrainReport[\"ran\"][number] {\n    67\t  const entry: DrainReport[\"ran\"][number] = {\n    68\t    workItemId: item.workItemId,\n    69\t    kind: item.kind as WorkKind,\n    70\t    sourceRef: item.sourceRef,\n    71\t    disposition,\n    72\t    attempts,\n    73\t  };\n    74\t  if (reason !== undefined) entry.reason = reason;\n    75\t  return entry;\n    76\t}\n    77\t\n    78\t// The drain loop against an open handle. Claim → dispatch → complete, one\n    79\t// item at a time, until the head stops it (empty / in_flight / waiting) or\n    80\t// maxItems is reached. The handler runs with NO open transaction; the only\n    81\t// exits from a handler failure are failAttempt and the terminal paths — the\n    82\t// drain never catches an error and records success.\n    83\texport async function drainOpenDb(\n    84\t  db: DatabaseSync,\n    85\t  deps: DrainDeps,\n    86\t  opts?: { maxItems?: number },\n    87\t): Promise<DrainReport> {\n    88\t  const { clock, lease, retry, provider } = deps.config;\n    89\t  const ran: DrainReport[\"ran\"] = [];\n    90\t  let stoppedBecause: DrainReport[\"stoppedBecause\"];\n    91\t  let waitingUntil: string | undefined;\n    92\t\n    93\t  for (;;) {\n    94\t    if (opts?.maxItems !== undefined && ran.length >= opts.maxItems) {\n    95\t      stoppedBecause = \"max_items\";\n    96\t      break;\n    97\t    }\n    98\t    const claim = claimNext(db, clock().toISOString(), lease.durationMs);\n    99\t    if (claim.outcome === \"empty\") {\n   100\t      stoppedBecause = \"empty\";\n   101\t      break;\n   102\t    }\n   103\t    if (claim.outcome === \"in_flight\") {\n   104\t      stoppedBecause = \"in_flight\";\n   105\t      break;\n   106\t    }\n   107\t    if (claim.outcome === \"waiting\") {\n   108\t      stoppedBecause = \"waiting\";\n   109\t      waitingUntil = claim.waitingUntil;\n   110\t      break;\n   111\t    }\n   112\t    const item = claim.item;\n   113\t\n   114\t    const lookedUp = deps.lookupHandler(item.kind);\n   115\t    if (!lookedUp.ok) {\n   116\t      // Unregistered kind: the normal terminal transaction, not a try/catch\n   117\t      // skip — failed_terminal with the stable code, form (if resolvable\n   118\t      // from the payload) lands failed, and the drain continues (AC-1.8).\n   119\t      failTerminal(db, item, {\n   120\t        reason: lookedUp.error.code,\n   121\t        formState: \"failed\",\n   122\t        attempts: item.attempts,\n   123\t        now: clock().toISOString(),\n   124\t      });\n   125\t      ran.push(ranEntry(item, \"failed_terminal\", item.attempts, lookedUp.error.code));\n   126\t      continue;\n   127\t    }\n   128\t\n   129\t    let outcome: HandlerOutcome;\n   130\t    try {\n   131\t      outcome = await lookedUp.value(\n   132\t        { openDb: () => db, provider, clock, config: deps.config },\n   133\t        {\n   134\t          workItemId: item.workItemId,\n   135\t          kind: item.kind,\n   136\t          sourceRef: item.sourceRef as unknown as Record<string, string>,\n   137\t        },\n   138\t      );\n   139\t    } catch (cause) {\n   140\t      // A throwing handler is a bug by the error contract, but the queue\n   141\t      // must not wedge on it: route it through the normal retry path so it\n   142\t      // counts attempts and exhausts visibly.\n   143\t      const detail = cause instanceof Error ? cause.message : String(cause);\n   144\t      outcome = { ok: false, retryable: true, reason: `handler threw: ${detail}` };\n   145\t    }\n   146\t\n   147\t    if (outcome.ok) {\n   148\t      const disposition = complete(\n   149\t        db,\n   150\t        item,\n   151\t        outcome.forms ?? [],\n   152\t        clock().toISOString(),\n   153\t        outcome.onApplied,\n   154\t      );\n   155\t      ran.push(ranEntry(item, disposition, item.attempts));\n   156\t      continue;\n   157\t    }\n   158\t    if (\"blocked\" in outcome) {\n   159\t      failTerminal(db, item, {\n   160\t        reason: outcome.reason,\n   161\t        formState: \"blocked\",\n   162\t        attempts: item.attempts + 1,\n   163\t        now: clock().toISOString(),\n   164\t      });\n   165\t      ran.push(ranEntry(item, \"failed_terminal\", item.attempts + 1, outcome.reason));\n   166\t      continue;\n   167\t    }\n   168\t    const failed = failAttempt(db, item, {\n   169\t      reason: outcome.reason,\n   170\t      retryable: outcome.retryable,\n   171\t      now: clock().toISOString(),\n   172\t      retry,\n   173\t    });\n   174\t    if (failed.terminal) {\n   175\t      ran.push(ranEntry(item, \"failed_terminal\", failed.attempts, outcome.reason));\n   176\t    }\n   177\t    // Under budget the item went back to queued (possibly backing off); the\n   178\t    // next claimNext re-reads the head — a backing-off head ends the drain\n   179\t    // with \"waiting\" and gates everything behind it.\n   180\t  }\n   181\t\n   182\t  const report: DrainReport = { ran, stoppedBecause, remaining: countLiveItems(db) };\n   183\t  if (waitingUntil !== undefined) report.waitingUntil = waitingUntil;\n   184\t  return report;\n   185\t}\n   186\t\n   187\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   188\t  return {\n   189\t    ok: false,\n   190\t    error: {\n   191\t      errorClass: \"caller_error\",\n   192\t      code: \"thread_not_found\",\n   193\t      reason: `no thread file exists at ${filePath}`,\n   194\t    },\n   195\t  };\n   196\t}\n   197\t\n   198\t// The drain operation against a thread file: open (validates + migrates),\n   199\t// drain, close. Both the SDK's work.drain and the background loop's passes\n   200\t// run through here — manual and background modes share one drain.\n   201\texport async function runDrain(\n   202\t  filePath: string,\n   203\t  deps: DrainDeps,\n   204\t  opts?: { maxItems?: number },\n   205\t): Promise<OpResult<DrainReport>> {\n   206\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   207\t  const opened = openThreadDatabase(filePath);\n   208\t  if (!opened.ok) return opened;\n   209\t  const db = opened.value;\n   210\t  try {\n   211\t    return { ok: true, value: await drainOpenDb(db, deps, opts) };\n   212\t  } catch (cause) {\n   213\t    const detail = cause instanceof Error ? cause.message : String(cause);\n   214\t    return storageFailure(`drain failed: ${detail}`);\n   215\t  } finally {\n   216\t    db.close();\n   217\t  }\n   218\t}\n   219\t\n   220\tinterface ThreadDrainState {\n   221\t  filePath: string;\n   222\t  running: boolean;\n   223\t  pending: boolean;\n   224\t  passes: number; // test-only observability (TC-1.2); must not become API\n   225\t  waiters: Array<() => void>;\n   226\t}\n   227\t\n   228\texport interface Scheduler {\n   229\t  readonly mode: SchedulerMode;\n   230\t  // Post-commit nudge that work was queued for a thread (DD-5). Manual mode:\n   231\t  // no-op by contract. Background mode: starts a drain, or coalesces into\n   232\t  // the pending flag if one is already running for the thread (AC-1.2).\n   233\t  poke(threadId: string): void;\n   234\t  // Thread-file open announcement (DD-10): learns threadId → filePath and,\n   235\t  // on the first touch of a thread this process lifetime, schedules a\n   236\t  // catch-up drain if the queue has leftover live work (AC-1.6).\n   237\t  touch(filePath: string, db: DatabaseSync): void;\n   238\t  // Resolves when the scheduler has no running or pending drain for the\n   239\t  // thread (issue 3). Manual mode resolves immediately.\n   240\t  drainSettled(threadId: string): Promise<void>;\n   241\t  // Test-only observability for coalescing exactness (TC-1.2): drain passes\n   242\t  // started for a thread. Named as a test hook on purpose — not API.\n   243\t  testPassCount(threadId: string): number;\n   244\t}\n   245\t\n   246\tfunction readThreadId(db: DatabaseSync): string | null {\n   247\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n   248\t    | { thread_id: string }\n   249\t    | undefined;\n   250\t  return row?.thread_id ?? null;\n   251\t}\n   252\t\n   253\t// Read a thread file's id without side effects (no migration, no touch) —\n   254\t// drainSettled must observe scheduler state, never schedule work.\n   255\texport function peekThreadId(filePath: string): string | null {\n   256\t  if (!existsSync(filePath)) return null;\n   257\t  let db: DatabaseSync | undefined;\n   258\t  try {\n   259\t    db = new DatabaseSync(filePath, { readOnly: true });\n   260\t    return readThreadId(db);\n   261\t  } catch {\n   262\t    return null;\n   263\t  } finally {\n   264\t    db?.close();\n   265\t  }\n   266\t}\n   267\t\n   268\texport function createScheduler(mode: SchedulerMode, deps: DrainDeps): Scheduler {\n   269\t  const states = new Map<string, ThreadDrainState>();\n   270\t  const seen = new Set<string>(); // first-touch catch-up guard, process lifetime\n   271\t\n   272\t  function stateFor(threadId: string): ThreadDrainState {\n   273\t    let st = states.get(threadId);\n   274\t    if (st === undefined) {\n   275\t      st = { filePath: \"\", running: false, pending: false, passes: 0, waiters: [] };\n   276\t      states.set(threadId, st);\n   277\t    }\n   278\t    return st;\n   279\t  }\n   280\t\n   281\t  async function runLoop(st: ThreadDrainState): Promise<void> {\n   282\t    // Defer past the committing operation's synchronous tail so the drain\n   283\t    // never contends with the transaction whose commit scheduled it.\n   284\t    await new Promise((resolve) => scheduleMacrotask(resolve));\n   285\t    try {\n   286\t      do {\n   287\t        st.pending = false;\n   288\t        st.passes += 1;\n   289\t        // A failed pass (storage error) has no caller to report to in\n   290\t        // background mode; the durable rows are untouched and the next poke\n   291\t        // or touch retries. A pass stopping on \"waiting\" likewise leaves the\n   292\t        // backing-off head for the next nudge — the lease and eligibility\n   293\t        // gates are durable, not timer state.\n   294\t        await runDrain(st.filePath, deps);\n   295\t      } while (st.pending);\n   296\t    } finally {\n   297\t      st.running = false;\n   298\t      for (const waiter of st.waiters.splice(0)) waiter();\n   299\t    }\n   300\t  }\n","exit_code":0,"status":"completed"}}

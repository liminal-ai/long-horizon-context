{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/report-repair.test.ts | sed -n '520,760p'\"","aggregated_output":"   520\t    expect(formOf(filePath, turnId, \"turn_rendering\")).toEqual(rendering);\n   521\t  });\n   522\t});\n   523\t\n   524\tdescribe(\"TC-4.7 / AC-4.7 (architecture risk): reads degrade, never block\", () => {\n   525\t  it(\"with every non-ready state present at once, message and turn reads return full records with states attached and zero errors\", async () => {\n   526\t    const { sdk, filePath } = await mixedStateThread();\n   527\t\n   528\t    const messagesRead = await sdk.messages.listMessages({ filePath });\n   529\t    expect(messagesRead.ok).toBe(true);\n   530\t    if (!messagesRead.ok) return;\n   531\t    expect(messagesRead.value.map((record) => record.messageId)).toEqual([\"m1\", \"m3\", \"m5\"]);\n   532\t    const formStates = new Map(\n   533\t      messagesRead.value.map((record) => [\n   534\t        record.messageId,\n   535\t        record.forms?.map((form) => form.state),\n   536\t      ]),\n   537\t    );\n   538\t    expect(formStates.get(\"m1\")).toEqual([\"failed\"]);\n   539\t    expect(formStates.get(\"m3\")).toEqual([\"ready\"]);\n   540\t    expect(formStates.get(\"m5\")).toEqual([\"pending\"]);\n   541\t\n   542\t    const turnsRead = await sdk.turns.listTurns({ filePath });\n   543\t    expect(turnsRead.ok).toBe(true);\n   544\t    if (!turnsRead.ok) return;\n   545\t    // Full records back, including the corrupt extra open turn — the read\n   546\t    // reports what is stored and never errors over incomplete derivation.\n   547\t    expect(turnsRead.value.map((record) => record.turnId)).toEqual([\"t1\", \"t2\", \"t3\", \"t4\"]);\n   548\t    expect(turnsRead.value[0]).toMatchObject({\n   549\t      turnId: \"t1\",\n   550\t      status: \"closed\",\n   551\t      memberMessageIds: [\"m1\"],\n   552\t    });\n   553\t\n   554\t    //
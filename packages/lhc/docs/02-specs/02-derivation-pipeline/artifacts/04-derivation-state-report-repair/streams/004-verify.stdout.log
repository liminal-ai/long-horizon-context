{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/report.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// The report row mapper shared by both owners' report queries (Flow 4).\n     2\t// Each domain's forms.ts owns its one-query join (owner scoping and the\n     3\t// form→kind mapping are the owner's knowledge); the raw-row → FormReportEntry\n     4\t// mapping is owner-blind and lives here so the two owners cannot drift on\n     5\t// how state, metadata, gaps, and queue detail read back (DD-2: one table,\n     6\t// one vocabulary).\n     7\timport type {\n     8\t  DependencyGap,\n     9\t  DerivedFormMetadata,\n    10\t  DerivedFormState,\n    11\t  FormKind,\n    12\t  FormReportEntry,\n    13\t  SubjectKind,\n    14\t} from \"./derivation.js\";\n    15\t\n    16\texport interface RawReportRow {\n    17\t  subject_id: string;\n    18\t  form: string;\n    19\t  state: string;\n    20\t  content: string | null;\n    21\t  reason: string | null;\n    22\t  metadata: string | null;\n    23\t  source_version: number | bigint;\n    24\t  gaps: string | null;\n    25\t  derived_at: string | null;\n    26\t  queue_status: string | null;\n    27\t  queue_attempts: number | bigint | null;\n    28\t  queue_last_error: string | null;\n    29\t  queue_eligible_at: string | null;\n    30\t}\n    31\t\n    32\texport function reportEntryFromRow(\n    33\t  subjectKind: SubjectKind,\n    34\t  row: RawReportRow,\n    35\t): FormReportEntry {\n    36\t  const entry: FormReportEntry = {\n    37\t    subjectKind,\n    38\t    subjectId: row.subject_id,\n    39\t    form: row.form as FormKind,\n    40\t    state: row.state as DerivedFormState,\n    41\t    sourceVersion: Number(row.source_version),\n    42\t  };\n    43\t  if (row.content !== null) entry.content = row.content;\n    44\t  if (row.reason !== null) entry.reason = row.reason;\n    45\t  if (row.metadata !== null) {\n    46\t    entry.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\n    47\t  }\n    48\t  if (row.gaps !== null) entry.gaps = JSON.parse(row.gaps) as DependencyGap[];\n    49\t  if (row.derived_at !== null) entry.derivedAt = row.derived_at;\n    50\t  if (row.queue_status !== null) {\n    51\t    entry.queue = {\n    52\t      status: row.queue_status as \"queued\" | \"claimed\",\n    53\t      attempts: Number(row.queue_attempts ?? 0),\n    54\t    };\n    55\t    if (row.queue_last_error !== null) entry.queue.lastError = row.queue_last_error;\n    56\t    if (row.queue_eligible_at !== null) entry.queue.eligibleAt = row.queue_eligible_at;\n    57\t  }\n    58\t  return entry;\n    59\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/index.ts | sed -n '1,380p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n     3\timport type { FormKind, FormReportEntry, WorkHandler } from \"../../shared/derivation.js\";\n     4\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     5\timport {\n     6\t  enqueue,\n     7\t  hasLiveItem,\n     8\t  listItems,\n     9\t  type WorkItemRecord,\n    10\t  type WorkKind,\n    11\t} from \"../../tech-utils/work-queue/index.js\";\n    12\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n    13\timport {\n    14\t  openThreadDatabase,\n    15\t  resolveThreadRef,\n    16\t  type ThreadRef,\n    17\t} from \"../threads/index.js\";\n    18\timport type { DerivedForm } from \"../../shared/derivation.js\";\n    19\timport {\n    20\t  findUnknownOutcomeCallSummary,\n    21\t  readMessageFormRow,\n    22\t  readMessageForms,\n    23\t  reportMessageForms,\n    24\t} from \"./internal/forms.js\";\n    25\timport { messageWorkHandlers } from \"./internal/handlers.js\";\n    26\timport { projectEvent } from \"./internal/project.js\";\n    27\timport { insertMessage, readMessages } from \"./internal/store.js\";\n    28\t\n    29\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n    30\t\n    31\texport interface Block {\n    32\t  blockType: BlockType;\n    33\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n    34\t}\n    35\t\n    36\texport interface MessageRecord {\n    37\t  messageId: string;\n    38\t  sourceEventOrder: number;\n    39\t  kind: Exclude<EventKind, \"turn_end\">;\n    40\t  blocks: Block[];\n    41\t  tokenEstimate: number;\n    42\t  actor: string;\n    43\t  harness: string;\n    44\t  turnId?: string;\n    45\t  // The message's derived forms as stored (Epic 02 Story 2): present only\n    46\t  // for messages that are derivation sources — kinds with no derivable form\n    47\t  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n    48\t  // never re-derived on read.\n    49\t  forms?: DerivedForm[];\n    50\t}\n    51\t\n    52\t// The event as the walk holds it after recording: the validated input plus\n    53\t// its server-stamped order and timestamp.\n    54\texport type RecordedEvent = EventRecord;\n    55\t\n    56\texport type MessageCreated = {\n    57\t  messageId: string;\n    58\t  kind: Exclude<EventKind, \"turn_end\">;\n    59\t  // Carried for tool activity only: the pairing key the queue sites need —\n    60\t  // tool_result projection runs the AC-2.8 late-result lookup against it.\n    61\t  toolCallId?: string;\n    62\t} | null;\n    63\t\n    64\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    65\t// (the first such call through the operation context; turns.applyEvent\n    66\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n    67\t// projection failure propagates to the pipeline's catch and rejects the\n    68\t// whole batch — recorded events without messages is the stranded state the\n    69\t// transaction exists to prevent. Returns null for turn_end (no message).\n    70\t// turnId is the membership stamp, settled by the pipeline before this call:\n    71\t// the turn open *after* this event's transition (so a prompt belongs to the\n    72\t// turn it just opened), or null in a gap — written once, never updated.\n    73\texport function createFromEvent(\n    74\t  ctx: OperationContext,\n    75\t  event: RecordedEvent,\n    76\t  turnId: string | null,\n    77\t): MessageCreated {\n    78\t  const projected = projectEvent(event);\n    79\t  if (projected === null) return null;\n    80\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n    81\t  const messageId = `m${event.eventOrder}`;\n    82\t  insertMessage(ctx.db, {\n    83\t    messageId,\n    84\t    sourceEventOrder: event.eventOrder,\n    85\t    kind,\n    86\t    tokenEstimate: projected.tokenEstimate,\n    87\t    actor: event.actor,\n    88\t    harness: event.harness,\n    89\t    turnId,\n    90\t    blocks: projected.blocks,\n    91\t  });\n    92\t  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n    93\t    return { messageId, kind, toolCallId: event.payload.toolCallId };\n    94\t  }\n    95\t  return { messageId, kind };\n    96\t}\n    97\t\n    98\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n    99\t// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n   100\t// tool result queues tool_result_summary, nothing else queues anything —\n   101\t// text, thinking, and note messages are not derivation sources (Epic 01\n   102\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n   103\t// intake-stream inside the batch transaction for every recorded message, so\n   104\t// the item commits (or rolls back) with the batch.\n   105\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n   106\t  user_prompt: \"prompt_smoothing\",\n   107\t  tool_call: \"tool_call_summary\",\n   108\t  tool_result: \"tool_result_summary\",\n   109\t};\n   110\t\n   111\t// Which derived form each message-owned kind produces — the owning domain's\n   112\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n   113\t// rides the same transaction (DD-5).\n   114\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n   115\t  prompt_smoothing: \"smoothed_prompt\",\n   116\t  tool_call_summary: \"tool_call_summary\",\n   117\t  tool_result_summary: \"tool_result_summary\",\n   118\t};\n   119\t\n   120\t// Message-owned work handlers, merged into the SDK's dispatch map at\n   121\t// construction (DD-6): prompt smoothing and the two tool-activity summaries.\n   122\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   123\t  messageWorkHandlers;\n   124\t\n   125\texport function queueMessageWork(\n   126\t  ctx: OperationContext,\n   127\t  message: MessageCreated,\n   128\t): WorkItemRecord[] {\n   129\t  if (message === null) return [];\n   130\t  const items: WorkItemRecord[] = [];\n   131\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n   132\t  if (kind !== undefined) {\n   133\t    const form = MESSAGE_WORK_FORMS[kind];\n   134\t    if (form === undefined) {\n   135\t      // Every queuing kind names its form above; a miss is a wiring bug.\n   136\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n   137\t    }\n   138\t    items.push(\n   139\t      enqueue(ctx, {\n   140\t        owner: \"messages\",\n   141\t        kind,\n   142\t        sourceRef: { messageId: message.messageId },\n   143\t        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n   144\t      }),\n   145\t    );\n   146\t  }\n   147\t  // Late-result repair (AC-2.8): a tool result landing after its call's\n   148\t  // summary already derived with outcome \"unknown\" means the summary's\n   149\t  // source — the call+result pair — completed underneath it; clear and\n   150\t  // regenerate at the next source version, in this same batch transaction.\n   151\t  // One indexed lookup; pending summaries (metadata NULL) never match, so\n   152\t  // the common call-and-result-in-one-batch case never triggers, and the\n   153\t  // version-scoped item id keeps the requeue idempotent.\n   154\t  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n   155\t    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n   156\t    if (stale !== undefined) {\n   157\t      items.push(\n   158\t        enqueue(ctx, {\n   159\t          owner: \"messages\",\n   160\t          kind: \"tool_call_summary\",\n   161\t          sourceRef: { messageId: stale.messageId },\n   162\t          sourceVersion: stale.sourceVersion + 1,\n   163\t          forms: [\n   164\t            {\n   165\t              subjectKind: \"message\",\n   166\t              subjectId: stale.messageId,\n   167\t              form: \"tool_call_summary\",\n   168\t            },\n   169\t          ],\n   170\t        }),\n   171\t      );\n   172\t    }\n   173\t  }\n   174\t  return items;\n   175\t}\n   176\t\n   177\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   178\t  return {\n   179\t    ok: false,\n   180\t    error: {\n   181\t      errorClass: \"caller_error\",\n   182\t      code: \"thread_not_found\",\n   183\t      reason: `no thread file exists at ${filePath}`,\n   184\t    },\n   185\t  };\n   186\t}\n   187\t\n   188\texport async function listMessages(\n   189\t  thread: ThreadRef,\n   190\t): Promise<OpResult<MessageRecord[]>> {\n   191\t  const resolved = await resolveThreadRef(thread);\n   192\t  if (!resolved.ok) return resolved;\n   193\t  const { filePath } = resolved.value;\n   194\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   195\t\n   196\t  // openThreadDatabase verifies the file is a real thread file and migrates\n   197\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\n   198\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\n   199\t  // unmutated (F-03-002).\n   200\t  const opened = openThreadDatabase(filePath);\n   201\t  if (!opened.ok) return opened;\n   202\t  const db = opened.value;\n   203\t  try {\n   204\t    // Form read-back rides the message read (AC-2.1): each record carries\n   205\t    // its stored derived forms, attached from one grouped query — the\n   206\t    // production path for \"readable alongside the message\".\n   207\t    const formsByMessage = readMessageForms(db);\n   208\t    const records = readMessages(db).map((record) => {\n   209\t      const forms = formsByMessage.get(record.messageId);\n   210\t      return forms === undefined ? record : { ...record, forms };\n   211\t    });\n   212\t    return { ok: true, value: records };\n   213\t  } catch (cause) {\n   214\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   215\t    return storageFailure(`message read-back failed: ${reason}`);\n   216\t  } finally {\n   217\t    db.close();\n   218\t  }\n   219\t}\n   220\t\n   221\texport async function listQueuedWork(\n   222\t  thread: ThreadRef,\n   223\t): Promise<OpResult<WorkItemRecord[]>> {\n   224\t  const resolved = await resolveThreadRef(thread);\n   225\t  if (!resolved.ok) return resolved;\n   226\t  const { filePath } = resolved.value;\n   227\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   228\t\n   229\t  const opened = openThreadDatabase(filePath);\n   230\t  if (!opened.ok) return opened;\n   231\t  const db = opened.value;\n   232\t  try {\n   233\t    return { ok: true, value: listItems(db, \"messages\") };\n   234\t  } catch (cause) {\n   235\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   236\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   237\t  } finally {\n   238\t    db.close();\n   239\t  }\n   240\t}\n   241\t\n   242\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   243\t\n   244\t// This owner's repair report: every message-owned form's durable state\n   245\t// joined with live queue detail in one query — the five operational\n   246\t// situations (waiting, retrying, ready, failed, blocked) read from the rows\n   247\t// without any queue API. Needs no provider; reads degrade, never block.\n   248\texport async function report(\n   249\t  thread: ThreadRef,\n   250\t  opts?: { notReady?: boolean; messageId?: string },\n   251\t): Promise<OpResult<FormReportEntry[]>> {\n   252\t  const resolved = await resolveThreadRef(thread);\n   253\t  if (!resolved.ok) return resolved;\n   254\t  const { filePath } = resolved.value;\n   255\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   256\t\n   257\t  const opened = openThreadDatabase(filePath);\n   258\t  if (!opened.ok) return opened;\n   259\t  const db = opened.value;\n   260\t  try {\n   261\t    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\n   262\t  } catch (cause) {\n   263\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   264\t    return storageFailure(`report read failed: ${reason}`);\n   265\t  } finally {\n   266\t    db.close();\n   267\t  }\n   268\t}\n   269\t\n   270\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n   271\t\n   272\t// Which work kind rebuilds each message-owned form — MESSAGE_WORK_FORMS\n   273\t// inverted; the requeue's join from the named form back to its queue site.\n   274\tconst MESSAGE_FORM_KINDS: Partial<Record<FormKind, WorkKind>> = {\n   275\t  smoothed_prompt: \"prompt_smoothing\",\n   276\t  tool_call_summary: \"tool_call_summary\",\n   277\t  tool_result_summary: \"tool_result_summary\",\n   278\t};\n   279\t\n   280\t// Explicit re-queue through the owning surface (AC-4.4): the public,\n   281\t// supported rebuild act. Refused for blocked forms with the form's stored\n   282\t// damage reason (AC-4.6) and for missing rows; a no-op against work already\n   283\t// queued or in flight at the form's current source version (AC-4.5).\n   284\t// Otherwise the form clears to pending and re-enqueues at the next source\n   285\t// version — the same enqueue path intake uses, poke-on-commit included, so\n   286\t// background mode processes the repair with no further call. The no-op check\n   287\t// and the enqueue commit in one transaction (anti-shim: a split would\n   288\t// reintroduce the duplicate-work race).\n   289\texport async function requeue(\n   290\t  thread: ThreadRef,\n   291\t  target: { messageId: string; form: FormKind },\n   292\t): Promise<OpResult<RequeueOutcome>> {\n   293\t  const kind = MESSAGE_FORM_KINDS[target.form];\n   294\t  if (kind === undefined) {\n   295\t    return {\n   296\t      ok: false,\n   297\t      error: {\n   298\t        errorClass: \"caller_error\",\n   299\t        code: \"message_not_found\",\n   300\t        reason: `form ${target.form} is not message-owned; messages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\n   301\t      },\n   302\t    };\n   303\t  }\n   304\t  const resolved = await resolveThreadRef(thread);\n   305\t  if (!resolved.ok) return resolved;\n   306\t  const { filePath } = resolved.value;\n   307\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   308\t\n   309\t  const opened = openThreadDatabase(filePath);\n   310\t  if (!opened.ok) return opened;\n   311\t  const db = opened.value;\n   312\t  try {\n   313\t    const meta = db\n   314\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   315\t      .get() as { thread_id: string } | undefined;\n   316\t    const threadId = meta?.thread_id ?? \"\";\n   317\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   318\t      const row = readMessageFormRow(ctx.db, target.messageId, target.form);\n   319\t      if (row === undefined) {\n   320\t        return {\n   321\t          ok: false,\n   322\t          error: {\n   323\t            errorClass: \"caller_error\",\n   324\t            code: \"message_not_found\",\n   325\t            reason: `no derived form ${target.form} exists for message ${target.messageId}`,\n   326\t          },\n   327\t        };\n   328\t      }\n   329\t      if (row.state === \"blocked\") {\n   330\t        // The refusal carries the form's stored reason — the damage named at\n   331\t        // blocking time, not a generic string (AC-4.6).\n   332\t        return {\n   333\t          ok: false,\n   334\t          error: {\n   335\t            errorClass: \"state_corruption\",\n   336\t            code: \"source_damaged\",\n   337\t            reason: row.reason ?? `form ${target.form} for message ${target.messageId} is blocked`,\n   338\t          },\n   339\t        };\n   340\t      }\n   341\t      const sourceRef = { messageId: target.messageId };\n   342\t      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\n   343\t        return { ok: true, value: { noop: \"already_queued\" } };\n   344\t      }\n   345\t      const item = enqueue(ctx, {\n   346\t        owner: \"messages\",\n   347\t        kind,\n   348\t        sourceRef,\n   349\t        sourceVersion: row.sourceVersion + 1,\n   350\t        forms: [{ subjectKind: \"message\", subjectId: target.messageId, form: target.form }],\n   351\t      });\n   352\t      return { ok: true, value: { workItemId: item.workItemId } };\n   353\t    });\n   354\t  } catch (cause) {\n   355\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   356\t    return storageFailure(`requeue failed: ${reason}`);\n   357\t  } finally {\n   358\t    db.close();\n   359\t  }\n   360\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/tech-utils/work-queue/index.ts | sed -n '1,560p'\"","aggregated_output":"     1\t// Durable work-item mechanics: recording, ordered listing, and the enqueue\n     2\t// wrapper that makes \"queueing is what schedules processing\" structural\n     3\t// (DD-5). The util is domain-blind by the tech-arch capability rule — it\n     4\t// knows the item vocabulary (owner, kind, sourceRef) but nothing about what\n     5\t// a turn or a summary is; which kinds queue for which sources, and which\n     6\t// derived forms a kind produces, is the owning domains' business (callers\n     7\t// pass the form targets in). Writes run on the caller's handle inside the\n     8\t// ambient transaction, so items commit (or roll back) with the batch. No\n     9\t// public SDK surface: read-back reaches here only through the owning\n    10\t// domains' listQueuedWork.\n    11\timport type { DatabaseSync } from \"node:sqlite\";\n    12\timport {\n    13\t  createCommitHooks,\n    14\t  fireSchedulerPoke,\n    15\t  type OperationContext,\n    16\t} from \"../../shared/context.js\";\n    17\timport type {\n    18\t  CompletionTx,\n    19\t  FormKind,\n    20\t  HandlerFormWrite,\n    21\t  SubjectKind,\n    22\t} from \"../../shared/derivation.js\";\n    23\t\n    24\texport type WorkOwner = \"messages\" | \"turns\";\n    25\texport type WorkKind =\n    26\t  | \"prompt_smoothing\"\n    27\t  | \"tool_call_summary\"\n    28\t  | \"tool_result_summary\"\n    29\t  | \"turn_derivation\"\n    30\t  | \"chunk_summary_detailed\"\n    31\t  | \"chunk_summary_brief\";\n    32\texport type WorkSourceRef = { messageId: string } | { turnId: string } | { chunkId: string };\n    33\t\n    34\t// The work-kind registry: owner and sourceRef semantics per the epic's Work\n    35\t// Item contract. Mechanical metadata only — what a kind *means* stays with\n    36\t// the owning domain's handler (registered at SDK construction, DD-6).\n    37\texport const WORK_KIND_REGISTRY: Readonly<\n    38\t  Record<WorkKind, { owner: WorkOwner; sourceRefKey: \"messageId\" | \"turnId\" | \"chunkId\" }>\n    39\t> = {\n    40\t  prompt_smoothing: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    41\t  tool_call_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    42\t  tool_result_summary: { owner: \"messages\", sourceRefKey: \"messageId\" },\n    43\t  turn_derivation: { owner: \"turns\", sourceRefKey: \"turnId\" },\n    44\t  chunk_summary_detailed: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n    45\t  chunk_summary_brief: { owner: \"turns\", sourceRefKey: \"chunkId\" },\n    46\t};\n    47\t\n    48\texport interface WorkItemRecord {\n    49\t  workItemId: string;\n    50\t  owner: WorkOwner;\n    51\t  kind: WorkKind;\n    52\t  sourceRef: WorkSourceRef;\n    53\t  status: \"queued\"; // the only status written before a drain claims (Epic 02 Story 1)\n    54\t  queuedAt: string;\n    55\t}\n    56\t\n    57\t// The derived forms an enqueue is scheduling work toward; the owning domain\n    58\t// names them (the util stays meaning-blind). Stored in the row's payload so\n    59\t// the drain's terminal paths (retry exhaustion, blocked source) can land the\n    60\t// form's failed/blocked state without asking any domain what a kind means.\n    61\texport interface EnqueueFormTarget {\n    62\t  subjectKind: SubjectKind;\n    63\t  subjectId: string;\n    64\t  form: FormKind;\n    65\t}\n    66\t\n    67\texport interface WorkItemInput {\n    68\t  owner: WorkOwner;\n    69\t  kind: WorkKind;\n    70\t  sourceRef: WorkSourceRef;\n    71\t  sourceVersion?: number; // defaults to 1 — first version of a fresh source\n    72\t  forms?: readonly EnqueueFormTarget[]; // carried in payload for the drain's terminal paths\n    73\t}\n    74\t\n    75\tfunction sourceIdOf(sourceRef: WorkSourceRef): string {\n    76\t  if (\"messageId\" in sourceRef) return sourceRef.messageId;\n    77\t  if (\"turnId\" in sourceRef) return sourceRef.turnId;\n    78\t  return sourceRef.chunkId;\n    79\t}\n    80\t\n    81\t// Deterministic id scoped to the source version (DD-1/DD-3): re-queueing the\n    82\t// same kind for the same source *at the same version* is the same id —\n    83\t// natural idempotency for the repair path — while a post-mutation\n    84\t// replacement (next version) never collides with an in-flight pre-mutation\n    85\t// item.\n    86\texport function recordItem(\n    87\t  db: DatabaseSync,\n    88\t  input: WorkItemInput,\n    89\t  queuedAt: string,\n    90\t): WorkItemRecord {\n    91\t  const sourceVersion = input.sourceVersion ?? 1;\n    92\t  const workItemId = `w-${sourceIdOf(input.sourceRef)}-${input.kind}-v${sourceVersion}`;\n    93\t  db.prepare(\n    94\t    `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at, payload)\n    95\t     VALUES (?, ?, ?, ?, 'queued', ?, ?)`,\n    96\t  ).run(\n    97\t    workItemId,\n    98\t    input.owner,\n    99\t    input.kind,\n   100\t    JSON.stringify(input.sourceRef),\n   101\t    queuedAt,\n   102\t    JSON.stringify({ sourceVersion, forms: input.forms ?? [] }),\n   103\t  );\n   104\t  return {\n   105\t    workItemId,\n   106\t    owner: input.owner,\n   107\t    kind: input.kind,\n   108\t    sourceRef: input.sourceRef,\n   109\t    status: \"queued\",\n   110\t    queuedAt,\n   111\t  };\n   112\t}\n   113\t\n   114\texport interface EnqueueInput extends WorkItemInput {\n   115\t  forms: readonly EnqueueFormTarget[];\n   116\t}\n   117\t\n   118\t// The one way work is scheduled (DD-5): the work row, the form's `pending`\n   119\t// state row, and the scheduler poke all ride the ambient transaction — they\n   120\t// commit together or vanish together. Enqueue is the *only* place a\n   121\t// derived_form row is created (completion is UPDATE-only); re-enqueueing\n   122\t// resets an existing row to pending at the enqueued source version.\n   123\texport function enqueue(ctx: OperationContext, input: EnqueueInput): WorkItemRecord {\n   124\t  const item = recordItem(ctx.db, input, ctx.clock().toISOString());\n   125\t  const sourceVersion = input.sourceVersion ?? 1;\n   126\t  const upsert = ctx.db.prepare(\n   127\t    `INSERT INTO derived_form (subject_kind, subject_id, form, state, source_version)\n   128\t     VALUES (?, ?, ?, 'pending', ?)\n   129\t     ON CONFLICT (subject_kind, subject_id, form) DO UPDATE SET\n   130\t       state = 'pending', content = NULL, reason = NULL, metadata = NULL,\n   131\t       gaps = NULL, derived_at = NULL, source_version = excluded.source_version`,\n   132\t  );\n   133\t  for (const target of input.forms) {\n   134\t    upsert.run(target.subjectKind, target.subjectId, target.form, sourceVersion);\n   135\t  }\n   136\t  ctx.onCommit(() => fireSchedulerPoke(ctx.threadId));\n   137\t  return item;\n   138\t}\n   139\t\n   140\tinterface RawWorkItemRow {\n   141\t  work_item_id: string;\n   142\t  owner: string;\n   143\t  kind: string;\n   144\t  source_ref: string;\n   145\t  queued_at: string;\n   146\t}\n   147\t\n   148\t// ── claim mechanics (Epic 02 Story 1, tech design §Mechanics) ─────\n   149\t// All pure SQL against the caller's open handle, domain-blind. Claim,\n   150\t// complete, and the terminal half of failAttempt each own one short\n   151\t// BEGIN IMMEDIATE; the handler in between runs with no open transaction.\n   152\t\n   153\t// The claimed row as the drain holds it: mechanical fields plus the payload's\n   154\t// source version and form targets. `kind` is a plain string here — a raw row\n   155\t// with an unregistered kind must still be claimable so the drain can land it\n   156\t// failed_terminal instead of skipping it (AC-1.8).\n   157\texport interface ClaimedWorkItem {\n   158\t  workItemId: string;\n   159\t  owner: WorkOwner;\n   160\t  kind: string;\n   161\t  sourceRef: WorkSourceRef;\n   162\t  attempts: number;\n   163\t  queuedAt: string;\n   164\t  sourceVersion: number;\n   165\t  forms: EnqueueFormTarget[];\n   166\t}\n   167\t\n   168\texport type ClaimOutcome =\n   169\t  | { outcome: \"claimed\"; item: ClaimedWorkItem }\n   170\t  | { outcome: \"empty\" }\n   171\t  | { outcome: \"in_flight\"; claimExpiresAt: string }\n   172\t  | { outcome: \"waiting\"; waitingUntil: string };\n   173\t\n   174\tinterface RawClaimRow {\n   175\t  work_item_id: string;\n   176\t  owner: string;\n   177\t  kind: string;\n   178\t  source_ref: string;\n   179\t  attempts: number | bigint;\n   180\t  queued_at: string;\n   181\t  payload: string | null;\n   182\t}\n   183\t\n   184\t// Form targets for pre-v5 rows, whose payload is NULL (Epic 01 wrote no\n   185\t// payload column). Exactly the F-02 backfill's kind→form mapping (migration\n   186\t// v5, shared/storage.ts): the backfill created pending derived_form rows at\n   187\t// source version 1 for these kinds, and a terminal failure must find them —\n   188\t// otherwise exhaustion would delete the work row and strand the backfilled\n   189\t// form as pending forever, breaking AC-1.9/DD-1 for upgraded threads.\n   190\tconst LEGACY_KIND_FORMS: Partial<\n   191\t  Record<string, ReadonlyArray<{ subjectKind: SubjectKind; form: FormKind }>>\n   192\t> = {\n   193\t  prompt_smoothing: [{ subjectKind: \"message\", form: \"smoothed_prompt\" }],\n   194\t  tool_result_summary: [{ subjectKind: \"message\", form: \"tool_result_summary\" }],\n   195\t  turn_derivation: [\n   196\t    { subjectKind: \"turn\", form: \"turn_rendering\" },\n   197\t    { subjectKind: \"turn\", form: \"lower_band_projection\" },\n   198\t  ],\n   199\t};\n   200\t\n   201\tfunction legacyFormTargets(kind: string, sourceRef: WorkSourceRef): EnqueueFormTarget[] {\n   202\t  const mapped = LEGACY_KIND_FORMS[kind];\n   203\t  if (mapped === undefined) return [];\n   204\t  const subjectId = sourceIdOf(sourceRef);\n   205\t  return mapped.map((target) => ({ ...target, subjectId }));\n   206\t}\n   207\t\n   208\tfunction toClaimedItem(row: RawClaimRow): ClaimedWorkItem {\n   209\t  const sourceRef = JSON.parse(row.source_ref) as WorkSourceRef;\n   210\t  const payload =\n   211\t    row.payload === null\n   212\t      ? // Pre-v5 row: version 1 (matching the backfill) and form targets\n   213\t        // reconstructed from the backfill's own mapping.\n   214\t        { sourceVersion: 1, forms: legacyFormTargets(row.kind, sourceRef) }\n   215\t      : (JSON.parse(row.payload) as { sourceVersion?: number; forms?: EnqueueFormTarget[] });\n   216\t  return {\n   217\t    workItemId: row.work_item_id,\n   218\t    owner: row.owner as WorkOwner,\n   219\t    kind: row.kind,\n   220\t    sourceRef,\n   221\t    attempts: Number(row.attempts),\n   222\t    queuedAt: row.queued_at,\n   223\t    sourceVersion: payload.sourceVersion ?? 1,\n   224\t    forms: payload.forms ?? [],\n   225\t  };\n   226\t}\n   227\t\n   228\t// Head-first, never skip-ahead: the claim decision is made against the oldest\n   229\t// live row only — a later eligible row is never considered while an older\n   230\t// live row exists. One atomic UPDATE under BEGIN IMMEDIATE (no read-then-\n   231\t// write split: the race window is the bug class). The CASE increments\n   232\t// `attempts` only when reclaiming an expired claimed row — a reclaim means a\n   233\t// run died or hung, and the increment makes the crash visible in the report\n   234\t// and counts it against the retry budget; normal claims never touch it.\n   235\texport function claimNext(db: DatabaseSync, now: string, leaseDurationMs: number): ClaimOutcome {\n   236\t  const expiresAt = new Date(Date.parse(now) + leaseDurationMs).toISOString();\n   237\t  db.exec(\"BEGIN IMMEDIATE;\");\n   238\t  try {\n   239\t    const claimed = db\n   240\t      .prepare(\n   241\t        `UPDATE work_item SET status = 'claimed', claimed_at = ?, claim_expires_at = ?,\n   242\t           attempts = attempts + CASE WHEN status = 'claimed' THEN 1 ELSE 0 END\n   243\t         WHERE work_item_id = (\n   244\t           SELECT work_item_id FROM (\n   245\t             SELECT work_item_id, status, eligible_at, claim_expires_at\n   246\t             FROM work_item WHERE status IN ('queued', 'claimed')\n   247\t             ORDER BY rowid LIMIT 1\n   248\t           )\n   249\t           WHERE (status = 'queued' AND (eligible_at IS NULL OR eligible_at <= ?))\n   250\t              OR (status = 'claimed' AND claim_expires_at <= ?)\n   251\t         )\n   252\t         RETURNING work_item_id, owner, kind, source_ref, attempts, queued_at, payload`,\n   253\t      )\n   254\t      .get(now, expiresAt, now, now) as unknown as RawClaimRow | undefined;\n   255\t    if (claimed !== undefined) {\n   256\t      db.exec(\"COMMIT;\");\n   257\t      return { outcome: \"claimed\", item: toClaimedItem(claimed) };\n   258\t    }\n   259\t    // No row claimable: re-read the head inside the same transaction to\n   260\t    // classify the stop. A claimed head with a live lease gates the queue\n   261\t    // (in_flight, AC-1.4); a queued head still backing off gates it too\n   262\t    // (waiting) — strict ordering, never reordered around the head.\n   263\t    const head = db\n   264\t      .prepare(\n   265\t        `SELECT status, eligible_at, claim_expires_at\n   266\t         FROM work_item WHERE status IN ('queued', 'claimed')\n   267\t         ORDER BY rowid LIMIT 1`,\n   268\t      )\n   269\t      .get() as unknown as\n   270\t      | { status: string; eligible_at: string | null; claim_expires_at: string | null }\n   271\t      | undefined;\n   272\t    db.exec(\"COMMIT;\");\n   273\t    if (head === undefined) return { outcome: \"empty\" };\n   274\t    if (head.status === \"claimed\") {\n   275\t      return { outcome: \"in_flight\", claimExpiresAt: head.claim_expires_at ?? \"\" };\n   276\t    }\n   277\t    return { outcome: \"waiting\", waitingUntil: head.eligible_at ?? \"\" };\n   278\t  } catch (cause) {\n   279\t    db.exec(\"ROLLBACK;\");\n   280\t    throw cause;\n   281\t  }\n   282\t}\n   283\t\n   284\t// Completion: the version-checked form writes and the item row's deletion in\n   285\t// one short transaction (DD-1: terminal transition deletes the row; the\n   286\t// disposition is reported in-memory, never stored). UPDATE-only, never\n   287\t// upsert — the pending row exists from enqueue; a write that finds no row at\n   288\t// the item's source version is discarded as stale (DD-3 truth table). The\n   289\t// optional onApplied hook (Story 3) runs inside this same transaction, after\n   290\t// the form writes and only when they landed — chunk placement and the\n   291\t// close→summary enqueues ride the completion commit; its onCommit\n   292\t// registrations (the enqueue pokes) flush after COMMIT and drop on rollback.\n   293\texport function complete(\n   294\t  db: DatabaseSync,\n   295\t  item: ClaimedWorkItem,\n   296\t  writes: readonly HandlerFormWrite[],\n   297\t  derivedAt: string,\n   298\t  onApplied?: (tx: CompletionTx) => void,\n   299\t): \"done\" | \"stale_discarded\" {\n   300\t  const hooks = createCommitHooks();\n   301\t  db.exec(\"BEGIN IMMEDIATE;\");\n   302\t  try {\n   303\t    let hits = 0;\n   304\t    const update = db.prepare(\n   305\t      `UPDATE derived_form\n   306\t       SET state = 'ready', content = ?, reason = NULL, metadata = ?, gaps = ?, derived_at = ?\n   307\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n   308\t    );\n   309\t    for (const write of writes) {\n   310\t      const changed = update.run(\n   311\t        write.content,\n   312\t        write.metadata === undefined ? null : JSON.stringify(write.metadata),\n   313\t        write.gaps === undefined ? null : JSON.stringify(write.gaps),\n   314\t        derivedAt,\n   315\t        write.subjectKind,\n   316\t        write.subjectId,\n   317\t        write.form,\n   318\t        item.sourceVersion,\n   319\t      );\n   320\t      hits += Number(changed.changes);\n   321\t    }\n   322\t    const stale = writes.length > 0 && hits === 0;\n   323\t    if (!stale && onApplied !== undefined) {\n   324\t      onApplied({ db, onCommit: hooks.register });\n   325\t    }\n   326\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n   327\t    db.exec(\"COMMIT;\");\n   328\t    hooks.flush();\n   329\t    return stale ? \"stale_discarded\" : \"done\";\n   330\t  } catch (cause) {\n   331\t    db.exec(\"ROLLBACK;\");\n   332\t    throw cause;\n   333\t  }\n   334\t}\n   335\t\n   336\texport interface RetryPolicy {\n   337\t  budget: number;\n   338\t  backoffBaseMs: number;\n   339\t  backoffCapMs: number;\n   340\t}\n   341\t\n   342\texport type FailAttemptResult =\n   343\t  | { terminal: false; attempts: number; eligibleAt: string }\n   344\t  | { terminal: true; attempts: number };\n   345\t\n   346\t// Terminal failure: the form rows land `failed` (or `blocked` for source\n   347\t// damage) carrying the final reason plus attempts/last-error copied onto the\n   348\t// form's metadata, and the item row is deleted — one transaction (DD-1).\n   349\t// Form writes stay version-checked: if a mutation moved the source since this\n   350\t// item was queued, the stale failure must not stamp the rebuilt form.\n   351\texport function failTerminal(\n   352\t  db: DatabaseSync,\n   353\t  item: ClaimedWorkItem,\n   354\t  opts: { reason: string; formState: \"failed\" | \"blocked\"; attempts: number; now: string },\n   355\t): void {\n   356\t  db.exec(\"BEGIN IMMEDIATE;\");\n   357\t  try {\n   358\t    const update = db.prepare(\n   359\t      `UPDATE derived_form\n   360\t       SET state = ?, content = NULL, reason = ?, metadata = ?, gaps = NULL, derived_at = ?\n   361\t       WHERE subject_kind = ? AND subject_id = ? AND form = ? AND source_version = ?`,\n   362\t    );\n   363\t    const metadata = JSON.stringify({ attempts: opts.attempts, lastError: opts.reason });\n   364\t    for (const target of item.forms) {\n   365\t      update.run(\n   366\t        opts.formState,\n   367\t        opts.reason,\n   368\t        metadata,\n   369\t        opts.now,\n   370\t        target.subjectKind,\n   371\t        target.subjectId,\n   372\t        target.form,\n   373\t        item.sourceVersion,\n   374\t      );\n   375\t    }\n   376\t    db.prepare(`DELETE FROM work_item WHERE work_item_id = ?`).run(item.workItemId);\n   377\t    db.exec(\"COMMIT;\");\n   378\t  } catch (cause) {\n   379\t    db.exec(\"ROLLBACK;\");\n   380\t    throw cause;\n   381\t  }\n   382\t}\n   383\t\n   384\t// A failed run counts itself. Under budget and retryable: the row goes back\n   385\t// to `queued` with attempts incremented and eligibility pushed out by backoff\n   386\t// (min(base × 2^attempts, cap)) — retry is not a status (DD-1). At budget, or\n   387\t// on a non-retryable failure, the item is terminal: form `failed` with the\n   388\t// final reason, row deleted (AC-1.9).\n   389\texport function failAttempt(\n   390\t  db: DatabaseSync,\n   391\t  item: ClaimedWorkItem,\n   392\t  opts: { reason: string; retryable: boolean; now: string; retry: RetryPolicy },\n   393\t): FailAttemptResult {\n   394\t  const attempts = item.attempts + 1;\n   395\t  if (opts.retryable && attempts < opts.retry.budget) {\n   396\t    const backoffMs = Math.min(\n   397\t      opts.retry.backoffBaseMs * 2 ** attempts,\n   398\t      opts.retry.backoffCapMs,\n   399\t    );\n   400\t    const eligibleAt = new Date(Date.parse(opts.now) + backoffMs).toISOString();\n   401\t    db.exec(\"BEGIN IMMEDIATE;\");\n   402\t    try {\n   403\t      db.prepare(\n   404\t        `UPDATE work_item\n   405\t         SET status = 'queued', attempts = ?, last_error = ?,\n   406\t             claimed_at = NULL, claim_expires_at = NULL, eligible_at = ?\n   407\t         WHERE work_item_id = ?`,\n   408\t      ).run(attempts, opts.reason, eligibleAt, item.workItemId);\n   409\t      db.exec(\"COMMIT;\");\n   410\t    } catch (cause) {\n   411\t      db.exec(\"ROLLBACK;\");\n   412\t      throw cause;\n   413\t    }\n   414\t    return { terminal: false, attempts, eligibleAt };\n   415\t  }\n   416\t  failTerminal(db, item, { reason: opts.reason, formState: \"failed\", attempts, now: opts.now });\n   417\t  return { terminal: true, attempts };\n   418\t}\n   419\t\n   420\t// Cascade tidy (tech design issue 1): delete still-queued items for the given\n   421\t// (kind, sourceRef) targets, returning the deleted ids for the mutation\n   422\t// result's `superseded` list. Runs inside the caller's ambient transaction —\n   423\t// the cascade owns the BEGIN/COMMIT — so no transaction is opened here.\n   424\t// Claimed items are deliberately left alone: the source-version check (DD-3)\n   425\t// discards their stale completions. Ships here as mechanics; its only caller\n   426\t// is Story 5's cascade.\n   427\texport function supersedeQueued(\n   428\t  db: DatabaseSync,\n   429\t  targets: ReadonlyArray<{ kind: WorkKind; sourceRef: WorkSourceRef }>,\n   430\t): string[] {\n   431\t  const ids: string[] = [];\n   432\t  const remove = db.prepare(\n   433\t    `DELETE FROM work_item WHERE status = 'queued' AND kind = ? AND source_ref = ?\n   434\t     RETURNING work_item_id`,\n   435\t  );\n   436\t  for (const target of targets) {\n   437\t    const rows = remove.all(target.kind, JSON.stringify(target.sourceRef)) as unknown as Array<{\n   438\t      work_item_id: string;\n   439\t    }>;\n   440\t    for (const row of rows) ids.push(row.work_item_id);\n   441\t  }\n   442\t  return ids;\n   443\t}\n   444\t\n   445\t// The requeue no-op rule's EXISTS check (AC-4.5): is there a live item —\n   446\t// queued or in flight — for this kind and source at this source version?\n   447\t// Runs inside the caller's requeue transaction so the check and the enqueue\n   448\t// commit together (anti-shim: a check-then-enqueue split across transactions\n   449\t// reintroduces the duplicate-work race). Version-scoped on purpose: a\n   450\t// claimed pre-mutation item at an older version is dying work whose\n   451\t// completion DD-3 will discard — it must not block the repair.\n   452\texport function hasLiveItem(\n   453\t  db: DatabaseSync,\n   454\t  kind: WorkKind,\n   455\t  sourceRef: WorkSourceRef,\n   456\t  sourceVersion: number,\n   457\t): boolean {\n   458\t  const row = db\n   459\t    .prepare(\n   460\t      `SELECT 1 FROM work_item\n   461\t       WHERE status IN ('queued', 'claimed') AND kind = ? AND source_ref = ?\n   462\t         AND COALESCE(json_extract(payload, '$.sourceVersion'), 1) = ?\n   463\t       LIMIT 1`,\n   464\t    )\n   465\t    .get(kind, JSON.stringify(sourceRef), sourceVersion);\n   466\t  return row !== undefined;\n   467\t}\n   468\t\n   469\t// Live items left in the queue — the drain report's `remaining` and the\n   470\t// repair report's join source (Story 4).\n   471\texport function countLiveItems(db: DatabaseSync): number {\n   472\t  const row = db\n   473\t    .prepare(`SELECT COUNT(*) AS n FROM work_item WHERE status IN ('queued', 'claimed')`)\n   474\t    .get() as unknown as { n: number | bigint };\n   475\t  return Number(row.n);\n   476\t}\n   477\t\n   478\texport interface QueueDetailRow {\n   479\t  workItemId: string;\n   480\t  owner: WorkOwner;\n   481\t  kind: string;\n   482\t  sourceRef: WorkSourceRef;\n   483\t  status: \"queued\" | \"claimed\";\n   484\t  attempts: number;\n   485\t  lastError?: string;\n   486\t  eligibleAt?: string;\n   487\t  claimedAt?: string;\n   488\t  claimExpiresAt?: string;\n   489\t  queuedAt: string;\n   490\t  sourceVersion: number;\n   491\t}\n   492\t\n   493\t// Mechanical detail of every live row in queue order — what the repair\n   494\t// report joins against derived_form (Flow 4) and what tests read to assert\n   495\t// lease/backoff state without raw SQL at every call site.\n   496\texport function queueDetail(db: DatabaseSync): QueueDetailRow[] {\n   497\t  const rows = db\n   498\t    .prepare(\n   499\t      `SELECT work_item_id, owner, kind, source_ref, status, attempts, last_error,\n   500\t              eligible_at, claimed_at, claim_expires_at, queued_at, payload\n   501\t       FROM work_item ORDER BY rowid`,\n   502\t    )\n   503\t    .all() as unknown as Array<\n   504\t    RawClaimRow & {\n   505\t      status: string;\n   506\t      last_error: string | null;\n   507\t      eligible_at: string | null;\n   508\t      claimed_at: string | null;\n   509\t      claim_expires_at: string | null;\n   510\t    }\n   511\t  >;\n   512\t  return rows.map((row) => {\n   513\t    const item = toClaimedItem(row);\n   514\t    const detail: QueueDetailRow = {\n   515\t      workItemId: item.workItemId,\n   516\t      owner: item.owner,\n   517\t      kind: item.kind,\n   518\t      sourceRef: item.sourceRef,\n   519\t      status: row.status as \"queued\" | \"claimed\",\n   520\t      attempts: item.attempts,\n   521\t      queuedAt: item.queuedAt,\n   522\t      sourceVersion: item.sourceVersion,\n   523\t    };\n   524\t    if (row.last_error !== null) detail.lastError = row.last_error;\n   525\t    if (row.eligible_at !== null) detail.eligibleAt = row.eligible_at;\n   526\t    if (row.claimed_at !== null) detail.claimedAt = row.claimed_at;\n   527\t    if (row.claim_expires_at !== null) detail.claimExpiresAt = row.claim_expires_at;\n   528\t    return detail;\n   529\t  });\n   530\t}\n   531\t\n   532\t// Listing in queue order (insertion order within the walk); each owning\n   533\t// domain lists only its own items.\n   534\texport function listItems(db: DatabaseSync, owner: WorkOwner): WorkItemRecord[] {\n   535\t  const rows = db\n   536\t    .prepare(\n   537\t      `SELECT work_item_id, owner, kind, source_ref, queued_at\n   538\t       FROM work_item WHERE owner = ? ORDER BY rowid`,\n   539\t    )\n   540\t    .all(owner) as unknown as RawWorkItemRow[];\n   541\t  return rows.map((row) => ({\n   542\t    workItemId: row.work_item_id,\n   543\t    owner: row.owner as WorkOwner,\n   544\t    kind: row.kind as WorkKind,\n   545\t    sourceRef: JSON.parse(row.source_ref) as WorkSourceRef,\n   546\t    status: \"queued\",\n   547\t    queuedAt: row.queued_at,\n   548\t  }));\n   549\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/threads.ts | sed -n '260,520p'\"","aggregated_output":"   260\t  const derivedAt = \"2026-06-10T12:00:00.000Z\";\n   261\t  setFormState(\n   262\t    filePath,\n   263\t    { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\" },\n   264\t    { state: \"ready\", content: \"smoothed(fixture:first prompt)\", derivedAt },\n   265\t  );\n   266\t  // Tool-activity outcome lives in machine-readable metadata, never inside\n   267\t  // provider-authored content (FC-0.3).\n   268\t  setFormState(\n   269\t    filePath,\n   270\t    { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\" },\n   271\t    {\n   272\t      state: \"ready\",\n   273\t      content: \"toolresult(fixture:contents of a.txt)\",\n   274\t      metadata: { outcome: \"succeeded\" },\n   275\t      derivedAt,\n   276\t    },\n   277\t  );\n   278\t  setFormState(\n   279\t    filePath,\n   280\t    { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\" },\n   281\t    { state: \"failed\", reason: \"provider_failure: scripted exhaustion (fixture)\" },\n   282\t  );\n   283\t  setFormState(\n   284\t    filePath,\n   285\t    { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\" },\n   286\t    { state: \"blocked\", reason: \"source_damaged: manufactured damage (fixture)\" },\n   287\t  );\n   288\t  return {\n   289\t    filePath,\n   290\t    expected: [\n   291\t      { subjectKind: \"message\", subjectId: \"m1\", form: \"smoothed_prompt\", state: \"ready\" },\n   292\t      { subjectKind: \"message\", subjectId: \"m4\", form: \"tool_result_summary\", state: \"ready\" },\n   293\t      { subjectKind: \"message\", subjectId: \"m6\", form: \"smoothed_prompt\", state: \"pending\" },\n   294\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"turn_rendering\", state: \"failed\" },\n   295\t      { subjectKind: \"turn\", subjectId: \"t1\", form: \"lower_band_projection\", state: \"pending\" },\n   296\t      { subjectKind: \"turn\", subjectId: \"t2\", form: \"turn_rendering\", state: \"blocked\" },\n   297\t      { subjectKind: \"turn\", subjectId: \"t2\", form: \"lower_band_projection\", state: \"pending\" },\n   298\t    ],\n   299\t  };\n   300\t}\n   301\t\n   302\t// ── damaged-source thread (Epic 01 corruption definition) ────────\n   303\t\n   304\t// A closed turn with its turn_derivation work queued, then the Epic 01\n   305\t// two-open-turns corruption — the damage a turn handler must find and the\n   306\t// intake pipeline refuses (turn_state_corrupt).\n   307\texport async function damagedSourceThread(\n   308\t  store: TempStore,\n   309\t): Promise<{ filePath: string; turnId: string }> {\n   310\t  const { filePath, turnIds } = await threadWithClosedTurns(store, 1);\n   311\t  // Open a second turn through real intake; the corruption writer then adds\n   312\t  // another open row — two open turns, the Epic 01 invariant violation.\n   313\t  await send(filePath, [validEvent(\"user_prompt\", { payload: { text: \"left open\" } })]);\n   314\t  corruptTwoOpenTurns(filePath);\n   315\t  const turnId = turnIds[0];\n   316\t  if (turnId === undefined) throw new Error(\"fixture invariant: one closed turn expected\");\n   317\t  return { filePath, turnId };\n   318\t}\n   319\t\n   320\t// ── gapped-rendering thread (TC-3.2's state, shared) ─────────────\n   321\t\n   322\t// TC-3.2's gapped-rendering state as one shared builder (coverage.md\n   323\t// cross-story debt: TC-4.4 consumes this exact scenario; don't rebuild it by\n   324\t// hand). Expects a manual-mode SDK with retry budget 3 and zero backoff:\n   325\t// scripts the double to exhaust the prompt's smoothing, then drains — the\n   326\t// smoothing lands failed (its work row deleted at exhaustion, DD-1) and the\n   327\t// turn rendering lands ready with the recorded gap.\n   328\texport const GAPPED_SMOOTHING_REASON = \"provider_failure: scripted smoothing exhaustion\";\n   329\t\n   330\texport async function gappedRenderingThread(\n   331\t  store: TempStore,\n   332\t  sdk: Lhc,\n   333\t  double: ProviderDouble,\n   334\t): Promise<{ filePath: string; messageId: string; turnId: string }> {\n   335\t  const filePath = await newThreadFile(store);\n   336\t  double.failKind(\"prompt_smoothing\", 3, {\n   337\t    retryable: true,\n   338\t    reason: GAPPED_SMOOTHING_REASON,\n   339\t  });\n   340\t  await send(filePath, [\n   341\t    validEvent(\"user_prompt\", { payload: { text: \"gapped prompt\" } }),\n   342\t    validEvent(\"assistant_text\", { payload: { text: \"gapped answer\" } }),\n   343\t    validEvent(\"turn_end\"),\n   344\t  ]);\n   345\t  const drained = await sdk.work.drain({ filePath });\n   346\t  if (!drained.ok) throw new Error(`fixture drain failed: ${drained.error.reason}`);\n   347\t  const forms = readDerivedForms(filePath);\n   348\t  const smoothing = forms.find((f) => f.subjectId === \"m1\" && f.form === \"smoothed_prompt\");\n   349\t  const rendering = forms.find((f) => f.subjectId === \"t1\" && f.form === \"turn_rendering\");\n   350\t  if (\n   351\t    smoothing?.state !== \"failed\" ||\n   352\t    rendering?.state !== \"ready\" ||\n   353\t    rendering.gaps === undefined\n   354\t  ) {\n   355\t    throw new Error(\n   356\t      \"fixture invariant: failed smoothing under a ready, gapped rendering expected\",\n   357\t    );\n   358\t  }\n   359\t  return { filePath, messageId: \"m1\", turnId: \"t1\" };\n   360\t}\n   361\t\n   362\t// ── twin SDK/CLI threads for parity tests ────────────────────────\n   363\t\n   364\t// The same batch recorded through the SDK entry and the in-process CLI\n   365\t// adapter, under one injected clock, so the two files are comparable\n   366\t// record-for-record. Distinct idempotency-key spaces are unnecessary: keys\n   367\t// scope per thread file.\n   368\texport async function twinThreads(\n   369\t  store: TempStore,\n   370\t  batch?: readonly MessageEventInput[],\n   371\t): Promise<{ sdkPath: string; cliPath: string; batch: readonly MessageEventInput[] }> {\n   372\t  const events =\n   373\t    batch ??\n   374\t    ([\n   375\t      validEvent(\"user_prompt\", { payload: { text: \"twin prompt\" } }),\n   376\t      validEvent(\"assistant_text\", { payload: { text: \"twin answer\" } }),\n   377\t      validEvent(\"tool_call\", {\n   378\t        payload: { toolCallId: \"call-twin-1\", toolName: \"read_file\", arguments: { path: \"t.txt\" } },\n   379\t      }),\n   380\t      validEvent(\"tool_result\", {\n   381\t        payload: { toolCallId: \"call-twin-1\", content: \"twin tool output\", isError: false },\n   382\t      }),\n   383\t      validEvent(\"turn_end\"),\n   384\t    ] as const);\n   385\t\n   386\t  setIntakeClock(() => new Date(\"2026-06-10T12:00:00.000Z\"));\n   387\t  try {\n   388\t    const sdkPath = await newThreadFile(store);\n   389\t    await send(sdkPath, events);\n   390\t\n   391\t    const cliPath = store.threadPath();\n   392\t    const created = await runCli([\n   393\t      \"threads\",\n   394\t      \"new-thread\",\n   395\t      \"--file-path\",\n   396\t      cliPath,\n   397\t      \"--registry\",\n   398\t      store.registryPath,\n   399\t    ]);\n   400\t    if (created.exitCode !== 0) {\n   401\t      throw new Error(`fixture CLI new-thread failed: ${created.stdout}`);\n   402\t    }\n   403\t    const recorded = await runCli(\n   404\t      [\"intake-stream\", \"message-events\", \"--file-path\", cliPath],\n   405\t      async () => JSON.stringify(events),\n   406\t    );\n   407\t    if (recorded.exitCode !== 0) {\n   408\t      throw new Error(`fixture CLI message-events failed: ${recorded.stdout}`);\n   409\t    }\n   410\t    return { sdkPath, cliPath, batch: events };\n   411\t  } finally {\n   412\t    setIntakeClock(null);\n   413\t  }\n   414\t}\n","exit_code":0,"status":"completed"}}

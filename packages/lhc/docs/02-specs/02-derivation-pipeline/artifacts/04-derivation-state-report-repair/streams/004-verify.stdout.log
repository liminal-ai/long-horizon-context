{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/forms.ts | sed -n '1,240p'\"","aggregated_output":"     1\t// Message-domain reads for derivation (Flow 2): the handler's view of its\n     2\t// source message and the call-id pairing reads — the only reach a\n     3\t// message-level handler has beyond its own message (AC-2.5). Also the\n     4\t// late-result repair lookup intake's projection step runs (AC-2.8): one\n     5\t// indexed query by call id, never a scan (the v5 expression index on\n     6\t// message_block covers it) and never a drain-time sweep or read-time join.\n     7\t// Completion writes for message forms ride the work-queue util's `complete`\n     8\t// (Story 1): UPDATE-only with the source-version check — no write path here.\n     9\t// Read-back of message-owned form rows (the listMessages join) also lives\n    10\t// here: stored state returned as stored — never re-derived on read.\n    11\timport type { DatabaseSync } from \"node:sqlite\";\n    12\timport type {\n    13\t  DependencyGap,\n    14\t  DerivedForm,\n    15\t  DerivedFormMetadata,\n    16\t  DerivedFormState,\n    17\t  FormKind,\n    18\t  FormReportEntry,\n    19\t} from \"../../../shared/derivation.js\";\n    20\timport { reportEntryFromRow, type RawReportRow } from \"../../../shared/report.js\";\n    21\t\n    22\texport interface MessageSource {\n    23\t  messageId: string;\n    24\t  kind: string;\n    25\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n    26\t}\n    27\t\n    28\texport function readMessageSource(\n    29\t  db: DatabaseSync,\n    30\t  messageId: string,\n    31\t): MessageSource | undefined {\n    32\t  const row = db\n    33\t    .prepare(`SELECT kind FROM message WHERE message_id = ?`)\n    34\t    .get(messageId) as unknown as { kind: string } | undefined;\n    35\t  if (row === undefined) return undefined;\n    36\t  const blocks = db\n    37\t    .prepare(\n    38\t      `SELECT block_type, content FROM message_block\n    39\t       WHERE message_id = ? ORDER BY block_index`,\n    40\t    )\n    41\t    .all(messageId) as unknown as Array<{ block_type: string; content: string }>;\n    42\t  return {\n    43\t    messageId,\n    44\t    kind: row.kind,\n    45\t    blocks: blocks.map((block) => ({\n    46\t      blockType: block.block_type,\n    47\t      content: JSON.parse(block.content) as Record<string, unknown>,\n    48\t    })),\n    49\t  };\n    50\t}\n    51\t\n    52\tinterface RawFormRow {\n    53\t  subject_id: string;\n    54\t  form: string;\n    55\t  state: string;\n    56\t  content: string | null;\n    57\t  reason: string | null;\n    58\t  metadata: string | null;\n    59\t  source_version: number | bigint;\n    60\t  gaps: string | null;\n    61\t  derived_at: string | null;\n    62\t}\n    63\t\n    64\t// Every message-owned derived-form row, grouped by message id — the form\n    65\t// read-back joined onto message reads (AC-2.1's \"readable alongside the\n    66\t// message\"). Rows come back exactly as the queue landed them: state, content,\n    67\t// reason, mechanically stamped metadata; nothing is derived at read time.\n    68\texport function readMessageForms(db: DatabaseSync): Map<string, DerivedForm[]> {\n    69\t  const rows = db\n    70\t    .prepare(\n    71\t      `SELECT subject_id, form, state, content, reason, metadata,\n    72\t              source_version, gaps, derived_at\n    73\t       FROM derived_form WHERE subject_kind = 'message'\n    74\t       ORDER BY subject_id, form`,\n    75\t    )\n    76\t    .all() as unknown as RawFormRow[];\n    77\t  const byMessage = new Map<string, DerivedForm[]>();\n    78\t  for (const row of rows) {\n    79\t    const record: DerivedForm = {\n    80\t      subjectKind: \"message\",\n    81\t      subjectId: row.subject_id,\n    82\t      form: row.form as FormKind,\n    83\t      state: row.state as DerivedFormState,\n    84\t      sourceVersion: Number(row.source_version),\n    85\t    };\n    86\t    if (row.content !== null) record.content = row.content;\n    87\t    if (row.reason !== null) record.reason = row.reason;\n    88\t    if (row.metadata !== null) {\n    89\t      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\n    90\t    }\n    91\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\n    92\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\n    93\t    const forms = byMessage.get(row.subject_id) ?? [];\n    94\t    forms.push(record);\n    95\t    byMessage.set(row.subject_id, forms);\n    96\t  }\n    97\t  return byMessage;\n    98\t}\n    99\t\n   100\t// One form row by exact key — the requeue operation's refusal read (missing\n   101\t// row, blocked state, current source version). State returned as stored.\n   102\texport function readMessageFormRow(\n   103\t  db: DatabaseSync,\n   104\t  messageId: string,\n   105\t  form: FormKind,\n   106\t): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\n   107\t  const row = db\n   108\t    .prepare(\n   109\t      `SELECT state, reason, source_version FROM derived_form\n   110\t       WHERE subject_kind = 'message' AND subject_id = ? AND form = ?`,\n   111\t    )\n   112\t    .get(messageId, form) as unknown as\n   113\t    | { state: string; reason: string | null; source_version: number | bigint }\n   114\t    | undefined;\n   115\t  if (row === undefined) return undefined;\n   116\t  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\n   117\t    state: row.state as DerivedFormState,\n   118\t    sourceVersion: Number(row.source_version),\n   119\t  };\n   120\t  if (row.reason !== null) view.reason = row.reason;\n   121\t  return view;\n   122\t}\n   123\t\n   124\t// The message owner's report (Flow 4): one query — message-owned form rows\n   125\t// LEFT JOINed with the live work_item still targeting each form at its\n   126\t// current source version, if any (DD-1: only live rows exist; terminal\n   127\t// outcomes already live on the form). No N+1, no in-memory assembly beyond\n   128\t// row mapping. The form→kind CASE is the owner's own queue-site mapping\n   129\t// (MESSAGE_WORK_FORMS) inverted.\n   130\texport function reportMessageForms(\n   131\t  db: DatabaseSync,\n   132\t  opts: { notReady?: boolean; messageId?: string } = {},\n   133\t): FormReportEntry[] {\n   134\t  const conditions = [\"df.subject_kind = 'message'\"];\n   135\t  const params: string[] = [];\n   136\t  if (opts.messageId !== undefined) {\n   137\t    conditions.push(\"df.subject_id = ?\");\n   138\t    params.push(opts.messageId);\n   139\t  }\n   140\t  // notReady is exact set equality by construction: every state but ready.\n   141\t  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n   142\t  const rows = db\n   143\t    .prepare(\n   144\t      `SELECT df.subject_id, df.form, df.state, df.content, df.reason, df.metadata,\n   145\t              df.source_version, df.gaps, df.derived_at,\n   146\t              w.status AS queue_status, w.attempts AS queue_attempts,\n   147\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n   148\t       FROM derived_form df\n   149\t       LEFT JOIN work_item w\n   150\t         ON w.status IN ('queued', 'claimed')\n   151\t        AND w.kind = CASE df.form WHEN 'smoothed_prompt' THEN 'prompt_smoothing' ELSE df.form END\n   152\t        AND json_extract(w.source_ref, '$.messageId') = df.subject_id\n   153\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n   154\t       WHERE ${conditions.join(\" AND \")}\n   155\t       ORDER BY df.subject_id, df.form`,\n   156\t    )\n   157\t    .all(...params) as unknown as RawReportRow[];\n   158\t  return rows.map((row) => reportEntryFromRow(\"message\", row));\n   159\t}\n   160\t\n   161\t// The call-id pairing reads. Earliest-recorded block wins if a call id were\n   162\t// ever repeated; in a well-formed record the pair is unique.\n   163\tfunction findPairedBlock(\n   164\t  db: DatabaseSync,\n   165\t  blockType: \"tool_call\" | \"tool_result\",\n   166\t  toolCallId: string,\n   167\t): Record<string, unknown> | undefined {\n   168\t  const row = db\n   169\t    .prepare(\n   170\t      `SELECT b.content FROM message_block b\n   171\t       JOIN message m ON m.message_id = b.message_id\n   172\t       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\n   173\t       ORDER BY m.source_event_order LIMIT 1`,\n   174\t    )\n   175\t    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\n   176\t  if (row === undefined) return undefined;\n   177\t  return JSON.parse(row.content) as Record<string, unknown>;\n   178\t}\n   179\t\n   180\texport function findPairedToolResult(\n   181\t  db: DatabaseSync,\n   182\t  toolCallId: string,\n   183\t): { content: string; isError: boolean } | undefined {\n   184\t  const block = findPairedBlock(db, \"tool_result\", toolCallId);\n   185\t  if (block === undefined) return undefined;\n   186\t  return {\n   187\t    content: typeof block[\"content\"] === \"string\" ? block[\"content\"] : \"\",\n   188\t    isError: block[\"isError\"] === true,\n   189\t  };\n   190\t}\n   191\t\n   192\texport function findPairedToolCall(\n   193\t  db: DatabaseSync,\n   194\t  toolCallId: string,\n   195\t): { toolName: string } | undefined {\n   196\t  const block = findPairedBlock(db, \"tool_call\", toolCallId);\n   197\t  if (block === undefined) return undefined;\n   198\t  return { toolName: typeof block[\"toolName\"] === \"string\" ? block[\"toolName\"] : \"\" };\n   199\t}\n   200\t\n   201\t// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\n   202\t// outcome \"unknown\"? Pending rows carry NULL metadata and never match, so the\n   203\t// common case — call and result in one batch, summary not yet run — never\n   204\t// triggers a requeue. Returns the call's message id and the form's current\n   205\t// source version (the requeue enqueues at version + 1: the pair is the\n   206\t// summary's source, and a source completing follows clear-and-regenerate).\n   207\texport function findUnknownOutcomeCallSummary(\n   208\t  db: DatabaseSync,\n   209\t  toolCallId: string,\n   210\t): { messageId: string; sourceVersion: number } | undefined {\n   211\t  const row = db\n   212\t    .prepare(\n   213\t      `SELECT df.subject_id, df.source_version FROM message_block b\n   214\t       JOIN derived_form df ON df.subject_kind = 'message'\n   215\t         AND df.subject_id = b.message_id AND df.form = 'tool_call_summary'\n   216\t       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\n   217\t         AND json_extract(df.metadata, '$.outcome') = 'unknown'\n   218\t       LIMIT 1`,\n   219\t    )\n   220\t    .get(toolCallId) as unknown as\n   221\t    | { subject_id: string; source_version: number | bigint }\n   222\t    | undefined;\n   223\t  if (row === undefined) return undefined;\n   224\t  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\n   225\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/threads/internal/create.ts | sed -n '130,240p'\"","aggregated_output":"   130\t      reason: `file at ${filePath} exists but is not an lhc thread file (${detail})`,\n   131\t    },\n   132\t  };\n   133\t}\n   134\t\n   135\tfunction errorDetail(cause: unknown): string {\n   136\t  return cause instanceof Error ? cause.message : String(cause);\n   137\t}\n   138\t\n   139\t// Identity check before any migration runs, on a read-only handle so an\n   140\t// invalid file cannot be mutated by the probe itself (F-03-002): a thread\n   141\t// file always carries schema version >= 1 and the thread_metadata singleton\n   142\t// row that creation wrote transactionally. Anything else — an empty\n   143\t// database, an unrelated SQLite file, a non-database file — is rejected as a\n   144\t// caller error, never adopted.\n   145\tfunction validateThreadFile(filePath: string): { ok: true } | { ok: false; error: ErrorResult } {\n   146\t  let db: DatabaseSync | undefined;\n   147\t  try {\n   148\t    db = new DatabaseSync(filePath, { readOnly: true });\n   149\t    if (getSchemaVersion(db) < 1) {\n   150\t      return notAThreadFile(filePath, \"no lhc schema version\");\n   151\t    }\n   152\t    const table = db\n   153\t      .prepare(\"SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'thread_metadata'\")\n   154\t      .get();\n   155\t    if (table === undefined) {\n   156\t      return notAThreadFile(filePath, \"no thread_metadata table\");\n   157\t    }\n   158\t    const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get();\n   159\t    if (row === undefined) {\n   160\t      return notAThreadFile(filePath, \"no thread metadata row\");\n   161\t    }\n   162\t    return { ok: true };\n   163\t  } catch (cause) {\n   164\t    const detail = errorDetail(cause);\n   165\t    // SQLite refusing the file as a database is an identity failure, not an\n   166\t    // environment failure; everything else stays a system error.\n   167\t    if (detail.includes(\"not a database\")) {\n   168\t      return notAThreadFile(filePath, detail);\n   169\t    }\n   170\t    return storageFailure(`could not inspect thread file: ${detail}`);\n   171\t  } finally {\n   172\t    db?.close();\n   173\t  }\n   174\t}\n   175\t\n   176\t// Opens a thread file and brings its schema to the current version before\n   177\t// returning the handle. Every SDK operation on an existing thread file goes\n   178\t// through here, so a pre-Story-3 file gains the message tables on its first\n   179\t// open by newer code — but only after the file proves it is a thread file;\n   180\t// migration never creates lhc schema on an arbitrary existing file. Each\n   181\t// migration runs in its own transaction (storage helper), completing before\n   182\t// any caller transaction begins.\n   183\texport function openThreadDatabase(filePath: string): OpResult<DatabaseSync> {\n   184\t  const valid = validateThreadFile(filePath);\n   185\t  if (!valid.ok) return valid;\n   186\t  let db: DatabaseSync;\n   187\t  try {\n   188\t    db = openDatabase(filePath);\n   189\t  } catch (cause) {\n   190\t    return storageFailure(`could not open thread file: ${errorDetail(cause)}`);\n   191\t  }\n   192\t  try {\n   193\t    runMigrations(db, buildThreadMigrations());\n   194\t  } catch (cause) {\n   195\t    db.close();\n   196\t    return storageFailure(`thread schema migration failed: ${errorDetail(cause)}`);\n   197\t  }\n   198\t  // Announce the open (DD-10): the background scheduler's first-touch\n   199\t  // catch-up hangs off this seam. Fired before any caller transaction\n   200\t  // begins; a no-op unless a listener is installed.\n   201\t  fireThreadTouch(filePath, db);\n   202\t  return { ok: true, value: db };\n   203\t}\n   204\t\n   205\t// Schema v1 plus the metadata row land in one migration transaction, so the\n   206\t// file either has its full schema and metadata row or creation fails whole.\n   207\texport function createThreadFile(\n   208\t  filePath: string,\n   209\t  threadId: string,\n   210\t  createdAt: string,\n   211\t): void {\n   212\t  const db = openDatabase(filePath);\n   213\t  try {\n   214\t    runMigrations(db, buildThreadMigrations({ threadId, createdAt }));\n   215\t  } finally {\n   216\t    db.close();\n   217\t  }\n   218\t}\n   219\t\n   220\t// Compensation: removes the thread file and its WAL companions. Used when the\n   221\t// registry insert fails after file creation (no registry row without its\n   222\t// file) and when file creation itself fails partway.\n   223\texport function deleteThreadFile(filePath: string): void {\n   224\t  for (const suffix of [\"\", \"-wal\", \"-shm\"]) {\n   225\t    rmSync(`${filePath}${suffix}`, { force: true });\n   226\t  }\n   227\t}\n","exit_code":0,"status":"completed"}}

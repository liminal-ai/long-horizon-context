───────────────\n   111\t\n   112\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n   113\t\n   114\t// Merge per-domain handler tables into the one join between the queue's\n   115\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n   116\t// (each kind has exactly one owner) and throws at construction.\n   117\texport function assembleWorkHandlerMap(\n   118\t  tables: ReadonlyArray<WorkHandlerMap>,\n   119\t): WorkHandlerMap {\n   120\t  const map: WorkHandlerMap = {};\n   121\t  for (const table of tables) {\n   122\t    for (const [kind, handler] of Object.entries(table)) {\n   123\t      if (map[kind as WorkKind] !== undefined) {\n   124\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n   125\t      }\n   126\t      map[kind as WorkKind] = handler;\n   127\t    }\n   128\t  }\n   129\t  return map;\n   130\t}\n   131\t\n   132\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n   133\t  return {\n   134\t    ok: false,\n   135\t    error: {\n   136\t      errorClass: \"state_corruption\",\n   137\t      code: \"unknown_work_kind\",\n   138\t      reason: `no handler registered for work kind \"${kind}\"`,\n   139\t    },\n   140\t  };\n   141\t}\n   142\t\n   143\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n   144\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n   145\texport function lookupWorkHandler(\n   146\t  map: WorkHandlerMap,\n   147\t  kind: string,\n   148\t): OpResult<WorkHandler> {\n   149\t  const handler = map[kind as WorkKind];\n   150\t  if (handler === undefined) return unknownWorkKind(kind);\n   151\t  return { ok: true, value: handler };\n   152\t}\n   153\t\n   154\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n   155\t// requeue land in Story 4.\n   156\texport interface WorkSurface {\n   157\t  drain(\n   158\t    ref: threadsDomain.ThreadRef,\n   159\t    opts?: { maxItems?: number },\n   160\t  ): Promise<OpResult<DrainReport>>;\n   161\t}\n   162\t\n   163\texport interface Lhc {\n   164\t  threads: typeof threadsDomain;\n   165\t  intakeStream: typeof intakeStreamDomain;\n   166\t  messages: typeof messagesDomain;\n   167\t  turns: typeof turnsDomain;\n   168\t  config: ResolvedSdkConfig;\n   169\t  scheduler: Scheduler;\n   170\t  workHandlers: WorkHandlerMap;\n   171\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n   172\t  work: WorkSurface;\n   173\t  // Resolves when the scheduler has no running or pending drain for the\n   174\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n   175\t  // resolve in manual mode.\n   176\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n   177\t}\n   178\t\n   179\tfunction requirePositive(value: number, name: string): void {\n   180\t  if (!Number.isFinite(value) || value <= 0) {\n   181\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n   182\t  }\n   183\t}\n   184\t\n   185\tfunction requireNonNegative(value: number, name: string): void {\n   186\t  if (!Number.isFinite(value) || value < 0) {\n   187\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n   188\t  }\n   189\t}\n   190\t\n   191\t// The only assembly path: provider, mode, clock, and policy enter here.\n   192\t// Config mistakes are programmer errors at construction and throw; operating\n   193\t// failures after construction return OpResults per the error contract.\n   194\texport function createSdk(config: SdkConfig): Lhc {\n   195\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   196\t    throw new TypeError(\n   197\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   198\t    );\n   199\t  }\n   200\t  if (config.provider === null || typeof config.provider !== \"object\") {\n   201\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   202\t  }\n   203\t  for (const operation of PROVIDER_OPERATIONS) {\n   204\t    if (typeof config.provider[operation] !== \"function\") {\n   205\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   206\t    }\n   207\t  }\n   208\t\n   209\t  const resolved: ResolvedSdkConfig = {\n   210\t    provider: config.provider,\n   211\t    mode: config.mode,\n   212\t    clock: config.clock ?? (() => new Date()),\n   213\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   214\t    lease: config.lease ?? { durationMs: 120000 },\n   215\t    chunkPolicy:\n   216\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n   217\t  };\n   218\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n   219\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n   220\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/handlers.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// The three message-level derivation handlers (Flow 2): prompt smoothing,\n     2\t// tool-call summary, tool-result summary. One shape throughout — read the\n     3\t// source message (a tool-activity handler additionally joins its call-id\n     4\t// pair, nothing more: AC-2.5), call exactly one provider operation, hand the\n     5\t// form content back through HandlerOutcome. The drain's completion\n     6\t// transaction performs the version-checked UPDATE-only write (Story 1), so a\n     7\t// stale or deleted source discards here exactly as everywhere else. Outcomes\n     8\t// on tool-activity summaries come from outcome.ts — the record, never the\n     9\t// provider's text (AC-2.4) — and land in form metadata apart from content.\n    10\timport type {\n    11\t  HandlerFormWrite,\n    12\t  HandlerOutcome,\n    13\t  HandlerRunContext,\n    14\t  WorkHandler,\n    15\t} from \"../../../shared/derivation.js\";\n    16\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n    17\timport { deriveToolOutcome } from \"./outcome.js\";\n    18\timport {\n    19\t  findPairedToolCall,\n    20\t  findPairedToolResult,\n    21\t  readMessageSource,\n    22\t  type MessageSource,\n    23\t} from \"./forms.js\";\n    24\t\n    25\t// A handler that cannot read its source coherently has found source damage:\n    26\t// terminal, form blocked with the reason (never a retry loop against a\n    27\t// record that cannot improve). A *deleted* source never reaches this — its\n    28\t// form row is gone and the completion write would discard — so a miss here\n    29\t// is genuine corruption.\n    30\tfunction sourceDamaged(reason: string): HandlerOutcome {\n    31\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n    32\t}\n    33\t\n    34\tfunction loadSource(\n    35\t  run: HandlerRunContext,\n    36\t  item: { sourceRef: Record<string, string> },\n    37\t  expectedKind: string,\n    38\t):\n    39\t  | { ok: true; messageId: string; source: MessageSource }\n    40\t  | { ok: false; outcome: HandlerOutcome } {\n    41\t  const messageId = item.sourceRef[\"messageId\"];\n    42\t  if (messageId === undefined) {\n    43\t    return { ok: false, outcome: sourceDamaged(\"work item carries no messageId\") };\n    44\t  }\n    45\t  const source = readMessageSource(run.openDb(), messageId);\n    46\t  if (source === undefined) {\n    47\t    return { ok: false, outcome: sourceDamaged(`message ${messageId} not found`) };\n    48\t  }\n    49\t  if (source.kind !== expectedKind) {\n    50\t    return {\n    51\t      ok: false,\n    52\t      outcome: sourceDamaged(\n    53\t        `message ${messageId} is kind ${source.kind}, expected ${expectedKind}`,\n    54\t      ),\n    55\t    };\n    56\t  }\n    57\t  return { ok: true, messageId, source };\n    58\t}\n    59\t\n    60\tfunction landForm(\n    61\t  write: HandlerFormWrite,\n    62\t  result: { ok: true; text: string } | { ok: false; retryable: boolean; reason: string },\n    63\t): HandlerOutcome {\n    64\t  if (!result.ok) return { ok: false, retryable: result.retryable, reason: result.reason };\n    65\t  return { ok: true, forms: [{ ...write, content: result.text }] };\n    66\t}\n    67\t\n    68\tconst smoothPromptHandler: WorkHandler = async (run, item) => {\n    69\t  const loaded = loadSource(run, item, \"user_prompt\");\n    70\t  if (!loaded.ok) return loaded.outcome;\n    71\t  const text = loaded.source.blocks[0]?.content[\"text\"];\n    72\t  if (typeof text !== \"string\") {\n    73\t    return sourceDamaged(`prompt ${loaded.messageId} has no text block`);\n    74\t  }\n    75\t  return landForm(\n    76\t    {\n    77\t      subjectKind: \"message\",\n    78\t      subjectId: loaded.messageId,\n    79\t      form: \"smoothed_prompt\",\n    80\t      content: \"\",\n    81\t    },\n    82\t    await run.provider.smoothPrompt({ text }),\n    83\t  );\n    84\t};\n    85\t\n    86\tconst toolCallSummaryHandler: WorkHandler = async (run, item) => {\n    87\t  const loaded = loadSource(run, item, \"tool_call\");\n    88\t  if (!loaded.ok) return loaded.outcome;\n    89\t  const block = loaded.source.blocks[0]?.content ?? {};\n    90\t  const toolCallId = block[\"toolCallId\"];\n    91\t  const toolName = block[\"toolName\"];\n    92\t  if (typeof toolCallId !== \"string\" || typeof toolName !== \"string\") {\n    93\t    return sourceDamaged(`tool call ${loaded.messageId} has no tool_call block`);\n    94\t  }\n    95\t  // The handler's one reach beyond its message: the paired result by call id\n    96\t  // (AC-2.5). Outcome is stamped from that pairing mechanically — present and\n    97\t  // clean, present and isError, or absent — before the provider ever runs.\n    98\t  const paired = findPairedToolResult(run.openDb(), toolCallId);\n    99\t  const outcome = deriveToolOutcome(paired);\n   100\t  const input: Parameters<typeof run.provider.summarizeToolCall>[0] = {\n   101\t    toolName,\n   102\t    argsJson: JSON.stringify(block[\"arguments\"] ?? {}),\n   103\t  };\n   104\t  if (paired !== undefined) {\n   105\t    input.pairedResult = { content: paired.content, isError: paired.isError };\n   106\t  }\n   107\t  return landForm(\n   108\t    {\n   109\t      subjectKind: \"message\",\n   110\t      subjectId: loaded.messageId,\n   111\t      form: \"tool_call_summary\",\n   112\t      content: \"\",\n   113\t      metadata: { outcome },\n   114\t    },\n   115\t    await run.provider.summarizeToolCall(input),\n   116\t  );\n   117\t};\n   118\t\n   119\tconst toolResultSummaryHandler: WorkHandler = async (run, item) => {\n   120\t  const loaded = loadSource(run, item, \"tool_result\");\n   121\t  if (!loaded.ok) return loaded.outcome;\n   122\t  const block = loaded.source.blocks[0]?.content ?? {};\n   123\t  const content = block[\"content\"];\n   124\t  if (typeof content !== \"string\") {\n   125\t    return sourceDamaged(`tool result ${loaded.messageId} has no tool_result block`);\n   126\t  }\n   127\t  const toolCallId = block[\"toolCallId\"];\n   128\t  const pairedCall =\n   129\t    typeof toolCallId === \"string\"\n   130\t      ? findPairedToolCall(run.openDb(), toolCallId)\n   131\t      : undefined;\n   132\t  // The summary abbreviates; the full result content stays untouched in the\n   133\t  // record (AC-2.3) — nothing here writes back to message_block. The result\n   134\t  // is tool activity, so its outcome is stamped from its own isError flag.\n   135\t  return landForm(\n   136\t    {\n   137\t      subjectKind: \"message\",\n   138\t      subjectId: loaded.messageId,\n   139\t      form: \"tool_result_summary\",\n   140\t      content: \"\",\n   141\t      metadata: { outcome: deriveToolOutcome({ isError: block[\"isError\"] === true }) },\n   142\t    },\n   143\t    await run.provider.summarizeToolResult({\n   144\t      toolName: pairedCall?.toolName ?? \"unknown_tool\",\n   145\t      content,\n   146\t    }),\n   147\t  );\n   148\t};\n   149\t\n   150\t// The domain's handler table, merged into the SDK dispatch map at\n   151\t// construction (DD-6). Turn-owned kinds stay with the turns domain.\n   152\texport const messageWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n   153\t  prompt_smoothing: smoothPromptHandler,\n   154\t  tool_call_summary: toolCallSummaryHandler,\n   155\t  tool_result_summary: toolResultSummaryHandler,\n   156\t};\n","exit_code":0,"status":"completed"}}

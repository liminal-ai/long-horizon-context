{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/cli/work.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// `lhc work drain` plus the per-owner report and requeue mirrors (Story 4)\n     2\t// — work.ts owns the drain/report/requeue command surface per tech design\n     3\t// §Placement. Provider resolution per DD-11: explicit `--provider` or\n     4\t// LHC_PROVIDER, looked up in the named-provider registry; no default and no\n     5\t// silent no-op — an unresolvable provider is a caller error naming both the\n     6\t// flag and the env var. Report, requeue, and mutations need no provider;\n     7\t// only drain dispatches handlers.\n     8\timport * as messages from \"../domains/messages/index.js\";\n     9\timport * as turns from \"../domains/turns/index.js\";\n    10\timport type { ThreadRef } from \"../domains/threads/index.js\";\n    11\timport { registeredProviderNames, resolveNamedProvider } from \"../providers/registry.js\";\n    12\timport { createSdk } from \"../sdk.js\";\n    13\timport type { DerivationProvider, FormKind } from \"../shared/derivation.js\";\n    14\timport type { ErrorResult, OpResult } from \"../shared/errors.js\";\n    15\timport { renderResult, type CliResult } from \"./render.js\";\n    16\t\n    17\tfunction providerNotConfigured(reason: string): { ok: false; error: ErrorResult } {\n    18\t  return {\n    19\t    ok: false,\n    20\t    error: { errorClass: \"caller_error\", code: \"provider_not_configured\", reason },\n    21\t  };\n    22\t}\n    23\t\n    24\texport function resolveCliProvider(\n    25\t  providerFlag: string | undefined,\n    26\t): OpResult<DerivationProvider> {\n    27\t  const name = providerFlag ?? process.env[\"LHC_PROVIDER\"];\n    28\t  if (name === undefined || name === \"\") {\n    29\t    return providerNotConfigured(\n    30\t      \"work drain needs a derivation provider: pass --provider <name> or set LHC_PROVIDER\",\n    31\t    );\n    32\t  }\n    33\t  const provider = resolveNamedProvider(name);\n    34\t  if (provider === undefined) {\n    35\t    return providerNotConfigured(\n    36\t      `no provider registered under \"${name}\" (--provider / LHC_PROVIDER); known: ${registeredProviderNames().join(\", \")}`,\n    37\t    );\n    38\t  }\n    39\t  return { ok: true, value: provider };\n    40\t}\n    41\t\n    42\texport async function runWorkDrain(\n    43\t  threadRef: ThreadRef,\n    44\t  flags: { provider?: string; maxItems?: number },\n    45\t): Promise<CliResult> {\n    46\t  const provider = resolveCliProvider(flags.provider);\n    47\t  if (!provider.ok) return renderResult(provider);\n    48\t  // The CLI is the manual host: it assembles the same SDK production hosts\n    49\t  // do and drains through the same surface — no in-process shortcut.\n    50\t  const sdk = createSdk({ provider: provider.value, mode: \"manual\" });\n    51\t  return renderResult(\n    52\t    await sdk.work.drain(\n    53\t      threadRef,\n    54\t      flags.maxItems !== undefined ? { maxItems: flags.maxItems } : undefined,\n    55\t    ),\n    56\t  );\n    57\t}\n    58\t\n    59\t// The report and requeue mirrors call the same domain operations the SDK\n    60\t// surfaces expose — same validation, same result JSON (AC-4.3/AC-4.4 CLI\n    61\t// parity). Form names pass through as given; an unknown form is refused by\n    62\t// the operation's own mapping check, identically to an SDK caller.\n    63\t\n    64\texport async function runMessagesReport(\n    65\t  threadRef: ThreadRef,\n    66\t  flags: { notReady?: boolean; messageId?: string },\n    67\t): Promise<CliResult> {\n    68\t  const opts: { notReady?: boolean; messageId?: string } = {};\n    69\t  if (flags.notReady === true) opts.notReady = true;\n    70\t  if (flags.messageId !== undefined) opts.messageId = flags.messageId;\n    71\t  return renderResult(await messages.report(threadRef, opts));\n    72\t}\n    73\t\n    74\texport async function runMessagesRequeue(\n    75\t  threadRef: ThreadRef,\n    76\t  flags: { messageId: string; form: string },\n    77\t): Promise<CliResult> {\n    78\t  return renderResult(\n    79\t    await messages.requeue(threadRef, {\n    80\t      messageId: flags.messageId,\n    81\t      form: flags.form as FormKind,\n    82\t    }),\n    83\t  );\n    84\t}\n    85\t\n    86\texport async function runTurnsReport(\n    87\t  threadRef: ThreadRef,\n    88\t  flags: { notReady?: boolean; turnId?: string; chunkId?: string },\n    89\t): Promise<CliResult> {\n    90\t  const opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n    91\t  if (flags.notReady === true) opts.notReady = true;\n    92\t  if (flags.turnId !== undefined) opts.turnId = flags.turnId;\n    93\t  if (flags.chunkId !== undefined) opts.chunkId = flags.chunkId;\n    94\t  return renderResult(await turns.report(threadRef, opts));\n    95\t}\n    96\t\n    97\texport async function runTurnsRequeue(\n    98\t  threadRef: ThreadRef,\n    99\t  flags: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: string },\n   100\t): Promise<CliResult> {\n   101\t  return renderResult(\n   102\t    await turns.requeue(threadRef, {\n   103\t      subjectKind: flags.subjectKind,\n   104\t      subjectId: flags.subjectId,\n   105\t      form: flags.form as FormKind,\n   106\t    }),\n   107\t  );\n   108\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/forms.ts | sed -n '1,280p'\"","aggregated_output":"     1\t// Turn-domain reads for derivation (Flow 3): the turn handler's view of its\n     2\t// source turn, the member messages it composes (deleted-filtered — the\n     3\t// shared read-filter rule lives here, once for this domain), the\n     4\t// message-level form rows composition consumes, and the member projections\n     5\t// the chunk summaries read. Completion writes for turn- and chunk-owned\n     6\t// forms ride the work-queue util's `complete` (UPDATE-only, version-checked)\n     7\t// — no write path here.\n     8\timport type { DatabaseSync } from \"node:sqlite\";\n     9\timport type {\n    10\t  DerivedFormState,\n    11\t  FormReportEntry,\n    12\t  RenderingPartKind,\n    13\t  ToolRunReceipt,\n    14\t} from \"../../../shared/derivation.js\";\n    15\timport { reportEntryFromRow, type RawReportRow } from \"../../../shared/report.js\";\n    16\timport type { ComposeFormRow, ComposeMessage } from \"./compose.js\";\n    17\timport { composeFormKey } from \"./compose.js\";\n    18\timport type { FormKind, SubjectKind } from \"../../../shared/derivation.js\";\n    19\t\n    20\texport interface TurnSource {\n    21\t  turnId: string;\n    22\t  status: \"open\" | \"closed\";\n    23\t  deleted: boolean;\n    24\t}\n    25\t\n    26\texport function readTurnSource(db: DatabaseSync, turnId: string): TurnSource | undefined {\n    27\t  const row = db\n    28\t    .prepare(`SELECT status, deleted_at FROM turns WHERE turn_id = ?`)\n    29\t    .get(turnId) as unknown as { status: string; deleted_at: string | null } | undefined;\n    30\t  if (row === undefined) return undefined;\n    31\t  return {\n    32\t    turnId,\n    33\t    status: row.status as TurnSource[\"status\"],\n    34\t    deleted: row.deleted_at !== null,\n    35\t  };\n    36\t}\n    37\t\n    38\t// Member messages in message order, blocks attached, deleted messages\n    39\t// filtered (tech design §Mechanics: composition's member enumeration reads\n    40\t// the live projection only).\n    41\texport function readMemberMessages(db: DatabaseSync, turnId: string): ComposeMessage[] {\n    42\t  const messages = db\n    43\t    .prepare(\n    44\t      `SELECT message_id, kind FROM message\n    45\t       WHERE turn_id = ? AND deleted_at IS NULL ORDER BY source_event_order`,\n    46\t    )\n    47\t    .all(turnId) as unknown as Array<{ message_id: string; kind: string }>;\n    48\t  const blockStmt = db.prepare(\n    49\t    `SELECT block_type, content FROM message_block\n    50\t     WHERE message_id = ? ORDER BY block_index`,\n    51\t  );\n    52\t  return messages.map((message) => {\n    53\t    const blocks = blockStmt.all(message.message_id) as unknown as Array<{\n    54\t      block_type: string;\n    55\t      content: string;\n    56\t    }>;\n    57\t    return {\n    58\t      messageId: message.message_id,\n    59\t      kind: message.kind as RenderingPartKind,\n    60\t      blocks: blocks.map((block) => ({\n    61\t        blockType: block.block_type,\n    62\t        content: JSON.parse(block.content) as Record<string, unknown>,\n    63\t      })),\n    64\t    };\n    65\t  });\n    66\t}\n    67\t\n    68\t// The message-owned form rows for a set of member messages, keyed for\n    69\t// composition. A cross-owner *read* by design: composition consumes message\n    70\t// forms; only message handlers ever write them (DD-2 ownership is a write\n    71\t// rule).\n    72\texport function readMessageFormRows(\n    73\t  db: DatabaseSync,\n    74\t  messageIds: readonly string[],\n    75\t): Map<string, ComposeFormRow> {\n    76\t  const rows = new Map<string, ComposeFormRow>();\n    77\t  if (messageIds.length === 0) return rows;\n    78\t  const placeholders = messageIds.map(() => \"?\").join(\", \");\n    79\t  const raw = db\n    80\t    .prepare(\n    81\t      `SELECT subject_id, form, state, content, metadata FROM derived_form\n    82\t       WHERE subject_kind = 'message' AND subject_id IN (${placeholders})`,\n    83\t    )\n    84\t    .all(...messageIds) as unknown as Array<{\n    85\t    subject_id: string;\n    86\t    form: string;\n    87\t    state: string;\n    88\t    content: string | null;\n    89\t    metadata: string | null;\n    90\t  }>;\n    91\t  for (const row of raw) {\n    92\t    const view: ComposeFormRow = { state: row.state as ComposeFormRow[\"state\"] };\n    93\t    if (row.content !== null) view.content = row.content;\n    94\t    if (row.metadata !== null) {\n    95\t      view.metadata = JSON.parse(row.metadata) as NonNullable<ComposeFormRow[\"metadata\"]>;\n    96\t    }\n    97\t    rows.set(composeFormKey(row.subject_id, row.form as FormKind), view);\n    98\t  }\n    99\t  return rows;\n   100\t}\n   101\t\n   102\t// Member projections in turn order for the chunk summaries: member rows by\n   103\t// member_idx, deleted turns filtered, each joined to its stored\n   104\t// lower_band_projection row (state + content as landed — never re-derived)\n   105\t// and to its turn_rendering's mechanically stamped tool-run receipts\n   106\t// (AC-3.8: the detailed summary's receipt material, read not re-derived).\n   107\texport interface MemberProjection {\n   108\t  turnId: string;\n   109\t  state?: string; // undefined: no projection row exists for the member\n   110\t  content?: string;\n   111\t  receipts: ToolRunReceipt[]; // empty when the member turn had no tool activity\n   112\t}\n   113\t\n   114\texport function readMemberProjections(db: DatabaseSync, chunkId: string): MemberProjection[] {\n   115\t  const rows = db\n   116\t    .prepare(\n   117\t      `SELECT cm.turn_id, df.state, df.content, rf.metadata AS rendering_metadata\n   118\t       FROM chunk_member cm\n   119\t       JOIN turns t ON t.turn_id = cm.turn_id AND t.deleted_at IS NULL\n   120\t       LEFT JOIN derived_form df ON df.subject_kind = 'turn'\n   121\t         AND df.subject_id = cm.turn_id AND df.form = 'lower_band_projection'\n   122\t       LEFT JOIN derived_form rf ON rf.subject_kind = 'turn'\n   123\t         AND rf.subject_id = cm.turn_id AND rf.form = 'turn_rendering'\n   124\t       WHERE cm.chunk_id = ? ORDER BY cm.member_idx`,\n   125\t    )\n   126\t    .all(chunkId) as unknown as Array<{\n   127\t    turn_id: string;\n   128\t    state: string | null;\n   129\t    content: string | null;\n   130\t    rendering_metadata: string | null;\n   131\t  }>;\n   132\t  return rows.map((row) => {\n   133\t    const metadata =\n   134\t      row.rendering_metadata === null\n   135\t        ? undefined\n   136\t        : (JSON.parse(row.rendering_metadata) as { receipts?: ToolRunReceipt[] });\n   137\t    const projection: MemberProjection = {\n   138\t      turnId: row.turn_id,\n   139\t      receipts: metadata?.receipts ?? [],\n   140\t    };\n   141\t    if (row.state !== null) projection.state = row.state;\n   142\t    if (row.content !== null) projection.content = row.content;\n   143\t    return projection;\n   144\t  });\n   145\t}\n   146\t\n   147\t// One form row by exact key for this owner's subjects — the requeue\n   148\t// operation's refusal read (missing row, blocked state, current version).\n   149\texport function readTurnFormRow(\n   150\t  db: DatabaseSync,\n   151\t  subjectKind: \"turn\" | \"chunk\",\n   152\t  subjectId: string,\n   153\t  form: FormKind,\n   154\t): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\n   155\t  const row = db\n   156\t    .prepare(\n   157\t      `SELECT state, reason, source_version FROM derived_form\n   158\t       WHERE subject_kind = ? AND subject_id = ? AND form = ?`,\n   159\t    )\n   160\t    .get(subjectKind, subjectId, form) as unknown as\n   161\t    | { state: string; reason: string | null; source_version: number | bigint }\n   162\t    | undefined;\n   163\t  if (row === undefined) return undefined;\n   164\t  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\n   165\t    state: row.state as DerivedFormState,\n   166\t    sourceVersion: Number(row.source_version),\n   167\t  };\n   168\t  if (row.reason !== null) view.reason = row.reason;\n   169\t  return view;\n   170\t}\n   171\t\n   172\t// The turns owner's report (Flow 4): one query over turn- and chunk-owned\n   173\t// form rows LEFT JOINed with the live work_item targeting each form at its\n   174\t// current source version. Both turn forms map to the one turn_derivation\n   175\t// kind; the chunk summary forms map to their same-named kinds — the CASE is\n   176\t// this owner's queue-site mapping inverted, mirroring the messages report.\n   177\texport function reportTurnForms(\n   178\t  db: DatabaseSync,\n   179\t  opts: { notReady?: boolean; turnId?: string; chunkId?: string } = {},\n   180\t): FormReportEntry[] {\n   181\t  const conditions = [\"df.subject_kind IN ('turn', 'chunk')\"];\n   182\t  const params: string[] = [];\n   183\t  const subjectFilters: string[] = [];\n   184\t  if (opts.turnId !== undefined) {\n   185\t    subjectFilters.push(\"(df.subject_kind = 'turn' AND df.subject_id = ?)\");\n   186\t    params.push(opts.turnId);\n   187\t  }\n   188\t  if (opts.chunkId !== undefined) {\n   189\t    subjectFilters.push(\"(df.subject_kind = 'chunk' AND df.subject_id = ?)\");\n   190\t    params.push(opts.chunkId);\n   191\t  }\n   192\t  if (subjectFilters.length > 0) conditions.push(`(${subjectFilters.join(\" OR \")})`);\n   193\t  // notReady is exact set equality by construction: every state but ready.\n   194\t  if (opts.notReady === true) conditions.push(\"df.state <> 'ready'\");\n   195\t  const rows = db\n   196\t    .prepare(\n   197\t      `SELECT df.subject_kind, df.subject_id, df.form, df.state, df.content, df.reason,\n   198\t              df.metadata, df.source_version, df.gaps, df.derived_at,\n   199\t              w.status AS queue_status, w.attempts AS queue_attempts,\n   200\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\n   201\t       FROM derived_form df\n   202\t       LEFT JOIN work_item w\n   203\t         ON w.status IN ('queued', 'claimed')\n   204\t        AND w.kind = CASE WHEN df.subject_kind = 'turn' THEN 'turn_derivation' ELSE df.form END\n   205\t        AND json_extract(\n   206\t              w.source_ref,\n   207\t              CASE WHEN df.subject_kind = 'turn' THEN '$.turnId' ELSE '$.chunkId' END\n   208\t            ) = df.subject_id\n   209\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\n   210\t       WHERE ${conditions.join(\" AND \")}\n   211\t       ORDER BY df.subject_kind DESC, df.subject_id, df.form`,\n   212\t    )\n   213\t    .all(...params) as unknown as Array<RawReportRow & { subject_kind: string }>;\n   214\t  return rows.map((row) => reportEntryFromRow(row.subject_kind as SubjectKind, row));\n   215\t}\n   216\t\n   217\texport function chunkExists(db: DatabaseSync, chunkId: string): boolean {\n   218\t  return (\n   219\t    db.prepare(`SELECT 1 FROM chunk WHERE chunk_id = ?`).get(chunkId) !== undefined\n   220\t  );\n   221\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/index.ts | sed -n '1,380p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n     3\timport type {\n     4\t  FormKind,\n     5\t  FormReportEntry,\n     6\t  WorkHandler,\n     7\t} from \"../../shared/derivation.js\";\n     8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     9\timport {\n    10\t  enqueue,\n    11\t  hasLiveItem,\n    12\t  listItems,\n    13\t  type EnqueueFormTarget,\n    14\t  type WorkItemRecord,\n    15\t  type WorkKind,\n    16\t  type WorkSourceRef,\n    17\t} from \"../../tech-utils/work-queue/index.js\";\n    18\timport type { EventKind } from \"../intake-stream/index.js\";\n    19\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n    20\timport { transition } from \"./internal/state-machine.js\";\n    21\t\n    22\t// The pure rule table, re-exported for the golden supplemental suite (the\n    23\t// test plan's one sanctioned direct entry besides the tokenizer); production\n    24\t// callers go through applyEvent.\n    25\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n    26\timport { turnWorkHandlers } from \"./internal/derive.js\";\n    27\timport { readTurnFormRow, reportTurnForms } from \"./internal/forms.js\";\n    28\timport {\n    29\t  closeTurn,\n    30\t  insertOpenTurn,\n    31\t  nextTurnOrder,\n    32\t  readTurns,\n    33\t  selectOpenTurnIds,\n    34\t} from \"./internal/store.js\";\n    35\t\n    36\texport interface TurnRecord {\n    37\t  turnId: string;\n    38\t  status: \"open\" | \"closed\";\n    39\t  memberMessageIds: string[];\n    40\t  openedAtEventOrder: number;\n    41\t  closedAtEventOrder?: number;\n    42\t  // Chunk placement (Epic 02 Story 3, AC-3.5): present once the turn's\n    43\t  // derivation placed it — stored values read back, never recomputed.\n    44\t  chunkId?: string;\n    45\t  memberIdx?: number;\n    46\t}\n    47\t\n    48\texport interface TurnTransitionOutcome {\n    49\t  // Transitions in occurrence order: a close_then_open reports the close\n    50\t  // first, then the open, exactly as the batch result surfaces them.\n    51\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n    52\t  // Turn state after the transition — the stamp for this event's message.\n    53\t  // Prompts see the turn they just opened (transition first, then stamp);\n    54\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n    55\t  openTurnId: string | null;\n    56\t  // Work queued by this transition: one turn_derivation item per closed\n    57\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\n    58\t  queuedWork: WorkItemRecord[];\n    59\t}\n    60\t\n    61\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n    62\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n    63\t// writes turn state, so more than one open turn means external interference.\n    64\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n    65\t  return selectOpenTurnIds(ctx.db);\n    66\t}\n    67\t\n    68\t// Closing a turn — by either close path — durably queues that turn's\n    69\t// derivation work in the same transaction (AC-3.6): the close update and the\n    70\t// work item commit or roll back together.\n    71\tfunction closeTurnAndQueueWork(\n    72\t  ctx: OperationContext,\n    73\t  turnId: string,\n    74\t  eventOrder: number,\n    75\t): WorkItemRecord {\n    76\t  closeTurn(ctx.db, turnId, eventOrder);\n    77\t  // One work item, two derived forms: the turn_derivation handler (Story 3)\n    78\t  // lands the rendering and the lower-band projection as independent rows;\n    79\t  // both go pending with the enqueue (DD-5).\n    80\t  return enqueue(ctx, {\n    81\t    owner: \"turns\",\n    82\t    kind: \"turn_derivation\",\n    83\t    sourceRef: { turnId },\n    84\t    forms: [\n    85\t      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n    86\t      { subjectKind: \"turn\", subjectId: turnId, form: \"lower_band_projection\" },\n    87\t    ],\n    88\t  });\n    89\t}\n    90\t\n    91\t// Turn-owned work handlers, merged into the SDK's dispatch map at\n    92\t// construction (DD-6): turn derivation and the two chunk summaries.\n    93\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n    94\t  turnWorkHandlers;\n    95\t\n    96\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    97\t// for every recorded event. Synchronous and throwing by design, like\n    98\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n    99\texport function applyEvent(\n   100\t  ctx: OperationContext,\n   101\t  eventKind: EventKind,\n   102\t  eventOrder: number,\n   103\t): TurnTransitionOutcome {\n   104\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n   105\t  const effect = transition({ openTurnId }, eventKind);\n   106\t  switch (effect.kind) {\n   107\t    case \"none\":\n   108\t      return { transitions: [], openTurnId, queuedWork: [] };\n   109\t    case \"open\": {\n   110\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   111\t      return {\n   112\t        transitions: [{ action: \"opened\", turnId }],\n   113\t        openTurnId: turnId,\n   114\t        queuedWork: [],\n   115\t      };\n   116\t    }\n   117\t    case \"close\": {\n   118\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   119\t      return {\n   120\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n   121\t        openTurnId: null,\n   122\t        queuedWork: [item],\n   123\t      };\n   124\t    }\n   125\t    case \"close_then_open\": {\n   126\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   127\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   128\t      return {\n   129\t        transitions: [\n   130\t          { action: \"closed\", turnId: openTurnId as string },\n   131\t          { action: \"opened\", turnId },\n   132\t        ],\n   133\t        openTurnId: turnId,\n   134\t        queuedWork: [item],\n   135\t      };\n   136\t    }\n   137\t  }\n   138\t}\n   139\t\n   140\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   141\t  return {\n   142\t    ok: false,\n   143\t    error: {\n   144\t      errorClass: \"caller_error\",\n   145\t      code: \"thread_not_found\",\n   146\t      reason: `no thread file exists at ${filePath}`,\n   147\t    },\n   148\t  };\n   149\t}\n   150\t\n   151\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n   152\t  const resolved = await resolveThreadRef(thread);\n   153\t  if (!resolved.ok) return resolved;\n   154\t  const { filePath } = resolved.value;\n   155\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   156\t\n   157\t  const opened = openThreadDatabase(filePath);\n   158\t  if (!opened.ok) return opened;\n   159\t  const db = opened.value;\n   160\t  try {\n   161\t    return { ok: true, value: readTurns(db) };\n   162\t  } catch (cause) {\n   163\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   164\t    return storageFailure(`turn read-back failed: ${reason}`);\n   165\t  } finally {\n   166\t    db.close();\n   167\t  }\n   168\t}\n   169\t\n   170\texport async function listQueuedWork(\n   171\t  thread: ThreadRef,\n   172\t): Promise<OpResult<WorkItemRecord[]>> {\n   173\t  const resolved = await resolveThreadRef(thread);\n   174\t  if (!resolved.ok) return resolved;\n   175\t  const { filePath } = resolved.value;\n   176\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   177\t\n   178\t  const opened = openThreadDatabase(filePath);\n   179\t  if (!opened.ok) return opened;\n   180\t  const db = opened.value;\n   181\t  try {\n   182\t    return { ok: true, value: listItems(db, \"turns\") };\n   183\t  } catch (cause) {\n   184\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   185\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   186\t  } finally {\n   187\t    db.close();\n   188\t  }\n   189\t}\n   190\t\n   191\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   192\t\n   193\t// This owner's repair report: every turn- and chunk-owned form's durable\n   194\t// state joined with live queue detail in one query. Needs no provider;\n   195\t// reads degrade, never block.\n   196\texport async function report(\n   197\t  thread: ThreadRef,\n   198\t  opts?: { notReady?: boolean; turnId?: string; chunkId?: string },\n   199\t): Promise<OpResult<FormReportEntry[]>> {\n   200\t  const resolved = await resolveThreadRef(thread);\n   201\t  if (!resolved.ok) return resolved;\n   202\t  const { filePath } = resolved.value;\n   203\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   204\t\n   205\t  const opened = openThreadDatabase(filePath);\n   206\t  if (!opened.ok) return opened;\n   207\t  const db = opened.value;\n   208\t  try {\n   209\t    return { ok: true, value: reportTurnForms(db, opts ?? {}) };\n   210\t  } catch (cause) {\n   211\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   212\t    return storageFailure(`report read failed: ${reason}`);\n   213\t  } finally {\n   214\t    db.close();\n   215\t  }\n   216\t}\n   217\t\n   218\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n   219\t\n   220\t// The queue site each turn-owned form rebuilds through. Both turn forms ride\n   221\t// the one turn_derivation item (the handler lands rendering and projection\n   222\t// together, so a rebuild of either re-derives both — the rebuild rule from\n   223\t// Flow 3); each chunk summary rides its same-named kind alone (AC-3.8's\n   224\t// independent lifecycles).\n   225\tfunction turnRequeueTarget(target: {\n   226\t  subjectKind: \"turn\" | \"chunk\";\n   227\t  subjectId: string;\n   228\t  form: FormKind;\n   229\t}): { kind: WorkKind; sourceRef: WorkSourceRef; forms: EnqueueFormTarget[] } | undefined {\n   230\t  if (\n   231\t    target.subjectKind === \"turn\" &&\n   232\t    (target.form === \"turn_rendering\" || target.form === \"lower_band_projection\")\n   233\t  ) {\n   234\t    return {\n   235\t      kind: \"turn_derivation\",\n   236\t      sourceRef: { turnId: target.subjectId },\n   237\t      forms: [\n   238\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"turn_rendering\" },\n   239\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"lower_band_projection\" },\n   240\t      ],\n   241\t    };\n   242\t  }\n   243\t  if (\n   244\t    target.subjectKind === \"chunk\" &&\n   245\t    (target.form === \"chunk_summary_detailed\" || target.form === \"chunk_summary_brief\")\n   246\t  ) {\n   247\t    return {\n   248\t      kind: target.form,\n   249\t      sourceRef: { chunkId: target.subjectId },\n   250\t      forms: [{ subjectKind: \"chunk\", subjectId: target.subjectId, form: target.form }],\n   251\t    };\n   252\t  }\n   253\t  return undefined;\n   254\t}\n   255\t\n   256\t// Explicit re-queue through the owning surface (AC-4.4): same contract as\n   257\t// messages.requeue — blocked refused with the stored damage reason, missing\n   258\t// rows refused, no-op against live work at the current source version, and\n   259\t// the no-op check + enqueue in one transaction. A successful requeue rebuilds\n   260\t// at the next source version: composed forms recompute their gaps from\n   261\t// current dependency states (Flow 3's rebuild rule).\n   262\texport async function requeue(\n   263\t  thread: ThreadRef,\n   264\t  target: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: FormKind },\n   265\t): Promise<OpResult<RequeueOutcome>> {\n   266\t  const mapped = turnRequeueTarget(target);\n   267\t  if (mapped === undefined) {\n   268\t    return {\n   269\t      ok: false,\n   270\t      error: {\n   271\t        errorClass: \"caller_error\",\n   272\t        code: \"turn_not_found\",\n   273\t        reason: `form ${target.form} is not a ${target.subjectKind}-owned form; turns.requeue repairs turn_rendering and lower_band_projection (turn) or chunk_summary_detailed and chunk_summary_brief (chunk)`,\n   274\t      },\n   275\t    };\n   276\t  }\n   277\t  const resolved = await resolveThreadRef(thread);\n   278\t  if (!resolved.ok) return resolved;\n   279\t  const { filePath } = resolved.value;\n   280\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   281\t\n   282\t  const opened = openThreadDatabase(filePath);\n   283\t  if (!opened.ok) return opened;\n   284\t  const db = opened.value;\n   285\t  try {\n   286\t    const meta = db\n   287\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   288\t      .get() as { thread_id: string } | undefined;\n   289\t    const threadId = meta?.thread_id ?? \"\";\n   290\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   291\t      const row = readTurnFormRow(ctx.db, target.subjectKind, target.subjectId, target.form);\n   292\t      if (row === undefined) {\n   293\t        return {\n   294\t          ok: false,\n   295\t          error: {\n   296\t            errorClass: \"caller_error\",\n   297\t            code: \"turn_not_found\",\n   298\t            reason: `no derived form ${target.form} exists for ${target.subjectKind} ${target.subjectId}`,\n   299\t          },\n   300\t        };\n   301\t      }\n   302\t      if (row.state === \"blocked\") {\n   303\t        // The refusal carries the form's stored reason — the damage named at\n   304\t        // blocking time, not a generic string (AC-4.6).\n   305\t        return {\n   306\t          ok: false,\n   307\t          error: {\n   308\t            errorClass: \"state_corruption\",\n   309\t            code: \"source_damaged\",\n   310\t            reason:\n   311\t              row.reason ??\n   312\t              `form ${target.form} for ${target.subjectKind} ${target.subjectId} is blocked`,\n   313\t          },\n   314\t        };\n   315\t      }\n   316\t      if (hasLiveItem(ctx.db, mapped.kind, mapped.sourceRef, row.sourceVersion)) {\n   317\t        return { ok: true, value: { noop: \"already_queued\" } };\n   318\t      }\n   319\t      const item = enqueue(ctx, {\n   320\t        owner: \"turns\",\n   321\t        kind: mapped.kind,\n   322\t        sourceRef: mapped.sourceRef,\n   323\t        sourceVersion: row.sourceVersion + 1,\n   324\t        forms: mapped.forms,\n   325\t      });\n   326\t      return { ok: true, value: { workItemId: item.workItemId } };\n   327\t    });\n   328\t  } catch (cause) {\n   329\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   330\t    return storageFailure(`requeue failed: ${reason}`);\n   331\t  } finally {\n   332\t    db.close();\n   333\t  }\n   334\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/cli/index.ts | sed -n '1,360p'\"","aggregated_output":"     1\timport { parseArgs } from \"node:util\";\n     2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n     3\timport * as messages from \"../domains/messages/index.js\";\n     4\timport * as threads from \"../domains/threads/index.js\";\n     5\timport * as turns from \"../domains/turns/index.js\";\n     6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n     7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n     8\timport type { OpResult } from \"../shared/errors.js\";\n     9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n    10\timport {\n    11\t  runMessagesReport,\n    12\t  runMessagesRequeue,\n    13\t  runTurnsReport,\n    14\t  runTurnsRequeue,\n    15\t  runWorkDrain,\n    16\t} from \"./work.js\";\n    17\t\n    18\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n    19\t// process stdin. null means interactive (TTY) — distinct from empty input\n    20\t// only in how it arises; both are refused with empty_stdin before any SDK\n    21\t// call (the SDK itself can never return that code).\n    22\texport type StdinReader = () => Promise<string | null>;\n    23\t\n    24\tasync function readProcessStdin(): Promise<string | null> {\n    25\t  if (process.stdin.isTTY) return null;\n    26\t  process.stdin.setEncoding(\"utf8\");\n    27\t  let data = \"\";\n    28\t  for await (const chunk of process.stdin) data += String(chunk);\n    29\t  return data;\n    30\t}\n    31\t\n    32\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n    33\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n    34\t}\n    35\t\n    36\tconst HELP = `lhc — Long Horizon Context CLI\n    37\t\n    38\tUsage:\n    39\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n    40\t  lhc threads resolve --thread-id <id> [--registry <r>]\n    41\t  lhc threads list [--registry <r>]\n    42\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n    43\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n    44\t  lhc messages list (--thread-id <id> | --file-path <p>) [--registry <r>]\n    45\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n    46\t  lhc messages report (--thread-id <id> | --file-path <p>) [--not-ready] [--message-id <id>] [--registry <r>]\n    47\t  lhc messages requeue (--thread-id <id> | --file-path <p>) --message-id <id> --form <form> [--registry <r>]\n    48\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n    49\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n    50\t  lhc turns report (--thread-id <id> | --file-path <p>) [--not-ready] [--turn-id <id>] [--chunk-id <id>] [--registry <r>]\n    51\t  lhc turns requeue (--thread-id <id> | --file-path <p>) --subject-kind (turn|chunk) --subject-id <id> --form <form> [--registry <r>]\n    52\t  lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n    53\t\n    54\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n    55\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n    56\t`;\n    57\t\n    58\tinterface ParsedFlags {\n    59\t  threadId?: string;\n    60\t  filePath?: string;\n    61\t  title?: string;\n    62\t  registryPath?: string;\n    63\t  maxItems?: string;\n    64\t  provider?: string;\n    65\t  notReady?: boolean;\n    66\t  messageId?: string;\n    67\t  turnId?: string;\n    68\t  chunkId?: string;\n    69\t  form?: string;\n    70\t  subjectKind?: string;\n    71\t  subjectId?: string;\n    72\t}\n    73\t\n    74\t// strict parse rejects unknown/misspelled flags so they are named back to the\n    75\t// caller, never silently dropped — the CLI boundary matching the SDK's\n    76\t// closed-contract strictness. The failure is returned as data (not thrown) so\n    77\t// runCli can render it as the structured usage error.\n    78\ttype ParseFlagsResult =\n    79\t  | { ok: true; flags: ParsedFlags }\n    80\t  | { ok: false; unknownFlag: string };\n    81\t\n    82\tfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n    83\t  let values;\n    84\t  try {\n    85\t    ({ values } = parseArgs({\n    86\t      args: [...args],\n    87\t      options: {\n    88\t        \"thread-id\": { type: \"string\" },\n    89\t        \"file-path\": { type: \"string\" },\n    90\t        title: { type: \"string\" },\n    91\t        registry: { type: \"string\" },\n    92\t        \"max-items\": { type: \"string\" },\n    93\t        provider: { type: \"string\" },\n    94\t        \"not-ready\": { type: \"boolean\" },\n    95\t        \"message-id\": { type: \"string\" },\n    96\t        \"turn-id\": { type: \"string\" },\n    97\t        \"chunk-id\": { type: \"string\" },\n    98\t        form: { type: \"string\" },\n    99\t        \"subject-kind\": { type: \"string\" },\n   100\t        \"subject-id\": { type: \"string\" },\n   101\t      },\n   102\t      strict: true,\n   103\t      allowPositionals: true,\n   104\t    }));\n   105\t  } catch (cause) {\n   106\t    const message = cause instanceof Error ? cause.message : String(cause);\n   107\t    // parseArgs names the offending option in single quotes (e.g. Unknown\n   108\t    // option '--file-pth'); surface that token, falling back to the message.\n   109\t    const named = /'([^']+)'/.exec(message);\n   110\t    return { ok: false, unknownFlag: named?.[1] ?? message };\n   111\t  }\n   112\t  const flags: ParsedFlags = {};\n   113\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n   114\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n   115\t  if (typeof values.title === \"string\") flags.title = values.title;\n   116\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n   117\t  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n   118\t  if (typeof values.provider === \"string\") flags.provider = values.provider;\n   119\t  if (values[\"not-ready\"] === true) flags.notReady = true;\n   120\t  if (typeof values[\"message-id\"] === \"string\") flags.messageId = values[\"message-id\"];\n   121\t  if (typeof values[\"turn-id\"] === \"string\") flags.turnId = values[\"turn-id\"];\n   122\t  if (typeof values[\"chunk-id\"] === \"string\") flags.chunkId = values[\"chunk-id\"];\n   123\t  if (typeof values.form === \"string\") flags.form = values.form;\n   124\t  if (typeof values[\"subject-kind\"] === \"string\") flags.subjectKind = values[\"subject-kind\"];\n   125\t  if (typeof values[\"subject-id\"] === \"string\") flags.subjectId = values[\"subject-id\"];\n   126\t  return { ok: true, flags };\n   127\t}\n   128\t\n   129\t// The read commands take a thread reference but no stdin; a missing reference\n   130\t// is a usage error named before any SDK call, matching the intake commands.\n   131\tfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n   132\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n   133\t    return renderCliError(\n   134\t      \"caller_error\",\n   135\t      \"missing_flag\",\n   136\t      `${command} requires --thread-id or --file-path`,\n   137\t    );\n   138\t  }\n   139\t  return undefined;\n   140\t}\n   141\t\n   142\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n   143\t  if (flags.threadId !== undefined) {\n   144\t    return flags.registryPath !== undefined\n   145\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n   146\t      : { threadId: flags.threadId };\n   147\t  }\n   148\t  return { filePath: flags.filePath ?? \"\" };\n   149\t}\n   150\t\n   151\texport async function runCli(\n   152\t  argv: readonly string[],\n   153\t  readStdin: StdinReader = readProcessStdin,\n   154\t): Promise<CliResult> {\n   155\t  if (argv.length === 0) {\n   156\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n   157\t  }\n   158\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n   159\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n   160\t  }\n   161\t\n   162\t  const [group, command, ...rest] = argv;\n   163\t  const key = command === undefined ? group : `${group} ${command}`;\n   164\t  const parsed = parseFlags(command === undefined ? [] : rest);\n   165\t  if (!parsed.ok) {\n   166\t    return renderCliError(\n   167\t      \"caller_error\",\n   168\t      \"unknown_flag\",\n   169\t      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n   170\t    );\n   171\t  }\n   172\t  const flags = parsed.flags;\n   173\t\n   174\t  switch (key) {\n   175\t    case \"threads new-thread\": {\n   176\t      // Guard here: an empty path reaching node:sqlite opens a temp database\n   177\t      // instead of failing, so the adapter refuses before any SDK call.\n   178\t      if (flags.filePath === undefined) {\n   179\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n   180\t      }\n   181\t      const input: Parameters<typeof threads.newThread>[0] = {\n   182\t        filePath: flags.filePath,\n   183\t      };\n   184\t      if (flags.title !== undefined) input.title = flags.title;\n   185\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n   186\t      return renderResult(await threads.newThread(input));\n   187\t    }\n   188\t    case \"threads resolve\": {\n   189\t      if (flags.threadId === undefined) {\n   190\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n   191\t      }\n   192\t      const input: Parameters<typeof threads.resolve>[0] = {\n   193\t        threadId: flags.threadId,\n   194\t      };\n   195\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n   196\t      return renderResult(await threads.resolve(input));\n   197\t    }\n   198\t    case \"threads list\": {\n   199\t      return renderResult(\n   200\t        await threads.listThreads(\n   201\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n   202\t        ),\n   203\t      );\n   204\t    }\n   205\t    case \"intake-stream message-events\": {\n   206\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n   207\t        return renderCliError(\n   208\t          \"caller_error\",\n   209\t          \"missing_flag\",\n   210\t          \"intake-stream message-events requires --thread-id or --file-path\",\n   211\t        );\n   212\t      }\n   213\t      const text = await readStdin();\n   214\t      if (text === null || text.trim() === \"\") {\n   215\t        return renderResult(\n   216\t          stdinCallerError(\n   217\t            \"empty_stdin\",\n   218\t            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n   219\t          ),\n   220\t        );\n   221\t      }\n   222\t      let parsed: unknown;\n   223\t      try {\n   224\t        parsed = JSON.parse(text);\n   225\t      } catch (cause) {\n   226\t        const detail = cause instanceof Error ? cause.message : String(cause);\n   227\t        return renderResult(\n   228\t          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n   229\t        );\n   230\t      }\n   231\t      if (!Array.isArray(parsed)) {\n   232\t        return renderResult(\n   233\t          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n   234\t        );\n   235\t      }\n   236\t      return renderResult(\n   237\t        await intakeStream.messageEvents(\n   238\t          threadRefFrom(flags),\n   239\t          parsed as readonly MessageEventInput[],\n   240\t        ),\n   241\t      );\n   242\t    }\n   243\t    case \"intake-stream list-events\": {\n   244\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n   245\t        return renderCliError(\n   246\t          \"caller_error\",\n   247\t          \"missing_flag\",\n   248\t          \"intake-stream list-events requires --thread-id or --file-path\",\n   249\t        );\n   250\t      }\n   251\t      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n   252\t    }\n   253\t    case \"messages list\":\n   254\t      return (\n   255\t        requireThreadRef(flags, \"messages list\") ??\n   256\t        renderResult(await messages.listMessages(threadRefFrom(flags)))\n   257\t      );\n   258\t    case \"messages list-queued-work\":\n   259\t      return (\n   260\t        requireThreadRef(flags, \"messages list-queued-work\") ??\n   261\t        renderResult(await messages.listQueuedWork(threadRefFrom(flags)))\n   262\t      );\n   263\t    case \"messages report\": {\n   264\t      const missingRef = requireThreadRef(flags, \"messages report\");\n   265\t      if (missingRef !== undefined) return missingRef;\n   266\t      const reportFlags: { notReady?: boolean; messageId?: string } = {};\n   267\t      if (flags.notReady === true) reportFlags.notReady = true;\n   268\t      if (flags.messageId !== undefined) reportFlags.messageId = flags.messageId;\n   269\t      return runMessagesReport(threadRefFrom(flags), reportFlags);\n   270\t    }\n   271\t    case \"messages requeue\": {\n   272\t      const missingRef = requireThreadRef(flags, \"messages requeue\");\n   273\t      if (missingRef !== undefined) return missingRef;\n   274\t      if (flags.messageId === undefined || flags.form === undefined) {\n   275\t        return renderCliError(\n   276\t          \"caller_error\",\n   277\t          \"missing_flag\",\n   278\t          \"messages requeue requires --message-id and --form\",\n   279\t        );\n   280\t      }\n   281\t      return runMessagesRequeue(threadRefFrom(flags), {\n   282\t        messageId: flags.messageId,\n   283\t        form: flags.form,\n   284\t      });\n   285\t    }\n   286\t    case \"turns list\":\n   287\t      return (\n   288\t        requireThreadRef(flags, \"turns list\") ??\n   289\t        renderResult(await turns.listTurns(threadRefFrom(flags)))\n   290\t      );\n   291\t    case \"turns list-queued-work\":\n   292\t      return (\n   293\t        requireThreadRef(flags, \"turns list-queued-work\") ??\n   294\t        renderResult(await turns.listQueuedWork(threadRefFrom(flags)))\n   295\t      );\n   296\t    case \"turns report\": {\n   297\t      const missingRef = requireThreadRef(flags, \"turns report\");\n   298\t      if (missingRef !== undefined) return missingRef;\n   299\t      const reportFlags: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n   300\t      if (flags.notReady === true) reportFlags.notReady = true;\n   301\t      if (flags.turnId !== undefined) reportFlags.turnId = flags.turnId;\n   302\t      if (flags.chunkId !== undefined) reportFlags.chunkId = flags.chunkId;\n   303\t      return runTurnsReport(threadRefFrom(flags), reportFlags);\n   304\t    }\n   305\t    case \"turns requeue\": {\n   306\t      const missingRef = requireThreadRef(flags, \"turns requeue\");\n   307\t      if (missingRef !== undefined) return missingRef;\n   308\t      if (\n   309\t        flags.subjectKind === undefined ||\n   310\t        flags.subjectId === undefined ||\n   311\t        flags.form === undefined\n   312\t      ) {\n   313\t        return renderCliError(\n   314\t          \"caller_error\",\n   315\t          \"missing_flag\",\n   316\t          \"turns requeue requires --subject-kind, --subject-id, and --form\",\n   317\t        );\n   318\t      }\n   319\t      if (flags.subjectKind !== \"turn\" && flags.subjectKind !== \"chunk\") {\n   320\t        return renderCliError(\n   321\t          \"caller_error\",\n   322\t          \"missing_flag\",\n   323\t          `--subject-kind must be \"turn\" or \"chunk\", got ${flags.subjectKind}`,\n   324\t        );\n   325\t      }\n   326\t      return runTurnsRequeue(threadRefFrom(flags), {\n   327\t        subjectKind: flags.subjectKind,\n   328\t        subjectId: flags.subjectId,\n   329\t        form: flags.form,\n   330\t      });\n   331\t    }\n   332\t    case \"work drain\": {\n   333\t      const missingRef = requireThreadRef(flags, \"work drain\");\n   334\t      if (missingRef !== undefined) return missingRef;\n   335\t      const drainFlags: { provider?: string; maxItems?: number } = {};\n   336\t      if (flags.provider !== undefined) drainFlags.provider = flags.provider;\n   337\t      if (flags.maxItems !== undefined) {\n   338\t        const maxItems = Number(flags.maxItems);\n   339\t        if (!Number.isInteger(maxItems) || maxItems <= 0) {\n   340\t          return renderCliError(\n   341\t            \"caller_error\",\n   342\t            \"missing_flag\",\n   343\t            `--max-items must be a positive integer, got ${flags.maxItems}`,\n   344\t          );\n   345\t        }\n   346\t        drainFlags.maxItems = maxItems;\n   347\t      }\n   348\t      return runWorkDrain(threadRefFrom(flags), drainFlags);\n   349\t    }\n   350\t    default:\n   351\t      return renderCliError(\n   352\t        \"caller_error\",\n   353\t        \"unknown_command\",\n   354\t        `unknown command: ${key}; run lhc --help`,\n   355\t      );\n   356\t  }\n   357\t}\n","exit_code":0,"status":"completed"}}

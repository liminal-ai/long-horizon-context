{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/internal/derive.ts | sed -n '1,240p'\"","aggregated_output":"     1\t// The turns derivation handlers (Flow 3): turn_derivation — the epic's\n     2\t// biggest single handler — and the two chunk summaries. turn_derivation\n     3\t// composes the rendering from message-level forms (compose.ts), sends it\n     4\t// through composeTurnRendering then projectLowerBand, hands both forms back\n     5\t// for the version-checked completion write, and runs placement in that same\n     6\t// completion transaction via the onApplied hook: open-chunk append, the\n     7\t// accumulated close policy, and any close's summary enqueues all ride the\n     8\t// one commit (anti-shim: a crash leaves either a placed turn with queued\n     9\t// summaries or an open chunk — nothing between).\n    10\timport type {\n    11\t  DependencyGap,\n    12\t  HandlerOutcome,\n    13\t  HandlerRunContext,\n    14\t  WorkHandler,\n    15\t} from \"../../../shared/derivation.js\";\n    16\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n    17\timport type { WorkKind } from \"../../../tech-utils/work-queue/index.js\";\n    18\timport { composeRenderingInput } from \"./compose.js\";\n    19\timport { enqueueChunkSummaries, placeTurn } from \"./chunks.js\";\n    20\timport {\n    21\t  chunkExists,\n    22\t  readMemberMessages,\n    23\t  readMemberProjections,\n    24\t  readMessageFormRows,\n    25\t  readTurnSource,\n    26\t} from \"./forms.js\";\n    27\timport { selectOpenTurnIds } from \"./store.js\";\n    28\t\n    29\tfunction sourceDamaged(reason: string): HandlerOutcome {\n    30\t  return { ok: false, blocked: true, reason: `source_damaged: ${reason}` };\n    31\t}\n    32\t\n    33\tfunction providerFailed(result: { retryable: boolean; reason: string }): HandlerOutcome {\n    34\t  return { ok: false, retryable: result.retryable, reason: result.reason };\n    35\t}\n    36\t\n    37\tfunction readThreadId(run: HandlerRunContext): string {\n    38\t  const row = run.openDb().prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`).get() as\n    39\t    | { thread_id: string }\n    40\t    | undefined;\n    41\t  return row?.thread_id ?? \"\";\n    42\t}\n    43\t\n    44\tconst turnDerivationHandler: WorkHandler = async (run, item) => {\n    45\t  const turnId = item.sourceRef[\"turnId\"];\n    46\t  if (turnId === undefined) return sourceDamaged(\"work item carries no turnId\");\n    47\t  const db = run.openDb();\n    48\t  const turn = readTurnSource(db, turnId);\n    49\t  if (turn === undefined || turn.deleted) {\n    50\t    // A deleted turn's form rows were dropped with it, so a blocked stamp\n    51\t    // would hit nothing; either way the item is terminal against a source\n    52\t    // that cannot improve.\n    53\t    return sourceDamaged(`turn ${turnId} not found`);\n    54\t  }\n    55\t  if (turn.status !== \"closed\") {\n    56\t    // Derivation is queued only at close; an open turn under a queued item\n    57\t    // means the record was interfered with.\n    58\t    return sourceDamaged(`turn ${turnId} is open under a derivation item`);\n    59\t  }\n    60\t  // Epic 01's corruption definition (AC-3.9 there, TC-4.6 here): only the\n    61\t  // batch pipeline writes turn state and it never leaves two turns open, so\n    62\t  // more than one open turn means the record was damaged below the SDK. A\n    63\t  // handler must not compose against a membership it cannot trust; the form\n    64\t  // lands blocked naming the damage, and requeue refuses with that reason\n    65\t  // until the source reads clean (Story 4).\n    66\t  const openTurnIds = selectOpenTurnIds(db);\n    67\t  if (openTurnIds.length > 1) {\n    68\t    return sourceDamaged(\n    69\t      `turn state corrupt: ${openTurnIds.length} turns open (${openTurnIds.join(\", \")})`,\n    70\t    );\n    71\t  }\n    72\t\n    73\t  // Compose from current message-form states: ready forms verbatim,\n    74\t  // non-ready fall back with one gap each (AC-3.2). Pure — both reads land\n    75\t  // before any provider call, and no transaction is held across them.\n    76\t  const messages = readMemberMessages(db, turnId);\n    77\t  const forms = readMessageFormRows(\n    78\t    db,\n    79\t    messages.map((message) => message.messageId),\n    80\t  );\n    81\t  const { parts, gaps, receipts } = composeRenderingInput(messages, forms);\n    82\t\n    83\t  const rendering = await run.provider.composeTurnRendering({ parts });\n    84\t  if (!rendering.ok) return providerFailed(rendering);\n    85\t  const projection = await run.provider.projectLowerBand({ rendering: rendering.text });\n    86\t  if (!projection.ok) return providerFailed(projection);\n    87\t\n    88\t  // The projection's token count is estimated exactly once, here, as the\n    89\t  // artifact lands; placement reads this stored arithmetic and never\n    90\t  // re-counts (AC-3.9's determinism input).\n    91\t  const projectedTokens = estimateTokens(projection.text);\n    92\t  const threadId = readThreadId(run);\n    93\t  const renderingGaps: DependencyGap[] | undefined = gaps.length > 0 ? gaps : undefined;\n    94\t\n    95\t  return {\n    96\t    ok: true,\n    97\t    forms: [\n    98\t      {\n    99\t        subjectKind: \"turn\",\n   100\t        subjectId: turnId,\n   101\t        form: \"turn_rendering\",\n   102\t        content: rendering.text,\n   103\t        ...(renderingGaps === undefined ? {} : { gaps: renderingGaps }),\n   104\t        // Tool-run receipts ride the rendering's metadata, mechanically\n   105\t        // restated from the composition input (AC-3.8) — the chunk\n   106\t        // summaries read them from here, never from provider prose.\n   107\t        ...(receipts.length > 0 ? { metadata: { receipts } } : {}),\n   108\t      },\n   109\t      {\n   110\t        subjectKind: \"turn\",\n   111\t        subjectId: turnId,\n   112\t        form: \"lower_band_projection\",\n   113\t        content: projection.text,\n   114\t      },\n   115\t    ],\n   116\t    onApplied: (tx) => {\n   117\t      const placement = placeTurn(tx.db, turnId, projectedTokens, run.config.chunkPolicy);\n   118\t      for (const chunkId of placement.closedChunkIds) {\n   119\t        enqueueChunkSummaries(\n   120\t          { db: tx.db, clock: run.clock, threadId, onCommit: tx.onCommit },\n   121\t          chunkId,\n   122\t        );\n   123\t      }\n   124\t    },\n   125\t  };\n   126\t};\n   127\t\n   128\t// One read for both summary kinds — member projections in turn order — but\n   129\t// two contracts at the provider seam (AC-3.8): detailed receives the\n   130\t// members' tool-run receipts (what changed, outcome) read from the\n   131\t// renderings' stamped metadata; brief receives outcomes only, the receipt\n   132\t// text stripped here so the brief provider call structurally cannot carry\n   133\t// it. Two work items, two handlers' runs, independent retry and states. A\n   134\t// member whose projection is not ready falls back to nothing and records a\n   135\t// gap, mirroring the rendering's fallback rule.\n   136\tfunction chunkSummaryHandler(\n   137\t  kind: \"chunk_summary_detailed\" | \"chunk_summary_brief\",\n   138\t): WorkHandler {\n   139\t  return async (run, item) => {\n   140\t    const chunkId = item.sourceRef[\"chunkId\"];\n   141\t    if (chunkId === undefined) return sourceDamaged(\"work item carries no chunkId\");\n   142\t    const db = run.openDb();\n   143\t    if (!chunkExists(db, chunkId)) return sourceDamaged(`chunk ${chunkId} not found`);\n   144\t\n   145\t    const members = readMemberProjections(db, chunkId);\n   146\t    const memberProjections: string[] = [];\n   147\t    const gaps: DependencyGap[] = [];\n   148\t    for (const member of members) {\n   149\t      if (member.state === \"ready\" && member.content !== undefined) {\n   150\t        memberProjections.push(member.content);\n   151\t      } else {\n   152\t        memberProjections.push(\"\");\n   153\t        gaps.push({\n   154\t          subjectKind: \"turn\",\n   155\t          subjectId: member.turnId,\n   156\t          form: \"lower_band_projection\",\n   157\t        });\n   158\t      }\n   159\t    }\n   160\t\n   161\t    const result =\n   162\t      kind === \"chunk_summary_detailed\"\n   163\t        ? await run.provider.summarizeChunkDetailed({\n   164\t            memberProjections,\n   165\t            memberReceipts: members.map((member) => member.receipts),\n   166\t          })\n   167\t        : await run.provider.summarizeChunkBrief({\n   168\t            memberProjections,\n   169\t            memberOutcomes: members.map((member) =>\n   170\t              member.receipts.map((receipt) => receipt.outcome),\n   171\t            ),\n   172\t          });\n   173\t    if (!result.ok) return providerFailed(result);\n   174\t\n   175\t    return {\n   176\t      ok: true,\n   177\t      forms: [\n   178\t        {\n   179\t          subjectKind: \"chunk\",\n   180\t          subjectId: chunkId,\n   181\t          form: kind,\n   182\t          content: result.text,\n   183\t          ...(gaps.length > 0 ? { gaps } : {}),\n   184\t        },\n   185\t      ],\n   186\t    };\n   187\t  };\n   188\t}\n   189\t\n   190\t// The domain's handler table, merged into the SDK dispatch map at\n   191\t// construction (DD-6).\n   192\texport const turnWorkHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> = {\n   193\t  turn_derivation: turnDerivationHandler,\n   194\t  chunk_summary_detailed: chunkSummaryHandler(\"chunk_summary_detailed\"),\n   195\t  chunk_summary_brief: chunkSummaryHandler(\"chunk_summary_brief\"),\n   196\t};\n","exit_code":0,"status":"completed"}}

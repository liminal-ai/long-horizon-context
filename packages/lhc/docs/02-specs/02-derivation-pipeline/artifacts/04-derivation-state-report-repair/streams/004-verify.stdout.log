{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/report-repair.test.ts | sed -n '1,240p'\"","aggregated_output":"     1\t// Story 4 (Epic 02): derivation state, report, and repair — Flow 4. The\n     2\t// four-state lifecycle proven on forms the pipeline landed for real\n     3\t// (TC-4.1), retrying-vs-first-wait read from the report's queue join without\n     4\t// any queue API (TC-4.2, architecture risk), exact owner scoping and the\n     5\t// exact not-ready set (TC-4.3), explicit re-queue through the owning\n     6\t// surfaces landing ready with the failure cleared (TC-4.4, background mode\n     7\t// proving the poke), requeue idempotency against live work (TC-4.5), the\n     8\t// blocked-source path with its refusal carrying the stored damage reason\n     9\t// (TC-4.6, architecture risk), and degrade-don't-block reads with every\n    10\t// non-ready state present at once (TC-4.7, architecture risk).\n    11\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    12\timport {\n    13\t  countLiveItems,\n    14\t  createSdk,\n    15\t  queueDetail,\n    16\t  setSchedulerPoke,\n    17\t  setThreadTouch,\n    18\t  threads,\n    19\t  type BatchResult,\n    20\t  type DerivationProvider,\n    21\t  type DrainReport,\n    22\t  type FormReportEntry,\n    23\t  type Lhc,\n    24\t  type MessageEventInput,\n    25\t  type SdkConfig,\n    26\t} from \"../src/index.js\";\n    27\timport {\n    28\t  corruptTwoOpenTurns,\n    29\t  createProviderDouble,\n    30\t  damagedSourceThread,\n    31\t  GAPPED_SMOOTHING_REASON,\n    32\t  gappedRenderingThread,\n    33\t  openRaw,\n    34\t  readDerivedForms,\n    35\t  tempStore,\n    36\t  validEvent,\n    37\t  type ProviderDouble,\n    38\t  type TempStore,\n    39\t} from \"./fixtures/index.js\";\n    40\t\n    41\tlet store: TempStore;\n    42\tbeforeEach(() => {\n    43\t  store = tempStore();\n    44\t});\n    45\tafterEach(() => {\n    46\t  store.cleanup();\n    47\t  setSchedulerPoke(null);\n    48\t  setThreadTouch(null);\n    49\t});\n    50\t\n    51\tasync function newThread(): Promise<string> {\n    52\t  const created = await threads.newThread({\n    53\t    filePath: store.threadPath(),\n    54\t    registryPath: store.registryPath,\n    55\t  });\n    56\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n    57\t  return created.value.filePath;\n    58\t}\n    59\t\n    60\tfunction manualSdk(\n    61\t  provider: DerivationProvider,\n    62\t  overrides: Partial<Pick<SdkConfig, \"retry\" | \"chunkPolicy\" | \"clock\">> = {},\n    63\t): Lhc {\n    64\t  const config: SdkConfig = {\n    65\t    provider,\n    66\t    mode: \"manual\",\n    67\t    retry: overrides.retry ?? { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    68\t    lease: { durationMs: 200 },\n    69\t  };\n    70\t  if (overrides.chunkPolicy !== undefined) config.chunkPolicy = overrides.chunkPolicy;\n    71\t  if (overrides.clock !== undefined) config.clock = overrides.clock;\n    72\t  return createSdk(config);\n    73\t}\n    74\t\n    75\tasync function send(\n    76\t  sdk: Lhc,\n    77\t  filePath: string,\n    78\t  batch: readonly MessageEventInput[],\n    79\t): Promise<BatchResult> {\n    80\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    81\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n    82\t  return result.value;\n    83\t}\n    84\t\n    85\tasync function drain(\n    86\t  sdk: Lhc,\n    87\t  filePath: string,\n    88\t  opts?: { maxItems?: number },\n    89\t): Promise<DrainReport> {\n    90\t  const result = await sdk.work.drain({ filePath }, opts);\n    91\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n    92\t  return result.value;\n    93\t}\n    94\t\n    95\tfunction formOf(filePath: string, subjectId: string, form: string) {\n    96\t  return readDerivedForms(filePath).find(\n    97\t    (f) => f.subjectId === subjectId && f.form === form,\n    98\t  );\n    99\t}\n   100\t\n   101\tfunction liveCount(filePath: string): number {\n   102\t  const db = openRaw(filePath);\n   103\t  try {\n   104\t    return countLiveItems(db);\n   105\t  } finally {\n   106\t    db.close();\n   107\t  }\n   108\t}\n   109\t\n   110\tfunction rawDetail(filePath: string): ReturnType<typeof queueDetail> {\n   111\t  const db = openRaw(filePath);\n   112\t  try {\n   113\t    return queueDetail(db);\n   114\t  } finally {\n   115\t    db.close();\n   116\t  }\n   117\t}\n   118\t\n   119\tfunction entryOf(\n   120\t  entries: readonly FormReportEntry[],\n   121\t  subjectId: string,\n   122\t  form: string,\n   123\t): FormReportEntry | undefined {\n   124\t  return entries.find((entry) => entry.subjectId === subjectId && entry.form === form);\n   125\t}\n   126\t\n   127\tasync function reportOf(\n   128\t  sdk: Lhc,\n   129\t  filePath: string,\n   130\t  owner: \"messages\" | \"turns\",\n   131\t  opts?: { notReady?: boolean },\n   132\t): Promise<FormReportEntry[]> {\n   133\t  const result =\n   134\t    owner === \"messages\"\n   135\t      ? await sdk.messages.report({ filePath }, opts)\n   136\t      : await sdk.turns.report({ filePath }, opts);\n   137\t  if (!result.ok) throw new Error(`${owner} report failed: ${result.error.reason}`);\n   138\t  return result.value;\n   139\t}\n   140\t\n   141\t// ── the mixed-state thread: every form state landed for real ─────\n   142\t// Three prompt turns through real intake; the double exhausts the first\n   143\t// prompt's smoothing (failed), the below-SDK corruption blocks both turn\n   144\t// derivations, maxItems leaves the third prompt's smoothing untouched\n   145\t// (pending with a live queued item), and the second prompt smooths clean\n   146\t// (ready). No below-SDK state writes — the pipeline produced every state.\n   147\tconst MIXED_FAILED_REASON = \"provider_failure: scripted exhaustion\";\n   148\t\n   149\tasync function mixedStateThread(): Promise<{\n   150\t  sdk: Lhc;\n   151\t  double: ProviderDouble;\n   152\t  filePath: string;\n   153\t  drainReport: DrainReport;\n   154\t}> {\n   155\t  const double = createProviderDouble();\n   156\t  const sdk = manualSdk(double);\n   157\t  const filePath = await newThread();\n   158\t  double.failKind(\"prompt_smoothing\", 3, {\n   159\t    retryable: true,\n   160\t    reason: MIXED_FAILED_REASON,\n   161\t  });\n   162\t  await send(sdk, filePath, [\n   163\t    validEvent(\"user_prompt\", { payload: { text: \"first prompt\" } }),\n   164\t    validEvent(\"turn_end\"),\n   165\t  ]);\n   166\t  await send(sdk, filePath, [\n   167\t    validEvent(\"user_prompt\", { payload: { text: \"second prompt\" } }),\n   168\t    validEvent(\"turn_end\"),\n   169\t  ]);\n   170\t  await send(sdk, filePath, [\n   171\t    validEvent(\"user_prompt\", { payload: { text: \"third prompt, left open\" } }),\n   172\t  ]);\n   173\t  corruptTwoOpenTurns(filePath);\n   174\t  const drainReport = await drain(sdk, filePath, { maxItems: 4 });\n   175\t  return { sdk, double, filePath, drainReport };\n   176\t}\n   177\t\n   178\tdescribe(\"TC-4.1 / AC-4.1: every landed form reads back in exactly one of the four states\", () => {\n   179\t  it(\"ready, failed-via-exhaustion, pending-via-unprocessed-queue, and blocked-via-damage land and read back; failed carries the stable reason\", async () => {\n   180\t    const { sdk, filePath, drainReport } = await mixedStateThread();\n   181\t    expect(drainReport.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n   182\t      [\"w-m1-prompt_smoothing-v1\", \"failed_terminal\"],\n   183\t      [\"w-t1-turn_derivation-v1\", \"failed_terminal\"],\n   184\t      [\"w-m3-prompt_smoothing-v1\", \"done\"],\n   185\t      [\"w-t2-turn_derivation-v1\", \"failed_terminal\"],\n   186\t    ]);\n   187\t    expect(drainReport.stoppedBecause).toBe(\"max_items\");\n   188\t    expect(drainReport.remaining).toBe(1);\n   189\t\n   190\t    const messageEntries = await reportOf(sdk, filePath, \"messages\");\n   191\t    const turnEntries = await reportOf(sdk, filePath, \"turns\");\n   192\t\n   193\t    const failed = entryOf(messageEntries, \"m1\", \"smoothed_prompt\");\n   194\t    expect(failed?.state).toBe(\"failed\");\n   195\t    // The stable reason code, plus the final attempts/last-error copied onto\n   196\t    // the form at exhaustion (DD-1: the queue row is gone; this is durable).\n   197\t    expect(failed?.reason).toBe(MIXED_FAILED_REASON);\n   198\t    expect(failed?.metadata).toEqual({ attempts: 3, lastError: MIXED_FAILED_REASON });\n   199\t\n   200\t    expect(entryOf(messageEntries, \"m3\", \"smoothed_prompt\")?.state).toBe(\"ready\");\n   201\t    expect(entryOf(messageEntries, \"m5\", \"smoothed_prompt\")?.state).toBe(\"pending\");\n   202\t    expect(entryOf(turnEntries, \"t1\", \"turn_rendering\")?.state).toBe(\"blocked\");\n   203\t    expect(entryOf(turnEntries, \"t1\", \"turn_rendering\")?.reason).toContain(\"source_damaged\");\n   204\t\n   205\t    // Exactly one of the four states on every row, both owners.\n   206\t    for (const entry of [...messageEntries, ...turnEntries]) {\n   207\t      expect([\"pending\", \"ready\", \"failed\", \"blocked\"]).toContain(entry.state);\n   208\t    }\n   209\t  });\n   210\t});\n   211\t\n   212\tdescribe(\"TC-4.2 / AC-4.2 (architecture risk): retrying reads from pending + queue detail in the report row itself\", () => {\n   213\t  it(\"a form mid-retry reports pending with attempts=1 and the last error joined in — no queue API, distinguishable from first-wait\", async () => {\n   214\t    const double = createProviderDouble();\n   215\t    // Frozen clock + non-zero backoff hold the retry window open\n   216\t    // deterministically: the failed attempt re-queues with eligible_at past\n   217\t    // the (never-advancing) clock, so the drain stops on \"waiting\" and the\n   218\t    // item sits mid-retry for the report to join.\n   219\t    const frozen = new Date(\"2026-06-11T10:00:00.000Z\");\n   220\t    const sdk = manualSdk(double, {\n   221\t      clock: () => frozen,\n   222\t      retry: { budget: 3, backoffBaseMs: 50, backoffCapMs: 60000 },\n   223\t    });\n   224\t    const filePath = await newThread();\n   225\t    double.failNext(1, { retryable: true, reason: \"transient provider blip\" });\n   226\t    await send(sdk, filePath, [\n   227\t      validEvent(\"user_prompt\", { payload: { text: \"retry me\" } }),\n   228\t      validEvent(\"turn_end\"),\n   229\t    ]);\n   230\t\n   231\t    const report = await drain(sdk, filePath);\n   232\t    expect(report.stoppedBecause).toBe(\"waiting\");\n   233\t    expect(report.ran).toEqual([]);\n   234\t\n   235\t    const entries = await reportOf(sdk, filePath, \"messages\");\n   236\t    const retrying = entryOf(entries, \"m1\", \"smoothed_prompt\");\n   237\t    expect(retrying?.state).toBe(\"pending\");\n   238\t    expect(retrying?.queue).toMatchObject({\n   239\t      status: \"queued\",\n   240\t      attempts: 1,\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/report-repair.test.ts | sed -n '241,520p'\"","aggregated_output":"   241\t      lastError: \"transient provider blip\",\n   242\t    });\n   243\t    expect(retrying?.queue?.eligibleAt).toBeDefined();\n   244\t\n   245\t    // First-wait contrast: the turn derivation behind the backing-off head\n   246\t    // has never been attempted — pending with attempts 0 and no error. The\n   247\t    // two situations read apart from the same single artifact state.\n   248\t    const turnEntries = await reportOf(sdk, filePath, \"turns\");\n   249\t    const waiting = entryOf(turnEntries, \"t1\", \"turn_rendering\");\n   250\t    expect(waiting?.state).toBe(\"pending\");\n   251\t    expect(waiting?.queue).toMatchObject({ status: \"queued\", attempts: 0 });\n   252\t    expect(waiting?.queue?.lastError).toBeUndefined();\n   253\t  });\n   254\t});\n   255\t\n   256\tdescribe(\"TC-4.3 / AC-4.3: owner scoping is exact and notReady is exact set equality\", () => {\n   257\t  it(\"each owner reports only its own forms; notReady returns exactly the failed+pending+blocked set\", async () => {\n   258\t    const { sdk, filePath } = await mixedStateThread();\n   259\t\n   260\t    const messageEntries = await reportOf(sdk, filePath, \"messages\");\n   261\t    expect(messageEntries.every((entry) => entry.subjectKind === \"message\")).toBe(true);\n   262\t    expect(messageEntries.map((entry) => [entry.subjectId, entry.state])).toEqual([\n   263\t      [\"m1\", \"failed\"],\n   264\t      [\"m3\", \"ready\"],\n   265\t      [\"m5\", \"pending\"],\n   266\t    ]);\n   267\t\n   268\t    const turnEntries = await reportOf(sdk, filePath, \"turns\");\n   269\t    expect(\n   270\t      turnEntries.every((entry) => entry.subjectKind === \"turn\" || entry.subjectKind === \"chunk\"),\n   271\t    ).toBe(true);\n   272\t    expect(turnEntries.map((entry) => [entry.subjectId, entry.form, entry.state])).toEqual([\n   273\t      [\"t1\", \"lower_band_projection\", \"blocked\"],\n   274\t      [\"t1\", \"turn_rendering\", \"blocked\"],\n   275\t      [\"t2\", \"lower_band_projection\", \"blocked\"],\n   276\t      [\"t2\", \"turn_rendering\", \"blocked\"],\n   277\t    ]);\n   278\t\n   279\t    // notReady: exactly the non-ready set — m2's ready row drops, nothing else.\n   280\t    const notReadyMessages = await reportOf(sdk, filePath, \"messages\", { notReady: true });\n   281\t    expect(notReadyMessages.map((entry) => [entry.subjectId, entry.state])).toEqual([\n   282\t      [\"m1\", \"failed\"],\n   283\t      [\"m5\", \"pending\"],\n   284\t    ]);\n   285\t    const notReadyTurns = await reportOf(sdk, filePath, \"turns\", { notReady: true });\n   286\t    expect(notReadyTurns).toHaveLength(4);\n   287\t    expect(notReadyTurns.every((entry) => entry.state === \"blocked\")).toBe(true);\n   288\t\n   289\t    // Subject filters scope to exactly the named subject's forms.\n   290\t    const oneMessage = await sdk.messages.report({ filePath }, { messageId: \"m1\" });\n   291\t    expect(oneMessage.ok && oneMessage.value.map((entry) => entry.subjectId)).toEqual([\"m1\"]);\n   292\t    const oneTurn = await sdk.turns.report({ filePath }, { turnId: \"t2\" });\n   293\t    expect(oneTurn.ok && oneTurn.value.map((entry) => entry.subjectId)).toEqual([\"t2\", \"t2\"]);\n   294\t  });\n   295\t\n   296\t  it(\"chunk summaries report under the turns owner, never under messages\", async () => {\n   297\t    const double = createProviderDouble();\n   298\t    // Policy 1/1: every turn's projection meets max, so each turn closes its\n   299\t    // own chunk immediately and both summary kinds queue and run.\n   300\t    const sdk = manualSdk(double, {\n   301\t      chunkPolicy: { targetProjectedTokens: 1, maxProjectedTokens: 1 },\n   302\t    });\n   303\t    const filePath = await newThread();\n   304\t    await send(sdk, filePath, [\n   305\t      validEvent(\"user_prompt\", { payload: { text: \"chunk one prompt\" } }),\n   306\t      validEvent(\"assistant_text\", { payload: { text: \"chunk one answer\" } }),\n   307\t      validEvent(\"turn_end\"),\n   308\t    ]);\n   309\t    await drain(sdk, filePath);\n   310\t    double.failKind(\"chunk_summary_brief\", 3, {\n   311\t      retryable: true,\n   312\t      reason: \"provider_failure: scripted brief exhaustion\",\n   313\t    });\n   314\t    await send(sdk, filePath, [\n   315\t      validEvent(\"user_prompt\", { payload: { text: \"chunk two prompt\" } }),\n   316\t      validEvent(\"assistant_text\", { payload: { text: \"chunk two answer\" } }),\n   317\t      validEvent(\"turn_end\"),\n   318\t    ]);\n   319\t    await drain(sdk, filePath);\n   320\t\n   321\t    const turnEntries = await reportOf(sdk, filePath, \"turns\");\n   322\t    const chunkEntries = turnEntries.filter((entry) => entry.subjectKind === \"chunk\");\n   323\t    expect(chunkEntries.map((entry) => [entry.subjectId, entry.form, entry.state])).toEqual([\n   324\t      [\"c1\", \"chunk_summary_brief\", \"ready\"],\n   325\t      [\"c1\", \"chunk_summary_detailed\", \"ready\"],\n   326\t      [\"c2\", \"chunk_summary_brief\", \"failed\"],\n   327\t      [\"c2\", \"chunk_summary_detailed\", \"ready\"],\n   328\t    ]);\n   329\t\n   330\t    const notReady = await reportOf(sdk, filePath, \"turns\", { notReady: true });\n   331\t    expect(notReady.map((entry) => [entry.subjectId, entry.form, entry.state])).toEqual([\n   332\t      [\"c2\", \"chunk_summary_brief\", \"failed\"],\n   333\t    ]);\n   334\t\n   335\t    // Cross-owner leakage check, both directions.\n   336\t    const messageEntries = await reportOf(sdk, filePath, \"messages\");\n   337\t    expect(messageEntries.every((entry) => entry.subjectKind === \"message\")).toBe(true);\n   338\t    expect(turnEntries.some((entry) => entry.subjectKind === \"message\")).toBe(false);\n   339\t\n   340\t    // The chunk filter scopes to exactly the named chunk's summary forms.\n   341\t    const oneChunk = await sdk.turns.report({ filePath }, { chunkId: \"c2\" });\n   342\t    expect(oneChunk.ok && oneChunk.value.map((entry) => [entry.subjectId, entry.form])).toEqual([\n   343\t      [\"c2\", \"chunk_summary_brief\"],\n   344\t      [\"c2\", \"chunk_summary_detailed\"],\n   345\t    ]);\n   346\t  });\n   347\t});\n   348\t\n   349\tdescribe(\"TC-4.4 / AC-4.4: re-queue through the owning surface lands the form ready with the failure cleared\", () => {\n   350\t  it(\"messages.requeue returns a failed smoothing to the pipeline; the commit poke alone drives the repair in background mode\", async () => {\n   351\t    const double = createProviderDouble();\n   352\t    const sdk = manualSdk(double);\n   353\t    const { filePath, messageId } = await gappedRenderingThread(store, sdk, double);\n   354\t\n   355\t    // DD-1 ground truth: the exhausted item's row is gone, which is what\n   356\t    // lets the deterministic id insert below without collision.\n   357\t    expect(liveCount(filePath)).toBe(0);\n   358\t    const before = formOf(filePath, messageId, \"smoothed_prompt\");\n   359\t    expect(before?.state).toBe(\"failed\");\n   360\t    expect(before?.reason).toBe(GAPPED_SMOOTHING_REASON);\n   361\t\n   362\t    // Background SDK first, so the requeue's poke-on-commit has a scheduler\n   363\t    // to land on; the repair must then run with no drain call at all.\n   364\t    const background = createSdk({\n   365\t      provider: double,\n   366\t      mode: \"background\",\n   367\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n   368\t      lease: { durationMs: 200 },\n   369\t    });\n   370\t    const requeued = await background.messages.requeue(\n   371\t      { filePath },\n   372\t      { messageId, form: \"smoothed_prompt\" },\n   373\t    );\n   374\t    expect(requeued.ok).toBe(true);\n   375\t    if (!requeued.ok) return;\n   376\t    expect(requeued.value).toEqual({ workItemId: \"w-m1-prompt_smoothing-v2\" });\n   377\t\n   378\t    await background.drainSettled({ filePath });\n   379\t\n   380\t    const repaired = formOf(filePath, messageId, \"smoothed_prompt\");\n   381\t    expect(repaired?.state).toBe(\"ready\");\n   382\t    expect(repaired?.sourceVersion).toBe(2);\n   383\t    expect(repaired?.content).toContain(\"smoothed(\");\n   384\t    // No failure residue: reason and the copied attempts/last-error are gone.\n   385\t    expect(repaired?.reason).toBeUndefined();\n   386\t    expect(repaired?.metadata).toBeUndefined();\n   387\t    expect(liveCount(filePath)).toBe(0);\n   388\t\n   389\t    const entries = await reportOf(sdk, filePath, \"messages\");\n   390\t    expect(entryOf(entries, messageId, \"smoothed_prompt\")).toMatchObject({\n   391\t      state: \"ready\",\n   392\t      sourceVersion: 2,\n   393\t    });\n   394\t  });\n   395\t\n   396\t  it(\"turns.requeue rebuilds a gapped rendering at the next source version; gaps recompute from current dependency states\", async () => {\n   397\t    const double = createProviderDouble();\n   398\t    const sdk = manualSdk(double);\n   399\t    const { filePath, messageId, turnId } = await gappedRenderingThread(store, sdk, double);\n   400\t\n   401\t    // Repair the dependency first (now healthy), then rebuild the composition.\n   402\t    const repairSmoothing = await sdk.messages.requeue(\n   403\t      { filePath },\n   404\t      { messageId, form: \"smoothed_prompt\" },\n   405\t    );\n   406\t    expect(repairSmoothing.ok).toBe(true);\n   407\t    await drain(sdk, filePath);\n   408\t    expect(formOf(filePath, messageId, \"smoothed_prompt\")?.state).toBe(\"ready\");\n   409\t    // No auto-cascade: the rendering still carries its recorded gap.\n   410\t    expect(formOf(filePath, turnId, \"turn_rendering\")?.gaps).toBeDefined();\n   411\t\n   412\t    const rebuild = await sdk.turns.requeue(\n   413\t      { filePath },\n   414\t      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n   415\t    );\n   416\t    expect(rebuild.ok).toBe(true);\n   417\t    if (!rebuild.ok) return;\n   418\t    expect(rebuild.value).toEqual({ workItemId: \"w-t1-turn_derivation-v2\" });\n   419\t\n   420\t    const report = await drain(sdk, filePath);\n   421\t    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n   422\t      [\"w-t1-turn_derivation-v2\", \"done\"],\n   423\t    ]);\n   424\t    const rebuilt = formOf(filePath, turnId, \"turn_rendering\");\n   425\t    expect(rebuilt?.state).toBe(\"ready\");\n   426\t    expect(rebuilt?.sourceVersion).toBe(2);\n   427\t    expect(rebuilt?.gaps).toBeUndefined();\n   428\t    // Both turn forms ride the one derivation item: the projection rebuilt too.\n   429\t    expect(formOf(filePath, turnId, \"lower_band_projection\")).toMatchObject({\n   430\t      state: \"ready\",\n   431\t      sourceVersion: 2,\n   432\t    });\n   433\t  });\n   434\t});\n   435\t\n   436\tdescribe(\"TC-4.5 / AC-4.5: re-queue is idempotent against live work\", () => {\n   437\t  it(\"the second requeue before draining is an explicit no-op; one live item, no duplicates\", async () => {\n   438\t    const double = createProviderDouble();\n   439\t    const sdk = manualSdk(double);\n   440\t    const { filePath, messageId } = await gappedRenderingThread(store, sdk, double);\n   441\t\n   442\t    const first = await sdk.messages.requeue(\n   443\t      { filePath },\n   444\t      { messageId, form: \"smoothed_prompt\" },\n   445\t    );\n   446\t    expect(first.ok).toBe(true);\n   447\t    if (!first.ok) return;\n   448\t    expect(first.value).toEqual({ workItemId: \"w-m1-prompt_smoothing-v2\" });\n   449\t\n   450\t    const second = await sdk.messages.requeue(\n   451\t      { filePath },\n   452\t      { messageId, form: \"smoothed_prompt\" },\n   453\t    );\n   454\t    expect(second.ok).toBe(true);\n   455\t    if (!second.ok) return;\n   456\t    expect(second.value).toEqual({ noop: \"already_queued\" });\n   457\t\n   458\t    // Queue read-back: exactly one live item for the form.\n   459\t    const detail = rawDetail(filePath);\n   460\t    expect(detail.map((row) => [row.workItemId, row.status])).toEqual([\n   461\t      [\"w-m1-prompt_smoothing-v2\", \"queued\"],\n   462\t    ]);\n   463\t\n   464\t    const report = await drain(sdk, filePath);\n   465\t    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n   466\t      [\"w-m1-prompt_smoothing-v2\", \"done\"],\n   467\t    ]);\n   468\t    expect(formOf(filePath, messageId, \"smoothed_prompt\")?.state).toBe(\"ready\");\n   469\t    // One row per form by key — drain left no duplicate artifacts behind.\n   470\t    const smoothings = readDerivedForms(filePath).filter(\n   471\t      (form) => form.subjectId === messageId && form.form === \"smoothed_prompt\",\n   472\t    );\n   473\t    expect(smoothings).toHaveLength(1);\n   474\t  });\n   475\t});\n   476\t\n   477\tdescribe(\"TC-4.6 / AC-4.6 (architecture risk): source damage lands blocked, the drain continues, and requeue refuses with the stored reason\", () => {\n   478\t  it(\"a turn derivation over the two-open-turns corruption blocks naming the damage; blocked is not failed — requeue is refused\", async () => {\n   479\t    const double = createProviderDouble();\n   480\t    const sdk = manualSdk(double);\n   481\t    const { filePath, turnId } = await damagedSourceThread(store);\n   482\t\n   483\t    const report = await drain(sdk, filePath);\n   484\t    // Truth-table shape: the blocked item reports failed_terminal and its row\n   485\t    // is deleted; the drain continued past it to the later smoothing.\n   486\t    expect(report.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n   487\t      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n   488\t      [\"w-t1-turn_derivation-v1\", \"failed_terminal\"],\n   489\t      [\"w-m4-prompt_smoothing-v1\", \"done\"],\n   490\t    ]);\n   491\t    expect(report.ran[1]?.reason).toContain(\"source_damaged\");\n   492\t    expect(liveCount(filePath)).toBe(0);\n   493\t\n   494\t    const rendering = formOf(filePath, turnId, \"turn_rendering\");\n   495\t    expect(rendering?.state).toBe(\"blocked\");\n   496\t    expect(rendering?.reason).toContain(\"source_damaged\");\n   497\t    expect(rendering?.reason).toContain(\"open\");\n   498\t    expect(formOf(filePath, turnId, \"lower_band_projection\")?.state).toBe(\"blocked\");\n   499\t\n   500\t    // The report surfaces the blocked rows with their reasons.\n   501\t    const notReady = await reportOf(sdk, filePath, \"turns\", { notReady: true });\n   502\t    expect(notReady.map((entry) => [entry.subjectId, entry.form, entry.state])).toEqual([\n   503\t      [\"t1\", \"lower_band_projection\", \"blocked\"],\n   504\t      [\"t1\", \"turn_rendering\", \"blocked\"],\n   505\t    ]);\n   506\t\n   507\t    // The refusal carries the form's stored reason — not a generic string.\n   508\t    const refused = await sdk.turns.requeue(\n   509\t      { filePath },\n   510\t      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n   511\t    );\n   512\t    expect(refused.ok).toBe(false);\n   513\t    if (refused.ok) return;\n   514\t    expect(refused.error.code).toBe(\"source_damaged\");\n   515\t    expect(refused.error.errorClass).toBe(\"state_corruption\");\n   516\t    expect(refused.error.reason).toBe(rendering?.reason);\n   517\t\n   518\t    // Refused means refused: nothing queued, nothing changed.\n   519\t    expect(liveCount(filePath)).toBe(0);\n   520\t    expect(formOf(filePath, turnId, \"turn_rendering\")).toEqual(rendering);\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/vitest.config.ts | sed -n '1,80p'\"","aggregated_output":"     1\timport { configDefaults, defineConfig } from \"vitest/config\";\n     2\t\n     3\t// The CLI process-boundary suite spawns dist/cli.js and needs a build\n     4\t// artifact, so it runs under verify-all only (LHC_PROCESS_SUITE=1). Its\n     5\t// absence from plain verify is announced by the verify script, never silent.\n     6\tconst includeProcessSuite = process.env[\"LHC_PROCESS_SUITE\"] === \"1\";\n     7\t\n     8\texport default defineConfig({\n     9\t  test: {\n    10\t    include: [\"test/**/*.test.ts\"],\n    11\t    exclude: [\n    12\t      ...configDefaults.exclude,\n    13\t      ...(includeProcessSuite\n    14\t        ? []\n    15\t        : [\n    16\t            \"test/cli-process.test.ts\",\n    17\t            \"test/cli-process-intake.test.ts\",\n    18\t            \"test/cli-process-projection.test.ts\",\n    19\t            \"test/cli-process-turns.test.ts\",\n    20\t            \"test/cli-process-work-queue.test.ts\",\n    21\t            \"test/cli-process-work.test.ts\",\n    22\t            \"test/cli-process-report-repair.test.ts\",\n    23\t            \"test/cli-process-mutations.test.ts\",\n    24\t            \"test/cli-process-mutations-delete.test.ts\",\n    25\t            \"test/cli-process-fix.test.ts\",\n    26\t            \"test/cli-process-view.test.ts\",\n    27\t            \"test/cli-process-inspect.test.ts\",\n    28\t          ]),\n    29\t    ],\n    30\t    passWithNoTests: true,\n    31\t  },\n    32\t});\n","exit_code":0,"status":"completed"}}

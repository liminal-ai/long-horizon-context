{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/internal/store.ts | sed -n '1,380p'\"","aggregated_output":"     1\t// Message and block row operations. Writes run on the caller's handle inside\n     2\t// the batch transaction (insert failures propagate so the pipeline rejects\n     3\t// the whole batch); reads run on a fresh handle per operation. The mutation\n     4\t// half (Epic 02 Story 5) — the edit's validation read and content apply —\n     5\t// also lives here: row-level mechanics, no policy.\n     6\timport type { DatabaseSync } from \"node:sqlite\";\n     7\timport { estimateTokens } from \"../../../tech-utils/token-counting/index.js\";\n     8\timport type { Block, MessageRecord } from \"../index.js\";\n     9\t\n    10\texport interface MessageRow {\n    11\t  messageId: string;\n    12\t  sourceEventOrder: number;\n    13\t  kind: MessageRecord[\"kind\"];\n    14\t  tokenEstimate: number;\n    15\t  actor: string;\n    16\t  harness: string;\n    17\t  // Membership stamp, settled at intake: the turn open after this event's\n    18\t  // transition, or null in a gap. Written once here, never updated — a null\n    19\t  // gap stamp stays null forever (AC-3.8), a closed turn's members never\n    20\t  // change (AC-3.7).\n    21\t  turnId: string | null;\n    22\t  blocks: Block[];\n    23\t}\n    24\t\n    25\texport function insertMessage(db: DatabaseSync, row: MessageRow): void {\n    26\t  db.prepare(\n    27\t    `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\n    28\t     VALUES (?, ?, ?, ?, ?, ?, ?)`,\n    29\t  ).run(\n    30\t    row.messageId,\n    31\t    row.sourceEventOrder,\n    32\t    row.kind,\n    33\t    row.tokenEstimate,\n    34\t    row.actor,\n    35\t    row.harness,\n    36\t    row.turnId,\n    37\t  );\n    38\t\n    39\t  const insertBlock = db.prepare(\n    40\t    `INSERT INTO message_block (message_id, block_index, block_type, content)\n    41\t     VALUES (?, ?, ?, ?)`,\n    42\t  );\n    43\t  for (const [index, block] of row.blocks.entries()) {\n    44\t    insertBlock.run(row.messageId, index, block.blockType, JSON.stringify(block.content));\n    45\t  }\n    46\t}\n    47\t\n    48\t// The mutation operations' validation read (Flows 5/6): the live\n    49\t// (deleted-filtered) message joined to its turn's status. A deleted target\n    50\t// misses here and refuses as message_not_found — the filtered view is the\n    51\t// refusal's read by design (never a distinct error for deleted; double\n    52\t// delete reads the same way, AC-6.7). turnStatus is null for a gap message\n    53\t// (no membership); the closed-turn target boundary refuses it the same as\n    54\t// an open turn. initiatesTurn carries the prompt-protection fact (AC-6.3):\n    55\t// a turn opens on its prompt's event, so the member whose source event\n    56\t// order equals the turn's opened-at order is the turn's initiating prompt.\n    57\texport interface MutableMessageView {\n    58\t  messageId: string;\n    59\t  kind: string;\n    60\t  turnId: string | null;\n    61\t  turnStatus: \"open\" | \"closed\" | null;\n    62\t  initiatesTurn: boolean;\n    63\t}\n    64\t\n    65\texport function readMutableMessage(\n    66\t  db: DatabaseSync,\n    67\t  messageId: string,\n    68\t): MutableMessageView | undefined {\n    69\t  const row = db\n    70\t    .prepare(\n    71\t      `SELECT m.message_id, m.kind, m.turn_id, m.source_event_order,\n    72\t              t.status AS turn_status, t.opened_at_event_order\n    73\t       FROM message m LEFT JOIN turns t ON t.turn_id = m.turn_id\n    74\t       WHERE m.message_id = ? AND m.deleted_at IS NULL`,\n    75\t    )\n    76\t    .get(messageId) as unknown as\n    77\t    | {\n    78\t        message_id: string;\n    79\t        kind: string;\n    80\t        turn_id: string | null;\n    81\t        source_event_order: number | bigint;\n    82\t        turn_status: string | null;\n    83\t        opened_at_event_order: number | bigint | null;\n    84\t      }\n    85\t    | undefined;\n    86\t  if (row === undefined) return undefined;\n    87\t  return {\n    88\t    messageId: row.message_id,\n    89\t    kind: row.kind,\n    90\t    turnId: row.turn_id,\n    91\t    turnStatus: row.turn_status as MutableMessageView[\"turnStatus\"],\n    92\t    initiatesTurn:\n    93\t      row.opened_at_event_order !== null &&\n    94\t      Number(row.source_event_order) === Number(row.opened_at_event_order),\n    95\t  };\n    96\t}\n    97\t\n    98\t// The delete's record apply (Flow 6): a projection-level tombstone — the\n    99\t// deleted_at stamp every read filters on. The source events are never\n   100\t// touched (record-never-destroyed, DD-12); event read-back keeps showing\n   101\t// them. The bulk variant is turns.deleteTurn's member stamp, scoped to live\n   102\t// rows so a turn whose messages were individually deleted first still\n   103\t// deletes cleanly (membership walk on live rows); it returns the stamped\n   104\t// ids in record order for the mutation result and the cascade's drop set.\n   105\texport function markMessageDeleted(\n   106\t  db: DatabaseSync,\n   107\t  messageId: string,\n   108\t  deletedAt: string,\n   109\t): void {\n   110\t  db.prepare(`UPDATE message SET deleted_at = ? WHERE message_id = ?`).run(\n   111\t    deletedAt,\n   112\t    messageId,\n   113\t  );\n   114\t}\n   115\t\n   116\texport function markTurnMessagesDeleted(\n   117\t  db: DatabaseSync,\n   118\t  turnId: string,\n   119\t  deletedAt: string,\n   120\t): string[] {\n   121\t  const rows = db\n   122\t    .prepare(\n   123\t      `UPDATE message SET deleted_at = ?\n   124\t       WHERE turn_id = ? AND deleted_at IS NULL\n   125\t       RETURNING message_id, source_event_order`,\n   126\t    )\n   127\t    .all(deletedAt, turnId) as unknown as Array<{\n   128\t    message_id: string;\n   129\t    source_event_order: number | bigint;\n   130\t  }>;\n   131\t  return rows\n   132\t    .sort((a, b) => Number(a.source_event_order) - Number(b.source_event_order))\n   133\t    .map((row) => row.message_id);\n   134\t}\n   135\t\n   136\t// The edit's record apply (AC-5.1): the new content lands in each block's\n   137\t// content-bearing field — the same field per block type the projection wrote\n   138\t// and counted (internal/project.ts) — and the token estimate re-stamps from\n   139\t// the same estimator, so placement arithmetic stays current after edits.\n   140\t// Events are untouched: this is projection-level mutation; the log keeps the\n   141\t// original (DD-12).\n   142\texport function applyMessageEdit(db: DatabaseSync, messageId: string, content: string): void {\n   143\t  const blocks = db\n   144\t    .prepare(\n   145\t      `SELECT block_index, block_type, content FROM message_block\n   146\t       WHERE message_id = ? ORDER BY block_index`,\n   147\t    )\n   148\t    .all(messageId) as unknown as Array<{\n   149\t    block_index: number | bigint;\n   150\t    block_type: string;\n   151\t    content: string;\n   152\t  }>;\n   153\t  const update = db.prepare(\n   154\t    `UPDATE message_block SET content = ? WHERE message_id = ? AND block_index = ?`,\n   155\t  );\n   156\t  let tokenEstimate = estimateTokens(content);\n   157\t  for (const block of blocks) {\n   158\t    const parsed = JSON.parse(block.content) as Record<string, unknown>;\n   159\t    switch (block.block_type) {\n   160\t      case \"text\":\n   161\t        parsed[\"text\"] = content;\n   162\t        break;\n   163\t      case \"tool_result\":\n   164\t        parsed[\"content\"] = content;\n   165\t        break;\n   166\t      case \"tool_call\":\n   167\t        // Arguments are the call's counted content; the edit's string lands\n   168\t        // verbatim as the new arguments value, mirroring projection's\n   169\t        // serialized-arguments estimate.\n   170\t        parsed[\"arguments\"] = content;\n   171\t        tokenEstimate = estimateTokens(JSON.stringify(content));\n   172\t        break;\n   173\t      default:\n   174\t        throw new Error(`message ${messageId} carries unknown block type ${block.block_type}`);\n   175\t    }\n   176\t    update.run(JSON.stringify(parsed), messageId, Number(block.block_index));\n   177\t  }\n   178\t  db.prepare(`UPDATE message SET token_estimate = ? WHERE message_id = ?`).run(\n   179\t    tokenEstimate,\n   180\t    messageId,\n   181\t  );\n   182\t}\n   183\t\n   184\tinterface RawMessageRow {\n   185\t  message_id: string;\n   186\t  source_event_order: number | bigint;\n   187\t  kind: string;\n   188\t  token_estimate: number | bigint;\n   189\t  actor: string;\n   190\t  harness: string;\n   191\t  turn_id: string | null;\n   192\t  deleted_at: string | null;\n   193\t}\n   194\t\n   195\tinterface RawBlockRow {\n   196\t  message_id: string;\n   197\t  block_type: string;\n   198\t  content: string;\n   199\t}\n   200\t\n   201\tfunction recordFromRow(row: RawMessageRow, blocks: Block[]): MessageRecord {\n   202\t  const record: MessageRecord = {\n   203\t    messageId: row.message_id,\n   204\t    sourceEventOrder: Number(row.source_event_order),\n   205\t    kind: row.kind as MessageRecord[\"kind\"],\n   206\t    blocks,\n   207\t    tokenEstimate: Number(row.token_estimate),\n   208\t    actor: row.actor,\n   209\t    harness: row.harness,\n   210\t  };\n   211\t  if (row.turn_id !== null) record.turnId = row.turn_id;\n   212\t  // The deleted marker (Epic 04 AC-3.3): present only on deleted rows, which\n   213\t  // only the includeDeleted read surfaces — never silently mixed in.\n   214\t  if (row.deleted_at !== null) record.deleted = true;\n   215\t  return record;\n   216\t}\n   217\t\n   218\t// Bounds in source-event-order coordinates (Epic 04 DD-3): the coordinate\n   219\t// the reports name, so drill-down uses what the operator already holds.\n   220\t// limit caps the count after bounds. Defaults preserve every existing\n   221\t// caller: visible messages, unbounded, record order.\n   222\texport interface MessageReadOptions {\n   223\t  from?: number;\n   224\t  to?: number;\n   225\t  limit?: number;\n   226\t  includeDeleted?: boolean;\n   227\t}\n   228\t\n   229\texport function readMessages(\n   230\t  db: DatabaseSync,\n   231\t  opts: MessageReadOptions = {},\n   232\t): MessageRecord[] {\n   233\t  // Bounds before content (AC-3.1 no-load-everything): the message query\n   234\t  // carries the deleted filter, the source-order window, and the limit, so a\n   235\t  // bounded list resolves its window from the message table first — never\n   236\t  // reading a row, or (below) parsing a block, outside that window.\n   237\t  //\n   238\t  // The deleted-read filter (tech design §Mechanics): message reads surface\n   239\t  // live projection rows only; a deleted message's source events stay\n   240\t  // readable through the Epic 01 event read-back, the one unfiltered surface.\n   241\t  // includeDeleted is the Epic 04 audit opt-in: deleted rows return flagged.\n   242\t  const conditions: string[] = [];\n   243\t  const params: number[] = [];\n   244\t  if (opts.includeDeleted !== true) conditions.push(\"deleted_at IS NULL\");\n   245\t  if (opts.from !== undefined) {\n   246\t    conditions.push(\"source_event_order >= ?\");\n   247\t    params.push(opts.from);\n   248\t  }\n   249\t  if (opts.to !== undefined) {\n   250\t    conditions.push(\"source_event_order <= ?\");\n   251\t    params.push(opts.to);\n   252\t  }\n   253\t  if (opts.limit !== undefined) params.push(opts.limit);\n   254\t  const messageRows = db\n   255\t    .prepare(\n   256\t      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id, deleted_at\n   257\t       FROM message${conditions.length > 0 ? ` WHERE ${conditions.join(\" AND \")}` : \"\"}\n   258\t       ORDER BY source_event_order${opts.limit !== undefined ? \" LIMIT ?\" : \"\"}`,\n   259\t    )\n   260\t    .all(...params) as unknown as RawMessageRow[];\n   261\t  if (messageRows.length === 0) return [];\n   262\t\n   263\t  // Block content only for the windowed messages — never the whole table:\n   264\t  // an out-of-window block is never selected, so its content is never loaded\n   265\t  // or parsed (the no-load-everything proof corrupts one to assert this).\n   266\t  const ids = messageRows.map((row) => row.message_id);\n   267\t  const blockRows = db\n   268\t    .prepare(\n   269\t      `SELECT message_id, block_type, content FROM message_block\n   270\t       WHERE message_id IN (${ids.map(() => \"?\").join(\", \")})\n   271\t       ORDER BY message_id, block_index`,\n   272\t    )\n   273\t    .all(...ids) as unknown as RawBlockRow[];\n   274\t  const blocksByMessage = new Map<string, Block[]>();\n   275\t  for (const row of blockRows) {\n   276\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n   277\t    blocks.push({\n   278\t      blockType: row.block_type as Block[\"blockType\"],\n   279\t      content: JSON.parse(row.content) as Record<string, unknown>,\n   280\t    });\n   281\t    blocksByMessage.set(row.message_id, blocks);\n   282\t  }\n   283\t  return messageRows.map((row) =>\n   284\t    recordFromRow(row, blocksByMessage.get(row.message_id) ?? []),\n   285\t  );\n   286\t}\n   287\t\n   288\t// The show operation's by-id read (Epic 04 Flow 3): the canonical record —\n   289\t// full blocks verbatim, never view-shortened — with the deleted flag honest.\n   290\t// Deliberately unfiltered on deleted_at: show on a deleted message is the\n   291\t// audit read (AC-3.3), never a not-found.\n   292\texport function readMessageById(\n   293\t  db: DatabaseSync,\n   294\t  messageId: string,\n   295\t): (MessageRecord & { deleted: boolean }) | undefined {\n   296\t  const row = db\n   297\t    .prepare(\n   298\t      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id, deleted_at\n   299\t       FROM message WHERE message_id = ?`,\n   300\t    )\n   301\t    .get(messageId) as unknown as RawMessageRow | undefined;\n   302\t  if (row === undefined) return undefined;\n   303\t  const blockRows = db\n   304\t    .prepare(\n   305\t      `SELECT message_id, block_type, content FROM message_block\n   306\t       WHERE message_id = ? ORDER BY block_index`,\n   307\t    )\n   308\t    .all(messageId) as unknown as RawBlockRow[];\n   309\t  const blocks = blockRows.map((block) => ({\n   310\t    blockType: block.block_type as Block[\"blockType\"],\n   311\t    content: JSON.parse(block.content) as Record<string, unknown>,\n   312\t  }));\n   313\t  return { ...recordFromRow(row, blocks), deleted: row.deleted_at !== null };\n   314\t}\n","exit_code":0,"status":"completed"}}

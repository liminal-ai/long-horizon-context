{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/corrupt.ts | sed -n '1,120p'\"","aggregated_output":"     1\timport { DatabaseSync } from \"node:sqlite\";\n     2\t\n     3\t// The one sanctioned below-SDK write in the test suite: inserts a second\n     4\t// status='open' turn row, a state no public operation can produce (the state\n     5\t// machine always closes before opening). Columns match the Story 4 turn\n     6\t// schema in threads/internal/create.ts.\n     7\texport function corruptTwoOpenTurns(path: string): void {\n     8\t  const db = new DatabaseSync(path);\n     9\t  try {\n    10\t    const row = db\n    11\t      .prepare(\"SELECT MAX(turn_order) AS max_order FROM turns\")\n    12\t      .get() as { max_order: number | bigint | null } | undefined;\n    13\t    const nextOrder = Number(row?.max_order ?? 0) + 1;\n    14\t    db.prepare(\n    15\t      \"INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order) VALUES (?, ?, 'open', ?)\",\n    16\t    ).run(`t${nextOrder}`, nextOrder, 0);\n    17\t  } finally {\n    18\t    db.close();\n    19\t  }\n    20\t}\n    21\t\n    22\t// Poison pills for the bounded no-load-everything proof (Epic 04 AC-3.1,\n    23\t// SV-01-002): overwrite one message's block content — or its derived-form\n    24\t// metadata — with bytes the production read's strict `JSON.parse` rejects, so\n    25\t// any read that *loads* that row throws on parse. A bounded list that excludes\n    26\t// the message must still succeed; a window that includes it must fail.\n    27\t// Together that is positive proof the out-of-window row was never read, not\n    28\t// merely absent from output.\n    29\t//\n    30\t// The value must still *store*: `message_block` carries the v5 expression\n    31\t// index `json_extract(content, '$.toolCallId')`, re-evaluated on every write,\n    32\t// and node:sqlite's json_extract refuses malformed JSON — so raw garbage is\n    33\t// rejected at write time, never reaching the read under test. JSON5 threads\n    34\t// the needle: json_extract accepts it (the index writes), while strict\n    35\t// `JSON.parse` rejects single quotes and the trailing comma (the read throws).\n    36\tconst NOT_JSON = \"{'unreadable': true,}\";\n    37\t\n    38\texport function poisonMessageBlockJson(path: string, messageId: string): void {\n    39\t  const db = new DatabaseSync(path);\n    40\t  try {\n    41\t    db.prepare(`UPDATE message_block SET content = ? WHERE message_id = ?`).run(\n    42\t      NOT_JSON,\n    43\t      messageId,\n    44\t    );\n    45\t  } finally {\n    46\t    db.close();\n    47\t  }\n    48\t}\n    49\t\n    50\texport function poisonMessageFormJson(path: string, messageId: string): void {\n    51\t  const db = new DatabaseSync(path);\n    52\t  try {\n    53\t    db.prepare(\n    54\t      `UPDATE derived_form SET metadata = ?\n    55\t       WHERE subject_kind = 'message' AND subject_id = ?`,\n    56\t    ).run(NOT_JSON, messageId);\n    57\t  } finally {\n    58\t    db.close();\n    59\t  }\n    60\t}\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/work-execution.test.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Story 1 (Epic 02): queue execution and drain — Flow 1, in-process half.\n     2\t// Claim/lease mechanics, queue-order dispatch, retry/backoff with the\n     3\t// head-gates-queue rule, terminal dispositions (reported then deleted, DD-1),\n     4\t// unknown-kind handling, both host modes, and coalesced background\n     5\t// scheduling. The cross-process legs (TC-1.3 kill, TC-1.4 claim exclusion,\n     6\t// CLI parity) live in cli-process-work.test.ts.\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport {\n     9\t  countLiveItems,\n    10\t  createSdk,\n    11\t  intakeStream,\n    12\t  queueDetail,\n    13\t  setSchedulerPoke,\n    14\t  setThreadTouch,\n    15\t  threads,\n    16\t  type DrainReport,\n    17\t  type Lhc,\n    18\t  type MessageEventInput,\n    19\t} from \"../src/index.js\";\n    20\timport {\n    21\t  createProviderDouble,\n    22\t  openRaw,\n    23\t  readDerivedForms,\n    24\t  registerTestWorkHandlers,\n    25\t  tempStore,\n    26\t  validEvent,\n    27\t  type TempStore,\n    28\t  type ProviderDouble,\n    29\t} from \"./fixtures/index.js\";\n    30\t\n    31\tfunction sleep(ms: number): Promise<void> {\n    32\t  return new Promise((resolve) => setTimeout(resolve, ms));\n    33\t}\n    34\t\n    35\tlet store: TempStore;\n    36\tbeforeEach(() => {\n    37\t  store = tempStore();\n    38\t});\n    39\tafterEach(() => {\n    40\t  // Background-mode SDKs install process-wide seams at construction; tests\n    41\t  // must not leak them into each other.\n    42\t  setSchedulerPoke(null);\n    43\t  setThreadTouch(null);\n    44\t  store.cleanup();\n    45\t});\n    46\t\n    47\tasync function newThread(): Promise<{ threadId: string; filePath: string }> {\n    48\t  const created = await threads.newThread({\n    49\t    filePath: store.threadPath(),\n    50\t    registryPath: store.registryPath,\n    51\t  });\n    52\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n    53\t  return created.value;\n    54\t}\n    55\t\n    56\tasync function send(\n    57\t  sdk: Lhc,\n    58\t  filePath: string,\n    59\t  batch: readonly MessageEventInput[],\n    60\t): Promise<void> {\n    61\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    62\t  if (!result.ok) throw new Error(`batch failed: ${result.error.reason}`);\n    63\t}\n    64\t\n    65\tfunction manualSdk(\n    66\t  double: ProviderDouble,\n    67\t  overrides: {\n    68\t    clock?: () => Date;\n    69\t    retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n    70\t  } = {},\n    71\t): Lhc {\n    72\t  const sdk = createSdk({\n    73\t    provider: double,\n    74\t    mode: \"manual\",\n    75\t    clock: overrides.clock ?? (() => new Date()),\n    76\t    retry: overrides.retry ?? { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    77\t    lease: { durationMs: 200 },\n    78\t  });\n    79\t  registerTestWorkHandlers(sdk, double);\n    80\t  return sdk;\n    81\t}\n    82\t\n    83\tasync function drain(\n    84\t  sdk: Lhc,\n    85\t  filePath: string,\n    86\t  opts?: { maxItems?: number },\n    87\t): Promise<DrainReport> {\n    88\t  const result = await sdk.work.drain({ filePath }, opts);\n    89\t  if (!result.ok) throw new Error(`drain failed: ${result.error.reason}`);\n    90\t  return result.value;\n    91\t}\n    92\t\n    93\tfunction liveCount(filePath: string): number {\n    94\t  const db = openRaw(filePath);\n    95\t  try {\n    96\t    return countLiveItems(db);\n    97\t  } finally {\n    98\t    db.close();\n    99\t  }\n   100\t}\n   101\t\n   102\tfunction liveDetail(filePath: string): ReturnType<typeof queueDetail> {\n   103\t  const db = openRaw(filePath);\n   104\t  try {\n   105\t    return queueDetail(db);\n   106\t  } finally {\n   107\t    db.close();\n   108\t  }\n   109\t}\n   110\t\n   111\tdescribe(\"TC-1.1: a drain runs queued items one at a time, in queue order, and reports each disposition\", () => {\n   112\t  // Epic 02 Story 2 (sanctioned amendment): tool_call now queues\n   113\t  // tool_call_summary, so this batch yields four items, not three.\n   114\t  it(\"four items across both owners run in order; rows are deleted at terminal transition; derivedAt is monotone\", async () => {\n   115\t    const double = createProviderDouble();\n   116\t    let tick = 0;\n   117\t    const base = Date.parse(\"2026-06-10T12:00:00.000Z\");\n   118\t    const sdk = manualSdk(double, { clock: () => new Date(base + 1000 * tick++) });\n   119\t    const { filePath } = await newThread();\n   120\t    await send(sdk, filePath, [\n   121\t      validEvent(\"user_prompt\"),\n   122\t      validEvent(\"tool_call\"),\n   123\t      validEvent(\"tool_result\"),\n   124\t      validEvent(\"turn_end\"),\n   125\t    ]);\n   126\t    expect(liveCount(filePath)).toBe(4);\n   127\t\n   128\t    const report = await drain(sdk, filePath);\n   129\t    // Queue order across owners: m1's smoothing, m2's call summary, m3's\n   130\t    // result summary, then the turn derivation queued at close — never\n   131\t    // reordered.\n   132\t    expect(report.ran.map((entry) => entry.workItemId)).toEqual([\n   133\t      \"w-m1-prompt_smoothing-v1\",\n   134\t      \"w-m2-tool_call_summary-v1\",\n   135\t      \"w-m3-tool_result_summary-v1\",\n   136\t      \"w-t1-turn_derivation-v1\",\n   137\t    ]);\n   138\t    expect(report.ran.map((entry) => entry.disposition)).toEqual([\n   139\t      \"done\",\n   140\t      \"done\",\n   141\t      \"done\",\n   142\t      \"done\",\n   143\t    ]);\n   144\t    expect(report.stoppedBecause).toBe(\"empty\");\n   145\t    expect(report.remaining).toBe(0);\n   146\t\n   147\t    // DD-1 storage contract: terminal rows are gone — the report is the only\n   148\t    // place the dispositions exist (raw zero-row read).\n   149\t    expect(liveCount(filePath)).toBe(0);\n   150\t    const db = openRaw(filePath);\n   151\t    try {\n   152\t      const rows = db.prepare(\"SELECT COUNT(*) AS n FROM work_item\").get() as {\n   153\t        n: number | bigint;\n   154\t      };\n   155\t      expect(Number(rows.n)).toBe(0);\n   156\t    } finally {\n   157\t      db.close();\n   158\t    }\n   159\t\n   160\t    // Artifacts landed in run order: derivedAt strictly monotone with the\n   161\t    // injected clock from m1 to m3 to the turn's forms.\n   162\t    const forms = readDerivedForms(filePath);\n   163\t    expect(forms.map((form) => form.state)).toEqual([\n   164\t      \"ready\",\n   165\t      \"ready\",\n   166\t      \"ready\",\n   167\t      \"ready\",\n   168\t      \"ready\",\n   169\t    ]);\n   170\t    const at = (subjectId: string, form: string): number => {\n   171\t      const row = forms.find((f) => f.subjectId === subjectId && f.form === form);\n   172\t      if (row?.derivedAt === undefined) throw new Error(`no derivedAt for ${subjectId}/${form}`);\n   173\t      return Date.parse(row.derivedAt);\n   174\t    };\n   175\t    expect(at(\"m1\", \"smoothed_prompt\")).toBeLessThan(at(\"m3\", \"tool_result_summary\"));\n   176\t    expect(at(\"m3\", \"tool_result_summary\")).toBeLessThan(at(\"t1\", \"turn_rendering\"));\n   177\t    expect(at(\"t1\", \"turn_rendering\")).toBe(at(\"t1\", \"lower_band_projection\"));\n   178\t  });\n   179\t});\n   180\t\n   181\tdescribe(\"TC-1.2 / AC-1.2: mid-drain queueing coalesces into at most one further pass\", () => {\n   182\t  it(\"a burst of two more batches during a slow in-flight drain yields exactly two passes and all artifacts\", async () => {\n   183\t    const double = createProviderDouble();\n   184\t    double.delayKind(\"prompt_smoothing\", 100);\n   185\t    const sdk = createSdk({\n   186\t      provider: double,\n   187\t      mode: \"background\",\n   188\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n   189\t      lease: { durationMs: 1000 },\n   190\t    });\n   191\t    registerTestWorkHandlers(sdk, double);\n   192\t    const { threadId, filePath } = await newThread();\n   193\t\n   194\t    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch A\" } })]);\n   195\t    // Let the poked drain start (it defers one macrotask), then queue two\n   196\t    // more batches while item A's slow handler is in flight.\n   197\t    await sleep(10);\n   198\t    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch B\" } })]);\n   199\t    await send(sdk, filePath, [validEvent(\"user_prompt\", { payload: { text: \"batch C\" } })]);\n   200\t\n   201\t    await sdk.drainSettled({ filePath });\n   202\t\n   203\t    // Everything queued mid-drain was processed before the cycle ended…\n   204\t    expect(liveCount(filePath)).toBe(0);\n   205\t    const smoothed = readDerivedForms(filePath).filter((f) => f.form === \"smoothed_prompt\");\n   206\t    expect(smoothed.map((f) => f.state)).toEqual([\"ready\", \"ready\", \"ready\"]);\n   207\t    // …and the burst coalesced: one initial pass plus exactly one follow-up,\n   208\t    // not one pass per poke (the cost model is the assertion).\n   209\t    expect(sdk.scheduler.testPassCount(threadId)).toBe(2);\n   210\t  });\n   211\t});\n   212\t\n   213\tdescribe(\"TC-1.5 / AC-1.5, AC-1.6: background mode — queueing is sufficient; first touch catches up\", () => {\n   214\t  it(\"an intake batch is processed with no drain call; drainSettled is the completion signal\", async () => {\n   215\t    const double = createProviderDouble();\n   216\t    const sdk = createSdk({\n   217\t      provider: double,\n   218\t      mode: \"background\",\n   219\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n   220\t      lease: { durationMs: 1000 },\n   221\t    });\n   222\t    registerTestWorkHandlers(sdk, double);\n   223\t    const { filePath } = await newThread();\n   224\t\n   225\t    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n   226\t    await sdk.drainSettled({ filePath });\n   227\t\n   228\t    const forms = readDerivedForms(filePath);\n   229\t    expect(forms.map((f) => `${f.subjectId}/${f.form}/${f.state}`).sort()).toEqual([\n   230\t      \"m1/smoothed_prompt/ready\",\n   231\t      \"t1/lower_band_projection/ready\",\n   232\t      \"t1/turn_rendering/ready\",\n   233\t    ]);\n   234\t    expect(liveCount(filePath)).toBe(0);\n   235\t  });\n   236\t\n   237\t  it(\"reopening a thread with leftover queued rows recovers them when the process engages — message reads stay pure (Epic 04 DD-6)\", async () => {\n   238\t    // Build the leftover state with no background scheduler installed: rows\n   239\t    // accumulate exactly as a dead process would have left them.\n   240\t    const { filePath } = await newThread();\n   241\t    const seeded = await intakeStream.messageEvents({ filePath }, [\n   242\t      validEvent(\"user_prompt\"),\n   243\t      validEvent(\"turn_end\"),\n   244\t    ]);\n   245\t    expect(seeded.ok).toBe(true);\n   246\t    expect(liveCount(filePath)).toBe(2);\n   247\t\n   248\t    const double = createProviderDouble();\n   249\t    const sdk = createSdk({\n   250\t      provider: double,\n   251\t      mode: \"background\",\n   252\t      retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n   253\t      lease: { durationMs: 1000 },\n   254\t    });\n   255\t    registerTestWorkHandlers(sdk, double);\n   256\t\n   257\t    // First touch of the thread in this process lifetime is a read. Message\n   258\t    // list/show are read-only (Epic 04 DD-6, SV-01-001): like thread-view's\n   259\t    // pull/status before them, they suppress the open announcement, so the\n   260\t    // read schedules no first-touch catch-up — the leftover rows stay exactly\n   261\t    // as the dead process left them, and no provider call fires off a read.\n   262\t    const read = await sdk.messages.listMessages({ filePath });\n   263\t    expect(read.ok).toBe(true);\n   264\t    await sdk.drainSettled({ filePath });\n   265\t    expect(liveCount(filePath)).toBe(2);\n   266\t\n   267\t    // Recovery arrives the moment the process engages the thread through a\n   268\t    // non-read path — here an explicit drain (an intake or any write touches\n   269\t    // the same way). The leftover work catches up to ready.\n   270\t    const recovered = await sdk.work.drain({ filePath });\n   271\t    expect(recovered.ok).toBe(true);\n   272\t    await sdk.drainSettled({ filePath });\n   273\t\n   274\t    expect(liveCount(filePath)).toBe(0);\n   275\t    const states = readDerivedForms(filePath).map((f) => f.state);\n   276\t    expect(states).toEqual([\"ready\", \"ready\", \"ready\"]);\n   277\t  });\n   278\t});\n   279\t\n   280\tdescribe(\"TC-1.6 / AC-1.7: manual mode — rows accumulate durably and run only when drain is invoked\", () => {\n   281\t  it(\"queued work sits until work.drain; artifacts land after\", async () => {\n   282\t    const double = createProviderDouble();\n   283\t    const sdk = manualSdk(double);\n   284\t    const { filePath } = await newThread();\n   285\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n   286\t\n   287\t    await sleep(100);\n   288\t    expect(liveCount(filePath)).toBe(1);\n   289\t    expect(liveDetail(filePath)[0]?.status).toBe(\"queued\");\n   290\t    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\"pending\"]);\n   291\t\n   292\t    const report = await drain(sdk, filePath);\n   293\t    expect(report.ran).toHaveLength(1);\n   294\t    expect(report.ran[0]?.disposition).toBe(\"done\");\n   295\t    expect(readDerivedForms(filePath).map((f) => f.state)).toEqual([\"ready\"]);\n   296\t    expect(liveCount(filePath)).toBe(0);\n   297\t  });\n   298\t});\n   299\t\n   300\tdescribe(\"TC-1.7 / AC-1.8: an unregistered kind lands failed_terminal with a stable reason and the drain continues\", () => {\n   301\t  it(\"a bogus-kind row ahead of a valid item fails with unknown_work_kind; the valid item still runs\", async () => {\n   302\t    const double = createProviderDouble();\n   303\t    const sdk = manualSdk(double);\n   304\t    const { filePath } = await newThread();\n   305\t\n   306\t    // Raw row with an unregistered kind, queued ahead of any valid work.\n   307\t    const db = openRaw(filePath);\n   308\t    try {\n   309\t      db.prepare(\n   310\t        `INSERT INTO work_item (work_item_id, owner, kind, source_ref, status, queued_at)\n   311\t         VALUES ('w-mX-bogus_kind-v1', 'messages', 'bogus_kind', '{\"messageId\":\"mX\"}', 'queued',\n   312\t                 '2026-06-10T11:00:00.000Z')`,\n   313\t      ).run();\n   314\t    } finally {\n   315\t      db.close();\n   316\t    }\n   317\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n   318\t\n   319\t    const report = await drain(sdk, filePath);\n   320\t    expect(report.ran).toHaveLength(2);\n   321\t    expect(report.ran[0]).toMatchObject({\n   322\t      workItemId: \"w-mX-bogus_kind-v1\",\n   323\t      disposition: \"failed_terminal\",\n   324\t      reason: \"unknown_work_kind\",\n   325\t    });\n   326\t    expect(report.ran[1]).toMatchObject({\n   327\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n   328\t      disposition: \"done\",\n   329\t    });\n   330\t    expect(report.stoppedBecause).toBe(\"empty\");\n   331\t    expect(liveCount(filePath)).toBe(0);\n   332\t    const smoothed = readDerivedForms(filePath).find((f) => f.subjectId === \"m1\");\n   333\t    expect(smoothed?.state).toBe(\"ready\");\n   334\t  });\n   335\t});\n   336\t\n   337\tdescribe(\"TC-1.8 / AC-1.9: retry per policy, terminal exhaustion, and the backoff eligibility gate\", () => {\n   338\t  it(\"fails twice then succeeds: artifact ready, report shows attempts=2\", async () => {\n   339\t    const double = createProviderDouble();\n   340\t    const sdk = manualSdk(double);\n   341\t    const { filePath } = await newThread();\n   342\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n   343\t\n   344\t    double.failNext(2, { retryable: true });\n   345\t    const report = await drain(sdk, filePath);\n   346\t    expect(report.ran).toHaveLength(1);\n   347\t    expect(report.ran[0]).toMatchObject({\n   348\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n   349\t      disposition: \"done\",\n   350\t      attempts: 2,\n   351\t    });\n   352\t    expect(readDerivedForms(filePath)[0]?.state).toBe(\"ready\");\n   353\t    expect(liveCount(filePath)).toBe(0);\n   354\t  });\n   355\t\n   356\t  it(\"exhausts the budget: form failed with the final provider reason; the next item still ran; row deleted\", async () => {\n   357\t    const double = createProviderDouble();\n   358\t    const sdk = manualSdk(double);\n   359\t    const { filePath } = await newThread();\n   360\t    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n   361\t\n   362\t    double.failKind(\"prompt_smoothing\", 99, {\n   363\t      retryable: true,\n   364\t      reason: \"scripted exhaustion (smoothPrompt)\",\n   365\t    });\n   366\t    const report = await drain(sdk, filePath);\n   367\t    expect(report.ran).toHaveLength(2);\n   368\t    expect(report.ran[0]).toMatchObject({\n   369\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n   370\t      disposition: \"failed_terminal\",\n   371\t      attempts: 3,\n   372\t      reason: \"scripted exhaustion (smoothPrompt)\",\n   373\t    });\n   374\t    expect(report.ran[1]).toMatchObject({\n   375\t      workItemId: \"w-t1-turn_derivation-v1\",\n   376\t      disposition: \"done\",\n   377\t    });\n   378\t\n   379\t    const forms = readDerivedForms(filePath);\n   380\t    const failed = forms.find((f) => f.form === \"smoothed_prompt\");\n   381\t    expect(failed?.state).toBe(\"failed\");\n   382\t    expect(failed?.reason).toBe(\"scripted exhaustion (smoothPrompt)\");\n   383\t    // Final attempts/last-error copied onto the form at exhaustion (DD-1).\n   384\t    expect(failed?.metadata?.attempts).toBe(3);\n   385\t    expect(forms.find((f) => f.form === \"turn_rendering\")?.state).toBe(\"ready\");\n   386\t    expect(liveCount(filePath)).toBe(0);\n   387\t  });\n   388\t\n   389\t  it(\"backoff gates the head and the head gates the queue: waiting stop, waitingUntil, and no skip-ahead\", async () => {\n   390\t    const double = createProviderDouble();\n   391\t    let nowMs = Date.parse(\"2026-06-10T12:00:00.000Z\");\n   392\t    const sdk = manualSdk(double, {\n   393\t      clock: () => new Date(nowMs),\n   394\t      retry: { budget: 3, backoffBaseMs: 50, backoffCapMs: 60000 },\n   395\t    });\n   396\t    const { filePath } = await newThread();\n   397\t    await send(sdk, filePath, [validEvent(\"user_prompt\"), validEvent(\"turn_end\")]);\n   398\t\n   399\t    double.failNext(1, { retryable: true });\n   400\t    const first = await drain(sdk, filePath);\n   401\t    // The head failed once and is backing off: nothing terminal ran, the\n   402\t    // drain stopped on the eligibility gate, and the queue behind the head\n   403\t    // was not touched.\n   404\t    expect(first.ran).toEqual([]);\n   405\t    expect(first.stoppedBecause).toBe(\"waiting\");\n   406\t    expect(first.remaining).toBe(2);\n   407\t    expect(first.waitingUntil).toBeDefined();\n   408\t    expect(Date.parse(first.waitingUntil ?? \"\")).toBeGreaterThan(nowMs);\n   409\t\n   410\t    const detail = liveDetail(filePath);\n   411\t    expect(detail).toHaveLength(2);\n   412\t    expect(detail[0]).toMatchObject({\n   413\t      workItemId: \"w-m1-prompt_smoothing-v1\",\n   414\t      status: \"queued\",\n   415\t      attempts: 1,\n   416\t    });\n   417\t    expect(detail[0]?.eligibleAt).toBe(first.waitingUntil);\n   418\t    // Skip-ahead proof: the eligible item behind the backing-off head was\n   419\t    // never claimed.\n   420\t    expect(detail[1]).toMatchObject({\n   421\t      workItemId: \"w-t1-turn_derivation-v1\",\n   422\t      status: \"queued\",\n   423\t      attempts: 0,\n   424\t    });\n   425\t    expect(detail[1]?.claimedAt).toBeUndefined();\n   426\t\n   427\t    // Pass the gate: the head becomes eligible and the queue drains in order.\n   428\t    nowMs += 60000;\n   429\t    const second = await drain(sdk, filePath);\n   430\t    expect(second.ran.map((entry) => [entry.workItemId, entry.disposition])).toEqual([\n   431\t      [\"w-m1-prompt_smoothing-v1\", \"done\"],\n   432\t      [\"w-t1-turn_derivation-v1\", \"done\"],\n   433\t    ]);\n   434\t    expect(second.ran[0]?.attempts).toBe(1);\n   435\t    expect(liveCount(filePath)).toBe(0);\n   436\t  });\n   437\t\n   438\t  it(\"a non-retryable provider failure is terminal immediately\", async () => {\n   439\t    const double = createProviderDouble();\n   440\t    const sdk = manualSdk(double);\n   441\t    const { filePath } = await newThread();\n   442\t    await send(sdk, filePath, [validEvent(\"user_prompt\")]);\n   443\t\n   444\t    double.failNext(1, { retryable: false, reason: \"content refusal (scripted)\" });\n   445\t    const report = await drain(sdk, filePath);\n   446\t    expect(report.ran[0]).toMatchObject({\n   447\t      disposition: \"failed_terminal\",\n   448\t      attempts: 1,\n   449\t      reason: \"content refusal (scripted)\",\n   450\t    });\n   451\t    expect(readDerivedForms(filePath)[0]?.state).toBe(\"failed\");\n   452\t    expect(liveCount(filePath)).toBe(0);\n   453\t  });\n   454\t\n   455\t  it(\"maxItems stops the drain with max_items and reports the remainder\", async () => {\n   456\t    const double = createProviderDouble();\n   457\t    const sdk = manualSdk(double);\n   458\t    const { filePath } = await newThread();\n   459\t    await send(sdk, filePath, [\n   460\t      validEvent(\"user_prompt\"),\n   461\t      validEvent(\"tool_call\"),\n   462\t      validEvent(\"tool_result\"),\n   463\t      validEvent(\"turn_end\"),\n   464\t    ]);\n   465\t\n   466\t    const report = await drain(sdk, filePath, { maxItems: 1 });\n   467\t    expect(report.ran).toHaveLength(1);\n   468\t    expect(report.stoppedBecause).toBe(\"max_items\");\n   469\t    // 3 behind the stop since Epic 02 Story 2: tool_call queues its summary\n   470\t    // (sanctioned amendment — was 2).\n   471\t    expect(report.remaining).toBe(3);\n   472\t    expect(liveCount(filePath)).toBe(3);\n   473\t  });\n   474\t});\n","exit_code":0,"status":"completed"}}

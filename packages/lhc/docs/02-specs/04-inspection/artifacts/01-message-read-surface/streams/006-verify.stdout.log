/.claude/projects/-Users-leemoore-code-pi-long-horizon-liminal-context/memory/\"},\"fast_mode_state\":\"off\"}\n3:{\"type\":\"rate_limit_event\",\"rate_limit_info\":{\"status\":\"allowed\",\"resetsAt\":1781275800,\"rateLimitType\":\"five_hour\",\"overageStatus\":\"rejected\",\"overageDisabledReason\":\"org_level_disabled\",\"isUsingOverage\":false},\"uuid\":\"b89366a6-46fd-41b0-a5f9-b7415c262c8d\",\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\"}\n30:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01KUNoDYHoz3pp8HRiDSxFUA\",\"type\":\"tool_result\",\"content\":\"1\\timport { existsSync } from \\\"node:fs\\\";\\n2\\timport {\\n3\\t  runInTransaction,\\n4\\t  runWithThreadTouchSuppressed,\\n5\\t  type OperationContext,\\n6\\t} from \\\"../../shared/context.js\\\";\\n7\\timport type { FormKind, FormReportEntry, WorkHandler } from \\\"../../shared/derivation.js\\\";\\n8\\timport { storageFailure, type ErrorResult, type OpResult } from \\\"../../shared/errors.js\\\";\\n9\\timport {\\n10\\t  enqueue,\\n11\\t  hasLiveItem,\\n12\\t  listItems,\\n13\\t  type WorkItemRecord,\\n14\\t  type WorkKind,\\n15\\t} from \\\"../../tech-utils/work-queue/index.js\\\";\\n16\\timport type { EventKind, EventRecord } from \\\"../intake-stream/index.js\\\";\\n17\\timport {\\n18\\t  openThreadDatabase,\\n19\\t  resolveThreadRef,\\n20\\t  type ThreadRef,\\n21\\t} from \\\"../threads/index.js\\\";\\n22\\timport type { DerivedForm } from \\\"../../shared/derivation.js\\\";\\n23\\timport {\\n24\\t  findUnknownOutcomeCallSummary,\\n25\\t  readMessageFormRow,\\n26\\t  readMessageForms,\\n27\\t  reportMessageForms,\\n28\\t} from \\\"./internal/forms.js\\\";\\n29\\timport { messageWorkHandlers } from \\\"./internal/handlers.js\\\";\\n30\\timport { projectEvent } from \\\"./internal/project.js\\\";\\n31\\timport {\\n32\\t  cascadeFromMessage,\\n33\\t  cascadeMessageDelete,\\n34\\t  cascadeTurnDelete,\\n35\\t  type CascadeClear,\\n36\\t  type CascadeOutcome,\\n37\\t} from \\\"./internal/cascade.js\\\";\\n38\\timport {\\n39\\t  applyMessageEdit,\\n40\\t  insertMessage,\\n41\\t  markMessageDeleted,\\n42\\t  markTurnMessagesDeleted,\\n43\\t  readMessageById,\\n44\\t  readMessages,\\n45\\t  readMutableMessage,\\n46\\t} from \\\"./internal/store.js\\\";\\n47\\t\\n48\\texport type BlockType = \\\"text\\\" | \\\"tool_call\\\" | \\\"tool_result\\\";\\n49\\t\\n50\\texport interface Block {\\n51\\t  blockType: BlockType;\\n52\\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\\n53\\t}\\n54\\t\\n55\\texport interface MessageRecord {\\n56\\t  messageId: string;\\n57\\t  sourceEventOrder: number;\\n58\\t  kind: Exclude<EventKind, \\\"turn_end\\\">;\\n59\\t  blocks: Block[];\\n60\\t  tokenEstimate: number;\\n61\\t  actor: string;\\n62\\t  harness: string;\\n63\\t  turnId?: string;\\n64\\t  // The message's derived forms as stored (Epic 02 Story 2): present only\\n65\\t  // for messages that are derivation sources — kinds with no derivable form\\n66\\t  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\\n67\\t  // never re-derived on read.\\n68\\t  forms?: DerivedForm[];\\n69\\t  // The deleted-audit marker (Epic 04 AC-3.3): present (true) only on\\n70\\t  // deleted records, which only the includeDeleted listing and the show\\n71\\t  // read ever surface — a default list never carries the key.\\n72\\t  deleted?: boolean;\\n73\\t}\\n74\\t\\n75\\t// The event as the walk holds it after recording: the validated input plus\\n76\\t// its server-stamped order and timestamp.\\n77\\texport type RecordedEvent = EventRecord;\\n78\\t\\n79\\texport type MessageCreated = {\\n80\\t  messageId: string;\\n81\\t  kind: Exclude<EventKind, \\\"turn_end\\\">;\\n82\\t  // Carried for tool activity only: the pairing key the queue sites need —\\n83\\t  // tool_result projection runs the AC-2.8 late-result lookup against it.\\n84\\t  toolCallId?: string;\\n85\\t} | null;\\n86\\t\\n87\\t// Cross-domain surface, called by intake-stream inside the batch transaction\\n88\\t// (the first such call through the operation context; turns.applyEvent\\n89\\t// follows the pattern in Story 4). Synchronous and throwing by design: a\\n90\\t// projection failure propagates to the pipeline's catch and rejects the\\n91\\t// whole batch — recorded events without messages is the stranded state the\\n92\\t// transaction exists to prevent. Returns null for turn_end (no message).\\n93\\t// turnId is the membership stamp, settled by the pipeline before this call:\\n94\\t// the turn open *after* this event's transition (so a prompt belongs to the\\n95\\t// turn it just opened), or null in a gap — written once, never updated.\\n96\\texport function createFromEvent(\\n97\\t  ctx: OperationContext,\\n98\\t  event: RecordedEvent,\\n99\\t  turnId: string | null,\\n100\\t): MessageCreated {\\n101\\t  const projected = projectEvent(event);\\n102\\t  if (projected === null) return null;\\n103\\t  const kind = event.eventKind as Exclude<EventKind, \\\"turn_end\\\">;\\n104\\t  const messageId = `m${event.eventOrder}`;\\n105\\t  insertMessage(ctx.db, {\\n106\\t    messageId,\\n107\\t    sourceEventOrder: event.eventOrder,\\n108\\t    kind,\\n109\\t    tokenEstimate: projected.tokenEstimate,\\n110\\t    actor: event.actor,\\n111\\t    harness: event.harness,\\n112\\t    turnId,\\n113\\t    blocks: projected.blocks,\\n114\\t  });\\n115\\t  if (event.eventKind === \\\"tool_call\\\" || event.eventKind === \\\"tool_result\\\") {\\n116\\t    return { messageId, kind, toolCallId: event.payload.toolCallId };\\n117\\t  }\\n118\\t  return { messageId, kind };\\n119\\t}\\n120\\t\\n121\\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\\n122\\t// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\\n123\\t// tool result queues tool_result_summary, nothing else queues anything —\\n124\\t// text, thinking, and note messages are not derivation sources (Epic 01\\n125\\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\\n126\\t// intake-stream inside the batch transaction for every recorded message, so\\n127\\t// the item commits (or rolls back) with the batch.\\n128\\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\\n129\\t  user_prompt: \\\"prompt_smoothing\\\",\\n130\\t  tool_call: \\\"tool_call_summary\\\",\\n131\\t  tool_result: \\\"tool_result_summary\\\",\\n132\\t};\\n133\\t\\n134\\t// Which derived form each message-owned kind produces — the owning domain's\\n135\\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\\n136\\t// rides the same transaction (DD-5).\\n137\\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\\n138\\t  prompt_smoothing: \\\"smoothed_prompt\\\",\\n139\\t  tool_call_summary: \\\"tool_call_summary\\\",\\n140\\t  tool_result_summary: \\\"tool_result_summary\\\",\\n141\\t};\\n142\\t\\n143\\t// Message-owned work handlers, merged into the SDK's dispatch map at\\n144\\t// construction (DD-6): prompt smoothing and the two tool-activity summaries.\\n145\\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\\n146\\t  messageWorkHandlers;\\n147\\t\\n148\\texport function queueMessageWork(\\n149\\t  ctx: OperationContext,\\n150\\t  message: MessageCreated,\\n151\\t): WorkItemRecord[] {\\n152\\t  if (message === null) return [];\\n153\\t  const items: WorkItemRecord[] = [];\\n154\\t  const kind = MESSAGE_WORK_KINDS[message.kind];\\n155\\t  if (kind !== undefined) {\\n156\\t    const form = MESSAGE_WORK_FORMS[kind];\\n157\\t    if (form === undefined) {\\n158\\t      // Every queuing kind names its form above; a miss is a wiring bug.\\n159\\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\\n160\\t    }\\n161\\t    items.push(\\n162\\t      enqueue(ctx, {\\n163\\t        owner: \\\"messages\\\",\\n164\\t        kind,\\n165\\t        sourceRef: { messageId: message.messageId },\\n166\\t        forms: [{ subjectKind: \\\"message\\\", subjectId: message.messageId, form }],\\n167\\t      }),\\n168\\t    );\\n169\\t  }\\n170\\t  // Late-result repair (AC-2.8): a tool result landing after its call's\\n171\\t  // summary already derived with outcome \\\"unknown\\\" means the summary's\\n172\\t  // source — the call+result pair — completed underneath it; clear and\\n173\\t  // regenerate at the next source version, in this same batch transaction.\\n174\\t  // One indexed lookup; pending summaries (metadata NULL) never match, so\\n175\\t  // the common call-and-result-in-one-batch case never triggers, and the\\n176\\t  // version-scoped item id keeps the requeue idempotent.\\n177\\t  if (message.kind === \\\"tool_result\\\" && message.toolCallId !== undefined) {\\n178\\t    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\\n179\\t    if (stale !== undefined) {\\n180\\t      items.push(\\n181\\t        enqueue(ctx, {\\n182\\t          owner: \\\"messages\\\",\\n183\\t          kind: \\\"tool_call_summary\\\",\\n184\\t          sourceRef: { messageId: stale.messageId },\\n185\\t          sourceVersion: stale.sourceVersion + 1,\\n186\\t          forms: [\\n187\\t            {\\n188\\t              subjectKind: \\\"message\\\",\\n189\\t              subjectId: stale.messageId,\\n190\\t              form: \\\"tool_call_summary\\\",\\n191\\t            },\\n192\\t          ],\\n193\\t        }),\\n194\\t      );\\n195\\t    }\\n196\\t  }\\n197\\t  return items;\\n198\\t}\\n199\\t\\n200\\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\\n201\\t  return {\\n202\\t    ok: false,\\n203\\t    error: {\\n204\\t      errorClass: \\\"caller_error\\\",\\n205\\t      code: \\\"thread_not_found\\\",\\n206\\t      reason: `no thread file exists at ${filePath}`,\\n207\\t    },\\n208\\t  };\\n209\\t}\\n210\\t\\n211\\t// Bounded-listing options (Epic 04 Story 1, DD-3): from/to are\\n212\\t// source-event-order bounds, limit caps the count after bounds,\\n213\\t// includeDeleted is the audit opt-in. All optional — existing callers see\\n214\\t// identical results (visible messages, unbounded, record order).\\n215\\texport interface MessageListOptions {\\n216\\t  from?: number;\\n217\\t  to?: number;\\n218\\t  limit?: number;\\n219\\t  includeDeleted?: boolean;\\n220\\t}\\n221\\t\\n222\\tfunction invalidBounds(reason: string): ErrorResult {\\n223\\t  return { errorClass: \\\"caller_error\\\", code: \\\"invalid_bounds\\\", reason };\\n224\\t}\\n225\\t\\n226\\t// Bounds mistakes are operational caller errors returned as results (tech\\n227\\t// design §Interface Definitions: from > to, limit < 1) — never a silent\\n228\\t// empty list a caller could mistake for an empty window.\\n229\\tfunction validateListOptions(opts: MessageListOptions): ErrorResult | undefined {\\n230\\t  const integers: ReadonlyArray<readonly [string, number | undefined]> = [\\n231\\t    [\\\"from\\\", opts.from],\\n232\\t    [\\\"to\\\", opts.to],\\n233\\t    [\\\"limit\\\", opts.limit],\\n234\\t  ];\\n235\\t  for (const [name, value] of integers) {\\n236\\t    if (value !== undefined && !Number.isInteger(value)) {\\n237\\t      return invalidBounds(`${name} must be an integer, got ${value}`);\\n238\\t    }\\n239\\t  }\\n240\\t  if (opts.from !== undefined && opts.to !== undefined && opts.from > opts.to) {\\n241\\t    return invalidBounds(`from (${opts.from}) must not exceed to (${opts.to})`);\\n242\\t  }\\n243\\t  if (opts.limit !== undefined && opts.limit < 1) {\\n244\\t    return invalidBounds(`limit must be at least 1, got ${opts.limit}`);\\n245\\t  }\\n246\\t  return undefined;\\n247\\t}\\n248\\t\\n249\\t// Reads-only is structural, not disciplined (DD-6, SV-01-001): the whole\\n250\\t// operation runs in the touch-suppressed scope, so openThreadDatabase's open\\n251\\t// announcement (openThreadDatabase → fireThreadTouch → scheduler.touch) can\\n252\\t// never let a background SDK's scheduler hang a first-touch catch-up drain —\\n253\\t// and the provider call that drain would make — off this read. A list calls\\n254\\t// no provider and schedules no work in either host mode.\\n255\\texport function listMessages(\\n256\\t  thread: ThreadRef,\\n257\\t  opts?: MessageListOptions,\\n258\\t): Promise<OpResult<MessageRecord[]>> {\\n259\\t  return runWithThreadTouchSuppressed(() => listMessagesInner(thread, opts));\\n260\\t}\\n261\\t\\n262\\tasync function listMessagesInner(\\n263\\t  thread: ThreadRef,\\n264\\t  opts?: MessageListOptions,\\n265\\t): Promise<OpResult<MessageRecord[]>> {\\n266\\t  if (opts !== undefined) {\\n267\\t    const badBounds = validateListOptions(opts);\\n268\\t    if (badBounds !== undefined) return { ok: false, error: badBounds };\\n269\\t  }\\n270\\t  const resolved = await resolveThreadRef(thread);\\n271\\t  if (!resolved.ok) return resolved;\\n272\\t  const { filePath } = resolved.value;\\n273\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n274\\t\\n275\\t  // openThreadDatabase verifies the file is a real thread file and migrates\\n276\\t  // a pre-Story-3 one before the read, so a thread recorded under an earlier\\n277\\t  // story lists cleanly (F-03-001) and a non-thread file is rejected\\n278\\t  // unmutated (F-03-002).\\n279\\t  const opened = openThreadDatabase(filePath);\\n280\\t  if (!opened.ok) return opened;\\n281\\t  const db = opened.value;\\n282\\t  try {\\n283\\t    // Bounds resolve the window first (AC-3.1 no-load-everything), then the\\n284\\t    // form read-back rides only that window (AC-2.1): each record carries its\\n285\\t    // stored derived forms, attached from one grouped query scoped to the\\n286\\t    // listed ids — never every message-owned form in a large thread.\\n287\\t    const records = readMessages(db, opts ?? {});\\n288\\t    const formsByMessage = readMessageForms(\\n289\\t      db,\\n290\\t      records.map((record) => record.messageId),\\n291\\t    );\\n292\\t    const withForms = records.map((record) => {\\n293\\t      const forms = formsByMessage.get(record.messageId);\\n294\\t      return forms === undefined ? record : { ...record, forms };\\n295\\t    });\\n296\\t    return { ok: true, value: withForms };\\n297\\t  } catch (cause) {\\n298\\t    const reason = cause instanceof Error ? cause.message : String(cause);\\n299\\t    return storageFailure(`message read-back failed: ${reason}`);\\n300\\t  } finally {\\n301\\t    db.close();\\n302\\t  }\\n303\\t}\\n304\\t\\n305\\t// The single-message view (Epic 04 AC-3.2): the canonical record — every\\n306\\t// block with complete content, full tool results, never the view-shortened\\n307\\t// forms — plus the message's derivation forms with their states and\\n308\\t// mechanically stamped metadata, joined from the owner's report read.\\n309\\texport interface MessageDetail extends Omit<MessageRecord, \\\"forms\\\"> {\\n310\\t  // Always present and honest (AC-3.3): show on a deleted message returns\\n311\\t  // the record flagged — audit is the point — never a not-found.\\n312\\t  deleted: boolean;\\n313\\t  // The owner report's queue-joined entries (DD-2), never synthesized here:\\n314\\t  // the same `reportMessageForms` read messages.report serves, scoped by id.\\n315\\t  forms: FormReportEntry[];\\n316\\t}\\n317\\t\\n318\\t// Reads-only is structural (DD-6, SV-01-001), exactly as listMessages: the\\n319\\t// open announcement that would let a background scheduler hang a first-touch\\n320\\t// catch-up drain (and its provider call) off this show is suppressed for the\\n321\\t// whole operation. show on a deleted message stays the audit read; neither\\n322\\t// path touches the queue or the provider.\\n323\\texport function show(\\n324\\t  thread: ThreadRef,\\n325\\t  messageId: string,\\n326\\t): Promise<OpResult<MessageDetail>> {\\n327\\t  return runWithThreadTouchSuppressed(() => showInner(thread, messageId));\\n328\\t}\\n329\\t\\n330\\tasync function showInner(\\n331\\t  thread: ThreadRef,\\n332\\t  messageId: string,\\n333\\t): Promise<OpResult<MessageDetail>> {\\n334\\t  const resolved = await resolveThreadRef(thread);\\n335\\t  if (!resolved.ok) return resolved;\\n336\\t  const { filePath } = resolved.value;\\n337\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n338\\t\\n339\\t  const opened = openThreadDatabase(filePath);\\n340\\t  if (!opened.ok) return opened;\\n341\\t  const db = opened.value;\\n342\\t  try {\\n343\\t    const record = readMessageById(db, messageId);\\n344\\t    if (record === undefined) {\\n345\\t      return {\\n346\\t        ok: false,\\n347\\t        error: {\\n348\\t          errorClass: \\\"caller_error\\\",\\n349\\t          code: \\\"message_not_found\\\",\\n350\\t          reason: `no message ${messageId} exists in this thread`,\\n351\\t        },\\n352\\t      };\\n353\\t    }\\n354\\t    const forms = reportMessageForms(db, { messageId });\\n355\\t    return { ok: true, value: { ...record, forms } };\\n356\\t  } catch (cause) {\\n357\\t    const reason = cause instanceof Error ? cause.message : String(cause);\\n358\\t    return storageFailure(`message show failed: ${reason}`);\\n359\\t  } finally {\\n360\\t    db.close();\\n361\\t  }\\n362\\t}\\n363\\t\\n364\\texport async function listQueuedWork(\\n365\\t  thread: ThreadRef,\\n366\\t): Promise<OpResult<WorkItemRecord[]>> {\\n367\\t  const resolved = await resolveThreadRef(thread);\\n368\\t  if (!resolved.ok) return resolved;\\n369\\t  const { filePath } = resolved.value;\\n370\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n371\\t\\n372\\t  const opened = openThreadDatabase(filePath);\\n373\\t  if (!opened.ok) return opened;\\n374\\t  const db = opened.value;\\n375\\t  try {\\n376\\t    return { ok: true, value: listItems(db, \\\"messages\\\") };\\n377\\t  } catch (cause) {\\n378\\t    const reason = cause instanceof Error ? cause.message : String(cause);\\n379\\t    return storageFailure(`queued-work read-back failed: ${reason}`);\\n380\\t  } finally {\\n381\\t    db.close();\\n382\\t  }\\n383\\t}\\n384\\t\\n385\\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\\n386\\t\\n387\\t// This owner's repair report: every message-owned form's durable state\\n388\\t// joined with live queue detail in one query — the five operational\\n389\\t// situations (waiting, retrying, ready, failed, blocked) read from the rows\\n390\\t// without any queue API. Needs no provider; reads degrade, never block.\\n391\\texport async function report(\\n392\\t  thread: ThreadRef,\\n393\\t  opts?: { notReady?: boolean; messageId?: string },\\n394\\t): Promise<OpResult<FormReportEntry[]>> {\\n395\\t  const resolved = await resolveThreadRef(thread);\\n396\\t  if (!resolved.ok) return resolved;\\n397\\t  const { filePath } = resolved.value;\\n398\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n399\\t\\n400\\t  const opened = openThreadDatabase(filePath);\\n401\\t  if (!opened.ok) return opened;\\n402\\t  const db = opened.value;\\n403\\t  try {\\n404\\t    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\\n405\\t  } catch (cause) {\\n406\\t    const reason = cause instanceof Error ? cause.message : String(cause);\\n407\\t    return storageFailure(`report read failed: ${reason}`);\\n408\\t  } finally {\\n409\\t    db.close();\\n410\\t  }\\n411\\t}\\n412\\t\\n413\\texport type RequeueOutcome = { workItemId: string } | { noop: \\\"already_queued\\\" };\\n414\\t\\n415\\t// Which work kind rebuilds each message-owned form — MESSAGE_WORK_FORMS\\n416\\t// inverted; the requeue's join from the named form back to its queue site.\\n417\\tconst MESSAGE_FORM_KINDS: Partial<Record<FormKind, WorkKind>> = {\\n418\\t  smoothed_prompt: \\\"prompt_smoothing\\\",\\n419\\t  tool_call_summary: \\\"tool_call_summary\\\",\\n420\\t  tool_result_summary: \\\"tool_result_summary\\\",\\n421\\t};\\n422\\t\\n423\\t// Explicit re-queue through the owning surface (AC-4.4): the public,\\n424\\t// supported rebuild act. Refused for blocked forms with the form's stored\\n425\\t// damage reason (AC-4.6) and for missing rows; a no-op against work already\\n426\\t// queued or in flight at the form's current source version (AC-4.5).\\n427\\t// Otherwise the form clears to pending and re-enqueues at the next source\\n428\\t// version — the same enqueue path intake uses, poke-on-commit included, so\\n429\\t// background mode processes the repair with no further call. The no-op check\\n430\\t// and the enqueue commit in one transaction (anti-shim: a split would\\n431\\t// reintroduce the duplicate-work race).\\n432\\texport async function requeue(\\n433\\t  thread: ThreadRef,\\n434\\t  target: { messageId: string; form: FormKind },\\n435\\t): Promise<OpResult<RequeueOutcome>> {\\n436\\t  const kind = MESSAGE_FORM_KINDS[target.form];\\n437\\t  if (kind === undefined) {\\n438\\t    return {\\n439\\t      ok: false,\\n440\\t      error: {\\n441\\t        errorClass: \\\"caller_error\\\",\\n442\\t        code: \\\"message_not_found\\\",\\n443\\t        reason: `form ${target.form} is not message-owned; messages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\\n444\\t      },\\n445\\t    };\\n446\\t  }\\n447\\t  const resolved = await resolveThreadRef(thread);\\n448\\t  if (!resolved.ok) return resolved;\\n449\\t  const { filePath } = resolved.value;\\n450\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n451\\t\\n452\\t  const opened = openThreadDatabase(filePath);\\n453\\t  if (!opened.ok) return opened;\\n454\\t  const db = opened.value;\\n455\\t  try {\\n456\\t    const meta = db\\n457\\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\\n458\\t      .get() as { thread_id: string } | undefined;\\n459\\t    const threadId = meta?.thread_id ?? \\\"\\\";\\n460\\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\\n461\\t      const row = readMessageFormRow(ctx.db, target.messageId, target.form);\\n462\\t      if (row === undefined) {\\n463\\t        return {\\n464\\t          ok: false,\\n465\\t          error: {\\n466\\t            errorClass: \\\"caller_error\\\",\\n467\\t            code: \\\"message_not_found\\\",\\n468\\t            reason: `no derived form ${target.form} exists for message ${target.messageId}`,\\n469\\t          },\\n470\\t        };\\n471\\t      }\\n472\\t      if (row.state === \\\"blocked\\\") {\\n473\\t        // The refusal carries the form's stored reason — the damage named at\\n474\\t        // blocking time, not a generic string (AC-4.6).\\n475\\t        return {\\n476\\t          ok: false,\\n477\\t          error: {\\n478\\t            errorClass: \\\"state_corruption\\\",\\n479\\t            code: \\\"source_damaged\\\",\\n480\\t            reason: row.reason ?? `form ${target.form} for message ${target.messageId} is blocked`,\\n481\\t          },\\n482\\t        };\\n483\\t      }\\n484\\t      const sourceRef = { messageId: target.messageId };\\n485\\t      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\\n486\\t        return { ok: true, value: { noop: \\\"already_queued\\\" } };\\n487\\t      }\\n488\\t      const item = enqueue(ctx, {\\n489\\t        owner: \\\"messages\\\",\\n490\\t        kind,\\n491\\t        sourceRef,\\n492\\t        sourceVersion: row.sourceVersion + 1,\\n493\\t        forms: [{ subjectKind: \\\"message\\\", subjectId: target.messageId, form: target.form }],\\n494\\t      });\\n495\\t      return { ok: true, value: { workItemId: item.workItemId } };\\n496\\t    });\\n497\\t  } catch (cause) {\\n498\\t    const reason = cause instanceof Error ? cause.message : String(cause);\\n499\\t    return storageFailure(`requeue failed: ${reason}`);\\n500\\t  } finally {\\n501\\t    db.close();\\n502\\t  }\\n503\\t}\\n504\\t\\n505\\t// ── mutations (Epic 02 Story 5, Flow 5) ──────────────────────────\\n506\\t\\n507\\t// The mutation result contract (tech design §Interfaces): what changed in\\n508\\t// the record, which dependent forms cleared, which dropped (delete only),\\n509\\t// what replacement work queued, and which still-queued old items the cascade\\n510\\t// tidied away (issue 1). Shared by edit and the Story 6 deletes.\\n511\\texport interface MutationResult {\\n512\\t  changed: { messageIds: string[]; turnIds: string[] };\\n513\\t  cleared: CascadeClear[];\\n514\\t  dropped: CascadeClear[];\\n515\\t  queued: Array<{ workItemId: string; kind: WorkKind }>;\\n516\\t  superseded: string[];\\n517\\t}\\n518\\t\\n519\\t// The record's first sanctioned mutation (AC-5.1–5.5): change a closed-turn\\n520\\t// message's content and blocks, re-stamp the token estimate, and walk the\\n521\\t// full dependent chain — clear to pending, supersede queued old work,\\n522\\t// enqueue replacements at the next source version — in one transaction.\\n523\\t// Synchronous and local by contract: everything above commits before this\\n524\\t// returns; the re-queued rebuilds run through the normal drain (background\\n525\\t// mode needs no further call — the enqueue pokes ride the commit). Events\\n526\\t// are never touched (projection-level mutation, DD-12), and no generated\\n527\\t// thread-view is either — visibility arrives at the next compact/rebuild.\\n528\\t// Refusals read through the deleted-filtered view and enforce the closed-turn\\n529\\t// target boundary: only a message in a closed turn is editable, so an\\n530\\t// open-turn *or* a turnless (no-membership) gap target is refused turn_open —\\n531\\t// the boundary's one stable code — a missing or deleted message is\\n532\\t// message_not_found, and a refusal changes nothing.\\n533\\texport async function edit(\\n534\\t  thread: ThreadRef,\\n535\\t  input: { messageId: string; content: string },\\n536\\t): Promise<OpResult<MutationResult>> {\\n537\\t  const resolved = await resolveThreadRef(thread);\\n538\\t  if (!resolved.ok) return resolved;\\n539\\t  const { filePath } = resolved.value;\\n540\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n541\\t\\n542\\t  const opened = openThreadDatabase(filePath);\\n543\\t  if (!opened.ok) return opened;\\n544\\t  const db = opened.value;\\n545\\t  try {\\n546\\t    const meta = db\\n547\\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\\n548\\t      .get() as { thread_id: string } | undefined;\\n549\\t    const threadId = meta?.thread_id ?? \\\"\\\";\\n550\\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\\n551\\t      const target = readMutableMessage(ctx.db, input.messageId);\\n552\\t      if (target === undefined) {\\n553\\t        return {\\n554\\t          ok: false,\\n555\\t          error: {\\n556\\t            errorClass: \\\"caller_error\\\",\\n557\\t            code: \\\"message_not_found\\\",\\n558\\t            reason: `no message ${input.messageId} exists in this thread`,\\n559\\t          },\\n560\\t        };\\n561\\t      }\\n562\\t      // The closed-turn target boundary (story scope; AC-5.1): the edit's\\n563\\t      // editable class is a message in a *closed* turn. Both failing cases —\\n564\\t      // an open turn and a turnless gap message (no membership) — refuse under\\n565\\t      // the one stable code; the reason distinguishes them so the open-turn\\n566\\t      // message reads exactly as before. A deleted/missing target never gets\\n567\\t      // here (it misses the filtered read above as message_not_found).\\n568\\t      if (target.turnStatus !== \\\"closed\\\") {\\n569\\t        return {\\n570\\t          ok: false,\\n571\\t          error: {\\n572\\t            errorClass: \\\"caller_error\\\",\\n573\\t            code: \\\"turn_open\\\",\\n574\\t            reason:\\n575\\t              target.turnStatus === \\\"open\\\"\\n576\\t                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \\\"\\\"}; open-turn messages cannot be edited (v1 boundary)`\\n577\\t                : `message ${input.messageId} has no turn membership; only closed-turn messages can be edited (v1 boundary)`,\\n578\\t          },\\n579\\t        };\\n580\\t      }\\n581\\t      applyMessageEdit(ctx.db, input.messageId, input.content);\\n582\\t      const cascade = cascadeFromMessage(ctx, input.messageId);\\n583\\t      return {\\n584\\t        ok: true,\\n585\\t        value: {\\n586\\t          changed: { messageIds: [input.messageId], turnIds: [] },\\n587\\t          cleared: cascade.cleared,\\n588\\t          dropped: cascade.dropped,\\n589\\t          queued: cascade.queued,\\n590\\t          superseded: cascade.superseded,\\n591\\t        },\\n592\\t      };\\n593\\t    });\\n594\\t  } catch (cause) {\\n595\\t    const reason = cause instanceof Error ? cause.message : String(cause);\\n596\\t    return storageFailure(`edit failed: ${reason}`);\\n597\\t  } finally {\\n598\\t    db.close();\\n599\\t  }\\n600\\t}\\n601\\t\\n602\\t// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\\n603\\t\\n604\\t// The record's removal mutation for one message (AC-6.1–6.3, 6.7):\\n605\\t// projection-level delete — the deleted_at stamp plus the delete cascade\\n606\\t// (own forms dropped, turn and chunk cleared and re-queued for minus-one\\n607\\t// composition) in one transaction. The source events are never touched;\\n608\\t// event read-back keeps returning them (the audit surface). Validation\\n609\\t// reads the same filtered view as edit, so a missing, deleted, or\\n610\\t// double-deleted target is message_not_found and an open-turn or turnless\\n611\\t// gap target is turn_open. The one delete-specific refusal is prompt\\n612\\t// protection: a turn is a prompt and what came back for it, so deleting the\\n613\\t// turn's initiating prompt is refused toward turns.deleteTurn — the error\\n614\\t// names the turn and that path (AC-6.3).\\n615\\texport async function deleteMessage(\\n616\\t  thread: ThreadRef,\\n617\\t  input: { messageId: string },\\n618\\t): Promise<OpResult<MutationResult>> {\\n619\\t  const resolved = await resolveThreadRef(thread);\\n620\\t  if (!resolved.ok) return resolved;\\n621\\t  const { filePath } = resolved.value;\\n622\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n623\\t\\n624\\t  const opened = openThreadDatabase(filePath);\\n625\\t  if (!opened.ok) return opened;\\n626\\t  const db = opened.value;\\n627\\t  try {\\n628\\t    const meta = db\\n629\\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\\n630\\t      .get() as { thread_id: string } | undefined;\\n631\\t    const threadId = meta?.thread_id ?? \\\"\\\";\\n632\\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\\n633\\t      const target = readMutableMessage(ctx.db, input.messageId);\\n634\\t      if (target === undefined) {\\n635\\t        return {\\n636\\t          ok: false,\\n637\\t          error: {\\n638\\t            errorClass: \\\"caller_error\\\",\\n639\\t            code: \\\"message_not_found\\\",\\n640\\t            reason: `no message ${input.messageId} exists in this thread`,\\n641\\t          },\\n642\\t        };\\n643\\t      }\\n644\\t      if (target.turnStatus !== \\\"closed\\\") {\\n645\\t        return {\\n646\\t          ok: false,\\n647\\t          error: {\\n648\\t            errorClass: \\\"caller_error\\\",\\n649\\t            code: \\\"turn_open\\\",\\n650\\t            reason:\\n651\\t              target.turnStatus === \\\"open\\\"\\n652\\t                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \\\"\\\"}; open-turn messages cannot be deleted (v1 boundary)`\\n653\\t                : `message ${input.messageId} has no turn membership; only closed-turn messages can be deleted (v1 boundary)`,\\n654\\t          },\\n655\\t        };\\n656\\t      }\\n657\\t      if (target.initiatesTurn) {\\n658\\t        return {\\n659\\t          ok: false,\\n660\\t          error: {\\n661\\t            errorClass: \\\"caller_error\\\",\\n662\\t            code: \\\"message_initiates_turn\\\",\\n663\\t            reason: `message ${input.messageId} is the prompt that initiates turn ${target.turnId ?? \\\"\\\"}; a turn is a prompt and what came back for it — delete the whole exchange with turns.deleteTurn (lhc turns delete --turn-id ${target.turnId ?? \\\"\\\"})`,\\n664\\t          },\\n665\\t        };\\n666\\t      }\\n667\\t      markMessageDeleted(ctx.db, input.messageId, ctx.clock().toISOString());\\n668\\t      const cascade = cascadeMessageDelete(ctx, input.messageId);\\n669\\t      return {\\n670\\t        ok: true,\\n671\\t        value: {\\n672\\t          changed: { messageIds: [input.messageId], turnIds: [] },\\n673\\t          cleared: cascade.cleared,\\n674\\t          dropped: cascade.dropped,\\n675\\t          queued: cascade.queued,\\n676\\t          superseded: cascade.superseded,\\n677\\t        },\\n678\\t      };\\n679\\t    });\\n680\\t  } catch (cause) {\\n681\\t    const reason = cause instanceof Error ? cause.message : String(cause);\\n682\\t    return storageFailure(`delete failed: ${reason}`);\\n683\\t  } finally {\\n684\\t    db.close();\\n685\\t  }\\n686\\t}\\n687\\t\\n688\\t// Cross-domain surface for turns.deleteTurn (DD-8: one cascade module, two\\n689\\t// callers), called inside the turn delete's transaction after the turn row\\n690\\t// is stamped. The messages domain owns the message-table write — the member\\n691\\t// stamp, scoped to live rows — and the shared cascade entry; the turns\\n692\\t// operation owns its own validation and turn-row stamp. Returns the cascade\\n693\\t// outcome plus the member ids stamped now (record order), which the turn\\n694\\t// delete reports as its changed messages.\\n695\\texport function applyTurnDeleteCascade(\\n696\\t  ctx: OperationContext,\\n697\\t  turnId: string,\\n698\\t): CascadeOutcome & { memberMessageIds: string[] } {\\n699\\t  const memberMessageIds = markTurnMessagesDeleted(\\n700\\t    ctx.db,\\n701\\t    turnId,\\n702\\t    ctx.clock().toISOString(),\\n703\\t  );\\n704\\t  return { ...cascadeTurnDelete(ctx, turnId, memberMessageIds), memberMessageIds };\\n705\\t}\\n706\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"uuid\":\"b07d0b3e-cc2c-492c-92de-1d2c0847551e\",\"timestamp\":\"2026-06-12T13:24:04.831Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/index.ts\",\"content\":\"import { existsSync } from \\\"node:fs\\\";\\nimport {\\n  runInTransaction,\\n  runWithThreadTouchSuppressed,\\n  type OperationContext,\\n} from \\\"../../shared/context.js\\\";\\nimport type { FormKind, FormReportEntry, WorkHandler } from \\\"../../shared/derivation.js\\\";\\nimport { storageFailure, type ErrorResult, type OpResult } from \\\"../../shared/errors.js\\\";\\nimport {\\n  enqueue,\\n  hasLiveItem,\\n  listItems,\\n  type WorkItemRecord,\\n  type WorkKind,\\n} from \\\"../../tech-utils/work-queue/index.js\\\";\\nimport type { EventKind, EventRecord } from \\\"../intake-stream/index.js\\\";\\nimport {\\n  openThreadDatabase,\\n  resolveThreadRef,\\n  type ThreadRef,\\n} from \\\"../threads/index.js\\\";\\nimport type { DerivedForm } from \\\"../../shared/derivation.js\\\";\\nimport {\\n  findUnknownOutcomeCallSummary,\\n  readMessageFormRow,\\n  readMessageForms,\\n  reportMessageForms,\\n} from \\\"./internal/forms.js\\\";\\nimport { messageWorkHandlers } from \\\"./internal/handlers.js\\\";\\nimport { projectEvent } from \\\"./internal/project.js\\\";\\nimport {\\n  cascadeFromMessage,\\n  cascadeMessageDelete,\\n  cascadeTurnDelete,\\n  type CascadeClear,\\n  type CascadeOutcome,\\n} from \\\"./internal/cascade.js\\\";\\nimport {\\n  applyMessageEdit,\\n  insertMessage,\\n  markMessageDeleted,\\n  markTurnMessagesDeleted,\\n  readMessageById,\\n  readMessages,\\n  readMutableMessage,\\n} from \\\"./internal/store.js\\\";\\n\\nexport type BlockType = \\\"text\\\" | \\\"tool_call\\\" | \\\"tool_result\\\";\\n\\nexport interface Block {\\n  blockType: BlockType;\\n  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\\n}\\n\\nexport interface MessageRecord {\\n  messageId: string;\\n  sourceEventOrder: number;\\n  kind: Exclude<EventKind, \\\"turn_end\\\">;\\n  blocks: Block[];\\n  tokenEstimate: number;\\n  actor: string;\\n  harness: string;\\n  turnId?: string;\\n  // The message's derived forms as stored (Epic 02 Story 2): present only\\n  // for messages that are derivation sources — kinds with no derivable form\\n  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\\n  // never re-derived on read.\\n  forms?: DerivedForm[];\\n  // The deleted-audit marker (Epic 04 AC-3.3): present (true) only on\\n  // deleted records, which only the includeDeleted listing and the show\\n  // read ever surface — a default list never carries the key.\\n  deleted?: boolean;\\n}\\n\\n// The event as the walk holds it after recording: the validated input plus\\n// its server-stamped order and timestamp.\\nexport type RecordedEvent = EventRecord;\\n\\nexport type MessageCreated = {\\n  messageId: string;\\n  kind: Exclude<EventKind, \\\"turn_end\\\">;\\n  // Carried for tool activity only: the pairing key the queue sites need —\\n  // tool_result projection runs the AC-2.8 late-result lookup against it.\\n  toolCallId?: string;\\n} | null;\\n\\n// Cross-domain surface, called by intake-stream inside the batch transaction\\n// (the first such call through the operation context; turns.applyEvent\\n// follows the pattern in Story 4). Synchronous and throwing by design: a\\n// projection failure propagates to the pipeline's catch and rejects the\\n// whole batch — recorded events without messages is the stranded state the\\n// transaction exists to prevent. Returns null for turn_end (no message).\\n// turnId is the membership stamp, settled by the pipeline before this call:\\n// the turn open *after* this event's transition (so a prompt belongs to the\\n// turn it just opened), or null in a gap — written once, never updated.\\nexport function createFromEvent(\\n  ctx: OperationContext,\\n  event: RecordedEvent,\\n  turnId: string | null,\\n): MessageCreated {\\n  const projected = projectEvent(event);\\n  if (projected === null) return null;\\n  const kind = event.eventKind as Exclude<EventKind, \\\"turn_end\\\">;\\n  const messageId = `m${event.eventOrder}`;\\n  insertMessage(ctx.db, {\\n    messageId,\\n    sourceEventOrder: event.eventOrder,\\n    kind,\\n    tokenEstimate: projected.tokenEstimate,\\n    actor: event.actor,\\n    harness: event.harness,\\n    turnId,\\n    blocks: projected.blocks,\\n  });\\n  if (event.eventKind === \\\"tool_call\\\" || event.eventKind === \\\"tool_result\\\") {\\n    return { messageId, kind, toolCallId: event.payload.toolCallId };\\n  }\\n  return { messageId, kind };\\n}\\n\\n// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\\n// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\\n// tool result queues tool_result_summary, nothing else queues anything —\\n// text, thinking, and note messages are not derivation sources (Epic 01\\n// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\\n// intake-stream inside the batch transaction for every recorded message, so\\n// the item commits (or rolls back) with the batch.\\nconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\\n  user_prompt: \\\"prompt_smoothing\\\",\\n  tool_call: \\\"tool_call_summary\\\",\\n  tool_result: \\\"tool_result_summary\\\",\\n};\\n\\n// Which derived form each message-owned kind produces — the owning domain's\\n// knowledge, handed to the meaning-blind enqueue so the form's pending row\\n// rides the same transaction (DD-5).\\nconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\\n  prompt_smoothing: \\\"smoothed_prompt\\\",\\n  tool_call_summary: \\\"tool_call_summary\\\",\\n  tool_result_summary: \\\"tool_result_summary\\\",\\n};\\n\\n// Message-owned work handlers, merged into the SDK's dispatch map at\\n// construction (DD-6): prompt smoothing and the two tool-activity summaries.\\nexport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\\n  messageWorkHandlers;\\n\\nexport function queueMessageWork(\\n  ctx: OperationContext,\\n  message: MessageCreated,\\n): WorkItemRecord[] {\\n  if (message === null) return [];\\n  const items: WorkItemRecord[] = [];\\n  const kind = MESSAGE_WORK_KINDS[message.kind];\\n  if (kind !== undefined) {\\n    const form = MESSAGE_WORK_FORMS[kind];\\n    if (form === undefined) {\\n      // Every queuing kind names its form above; a miss is a wiring bug.\\n      throw new Error(`no derived form mapped for message work kind ${kind}`);\\n    }\\n    items.push(\\n      enqueue(ctx, {\\n        owner: \\\"messages\\\",\\n        kind,\\n        sourceRef: { messageId: message.messageId },\\n        forms: [{ subjectKind: \\\"message\\\", subjectId: message.messageId, form }],\\n      }),\\n    );\\n  }\\n  // Late-result repair (AC-2.8): a tool result landing after its call's\\n  // summary already derived with outcome \\\"unknown\\\" means the summary's\\n  // source — the call+result pair — completed underneath it; clear and\\n  // regenerate at the next source version, in this same batch transaction.\\n  // One indexed lookup; pending summaries (metadata NULL) never match, so\\n  // the common call-and-result-in-one-batch case never triggers, and the\\n  // version-scoped item id keeps the requeue idempotent.\\n  if (message.kind === \\\"tool_result\\\" && message.toolCallId !== undefined) {\\n    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\\n    if (stale !== undefined) {\\n      items.push(\\n        enqueue(ctx, {\\n          owner: \\\"messages\\\",\\n          kind: \\\"tool_call_summary\\\",\\n          sourceRef: { messageId: stale.messageId },\\n          sourceVersion: stale.sourceVersion + 1,\\n          forms: [\\n            {\\n              subjectKind: \\\"message\\\",\\n              subjectId: stale.messageId,\\n              form: \\\"tool_call_summary\\\",\\n            },\\n          ],\\n        }),\\n      );\\n    }\\n  }\\n  return items;\\n}\\n\\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\\n  return {\\n    ok: false,\\n    error: {\\n      errorClass: \\\"caller_error\\\",\\n      code: \\\"thread_not_found\\\",\\n      reason: `no thread file exists at ${filePath}`,\\n    },\\n  };\\n}\\n\\n// Bounded-listing options (Epic 04 Story 1, DD-3): from/to are\\n// source-event-order bounds, limit caps the count after bounds,\\n// includeDeleted is the audit opt-in. All optional — existing callers see\\n// identical results (visible messages, unbounded, record order).\\nexport interface MessageListOptions {\\n  from?: number;\\n  to?: number;\\n  limit?: number;\\n  includeDeleted?: boolean;\\n}\\n\\nfunction invalidBounds(reason: string): ErrorResult {\\n  return { errorClass: \\\"caller_error\\\", code: \\\"invalid_bounds\\\", reason };\\n}\\n\\n// Bounds mistakes are operational caller errors returned as results (tech\\n// design §Interface Definitions: from > to, limit < 1) — never a silent\\n// empty list a caller could mistake for an empty window.\\nfunction validateListOptions(opts: MessageListOptions): ErrorResult | undefined {\\n  const integers: ReadonlyArray<readonly [string, number | undefined]> = [\\n    [\\\"from\\\", opts.from],\\n    [\\\"to\\\", opts.to],\\n    [\\\"limit\\\", opts.limit],\\n  ];\\n  for (const [name, value] of integers) {\\n    if (value !== undefined && !Number.isInteger(value)) {\\n      return invalidBounds(`${name} must be an integer, got ${value}`);\\n    }\\n  }\\n  if (opts.from !== undefined && opts.to !== undefined && opts.from > opts.to) {\\n    return invalidBounds(`from (${opts.from}) must not exceed to (${opts.to})`);\\n  }\\n  if (opts.limit !== undefined && opts.limit < 1) {\\n    return invalidBounds(`limit must be at least 1, got ${opts.limit}`);\\n  }\\n  return undefined;\\n}\\n\\n// Reads-only is structural, not disciplined (DD-6, SV-01-001): the whole\\n// operation runs in the touch-suppressed scope, so openThreadDatabase's open\\n// announcement (openThreadDatabase → fireThreadTouch → scheduler.touch) can\\n// never let a background SDK's scheduler hang a first-touch catch-up drain —\\n// and the provider call that drain would make — off this read. A list calls\\n// no provider and schedules no work in either host mode.\\nexport function listMessages(\\n  thread: ThreadRef,\\n  opts?: MessageListOptions,\\n): Promise<OpResult<MessageRecord[]>> {\\n  return runWithThreadTouchSuppressed(() => listMessagesInner(thread, opts));\\n}\\n\\nasync function listMessagesInner(\\n  thread: ThreadRef,\\n  opts?: MessageListOptions,\\n): Promise<OpResult<MessageRecord[]>> {\\n  if (opts !== undefined) {\\n    const badBounds = validateListOptions(opts);\\n    if (badBounds !== undefined) return { ok: false, error: badBounds };\\n  }\\n  const resolved = await resolveThreadRef(thread);\\n  if (!resolved.ok) return resolved;\\n  const { filePath } = resolved.value;\\n  if (!existsSync(filePath)) return threadNotFound(filePath);\\n\\n  // openThreadDatabase verifies the file is a real thread file and migrates\\n  // a pre-Story-3 one before the read, so a thread recorded under an earlier\\n  // story lists cleanly (F-03-001) and a non-thread file is rejected\\n  // unmutated (F-03-002).\\n  const opened = openThreadDatabase(filePath);\\n  if (!opened.ok) return opened;\\n  const db = opened.value;\\n  try {\\n    // Bounds resolve the window first (AC-3.1 no-load-everything), then the\\n    // form read-back rides only that window (AC-2.1): each record carries its\\n    // stored derived forms, attached from one grouped query scoped to the\\n    // listed ids — never every message-owned form in a large thread.\\n    const records = readMessages(db, opts ?? {});\\n    const formsByMessage = readMessageForms(\\n      db,\\n      records.map((record) => record.messageId),\\n    );\\n    const withForms = records.map((record) => {\\n      const forms = formsByMessage.get(record.messageId);\\n      return forms === undefined ? record : { ...record, forms };\\n    });\\n    return { ok: true, value: withForms };\\n  } catch (cause) {\\n    const reason = cause instanceof Error ? cause.message : String(cause);\\n    return storageFailure(`message read-back failed: ${reason}`);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\n// The single-message view (Epic 04 AC-3.2): the canonical record — every\\n// block with complete content, full tool results, never the view-shortened\\n// forms — plus the message's derivation forms with their states and\\n// mechanically stamped metadata, joined from the owner's report read.\\nexport interface MessageDetail extends Omit<MessageRecord, \\\"forms\\\"> {\\n  // Always present and honest (AC-3.3): show on a deleted message returns\\n  // the record flagged — audit is the point — never a not-found.\\n  deleted: boolean;\\n  // The owner report's queue-joined entries (DD-2), never synthesized here:\\n  // the same `reportMessageForms` read messages.report serves, scoped by id.\\n  forms: FormReportEntry[];\\n}\\n\\n// Reads-only is structural (DD-6, SV-01-001), exactly as listMessages: the\\n// open announcement that would let a background scheduler hang a first-touch\\n// catch-up drain (and its provider call) off this show is suppressed for the\\n// whole operation. show on a deleted message stays the audit read; neither\\n// path touches the queue or the provider.\\nexport function show(\\n  thread: ThreadRef,\\n  messageId: string,\\n): Promise<OpResult<MessageDetail>> {\\n  return runWithThreadTouchSuppressed(() => showInner(thread, messageId));\\n}\\n\\nasync function showInner(\\n  thread: ThreadRef,\\n  messageId: string,\\n): Promise<OpResult<MessageDetail>> {\\n  const resolved = await resolveThreadRef(thread);\\n  if (!resolved.ok) return resolved;\\n  const { filePath } = resolved.value;\\n  if (!existsSync(filePath)) return threadNotFound(filePath);\\n\\n  const opened = openThreadDatabase(filePath);\\n  if (!opened.ok) return opened;\\n  const db = opened.value;\\n  try {\\n    const record = readMessageById(db, messageId);\\n    if (record === undefined) {\\n      return {\\n        ok: false,\\n        error: {\\n          errorClass: \\\"caller_error\\\",\\n          code: \\\"message_not_found\\\",\\n          reason: `no message ${messageId} exists in this thread`,\\n        },\\n      };\\n    }\\n    const forms = reportMessageForms(db, { messageId });\\n    return { ok: true, value: { ...record, forms } };\\n  } catch (cause) {\\n    const reason = cause instanceof Error ? cause.message : String(cause);\\n    return storageFailure(`message show failed: ${reason}`);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nexport async function listQueuedWork(\\n  thread: ThreadRef,\\n): Promise<OpResult<WorkItemRecord[]>> {\\n  const resolved = await resolveThreadRef(thread);\\n  if (!resolved.ok) return resolved;\\n  const { filePath } = resolved.value;\\n  if (!existsSync(filePath)) return threadNotFound(filePath);\\n\\n  const opened = openThreadDatabase(filePath);\\n  if (!opened.ok) return opened;\\n  const db = opened.value;\\n  try {\\n    return { ok: true, value: listItems(db, \\\"messages\\\") };\\n  } catch (cause) {\\n    const reason = cause instanceof Error ? cause.message : String(cause);\\n    return storageFailure(`queued-work read-back failed: ${reason}`);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\n// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\\n\\n// This owner's repair report: every message-owned form's durable state\\n// joined with live queue detail in one query — the five operational\\n// situations (waiting, retrying, ready, failed, blocked) read from the rows\\n// without any queue API. Needs no provider; reads degrade, never block.\\nexport async function report(\\n  thread: ThreadRef,\\n  opts?: { notReady?: boolean; messageId?: string },\\n): Promise<OpResult<FormReportEntry[]>> {\\n  const resolved = await resolveThreadRef(thread);\\n  if (!resolved.ok) return resolved;\\n  const { filePath } = resolved.value;\\n  if (!existsSync(filePath)) return threadNotFound(filePath);\\n\\n  const opened = openThreadDatabase(filePath);\\n  if (!opened.ok) return opened;\\n  const db = opened.value;\\n  try {\\n    return { ok: true, value: reportMessageForms(db, opts ?? {}) };\\n  } catch (cause) {\\n    const reason = cause instanceof Error ? cause.message : String(cause);\\n    return storageFailure(`report read failed: ${reason}`);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\nexport type RequeueOutcome = { workItemId: string } | { noop: \\\"already_queued\\\" };\\n\\n// Which work kind rebuilds each message-owned form — MESSAGE_WORK_FORMS\\n// inverted; the requeue's join from the named form back to its queue site.\\nconst MESSAGE_FORM_KINDS: Partial<Record<FormKind, WorkKind>> = {\\n  smoothed_prompt: \\\"prompt_smoothing\\\",\\n  tool_call_summary: \\\"tool_call_summary\\\",\\n  tool_result_summary: \\\"tool_result_summary\\\",\\n};\\n\\n// Explicit re-queue through the owning surface (AC-4.4): the public,\\n// supported rebuild act. Refused for blocked forms with the form's stored\\n// damage reason (AC-4.6) and for missing rows; a no-op against work already\\n// queued or in flight at the form's current source version (AC-4.5).\\n// Otherwise the form clears to pending and re-enqueues at the next source\\n// version — the same enqueue path intake uses, poke-on-commit included, so\\n// background mode processes the repair with no further call. The no-op check\\n// and the enqueue commit in one transaction (anti-shim: a split would\\n// reintroduce the duplicate-work race).\\nexport async function requeue(\\n  thread: ThreadRef,\\n  target: { messageId: string; form: FormKind },\\n): Promise<OpResult<RequeueOutcome>> {\\n  const kind = MESSAGE_FORM_KINDS[target.form];\\n  if (kind === undefined) {\\n    return {\\n      ok: false,\\n      error: {\\n        errorClass: \\\"caller_error\\\",\\n        code: \\\"message_not_found\\\",\\n        reason: `form ${target.form} is not message-owned; messages.requeue repairs smoothed_prompt, tool_call_summary, tool_result_summary`,\\n      },\\n    };\\n  }\\n  const resolved = await resolveThreadRef(thread);\\n  if (!resolved.ok) return resolved;\\n  const { filePath } = resolved.value;\\n  if (!existsSync(filePath)) return threadNotFound(filePath);\\n\\n  const opened = openThreadDatabase(filePath);\\n  if (!opened.ok) return opened;\\n  const db = opened.value;\\n  try {\\n    const meta = db\\n      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\\n      .get() as { thread_id: string } | undefined;\\n    const threadId = meta?.thread_id ?? \\\"\\\";\\n    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\\n      const row = readMessageFormRow(ctx.db, target.messageId, target.form);\\n      if (row === undefined) {\\n        return {\\n          ok: false,\\n          error: {\\n            errorClass: \\\"caller_error\\\",\\n            code: \\\"message_not_found\\\",\\n            reason: `no derived form ${target.form} exists for message ${target.messageId}`,\\n          },\\n        };\\n      }\\n      if (row.state === \\\"blocked\\\") {\\n        // The refusal carries the form's stored reason — the damage named at\\n        // blocking time, not a generic string (AC-4.6).\\n        return {\\n          ok: false,\\n          error: {\\n            errorClass: \\\"state_corruption\\\",\\n            code: \\\"source_damaged\\\",\\n            reason: row.reason ?? `form ${target.form} for message ${target.messageId} is blocked`,\\n          },\\n        };\\n      }\\n      const sourceRef = { messageId: target.messageId };\\n      if (hasLiveItem(ctx.db, kind, sourceRef, row.sourceVersion)) {\\n        return { ok: true, value: { noop: \\\"already_queued\\\" } };\\n      }\\n      const item = enqueue(ctx, {\\n        owner: \\\"messages\\\",\\n        kind,\\n        sourceRef,\\n        sourceVersion: row.sourceVersion + 1,\\n        forms: [{ subjectKind: \\\"message\\\", subjectId: target.messageId, form: target.form }],\\n      });\\n      return { ok: true, value: { workItemId: item.workItemId } };\\n    });\\n  } catch (cause) {\\n    const reason = cause instanceof Error ? cause.message : String(cause);\\n    return storageFailure(`requeue failed: ${reason}`);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\n// ── mutations (Epic 02 Story 5, Flow 5) ──────────────────────────\\n\\n// The mutation result contract (tech design §Interfaces): what changed in\\n// the record, which dependent forms cleared, which dropped (delete only),\\n// what replacement work queued, and which still-queued old items the cascade\\n// tidied away (issue 1). Shared by edit and the Story 6 deletes.\\nexport interface MutationResult {\\n  changed: { messageIds: string[]; turnIds: string[] };\\n  cleared: CascadeClear[];\\n  dropped: CascadeClear[];\\n  queued: Array<{ workItemId: string; kind: WorkKind }>;\\n  superseded: string[];\\n}\\n\\n// The record's first sanctioned mutation (AC-5.1–5.5): change a closed-turn\\n// message's content and blocks, re-stamp the token estimate, and walk the\\n// full dependent chain — clear to pending, supersede queued old work,\\n// enqueue replacements at the next source version — in one transaction.\\n// Synchronous and local by contract: everything above commits before this\\n// returns; the re-queued rebuilds run through the normal drain (background\\n// mode needs no further call — the enqueue pokes ride the commit). Events\\n// are never touched (projection-level mutation, DD-12), and no generated\\n// thread-view is either — visibility arrives at the next compact/rebuild.\\n// Refusals read through the deleted-filtered view and enforce the closed-turn\\n// target boundary: only a message in a closed turn is editable, so an\\n// open-turn *or* a turnless (no-membership) gap target is refused turn_open —\\n// the boundary's one stable code — a missing or deleted message is\\n// message_not_found, and a refusal changes nothing.\\nexport async function edit(\\n  thread: ThreadRef,\\n  input: { messageId: string; content: string },\\n): Promise<OpResult<MutationResult>> {\\n  const resolved = await resolveThreadRef(thread);\\n  if (!resolved.ok) return resolved;\\n  const { filePath } = resolved.value;\\n  if (!existsSync(filePath)) return threadNotFound(filePath);\\n\\n  const opened = openThreadDatabase(filePath);\\n  if (!opened.ok) return opened;\\n  const db = opened.value;\\n  try {\\n    const meta = db\\n      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\\n      .get() as { thread_id: string } | undefined;\\n    const threadId = meta?.thread_id ?? \\\"\\\";\\n    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\\n      const target = readMutableMessage(ctx.db, input.messageId);\\n      if (target === undefined) {\\n        return {\\n          ok: false,\\n          error: {\\n            errorClass: \\\"caller_error\\\",\\n            code: \\\"message_not_found\\\",\\n            reason: `no message ${input.messageId} exists in this thread`,\\n          },\\n        };\\n      }\\n      // The closed-turn target boundary (story scope; AC-5.1): the edit's\\n      // editable class is a message in a *closed* turn. Both failing cases —\\n      // an open turn and a turnless gap message (no membership) — refuse under\\n      // the one stable code; the reason distinguishes them so the open-turn\\n      // message reads exactly as before. A deleted/missing target never gets\\n      // here (it misses the filtered read above as message_not_found).\\n      if (target.turnStatus !== \\\"closed\\\") {\\n        return {\\n          ok: false,\\n          error: {\\n            errorClass: \\\"caller_error\\\",\\n            code: \\\"turn_open\\\",\\n            reason:\\n              target.turnStatus === \\\"open\\\"\\n                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \\\"\\\"}; open-turn messages cannot be edited (v1 boundary)`\\n                : `message ${input.messageId} has no turn membership; only closed-turn messages can be edited (v1 boundary)`,\\n          },\\n        };\\n      }\\n      applyMessageEdit(ctx.db, input.messageId, input.content);\\n      const cascade = cascadeFromMessage(ctx, input.messageId);\\n      return {\\n        ok: true,\\n        value: {\\n          changed: { messageIds: [input.messageId], turnIds: [] },\\n          cleared: cascade.cleared,\\n          dropped: cascade.dropped,\\n          queued: cascade.queued,\\n          superseded: cascade.superseded,\\n        },\\n      };\\n    });\\n  } catch (cause) {\\n    const reason = cause instanceof Error ? cause.message : String(cause);\\n    return storageFailure(`edit failed: ${reason}`);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\n// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\\n\\n// The record's removal mutation for one message (AC-6.1–6.3, 6.7):\\n// projection-level delete — the deleted_at stamp plus the delete cascade\\n// (own forms dropped, turn and chunk cleared and re-queued for minus-one\\n// composition) in one transaction. The source events are never touched;\\n// event read-back keeps returning them (the audit surface). Validation\\n// reads the same filtered view as edit, so a missing, deleted, or\\n// double-deleted target is message_not_found and an open-turn or turnless\\n// gap target is turn_open. The one delete-specific refusal is prompt\\n// protection: a turn is a prompt and what came back for it, so deleting the\\n// turn's initiating prompt is refused toward turns.deleteTurn — the error\\n// names the turn and that path (AC-6.3).\\nexport async function deleteMessage(\\n  thread: ThreadRef,\\n  input: { messageId: string },\\n): Promise<OpResult<MutationResult>> {\\n  const resolved = await resolveThreadRef(thread);\\n  if (!resolved.ok) return resolved;\\n  const { filePath } = resolved.value;\\n  if (!existsSync(filePath)) return threadNotFound(filePath);\\n\\n  const opened = openThreadDatabase(filePath);\\n  if (!opened.ok) return opened;\\n  const db = opened.value;\\n  try {\\n    const meta = db\\n      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\\n      .get() as { thread_id: string } | undefined;\\n    const threadId = meta?.thread_id ?? \\\"\\\";\\n    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\\n      const target = readMutableMessage(ctx.db, input.messageId);\\n      if (target === undefined) {\\n        return {\\n          ok: false,\\n          error: {\\n            errorClass: \\\"caller_error\\\",\\n            code: \\\"message_not_found\\\",\\n            reason: `no message ${input.messageId} exists in this thread`,\\n          },\\n        };\\n      }\\n      if (target.turnStatus !== \\\"closed\\\") {\\n        return {\\n          ok: false,\\n          error: {\\n            errorClass: \\\"caller_error\\\",\\n            code: \\\"turn_open\\\",\\n            reason:\\n              target.turnStatus === \\\"open\\\"\\n                ? `message ${input.messageId} belongs to open turn ${target.turnId ?? \\\"\\\"}; open-turn messages cannot be deleted (v1 boundary)`\\n                : `message ${input.messageId} has no turn membership; only closed-turn messages can be deleted (v1 boundary)`,\\n          },\\n        };\\n      }\\n      if (target.initiatesTurn) {\\n        return {\\n          ok: false,\\n          error: {\\n            errorClass: \\\"caller_error\\\",\\n            code: \\\"message_initiates_turn\\\",\\n            reason: `message ${input.messageId} is the prompt that initiates turn ${target.turnId ?? \\\"\\\"}; a turn is a prompt and what came back for it — delete the whole exchange with turns.deleteTurn (lhc turns delete --turn-id ${target.turnId ?? \\\"\\\"})`,\\n          },\\n        };\\n      }\\n      markMessageDeleted(ctx.db, input.messageId, ctx.clock().toISOString());\\n      const cascade = cascadeMessageDelete(ctx, input.messageId);\\n      return {\\n        ok: true,\\n        value: {\\n          changed: { messageIds: [input.messageId], turnIds: [] },\\n          cleared: cascade.cleared,\\n          dropped: cascade.dropped,\\n          queued: cascade.queued,\\n          superseded: cascade.superseded,\\n        },\\n      };\\n    });\\n  } catch (cause) {\\n    const reason = cause instanceof Error ? cause.message : String(cause);\\n    return storageFailure(`delete failed: ${reason}`);\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\n// Cross-domain surface for turns.deleteTurn (DD-8: one cascade module, two\\n// callers), called inside the turn delete's transaction after the turn row\\n// is stamped. The messages domain owns the message-table write — the member\\n// stamp, scoped to live rows — and the shared cascade entry; the turns\\n// operation owns its own validation and turn-row stamp. Returns the cascade\\n// outcome plus the member ids stamped now (record order), which the turn\\n// delete reports as its changed messages.\\nexport function applyTurnDeleteCascade(\\n  ctx: OperationContext,\\n  turnId: string,\\n): CascadeOutcome & { memberMessageIds: string[] } {\\n  const memberMessageIds = markTurnMessagesDeleted(\\n    ctx.db,\\n    turnId,\\n    ctx.clock().toISOString(),\\n  );\\n  return { ...cascadeTurnDelete(ctx, turnId, memberMessageIds), memberMessageIds };\\n}\\n\",\"numLines\":706,\"startLine\":1,\"totalLines\":706}}}\n38:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_0153AKLAk8Jr91Q1TN4XqjDM\",\"type\":\"tool_result\",\"content\":\"1\\t// Message and block row operations. Writes run on the caller's handle inside\\n2\\t// the batch transaction (insert failures propagate so the pipeline rejects\\n3\\t// the whole batch); reads run on a fresh handle per operation. The mutation\\n4\\t// half (Epic 02 Story 5) — the edit's validation read and content apply —\\n5\\t// also lives here: row-level mechanics, no policy.\\n6\\timport type { DatabaseSync } from \\\"node:sqlite\\\";\\n7\\timport { estimateTokens } from \\\"../../../tech-utils/token-counting/index.js\\\";\\n8\\timport type { Block, MessageRecord } from \\\"../index.js\\\";\\n9\\t\\n10\\texport interface MessageRow {\\n11\\t  messageId: string;\\n12\\t  sourceEventOrder: number;\\n13\\t  kind: MessageRecord[\\\"kind\\\"];\\n14\\t  tokenEstimate: number;\\n15\\t  actor: string;\\n16\\t  harness: string;\\n17\\t  // Membership stamp, settled at intake: the turn open after this event's\\n18\\t  // transition, or null in a gap. Written once here, never updated — a null\\n19\\t  // gap stamp stays null forever (AC-3.8), a closed turn's members never\\n20\\t  // change (AC-3.7).\\n21\\t  turnId: string | null;\\n22\\t  blocks: Block[];\\n23\\t}\\n24\\t\\n25\\texport function insertMessage(db: DatabaseSync, row: MessageRow): void {\\n26\\t  db.prepare(\\n27\\t    `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\\n28\\t     VALUES (?, ?, ?, ?, ?, ?, ?)`,\\n29\\t  ).run(\\n30\\t    row.messageId,\\n31\\t    row.sourceEventOrder,\\n32\\t    row.kind,\\n33\\t    row.tokenEstimate,\\n34\\t    row.actor,\\n35\\t    row.harness,\\n36\\t    row.turnId,\\n37\\t  );\\n38\\t\\n39\\t  const insertBlock = db.prepare(\\n40\\t    `INSERT INTO message_block (message_id, block_index, block_type, content)\\n41\\t     VALUES (?, ?, ?, ?)`,\\n42\\t  );\\n43\\t  for (const [index, block] of row.blocks.entries()) {\\n44\\t    insertBlock.run(row.messageId, index, block.blockType, JSON.stringify(block.content));\\n45\\t  }\\n46\\t}\\n47\\t\\n48\\t// The mutation operations' validation read (Flows 5/6): the live\\n49\\t// (deleted-filtered) message joined to its turn's status. A deleted target\\n50\\t// misses here and refuses as message_not_found — the filtered view is the\\n51\\t// refusal's read by design (never a distinct error for deleted; double\\n52\\t// delete reads the same way, AC-6.7). turnStatus is null for a gap message\\n53\\t// (no membership); the closed-turn target boundary refuses it the same as\\n54\\t// an open turn. initiatesTurn carries the prompt-protection fact (AC-6.3):\\n55\\t// a turn opens on its prompt's event, so the member whose source event\\n56\\t// order equals the turn's opened-at order is the turn's initiating prompt.\\n57\\texport interface MutableMessageView {\\n58\\t  messageId: string;\\n59\\t  kind: string;\\n60\\t  turnId: string | null;\\n61\\t  turnStatus: \\\"open\\\" | \\\"closed\\\" | null;\\n62\\t  initiatesTurn: boolean;\\n63\\t}\\n64\\t\\n65\\texport function readMutableMessage(\\n66\\t  db: DatabaseSync,\\n67\\t  messageId: string,\\n68\\t): MutableMessageView | undefined {\\n69\\t  const row = db\\n70\\t    .prepare(\\n71\\t      `SELECT m.message_id, m.kind, m.turn_id, m.source_event_order,\\n72\\t              t.status AS turn_status, t.opened_at_event_order\\n73\\t       FROM message m LEFT JOIN turns t ON t.turn_id = m.turn_id\\n74\\t       WHERE m.message_id = ? AND m.deleted_at IS NULL`,\\n75\\t    )\\n76\\t    .get(messageId) as unknown as\\n77\\t    | {\\n78\\t        message_id: string;\\n79\\t        kind: string;\\n80\\t        turn_id: string | null;\\n81\\t        source_event_order: number | bigint;\\n82\\t        turn_status: string | null;\\n83\\t        opened_at_event_order: number | bigint | null;\\n84\\t      }\\n85\\t    | undefined;\\n86\\t  if (row === undefined) return undefined;\\n87\\t  return {\\n88\\t    messageId: row.message_id,\\n89\\t    kind: row.kind,\\n90\\t    turnId: row.turn_id,\\n91\\t    turnStatus: row.turn_status as MutableMessageView[\\\"turnStatus\\\"],\\n92\\t    initiatesTurn:\\n93\\t      row.opened_at_event_order !== null &&\\n94\\t      Number(row.source_event_order) === Number(row.opened_at_event_order),\\n95\\t  };\\n96\\t}\\n97\\t\\n98\\t// The delete's record apply (Flow 6): a projection-level tombstone — the\\n99\\t// deleted_at stamp every read filters on. The source events are never\\n100\\t// touched (record-never-destroyed, DD-12); event read-back keeps showing\\n101\\t// them. The bulk variant is turns.deleteTurn's member stamp, scoped to live\\n102\\t// rows so a turn whose messages were individually deleted first still\\n103\\t// deletes cleanly (membership walk on live rows); it returns the stamped\\n104\\t// ids in record order for the mutation result and the cascade's drop set.\\n105\\texport function markMessageDeleted(\\n106\\t  db: DatabaseSync,\\n107\\t  messageId: string,\\n108\\t  deletedAt: string,\\n109\\t): void {\\n110\\t  db.prepare(`UPDATE message SET deleted_at = ? WHERE message_id = ?`).run(\\n111\\t    deletedAt,\\n112\\t    messageId,\\n113\\t  );\\n114\\t}\\n115\\t\\n116\\texport function markTurnMessagesDeleted(\\n117\\t  db: DatabaseSync,\\n118\\t  turnId: string,\\n119\\t  deletedAt: string,\\n120\\t): string[] {\\n121\\t  const rows = db\\n122\\t    .prepare(\\n123\\t      `UPDATE message SET deleted_at = ?\\n124\\t       WHERE turn_id = ? AND deleted_at IS NULL\\n125\\t       RETURNING message_id, source_event_order`,\\n126\\t    )\\n127\\t    .all(deletedAt, turnId) as unknown as Array<{\\n128\\t    message_id: string;\\n129\\t    source_event_order: number | bigint;\\n130\\t  }>;\\n131\\t  return rows\\n132\\t    .sort((a, b) => Number(a.source_event_order) - Number(b.source_event_order))\\n133\\t    .map((row) => row.message_id);\\n134\\t}\\n135\\t\\n136\\t// The edit's record apply (AC-5.1): the new content lands in each block's\\n137\\t// content-bearing field — the same field per block type the projection wrote\\n138\\t// and counted (internal/project.ts) — and the token estimate re-stamps from\\n139\\t// the same estimator, so placement arithmetic stays current after edits.\\n140\\t// Events are untouched: this is projection-level mutation; the log keeps the\\n141\\t// original (DD-12).\\n142\\texport function applyMessageEdit(db: DatabaseSync, messageId: string, content: string): void {\\n143\\t  const blocks = db\\n144\\t    .prepare(\\n145\\t      `SELECT block_index, block_type, content FROM message_block\\n146\\t       WHERE message_id = ? ORDER BY block_index`,\\n147\\t    )\\n148\\t    .all(messageId) as unknown as Array<{\\n149\\t    block_index: number | bigint;\\n150\\t    block_type: string;\\n151\\t    content: string;\\n152\\t  }>;\\n153\\t  const update = db.prepare(\\n154\\t    `UPDATE message_block SET content = ? WHERE message_id = ? AND block_index = ?`,\\n155\\t  );\\n156\\t  let tokenEstimate = estimateTokens(content);\\n157\\t  for (const block of blocks) {\\n158\\t    const parsed = JSON.parse(block.content) as Record<string, unknown>;\\n159\\t    switch (block.block_type) {\\n160\\t      case \\\"text\\\":\\n161\\t        parsed[\\\"text\\\"] = content;\\n162\\t        break;\\n163\\t      case \\\"tool_result\\\":\\n164\\t        parsed[\\\"content\\\"] = content;\\n165\\t        break;\\n166\\t      case \\\"tool_call\\\":\\n167\\t        // Arguments are the call's counted content; the edit's string lands\\n168\\t        // verbatim as the new arguments value, mirroring projection's\\n169\\t        // serialized-arguments estimate.\\n170\\t        parsed[\\\"arguments\\\"] = content;\\n171\\t        tokenEstimate = estimateTokens(JSON.stringify(content));\\n172\\t        break;\\n173\\t      default:\\n174\\t        throw new Error(`message ${messageId} carries unknown block type ${block.block_type}`);\\n175\\t    }\\n176\\t    update.run(JSON.stringify(parsed), messageId, Number(block.block_index));\\n177\\t  }\\n178\\t  db.prepare(`UPDATE message SET token_estimate = ? WHERE message_id = ?`).run(\\n179\\t    tokenEstimate,\\n180\\t    messageId,\\n181\\t  );\\n182\\t}\\n183\\t\\n184\\tinterface RawMessageRow {\\n185\\t  message_id: string;\\n186\\t  source_event_order: number | bigint;\\n187\\t  kind: string;\\n188\\t  token_estimate: number | bigint;\\n189\\t  actor: string;\\n190\\t  harness: string;\\n191\\t  turn_id: string | null;\\n192\\t  deleted_at: string | null;\\n193\\t}\\n194\\t\\n195\\tinterface RawBlockRow {\\n196\\t  message_id: string;\\n197\\t  block_type: string;\\n198\\t  content: string;\\n199\\t}\\n200\\t\\n201\\tfunction recordFromRow(row: RawMessageRow, blocks: Block[]): MessageRecord {\\n202\\t  const record: MessageRecord = {\\n203\\t    messageId: row.message_id,\\n204\\t    sourceEventOrder: Number(row.source_event_order),\\n205\\t    kind: row.kind as MessageRecord[\\\"kind\\\"],\\n206\\t    blocks,\\n207\\t    tokenEstimate: Number(row.token_estimate),\\n208\\t    actor: row.actor,\\n209\\t    harness: row.harness,\\n210\\t  };\\n211\\t  if (row.turn_id !== null) record.turnId = row.turn_id;\\n212\\t  // The deleted marker (Epic 04 AC-3.3): present only on deleted rows, which\\n213\\t  // only the includeDeleted read surfaces — never silently mixed in.\\n214\\t  if (row.deleted_at !== null) record.deleted = true;\\n215\\t  return record;\\n216\\t}\\n217\\t\\n218\\t// Bounds in source-event-order coordinates (Epic 04 DD-3): the coordinate\\n219\\t// the reports name, so drill-down uses what the operator already holds.\\n220\\t// limit caps the count after bounds. Defaults preserve every existing\\n221\\t// caller: visible messages, unbounded, record order.\\n222\\texport interface MessageReadOptions {\\n223\\t  from?: number;\\n224\\t  to?: number;\\n225\\t  limit?: number;\\n226\\t  includeDeleted?: boolean;\\n227\\t}\\n228\\t\\n229\\texport function readMessages(\\n230\\t  db: DatabaseSync,\\n231\\t  opts: MessageReadOptions = {},\\n232\\t): MessageRecord[] {\\n233\\t  // Bounds before content (AC-3.1 no-load-everything): the message query\\n234\\t  // carries the deleted filter, the source-order window, and the limit, so a\\n235\\t  // bounded list resolves its window from the message table first — never\\n236\\t  // reading a row, or (below) parsing a block, outside that window.\\n237\\t  //\\n238\\t  // The deleted-read filter (tech design §Mechanics): message reads surface\\n239\\t  // live projection rows only; a deleted message's source events stay\\n240\\t  // readable through the Epic 01 event read-back, the one unfiltered surface.\\n241\\t  // includeDeleted is the Epic 04 audit opt-in: deleted rows return flagged.\\n242\\t  const conditions: string[] = [];\\n243\\t  const params: number[] = [];\\n244\\t  if (opts.includeDeleted !== true) conditions.push(\\\"deleted_at IS NULL\\\");\\n245\\t  if (opts.from !== undefined) {\\n246\\t    conditions.push(\\\"source_event_order >= ?\\\");\\n247\\t    params.push(opts.from);\\n248\\t  }\\n249\\t  if (opts.to !== undefined) {\\n250\\t    conditions.push(\\\"source_event_order <= ?\\\");\\n251\\t    params.push(opts.to);\\n252\\t  }\\n253\\t  if (opts.limit !== undefined) params.push(opts.limit);\\n254\\t  const messageRows = db\\n255\\t    .prepare(\\n256\\t      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id, deleted_at\\n257\\t       FROM message${conditions.length > 0 ? ` WHERE ${conditions.join(\\\" AND \\\")}` : \\\"\\\"}\\n258\\t       ORDER BY source_event_order${opts.limit !== undefined ? \\\" LIMIT ?\\\" : \\\"\\\"}`,\\n259\\t    )\\n260\\t    .all(...params) as unknown as RawMessageRow[];\\n261\\t  if (messageRows.length === 0) return [];\\n262\\t\\n263\\t  // Block content only for the windowed messages — never the whole table:\\n264\\t  // an out-of-window block is never selected, so its content is never loaded\\n265\\t  // or parsed (the no-load-everything proof corrupts one to assert this).\\n266\\t  const ids = messageRows.map((row) => row.message_id);\\n267\\t  const blockRows = db\\n268\\t    .prepare(\\n269\\t      `SELECT message_id, block_type, content FROM message_block\\n270\\t       WHERE message_id IN (${ids.map(() => \\\"?\\\").join(\\\", \\\")})\\n271\\t       ORDER BY message_id, block_index`,\\n272\\t    )\\n273\\t    .all(...ids) as unknown as RawBlockRow[];\\n274\\t  const blocksByMessage = new Map<string, Block[]>();\\n275\\t  for (const row of blockRows) {\\n276\\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\\n277\\t    blocks.push({\\n278\\t      blockType: row.block_type as Block[\\\"blockType\\\"],\\n279\\t      content: JSON.parse(row.content) as Record<string, unknown>,\\n280\\t    });\\n281\\t    blocksByMessage.set(row.message_id, blocks);\\n282\\t  }\\n283\\t  return messageRows.map((row) =>\\n284\\t    recordFromRow(row, blocksByMessage.get(row.message_id) ?? []),\\n285\\t  );\\n286\\t}\\n287\\t\\n288\\t// The show operation's by-id read (Epic 04 Flow 3): the canonical record —\\n289\\t// full blocks verbatim, never view-shortened — with the deleted flag honest.\\n290\\t// Deliberately unfiltered on deleted_at: show on a deleted message is the\\n291\\t// audit read (AC-3.3), never a not-found.\\n292\\texport function readMessageById(\\n293\\t  db: DatabaseSync,\\n294\\t  messageId: string,\\n295\\t): (MessageRecord & { deleted: boolean }) | undefined {\\n296\\t  const row = db\\n297\\t    .prepare(\\n298\\t      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id, deleted_at\\n299\\t       FROM message WHERE message_id = ?`,\\n300\\t    )\\n301\\t    .get(messageId) as unknown as RawMessageRow | undefined;\\n302\\t  if (row === undefined) return undefined;\\n303\\t  const blockRows = db\\n304\\t    .prepare(\\n305\\t      `SELECT message_id, block_type, content FROM message_block\\n306\\t       WHERE message_id = ? ORDER BY block_index`,\\n307\\t    )\\n308\\t    .all(messageId) as unknown as RawBlockRow[];\\n309\\t  const blocks = blockRows.map((block) => ({\\n310\\t    blockType: block.block_type as Block[\\\"blockType\\\"],\\n311\\t    content: JSON.parse(block.content) as Record<string, unknown>,\\n312\\t  }));\\n313\\t  return { ...recordFromRow(row, blocks), deleted: row.deleted_at !== null };\\n314\\t}\\n315\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"uuid\":\"a4ad2bee-8234-4fc3-8eae-738a2d197276\",\"timestamp\":\"2026-06-12T13:24:05.684Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/store.ts\",\"content\":\"// Message and block row operations. Writes run on the caller's handle inside\\n// the batch transaction (insert failures propagate so the pipeline rejects\\n// the whole batch); reads run on a fresh handle per operation. The mutation\\n// half (Epic 02 Story 5) — the edit's validation read and content apply —\\n// also lives here: row-level mechanics, no policy.\\nimport type { DatabaseSync } from \\\"node:sqlite\\\";\\nimport { estimateTokens } from \\\"../../../tech-utils/token-counting/index.js\\\";\\nimport type { Block, MessageRecord } from \\\"../index.js\\\";\\n\\nexport interface MessageRow {\\n  messageId: string;\\n  sourceEventOrder: number;\\n  kind: MessageRecord[\\\"kind\\\"];\\n  tokenEstimate: number;\\n  actor: string;\\n  harness: string;\\n  // Membership stamp, settled at intake: the turn open after this event's\\n  // transition, or null in a gap. Written once here, never updated — a null\\n  // gap stamp stays null forever (AC-3.8), a closed turn's members never\\n  // change (AC-3.7).\\n  turnId: string | null;\\n  blocks: Block[];\\n}\\n\\nexport function insertMessage(db: DatabaseSync, row: MessageRow): void {\\n  db.prepare(\\n    `INSERT INTO message (message_id, source_event_order, kind, token_estimate, actor, harness, turn_id)\\n     VALUES (?, ?, ?, ?, ?, ?, ?)`,\\n  ).run(\\n    row.messageId,\\n    row.sourceEventOrder,\\n    row.kind,\\n    row.tokenEstimate,\\n    row.actor,\\n    row.harness,\\n    row.turnId,\\n  );\\n\\n  const insertBlock = db.prepare(\\n    `INSERT INTO message_block (message_id, block_index, block_type, content)\\n     VALUES (?, ?, ?, ?)`,\\n  );\\n  for (const [index, block] of row.blocks.entries()) {\\n    insertBlock.run(row.messageId, index, block.blockType, JSON.stringify(block.content));\\n  }\\n}\\n\\n// The mutation operations' validation read (Flows 5/6): the live\\n// (deleted-filtered) message joined to its turn's status. A deleted target\\n// misses here and refuses as message_not_found — the filtered view is the\\n// refusal's read by design (never a distinct error for deleted; double\\n// delete reads the same way, AC-6.7). turnStatus is null for a gap message\\n// (no membership); the closed-turn target boundary refuses it the same as\\n// an open turn. initiatesTurn carries the prompt-protection fact (AC-6.3):\\n// a turn opens on its prompt's event, so the member whose source event\\n// order equals the turn's opened-at order is the turn's initiating prompt.\\nexport interface MutableMessageView {\\n  messageId: string;\\n  kind: string;\\n  turnId: string | null;\\n  turnStatus: \\\"open\\\" | \\\"closed\\\" | null;\\n  initiatesTurn: boolean;\\n}\\n\\nexport function readMutableMessage(\\n  db: DatabaseSync,\\n  messageId: string,\\n): MutableMessageView | undefined {\\n  const row = db\\n    .prepare(\\n      `SELECT m.message_id, m.kind, m.turn_id, m.source_event_order,\\n              t.status AS turn_status, t.opened_at_event_order\\n       FROM message m LEFT JOIN turns t ON t.turn_id = m.turn_id\\n       WHERE m.message_id = ? AND m.deleted_at IS NULL`,\\n    )\\n    .get(messageId) as unknown as\\n    | {\\n        message_id: string;\\n        kind: string;\\n        turn_id: string | null;\\n        source_event_order: number | bigint;\\n        turn_status: string | null;\\n        opened_at_event_order: number | bigint | null;\\n      }\\n    | undefined;\\n  if (row === undefined) return undefined;\\n  return {\\n    messageId: row.message_id,\\n    kind: row.kind,\\n    turnId: row.turn_id,\\n    turnStatus: row.turn_status as MutableMessageView[\\\"turnStatus\\\"],\\n    initiatesTurn:\\n      row.opened_at_event_order !== null &&\\n      Number(row.source_event_order) === Number(row.opened_at_event_order),\\n  };\\n}\\n\\n// The delete's record apply (Flow 6): a projection-level tombstone — the\\n// deleted_at stamp every read filters on. The source events are never\\n// touched (record-never-destroyed, DD-12); event read-back keeps showing\\n// them. The bulk variant is turns.deleteTurn's member stamp, scoped to live\\n// rows so a turn whose messages were individually deleted first still\\n// deletes cleanly (membership walk on live rows); it returns the stamped\\n// ids in record order for the mutation result and the cascade's drop set.\\nexport function markMessageDeleted(\\n  db: DatabaseSync,\\n  messageId: string,\\n  deletedAt: string,\\n): void {\\n  db.prepare(`UPDATE message SET deleted_at = ? WHERE message_id = ?`).run(\\n    deletedAt,\\n    messageId,\\n  );\\n}\\n\\nexport function markTurnMessagesDeleted(\\n  db: DatabaseSync,\\n  turnId: string,\\n  deletedAt: string,\\n): string[] {\\n  const rows = db\\n    .prepare(\\n      `UPDATE message SET deleted_at = ?\\n       WHERE turn_id = ? AND deleted_at IS NULL\\n       RETURNING message_id, source_event_order`,\\n    )\\n    .all(deletedAt, turnId) as unknown as Array<{\\n    message_id: string;\\n    source_event_order: number | bigint;\\n  }>;\\n  return rows\\n    .sort((a, b) => Number(a.source_event_order) - Number(b.source_event_order))\\n    .map((row) => row.message_id);\\n}\\n\\n// The edit's record apply (AC-5.1): the new content lands in each block's\\n// content-bearing field — the same field per block type the projection wrote\\n// and counted (internal/project.ts) — and the token estimate re-stamps from\\n// the same estimator, so placement arithmetic stays current after edits.\\n// Events are untouched: this is projection-level mutation; the log keeps the\\n// original (DD-12).\\nexport function applyMessageEdit(db: DatabaseSync, messageId: string, content: string): void {\\n  const blocks = db\\n    .prepare(\\n      `SELECT block_index, block_type, content FROM message_block\\n       WHERE message_id = ? ORDER BY block_index`,\\n    )\\n    .all(messageId) as unknown as Array<{\\n    block_index: number | bigint;\\n    block_type: string;\\n    content: string;\\n  }>;\\n  const update = db.prepare(\\n    `UPDATE message_block SET content = ? WHERE message_id = ? AND block_index = ?`,\\n  );\\n  let tokenEstimate = estimateTokens(content);\\n  for (const block of blocks) {\\n    const parsed = JSON.parse(block.content) as Record<string, unknown>;\\n    switch (block.block_type) {\\n      case \\\"text\\\":\\n        parsed[\\\"text\\\"] = content;\\n        break;\\n      case \\\"tool_result\\\":\\n        parsed[\\\"content\\\"] = content;\\n        break;\\n      case \\\"tool_call\\\":\\n        // Arguments are the call's counted content; the edit's string lands\\n        // verbatim as the new arguments value, mirroring projection's\\n        // serialized-arguments estimate.\\n        parsed[\\\"arguments\\\"] = content;\\n        tokenEstimate = estimateTokens(JSON.stringify(content));\\n        break;\\n      default:\\n        throw new Error(`message ${messageId} carries unknown block type ${block.block_type}`);\\n    }\\n    update.run(JSON.stringify(parsed), messageId, Number(block.block_index));\\n  }\\n  db.prepare(`UPDATE message SET token_estimate = ? WHERE message_id = ?`).run(\\n    tokenEstimate,\\n    messageId,\\n  );\\n}\\n\\ninterface RawMessageRow {\\n  message_id: string;\\n  source_event_order: number | bigint;\\n  kind: string;\\n  token_estimate: number | bigint;\\n  actor: string;\\n  harness: string;\\n  turn_id: string | null;\\n  deleted_at: string | null;\\n}\\n\\ninterface RawBlockRow {\\n  message_id: string;\\n  block_type: string;\\n  content: string;\\n}\\n\\nfunction recordFromRow(row: RawMessageRow, blocks: Block[]): MessageRecord {\\n  const record: MessageRecord = {\\n    messageId: row.message_id,\\n    sourceEventOrder: Number(row.source_event_order),\\n    kind: row.kind as MessageRecord[\\\"kind\\\"],\\n    blocks,\\n    tokenEstimate: Number(row.token_estimate),\\n    actor: row.actor,\\n    harness: row.harness,\\n  };\\n  if (row.turn_id !== null) record.turnId = row.turn_id;\\n  // The deleted marker (Epic 04 AC-3.3): present only on deleted rows, which\\n  // only the includeDeleted read surfaces — never silently mixed in.\\n  if (row.deleted_at !== null) record.deleted = true;\\n  return record;\\n}\\n\\n// Bounds in source-event-order coordinates (Epic 04 DD-3): the coordinate\\n// the reports name, so drill-down uses what the operator already holds.\\n// limit caps the count after bounds. Defaults preserve every existing\\n// caller: visible messages, unbounded, record order.\\nexport interface MessageReadOptions {\\n  from?: number;\\n  to?: number;\\n  limit?: number;\\n  includeDeleted?: boolean;\\n}\\n\\nexport function readMessages(\\n  db: DatabaseSync,\\n  opts: MessageReadOptions = {},\\n): MessageRecord[] {\\n  // Bounds before content (AC-3.1 no-load-everything): the message query\\n  // carries the deleted filter, the source-order window, and the limit, so a\\n  // bounded list resolves its window from the message table first — never\\n  // reading a row, or (below) parsing a block, outside that window.\\n  //\\n  // The deleted-read filter (tech design §Mechanics): message reads surface\\n  // live projection rows only; a deleted message's source events stay\\n  // readable through the Epic 01 event read-back, the one unfiltered surface.\\n  // includeDeleted is the Epic 04 audit opt-in: deleted rows return flagged.\\n  const conditions: string[] = [];\\n  const params: number[] = [];\\n  if (opts.includeDeleted !== true) conditions.push(\\\"deleted_at IS NULL\\\");\\n  if (opts.from !== undefined) {\\n    conditions.push(\\\"source_event_order >= ?\\\");\\n    params.push(opts.from);\\n  }\\n  if (opts.to !== undefined) {\\n    conditions.push(\\\"source_event_order <= ?\\\");\\n    params.push(opts.to);\\n  }\\n  if (opts.limit !== undefined) params.push(opts.limit);\\n  const messageRows = db\\n    .prepare(\\n      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id, deleted_at\\n       FROM message${conditions.length > 0 ? ` WHERE ${conditions.join(\\\" AND \\\")}` : \\\"\\\"}\\n       ORDER BY source_event_order${opts.limit !== undefined ? \\\" LIMIT ?\\\" : \\\"\\\"}`,\\n    )\\n    .all(...params) as unknown as RawMessageRow[];\\n  if (messageRows.length === 0) return [];\\n\\n  // Block content only for the windowed messages — never the whole table:\\n  // an out-of-window block is never selected, so its content is never loaded\\n  // or parsed (the no-load-everything proof corrupts one to assert this).\\n  const ids = messageRows.map((row) => row.message_id);\\n  const blockRows = db\\n    .prepare(\\n      `SELECT message_id, block_type, content FROM message_block\\n       WHERE message_id IN (${ids.map(() => \\\"?\\\").join(\\\", \\\")})\\n       ORDER BY message_id, block_index`,\\n    )\\n    .all(...ids) as unknown as RawBlockRow[];\\n  const blocksByMessage = new Map<string, Block[]>();\\n  for (const row of blockRows) {\\n    const blocks = blocksByMessage.get(row.message_id) ?? [];\\n    blocks.push({\\n      blockType: row.block_type as Block[\\\"blockType\\\"],\\n      content: JSON.parse(row.content) as Record<string, unknown>,\\n    });\\n    blocksByMessage.set(row.message_id, blocks);\\n  }\\n  return messageRows.map((row) =>\\n    recordFromRow(row, blocksByMessage.get(row.message_id) ?? []),\\n  );\\n}\\n\\n// The show operation's by-id read (Epic 04 Flow 3): the canonical record —\\n// full blocks verbatim, never view-shortened — with the deleted flag honest.\\n// Deliberately unfiltered on deleted_at: show on a deleted message is the\\n// audit read (AC-3.3), never a not-found.\\nexport function readMessageById(\\n  db: DatabaseSync,\\n  messageId: string,\\n): (MessageRecord & { deleted: boolean }) | undefined {\\n  const row = db\\n    .prepare(\\n      `SELECT message_id, source_event_order, kind, token_estimate, actor, harness, turn_id, deleted_at\\n       FROM message WHERE message_id = ?`,\\n    )\\n    .get(messageId) as unknown as RawMessageRow | undefined;\\n  if (row === undefined) return undefined;\\n  const blockRows = db\\n    .prepare(\\n      `SELECT message_id, block_type, content FROM message_block\\n       WHERE message_id = ? ORDER BY block_index`,\\n    )\\n    .all(messageId) as unknown as RawBlockRow[];\\n  const blocks = blockRows.map((block) => ({\\n    blockType: block.block_type as Block[\\\"blockType\\\"],\\n    content: JSON.parse(block.content) as Record<string, unknown>,\\n  }));\\n  return { ...recordFromRow(row, blocks), deleted: row.deleted_at !== null };\\n}\\n\",\"numLines\":315,\"startLine\":1,\"totalLines\":315}}}\n45:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HcjhKF6RCRd25rNdzzDpoP\",\"type\":\"tool_result\",\"content\":\"1\\t// `lhc messages list` and `lhc messages show` (Epic 04 Story 1) per tech\\n2\\t// design §Placement: the message read command surface, mirroring the SDK\\n3\\t// operations one-for-one (AC-3.4). Thin argv-to-SDK wrappers — semantic\\n4\\t// option validation (from > to, limit < 1) stays in the SDK so the CLI's\\n5\\t// result JSON deep-equals the in-process result, refusals included.\\n6\\timport * as messages from \\\"../domains/messages/index.js\\\";\\n7\\timport type { MessageListOptions } from \\\"../domains/messages/index.js\\\";\\n8\\timport type { ThreadRef } from \\\"../domains/threads/index.js\\\";\\n9\\timport { renderResult, type CliResult } from \\\"./render.js\\\";\\n10\\t\\n11\\texport async function runMessagesList(\\n12\\t  threadRef: ThreadRef,\\n13\\t  opts: MessageListOptions,\\n14\\t): Promise<CliResult> {\\n15\\t  return renderResult(await messages.listMessages(threadRef, opts));\\n16\\t}\\n17\\t\\n18\\texport async function runMessagesShow(\\n19\\t  threadRef: ThreadRef,\\n20\\t  flags: { messageId: string },\\n21\\t): Promise<CliResult> {\\n22\\t  return renderResult(await messages.show(threadRef, flags.messageId));\\n23\\t}\\n24\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"uuid\":\"a2e5da6f-9c04-4be0-a538-b7b3d5717559\",\"timestamp\":\"2026-06-12T13:24:06.094Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/cli/messages-read.ts\",\"content\":\"// `lhc messages list` and `lhc messages show` (Epic 04 Story 1) per tech\\n// design §Placement: the message read command surface, mirroring the SDK\\n// operations one-for-one (AC-3.4). Thin argv-to-SDK wrappers — semantic\\n// option validation (from > to, limit < 1) stays in the SDK so the CLI's\\n// result JSON deep-equals the in-process result, refusals included.\\nimport * as messages from \\\"../domains/messages/index.js\\\";\\nimport type { MessageListOptions } from \\\"../domains/messages/index.js\\\";\\nimport type { ThreadRef } from \\\"../domains/threads/index.js\\\";\\nimport { renderResult, type CliResult } from \\\"./render.js\\\";\\n\\nexport async function runMessagesList(\\n  threadRef: ThreadRef,\\n  opts: MessageListOptions,\\n): Promise<CliResult> {\\n  return renderResult(await messages.listMessages(threadRef, opts));\\n}\\n\\nexport async function runMessagesShow(\\n  threadRef: ThreadRef,\\n  flags: { messageId: string },\\n): Promise<CliResult> {\\n  return renderResult(await messages.show(threadRef, flags.messageId));\\n}\\n\",\"numLines\":24,\"startLine\":1,\"totalLines\":24}}}\n79:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01TMffwe179aH5Ztt9Atn2Nu\",\"type\":\"tool_result\",\"content\":\"1\\t# Epic 04: Inspection — Tech Design\\n2\\t\\n3\\t**Epic:** `epic.md` (23 ACs / 17 TCs) · **Tech arch:** `../01-tech-arch.md` · **Test plan:** `test-plan.md`\\n4\\t**Inherits:** Epic 01–03 technical world — storage/transaction rules, error model, `OpResult`, verification tiers, process-suite accounting, CLI conventions. Nothing re-stated here that those designs pin; this document covers what Epic 04 adds.\\n5\\t\\n6\\t## Context\\n7\\t\\n8\\tThe last epic of the v1 PRD, and the smallest: no migration, no new tables, no derivations, no provider use, no new algorithms. Four read surfaces and a lifecycle exercise. The design problem is not mechanism — it is *composition discipline*: every report assembles other domains' surfaces without touching their tables, and where a report describes another surface's output (`loadCost` vs `pull`), the design makes agreement structural rather than tested-into-existence (the materialize parity-by-construction pattern, reused).\\n9\\t\\n10\\tThe second design problem is the dependency posture: this epic consumes Epic 03's surfaces, which finished building days before this design. The epic's handoff gate requires the deviation check below.\\n11\\t\\n12\\t## Spec Validation\\n13\\t\\n14\\tDesigned from the epic; issues found and resolved during design:\\n15\\t\\n16\\t| # | Issue | Resolution | Status |\\n17\\t|---|-------|-----------|--------|\\n18\\t| 1 | **Handoff gate (epic Assumptions):** Epic 02/03 final deviation tables vs the contracts this epic consumes | Reviewed all recorded deviations (Epic 02 impl log; Epic 03 impl log: `ViewProfileOverride[]` config typing, `view_boundary` strftime seed, `ViewCompactParams` nested partial, additive error codes, sweep-absent literal superseded by Story 3). None alter consumed shapes: `ViewStatus`, `PullResult`, `thread_view`/`thread_view_band`/`view_boundary` DDL, `messages.report`/`turns.report`, `FormReportEntry`, `MessageRecord.forms` all match spec as built. One *favorable* drift: Epic 02's AC-4.7 ruling attached `forms` to message reads (built for this consumer), so Flow 3's join is thinner than the epic assumed | Gate PASSED — recorded here |\\n19\\t| 2 | AC-1.1 needs counts (events, messages by kind, tokens) that no surface exposes as counts; inspect may not read tables directly; epic sanctions only one surface addition (`describe`) | Overview composes *list* reads (`listEvents`, `listMessages`, `listTurns`, `listChunks`) and counts in inspect. Cost is linear in thread size — acceptable at v1 scale (NFR allows thread-proportional reads). Count-only surface ops are a deferred optimization, not a v1 need | Resolved — composition, no new surfaces |\\n20\\t| 3 | Epic Data Contracts leave list-option names to tech design | Pinned: `{ from?, to?, limit?, includeDeleted? }` — `from`/`to` are source-event-order bounds (reports name `sourceEventOrder`, so drill-down uses the coordinate the operator already holds), `limit` caps count after bounds | Resolved — DD-3 |\\n21\\t| 4 | AC-2.3 equality (`loadCost` totals what pull serves) could be a fragile re-implementation of pull's costing | `inspect.view` *invokes* `threadView.pull` through the surface and measures its output — parity by construction; the TC's independent leg runs a second pull in the test and re-measures. Same pattern as Epic 03's materialize | Resolved — DD-4 |\\n22\\t| 5 | TC-5.x suite placement left open by epic (TD question 5) | TC-5.1–5.3 default suite (in-process, deterministic, fast); TC-5.4 process suite (spawned CLI). The epic's lean (\\\"TC-5.1 likely default\\\") extended after checking runtimes: replay + teardown legs spawn nothing | Resolved — DD-8 |\\n23\\t\\n24\\t## System View\\n25\\t\\n26\\t```\\n27\\t                    ┌─────────────── inspect (NEW) ───────────────┐\\n28\\t                    │  overview()      view()       health()      │\\n29\\t                    └───┬─────┬─────────┬──┬───────────┬──────────┘\\n30\\t                        │     │         │  │           │\\n31\\t        ┌───────────────┘     │         │  └───────┐   └────────┐\\n32\\t        ▼                     ▼         ▼          ▼            ▼\\n33\\t   threads.resolve      intake-stream  thread-view  messages.report\\n34\\t   listThreads          .listEvents    .describe(NEW) turns.report\\n35\\t                                       .pull        .listQueuedWork\\n36\\t                        messages.listMessages(+opts)\\n37\\t                        messages.show (NEW)          turns.listTurns/listChunks\\n38\\t```\\n39\\t\\n40\\t`inspect` sits at the top of the domain graph: pure consumer, imports five surfaces, nothing imports it except `sdk.ts` and `cli/`. No cycles — unlike Epic 03's sanctioned intake→thread-view cycle, this addition is acyclic by construction. `check-boundaries` gains the domain with no exception entries.\\n41\\t\\n42\\t### External Contracts (consumed, as built)\\n43\\t\\n44\\t| Contract | Source | Used by |\\n45\\t|----------|--------|---------|\\n46\\t| `listEvents` → ordered `EventRecord[]` | intake-stream (E01) | overview (count, span) |\\n47\\t| `listMessages` → `MessageRecord[]` with `forms?` attached | messages (E01 + E02 AC-4.7) | overview, list/show |\\n48\\t| `report(ref, {messageId?})` → `FormReportEntry[]` (queue join) | messages/turns (E02) | health, show |\\n49\\t| `listTurns` / `listChunks` / `listQueuedWork` | turns (E01/E02) | overview, health |\\n50\\t| `status` → `ViewStatus` | thread-view (E03) | overview (visibility, derivation counts) |\\n51\\t| `pull` → `PullResult` | thread-view (E03) | view (loadCost by construction) |\\n52\\t| `thread_view` row + bands (storage, in-domain) | thread-view (E03) | `describe` only |\\n53\\t\\n54\\t## Module Boundaries\\n55\\t\\n56\\t### Placement\\n57\\t\\n58\\t```\\n59\\tsrc/\\n60\\t  domains/\\n61\\t    inspect/\\n62\\t      index.ts          ← NEW surface: overview, view, health\\n63\\t      internal/\\n64\\t        overview.ts     ← compose counts from list reads\\n65\\t        view-report.ts  ← describe + pull → ViewContentsReport\\n66\\t        health.ts       ← report joins → HealthReport\\n67\\t    thread-view/\\n68\\t      index.ts          ← gains describe() (read-only, ~30 lines)\\n69\\t    messages/\\n70\\t      index.ts          ← listMessages gains opts; gains show()\\n71\\t  shared/\\n72\\t    inspect.ts          ← NEW: InspectOverview, ViewContentsReport, HealthReport shapes\\n73\\t  cli/\\n74\\t    inspect.ts          ← NEW: lhc inspect overview|view|health\\n75\\t    messages-read.ts    ← NEW: lhc messages list|show (mutations stay in messages-mutate.ts)\\n76\\t  sdk.ts                ← gains inspect namespace; threadView.describe; messages.show/list opts\\n77\\t```\\n78\\t\\n79\\t### Module Responsibility Matrix\\n80\\t\\n81\\t| Module | Owns | Must NOT own |\\n82\\t|--------|------|--------------|\\n83\\t| `inspect/index.ts` + internal | Report assembly, counting, shaping | Any table read, any write, any provider call, any derivation interpretation beyond the owners' reported states |\\n84\\t| `thread-view/describe` | Exposing stored view row (arrangement, gaps, config, source state) | Recomputing anything; mutating; reading the record |\\n85\\t| `messages/show` | Single-record read (full blocks) + `report(messageId)` composition | View-form shortening (show returns the record — full tool results, never boundary-shortened) |\\n86\\t| `messages/listMessages` opts | Bounds, limit, deleted filter | Default-including deleted (audit is opt-in) |\\n87\\t| `cli/inspect.ts`, `cli/messages-read.ts` | argv → SDK → JSON stdout | Any logic beyond arg mapping (CLI parity is structural: same code path as SDK) |\\n88\\t\\n89\\tDesign decisions:\\n90\\t\\n91\\t- **DD-1 (describe placement):** `describe` lives in thread-view because the stored view row is thread-view's table; inspect consuming it through the surface keeps the must-not-own rule airtight. Absent view → `ok` with `null`, mirroring `status`'s never-compacted behavior.\\n92\\t- **DD-2 (show composes report):** `show` = internal single-message read (same store read as `listMessages`, by id, full blocks) + `messages.report(ref, {messageId})` for the queue-joined forms. No new join machinery; `FormReportEntry` is the forms shape `show` returns.\\n93\\t- **DD-3 (list options):** `{ from?, to?, limit?, includeDeleted? }`, bounds in source event order. Existing callers unaffected (opts optional, default behavior unchanged: all visible messages).\\n94\\t- **DD-4 (loadCost by construction):** `view-report.ts` calls `describe` (stored bands: entries, gaps, config, stored token counts) and `pull` (served messages). `loadCost.bandTokens` = sum of stored band counts; `loadCost.tailTokens` = estimator over pull's tail messages (band-absent entries); `total` = sum. Pull is the single costing authority for the tail — AC-2.2's boundary-aware shortening is inherited, not re-implemented.\\n95\\t- **DD-5 (overview's view section):** composed from `status` (boundary, zone, derivation counts, view health) + `describe` (viewId, createdAt, compactPoint, coveredFrom) — both already exist; overview adds no view logic.\\n96\\t- **DD-6 (read-only, structurally tested):** the architecture-risk test snapshots observable state (work-item rows via `listQueuedWork`/reports, boundary position via `status`, view identity via `describe`, event/message counts) before and after every inspect/describe/show/list call and asserts deep equality. Read-only is asserted as absence-of-delta, not absence-of-write-code.\\n97\\t- **DD-7 (no migration):** schema terminal at v6. The one index temptation (message kind counts) is declined — counts come from list reads (Spec Validation #2); if profiling ever demands an index, that is a v7 proposal.\\n98\\t- **DD-8 (suite placement):** TC-5.1–5.3 default suite; TC-5.4 process suite. The lifecycle script is a shared fixture helper (`test/fixtures/lifecycle.ts`) both suites drive, so the spawned leg replays the same sequence rather than a re-described one.\\n99\\t\\n100\\t## Storage\\n101\\t\\n102\\tNone. No tables, no migration, no new indexes (DD-7). The only storage *read* this epic adds is `describe`'s in-domain read of `thread_view` / `thread_view_band` / `view_boundary`, all Epic 03 tables.\\n103\\t\\n104\\t## Flow-by-Flow Design\\n105\\t\\n106\\t### Flow 1: Overview\\n107\\t\\n108\\t`overview(ref)`: resolve thread (registry metadata) → `listEvents` (count, first/last order) → `listMessages({includeDeleted: true})` (visible/deleted split, kind counts, visible token sum — deleted detected per the read contract's flag) → `listTurns` (open/closed counts) → `listChunks` (count; unchunked = closed turns minus chunk-member turns) → `status` + `describe` (derivation counts, visibility, view summary). Each piece independent; fresh-empty, mid-first-turn, never-compacted-with-record, compacted, and mid-rebuild shapes fall out of the same composition path: absent pieces are zeros/nulls; no shape-specific branch is allowed except normalizing null sections.\\n109\\t\\n110\\tWorked example (compacted fixture, abridged):\\n111\\t\\n112\\t```json\\n113\\t{\\n114\\t  \\\"thread\\\": { \\\"id\\\": \\\"th_…\\\", \\\"createdAt\\\": \\\"…\\\" },\\n115\\t  \\\"events\\\": { \\\"count\\\": 412, \\\"span\\\": { \\\"first\\\": 1, \\\"last\\\": 412 } },\\n116\\t  \\\"messages\\\": { \\\"visible\\\": 187, \\\"byKind\\\": { \\\"user_prompt\\\": 14, \\\"assistant_text\\\": 41, \\\"tool_call\\\": 66, \\\"tool_result\\\": 64, \\\"assistant_thinking\\\": 2 }, \\\"deleted\\\": 2, \\\"visibleTokens\\\": 96342 },\\n117\\t  \\\"turns\\\": { \\\"open\\\": 0, \\\"closed\\\": 14 },\\n118\\t  \\\"chunks\\\": { \\\"count\\\": 4, \\\"unchunkedTurns\\\": 2 },\\n119\\t  \\\"derivation\\\": { \\\"ready\\\": 118, \\\"pending\\\": 3, \\\"retrying\\\": 1, \\\"failed\\\": 2, \\\"blocked\\\": 0 },\\n120\\t  \\\"view\\\": { \\\"viewId\\\": \\\"v391\\\", \\\"createdAt\\\": \\\"…\\\", \\\"compactPoint\\\": 391, \\\"coveredFrom\\\": 12 },\\n121\\t  \\\"visibility\\\": { \\\"boundaryPosition\\\": 398, \\\"zoneTokens\\\": 18204 }\\n122\\t}\\n123\\t```\\n124\\t\\n125\\t### Flow 2: View Contents Report\\n126\\t\\n127\\t```\\n128\\tinspect.view ──► threadView.describe ──► stored arrangement/gaps/config/band tokens/source state\\n129\\t      │\\n130\\t      └────────► threadView.pull ──► served messages\\n131\\t                      │\\n132\\t                      ├─ band entries → cross-check count only (arrangement is describe's)\\n133\\t                      └─ tail entries → estimator → tailTokens (as served: short forms short)\\n134\\tloadCost = { bandTokens: Σ stored, tailTokens: measured, total: sum }\\n135\\t```\\n136\\t\\n137\\tNever-compacted: `describe` → null ⇒ `meta: null`, bands empty, whole pull output is tail, parity contract unchanged (AC-2.4). The report never recomputes selection, rendering, or boundary state — stored snapshot + live pull are the only sources (AC-2.1's \\\"not recomputed\\\" is structural).\\n138\\t\\n139\\t### Flow 3: Message Listing and Show\\n140\\t\\n141\\t`listMessages(ref, opts)`: existing read + WHERE bounds on `source_event_order`, LIMIT, deleted filter (default excluded; `includeDeleted` includes flagged). `show(ref, messageId)`: by-id read, full blocks verbatim from the record, `deleted` flag honest, forms from `report({messageId})`. Not-found → `message_not_found` (existing code). Deleted + show → `ok` with flagged record (AC-3.3: audit, never not-found).\\n142\\t\\n143\\t### Flow 4: Health\\n144\\t\\n145\\t`health(ref)`: `messages.report` + `turns.report` (full, not-ready included) + `listQueuedWork` both owners. Compose: counts by owner/kind/state from report entries' states; `failures[]` from `failed`/`blocked` entries (reason, attempts, lastError off `FormReportEntry`); `repairPreview[]` = failed-and-not-blocked subjects (reported, never requeued — AC-4.3); `queue` = queued/claimed counts from the live-item joins, consistent by construction with the same entries' states (AC-4.5). Rebuild visibility (AC-4.4) is two health calls bracketing a drain — no new mechanism, the cascade's pending states simply show.\\n146\\t\\n147\\t### Flow 5: Lifecycle Exercise\\n148\\t\\n149\\tScripted in `test/fixtures/lifecycle.ts`: phases named `create | intake | drain | status | compact1 | pull1 | inspect1 | mutate | rebuild | health2 | compact2 | pull2 | materialize`. Each phase returns its results to the driving test; checkpoint assertions live in the test, not the script. Teardown leg (TC-5.3) re-creates the SDK between named phase groups using the same script with a `freshSdk` hook. Receipt-vs-health cross-check (AC-5.2): `compact2`'s receipt sweep section against the `health2` snapshot taken immediately before — field-level equality on the failed/requeued sets.\\n150\\t\\n151\\t## Interface Definitions\\n152\\t\\n153\\t`src/shared/inspect.ts` (load-bearing shapes; field comments carry AC refs in source):\\n154\\t\\n155\\t```typescript\\n156\\texport interface InspectOverview {\\n157\\t  thread: { id: string; createdAt: string; metadata?: Record<string, string> };\\n158\\t  events: { count: number; span: { first: number; last: number } | null };\\n159\\t  messages: { visible: number; byKind: Record<string, number>; deleted: number; visibleTokens: number };\\n160\\t  turns: { open: number; closed: number };\\n161\\t  chunks: { count: number; unchunkedTurns: number };\\n162\\t  derivation: { ready: number; pending: number; retrying: number; failed: number; blocked: number };\\n163\\t  view: { viewId: string; createdAt: string; compactPoint: number; coveredFrom: number } | null;\\n164\\t  visibility: { boundaryPosition: number; zoneTokens: number };\\n165\\t}\\n166\\t\\n167\\texport interface ViewContentsReport {\\n168\\t  meta: { viewId: string; createdAt: string; profile: string | null;\\n169\\t          config: { lowerBound: number; percentages: Record<string, number> };\\n170\\t          compactPoint: number; coveredFrom: number } | null;\\n171\\t  bands: Array<{ band: Band; entries: Array<{ subjectKind: \\\"chunk\\\" | \\\"turn\\\"; subjectId: string;\\n172\\t          formUsed: string; degraded: boolean }>; storedTokens: number }>;\\n173\\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\\n174\\t  tail: { messageCount: number; tokens: number };          // as served (AC-2.2)\\n175\\t  loadCost: { bandTokens: number; tailTokens: number; total: number }; // = pull (AC-2.3)\\n176\\t  sourceState: { maxEventOrder: number; formCounts: Record<string, number> }; // provenance verbatim (AC-2.5)\\n177\\t}\\n178\\t\\n179\\texport interface HealthReport {\\n180\\t  owners: Array<{ owner: \\\"messages\\\" | \\\"turns\\\"; kind: string;\\n181\\t          counts: { ready: number; pending: number; retrying: number; failed: number; blocked: number } }>;\\n182\\t  failures: Array<{ owner: string; subjectKind: string; subjectId: string; form: string;\\n183\\t          reason: string; attempts: number; lastError?: string }>;\\n184\\t  repairPreview: Array<{ owner: string; subjectKind: string; subjectId: string; form: string }>;\\n185\\t  queue: { queued: number; claimed: number };\\n186\\t}\\n187\\t```\\n188\\t\\n189\\tSurface signatures:\\n190\\t\\n191\\t```typescript\\n192\\t// inspect\\n193\\toverview(ref: ThreadRef): Promise<OpResult<InspectOverview>>;\\n194\\tview(ref: ThreadRef): Promise<OpResult<ViewContentsReport>>;\\n195\\thealth(ref: ThreadRef): Promise<OpResult<HealthReport>>;\\n196\\t// thread-view addition\\n197\\tdescribe(ref: ThreadRef): Promise<OpResult<StoredView | null>>;   // StoredView mirrors the row: id, createdAt, compactPoint, coveredFrom, profileName, config, arrangement, gaps, sourceState, bands (band → storedTokens)\\n198\\t// messages additions\\n199\\tlistMessages(ref: ThreadRef, opts?: { from?: number; to?: number; limit?: number; includeDeleted?: boolean }): Promise<OpResult<MessageRecord[]>>;\\n200\\tshow(ref: ThreadRef, messageId: string): Promise<OpResult<MessageDetail>>;  // MessageRecord (full blocks, deleted flag) + forms: FormReportEntry[]\\n201\\t```\\n202\\t\\n203\\tCLI grammar (JSON stdout, existing error classes, exit conventions inherited):\\n204\\t\\n205\\t```\\n206\\tlhc inspect overview --thread <ref>\\n207\\tlhc inspect view     --thread <ref>\\n208\\tlhc inspect health   --thread <ref>\\n209\\tlhc messages list    --thread <ref> [--from <n>] [--to <n>] [--limit <n>] [--include-deleted]\\n210\\tlhc messages show    --thread <ref> --message-id <id>\\n211\\t```\\n212\\t\\n213\\tError codes: no additions. `thread_not_found`, `message_not_found`, `caller_error` (bad bounds: `from > to`, `limit < 1`), `state_corruption`, `system_error` — all existing.\\n214\\t\\n215\\t## Testing Strategy\\n216\\t\\n217\\tInherited wholesale from Epics 01–03: real temp SQLite, no mocks anywhere but the provider seam (unused here beyond fixture prep), default + process suites, zero-provider assertion extended to all inspect/show/list/describe operations. New emphasis — the **read-only delta assert** (DD-6) is this epic's architecture-risk centerpiece: every new operation runs under a before/after observable-state snapshot in one shared helper. Direct table-read prevention is static: `check-boundaries` forbids cross-domain internal imports, and this epic adds a source check that `domains/inspect/**` contains no raw SQL table-name access to other domains' tables. Test files: `inspect-overview.test.ts`, `inspect-view.test.ts`, `messages-read.test.ts`, `inspect-health.test.ts`, `lifecycle.test.ts`, `cli-process-inspect.test.ts` (process suite). Full TC mapping, fixture extensions, and Red/Green detail: `test-plan.md`.\\n218\\t\\n219\\t## Work Breakdown\\n220\\t\\n221\\tStory chunks follow the epic's four stories; per-chunk Red/Green and counts in the test plan.\\n222\\t\\n223\\t| Chunk | Story | Builds | Risk concentration |\\n224\\t|-------|-------|--------|--------------------|\\n225\\t| 1 | S1 Message reads | list opts, show, `cli/messages-read.ts` | Bounds semantics; deleted default; show returning record-not-view forms |\\n226\\t| 2 | S2 Inspect domain | surface + overview + health, `shared/inspect.ts`, `cli/inspect.ts`, fixture mutation-states extension | Count correctness vs fixture ground truth; health composition staying on surfaces |\\n227\\t| 3 | S3 View report | `describe`, `view-report.ts` | Parity-by-construction wiring; never-compacted nulls |\\n228\\t| 4 | S4 Lifecycle | `lifecycle.ts` script + 4 TC legs | Checkpoint ordering; receipt-vs-health equality; teardown continuity |\\n229\\t\\n230\\tSequencing: 1 → 2 → 3 → 4 (3 needs Epic 03 storage live — already landed; 4 needs 1–3).\\n231\\t\\n232\\t## Open Questions\\n233\\t\\n234\\tNone blocking. Deferred items: count-only surface ops if thread scale ever makes overview's list-composition measurable (Spec Validation #2); message search (post-v1, PRD-recorded).\\n235\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"uuid\":\"fe4f0962-910f-4dfa-9ccd-9ce8d8c117ec\",\"timestamp\":\"2026-06-12T13:24:11.558Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/tech-design.md\",\"content\":\"# Epic 04: Inspection — Tech Design\\n\\n**Epic:** `epic.md` (23 ACs / 17 TCs) · **Tech arch:** `../01-tech-arch.md` · **Test plan:** `test-plan.md`\\n**Inherits:** Epic 01–03 technical world — storage/transaction rules, error model, `OpResult`, verification tiers, process-suite accounting, CLI conventions. Nothing re-stated here that those designs pin; this document covers what Epic 04 adds.\\n\\n## Context\\n\\nThe last epic of the v1 PRD, and the smallest: no migration, no new tables, no derivations, no provider use, no new algorithms. Four read surfaces and a lifecycle exercise. The design problem is not mechanism — it is *composition discipline*: every report assembles other domains' surfaces without touching their tables, and where a report describes another surface's output (`loadCost` vs `pull`), the design makes agreement structural rather than tested-into-existence (the materialize parity-by-construction pattern, reused).\\n\\nThe second design problem is the dependency posture: this epic consumes Epic 03's surfaces, which finished building days before this design. The epic's handoff gate requires the deviation check below.\\n\\n## Spec Validation\\n\\nDesigned from the epic; issues found and resolved during design:\\n\\n| # | Issue | Resolution | Status |\\n|---|-------|-----------|--------|\\n| 1 | **Handoff gate (epic Assumptions):** Epic 02/03 final deviation tables vs the contracts this epic consumes | Reviewed all recorded deviations (Epic 02 impl log; Epic 03 impl log: `ViewProfileOverride[]` config typing, `view_boundary` strftime seed, `ViewCompactParams` nested partial, additive error codes, sweep-absent literal superseded by Story 3). None alter consumed shapes: `ViewStatus`, `PullResult`, `thread_view`/`thread_view_band`/`view_boundary` DDL, `messages.report`/`turns.report`, `FormReportEntry`, `MessageRecord.forms` all match spec as built. One *favorable* drift: Epic 02's AC-4.7 ruling attached `forms` to message reads (built for this consumer), so Flow 3's join is thinner than the epic assumed | Gate PASSED — recorded here |\\n| 2 | AC-1.1 needs counts (events, messages by kind, tokens) that no surface exposes as counts; inspect may not read tables directly; epic sanctions only one surface addition (`describe`) | Overview composes *list* reads (`listEvents`, `listMessages`, `listTurns`, `listChunks`) and counts in inspect. Cost is linear in thread size — acceptable at v1 scale (NFR allows thread-proportional reads). Count-only surface ops are a deferred optimization, not a v1 need | Resolved — composition, no new surfaces |\\n| 3 | Epic Data Contracts leave list-option names to tech design | Pinned: `{ from?, to?, limit?, includeDeleted? }` — `from`/`to` are source-event-order bounds (reports name `sourceEventOrder`, so drill-down uses the coordinate the operator already holds), `limit` caps count after bounds | Resolved — DD-3 |\\n| 4 | AC-2.3 equality (`loadCost` totals what pull serves) could be a fragile re-implementation of pull's costing | `inspect.view` *invokes* `threadView.pull` through the surface and measures its output — parity by construction; the TC's independent leg runs a second pull in the test and re-measures. Same pattern as Epic 03's materialize | Resolved — DD-4 |\\n| 5 | TC-5.x suite placement left open by epic (TD question 5) | TC-5.1–5.3 default suite (in-process, deterministic, fast); TC-5.4 process suite (spawned CLI). The epic's lean (\\\"TC-5.1 likely default\\\") extended after checking runtimes: replay + teardown legs spawn nothing | Resolved — DD-8 |\\n\\n## System View\\n\\n```\\n                    ┌─────────────── inspect (NEW) ───────────────┐\\n                    │  overview()      view()       health()      │\\n                    └───┬─────┬─────────┬──┬───────────┬──────────┘\\n                        │     │         │  │           │\\n        ┌───────────────┘     │         │  └───────┐   └────────┐\\n        ▼                     ▼         ▼          ▼            ▼\\n   threads.resolve      intake-stream  thread-view  messages.report\\n   listThreads          .listEvents    .describe(NEW) turns.report\\n                                       .pull        .listQueuedWork\\n                        messages.listMessages(+opts)\\n                        messages.show (NEW)          turns.listTurns/listChunks\\n```\\n\\n`inspect` sits at the top of the domain graph: pure consumer, imports five surfaces, nothing imports it except `sdk.ts` and `cli/`. No cycles — unlike Epic 03's sanctioned intake→thread-view cycle, this addition is acyclic by construction. `check-boundaries` gains the domain with no exception entries.\\n\\n### External Contracts (consumed, as built)\\n\\n| Contract | Source | Used by |\\n|----------|--------|---------|\\n| `listEvents` → ordered `EventRecord[]` | intake-stream (E01) | overview (count, span) |\\n| `listMessages` → `MessageRecord[]` with `forms?` attached | messages (E01 + E02 AC-4.7) | overview, list/show |\\n| `report(ref, {messageId?})` → `FormReportEntry[]` (queue join) | messages/turns (E02) | health, show |\\n| `listTurns` / `listChunks` / `listQueuedWork` | turns (E01/E02) | overview, health |\\n| `status` → `ViewStatus` | thread-view (E03) | overview (visibility, derivation counts) |\\n| `pull` → `PullResult` | thread-view (E03) | view (loadCost by construction) |\\n| `thread_view` row + bands (storage, in-domain) | thread-view (E03) | `describe` only |\\n\\n## Module Boundaries\\n\\n### Placement\\n\\n```\\nsrc/\\n  domains/\\n    inspect/\\n      index.ts          ← NEW surface: overview, view, health\\n      internal/\\n        overview.ts     ← compose counts from list reads\\n        view-report.ts  ← describe + pull → ViewContentsReport\\n        health.ts       ← report joins → HealthReport\\n    thread-view/\\n      index.ts          ← gains describe() (read-only, ~30 lines)\\n    messages/\\n      index.ts          ← listMessages gains opts; gains show()\\n  shared/\\n    inspect.ts          ← NEW: InspectOverview, ViewContentsReport, HealthReport shapes\\n  cli/\\n    inspect.ts          ← NEW: lhc inspect overview|view|health\\n    messages-read.ts    ← NEW: lhc messages list|show (mutations stay in messages-mutate.ts)\\n  sdk.ts                ← gains inspect namespace; threadView.describe; messages.show/list opts\\n```\\n\\n### Module Responsibility Matrix\\n\\n| Module | Owns | Must NOT own |\\n|--------|------|--------------|\\n| `inspect/index.ts` + internal | Report assembly, counting, shaping | Any table read, any write, any provider call, any derivation interpretation beyond the owners' reported states |\\n| `thread-view/describe` | Exposing stored view row (arrangement, gaps, config, source state) | Recomputing anything; mutating; reading the record |\\n| `messages/show` | Single-record read (full blocks) + `report(messageId)` composition | View-form shortening (show returns the record — full tool results, never boundary-shortened) |\\n| `messages/listMessages` opts | Bounds, limit, deleted filter | Default-including deleted (audit is opt-in) |\\n| `cli/inspect.ts`, `cli/messages-read.ts` | argv → SDK → JSON stdout | Any logic beyond arg mapping (CLI parity is structural: same code path as SDK) |\\n\\nDesign decisions:\\n\\n- **DD-1 (describe placement):** `describe` lives in thread-view because the stored view row is thread-view's table; inspect consuming it through the surface keeps the must-not-own rule airtight. Absent view → `ok` with `null`, mirroring `status`'s never-compacted behavior.\\n- **DD-2 (show composes report):** `show` = internal single-message read (same store read as `listMessages`, by id, full blocks) + `messages.report(ref, {messageId})` for the queue-joined forms. No new join machinery; `FormReportEntry` is the forms shape `show` returns.\\n- **DD-3 (list options):** `{ from?, to?, limit?, includeDeleted? }`, bounds in source event order. Existing callers unaffected (opts optional, default behavior unchanged: all visible messages).\\n- **DD-4 (loadCost by construction):** `view-report.ts` calls `describe` (stored bands: entries, gaps, config, stored token counts) and `pull` (served messages). `loadCost.bandTokens` = sum of stored band counts; `loadCost.tailTokens` = estimator over pull's tail messages (band-absent entries); `total` = sum. Pull is the single costing authority for the tail — AC-2.2's boundary-aware shortening is inherited, not re-implemented.\\n- **DD-5 (overview's view section):** composed from `status` (boundary, zone, derivation counts, view health) + `describe` (viewId, createdAt, compactPoint, coveredFrom) — both already exist; overview adds no view logic.\\n- **DD-6 (read-only, structurally tested):** the architecture-risk test snapshots observable state (work-item rows via `listQueuedWork`/reports, boundary position via `status`, view identity via `describe`, event/message counts) before and after every inspect/describe/show/list call and asserts deep equality. Read-only is asserted as absence-of-delta, not absence-of-write-code.\\n- **DD-7 (no migration):** schema terminal at v6. The one index temptation (message kind counts) is declined — counts come from list reads (Spec Validation #2); if profiling ever demands an index, that is a v7 proposal.\\n- **DD-8 (suite placement):** TC-5.1–5.3 default suite; TC-5.4 process suite. The lifecycle script is a shared fixture helper (`test/fixtures/lifecycle.ts`) both suites drive, so the spawned leg replays the same sequence rather than a re-described one.\\n\\n## Storage\\n\\nNone. No tables, no migration, no new indexes (DD-7). The only storage *read* this epic adds is `describe`'s in-domain read of `thread_view` / `thread_view_band` / `view_boundary`, all Epic 03 tables.\\n\\n## Flow-by-Flow Design\\n\\n### Flow 1: Overview\\n\\n`overview(ref)`: resolve thread (registry metadata) → `listEvents` (count, first/last order) → `listMessages({includeDeleted: true})` (visible/deleted split, kind counts, visible token sum — deleted detected per the read contract's flag) → `listTurns` (open/closed counts) → `listChunks` (count; unchunked = closed turns minus chunk-member turns) → `status` + `describe` (derivation counts, visibility, view summary). Each piece independent; fresh-empty, mid-first-turn, never-compacted-with-record, compacted, and mid-rebuild shapes fall out of the same composition path: absent pieces are zeros/nulls; no shape-specific branch is allowed except normalizing null sections.\\n\\nWorked example (compacted fixture, abridged):\\n\\n```json\\n{\\n  \\\"thread\\\": { \\\"id\\\": \\\"th_…\\\", \\\"createdAt\\\": \\\"…\\\" },\\n  \\\"events\\\": { \\\"count\\\": 412, \\\"span\\\": { \\\"first\\\": 1, \\\"last\\\": 412 } },\\n  \\\"messages\\\": { \\\"visible\\\": 187, \\\"byKind\\\": { \\\"user_prompt\\\": 14, \\\"assistant_text\\\": 41, \\\"tool_call\\\": 66, \\\"tool_result\\\": 64, \\\"assistant_thinking\\\": 2 }, \\\"deleted\\\": 2, \\\"visibleTokens\\\": 96342 },\\n  \\\"turns\\\": { \\\"open\\\": 0, \\\"closed\\\": 14 },\\n  \\\"chunks\\\": { \\\"count\\\": 4, \\\"unchunkedTurns\\\": 2 },\\n  \\\"derivation\\\": { \\\"ready\\\": 118, \\\"pending\\\": 3, \\\"retrying\\\": 1, \\\"failed\\\": 2, \\\"blocked\\\": 0 },\\n  \\\"view\\\": { \\\"viewId\\\": \\\"v391\\\", \\\"createdAt\\\": \\\"…\\\", \\\"compactPoint\\\": 391, \\\"coveredFrom\\\": 12 },\\n  \\\"visibility\\\": { \\\"boundaryPosition\\\": 398, \\\"zoneTokens\\\": 18204 }\\n}\\n```\\n\\n### Flow 2: View Contents Report\\n\\n```\\ninspect.view ──► threadView.describe ──► stored arrangement/gaps/config/band tokens/source state\\n      │\\n      └────────► threadView.pull ──► served messages\\n                      │\\n                      ├─ band entries → cross-check count only (arrangement is describe's)\\n                      └─ tail entries → estimator → tailTokens (as served: short forms short)\\nloadCost = { bandTokens: Σ stored, tailTokens: measured, total: sum }\\n```\\n\\nNever-compacted: `describe` → null ⇒ `meta: null`, bands empty, whole pull output is tail, parity contract unchanged (AC-2.4). The report never recomputes selection, rendering, or boundary state — stored snapshot + live pull are the only sources (AC-2.1's \\\"not recomputed\\\" is structural).\\n\\n### Flow 3: Message Listing and Show\\n\\n`listMessages(ref, opts)`: existing read + WHERE bounds on `source_event_order`, LIMIT, deleted filter (default excluded; `includeDeleted` includes flagged). `show(ref, messageId)`: by-id read, full blocks verbatim from the record, `deleted` flag honest, forms from `report({messageId})`. Not-found → `message_not_found` (existing code). Deleted + show → `ok` with flagged record (AC-3.3: audit, never not-found).\\n\\n### Flow 4: Health\\n\\n`health(ref)`: `messages.report` + `turns.report` (full, not-ready included) + `listQueuedWork` both owners. Compose: counts by owner/kind/state from report entries' states; `failures[]` from `failed`/`blocked` entries (reason, attempts, lastError off `FormReportEntry`); `repairPreview[]` = failed-and-not-blocked subjects (reported, never requeued — AC-4.3); `queue` = queued/claimed counts from the live-item joins, consistent by construction with the same entries' states (AC-4.5). Rebuild visibility (AC-4.4) is two health calls bracketing a drain — no new mechanism, the cascade's pending states simply show.\\n\\n### Flow 5: Lifecycle Exercise\\n\\nScripted in `test/fixtures/lifecycle.ts`: phases named `create | intake | drain | status | compact1 | pull1 | inspect1 | mutate | rebuild | health2 | compact2 | pull2 | materialize`. Each phase returns its results to the driving test; checkpoint assertions live in the test, not the script. Teardown leg (TC-5.3) re-creates the SDK between named phase groups using the same script with a `freshSdk` hook. Receipt-vs-health cross-check (AC-5.2): `compact2`'s receipt sweep section against the `health2` snapshot taken immediately before — field-level equality on the failed/requeued sets.\\n\\n## Interface Definitions\\n\\n`src/shared/inspect.ts` (load-bearing shapes; field comments carry AC refs in source):\\n\\n```typescript\\nexport interface InspectOverview {\\n  thread: { id: string; createdAt: string; metadata?: Record<string, string> };\\n  events: { count: number; span: { first: number; last: number } | null };\\n  messages: { visible: number; byKind: Record<string, number>; deleted: number; visibleTokens: number };\\n  turns: { open: number; closed: number };\\n  chunks: { count: number; unchunkedTurns: number };\\n  derivation: { ready: number; pending: number; retrying: number; failed: number; blocked: number };\\n  view: { viewId: string; createdAt: string; compactPoint: number; coveredFrom: number } | null;\\n  visibility: { boundaryPosition: number; zoneTokens: number };\\n}\\n\\nexport interface ViewContentsReport {\\n  meta: { viewId: string; createdAt: string; profile: string | null;\\n          config: { lowerBound: number; percentages: Record<string, number> };\\n          compactPoint: number; coveredFrom: number } | null;\\n  bands: Array<{ band: Band; entries: Array<{ subjectKind: \\\"chunk\\\" | \\\"turn\\\"; subjectId: string;\\n          formUsed: string; degraded: boolean }>; storedTokens: number }>;\\n  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\\n  tail: { messageCount: number; tokens: number };          // as served (AC-2.2)\\n  loadCost: { bandTokens: number; tailTokens: number; total: number }; // = pull (AC-2.3)\\n  sourceState: { maxEventOrder: number; formCounts: Record<string, number> }; // provenance verbatim (AC-2.5)\\n}\\n\\nexport interface HealthReport {\\n  owners: Array<{ owner: \\\"messages\\\" | \\\"turns\\\"; kind: string;\\n          counts: { ready: number; pending: number; retrying: number; failed: number; blocked: number } }>;\\n  failures: Array<{ owner: string; subjectKind: string; subjectId: string; form: string;\\n          reason: string; attempts: number; lastError?: string }>;\\n  repairPreview: Array<{ owner: string; subjectKind: string; subjectId: string; form: string }>;\\n  queue: { queued: number; claimed: number };\\n}\\n```\\n\\nSurface signatures:\\n\\n```typescript\\n// inspect\\noverview(ref: ThreadRef): Promise<OpResult<InspectOverview>>;\\nview(ref: ThreadRef): Promise<OpResult<ViewContentsReport>>;\\nhealth(ref: ThreadRef): Promise<OpResult<HealthReport>>;\\n// thread-view addition\\ndescribe(ref: ThreadRef): Promise<OpResult<StoredView | null>>;   // StoredView mirrors the row: id, createdAt, compactPoint, coveredFrom, profileName, config, arrangement, gaps, sourceState, bands (band → storedTokens)\\n// messages additions\\nlistMessages(ref: ThreadRef, opts?: { from?: number; to?: number; limit?: number; includeDeleted?: boolean }): Promise<OpResult<MessageRecord[]>>;\\nshow(ref: ThreadRef, messageId: string): Promise<OpResult<MessageDetail>>;  // MessageRecord (full blocks, deleted flag) + forms: FormReportEntry[]\\n```\\n\\nCLI grammar (JSON stdout, existing error classes, exit conventions inherited):\\n\\n```\\nlhc inspect overview --thread <ref>\\nlhc inspect view     --thread <ref>\\nlhc inspect health   --thread <ref>\\nlhc messages list    --thread <ref> [--from <n>] [--to <n>] [--limit <n>] [--include-deleted]\\nlhc messages show    --thread <ref> --message-id <id>\\n```\\n\\nError codes: no additions. `thread_not_found`, `message_not_found`, `caller_error` (bad bounds: `from > to`, `limit < 1`), `state_corruption`, `system_error` — all existing.\\n\\n## Testing Strategy\\n\\nInherited wholesale from Epics 01–03: real temp SQLite, no mocks anywhere but the provider seam (unused here beyond fixture prep), default + process suites, zero-provider assertion extended to all inspect/show/list/describe operations. New emphasis — the **read-only delta assert** (DD-6) is this epic's architecture-risk centerpiece: every new operation runs under a before/after observable-state snapshot in one shared helper. Direct table-read prevention is static: `check-boundaries` forbids cross-domain internal imports, and this epic adds a source check that `domains/inspect/**` contains no raw SQL table-name access to other domains' tables. Test files: `inspect-overview.test.ts`, `inspect-view.test.ts`, `messages-read.test.ts`, `inspect-health.test.ts`, `lifecycle.test.ts`, `cli-process-inspect.test.ts` (process suite). Full TC mapping, fixture extensions, and Red/Green detail: `test-plan.md`.\\n\\n## Work Breakdown\\n\\nStory chunks follow the epic's four stories; per-chunk Red/Green and counts in the test plan.\\n\\n| Chunk | Story | Builds | Risk concentration |\\n|-------|-------|--------|--------------------|\\n| 1 | S1 Message reads | list opts, show, `cli/messages-read.ts` | Bounds semantics; deleted default; show returning record-not-view forms |\\n| 2 | S2 Inspect domain | surface + overview + health, `shared/inspect.ts`, `cli/inspect.ts`, fixture mutation-states extension | Count correctness vs fixture ground truth; health composition staying on surfaces |\\n| 3 | S3 View report | `describe`, `view-report.ts` | Parity-by-construction wiring; never-compacted nulls |\\n| 4 | S4 Lifecycle | `lifecycle.ts` script + 4 TC legs | Checkpoint ordering; receipt-vs-health equality; teardown continuity |\\n\\nSequencing: 1 → 2 → 3 → 4 (3 needs Epic 03 storage live — already landed; 4 needs 1–3).\\n\\n## Open Questions\\n\\nNone blocking. Deferred items: count-only surface ops if thread scale ever makes overview's list-composition measurable (Spec Validation #2); message search (post-v1, PRD-recorded).\\n\",\"numLines\":235,\"startLine\":1,\"totalLines\":235}}}\n87:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01JRETZ7WmiJbKg93YhzRYKC\",\"type\":\"tool_result\",\"content\":\"1\\t# Team Impl Log — Epic 04: Inspection\\n2\\t\\n3\\tState: STORY_ACTIVE\\n4\\tSpec-pack root: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection\\n5\\tCurrent Story: 01-message-read-surface\\n6\\tCurrent Phase: implement (story-orchestrate)\\n7\\t\\n8\\t## Run Configuration\\n9\\t\\n10\\t- Date: 2026-06-12\\n11\\t- Caller harness: Claude Code (Fable 5) acting as impl-lead.\\n12\\t- Primary harness: claude-code. Secondary harness probe: codex-cli 0.139.0 available.\\n13\\t- Defaults table applied: \\\"Codex available\\\" (operations/31-provider-resolution.md), no deviations.\\n14\\t- Roles: story_lead_provider=codex gpt-5.5 high; story_implementor=claude-fable-5 medium; quick_fixer=claude-opus-4-8 xhigh; story_verifier=codex gpt-5.5 xhigh; epic-reviewer-1=claude-fable-5 xhigh; epic-reviewer-2=codex gpt-5.5 xhigh; epic_reverifier=claude-fable-5 xhigh.\\n15\\t- Self-review passes: 3 (default).\\n16\\t- Degraded-diversity: none (Codex available).\\n17\\t- Prompt inserts: both absent (non-blocking).\\n18\\t\\n19\\t## Verification Gates\\n20\\t\\n21\\t- Story gate: `pnpm verify` — source: package scripts (packages/lhc/package.json). Candidates considered: `verify`, `green-verify` (adds check-test-immutability guard), `verify-all`. `verify` selected per skill rule: prefer plain `verify` during story work because stories legitimately add tests; guarded `green-verify` reserved for hygiene/explicit policy.\\n22\\t- Epic gate: `pnpm verify-all` (runs red-verify + LHC_PROCESS_SUITE=1 vitest) — source: package scripts; matches spec-pack Verification sections (`LHC_PROCESS_SUITE=1 pnpm verify-all`). Process suite must report `ran`.\\n23\\t- Gate working directory: packages/lhc.\\n24\\t\\n25\\t## Spec Pack\\n26\\t\\n27\\t- inspect: ready. Shape: two-file (tech-design.md + test-plan.md). artifacts/ created.\\n28\\t- Stories in order: 01-message-read-surface, 02-inspect-domain-overview-and-health, 03-view-contents-report, 04-lifecycle-exercise. coverage.md ignored as non-story.\\n29\\t- Coverage gate (coverage.md): PASS — all 23 ACs owned, one primary owner per TC.\\n30\\t\\n31\\t## Retained Spec Notes (compaction-safe)\\n32\\t\\n33\\t- Epic 04 builds the inspection surface for the LHC SDK (in-process long-horizon-context system for PI CLI extensions; thin CLI for testing/integration).\\n34\\t- S1 message reads: listMessages bounds {from,to,limit,includeDeleted} in source-event order; show returns FULL record blocks + owner-reported form states (never view-shortened, never synthesized); deleted excluded by default, auditable, show on deleted = ok+flag, missing id = message_not_found; CLI deep-equal parity. Search deferred post-v1, no placeholder. Strategy: simple-risk-reminders.\\n35\\t- S2 inspect domain: overview (identity, event/message/turn/chunk counts, derivation states, view summary or null, boundary + zone tokens; deleted contract; all 5 thread shapes; pure read) + health (owner/kind/state counts via owner report surfaces ONLY — no direct derived_form/work_item reads; failure detail; repair preview = failed∧¬blocked, never executed; queue visibility; rebuild bracket edit→pending→drain→ready). Read-only delta helper lands here, wraps S1 ops retroactively. Mutation-in-flight fixture via production mutate + partial drain, never hand-written rows. Strategy: tdd-lite.\\n36\\t- S3 view report: threadView.describe = stored snapshot only (null when absent, never recompute); inspect.view = describe + measured pull tail; governing contract loadCost.total == actual pull served content (incl. never-compacted: meta null, bands [], tail-only). No new storage/migration. Strategy: tdd-lite.\\n37\\t- S4 lifecycle capstone: test/fixtures/lifecycle.ts scripted PI-extension order (create→intake→drain→status→compact→pull→inspect→edit+delete→rebuild drain→health→compact2→pull→materialize); deterministic provider only, zero network; replay byte-identical; SDK teardown/recreate continuity; spawned-CLI checkpoint parity; receipt-vs-health cross-check. Process suite must report ran, never silently skip. Strategy: full-staged-risk.\\n38\\t- Test plan: ~26 default tests across messages-read/inspect-overview/inspect-view/inspect-health/lifecycle + cli-process-inspect (process: TC-3.4, TC-5.4). Architecture-risk: read-only delta assert on every new op; throwing-provider suite-wide assert; loadCost parity two independent measurements; check-boundaries + source check against raw SQL into other domains from domains/inspect/**.\\n39\\t\\n40\\t## Operating Reminders\\n41\\t\\n42\\t- Impl-lead owns acceptance, final gates, fix routing, recovery. CLI never accepts.\\n43\\t- Story cycle: story-orchestrate validate → run (background) → monitor via runtime progress artifacts + 5-min Monitor cadence → review final package → run story gate myself → receipt → advance.\\n44\\t- Receipt before acceptance: implementor evidence, verifier evidence, gate result, dispositions, baseline before/after.\\n45\\t- Cumulative baseline tracking: total test count must not regress story-over-story.\\n46\\t\\n47\\t## Cumulative Baseline\\n48\\t\\n49\\t- Pre-run baseline (2026-06-12, before Story 1): `pnpm verify` PASS — 290 tests / 27 files.\\n50\\t\\n51\\t## Story Sequence Status\\n52\\t\\n53\\t| Story | Status |\\n54\\t|---|---|\\n55\\t| 01-message-read-surface | pending |\\n56\\t| 02-inspect-domain-overview-and-health | pending |\\n57\\t| 03-view-contents-report | pending |\\n58\\t| 04-lifecycle-exercise | pending |\\n59\\t\\n60\\t## Transitions\\n61\\t\\n62\\t- 2026-06-12: Run created. State: SETUP. inspect ready; config authored; gates resolved from package scripts.\\n63\\t- 2026-06-12: preflight ready (002-preflight.json). Gates persisted into impl-run.config.json by preflight (expected side effect). Baseline 290/27 recorded. State → STORY_ACTIVE, Story 01, phase implement.\\n64\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"uuid\":\"9d70611e-ff45-41a6-afe7-5aa211617934\",\"timestamp\":\"2026-06-12T13:24:12.502Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/team-impl-log.md\",\"content\":\"# Team Impl Log — Epic 04: Inspection\\n\\nState: STORY_ACTIVE\\nSpec-pack root: /Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection\\nCurrent Story: 01-message-read-surface\\nCurrent Phase: implement (story-orchestrate)\\n\\n## Run Configuration\\n\\n- Date: 2026-06-12\\n- Caller harness: Claude Code (Fable 5) acting as impl-lead.\\n- Primary harness: claude-code. Secondary harness probe: codex-cli 0.139.0 available.\\n- Defaults table applied: \\\"Codex available\\\" (operations/31-provider-resolution.md), no deviations.\\n- Roles: story_lead_provider=codex gpt-5.5 high; story_implementor=claude-fable-5 medium; quick_fixer=claude-opus-4-8 xhigh; story_verifier=codex gpt-5.5 xhigh; epic-reviewer-1=claude-fable-5 xhigh; epic-reviewer-2=codex gpt-5.5 xhigh; epic_reverifier=claude-fable-5 xhigh.\\n- Self-review passes: 3 (default).\\n- Degraded-diversity: none (Codex available).\\n- Prompt inserts: both absent (non-blocking).\\n\\n## Verification Gates\\n\\n- Story gate: `pnpm verify` — source: package scripts (packages/lhc/package.json). Candidates considered: `verify`, `green-verify` (adds check-test-immutability guard), `verify-all`. `verify` selected per skill rule: prefer plain `verify` during story work because stories legitimately add tests; guarded `green-verify` reserved for hygiene/explicit policy.\\n- Epic gate: `pnpm verify-all` (runs red-verify + LHC_PROCESS_SUITE=1 vitest) — source: package scripts; matches spec-pack Verification sections (`LHC_PROCESS_SUITE=1 pnpm verify-all`). Process suite must report `ran`.\\n- Gate working directory: packages/lhc.\\n\\n## Spec Pack\\n\\n- inspect: ready. Shape: two-file (tech-design.md + test-plan.md). artifacts/ created.\\n- Stories in order: 01-message-read-surface, 02-inspect-domain-overview-and-health, 03-view-contents-report, 04-lifecycle-exercise. coverage.md ignored as non-story.\\n- Coverage gate (coverage.md): PASS — all 23 ACs owned, one primary owner per TC.\\n\\n## Retained Spec Notes (compaction-safe)\\n\\n- Epic 04 builds the inspection surface for the LHC SDK (in-process long-horizon-context system for PI CLI extensions; thin CLI for testing/integration).\\n- S1 message reads: listMessages bounds {from,to,limit,includeDeleted} in source-event order; show returns FULL record blocks + owner-reported form states (never view-shortened, never synthesized); deleted excluded by default, auditable, show on deleted = ok+flag, missing id = message_not_found; CLI deep-equal parity. Search deferred post-v1, no placeholder. Strategy: simple-risk-reminders.\\n- S2 inspect domain: overview (identity, event/message/turn/chunk counts, derivation states, view summary or null, boundary + zone tokens; deleted contract; all 5 thread shapes; pure read) + health (owner/kind/state counts via owner report surfaces ONLY — no direct derived_form/work_item reads; failure detail; repair preview = failed∧¬blocked, never executed; queue visibility; rebuild bracket edit→pending→drain→ready). Read-only delta helper lands here, wraps S1 ops retroactively. Mutation-in-flight fixture via production mutate + partial drain, never hand-written rows. Strategy: tdd-lite.\\n- S3 view report: threadView.describe = stored snapshot only (null when absent, never recompute); inspect.view = describe + measured pull tail; governing contract loadCost.total == actual pull served content (incl. never-compacted: meta null, bands [], tail-only). No new storage/migration. Strategy: tdd-lite.\\n- S4 lifecycle capstone: test/fixtures/lifecycle.ts scripted PI-extension order (create→intake→drain→status→compact→pull→inspect→edit+delete→rebuild drain→health→compact2→pull→materialize); deterministic provider only, zero network; replay byte-identical; SDK teardown/recreate continuity; spawned-CLI checkpoint parity; receipt-vs-health cross-check. Process suite must report ran, never silently skip. Strategy: full-staged-risk.\\n- Test plan: ~26 default tests across messages-read/inspect-overview/inspect-view/inspect-health/lifecycle + cli-process-inspect (process: TC-3.4, TC-5.4). Architecture-risk: read-only delta assert on every new op; throwing-provider suite-wide assert; loadCost parity two independent measurements; check-boundaries + source check against raw SQL into other domains from domains/inspect/**.\\n\\n## Operating Reminders\\n\\n- Impl-lead owns acceptance, final gates, fix routing, recovery. CLI never accepts.\\n- Story cycle: story-orchestrate validate → run (background) → monitor via runtime progress artifacts + 5-min Monitor cadence → review final package → run story gate myself → receipt → advance.\\n- Receipt before acceptance: implementor evidence, verifier evidence, gate result, dispositions, baseline before/after.\\n- Cumulative baseline tracking: total test count must not regress story-over-story.\\n\\n## Cumulative Baseline\\n\\n- Pre-run baseline (2026-06-12, before Story 1): `pnpm verify` PASS — 290 tests / 27 files.\\n\\n## Story Sequence Status\\n\\n| Story | Status |\\n|---|---|\\n| 01-message-read-surface | pending |\\n| 02-inspect-domain-overview-and-health | pending |\\n| 03-view-contents-report | pending |\\n| 04-lifecycle-exercise | pending |\\n\\n## Transitions\\n\\n- 2026-06-12: Run created. State: SETUP. inspect ready; config authored; gates resolved from package scripts.\\n- 2026-06-12: preflight ready (002-preflight.json). Gates persisted into impl-run.config.json by preflight (expected side effect). Baseline 290/27 recorded. State → STORY_ACTIVE, Story 01, phase implement.\\n\",\"numLines\":64,\"startLine\":1,\"totalLines\":64}}}\n118:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01WVsp1svp4RxDnvsFfwcj3y\",\"type\":\"tool_result\",\"content\":\"1\\t# Story 1: Message Read Surface\\n2\\t\\n3\\t### Summary\\n4\\t<!-- Jira: Summary field -->\\n5\\tComplete message listing and single-message viewing with deleted-audit support and CLI parity.\\n6\\t\\n7\\t### Description\\n8\\t<!-- Jira: Description field -->\\n9\\t**User Profile:** The operator audits threads from the CLI; agents inside a harness use the same reads mid-task.\\n10\\t\\n11\\t**Objective:** Provide the drill-down floor for every report that names message subjects.\\n12\\t\\n13\\t**Scope In:** `messages.list` bounded listing options, `messages.show`, forms join, deleted-message audit option, `lhc messages list`, `lhc messages show`, SDK/CLI JSON parity.\\n14\\t\\n15\\t**Scope Out:** Message search is deferred post-v1. No search behavior, search placeholder, ranking, FTS, or result-granularity decision ships in this story.\\n16\\t\\n17\\t**Dependencies:** Built Epic 01 message record/read-back behavior and Epic 02 report/deleted-message contracts.\\n18\\t\\n19\\t### Acceptance Criteria\\n20\\t<!-- Jira: Acceptance Criteria field -->\\n21\\t- **AC-3.1**: Listing returns messages in record order with kind, block summary, token estimate, turn membership, and deleted status, with bounded-listing options (range/limit) so large threads list without loading everything.\\n22\\t\\n23\\t- **TC-3.1** (AC-3.1): List on the fixture → record order, kinds, token estimates, turn ids correct; range and limit options honored exactly.\\n24\\t\\n25\\t- **AC-3.2**: `messages.show` returns one message in full: every block with complete content (the record — full tool results, not view-shortened forms), token estimate, turn membership, and the message's derivation forms with their states and metadata (joined from the owner's report, including tool-outcome metadata where present).\\n26\\t\\n27\\t- **TC-3.2** (AC-3.2): Show on a drained tool-result message → full original content present, forms listed with states, outcome metadata present.\\n28\\t\\n29\\t- **AC-3.3**: Deleted messages are excluded by default and listable with an explicit include-deleted option, marked deleted — never silently mixed in. `show` on a deleted message returns the record marked deleted (audit is the point), never a not-found.\\n30\\t\\n31\\t- **TC-3.3** (AC-3.3): Delete one message → default list excludes it; include-deleted lists it marked; show on its id → record with deleted flag.\\n32\\t\\n33\\t- **AC-3.4**: CLI parity: `lhc messages list` and `lhc messages show` mirror the SDK operations — same options, same result JSON.\\n34\\t\\n35\\t- **TC-3.4** (AC-3.4): Spawned-CLI list and show on a fixture thread → JSON equals the in-process SDK results (process suite).\\n36\\t\\n37\\t### Technical Design\\n38\\t<!-- Jira: Technical Notes or sub-section of Description -->\\n39\\t#### Architecture Context\\n40\\t\\n41\\tThis story extends the existing messages surface. `listMessages` gains optional bounds and deleted-audit options while preserving default visible-message behavior for existing callers. `show` returns the canonical record content, not the view-shortened content, and composes form state from the owner report surface.\\n42\\t\\n43\\tThe CLI is a thin argv-to-SDK wrapper. JSON output must deep-equal the in-process SDK result.\\n44\\t\\n45\\t#### Build Strategy\\n46\\t\\n47\\tStrategy: simple-risk-reminders\\n48\\t\\n49\\tReason:\\n50\\t- One surface owns listing/showing behavior, but bounds semantics, deleted defaults, and CLI parity are easy to shortcut.\\n51\\t\\n52\\tRisk Reminders:\\n53\\t- `show` returns full record blocks, including full tool results.\\n54\\t- Deleted messages remain excluded by default and auditable on explicit request.\\n55\\t- Bounds use source-event-order coordinates: `{ from?, to?, limit?, includeDeleted? }`.\\n56\\t\\n57\\t#### Implementation Targets\\n58\\t\\n59\\t| Area | Files / Modules |\\n60\\t|------|-----------------|\\n61\\t| Message surface | `src/domains/messages/index.ts` |\\n62\\t| CLI | `src/cli/messages-read.ts` |\\n63\\t| SDK export | `src/sdk.ts` |\\n64\\t| Tests | `test/messages-read.test.ts`, `test/cli-process-inspect.test.ts` |\\n65\\t\\n66\\t#### Design References\\n67\\t\\n68\\t- [tech-design.md §Module Boundaries](/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/tech-design.md:54), lines 54-98\\n69\\t- [tech-design.md §Flow 3: Message Listing and Show](/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/tech-design.md:139), lines 139-142\\n70\\t- [tech-design.md §Interface Definitions](/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/tech-design.md:189), lines 189-213\\n71\\t- [test-plan.md §Test Files](/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/test-plan.md:6), lines 6-18\\n72\\t- [test-plan.md §TC → Test Mapping](/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/test-plan.md:20), lines 20-40\\n73\\t- [test-plan.md §Chunk Red/Green Detail](/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/test-plan.md:56), lines 56-64\\n74\\t\\n75\\t#### Test Mapping\\n76\\t\\n77\\t| TC | Test File / Check | Test Description |\\n78\\t|----|-------------------|------------------|\\n79\\t| TC-3.1 | `test/messages-read.test.ts :: order, fields, bounds` | Record order, kind, token estimate, turn id, exact `from`/`to`/`limit` windows, and bad bounds error. |\\n80\\t| TC-3.2 | `test/messages-read.test.ts :: show full record + forms` | Drained tool-result message returns full content, form states, and outcome metadata. |\\n81\\t| TC-3.3 | `test/messages-read.test.ts :: deleted handling` | Default list excludes deleted; include-deleted marks it; show on deleted returns ok with flag; missing id returns not found. |\\n82\\t| TC-3.4 | `test/cli-process-inspect.test.ts :: list/show parity` | Spawned CLI message list/show JSON deep-equals SDK results. |\\n83\\t\\n84\\t#### Architecture-Risk Tests\\n85\\t\\n86\\t| Risk | Test File / Check | Test Description | Why AC/TC Mapping Alone Would Miss It |\\n87\\t|------|-------------------|------------------|---------------------------------------|\\n88\\t| Read-only drift | `test/messages-read.test.ts` read-only legs | Before/after observable-state snapshots stay equal for list/show. | A read can satisfy shape assertions while still mutating queue, boundary, or view state. |\\n89\\t| CLI bypasses SDK | `test/cli-process-inspect.test.ts` process parity | Spawned commands compare serialized JSON against SDK results. | Private helper tests can pass while production CLI output diverges. |\\n90\\t\\n91\\t#### Technical Notes\\n92\\t\\n93\\t- `listMessages` option defaults must preserve existing callers: visible messages, unbounded, record order.\\n94\\t- `from` and `to` are source-event-order bounds; `limit` caps after bounds.\\n95\\t- `show` composes the by-id message read with `messages.report(ref, { messageId })`.\\n96\\t- Message search remains deferred post-v1 and gets no v1 placeholder behavior.\\n97\\t\\n98\\t#### Anti-Shim Requirements\\n99\\t\\n100\\t- Assert real full block content for tool-result messages, not only message id or metadata.\\n101\\t- Exercise the spawned `lhc messages` commands for process parity.\\n102\\t- Do not synthesize form state in `show`; use the owner report entries.\\n103\\t\\n104\\t#### Production Path Proof\\n105\\t\\n106\\t- Entrypoint: `messages.listMessages`, `messages.show`, `lhc messages list`, `lhc messages show`.\\n107\\t- Registration/default path: `src/sdk.ts` exposes the message operations; `src/cli/messages-read.ts` routes CLI commands to SDK calls.\\n108\\t- Evidence: process parity for CLI list/show and default-suite message read tests.\\n109\\t\\n110\\t#### Verification\\n111\\t\\n112\\t- Targeted: `pnpm verify`\\n113\\t- Story gate: `pnpm verify`\\n114\\t- Epic/process gate: `LHC_PROCESS_SUITE=1 pnpm verify-all`\\n115\\t\\n116\\t#### Spec Deviations\\n117\\t\\n118\\tNone.\\n119\\t\\n120\\t### Definition of Done\\n121\\t<!-- Jira: Definition of Done or Acceptance Criteria footer -->\\n122\\t- `messages.list` returns bounded, ordered message summaries with deleted filtering.\\n123\\t- `messages.show` returns full record content and owner-reported form state for one message.\\n124\\t- Deleted-message audit behavior matches Epic 02's deleted contract.\\n125\\t- CLI list/show options and JSON match SDK results.\\n126\\t- TC-3.1 through TC-3.4 pass with one primary owner in this story.\\n127\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"uuid\":\"f853556b-5c91-4adf-871d-8a3cc45d9e24\",\"timestamp\":\"2026-06-12T13:24:17.982Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/stories/01-message-read-surface.md\",\"content\":\"# Story 1: Message Read Surface\\n\\n### Summary\\n<!-- Jira: Summary field -->\\nComplete message listing and single-message viewing with deleted-audit support and CLI parity.\\n\\n### Description\\n<!-- Jira: Description field -->\\n**User Profile:** The operator audits threads from the CLI; agents inside a harness use the same reads mid-task.\\n\\n**Objective:** Provide the drill-down floor for every report that names message subjects.\\n\\n**Scope In:** `messages.list` bounded listing options, `messages.show`, forms join, deleted-message audit option, `lhc messages list`, `lhc messages show`, SDK/CLI JSON parity.\\n\\n**Scope Out:** Message search is deferred post-v1. No search behavior, search placeholder, ranking, FTS, or result-granularity decision ships in this story.\\n\\n**Dependencies:** Built Epic 01 message record/read-back behavior and Epic 02 report/deleted-message contracts.\\n\\n### Acceptance Criteria\\n<!-- Jira: Acceptance Criteria field -->\\n- **AC-3.1**: Listing returns messages in record order with kind, block summary, token estimate, turn membership, and deleted status, with bounded-listing options (range/limit) so large threads list without loading everything.\\n\\n- **TC-3.1** (AC-3.1): List on the fixture → record order, kinds, token estimates, turn ids correct; range and limit options honored exactly.\\n\\n- **AC-3.2**: `messages.show` returns one message in full: every block with complete content (the record — full tool results, not view-shortened forms), token estimate, turn membership, and the message's derivation forms with their states and metadata (joined from the owner's report, including tool-outcome metadata where present).\\n\\n- **TC-3.2** (AC-3.2): Show on a drained tool-result message → full original content present, forms listed with states, outcome metadata present.\\n\\n- **AC-3.3**: Deleted messages are excluded by default and listable with an explicit include-deleted option, marked deleted — never silently mixed in. `show` on a deleted message returns the record marked deleted (audit is the point), never a not-found.\\n\\n- **TC-3.3** (AC-3.3): Delete one message → default list excludes it; include-deleted lists it marked; show on its id → record with deleted flag.\\n\\n- **AC-3.4**: CLI parity: `lhc messages list` and `lhc messages show` mirror the SDK operations — same options, same result JSON.\\n\\n- **TC-3.4** (AC-3.4): Spawned-CLI list and show on a fixture thread → JSON equals the in-process SDK results (process suite).\\n\\n### Technical Design\\n<!-- Jira: Technical Notes or sub-section of Description -->\\n#### Architecture Context\\n\\nThis story extends the existing messages surface. `listMessages` gains optional bounds and deleted-audit options while preserving default visible-message behavior for existing callers. `show` returns the canonical record content, not the view-shortened content, and composes form state from the owner report surface.\\n\\nThe CLI is a thin argv-to-SDK wrapper. JSON output must deep-equal the in-process SDK result.\\n\\n#### Build Strategy\\n\\nStrategy: simple-risk-reminders\\n\\nReason:\\n- One surface owns listing/showing behavior, but bounds semantics, deleted defaults, and CLI parity are easy to shortcut.\\n\\nRisk Reminders:\\n- `show` returns full record blocks, including full tool results.\\n- Deleted messages remain excluded by default and auditable on explicit request.\\n- Bounds use source-event-order coordinates: `{ from?, to?, limit?, includeDeleted? }`.\\n\\n#### Implementation Targets\\n\\n| Area | Files / Modules |\\n|------|-----------------|\\n| Message surface | `src/domains/messages/index.ts` |\\n| CLI | `src/cli/messages-read.ts` |\\n| SDK export | `src/sdk.ts` |\\n| Tests | `test/messages-read.test.ts`, `test/cli-process-inspect.test.ts` |\\n\\n#### Design References\\n\\n- [tech-design.md §Module Boundaries](/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/tech-design.md:54), lines 54-98\\n- [tech-design.md §Flow 3: Message Listing and Show](/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/tech-design.md:139), lines 139-142\\n- [tech-design.md §Interface Definitions](/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/tech-design.md:189), lines 189-213\\n- [test-plan.md §Test Files](/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/test-plan.md:6), lines 6-18\\n- [test-plan.md §TC → Test Mapping](/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/test-plan.md:20), lines 20-40\\n- [test-plan.md §Chunk Red/Green Detail](/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/docs/02-specs/04-inspection/test-plan.md:56), lines 56-64\\n\\n#### Test Mapping\\n\\n| TC | Test File / Check | Test Description |\\n|----|-------------------|------------------|\\n| TC-3.1 | `test/messages-read.test.ts :: order, fields, bounds` | Record order, kind, token estimate, turn id, exact `from`/`to`/`limit` windows, and bad bounds error. |\\n| TC-3.2 | `test/messages-read.test.ts :: show full record + forms` | Drained tool-result message returns full content, form states, and outcome metadata. |\\n| TC-3.3 | `test/messages-read.test.ts :: deleted handling` | Default list excludes deleted; include-deleted marks it; show on deleted returns ok with flag; missing id returns not found. |\\n| TC-3.4 | `test/cli-process-inspect.test.ts :: list/show parity` | Spawned CLI message list/show JSON deep-equals SDK results. |\\n\\n#### Architecture-Risk Tests\\n\\n| Risk | Test File / Check | Test Description | Why AC/TC Mapping Alone Would Miss It |\\n|------|-------------------|------------------|---------------------------------------|\\n| Read-only drift | `test/messages-read.test.ts` read-only legs | Before/after observable-state snapshots stay equal for list/show. | A read can satisfy shape assertions while still mutating queue, boundary, or view state. |\\n| CLI bypasses SDK | `test/cli-process-inspect.test.ts` process parity | Spawned commands compare serialized JSON against SDK results. | Private helper tests can pass while production CLI output diverges. |\\n\\n#### Technical Notes\\n\\n- `listMessages` option defaults must preserve existing callers: visible messages, unbounded, record order.\\n- `from` and `to` are source-event-order bounds; `limit` caps after bounds.\\n- `show` composes the by-id message read with `messages.report(ref, { messageId })`.\\n- Message search remains deferred post-v1 and gets no v1 placeholder behavior.\\n\\n#### Anti-Shim Requirements\\n\\n- Assert real full block content for tool-result messages, not only message id or metadata.\\n- Exercise the spawned `lhc messages` commands for process parity.\\n- Do not synthesize form state in `show`; use the owner report entries.\\n\\n#### Production Path Proof\\n\\n- Entrypoint: `messages.listMessages`, `messages.show`, `lhc messages list`, `lhc messages show`.\\n- Registration/default path: `src/sdk.ts` exposes the message operations; `src/cli/messages-read.ts` routes CLI commands to SDK calls.\\n- Evidence: process parity for CLI list/show and default-suite message read tests.\\n\\n#### Verification\\n\\n- Targeted: `pnpm verify`\\n- Story gate: `pnpm verify`\\n- Epic/process gate: `LHC_PROCESS_SUITE=1 pnpm verify-all`\\n\\n#### Spec Deviations\\n\\nNone.\\n\\n### Definition of Done\\n<!-- Jira: Definition of Done or Acceptance Criteria footer -->\\n- `messages.list` returns bounded, ordered message summaries with deleted filtering.\\n- `messages.show` returns full record content and owner-reported form state for one message.\\n- Deleted-message audit behavior matches Epic 02's deleted contract.\\n- CLI list/show options and JSON match SDK results.\\n- TC-3.1 through TC-3.4 pass with one primary owner in this story.\\n\",\"numLines\":127,\"startLine\":1,\"totalLines\":127}}}\n127:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01SJ8QEoT3GKMUnb9R7yNS8o\",\"type\":\"tool_result\",\"content\":\"1\\t// Story 1 (Epic 04), default suite: TC-3.1–3.3 — the message read surface.\\n2\\t// Bounded listing in source-event-order coordinates (DD-3), show returning\\n3\\t// the canonical record (full blocks, never view-shortened) composed with the\\n4\\t// owner report's form entries (DD-2), and the deleted-audit contract\\n5\\t// (excluded by default, listable flagged on request, show never not-found).\\n6\\t// Plus the architecture-risk legs: every read leaves observable state\\n7\\t// unchanged (read-only delta, DD-6) and calls no provider.\\n8\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n9\\timport {\\n10\\t  createSdk,\\n11\\t  intakeStream,\\n12\\t  messages,\\n13\\t  threadView,\\n14\\t  turns,\\n15\\t  type Lhc,\\n16\\t  type MessageEventInput,\\n17\\t} from \\\"../src/index.js\\\";\\n18\\timport {\\n19\\t  createProviderDouble,\\n20\\t  openRaw,\\n21\\t  poisonMessageBlockJson,\\n22\\t  poisonMessageFormJson,\\n23\\t  readDerivedForms,\\n24\\t  tempStore,\\n25\\t  validEvent,\\n26\\t  type TempStore,\\n27\\t} from \\\"./fixtures/index.js\\\";\\n28\\t\\n29\\t// Long enough that any view-form shortening would be visible: show must\\n30\\t// return this verbatim (AC-3.2's record-not-view contract).\\n31\\tconst TOOL_RESULT_CONTENT = [\\n32\\t  \\\"contents of notes.txt — full record content:\\\",\\n33\\t  \\\"line 1: the quick brown fox jumps over the lazy dog\\\",\\n34\\t  \\\"line 2: detailed tool output that a boundary-shortened form would drop\\\",\\n35\\t  \\\"line 3: trailing detail proving the record came back complete\\\",\\n36\\t].join(\\\"\\\\n\\\");\\n37\\t\\n38\\tinterface ReadFixture {\\n39\\t  filePath: string;\\n40\\t  sdk: Lhc;\\n41\\t  double: ReturnType<typeof createProviderDouble>;\\n42\\t}\\n43\\t\\n44\\t// Two closed turns through real intake, fully drained against the\\n45\\t// deterministic double so m1's smoothing and m3/m4's tool summaries sit\\n46\\t// ready with mechanically stamped outcome metadata. Messages: m1 prompt,\\n47\\t// m2 text, m3 call, m4 result (turn 1; turn_end is event 5, no message);\\n48\\t// m6 prompt, m7 text (turn 2). Source event orders 1,2,3,4,6,7.\\n49\\tasync function readFixture(store: TempStore): Promise<ReadFixture> {\\n50\\t  const double = createProviderDouble();\\n51\\t  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n52\\t  const filePath = store.threadPath();\\n53\\t  const created = await sdk.threads.newThread({\\n54\\t    filePath,\\n55\\t    registryPath: store.registryPath,\\n56\\t  });\\n57\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n58\\t  const batches: MessageEventInput[][] = [\\n59\\t    [\\n60\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"please read notes.txt\\\" } }),\\n61\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"reading it now\\\" } }),\\n62\\t      validEvent(\\\"tool_call\\\", {\\n63\\t        payload: {\\n64\\t          toolCallId: \\\"call-read-1\\\",\\n65\\t          toolName: \\\"read_file\\\",\\n66\\t          arguments: { path: \\\"notes.txt\\\" },\\n67\\t        },\\n68\\t      }),\\n69\\t      validEvent(\\\"tool_result\\\", {\\n70\\t        payload: { toolCallId: \\\"call-read-1\\\", content: TOOL_RESULT_CONTENT, isError: false },\\n71\\t      }),\\n72\\t      validEvent(\\\"turn_end\\\"),\\n73\\t    ],\\n74\\t    [\\n75\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"summarize what you read\\\" } }),\\n76\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"here is the summary\\\" } }),\\n77\\t      validEvent(\\\"turn_end\\\"),\\n78\\t    ],\\n79\\t  ];\\n80\\t  for (const batch of batches) {\\n81\\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n82\\t    if (!sent.ok) throw new Error(`fixture batch failed: ${sent.error.reason}`);\\n83\\t  }\\n84\\t  const drained = await sdk.work.drain({ filePath });\\n85\\t  if (!drained.ok) throw new Error(`fixture drain failed: ${drained.error.reason}`);\\n86\\t  if (drained.value.remaining !== 0) {\\n87\\t    throw new Error(`fixture drain left ${drained.value.remaining} items behind`);\\n88\\t  }\\n89\\t  return { filePath, sdk, double };\\n90\\t}\\n91\\t\\n92\\tfunction idsOf(result: { ok: boolean }): string[] {\\n93\\t  if (!result.ok) throw new Error(\\\"expected an ok list result\\\");\\n94\\t  return (result as { ok: true; value: Array<{ messageId: string }> }).value.map(\\n95\\t    (record) => record.messageId,\\n96\\t  );\\n97\\t}\\n98\\t\\n99\\t// The DD-6 observable-state snapshot: queued work through both owners, view\\n100\\t// boundary/zone through status, derived-form rows, and the event log. A read\\n101\\t// that mutates any of these fails the before/after deep-equal.\\n102\\tasync function observableState(filePath: string): Promise<Record<string, unknown>> {\\n103\\t  return {\\n104\\t    events: await intakeStream.listEvents({ filePath }),\\n105\\t    messageWork: await messages.listQueuedWork({ filePath }),\\n106\\t    turnWork: await turns.listQueuedWork({ filePath }),\\n107\\t    viewStatus: await threadView.status({ filePath }),\\n108\\t    forms: readDerivedForms(filePath),\\n109\\t  };\\n110\\t}\\n111\\t\\n112\\tlet store: TempStore;\\n113\\tbeforeEach(() => {\\n114\\t  store = tempStore();\\n115\\t});\\n116\\tafterEach(() => {\\n117\\t  store.cleanup();\\n118\\t});\\n119\\t\\n120\\tdescribe(\\\"TC-3.1 / AC-3.1: listing order, fields, and bounds\\\", () => {\\n121\\t  it(\\\"returns messages in record order with kind, token estimate, and turn membership\\\", async () => {\\n122\\t    const { filePath } = await readFixture(store);\\n123\\t    const listed = await messages.listMessages({ filePath });\\n124\\t    expect(listed.ok).toBe(true);\\n125\\t    if (!listed.ok) return;\\n126\\t    expect(listed.value.map((m) => m.messageId)).toEqual([\\n127\\t      \\\"m1\\\",\\n128\\t      \\\"m2\\\",\\n129\\t      \\\"m3\\\",\\n130\\t      \\\"m4\\\",\\n131\\t      \\\"m6\\\",\\n132\\t      \\\"m7\\\",\\n133\\t    ]);\\n134\\t    expect(listed.value.map((m) => m.sourceEventOrder)).toEqual([1, 2, 3, 4, 6, 7]);\\n135\\t    expect(listed.value.map((m) => m.kind)).toEqual([\\n136\\t      \\\"user_prompt\\\",\\n137\\t      \\\"assistant_text\\\",\\n138\\t      \\\"tool_call\\\",\\n139\\t      \\\"tool_result\\\",\\n140\\t      \\\"user_prompt\\\",\\n141\\t      \\\"assistant_text\\\",\\n142\\t    ]);\\n143\\t    expect(listed.value.map((m) => m.turnId)).toEqual([\\\"t1\\\", \\\"t1\\\", \\\"t1\\\", \\\"t1\\\", \\\"t2\\\", \\\"t2\\\"]);\\n144\\t    for (const record of listed.value) {\\n145\\t      expect(record.tokenEstimate).toBeGreaterThan(0);\\n146\\t      expect(record.deleted).toBeUndefined();\\n147\\t    }\\n148\\t  });\\n149\\t\\n150\\t  it(\\\"honors from/to/limit windows exactly in source-event-order coordinates\\\", async () => {\\n151\\t    const { filePath } = await readFixture(store);\\n152\\t    const windows: Array<[Parameters<typeof messages.listMessages>[1], string[]]> = [\\n153\\t      [{ from: 2, to: 4 }, [\\\"m2\\\", \\\"m3\\\", \\\"m4\\\"]],\\n154\\t      [{ from: 6 }, [\\\"m6\\\", \\\"m7\\\"]],\\n155\\t      [{ to: 2 }, [\\\"m1\\\", \\\"m2\\\"]],\\n156\\t      [{ limit: 3 }, [\\\"m1\\\", \\\"m2\\\", \\\"m3\\\"]],\\n157\\t      [{ from: 2, limit: 2 }, [\\\"m2\\\", \\\"m3\\\"]],\\n158\\t      [{ from: 4, to: 4 }, [\\\"m4\\\"]],\\n159\\t      [{ from: 5, to: 5 }, []], // the turn_end order: an event, never a message\\n160\\t    ];\\n161\\t    for (const [opts, expected] of windows) {\\n162\\t      expect(idsOf(await messages.listMessages({ filePath }, opts))).toEqual(expected);\\n163\\t    }\\n164\\t  });\\n165\\t\\n166\\t  it(\\\"refuses bad bounds as caller errors and returns no partial window\\\", async () => {\\n167\\t    const { filePath } = await readFixture(store);\\n168\\t    const badBounds = [{ from: 5, to: 2 }, { limit: 0 }, { limit: -1 }, { from: 1.5 }];\\n169\\t    for (const opts of badBounds) {\\n170\\t      const refused = await messages.listMessages({ filePath }, opts);\\n171\\t      expect(refused.ok).toBe(false);\\n172\\t      if (refused.ok) continue;\\n173\\t      expect(refused.error.errorClass).toBe(\\\"caller_error\\\");\\n174\\t      expect(refused.error.code).toBe(\\\"invalid_bounds\\\");\\n175\\t    }\\n176\\t  });\\n177\\t});\\n178\\t\\n179\\tdescribe(\\\"TC-3.2 / AC-3.2: show returns the full record with owner-reported forms\\\", () => {\\n180\\t  it(\\\"a drained tool-result message comes back with full content, form states, and outcome metadata\\\", async () => {\\n181\\t    const { filePath } = await readFixture(store);\\n182\\t    const shown = await messages.show({ filePath }, \\\"m4\\\");\\n183\\t    expect(shown.ok).toBe(true);\\n184\\t    if (!shown.ok) return;\\n185\\t    const detail = shown.value;\\n186\\t    expect(detail.messageId).toBe(\\\"m4\\\");\\n187\\t    expect(detail.kind).toBe(\\\"tool_result\\\");\\n188\\t    expect(detail.turnId).toBe(\\\"t1\\\");\\n189\\t    expect(detail.deleted).toBe(false);\\n190\\t    expect(detail.tokenEstimate).toBeGreaterThan(0);\\n191\\t    // The record, not the view: the complete original tool result verbatim.\\n192\\t    expect(detail.blocks).toHaveLength(1);\\n193\\t    expect(detail.blocks[0]?.blockType).toBe(\\\"tool_result\\\");\\n194\\t    expect(detail.blocks[0]?.content[\\\"content\\\"]).toBe(TOOL_RESULT_CONTENT);\\n195\\t    expect(detail.blocks[0]?.content[\\\"toolCallId\\\"]).toBe(\\\"call-read-1\\\");\\n196\\t    // Forms with states and tool-outcome metadata, joined from the owner.\\n197\\t    expect(detail.forms).toHaveLength(1);\\n198\\t    const summary = detail.forms[0];\\n199\\t    expect(summary?.form).toBe(\\\"tool_result_summary\\\");\\n200\\t    expect(summary?.state).toBe(\\\"ready\\\");\\n201\\t    expect(summary?.content).toBeDefined();\\n202\\t    expect(summary?.metadata?.outcome).toBe(\\\"succeeded\\\");\\n203\\t    // Anti-shim: the forms ARE the owner report's entries for this message,\\n204\\t    // never a synthesized join (DD-2).\\n205\\t    const report = await messages.report({ filePath }, { messageId: \\\"m4\\\" });\\n206\\t    expect(report.ok).toBe(true);\\n207\\t    if (!report.ok) return;\\n208\\t    expect(detail.forms).toEqual(report.value);\\n209\\t  });\\n210\\t\\n211\\t  it(\\\"a drained prompt shows its smoothing form alongside the full record\\\", async () => {\\n212\\t    const { filePath } = await readFixture(store);\\n213\\t    const shown = await messages.show({ filePath }, \\\"m1\\\");\\n214\\t    expect(shown.ok).toBe(true);\\n215\\t    if (!shown.ok) return;\\n216\\t    expect(shown.value.blocks[0]?.content[\\\"text\\\"]).toBe(\\\"please read notes.txt\\\");\\n217\\t    expect(shown.value.forms.map((form) => [form.form, form.state])).toEqual([\\n218\\t      [\\\"smoothed_prompt\\\", \\\"ready\\\"],\\n219\\t    ]);\\n220\\t  });\\n221\\t});\\n222\\t\\n223\\tdescribe(\\\"TC-3.3 / AC-3.3: deleted messages are audit-visible, never silently mixed\\\", () => {\\n224\\t  it(\\\"default list excludes a deleted message; include-deleted lists it marked; show returns it flagged\\\", async () => {\\n225\\t    const { filePath } = await readFixture(store);\\n226\\t    const deleted = await messages.deleteMessage({ filePath }, { messageId: \\\"m2\\\" });\\n227\\t    expect(deleted.ok).toBe(true);\\n228\\t\\n229\\t    const defaultList = await messages.listMessages({ filePath });\\n230\\t    expect(idsOf(defaultList)).toEqual([\\\"m1\\\", \\\"m3\\\", \\\"m4\\\", \\\"m6\\\", \\\"m7\\\"]);\\n231\\t\\n232\\t    const audited = await messages.listMessages({ filePath }, { includeDeleted: true });\\n233\\t    expect(audited.ok).toBe(true);\\n234\\t    if (!audited.ok) return;\\n235\\t    expect(audited.value.map((m) => m.messageId)).toEqual([\\n236\\t      \\\"m1\\\",\\n237\\t      \\\"m2\\\",\\n238\\t      \\\"m3\\\",\\n239\\t      \\\"m4\\\",\\n240\\t      \\\"m6\\\",\\n241\\t      \\\"m7\\\",\\n242\\t    ]);\\n243\\t    for (const record of audited.value) {\\n244\\t      if (record.messageId === \\\"m2\\\") expect(record.deleted).toBe(true);\\n245\\t      else expect(record.deleted).toBeUndefined();\\n246\\t    }\\n247\\t\\n248\\t    // Show on the deleted message is the audit read: the record, flagged —\\n249\\t    // never a not-found.\\n250\\t    const shown = await messages.show({ filePath }, \\\"m2\\\");\\n251\\t    expect(shown.ok).toBe(true);\\n252\\t    if (!shown.ok) return;\\n253\\t    expect(shown.value.deleted).toBe(true);\\n254\\t    expect(shown.value.blocks[0]?.content[\\\"text\\\"]).toBe(\\\"reading it now\\\");\\n255\\t  });\\n256\\t\\n257\\t  it(\\\"show on a missing id is message_not_found\\\", async () => {\\n258\\t    const { filePath } = await readFixture(store);\\n259\\t    const missing = await messages.show({ filePath }, \\\"m99\\\");\\n260\\t    expect(missing.ok).toBe(false);\\n261\\t    if (missing.ok) return;\\n262\\t    expect(missing.error.errorClass).toBe(\\\"caller_error\\\");\\n263\\t    expect(missing.error.code).toBe(\\\"message_not_found\\\");\\n264\\t  });\\n265\\t});\\n266\\t\\n267\\tdescribe(\\\"architecture risk: reads are read-only and provider-free (DD-6)\\\", () => {\\n268\\t  it(\\\"list and show in every mode leave observable state unchanged and call no provider\\\", async () => {\\n269\\t    const { filePath, double } = await readFixture(store);\\n270\\t    const captured = double.captureInputs();\\n271\\t    const before = await observableState(filePath);\\n272\\t\\n273\\t    await messages.listMessages({ filePath });\\n274\\t    await messages.listMessages({ filePath }, { from: 2, to: 4, limit: 2 });\\n275\\t    await messages.listMessages({ filePath }, { includeDeleted: true });\\n276\\t    await messages.listMessages({ filePath }, { from: 9, to: 1 }); // refused, must not write either\\n277\\t    await messages.show({ filePath }, \\\"m4\\\");\\n278\\t    await messages.show({ filePath }, \\\"m99\\\"); // not-found, must not write either\\n279\\t\\n280\\t    const after = await observableState(filePath);\\n281\\t    expect(after).toEqual(before);\\n282\\t    expect(captured).toHaveLength(0);\\n283\\t  });\\n284\\t});\\n285\\t\\n286\\t// A thread with live, undrained work: one tool turn through a manual SDK\\n287\\t// (its no-op seam never drains), leaving three pending forms and their queue\\n288\\t// rows. The background read-only proof needs the pending state the manual\\n289\\t// read-only proof above cannot manufacture.\\n290\\tasync function pendingWorkThread(): Promise<string> {\\n291\\t  const seeder = createSdk({ provider: createProviderDouble(), mode: \\\"manual\\\" });\\n292\\t  const filePath = store.threadPath();\\n293\\t  const created = await seeder.threads.newThread({\\n294\\t    filePath,\\n295\\t    registryPath: store.registryPath,\\n296\\t  });\\n297\\t  if (!created.ok) throw new Error(`pending fixture thread creation failed: ${created.error.reason}`);\\n298\\t  const sent = await seeder.intakeStream.messageEvents({ filePath }, [\\n299\\t    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"background prompt\\\" } }),\\n300\\t    validEvent(\\\"tool_call\\\", {\\n301\\t      payload: { toolCallId: \\\"call-bg-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"bg.txt\\\" } },\\n302\\t    }),\\n303\\t    validEvent(\\\"tool_result\\\", {\\n304\\t      payload: { toolCallId: \\\"call-bg-1\\\", content: \\\"background output\\\", isError: false },\\n305\\t    }),\\n306\\t    validEvent(\\\"assistant_text\\\", { payload: { text: \\\"background answer\\\" } }),\\n307\\t    validEvent(\\\"turn_end\\\"),\\n308\\t  ]);\\n309\\t  if (!sent.ok) throw new Error(`pending fixture intake failed: ${sent.error.reason}`);\\n310\\t  return filePath;\\n311\\t}\\n312\\t\\n313\\t// Below-SDK raw snapshot of everything a wrongly-scheduled catch-up drain\\n314\\t// would move: work-item rows and derived-form states. Read through a raw\\n315\\t// handle (openRaw), never the SDK ops — those would fire their own touch and\\n316\\t// pollute the very state under test.\\n317\\tfunction rawWorkAndForms(filePath: string): Record<string, unknown> {\\n318\\t  const db = openRaw(filePath);\\n319\\t  try {\\n320\\t    return {\\n321\\t      workItems: db\\n322\\t        .prepare(`SELECT work_item_id, status, attempts FROM work_item ORDER BY work_item_id`)\\n323\\t        .all(),\\n324\\t      forms: db\\n325\\t        .prepare(\\n326\\t          `SELECT subject_id, form, state, source_version FROM derived_form\\n327\\t           ORDER BY subject_id, form`,\\n328\\t        )\\n329\\t        .all(),\\n330\\t    };\\n331\\t  } finally {\\n332\\t    db.close();\\n333\\t  }\\n334\\t}\\n335\\t\\n336\\tdescribe(\\\"architecture risk: background reads schedule no catch-up drain (DD-6, SV-01-001)\\\", () => {\\n337\\t  it(\\\"list and show through a background SDK with pending work call no provider and advance no form\\\", async () => {\\n338\\t    const filePath = await pendingWorkThread();\\n339\\t\\n340\\t    // A fresh background SDK whose scheduler WOULD hang a first-touch catch-up\\n341\\t    // drain — and the provider call that drain makes — off the open\\n342\\t    // announcement (openThreadDatabase → fireThreadTouch → scheduler.touch) if\\n343\\t    // list or show fired it. The touch-suppressed read scope is what stops it;\\n344\\t    // this is the production-path proof a manual-mode no-op seam cannot give.\\n345\\t    const bgDouble = createProviderDouble();\\n346\\t    const bg = createSdk({ provider: bgDouble, mode: \\\"background\\\" });\\n347\\t    const captured = bgDouble.captureInputs();\\n348\\t    const before = rawWorkAndForms(filePath);\\n349\\t\\n350\\t    const listed = await bg.messages.listMessages({ filePath });\\n351\\t    await bg.messages.listMessages({ filePath }, { limit: 1 });\\n352\\t    const shown = await bg.messages.show({ filePath }, \\\"m1\\\");\\n353\\t    expect(listed.ok && shown.ok).toBe(true);\\n354\\t    if (!listed.ok || !shown.ok) return;\\n355\\t\\n356\\t    // The reads ran against the live, undrained queue — the records carry\\n357\\t    // their pending forms — so this is no vacuous pass on an empty thread.\\n358\\t    const listedForms = listed.value.flatMap((m) => m.forms ?? []);\\n359\\t    expect(listedForms.length).toBeGreaterThan(0);\\n360\\t    expect(listedForms.every((form) => form.state === \\\"pending\\\")).toBe(true);\\n361\\t    expect(shown.value.forms.map((form) => form.state)).toEqual([\\\"pending\\\"]);\\n362\\t\\n363\\t    // Give any wrongly-scheduled catch-up drain room to surface, then wait the\\n364\\t    // scheduler out before asserting nothing moved underneath the reads.\\n365\\t    await new Promise((resolve) => setTimeout(resolve, 25));\\n366\\t    await bg.drainSettled({ filePath });\\n367\\t\\n368\\t    // Reads only: every work-item and form row is exactly as before, and the\\n369\\t    // background provider observed zero calls — no first-touch drain fired.\\n370\\t    expect(rawWorkAndForms(filePath)).toEqual(before);\\n371\\t    expect(captured).toHaveLength(0);\\n372\\t  });\\n373\\t});\\n374\\t\\n375\\tdescribe(\\\"architecture risk: bounded listing loads only its window (AC-3.1, SV-01-002)\\\", () => {\\n376\\t  it(\\\"a bounded list excluding out-of-window rows never loads their blocks or forms\\\", async () => {\\n377\\t    const { filePath } = await readFixture(store);\\n378\\t    // Corrupt content the bounds must exclude: m7's block (an out-of-window\\n379\\t    // message) and m4's tool-result-summary metadata (an out-of-window form).\\n380\\t    // Any read that loads either row throws on JSON.parse, so a bounded list\\n381\\t    // that still succeeds proves it never read outside its window.\\n382\\t    poisonMessageBlockJson(filePath, \\\"m7\\\");\\n383\\t    poisonMessageFormJson(filePath, \\\"m4\\\");\\n384\\t\\n385\\t    // In-window reads succeed and return exactly the window — the poisoned\\n386\\t    // rows are sourced neither as blocks nor as forms.\\n387\\t    for (const opts of [{ to: 1 }, { limit: 1 }] as const) {\\n388\\t      const bounded = await messages.listMessages({ filePath }, opts);\\n389\\t      expect(bounded.ok).toBe(true);\\n390\\t      if (!bounded.ok) return;\\n391\\t      expect(bounded.value.map((m) => m.messageId)).toEqual([\\\"m1\\\"]);\\n392\\t      expect(bounded.value[0]?.blocks[0]?.content[\\\"text\\\"]).toBe(\\\"please read notes.txt\\\");\\n393\\t    }\\n394\\t\\n395\\t    // Positive controls: a window that *includes* a poisoned row does load it\\n396\\t    // and fails on parse — proof the pills are real, so the passes above are\\n397\\t    // genuine no-loads, not silently-dropped output.\\n398\\t    const hitsBlock = await messages.listMessages({ filePath }, { from: 7 });\\n399\\t    expect(hitsBlock.ok).toBe(false);\\n400\\t    const hitsForm = await messages.listMessages({ filePath }, { from: 4, to: 4 });\\n401\\t    expect(hitsForm.ok).toBe(false);\\n402\\t  });\\n403\\t});\\n404\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"uuid\":\"4b3be8a8-ca91-4c11-852b-e02aa44a56a6\",\"timestamp\":\"2026-06-12T13:24:18.421Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/messages-read.test.ts\",\"content\":\"// Story 1 (Epic 04), default suite: TC-3.1–3.3 — the message read surface.\\n// Bounded listing in source-event-order coordinates (DD-3), show returning\\n// the canonical record (full blocks, never view-shortened) composed with the\\n// owner report's form entries (DD-2), and the deleted-audit contract\\n// (excluded by default, listable flagged on request, show never not-found).\\n// Plus the architecture-risk legs: every read leaves observable state\\n// unchanged (read-only delta, DD-6) and calls no provider.\\nimport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  createSdk,\\n  intakeStream,\\n  messages,\\n  threadView,\\n  turns,\\n  type Lhc,\\n  type MessageEventInput,\\n} from \\\"../src/index.js\\\";\\nimport {\\n  createProviderDouble,\\n  openRaw,\\n  poisonMessageBlockJson,\\n  poisonMessageFormJson,\\n  readDerivedForms,\\n  tempStore,\\n  validEvent,\\n  type TempStore,\\n} from \\\"./fixtures/index.js\\\";\\n\\n// Long enough that any view-form shortening would be visible: show must\\n// return this verbatim (AC-3.2's record-not-view contract).\\nconst TOOL_RESULT_CONTENT = [\\n  \\\"contents of notes.txt — full record content:\\\",\\n  \\\"line 1: the quick brown fox jumps over the lazy dog\\\",\\n  \\\"line 2: detailed tool output that a boundary-shortened form would drop\\\",\\n  \\\"line 3: trailing detail proving the record came back complete\\\",\\n].join(\\\"\\\\n\\\");\\n\\ninterface ReadFixture {\\n  filePath: string;\\n  sdk: Lhc;\\n  double: ReturnType<typeof createProviderDouble>;\\n}\\n\\n// Two closed turns through real intake, fully drained against the\\n// deterministic double so m1's smoothing and m3/m4's tool summaries sit\\n// ready with mechanically stamped outcome metadata. Messages: m1 prompt,\\n// m2 text, m3 call, m4 result (turn 1; turn_end is event 5, no message);\\n// m6 prompt, m7 text (turn 2). Source event orders 1,2,3,4,6,7.\\nasync function readFixture(store: TempStore): Promise<ReadFixture> {\\n  const double = createProviderDouble();\\n  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n  const filePath = store.threadPath();\\n  const created = await sdk.threads.newThread({\\n    filePath,\\n    registryPath: store.registryPath,\\n  });\\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n  const batches: MessageEventInput[][] = [\\n    [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"please read notes.txt\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"reading it now\\\" } }),\\n      validEvent(\\\"tool_call\\\", {\\n        payload: {\\n          toolCallId: \\\"call-read-1\\\",\\n          toolName: \\\"read_file\\\",\\n          arguments: { path: \\\"notes.txt\\\" },\\n        },\\n      }),\\n      validEvent(\\\"tool_result\\\", {\\n        payload: { toolCallId: \\\"call-read-1\\\", content: TOOL_RESULT_CONTENT, isError: false },\\n      }),\\n      validEvent(\\\"turn_end\\\"),\\n    ],\\n    [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"summarize what you read\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"here is the summary\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ],\\n  ];\\n  for (const batch of batches) {\\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n    if (!sent.ok) throw new Error(`fixture batch failed: ${sent.error.reason}`);\\n  }\\n  const drained = await sdk.work.drain({ filePath });\\n  if (!drained.ok) throw new Error(`fixture drain failed: ${drained.error.reason}`);\\n  if (drained.value.remaining !== 0) {\\n    throw new Error(`fixture drain left ${drained.value.remaining} items behind`);\\n  }\\n  return { filePath, sdk, double };\\n}\\n\\nfunction idsOf(result: { ok: boolean }): string[] {\\n  if (!result.ok) throw new Error(\\\"expected an ok list result\\\");\\n  return (result as { ok: true; value: Array<{ messageId: string }> }).value.map(\\n    (record) => record.messageId,\\n  );\\n}\\n\\n// The DD-6 observable-state snapshot: queued work through both owners, view\\n// boundary/zone through status, derived-form rows, and the event log. A read\\n// that mutates any of these fails the before/after deep-equal.\\nasync function observableState(filePath: string): Promise<Record<string, unknown>> {\\n  return {\\n    events: await intakeStream.listEvents({ filePath }),\\n    messageWork: await messages.listQueuedWork({ filePath }),\\n    turnWork: await turns.listQueuedWork({ filePath }),\\n    viewStatus: await threadView.status({ filePath }),\\n    forms: readDerivedForms(filePath),\\n  };\\n}\\n\\nlet store: TempStore;\\nbeforeEach(() => {\\n  store = tempStore();\\n});\\nafterEach(() => {\\n  store.cleanup();\\n});\\n\\ndescribe(\\\"TC-3.1 / AC-3.1: listing order, fields, and bounds\\\", () => {\\n  it(\\\"returns messages in record order with kind, token estimate, and turn membership\\\", async () => {\\n    const { filePath } = await readFixture(store);\\n    const listed = await messages.listMessages({ filePath });\\n    expect(listed.ok).toBe(true);\\n    if (!listed.ok) return;\\n    expect(listed.value.map((m) => m.messageId)).toEqual([\\n      \\\"m1\\\",\\n      \\\"m2\\\",\\n      \\\"m3\\\",\\n      \\\"m4\\\",\\n      \\\"m6\\\",\\n      \\\"m7\\\",\\n    ]);\\n    expect(listed.value.map((m) => m.sourceEventOrder)).toEqual([1, 2, 3, 4, 6, 7]);\\n    expect(listed.value.map((m) => m.kind)).toEqual([\\n      \\\"user_prompt\\\",\\n      \\\"assistant_text\\\",\\n      \\\"tool_call\\\",\\n      \\\"tool_result\\\",\\n      \\\"user_prompt\\\",\\n      \\\"assistant_text\\\",\\n    ]);\\n    expect(listed.value.map((m) => m.turnId)).toEqual([\\\"t1\\\", \\\"t1\\\", \\\"t1\\\", \\\"t1\\\", \\\"t2\\\", \\\"t2\\\"]);\\n    for (const record of listed.value) {\\n      expect(record.tokenEstimate).toBeGreaterThan(0);\\n      expect(record.deleted).toBeUndefined();\\n    }\\n  });\\n\\n  it(\\\"honors from/to/limit windows exactly in source-event-order coordinates\\\", async () => {\\n    const { filePath } = await readFixture(store);\\n    const windows: Array<[Parameters<typeof messages.listMessages>[1], string[]]> = [\\n      [{ from: 2, to: 4 }, [\\\"m2\\\", \\\"m3\\\", \\\"m4\\\"]],\\n      [{ from: 6 }, [\\\"m6\\\", \\\"m7\\\"]],\\n      [{ to: 2 }, [\\\"m1\\\", \\\"m2\\\"]],\\n      [{ limit: 3 }, [\\\"m1\\\", \\\"m2\\\", \\\"m3\\\"]],\\n      [{ from: 2, limit: 2 }, [\\\"m2\\\", \\\"m3\\\"]],\\n      [{ from: 4, to: 4 }, [\\\"m4\\\"]],\\n      [{ from: 5, to: 5 }, []], // the turn_end order: an event, never a message\\n    ];\\n    for (const [opts, expected] of windows) {\\n      expect(idsOf(await messages.listMessages({ filePath }, opts))).toEqual(expected);\\n    }\\n  });\\n\\n  it(\\\"refuses bad bounds as caller errors and returns no partial window\\\", async () => {\\n    const { filePath } = await readFixture(store);\\n    const badBounds = [{ from: 5, to: 2 }, { limit: 0 }, { limit: -1 }, { from: 1.5 }];\\n    for (const opts of badBounds) {\\n      const refused = await messages.listMessages({ filePath }, opts);\\n      expect(refused.ok).toBe(false);\\n      if (refused.ok) continue;\\n      expect(refused.error.errorClass).toBe(\\\"caller_error\\\");\\n      expect(refused.error.code).toBe(\\\"invalid_bounds\\\");\\n    }\\n  });\\n});\\n\\ndescribe(\\\"TC-3.2 / AC-3.2: show returns the full record with owner-reported forms\\\", () => {\\n  it(\\\"a drained tool-result message comes back with full content, form states, and outcome metadata\\\", async () => {\\n    const { filePath } = await readFixture(store);\\n    const shown = await messages.show({ filePath }, \\\"m4\\\");\\n    expect(shown.ok).toBe(true);\\n    if (!shown.ok) return;\\n    const detail = shown.value;\\n    expect(detail.messageId).toBe(\\\"m4\\\");\\n    expect(detail.kind).toBe(\\\"tool_result\\\");\\n    expect(detail.turnId).toBe(\\\"t1\\\");\\n    expect(detail.deleted).toBe(false);\\n    expect(detail.tokenEstimate).toBeGreaterThan(0);\\n    // The record, not the view: the complete original tool result verbatim.\\n    expect(detail.blocks).toHaveLength(1);\\n    expect(detail.blocks[0]?.blockType).toBe(\\\"tool_result\\\");\\n    expect(detail.blocks[0]?.content[\\\"content\\\"]).toBe(TOOL_RESULT_CONTENT);\\n    expect(detail.blocks[0]?.content[\\\"toolCallId\\\"]).toBe(\\\"call-read-1\\\");\\n    // Forms with states and tool-outcome metadata, joined from the owner.\\n    expect(detail.forms).toHaveLength(1);\\n    const summary = detail.forms[0];\\n    expect(summary?.form).toBe(\\\"tool_result_summary\\\");\\n    expect(summary?.state).toBe(\\\"ready\\\");\\n    expect(summary?.content).toBeDefined();\\n    expect(summary?.metadata?.outcome).toBe(\\\"succeeded\\\");\\n    // Anti-shim: the forms ARE the owner report's entries for this message,\\n    // never a synthesized join (DD-2).\\n    const report = await messages.report({ filePath }, { messageId: \\\"m4\\\" });\\n    expect(report.ok).toBe(true);\\n    if (!report.ok) return;\\n    expect(detail.forms).toEqual(report.value);\\n  });\\n\\n  it(\\\"a drained prompt shows its smoothing form alongside the full record\\\", async () => {\\n    const { filePath } = await readFixture(store);\\n    const shown = await messages.show({ filePath }, \\\"m1\\\");\\n    expect(shown.ok).toBe(true);\\n    if (!shown.ok) return;\\n    expect(shown.value.blocks[0]?.content[\\\"text\\\"]).toBe(\\\"please read notes.txt\\\");\\n    expect(shown.value.forms.map((form) => [form.form, form.state])).toEqual([\\n      [\\\"smoothed_prompt\\\", \\\"ready\\\"],\\n    ]);\\n  });\\n});\\n\\ndescribe(\\\"TC-3.3 / AC-3.3: deleted messages are audit-visible, never silently mixed\\\", () => {\\n  it(\\\"default list excludes a deleted message; include-deleted lists it marked; show returns it flagged\\\", async () => {\\n    const { filePath } = await readFixture(store);\\n    const deleted = await messages.deleteMessage({ filePath }, { messageId: \\\"m2\\\" });\\n    expect(deleted.ok).toBe(true);\\n\\n    const defaultList = await messages.listMessages({ filePath });\\n    expect(idsOf(defaultList)).toEqual([\\\"m1\\\", \\\"m3\\\", \\\"m4\\\", \\\"m6\\\", \\\"m7\\\"]);\\n\\n    const audited = await messages.listMessages({ filePath }, { includeDeleted: true });\\n    expect(audited.ok).toBe(true);\\n    if (!audited.ok) return;\\n    expect(audited.value.map((m) => m.messageId)).toEqual([\\n      \\\"m1\\\",\\n      \\\"m2\\\",\\n      \\\"m3\\\",\\n      \\\"m4\\\",\\n      \\\"m6\\\",\\n      \\\"m7\\\",\\n    ]);\\n    for (const record of audited.value) {\\n      if (record.messageId === \\\"m2\\\") expect(record.deleted).toBe(true);\\n      else expect(record.deleted).toBeUndefined();\\n    }\\n\\n    // Show on the deleted message is the audit read: the record, flagged —\\n    // never a not-found.\\n    const shown = await messages.show({ filePath }, \\\"m2\\\");\\n    expect(shown.ok).toBe(true);\\n    if (!shown.ok) return;\\n    expect(shown.value.deleted).toBe(true);\\n    expect(shown.value.blocks[0]?.content[\\\"text\\\"]).toBe(\\\"reading it now\\\");\\n  });\\n\\n  it(\\\"show on a missing id is message_not_found\\\", async () => {\\n    const { filePath } = await readFixture(store);\\n    const missing = await messages.show({ filePath }, \\\"m99\\\");\\n    expect(missing.ok).toBe(false);\\n    if (missing.ok) return;\\n    expect(missing.error.errorClass).toBe(\\\"caller_error\\\");\\n    expect(missing.error.code).toBe(\\\"message_not_found\\\");\\n  });\\n});\\n\\ndescribe(\\\"architecture risk: reads are read-only and provider-free (DD-6)\\\", () => {\\n  it(\\\"list and show in every mode leave observable state unchanged and call no provider\\\", async () => {\\n    const { filePath, double } = await readFixture(store);\\n    const captured = double.captureInputs();\\n    const before = await observableState(filePath);\\n\\n    await messages.listMessages({ filePath });\\n    await messages.listMessages({ filePath }, { from: 2, to: 4, limit: 2 });\\n    await messages.listMessages({ filePath }, { includeDeleted: true });\\n    await messages.listMessages({ filePath }, { from: 9, to: 1 }); // refused, must not write either\\n    await messages.show({ filePath }, \\\"m4\\\");\\n    await messages.show({ filePath }, \\\"m99\\\"); // not-found, must not write either\\n\\n    const after = await observableState(filePath);\\n    expect(after).toEqual(before);\\n    expect(captured).toHaveLength(0);\\n  });\\n});\\n\\n// A thread with live, undrained work: one tool turn through a manual SDK\\n// (its no-op seam never drains), leaving three pending forms and their queue\\n// rows. The background read-only proof needs the pending state the manual\\n// read-only proof above cannot manufacture.\\nasync function pendingWorkThread(): Promise<string> {\\n  const seeder = createSdk({ provider: createProviderDouble(), mode: \\\"manual\\\" });\\n  const filePath = store.threadPath();\\n  const created = await seeder.threads.newThread({\\n    filePath,\\n    registryPath: store.registryPath,\\n  });\\n  if (!created.ok) throw new Error(`pending fixture thread creation failed: ${created.error.reason}`);\\n  const sent = await seeder.intakeStream.messageEvents({ filePath }, [\\n    validEvent(\\\"user_prompt\\\", { payload: { text: \\\"background prompt\\\" } }),\\n    validEvent(\\\"tool_call\\\", {\\n      payload: { toolCallId: \\\"call-bg-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"bg.txt\\\" } },\\n    }),\\n    validEvent(\\\"tool_result\\\", {\\n      payload: { toolCallId: \\\"call-bg-1\\\", content: \\\"background output\\\", isError: false },\\n    }),\\n    validEvent(\\\"assistant_text\\\", { payload: { text: \\\"background answer\\\" } }),\\n    validEvent(\\\"turn_end\\\"),\\n  ]);\\n  if (!sent.ok) throw new Error(`pending fixture intake failed: ${sent.error.reason}`);\\n  return filePath;\\n}\\n\\n// Below-SDK raw snapshot of everything a wrongly-scheduled catch-up drain\\n// would move: work-item rows and derived-form states. Read through a raw\\n// handle (openRaw), never the SDK ops — those would fire their own touch and\\n// pollute the very state under test.\\nfunction rawWorkAndForms(filePath: string): Record<string, unknown> {\\n  const db = openRaw(filePath);\\n  try {\\n    return {\\n      workItems: db\\n        .prepare(`SELECT work_item_id, status, attempts FROM work_item ORDER BY work_item_id`)\\n        .all(),\\n      forms: db\\n        .prepare(\\n          `SELECT subject_id, form, state, source_version FROM derived_form\\n           ORDER BY subject_id, form`,\\n        )\\n        .all(),\\n    };\\n  } finally {\\n    db.close();\\n  }\\n}\\n\\ndescribe(\\\"architecture risk: background reads schedule no catch-up drain (DD-6, SV-01-001)\\\", () => {\\n  it(\\\"list and show through a background SDK with pending work call no provider and advance no form\\\", async () => {\\n    const filePath = await pendingWorkThread();\\n\\n    // A fresh background SDK whose scheduler WOULD hang a first-touch catch-up\\n    // drain — and the provider call that drain makes — off the open\\n    // announcement (openThreadDatabase → fireThreadTouch → scheduler.touch) if\\n    // list or show fired it. The touch-suppressed read scope is what stops it;\\n    // this is the production-path proof a manual-mode no-op seam cannot give.\\n    const bgDouble = createProviderDouble();\\n    const bg = createSdk({ provider: bgDouble, mode: \\\"background\\\" });\\n    const captured = bgDouble.captureInputs();\\n    const before = rawWorkAndForms(filePath);\\n\\n    const listed = await bg.messages.listMessages({ filePath });\\n    await bg.messages.listMessages({ filePath }, { limit: 1 });\\n    const shown = await bg.messages.show({ filePath }, \\\"m1\\\");\\n    expect(listed.ok && shown.ok).toBe(true);\\n    if (!listed.ok || !shown.ok) return;\\n\\n    // The reads ran against the live, undrained queue — the records carry\\n    // their pending forms — so this is no vacuous pass on an empty thread.\\n    const listedForms = listed.value.flatMap((m) => m.forms ?? []);\\n    expect(listedForms.length).toBeGreaterThan(0);\\n    expect(listedForms.every((form) => form.state === \\\"pending\\\")).toBe(true);\\n    expect(shown.value.forms.map((form) => form.state)).toEqual([\\\"pending\\\"]);\\n\\n    // Give any wrongly-scheduled catch-up drain room to surface, then wait the\\n    // scheduler out before asserting nothing moved underneath the reads.\\n    await new Promise((resolve) => setTimeout(resolve, 25));\\n    await bg.drainSettled({ filePath });\\n\\n    // Reads only: every work-item and form row is exactly as before, and the\\n    // background provider observed zero calls — no first-touch drain fired.\\n    expect(rawWorkAndForms(filePath)).toEqual(before);\\n    expect(captured).toHaveLength(0);\\n  });\\n});\\n\\ndescribe(\\\"architecture risk: bounded listing loads only its window (AC-3.1, SV-01-002)\\\", () => {\\n  it(\\\"a bounded list excluding out-of-window rows never loads their blocks or forms\\\", async () => {\\n    const { filePath } = await readFixture(store);\\n    // Corrupt content the bounds must exclude: m7's block (an out-of-window\\n    // message) and m4's tool-result-summary metadata (an out-of-window form).\\n    // Any read that loads either row throws on JSON.parse, so a bounded list\\n    // that still succeeds proves it never read outside its window.\\n    poisonMessageBlockJson(filePath, \\\"m7\\\");\\n    poisonMessageFormJson(filePath, \\\"m4\\\");\\n\\n    // In-window reads succeed and return exactly the window — the poisoned\\n    // rows are sourced neither as blocks nor as forms.\\n    for (const opts of [{ to: 1 }, { limit: 1 }] as const) {\\n      const bounded = await messages.listMessages({ filePath }, opts);\\n      expect(bounded.ok).toBe(true);\\n      if (!bounded.ok) return;\\n      expect(bounded.value.map((m) => m.messageId)).toEqual([\\\"m1\\\"]);\\n      expect(bounded.value[0]?.blocks[0]?.content[\\\"text\\\"]).toBe(\\\"please read notes.txt\\\");\\n    }\\n\\n    // Positive controls: a window that *includes* a poisoned row does load it\\n    // and fails on parse — proof the pills are real, so the passes above are\\n    // genuine no-loads, not silently-dropped output.\\n    const hitsBlock = await messages.listMessages({ filePath }, { from: 7 });\\n    expect(hitsBlock.ok).toBe(false);\\n    const hitsForm = await messages.listMessages({ filePath }, { from: 4, to: 4 });\\n    expect(hitsForm.ok).toBe(false);\\n  });\\n});\\n\",\"numLines\":404,\"startLine\":1,\"totalLines\":404}}}\n132:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Ke6Z8o4LHDnywvr9Stkrui\",\"type\":\"tool_result\",\"content\":\"1\\t// Story 1 (Epic 04), process-boundary suite: TC-3.4 — `lhc messages list`\\n2\\t// and `lhc messages show` through the spawned dist/cli.js have full JSON\\n3\\t// parity with the in-process SDK operations: same options, same result JSON,\\n4\\t// refusals included. Reads are non-mutating, so one fixture thread serves\\n5\\t// both sides — the spawned output deep-equals the SDK result on the same\\n6\\t// file (the production-path proof: cli/messages-read.ts routes to the SDK,\\n7\\t// any divergence is a bypass). Reads need no provider; the binary runs with\\n8\\t// LHC_PROVIDER unset. Runs under verify-all only (LHC_PROCESS_SUITE=1).\\n9\\t// TC-5.4's checkpoint parity joins this file in Story 4.\\n10\\timport { spawnSync } from \\\"node:child_process\\\";\\n11\\timport { mkdtempSync, rmSync } from \\\"node:fs\\\";\\n12\\timport { tmpdir } from \\\"node:os\\\";\\n13\\timport path from \\\"node:path\\\";\\n14\\timport { fileURLToPath } from \\\"node:url\\\";\\n15\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n16\\timport {\\n17\\t  createSdk,\\n18\\t  messages,\\n19\\t  resolveNamedProvider,\\n20\\t  threads,\\n21\\t  type MessageListOptions,\\n22\\t} from \\\"../src/index.js\\\";\\n23\\timport { validEvent } from \\\"./fixtures/index.js\\\";\\n24\\t\\n25\\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \\\"..\\\");\\n26\\tconst cliPath = path.join(pkgRoot, \\\"dist\\\", \\\"cli.js\\\");\\n27\\t\\n28\\tfunction runBinary(args: string[]): { status: number | null; stdout: string; stderr: string } {\\n29\\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\\n30\\t    encoding: \\\"utf8\\\",\\n31\\t    env: { ...process.env, LHC_PROVIDER: undefined },\\n32\\t  });\\n33\\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\\n34\\t}\\n35\\t\\n36\\tlet dir: string;\\n37\\tbeforeEach(() => {\\n38\\t  dir = mkdtempSync(path.join(tmpdir(), \\\"lhc-proc-inspect-\\\"));\\n39\\t});\\n40\\tafterEach(() => {\\n41\\t  rmSync(dir, { recursive: true, force: true });\\n42\\t});\\n43\\t\\n44\\t// Two closed turns (m1 prompt, m2 text, m3 call, m4 result; m6 prompt,\\n45\\t// m7 text), drained in-process against the registry's deterministic\\n46\\t// provider, then m2 deleted — so the parity sweep covers live, bounded,\\n47\\t// deleted-included, and deleted-shown reads on one record.\\n48\\tasync function seedThread(): Promise<string> {\\n49\\t  const filePath = path.join(dir, \\\"inspect-parity.sqlite\\\");\\n50\\t  const created = await threads.newThread({\\n51\\t    filePath,\\n52\\t    registryPath: path.join(dir, \\\"registry.sqlite\\\"),\\n53\\t  });\\n54\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n55\\t  const provider = resolveNamedProvider(\\\"deterministic\\\");\\n56\\t  if (provider === undefined) throw new Error(\\\"deterministic provider not registered\\\");\\n57\\t  const sdk = createSdk({ provider, mode: \\\"manual\\\" });\\n58\\t  const batches = [\\n59\\t    [\\n60\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"please read notes.txt\\\" } }),\\n61\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"reading it now\\\" } }),\\n62\\t      validEvent(\\\"tool_call\\\", {\\n63\\t        payload: {\\n64\\t          toolCallId: \\\"call-parity-1\\\",\\n65\\t          toolName: \\\"read_file\\\",\\n66\\t          arguments: { path: \\\"notes.txt\\\" },\\n67\\t        },\\n68\\t      }),\\n69\\t      validEvent(\\\"tool_result\\\", {\\n70\\t        payload: {\\n71\\t          toolCallId: \\\"call-parity-1\\\",\\n72\\t          content: \\\"contents of notes.txt: full parity-fixture tool output\\\",\\n73\\t          isError: false,\\n74\\t        },\\n75\\t      }),\\n76\\t      validEvent(\\\"turn_end\\\"),\\n77\\t    ],\\n78\\t    [\\n79\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"summarize what you read\\\" } }),\\n80\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"here is the summary\\\" } }),\\n81\\t      validEvent(\\\"turn_end\\\"),\\n82\\t    ],\\n83\\t  ];\\n84\\t  for (const batch of batches) {\\n85\\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n86\\t    if (!sent.ok) throw new Error(`fixture batch failed: ${sent.error.reason}`);\\n87\\t  }\\n88\\t  const drained = await sdk.work.drain({ filePath });\\n89\\t  if (!drained.ok || drained.value.remaining !== 0) {\\n90\\t    throw new Error(\\\"fixture drain did not settle\\\");\\n91\\t  }\\n92\\t  const deleted = await messages.deleteMessage({ filePath }, { messageId: \\\"m2\\\" });\\n93\\t  if (!deleted.ok) throw new Error(`fixture delete failed: ${deleted.error.reason}`);\\n94\\t  return filePath;\\n95\\t}\\n96\\t\\n97\\tdescribe(\\\"TC-3.4 / AC-3.4: spawned-CLI message list/show parity with the SDK\\\", () => {\\n98\\t  it(\\\"messages list mirrors the SDK across default, bounded, include-deleted, and refused options\\\", async () => {\\n99\\t    const filePath = await seedThread();\\n100\\t    const cases: Array<{ args: string[]; opts: MessageListOptions; ok: boolean }> = [\\n101\\t      { args: [], opts: {}, ok: true },\\n102\\t      { args: [\\\"--from\\\", \\\"2\\\", \\\"--to\\\", \\\"4\\\"], opts: { from: 2, to: 4 }, ok: true },\\n103\\t      { args: [\\\"--limit\\\", \\\"2\\\"], opts: { limit: 2 }, ok: true },\\n104\\t      { args: [\\\"--include-deleted\\\"], opts: { includeDeleted: true }, ok: true },\\n105\\t      {\\n106\\t        args: [\\\"--from\\\", \\\"3\\\", \\\"--limit\\\", \\\"2\\\", \\\"--include-deleted\\\"],\\n107\\t        opts: { from: 3, limit: 2, includeDeleted: true },\\n108\\t        ok: true,\\n109\\t      },\\n110\\t      // The refusal leg: bad bounds carry the same structured error through\\n111\\t      // the process boundary, exit 1.\\n112\\t      { args: [\\\"--from\\\", \\\"5\\\", \\\"--to\\\", \\\"2\\\"], opts: { from: 5, to: 2 }, ok: false },\\n113\\t    ];\\n114\\t    for (const parity of cases) {\\n115\\t      const viaSdk = await messages.listMessages({ filePath }, parity.opts);\\n116\\t      expect(viaSdk.ok).toBe(parity.ok);\\n117\\t      const viaCli = runBinary([\\\"messages\\\", \\\"list\\\", \\\"--file-path\\\", filePath, ...parity.args]);\\n118\\t      expect(viaCli.status).toBe(parity.ok ? 0 : 1);\\n119\\t      expect(JSON.parse(viaCli.stdout)).toEqual(viaSdk);\\n120\\t    }\\n121\\t    // Six serial dist/cli.js spawns push past Vitest's 5000ms default on a\\n122\\t    // loaded machine; the explicit budget keeps the configured verify-all gate\\n123\\t    // stable (SV-01-003), matching the other process-suite spawn tests.\\n124\\t  }, 30000);\\n125\\t\\n126\\t  it(\\\"messages show mirrors the SDK for live, deleted, and missing targets\\\", async () => {\\n127\\t    const filePath = await seedThread();\\n128\\t    for (const messageId of [\\n129\\t      \\\"m4\\\", // live drained tool result, forms attached\\n130\\t      \\\"m2\\\", // deleted: ok + flag — the audit read\\n131\\t      \\\"m99\\\", // missing: message_not_found, exit 1\\n132\\t    ]) {\\n133\\t      const viaSdk = await messages.show({ filePath }, messageId);\\n134\\t      const viaCli = runBinary([\\n135\\t        \\\"messages\\\",\\n136\\t        \\\"show\\\",\\n137\\t        \\\"--file-path\\\",\\n138\\t        filePath,\\n139\\t        \\\"--message-id\\\",\\n140\\t        messageId,\\n141\\t      ]);\\n142\\t      expect(viaCli.status).toBe(viaSdk.ok ? 0 : 1);\\n143\\t      expect(JSON.parse(viaCli.stdout)).toEqual(viaSdk);\\n144\\t    }\\n145\\t    // The deleted target succeeds with the flag; the missing one refuses —\\n146\\t    // pinned here so the loop's parity can't both-sides-drift.\\n147\\t    const deletedShown = await messages.show({ filePath }, \\\"m2\\\");\\n148\\t    expect(deletedShown.ok).toBe(true);\\n149\\t    if (deletedShown.ok) expect(deletedShown.value.deleted).toBe(true);\\n150\\t    const missing = await messages.show({ filePath }, \\\"m99\\\");\\n151\\t    expect(missing.ok).toBe(false);\\n152\\t    if (!missing.ok) expect(missing.error.code).toBe(\\\"message_not_found\\\");\\n153\\t    // Same spawn-cost budget as the list leg, for the same gate-stability\\n154\\t    // reason (SV-01-003).\\n155\\t  }, 30000);\\n156\\t});\\n157\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"uuid\":\"0514ced0-61a4-4490-b296-69e25eabcc5e\",\"timestamp\":\"2026-06-12T13:24:19.012Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/cli-process-inspect.test.ts\",\"content\":\"// Story 1 (Epic 04), process-boundary suite: TC-3.4 — `lhc messages list`\\n// and `lhc messages show` through the spawned dist/cli.js have full JSON\\n// parity with the in-process SDK operations: same options, same result JSON,\\n// refusals included. Reads are non-mutating, so one fixture thread serves\\n// both sides — the spawned output deep-equals the SDK result on the same\\n// file (the production-path proof: cli/messages-read.ts routes to the SDK,\\n// any divergence is a bypass). Reads need no provider; the binary runs with\\n// LHC_PROVIDER unset. Runs under verify-all only (LHC_PROCESS_SUITE=1).\\n// TC-5.4's checkpoint parity joins this file in Story 4.\\nimport { spawnSync } from \\\"node:child_process\\\";\\nimport { mkdtempSync, rmSync } from \\\"node:fs\\\";\\nimport { tmpdir } from \\\"node:os\\\";\\nimport path from \\\"node:path\\\";\\nimport { fileURLToPath } from \\\"node:url\\\";\\nimport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\nimport {\\n  createSdk,\\n  messages,\\n  resolveNamedProvider,\\n  threads,\\n  type MessageListOptions,\\n} from \\\"../src/index.js\\\";\\nimport { validEvent } from \\\"./fixtures/index.js\\\";\\n\\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \\\"..\\\");\\nconst cliPath = path.join(pkgRoot, \\\"dist\\\", \\\"cli.js\\\");\\n\\nfunction runBinary(args: string[]): { status: number | null; stdout: string; stderr: string } {\\n  const result = spawnSync(process.execPath, [cliPath, ...args], {\\n    encoding: \\\"utf8\\\",\\n    env: { ...process.env, LHC_PROVIDER: undefined },\\n  });\\n  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\\n}\\n\\nlet dir: string;\\nbeforeEach(() => {\\n  dir = mkdtempSync(path.join(tmpdir(), \\\"lhc-proc-inspect-\\\"));\\n});\\nafterEach(() => {\\n  rmSync(dir, { recursive: true, force: true });\\n});\\n\\n// Two closed turns (m1 prompt, m2 text, m3 call, m4 result; m6 prompt,\\n// m7 text), drained in-process against the registry's deterministic\\n// provider, then m2 deleted — so the parity sweep covers live, bounded,\\n// deleted-included, and deleted-shown reads on one record.\\nasync function seedThread(): Promise<string> {\\n  const filePath = path.join(dir, \\\"inspect-parity.sqlite\\\");\\n  const created = await threads.newThread({\\n    filePath,\\n    registryPath: path.join(dir, \\\"registry.sqlite\\\"),\\n  });\\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n  const provider = resolveNamedProvider(\\\"deterministic\\\");\\n  if (provider === undefined) throw new Error(\\\"deterministic provider not registered\\\");\\n  const sdk = createSdk({ provider, mode: \\\"manual\\\" });\\n  const batches = [\\n    [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"please read notes.txt\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"reading it now\\\" } }),\\n      validEvent(\\\"tool_call\\\", {\\n        payload: {\\n          toolCallId: \\\"call-parity-1\\\",\\n          toolName: \\\"read_file\\\",\\n          arguments: { path: \\\"notes.txt\\\" },\\n        },\\n      }),\\n      validEvent(\\\"tool_result\\\", {\\n        payload: {\\n          toolCallId: \\\"call-parity-1\\\",\\n          content: \\\"contents of notes.txt: full parity-fixture tool output\\\",\\n          isError: false,\\n        },\\n      }),\\n      validEvent(\\\"turn_end\\\"),\\n    ],\\n    [\\n      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"summarize what you read\\\" } }),\\n      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"here is the summary\\\" } }),\\n      validEvent(\\\"turn_end\\\"),\\n    ],\\n  ];\\n  for (const batch of batches) {\\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n    if (!sent.ok) throw new Error(`fixture batch failed: ${sent.error.reason}`);\\n  }\\n  const drained = await sdk.work.drain({ filePath });\\n  if (!drained.ok || drained.value.remaining !== 0) {\\n    throw new Error(\\\"fixture drain did not settle\\\");\\n  }\\n  const deleted = await messages.deleteMessage({ filePath }, { messageId: \\\"m2\\\" });\\n  if (!deleted.ok) throw new Error(`fixture delete failed: ${deleted.error.reason}`);\\n  return filePath;\\n}\\n\\ndescribe(\\\"TC-3.4 / AC-3.4: spawned-CLI message list/show parity with the SDK\\\", () => {\\n  it(\\\"messages list mirrors the SDK across default, bounded, include-deleted, and refused options\\\", async () => {\\n    const filePath = await seedThread();\\n    const cases: Array<{ args: string[]; opts: MessageListOptions; ok: boolean }> = [\\n      { args: [], opts: {}, ok: true },\\n      { args: [\\\"--from\\\", \\\"2\\\", \\\"--to\\\", \\\"4\\\"], opts: { from: 2, to: 4 }, ok: true },\\n      { args: [\\\"--limit\\\", \\\"2\\\"], opts: { limit: 2 }, ok: true },\\n      { args: [\\\"--include-deleted\\\"], opts: { includeDeleted: true }, ok: true },\\n      {\\n        args: [\\\"--from\\\", \\\"3\\\", \\\"--limit\\\", \\\"2\\\", \\\"--include-deleted\\\"],\\n        opts: { from: 3, limit: 2, includeDeleted: true },\\n        ok: true,\\n      },\\n      // The refusal leg: bad bounds carry the same structured error through\\n      // the process boundary, exit 1.\\n      { args: [\\\"--from\\\", \\\"5\\\", \\\"--to\\\", \\\"2\\\"], opts: { from: 5, to: 2 }, ok: false },\\n    ];\\n    for (const parity of cases) {\\n      const viaSdk = await messages.listMessages({ filePath }, parity.opts);\\n      expect(viaSdk.ok).toBe(parity.ok);\\n      const viaCli = runBinary([\\\"messages\\\", \\\"list\\\", \\\"--file-path\\\", filePath, ...parity.args]);\\n      expect(viaCli.status).toBe(parity.ok ? 0 : 1);\\n      expect(JSON.parse(viaCli.stdout)).toEqual(viaSdk);\\n    }\\n    // Six serial dist/cli.js spawns push past Vitest's 5000ms default on a\\n    // loaded machine; the explicit budget keeps the configured verify-all gate\\n    // stable (SV-01-003), matching the other process-suite spawn tests.\\n  }, 30000);\\n\\n  it(\\\"messages show mirrors the SDK for live, deleted, and missing targets\\\", async () => {\\n    const filePath = await seedThread();\\n    for (const messageId of [\\n      \\\"m4\\\", // live drained tool result, forms attached\\n      \\\"m2\\\", // deleted: ok + flag — the audit read\\n      \\\"m99\\\", // missing: message_not_found, exit 1\\n    ]) {\\n      const viaSdk = await messages.show({ filePath }, messageId);\\n      const viaCli = runBinary([\\n        \\\"messages\\\",\\n        \\\"show\\\",\\n        \\\"--file-path\\\",\\n        filePath,\\n        \\\"--message-id\\\",\\n        messageId,\\n      ]);\\n      expect(viaCli.status).toBe(viaSdk.ok ? 0 : 1);\\n      expect(JSON.parse(viaCli.stdout)).toEqual(viaSdk);\\n    }\\n    // The deleted target succeeds with the flag; the missing one refuses —\\n    // pinned here so the loop's parity can't both-sides-drift.\\n    const deletedShown = await messages.show({ filePath }, \\\"m2\\\");\\n    expect(deletedShown.ok).toBe(true);\\n    if (deletedShown.ok) expect(deletedShown.value.deleted).toBe(true);\\n    const missing = await messages.show({ filePath }, \\\"m99\\\");\\n    expect(missing.ok).toBe(false);\\n    if (!missing.ok) expect(missing.error.code).toBe(\\\"message_not_found\\\");\\n    // Same spawn-cost budget as the list leg, for the same gate-stability\\n    // reason (SV-01-003).\\n  }, 30000);\\n});\\n\",\"numLines\":157,\"startLine\":1,\"totalLines\":157}}}\n158:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\" at the supporting infrastructure — the touch-suppression context, forms read, fixtures, and run the tests to see the act\"}},\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"parent_tool_use_id\":null,\"uuid\":\"a5ccbf52-a6ef-4869-a994-848db13ed2c3\"}\n160:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-8\",\"id\":\"msg_01HcNe1CeM8QTMAg2hFYwTxs\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Now let me look at the supporting infrastructure — the touch-suppression context, forms read, fixtures, and run the tests to see the actual current state.\"}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":131,\"cache_creation_input_tokens\":14545,\"cache_read_input_tokens\":51039,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":14545},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"uuid\":\"0be3567c-f897-4afa-ae99-5feabd953dc4\",\"request_id\":\"req_011CbySRsoDegfKR183TXaiw\"}\n174:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HxrP7bVV93ZzEfjYQ2d2L4\",\"type\":\"tool_result\",\"content\":\"1\\t// Message-domain reads for derivation (Flow 2): the handler's view of its\\n2\\t// source message and the call-id pairing reads — the only reach a\\n3\\t// message-level handler has beyond its own message (AC-2.5). Also the\\n4\\t// late-result repair lookup intake's projection step runs (AC-2.8): one\\n5\\t// indexed query by call id, never a scan (the v5 expression index on\\n6\\t// message_block covers it) and never a drain-time sweep or read-time join.\\n7\\t// Completion writes for message forms ride the work-queue util's `complete`\\n8\\t// (Story 1): UPDATE-only with the source-version check — no write path here.\\n9\\t// Read-back of message-owned form rows (the listMessages join) also lives\\n10\\t// here: stored state returned as stored — never re-derived on read.\\n11\\timport type { DatabaseSync } from \\\"node:sqlite\\\";\\n12\\timport type {\\n13\\t  DependencyGap,\\n14\\t  DerivedForm,\\n15\\t  DerivedFormMetadata,\\n16\\t  DerivedFormState,\\n17\\t  FormKind,\\n18\\t  FormReportEntry,\\n19\\t} from \\\"../../../shared/derivation.js\\\";\\n20\\timport { reportEntryFromRow, type RawReportRow } from \\\"../../../shared/report.js\\\";\\n21\\t\\n22\\texport interface MessageSource {\\n23\\t  messageId: string;\\n24\\t  kind: string;\\n25\\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\\n26\\t}\\n27\\t\\n28\\texport function readMessageSource(\\n29\\t  db: DatabaseSync,\\n30\\t  messageId: string,\\n31\\t): MessageSource | undefined {\\n32\\t  const row = db\\n33\\t    .prepare(`SELECT kind FROM message WHERE message_id = ?`)\\n34\\t    .get(messageId) as unknown as { kind: string } | undefined;\\n35\\t  if (row === undefined) return undefined;\\n36\\t  const blocks = db\\n37\\t    .prepare(\\n38\\t      `SELECT block_type, content FROM message_block\\n39\\t       WHERE message_id = ? ORDER BY block_index`,\\n40\\t    )\\n41\\t    .all(messageId) as unknown as Array<{ block_type: string; content: string }>;\\n42\\t  return {\\n43\\t    messageId,\\n44\\t    kind: row.kind,\\n45\\t    blocks: blocks.map((block) => ({\\n46\\t      blockType: block.block_type,\\n47\\t      content: JSON.parse(block.content) as Record<string, unknown>,\\n48\\t    })),\\n49\\t  };\\n50\\t}\\n51\\t\\n52\\tinterface RawFormRow {\\n53\\t  subject_id: string;\\n54\\t  form: string;\\n55\\t  state: string;\\n56\\t  content: string | null;\\n57\\t  reason: string | null;\\n58\\t  metadata: string | null;\\n59\\t  source_version: number | bigint;\\n60\\t  gaps: string | null;\\n61\\t  derived_at: string | null;\\n62\\t}\\n63\\t\\n64\\t// Every message-owned derived-form row, grouped by message id — the form\\n65\\t// read-back joined onto message reads (AC-2.1's \\\"readable alongside the\\n66\\t// message\\\"). Rows come back exactly as the queue landed them: state, content,\\n67\\t// reason, mechanically stamped metadata; nothing is derived at read time.\\n68\\t//\\n69\\t// messageIds, when provided, scopes the read to just those subjects so a\\n70\\t// bounded listMessages loads only its window's forms (AC-3.1's\\n71\\t// no-load-everything clause), never every message-owned form in the thread.\\n72\\t// Omitted — the report-surface path that already reads its own scope — reads\\n73\\t// all message-owned form rows as before.\\n74\\texport function readMessageForms(\\n75\\t  db: DatabaseSync,\\n76\\t  messageIds?: readonly string[],\\n77\\t): Map<string, DerivedForm[]> {\\n78\\t  const byMessage = new Map<string, DerivedForm[]>();\\n79\\t  if (messageIds !== undefined && messageIds.length === 0) return byMessage;\\n80\\t  const idFilter =\\n81\\t    messageIds === undefined\\n82\\t      ? \\\"\\\"\\n83\\t      : ` AND subject_id IN (${messageIds.map(() => \\\"?\\\").join(\\\", \\\")})`;\\n84\\t  const rows = db\\n85\\t    .prepare(\\n86\\t      `SELECT subject_id, form, state, content, reason, metadata,\\n87\\t              source_version, gaps, derived_at\\n88\\t       FROM derived_form WHERE subject_kind = 'message'${idFilter}\\n89\\t       ORDER BY subject_id, form`,\\n90\\t    )\\n91\\t    .all(...(messageIds ?? [])) as unknown as RawFormRow[];\\n92\\t  for (const row of rows) {\\n93\\t    const record: DerivedForm = {\\n94\\t      subjectKind: \\\"message\\\",\\n95\\t      subjectId: row.subject_id,\\n96\\t      form: row.form as FormKind,\\n97\\t      state: row.state as DerivedFormState,\\n98\\t      sourceVersion: Number(row.source_version),\\n99\\t    };\\n100\\t    if (row.content !== null) record.content = row.content;\\n101\\t    if (row.reason !== null) record.reason = row.reason;\\n102\\t    if (row.metadata !== null) {\\n103\\t      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\\n104\\t    }\\n105\\t    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\\n106\\t    if (row.derived_at !== null) record.derivedAt = row.derived_at;\\n107\\t    const forms = byMessage.get(row.subject_id) ?? [];\\n108\\t    forms.push(record);\\n109\\t    byMessage.set(row.subject_id, forms);\\n110\\t  }\\n111\\t  return byMessage;\\n112\\t}\\n113\\t\\n114\\t// One form row by exact key — the requeue operation's refusal read (missing\\n115\\t// row, blocked state, current source version). State returned as stored.\\n116\\texport function readMessageFormRow(\\n117\\t  db: DatabaseSync,\\n118\\t  messageId: string,\\n119\\t  form: FormKind,\\n120\\t): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\\n121\\t  const row = db\\n122\\t    .prepare(\\n123\\t      `SELECT state, reason, source_version FROM derived_form\\n124\\t       WHERE subject_kind = 'message' AND subject_id = ? AND form = ?`,\\n125\\t    )\\n126\\t    .get(messageId, form) as unknown as\\n127\\t    | { state: string; reason: string | null; source_version: number | bigint }\\n128\\t    | undefined;\\n129\\t  if (row === undefined) return undefined;\\n130\\t  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\\n131\\t    state: row.state as DerivedFormState,\\n132\\t    sourceVersion: Number(row.source_version),\\n133\\t  };\\n134\\t  if (row.reason !== null) view.reason = row.reason;\\n135\\t  return view;\\n136\\t}\\n137\\t\\n138\\t// The message owner's report (Flow 4): one query — message-owned form rows\\n139\\t// LEFT JOINed with the live work_item still targeting each form at its\\n140\\t// current source version, if any (DD-1: only live rows exist; terminal\\n141\\t// outcomes already live on the form). No N+1, no in-memory assembly beyond\\n142\\t// row mapping. The form→kind CASE is the owner's own queue-site mapping\\n143\\t// (MESSAGE_WORK_FORMS) inverted.\\n144\\texport function reportMessageForms(\\n145\\t  db: DatabaseSync,\\n146\\t  opts: { notReady?: boolean; messageId?: string } = {},\\n147\\t): FormReportEntry[] {\\n148\\t  const conditions = [\\\"df.subject_kind = 'message'\\\"];\\n149\\t  const params: string[] = [];\\n150\\t  if (opts.messageId !== undefined) {\\n151\\t    conditions.push(\\\"df.subject_id = ?\\\");\\n152\\t    params.push(opts.messageId);\\n153\\t  }\\n154\\t  // notReady is exact set equality by construction: every state but ready.\\n155\\t  if (opts.notReady === true) conditions.push(\\\"df.state <> 'ready'\\\");\\n156\\t  const rows = db\\n157\\t    .prepare(\\n158\\t      `SELECT df.subject_id, df.form, df.state, df.content, df.reason, df.metadata,\\n159\\t              df.source_version, df.gaps, df.derived_at,\\n160\\t              w.status AS queue_status, w.attempts AS queue_attempts,\\n161\\t              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\\n162\\t       FROM derived_form df\\n163\\t       LEFT JOIN work_item w\\n164\\t         ON w.status IN ('queued', 'claimed')\\n165\\t        AND w.kind = CASE df.form WHEN 'smoothed_prompt' THEN 'prompt_smoothing' ELSE df.form END\\n166\\t        AND json_extract(w.source_ref, '$.messageId') = df.subject_id\\n167\\t        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\\n168\\t       WHERE ${conditions.join(\\\" AND \\\")}\\n169\\t       ORDER BY df.subject_id, df.form`,\\n170\\t    )\\n171\\t    .all(...params) as unknown as RawReportRow[];\\n172\\t  return rows.map((row) => reportEntryFromRow(\\\"message\\\", row));\\n173\\t}\\n174\\t\\n175\\t// The call-id pairing reads. Earliest-recorded block wins if a call id were\\n176\\t// ever repeated; in a well-formed record the pair is unique. Deleted messages\\n177\\t// are excluded (tech-design §Mechanics' deleted-read rule, epic-fix-001):\\n178\\t// composition inputs and derivation reads never see deleted records, so a\\n179\\t// tool_call whose paired result has been deleted reads no pair and derives\\n180\\t// outcome `unknown` — never the dead result's outcome.\\n181\\tfunction findPairedBlock(\\n182\\t  db: DatabaseSync,\\n183\\t  blockType: \\\"tool_call\\\" | \\\"tool_result\\\",\\n184\\t  toolCallId: string,\\n185\\t): Record<string, unknown> | undefined {\\n186\\t  const row = db\\n187\\t    .prepare(\\n188\\t      `SELECT b.content FROM message_block b\\n189\\t       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\\n190\\t       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\\n191\\t       ORDER BY m.source_event_order LIMIT 1`,\\n192\\t    )\\n193\\t    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\\n194\\t  if (row === undefined) return undefined;\\n195\\t  return JSON.parse(row.content) as Record<string, unknown>;\\n196\\t}\\n197\\t\\n198\\texport function findPairedToolResult(\\n199\\t  db: DatabaseSync,\\n200\\t  toolCallId: string,\\n201\\t): { content: string; isError: boolean } | undefined {\\n202\\t  const block = findPairedBlock(db, \\\"tool_result\\\", toolCallId);\\n203\\t  if (block === undefined) return undefined;\\n204\\t  return {\\n205\\t    content: typeof block[\\\"content\\\"] === \\\"string\\\" ? block[\\\"content\\\"] : \\\"\\\",\\n206\\t    isError: block[\\\"isError\\\"] === true,\\n207\\t  };\\n208\\t}\\n209\\t\\n210\\texport function findPairedToolCall(\\n211\\t  db: DatabaseSync,\\n212\\t  toolCallId: string,\\n213\\t): { toolName: string } | undefined {\\n214\\t  const block = findPairedBlock(db, \\\"tool_call\\\", toolCallId);\\n215\\t  if (block === undefined) return undefined;\\n216\\t  return { toolName: typeof block[\\\"toolName\\\"] === \\\"string\\\" ? block[\\\"toolName\\\"] : \\\"\\\" };\\n217\\t}\\n218\\t\\n219\\t// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\\n220\\t// outcome \\\"unknown\\\"? Pending rows carry NULL metadata and never match, so the\\n221\\t// common case — call and result in one batch, summary not yet run — never\\n222\\t// triggers a requeue. Returns the call's message id and the form's current\\n223\\t// source version (the requeue enqueues at version + 1: the pair is the\\n224\\t// summary's source, and a source completing follows clear-and-regenerate).\\n225\\texport function findUnknownOutcomeCallSummary(\\n226\\t  db: DatabaseSync,\\n227\\t  toolCallId: string,\\n228\\t): { messageId: string; sourceVersion: number } | undefined {\\n229\\t  const row = db\\n230\\t    .prepare(\\n231\\t      `SELECT df.subject_id, df.source_version FROM message_block b\\n232\\t       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\\n233\\t       JOIN derived_form df ON df.subject_kind = 'message'\\n234\\t         AND df.subject_id = b.message_id AND df.form = 'tool_call_summary'\\n235\\t       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\\n236\\t         AND json_extract(df.metadata, '$.outcome') = 'unknown'\\n237\\t       LIMIT 1`,\\n238\\t    )\\n239\\t    .get(toolCallId) as unknown as\\n240\\t    | { subject_id: string; source_version: number | bigint }\\n241\\t    | undefined;\\n242\\t  if (row === undefined) return undefined;\\n243\\t  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\\n244\\t}\\n245\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"uuid\":\"94e40dd3-470d-4837-a704-e0b58191f5b1\",\"timestamp\":\"2026-06-12T13:24:35.245Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/messages/internal/forms.ts\",\"content\":\"// Message-domain reads for derivation (Flow 2): the handler's view of its\\n// source message and the call-id pairing reads — the only reach a\\n// message-level handler has beyond its own message (AC-2.5). Also the\\n// late-result repair lookup intake's projection step runs (AC-2.8): one\\n// indexed query by call id, never a scan (the v5 expression index on\\n// message_block covers it) and never a drain-time sweep or read-time join.\\n// Completion writes for message forms ride the work-queue util's `complete`\\n// (Story 1): UPDATE-only with the source-version check — no write path here.\\n// Read-back of message-owned form rows (the listMessages join) also lives\\n// here: stored state returned as stored — never re-derived on read.\\nimport type { DatabaseSync } from \\\"node:sqlite\\\";\\nimport type {\\n  DependencyGap,\\n  DerivedForm,\\n  DerivedFormMetadata,\\n  DerivedFormState,\\n  FormKind,\\n  FormReportEntry,\\n} from \\\"../../../shared/derivation.js\\\";\\nimport { reportEntryFromRow, type RawReportRow } from \\\"../../../shared/report.js\\\";\\n\\nexport interface MessageSource {\\n  messageId: string;\\n  kind: string;\\n  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\\n}\\n\\nexport function readMessageSource(\\n  db: DatabaseSync,\\n  messageId: string,\\n): MessageSource | undefined {\\n  const row = db\\n    .prepare(`SELECT kind FROM message WHERE message_id = ?`)\\n    .get(messageId) as unknown as { kind: string } | undefined;\\n  if (row === undefined) return undefined;\\n  const blocks = db\\n    .prepare(\\n      `SELECT block_type, content FROM message_block\\n       WHERE message_id = ? ORDER BY block_index`,\\n    )\\n    .all(messageId) as unknown as Array<{ block_type: string; content: string }>;\\n  return {\\n    messageId,\\n    kind: row.kind,\\n    blocks: blocks.map((block) => ({\\n      blockType: block.block_type,\\n      content: JSON.parse(block.content) as Record<string, unknown>,\\n    })),\\n  };\\n}\\n\\ninterface RawFormRow {\\n  subject_id: string;\\n  form: string;\\n  state: string;\\n  content: string | null;\\n  reason: string | null;\\n  metadata: string | null;\\n  source_version: number | bigint;\\n  gaps: string | null;\\n  derived_at: string | null;\\n}\\n\\n// Every message-owned derived-form row, grouped by message id — the form\\n// read-back joined onto message reads (AC-2.1's \\\"readable alongside the\\n// message\\\"). Rows come back exactly as the queue landed them: state, content,\\n// reason, mechanically stamped metadata; nothing is derived at read time.\\n//\\n// messageIds, when provided, scopes the read to just those subjects so a\\n// bounded listMessages loads only its window's forms (AC-3.1's\\n// no-load-everything clause), never every message-owned form in the thread.\\n// Omitted — the report-surface path that already reads its own scope — reads\\n// all message-owned form rows as before.\\nexport function readMessageForms(\\n  db: DatabaseSync,\\n  messageIds?: readonly string[],\\n): Map<string, DerivedForm[]> {\\n  const byMessage = new Map<string, DerivedForm[]>();\\n  if (messageIds !== undefined && messageIds.length === 0) return byMessage;\\n  const idFilter =\\n    messageIds === undefined\\n      ? \\\"\\\"\\n      : ` AND subject_id IN (${messageIds.map(() => \\\"?\\\").join(\\\", \\\")})`;\\n  const rows = db\\n    .prepare(\\n      `SELECT subject_id, form, state, content, reason, metadata,\\n              source_version, gaps, derived_at\\n       FROM derived_form WHERE subject_kind = 'message'${idFilter}\\n       ORDER BY subject_id, form`,\\n    )\\n    .all(...(messageIds ?? [])) as unknown as RawFormRow[];\\n  for (const row of rows) {\\n    const record: DerivedForm = {\\n      subjectKind: \\\"message\\\",\\n      subjectId: row.subject_id,\\n      form: row.form as FormKind,\\n      state: row.state as DerivedFormState,\\n      sourceVersion: Number(row.source_version),\\n    };\\n    if (row.content !== null) record.content = row.content;\\n    if (row.reason !== null) record.reason = row.reason;\\n    if (row.metadata !== null) {\\n      record.metadata = JSON.parse(row.metadata) as DerivedFormMetadata;\\n    }\\n    if (row.gaps !== null) record.gaps = JSON.parse(row.gaps) as DependencyGap[];\\n    if (row.derived_at !== null) record.derivedAt = row.derived_at;\\n    const forms = byMessage.get(row.subject_id) ?? [];\\n    forms.push(record);\\n    byMessage.set(row.subject_id, forms);\\n  }\\n  return byMessage;\\n}\\n\\n// One form row by exact key — the requeue operation's refusal read (missing\\n// row, blocked state, current source version). State returned as stored.\\nexport function readMessageFormRow(\\n  db: DatabaseSync,\\n  messageId: string,\\n  form: FormKind,\\n): { state: DerivedFormState; reason?: string; sourceVersion: number } | undefined {\\n  const row = db\\n    .prepare(\\n      `SELECT state, reason, source_version FROM derived_form\\n       WHERE subject_kind = 'message' AND subject_id = ? AND form = ?`,\\n    )\\n    .get(messageId, form) as unknown as\\n    | { state: string; reason: string | null; source_version: number | bigint }\\n    | undefined;\\n  if (row === undefined) return undefined;\\n  const view: { state: DerivedFormState; reason?: string; sourceVersion: number } = {\\n    state: row.state as DerivedFormState,\\n    sourceVersion: Number(row.source_version),\\n  };\\n  if (row.reason !== null) view.reason = row.reason;\\n  return view;\\n}\\n\\n// The message owner's report (Flow 4): one query — message-owned form rows\\n// LEFT JOINed with the live work_item still targeting each form at its\\n// current source version, if any (DD-1: only live rows exist; terminal\\n// outcomes already live on the form). No N+1, no in-memory assembly beyond\\n// row mapping. The form→kind CASE is the owner's own queue-site mapping\\n// (MESSAGE_WORK_FORMS) inverted.\\nexport function reportMessageForms(\\n  db: DatabaseSync,\\n  opts: { notReady?: boolean; messageId?: string } = {},\\n): FormReportEntry[] {\\n  const conditions = [\\\"df.subject_kind = 'message'\\\"];\\n  const params: string[] = [];\\n  if (opts.messageId !== undefined) {\\n    conditions.push(\\\"df.subject_id = ?\\\");\\n    params.push(opts.messageId);\\n  }\\n  // notReady is exact set equality by construction: every state but ready.\\n  if (opts.notReady === true) conditions.push(\\\"df.state <> 'ready'\\\");\\n  const rows = db\\n    .prepare(\\n      `SELECT df.subject_id, df.form, df.state, df.content, df.reason, df.metadata,\\n              df.source_version, df.gaps, df.derived_at,\\n              w.status AS queue_status, w.attempts AS queue_attempts,\\n              w.last_error AS queue_last_error, w.eligible_at AS queue_eligible_at\\n       FROM derived_form df\\n       LEFT JOIN work_item w\\n         ON w.status IN ('queued', 'claimed')\\n        AND w.kind = CASE df.form WHEN 'smoothed_prompt' THEN 'prompt_smoothing' ELSE df.form END\\n        AND json_extract(w.source_ref, '$.messageId') = df.subject_id\\n        AND COALESCE(json_extract(w.payload, '$.sourceVersion'), 1) = df.source_version\\n       WHERE ${conditions.join(\\\" AND \\\")}\\n       ORDER BY df.subject_id, df.form`,\\n    )\\n    .all(...params) as unknown as RawReportRow[];\\n  return rows.map((row) => reportEntryFromRow(\\\"message\\\", row));\\n}\\n\\n// The call-id pairing reads. Earliest-recorded block wins if a call id were\\n// ever repeated; in a well-formed record the pair is unique. Deleted messages\\n// are excluded (tech-design §Mechanics' deleted-read rule, epic-fix-001):\\n// composition inputs and derivation reads never see deleted records, so a\\n// tool_call whose paired result has been deleted reads no pair and derives\\n// outcome `unknown` — never the dead result's outcome.\\nfunction findPairedBlock(\\n  db: DatabaseSync,\\n  blockType: \\\"tool_call\\\" | \\\"tool_result\\\",\\n  toolCallId: string,\\n): Record<string, unknown> | undefined {\\n  const row = db\\n    .prepare(\\n      `SELECT b.content FROM message_block b\\n       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\\n       WHERE b.block_type = ? AND json_extract(b.content, '$.toolCallId') = ?\\n       ORDER BY m.source_event_order LIMIT 1`,\\n    )\\n    .get(blockType, toolCallId) as unknown as { content: string } | undefined;\\n  if (row === undefined) return undefined;\\n  return JSON.parse(row.content) as Record<string, unknown>;\\n}\\n\\nexport function findPairedToolResult(\\n  db: DatabaseSync,\\n  toolCallId: string,\\n): { content: string; isError: boolean } | undefined {\\n  const block = findPairedBlock(db, \\\"tool_result\\\", toolCallId);\\n  if (block === undefined) return undefined;\\n  return {\\n    content: typeof block[\\\"content\\\"] === \\\"string\\\" ? block[\\\"content\\\"] : \\\"\\\",\\n    isError: block[\\\"isError\\\"] === true,\\n  };\\n}\\n\\nexport function findPairedToolCall(\\n  db: DatabaseSync,\\n  toolCallId: string,\\n): { toolName: string } | undefined {\\n  const block = findPairedBlock(db, \\\"tool_call\\\", toolCallId);\\n  if (block === undefined) return undefined;\\n  return { toolName: typeof block[\\\"toolName\\\"] === \\\"string\\\" ? block[\\\"toolName\\\"] : \\\"\\\" };\\n}\\n\\n// AC-2.8's intake-time lookup: does the paired call's summary sit landed with\\n// outcome \\\"unknown\\\"? Pending rows carry NULL metadata and never match, so the\\n// common case — call and result in one batch, summary not yet run — never\\n// triggers a requeue. Returns the call's message id and the form's current\\n// source version (the requeue enqueues at version + 1: the pair is the\\n// summary's source, and a source completing follows clear-and-regenerate).\\nexport function findUnknownOutcomeCallSummary(\\n  db: DatabaseSync,\\n  toolCallId: string,\\n): { messageId: string; sourceVersion: number } | undefined {\\n  const row = db\\n    .prepare(\\n      `SELECT df.subject_id, df.source_version FROM message_block b\\n       JOIN message m ON m.message_id = b.message_id AND m.deleted_at IS NULL\\n       JOIN derived_form df ON df.subject_kind = 'message'\\n         AND df.subject_id = b.message_id AND df.form = 'tool_call_summary'\\n       WHERE b.block_type = 'tool_call' AND json_extract(b.content, '$.toolCallId') = ?\\n         AND json_extract(df.metadata, '$.outcome') = 'unknown'\\n       LIMIT 1`,\\n    )\\n    .get(toolCallId) as unknown as\\n    | { subject_id: string; source_version: number | bigint }\\n    | undefined;\\n  if (row === undefined) return undefined;\\n  return { messageId: row.subject_id, sourceVersion: Number(row.source_version) };\\n}\\n\",\"numLines\":245,\"startLine\":1,\"totalLines\":245}}}\n194:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":1,\"delta\":{\"type\":\"text_delta\",\"text\":\"The code already appears to implement the fixes. Let me run the relevant tests to see the actual current state — both the default-\"}},\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"parent_tool_use_id\":null,\"uuid\":\"d1635a6e-cf61-46fa-8a2c-a43e2c9535ca\"}\n196:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-4-8\",\"id\":\"msg_016iyvcfGBd1aupwooJhYC4c\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"The code already appears to implement the fixes. Let me run the relevant tests to see the actual current state — both the default-suite message read test and the process suite.\"}],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":6265,\"cache_read_input_tokens\":65584,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":6265},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":{\"cache_miss_reason\":{\"type\":\"unavailable\"}},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"uuid\":\"e2b448d4-d9ac-4600-8d3b-e9bf30ee936c\",\"request_id\":\"req_011CbyST78Bkhs3rLhdg1PrA\"}\n204:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_delta\",\"index\":2,\"delta\":{\"type\":\"input_json_delta\",\"partial_json\":\"\\\", \\\"description\\\": \\\"Check touch-suppression helper exists\"}},\"session_id\":\"fc748cdb-c5fb-4e11-a01a-1f0f214d246f\",\"parent_tool_use_id\":null,\"uuid\":\"4c664514-64e4-47d8-8eb6-15c6359e0e85\"}\n206:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-opus-
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GqKRsJkQyNEc5EBVg5xwqC","type":"tool_result","content":"1\t// Story 1 (Epic 04), process-boundary suite: TC-3.4 — `lhc messages list`\n2\t// and `lhc messages show` through the spawned dist/cli.js have full JSON\n3\t// parity with the in-process SDK operations: same options, same result JSON,\n4\t// refusals included. Reads are non-mutating, so one fixture thread serves\n5\t// both sides — the spawned output deep-equals the SDK result on the same\n6\t// file (the production-path proof: cli/messages-read.ts routes to the SDK,\n7\t// any divergence is a bypass). Reads need no provider; the binary runs with\n8\t// LHC_PROVIDER unset. Runs under verify-all only (LHC_PROCESS_SUITE=1).\n9\t// TC-5.4's checkpoint parity joins this file in Story 4.\n10\timport { spawnSync } from \"node:child_process\";\n11\timport { mkdtempSync, rmSync } from \"node:fs\";\n12\timport { tmpdir } from \"node:os\";\n13\timport path from \"node:path\";\n14\timport { fileURLToPath } from \"node:url\";\n15\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n16\timport {\n17\t  createSdk,\n18\t  messages,\n19\t  resolveNamedProvider,\n20\t  threads,\n21\t  type MessageListOptions,\n22\t} from \"../src/index.js\";\n23\timport { validEvent } from \"./fixtures/index.js\";\n24\t\n25\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n26\tconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\n27\t\n28\tfunction runBinary(args: string[]): { status: number | null; stdout: string; stderr: string } {\n29\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n30\t    encoding: \"utf8\",\n31\t    env: { ...process.env, LHC_PROVIDER: undefined },\n32\t  });\n33\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n34\t}\n35\t\n36\tlet dir: string;\n37\tbeforeEach(() => {\n38\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-inspect-\"));\n39\t});\n40\tafterEach(() => {\n41\t  rmSync(dir, { recursive: true, force: true });\n42\t});\n43\t\n44\t// Two closed turns (m1 prompt, m2 text, m3 call, m4 result; m6 prompt,\n45\t// m7 text), drained in-process against the registry's deterministic\n46\t// provider, then m2 deleted — so the parity sweep covers live, bounded,\n47\t// deleted-included, and deleted-shown reads on one record.\n48\tasync function seedThread(): Promise<string> {\n49\t  const filePath = path.join(dir, \"inspect-parity.sqlite\");\n50\t  const created = await threads.newThread({\n51\t    filePath,\n52\t    registryPath: path.join(dir, \"registry.sqlite\"),\n53\t  });\n54\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n55\t  const provider = resolveNamedProvider(\"deterministic\");\n56\t  if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n57\t  const sdk = createSdk({ provider, mode: \"manual\" });\n58\t  const batches = [\n59\t    [\n60\t      validEvent(\"user_prompt\", { payload: { text: \"please read notes.txt\" } }),\n61\t      validEvent(\"assistant_text\", { payload: { text: \"reading it now\" } }),\n62\t      validEvent(\"tool_call\", {\n63\t        payload: {\n64\t          toolCallId: \"call-parity-1\",\n65\t          toolName: \"read_file\",\n66\t          arguments: { path: \"notes.txt\" },\n67\t        },\n68\t      }),\n69\t      validEvent(\"tool_result\", {\n70\t        payload: {\n71\t          toolCallId: \"call-parity-1\",\n72\t          content: \"contents of notes.txt: full parity-fixture tool output\",\n73\t          isError: false,\n74\t        },\n75\t      }),\n76\t      validEvent(\"turn_end\"),\n77\t    ],\n78\t    [\n79\t      validEvent(\"user_prompt\", { payload: { text: \"summarize what you read\" } }),\n80\t      validEvent(\"assistant_text\", { payload: { text: \"here is the summary\" } }),\n81\t      validEvent(\"turn_end\"),\n82\t    ],\n83\t  ];\n84\t  for (const batch of batches) {\n85\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, batch);\n86\t    if (!sent.ok) throw new Error(`fixture batch failed: ${sent.error.reason}`);\n87\t  }\n88\t  const drained = await sdk.work.drain({ filePath });\n89\t  if (!drained.ok || drained.value.remaining !== 0) {\n90\t    throw new Error(\"fixture drain did not settle\");\n91\t  }\n92\t  const deleted = await messages.deleteMessage({ filePath }, { messageId: \"m2\" });\n93\t  if (!deleted.ok) throw new Error(`fixture delete failed: ${deleted.error.reason}`);\n94\t  return filePath;\n95\t}\n96\t\n97\tdescribe(\"TC-3.4 / AC-3.4: spawned-CLI message list/show parity with the SDK\", () => {\n98\t  it(\"messages list mirrors the SDK across default, bounded, include-deleted, and refused options\", async () => {\n99\t    const filePath = await seedThread();\n100\t    const cases: Array<{ args: string[]; opts: MessageListOptions; ok: boolean }> = [\n101\t      { args: [], opts: {}, ok: true },\n102\t      { args: [\"--from\", \"2\", \"--to\", \"4\"], opts: { from: 2, to: 4 }, ok: true },\n103\t      { args: [\"--limit\", \"2\"], opts: { limit: 2 }, ok: true },\n104\t      { args: [\"--include-deleted\"], opts: { includeDeleted: true }, ok: true },\n105\t      {\n106\t        args: [\"--from\", \"3\", \"--limit\", \"2\", \"--include-deleted\"],\n107\t        opts: { from: 3, limit: 2, includeDeleted: true },\n108\t        ok: true,\n109\t      },\n110\t      // The refusal leg: bad bounds carry the same structured error through\n111\t      // the process boundary, exit 1.\n112\t      { args: [\"--from\", \"5\", \"--to\", \"2\"], opts: { from: 5, to: 2 }, ok: false },\n113\t    ];\n114\t    for (const parity of cases) {\n115\t      const viaSdk = await messages.listMessages({ filePath }, parity.opts);\n116\t      expect(viaSdk.ok).toBe(parity.ok);\n117\t      const viaCli = runBinary([\"messages\", \"list\", \"--file-path\", filePath, ...parity.args]);\n118\t      expect(viaCli.status).toBe(parity.ok ? 0 : 1);\n119\t      expect(JSON.parse(viaCli.stdout)).toEqual(viaSdk);\n120\t    }\n121\t    // Six serial dist/cli.js spawns push past Vitest's 5000ms default on a\n122\t    // loaded machine; the explicit budget keeps the configured verify-all gate\n123\t    // stable (SV-01-003), matching the other process-suite spawn tests.\n124\t  }, 30000);\n125\t\n126\t  it(\"messages show mirrors the SDK for live, deleted, and missing targets\", async () => {\n127\t    const filePath = await seedThread();\n128\t    for (const messageId of [\n129\t      \"m4\", // live drained tool result, forms attached\n130\t      \"m2\", // deleted: ok + flag — the audit read\n131\t      \"m99\", // missing: message_not_found, exit 1\n132\t    ]) {\n133\t      const viaSdk = await messages.show({ filePath }, messageId);\n134\t      const viaCli = runBinary([\n135\t        \"messages\",\n136\t        \"show\",\n137\t        \"--file-path\",\n138\t        filePath,\n139\t        \"--message-id\",\n140\t        messageId,\n141\t      ]);\n142\t      expect(viaCli.status).toBe(viaSdk.ok ? 0 : 1);\n143\t      expect(JSON.parse(viaCli.stdout)).toEqual(viaSdk);\n144\t    }\n145\t    // The deleted target succeeds with the flag; the missing one refuses —\n146\t    // pinned here so the loop's parity can't both-sides-drift.\n147\t    const deletedShown = await messages.show({ filePath }, \"m2\");\n148\t    expect(deletedShown.ok).toBe(true);\n149\t    if (deletedShown.ok) expect(deletedShown.value.deleted).toBe(true);\n150\t    const missing = await messages.show({ filePath }, \"m99\");\n151\t    expect(missing.ok).toBe(false);\n152\t    if (!missing.ok) expect(missing.error.code).toBe(\"message_not_found\");\n153\t    // Same spawn-cost budget as the list leg, for the same gate-stability\n154\t    // reason (SV-01-003).\n155\t  }, 30000);\n156\t});\n157\t"}]},"parent_tool_use_id":null,"session_id":"77c6c733-044c-452a-abeb-bd7584806be0","uuid":"0ae429cb-fa8e-4e32-a0d6-9aace60fe8d8","timestamp":"2026-06-12T15:07:56.637Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/cli-process-inspect.test.ts","content":"// Story 1 (Epic 04), process-boundary suite: TC-3.4 — `lhc messages list`\n// and `lhc messages show` through the spawned dist/cli.js have full JSON\n// parity with the in-process SDK operations: same options, same result JSON,\n// refusals included. Reads are non-mutating, so one fixture thread serves\n// both sides — the spawned output deep-equals the SDK result on the same\n// file (the production-path proof: cli/messages-read.ts routes to the SDK,\n// any divergence is a bypass). Reads need no provider; the binary runs with\n// LHC_PROVIDER unset. Runs under verify-all only (LHC_PROCESS_SUITE=1).\n// TC-5.4's checkpoint parity joins this file in Story 4.\nimport { spawnSync } from \"node:child_process\";\nimport { mkdtempSync, rmSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createSdk,\n  messages,\n  resolveNamedProvider,\n  threads,\n  type MessageListOptions,\n} from \"../src/index.js\";\nimport { validEvent } from \"./fixtures/index.js\";\n\nconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\nconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\n\nfunction runBinary(args: string[]): { status: number | null; stdout: string; stderr: string } {\n  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    encoding: \"utf8\",\n    env: { ...process.env, LHC_PROVIDER: undefined },\n  });\n  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n}\n\nlet dir: string;\nbeforeEach(() => {\n  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-inspect-\"));\n});\nafterEach(() => {\n  rmSync(dir, { recursive: true, force: true });\n});\n\n// Two closed turns (m1 prompt, m2 text, m3 call, m4 result; m6 prompt,\n// m7 text), drained in-process against the registry's deterministic\n// provider, then m2 deleted — so the parity sweep covers live, bounded,\n// deleted-included, and deleted-shown reads on one record.\nasync function seedThread(): Promise<string> {\n  const filePath = path.join(dir, \"inspect-parity.sqlite\");\n  const created = await threads.newThread({\n    filePath,\n    registryPath: path.join(dir, \"registry.sqlite\"),\n  });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  const provider = resolveNamedProvider(\"deterministic\");\n  if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n  const sdk = createSdk({ provider, mode: \"manual\" });\n  const batches = [\n    [\n      validEvent(\"user_prompt\", { payload: { text: \"please read notes.txt\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"reading it now\" } }),\n      validEvent(\"tool_call\", {\n        payload: {\n          toolCallId: \"call-parity-1\",\n          toolName: \"read_file\",\n          arguments: { path: \"notes.txt\" },\n        },\n      }),\n      validEvent(\"tool_result\", {\n        payload: {\n          toolCallId: \"call-parity-1\",\n          content: \"contents of notes.txt: full parity-fixture tool output\",\n          isError: false,\n        },\n      }),\n      validEvent(\"turn_end\"),\n    ],\n    [\n      validEvent(\"user_prompt\", { payload: { text: \"summarize what you read\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"here is the summary\" } }),\n      validEvent(\"turn_end\"),\n    ],\n  ];\n  for (const batch of batches) {\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    if (!sent.ok) throw new Error(`fixture batch failed: ${sent.error.reason}`);\n  }\n  const drained = await sdk.work.drain({ filePath });\n  if (!drained.ok || drained.value.remaining !== 0) {\n    throw new Error(\"fixture drain did not settle\");\n  }\n  const deleted = await messages.deleteMessage({ filePath }, { messageId: \"m2\" });\n  if (!deleted.ok) throw new Error(`fixture delete failed: ${deleted.error.reason}`);\n  return filePath;\n}\n\ndescribe(\"TC-3.4 / AC-3.4: spawned-CLI message list/show parity with the SDK\", () => {\n  it(\"messages list mirrors the SDK across default, bounded, include-deleted, and refused options\", async () => {\n    const filePath = await seedThread();\n    const cases: Array<{ args: string[]; opts: MessageListOptions; ok: boolean }> = [\n      { args: [], opts: {}, ok: true },\n      { args: [\"--from\", \"2\", \"--to\", \"4\"], opts: { from: 2, to: 4 }, ok: true },\n      { args: [\"--limit\", \"2\"], opts: { limit: 2 }, ok: true },\n      { args: [\"--include-deleted\"], opts: { includeDeleted: true }, ok: true },\n      {\n        args: [\"--from\", \"3\", \"--limit\", \"2\", \"--include-deleted\"],\n        opts: { from: 3, limit: 2, includeDeleted: true },\n        ok: true,\n      },\n      // The refusal leg: bad bounds carry the same structured error through\n      // the process boundary, exit 1.\n      { args: [\"--from\", \"5\", \"--to\", \"2\"], opts: { from: 5, to: 2 }, ok: false },\n    ];\n    for (const parity of cases) {\n      const viaSdk = await messages.listMessages({ filePath }, parity.opts);\n      expect(viaSdk.ok).toBe(parity.ok);\n      const viaCli = runBinary([\"messages\", \"list\", \"--file-path\", filePath, ...parity.args]);\n      expect(viaCli.status).toBe(parity.ok ? 0 : 1);\n      expect(JSON.parse(viaCli.stdout)).toEqual(viaSdk);\n    }\n    // Six serial dist/cli.js spawns push past Vitest's 5000ms default on a\n    // loaded machine; the explicit budget keeps the configured verify-all gate\n    // stable (SV-01-003), matching the other process-suite spawn tests.\n  }, 30000);\n\n  it(\"messages show mirrors the SDK for live, deleted, and missing targets\", async () => {\n    const filePath = await seedThread();\n    for (const messageId of [\n      \"m4\", // live drained tool result, forms attached\n      \"m2\", // deleted: ok + flag — the audit read\n      \"m99\", // missing: message_not_found, exit 1\n    ]) {\n      const viaSdk = await messages.show({ filePath }, messageId);\n      const viaCli = runBinary([\n        \"messages\",\n        \"show\",\n        \"--file-path\",\n        filePath,\n        \"--message-id\",\n        messageId,\n      ]);\n      expect(viaCli.status).toBe(viaSdk.ok ? 0 : 1);\n      expect(JSON.parse(viaCli.stdout)).toEqual(viaSdk);\n    }\n    // The deleted target succeeds with the flag; the missing one refuses —\n    // pinned here so the loop's parity can't both-sides-drift.\n    const deletedShown = await messages.show({ filePath }, \"m2\");\n    expect(deletedShown.ok).toBe(true);\n    if (deletedShown.ok) expect(deletedShown.value.deleted).toBe(true);\n    const missing = await messages.show({ filePath }, \"m99\");\n    expect(missing.ok).toBe(false);\n    if (!missing.ok) expect(missing.error.code).toBe(\"message_not_found\");\n    // Same spawn-cost budget as the list leg, for the same gate-stability\n    // reason (SV-01-003).\n  }, 30000);\n});\n","numLines":157,"startLine":1,"totalLines":157}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VeYAPoWNzHa9VnjRwpqfdY","type":"tool_result","content":"1\t// Epic 03 Story 5: render targets (TC-5.1, TC-5.2, TC-5.3, TC-5.5). One\n2\t// view, two shapes: the pull's message array and the materialized PI session\n3\t// file must carry the same content because they come from the same assembly.\n4\t// Every TC goes through the real SDK surface (createSdk().threadView.*)\n5\t// against real temp thread files; the provider double appears only in\n6\t// fixture setup. The format fixture is a structure-trimmed REAL PI session\n7\t// file (test/fixtures/pi-session-structure.jsonl, provenance note beside it)\n8\t// — conformance shapes derive from it at runtime, never from the design's\n9\t// description. The CLI legs (TC-5.4 + parity rows) live in\n10\t// cli-process-view.test.ts under the process suite.\n11\timport { createHash } from \"node:crypto\";\n12\timport { readFileSync } from \"node:fs\";\n13\timport { join } from \"node:path\";\n14\timport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\n15\timport { createSdk, type Lhc, type ViewMessage } from \"../src/index.js\";\n16\timport {\n17\t  assertPiSessionConformance,\n18\t  createProviderDouble,\n19\t  derivedThreadFixture,\n20\t  eventBatch,\n21\t  openRaw,\n22\t  tempStore,\n23\t  type DerivedThreadFixture,\n24\t  type TempStore,\n25\t} from \"./fixtures/index.js\";\n26\t\n27\tlet store: TempStore;\n28\tlet fixture: DerivedThreadFixture;\n29\t\n30\tbeforeAll(async () => {\n31\t  store = tempStore();\n32\t  fixture = await derivedThreadFixture(store);\n33\t});\n34\tafterAll(() => {\n35\t  store.cleanup();\n36\t});\n37\t\n38\t// All three bands non-empty (Story 2's reference config: smooth t7+t8,\n39\t// detailed c2, brief c1; compact point at t9's start).\n40\tconst GRADIENT_PARAMS = {\n41\t  lowerBound: 400,\n42\t  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\n43\t};\n44\t\n45\tfunction sha256(value: string | Buffer): string {\n46\t  return createHash(\"sha256\").update(value).digest(\"hex\");\n47\t}\n48\t\n49\t// Full thread-file state, view rows and boundary included — materialize must\n50\t// change NONE of it (AC-5.2: the write changes no thread state).\n51\tfunction fullStateHash(filePath: string): string {\n52\t  const db = openRaw(filePath);\n53\t  try {\n54\t    return sha256(\n55\t      JSON.stringify({\n56\t        events: db.prepare(`SELECT * FROM event ORDER BY event_order`).all(),\n57\t        messages: db.prepare(`SELECT * FROM message ORDER BY source_event_order`).all(),\n58\t        blocks: db\n59\t          .prepare(`SELECT * FROM message_block ORDER BY message_id, block_index`)\n60\t          .all(),\n61\t        turns: db.prepare(`SELECT * FROM turns ORDER BY turn_order`).all(),\n62\t        chunks: db.prepare(`SELECT * FROM chunk ORDER BY chunk_order`).all(),\n63\t        members: db\n64\t          .prepare(`SELECT * FROM chunk_member ORDER BY chunk_id, member_idx`)\n65\t          .all(),\n66\t        forms: db\n67\t          .prepare(`SELECT * FROM derived_form ORDER BY subject_kind, subject_id, form`)\n68\t          .all(),\n69\t        views: db.prepare(`SELECT * FROM thread_view`).all(),\n70\t        bands: db.prepare(`SELECT * FROM thread_view_band ORDER BY band`).all(),\n71\t        boundary: db.prepare(`SELECT * FROM view_boundary`).all(),\n72\t        work: db.prepare(`SELECT * FROM work_item ORDER BY work_item_id`).all(),\n73\t      }),\n74\t    );\n75\t  } finally {\n76\t    db.close();\n77\t  }\n78\t}\n79\t\n80\tinterface SessionEntry {\n81\t  type: string;\n82\t  id: string;\n83\t  parentId: string | null;\n84\t  timestamp: string;\n85\t  message: { role: string; content: Array<{ type: string; text: string }> };\n86\t}\n87\t\n88\tfunction readSessionFile(path: string): {\n89\t  text: string;\n90\t  header: Record<string, unknown>;\n91\t  entries: SessionEntry[];\n92\t} {\n93\t  const text = readFileSync(path, \"utf8\");\n94\t  const lines = text.split(\"\\n\").filter((line) => line !== \"\");\n95\t  const header = JSON.parse(lines[0] ?? \"{}\") as Record<string, unknown>;\n96\t  const entries = lines.slice(1).map((line) => JSON.parse(line) as SessionEntry);\n97\t  return { text, header, entries };\n98\t}\n99\t\n100\tdescribe(\"TC-5.1 (AC-5.1): pull opens with band context messages in gradient order, tail in record order, deterministic\", () => {\n101\t  it(\"bands brief → detailed → smooth with labels, then the tail; repeated pulls byte-identical\", async () => {\n102\t    const ref = { filePath: fixture.filePath };\n103\t    const compacted = await fixture.sdk.threadView.compact(ref, { params: GRADIENT_PARAMS });\n104\t    expect(compacted.ok).toBe(true);\n105\t\n106\t    const first = await fixture.sdk.threadView.pull(ref);\n107\t    expect(first.ok).toBe(true);\n108\t    if (!first.ok) return;\n109\t    const messages = first.value.messages;\n110\t\n111\t    // Band messages open the array in gradient order, each a labeled `user`\n112\t    // context message carrying its band marker.\n113\t    const bands = messages.filter((m) => m.band !== undefined);\n114\t    expect(bands.map((m) => m.band)).toEqual([\"brief\", \"detailed\", \"smooth\"]);\n115\t    for (const band of bands) {\n116\t      expect(band.role).toBe(\"user\");\n117\t      expect(band.content.startsWith(`[context · ${band.band}]\\n`)).toBe(true);\n118\t    }\n119\t    expect(messages.slice(0, bands.length)).toEqual(bands);\n120\t\n121\t    // Tail follows in record order: with this config the compact point sits\n122\t    // at t9's start, so the tail opens with turn 9's prompt and carries the\n123\t    // turn 9–12 prompts in conversation order.\n124\t    const tail = messages.slice(bands.length);\n125\t    expect(tail.every((m) => m.band === undefined)).toBe(true);\n126\t    expect(tail[0]).toEqual({ role: \"user\", content: \"turn 9: please investigate area 9\" });\n127\t    const prompts = tail\n128\t      .filter((m) => m.content.startsWith(\"turn \"))\n129\t      .map((m) => m.content.split(\":\")[0]);\n130\t    expect(prompts).toEqual([\"turn 9\", \"turn 10\", \"turn 11\", \"turn 12\"]);\n131\t    // Roles per the pinned mapping: prompts/tool-results user, the\n132\t    // assistant kinds assistant.\n133\t    for (const m of tail) {\n134\t      if (m.content.startsWith(\"[tool call\") || m.content.startsWith(\"[thinking]\")) {\n135\t        expect(m.role).toBe(\"assistant\");\n136\t      }\n137\t      if (m.content.startsWith(\"[tool result\")) expect(m.role).toBe(\"user\");\n138\t    }\n139\t\n140\t    // Deterministic across repeated pulls: byte-identical result.\n141\t    const second = await fixture.sdk.threadView.pull(ref);\n142\t    expect(second.ok).toBe(true);\n143\t    if (!second.ok) return;\n144\t    expect(JSON.stringify(second.value)).toBe(JSON.stringify(first.value));\n145\t  });\n146\t});\n147\t\n148\tdescribe(\"TC-5.2 (AC-5.2, AC-5.3): materialize/pull parity, byte-identical repeat, thread state untouched\", () => {\n149\t  it(\"every pull message appears in the file, same order, same text; repeat is byte-identical; state hash unchanged\", async () => {\n150\t    const ref = { filePath: fixture.filePath };\n151\t    // The view from TC-5.1's compact (suite order) — recompact defensively so\n152\t    // this test stands alone too.\n153\t    const compacted = await fixture.sdk.threadView.compact(ref, { params: GRADIENT_PARAMS });\n154\t    expect(compacted.ok).toBe(true);\n155\t    const pulled = await fixture.sdk.threadView.pull(ref);\n156\t    expect(pulled.ok).toBe(true);\n157\t    if (!pulled.ok) return;\n158\t\n159\t    const before = fullStateHash(fixture.filePath);\n160\t    const outPath = join(store.dir, \"render-parity.jsonl\");\n161\t    const materialized = await fixture.sdk.threadView.materialize(ref, { path: outPath });\n162\t    expect(materialized.ok).toBe(true);\n163\t    if (!materialized.ok) return;\n164\t    expect(materialized.value.writtenPath).toBe(outPath);\n165\t\n166\t    // Item-for-item parity: same count, same order, same role, same rendered\n167\t    // text in the target encoding (one text block per message).\n168\t    const file = readSessionFile(outPath);\n169\t    expect(file.entries).toHaveLength(pulled.value.messages.length);\n170\t    file.entries.forEach((entry, i) => {\n171\t      const source = pulled.value.messages[i] as ViewMessage;\n172\t      expect(entry.message.role).toBe(source.role);\n173\t      expect(entry.message.content).toEqual([{ type: \"text\", text: source.content }]);\n174\t    });\n175\t\n176\t    // Band entries' generated fields derive from view metadata: the view's\n177\t    // created-at and viewId, never a write-time clock.\n178\t    expect(file.entries[0]?.timestamp).toBe(pulled.value.meta.createdAt);\n179\t    expect(file.entries[0]?.id).toBe(`${pulled.value.meta.viewId}-brief`);\n180\t    expect(file.header[\"timestamp\"]).toBe(pulled.value.meta.createdAt);\n181\t\n182\t    // Repeat with no thread changes → byte-identical file.\n183\t    const again = await fixture.sdk.threadView.materialize(ref, { path: outPath });\n184\t    expect(again.ok).toBe(true);\n185\t    expect(sha256(readFileSync(outPath))).toBe(sha256(Buffer.from(file.text)));\n186\t\n187\t    // The write changed no thread state — full-file hash, view rows and\n188\t    // boundary included.\n189\t    expect(fullStateHash(fixture.filePath)).toBe(before);\n190\t  });\n191\t\n192\t  it(\"rejects an unknown format naming the accepted values, writing nothing\", async () => {\n193\t    const outPath = join(store.dir, \"never-written.jsonl\");\n194\t    const result = await fixture.sdk.threadView.materialize(\n195\t      { filePath: fixture.filePath },\n196\t      { path: outPath, format: \"markdown\" as \"pi-session\" },\n197\t    );\n198\t    expect(result.ok).toBe(false);\n199\t    if (result.ok) return;\n200\t    expect(result.error.errorClass).toBe(\"caller_error\");\n201\t    expect(result.error.code).toBe(\"unknown_format\");\n202\t    expect(result.error.reason).toContain(\"pi-session\");\n203\t    expect(() => readFileSync(outPath)).toThrow();\n204\t  });\n205\t});\n206\t\n207\tdescribe(\"TC-5.3 (AC-5.4): a never-compacted thread materializes its tail-only view\", () => {\n208\t  it(\"valid file, tail-only content, loadable against the format fixture, header from the thread's created-at\", async () => {\n209\t    const sdk: Lhc = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n210\t    const filePath = store.threadPath(\"never-compacted\");\n211\t    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n212\t    expect(created.ok).toBe(true);\n213\t    const seeded = await sdk.intakeStream.messageEvents({ filePath }, [\n214\t      ...eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n215\t      ...eventBatch([\"user_prompt\", \"assistant_text\"]),\n216\t    ]);\n217\t    expect(seeded.ok).toBe(true);\n218\t\n219\t    const outPath = join(store.dir, \"tail-only.jsonl\");\n220\t    const materialized = await sdk.threadView.materialize({ filePath }, { path: outPath });\n221\t    expect(materialized.ok).toBe(true);\n222\t\n223\t    const file = readSessionFile(outPath);\n224\t    expect(() => assertPiSessionConformance(file.text)).not.toThrow();\n225\t\n226\t    // Tail-only: every entry is a record message (no band context entries),\n227\t    // matching the pull of the same never-compacted thread.\n228\t    const pulled = await sdk.threadView.pull({ filePath });\n229\t    expect(pulled.ok).toBe(true);\n230\t    if (!pulled.ok) return;\n231\t    expect(pulled.value.meta.viewId).toBeNull();\n232\t    // Four record messages (turn_end projects no message), zero band entries.\n233\t    expect(file.entries).toHaveLength(4);\n234\t    expect(file.entries.every((e) => !e.message.content[0]?.text.startsWith(\"[context ·\"))).toBe(\n235\t      true,\n236\t    );\n237\t    file.entries.forEach((entry, i) => {\n238\t      expect(entry.message.content[0]?.text).toBe(pulled.value.messages[i]?.content);\n239\t    });\n240\t\n241\t    // viewId null ⇒ the header derives from the thread's created-at.\n242\t    const db = openRaw(filePath);\n243\t    const meta = db\n244\t      .prepare(`SELECT thread_id, created_at FROM thread_metadata WHERE id = 1`)\n245\t      .get() as { thread_id: string; created_at: string };\n246\t    db.close();\n247\t    expect(file.header[\"timestamp\"]).toBe(meta.created_at);\n248\t    expect(file.header[\"id\"]).toBe(`${meta.thread_id}:${meta.created_at}`);\n249\t  });\n250\t});\n251\t\n252\tdescribe(\"TC-5.5 (AC-5.3): materialized file conforms to the real-PI-session structure fixture\", () => {\n253\t  it(\"header line, entry shape, parentId chain, message encoding all validate\", async () => {\n254\t    const ref = { filePath: fixture.filePath };\n255\t    const compacted = await fixture.sdk.threadView.compact(ref, { params: GRADIENT_PARAMS });\n256\t    expect(compacted.ok).toBe(true);\n257\t    const outPath = join(store.dir, \"conformance.jsonl\");\n258\t    const materialized = await fixture.sdk.threadView.materialize(ref, { path: outPath });\n259\t    expect(materialized.ok).toBe(true);\n260\t\n261\t    const file = readSessionFile(outPath);\n262\t    expect(() => assertPiSessionConformance(file.text)).not.toThrow();\n263\t\n264\t    // The chain explicitly, beyond the helper: first entry parentId null,\n265\t    // every later entry chained to the previous id.\n266\t    expect(file.entries[0]?.parentId).toBeNull();\n267\t    for (let i = 1; i < file.entries.length; i += 1) {\n268\t      expect(file.entries[i]?.parentId).toBe(file.entries[i - 1]?.id);\n269\t    }\n270\t  });\n271\t});\n272\t"}]},"parent_tool_use_id":null,"session_id":"77c6c733-044c-452a-abeb-bd7584806be0","uuid":"4612e85b-7314-45b4-98b6-4107438d8cab","timestamp":"2026-06-12T15:08:26.658Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-render-targets.test.ts","content":"// Epic 03 Story 5: render targets (TC-5.1, TC-5.2, TC-5.3, TC-5.5). One\n// view, two shapes: the pull's message array and the materialized PI session\n// file must carry the same content because they come from the same assembly.\n// Every TC goes through the real SDK surface (createSdk().threadView.*)\n// against real temp thread files; the provider double appears only in\n// fixture setup. The format fixture is a structure-trimmed REAL PI session\n// file (test/fixtures/pi-session-structure.jsonl, provenance note beside it)\n// — conformance shapes derive from it at runtime, never from the design's\n// description. The CLI legs (TC-5.4 + parity rows) live in\n// cli-process-view.test.ts under the process suite.\nimport { createHash } from \"node:crypto\";\nimport { readFileSync } from \"node:fs\";\nimport { join } from \"node:path\";\nimport { afterAll, beforeAll, describe, expect, it } from \"vitest\";\nimport { createSdk, type Lhc, type ViewMessage } from \"../src/index.js\";\nimport {\n  assertPiSessionConformance,\n  createProviderDouble,\n  derivedThreadFixture,\n  eventBatch,\n  openRaw,\n  tempStore,\n  type DerivedThreadFixture,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nlet fixture: DerivedThreadFixture;\n\nbeforeAll(async () => {\n  store = tempStore();\n  fixture = await derivedThreadFixture(store);\n});\nafterAll(() => {\n  store.cleanup();\n});\n\n// All three bands non-empty (Story 2's reference config: smooth t7+t8,\n// detailed c2, brief c1; compact point at t9's start).\nconst GRADIENT_PARAMS = {\n  lowerBound: 400,\n  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\n};\n\nfunction sha256(value: string | Buffer): string {\n  return createHash(\"sha256\").update(value).digest(\"hex\");\n}\n\n// Full thread-file state, view rows and boundary included — materialize must\n// change NONE of it (AC-5.2: the write changes no thread state).\nfunction fullStateHash(filePath: string): string {\n  const db = openRaw(filePath);\n  try {\n    return sha256(\n      JSON.stringify({\n        events: db.prepare(`SELECT * FROM event ORDER BY event_order`).all(),\n        messages: db.prepare(`SELECT * FROM message ORDER BY source_event_order`).all(),\n        blocks: db\n          .prepare(`SELECT * FROM message_block ORDER BY message_id, block_index`)\n          .all(),\n        turns: db.prepare(`SELECT * FROM turns ORDER BY turn_order`).all(),\n        chunks: db.prepare(`SELECT * FROM chunk ORDER BY chunk_order`).all(),\n        members: db\n          .prepare(`SELECT * FROM chunk_member ORDER BY chunk_id, member_idx`)\n          .all(),\n        forms: db\n          .prepare(`SELECT * FROM derived_form ORDER BY subject_kind, subject_id, form`)\n          .all(),\n        views: db.prepare(`SELECT * FROM thread_view`).all(),\n        bands: db.prepare(`SELECT * FROM thread_view_band ORDER BY band`).all(),\n        boundary: db.prepare(`SELECT * FROM view_boundary`).all(),\n        work: db.prepare(`SELECT * FROM work_item ORDER BY work_item_id`).all(),\n      }),\n    );\n  } finally {\n    db.close();\n  }\n}\n\ninterface SessionEntry {\n  type: string;\n  id: string;\n  parentId: string | null;\n  timestamp: string;\n  message: { role: string; content: Array<{ type: string; text: string }> };\n}\n\nfunction readSessionFile(path: string): {\n  text: string;\n  header: Record<string, unknown>;\n  entries: SessionEntry[];\n} {\n  const text = readFileSync(path, \"utf8\");\n  const lines = text.split(\"\\n\").filter((line) => line !== \"\");\n  const header = JSON.parse(lines[0] ?? \"{}\") as Record<string, unknown>;\n  const entries = lines.slice(1).map((line) => JSON.parse(line) as SessionEntry);\n  return { text, header, entries };\n}\n\ndescribe(\"TC-5.1 (AC-5.1): pull opens with band context messages in gradient order, tail in record order, deterministic\", () => {\n  it(\"bands brief → detailed → smooth with labels, then the tail; repeated pulls byte-identical\", async () => {\n    const ref = { filePath: fixture.filePath };\n    const compacted = await fixture.sdk.threadView.compact(ref, { params: GRADIENT_PARAMS });\n    expect(compacted.ok).toBe(true);\n\n    const first = await fixture.sdk.threadView.pull(ref);\n    expect(first.ok).toBe(true);\n    if (!first.ok) return;\n    const messages = first.value.messages;\n\n    // Band messages open the array in gradient order, each a labeled `user`\n    // context message carrying its band marker.\n    const bands = messages.filter((m) => m.band !== undefined);\n    expect(bands.map((m) => m.band)).toEqual([\"brief\", \"detailed\", \"smooth\"]);\n    for (const band of bands) {\n      expect(band.role).toBe(\"user\");\n      expect(band.content.startsWith(`[context · ${band.band}]\\n`)).toBe(true);\n    }\n    expect(messages.slice(0, bands.length)).toEqual(bands);\n\n    // Tail follows in record order: with this config the compact point sits\n    // at t9's start, so the tail opens with turn 9's prompt and carries the\n    // turn 9–12 prompts in conversation order.\n    const tail = messages.slice(bands.length);\n    expect(tail.every((m) => m.band === undefined)).toBe(true);\n    expect(tail[0]).toEqual({ role: \"user\", content: \"turn 9: please investigate area 9\" });\n    const prompts = tail\n      .filter((m) => m.content.startsWith(\"turn \"))\n      .map((m) => m.content.split(\":\")[0]);\n    expect(prompts).toEqual([\"turn 9\", \"turn 10\", \"turn 11\", \"turn 12\"]);\n    // Roles per the pinned mapping: prompts/tool-results user, the\n    // assistant kinds assistant.\n    for (const m of tail) {\n      if (m.content.startsWith(\"[tool call\") || m.content.startsWith(\"[thinking]\")) {\n        expect(m.role).toBe(\"assistant\");\n      }\n      if (m.content.startsWith(\"[tool result\")) expect(m.role).toBe(\"user\");\n    }\n\n    // Deterministic across repeated pulls: byte-identical result.\n    const second = await fixture.sdk.threadView.pull(ref);\n    expect(second.ok).toBe(true);\n    if (!second.ok) return;\n    expect(JSON.stringify(second.value)).toBe(JSON.stringify(first.value));\n  });\n});\n\ndescribe(\"TC-5.2 (AC-5.2, AC-5.3): materialize/pull parity, byte-identical repeat, thread state untouched\", () => {\n  it(\"every pull message appears in the file, same order, same text; repeat is byte-identical; state hash unchanged\", async () => {\n    const ref = { filePath: fixture.filePath };\n    // The view from TC-5.1's compact (suite order) — recompact defensively so\n    // this test stands alone too.\n    const compacted = await fixture.sdk.threadView.compact(ref, { params: GRADIENT_PARAMS });\n    expect(compacted.ok).toBe(true);\n    const pulled = await fixture.sdk.threadView.pull(ref);\n    expect(pulled.ok).toBe(true);\n    if (!pulled.ok) return;\n\n    const before = fullStateHash(fixture.filePath);\n    const outPath = join(store.dir, \"render-parity.jsonl\");\n    const materialized = await fixture.sdk.threadView.materialize(ref, { path: outPath });\n    expect(materialized.ok).toBe(true);\n    if (!materialized.ok) return;\n    expect(materialized.value.writtenPath).toBe(outPath);\n\n    // Item-for-item parity: same count, same order, same role, same rendered\n    // text in the target encoding (one text block per message).\n    const file = readSessionFile(outPath);\n    expect(file.entries).toHaveLength(pulled.value.messages.length);\n    file.entries.forEach((entry, i) => {\n      const source = pulled.value.messages[i] as ViewMessage;\n      expect(entry.message.role).toBe(source.role);\n      expect(entry.message.content).toEqual([{ type: \"text\", text: source.content }]);\n    });\n\n    // Band entries' generated fields derive from view metadata: the view's\n    // created-at and viewId, never a write-time clock.\n    expect(file.entries[0]?.timestamp).toBe(pulled.value.meta.createdAt);\n    expect(file.entries[0]?.id).toBe(`${pulled.value.meta.viewId}-brief`);\n    expect(file.header[\"timestamp\"]).toBe(pulled.value.meta.createdAt);\n\n    // Repeat with no thread changes → byte-identical file.\n    const again = await fixture.sdk.threadView.materialize(ref, { path: outPath });\n    expect(again.ok).toBe(true);\n    expect(sha256(readFileSync(outPath))).toBe(sha256(Buffer.from(file.text)));\n\n    // The write changed no thread state — full-file hash, view rows and\n    // boundary included.\n    expect(fullStateHash(fixture.filePath)).toBe(before);\n  });\n\n  it(\"rejects an unknown format naming the accepted values, writing nothing\", async () => {\n    const outPath = join(store.dir, \"never-written.jsonl\");\n    const result = await fixture.sdk.threadView.materialize(\n      { filePath: fixture.filePath },\n      { path: outPath, format: \"markdown\" as \"pi-session\" },\n    );\n    expect(result.ok).toBe(false);\n    if (result.ok) return;\n    expect(result.error.errorClass).toBe(\"caller_error\");\n    expect(result.error.code).toBe(\"unknown_format\");\n    expect(result.error.reason).toContain(\"pi-session\");\n    expect(() => readFileSync(outPath)).toThrow();\n  });\n});\n\ndescribe(\"TC-5.3 (AC-5.4): a never-compacted thread materializes its tail-only view\", () => {\n  it(\"valid file, tail-only content, loadable against the format fixture, header from the thread's created-at\", async () => {\n    const sdk: Lhc = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n    const filePath = store.threadPath(\"never-compacted\");\n    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n    expect(created.ok).toBe(true);\n    const seeded = await sdk.intakeStream.messageEvents({ filePath }, [\n      ...eventBatch([\"user_prompt\", \"assistant_text\", \"turn_end\"]),\n      ...eventBatch([\"user_prompt\", \"assistant_text\"]),\n    ]);\n    expect(seeded.ok).toBe(true);\n\n    const outPath = join(store.dir, \"tail-only.jsonl\");\n    const materialized = await sdk.threadView.materialize({ filePath }, { path: outPath });\n    expect(materialized.ok).toBe(true);\n\n    const file = readSessionFile(outPath);\n    expect(() => assertPiSessionConformance(file.text)).not.toThrow();\n\n    // Tail-only: every entry is a record message (no band context entries),\n    // matching the pull of the same never-compacted thread.\n    const pulled = await sdk.threadView.pull({ filePath });\n    expect(pulled.ok).toBe(true);\n    if (!pulled.ok) return;\n    expect(pulled.value.meta.viewId).toBeNull();\n    // Four record messages (turn_end projects no message), zero band entries.\n    expect(file.entries).toHaveLength(4);\n    expect(file.entries.every((e) => !e.message.content[0]?.text.startsWith(\"[context ·\"))).toBe(\n      true,\n    );\n    file.entries.forEach((entry, i) => {\n      expect(entry.message.content[0]?.text).toBe(pulled.value.messages[i]?.content);\n    });\n\n    // viewId null ⇒ the header derives from the thread's created-at.\n    const db = openRaw(filePath);\n    const meta = db\n      .prepare(`SELECT thread_id, created_at FROM thread_metadata WHERE id = 1`)\n      .get() as { thread_id: string; created_at: string };\n    db.close();\n    expect(file.header[\"timestamp\"]).toBe(meta.created_at);\n    expect(file.header[\"id\"]).toBe(`${meta.thread_id}:${meta.created_at}`);\n  });\n});\n\ndescribe(\"TC-5.5 (AC-5.3): materialized file conforms to the real-PI-session structure fixture\", () => {\n  it(\"header line, entry shape, parentId chain, message encoding all validate\", async () => {\n    const ref = { filePath: fixture.filePath };\n    const compacted = await fixture.sdk.threadView.compact(ref, { params: GRADIENT_PARAMS });\n    expect(compacted.ok).toBe(true);\n    const outPath = join(store.dir, \"conformance.jsonl\");\n    const materialized = await fixture.sdk.threadView.materialize(ref, { path: outPath });\n    expect(materialized.ok).toBe(true);\n\n    const file = readSessionFile(outPath);\n    expect(() => assertPiSessionConformance(file.text)).not.toThrow();\n\n    // The chain explicitly, beyond the helper: first entry parentId null,\n    // every later entry chained to the previous id.\n    expect(file.entries[0]?.parentId).toBeNull();\n    for (let i = 1; i < file.entries.length; i += 1) {\n      expect(file.entries[i]?.parentId).toBe(file.entries[i - 1]?.id);\n    }\n  });\n});\n","numLines":272,"startLine":1,"totalLines":272}}}

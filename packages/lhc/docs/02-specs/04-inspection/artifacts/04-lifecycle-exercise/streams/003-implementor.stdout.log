{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RcUcxdm4Tq838Q7tVzL9ii","type":"tool_result","content":"1\t// The shared read-only delta helper (Epic 04, DD-6): inspect describes,\n2\t// never changes — and that is asserted as ABSENCE OF DELTA in observable\n3\t// state, not absence of write code. Snapshot everything a forgotten side\n4\t// effect could move — queued work through both owners, boundary/zone/view\n5\t// identity through the thread-view surface, the event log, the audit message\n6\t// listing, and the raw derived-form rows — before and after an operation,\n7\t// and require deep equality. Lands with Story 2 and wraps Story 1's read\n8\t// ops retroactively (test plan, Chunk 2).\n9\timport { deepStrictEqual } from \"node:assert/strict\";\n10\timport { intakeStream, messages, threadView, turns } from \"../../src/index.js\";\n11\timport { readDerivedForms } from \"./threads.js\";\n12\t\n13\texport interface ObservableState {\n14\t  events: unknown;\n15\t  messages: unknown;\n16\t  messageWork: unknown;\n17\t  turnWork: unknown;\n18\t  viewStatus: unknown;\n19\t  pullMeta: unknown;\n20\t  storedView: unknown;\n21\t  forms: unknown;\n22\t}\n23\t\n24\texport async function observableState(filePath: string): Promise<ObservableState> {\n25\t  const pulled = await threadView.pull({ filePath });\n26\t  return {\n27\t    events: await intakeStream.listEvents({ filePath }),\n28\t    messages: await messages.listMessages({ filePath }, { includeDeleted: true }),\n29\t    messageWork: await messages.listQueuedWork({ filePath }),\n30\t    turnWork: await turns.listQueuedWork({ filePath }),\n31\t    viewStatus: await threadView.status({ filePath }),\n32\t    pullMeta: pulled.ok ? pulled.value.meta : pulled,\n33\t    // The stored snapshot whole (Story 3): a forgotten view touch — config,\n34\t    // arrangement, band rows, provenance — moves this even when pull's meta\n35\t    // would not show it.\n36\t    storedView: await threadView.describe({ filePath }),\n37\t    forms: readDerivedForms(filePath),\n38\t  };\n39\t}\n40\t\n41\t// Run one operation under the before/after snapshot and return its result so\n42\t// call sites can keep asserting on it. Throws (deepStrictEqual) when the\n43\t// operation moved anything observable.\n44\texport async function expectReadOnly<T>(\n45\t  filePath: string,\n46\t  operation: () => Promise<T>,\n47\t): Promise<T> {\n48\t  const before = await observableState(filePath);\n49\t  const result = await operation();\n50\t  deepStrictEqual(\n51\t    await observableState(filePath),\n52\t    before,\n53\t    \"read-only delta: operation changed observable state\",\n54\t  );\n55\t  return result;\n56\t}\n57\t"}]},"parent_tool_use_id":null,"session_id":"77c6c733-044c-452a-abeb-bd7584806be0","uuid":"f0fadbcc-1d6e-48a7-b2c2-9a446b5b3bfe","timestamp":"2026-06-12T15:08:41.550Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/read-only-delta.ts","content":"// The shared read-only delta helper (Epic 04, DD-6): inspect describes,\n// never changes — and that is asserted as ABSENCE OF DELTA in observable\n// state, not absence of write code. Snapshot everything a forgotten side\n// effect could move — queued work through both owners, boundary/zone/view\n// identity through the thread-view surface, the event log, the audit message\n// listing, and the raw derived-form rows — before and after an operation,\n// and require deep equality. Lands with Story 2 and wraps Story 1's read\n// ops retroactively (test plan, Chunk 2).\nimport { deepStrictEqual } from \"node:assert/strict\";\nimport { intakeStream, messages, threadView, turns } from \"../../src/index.js\";\nimport { readDerivedForms } from \"./threads.js\";\n\nexport interface ObservableState {\n  events: unknown;\n  messages: unknown;\n  messageWork: unknown;\n  turnWork: unknown;\n  viewStatus: unknown;\n  pullMeta: unknown;\n  storedView: unknown;\n  forms: unknown;\n}\n\nexport async function observableState(filePath: string): Promise<ObservableState> {\n  const pulled = await threadView.pull({ filePath });\n  return {\n    events: await intakeStream.listEvents({ filePath }),\n    messages: await messages.listMessages({ filePath }, { includeDeleted: true }),\n    messageWork: await messages.listQueuedWork({ filePath }),\n    turnWork: await turns.listQueuedWork({ filePath }),\n    viewStatus: await threadView.status({ filePath }),\n    pullMeta: pulled.ok ? pulled.value.meta : pulled,\n    // The stored snapshot whole (Story 3): a forgotten view touch — config,\n    // arrangement, band rows, provenance — moves this even when pull's meta\n    // would not show it.\n    storedView: await threadView.describe({ filePath }),\n    forms: readDerivedForms(filePath),\n  };\n}\n\n// Run one operation under the before/after snapshot and return its result so\n// call sites can keep asserting on it. Throws (deepStrictEqual) when the\n// operation moved anything observable.\nexport async function expectReadOnly<T>(\n  filePath: string,\n  operation: () => Promise<T>,\n): Promise<T> {\n  const before = await observableState(filePath);\n  const result = await operation();\n  deepStrictEqual(\n    await observableState(filePath),\n    before,\n    \"read-only delta: operation changed observable state\",\n  );\n  return result;\n}\n","numLines":57,"startLine":1,"totalLines":57}}}

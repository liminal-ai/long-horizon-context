{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012o11brCbMSNrgKsws5GQQJ","type":"tool_result","content":"1\t// Epic 04 shared vocabulary: the inspect domain's report shapes (tech design\n2\t// §Interface Definitions). Inspect is a pure consumer — these shapes carry\n3\t// other domains' surface output composed into counts and summaries; nothing\n4\t// here is re-derived or re-interpreted beyond the owners' reported states.\n5\timport type { Band } from \"./view.js\";\n6\t\n7\texport interface InspectOverview {\n8\t  thread: { id: string; createdAt: string; metadata?: Record<string, string> };\n9\t  // span null ⇔ count 0 (AC-1.3: absent pieces report as zeros/nulls).\n10\t  events: { count: number; span: { first: number; last: number } | null };\n11\t  // Deleted contract (AC-1.2): deleted messages appear only in `deleted` —\n12\t  // excluded from visible, byKind, and visibleTokens; event counts above are\n13\t  // unaffected (the record retains everything).\n14\t  messages: {\n15\t    visible: number;\n16\t    byKind: Record<string, number>;\n17\t    deleted: number;\n18\t    visibleTokens: number;\n19\t  };\n20\t  turns: { open: number; closed: number };\n21\t  chunks: { count: number; unchunkedTurns: number };\n22\t  // Counts by operational state across both owners' report surfaces; ready\n23\t  // included (AC-1.1 — unlike ViewStatus, which reports situations only).\n24\t  derivation: {\n25\t    ready: number;\n26\t    pending: number;\n27\t    retrying: number;\n28\t    failed: number;\n29\t    blocked: number;\n30\t  };\n31\t  // Active-view summary, or null when never compacted (AC-1.1).\n32\t  view: {\n33\t    viewId: string;\n34\t    createdAt: string;\n35\t    compactPoint: number;\n36\t    coveredFrom: number;\n37\t  } | null;\n38\t  visibility: { boundaryPosition: number; zoneTokens: number };\n39\t}\n40\t\n41\t// Story 3's shape, pinned with the domain so the inspect vocabulary lands\n42\t// whole (tech design §Interface Definitions); `inspect.view` serves it.\n43\texport interface ViewContentsReport {\n44\t  meta: {\n45\t    viewId: string;\n46\t    createdAt: string;\n47\t    profile: string | null;\n48\t    config: { lowerBound: number; percentages: Record<string, number> };\n49\t    compactPoint: number;\n50\t    coveredFrom: number;\n51\t  } | null;\n52\t  bands: Array<{\n53\t    band: Band;\n54\t    entries: Array<{\n55\t      subjectKind: \"chunk\" | \"turn\";\n56\t      subjectId: string;\n57\t      formUsed: string;\n58\t      degraded: boolean;\n59\t    }>;\n60\t    storedTokens: number;\n61\t  }>;\n62\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n63\t  tail: { messageCount: number; tokens: number }; // as served (AC-2.2)\n64\t  // loadCost totals what pull serves NOW (AC-2.3): band and tail tokens are\n65\t  // both measured over pull's served messages with the shared estimator, so\n66\t  // equality with an independent pull is structural. The stored per-band\n67\t  // counts stay reported above (bands[].storedTokens, AC-2.1) — they price\n68\t  // the snapshot bytes without the served band-marker header, so they are\n69\t  // describe's truth, not the serving cost.\n70\t  loadCost: { bandTokens: number; tailTokens: number; total: number }; // = pull (AC-2.3)\n71\t  // Provenance verbatim (AC-2.5); null on a never-compacted thread — no\n72\t  // compact ever recorded what it saw, and inventing zeros would fabricate\n73\t  // provenance (AC-2.4's view-null shape extends here).\n74\t  sourceState: { maxEventOrder: number; formCounts: Record<string, number> } | null;\n75\t}\n76\t\n77\texport interface HealthReport {\n78\t  // Counts by owner, form kind, and operational state (AC-4.1), assembled\n79\t  // entirely from the owners' report surfaces.\n80\t  owners: Array<{\n81\t    owner: \"messages\" | \"turns\";\n82\t    kind: string;\n83\t    counts: {\n84\t      ready: number;\n85\t      pending: number;\n86\t      retrying: number;\n87\t      failed: number;\n88\t      blocked: number;\n89\t    };\n90\t  }>;\n91\t  // Actionable failure detail (AC-4.2): enough to decide and target a\n92\t  // requeue without raw SQL.\n93\t  failures: Array<{\n94\t    owner: string;\n95\t    subjectKind: string;\n96\t    subjectId: string;\n97\t    form: string;\n98\t    reason: string;\n99\t    attempts: number;\n100\t    lastError?: string;\n101\t  }>;\n102\t  // What a requeue pass would touch — failed and not blocked — reported,\n103\t  // never executed (AC-4.3).\n104\t  repairPreview: Array<{\n105\t    owner: string;\n106\t    subjectKind: string;\n107\t    subjectId: string;\n108\t    form: string;\n109\t  }>;\n110\t  // Live queue visibility from the owners' queue detail (AC-4.5), counted\n111\t  // per report entry so the section is consistent by construction with the\n112\t  // pending/retrying state counts in the same report.\n113\t  queue: { queued: number; claimed: number };\n114\t}\n115\t"}]},"parent_tool_use_id":null,"session_id":"77c6c733-044c-452a-abeb-bd7584806be0","uuid":"6705b42f-a51b-4bda-a29b-3acdfcaa21d4","timestamp":"2026-06-12T15:18:07.738Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/shared/inspect.ts","content":"// Epic 04 shared vocabulary: the inspect domain's report shapes (tech design\n// §Interface Definitions). Inspect is a pure consumer — these shapes carry\n// other domains' surface output composed into counts and summaries; nothing\n// here is re-derived or re-interpreted beyond the owners' reported states.\nimport type { Band } from \"./view.js\";\n\nexport interface InspectOverview {\n  thread: { id: string; createdAt: string; metadata?: Record<string, string> };\n  // span null ⇔ count 0 (AC-1.3: absent pieces report as zeros/nulls).\n  events: { count: number; span: { first: number; last: number } | null };\n  // Deleted contract (AC-1.2): deleted messages appear only in `deleted` —\n  // excluded from visible, byKind, and visibleTokens; event counts above are\n  // unaffected (the record retains everything).\n  messages: {\n    visible: number;\n    byKind: Record<string, number>;\n    deleted: number;\n    visibleTokens: number;\n  };\n  turns: { open: number; closed: number };\n  chunks: { count: number; unchunkedTurns: number };\n  // Counts by operational state across both owners' report surfaces; ready\n  // included (AC-1.1 — unlike ViewStatus, which reports situations only).\n  derivation: {\n    ready: number;\n    pending: number;\n    retrying: number;\n    failed: number;\n    blocked: number;\n  };\n  // Active-view summary, or null when never compacted (AC-1.1).\n  view: {\n    viewId: string;\n    createdAt: string;\n    compactPoint: number;\n    coveredFrom: number;\n  } | null;\n  visibility: { boundaryPosition: number; zoneTokens: number };\n}\n\n// Story 3's shape, pinned with the domain so the inspect vocabulary lands\n// whole (tech design §Interface Definitions); `inspect.view` serves it.\nexport interface ViewContentsReport {\n  meta: {\n    viewId: string;\n    createdAt: string;\n    profile: string | null;\n    config: { lowerBound: number; percentages: Record<string, number> };\n    compactPoint: number;\n    coveredFrom: number;\n  } | null;\n  bands: Array<{\n    band: Band;\n    entries: Array<{\n      subjectKind: \"chunk\" | \"turn\";\n      subjectId: string;\n      formUsed: string;\n      degraded: boolean;\n    }>;\n    storedTokens: number;\n  }>;\n  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n  tail: { messageCount: number; tokens: number }; // as served (AC-2.2)\n  // loadCost totals what pull serves NOW (AC-2.3): band and tail tokens are\n  // both measured over pull's served messages with the shared estimator, so\n  // equality with an independent pull is structural. The stored per-band\n  // counts stay reported above (bands[].storedTokens, AC-2.1) — they price\n  // the snapshot bytes without the served band-marker header, so they are\n  // describe's truth, not the serving cost.\n  loadCost: { bandTokens: number; tailTokens: number; total: number }; // = pull (AC-2.3)\n  // Provenance verbatim (AC-2.5); null on a never-compacted thread — no\n  // compact ever recorded what it saw, and inventing zeros would fabricate\n  // provenance (AC-2.4's view-null shape extends here).\n  sourceState: { maxEventOrder: number; formCounts: Record<string, number> } | null;\n}\n\nexport interface HealthReport {\n  // Counts by owner, form kind, and operational state (AC-4.1), assembled\n  // entirely from the owners' report surfaces.\n  owners: Array<{\n    owner: \"messages\" | \"turns\";\n    kind: string;\n    counts: {\n      ready: number;\n      pending: number;\n      retrying: number;\n      failed: number;\n      blocked: number;\n    };\n  }>;\n  // Actionable failure detail (AC-4.2): enough to decide and target a\n  // requeue without raw SQL.\n  failures: Array<{\n    owner: string;\n    subjectKind: string;\n    subjectId: string;\n    form: string;\n    reason: string;\n    attempts: number;\n    lastError?: string;\n  }>;\n  // What a requeue pass would touch — failed and not blocked — reported,\n  // never executed (AC-4.3).\n  repairPreview: Array<{\n    owner: string;\n    subjectKind: string;\n    subjectId: string;\n    form: string;\n  }>;\n  // Live queue visibility from the owners' queue detail (AC-4.5), counted\n  // per report entry so the section is consistent by construction with the\n  // pending/retrying state counts in the same report.\n  queue: { queued: number; claimed: number };\n}\n","numLines":115,"startLine":1,"totalLines":115}}}

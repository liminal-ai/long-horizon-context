{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FVKaaodW89TANrY4oDCzes","type":"tool_result","content":"1\t// Story 2 (Epic 04), default suite: TC-4.1–4.3 — the inspect health report.\n2\t// Counts by owner/kind/state assembled entirely from the owners' report\n3\t// surfaces (AC-4.1), actionable failure detail (AC-4.2), a repair preview\n4\t// that is reported and never executed (AC-4.3), rebuild visibility bracketing\n5\t// a drain (AC-4.4), and live queue visibility consistent with the state\n6\t// counts in the same report (AC-4.5).\n7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n8\timport { createSdk, type HealthReport } from \"../src/index.js\";\n9\timport {\n10\t  createProviderDouble,\n11\t  expectReadOnly,\n12\t  mixedStateVariantThread,\n13\t  mutationInFlightVariant,\n14\t  PERMANENT_FAILURE_REASON,\n15\t  tempStore,\n16\t  TRANSIENT_EXHAUST_REASON,\n17\t  type TempStore,\n18\t} from \"./fixtures/index.js\";\n19\t\n20\tlet store: TempStore;\n21\tbeforeEach(() => {\n22\t  store = tempStore();\n23\t});\n24\tafterEach(() => {\n25\t  store.cleanup();\n26\t});\n27\t\n28\tfunction valueOf(result: { ok: boolean }): HealthReport {\n29\t  if (!result.ok) {\n30\t    throw new Error(`expected ok health report: ${JSON.stringify(result)}`);\n31\t  }\n32\t  return (result as { ok: true; value: HealthReport }).value;\n33\t}\n34\t\n35\tconst ZERO = { ready: 0, pending: 0, retrying: 0, failed: 0, blocked: 0 };\n36\t\n37\tdescribe(\"TC-4.1 / AC-4.1, AC-4.5: counts per owner/kind/state and queue consistency\", () => {\n38\t  it(\"the mixed-state fixture reports exact counts and a queue section consistent with them\", async () => {\n39\t    const fixture = await mixedStateVariantThread(store);\n40\t    const { filePath, sdk } = fixture;\n41\t\n42\t    const health = await expectReadOnly(filePath, () => sdk.inspect.health({ filePath }));\n43\t    expect(health.ok).toBe(true);\n44\t    if (!health.ok) return;\n45\t    const report = health.value;\n46\t\n47\t    // Every owner/kind/state count, exact, in deterministic order: 13 turns'\n48\t    // smoothings ready + t14's pending; the tool-heavy middle's summaries\n49\t    // with the two scripted failures; t13's turn forms blocked on the real\n50\t    // source damage; the three closed chunks' summaries ready.\n51\t    expect(report.owners).toEqual([\n52\t      { owner: \"messages\", kind: \"smoothed_prompt\", counts: { ...ZERO, ready: 13, pending: 1 } },\n53\t      { owner: \"messages\", kind: \"tool_call_summary\", counts: { ...ZERO, ready: 8 } },\n54\t      { owner: \"messages\", kind: \"tool_result_summary\", counts: { ...ZERO, ready: 6, failed: 2 } },\n55\t      { owner: \"turns\", kind: \"chunk_summary_brief\", counts: { ...ZERO, ready: 3 } },\n56\t      { owner: \"turns\", kind: \"chunk_summary_detailed\", counts: { ...ZERO, ready: 3 } },\n57\t      { owner: \"turns\", kind: \"lower_band_projection\", counts: { ...ZERO, ready: 12, blocked: 1 } },\n58\t      { owner: \"turns\", kind: \"turn_rendering\", counts: { ...ZERO, ready: 12, blocked: 1 } },\n59\t    ]);\n60\t\n61\t    // Queue visibility from the same report's live joins: exactly the one\n62\t    // still-queued smoothing item, consistent with the pending count.\n63\t    expect(report.queue).toEqual({ queued: 1, claimed: 0 });\n64\t    const pendingTotal = report.owners.reduce(\n65\t      (sum, row) => sum + row.counts.pending + row.counts.retrying,\n66\t      0,\n67\t    );\n68\t    expect(report.queue.queued + report.queue.claimed).toBe(pendingTotal);\n69\t  });\n70\t});\n71\t\n72\tdescribe(\"TC-4.2 / AC-4.2, AC-4.3: failure detail and repair preview\", () => {\n73\t  it(\"failed entries carry exact detail; the preview is exactly the failed-not-blocked set\", async () => {\n74\t    const fixture = await mixedStateVariantThread(store);\n75\t    const { filePath, sdk } = fixture;\n76\t    const report = valueOf(await sdk.inspect.health({ filePath }));\n77\t\n78\t    // Actionable failure detail: subject, form, reason, attempts, last error\n79\t    // — enough to target a requeue without raw SQL.\n80\t    const failed = report.failures.filter((entry) => entry.reason.startsWith(\"rate_limit\") || entry.reason.startsWith(\"content_refusal\"));\n81\t    expect(failed).toEqual([\n82\t      {\n83\t        owner: \"messages\",\n84\t        subjectKind: \"message\",\n85\t        subjectId: fixture.failedTransientMessageId,\n86\t        form: \"tool_result_summary\",\n87\t        reason: TRANSIENT_EXHAUST_REASON,\n88\t        attempts: 3,\n89\t        lastError: TRANSIENT_EXHAUST_REASON,\n90\t      },\n91\t      {\n92\t        owner: \"messages\",\n93\t        subjectKind: \"message\",\n94\t        subjectId: fixture.failedPermanentMessageId,\n95\t        form: \"tool_result_summary\",\n96\t        reason: PERMANENT_FAILURE_REASON,\n97\t        attempts: 1,\n98\t        lastError: PERMANENT_FAILURE_REASON,\n99\t      },\n100\t    ]);\n101\t\n102\t    // Blocked forms surface as failures too — with the damage named — but\n103\t    // never as repair targets.\n104\t    const blocked = report.failures.filter((entry) => !failed.includes(entry));\n105\t    expect(blocked.map((entry) => [entry.owner, entry.subjectKind, entry.subjectId, entry.form])).toEqual([\n106\t      [\"turns\", \"turn\", fixture.blockedTurnId, \"lower_band_projection\"],\n107\t      [\"turns\", \"turn\", fixture.blockedTurnId, \"turn_rendering\"],\n108\t    ]);\n109\t    for (const entry of blocked) {\n110\t      expect(entry.reason.length).toBeGreaterThan(0);\n111\t    }\n112\t\n113\t    // The preview lists exactly the failed-and-not-blocked set, in report\n114\t    // order — and previews only: the read changed nothing (the delta assert\n115\t    // in TC-4.1 covers the same operation).\n116\t    expect(report.repairPreview).toEqual([\n117\t      {\n118\t        owner: \"messages\",\n119\t        subjectKind: \"message\",\n120\t        subjectId: fixture.failedTransientMessageId,\n121\t        form: \"tool_result_summary\",\n122\t      },\n123\t      {\n124\t        owner: \"messages\",\n125\t        subjectKind: \"message\",\n126\t        subjectId: fixture.failedPermanentMessageId,\n127\t        form: \"tool_result_summary\",\n128\t      },\n129\t    ]);\n130\t\n131\t    // Never executed: the failed forms are still failed on a second read —\n132\t    // health did not requeue what it previewed.\n133\t    const again = valueOf(await sdk.inspect.health({ filePath }));\n134\t    expect(again).toEqual(report);\n135\t  });\n136\t});\n137\t\n138\tdescribe(\"TC-4.3 / AC-4.4: rebuild visibility brackets a drain\", () => {\n139\t  it(\"after an edit the cascade's cleared set is pending with queued work; after the drain the same set is ready; nothing else moved\", async () => {\n140\t    const fixture = await mutationInFlightVariant(store);\n141\t    const { filePath, sdk } = fixture;\n142\t\n143\t    // The cascade contract's exact cleared set: the prompt's own smoothing,\n144\t    // t2's two turn forms, c1's two chunk summaries.\n145\t    const clearedKeys = fixture.mutation.cleared\n146\t      .map((target) => `${target.subjectKind}:${target.subjectId}:${target.form}`)\n147\t      .sort();\n148\t    expect(clearedKeys).toEqual(\n149\t      [\n150\t        `message:${fixture.editedMessageId}:smoothed_prompt`,\n151\t        \"turn:t2:turn_rendering\",\n152\t        \"turn:t2:lower_band_projection\",\n153\t        \"chunk:c1:chunk_summary_detailed\",\n154\t        \"chunk:c1:chunk_summary_brief\",\n155\t      ].sort(),\n156\t    );\n157\t\n158\t    const before = valueOf(await expectReadOnly(filePath, () => sdk.inspect.health({ filePath })));\n159\t    // The cleared set reads pending — one per owner/kind — with its queued\n160\t    // replacement work visible, and every form outside the cascade still\n161\t    // ready (failures-free fixture: full counts minus the cascade).\n162\t    expect(before.owners).toEqual([\n163\t      { owner: \"messages\", kind: \"smoothed_prompt\", counts: { ...ZERO, ready: 11, pending: 1 } },\n164\t      { owner: \"messages\", kind: \"tool_call_summary\", counts: { ...ZERO, ready: 8 } },\n165\t      { owner: \"messages\", kind: \"tool_result_summary\", counts: { ...ZERO, ready: 8 } },\n166\t      { owner: \"turns\", kind: \"chunk_summary_brief\", counts: { ...ZERO, ready: 2, pending: 1 } },\n167\t      { owner: \"turns\", kind: \"chunk_summary_detailed\", counts: { ...ZERO, ready: 2, pending: 1 } },\n168\t      { owner: \"turns\", kind: \"lower_band_projection\", counts: { ...ZERO, ready: 11, pending: 1 } },\n169\t      { owner: \"turns\", kind: \"turn_rendering\", counts: { ...ZERO, ready: 11, pending: 1 } },\n170\t    ]);\n171\t    // Queued work visible and consistent: 4 replacement items — smoothing,\n172\t    // turn derivation (two forms), two chunk summaries — join onto the 5\n173\t    // pending entries.\n174\t    expect(before.queue).toEqual({ queued: 5, claimed: 0 });\n175\t    expect(before.failures).toEqual([]);\n176\t    expect(before.repairPreview).toEqual([]);\n177\t\n178\t    // The exact pending subjects per the cascade contract, read through the\n179\t    // owners' surfaces health composes.\n180\t    const messagesPending = await sdk.messages.report({ filePath }, { notReady: true });\n181\t    const turnsPending = await sdk.turns.report({ filePath }, { notReady: true });\n182\t    expect(messagesPending.ok && turnsPending.ok).toBe(true);\n183\t    if (!messagesPending.ok || !turnsPending.ok) return;\n184\t    const pendingKeys = [...messagesPending.value, ...turnsPending.value]\n185\t      .filter((entry) => entry.state === \"pending\")\n186\t      .map((entry) => `${entry.subjectKind}:${entry.subjectId}:${entry.form}`)\n187\t      .sort();\n188\t    expect(pendingKeys).toEqual(clearedKeys);\n189\t\n190\t    // Drain the queued rebuilds and wait the scheduler out.\n191\t    const drained = await sdk.work.drain({ filePath });\n192\t    expect(drained.ok).toBe(true);\n193\t    await sdk.drainSettled({ filePath });\n194\t\n195\t    // The same set reads ready; counts return to the full fixture totals;\n196\t    // queue empty — two reads bracket the rebuild.\n197\t    const after = valueOf(await sdk.inspect.health({ filePath }));\n198\t    expect(after.owners).toEqual([\n199\t      { owner: \"messages\", kind: \"smoothed_prompt\", counts: { ...ZERO, ready: 12 } },\n200\t      { owner: \"messages\", kind: \"tool_call_summary\", counts: { ...ZERO, ready: 8 } },\n201\t      { owner: \"messages\", kind: \"tool_result_summary\", counts: { ...ZERO, ready: 8 } },\n202\t      { owner: \"turns\", kind: \"chunk_summary_brief\", counts: { ...ZERO, ready: 3 } },\n203\t      { owner: \"turns\", kind: \"chunk_summary_detailed\", counts: { ...ZERO, ready: 3 } },\n204\t      { owner: \"turns\", kind: \"lower_band_projection\", counts: { ...ZERO, ready: 12 } },\n205\t      { owner: \"turns\", kind: \"turn_rendering\", counts: { ...ZERO, ready: 12 } },\n206\t    ]);\n207\t    expect(after.queue).toEqual({ queued: 0, claimed: 0 });\n208\t    expect(after.failures).toEqual([]);\n209\t  });\n210\t});\n211\t\n212\tdescribe(\"architecture risk: health is provider-free and surface-composed\", () => {\n213\t  it(\"health succeeds under a throwing provider and calls no provider on the fixture SDK\", async () => {\n214\t    const fixture = await mixedStateVariantThread(store);\n215\t    const captured = fixture.double.captureInputs();\n216\t\n217\t    const refuse = (): never => {\n218\t      throw new Error(\"provider must never be called by a read operation\");\n219\t    };\n220\t    const reader = createSdk({\n221\t      provider: {\n222\t        smoothPrompt: refuse,\n223\t        summarizeToolCall: refuse,\n224\t        summarizeToolResult: refuse,\n225\t        composeTurnRendering: refuse,\n226\t        projectLowerBand: refuse,\n227\t        summarizeChunkDetailed: refuse,\n228\t        summarizeChunkBrief: refuse,\n229\t      },\n230\t      mode: \"manual\",\n231\t    });\n232\t    const health = await expectReadOnly(fixture.filePath, () =>\n233\t      reader.inspect.health({ filePath: fixture.filePath }),\n234\t    );\n235\t    expect(health.ok).toBe(true);\n236\t    expect(captured).toHaveLength(0);\n237\t  });\n238\t});\n239\t"}]},"parent_tool_use_id":null,"session_id":"77c6c733-044c-452a-abeb-bd7584806be0","uuid":"527638e3-a8c8-4115-93d3-8366f1f0e23d","timestamp":"2026-06-12T15:09:25.269Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/inspect-health.test.ts","content":"// Story 2 (Epic 04), default suite: TC-4.1–4.3 — the inspect health report.\n// Counts by owner/kind/state assembled entirely from the owners' report\n// surfaces (AC-4.1), actionable failure detail (AC-4.2), a repair preview\n// that is reported and never executed (AC-4.3), rebuild visibility bracketing\n// a drain (AC-4.4), and live queue visibility consistent with the state\n// counts in the same report (AC-4.5).\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport { createSdk, type HealthReport } from \"../src/index.js\";\nimport {\n  createProviderDouble,\n  expectReadOnly,\n  mixedStateVariantThread,\n  mutationInFlightVariant,\n  PERMANENT_FAILURE_REASON,\n  tempStore,\n  TRANSIENT_EXHAUST_REASON,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\nfunction valueOf(result: { ok: boolean }): HealthReport {\n  if (!result.ok) {\n    throw new Error(`expected ok health report: ${JSON.stringify(result)}`);\n  }\n  return (result as { ok: true; value: HealthReport }).value;\n}\n\nconst ZERO = { ready: 0, pending: 0, retrying: 0, failed: 0, blocked: 0 };\n\ndescribe(\"TC-4.1 / AC-4.1, AC-4.5: counts per owner/kind/state and queue consistency\", () => {\n  it(\"the mixed-state fixture reports exact counts and a queue section consistent with them\", async () => {\n    const fixture = await mixedStateVariantThread(store);\n    const { filePath, sdk } = fixture;\n\n    const health = await expectReadOnly(filePath, () => sdk.inspect.health({ filePath }));\n    expect(health.ok).toBe(true);\n    if (!health.ok) return;\n    const report = health.value;\n\n    // Every owner/kind/state count, exact, in deterministic order: 13 turns'\n    // smoothings ready + t14's pending; the tool-heavy middle's summaries\n    // with the two scripted failures; t13's turn forms blocked on the real\n    // source damage; the three closed chunks' summaries ready.\n    expect(report.owners).toEqual([\n      { owner: \"messages\", kind: \"smoothed_prompt\", counts: { ...ZERO, ready: 13, pending: 1 } },\n      { owner: \"messages\", kind: \"tool_call_summary\", counts: { ...ZERO, ready: 8 } },\n      { owner: \"messages\", kind: \"tool_result_summary\", counts: { ...ZERO, ready: 6, failed: 2 } },\n      { owner: \"turns\", kind: \"chunk_summary_brief\", counts: { ...ZERO, ready: 3 } },\n      { owner: \"turns\", kind: \"chunk_summary_detailed\", counts: { ...ZERO, ready: 3 } },\n      { owner: \"turns\", kind: \"lower_band_projection\", counts: { ...ZERO, ready: 12, blocked: 1 } },\n      { owner: \"turns\", kind: \"turn_rendering\", counts: { ...ZERO, ready: 12, blocked: 1 } },\n    ]);\n\n    // Queue visibility from the same report's live joins: exactly the one\n    // still-queued smoothing item, consistent with the pending count.\n    expect(report.queue).toEqual({ queued: 1, claimed: 0 });\n    const pendingTotal = report.owners.reduce(\n      (sum, row) => sum + row.counts.pending + row.counts.retrying,\n      0,\n    );\n    expect(report.queue.queued + report.queue.claimed).toBe(pendingTotal);\n  });\n});\n\ndescribe(\"TC-4.2 / AC-4.2, AC-4.3: failure detail and repair preview\", () => {\n  it(\"failed entries carry exact detail; the preview is exactly the failed-not-blocked set\", async () => {\n    const fixture = await mixedStateVariantThread(store);\n    const { filePath, sdk } = fixture;\n    const report = valueOf(await sdk.inspect.health({ filePath }));\n\n    // Actionable failure detail: subject, form, reason, attempts, last error\n    // — enough to target a requeue without raw SQL.\n    const failed = report.failures.filter((entry) => entry.reason.startsWith(\"rate_limit\") || entry.reason.startsWith(\"content_refusal\"));\n    expect(failed).toEqual([\n      {\n        owner: \"messages\",\n        subjectKind: \"message\",\n        subjectId: fixture.failedTransientMessageId,\n        form: \"tool_result_summary\",\n        reason: TRANSIENT_EXHAUST_REASON,\n        attempts: 3,\n        lastError: TRANSIENT_EXHAUST_REASON,\n      },\n      {\n        owner: \"messages\",\n        subjectKind: \"message\",\n        subjectId: fixture.failedPermanentMessageId,\n        form: \"tool_result_summary\",\n        reason: PERMANENT_FAILURE_REASON,\n        attempts: 1,\n        lastError: PERMANENT_FAILURE_REASON,\n      },\n    ]);\n\n    // Blocked forms surface as failures too — with the damage named — but\n    // never as repair targets.\n    const blocked = report.failures.filter((entry) => !failed.includes(entry));\n    expect(blocked.map((entry) => [entry.owner, entry.subjectKind, entry.subjectId, entry.form])).toEqual([\n      [\"turns\", \"turn\", fixture.blockedTurnId, \"lower_band_projection\"],\n      [\"turns\", \"turn\", fixture.blockedTurnId, \"turn_rendering\"],\n    ]);\n    for (const entry of blocked) {\n      expect(entry.reason.length).toBeGreaterThan(0);\n    }\n\n    // The preview lists exactly the failed-and-not-blocked set, in report\n    // order — and previews only: the read changed nothing (the delta assert\n    // in TC-4.1 covers the same operation).\n    expect(report.repairPreview).toEqual([\n      {\n        owner: \"messages\",\n        subjectKind: \"message\",\n        subjectId: fixture.failedTransientMessageId,\n        form: \"tool_result_summary\",\n      },\n      {\n        owner: \"messages\",\n        subjectKind: \"message\",\n        subjectId: fixture.failedPermanentMessageId,\n        form: \"tool_result_summary\",\n      },\n    ]);\n\n    // Never executed: the failed forms are still failed on a second read —\n    // health did not requeue what it previewed.\n    const again = valueOf(await sdk.inspect.health({ filePath }));\n    expect(again).toEqual(report);\n  });\n});\n\ndescribe(\"TC-4.3 / AC-4.4: rebuild visibility brackets a drain\", () => {\n  it(\"after an edit the cascade's cleared set is pending with queued work; after the drain the same set is ready; nothing else moved\", async () => {\n    const fixture = await mutationInFlightVariant(store);\n    const { filePath, sdk } = fixture;\n\n    // The cascade contract's exact cleared set: the prompt's own smoothing,\n    // t2's two turn forms, c1's two chunk summaries.\n    const clearedKeys = fixture.mutation.cleared\n      .map((target) => `${target.subjectKind}:${target.subjectId}:${target.form}`)\n      .sort();\n    expect(clearedKeys).toEqual(\n      [\n        `message:${fixture.editedMessageId}:smoothed_prompt`,\n        \"turn:t2:turn_rendering\",\n        \"turn:t2:lower_band_projection\",\n        \"chunk:c1:chunk_summary_detailed\",\n        \"chunk:c1:chunk_summary_brief\",\n      ].sort(),\n    );\n\n    const before = valueOf(await expectReadOnly(filePath, () => sdk.inspect.health({ filePath })));\n    // The cleared set reads pending — one per owner/kind — with its queued\n    // replacement work visible, and every form outside the cascade still\n    // ready (failures-free fixture: full counts minus the cascade).\n    expect(before.owners).toEqual([\n      { owner: \"messages\", kind: \"smoothed_prompt\", counts: { ...ZERO, ready: 11, pending: 1 } },\n      { owner: \"messages\", kind: \"tool_call_summary\", counts: { ...ZERO, ready: 8 } },\n      { owner: \"messages\", kind: \"tool_result_summary\", counts: { ...ZERO, ready: 8 } },\n      { owner: \"turns\", kind: \"chunk_summary_brief\", counts: { ...ZERO, ready: 2, pending: 1 } },\n      { owner: \"turns\", kind: \"chunk_summary_detailed\", counts: { ...ZERO, ready: 2, pending: 1 } },\n      { owner: \"turns\", kind: \"lower_band_projection\", counts: { ...ZERO, ready: 11, pending: 1 } },\n      { owner: \"turns\", kind: \"turn_rendering\", counts: { ...ZERO, ready: 11, pending: 1 } },\n    ]);\n    // Queued work visible and consistent: 4 replacement items — smoothing,\n    // turn derivation (two forms), two chunk summaries — join onto the 5\n    // pending entries.\n    expect(before.queue).toEqual({ queued: 5, claimed: 0 });\n    expect(before.failures).toEqual([]);\n    expect(before.repairPreview).toEqual([]);\n\n    // The exact pending subjects per the cascade contract, read through the\n    // owners' surfaces health composes.\n    const messagesPending = await sdk.messages.report({ filePath }, { notReady: true });\n    const turnsPending = await sdk.turns.report({ filePath }, { notReady: true });\n    expect(messagesPending.ok && turnsPending.ok).toBe(true);\n    if (!messagesPending.ok || !turnsPending.ok) return;\n    const pendingKeys = [...messagesPending.value, ...turnsPending.value]\n      .filter((entry) => entry.state === \"pending\")\n      .map((entry) => `${entry.subjectKind}:${entry.subjectId}:${entry.form}`)\n      .sort();\n    expect(pendingKeys).toEqual(clearedKeys);\n\n    // Drain the queued rebuilds and wait the scheduler out.\n    const drained = await sdk.work.drain({ filePath });\n    expect(drained.ok).toBe(true);\n    await sdk.drainSettled({ filePath });\n\n    // The same set reads ready; counts return to the full fixture totals;\n    // queue empty — two reads bracket the rebuild.\n    const after = valueOf(await sdk.inspect.health({ filePath }));\n    expect(after.owners).toEqual([\n      { owner: \"messages\", kind: \"smoothed_prompt\", counts: { ...ZERO, ready: 12 } },\n      { owner: \"messages\", kind: \"tool_call_summary\", counts: { ...ZERO, ready: 8 } },\n      { owner: \"messages\", kind: \"tool_result_summary\", counts: { ...ZERO, ready: 8 } },\n      { owner: \"turns\", kind: \"chunk_summary_brief\", counts: { ...ZERO, ready: 3 } },\n      { owner: \"turns\", kind: \"chunk_summary_detailed\", counts: { ...ZERO, ready: 3 } },\n      { owner: \"turns\", kind: \"lower_band_projection\", counts: { ...ZERO, ready: 12 } },\n      { owner: \"turns\", kind: \"turn_rendering\", counts: { ...ZERO, ready: 12 } },\n    ]);\n    expect(after.queue).toEqual({ queued: 0, claimed: 0 });\n    expect(after.failures).toEqual([]);\n  });\n});\n\ndescribe(\"architecture risk: health is provider-free and surface-composed\", () => {\n  it(\"health succeeds under a throwing provider and calls no provider on the fixture SDK\", async () => {\n    const fixture = await mixedStateVariantThread(store);\n    const captured = fixture.double.captureInputs();\n\n    const refuse = (): never => {\n      throw new Error(\"provider must never be called by a read operation\");\n    };\n    const reader = createSdk({\n      provider: {\n        smoothPrompt: refuse,\n        summarizeToolCall: refuse,\n        summarizeToolResult: refuse,\n        composeTurnRendering: refuse,\n        projectLowerBand: refuse,\n        summarizeChunkDetailed: refuse,\n        summarizeChunkBrief: refuse,\n      },\n      mode: \"manual\",\n    });\n    const health = await expectReadOnly(fixture.filePath, () =>\n      reader.inspect.health({ filePath: fixture.filePath }),\n    );\n    expect(health.ok).toBe(true);\n    expect(captured).toHaveLength(0);\n  });\n});\n","numLines":239,"startLine":1,"totalLines":239}}}

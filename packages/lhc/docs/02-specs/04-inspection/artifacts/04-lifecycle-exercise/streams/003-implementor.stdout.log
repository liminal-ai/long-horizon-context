{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014kxMAzBdA3fgE6zqRzKB5j","type":"tool_result","content":"1\t// SDK-internal scheduler and drain (DD-4): the one component holding\n2\t// cross-operation in-memory state. The drain loop lives here per the tech\n3\t// design's placement — claim under BEGIN IMMEDIATE, dispatch through the\n4\t// handler map with no open transaction (the provider call lives there),\n5\t// complete in a second short transaction. Background mode adds per-thread\n6\t// single-flight with pending-flag coalescing, post-commit pokes, first-touch\n7\t// catch-up (DD-10), and drainSettled (issue 3). The in-memory state is\n8\t// advisory only: cross-process safety comes from the durable lease alone, so\n9\t// a fresh handle sees identical drain behavior — the queue is the rows.\n10\timport { existsSync } from \"node:fs\";\n11\timport {\n12\t  clearTimeout as cancelTimer,\n13\t  setImmediate as scheduleMacrotask,\n14\t  setTimeout as scheduleTimer,\n15\t} from \"node:timers\";\n16\timport { DatabaseSync } from \"node:sqlite\";\n17\timport { openThreadDatabase } from \"./domains/threads/index.js\";\n18\timport type {\n19\t  HandlerOutcome,\n20\t  ResolvedSdkConfig,\n21\t  WorkHandler,\n22\t} from \"./shared/derivation.js\";\n23\timport { storageFailure, type ErrorResult, type OpResult } from \"./shared/errors.js\";\n24\timport {\n25\t  claimNext,\n26\t  complete,\n27\t  countLiveItems,\n28\t  failAttempt,\n29\t  failTerminal,\n30\t  type ClaimedWorkItem,\n31\t  type WorkKind,\n32\t  type WorkSourceRef,\n33\t} from \"./tech-utils/work-queue/index.js\";\n34\t\n35\texport type SchedulerMode = \"background\" | \"manual\";\n36\t\n37\t// Report shape per tech design §Interfaces. `superseded` never appears here:\n38\t// the cascade deletes superseded items and reports them on the mutation\n39\t// result; a drain never sees them.\n40\texport interface DrainReport {\n41\t  ran: Array<{\n42\t    workItemId: string;\n43\t    kind: WorkKind;\n44\t    sourceRef: WorkSourceRef;\n45\t    disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\";\n46\t    attempts: number;\n47\t    reason?: string;\n48\t  }>;\n49\t  stoppedBecause: \"empty\" | \"in_flight\" | \"waiting\" | \"max_items\";\n50\t  waitingUntil?: string; // head's eligible_at when stoppedBecause = \"waiting\"\n51\t  remaining: number; // live items left behind the stop point\n52\t}\n53\t\n54\texport interface DrainDeps {\n55\t  lookupHandler: (kind: string) => OpResult<WorkHandler>;\n56\t  // Whether any handler is registered at all. Background scheduling is gated\n57\t  // on this, fail-closed: with an empty map a background drain could only\n58\t  // turn queued rows into failed_terminal — destruction, not processing — so\n59\t  // pokes and catch-up stay inert until a handler table is populated\n60\t  // (Stories 2–3 in production; explicit registration in tests).\n61\t  hasAnyHandler: () => boolean;\n62\t  config: ResolvedSdkConfig;\n63\t}\n64\t\n65\tfunction ranEntry(\n66\t  item: ClaimedWorkItem,\n67\t  disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\",\n68\t  attempts: number,\n69\t  reason?: string,\n70\t): DrainReport[\"ran\"][number] {\n71\t  const entry: DrainReport[\"ran\"][number] = {\n72\t    workItemId: item.workItemId,\n73\t    kind: item.kind as WorkKind,\n74\t    sourceRef: item.sourceRef,\n75\t    disposition,\n76\t    attempts,\n77\t  };\n78\t  if (reason !== undefined) entry.reason = reason;\n79\t  return entry;\n80\t}\n81\t\n82\t// The drain loop against an open handle. Claim → dispatch → complete, one\n83\t// item at a time, until the head stops it (empty / in_flight / waiting) or\n84\t// maxItems is reached. The handler runs with NO open transaction; the only\n85\t// exits from a handler failure are failAttempt and the terminal paths — the\n86\t// drain never catches an error and records success.\n87\texport async function drainOpenDb(\n88\t  db: DatabaseSync,\n89\t  deps: DrainDeps,\n90\t  opts?: { maxItems?: number },\n91\t): Promise<DrainReport> {\n92\t  const { clock, lease, retry, provider } = deps.config;\n93\t  const ran: DrainReport[\"ran\"] = [];\n94\t  let stoppedBecause: DrainReport[\"stoppedBecause\"];\n95\t  let waitingUntil: string | undefined;\n96\t\n97\t  for (;;) {\n98\t    if (opts?.maxItems !== undefined && ran.length >= opts.maxItems) {\n99\t      stoppedBecause = \"max_items\";\n100\t      break;\n101\t    }\n102\t    const claim = claimNext(db, clock().toISOString(), lease.durationMs);\n103\t    if (claim.outcome === \"empty\") {\n104\t      stoppedBecause = \"empty\";\n105\t      break;\n106\t    }\n107\t    if (claim.outcome === \"in_flight\") {\n108\t      stoppedBecause = \"in_flight\";\n109\t      break;\n110\t    }\n111\t    if (claim.outcome === \"waiting\") {\n112\t      stoppedBecause = \"waiting\";\n113\t      waitingUntil = claim.waitingUntil;\n114\t      break;\n115\t    }\n116\t    const item = claim.item;\n117\t\n118\t    const lookedUp = deps.lookupHandler(item.kind);\n119\t    if (!lookedUp.ok) {\n120\t      // Unregistered kind: the normal terminal transaction, not a try/catch\n121\t      // skip — failed_terminal with the stable code, form (if resolvable\n122\t      // from the payload) lands failed, and the drain continues (AC-1.8).\n123\t      failTerminal(db, item, {\n124\t        reason: lookedUp.error.code,\n125\t        formState: \"failed\",\n126\t        attempts: item.attempts,\n127\t        now: clock().toISOString(),\n128\t      });\n129\t      ran.push(ranEntry(item, \"failed_terminal\", item.attempts, lookedUp.error.code));\n130\t      continue;\n131\t    }\n132\t\n133\t    let outcome: HandlerOutcome;\n134\t    try {\n135\t      outcome = await lookedUp.value(\n136\t        { openDb: () => db, provider, clock, config: deps.config },\n137\t        {\n138\t          workItemId: item.workItemId,\n139\t          kind: item.kind,\n140\t          sourceRef: item.sourceRef as unknown as Record<string, string>,\n141\t        },\n142\t      );\n143\t    } catch (cause) {\n144\t      // A throwing handler is a bug by the error contract, but the queue\n145\t      // must not wedge on it: route it through the normal retry path so it\n146\t      // counts attempts and exhausts visibly.\n147\t      const detail = cause instanceof Error ? cause.message : String(cause);\n148\t      outcome = { ok: false, retryable: true, reason: `handler threw: ${detail}` };\n149\t    }\n150\t\n151\t    if (outcome.ok) {\n152\t      const disposition = complete(\n153\t        db,\n154\t        item,\n155\t        outcome.forms ?? [],\n156\t        clock().toISOString(),\n157\t        outcome.onApplied,\n158\t      );\n159\t      ran.push(ranEntry(item, disposition, item.attempts));\n160\t      continue;\n161\t    }\n162\t    if (\"blocked\" in outcome) {\n163\t      failTerminal(db, item, {\n164\t        reason: outcome.reason,\n165\t        formState: \"blocked\",\n166\t        attempts: item.attempts + 1,\n167\t        now: clock().toISOString(),\n168\t      });\n169\t      ran.push(ranEntry(item, \"failed_terminal\", item.attempts + 1, outcome.reason));\n170\t      continue;\n171\t    }\n172\t    const failed = failAttempt(db, item, {\n173\t      reason: outcome.reason,\n174\t      retryable: outcome.retryable,\n175\t      now: clock().toISOString(),\n176\t      retry,\n177\t    });\n178\t    if (failed.terminal) {\n179\t      ran.push(ranEntry(item, \"failed_terminal\", failed.attempts, outcome.reason));\n180\t    }\n181\t    // Under budget the item went back to queued (possibly backing off); the\n182\t    // next claimNext re-reads the head — a backing-off head ends the drain\n183\t    // with \"waiting\" and gates everything behind it.\n184\t  }\n185\t\n186\t  const report: DrainReport = { ran, stoppedBecause, remaining: countLiveItems(db) };\n187\t  if (waitingUntil !== undefined) report.waitingUntil = waitingUntil;\n188\t  return report;\n189\t}\n190\t\n191\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n192\t  return {\n193\t    ok: false,\n194\t    error: {\n195\t      errorClass: \"caller_error\",\n196\t      code: \"thread_not_found\",\n197\t      reason: `no thread file exists at ${filePath}`,\n198\t    },\n199\t  };\n200\t}\n201\t\n202\t// The drain operation against a thread file: open (validates + migrates),\n203\t// drain, close. Both the SDK's work.drain and the background loop's passes\n204\t// run through here — manual and background modes share one drain.\n205\texport async function runDrain(\n206\t  filePath: string,\n207\t  deps: DrainDeps,\n208\t  opts?: { maxItems?: number },\n209\t): Promise<OpResult<DrainReport>> {\n210\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n211\t  const opened = openThreadDatabase(filePath);\n212\t  if (!opened.ok) return opened;\n213\t  const db = opened.value;\n214\t  try {\n215\t    return { ok: true, value: await drainOpenDb(db, deps, opts) };\n216\t  } catch (cause) {\n217\t    const detail = cause instanceof Error ? cause.message : String(cause);\n218\t    return storageFailure(`drain failed: ${detail}`);\n219\t  } finally {\n220\t    db.close();\n221\t  }\n222\t}\n223\t\n224\tinterface ThreadDrainState {\n225\t  threadId: string;\n226\t  filePath: string;\n227\t  running: boolean;\n228\t  pending: boolean;\n229\t  passes: number; // test-only observability (TC-1.2); must not become API\n230\t  waiters: Array<() => void>;\n231\t  // Fix 1 (DD-4 completion): at most one pending backoff wake per thread; a\n232\t  // poke or a newer wake clears it. unref'd so it never keeps the process\n233\t  // alive. Background only — manual never reaches the drain loop.\n234\t  wakeTimer: ReturnType<typeof scheduleTimer> | undefined;\n235\t}\n236\t\n237\t// A wake floored to a sane minimum: an eligible_at already in the past must\n238\t// nudge once, not busy-spin (the durable claimNext gate is the real guard).\n239\tconst WAKE_MIN_DELAY_MS = 5;\n240\t\n241\texport interface Scheduler {\n242\t  readonly mode: SchedulerMode;\n243\t  // Post-commit nudge that work was queued for a thread (DD-5). Manual mode:\n244\t  // no-op by contract. Background mode: starts a drain, or coalesces into\n245\t  // the pending flag if one is already running for the thread (AC-1.2).\n246\t  poke(threadId: string): void;\n247\t  // Thread-file open announcement (DD-10): learns threadId → filePath and,\n248\t  // on the first touch of a thread this process lifetime, schedules a\n249\t  // catch-up drain if the queue has leftover live work (AC-1.6).\n250\t  touch(filePath: string, db: DatabaseSync): void;\n251\t  // Resolves when the scheduler has no running or pending drain for the\n252\t  // thread (issue 3). Manual mode resolves immediately.\n253\t  drainSettled(threadId: string): Promise<void>;\n254\t  // Test-only observability for coalescing exactness (TC-1.2): drain passes\n255\t  // started for a thread. Named as a test hook on purpose — not API.\n256\t  testPassCount(threadId: string): number;\n257\t}\n258\t\n259\tfunction readThreadId(db: DatabaseSync): string | null {\n260\t  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n261\t    | { thread_id: string }\n262\t    | undefined;\n263\t  return row?.thread_id ?? null;\n264\t}\n265\t\n266\t// Read a thread file's id without side effects (no migration, no touch) —\n267\t// drainSettled must observe scheduler state, never schedule work.\n268\texport function peekThreadId(filePath: string): string | null {\n269\t  if (!existsSync(filePath)) return null;\n270\t  let db: DatabaseSync | undefined;\n271\t  try {\n272\t    db = new DatabaseSync(filePath, { readOnly: true });\n273\t    return readThreadId(db);\n274\t  } catch {\n275\t    return null;\n276\t  } finally {\n277\t    db?.close();\n278\t  }\n279\t}\n280\t\n281\texport function createScheduler(mode: SchedulerMode, deps: DrainDeps): Scheduler {\n282\t  const states = new Map<string, ThreadDrainState>();\n283\t  const seen = new Set<string>(); // first-touch catch-up guard, process lifetime\n284\t\n285\t  function stateFor(threadId: string): ThreadDrainState {\n286\t    let st = states.get(threadId);\n287\t    if (st === undefined) {\n288\t      st = {\n289\t        threadId,\n290\t        filePath: \"\",\n291\t        running: false,\n292\t        pending: false,\n293\t        passes: 0,\n294\t        waiters: [],\n295\t        wakeTimer: undefined,\n296\t      };\n297\t      states.set(threadId, st);\n298\t    }\n299\t    return st;\n300\t  }\n301\t\n302\t  function clearWake(st: ThreadDrainState): void {\n303\t    if (st.wakeTimer !== undefined) {\n304\t      cancelTimer(st.wakeTimer);\n305\t      st.wakeTimer = undefined;\n306\t    }\n307\t  }\n308\t\n309\t  // Arm the lone backoff wake (Fix 1): when a background pass stops on the\n310\t  // eligibility gate, schedule a single nudge at the head's eligible_at that\n311\t  // re-enters the existing poke path. The delay reads the SDK clock seam (no\n312\t  // fresh Date here — E02-NB-001) and is floored to a sane minimum; correctness\n313\t  // rides claimNext's durable gate, so a coarse timer never retries early.\n314\t  function armWake(st: ThreadDrainState, waitingUntil: string): void {\n315\t    clearWake(st);\n316\t    const nowMs = deps.config.clock().getTime();\n317\t    const delay = Math.max(WAKE_MIN_DELAY_MS, Date.parse(waitingUntil) - nowMs);\n318\t    const timer = scheduleTimer(() => {\n319\t      st.wakeTimer = undefined;\n320\t      schedule(st.threadId);\n321\t    }, delay);\n322\t    timer.unref();\n323\t    st.wakeTimer = timer;\n324\t  }\n325\t\n326\t  async function runLoop(st: ThreadDrainState): Promise<void> {\n327\t    // Defer past the committing operation's synchronous tail so the drain\n328\t    // never contends with the transaction whose commit scheduled it.\n329\t    await new Promise((resolve) => scheduleMacrotask(resolve));\n330\t    let lastReport: DrainReport | undefined;\n331\t    try {\n332\t      do {\n333\t        st.pending = false;\n334\t        st.passes += 1;\n335\t        // A failed pass (storage error) has no caller to report to in\n336\t        // background mode; the durable rows are untouched and the next poke\n337\t        // or touch retries. A pass stopping on \"waiting\" leaves a backing-off\n338\t        // head — handled below by arming a single eligibility wake.\n339\t        const result = await runDrain(st.filePath, deps);\n340\t        lastReport = result.ok ? result.value : undefined;\n341\t      } while (st.pending);\n342\t    } finally {\n343\t      st.running = false;\n344\t      // Fix 1 (DD-4 completion): honor eligibility in background mode. A pass\n345\t      // that stopped on \"waiting\" left a backing-off head that no later poke is\n346\t      // guaranteed to revisit; arm one wake at its eligible_at through the poke\n347\t      // path and stay unsettled until it fires, so drainSettled awaits the\n348\t      // retry. Any other stop reason (empty / max_items / in_flight, or a\n349\t      // failed pass) settles the thread now.\n350\t      if (\n351\t        st.wakeTimer === undefined &&\n352\t        lastReport?.stoppedBecause === \"waiting\" &&\n353\t        lastReport.waitingUntil !== undefined\n354\t      ) {\n355\t        armWake(st, lastReport.waitingUntil);\n356\t        return; // waiters resolve when the wake's drain settles, not here\n357\t      }\n358\t      for (const waiter of st.waiters.splice(0)) waiter();\n359\t    }\n360\t  }\n361\t\n362\t  function schedule(threadId: string): void {\n363\t    const st = stateFor(threadId);\n364\t    // A poke (or the wake itself) supersedes any pending backoff wake — we are\n365\t    // about to drain or coalesce, so the timer's job is done (one wake max).\n366\t    clearWake(st);\n367\t    if (st.filePath === \"\") return; // never touched here: no path to drain\n368\t    if (st.running) {\n369\t      st.pending = true; // burst coalesce: at most one further pass (AC-1.2)\n370\t      return;\n371\t    }\n372\t    st.running = true;\n373\t    void runLoop(st);\n374\t  }\n375\t\n376\t  return {\n377\t    mode,\n378\t    poke(threadId: string): void {\n379\t      if (mode !== \"background\") return;\n380\t      if (!deps.hasAnyHandler()) return;\n381\t      schedule(threadId);\n382\t    },\n383\t    touch(filePath: string, db: DatabaseSync): void {\n384\t      if (mode !== \"background\") return;\n385\t      const threadId = readThreadId(db);\n386\t      if (threadId === null) return;\n387\t      const st = stateFor(threadId);\n388\t      st.filePath = filePath;\n389\t      if (seen.has(threadId)) return;\n390\t      seen.add(threadId);\n391\t      // Catch-up (DD-10): leftover live work from a previous process runs on\n392\t      // first touch. One indexed query on the already-open handle keeps the\n393\t      // empty-queue case cheap.\n394\t      if (deps.hasAnyHandler() && countLiveItems(db) > 0) schedule(threadId);\n395\t    },\n396\t    drainSettled(threadId: string): Promise<void> {\n397\t      const st = states.get(threadId);\n398\t      // A pending backoff wake counts as unsettled (Fix 1): the retry it will\n399\t      // fire is part of this drain cycle, so the awaitable must span it.\n400\t      if (\n401\t        st === undefined ||\n402\t        (!st.running && !st.pending && st.wakeTimer === undefined)\n403\t      ) {\n404\t        return Promise.resolve();\n405\t      }\n406\t      return new Promise((resolve) => st.waiters.push(resolve));\n407\t    },\n408\t    testPassCount(threadId: string): number {\n409\t      return states.get(threadId)?.passes ?? 0;\n410\t    },\n411\t  };\n412\t}\n413\t"}]},"parent_tool_use_id":null,"session_id":"77c6c733-044c-452a-abeb-bd7584806be0","uuid":"f6f133b6-c399-4383-b4ac-9c0476db24cc","timestamp":"2026-06-12T15:09:25.030Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/scheduler.ts","content":"// SDK-internal scheduler and drain (DD-4): the one component holding\n// cross-operation in-memory state. The drain loop lives here per the tech\n// design's placement — claim under BEGIN IMMEDIATE, dispatch through the\n// handler map with no open transaction (the provider call lives there),\n// complete in a second short transaction. Background mode adds per-thread\n// single-flight with pending-flag coalescing, post-commit pokes, first-touch\n// catch-up (DD-10), and drainSettled (issue 3). The in-memory state is\n// advisory only: cross-process safety comes from the durable lease alone, so\n// a fresh handle sees identical drain behavior — the queue is the rows.\nimport { existsSync } from \"node:fs\";\nimport {\n  clearTimeout as cancelTimer,\n  setImmediate as scheduleMacrotask,\n  setTimeout as scheduleTimer,\n} from \"node:timers\";\nimport { DatabaseSync } from \"node:sqlite\";\nimport { openThreadDatabase } from \"./domains/threads/index.js\";\nimport type {\n  HandlerOutcome,\n  ResolvedSdkConfig,\n  WorkHandler,\n} from \"./shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"./shared/errors.js\";\nimport {\n  claimNext,\n  complete,\n  countLiveItems,\n  failAttempt,\n  failTerminal,\n  type ClaimedWorkItem,\n  type WorkKind,\n  type WorkSourceRef,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type SchedulerMode = \"background\" | \"manual\";\n\n// Report shape per tech design §Interfaces. `superseded` never appears here:\n// the cascade deletes superseded items and reports them on the mutation\n// result; a drain never sees them.\nexport interface DrainReport {\n  ran: Array<{\n    workItemId: string;\n    kind: WorkKind;\n    sourceRef: WorkSourceRef;\n    disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\";\n    attempts: number;\n    reason?: string;\n  }>;\n  stoppedBecause: \"empty\" | \"in_flight\" | \"waiting\" | \"max_items\";\n  waitingUntil?: string; // head's eligible_at when stoppedBecause = \"waiting\"\n  remaining: number; // live items left behind the stop point\n}\n\nexport interface DrainDeps {\n  lookupHandler: (kind: string) => OpResult<WorkHandler>;\n  // Whether any handler is registered at all. Background scheduling is gated\n  // on this, fail-closed: with an empty map a background drain could only\n  // turn queued rows into failed_terminal — destruction, not processing — so\n  // pokes and catch-up stay inert until a handler table is populated\n  // (Stories 2–3 in production; explicit registration in tests).\n  hasAnyHandler: () => boolean;\n  config: ResolvedSdkConfig;\n}\n\nfunction ranEntry(\n  item: ClaimedWorkItem,\n  disposition: \"done\" | \"failed_terminal\" | \"stale_discarded\",\n  attempts: number,\n  reason?: string,\n): DrainReport[\"ran\"][number] {\n  const entry: DrainReport[\"ran\"][number] = {\n    workItemId: item.workItemId,\n    kind: item.kind as WorkKind,\n    sourceRef: item.sourceRef,\n    disposition,\n    attempts,\n  };\n  if (reason !== undefined) entry.reason = reason;\n  return entry;\n}\n\n// The drain loop against an open handle. Claim → dispatch → complete, one\n// item at a time, until the head stops it (empty / in_flight / waiting) or\n// maxItems is reached. The handler runs with NO open transaction; the only\n// exits from a handler failure are failAttempt and the terminal paths — the\n// drain never catches an error and records success.\nexport async function drainOpenDb(\n  db: DatabaseSync,\n  deps: DrainDeps,\n  opts?: { maxItems?: number },\n): Promise<DrainReport> {\n  const { clock, lease, retry, provider } = deps.config;\n  const ran: DrainReport[\"ran\"] = [];\n  let stoppedBecause: DrainReport[\"stoppedBecause\"];\n  let waitingUntil: string | undefined;\n\n  for (;;) {\n    if (opts?.maxItems !== undefined && ran.length >= opts.maxItems) {\n      stoppedBecause = \"max_items\";\n      break;\n    }\n    const claim = claimNext(db, clock().toISOString(), lease.durationMs);\n    if (claim.outcome === \"empty\") {\n      stoppedBecause = \"empty\";\n      break;\n    }\n    if (claim.outcome === \"in_flight\") {\n      stoppedBecause = \"in_flight\";\n      break;\n    }\n    if (claim.outcome === \"waiting\") {\n      stoppedBecause = \"waiting\";\n      waitingUntil = claim.waitingUntil;\n      break;\n    }\n    const item = claim.item;\n\n    const lookedUp = deps.lookupHandler(item.kind);\n    if (!lookedUp.ok) {\n      // Unregistered kind: the normal terminal transaction, not a try/catch\n      // skip — failed_terminal with the stable code, form (if resolvable\n      // from the payload) lands failed, and the drain continues (AC-1.8).\n      failTerminal(db, item, {\n        reason: lookedUp.error.code,\n        formState: \"failed\",\n        attempts: item.attempts,\n        now: clock().toISOString(),\n      });\n      ran.push(ranEntry(item, \"failed_terminal\", item.attempts, lookedUp.error.code));\n      continue;\n    }\n\n    let outcome: HandlerOutcome;\n    try {\n      outcome = await lookedUp.value(\n        { openDb: () => db, provider, clock, config: deps.config },\n        {\n          workItemId: item.workItemId,\n          kind: item.kind,\n          sourceRef: item.sourceRef as unknown as Record<string, string>,\n        },\n      );\n    } catch (cause) {\n      // A throwing handler is a bug by the error contract, but the queue\n      // must not wedge on it: route it through the normal retry path so it\n      // counts attempts and exhausts visibly.\n      const detail = cause instanceof Error ? cause.message : String(cause);\n      outcome = { ok: false, retryable: true, reason: `handler threw: ${detail}` };\n    }\n\n    if (outcome.ok) {\n      const disposition = complete(\n        db,\n        item,\n        outcome.forms ?? [],\n        clock().toISOString(),\n        outcome.onApplied,\n      );\n      ran.push(ranEntry(item, disposition, item.attempts));\n      continue;\n    }\n    if (\"blocked\" in outcome) {\n      failTerminal(db, item, {\n        reason: outcome.reason,\n        formState: \"blocked\",\n        attempts: item.attempts + 1,\n        now: clock().toISOString(),\n      });\n      ran.push(ranEntry(item, \"failed_terminal\", item.attempts + 1, outcome.reason));\n      continue;\n    }\n    const failed = failAttempt(db, item, {\n      reason: outcome.reason,\n      retryable: outcome.retryable,\n      now: clock().toISOString(),\n      retry,\n    });\n    if (failed.terminal) {\n      ran.push(ranEntry(item, \"failed_terminal\", failed.attempts, outcome.reason));\n    }\n    // Under budget the item went back to queued (possibly backing off); the\n    // next claimNext re-reads the head — a backing-off head ends the drain\n    // with \"waiting\" and gates everything behind it.\n  }\n\n  const report: DrainReport = { ran, stoppedBecause, remaining: countLiveItems(db) };\n  if (waitingUntil !== undefined) report.waitingUntil = waitingUntil;\n  return report;\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\n// The drain operation against a thread file: open (validates + migrates),\n// drain, close. Both the SDK's work.drain and the background loop's passes\n// run through here — manual and background modes share one drain.\nexport async function runDrain(\n  filePath: string,\n  deps: DrainDeps,\n  opts?: { maxItems?: number },\n): Promise<OpResult<DrainReport>> {\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    return { ok: true, value: await drainOpenDb(db, deps, opts) };\n  } catch (cause) {\n    const detail = cause instanceof Error ? cause.message : String(cause);\n    return storageFailure(`drain failed: ${detail}`);\n  } finally {\n    db.close();\n  }\n}\n\ninterface ThreadDrainState {\n  threadId: string;\n  filePath: string;\n  running: boolean;\n  pending: boolean;\n  passes: number; // test-only observability (TC-1.2); must not become API\n  waiters: Array<() => void>;\n  // Fix 1 (DD-4 completion): at most one pending backoff wake per thread; a\n  // poke or a newer wake clears it. unref'd so it never keeps the process\n  // alive. Background only — manual never reaches the drain loop.\n  wakeTimer: ReturnType<typeof scheduleTimer> | undefined;\n}\n\n// A wake floored to a sane minimum: an eligible_at already in the past must\n// nudge once, not busy-spin (the durable claimNext gate is the real guard).\nconst WAKE_MIN_DELAY_MS = 5;\n\nexport interface Scheduler {\n  readonly mode: SchedulerMode;\n  // Post-commit nudge that work was queued for a thread (DD-5). Manual mode:\n  // no-op by contract. Background mode: starts a drain, or coalesces into\n  // the pending flag if one is already running for the thread (AC-1.2).\n  poke(threadId: string): void;\n  // Thread-file open announcement (DD-10): learns threadId → filePath and,\n  // on the first touch of a thread this process lifetime, schedules a\n  // catch-up drain if the queue has leftover live work (AC-1.6).\n  touch(filePath: string, db: DatabaseSync): void;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3). Manual mode resolves immediately.\n  drainSettled(threadId: string): Promise<void>;\n  // Test-only observability for coalescing exactness (TC-1.2): drain passes\n  // started for a thread. Named as a test hook on purpose — not API.\n  testPassCount(threadId: string): number;\n}\n\nfunction readThreadId(db: DatabaseSync): string | null {\n  const row = db.prepare(\"SELECT thread_id FROM thread_metadata WHERE id = 1\").get() as\n    | { thread_id: string }\n    | undefined;\n  return row?.thread_id ?? null;\n}\n\n// Read a thread file's id without side effects (no migration, no touch) —\n// drainSettled must observe scheduler state, never schedule work.\nexport function peekThreadId(filePath: string): string | null {\n  if (!existsSync(filePath)) return null;\n  let db: DatabaseSync | undefined;\n  try {\n    db = new DatabaseSync(filePath, { readOnly: true });\n    return readThreadId(db);\n  } catch {\n    return null;\n  } finally {\n    db?.close();\n  }\n}\n\nexport function createScheduler(mode: SchedulerMode, deps: DrainDeps): Scheduler {\n  const states = new Map<string, ThreadDrainState>();\n  const seen = new Set<string>(); // first-touch catch-up guard, process lifetime\n\n  function stateFor(threadId: string): ThreadDrainState {\n    let st = states.get(threadId);\n    if (st === undefined) {\n      st = {\n        threadId,\n        filePath: \"\",\n        running: false,\n        pending: false,\n        passes: 0,\n        waiters: [],\n        wakeTimer: undefined,\n      };\n      states.set(threadId, st);\n    }\n    return st;\n  }\n\n  function clearWake(st: ThreadDrainState): void {\n    if (st.wakeTimer !== undefined) {\n      cancelTimer(st.wakeTimer);\n      st.wakeTimer = undefined;\n    }\n  }\n\n  // Arm the lone backoff wake (Fix 1): when a background pass stops on the\n  // eligibility gate, schedule a single nudge at the head's eligible_at that\n  // re-enters the existing poke path. The delay reads the SDK clock seam (no\n  // fresh Date here — E02-NB-001) and is floored to a sane minimum; correctness\n  // rides claimNext's durable gate, so a coarse timer never retries early.\n  function armWake(st: ThreadDrainState, waitingUntil: string): void {\n    clearWake(st);\n    const nowMs = deps.config.clock().getTime();\n    const delay = Math.max(WAKE_MIN_DELAY_MS, Date.parse(waitingUntil) - nowMs);\n    const timer = scheduleTimer(() => {\n      st.wakeTimer = undefined;\n      schedule(st.threadId);\n    }, delay);\n    timer.unref();\n    st.wakeTimer = timer;\n  }\n\n  async function runLoop(st: ThreadDrainState): Promise<void> {\n    // Defer past the committing operation's synchronous tail so the drain\n    // never contends with the transaction whose commit scheduled it.\n    await new Promise((resolve) => scheduleMacrotask(resolve));\n    let lastReport: DrainReport | undefined;\n    try {\n      do {\n        st.pending = false;\n        st.passes += 1;\n        // A failed pass (storage error) has no caller to report to in\n        // background mode; the durable rows are untouched and the next poke\n        // or touch retries. A pass stopping on \"waiting\" leaves a backing-off\n        // head — handled below by arming a single eligibility wake.\n        const result = await runDrain(st.filePath, deps);\n        lastReport = result.ok ? result.value : undefined;\n      } while (st.pending);\n    } finally {\n      st.running = false;\n      // Fix 1 (DD-4 completion): honor eligibility in background mode. A pass\n      // that stopped on \"waiting\" left a backing-off head that no later poke is\n      // guaranteed to revisit; arm one wake at its eligible_at through the poke\n      // path and stay unsettled until it fires, so drainSettled awaits the\n      // retry. Any other stop reason (empty / max_items / in_flight, or a\n      // failed pass) settles the thread now.\n      if (\n        st.wakeTimer === undefined &&\n        lastReport?.stoppedBecause === \"waiting\" &&\n        lastReport.waitingUntil !== undefined\n      ) {\n        armWake(st, lastReport.waitingUntil);\n        return; // waiters resolve when the wake's drain settles, not here\n      }\n      for (const waiter of st.waiters.splice(0)) waiter();\n    }\n  }\n\n  function schedule(threadId: string): void {\n    const st = stateFor(threadId);\n    // A poke (or the wake itself) supersedes any pending backoff wake — we are\n    // about to drain or coalesce, so the timer's job is done (one wake max).\n    clearWake(st);\n    if (st.filePath === \"\") return; // never touched here: no path to drain\n    if (st.running) {\n      st.pending = true; // burst coalesce: at most one further pass (AC-1.2)\n      return;\n    }\n    st.running = true;\n    void runLoop(st);\n  }\n\n  return {\n    mode,\n    poke(threadId: string): void {\n      if (mode !== \"background\") return;\n      if (!deps.hasAnyHandler()) return;\n      schedule(threadId);\n    },\n    touch(filePath: string, db: DatabaseSync): void {\n      if (mode !== \"background\") return;\n      const threadId = readThreadId(db);\n      if (threadId === null) return;\n      const st = stateFor(threadId);\n      st.filePath = filePath;\n      if (seen.has(threadId)) return;\n      seen.add(threadId);\n      // Catch-up (DD-10): leftover live work from a previous process runs on\n      // first touch. One indexed query on the already-open handle keeps the\n      // empty-queue case cheap.\n      if (deps.hasAnyHandler() && countLiveItems(db) > 0) schedule(threadId);\n    },\n    drainSettled(threadId: string): Promise<void> {\n      const st = states.get(threadId);\n      // A pending backoff wake counts as unsettled (Fix 1): the retry it will\n      // fire is part of this drain cycle, so the awaitable must span it.\n      if (\n        st === undefined ||\n        (!st.running && !st.pending && st.wakeTimer === undefined)\n      ) {\n        return Promise.resolve();\n      }\n      return new Promise((resolve) => st.waiters.push(resolve));\n    },\n    testPassCount(threadId: string): number {\n      return states.get(threadId)?.passes ?? 0;\n    },\n  };\n}\n","numLines":413,"startLine":1,"totalLines":413}}}

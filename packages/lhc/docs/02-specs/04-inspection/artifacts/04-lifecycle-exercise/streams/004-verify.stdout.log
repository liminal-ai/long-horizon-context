{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/lifecycle.test.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Story 4 (Epic 04), default suite: TC-5.1–5.3 — the full-surface lifecycle\n     2\t// exercise. One scripted sequence (test/fixtures/lifecycle.ts) drives every\n     3\t// built v1 surface in PI-extension call order against one real SDK\n     4\t// configuration with the registry's deterministic provider: zero network and\n     5\t// zero real-provider calls are structural (no other provider exists in the\n     6\t// configuration), and every checkpoint assertion lives here, not in the\n     7\t// script, so the replay (TC-5.2), teardown (TC-5.3), and process (TC-5.4,\n     8\t// cli-process-inspect.test.ts) legs replay the same sequence.\n     9\t//\n    10\t// Determinism control: the wall clock is the one ambient input the built\n    11\t// surfaces stamp into outputs (event recorded_at, view created_at, mutation\n    12\t// timestamps), so this file freezes Date — and only Date; the scheduler's\n    13\t// real setImmediate/setTimeout stay live for the background drains. With\n    14\t// the clock frozen, pull outputs are byte-identical across runs with no\n    15\t// normalization at all.\n    16\t//\n    17\t// One pinned deviation (AC-5.3/AC-5.4 file equality): a thread's id is the\n    18\t// design's ONE random value (threads design decision 7), and the PI session\n    19\t// header embeds it (`id: \"<threadId>:<timestamp>\"`). Two real threads cannot\n    20\t// share an id through the public surface, so the materialized-file equality\n    21\t// here substitutes each run's own thread id with a fixed placeholder and\n    22\t// requires every other byte identical. Nothing else is normalized.\n    23\timport { createHash } from \"node:crypto\";\n    24\timport { readFileSync } from \"node:fs\";\n    25\timport { afterAll, beforeAll, describe, expect, it, vi } from \"vitest\";\n    26\timport {\n    27\t  estimateTokens,\n    28\t  type FormReportEntry,\n    29\t  type HealthReport,\n    30\t  type MutationResult,\n    31\t  type OpResult,\n    32\t  type PullResult,\n    33\t  type SweepReceipt,\n    34\t  type ViewMessage,\n    35\t} from \"../src/index.js\";\n    36\timport {\n    37\t  DELETED_MESSAGE_TEXT,\n    38\t  EDITED_MESSAGE_TEXT,\n    39\t  LIFECYCLE_PROFILE,\n    40\t  runLifecycle,\n    41\t  tempStore,\n    42\t  type LifecycleRun,\n    43\t  type TempStore,\n    44\t} from \"./fixtures/index.js\";\n    45\t\n    46\tlet store: TempStore;\n    47\tlet run: LifecycleRun;\n    48\t\n    49\tbeforeAll(async () => {\n    50\t  vi.useFakeTimers({ toFake: [\"Date\"] });\n    51\t  vi.setSystemTime(new Date(\"2026-06-12T00:00:00.000Z\"));\n    52\t  store = tempStore();\n    53\t  run = await runLifecycle(store, { name: \"baseline\" });\n    54\t}, 60000);\n    55\tafterAll(() => {\n    56\t  vi.useRealTimers();\n    57\t  store.cleanup();\n    58\t});\n    59\t\n    60\tfunction ok<T>(result: OpResult<T>): T {\n    61\t  if (!result.ok) {\n    62\t    throw new Error(`expected ok result: ${JSON.stringify(result.error)}`);\n    63\t  }\n    64\t  return result.value;\n    65\t}\n    66\t\n    67\tfunction sha256(value: string): string {\n    68\t  return createHash(\"sha256\").update(value).digest(\"hex\");\n    69\t}\n    70\t\n    71\tfunction measured(messages: readonly ViewMessage[]): number {\n    72\t  return messages.reduce((sum, message) => sum + estimateTokens(message.content), 0);\n    73\t}\n    74\t\n    75\tfunction clearedKeys(...mutations: MutationResult[]): string[] {\n    76\t  return mutations\n    77\t    .flatMap((mutation) => mutation.cleared)\n    78\t    .map((target) => `${target.subjectKind}:${target.subjectId}:${target.form}`)\n    79\t    .sort();\n    80\t}\n    81\t\n    82\tfunction pendingKeys(...reports: Array<readonly FormReportEntry[]>): string[] {\n    83\t  return reports\n    84\t    .flat()\n    85\t    .filter((entry) => entry.state === \"pending\")\n    86\t    .map((entry) => `${entry.subjectKind}:${entry.subjectId}:${entry.form}`)\n    87\t    .sort();\n    88\t}\n    89\t\n    90\ttype SweepLine = SweepReceipt[\"owners\"][number];\n    91\tfunction byOwnerKind(rows: readonly SweepLine[]): SweepLine[] {\n    92\t  return [...rows].sort((a, b) =>\n    93\t    `${a.owner}/${a.kind}`.localeCompare(`${b.owner}/${b.kind}`),\n    94\t  );\n    95\t}\n    96\t\n    97\t// The materialized file with the run's own thread id substituted — the one\n    98\t// sanctioned normalization (see header).\n    99\tfunction comparableSessionFile(lifecycleRun: LifecycleRun): string {\n   100\t  return readFileSync(lifecycleRun.outPath, \"utf8\").replaceAll(\n   101\t    lifecycleRun.threadId,\n   102\t    \"<thread-id>\",\n   103\t  );\n   104\t}\n   105\t\n   106\tdescribe(\"TC-5.1 / AC-5.1: the full sequence completes ok through one SDK configuration\", () => {\n   107\t  it(\"every phase operation returns ok with the deterministic provider only\", () => {\n   108\t    const { phases } = run;\n   109\t    expect(phases.create.ok).toBe(true);\n   110\t    for (const batch of phases.intake) expect(batch.ok).toBe(true);\n   111\t    expect(phases.drain.settled).toBe(true);\n   112\t    expect(phases.status.ok).toBe(true);\n   113\t    expect(phases.compact1.ok).toBe(true);\n   114\t    expect(phases.pull1.ok).toBe(true);\n   115\t    expect(phases.inspect1.overview.ok).toBe(true);\n   116\t    expect(phases.inspect1.view.ok).toBe(true);\n   117\t    expect(phases.inspect1.health.ok).toBe(true);\n   118\t    expect(phases.mutate.edit.ok).toBe(true);\n   119\t    expect(phases.mutate.delete.ok).toBe(true);\n   120\t    expect(phases.mutate.healthAfterMutate.ok).toBe(true);\n   121\t    expect(phases.rebuild.settled).toBe(true);\n   122\t    expect(phases.health2.ok).toBe(true);\n   123\t    expect(phases.compact2.ok).toBe(true);\n   124\t    expect(phases.pull2.ok).toBe(true);\n   125\t    expect(phases.materialize.ok).toBe(true);\n   126\t  });\n   127\t\n   128\t  it(\"status recommends the compact the sequence performs next, with derivation settled\", () => {\n   129\t    const status = ok(run.phases.status);\n   130\t    expect(status.threshold).toBe(300);\n   131\t    expect(status.tailTokens).toBeGreaterThan(status.threshold);\n   132\t    expect(status.compactRecommended).toBe(true);\n   133\t    expect(status.derivation).toEqual({ pending: 0, retrying: 0, failed: 0, blocked: 0 });\n   134\t    expect(status.view).toBeNull(); // not yet compacted at this checkpoint\n   135\t  });\n   136\t});\n   137\t\n   138\tdescribe(\"TC-5.1 / AC-5.2: checkpoint coherence across the sequence\", () => {\n   139\t  it(\"post-compact pull serves bands + tail, and the view report's loadCost prices that pull\", () => {\n   140\t    const receipt = ok(run.phases.compact1);\n   141\t    expect(receipt.profile).toBe(LIFECYCLE_PROFILE.name);\n   142\t    const pull = ok(run.phases.pull1);\n   143\t\n   144\t    // Bands open the array in gradient order; the tail follows in record\n   145\t    // order — the served shape the PI extension will consume.\n   146\t    const bands = pull.messages.filter((message) => message.band !== undefined);\n   147\t    expect(bands.map((message) => message.band)).toEqual([\"brief\", \"detailed\", \"smooth\"]);\n   148\t    expect(pull.messages.slice(0, bands.length)).toEqual(bands);\n   149\t    const tail = pull.messages.slice(bands.length);\n   150\t    expect(tail.length).toBeGreaterThan(0);\n   151\t    expect(tail.every((message) => message.band === undefined)).toBe(true);\n   152\t    expect(pull.meta.viewId).toBe(receipt.viewId);\n   153\t    expect(pull.meta.compactPoint).toBe(receipt.compactPoint);\n   154\t\n   155\t    // Cross-epic loadCost checkpoint (test plan: report at compact1 vs\n   156\t    // pull1): the inspect report's serving cost equals this independent\n   157\t    // pull re-measured with the shared estimator.\n   158\t    const report = ok(run.phases.inspect1.view);\n   159\t    expect(report.meta?.viewId).toBe(receipt.viewId);\n   160\t    expect(report.meta?.profile).toBe(LIFECYCLE_PROFILE.name);\n   161\t    expect(report.loadCost.bandTokens).toBe(measured(bands));\n   162\t    expect(report.loadCost.tailTokens).toBe(measured(tail));\n   163\t    expect(report.loadCost.total).toBe(measured(pull.messages));\n   164\t\n   165\t    // Overview agrees on the same view identity with derivation settled.\n   166\t    const overview = ok(run.phases.inspect1.overview);\n   167\t    expect(overview.view?.viewId).toBe(receipt.viewId);\n   168\t    expect(overview.derivation.pending).toBe(0);\n   169\t    expect(overview.messages.deleted).toBe(0);\n   170\t  });\n   171\t\n   172\t  it(\"post-mutation health shows exactly the cleared set pending; post-drain health shows it ready\", () => {\n   173\t    const { mutate } = run.phases;\n   174\t    const edit = ok(mutate.edit);\n   175\t    const deleted = ok(mutate.delete);\n   176\t    expect(edit.superseded).toEqual([]);\n   177\t    expect(deleted.superseded).toEqual([]);\n   178\t    // The deleted assistant_text owns no derived forms: its cascade clears\n   179\t    // sibling turn forms only.\n   180\t    expect(deleted.dropped).toEqual([]);\n   181\t\n   182\t    // The cascade contracts' cleared union IS the pending set the owners\n   183\t    // report — no more, no less (AC-5.2's \"the cleared set pending\").\n   184\t    const cleared = clearedKeys(edit, deleted);\n   185\t    expect(cleared.length).toBeGreaterThan(0);\n   186\t    const pending = pendingKeys(ok(mutate.messagesNotReady), ok(mutate.turnsNotReady));\n   187\t    expect(pending).toEqual(cleared);\n   188\t\n   189\t    // Health joins the same truth: pending counts sum to the cleared set,\n   190\t    // with the queued replacement work live and unclaimed (the background\n   191\t    // drain has not started — the snapshot precedes its first pass).\n   192\t    const health = ok(mutate.healthAfterMutate);\n   193\t    const pendingTotal = health.owners.reduce(\n   194\t      (sum, row) => sum + row.counts.pending + row.counts.retrying,\n   195\t      0,\n   196\t    );\n   197\t    expect(pendingTotal).toBe(cleared.length);\n   198\t    // Queue visibility is counted per report entry (AC-4.5's by-construction\n   199\t    // consistency), so queued equals the pending entries — all unclaimed.\n   200\t    expect(health.queue).toEqual({ queued: cleared.length, claimed: 0 });\n   201\t    expect(edit.queued.length).toBeGreaterThan(0);\n   202\t    expect(deleted.queued.length).toBeGreaterThan(0);\n   203\t    expect(health.failures).toEqual([]);\n   204\t\n   205\t    // Post-drain (rebuild settled): everything ready, nothing failed,\n   206\t    // queue empty.\n   207\t    const after = ok(run.phases.health2);\n   208\t    for (const row of after.owners) {\n   209\t      expect(row.counts.pending).toBe(0);\n   210\t      expect(row.counts.retrying).toBe(0);\n   211\t      expect(row.counts.failed).toBe(0);\n   212\t      expect(row.counts.blocked).toBe(0);\n   213\t      expect(row.counts.ready).toBeGreaterThan(0);\n   214\t    }\n   215\t    expect(after.failures).toEqual([]);\n   216\t    expect(after.repairPreview).toEqual([]);\n   217\t    expect(after.queue).toEqual({ queued: 0, claimed: 0 });\n   218\t  });\n   219\t\n   220\t  it(\"the second compact's view reflects post-edit content\", () => {\n   221\t    const pull1 = ok(run.phases.pull1);\n   222\t    const pull2 = ok(run.phases.pull2);\n   223\t\n   224\t    // Before the mutations: the original prompt and the to-be-deleted text\n   225\t    // are served verbatim in the tail (full fidelity).\n   226\t    expect(\n   227\t      pull1.messages.some((m) => m.content === \"turn 12: please investigate area 12\"),\n   228\t    ).toBe(true);\n   229\t    expect(pull1.messages.some((m) => m.content === DELETED_MESSAGE_TEXT)).toBe(true);\n   230\t\n   231\t    // After mutate + rebuild + compact2: the edited prompt serves verbatim,\n   232\t    // the deleted message is gone from the served view entirely.\n   233\t    expect(\n   234\t      pull2.messages.some(\n   235\t        (m) => m.band === undefined && m.role === \"user\" && m.content === EDITED_MESSAGE_TEXT,\n   236\t      ),\n   237\t    ).toBe(true);\n   238\t    expect(pull2.messages.some((m) => m.content.includes(DELETED_MESSAGE_TEXT))).toBe(false);\n   239\t    expect(\n   240\t      pull2.messages.some((m) => m.content === \"turn 12: please investigate area 12\"),\n   241\t    ).toBe(false);\n   242\t  });\n   243\t\n   244\t  it(\"the second compact receipt's sweep section agrees with the health report taken immediately before it\", () => {\n   245\t    const receipt = ok(run.phases.compact2);\n   246\t    const health: HealthReport = ok(run.phases.health2);\n   247\t    expect(\"owners\" in receipt.sweep).toBe(true);\n   248\t    const sweep = receipt.sweep as SweepReceipt;\n   249\t\n   250\t    // Field-level agreement per owner/kind: the sweep saw exactly the state\n   251\t    // health reported — same ready counts, in-flight = pending + retrying,\n   252\t    // and the failed/requeued/blocked sets empty on both sides.\n   253\t    const expectedFromHealth = health.owners.map((row) => ({\n   254\t      owner: row.owner,\n   255\t      kind: row.kind,\n   256\t      ready: row.counts.ready,\n   257\t      inFlight: row.counts.pending + row.counts.retrying,\n   258\t      requeued: [],\n   259\t      blocked: [],\n   260\t      permanentFailed: [],\n   261\t    }));\n   262\t    expect(byOwnerKind(sweep.owners)).toEqual(byOwnerKind(expectedFromHealth));\n   263\t    expect(health.failures).toEqual([]);\n   264\t  });\n   265\t});\n   266\t\n   267\tdescribe(\"TC-5.2 / AC-5.3: replay determinism on a fresh thread\", () => {\n   268\t  it(\"produces hash-equal pull outputs and a byte-identical materialized file (modulo the one random thread id)\", async () => {\n   269\t    const replay = await runLifecycle(store, { name: \"replay\" });\n   270\t\n   271\t    // Pull outputs: exact hash equality, no normalization — the frozen\n   272\t    // clock leaves no ambient input, so any inequality is real\n   273\t    // nondeterminism in the built surfaces.\n   274\t    const pulls: Array<[OpResult<PullResult>, OpResult<PullResult>]> = [\n   275\t      [run.phases.pull1, replay.phases.pull1],\n   276\t      [run.phases.pull2, replay.phases.pull2],\n   277\t    ];\n   278\t    for (const [original, replayed] of pulls) {\n   279\t      expect(sha256(JSON.stringify(ok(replayed)))).toBe(sha256(JSON.stringify(ok(original))));\n   280\t    }\n   281\t\n   282\t    // Materialized file: identical bytes after substituting each thread's\n   283\t    // own id (the header's one random value — see file header note).\n   284\t    expect(replay.threadId).not.toBe(run.threadId);\n   285\t    expect(sha256(comparableSessionFile(replay))).toBe(sha256(comparableSessionFile(run)));\n   286\t  }, 60000);\n   287\t});\n   288\t\n   289\tdescribe(\"TC-5.3 / AC-5.4: teardown continuity — fresh createSdk between phase groups\", () => {\n   290\t  it(\"yields final pull, health, and materialized file identical to the uninterrupted run's\", async () => {\n   291\t    const teardown = await runLifecycle(store, {\n   292\t      name: \"teardown\",\n   293\t      freshSdkBetweenGroups: true,\n   294\t    });\n   295\t\n   296\t    // No in-memory dependency: the end state lives in the thread file, so a\n   297\t    // fresh instance continuing each phase group lands byte-identical.\n   298\t    expect(JSON.stringify(ok(teardown.phases.pull2))).toBe(\n   299\t      JSON.stringify(ok(run.phases.pull2)),\n   300\t    );\n   301\t    expect(ok(teardown.phases.health2)).toEqual(ok(run.phases.health2));\n   302\t    expect(sha256(comparableSessionFile(teardown))).toBe(sha256(comparableSessionFile(run)));\n   303\t  }, 60000);\n   304\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/lifecycle.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// The Epic 04 lifecycle script (Story 4, Flow 5): every built v1 surface\n     2\t// driven once, in PI-extension call order, against one real SDK\n     3\t// configuration with the deterministic provider — zero network, zero real\n     4\t// provider, no mocks anywhere. The script owns the sequence and the phase\n     5\t// names (tech design Flow 5); assertions live in the driving tests, so the\n     6\t// replay, teardown, and process legs all run THIS sequence rather than a\n     7\t// re-described one (DD-8).\n     8\t//\n     9\t// Phases: create | intake | drain | status | compact1 | pull1 | inspect1 |\n    10\t// mutate | rebuild | health2 | compact2 | pull2 | materialize.\n    11\t//\n    12\t// Mode is background — the production posture the PI extension will run —\n    13\t// and the drain/rebuild phases settle through `drainSettled`, the real\n    14\t// background awaitable. The post-mutation health snapshot (AC-5.2's\n    15\t// \"cleared set pending\") is deterministic because every SDK operation here\n    16\t// is synchronous SQLite chained through microtasks, while a background\n    17\t// drain pass always starts on a macrotask (scheduler runLoop defers through\n    18\t// setImmediate): the edit → delete → health reads inside the mutate phase\n    19\t// run as one unbroken microtask cascade and complete before the poked drain\n    20\t// can claim its first item. The rebuild phase then yields via drainSettled\n    21\t// and the drain runs to empty.\n    22\timport { join } from \"node:path\";\n    23\timport {\n    24\t  createSdk,\n    25\t  resolveNamedProvider,\n    26\t  type BatchResult,\n    27\t  type CompactReceipt,\n    28\t  type FormReportEntry,\n    29\t  type HealthReport,\n    30\t  type InspectOverview,\n    31\t  type Lhc,\n    32\t  type MessageEventInput,\n    33\t  type MutationResult,\n    34\t  type OpResult,\n    35\t  type PullResult,\n    36\t  type ViewContentsReport,\n    37\t  type ViewStatus,\n    38\t} from \"../../src/index.js\";\n    39\timport { validEvent, type TempStore } from \"./index.js\";\n    40\t\n    41\t// ── the one SDK configuration (AC-5.1) ────────────────────────────\n    42\t//\n    43\t// Deterministic provider from the production registry (the same resolution\n    44\t// seam the spawned CLI uses), background mode, zero-backoff retry so a\n    45\t// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\n    46\t// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\n    47\t// a named \"lifecycle\" profile so compact runs profile-addressed (story\n    48\t// scope: \"compact (profile)\") with all three lower bands non-empty on this\n    49\t// thread (Epic 03 Story 2's reference gradient).\n    50\texport const LIFECYCLE_PROFILE = {\n    51\t  name: \"lifecycle\",\n    52\t  lowerBound: 400,\n    53\t  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\n    54\t} as const;\n    55\t\n    56\texport function createLifecycleSdk(): Lhc {\n    57\t  const provider = resolveNamedProvider(\"deterministic\");\n    58\t  if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n    59\t  return createSdk({\n    60\t    provider,\n    61\t    mode: \"background\",\n    62\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    63\t    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\n    64\t    view: {\n    65\t      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\n    66\t      // Low threshold so the status checkpoint genuinely recommends the\n    67\t      // compact the sequence performs next.\n    68\t      compactThreshold: 300,\n    69\t    },\n    70\t  });\n    71\t}\n    72\t\n    73\t// ── the recorded conversation ─────────────────────────────────────\n    74\t//\n    75\t// Same shape and text profile as the Epic 03 derived-thread fixture (12\n    76\t// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\n    77\t// policy cuts the same 4-chunk shape — but with explicit per-run\n    78\t// idempotency keys so a replay on a fresh thread records byte-identical\n    79\t// event payloads regardless of any process-global fixture counters.\n    80\tconst TURN_COUNT = 12;\n    81\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n    82\tconst TURNS_PER_BATCH = 3; // multi-turn batches (story scope)\n    83\t\n    84\t// Mutation targets: both in the post-compact tail (compact point at t9's\n    85\t// start under the lifecycle profile), so the second compact's pull shows the\n    86\t// edit verbatim and the deletion's absence — the tail is full fidelity.\n    87\texport const EDIT_TARGET = { turnId: \"t12\", kind: \"user_prompt\" } as const;\n    88\texport const EDITED_MESSAGE_TEXT =\n    89\t  \"turn 12 revised: drop area 12 and re-check area 5 instead\";\n    90\texport const DELETE_TARGET = { turnId: \"t10\", kind: \"assistant_text\" } as const;\n    91\texport const DELETED_MESSAGE_TEXT = \"findings for area 10\";\n    92\t\n    93\tfunction turnEvents(turn: number): MessageEventInput[] {\n    94\t  let seq = 0;\n    95\t  const key = (): string => {\n    96\t    seq += 1;\n    97\t    return `lc-t${turn}-e${seq}`;\n    98\t  };\n    99\t  const events: MessageEventInput[] = [\n   100\t    validEvent(\"user_prompt\", {\n   101\t      idempotencyKey: key(),\n   102\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n   103\t    }),\n   104\t    validEvent(\"assistant_thinking\", {\n   105\t      idempotencyKey: key(),\n   106\t      payload: { text: `considering what area ${turn} contains` },\n   107\t    }),\n   108\t  ];\n   109\t  if (TOOL_HEAVY_TURNS.has(turn)) {\n   110\t    for (const run of [1, 2]) {\n   111\t      const toolCallId = `call-lc-${turn}-${run}`;\n   112\t      events.push(\n   113\t        validEvent(\"tool_call\", {\n   114\t          idempotencyKey: key(),\n   115\t          payload: {\n   116\t            toolCallId,\n   117\t            toolName: \"read_file\",\n   118\t            arguments: { path: `area-${turn}/file-${run}.txt` },\n   119\t          },\n   120\t        }),\n   121\t        validEvent(\"tool_result\", {\n   122\t          idempotencyKey: key(),\n   123\t          payload: {\n   124\t            toolCallId,\n   125\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n   126\t            isError: false,\n   127\t          },\n   128\t        }),\n   129\t      );\n   130\t    }\n   131\t  }\n   132\t  events.push(\n   133\t    validEvent(\"assistant_text\", {\n   134\t      idempotencyKey: key(),\n   135\t      payload: { text: `findings for area ${turn}` },\n   136\t    }),\n   137\t    validEvent(\"turn_end\", { idempotencyKey: key() }),\n   138\t  );\n   139\t  return events;\n   140\t}\n   141\t\n   142\tfunction intakeBatches(): MessageEventInput[][] {\n   143\t  const batches: MessageEventInput[][] = [];\n   144\t  for (let first = 1; first <= TURN_COUNT; first += TURNS_PER_BATCH) {\n   145\t    const batch: MessageEventInput[] = [];\n   146\t    for (let turn = first; turn < first + TURNS_PER_BATCH && turn <= TURN_COUNT; turn += 1) {\n   147\t      batch.push(...turnEvents(turn));\n   148\t    }\n   149\t    batches.push(batch);\n   150\t  }\n   151\t  return batches;\n   152\t}\n   153\t\n   154\t// ── run shape ─────────────────────────────────────────────────────\n   155\t\n   156\texport interface LifecyclePhases {\n   157\t  create: OpResult<{ threadId: string; filePath: string }>;\n   158\t  intake: Array<OpResult<BatchResult>>;\n   159\t  drain: { settled: true };\n   160\t  status: OpResult<ViewStatus>;\n   161\t  compact1: OpResult<CompactReceipt>;\n   162\t  pull1: OpResult<PullResult>;\n   163\t  inspect1: {\n   164\t    overview: OpResult<InspectOverview>;\n   165\t    view: OpResult<ViewContentsReport>;\n   166\t    health: OpResult<HealthReport>;\n   167\t  };\n   168\t  mutate: {\n   169\t    editedMessageId: string;\n   170\t    deletedMessageId: string;\n   171\t    edit: OpResult<MutationResult>;\n   172\t    delete: OpResult<MutationResult>;\n   173\t    // Captured inside the mutate phase, before the background drain's first\n   174\t    // macrotask: the cleared-set-pending evidence (AC-5.2).\n   175\t    healthAfterMutate: OpResult<HealthReport>;\n   176\t    messagesNotReady: OpResult<FormReportEntry[]>;\n   177\t    turnsNotReady: OpResult<FormReportEntry[]>;\n   178\t  };\n   179\t  rebuild: { settled: true };\n   180\t  health2: OpResult<HealthReport>;\n   181\t  compact2: OpResult<CompactReceipt>;\n   182\t  pull2: OpResult<PullResult>;\n   183\t  materialize: OpResult<{ writtenPath: string }>;\n   184\t}\n   185\t\n   186\texport type LifecycleCheckpoint = \"inspect1\" | \"health2\" | \"materialize\";\n   187\t\n   188\texport interface LifecycleOptions {\n   189\t  // Distinguishes the thread file and materialize target so replay and\n   190\t  // teardown legs run side by side in one store (same dir ⇒ same header cwd).\n   191\t  name?: string;\n   192\t  // TC-5.3: a fresh createSdk between the intake / compact / mutation /\n   193\t  // render phase groups — every group boundary is a quiescent point (no\n   194\t  // queued work, no running drain), so the abandoned instance can never act\n   195\t  // after its group ends.\n   196\t  freshSdkBetweenGroups?: boolean;\n   197\t  // TC-5.4: spawned-CLI parity probes at the three read checkpoints.\n   198\t  onCheckpoint?: (\n   199\t    checkpoint: LifecycleCheckpoint,\n   200\t    ctx: { sdk: Lhc; filePath: string },\n   201\t  ) => Promise<void>;\n   202\t}\n   203\t\n   204\texport interface LifecycleRun {\n   205\t  filePath: string;\n   206\t  outPath: string;\n   207\t  threadId: string;\n   208\t  phases: LifecyclePhases;\n   209\t}\n   210\t\n   211\tfunction expectOk<T>(result: OpResult<T>, phase: string): T {\n   212\t  if (!result.ok) {\n   213\t    throw new Error(`lifecycle ${phase} failed: ${result.error.code} — ${result.error.reason}`);\n   214\t  }\n   215\t  return result.value;\n   216\t}\n   217\t\n   218\t// ── the sequence ──────────────────────────────────────────────────\n   219\t\n   220\texport async function runLifecycle(\n   221\t  store: TempStore,\n   222\t  opts: LifecycleOptions = {},\n   223\t): Promise<LifecycleRun> {\n   224\t  const name = opts.name ?? \"lifecycle\";\n   225\t  const filePath = store.threadPath(name);\n   226\t  const outPath = join(store.dir, `${name}-session.jsonl`);\n   227\t  const ref = { filePath };\n   228\t\n   229\t  let sdk = createLifecycleSdk();\n   230\t  const nextGroup = (): void => {\n   231\t    // The fresh instance is the same configuration assembled again — the\n   232\t    // continuity proof is that no phase depends on the prior instance's\n   233\t    // memory, only on the thread file.\n   234\t    if (opts.freshSdkBetweenGroups) sdk = createLifecycleSdk();\n   235\t  };\n   236\t  const checkpoint = async (cp: LifecycleCheckpoint): Promise<void> => {\n   237\t    if (opts.onCheckpoint !== undefined) await opts.onCheckpoint(cp, { sdk, filePath });\n   238\t  };\n   239\t\n   240\t  // ── group 1: create → intake → drain → status ──\n   241\t  const create = await sdk.threads.newThread({\n   242\t    filePath,\n   243\t    registryPath: store.registryPath,\n   244\t  });\n   245\t  const threadId = expectOk(create, \"create\").threadId;\n   246\t\n   247\t  const intake: Array<OpResult<BatchResult>> = [];\n   248\t  for (const batch of intakeBatches()) {\n   249\t    const sent = await sdk.intakeStream.messageEvents(ref, batch);\n   250\t    intake.push(sent);\n   251\t    expectOk(sent, \"intake\");\n   252\t  }\n   253\t\n   254\t  // Background drain settles (story scope): the intake pokes scheduled the\n   255\t  // work; this is the await that lets the scheduler run it to empty.\n   256\t  await sdk.drainSettled(ref);\n   257\t  const drain = { settled: true } as const;\n   258\t\n   259\t  const status = await sdk.threadView.status(ref);\n   260\t  expectOk(status, \"status\");\n   261\t\n   262\t  // ── group 2: compact1 → pull1 → inspect1 ──\n   263\t  nextGroup();\n   264\t  const compact1 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\n   265\t  expectOk(compact1, \"compact1\");\n   266\t  const pull1 = await sdk.threadView.pull(ref);\n   267\t  expectOk(pull1, \"pull1\");\n   268\t  const inspect1 = {\n   269\t    overview: await sdk.inspect.overview(ref),\n   270\t    view: await sdk.inspect.view(ref),\n   271\t    health: await sdk.inspect.health(ref),\n   272\t  };\n   273\t  expectOk(inspect1.overview, \"inspect1.overview\");\n   274\t  expectOk(inspect1.view, \"inspect1.view\");\n   275\t  expectOk(inspect1.health, \"inspect1.health\");\n   276\t  await checkpoint(\"inspect1\");\n   277\t\n   278\t  // ── group 3: mutate → rebuild → health2 ──\n   279\t  nextGroup();\n   280\t  const listed = expectOk(await sdk.messages.listMessages(ref), \"mutate.list\");\n   281\t  const editTarget = listed.find(\n   282\t    (record) => record.kind === EDIT_TARGET.kind && record.turnId === EDIT_TARGET.turnId,\n   283\t  );\n   284\t  const deleteTarget = listed.find(\n   285\t    (record) => record.kind === DELETE_TARGET.kind && record.turnId === DELETE_TARGET.turnId,\n   286\t  );\n   287\t  if (editTarget === undefined || deleteTarget === undefined) {\n   288\t    throw new Error(\"lifecycle invariant: edit/delete targets not found in the record\");\n   289\t  }\n   290\t  // Edit, delete, and the pending-state reads run in one microtask cascade\n   291\t  // (see module header): the snapshot is taken before the poked background\n   292\t  // drain starts its first pass.\n   293\t  const edit = await sdk.messages.edit(ref, {\n   294\t    messageId: editTarget.messageId,\n   295\t    content: EDITED_MESSAGE_TEXT,\n   296\t  });\n   297\t  expectOk(edit, \"mutate.edit\");\n   298\t  const deleted = await sdk.messages.deleteMessage(ref, { messageId: deleteTarget.messageId });\n   299\t  expectOk(deleted, \"mutate.delete\");\n   300\t  const mutate: LifecyclePhases[\"mutate\"] = {\n   301\t    editedMessageId: editTarget.messageId,\n   302\t    deletedMessageId: deleteTarget.messageId,\n   303\t    edit,\n   304\t    delete: deleted,\n   305\t    healthAfterMutate: await sdk.inspect.health(ref),\n   306\t    messagesNotReady: await sdk.messages.report(ref, { notReady: true }),\n   307\t    turnsNotReady: await sdk.turns.report(ref, { notReady: true }),\n   308\t  };\n   309\t  expectOk(mutate.healthAfterMutate, \"mutate.health\");\n   310\t  expectOk(mutate.messagesNotReady, \"mutate.messagesNotReady\");\n   311\t  expectOk(mutate.turnsNotReady, \"mutate.turnsNotReady\");\n   312\t\n   313\t  // Rebuild drains: the mutations' pokes already scheduled the cascade\n   314\t  // rebuilds on THIS instance's scheduler; settle is the production await.\n   315\t  await sdk.drainSettled(ref);\n   316\t  const rebuild = { settled: true } as const;\n   317\t\n   318\t  const health2 = await sdk.inspect.health(ref);\n   319\t  expectOk(health2, \"health2\");\n   320\t  await checkpoint(\"health2\");\n   321\t\n   322\t  // ── group 4: compact2 → pull2 → materialize ──\n   323\t  nextGroup();\n   324\t  const compact2 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\n   325\t  expectOk(compact2, \"compact2\");\n   326\t  const pull2 = await sdk.threadView.pull(ref);\n   327\t  expectOk(pull2, \"pull2\");\n   328\t  const materialize = await sdk.threadView.materialize(ref, { path: outPath });\n   329\t  expectOk(materialize, \"materialize\");\n   330\t  await checkpoint(\"materialize\");\n   331\t\n   332\t  return {\n   333\t    filePath,\n   334\t    outPath,\n   335\t    threadId,\n   336\t    phases: {\n   337\t      create,\n   338\t      intake,\n   339\t      drain,\n   340\t      status,\n   341\t      compact1,\n   342\t      pull1,\n   343\t      inspect1,\n   344\t      mutate,\n   345\t      rebuild,\n   346\t      health2,\n   347\t      compact2,\n   348\t      pull2,\n   349\t      materialize,\n   350\t    },\n   351\t  };\n   352\t}\n","exit_code":0,"status":"completed"}}

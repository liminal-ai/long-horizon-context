{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/cli-process-inspect.test.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Story 1 (Epic 04), process-boundary suite: TC-3.4 — `lhc messages list`\n     2\t// and `lhc messages show` through the spawned dist/cli.js have full JSON\n     3\t// parity with the in-process SDK operations: same options, same result JSON,\n     4\t// refusals included. Reads are non-mutating, so one fixture thread serves\n     5\t// both sides — the spawned output deep-equals the SDK result on the same\n     6\t// file (the production-path proof: cli/messages-read.ts routes to the SDK,\n     7\t// any divergence is a bypass). Reads need no provider; the binary runs with\n     8\t// LHC_PROVIDER unset. Runs under verify-all only (LHC_PROCESS_SUITE=1).\n     9\t// TC-5.4's checkpoint parity joins this file in Story 4.\n    10\timport { spawnSync } from \"node:child_process\";\n    11\timport { mkdtempSync, rmSync } from \"node:fs\";\n    12\timport { tmpdir } from \"node:os\";\n    13\timport path from \"node:path\";\n    14\timport { fileURLToPath } from \"node:url\";\n    15\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    16\timport {\n    17\t  createSdk,\n    18\t  messages,\n    19\t  resolveNamedProvider,\n    20\t  threads,\n    21\t  type MessageListOptions,\n    22\t} from \"../src/index.js\";\n    23\timport {\n    24\t  runLifecycle,\n    25\t  tempStore,\n    26\t  validEvent,\n    27\t  type LifecycleCheckpoint,\n    28\t} from \"./fixtures/index.js\";\n    29\t\n    30\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n    31\tconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\n    32\t\n    33\tfunction runBinary(args: string[]): { status: number | null; stdout: string; stderr: string } {\n    34\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    35\t    encoding: \"utf8\",\n    36\t    env: { ...process.env, LHC_PROVIDER: undefined },\n    37\t  });\n    38\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n    39\t}\n    40\t\n    41\tlet dir: string;\n    42\tbeforeEach(() => {\n    43\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-inspect-\"));\n    44\t});\n    45\tafterEach(() => {\n    46\t  rmSync(dir, { recursive: true, force: true });\n    47\t});\n    48\t\n    49\t// Two closed turns (m1 prompt, m2 text, m3 call, m4 result; m6 prompt,\n    50\t// m7 text), drained in-process against the registry's deterministic\n    51\t// provider, then m2 deleted — so the parity sweep covers live, bounded,\n    52\t// deleted-included, and deleted-shown reads on one record.\n    53\tasync function seedThread(): Promise<string> {\n    54\t  const filePath = path.join(dir, \"inspect-parity.sqlite\");\n    55\t  const created = await threads.newThread({\n    56\t    filePath,\n    57\t    registryPath: path.join(dir, \"registry.sqlite\"),\n    58\t  });\n    59\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    60\t  const provider = resolveNamedProvider(\"deterministic\");\n    61\t  if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n    62\t  const sdk = createSdk({ provider, mode: \"manual\" });\n    63\t  const batches = [\n    64\t    [\n    65\t      validEvent(\"user_prompt\", { payload: { text: \"please read notes.txt\" } }),\n    66\t      validEvent(\"assistant_text\", { payload: { text: \"reading it now\" } }),\n    67\t      validEvent(\"tool_call\", {\n    68\t        payload: {\n    69\t          toolCallId: \"call-parity-1\",\n    70\t          toolName: \"read_file\",\n    71\t          arguments: { path: \"notes.txt\" },\n    72\t        },\n    73\t      }),\n    74\t      validEvent(\"tool_result\", {\n    75\t        payload: {\n    76\t          toolCallId: \"call-parity-1\",\n    77\t          content: \"contents of notes.txt: full parity-fixture tool output\",\n    78\t          isError: false,\n    79\t        },\n    80\t      }),\n    81\t      validEvent(\"turn_end\"),\n    82\t    ],\n    83\t    [\n    84\t      validEvent(\"user_prompt\", { payload: { text: \"summarize what you read\" } }),\n    85\t      validEvent(\"assistant_text\", { payload: { text: \"here is the summary\" } }),\n    86\t      validEvent(\"turn_end\"),\n    87\t    ],\n    88\t  ];\n    89\t  for (const batch of batches) {\n    90\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    91\t    if (!sent.ok) throw new Error(`fixture batch failed: ${sent.error.reason}`);\n    92\t  }\n    93\t  const drained = await sdk.work.drain({ filePath });\n    94\t  if (!drained.ok || drained.value.remaining !== 0) {\n    95\t    throw new Error(\"fixture drain did not settle\");\n    96\t  }\n    97\t  const deleted = await messages.deleteMessage({ filePath }, { messageId: \"m2\" });\n    98\t  if (!deleted.ok) throw new Error(`fixture delete failed: ${deleted.error.reason}`);\n    99\t  return filePath;\n   100\t}\n   101\t\n   102\tdescribe(\"TC-3.4 / AC-3.4: spawned-CLI message list/show parity with the SDK\", () => {\n   103\t  it(\"messages list mirrors the SDK across default, bounded, include-deleted, and refused options\", async () => {\n   104\t    const filePath = await seedThread();\n   105\t    const cases: Array<{ args: string[]; opts: MessageListOptions; ok: boolean }> = [\n   106\t      { args: [], opts: {}, ok: true },\n   107\t      { args: [\"--from\", \"2\", \"--to\", \"4\"], opts: { from: 2, to: 4 }, ok: true },\n   108\t      { args: [\"--limit\", \"2\"], opts: { limit: 2 }, ok: true },\n   109\t      { args: [\"--include-deleted\"], opts: { includeDeleted: true }, ok: true },\n   110\t      {\n   111\t        args: [\"--from\", \"3\", \"--limit\", \"2\", \"--include-deleted\"],\n   112\t        opts: { from: 3, limit: 2, includeDeleted: true },\n   113\t        ok: true,\n   114\t      },\n   115\t      // The refusal leg: bad bounds carry the same structured error through\n   116\t      // the process boundary, exit 1.\n   117\t      { args: [\"--from\", \"5\", \"--to\", \"2\"], opts: { from: 5, to: 2 }, ok: false },\n   118\t    ];\n   119\t    for (const parity of cases) {\n   120\t      const viaSdk = await messages.listMessages({ filePath }, parity.opts);\n   121\t      expect(viaSdk.ok).toBe(parity.ok);\n   122\t      const viaCli = runBinary([\"messages\", \"list\", \"--file-path\", filePath, ...parity.args]);\n   123\t      expect(viaCli.status).toBe(parity.ok ? 0 : 1);\n   124\t      expect(JSON.parse(viaCli.stdout)).toEqual(viaSdk);\n   125\t    }\n   126\t    // Six serial dist/cli.js spawns push past Vitest's 5000ms default on a\n   127\t    // loaded machine; the explicit budget keeps the configured verify-all gate\n   128\t    // stable (SV-01-003), matching the other process-suite spawn tests.\n   129\t  }, 30000);\n   130\t\n   131\t  it(\"messages show mirrors the SDK for live, deleted, and missing targets\", async () => {\n   132\t    const filePath = await seedThread();\n   133\t    for (const messageId of [\n   134\t      \"m4\", // live drained tool result, forms attached\n   135\t      \"m2\", // deleted: ok + flag — the audit read\n   136\t      \"m99\", // missing: message_not_found, exit 1\n   137\t    ]) {\n   138\t      const viaSdk = await messages.show({ filePath }, messageId);\n   139\t      const viaCli = runBinary([\n   140\t        \"messages\",\n   141\t        \"show\",\n   142\t        \"--file-path\",\n   143\t        filePath,\n   144\t        \"--message-id\",\n   145\t        messageId,\n   146\t      ]);\n   147\t      expect(viaCli.status).toBe(viaSdk.ok ? 0 : 1);\n   148\t      expect(JSON.parse(viaCli.stdout)).toEqual(viaSdk);\n   149\t    }\n   150\t    // The deleted target succeeds with the flag; the missing one refuses —\n   151\t    // pinned here so the loop's parity can't both-sides-drift.\n   152\t    const deletedShown = await messages.show({ filePath }, \"m2\");\n   153\t    expect(deletedShown.ok).toBe(true);\n   154\t    if (deletedShown.ok) expect(deletedShown.value.deleted).toBe(true);\n   155\t    const missing = await messages.show({ filePath }, \"m99\");\n   156\t    expect(missing.ok).toBe(false);\n   157\t    if (!missing.ok) expect(missing.error.code).toBe(\"message_not_found\");\n   158\t    // Same spawn-cost budget as the list leg, for the same gate-stability\n   159\t    // reason (SV-01-003).\n   160\t  }, 30000);\n   161\t});\n   162\t\n   163\tdescribe(\"TC-5.4 / AC-5.5: spawned-CLI checkpoint parity along the lifecycle\", () => {\n   164\t  it(\"spawned overview/view/list reads at three lifecycle checkpoints deep-equal the in-process results\", async () => {\n   165\t    // The SAME scripted sequence the default-suite legs drive\n   166\t    // (test/fixtures/lifecycle.ts, DD-8): the operator's spawned reads probe\n   167\t    // it at the three read checkpoints — post-compact (inspect1),\n   168\t    // post-rebuild (health2), and final (materialize) — and must return the\n   169\t    // same JSON as the in-process SDK calls at that exact state. Reads need\n   170\t    // no provider; the binary runs with LHC_PROVIDER unset. Parity is the\n   171\t    // production-path proof: cli/inspect.ts and cli/messages-read.ts route\n   172\t    // argv to the same surfaces, so any divergence is a bypass.\n   173\t    const store = tempStore();\n   174\t    const visited: LifecycleCheckpoint[] = [];\n   175\t    try {\n   176\t      await runLifecycle(store, {\n   177\t        name: \"cli-parity\",\n   178\t        onCheckpoint: async (checkpoint, { sdk, filePath }) => {\n   179\t          visited.push(checkpoint);\n   180\t          const inProcess = {\n   181\t            overview: await sdk.inspect.overview({ filePath }),\n   182\t            view: await sdk.inspect.view({ filePath }),\n   183\t            list: await sdk.messages.listMessages({ filePath }),\n   184\t          };\n   185\t          const spawned = {\n   186\t            overview: runBinary([\"inspect\", \"overview\", \"--file-path\", filePath]),\n   187\t            view: runBinary([\"inspect\", \"view\", \"--file-path\", filePath]),\n   188\t            list: runBinary([\"messages\", \"list\", \"--file-path\", filePath]),\n   189\t          };\n   190\t          for (const surface of [\"overview\", \"view\", \"list\"] as const) {\n   191\t            expect(spawned[surface].status, `${surface} at ${checkpoint}`).toBe(0);\n   192\t            expect(\n   193\t              JSON.parse(spawned[surface].stdout),\n   194\t              `${surface} at ${checkpoint}`,\n   195\t            ).toEqual(inProcess[surface]);\n   196\t          }\n   197\t        },\n   198\t      });\n   199\t    } finally {\n   200\t      store.cleanup();\n   201\t    }\n   202\t    // The checkpoints actually fired — a sequence change can never skip the\n   203\t    // parity probes silently (anti-shim: the process leg reports ran).\n   204\t    expect(visited).toEqual([\"inspect1\", \"health2\", \"materialize\"]);\n   205\t    // Nine serial dist/cli.js spawns plus the full scripted lifecycle: the\n   206\t    // same explicit budget rationale as the other process legs (SV-01-003),\n   207\t    // sized up for the spawn count.\n   208\t  }, 60000);\n   209\t});\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/sdk.ts | sed -n '250,430p'\"","aggregated_output":"   250\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n   251\t  work: WorkSurface;\n   252\t  // Resolves when the scheduler has no running or pending drain for the\n   253\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n   254\t  // resolve in manual mode.\n   255\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n   256\t}\n   257\t\n   258\tfunction requirePositive(value: number, name: string): void {\n   259\t  if (!Number.isFinite(value) || value <= 0) {\n   260\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n   261\t  }\n   262\t}\n   263\t\n   264\tfunction requireNonNegative(value: number, name: string): void {\n   265\t  if (!Number.isFinite(value) || value < 0) {\n   266\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n   267\t  }\n   268\t}\n   269\t\n   270\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n   271\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n   272\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n   273\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n   274\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n   275\t// object is the same shape as the namespace, so the public surface type holds.\n   276\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n   277\t  const scoped: Record<string, unknown> = {};\n   278\t  for (const key of Object.keys(surface)) {\n   279\t    const value = (surface as Record<string, unknown>)[key];\n   280\t    scoped[key] =\n   281\t      typeof value === \"function\"\n   282\t        ? (...args: unknown[]): unknown =>\n   283\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n   284\t        : value;\n   285\t  }\n   286\t  return scoped as T;\n   287\t}\n   288\t\n   289\t// The only assembly path: provider, mode, clock, and policy enter here.\n   290\t// Config mistakes are programmer errors at construction and throw; operating\n   291\t// failures after construction return OpResults per the error contract.\n   292\texport function createSdk(config: SdkConfig): Lhc {\n   293\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   294\t    throw new TypeError(\n   295\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   296\t    );\n   297\t  }\n   298\t  if (config.provider === null || typeof config.provider !== \"object\") {\n   299\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   300\t  }\n   301\t  for (const operation of PROVIDER_OPERATIONS) {\n   302\t    if (typeof config.provider[operation] !== \"function\") {\n   303\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   304\t    }\n   305\t  }\n   306\t\n   307\t  const resolved: ResolvedSdkConfig = {\n   308\t    provider: config.provider,\n   309\t    mode: config.mode,\n   310\t    clock: config.clock ?? (() => new Date()),\n   311\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   312\t    lease: config.lease ?? { durationMs: 120000 },\n   313\t    chunkPolicy:\n   314\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n   315\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n   316\t    // sums and visibility budgets validated — throws naming the violation.\n   317\t    view: resolveViewConfig(config.view),\n   318\t  };\n   319\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n   320\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n   321\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n   322\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n   323\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n   324\t  }\n   325\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n   326\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n   327\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n   328\t    throw new TypeError(\n   329\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n   330\t    );\n   331\t  }\n   332\t\n   333\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n   334\t  // The tables are empty until Stories 2–3 land the real handlers; the\n   335\t  // assembly mechanics are production code from day one.\n   336\t  const workHandlers = assembleWorkHandlerMap([\n   337\t    messagesDomain.workHandlers,\n   338\t    turnsDomain.workHandlers,\n   339\t  ]);\n   340\t\n   341\t  const drainDeps: DrainDeps = {\n   342\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   343\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n   344\t    config: resolved,\n   345\t  };\n   346\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n   347\t\n   348\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n   349\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n   350\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n   351\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n   352\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n   353\t  // the construction order, because its operations deliver to the no-op seam,\n   354\t  // not to whatever a background SDK installed below.\n   355\t  // The seam also carries this instance's resolved view config (Epic 03,\n   356\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n   357\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n   358\t  // fall back to the built-in defaults inside the thread-view surface.\n   359\t  const seam: InstanceSeam =\n   360\t    resolved.mode === \"background\"\n   361\t      ? {\n   362\t          poke: (threadId) => scheduler.poke(threadId),\n   363\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n   364\t          view: resolved.view,\n   365\t        }\n   366\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\n   367\t\n   368\t  // Background mode also installs the below-SDK default seam so a direct\n   369\t  // domain call made with no SDK scope — a top-level mutation in the\n   370\t  // single-background \"production path\" — still reaches the one installed\n   371\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n   372\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n   373\t  // leaves the default alone (pokes stay no-ops by contract).\n   374\t  if (resolved.mode === \"background\") {\n   375\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n   376\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n   377\t  }\n   378\t\n   379\t  const work: WorkSurface = {\n   380\t    drain: (ref, opts) =>\n   381\t      runWithInstanceSeam(seam, async () => {\n   382\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   383\t        if (!resolvedRef.ok) return resolvedRef;\n   384\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n   385\t      }),\n   386\t  };\n   387\t\n   388\t  return {\n   389\t    threads: threadsDomain,\n   390\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n   391\t    messages: scopeSurface(messagesDomain, seam),\n   392\t    turns: scopeSurface(turnsDomain, seam),\n   393\t    threadView: scopeSurface<ThreadViewSurface>(\n   394\t      {\n   395\t        pull: threadViewDomain.pull,\n   396\t        status: threadViewDomain.status,\n   397\t        describe: threadViewDomain.describe,\n   398\t        compact: threadViewDomain.compact,\n   399\t        sweep: threadViewDomain.sweep,\n   400\t        materialize: threadViewDomain.materialize,\n   401\t      },\n   402\t      seam,\n   403\t    ),\n   404\t    inspect: scopeSurface(inspectDomain, seam),\n   405\t    config: resolved,\n   406\t    scheduler,\n   407\t    workHandlers,\n   408\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   409\t    work,\n   410\t    drainSettled: async (ref) => {\n   411\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   412\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n   413\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n   414\t      if (threadId === null) return;\n   415\t      return scheduler.drainSettled(threadId);\n   416\t    },\n   417\t  };\n   418\t}\n","exit_code":0,"status":"completed"}}

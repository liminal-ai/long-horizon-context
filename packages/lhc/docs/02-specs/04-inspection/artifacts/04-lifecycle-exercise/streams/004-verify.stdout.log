{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/providers/deterministic.ts | sed -n '1,140p'\"","aggregated_output":"     1\t// The deterministic provider: marked, input-derived output for every seam\n     2\t// operation — `<marker>(<digest>:<prefix>)` where digest and prefix are pure\n     3\t// functions of the input. It backs the named-provider registry's\n     4\t// \"deterministic\" entry (DD-11) so spawned-CLI tests exercise the production\n     5\t// resolution seam, and the test double reuses these helpers so in-process and\n     6\t// spawned runs produce byte-identical artifacts. It is selectable only by\n     7\t// explicit name — never a production default.\n     8\timport type {\n     9\t  DerivationProvider,\n    10\t  ProviderResult,\n    11\t  RenderingPart,\n    12\t  ToolOutcome,\n    13\t  ToolRunReceipt,\n    14\t} from \"../shared/derivation.js\";\n    15\t\n    16\texport type DeterministicOpName =\n    17\t  | \"smoothPrompt\"\n    18\t  | \"summarizeToolCall\"\n    19\t  | \"summarizeToolResult\"\n    20\t  | \"composeTurnRendering\"\n    21\t  | \"projectLowerBand\"\n    22\t  | \"summarizeChunkDetailed\"\n    23\t  | \"summarizeChunkBrief\";\n    24\t\n    25\texport const DETERMINISTIC_MARKERS: Record<DeterministicOpName, string> = {\n    26\t  smoothPrompt: \"smoothed\",\n    27\t  summarizeToolCall: \"toolcall\",\n    28\t  summarizeToolResult: \"toolresult\",\n    29\t  composeTurnRendering: \"rendering\",\n    30\t  projectLowerBand: \"projection\",\n    31\t  summarizeChunkDetailed: \"detailed\",\n    32\t  summarizeChunkBrief: \"brief\",\n    33\t};\n    34\t\n    35\t// FNV-1a 32-bit over the canonical input JSON: stable, dependency-free, and\n    36\t// input-sensitive enough that distinct inputs mark distinct outputs.\n    37\texport function deterministicDigest(input: unknown): string {\n    38\t  const text = JSON.stringify(input);\n    39\t  let hash = 0x811c9dc5;\n    40\t  for (let i = 0; i < text.length; i += 1) {\n    41\t    hash ^= text.charCodeAt(i);\n    42\t    hash = Math.imul(hash, 0x01000193) >>> 0;\n    43\t  }\n    44\t  return hash.toString(16).padStart(8, \"0\");\n    45\t}\n    46\t\n    47\texport function deterministicText(\n    48\t  op: DeterministicOpName,\n    49\t  input: unknown,\n    50\t  text: string,\n    51\t): string {\n    52\t  return `${DETERMINISTIC_MARKERS[op]}(${deterministicDigest(input)}:${text.slice(0, 40)})`;\n    53\t}\n    54\t\n    55\tfunction ok(op: DeterministicOpName, input: unknown, text: string): Promise<ProviderResult> {\n    56\t  return Promise.resolve({ ok: true, text: deterministicText(op, input, text) });\n    57\t}\n    58\t\n    59\t// The chunk-summary contract made visible in deterministic output (AC-3.8):\n    60\t// the detailed summary's artifact carries the members' tool-run receipts —\n    61\t// account and outcome — verbatim; the brief summary's carries outcomes\n    62\t// only. Pure suffixes over the input fields, shared with the test double so\n    63\t// in-process and spawned artifacts stay byte-identical; empty receipt sets\n    64\t// add nothing, keeping receipt-less output unchanged.\n    65\texport function deterministicReceiptsSuffix(memberReceipts?: ToolRunReceipt[][]): string {\n    66\t  const receipts = (memberReceipts ?? []).flat();\n    67\t  if (receipts.length === 0) return \"\";\n    68\t  return `[receipts ${receipts.map((r) => `${r.account}=>${r.outcome}`).join(\"; \")}]`;\n    69\t}\n    70\t\n    71\texport function deterministicOutcomesSuffix(memberOutcomes?: ToolOutcome[][]): string {\n    72\t  const outcomes = (memberOutcomes ?? []).flat();\n    73\t  if (outcomes.length === 0) return \"\";\n    74\t  return `[outcomes ${outcomes.join(\",\")}]`;\n    75\t}\n    76\t\n    77\texport function createDeterministicProvider(): DerivationProvider {\n    78\t  return {\n    79\t    smoothPrompt: (i: { text: string }) => ok(\"smoothPrompt\", i, i.text),\n    80\t    summarizeToolCall: (i: {\n    81\t      toolName: string;\n    82\t      argsJson: string;\n    83\t      pairedResult?: { content: string; isError: boolean };\n    84\t    }) => ok(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`),\n    85\t    summarizeToolResult: (i: { toolName: string; content: string }) =>\n    86\t      ok(\"summarizeToolResult\", i, i.content),\n    87\t    composeTurnRendering: (i: { parts: RenderingPart[] }) =>\n    88\t      ok(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \")),\n    89\t    projectLowerBand: (i: { rendering: string }) => ok(\"projectLowerBand\", i, i.rendering),\n    90\t    summarizeChunkDetailed: async (i: {\n    91\t      memberProjections: string[];\n    92\t      memberReceipts?: ToolRunReceipt[][];\n    93\t    }) => {\n    94\t      const base = await ok(\"summarizeChunkDetailed\", i, i.memberProjections.join(\" | \"));\n    95\t      if (!base.ok) return base;\n    96\t      return { ok: true, text: base.text + deterministicReceiptsSuffix(i.memberReceipts) };\n    97\t    },\n    98\t    summarizeChunkBrief: async (i: {\n    99\t      memberProjections: string[];\n   100\t      memberOutcomes?: ToolOutcome[][];\n   101\t    }) => {\n   102\t      const base = await ok(\"summarizeChunkBrief\", i, i.memberProjections.join(\" | \"));\n   103\t      if (!base.ok) return base;\n   104\t      return { ok: true, text: base.text + deterministicOutcomesSuffix(i.memberOutcomes) };\n   105\t    },\n   106\t  };\n   107\t}\n","exit_code":0,"status":"completed"}}

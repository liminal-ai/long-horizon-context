{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/providers/registry.ts | sed -n '1,120p'\"","aggregated_output":"     1\t// The named-provider registry (DD-11). SDK hosts inject a provider at\n     2\t// createSdk; the CLI — which has no construction step — resolves one here\n     3\t// from `--provider <name>` or LHC_PROVIDER. No default: a provider-needing\n     4\t// command without a resolvable name fails with provider_not_configured,\n     5\t// never a silent no-op.\n     6\timport type { DerivationProvider } from \"../shared/derivation.js\";\n     7\timport { createDeterministicProvider } from \"./deterministic.js\";\n     8\t\n     9\tconst REGISTRY: Record<string, () => DerivationProvider> = {\n    10\t  deterministic: createDeterministicProvider,\n    11\t};\n    12\t\n    13\texport function resolveNamedProvider(name: string): DerivationProvider | undefined {\n    14\t  return REGISTRY[name]?.();\n    15\t}\n    16\t\n    17\texport function registeredProviderNames(): string[] {\n    18\t  return Object.keys(REGISTRY);\n    19\t}\n","exit_code":0,"status":"completed"}}

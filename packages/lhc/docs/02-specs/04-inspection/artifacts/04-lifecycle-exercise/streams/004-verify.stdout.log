{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/index.ts | sed -n '560,650p'\"","aggregated_output":"   560\t// runs at flush in BOTH host modes — unlike the queue poke it is cheap and\n   561\t// deterministic, and a CLI intake must advance too or CLI-driven threads\n   562\t// bloat. Budgets resolve through the per-instance seam exactly as the poke\n   563\t// does (the flush runs synchronously inside the SDK operation's seam scope),\n   564\t// falling back to the built-in defaults for direct domain calls.\n   565\t//\n   566\t// Synchronous and throw-permitted by contract: the registering site wraps it\n   567\t// (catch + diagnose) so a failure never reaches intake's caller and never\n   568\t// eats the queue poke; the boundary is then simply unchanged and the\n   569\t// over-budget condition stays visible because status computes the same zone\n   570\t// sum live (AC-4.9).\n   571\texport function runPostCommitBoundaryAdvance(ctx: OperationContext): void {\n   572\t  // Story-0 injection point (TC-4.6): fired before the advance computes; an\n   573\t  // installed hook's throw stands in for an advance failure.\n   574\t  fireViewInjection(\"post-commit-advance\");\n   575\t  executeBoundaryAdvance(ctx.db, viewConfig().visibility, ctx.clock);\n   576\t}\n   577\t\n   578\t// ── materialize (Flow 5: AC-5.2–5.5) ─────────────────────────────\n   579\t\n   580\t// PI session-file materialization: run the pull assembly internally, hand\n   581\t// the same entry array to the JSONL writer, return the written path. No\n   582\t// thread state changes (reads + a file write outside the thread file), and\n   583\t// every generated field derives from view/record metadata, never write-time\n   584\t// clocks — repeating after no thread changes produces a byte-identical file\n   585\t// (AC-5.2). Parity with pull is by construction: one assembly, two shapes\n   586\t// (AC-5.3). A never-compacted thread materializes its tail-only pull with\n   587\t// the header timestamp from the thread's created-at (AC-5.4). Like pull,\n   588\t// the whole operation runs touch-suppressed: a background SDK's materialize\n   589\t// can never schedule a catch-up drain.\n   590\texport async function materialize(\n   591\t  ref: ThreadRef,\n   592\t  opts: { path: string; format?: \"pi-session\" },\n   593\t): Promise<OpResult<{ writtenPath: string }>> {\n   594\t  return runWithThreadTouchSuppressed(() => materializeInner(ref, opts));\n   595\t}\n   596\t\n   597\tasync function materializeInner(\n   598\t  ref: ThreadRef,\n   599\t  opts: { path: string; format?: \"pi-session\" },\n   600\t): Promise<OpResult<{ writtenPath: string }>> {\n   601\t  const format = opts.format ?? \"pi-session\";\n   602\t  if (format !== \"pi-session\") {\n   603\t    return {\n   604\t      ok: false,\n   605\t      error: {\n   606\t        errorClass: \"caller_error\",\n   607\t        code: \"unknown_format\",\n   608\t        reason: `unknown materialize format \"${String(format)}\"; accepted formats are \"pi-session\"`,\n   609\t      },\n   610\t    };\n   611\t  }\n   612\t  const resolved = await resolveThreadRef(ref);\n   613\t  if (!resolved.ok) return resolved;\n   614\t  const { filePath } = resolved.value;\n   615\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   616\t\n   617\t  const opened = openThreadDatabase(filePath);\n   618\t  if (!opened.ok) return opened;\n   619\t  const db = opened.value;\n   620\t  let input: MaterializeInput;\n   621\t  try {\n   622\t    const assembled = assembleView(db);\n   623\t    const threadMeta = readThreadMetadata(db);\n   624\t    input = {\n   625\t      threadId: threadMeta.threadId,\n   626\t      headerTimestamp: assembled.snapshot?.createdAt ?? threadMeta.createdAt,\n   627\t      // Deterministic per thread file — never the writing process's cwd.\n   628\t      cwd: path.dirname(path.resolve(filePath)),\n   629\t      entries: assembled.entries,\n   630\t    };\n   631\t  } catch (cause) {\n   632\t    return storageFailure(`view materialize failed: ${detail(cause)}`);\n   633\t  } finally {\n   634\t    db.close();\n   635\t  }\n   636\t  try {\n   637\t    return { ok: true, value: writePiSessionFile(input, opts.path) };\n   638\t  } catch (cause) {\n   639\t    return storageFailure(\n   640\t      `view materialize could not write ${opts.path}: ${detail(cause)}`,\n   641\t    );\n   642\t  }\n   643\t}\n   644\t\n   645\t// ── Story 0 substrate (consumed by createSdk at construction) ─────\n   646\texport {\n   647\t  BUILT_IN_PROFILES,\n   648\t  DEFAULT_COMPACT_THRESHOLD,\n   649\t  DEFAULT_VISIBILITY,\n   650\t  resolveViewConfig,\n","exit_code":0,"status":"completed"}}

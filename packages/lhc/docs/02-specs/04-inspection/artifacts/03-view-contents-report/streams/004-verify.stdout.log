<OpResult<SweepReceipt>> {\\n   542\\t  const resolved = await resolveThreadRef(ref);\\n   543\\t  if (!resolved.ok) return resolved;\\n   544\\t  const { filePath } = resolved.value;\\n   545\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   546\\t  try {\\n   547\\t    return await runSweep(filePath);\\n   548\\t  } catch (cause) {\\n   549\\t    return storageFailure(`view sweep failed: ${detail(cause)}`);\\n   550\\t  }\\n   551\\t}\\n   552\\t\\n   553\\t// ── boundary advance (Flow 4: AC-4.3–4.6, 4.9) ───────────────────\\n   554\\t\\n   555\\t// The post-commit advance, Story 4. NOT a host operation: no public advance\\n   556\\t// surface exists (story Anti-Shim Requirements) — the SDK's ThreadViewSurface\\n   557\\t// carries only the five operations, and this function's one production caller\\n   558\\t// is intake-stream's ctx.onCommit registration (the sanctioned\\n   559\\t// intake→thread-view surface import, tech design §Module Boundaries). It\\n   560\\t// runs at flush in BOTH host modes — unlike the queue poke it is cheap and\\n   561\\t// deterministic, and a CLI intake must advance too or CLI-driven threads\\n   562\\t// bloat. Budgets resolve through the per-instance seam exactly as the poke\\n   563\\t// does (the flush runs synchronously inside the SDK operation's seam scope),\\n   564\\t// falling back to the built-in defaults for direct domain calls.\\n   565\\t//\\n   566\\t// Synchronous and throw-permitted by contract: the registering site wraps it\\n   567\\t// (catch + diagnose) so a failure never reaches intake's caller and never\\n   568\\t// eats the queue poke; the boundary is then simply unchanged and the\\n   569\\t// over-budget condition stays visible because status computes the same zone\\n   570\\t// sum live (AC-4.9).\\n   571\\texport function runPostCommitBoundaryAdvance(ctx: OperationContext): void {\\n   572\\t  // Story-0 injection point (TC-4.6): fired before the advance computes; an\\n   573\\t  // installed hook's throw stands in for an advance failure.\\n   574\\t  fireViewInjection(\\\"post-commit-advance\\\");\\n   575\\t  executeBoundaryAdvance(ctx.db, viewConfig().visibility, ctx.clock);\\n   576\\t}\\n   577\\t\\n   578\\t// ── materialize (Flow 5: AC-5.2–5.5) ─────────────────────────────\\n   579\\t\\n   580\\t// PI session-file materialization: run the pull assembly internally, hand\\n   581\\t// the same entry array to the JSONL writer, return the written path. No\\n   582\\t// thread state changes (reads + a file write outside the thread file), and\\n   583\\t// every generated field derives from view/record metadata, never write-time\\n   584\\t// clocks — repeating after no thread changes produces a byte-identical file\\n   585\\t// (AC-5.2). Parity with pull is by construction: one assembly, two shapes\\n   586\\t// (AC-5.3). A never-compacted thread materializes its tail-only pull with\\n   587\\t// the header timestamp from the thread's created-at (AC-5.4). Like pull,\\n   588\\t// the whole operation runs touch-suppressed: a background SDK's materialize\\n   589\\t// can never schedule a catch-up drain.\\n   590\\texport async function materialize(\\n   591\\t  ref: ThreadRef,\\n   592\\t  opts: { path: string; format?: \\\"pi-session\\\" },\\n   593\\t): Promise<OpResult<{ writtenPath: string }>> {\\n   594\\t  return runWithThreadTouchSuppressed(() => materializeInner(ref, opts));\\n   595\\t}\\n   596\\t\\n   597\\tasync function materializeInner(\\n   598\\t  ref: ThreadRef,\\n   599\\t  opts: { path: string; format?: \\\"pi-session\\\" },\\n   600\\t): Promise<OpResult<{ writtenPath: string }>> {\\n   601\\t  const format = opts.format ?? \\\"pi-session\\\";\\n   602\\t  if (format !== \\\"pi-session\\\") {\\n   603\\t    return {\\n   604\\t      ok: false,\\n   605\\t      error: {\\n   606\\t        errorClass: \\\"caller_error\\\",\\n   607\\t        code: \\\"unknown_format\\\",\\n   608\\t        reason: `unknown materialize format \\\"${String(format)}\\\"; accepted formats are \\\"pi-session\\\"`,\\n   609\\t      },\\n   610\\t    };\\n   611\\t  }\\n   612\\t  const resolved = await resolveThreadRef(ref);\\n   613\\t  if (!resolved.ok) return resolved;\\n   614\\t  const { filePath } = resolved.value;\\n   615\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   616\\t\\n   617\\t  const opened = openThreadDatabase(filePath);\\n   618\\t  if (!opened.ok) return opened;\\n   619\\t  const db = opened.value;\\n   620\\t  let input: MaterializeInput;\\n   621\\t  try {\\n   622\\t    const assembled = assembleView(db);\\n   623\\t    const threadMeta = readThreadMetadata(db);\\n   624\\t    input = {\\n   625\\t      threadId: threadMeta.threadId,\\n   626\\t      headerTimestamp: assembled.snapshot?.createdAt ?? threadMeta.createdAt,\\n   627\\t      // Deterministic per thread file — never the writing process's cwd.\\n   628\\t      cwd: path.dirname(path.resolve(filePath)),\\n   629\\t      entries: assembled.entries,\\n   630\\t    };\\n   631\\t  } catch (cause) {\\n   632\\t    return storageFailure(`view materialize failed: ${detail(cause)}`);\\n   633\\t  } finally {\\n   634\\t    db.close();\\n   635\\t  }\\n   636\\t  try {\\n   637\\t    return { ok: true, value: writePiSessionFile(input, opts.path) };\\n   638\\t  } catch (cause) {\\n   639\\t    return storageFailure(\\n   640\\t      `view materialize could not write ${opts.path}: ${detail(cause)}`,\\n   641\\t    );\\n   642\\t  }\\n   643\\t}\\n   644\\t\\n   645\\t// ── Story 0 substrate (consumed by createSdk at construction) ─────\\n   646\\texport {\\n   647\\t  BUILT_IN_PROFILES,\\n   648\\t  DEFAULT_COMPACT_THRESHOLD,\\n   649\\t  DEFAULT_VISIBILITY,\\n   650\\t  resolveViewConfig,\\n   651\\t} from \\\"./internal/profiles.js\\\";\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_10\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/internal/snapshot.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"     1\\t// The pull's read path (Story 1): the stored view snapshot — header plus\\n     2\\t// band rows, absent ⇒ tail-only signal — and the record reads the tail\\n     3\\t// assembly needs (live messages after the compact point, their ready\\n     4\\t// tool-result summaries, the tail token sum). Story 2 adds the one writer:\\n     5\\t// the atomic replace at compact. Direct record/derived_form reads are\\n     6\\t// sanctioned for thread-view internals (tech design §System View — the\\n     7\\t// surface-import rule governs code imports, not SQL); what must NOT read\\n     8\\t// derived_form directly is the status's derivation counting, which goes\\n     9\\t// through the owners' report surfaces in index.ts.\\n    10\\timport type { DatabaseSync } from \\\"node:sqlite\\\";\\n    11\\timport type { Band, StoredView } from \\\"../../../shared/view.js\\\";\\n    12\\timport type { RenderingPartKind } from \\\"../../../shared/derivation.js\\\";\\n    13\\t\\n    14\\t// ── view snapshot (header + bands) ────────────────────────────────\\n    15\\t\\n    16\\texport interface ViewSnapshot {\\n    17\\t  viewId: string;\\n    18\\t  createdAt: string;\\n    19\\t  compactPoint: number;\\n    20\\t  coveredFrom: number;\\n    21\\t  gapCount: number;\\n    22\\t  degradedCount: number;\\n    23\\t  // Non-empty bands in gradient order (brief → detailed → smooth), the order\\n    24\\t  // the pull prepends them in.\\n    25\\t  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\\n    26\\t}\\n    27\\t\\n    28\\tinterface RawViewRow {\\n    29\\t  view_id: string;\\n    30\\t  created_at: string;\\n    31\\t  compact_point: number | bigint;\\n    32\\t  covered_from: number | bigint;\\n    33\\t  arrangement_json: string;\\n    34\\t  gaps_json: string;\\n    35\\t}\\n    36\\t\\n    37\\tconst BAND_GRADIENT_ORDER: readonly Band[] = [\\\"brief\\\", \\\"detailed\\\", \\\"smooth\\\"];\\n    38\\t\\n    39\\t// null ⇒ no view exists (never compacted): the whole record renders as tail\\n    40\\t// from event 1 through the same pull code path — snapshot-absent, not a\\n    41\\t// separate branch (story Anti-Shim Requirements).\\n    42\\texport function readViewSnapshot(db: DatabaseSync): ViewSnapshot | null {\\n    43\\t  const header = db\\n    44\\t    .prepare(\\n    45\\t      `SELECT view_id, created_at, compact_point, covered_from, arrangement_json, gaps_json\\n    46\\t       FROM thread_view WHERE singleton = 1`,\\n    47\\t    )\\n    48\\t    .get() as RawViewRow | undefined;\\n    49\\t  if (header === undefined) return null;\\n    50\\t\\n    51\\t  const arrangement = JSON.parse(header.arrangement_json) as Array<{ degraded?: boolean }>;\\n    52\\t  const gaps = JSON.parse(header.gaps_json) as unknown[];\\n    53\\t  const bandRows = db\\n    54\\t    .prepare(\\n    55\\t      `SELECT band, rendered_text, token_count FROM thread_view_band WHERE view_id = ?`,\\n    56\\t    )\\n    57\\t    .all(header.view_id) as unknown as Array<{\\n    58\\t    band: string;\\n    59\\t    rendered_text: string;\\n    60\\t    token_count: number | bigint;\\n    61\\t  }>;\\n    62\\t  const byBand = new Map(bandRows.map((row) => [row.band, row]));\\n    63\\t\\n    64\\t  return {\\n    65\\t    viewId: header.view_id,\\n    66\\t    createdAt: header.created_at,\\n    67\\t    compactPoint: Number(header.compact_point),\\n    68\\t    coveredFrom: Number(header.covered_from),\\n    69\\t    gapCount: gaps.length,\\n    70\\t    degradedCount: arrangement.filter((entry) => entry.degraded === true).length,\\n    71\\t    bands: BAND_GRADIENT_ORDER.flatMap((band) => {\\n    72\\t      const row = byBand.get(band);\\n    73\\t      return row === undefined\\n    74\\t        ? []\\n    75\\t        : [{ band, renderedText: row.rendered_text, tokenCount: Number(row.token_count) }];\\n    76\\t    }),\\n    77\\t  };\\n    78\\t}\\n    79\\t\\n    80\\t// The full stored row for `describe` (Epic 04 Story 3): everything the\\n    81\\t// compact wrote, parsed verbatim — arrangement, gaps, config, source-state\\n    82\\t// provenance, per-band stored token counts. Reading, never recomputing: the\\n    83\\t// JSON columns are the snapshot, and this read is the only path between\\n    84\\t// them and the describe surface.\\n    85\\texport function readStoredView(db: DatabaseSync): StoredView | null {\\n    86\\t  const header = db\\n    87\\t    .prepare(\\n    88\\t      `SELECT view_id, created_at, compact_point, covered_from, profile_name,\\n    89\\t              config_json, arrangement_json, gaps_json, source_state_json\\n    90\\t       FROM thread_view WHERE singleton = 1`,\\n    91\\t    )\\n    92\\t    .get() as\\n    93\\t    | {\\n    94\\t        view_id: string;\\n    95\\t        created_at: string;\\n    96\\t        compact_point: number | bigint;\\n    97\\t        covered_from: number | bigint;\\n    98\\t        profile_name: string | null;\\n    99\\t        config_json: string;\\n   100\\t        arrangement_json: string;\\n   101\\t        gaps_json: string;\\n   102\\t        source_state_json: string;\\n   103\\t      }\\n   104\\t    | undefined;\\n   105\\t  if (header === undefined) return null;\\n   106\\t\\n   107\\t  const bandRows = db\\n   108\\t    .prepare(`SELECT band, token_count FROM thread_view_band WHERE view_id = ?`)\\n   109\\t    .all(header.view_id) as unknown as Array<{ band: string; token_count: number | bigint }>;\\n   110\\t  const byBand = new Map(bandRows.map((row) => [row.band, row]));\\n   111\\t\\n   112\\t  return {\\n   113\\t    viewId: header.view_id,\\n   114\\t    createdAt: header.created_at,\\n   115\\t    compactPoint: Number(header.compact_point),\\n   116\\t    coveredFrom: Number(header.covered_from),\\n   117\\t    profileName: header.profile_name,\\n   118\\t    config: JSON.parse(header.config_json) as StoredView[\\\"config\\\"],\\n   119\\t    arrangement: JSON.parse(header.arrangement_json) as StoredView[\\\"arrangement\\\"],\\n   120\\t    gaps: JSON.parse(header.gaps_json) as StoredView[\\\"gaps\\\"],\\n   121\\t    sourceState: JSON.parse(header.source_state_json) as StoredView[\\\"sourceState\\\"],\\n   122\\t    bands: BAND_GRADIENT_ORDER.flatMap((band) => {\\n   123\\t      const row = byBand.get(band);\\n   124\\t      return row === undefined ? [] : [{ band, storedTokens: Number(row.token_count) }];\\n   125\\t    }),\\n   126\\t  };\\n   127\\t}\\n   128\\t\\n   129\\t// ── tail record reads ─────────────────────────────────────────────\\n   130\\t\\n   131\\texport interface TailMessageRow {\\n   132\\t  messageId: string;\\n   133\\t  sourceEventOrder: number;\\n   134\\t  kind: RenderingPartKind;\\n   135\\t  // The source event's recorded_at — materialize's entry timestamp (AC-5.2:\\n   136\\t  // generated fields derive from record times, never write-time clocks).\\n   137\\t  recordedAt: string;\\n   138\\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\\n   139\\t}\\n   140\\t\\n   141\\t// Live messages after the compact point in record order, with their projected\\n   142\\t// blocks — the deleted-read filter applied here so a deleted message never\\n   143\\t// reaches rendering (AC-1.x delete filtering).\\n   144\\texport function readTailMessages(db: DatabaseSync, compactPoint: number): TailMessageRow[] {\\n   145\\t  const messageRows = db\\n   146\\t    .prepare(\\n   147\\t      `SELECT m.message_id, m.source_event_order, m.kind, e.recorded_at FROM message m\\n   148\\t       JOIN event e ON e.event_order = m.source_event_order\\n   149\\t       WHERE m.deleted_at IS NULL AND m.source_event_order > ?\\n   150\\t       ORDER BY m.source_event_order`,\\n   151\\t    )\\n   152\\t    .all(compactPoint) as unknown as Array<{\\n   153\\t    message_id: string;\\n   154\\t    source_event_order: number | bigint;\\n   155\\t    kind: string;\\n   156\\t    recorded_at: string;\\n   157\\t  }>;\\n   158\\t  const blockRows = db\\n   159\\t    .prepare(\\n   160\\t      `SELECT mb.message_id, mb.block_type, mb.content\\n   161\\t       FROM message_block mb JOIN message m ON m.message_id = mb.message_id\\n   162\\t       WHERE m.deleted_at IS NULL AND m.source_event_order > ?\\n   163\\t       ORDER BY m.source_event_order, mb.block_index`,\\n   164\\t    )\\n   165\\t    .all(compactPoint) as unknown as Array<{\\n   166\\t    message_id: string;\\n   167\\t    block_type: string;\\n   168\\t    content: string;\\n   169\\t  }>;\\n   170\\t  const blocksByMessage = new Map<string, TailMessageRow[\\\"blocks\\\"]>();\\n   171\\t  for (const row of blockRows) {\\n   172\\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\\n   173\\t    blocks.push({\\n   174\\t      blockType: row.block_type,\\n   175\\t      content: JSON.parse(row.content) as Record<string, unknown>,\\n   176\\t    });\\n   177\\t    blocksByMessage.set(row.message_id, blocks);\\n   178\\t  }\\n   179\\t  return messageRows.map((row) => ({\\n   180\\t    messageId: row.message_id,\\n   181\\t    sourceEventOrder: Number(row.source_event_order),\\n   182\\t    kind: row.kind as RenderingPartKind,\\n   183\\t    recordedAt: row.recorded_at,\\n   184\\t    blocks: blocksByMessage.get(row.message_id) ?? [],\\n   185\\t  }));\\n   186\\t}\\n   187\\t\\n   188\\t// The thread's identity row — materialize's header source (AC-5.2: the\\n   189\\t// header id derives from thread id + view created-at; a never-compacted\\n   190\\t// thread's header uses the thread's created-at).\\n   191\\texport function readThreadMetadata(db: DatabaseSync): { threadId: string; createdAt: string } {\\n   192\\t  const row = db\\n   193\\t    .prepare(`SELECT thread_id, created_at FROM thread_metadata WHERE id = 1`)\\n   194\\t    .get() as { thread_id: string; created_at: string } | undefined;\\n   195\\t  if (row === undefined) {\\n   196\\t    throw new Error(\\\"thread_metadata singleton row missing (creation writes it)\\\");\\n   197\\t  }\\n   198\\t  return { threadId: row.thread_id, createdAt: row.created_at };\\n   199\\t}\\n   200\\t\\n   201\\t// The tail's token sum for status (AC-2.8): every live message after the\\n   202\\t// compact point, all kinds — the same population the pull renders as tail.\\n   203\\texport function tailTokenSum(db: DatabaseSync, compactPoint: number): number {\\n   204\\t  const row = db\\n   205\\t    .prepare(\\n   206\\t      `SELECT COALESCE(SUM(token_estimate), 0) AS total FROM message\\n   207\\t       WHERE deleted_at IS NULL AND source_event_order > ?`,\\n   208\\t    )\\n   209\\t    .get(compactPoint) as { total: number | bigint };\\n   210\\t  return Number(row.total);\\n   211\\t}\\n   212\\t\\n   213\\t// ── the atomic replace (Story 2, AC-2.6) ──────────────────────────\\n   214\\t\\n   215\\texport interface ViewReplaceInput {\\n   216\\t  viewId: string;\\n   217\\t  createdAt: string;\\n   218\\t  compactPoint: number;\\n   219\\t  coveredFrom: number;\\n   220\\t  profileName: string | null;\\n   221\\t  configJson: string;\\n   222\\t  arrangementJson: string;\\n   223\\t  gapsJson: string;\\n   224\\t  sourceStateJson: string;\\n   225\\t  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\\n   226\\t}\\n   227\\t\\n   228\\t// Compact's one transaction: delete the singleton view row (the FK cascade\\n   229\\t// drops its bands), insert the new header and bands, and reset the boundary\\n   230\\t// to the compact point (AC-4.7) — all inside one BEGIN IMMEDIATE, so a crash\\n   231\\t// anywhere rolls the whole replace back and the previous view keeps serving\\n   232\\t// (AC-2.6, TC-2.4). Compact is the only writer of these rows; the boundary's\\n   233\\t// other writer is Story 4's advance.\\n   234\\texport function replaceViewSnapshot(db: DatabaseSync, input: ViewReplaceInput): void {\\n   235\\t  db.exec(\\\"BEGIN IMMEDIATE;\\\");\\n   236\\t  try {\\n   237\\t    db.prepare(`DELETE FROM thread_view WHERE singleton = 1`).run();\\n   238\\t    db.prepare(\\n   239\\t      `INSERT INTO thread_view (singleton, view_id, created_at, compact_point, covered_from,\\n   240\\t         profile_name, config_json, arrangement_json, gaps_json, source_state_json)\\n   241\\t       VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\\n   242\\t    ).run(\\n   243\\t      input.viewId,\\n   244\\t      input.createdAt,\\n   245\\t      input.compactPoint,\\n   246\\t      input.coveredFrom,\\n   247\\t      input.profileName,\\n   248\\t      input.configJson,\\n   249\\t      input.arrangementJson,\\n   250\\t      input.gapsJson,\\n   251\\t      input.sourceStateJson,\\n   252\\t    );\\n   253\\t    const insertBand = db.prepare(\\n   254\\t      `INSERT INTO thread_view_band (view_id, band, rendered_text, token_count)\\n   255\\t       VALUES (?, ?, ?, ?)`,\\n   256\\t    );\\n   257\\t    for (const band of input.bands) {\\n   258\\t      insertBand.run(input.viewId, band.band, band.renderedText, band.tokenCount);\\n   259\\t    }\\n   260\\t    db.prepare(\\n   261\\t      `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\\n   262\\t    ).run(input.compactPoint, input.createdAt);\\n   263\\t    db.exec(\\\"COMMIT;\\\");\\n   264\\t  } catch (cause) {\\n   265\\t    db.exec(\\\"ROLLBACK;\\\");\\n   266\\t    throw cause;\\n   267\\t  }\\n   268\\t}\\n   269\\t\\n   270\\t// Ready tool-result summaries by message id — the short-form ladder's first\\n   271\\t// rung. Stored state read verbatim, never derived here (no-inference rule).\\n   272\\texport function readReadyToolResultSummaries(db: DatabaseSync): Map<string, string> {\\n   273\\t  const rows = db\\n   274\\t    .prepare(\\n   275\\t      `SELECT subject_id, content FROM derived_form\\n   276\\t       WHERE subject_kind = 'message' AND form = 'tool_result_summary'\\n   277\\t         AND state = 'ready' AND content IS NOT NULL`,\\n   278\\t    )\\n   279\\t    .all() as unknown as Array<{ subject_id: string; content: string }>;\\n   280\\t  return new Map(rows.map((row) => [row.subject_id, row.content]));\\n   281\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_9\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/index.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"     1\\t// thread-view surface (Epic 03): pull, status, compact, sweep, materialize;\\n     2\\t// Epic 04 Story 3 adds describe (the stored-snapshot read inspect composes).\\n     3\\t// Story 1 landed the hot-path reads (`pull`, `status`): local reads and\\n     4\\t// deterministic string assembly only, no inference, no network, no queue\\n     5\\t// interaction, no writes (AC-1.1, AC-2.8). Story 2 landed `compact`;\\n     6\\t// Story 3 landed `sweep` (standalone and embedded default-on in compact);\\n     7\\t// Story 5 lands `materialize` (the PI session-file render target over the\\n     8\\t// same pull assembly). Story 0's substrate (profile resolution, consumed by\\n     9\\t// createSdk) re-exports at the bottom.\\n    10\\timport { existsSync } from \\\"node:fs\\\";\\n    11\\timport * as path from \\\"node:path\\\";\\n    12\\timport {\\n    13\\t  resolveInstanceViewConfig,\\n    14\\t  runWithThreadTouchSuppressed,\\n    15\\t  type OperationContext,\\n    16\\t} from \\\"../../shared/context.js\\\";\\n    17\\timport type { FormReportEntry } from \\\"../../shared/derivation.js\\\";\\n    18\\timport { storageFailure, type ErrorResult, type OpResult } from \\\"../../shared/errors.js\\\";\\n    19\\timport type {\\n    20\\t  CompactReceipt,\\n    21\\t  PullResult,\\n    22\\t  ResolvedViewConfig,\\n    23\\t  StoredView,\\n    24\\t  SweepReceipt,\\n    25\\t  ViewCompactParams,\\n    26\\t  ViewMessage,\\n    27\\t  ViewProfile,\\n    28\\t  ViewStatus,\\n    29\\t} from \\\"../../shared/view.js\\\";\\n    30\\timport * as messagesDomain from \\\"../messages/index.js\\\";\\n    31\\timport * as turnsDomain from \\\"../turns/index.js\\\";\\n    32\\timport {\\n    33\\t  openThreadDatabase,\\n    34\\t  resolveThreadRef,\\n    35\\t  type ThreadRef,\\n    36\\t} from \\\"../threads/index.js\\\";\\n    37\\timport {\\n    38\\t  executeBoundaryAdvance,\\n    39\\t  readBoundaryPosition,\\n    40\\t  visibilityZoneTokens,\\n    41\\t} from \\\"./internal/boundary.js\\\";\\n    42\\timport { profileViolation, resolveViewConfig } from \\\"./internal/profiles.js\\\";\\n    43\\timport {\\n    44\\t  assembleBandText,\\n    45\\t  renderBandMessage,\\n    46\\t  renderTailMessage,\\n    47\\t  toolNamesByCallId,\\n    48\\t} from \\\"./internal/render.js\\\";\\n    49\\timport { fireViewInjection } from \\\"./internal/seam.js\\\";\\n    50\\timport {\\n    51\\t  CanonicalCorruptionError,\\n    52\\t  readSelectionInputs,\\n    53\\t  selectArrangement,\\n    54\\t  type ArrangementEntry,\\n    55\\t} from \\\"./internal/select.js\\\";\\n    56\\timport { writePiSessionFile, type MaterializeInput } from \\\"./internal/materialize.js\\\";\\n    57\\timport {\\n    58\\t  readReadyToolResultSummaries,\\n    59\\t  readStoredView,\\n    60\\t  readTailMessages,\\n    61\\t  readThreadMetadata,\\n    62\\t  readViewSnapshot,\\n    63\\t  replaceViewSnapshot,\\n    64\\t  tailTokenSum,\\n    65\\t} from \\\"./internal/snapshot.js\\\";\\n    66\\timport { runSweep } from \\\"./internal/sweep.js\\\";\\n    67\\timport { estimateTokens } from \\\"../../tech-utils/token-counting/index.js\\\";\\n    68\\timport type { Band } from \\\"../../shared/view.js\\\";\\n    69\\t\\n    70\\t// Config resolution for the operation in hand: the SDK instance's resolved\\n    71\\t// view config rides the per-instance seam (epic-fix-001 pattern, tech design\\n    72\\t// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\\n    73\\t// through the same one resolution path createSdk uses.\\n    74\\tconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\\n    75\\t\\n    76\\tfunction viewConfig(): ResolvedViewConfig {\\n    77\\t  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\\n    78\\t}\\n    79\\t\\n    80\\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\\n    81\\t  return {\\n    82\\t    ok: false,\\n    83\\t    error: {\\n    84\\t      errorClass: \\\"caller_error\\\",\\n    85\\t      code: \\\"thread_not_found\\\",\\n    86\\t      reason: `no thread file exists at ${filePath}`,\\n    87\\t    },\\n    88\\t  };\\n    89\\t}\\n    90\\t\\n    91\\tfunction detail(cause: unknown): string {\\n    92\\t  return cause instanceof Error ? cause.message : String(cause);\\n    93\\t}\\n    94\\t\\n    95\\t// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\\n    96\\t\\n    97\\t// The hot-path read: view header + bands (if any), tail messages after the\\n    98\\t// compact point (deleted-filtered, record order), boundary position; then\\n    99\\t// format — band messages first, tail per the mapping table, tool results\\n   100\\t// at-or-behind the boundary in short form. No view row ⇒ the whole record is\\n   101\\t// tail from event 1 (AC-1.3) through this same code path with the compact\\n   102\\t// point at its zero origin — snapshot-absent, never a separate branch.\\n   103\\t//\\n   104\\t// Reads-only is structural, not disciplined: the whole operation runs in the\\n   105\\t// touch-suppressed scope, so the open announcement that would let a\\n   106\\t// background SDK's scheduler hang a first-touch catch-up drain off this read\\n   107\\t// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\\n   108\\t// AC-1.1's no-queue-interaction holds in both host modes.\\n   109\\texport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\\n   110\\t  return runWithThreadTouchSuppressed(() => pullInner(ref));\\n   111\\t}\\n   112\\t\\n   113\\t// The one assembly both render targets consume (Story 5): pull serves the\\n   114\\t// messages; materialize serves the same entries with the metadata the file's\\n   115\\t// generated fields derive from (entry ids, record-time timestamps). Sharing\\n   116\\t// the array is what makes AC-5.3's parity structural — materialize cannot\\n   117\\t// diverge from pull because there is no second assembly to diverge.\\n   118\\tinterface AssembledView {\\n   119\\t  entries: Array<{ message: ViewMessage; entryId: string; timestamp: string }>;\\n   120\\t  meta: PullResult[\\\"meta\\\"];\\n   121\\t  snapshot: ReturnType<typeof readViewSnapshot>;\\n   122\\t}\\n   123\\t\\n   124\\tfunction assembleView(db: Parameters<typeof readViewSnapshot>[0]): AssembledView {\\n   125\\t  const snapshot = readViewSnapshot(db);\\n   126\\t  const compactPoint = snapshot?.compactPoint ?? 0;\\n   127\\t  const boundaryPosition = readBoundaryPosition(db);\\n   128\\t  const tailRows = readTailMessages(db, compactPoint);\\n   129\\t  const renderCtx = {\\n   130\\t    boundaryPosition,\\n   131\\t    toolNameByCallId: toolNamesByCallId(tailRows),\\n   132\\t    toolResultSummaries: readReadyToolResultSummaries(db),\\n   133\\t  };\\n   134\\t\\n   135\\t  const entries: AssembledView[\\\"entries\\\"] = [];\\n   136\\t  if (snapshot !== null) {\\n   137\\t    for (const band of snapshot.bands) {\\n   138\\t      entries.push({\\n   139\\t        message: renderBandMessage(band.band, band.renderedText),\\n   140\\t        // Band entries are not record messages; their generated fields\\n   141\\t        // derive from view metadata (AC-5.2).\\n   142\\t        entryId: `${snapshot.viewId}-${band.band}`,\\n   143\\t        timestamp: snapshot.createdAt,\\n   144\\t      });\\n   145\\t    }\\n   146\\t  }\\n   147\\t  for (const row of tailRows) {\\n   148\\t    entries.push({\\n   149\\t      message: renderTailMessage(row, renderCtx),\\n   150\\t      entryId: row.messageId,\\n   151\\t      timestamp: row.recordedAt,\\n   152\\t    });\\n   153\\t  }\\n   154\\t\\n   155\\t  return {\\n   156\\t    entries,\\n   157\\t    meta: {\\n   158\\t      compactPoint: snapshot?.compactPoint ?? null,\\n   159\\t      coveredFrom: snapshot?.coveredFrom ?? null,\\n   160\\t      boundaryPosition,\\n   161\\t      gapCount: snapshot?.gapCount ?? 0,\\n   162\\t      degradedCount: snapshot?.degradedCount ?? 0,\\n   163\\t      viewId: snapshot?.viewId ?? null,\\n   164\\t      createdAt: snapshot?.createdAt ?? null,\\n   165\\t    },\\n   166\\t    snapshot,\\n   167\\t  };\\n   168\\t}\\n   169\\t\\n   170\\tasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\\n   171\\t  const resolved = await resolveThreadRef(ref);\\n   172\\t  if (!resolved.ok) return resolved;\\n   173\\t  const { filePath } = resolved.value;\\n   174\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   175\\t\\n   176\\t  const opened = openThreadDatabase(filePath);\\n   177\\t  if (!opened.ok) return opened;\\n   178\\t  const db = opened.value;\\n   179\\t  try {\\n   180\\t    const assembled = assembleView(db);\\n   181\\t    return {\\n   182\\t      ok: true,\\n   183\\t      value: {\\n   184\\t        messages: assembled.entries.map((entry) => entry.message),\\n   185\\t        meta: assembled.meta,\\n   186\\t      },\\n   187\\t    };\\n   188\\t  } catch (cause) {\\n   189\\t    return storageFailure(`view pull failed: ${detail(cause)}`);\\n   190\\t  } finally {\\n   191\\t    db.close();\\n   192\\t  }\\n   193\\t}\\n   194\\t\\n   195\\t// ── status (AC-2.8) ───────────────────────────────────────────────\\n   196\\t\\n   197\\t// Derivation counts bucket from one report entry the way the report's own\\n   198\\t// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\\n   199\\t// pending, retrying (pending with attempts spent), failed, blocked. Ready\\n   200\\t// forms are healthy and not an operational situation.\\n   201\\tfunction bucketDerivation(\\n   202\\t  entries: readonly FormReportEntry[],\\n   203\\t  counts: ViewStatus[\\\"derivation\\\"],\\n   204\\t): void {\\n   205\\t  for (const entry of entries) {\\n   206\\t    switch (entry.state) {\\n   207\\t      case \\\"pending\\\":\\n   208\\t        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\\n   209\\t        else counts.pending += 1;\\n   210\\t        break;\\n   211\\t      case \\\"failed\\\":\\n   212\\t        counts.failed += 1;\\n   213\\t        break;\\n   214\\t      case \\\"blocked\\\":\\n   215\\t        counts.blocked += 1;\\n   216\\t        break;\\n   217\\t      case \\\"ready\\\":\\n   218\\t        break;\\n   219\\t    }\\n   220\\t  }\\n   221\\t}\\n   222\\t\\n   223\\t// Reads only, callable any time, no side effects: tail size against the\\n   224\\t// configured trigger threshold with a compact recommendation (`tailTokens >\\n   225\\t// threshold`, nothing smarter — the caller owns policy), derivation counts\\n   226\\t// by state read through the OWNERS' report surfaces (must-not-own: never a\\n   227\\t// direct derived_form read here), the active view's health or null\\n   228\\t// pre-compact, and the visibility zone's sum against its max — computed live\\n   229\\t// by the same query the Story 4 advance will use, so \\\"visible in status\\\" is\\n   230\\t// structural, not stored.\\n   231\\t//\\n   232\\t// Like pull, the whole read — including the owners' report surfaces it\\n   233\\t// consumes — runs in the touch-suppressed scope, so a background SDK's\\n   234\\t// status can never schedule a catch-up drain (AC-2.8 reads-only, both\\n   235\\t// host modes).\\n   236\\texport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\\n   237\\t  return runWithThreadTouchSuppressed(() => statusInner(ref));\\n   238\\t}\\n   239\\t\\n   240\\tasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\\n   241\\t  const resolved = await resolveThreadRef(ref);\\n   242\\t  if (!resolved.ok) return resolved;\\n   243\\t  const { filePath } = resolved.value;\\n   244\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   245\\t\\n   246\\t  const config = viewConfig();\\n   247\\t  const opened = openThreadDatabase(filePath);\\n   248\\t  if (!opened.ok) return opened;\\n   249\\t  const db = opened.value;\\n   250\\t  let tailTokens: number;\\n   251\\t  let zoneTokens: number;\\n   252\\t  let view: ViewStatus[\\\"view\\\"];\\n   253\\t  try {\\n   254\\t    const snapshot = readViewSnapshot(db);\\n   255\\t    const compactPoint = snapshot?.compactPoint ?? 0;\\n   256\\t    const boundaryPosition = readBoundaryPosition(db);\\n   257\\t    tailTokens = tailTokenSum(db, compactPoint);\\n   258\\t    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\\n   259\\t    view =\\n   260\\t      snapshot === null\\n   261\\t        ? null\\n   262\\t        : {\\n   263\\t            degraded: snapshot.degradedCount,\\n   264\\t            gaps: snapshot.gapCount,\\n   265\\t            builtAt: snapshot.createdAt,\\n   266\\t          };\\n   267\\t  } catch (cause) {\\n   268\\t    return storageFailure(`view status failed: ${detail(cause)}`);\\n   269\\t  } finally {\\n   270\\t    db.close();\\n   271\\t  }\\n   272\\t\\n   273\\t  // The owners' report surfaces open their own handles; ours is closed first\\n   274\\t  // so the status read never holds two handles on one thread file.\\n   275\\t  const messageReport = await messagesDomain.report({ filePath });\\n   276\\t  if (!messageReport.ok) return messageReport;\\n   277\\t  const turnReport = await turnsDomain.report({ filePath });\\n   278\\t  if (!turnReport.ok) return turnReport;\\n   279\\t  const derivation: ViewStatus[\\\"derivation\\\"] = {\\n   280\\t    pending: 0,\\n   281\\t    retrying: 0,\\n   282\\t    failed: 0,\\n   283\\t    blocked: 0,\\n   284\\t  };\\n   285\\t  bucketDerivation(messageReport.value, derivation);\\n   286\\t  bucketDerivation(turnReport.value, derivation);\\n   287\\t\\n   288\\t  return {\\n   289\\t    ok: true,\\n   290\\t    value: {\\n   291\\t      tailTokens,\\n   292\\t      threshold: config.compactThreshold,\\n   293\\t      compactRecommended: tailTokens > config.compactThreshold,\\n   294\\t      derivation,\\n   295\\t      view,\\n   296\\t      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\\n   297\\t    },\\n   298\\t  };\\n   299\\t}\\n   300\\t\\n   301\\t// ── describe (Epic 04 Story 3: AC-2.1, AC-2.5) ───────────────────\\n   302\\t\\n   303\\t// The stored active view row, exposed read-only so inspect never reads\\n   304\\t// thread-view tables directly (DD-1). Everything is the snapshot verbatim —\\n   305\\t// arrangement, gaps, config, source-state provenance, per-band stored token\\n   306\\t// counts; nothing is recomputed, repaired, or read from the record. Absent\\n   307\\t// view ⇒ ok with null, mirroring status's never-compacted behavior. Like the\\n   308\\t// other reads, the whole operation runs touch-suppressed: a background SDK's\\n   309\\t// describe can never schedule a catch-up drain.\\n   310\\texport async function describe(ref: ThreadRef): Promise<OpResult<StoredView | null>> {\\n   311\\t  return runWithThreadTouchSuppressed(() => describeInner(ref));\\n   312\\t}\\n   313\\t\\n   314\\tasync function describeInner(ref: ThreadRef): Promise<OpResult<StoredView | null>> {\\n   315\\t  const resolved = await resolveThreadRef(ref);\\n   316\\t  if (!resolved.ok) return resolved;\\n   317\\t  const { filePath } = resolved.value;\\n   318\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   319\\t\\n   320\\t  const opened = openThreadDatabase(filePath);\\n   321\\t  if (!opened.ok) return opened;\\n   322\\t  const db = opened.value;\\n   323\\t  try {\\n   324\\t    return { ok: true, value: readStoredView(db) };\\n   325\\t  } catch (cause) {\\n   326\\t    return storageFailure(`view describe failed: ${detail(cause)}`);\\n   327\\t  } finally {\\n   328\\t    db.close();\\n   329\\t  }\\n   330\\t}\\n   331\\t\\n   332\\t// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\\n   333\\t\\n   334\\t// The default base when no profile is named: the first built-in, matching\\n   335\\t// the epic's primary user (the PI continuation harness). Explicit params\\n   336\\t// override the base field-wise (AC-2.2).\\n   337\\tconst DEFAULT_PROFILE_NAME = \\\"continuation\\\";\\n   338\\t\\n   339\\tfunction callerError(\\n   340\\t  code: \\\"unknown_profile\\\" | \\\"invalid_view_config\\\",\\n   341\\t  reason: string,\\n   342\\t): { ok: false; error: ErrorResult } {\\n   343\\t  return { ok: false, error: { errorClass: \\\"caller_error\\\", code, reason } };\\n   344\\t}\\n   345\\t\\n   346\\tconst BAND_ORDER: readonly Band[] = [\\\"brief\\\", \\\"detailed\\\", \\\"smooth\\\"];\\n   347\\t\\n   348\\t// Compact runs only when invoked through this surface (AC-2.1: no code path\\n   349\\t// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\\n   350\\t// rejection provably touches nothing) → sweep, on by default, `sweep: false`\\n   351\\t// skips (AC-3.6; the receipt records which) → read record + forms with the\\n   352\\t// corruption check in the reads (pre-transaction, prior view trivially\\n   353\\t// intact on refusal) → selection walk → band rendering → one BEGIN\\n   354\\t// IMMEDIATE replacing the view and resetting the boundary → receipt.\\n   355\\t// Assembly is entirely from stored artifacts: nothing here can reach a\\n   356\\t// provider (AC-2.4 zero-inference is structural — the sweep step repairs\\n   357\\t// through owners' requeue surfaces and calls no provider either).\\n   358\\texport async function compact(\\n   359\\t  ref: ThreadRef,\\n   360\\t  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\\n   361\\t): Promise<OpResult<CompactReceipt>> {\\n   362\\t  const resolved = await resolveThreadRef(ref);\\n   363\\t  if (!resolved.ok) return resolved;\\n   364\\t  const { filePath } = resolved.value;\\n   365\\t  if (!existsSync(filePath)) return threadNotFound(filePath);\\n   366\\t\\n   367\\t  const config = viewConfig();\\n   368\\t  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\\n   369\\t  const base = config.profiles[baseName];\\n   370\\t  if (base === undefined) {\\n   371\\t    return callerError(\\n   372\\t      \\\"unknown_profile\\\",\\n   373\\t      `unknown profile \\\"${baseName}\\\"; configured profiles are ${Object.keys(config.profiles)\\n   374\\t        .map((name) => `\\\"${name}\\\"`)\\n   375\\t        .join(\\\", \\\")}`,\\n   376\\t    );\\n   377\\t  }\\n   378\\t  const merged: ViewProfile = {\\n   379\\t    name: base.name,\\n   380\\t    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\\n   381\\t    percentages: { ...base.percentages, ...opts.params?.percentages },\\n   382\\t  };\\n   383\\t  const violation = profileViolation(merged);\\n   384\\t  if (violation !== null) return callerError(\\\"invalid_view_config\\\", violation);\\n   385\\t  // Receipt provenance: \\\"null when explicit params\\\" (tech design §Storage) —\\n   386\\t  // any param override means the config is no longer a named profile's mix,\\n   387\\t  // even when one served as the merge base; the receipt's config carries the\\n   388\\t  // resolved truth. A bare or profile-only call names its profile.\\n   389\\t  const profileName = opts.params === undefined ? baseName : null;\\n   390\\t\\n   391\\t  // The sweep step (Flow 2 / Flow 3, AC-3.6): on by default so every compact\\n   392\\t  // leaves the thread healthier than it found it; `sweep: false` skips with\\n   393\\t  // the skip recorded in the receipt. Runs before this operation opens its\\n   394\\t  // own handle (the owners' surfaces open theirs), and before any view\\n   395\\t  // write — a sweep failure aborts the compact with the prior view intact.\\n   396\\t  let sweepOutcome: SweepReceipt | { skipped: true };\\n   397\\t  if (opts.sweep === false) {\\n   398\\t    sweepOutcome = { skipped: true };\\n   399\\t  } else {\\n   400\\t    const swept = await runSweep(filePath);\\n   401\\t    if (!swept.ok) return swept;\\n   402\\t    sweepOutcome = swept.value;\\n   403\\t  }\\n   404\\t\\n   405\\t  const opened = openThreadDatabase(filePath);\\n   406\\t  if (!opened.ok) return opened;\\n   407\\t  const db = opened.value;\\n   408\\t  try {\\n   409\\t    let inputs;\\n   410\\t    try {\\n   411\\t      inputs = readSelectionInputs(db);\\n   412\\t    } catch (cause) {\\n   413\\t      if (cause instanceof CanonicalCorruptionError) {\\n   414\\t        // Pre-transaction refusal: nothing was written, the prior view and\\n   415\\t        // the record are untouched (AC-2.5).\\n   416\\t        return {\\n   417\\t          ok: false,\\n   418\\t          error: { errorClass: \\\"state_corruption\\\", code: cause.code, reason: cause.message },\\n   419\\t        };\\n   420\\t      }\\n   421\\t      throw cause;\\n   422\\t    }\\n   423\\t    const selection = selectArrangement(inputs, {\\n   424\\t      lowerBound: merged.lowerBound,\\n   425\\t      percentages: merged.percentages,\\n   426\\t    });\\n   427\\t\\n   428\\t    const entriesByBand = (band: Band): ArrangementEntry[] =>\\n   429\\t      selection.entries.filter((entry) => entry.band === band);\\n   430\\t    const bands = BAND_ORDER.flatMap((band) => {\\n   431\\t      const entries = entriesByBand(band);\\n   432\\t      if (entries.length === 0) return [];\\n   433\\t      const renderedText = assembleBandText(entries.map((entry) => entry.text));\\n   434\\t      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\\n   435\\t    });\\n   436\\t\\n   437\\t    const createdAt = new Date().toISOString();\\n   438\\t    // view_id is v<compact event order> — deterministic, and deliberately\\n   439\\t    // reused by an intake-free recompact (tech design L395: do not \\\"fix\\\"\\n   440\\t    // into a uniqueness scheme; the singleton row is replaced whole).\\n   441\\t    const viewId = `v${inputs.maxEventOrder}`;\\n   442\\t\\n   443\\t    // Story-0 injection point: TC-2.4's crash between the sweep and the\\n   444\\t    // view-write transaction. An installed hook's throw aborts here —\\n   445\\t    // before BEGIN — so the previous view keeps serving.\\n   446\\t    fireViewInjection(\\\"compact-write\\\");\\n   447\\t\\n   448\\t    replaceViewSnapshot(db, {\\n   449\\t      viewId,\\n   450\\t      createdAt,\\n   451\\t      compactPoint: selection.compactPoint,\\n   452\\t      coveredFrom: selection.coveredFrom,\\n   453\\t      profileName,\\n   454\\t      configJson: JSON.stringify({\\n   455\\t        lowerBound: merged.lowerBound,\\n   456\\t        percentages: merged.percentages,\\n   457\\t      }),\\n   458\\t      arrangementJson: JSON.stringify(\\n   459\\t        selection.entries.map((entry) => ({\\n   460\\t          band: entry.band,\\n   461\\t          subjectKind: entry.subjectKind,\\n   462\\t          subjectId: entry.subjectId,\\n   463\\t          formUsed: entry.formUsed,\\n   464\\t          degraded: entry.degraded,\\n   465\\t        })),\\n   466\\t      ),\\n   467\\t      gapsJson: JSON.stringify(\\n   468\\t        selection.entries\\n   469\\t          .filter((entry) => entry.gap)\\n   470\\t          .map((entry) => ({\\n   471\\t            band: entry.band,\\n   472\\t            subjectId: entry.subjectId,\\n   473\\t            reason: entry.reason ?? \\\"unknown\\\",\\n   474\\t          })),\\n   475\\t      ),\\n   476\\t      sourceStateJson: JSON.stringify({\\n   477\\t        maxEventOrder: inputs.maxEventOrder,\\n   478\\t        formCounts: inputs.formCounts,\\n   479\\t      }),\\n   480\\t      bands,\\n   481\\t    });\\n   482\\t\\n   483\\t    const bandReport = {} as CompactReceipt[\\\"bands\\\"];\\n   484\\t    for (const band of BAND_ORDER) {\\n   485\\t      const stored = bands.find((row) => row.band === band);\\n   486\\t      bandReport[band] = {\\n   487\\t        entries: entriesByBand(band).length,\\n   488\\t        tokens: stored?.tokenCount ?? 0,\\n   489\\t      };\\n   490\\t    }\\n   491\\t    const tailTokens = tailTokenSum(db, selection.compactPoint);\\n   492\\t    return {\\n   493\\t      ok: true,\\n   494\\t      value: {\\n   495\\t        viewId,\\n   496\\t        profile: profileName,\\n   497\\t        config: { ...merged.percentages, lowerBound: merged.lowerBound },\\n   498\\t        bands: bandReport,\\n   499\\t        tailTokens,\\n   500\\t        // Actual assembled total vs the bound (target, not cap — AC-2.4).\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/inspect/index.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_12\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/inspect/index.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"     1\\t// inspect surface (Epic 04): overview, view, health. The domain at the top\\n     2\\t// of the graph — a pure consumer of five other surfaces, importing no\\n     3\\t// internals, owning no tables, calling no provider, writing nothing. It\\n     4\\t// reports repair targets without executing repair; mutations stay Feature 2\\n     5\\t// behavior on the owning surfaces.\\n     6\\t//\\n     7\\t// Story 2 landed overview and health; Story 3 lands `view` — the stored\\n     8\\t// snapshot from `threadView.describe` plus the serving cost measured from\\n     9\\t// `threadView.pull` (parity by construction, DD-4).\\n    10\\t//\\n    11\\t// Reads-only is structural, not disciplined (DD-6): every operation runs in\\n    12\\t// the touch-suppressed scope, so the open announcements fired by the surfaces\\n    13\\t// it composes can never let a background SDK's scheduler hang a first-touch\\n    14\\t// catch-up drain — and the provider call that drain would make — off an\\n    15\\t// inspect read.\\n    16\\timport { runWithThreadTouchSuppressed } from \\\"../../shared/context.js\\\";\\n    17\\timport type { OpResult } from \\\"../../shared/errors.js\\\";\\n    18\\timport type {\\n    19\\t  HealthReport,\\n    20\\t  InspectOverview,\\n    21\\t  ViewContentsReport,\\n    22\\t} from \\\"../../shared/inspect.js\\\";\\n    23\\timport type { ThreadRef } from \\\"../threads/index.js\\\";\\n    24\\timport { composeHealth } from \\\"./internal/health.js\\\";\\n    25\\timport { composeOverview } from \\\"./internal/overview.js\\\";\\n    26\\timport { composeViewReport } from \\\"./internal/view-report.js\\\";\\n    27\\t\\n    28\\texport type { HealthReport, InspectOverview, ViewContentsReport };\\n    29\\t\\n    30\\texport async function overview(ref: ThreadRef): Promise<OpResult<InspectOverview>> {\\n    31\\t  return runWithThreadTouchSuppressed(() => composeOverview(ref));\\n    32\\t}\\n    33\\t\\n    34\\texport async function health(ref: ThreadRef): Promise<OpResult<HealthReport>> {\\n    35\\t  return runWithThreadTouchSuppressed(() => composeHealth(ref));\\n    36\\t}\\n    37\\t\\n    38\\texport async function view(ref: ThreadRef): Promise<OpResult<ViewContentsReport>> {\\n    39\\t  return runWithThreadTouchSuppressed(() => composeViewReport(ref));\\n    40\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/inspect/internal/view-report.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_13\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/inspect/internal/view-report.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"     1\\t// View-contents report composition (Flow 2, DD-4): describe + pull are the\\n     2\\t// only sources. The stored arrangement, gaps, config, per-band stored token\\n     3\\t// counts, and source-state provenance come from `threadView.describe`; the\\n     4\\t// serving cost comes from MEASURING `threadView.pull`'s output with the\\n     5\\t// shared estimator — parity with what agents receive is by construction\\n     6\\t// (AC-2.3), and AC-2.2's boundary-aware tail shortening is inherited from\\n     7\\t// pull, never re-implemented. Nothing here recomputes selection, rendering,\\n     8\\t// form choice, or boundary state.\\n     9\\timport { storageFailure, type OpResult } from \\\"../../../shared/errors.js\\\";\\n    10\\timport type { ViewContentsReport } from \\\"../../../shared/inspect.js\\\";\\n    11\\timport type { Band, ViewMessage } from \\\"../../../shared/view.js\\\";\\n    12\\timport { estimateTokens } from \\\"../../../tech-utils/token-counting/index.js\\\";\\n    13\\timport * as threadView from \\\"../../thread-view/index.js\\\";\\n    14\\timport type { ThreadRef } from \\\"../../threads/index.js\\\";\\n    15\\t\\n    16\\tconst BAND_ORDER: readonly Band[] = [\\\"brief\\\", \\\"detailed\\\", \\\"smooth\\\"];\\n    17\\t\\n    18\\tfunction measuredTokens(messages: readonly ViewMessage[]): number {\\n    19\\t  return messages.reduce((sum, message) => sum + estimateTokens(message.content), 0);\\n    20\\t}\\n    21\\t\\n    22\\texport async function composeViewReport(\\n    23\\t  ref: ThreadRef,\\n    24\\t): Promise<OpResult<ViewContentsReport>> {\\n    25\\t  const described = await threadView.describe(ref);\\n    26\\t  if (!described.ok) return described;\\n    27\\t  const pulled = await threadView.pull(ref);\\n    28\\t  if (!pulled.ok) return pulled;\\n    29\\t  const stored = described.value;\\n    30\\t\\n    31\\t  const bandMessages = pulled.value.messages.filter((message) => message.band !== undefined);\\n    32\\t  const tailMessages = pulled.value.messages.filter((message) => message.band === undefined);\\n    33\\t\\n    34\\t  // Cross-check count only (Flow 2): the arrangement is describe's; pull just\\n    35\\t  // has to be serving the same snapshot's bands. A mismatch means the two\\n    36\\t  // reads saw different stored state (a compact landed between them) —\\n    37\\t  // report it, never paper over it. Existing code, no additions (tech\\n    38\\t  // design §Interface Definitions).\\n    39\\t  const storedBandCount = stored?.bands.length ?? 0;\\n    40\\t  if (bandMessages.length !== storedBandCount) {\\n    41\\t    return storageFailure(\\n    42\\t      `view report cross-check failed: describe saw ${storedBandCount} stored band(s) but pull served ${bandMessages.length} band message(s); the view changed between reads`,\\n    43\\t    );\\n    44\\t  }\\n    45\\t\\n    46\\t  // Band sections: stored arrangement entries grouped in served order\\n    47\\t  // (brief → detailed → smooth), gap entries included — they are arrangement\\n    48\\t  // rows; their reasons live in `gaps`. storedTokens is the band row's count\\n    49\\t  // verbatim (AC-2.1: from the stored snapshot, not recomputed).\\n    50\\t  const bands: ViewContentsReport[\\\"bands\\\"] =\\n    51\\t    stored === null\\n    52\\t      ? []\\n    53\\t      : BAND_ORDER.flatMap((band) => {\\n    54\\t          const entries = stored.arrangement\\n    55\\t            .filter((entry) => entry.band === band)\\n    56\\t            .map((entry) => ({\\n    57\\t              subjectKind: entry.subjectKind,\\n    58\\t              subjectId: entry.subjectId,\\n    59\\t              formUsed: entry.formUsed,\\n    60\\t              degraded: entry.degraded,\\n    61\\t            }));\\n    62\\t          const storedBand = stored.bands.find((row) => row.band === band);\\n    63\\t          if (entries.length === 0 && storedBand === undefined) return [];\\n    64\\t          return [{ band, entries, storedTokens: storedBand?.storedTokens ?? 0 }];\\n    65\\t        });\\n    66\\t\\n    67\\t  const bandTokens = measuredTokens(bandMessages);\\n    68\\t  const tailTokens = measuredTokens(tailMessages);\\n    69\\t\\n    70\\t  return {\\n    71\\t    ok: true,\\n    72\\t    value: {\\n    73\\t      meta:\\n    74\\t        stored === null\\n    75\\t          ? null\\n    76\\t          : {\\n    77\\t              viewId: stored.viewId,\\n    78\\t              createdAt: stored.createdAt,\\n    79\\t              profile: stored.profileName,\\n    80\\t              config: stored.config,\\n    81\\t              compactPoint: stored.compactPoint,\\n    82\\t              coveredFrom: stored.coveredFrom,\\n    83\\t            },\\n    84\\t      bands,\\n    85\\t      gaps: stored?.gaps ?? [],\\n    86\\t      tail: { messageCount: tailMessages.length, tokens: tailTokens },\\n    87\\t      loadCost: { bandTokens, tailTokens, total: bandTokens + tailTokens },\\n    88\\t      sourceState: stored?.sourceState ?? null,\\n    89\\t    },\\n    90\\t  };\\n    91\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/shared/view.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/shared/view.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"     1\\t// Epic 03 shared vocabulary: the thread-view types (tech design §Interface\\n     2\\t// Definitions). Shared so cli/sdk/tests import one home; the thread-view\\n     3\\t// domain owns the behavior, this module owns only the shapes.\\n     4\\t\\n     5\\texport type Band = \\\"brief\\\" | \\\"detailed\\\" | \\\"smooth\\\";\\n     6\\t\\n     7\\texport interface ViewProfile {\\n     8\\t  name: string;\\n     9\\t  // Target assembled size; whole-entry fills may land under or over (epic\\n    10\\t  // Data Contracts — the bound is a target, not a cap).\\n    11\\t  lowerBound: number;\\n    12\\t  // Band shares of the lower bound; must sum to 100 (AC-2.3).\\n    13\\t  percentages: { full: number; smooth: number; detailed: number; brief: number };\\n    14\\t}\\n    15\\t\\n    16\\t// A user profile entry as configured: a full profile under a new name, or a\\n    17\\t// field-wise override of a built-in (merged by name, AC-2.2). A partial entry\\n    18\\t// whose name matches no built-in has nothing to merge over and is rejected at\\n    19\\t// construction (FC-0.2's unknown-override violation).\\n    20\\texport interface ViewProfileOverride {\\n    21\\t  name: string;\\n    22\\t  lowerBound?: number;\\n    23\\t  percentages?: Partial<ViewProfile[\\\"percentages\\\"]>;\\n    24\\t}\\n    25\\t\\n    26\\t// Compact-time explicit parameters (AC-2.2): field-wise overrides of the\\n    27\\t// base profile, down to single band percentages — the same depth the CLI's\\n    28\\t// per-band flags override at. A nested-partial deepening of the tech\\n    29\\t// design's `Partial<ViewProfile>` sketch, which could not express a\\n    30\\t// single-band override.\\n    31\\texport interface ViewCompactParams {\\n    32\\t  lowerBound?: number;\\n    33\\t  percentages?: Partial<ViewProfile[\\\"percentages\\\"]>;\\n    34\\t}\\n    35\\t\\n    36\\t// Visibility-boundary budgets (AC-4.x): max > target ≥ floor, all positive.\\n    37\\texport interface VisibilityBudgets {\\n    38\\t  maxTokens: number;\\n    39\\t  targetTokens: number;\\n    40\\t  floorTokens: number;\\n    41\\t}\\n    42\\t\\n    43\\t// ── SDK assembly config (validated at construction, throws on nonsense\\n    44\\t// per the Epic 02 rule) ───────────────────────────────────────────\\n    45\\texport interface SdkViewConfig {\\n    46\\t  profiles?: ViewProfileOverride[]; // merged over built-ins by name\\n    47\\t  visibility?: Partial<VisibilityBudgets>; // defaults: 32000 / 24000 / 8000\\n    48\\t  compactThreshold?: number; // status trigger; default 160000\\n    49\\t}\\n    50\\t\\n    51\\t// Every optional filled by createSdk's central defaults; profiles resolved\\n    52\\t// to complete, validated entries keyed by name.\\n    53\\texport interface ResolvedViewConfig {\\n    54\\t  profiles: Readonly<Record<string, ViewProfile>>;\\n    55\\t  visibility: VisibilityBudgets;\\n    56\\t  compactThreshold: number;\\n    57\\t}\\n    58\\t\\n    59\\t// ── pull / status shapes (the product crossing to the harness) ────\\n    60\\t//\\n    61\\t// The pull's array shape (Story 1, load-bearing for Stories 2–5): band\\n    62\\t// messages first — one `user` message per non-empty band, gradient order\\n    63\\t// brief → detailed → smooth, marker header + snapshot bytes verbatim — then\\n    64\\t// the tail in record order. Tail messages render by the message-kind mapping\\n    65\\t// table (tech design §Tail message rendering), the contract every later\\n    66\\t// story renders into:\\n    67\\t//\\n    68\\t//   | Message kind                       | Role      | Content shape |\\n    69\\t//   |------------------------------------|-----------|---------------|\\n    70\\t//   | user_prompt                        | user      | text verbatim |\\n    71\\t//   | assistant_text                     | assistant | text verbatim |\\n    72\\t//   | assistant_thinking                 | assistant | fenced: `[thinking]\\\\n<text>\\\\n[/thinking]` — included (the tail is full fidelity) |\\n    73\\t//   | tool_call                          | assistant | `[tool call · <name>] <compact args>` — deterministic arg rendering, abbreviation rule for oversized args |\\n    74\\t//   | tool_result (ahead of boundary)    | user      | `[tool result · <name>]\\\\n<full content>` |\\n    75\\t//   | tool_result (at-or-behind boundary)| user      | `[tool result · <name> · abridged]\\\\n<summary or deterministic truncation>` (short-form ladder) |\\n    76\\t//   | runtime_note                       | user      | `[runtime note] <text>` |\\n    77\\texport interface ViewMessage {\\n    78\\t  role: \\\"user\\\" | \\\"assistant\\\";\\n    79\\t  content: string;\\n    80\\t  band?: Band; // band absent ⇒ tail\\n    81\\t}\\n    82\\t\\n    83\\texport interface ViewMeta {\\n    84\\t  compactPoint: number | null; // null ⇒ never compacted (AC-1.3)\\n    85\\t  coveredFrom: number | null;\\n    86\\t  boundaryPosition: number;\\n    87\\t  gapCount: number;\\n    88\\t  degradedCount: number;\\n    89\\t  viewId: string | null;\\n    90\\t  createdAt: string | null;\\n    91\\t}\\n    92\\t\\n    93\\texport interface PullResult {\\n    94\\t  messages: ViewMessage[];\\n    95\\t  meta: ViewMeta;\\n    96\\t}\\n    97\\t\\n    98\\t// The stored active view row as `threadView.describe` exposes it (Epic 04\\n    99\\t// Story 3): the snapshot verbatim — arrangement, gaps, config, source-state\\n   100\\t// provenance, per-band stored token counts — never recomputed, never\\n   101\\t// repaired. Absent view ⇒ describe returns ok/null, mirroring status's\\n   102\\t// never-compacted behavior (DD-1).\\n   103\\texport interface StoredView {\\n   104\\t  viewId: string;\\n   105\\t  createdAt: string;\\n   106\\t  compactPoint: number;\\n   107\\t  coveredFrom: number;\\n   108\\t  // null when explicit params overrode a named base at compact (the stored\\n   109\\t  // config carries the resolved truth either way).\\n   110\\t  profileName: string | null;\\n   111\\t  config: { lowerBound: number; percentages: Record<string, number> };\\n   112\\t  // Every selected entry in served order, gap entries included (they are\\n   113\\t  // arrangement rows too; `gaps` carries their reasons).\\n   114\\t  arrangement: Array<{\\n   115\\t    band: Band;\\n   116\\t    subjectKind: \\\"chunk\\\" | \\\"turn\\\";\\n   117\\t    subjectId: string;\\n   118\\t    formUsed: string;\\n   119\\t    degraded: boolean;\\n   120\\t  }>;\\n   121\\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\\n   122\\t  // What the compact saw (AC-2.5 provenance, stored verbatim).\\n   123\\t  sourceState: { maxEventOrder: number; formCounts: Record<string, number> };\\n   124\\t  // Non-empty bands in gradient order with their stored token counts.\\n   125\\t  bands: Array<{ band: Band; storedTokens: number }>;\\n   126\\t}\\n   127\\t\\n   128\\texport interface ViewStatus {\\n   129\\t  tailTokens: number;\\n   130\\t  threshold: number;\\n   131\\t  compactRecommended: boolean;\\n   132\\t  derivation: { pending: number; retrying: number; failed: number; blocked: number };\\n   133\\t  view: { degraded: number; gaps: number; builtAt: string } | null;\\n   134\\t  visibility: { zoneTokens: number; maxTokens: number };\\n   135\\t}\\n   136\\t\\n   137\\t// ── receipts (AC-2.7, AC-3.x) ─────────────────────────────────────\\n   138\\texport interface CompactReceipt {\\n   139\\t  viewId: string;\\n   140\\t  profile: string | null;\\n   141\\t  config: ViewProfile[\\\"percentages\\\"] & { lowerBound: number };\\n   142\\t  bands: Record<Band, { entries: number; tokens: number }>;\\n   143\\t  tailTokens: number;\\n   144\\t  // The assembled view's actual total (band tokens + tail tokens) against\\n   145\\t  // the configured lower bound — a target, not a cap: whole-entry fills may\\n   146\\t  // land under it, indivisible entries over it (AC-2.4; ruling 013).\\n   147\\t  totalTokens: number;\\n   148\\t  coveredFrom: number;\\n   149\\t  compactPoint: number;\\n   150\\t  degraded: Array<{ band: Band; subjectId: string; usedForm: string }>;\\n   151\\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\\n   152\\t  // The embedded sweep's receipt (AC-3.6): the sweep runs first by default\\n   153\\t  // and its full receipt embeds here; `sweep: false` records the skip — the\\n   154\\t  // receipt always says whether the sweep ran (Story 3 closed Story 2's\\n   155\\t  // \\\"absent\\\" placeholder).\\n   156\\t  sweep: SweepReceipt | { skipped: true };\\n   157\\t}\\n   158\\t\\n   159\\texport interface SweepReceipt {\\n   160\\t  owners: Array<{\\n   161\\t    owner: \\\"messages\\\" | \\\"turns\\\";\\n   162\\t    kind: string;\\n   163\\t    ready: number;\\n   164\\t    inFlight: number;\\n   165\\t    requeued: string[]; // subject ids\\n   166\\t    blocked: Array<{ subjectId: string; reason: string }>;\\n   167\\t    permanentFailed: Array<{ subjectId: string; reason: string }>;\\n   168\\t  }>;\\n   169\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/shared/inspect.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/shared/inspect.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"     1\\t// Epic 04 shared vocabulary: the inspect domain's report shapes (tech design\\n     2\\t// §Interface Definitions). Inspect is a pure consumer — these shapes carry\\n     3\\t// other domains' surface output composed into counts and summaries; nothing\\n     4\\t// here is re-derived or re-interpreted beyond the owners' reported states.\\n     5\\timport type { Band } from \\\"./view.js\\\";\\n     6\\t\\n     7\\texport interface InspectOverview {\\n     8\\t  thread: { id: string; createdAt: string; metadata?: Record<string, string> };\\n     9\\t  // span null ⇔ count 0 (AC-1.3: absent pieces report as zeros/nulls).\\n    10\\t  events: { count: number; span: { first: number; last: number } | null };\\n    11\\t  // Deleted contract (AC-1.2): deleted messages appear only in `deleted` —\\n    12\\t  // excluded from visible, byKind, and visibleTokens; event counts above are\\n    13\\t  // unaffected (the record retains everything).\\n    14\\t  messages: {\\n    15\\t    visible: number;\\n    16\\t    byKind: Record<string, number>;\\n    17\\t    deleted: number;\\n    18\\t    visibleTokens: number;\\n    19\\t  };\\n    20\\t  turns: { open: number; closed: number };\\n    21\\t  chunks: { count: number; unchunkedTurns: number };\\n    22\\t  // Counts by operational state across both owners' report surfaces; ready\\n    23\\t  // included (AC-1.1 — unlike ViewStatus, which reports situations only).\\n    24\\t  derivation: {\\n    25\\t    ready: number;\\n    26\\t    pending: number;\\n    27\\t    retrying: number;\\n    28\\t    failed: number;\\n    29\\t    blocked: number;\\n    30\\t  };\\n    31\\t  // Active-view summary, or null when never compacted (AC-1.1).\\n    32\\t  view: {\\n    33\\t    viewId: string;\\n    34\\t    createdAt: string;\\n    35\\t    compactPoint: number;\\n    36\\t    coveredFrom: number;\\n    37\\t  } | null;\\n    38\\t  visibility: { boundaryPosition: number; zoneTokens: number };\\n    39\\t}\\n    40\\t\\n    41\\t// Story 3's shape, pinned with the domain so the inspect vocabulary lands\\n    42\\t// whole (tech design §Interface Definitions); `inspect.view` serves it.\\n    43\\texport interface ViewContentsReport {\\n    44\\t  meta: {\\n    45\\t    viewId: string;\\n    46\\t    createdAt: string;\\n    47\\t    profile: string | null;\\n    48\\t    config: { lowerBound: number; percentages: Record<string, number> };\\n    49\\t    compactPoint: number;\\n    50\\t    coveredFrom: number;\\n    51\\t  } | null;\\n    52\\t  bands: Array<{\\n    53\\t    band: Band;\\n    54\\t    entries: Array<{\\n    55\\t      subjectKind: \\\"chunk\\\" | \\\"turn\\\";\\n    56\\t      subjectId: string;\\n    57\\t      formUsed: string;\\n    58\\t      degraded: boolean;\\n    59\\t    }>;\\n    60\\t    storedTokens: number;\\n    61\\t  }>;\\n    62\\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\\n    63\\t  tail: { messageCount: number; tokens: number }; // as served (AC-2.2)\\n    64\\t  // loadCost totals what pull serves NOW (AC-2.3): band and tail tokens are\\n    65\\t  // both measured over pull's served messages with the shared estimator, so\\n    66\\t  // equality with an independent pull is structural. The stored per-band\\n    67\\t  // counts stay reported above (bands[].storedTokens, AC-2.1) — they price\\n    68\\t  // the snapshot bytes without the served band-marker header, so they are\\n    69\\t  // describe's truth, not the serving cost.\\n    70\\t  loadCost: { bandTokens: number; tailTokens: number; total: number }; // = pull (AC-2.3)\\n    71\\t  // Provenance verbatim (AC-2.5); null on a never-compacted thread — no\\n    72\\t  // compact ever recorded what it saw, and inventing zeros would fabricate\\n    73\\t  // provenance (AC-2.4's view-null shape extends here).\\n    74\\t  sourceState: { maxEventOrder: number; formCounts: Record<string, number> } | null;\\n    75\\t}\\n    76\\t\\n    77\\texport interface HealthReport {\\n    78\\t  // Counts by owner, form kind, and operational state (AC-4.1), assembled\\n    79\\t  // entirely from the owners' report surfaces.\\n    80\\t  owners: Array<{\\n    81\\t    owner: \\\"messages\\\" | \\\"turns\\\";\\n    82\\t    kind: string;\\n    83\\t    counts: {\\n    84\\t      ready: number;\\n    85\\t      pending: number;\\n    86\\t      retrying: number;\\n    87\\t      failed: number;\\n    88\\t      blocked: number;\\n    89\\t    };\\n    90\\t  }>;\\n    91\\t  // Actionable failure detail (AC-4.2): enough to decide and target a\\n    92\\t  // requeue without raw SQL.\\n    93\\t  failures: Array<{\\n    94\\t    owner: string;\\n    95\\t    subjectKind: string;\\n    96\\t    subjectId: string;\\n    97\\t    form: string;\\n    98\\t    reason: string;\\n    99\\t    attempts: number;\\n   100\\t    lastError?: string;\\n   101\\t  }>;\\n   102\\t  // What a requeue pass would touch — failed and not blocked — reported,\\n   103\\t  // never executed (AC-4.3).\\n   104\\t  repairPreview: Array<{\\n   105\\t    owner: string;\\n   106\\t    subjectKind: string;\\n   107\\t    subjectId: string;\\n   108\\t    form: string;\\n   109\\t  }>;\\n   110\\t  // Live queue visibility from the owners' queue detail (AC-4.5), counted\\n   111\\t  // per report entry so the section is consistent by construction with the\\n   112\\t  // pending/retrying state counts in the same report.\\n   113\\t  queue: { queued: number; claimed: number };\\n   114\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/test/inspect-view.test.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/internal/render.ts | sed -n '1,220p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_17\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/domains/thread-view/internal/render.ts | sed -n '1,220p'\\\"\",\"aggregated_output\":\"     1\\t// Tail and band formatting (Story 1): the seven-kind tail mapping table\\n     2\\t// (tech design §Tail message rendering — contract, not implementation\\n     3\\t// choice), short/full tool-result selection by boundary position, and the\\n     4\\t// short-form ladder (ready summary → deterministic truncation). Pure\\n     5\\t// functions over read state by design: no DB handle, no provider, no clock —\\n     6\\t// determinism is structural (AC-1.7 byte-identical pulls fall out of it).\\n     7\\t//\\n     8\\t// Story 2 adds the band-entry side: the degrade ladders (tech design\\n     9\\t// §Degrade ladders), gap entries as the last rung (never absence, AC-2.5),\\n    10\\t// visible subject keys (§t12 / §c4, AC-2.10), the [degraded: …] and\\n    11\\t// [inter-turn note] markers, and band-text assembly. select.ts consumes the\\n    12\\t// same entry renderer to price entries during the fill walk, so the tokens\\n    13\\t// the walk budgets are the tokens the band stores — one renderer, no drift.\\n    14\\timport type { Band, ViewMessage } from \\\"../../../shared/view.js\\\";\\n    15\\timport type { TailMessageRow } from \\\"./snapshot.js\\\";\\n    16\\t\\n    17\\t// Epic 01's deterministic abbreviation rule: a fixed prefix plus an exact\\n    18\\t// tail marker, a pure function of the input string alone. Restated here —\\n    19\\t// byte-identical to turns/internal/compose.ts's truncateForFallback —\\n    20\\t// because cross-domain internals may not be imported and the turns domain\\n    21\\t// is frozen for this epic (tech design §Top-Tier Surfaces: no changes).\\n    22\\texport const ABBREVIATION_LIMIT = 200;\\n    23\\t\\n    24\\texport function deterministicTruncation(text: string): string {\\n    25\\t  if (text.length <= ABBREVIATION_LIMIT) return text;\\n    26\\t  const dropped = text.length - ABBREVIATION_LIMIT;\\n    27\\t  return `${text.slice(0, ABBREVIATION_LIMIT)}… [truncated ${dropped} chars]`;\\n    28\\t}\\n    29\\t\\n    30\\tfunction blockContent(message: TailMessageRow): Record<string, unknown> {\\n    31\\t  return message.blocks[0]?.content ?? {};\\n    32\\t}\\n    33\\t\\n    34\\tfunction textOf(message: TailMessageRow): string {\\n    35\\t  const text = blockContent(message)[\\\"text\\\"];\\n    36\\t  return typeof text === \\\"string\\\" ? text : \\\"\\\";\\n    37\\t}\\n    38\\t\\n    39\\t// What the tail renderer needs beyond the message itself: the boundary\\n    40\\t// position (short/full selection), the call-id → tool-name pairing (results\\n    41\\t// carry only their call id), and the ready tool-result summaries (the\\n    42\\t// short-form ladder's first rung).\\n    43\\texport interface TailRenderContext {\\n    44\\t  boundaryPosition: number;\\n    45\\t  toolNameByCallId: ReadonlyMap<string, string>;\\n    46\\t  toolResultSummaries: ReadonlyMap<string, string>;\\n    47\\t}\\n    48\\t\\n    49\\t// The call-id → tool-name map from the messages in hand. Pairing within the\\n    50\\t// tail is structurally sufficient: the compact point snaps to a turn start,\\n    51\\t// so a tail result's call is never behind it.\\n    52\\texport function toolNamesByCallId(\\n    53\\t  messages: readonly TailMessageRow[],\\n    54\\t): Map<string, string> {\\n    55\\t  const names = new Map<string, string>();\\n    56\\t  for (const message of messages) {\\n    57\\t    if (message.kind !== \\\"tool_call\\\") continue;\\n    58\\t    const block = blockContent(message);\\n    59\\t    const callId = block[\\\"toolCallId\\\"];\\n    60\\t    const toolName = block[\\\"toolName\\\"];\\n    61\\t    if (typeof callId === \\\"string\\\" && typeof toolName === \\\"string\\\") {\\n    62\\t      names.set(callId, toolName);\\n    63\\t    }\\n    64\\t  }\\n    65\\t  return names;\\n    66\\t}\\n    67\\t\\n    68\\tfunction renderToolCall(message: TailMessageRow): ViewMessage {\\n    69\\t  const block = blockContent(message);\\n    70\\t  const name = typeof block[\\\"toolName\\\"] === \\\"string\\\" ? block[\\\"toolName\\\"] : \\\"unknown_tool\\\";\\n    71\\t  // Deterministic arg rendering: the projected arguments serialized verbatim,\\n    72\\t  // oversized args abbreviated by the same Epic 01 rule.\\n    73\\t  const args = deterministicTruncation(JSON.stringify(block[\\\"arguments\\\"] ?? {}));\\n    74\\t  return { role: \\\"assistant\\\", content: `[tool call · ${name}] ${args}` };\\n    75\\t}\\n    76\\t\\n    77\\tfunction renderToolResult(message: TailMessageRow, ctx: TailRenderContext): ViewMessage {\\n    78\\t  const block = blockContent(message);\\n    79\\t  const callId = block[\\\"toolCallId\\\"];\\n    80\\t  const name =\\n    81\\t    (typeof callId === \\\"string\\\" ? ctx.toolNameByCallId.get(callId) : undefined) ??\\n    82\\t    \\\"unknown_tool\\\";\\n    83\\t  const content = typeof block[\\\"content\\\"] === \\\"string\\\" ? block[\\\"content\\\"] : \\\"\\\";\\n    84\\t  if (message.sourceEventOrder > ctx.boundaryPosition) {\\n    85\\t    return { role: \\\"user\\\", content: `[tool result · ${name}]\\\\n${content}` };\\n    86\\t  }\\n    87\\t  // At-or-behind the boundary: the short-form ladder — the ready summary\\n    88\\t  // when usable, else deterministic truncation of the raw content (AC-4.2's\\n    89\\t  // vocabulary; the default-boundary leg lands here in Story 1). Short-form\\n    90\\t  // rendering marks that fuller content exists in the record.\\n    91\\t  const short = ctx.toolResultSummaries.get(message.messageId) ?? deterministicTruncation(content);\\n    92\\t  return {\\n    93\\t    role: \\\"user\\\",\\n    94\\t    content: `[tool result · ${name} · abridged]\\\\n${short} [full content in record §${message.messageId}]`,\\n    95\\t  };\\n    96\\t}\\n    97\\t\\n    98\\t// One tail message → one ViewMessage per the mapping table. Each kind is its\\n    99\\t// own arm so a single kind's drift fails its own named test leg.\\n   100\\texport function renderTailMessage(\\n   101\\t  message: TailMessageRow,\\n   102\\t  ctx: TailRenderContext,\\n   103\\t): ViewMessage {\\n   104\\t  switch (message.kind) {\\n   105\\t    case \\\"user_prompt\\\":\\n   106\\t      return { role: \\\"user\\\", content: textOf(message) };\\n   107\\t    case \\\"assistant_text\\\":\\n   108\\t      return { role: \\\"assistant\\\", content: textOf(message) };\\n   109\\t    case \\\"assistant_thinking\\\":\\n   110\\t      // Included: the tail is full fidelity (bands compress thinking away for\\n   111\\t      // older turns); harness-side conversion may re-block or drop.\\n   112\\t      return { role: \\\"assistant\\\", content: `[thinking]\\\\n${textOf(message)}\\\\n[/thinking]` };\\n   113\\t    case \\\"tool_call\\\":\\n   114\\t      return renderToolCall(message);\\n   115\\t    case \\\"tool_result\\\":\\n   116\\t      return renderToolResult(message, ctx);\\n   117\\t    case \\\"runtime_note\\\":\\n   118\\t      return { role: \\\"user\\\", content: `[runtime note] ${textOf(message)}` };\\n   119\\t  }\\n   120\\t}\\n   121\\t\\n   122\\t// One non-empty band → one labeled `user` message: band-marker header, then\\n   123\\t// the snapshot bytes verbatim (AC-5.1 resolution: provider APIs reject\\n   124\\t// unknown roles; `user` is what the MVP's injection used).\\n   125\\texport function renderBandMessage(band: Band, renderedText: string): ViewMessage {\\n   126\\t  return { role: \\\"user\\\", band, content: `[context · ${band}]\\\\n${renderedText}` };\\n   127\\t}\\n   128\\t\\n   129\\t// ── band entries: degrade ladders, gaps, keys (Story 2) ──────────\\n   130\\t\\n   131\\t// One derived form's stored state as the ladder reads it (a projection of\\n   132\\t// DerivedForm: the resolvers never write, never re-derive).\\n   133\\texport interface FormSnapshot {\\n   134\\t  state: \\\"pending\\\" | \\\"ready\\\" | \\\"failed\\\" | \\\"blocked\\\";\\n   135\\t  content?: string;\\n   136\\t  reason?: string;\\n   137\\t}\\n   138\\t\\n   139\\texport type FormLookup = (subjectId: string, form: string) => FormSnapshot | undefined;\\n   140\\t\\n   141\\t// A subject's resolved representation: which rung of its ladder renders.\\n   142\\t// `formUsed` is the arrangement/receipt vocabulary; `degradedMarker` is the\\n   143\\t// rendered [degraded: …] text for fallback rungs.\\n   144\\texport interface ResolvedRepresentation {\\n   145\\t  formUsed: string;\\n   146\\t  body: string;\\n   147\\t  degraded: boolean;\\n   148\\t  gap: boolean;\\n   149\\t  degradedMarker?: string;\\n   150\\t  reason?: string;\\n   151\\t}\\n   152\\t\\n   153\\tfunction usable(form: FormSnapshot | undefined): form is FormSnapshot & { content: string } {\\n   154\\t  // \\\"Usable\\\" means state = ready (tech design §Degrade ladders).\\n   155\\t  return form?.state === \\\"ready\\\" && typeof form.content === \\\"string\\\";\\n   156\\t}\\n   157\\t\\n   158\\tfunction ladderState(form: FormSnapshot | undefined): string {\\n   159\\t  return form === undefined ? \\\"absent\\\" : form.state;\\n   160\\t}\\n   161\\t\\n   162\\t// Smooth (turn) ladder: turn_rendering → lower_band_projection →\\n   163\\t// deterministic excerpt of the turn's live messages → gap entry.\\n   164\\texport function resolveSmoothRepresentation(\\n   165\\t  turnId: string,\\n   166\\t  lookup: FormLookup,\\n   167\\t  excerpt: string | null,\\n   168\\t): ResolvedRepresentation {\\n   169\\t  const rendering = lookup(turnId, \\\"turn_rendering\\\");\\n   170\\t  if (usable(rendering)) {\\n   171\\t    return { formUsed: \\\"turn_rendering\\\", body: rendering.content, degraded: false, gap: false };\\n   172\\t  }\\n   173\\t  const projection = lookup(turnId, \\\"lower_band_projection\\\");\\n   174\\t  if (usable(projection)) {\\n   175\\t    return {\\n   176\\t      formUsed: \\\"lower_band_projection\\\",\\n   177\\t      body: projection.content,\\n   178\\t      degraded: true,\\n   179\\t      gap: false,\\n   180\\t      degradedMarker: \\\"smooth-from-projection\\\",\\n   181\\t    };\\n   182\\t  }\\n   183\\t  if (excerpt !== null) {\\n   184\\t    return {\\n   185\\t      formUsed: \\\"message_excerpt\\\",\\n   186\\t      body: deterministicTruncation(excerpt),\\n   187\\t      degraded: true,\\n   188\\t      gap: false,\\n   189\\t      degradedMarker: \\\"smooth-from-excerpt\\\",\\n   190\\t    };\\n   191\\t  }\\n   192\\t  return {\\n   193\\t    formUsed: \\\"gap\\\",\\n   194\\t    body: \\\"\\\",\\n   195\\t    degraded: false,\\n   196\\t    gap: true,\\n   197\\t    reason: `no usable form (turn_rendering: ${ladderState(rendering)}, lower_band_projection: ${ladderState(projection)}, no live messages)`,\\n   198\\t  };\\n   199\\t}\\n   200\\t\\n   201\\t// Detailed (chunk) ladder: chunk_summary_detailed → chunk_summary_brief →\\n   202\\t// concatenated member projections (truncated, marked) → gap entry.\\n   203\\texport function resolveDetailedRepresentation(\\n   204\\t  chunkId: string,\\n   205\\t  lookup: FormLookup,\\n   206\\t  memberProjections: readonly string[],\\n   207\\t): ResolvedRepresentation {\\n   208\\t  const detailed = lookup(chunkId, \\\"chunk_summary_detailed\\\");\\n   209\\t  if (usable(detailed)) {\\n   210\\t    return { formUsed: \\\"chunk_summary_detailed\\\", body: detailed.content, degraded: false, gap: false };\\n   211\\t  }\\n   212\\t  const brief = lookup(chunkId, \\\"chunk_summary_brief\\\");\\n   213\\t  if (usable(brief)) {\\n   214\\t    return {\\n   215\\t      formUsed: \\\"chunk_summary_brief\\\",\\n   216\\t      body: brief.content,\\n   217\\t      degraded: true,\\n   218\\t      gap: false,\\n   219\\t      degradedMarker: \\\"detailed-from-brief\\\",\\n   220\\t    };\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_16\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/test/inspect-view.test.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"     1\\t// Story 3 (Epic 04), default suite: TC-2.1–2.3 — the view-contents report\\n     2\\t// plus the describe legs. `threadView.describe` exposes the stored active\\n     3\\t// view row verbatim (null when absent, never recomputed); `inspect.view`\\n     4\\t// composes describe + a measured pull so loadCost equals what pull serves\\n     5\\t// now (AC-2.3, parity by construction) — asserted here against an\\n     6\\t// INDEPENDENT pull re-measured with the same estimator, on a compacted\\n     7\\t// fixture, a boundary-advanced fixture (short forms costed short, AC-2.2),\\n     8\\t// and a never-compacted thread (meta null, tail-only, AC-2.4). Reads are\\n     9\\t// pure (AC-1.4 contract): read-only delta assert, zero provider calls.\\n    10\\timport { DatabaseSync } from \\\"node:sqlite\\\";\\n    11\\timport { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n    12\\timport {\\n    13\\t  createSdk,\\n    14\\t  estimateTokens,\\n    15\\t  runCli,\\n    16\\t  type DerivationProvider,\\n    17\\t  type Lhc,\\n    18\\t  type MessageEventInput,\\n    19\\t  type StoredView,\\n    20\\t  type ViewContentsReport,\\n    21\\t} from \\\"../src/index.js\\\";\\n    22\\timport {\\n    23\\t  createProviderDouble,\\n    24\\t  derivedThreadFixture,\\n    25\\t  expectReadOnly,\\n    26\\t  tempStore,\\n    27\\t  validEvent,\\n    28\\t  type DerivedThreadFixture,\\n    29\\t  type TempStore,\\n    30\\t} from \\\"./fixtures/index.js\\\";\\n    31\\t\\n    32\\tlet store: TempStore;\\n    33\\tbeforeEach(() => {\\n    34\\t  store = tempStore();\\n    35\\t});\\n    36\\tafterEach(() => {\\n    37\\t  store.cleanup();\\n    38\\t});\\n    39\\t\\n    40\\tfunction valueOf<T>(result: { ok: boolean }): T {\\n    41\\t  if (!result.ok) throw new Error(`expected ok result: ${JSON.stringify(result)}`);\\n    42\\t  return (result as { ok: true; value: T }).value;\\n    43\\t}\\n    44\\t\\n    45\\tfunction measured(messages: ReadonlyArray<{ content: string }>): number {\\n    46\\t  return messages.reduce((sum, message) => sum + estimateTokens(message.content), 0);\\n    47\\t}\\n    48\\t\\n    49\\t// Independent stored-row read (anti-shim: the report and describe are\\n    50\\t// compared against the raw thread_view/thread_view_band rows through this\\n    51\\t// separate path, not against each other alone).\\n    52\\tfunction readRawStoredView(filePath: string): StoredView | null {\\n    53\\t  const db = new DatabaseSync(filePath);\\n    54\\t  try {\\n    55\\t    const header = db\\n    56\\t      .prepare(\\n    57\\t        `SELECT view_id, created_at, compact_point, covered_from, profile_name,\\n    58\\t                config_json, arrangement_json, gaps_json, source_state_json\\n    59\\t         FROM thread_view WHERE singleton = 1`,\\n    60\\t      )\\n    61\\t      .get() as\\n    62\\t      | {\\n    63\\t          view_id: string;\\n    64\\t          created_at: string;\\n    65\\t          compact_point: number | bigint;\\n    66\\t          covered_from: number | bigint;\\n    67\\t          profile_name: string | null;\\n    68\\t          config_json: string;\\n    69\\t          arrangement_json: string;\\n    70\\t          gaps_json: string;\\n    71\\t          source_state_json: string;\\n    72\\t        }\\n    73\\t      | undefined;\\n    74\\t    if (header === undefined) return null;\\n    75\\t    const bandRows = db\\n    76\\t      .prepare(`SELECT band, token_count FROM thread_view_band WHERE view_id = ?`)\\n    77\\t      .all(header.view_id) as unknown as Array<{ band: string; token_count: number | bigint }>;\\n    78\\t    const byBand = new Map(bandRows.map((row) => [row.band, row]));\\n    79\\t    return {\\n    80\\t      viewId: header.view_id,\\n    81\\t      createdAt: header.created_at,\\n    82\\t      compactPoint: Number(header.compact_point),\\n    83\\t      coveredFrom: Number(header.covered_from),\\n    84\\t      profileName: header.profile_name,\\n    85\\t      config: JSON.parse(header.config_json) as StoredView[\\\"config\\\"],\\n    86\\t      arrangement: JSON.parse(header.arrangement_json) as StoredView[\\\"arrangement\\\"],\\n    87\\t      gaps: JSON.parse(header.gaps_json) as StoredView[\\\"gaps\\\"],\\n    88\\t      sourceState: JSON.parse(header.source_state_json) as StoredView[\\\"sourceState\\\"],\\n    89\\t      bands: ([\\\"brief\\\", \\\"detailed\\\", \\\"smooth\\\"] as const).flatMap((band) => {\\n    90\\t        const row = byBand.get(band);\\n    91\\t        return row === undefined ? [] : [{ band, storedTokens: Number(row.token_count) }];\\n    92\\t      }),\\n    93\\t    };\\n    94\\t  } finally {\\n    95\\t    db.close();\\n    96\\t  }\\n    97\\t}\\n    98\\t\\n    99\\t// The report's band sections regrouped from the raw row, independently of\\n   100\\t// view-report.ts: arrangement entries per band in served order, stored band\\n   101\\t// token counts verbatim.\\n   102\\tfunction bandsFromRaw(raw: StoredView): ViewContentsReport[\\\"bands\\\"] {\\n   103\\t  return ([\\\"brief\\\", \\\"detailed\\\", \\\"smooth\\\"] as const).flatMap((band) => {\\n   104\\t    const entries = raw.arrangement\\n   105\\t      .filter((entry) => entry.band === band)\\n   106\\t      .map((entry) => ({\\n   107\\t        subjectKind: entry.subjectKind,\\n   108\\t        subjectId: entry.subjectId,\\n   109\\t        formUsed: entry.formUsed,\\n   110\\t        degraded: entry.degraded,\\n   111\\t      }));\\n   112\\t    const stored = raw.bands.find((row) => row.band === band);\\n   113\\t    if (entries.length === 0 && stored === undefined) return [];\\n   114\\t    return [{ band, entries, storedTokens: stored?.storedTokens ?? 0 }];\\n   115\\t  });\\n   116\\t}\\n   117\\t\\n   118\\t// The TC-2.1 substrate: the tool-heavy fixture with one degraded entry and\\n   119\\t// one gap reached through production paths — post-build edits (not drained)\\n   120\\t// clear t8's turn forms (the smooth entry degrades down its ladder) and all\\n   121\\t// of c2's chain (summaries pending, zero ready member projections: the gap\\n   122\\t// rung). Same recipe Epic 03's degraded compact proved; params force the\\n   123\\t// chunk bands so profileName stores null and config carries the resolved\\n   124\\t// truth.\\n   125\\tconst DEGRADED_COMPACT_PARAMS = {\\n   126\\t  lowerBound: 400,\\n   127\\t  percentages: { full: 25, smooth: 25, detailed: 10, brief: 40 },\\n   128\\t};\\n   129\\t\\n   130\\tasync function degradedCompactedThread(): Promise<DerivedThreadFixture> {\\n   131\\t  const fixture = await derivedThreadFixture(store, { failures: false });\\n   132\\t  const { sdk, filePath } = fixture;\\n   133\\t  const listed = await sdk.messages.listMessages({ filePath });\\n   134\\t  if (!listed.ok) throw new Error(`fixture list failed: ${listed.error.reason}`);\\n   135\\t  for (const turn of [\\\"t4\\\", \\\"t5\\\", \\\"t6\\\", \\\"t8\\\"]) {\\n   136\\t    const target = listed.value.find(\\n   137\\t      (record) => record.kind === \\\"user_prompt\\\" && record.turnId === turn,\\n   138\\t    );\\n   139\\t    if (target === undefined) throw new Error(`fixture invariant: no prompt in ${turn}`);\\n   140\\t    const edited = await sdk.messages.edit(\\n   141\\t      { filePath },\\n   142\\t      { messageId: target.messageId, content: `${turn} revised: investigate the area again` },\\n   143\\t    );\\n   144\\t    if (!edited.ok) throw new Error(`fixture edit failed: ${edited.error.reason}`);\\n   145\\t  }\\n   146\\t  const compacted = await sdk.threadView.compact(\\n   147\\t    { filePath },\\n   148\\t    { params: DEGRADED_COMPACT_PARAMS },\\n   149\\t  );\\n   150\\t  if (!compacted.ok) throw new Error(`fixture compact failed: ${compacted.error.reason}`);\\n   151\\t  return fixture;\\n   152\\t}\\n   153\\t\\n   154\\t// A small never-compacted thread: two closed turns, fully drained.\\n   155\\tasync function neverCompactedThread(): Promise<{ filePath: string; sdk: Lhc }> {\\n   156\\t  const double = createProviderDouble();\\n   157\\t  const sdk = createSdk({ provider: double, mode: \\\"manual\\\" });\\n   158\\t  const filePath = store.threadPath();\\n   159\\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n   160\\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\\n   161\\t  const batches: MessageEventInput[][] = [\\n   162\\t    [\\n   163\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"please read notes.txt\\\" } }),\\n   164\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"reading it now\\\" } }),\\n   165\\t      validEvent(\\\"tool_call\\\", {\\n   166\\t        payload: { toolCallId: \\\"call-iv-1\\\", toolName: \\\"read_file\\\", arguments: { path: \\\"notes.txt\\\" } },\\n   167\\t      }),\\n   168\\t      validEvent(\\\"tool_result\\\", {\\n   169\\t        payload: { toolCallId: \\\"call-iv-1\\\", content: \\\"contents of notes.txt\\\", isError: false },\\n   170\\t      }),\\n   171\\t      validEvent(\\\"turn_end\\\"),\\n   172\\t    ],\\n   173\\t    [\\n   174\\t      validEvent(\\\"user_prompt\\\", { payload: { text: \\\"summarize what you read\\\" } }),\\n   175\\t      validEvent(\\\"assistant_text\\\", { payload: { text: \\\"here is the summary\\\" } }),\\n   176\\t      validEvent(\\\"turn_end\\\"),\\n   177\\t    ],\\n   178\\t  ];\\n   179\\t  for (const batch of batches) {\\n   180\\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, batch);\\n   181\\t    if (!sent.ok) throw new Error(`fixture batch failed: ${sent.error.reason}`);\\n   182\\t  }\\n   183\\t  const drained = await sdk.work.drain({ filePath });\\n   184\\t  if (!drained.ok || drained.value.remaining !== 0) {\\n   185\\t    throw new Error(\\\"fixture drain left work behind\\\");\\n   186\\t  }\\n   187\\t  return { filePath, sdk };\\n   188\\t}\\n   189\\t\\n   190\\tfunction tokens(n: number): string {\\n   191\\t  return Array<string>(n).fill(\\\"tok\\\").join(\\\" \\\");\\n   192\\t}\\n   193\\t\\n   194\\tdescribe(\\\"TC-2.1 / AC-2.1, AC-2.5: arrangement fidelity from the stored snapshot\\\", () => {\\n   195\\t  it(\\\"report entries, forms, degraded flags, gap reasons, config, and provenance equal describe output and the stored row\\\", async () => {\\n   196\\t    const { filePath, sdk } = await degradedCompactedThread();\\n   197\\t    const raw = readRawStoredView(filePath);\\n   198\\t    expect(raw).not.toBeNull();\\n   199\\t    if (raw === null) return;\\n   200\\t\\n   201\\t    // describe leg: the stored row verbatim through the surface.\\n   202\\t    const described = valueOf<StoredView | null>(await sdk.threadView.describe({ filePath }));\\n   203\\t    expect(described).toEqual(raw);\\n   204\\t\\n   205\\t    const report = valueOf<ViewContentsReport>(await sdk.inspect.view({ filePath }));\\n   206\\t    // Meta: identity, profile (null — explicit params), resolved config,\\n   207\\t    // window — the row's fields, never re-resolved.\\n   208\\t    expect(report.meta).toEqual({\\n   209\\t      viewId: raw.viewId,\\n   210\\t      createdAt: raw.createdAt,\\n   211\\t      profile: null,\\n   212\\t      config: {\\n   213\\t        lowerBound: DEGRADED_COMPACT_PARAMS.lowerBound,\\n   214\\t        percentages: DEGRADED_COMPACT_PARAMS.percentages,\\n   215\\t      },\\n   216\\t      compactPoint: raw.compactPoint,\\n   217\\t      coveredFrom: raw.coveredFrom,\\n   218\\t    });\\n   219\\t    expect(report.meta?.config).toEqual(raw.config);\\n   220\\t\\n   221\\t    // Every band entry in served order with form/degraded verbatim; per-band\\n   222\\t    // stored token counts; every gap with its reason — all from the row.\\n   223\\t    expect(report.bands).toEqual(bandsFromRaw(raw));\\n   224\\t    expect(report.gaps).toEqual(raw.gaps);\\n   225\\t    expect(report.sourceState).toEqual(raw.sourceState);\\n   226\\t\\n   227\\t    // Fixture sanity: the degraded entry (t8's smooth fallback) and the gap\\n   228\\t    // (c2, no usable form) both present and named.\\n   229\\t    const entries = report.bands.flatMap((band) => band.entries);\\n   230\\t    expect(entries.some((entry) => entry.subjectId === \\\"t8\\\" && entry.degraded)).toBe(true);\\n   231\\t    expect(report.gaps.length).toBeGreaterThanOrEqual(1);\\n   232\\t    expect(report.gaps.some((gap) => gap.subjectId === \\\"c2\\\" && /no usable form/.test(gap.reason))).toBe(\\n   233\\t      true,\\n   234\\t    );\\n   235\\t\\n   236\\t    // Load-cost parity on the compacted shape too (bands + tail): an\\n   237\\t    // independent pull re-measured with the same estimator.\\n   238\\t    const pulled = valueOf<{ messages: Array<{ content: string; band?: string }> }>(\\n   239\\t      await sdk.threadView.pull({ filePath }),\\n   240\\t    );\\n   241\\t    expect(report.loadCost.total).toBe(measured(pulled.messages));\\n   242\\t    expect(report.loadCost.bandTokens).toBe(\\n   243\\t      measured(pulled.messages.filter((message) => message.band !== undefined)),\\n   244\\t    );\\n   245\\t    expect(report.loadCost.total).toBe(report.loadCost.bandTokens + report.loadCost.tailTokens);\\n   246\\t    expect(report.tail.messageCount).toBe(\\n   247\\t      pulled.messages.filter((message) => message.band === undefined).length,\\n   248\\t    );\\n   249\\t  });\\n   250\\t\\n   251\\t  it(\\\"describe returns ok/null on a never-compacted thread and thread_not_found on a missing one\\\", async () => {\\n   252\\t    const { filePath, sdk } = await neverCompactedThread();\\n   253\\t    const described = await sdk.threadView.describe({ filePath });\\n   254\\t    expect(described.ok).toBe(true);\\n   255\\t    if (described.ok) expect(described.value).toBeNull();\\n   256\\t    expect(readRawStoredView(filePath)).toBeNull();\\n   257\\t\\n   258\\t    const missing = await sdk.threadView.describe({ filePath: store.threadPath(\\\"missing\\\") });\\n   259\\t    expect(missing.ok).toBe(false);\\n   260\\t    if (!missing.ok) {\\n   261\\t      expect(missing.error.errorClass).toBe(\\\"caller_error\\\");\\n   262\\t      expect(missing.error.code).toBe(\\\"thread_not_found\\\");\\n   263\\t    }\\n   264\\t  });\\n   265\\t});\\n   266\\t\\n   267\\tdescribe(\\\"TC-2.2 / AC-2.2, AC-2.3: loadCost parity on a boundary-advanced fixture\\\", () => {\\n   268\\t  it(\\\"tail costs short forms short and total equals an independent pull re-measured\\\", async () => {\\n   269\\t    // Small budgets so a real intake post-commit advance moves the boundary\\n   270\\t    // into the tail (Epic 03 Story 4 mechanics — never a hand-set position).\\n   271\\t    const sdk = createSdk({\\n   272\\t      provider: createProviderDouble(),\\n   273\\t      mode: \\\"manual\\\",\\n   274\\t      view: { visibility: { maxTokens: 100, targetTokens: 60, floorTokens: 30 } },\\n   275\\t    });\\n   276\\t    const filePath = store.threadPath();\\n   277\\t    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\\n   278\\t    if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\\n   279\\t\\n   280\\t    // Six plain turns, drained, then a compact small enough to leave bands\\n   281\\t    // and a real compact point.\\n   282\\t    for (let turn = 1; turn <= 6; turn += 1) {\\n   283\\t      const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n   284\\t        validEvent(\\\"user_prompt\\\", { payload: { text: `turn ${turn}: please investigate area ${turn}` } }),\\n   285\\t        validEvent(\\\"assistant_text\\\", { payload: { text: `findings for area ${turn}` } }),\\n   286\\t        validEvent(\\\"turn_end\\\"),\\n   287\\t      ]);\\n   288\\t      if (!sent.ok) throw new Error(`intake failed: ${sent.error.reason}`);\\n   289\\t      const drained = await sdk.work.drain({ filePath });\\n   290\\t      if (!drained.ok) throw new Error(`drain failed: ${drained.error.reason}`);\\n   291\\t    }\\n   292\\t    const compacted = await sdk.threadView.compact(\\n   293\\t      { filePath },\\n   294\\t      { params: { lowerBound: 60, percentages: { full: 25, smooth: 25, detailed: 10, brief: 40 } } },\\n   295\\t    );\\n   296\\t    expect(compacted.ok).toBe(true);\\n   297\\t    if (!compacted.ok) return;\\n   298\\t\\n   299\\t    // Two post-compact tool turns (80-token results). The second batch\\n   300\\t    // crosses max (zone 160 > 100): the advance flips the older result\\n   301\\t    // behind the boundary; the newer one is floor-protected and stays full.\\n   302\\t    for (const run of [1, 2]) {\\n   303\\t      const sent = await sdk.intakeStream.messageEvents({ filePath }, [\\n   304\\t        validEvent(\\\"user_prompt\\\", { payload: { text: `post-compact tool run ${run}` } }),\\n   305\\t        validEvent(\\\"tool_call\\\", {\\n   306\\t          payload: { toolCallId: `call-adv-${run}`, toolName: \\\"read_file\\\", arguments: { path: `adv-${run}.txt` } },\\n   307\\t        }),\\n   308\\t        validEvent(\\\"tool_result\\\", {\\n   309\\t          payload: { toolCallId: `call-adv-${run}`, content: tokens(80), isError: false },\\n   310\\t        }),\\n   311\\t        validEvent(\\\"turn_end\\\"),\\n   312\\t      ]);\\n   313\\t      if (!sent.ok) throw new Error(`intake failed: ${sent.error.reason}`);\\n   314\\t    }\\n   315\\t\\n   316\\t    const pulled = valueOf<{\\n   317\\t      messages: Array<{ content: string; band?: string }>;\\n   318\\t      meta: { boundaryPosition: number; compactPoint: number | null };\\n   319\\t    }>(await sdk.threadView.pull({ filePath }));\\n   320\\t    expect(pulled.meta.boundaryPosition).toBeGreaterThan(pulled.meta.compactPoint ?? 0);\\n   321\\t    const tailServed = pulled.messages.filter((message) => message.band === undefined);\\n   322\\t    const abridged = tailServed.filter((message) => message.content.includes(\\\" · abridged]\\\"));\\n   323\\t    const fullResults = tailServed.filter(\\n   324\\t      (message) =>\\n   325\\t        message.content.startsWith(\\\"[tool result · \\\") && !message.content.includes(\\\" · abridged]\\\"),\\n   326\\t    );\\n   327\\t    expect(abridged.length).toBe(1);\\n   328\\t    expect(fullResults.length).toBe(1);\\n   329\\t    // Short forms cost short: the abridged result is cheaper as served than\\n   330\\t    // its full sibling of identical record size.\\n   331\\t    expect(estimateTokens(abridged[0]?.content ?? \\\"\\\")).toBeLessThan(\\n   332\\t      estimateTokens(fullResults[0]?.content ?? \\\"\\\"),\\n   333\\t    );\\n   334\\t\\n   335\\t    const report = valueOf<ViewContentsReport>(await sdk.inspect.view({ filePath }));\\n   336\\t    // Tail as served: count and tokens measured over the served tail —\\n   337\\t    // boundary-aware shortening inherited from pull, never re-implemented.\\n   338\\t    expect(report.tail.messageCount).toBe(tailServed.length);\\n   339\\t    expect(report.tail.tokens).toBe(measured(tailServed));\\n   340\\t    expect(report.loadCost.tailTokens).toBe(report.tail.tokens);\\n   341\\t    // The governing contract: total equals an independent pull's measured\\n   342\\t    // content under the same estimator.\\n   343\\t    expect(report.loadCost.total).toBe(measured(pulled.messages));\\n   344\\t    expect(report.loadCost.total).toBe(report.loadCost.bandTokens + report.loadCost.tailTokens);\\n   345\\t  });\\n   346\\t});\\n   347\\t\\n   348\\tdescribe(\\\"TC-2.3 / AC-2.4: never-compacted thread reports tail-only under the same parity contract\\\", () => {\\n   349\\t  it(\\\"meta null, bands empty, tail spans the record, cost parity holds\\\", async () => {\\n   350\\t    const { filePath, sdk } = await neverCompactedThread();\\n   351\\t    const report = valueOf<ViewContentsReport>(await sdk.inspect.view({ filePath }));\\n   352\\t    expect(report.meta).toBeNull();\\n   353\\t    expect(report.bands).toEqual([]);\\n   354\\t    expect(report.gaps).toEqual([]);\\n   355\\t    expect(report.sourceState).toBeNull();\\n   356\\t    expect(report.loadCost.bandTokens).toBe(0);\\n   357\\t\\n   358\\t    const pulled = valueOf<{ messages: Array<{ content: string; band?: string }> }>(\\n   359\\t      await sdk.threadView.pull({ filePath }),\\n   360\\t    );\\n   361\\t    // The whole record serves as tail: every pulled message is band-absent\\n   362\\t    // and the report counts all six visible messages.\\n   363\\t    expect(pulled.messages.every((message) => message.band === undefined)).toBe(true);\\n   364\\t    expect(report.tail.messageCount).toBe(pulled.messages.length);\\n   365\\t    expect(report.tail.messageCount).toBe(6);\\n   366\\t    expect(report.tail.tokens).toBe(measured(pulled.messages));\\n   367\\t    expect(report.loadCost.tailTokens).toBe(report.tail.tokens);\\n   368\\t    expect(report.loadCost.total).toBe(measured(pulled.messages));\\n   369\\t  });\\n   370\\t});\\n   371\\t\\n   372\\tdescribe(\\\"AC-1.4 contract: view and describe are pure reads\\\", () => {\\n   373\\t  it(\\\"repeated calls are deep-equal, leave no delta, and call no provider — including under a throwing provider\\\", async () => {\\n   374\\t    const fixture = await degradedCompactedThread();\\n   375\\t    const { filePath, sdk, double } = fixture;\\n   376\\t    const captured = double.captureInputs();\\n   377\\t\\n   378\\t    const first = await expectReadOnly(filePath, () => sdk.inspect.view({ filePath }));\\n   379\\t    const second = await expectReadOnly(filePath, () => sdk.inspect.view({ filePath }));\\n   380\\t    const describedOnce = await expectReadOnly(filePath, () =>\\n   381\\t      sdk.threadView.describe({ filePath }),\\n   382\\t    );\\n   383\\t    expect(first.ok && second.ok && describedOnce.ok).toBe(true);\\n   384\\t    expect(second).toEqual(first);\\n   385\\t    expect(captured).toHaveLength(0);\\n   386\\t\\n   387\\t    // A provider that throws on contact: both reads stay provider-free\\n   388\\t    // structurally (the zero-provider assert extended to Story 3's ops).\\n   389\\t    const refuse = (): never => {\\n   390\\t      throw new Error(\\\"provider must never be called by a read operation\\\");\\n   391\\t    };\\n   392\\t    const throwing: DerivationProvider = {\\n   393\\t      smoothPrompt: refuse,\\n   394\\t      summarizeToolCall: refuse,\\n   395\\t      summarizeToolResult: refuse,\\n   396\\t      composeTurnRendering: refuse,\\n   397\\t      projectLowerBand: refuse,\\n   398\\t      summarizeChunkDetailed: refuse,\\n   399\\t      summarizeChunkBrief: refuse,\\n   400\\t    };\\n   401\\t    const reader = createSdk({ provider: throwing, mode: \\\"manual\\\" });\\n   402\\t    const viewed = await expectReadOnly(filePath, () => reader.inspect.view({ filePath }));\\n   403\\t    const described = await expectReadOnly(filePath, () =>\\n   404\\t      reader.threadView.describe({ filePath }),\\n   405\\t    );\\n   406\\t    expect(viewed.ok && described.ok).toBe(true);\\n   407\\t  });\\n   408\\t\\n   409\\t  it(\\\"inspect.view on a missing thread is thread_not_found, not a shape error\\\", async () => {\\n   410\\t    const sdk = createSdk({ provider: createProviderDouble(), mode: \\\"manual\\\" });\\n   411\\t    const missing = await sdk.inspect.view({ filePath: store.threadPath(\\\"missing\\\") });\\n   412\\t    expect(missing.ok).toBe(false);\\n   413\\t    if (missing.ok) return;\\n   414\\t    expect(missing.error.errorClass).toBe(\\\"caller_error\\\");\\n   415\\t    expect(missing.error.code).toBe(\\\"thread_not_found\\\");\\n   416\\t  });\\n   417\\t});\\n   418\\t\\n   419\\tdescribe(\\\"CLI parity: lhc inspect view returns SDK-parity JSON\\\", () => {\\n   420\\t  it(\\\"the in-process CLI result deep-equals the SDK result on compacted and never-compacted threads\\\", async () => {\\n   421\\t    const { filePath, sdk } = await degradedCompactedThread();\\n   422\\t    const viaSdk = await sdk.inspect.view({ filePath });\\n   423\\t    const viaCli = await runCli([\\\"inspect\\\", \\\"view\\\", \\\"--file-path\\\", filePath]);\\n   424\\t    expect(viaCli.exitCode).toBe(0);\\n   425\\t    expect(JSON.parse(viaCli.stdout)).toEqual(viaSdk);\\n   426\\t\\n   427\\t    const plain = await neverCompactedThread();\\n   428\\t    const plainSdk = await plain.sdk.inspect.view({ filePath: plain.filePath });\\n   429\\t    const plainCli = await runCli([\\\"inspect\\\", \\\"view\\\", \\\"--file-path\\\", plain.filePath]);\\n   430\\t    expect(plainCli.exitCode).toBe(0);\\n   431\\t    expect(JSON.parse(plainCli.stdout)).toEqual(plainSdk);\\n   432\\t  });\\n   433\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_18\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/test/fixtures/read-only-delta.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_18\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/test/fixtures/read-only-delta.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"     1\\t// The shared read-only delta helper (Epic 04, DD-6): inspect describes,\\n     2\\t// never changes — and that is asserted as ABSENCE OF DELTA in observable\\n     3\\t// state, not absence of write code. Snapshot everything a forgotten side\\n     4\\t// effect could move — queued work through both owners, boundary/zone/view\\n     5\\t// identity through the thread-view surface, the event log, the audit message\\n     6\\t// listing, and the raw derived-form rows — before and after an operation,\\n     7\\t// and require deep equality. Lands with Story 2 and wraps Story 1's read\\n     8\\t// ops retroactively (test plan, Chunk 2).\\n     9\\timport { deepStrictEqual } from \\\"node:assert/strict\\\";\\n    10\\timport { intakeStream, messages, threadView, turns } from \\\"../../src/index.js\\\";\\n    11\\timport { readDerivedForms } from \\\"./threads.js\\\";\\n    12\\t\\n    13\\texport interface ObservableState {\\n    14\\t  events: unknown;\\n    15\\t  messages: unknown;\\n    16\\t  messageWork: unknown;\\n    17\\t  turnWork: unknown;\\n    18\\t  viewStatus: unknown;\\n    19\\t  pullMeta: unknown;\\n    20\\t  storedView: unknown;\\n    21\\t  forms: unknown;\\n    22\\t}\\n    23\\t\\n    24\\texport async function observableState(filePath: string): Promise<ObservableState> {\\n    25\\t  const pulled = await threadView.pull({ filePath });\\n    26\\t  return {\\n    27\\t    events: await intakeStream.listEvents({ filePath }),\\n    28\\t    messages: await messages.listMessages({ filePath }, { includeDeleted: true }),\\n    29\\t    messageWork: await messages.listQueuedWork({ filePath }),\\n    30\\t    turnWork: await turns.listQueuedWork({ filePath }),\\n    31\\t    viewStatus: await threadView.status({ filePath }),\\n    32\\t    pullMeta: pulled.ok ? pulled.value.meta : pulled,\\n    33\\t    // The stored snapshot whole (Story 3): a forgotten view touch — config,\\n    34\\t    // arrangement, band rows, provenance — moves this even when pull's meta\\n    35\\t    // would not show it.\\n    36\\t    storedView: await threadView.describe({ filePath }),\\n    37\\t    forms: readDerivedForms(filePath),\\n    38\\t  };\\n    39\\t}\\n    40\\t\\n    41\\t// Run one operation under the before/after snapshot and return its result so\\n    42\\t// call sites can keep asserting on it. Throws (deepStrictEqual) when the\\n    43\\t// operation moved anything observable.\\n    44\\texport async function expectReadOnly<T>(\\n    45\\t  filePath: string,\\n    46\\t  operation: () => Promise<T>,\\n    47\\t): Promise<T> {\\n    48\\t  const before = await observableState(filePath);\\n    49\\t  const result = await operation();\\n    50\\t  deepStrictEqual(\\n    51\\t    await observableState(filePath),\\n    52\\t    before,\\n    53\\t    \\\"read-only delta: operation changed observable state\\\",\\n    54\\t  );\\n    55\\t  return result;\\n    56\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/cli/index.ts | sed -n '430,490p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_20\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/cli/inspect.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_20\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/cli/inspect.ts | sed -n '1,500p'\\\"\",\"aggregated_output\":\"     1\\t// `lhc inspect overview|view|health` (Epic 04 Story 2) per tech design\\n     2\\t// §Placement: thin argv-to-SDK wrappers — no logic beyond arg mapping, so\\n     3\\t// CLI parity with the SDK result is structural (same code path, same JSON).\\n     4\\timport * as inspect from \\\"../domains/inspect/index.js\\\";\\n     5\\timport type { ThreadRef } from \\\"../domains/threads/index.js\\\";\\n     6\\timport { renderResult, type CliResult } from \\\"./render.js\\\";\\n     7\\t\\n     8\\texport async function runInspectOverview(threadRef: ThreadRef): Promise<CliResult> {\\n     9\\t  return renderResult(await inspect.overview(threadRef));\\n    10\\t}\\n    11\\t\\n    12\\texport async function runInspectHealth(threadRef: ThreadRef): Promise<CliResult> {\\n    13\\t  return renderResult(await inspect.health(threadRef));\\n    14\\t}\\n    15\\t\\n    16\\texport async function runInspectView(threadRef: ThreadRef): Promise<CliResult> {\\n    17\\t  return renderResult(await inspect.view(threadRef));\\n    18\\t}\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_19\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/cli/index.ts | sed -n '430,490p'\\\"\",\"aggregated_output\":\"   430\\t        flags.subjectId === undefined ||\\n   431\\t        flags.form === undefined\\n   432\\t      ) {\\n   433\\t        return renderCliError(\\n   434\\t          \\\"caller_error\\\",\\n   435\\t          \\\"missing_flag\\\",\\n   436\\t          \\\"turns requeue requires --subject-kind, --subject-id, and --form\\\",\\n   437\\t        );\\n   438\\t      }\\n   439\\t      if (flags.subjectKind !== \\\"turn\\\" && flags.subjectKind !== \\\"chunk\\\") {\\n   440\\t        return renderCliError(\\n   441\\t          \\\"caller_error\\\",\\n   442\\t          \\\"missing_flag\\\",\\n   443\\t          `--subject-kind must be \\\"turn\\\" or \\\"chunk\\\", got ${flags.subjectKind}`,\\n   444\\t        );\\n   445\\t      }\\n   446\\t      return runTurnsRequeue(threadRefFrom(flags), {\\n   447\\t        subjectKind: flags.subjectKind,\\n   448\\t        subjectId: flags.subjectId,\\n   449\\t        form: flags.form,\\n   450\\t      });\\n   451\\t    }\\n   452\\t    case \\\"turns delete\\\": {\\n   453\\t      const missingRef = requireThreadRef(flags, \\\"turns delete\\\");\\n   454\\t      if (missingRef !== undefined) return missingRef;\\n   455\\t      if (flags.turnId === undefined) {\\n   456\\t        return renderCliError(\\n   457\\t          \\\"caller_error\\\",\\n   458\\t          \\\"missing_flag\\\",\\n   459\\t          \\\"turns delete requires --turn (or --turn-id)\\\",\\n   460\\t        );\\n   461\\t      }\\n   462\\t      return runTurnsDelete(threadRefFrom(flags), { turnId: flags.turnId });\\n   463\\t    }\\n   464\\t    case \\\"inspect overview\\\":\\n   465\\t      return (\\n   466\\t        requireThreadRef(flags, \\\"inspect overview\\\") ??\\n   467\\t        runInspectOverview(threadRefFrom(flags))\\n   468\\t      );\\n   469\\t    case \\\"inspect health\\\":\\n   470\\t      return (\\n   471\\t        requireThreadRef(flags, \\\"inspect health\\\") ?? runInspectHealth(threadRefFrom(flags))\\n   472\\t      );\\n   473\\t    // Routed ahead of its story so the CLI mirrors the SDK surface: the stub\\n   474\\t    // returns the structured not-implemented result; Story 3 makes it real\\n   475\\t    // (and adds it to the help text).\\n   476\\t    case \\\"inspect view\\\":\\n   477\\t      return (\\n   478\\t        requireThreadRef(flags, \\\"inspect view\\\") ?? runInspectView(threadRefFrom(flags))\\n   479\\t      );\\n   480\\t    case \\\"work drain\\\": {\\n   481\\t      const missingRef = requireThreadRef(flags, \\\"work drain\\\");\\n   482\\t      if (missingRef !== undefined) return missingRef;\\n   483\\t      const drainFlags: { provider?: string; maxItems?: number } = {};\\n   484\\t      if (flags.provider !== undefined) drainFlags.provider = flags.provider;\\n   485\\t      if (flags.maxItems !== undefined) {\\n   486\\t        const maxItems = Number(flags.maxItems);\\n   487\\t        if (!Number.isInteger(maxItems) || maxItems <= 0) {\\n   488\\t          return renderCliError(\\n   489\\t            \\\"caller_error\\\",\\n   490\\t            \\\"missing_flag\\\",\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_21\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/sdk.ts | sed -n '200,420p'\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_21\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"nl -ba packages/lhc/src/sdk.ts | sed -n '200,420p'\\\"\",\"aggregated_output\":\"   200\\t  map: WorkHandlerMap,\\n   201\\t  kind: string,\\n   202\\t): OpResult<WorkHandler> {\\n   203\\t  const handler = map[kind as WorkKind];\\n   204\\t  if (handler === undefined) return unknownWorkKind(kind);\\n   205\\t  return { ok: true, value: handler };\\n   206\\t}\\n   207\\t\\n   208\\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\\n   209\\t// requeue land in Story 4.\\n   210\\texport interface WorkSurface {\\n   211\\t  drain(\\n   212\\t    ref: threadsDomain.ThreadRef,\\n   213\\t    opts?: { maxItems?: number },\\n   214\\t  ): Promise<OpResult<DrainReport>>;\\n   215\\t}\\n   216\\t\\n   217\\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\\n   218\\t// §Interface Definitions): the operations only — the Story 0 config\\n   219\\t// substrate the domain index also carries is construction machinery, not an\\n   220\\t// operation. Epic 04 Story 3 adds `describe`, the stored-snapshot read the\\n   221\\t// inspect domain composes (DD-1).\\n   222\\texport interface ThreadViewSurface {\\n   223\\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\\n   224\\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\\n   225\\t  describe(ref: threadsDomain.ThreadRef): Promise<OpResult<StoredView | null>>;\\n   226\\t  compact(\\n   227\\t    ref: threadsDomain.ThreadRef,\\n   228\\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\\n   229\\t  ): Promise<OpResult<CompactReceipt>>;\\n   230\\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\\n   231\\t  materialize(\\n   232\\t    ref: threadsDomain.ThreadRef,\\n   233\\t    opts: { path: string; format?: \\\"pi-session\\\" },\\n   234\\t  ): Promise<OpResult<{ writtenPath: string }>>;\\n   235\\t}\\n   236\\t\\n   237\\texport interface Lhc {\\n   238\\t  threads: typeof threadsDomain;\\n   239\\t  intakeStream: typeof intakeStreamDomain;\\n   240\\t  messages: typeof messagesDomain;\\n   241\\t  turns: typeof turnsDomain;\\n   242\\t  threadView: ThreadViewSurface;\\n   243\\t  // Epic 04: the read-only report surface. Scoped through the instance seam\\n   244\\t  // like every other namespace so the status read it composes resolves THIS\\n   245\\t  // SDK's view config (threshold, visibility budgets).\\n   246\\t  inspect: typeof inspectDomain;\\n   247\\t  config: ResolvedSdkConfig;\\n   248\\t  scheduler: Scheduler;\\n   249\\t  workHandlers: WorkHandlerMap;\\n   250\\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\\n   251\\t  work: WorkSurface;\\n   252\\t  // Resolves when the scheduler has no running or pending drain for the\\n   253\\t  // thread (issue 3) — the awaitable for background mode, and a no-op\\n   254\\t  // resolve in manual mode.\\n   255\\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\\n   256\\t}\\n   257\\t\\n   258\\tfunction requirePositive(value: number, name: string): void {\\n   259\\t  if (!Number.isFinite(value) || value <= 0) {\\n   260\\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\\n   261\\t  }\\n   262\\t}\\n   263\\t\\n   264\\tfunction requireNonNegative(value: number, name: string): void {\\n   265\\t  if (!Number.isFinite(value) || value < 0) {\\n   266\\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\\n   267\\t  }\\n   268\\t}\\n   269\\t\\n   270\\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\\n   271\\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\\n   272\\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\\n   273\\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\\n   274\\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\\n   275\\t// object is the same shape as the namespace, so the public surface type holds.\\n   276\\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\\n   277\\t  const scoped: Record<string, unknown> = {};\\n   278\\t  for (const key of Object.keys(surface)) {\\n   279\\t    const value = (surface as Record<string, unknown>)[key];\\n   280\\t    scoped[key] =\\n   281\\t      typeof value === \\\"function\\\"\\n   282\\t        ? (...args: unknown[]): unknown =>\\n   283\\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\\n   284\\t        : value;\\n   285\\t  }\\n   286\\t  return scoped as T;\\n   287\\t}\\n   288\\t\\n   289\\t// The only assembly path: provider, mode, clock, and policy enter here.\\n   290\\t// Config mistakes are programmer errors at construction and throw; operating\\n   291\\t// failures after construction return OpResults per the error contract.\\n   292\\texport function createSdk(config: SdkConfig): Lhc {\\n   293\\t  if (config.mode !== \\\"background\\\" && config.mode !== \\\"manual\\\") {\\n   294\\t    throw new TypeError(\\n   295\\t      `createSdk config: mode must be \\\"background\\\" or \\\"manual\\\", got ${JSON.stringify(config.mode)}`,\\n   296\\t    );\\n   297\\t  }\\n   298\\t  if (config.provider === null || typeof config.provider !== \\\"object\\\") {\\n   299\\t    throw new TypeError(\\\"createSdk config: provider must implement DerivationProvider\\\");\\n   300\\t  }\\n   301\\t  for (const operation of PROVIDER_OPERATIONS) {\\n   302\\t    if (typeof config.provider[operation] !== \\\"function\\\") {\\n   303\\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\\n   304\\t    }\\n   305\\t  }\\n   306\\t\\n   307\\t  const resolved: ResolvedSdkConfig = {\\n   308\\t    provider: config.provider,\\n   309\\t    mode: config.mode,\\n   310\\t    clock: config.clock ?? (() => new Date()),\\n   311\\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\\n   312\\t    lease: config.lease ?? { durationMs: 120000 },\\n   313\\t    chunkPolicy:\\n   314\\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\\n   315\\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\\n   316\\t    // sums and visibility budgets validated — throws naming the violation.\\n   317\\t    view: resolveViewConfig(config.view),\\n   318\\t  };\\n   319\\t  requirePositive(resolved.retry.budget, \\\"retry.budget\\\");\\n   320\\t  requireNonNegative(resolved.retry.backoffBaseMs, \\\"retry.backoffBaseMs\\\");\\n   321\\t  requireNonNegative(resolved.retry.backoffCapMs, \\\"retry.backoffCapMs\\\");\\n   322\\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\\n   323\\t    throw new TypeError(\\\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\\\");\\n   324\\t  }\\n   325\\t  requirePositive(resolved.lease.durationMs, \\\"lease.durationMs\\\");\\n   326\\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \\\"chunkPolicy.targetProjectedTokens\\\");\\n   327\\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\\n   328\\t    throw new TypeError(\\n   329\\t      \\\"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\\\",\\n   330\\t    );\\n   331\\t  }\\n   332\\t\\n   333\\t  // Handler maps merge from per-domain contributions at construction (DD-6).\\n   334\\t  // The tables are empty until Stories 2–3 land the real handlers; the\\n   335\\t  // assembly mechanics are production code from day one.\\n   336\\t  const workHandlers = assembleWorkHandlerMap([\\n   337\\t    messagesDomain.workHandlers,\\n   338\\t    turnsDomain.workHandlers,\\n   339\\t  ]);\\n   340\\t\\n   341\\t  const drainDeps: DrainDeps = {\\n   342\\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\\n   343\\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\\n   344\\t    config: resolved,\\n   345\\t  };\\n   346\\t  const scheduler = createScheduler(resolved.mode, drainDeps);\\n   347\\t\\n   348\\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\\n   349\\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\\n   350\\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\\n   351\\t  // background mode, or a no-op in manual mode — isolated from any other SDK\\n   352\\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\\n   353\\t  // the construction order, because its operations deliver to the no-op seam,\\n   354\\t  // not to whatever a background SDK installed below.\\n   355\\t  // The seam also carries this instance's resolved view config (Epic 03,\\n   356\\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\\n   357\\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\\n   358\\t  // fall back to the built-in defaults inside the thread-view surface.\\n   359\\t  const seam: InstanceSeam =\\n   360\\t    resolved.mode === \\\"background\\\"\\n   361\\t      ? {\\n   362\\t          poke: (threadId) => scheduler.poke(threadId),\\n   363\\t          touch: (filePath, db) => scheduler.touch(filePath, db),\\n   364\\t          view: resolved.view,\\n   365\\t        }\\n   366\\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\\n   367\\t\\n   368\\t  // Background mode also installs the below-SDK default seam so a direct\\n   369\\t  // domain call made with no SDK scope — a top-level mutation in the\\n   370\\t  // single-background \\\"production path\\\" — still reaches the one installed\\n   371\\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\\n   372\\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\\n   373\\t  // leaves the default alone (pokes stay no-ops by contract).\\n   374\\t  if (resolved.mode === \\\"background\\\") {\\n   375\\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\\n   376\\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\\n   377\\t  }\\n   378\\t\\n   379\\t  const work: WorkSurface = {\\
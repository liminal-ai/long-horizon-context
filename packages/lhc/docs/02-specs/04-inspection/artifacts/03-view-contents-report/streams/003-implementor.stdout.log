{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RD2Dx8fG1Ah77kiQCEwHdc","type":"tool_result","content":"1\t// The pull's read path (Story 1): the stored view snapshot — header plus\n2\t// band rows, absent ⇒ tail-only signal — and the record reads the tail\n3\t// assembly needs (live messages after the compact point, their ready\n4\t// tool-result summaries, the tail token sum). Story 2 adds the one writer:\n5\t// the atomic replace at compact. Direct record/derived_form reads are\n6\t// sanctioned for thread-view internals (tech design §System View — the\n7\t// surface-import rule governs code imports, not SQL); what must NOT read\n8\t// derived_form directly is the status's derivation counting, which goes\n9\t// through the owners' report surfaces in index.ts.\n10\timport type { DatabaseSync } from \"node:sqlite\";\n11\timport type { Band } from \"../../../shared/view.js\";\n12\timport type { RenderingPartKind } from \"../../../shared/derivation.js\";\n13\t\n14\t// ── view snapshot (header + bands) ────────────────────────────────\n15\t\n16\texport interface ViewSnapshot {\n17\t  viewId: string;\n18\t  createdAt: string;\n19\t  compactPoint: number;\n20\t  coveredFrom: number;\n21\t  gapCount: number;\n22\t  degradedCount: number;\n23\t  // Non-empty bands in gradient order (brief → detailed → smooth), the order\n24\t  // the pull prepends them in.\n25\t  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\n26\t}\n27\t\n28\tinterface RawViewRow {\n29\t  view_id: string;\n30\t  created_at: string;\n31\t  compact_point: number | bigint;\n32\t  covered_from: number | bigint;\n33\t  arrangement_json: string;\n34\t  gaps_json: string;\n35\t}\n36\t\n37\tconst BAND_GRADIENT_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n38\t\n39\t// null ⇒ no view exists (never compacted): the whole record renders as tail\n40\t// from event 1 through the same pull code path — snapshot-absent, not a\n41\t// separate branch (story Anti-Shim Requirements).\n42\texport function readViewSnapshot(db: DatabaseSync): ViewSnapshot | null {\n43\t  const header = db\n44\t    .prepare(\n45\t      `SELECT view_id, created_at, compact_point, covered_from, arrangement_json, gaps_json\n46\t       FROM thread_view WHERE singleton = 1`,\n47\t    )\n48\t    .get() as RawViewRow | undefined;\n49\t  if (header === undefined) return null;\n50\t\n51\t  const arrangement = JSON.parse(header.arrangement_json) as Array<{ degraded?: boolean }>;\n52\t  const gaps = JSON.parse(header.gaps_json) as unknown[];\n53\t  const bandRows = db\n54\t    .prepare(\n55\t      `SELECT band, rendered_text, token_count FROM thread_view_band WHERE view_id = ?`,\n56\t    )\n57\t    .all(header.view_id) as unknown as Array<{\n58\t    band: string;\n59\t    rendered_text: string;\n60\t    token_count: number | bigint;\n61\t  }>;\n62\t  const byBand = new Map(bandRows.map((row) => [row.band, row]));\n63\t\n64\t  return {\n65\t    viewId: header.view_id,\n66\t    createdAt: header.created_at,\n67\t    compactPoint: Number(header.compact_point),\n68\t    coveredFrom: Number(header.covered_from),\n69\t    gapCount: gaps.length,\n70\t    degradedCount: arrangement.filter((entry) => entry.degraded === true).length,\n71\t    bands: BAND_GRADIENT_ORDER.flatMap((band) => {\n72\t      const row = byBand.get(band);\n73\t      return row === undefined\n74\t        ? []\n75\t        : [{ band, renderedText: row.rendered_text, tokenCount: Number(row.token_count) }];\n76\t    }),\n77\t  };\n78\t}\n79\t\n80\t// ── tail record reads ─────────────────────────────────────────────\n81\t\n82\texport interface TailMessageRow {\n83\t  messageId: string;\n84\t  sourceEventOrder: number;\n85\t  kind: RenderingPartKind;\n86\t  // The source event's recorded_at — materialize's entry timestamp (AC-5.2:\n87\t  // generated fields derive from record times, never write-time clocks).\n88\t  recordedAt: string;\n89\t  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n90\t}\n91\t\n92\t// Live messages after the compact point in record order, with their projected\n93\t// blocks — the deleted-read filter applied here so a deleted message never\n94\t// reaches rendering (AC-1.x delete filtering).\n95\texport function readTailMessages(db: DatabaseSync, compactPoint: number): TailMessageRow[] {\n96\t  const messageRows = db\n97\t    .prepare(\n98\t      `SELECT m.message_id, m.source_event_order, m.kind, e.recorded_at FROM message m\n99\t       JOIN event e ON e.event_order = m.source_event_order\n100\t       WHERE m.deleted_at IS NULL AND m.source_event_order > ?\n101\t       ORDER BY m.source_event_order`,\n102\t    )\n103\t    .all(compactPoint) as unknown as Array<{\n104\t    message_id: string;\n105\t    source_event_order: number | bigint;\n106\t    kind: string;\n107\t    recorded_at: string;\n108\t  }>;\n109\t  const blockRows = db\n110\t    .prepare(\n111\t      `SELECT mb.message_id, mb.block_type, mb.content\n112\t       FROM message_block mb JOIN message m ON m.message_id = mb.message_id\n113\t       WHERE m.deleted_at IS NULL AND m.source_event_order > ?\n114\t       ORDER BY m.source_event_order, mb.block_index`,\n115\t    )\n116\t    .all(compactPoint) as unknown as Array<{\n117\t    message_id: string;\n118\t    block_type: string;\n119\t    content: string;\n120\t  }>;\n121\t  const blocksByMessage = new Map<string, TailMessageRow[\"blocks\"]>();\n122\t  for (const row of blockRows) {\n123\t    const blocks = blocksByMessage.get(row.message_id) ?? [];\n124\t    blocks.push({\n125\t      blockType: row.block_type,\n126\t      content: JSON.parse(row.content) as Record<string, unknown>,\n127\t    });\n128\t    blocksByMessage.set(row.message_id, blocks);\n129\t  }\n130\t  return messageRows.map((row) => ({\n131\t    messageId: row.message_id,\n132\t    sourceEventOrder: Number(row.source_event_order),\n133\t    kind: row.kind as RenderingPartKind,\n134\t    recordedAt: row.recorded_at,\n135\t    blocks: blocksByMessage.get(row.message_id) ?? [],\n136\t  }));\n137\t}\n138\t\n139\t// The thread's identity row — materialize's header source (AC-5.2: the\n140\t// header id derives from thread id + view created-at; a never-compacted\n141\t// thread's header uses the thread's created-at).\n142\texport function readThreadMetadata(db: DatabaseSync): { threadId: string; createdAt: string } {\n143\t  const row = db\n144\t    .prepare(`SELECT thread_id, created_at FROM thread_metadata WHERE id = 1`)\n145\t    .get() as { thread_id: string; created_at: string } | undefined;\n146\t  if (row === undefined) {\n147\t    throw new Error(\"thread_metadata singleton row missing (creation writes it)\");\n148\t  }\n149\t  return { threadId: row.thread_id, createdAt: row.created_at };\n150\t}\n151\t\n152\t// The tail's token sum for status (AC-2.8): every live message after the\n153\t// compact point, all kinds — the same population the pull renders as tail.\n154\texport function tailTokenSum(db: DatabaseSync, compactPoint: number): number {\n155\t  const row = db\n156\t    .prepare(\n157\t      `SELECT COALESCE(SUM(token_estimate), 0) AS total FROM message\n158\t       WHERE deleted_at IS NULL AND source_event_order > ?`,\n159\t    )\n160\t    .get(compactPoint) as { total: number | bigint };\n161\t  return Number(row.total);\n162\t}\n163\t\n164\t// ── the atomic replace (Story 2, AC-2.6) ──────────────────────────\n165\t\n166\texport interface ViewReplaceInput {\n167\t  viewId: string;\n168\t  createdAt: string;\n169\t  compactPoint: number;\n170\t  coveredFrom: number;\n171\t  profileName: string | null;\n172\t  configJson: string;\n173\t  arrangementJson: string;\n174\t  gapsJson: string;\n175\t  sourceStateJson: string;\n176\t  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\n177\t}\n178\t\n179\t// Compact's one transaction: delete the singleton view row (the FK cascade\n180\t// drops its bands), insert the new header and bands, and reset the boundary\n181\t// to the compact point (AC-4.7) — all inside one BEGIN IMMEDIATE, so a crash\n182\t// anywhere rolls the whole replace back and the previous view keeps serving\n183\t// (AC-2.6, TC-2.4). Compact is the only writer of these rows; the boundary's\n184\t// other writer is Story 4's advance.\n185\texport function replaceViewSnapshot(db: DatabaseSync, input: ViewReplaceInput): void {\n186\t  db.exec(\"BEGIN IMMEDIATE;\");\n187\t  try {\n188\t    db.prepare(`DELETE FROM thread_view WHERE singleton = 1`).run();\n189\t    db.prepare(\n190\t      `INSERT INTO thread_view (singleton, view_id, created_at, compact_point, covered_from,\n191\t         profile_name, config_json, arrangement_json, gaps_json, source_state_json)\n192\t       VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n193\t    ).run(\n194\t      input.viewId,\n195\t      input.createdAt,\n196\t      input.compactPoint,\n197\t      input.coveredFrom,\n198\t      input.profileName,\n199\t      input.configJson,\n200\t      input.arrangementJson,\n201\t      input.gapsJson,\n202\t      input.sourceStateJson,\n203\t    );\n204\t    const insertBand = db.prepare(\n205\t      `INSERT INTO thread_view_band (view_id, band, rendered_text, token_count)\n206\t       VALUES (?, ?, ?, ?)`,\n207\t    );\n208\t    for (const band of input.bands) {\n209\t      insertBand.run(input.viewId, band.band, band.renderedText, band.tokenCount);\n210\t    }\n211\t    db.prepare(\n212\t      `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\n213\t    ).run(input.compactPoint, input.createdAt);\n214\t    db.exec(\"COMMIT;\");\n215\t  } catch (cause) {\n216\t    db.exec(\"ROLLBACK;\");\n217\t    throw cause;\n218\t  }\n219\t}\n220\t\n221\t// Ready tool-result summaries by message id — the short-form ladder's first\n222\t// rung. Stored state read verbatim, never derived here (no-inference rule).\n223\texport function readReadyToolResultSummaries(db: DatabaseSync): Map<string, string> {\n224\t  const rows = db\n225\t    .prepare(\n226\t      `SELECT subject_id, content FROM derived_form\n227\t       WHERE subject_kind = 'message' AND form = 'tool_result_summary'\n228\t         AND state = 'ready' AND content IS NOT NULL`,\n229\t    )\n230\t    .all() as unknown as Array<{ subject_id: string; content: string }>;\n231\t  return new Map(rows.map((row) => [row.subject_id, row.content]));\n232\t}\n233\t"}]},"parent_tool_use_id":null,"session_id":"67ded016-4b4e-4398-b028-a8f2c13ea2bb","uuid":"c80ff0ae-dec0-493f-94f2-4c4b455bbb5e","timestamp":"2026-06-12T14:42:37.457Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/internal/snapshot.ts","content":"// The pull's read path (Story 1): the stored view snapshot — header plus\n// band rows, absent ⇒ tail-only signal — and the record reads the tail\n// assembly needs (live messages after the compact point, their ready\n// tool-result summaries, the tail token sum). Story 2 adds the one writer:\n// the atomic replace at compact. Direct record/derived_form reads are\n// sanctioned for thread-view internals (tech design §System View — the\n// surface-import rule governs code imports, not SQL); what must NOT read\n// derived_form directly is the status's derivation counting, which goes\n// through the owners' report surfaces in index.ts.\nimport type { DatabaseSync } from \"node:sqlite\";\nimport type { Band } from \"../../../shared/view.js\";\nimport type { RenderingPartKind } from \"../../../shared/derivation.js\";\n\n// ── view snapshot (header + bands) ────────────────────────────────\n\nexport interface ViewSnapshot {\n  viewId: string;\n  createdAt: string;\n  compactPoint: number;\n  coveredFrom: number;\n  gapCount: number;\n  degradedCount: number;\n  // Non-empty bands in gradient order (brief → detailed → smooth), the order\n  // the pull prepends them in.\n  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\n}\n\ninterface RawViewRow {\n  view_id: string;\n  created_at: string;\n  compact_point: number | bigint;\n  covered_from: number | bigint;\n  arrangement_json: string;\n  gaps_json: string;\n}\n\nconst BAND_GRADIENT_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n\n// null ⇒ no view exists (never compacted): the whole record renders as tail\n// from event 1 through the same pull code path — snapshot-absent, not a\n// separate branch (story Anti-Shim Requirements).\nexport function readViewSnapshot(db: DatabaseSync): ViewSnapshot | null {\n  const header = db\n    .prepare(\n      `SELECT view_id, created_at, compact_point, covered_from, arrangement_json, gaps_json\n       FROM thread_view WHERE singleton = 1`,\n    )\n    .get() as RawViewRow | undefined;\n  if (header === undefined) return null;\n\n  const arrangement = JSON.parse(header.arrangement_json) as Array<{ degraded?: boolean }>;\n  const gaps = JSON.parse(header.gaps_json) as unknown[];\n  const bandRows = db\n    .prepare(\n      `SELECT band, rendered_text, token_count FROM thread_view_band WHERE view_id = ?`,\n    )\n    .all(header.view_id) as unknown as Array<{\n    band: string;\n    rendered_text: string;\n    token_count: number | bigint;\n  }>;\n  const byBand = new Map(bandRows.map((row) => [row.band, row]));\n\n  return {\n    viewId: header.view_id,\n    createdAt: header.created_at,\n    compactPoint: Number(header.compact_point),\n    coveredFrom: Number(header.covered_from),\n    gapCount: gaps.length,\n    degradedCount: arrangement.filter((entry) => entry.degraded === true).length,\n    bands: BAND_GRADIENT_ORDER.flatMap((band) => {\n      const row = byBand.get(band);\n      return row === undefined\n        ? []\n        : [{ band, renderedText: row.rendered_text, tokenCount: Number(row.token_count) }];\n    }),\n  };\n}\n\n// ── tail record reads ─────────────────────────────────────────────\n\nexport interface TailMessageRow {\n  messageId: string;\n  sourceEventOrder: number;\n  kind: RenderingPartKind;\n  // The source event's recorded_at — materialize's entry timestamp (AC-5.2:\n  // generated fields derive from record times, never write-time clocks).\n  recordedAt: string;\n  blocks: Array<{ blockType: string; content: Record<string, unknown> }>;\n}\n\n// Live messages after the compact point in record order, with their projected\n// blocks — the deleted-read filter applied here so a deleted message never\n// reaches rendering (AC-1.x delete filtering).\nexport function readTailMessages(db: DatabaseSync, compactPoint: number): TailMessageRow[] {\n  const messageRows = db\n    .prepare(\n      `SELECT m.message_id, m.source_event_order, m.kind, e.recorded_at FROM message m\n       JOIN event e ON e.event_order = m.source_event_order\n       WHERE m.deleted_at IS NULL AND m.source_event_order > ?\n       ORDER BY m.source_event_order`,\n    )\n    .all(compactPoint) as unknown as Array<{\n    message_id: string;\n    source_event_order: number | bigint;\n    kind: string;\n    recorded_at: string;\n  }>;\n  const blockRows = db\n    .prepare(\n      `SELECT mb.message_id, mb.block_type, mb.content\n       FROM message_block mb JOIN message m ON m.message_id = mb.message_id\n       WHERE m.deleted_at IS NULL AND m.source_event_order > ?\n       ORDER BY m.source_event_order, mb.block_index`,\n    )\n    .all(compactPoint) as unknown as Array<{\n    message_id: string;\n    block_type: string;\n    content: string;\n  }>;\n  const blocksByMessage = new Map<string, TailMessageRow[\"blocks\"]>();\n  for (const row of blockRows) {\n    const blocks = blocksByMessage.get(row.message_id) ?? [];\n    blocks.push({\n      blockType: row.block_type,\n      content: JSON.parse(row.content) as Record<string, unknown>,\n    });\n    blocksByMessage.set(row.message_id, blocks);\n  }\n  return messageRows.map((row) => ({\n    messageId: row.message_id,\n    sourceEventOrder: Number(row.source_event_order),\n    kind: row.kind as RenderingPartKind,\n    recordedAt: row.recorded_at,\n    blocks: blocksByMessage.get(row.message_id) ?? [],\n  }));\n}\n\n// The thread's identity row — materialize's header source (AC-5.2: the\n// header id derives from thread id + view created-at; a never-compacted\n// thread's header uses the thread's created-at).\nexport function readThreadMetadata(db: DatabaseSync): { threadId: string; createdAt: string } {\n  const row = db\n    .prepare(`SELECT thread_id, created_at FROM thread_metadata WHERE id = 1`)\n    .get() as { thread_id: string; created_at: string } | undefined;\n  if (row === undefined) {\n    throw new Error(\"thread_metadata singleton row missing (creation writes it)\");\n  }\n  return { threadId: row.thread_id, createdAt: row.created_at };\n}\n\n// The tail's token sum for status (AC-2.8): every live message after the\n// compact point, all kinds — the same population the pull renders as tail.\nexport function tailTokenSum(db: DatabaseSync, compactPoint: number): number {\n  const row = db\n    .prepare(\n      `SELECT COALESCE(SUM(token_estimate), 0) AS total FROM message\n       WHERE deleted_at IS NULL AND source_event_order > ?`,\n    )\n    .get(compactPoint) as { total: number | bigint };\n  return Number(row.total);\n}\n\n// ── the atomic replace (Story 2, AC-2.6) ──────────────────────────\n\nexport interface ViewReplaceInput {\n  viewId: string;\n  createdAt: string;\n  compactPoint: number;\n  coveredFrom: number;\n  profileName: string | null;\n  configJson: string;\n  arrangementJson: string;\n  gapsJson: string;\n  sourceStateJson: string;\n  bands: Array<{ band: Band; renderedText: string; tokenCount: number }>;\n}\n\n// Compact's one transaction: delete the singleton view row (the FK cascade\n// drops its bands), insert the new header and bands, and reset the boundary\n// to the compact point (AC-4.7) — all inside one BEGIN IMMEDIATE, so a crash\n// anywhere rolls the whole replace back and the previous view keeps serving\n// (AC-2.6, TC-2.4). Compact is the only writer of these rows; the boundary's\n// other writer is Story 4's advance.\nexport function replaceViewSnapshot(db: DatabaseSync, input: ViewReplaceInput): void {\n  db.exec(\"BEGIN IMMEDIATE;\");\n  try {\n    db.prepare(`DELETE FROM thread_view WHERE singleton = 1`).run();\n    db.prepare(\n      `INSERT INTO thread_view (singleton, view_id, created_at, compact_point, covered_from,\n         profile_name, config_json, arrangement_json, gaps_json, source_state_json)\n       VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,\n    ).run(\n      input.viewId,\n      input.createdAt,\n      input.compactPoint,\n      input.coveredFrom,\n      input.profileName,\n      input.configJson,\n      input.arrangementJson,\n      input.gapsJson,\n      input.sourceStateJson,\n    );\n    const insertBand = db.prepare(\n      `INSERT INTO thread_view_band (view_id, band, rendered_text, token_count)\n       VALUES (?, ?, ?, ?)`,\n    );\n    for (const band of input.bands) {\n      insertBand.run(input.viewId, band.band, band.renderedText, band.tokenCount);\n    }\n    db.prepare(\n      `UPDATE view_boundary SET position = ?, updated_at = ? WHERE thread_singleton = 1`,\n    ).run(input.compactPoint, input.createdAt);\n    db.exec(\"COMMIT;\");\n  } catch (cause) {\n    db.exec(\"ROLLBACK;\");\n    throw cause;\n  }\n}\n\n// Ready tool-result summaries by message id — the short-form ladder's first\n// rung. Stored state read verbatim, never derived here (no-inference rule).\nexport function readReadyToolResultSummaries(db: DatabaseSync): Map<string, string> {\n  const rows = db\n    .prepare(\n      `SELECT subject_id, content FROM derived_form\n       WHERE subject_kind = 'message' AND form = 'tool_result_summary'\n         AND state = 'ready' AND content IS NOT NULL`,\n    )\n    .all() as unknown as Array<{ subject_id: string; content: string }>;\n  return new Map(rows.map((row) => [row.subject_id, row.content]));\n}\n","numLines":233,"startLine":1,"totalLines":233}}}

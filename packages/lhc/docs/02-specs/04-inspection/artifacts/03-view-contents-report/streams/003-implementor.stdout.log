{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NakNoNGupxU3rxzdX2wb7h","type":"tool_result","content":"1\t// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\n2\t// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\n3\t// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\n4\t// deterministic provider double into known form states. States are reached\n5\t// through production paths, never hand-written rows (the anti-shim line\n6\t// FC-0.3 enforces): the failed states come from scripted provider failures\n7\t// consumed by the real retry/exhaustion mechanics, and blocked comes from\n8\t// real source damage on a sacrificial sibling thread. Every later Epic 03\n9\t// story compacts against what this builder returns.\n10\timport {\n11\t  createSdk,\n12\t  type CompactReceipt,\n13\t  type FormReportEntry,\n14\t  type Lhc,\n15\t  type MessageEventInput,\n16\t  type MutationResult,\n17\t} from \"../../src/index.js\";\n18\timport { corruptTwoOpenTurns } from \"./corrupt.js\";\n19\timport { createProviderDouble, type ProviderDouble } from \"./provider-double.js\";\n20\timport { readChunks, type ChunkSnapshot } from \"./threads.js\";\n21\timport { validEvent, type TempStore } from \"./index.js\";\n22\t\n23\t// Reason classes the scripted failures stamp, chosen from the sweep\n24\t// classification table's vocabulary (tech design §Spec Validation): a\n25\t// rate-limit class reads transient, a content-refusal class reads permanent —\n26\t// FC-0.4's distinguishable-on-read-back guarantee, proven here before\n27\t// Story 3 depends on it.\n28\texport const TRANSIENT_EXHAUST_REASON =\n29\t  \"rate_limit: scripted transient exhaustion (fixture)\";\n30\texport const PERMANENT_FAILURE_REASON =\n31\t  \"content_refusal: scripted permanent failure (fixture)\";\n32\t\n33\t// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\n34\t// (3 members each; c1–c3 closed, c4 still open). Projections from the\n35\t// deterministic double are near-constant in size (`projection(<digest>:<40\n36\t// chars>)`), so the cut is stable; the builder asserts the shape and throws\n37\t// if drift ever moves it.\n38\tconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\n39\t\n40\tconst TURN_COUNT = 12;\n41\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n42\t\n43\tfunction turnEvents(turn: number): MessageEventInput[] {\n44\t  const events: MessageEventInput[] = [\n45\t    validEvent(\"user_prompt\", {\n46\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n47\t    }),\n48\t    validEvent(\"assistant_thinking\", {\n49\t      payload: { text: `considering what area ${turn} contains` },\n50\t    }),\n51\t  ];\n52\t  if (TOOL_HEAVY_TURNS.has(turn)) {\n53\t    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\n54\t    // realistic over-max zone of tool results to age behind the boundary.\n55\t    for (const run of [1, 2]) {\n56\t      const toolCallId = `call-fx-${turn}-${run}`;\n57\t      events.push(\n58\t        validEvent(\"tool_call\", {\n59\t          payload: {\n60\t            toolCallId,\n61\t            toolName: \"read_file\",\n62\t            arguments: { path: `area-${turn}/file-${run}.txt` },\n63\t          },\n64\t        }),\n65\t        validEvent(\"tool_result\", {\n66\t          payload: {\n67\t            toolCallId,\n68\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n69\t            isError: false,\n70\t          },\n71\t        }),\n72\t      );\n73\t    }\n74\t  }\n75\t  events.push(\n76\t    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n77\t    validEvent(\"turn_end\"),\n78\t  );\n79\t  return events;\n80\t}\n81\t\n82\texport interface DerivedThreadFixture {\n83\t  filePath: string;\n84\t  sdk: Lhc;\n85\t  double: ProviderDouble;\n86\t  turnIds: string[]; // t1..t12\n87\t  chunks: ChunkSnapshot;\n88\t  // The two manufactured failed subjects (tool_result_summary forms), reached\n89\t  // through real retry exhaustion / terminal failure — absent when failures\n90\t  // are disabled for a variant.\n91\t  failedTransientMessageId?: string;\n92\t  failedPermanentMessageId?: string;\n93\t  // The straggler variant's turnId-null messages: one between two turns, one\n94\t  // after the last turn — absent unless stragglers are enabled.\n95\t  stragglerBetweenMessageId?: string;\n96\t  stragglerTrailingMessageId?: string;\n97\t}\n98\t\n99\texport interface DerivedThreadOptions {\n100\t  failures?: boolean; // default true: manufacture the two failed states\n101\t  stragglers?: boolean; // default false: insert the turnless runtime notes\n102\t}\n103\t\n104\tasync function send(\n105\t  sdk: Lhc,\n106\t  filePath: string,\n107\t  batch: readonly MessageEventInput[],\n108\t): Promise<string[]> {\n109\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n110\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n111\t  return result.value.events.map((entry) => entry.messageId ?? \"\");\n112\t}\n113\t\n114\tasync function drain(sdk: Lhc, filePath: string): Promise<void> {\n115\t  const report = await sdk.work.drain({ filePath });\n116\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n117\t  if (report.value.stoppedBecause !== \"empty\" || report.value.remaining !== 0) {\n118\t    throw new Error(\n119\t      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\n120\t    );\n121\t  }\n122\t}\n123\t\n124\tfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\n125\t  return entries.filter((entry) => entry.state === \"failed\" && entry.reason === reason);\n126\t}\n127\t\n128\texport async function derivedThreadFixture(\n129\t  store: TempStore,\n130\t  opts: DerivedThreadOptions = {},\n131\t): Promise<DerivedThreadFixture> {\n132\t  const failures = opts.failures ?? true;\n133\t  const stragglers = opts.stragglers ?? false;\n134\t\n135\t  const double = createProviderDouble();\n136\t  const sdk = createSdk({\n137\t    provider: double,\n138\t    mode: \"manual\",\n139\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n140\t    chunkPolicy: FIXTURE_CHUNK_POLICY,\n141\t  });\n142\t\n143\t  const filePath = store.threadPath();\n144\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n145\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n146\t\n147\t  const turnIds: string[] = [];\n148\t  const fixture: DerivedThreadFixture = {\n149\t    filePath,\n150\t    sdk,\n151\t    double,\n152\t    turnIds,\n153\t    chunks: { chunks: [], members: [] },\n154\t  };\n155\t\n156\t  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\n157\t    if (failures && turn === 6) {\n158\t      // Retryable failures consumed to exhaustion by the head-first drain:\n159\t      // the first tool_result_summary item of this batch takes all three\n160\t      // attempts and lands failed with the transient reason class.\n161\t      double.failKind(\"tool_result_summary\", 3, {\n162\t        retryable: true,\n163\t        reason: TRANSIENT_EXHAUST_REASON,\n164\t      });\n165\t    }\n166\t    if (failures && turn === 7) {\n167\t      // One non-retryable failure: terminal on the first attempt — the\n168\t      // permanent reason class, attempts 1.\n169\t      double.failKind(\"tool_result_summary\", 1, {\n170\t        retryable: false,\n171\t        reason: PERMANENT_FAILURE_REASON,\n172\t      });\n173\t    }\n174\t    const messageIds = await send(sdk, filePath, turnEvents(turn));\n175\t    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\n176\t    // result, call, result, text, end — index 3 is the first tool result,\n177\t    // the scripted failures' subject.\n178\t    const firstToolResultId = messageIds[3];\n179\t    if (failures && (turn === 6 || turn === 7)) {\n180\t      if (firstToolResultId === undefined || firstToolResultId === \"\") {\n181\t        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\n182\t      }\n183\t      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\n184\t      else fixture.failedPermanentMessageId = firstToolResultId;\n185\t    }\n186\t    await drain(sdk, filePath);\n187\t\n188\t    if (stragglers && turn === 3) {\n189\t      // A runtime note between turn 3's end and turn 4's prompt: projected\n190\t      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\n191\t      const noteIds = await send(sdk, filePath, [\n192\t        validEvent(\"runtime_note\", {\n193\t          payload: { text: \"harness restarted between turns (fixture straggler)\" },\n194\t        }),\n195\t      ]);\n196\t      const noteId = noteIds[0];\n197\t      if (noteId === undefined || noteId === \"\") {\n198\t        throw new Error(\"fixture invariant: between-turns straggler did not project\");\n199\t      }\n200\t      fixture.stragglerBetweenMessageId = noteId;\n201\t    }\n202\t    turnIds.push(`t${turn}`);\n203\t  }\n204\t\n205\t  if (stragglers) {\n206\t    const noteIds = await send(sdk, filePath, [\n207\t      validEvent(\"runtime_note\", {\n208\t        payload: { text: \"session closing note after the last turn (fixture straggler)\" },\n209\t      }),\n210\t    ]);\n211\t    const noteId = noteIds[0];\n212\t    if (noteId === undefined || noteId === \"\") {\n213\t      throw new Error(\"fixture invariant: trailing straggler did not project\");\n214\t    }\n215\t    fixture.stragglerTrailingMessageId = noteId;\n216\t    await drain(sdk, filePath);\n217\t  }\n218\t\n219\t  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\n220\t  // chunks, the first three closed. A failure here means the deterministic\n221\t  // substrate moved (provider output or tokenizer), not a flaky test.\n222\t  fixture.chunks = readChunks(filePath);\n223\t  if (fixture.chunks.chunks.length !== 4) {\n224\t    throw new Error(\n225\t      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\n226\t    );\n227\t  }\n228\t  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \"closed\").length;\n229\t  if (closed !== 3) {\n230\t    throw new Error(\n231\t      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\n232\t    );\n233\t  }\n234\t\n235\t  if (failures) {\n236\t    // Verify the manufactured states by read-back through the owning report\n237\t    // surface before handing the fixture to any test (FC-0.3's enforcement\n238\t    // lives in the tests; this guards the builder's own contract).\n239\t    const report = await sdk.messages.report({ filePath });\n240\t    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\n241\t    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\n242\t    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\n243\t    if (\n244\t      transient.length !== 1 ||\n245\t      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\n246\t      permanent.length !== 1 ||\n247\t      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\n248\t    ) {\n249\t      throw new Error(\n250\t        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\n251\t      );\n252\t    }\n253\t  }\n254\t\n255\t  return fixture;\n256\t}\n257\t\n258\t// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\n259\t// conversation with a runtime note between two turns and one after the last\n260\t// turn, fully drained, no manufactured failures.\n261\texport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\n262\t  return derivedThreadFixture(store, { failures: false, stragglers: true });\n263\t}\n264\t\n265\t// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\n266\t// short real conversation, drained clean, then damaged below the SDK into\n267\t// the two-open-turns state no public operation can produce. Canonical\n268\t// consumers refuse it with state_corruption.\n269\texport async function corruptedVariantThread(\n270\t  store: TempStore,\n271\t): Promise<{ filePath: string; sdk: Lhc }> {\n272\t  const double = createProviderDouble();\n273\t  const sdk = createSdk({ provider: double, mode: \"manual\" });\n274\t  const filePath = store.threadPath();\n275\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n276\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n277\t  for (let turn = 1; turn <= 3; turn += 1) {\n278\t    await send(sdk, filePath, turnEvents(turn));\n279\t  }\n280\t  await drain(sdk, filePath);\n281\t  // Open a turn through real intake, then add a second open row: two open\n282\t  // turns, the Epic 01 invariant violation.\n283\t  await send(sdk, filePath, [\n284\t    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n285\t  ]);\n286\t  corruptTwoOpenTurns(filePath);\n287\t  return { filePath, sdk };\n288\t}\n289\t\n290\t// ── Epic 04 Story 2 extensions (test plan: fixture extended in place) ──\n291\t\n292\t// The mutation-in-flight variant: the tool-heavy thread compacted, then ONE\n293\t// edit applied through the production mutation path with the drain NOT\n294\t// settled — so the cascade's cleared-pending states and their queued work\n295\t// are real production states, never hand-written rows (FC-fidelity rule).\n296\t// Serves the mid-rebuild overview shape (TC-1.1) and the rebuild bracket's\n297\t// opening state (TC-4.3).\n298\texport interface MutationInFlightFixture extends DerivedThreadFixture {\n299\t  compactReceipt: CompactReceipt;\n300\t  editedMessageId: string;\n301\t  // The cascade contract's exact account of the edit: cleared set, queued\n302\t  // replacements, superseded items — what the bracketing health reads\n303\t  // assert against.\n304\t  mutation: MutationResult;\n305\t}\n306\t\n307\texport async function mutationInFlightVariant(\n308\t  store: TempStore,\n309\t): Promise<MutationInFlightFixture> {\n310\t  // No manufactured failures: the bracket's \"nothing outside the cascade\n311\t  // changed state\" assertion wants a clean baseline.\n312\t  const fixture = await derivedThreadFixture(store, { failures: false });\n313\t  const { sdk, filePath } = fixture;\n314\t\n315\t  const compacted = await sdk.threadView.compact({ filePath }, {});\n316\t  if (!compacted.ok) {\n317\t    throw new Error(`fixture compact failed: ${compacted.error.reason}`);\n318\t  }\n319\t\n320\t  // A mid-thread closed-turn target: turn 2's prompt, so the cascade spans\n321\t  // all three subject kinds — its own smoothed_prompt, t2's two turn forms,\n322\t  // and c1's two chunk summaries.\n323\t  const listed = await sdk.messages.listMessages({ filePath });\n324\t  if (!listed.ok) throw new Error(`fixture list failed: ${listed.error.reason}`);\n325\t  const target = listed.value.find(\n326\t    (record) => record.kind === \"user_prompt\" && record.turnId === \"t2\",\n327\t  );\n328\t  if (target === undefined) {\n329\t    throw new Error(\"fixture invariant: turn 2 carries no prompt message\");\n330\t  }\n331\t\n332\t  const edited = await sdk.messages.edit(\n333\t    { filePath },\n334\t    { messageId: target.messageId, content: \"turn 2 revised: investigate area 2 again\" },\n335\t  );\n336\t  if (!edited.ok) throw new Error(`fixture edit failed: ${edited.error.reason}`);\n337\t\n338\t  return {\n339\t    ...fixture,\n340\t    compactReceipt: compacted.value,\n341\t    editedMessageId: target.messageId,\n342\t    mutation: edited.value,\n343\t  };\n344\t}\n345\t\n346\t// The mixed-state variant (TC-4.1's substrate): one thread carrying every\n347\t// operational state at once — ready (the drained body), failed-transient and\n348\t// failed-permanent (the scripted exhaustions), blocked (a turn derivation\n349\t// meeting real source damage), and pending with live queued work (a partial\n350\t// drain stopping short). All states reached through intake, mutation, and\n351\t// drain behavior; the only below-SDK write is the sanctioned two-open-turns\n352\t// corruption.\n353\texport interface MixedStateFixture extends DerivedThreadFixture {\n354\t  blockedTurnId: string; // t13: turn forms blocked through the terminal path\n355\t  pendingPromptMessageId: string; // t14's prompt: smoothed_prompt still queued\n356\t}\n357\t\n358\texport async function mixedStateVariantThread(store: TempStore): Promise<MixedStateFixture> {\n359\t  const fixture = await derivedThreadFixture(store);\n360\t  const { sdk, filePath } = fixture;\n361\t\n362\t  // Turn 13 closes cleanly but is NOT drained: its prompt smoothing and turn\n363\t  // derivation sit queued (events: prompt, thinking, text, end — no tools).\n364\t  await send(sdk, filePath, turnEvents(13));\n365\t\n366\t  // Turn 14 opens with a lone prompt: one more queued smoothing item that the\n367\t  // partial drain below will leave pending.\n368\t  const promptIds = await send(sdk, filePath, [\n369\t    validEvent(\"user_prompt\", {\n370\t      payload: { text: \"turn 14: this prompt's smoothing stays pending\" },\n371\t    }),\n372\t  ]);\n373\t  const pendingPromptMessageId = promptIds[0];\n374\t  if (pendingPromptMessageId === undefined || pendingPromptMessageId === \"\") {\n375\t    throw new Error(\"fixture invariant: turn 14 prompt did not project\");\n376\t  }\n377\t\n378\t  // Real source damage: t14 is open, the corruption writer adds a second open\n379\t  // row — the state t13's claimed derivation meets at drain time.\n380\t  corruptTwoOpenTurns(filePath);\n381\t\n382\t  // Partial drain, head-first FIFO: item 1 is t13's prompt smoothing (ready),\n383\t  // item 2 is t13's turn derivation (terminal on the damage → blocked).\n384\t  // t14's smoothing stays queued — the live pending state.\n385\t  const report = await sdk.work.drain({ filePath }, { maxItems: 2 });\n386\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n387\t  const blockedRun = report.value.ran.find(\n388\t    (entry) => entry.kind === \"turn_derivation\" && entry.disposition === \"failed_terminal\",\n389\t  );\n390\t  if (blockedRun === undefined) {\n391\t    throw new Error(\"fixture invariant: turn 13 derivation expected to land terminal on damage\");\n392\t  }\n393\t  if (report.value.remaining !== 1) {\n394\t    throw new Error(\n395\t      `fixture invariant: expected exactly one queued item left, got ${report.value.remaining}`,\n396\t    );\n397\t  }\n398\t\n399\t  return { ...fixture, blockedTurnId: \"t13\", pendingPromptMessageId };\n400\t}\n401\t\n402\t// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\n403\t// queued derivation meets real source damage at drain time — the handler\n404\t// finds two open turns and lands the turn forms blocked through the\n405\t// production terminal path, never a hand-written row.\n406\texport async function blockedSiblingThread(\n407\t  store: TempStore,\n408\t): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\n409\t  const double = createProviderDouble();\n410\t  const sdk = createSdk({ provider: double, mode: \"manual\" });\n411\t  const filePath = store.threadPath();\n412\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n413\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n414\t  // Turn 1 closes (its turn_derivation queues); a second turn opens through\n415\t  // real intake; the corruption writer adds another open row. The drain then\n416\t  // claims t1's derivation against a record with two open turns.\n417\t  await send(sdk, filePath, turnEvents(1));\n418\t  await send(sdk, filePath, [\n419\t    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n420\t  ]);\n421\t  corruptTwoOpenTurns(filePath);\n422\t  const report = await sdk.work.drain({ filePath });\n423\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n424\t  const blocked = report.value.ran.find(\n425\t    (entry) => entry.kind === \"turn_derivation\" && entry.disposition === \"failed_terminal\",\n426\t  );\n427\t  if (blocked === undefined) {\n428\t    throw new Error(\"fixture invariant: turn_derivation expected to land terminal on damage\");\n429\t  }\n430\t  return { filePath, sdk, blockedTurnId: \"t1\" };\n431\t}\n432\t"}]},"parent_tool_use_id":null,"session_id":"67ded016-4b4e-4398-b028-a8f2c13ea2bb","uuid":"1dfbcaea-12ec-4cde-acf8-c40f936ebb92","timestamp":"2026-06-12T14:43:05.804Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/view-thread.ts","content":"// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\n// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\n// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\n// deterministic provider double into known form states. States are reached\n// through production paths, never hand-written rows (the anti-shim line\n// FC-0.3 enforces): the failed states come from scripted provider failures\n// consumed by the real retry/exhaustion mechanics, and blocked comes from\n// real source damage on a sacrificial sibling thread. Every later Epic 03\n// story compacts against what this builder returns.\nimport {\n  createSdk,\n  type CompactReceipt,\n  type FormReportEntry,\n  type Lhc,\n  type MessageEventInput,\n  type MutationResult,\n} from \"../../src/index.js\";\nimport { corruptTwoOpenTurns } from \"./corrupt.js\";\nimport { createProviderDouble, type ProviderDouble } from \"./provider-double.js\";\nimport { readChunks, type ChunkSnapshot } from \"./threads.js\";\nimport { validEvent, type TempStore } from \"./index.js\";\n\n// Reason classes the scripted failures stamp, chosen from the sweep\n// classification table's vocabulary (tech design §Spec Validation): a\n// rate-limit class reads transient, a content-refusal class reads permanent —\n// FC-0.4's distinguishable-on-read-back guarantee, proven here before\n// Story 3 depends on it.\nexport const TRANSIENT_EXHAUST_REASON =\n  \"rate_limit: scripted transient exhaustion (fixture)\";\nexport const PERMANENT_FAILURE_REASON =\n  \"content_refusal: scripted permanent failure (fixture)\";\n\n// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\n// (3 members each; c1–c3 closed, c4 still open). Projections from the\n// deterministic double are near-constant in size (`projection(<digest>:<40\n// chars>)`), so the cut is stable; the builder asserts the shape and throws\n// if drift ever moves it.\nconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\n\nconst TURN_COUNT = 12;\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n\nfunction turnEvents(turn: number): MessageEventInput[] {\n  const events: MessageEventInput[] = [\n    validEvent(\"user_prompt\", {\n      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n    }),\n    validEvent(\"assistant_thinking\", {\n      payload: { text: `considering what area ${turn} contains` },\n    }),\n  ];\n  if (TOOL_HEAVY_TURNS.has(turn)) {\n    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\n    // realistic over-max zone of tool results to age behind the boundary.\n    for (const run of [1, 2]) {\n      const toolCallId = `call-fx-${turn}-${run}`;\n      events.push(\n        validEvent(\"tool_call\", {\n          payload: {\n            toolCallId,\n            toolName: \"read_file\",\n            arguments: { path: `area-${turn}/file-${run}.txt` },\n          },\n        }),\n        validEvent(\"tool_result\", {\n          payload: {\n            toolCallId,\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n            isError: false,\n          },\n        }),\n      );\n    }\n  }\n  events.push(\n    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n    validEvent(\"turn_end\"),\n  );\n  return events;\n}\n\nexport interface DerivedThreadFixture {\n  filePath: string;\n  sdk: Lhc;\n  double: ProviderDouble;\n  turnIds: string[]; // t1..t12\n  chunks: ChunkSnapshot;\n  // The two manufactured failed subjects (tool_result_summary forms), reached\n  // through real retry exhaustion / terminal failure — absent when failures\n  // are disabled for a variant.\n  failedTransientMessageId?: string;\n  failedPermanentMessageId?: string;\n  // The straggler variant's turnId-null messages: one between two turns, one\n  // after the last turn — absent unless stragglers are enabled.\n  stragglerBetweenMessageId?: string;\n  stragglerTrailingMessageId?: string;\n}\n\nexport interface DerivedThreadOptions {\n  failures?: boolean; // default true: manufacture the two failed states\n  stragglers?: boolean; // default false: insert the turnless runtime notes\n}\n\nasync function send(\n  sdk: Lhc,\n  filePath: string,\n  batch: readonly MessageEventInput[],\n): Promise<string[]> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n  return result.value.events.map((entry) => entry.messageId ?? \"\");\n}\n\nasync function drain(sdk: Lhc, filePath: string): Promise<void> {\n  const report = await sdk.work.drain({ filePath });\n  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n  if (report.value.stoppedBecause !== \"empty\" || report.value.remaining !== 0) {\n    throw new Error(\n      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\n    );\n  }\n}\n\nfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\n  return entries.filter((entry) => entry.state === \"failed\" && entry.reason === reason);\n}\n\nexport async function derivedThreadFixture(\n  store: TempStore,\n  opts: DerivedThreadOptions = {},\n): Promise<DerivedThreadFixture> {\n  const failures = opts.failures ?? true;\n  const stragglers = opts.stragglers ?? false;\n\n  const double = createProviderDouble();\n  const sdk = createSdk({\n    provider: double,\n    mode: \"manual\",\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n    chunkPolicy: FIXTURE_CHUNK_POLICY,\n  });\n\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n\n  const turnIds: string[] = [];\n  const fixture: DerivedThreadFixture = {\n    filePath,\n    sdk,\n    double,\n    turnIds,\n    chunks: { chunks: [], members: [] },\n  };\n\n  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\n    if (failures && turn === 6) {\n      // Retryable failures consumed to exhaustion by the head-first drain:\n      // the first tool_result_summary item of this batch takes all three\n      // attempts and lands failed with the transient reason class.\n      double.failKind(\"tool_result_summary\", 3, {\n        retryable: true,\n        reason: TRANSIENT_EXHAUST_REASON,\n      });\n    }\n    if (failures && turn === 7) {\n      // One non-retryable failure: terminal on the first attempt — the\n      // permanent reason class, attempts 1.\n      double.failKind(\"tool_result_summary\", 1, {\n        retryable: false,\n        reason: PERMANENT_FAILURE_REASON,\n      });\n    }\n    const messageIds = await send(sdk, filePath, turnEvents(turn));\n    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\n    // result, call, result, text, end — index 3 is the first tool result,\n    // the scripted failures' subject.\n    const firstToolResultId = messageIds[3];\n    if (failures && (turn === 6 || turn === 7)) {\n      if (firstToolResultId === undefined || firstToolResultId === \"\") {\n        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\n      }\n      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\n      else fixture.failedPermanentMessageId = firstToolResultId;\n    }\n    await drain(sdk, filePath);\n\n    if (stragglers && turn === 3) {\n      // A runtime note between turn 3's end and turn 4's prompt: projected\n      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\n      const noteIds = await send(sdk, filePath, [\n        validEvent(\"runtime_note\", {\n          payload: { text: \"harness restarted between turns (fixture straggler)\" },\n        }),\n      ]);\n      const noteId = noteIds[0];\n      if (noteId === undefined || noteId === \"\") {\n        throw new Error(\"fixture invariant: between-turns straggler did not project\");\n      }\n      fixture.stragglerBetweenMessageId = noteId;\n    }\n    turnIds.push(`t${turn}`);\n  }\n\n  if (stragglers) {\n    const noteIds = await send(sdk, filePath, [\n      validEvent(\"runtime_note\", {\n        payload: { text: \"session closing note after the last turn (fixture straggler)\" },\n      }),\n    ]);\n    const noteId = noteIds[0];\n    if (noteId === undefined || noteId === \"\") {\n      throw new Error(\"fixture invariant: trailing straggler did not project\");\n    }\n    fixture.stragglerTrailingMessageId = noteId;\n    await drain(sdk, filePath);\n  }\n\n  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\n  // chunks, the first three closed. A failure here means the deterministic\n  // substrate moved (provider output or tokenizer), not a flaky test.\n  fixture.chunks = readChunks(filePath);\n  if (fixture.chunks.chunks.length !== 4) {\n    throw new Error(\n      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\n    );\n  }\n  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \"closed\").length;\n  if (closed !== 3) {\n    throw new Error(\n      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\n    );\n  }\n\n  if (failures) {\n    // Verify the manufactured states by read-back through the owning report\n    // surface before handing the fixture to any test (FC-0.3's enforcement\n    // lives in the tests; this guards the builder's own contract).\n    const report = await sdk.messages.report({ filePath });\n    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\n    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\n    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\n    if (\n      transient.length !== 1 ||\n      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\n      permanent.length !== 1 ||\n      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\n    ) {\n      throw new Error(\n        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\n      );\n    }\n  }\n\n  return fixture;\n}\n\n// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\n// conversation with a runtime note between two turns and one after the last\n// turn, fully drained, no manufactured failures.\nexport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\n  return derivedThreadFixture(store, { failures: false, stragglers: true });\n}\n\n// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\n// short real conversation, drained clean, then damaged below the SDK into\n// the two-open-turns state no public operation can produce. Canonical\n// consumers refuse it with state_corruption.\nexport async function corruptedVariantThread(\n  store: TempStore,\n): Promise<{ filePath: string; sdk: Lhc }> {\n  const double = createProviderDouble();\n  const sdk = createSdk({ provider: double, mode: \"manual\" });\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  for (let turn = 1; turn <= 3; turn += 1) {\n    await send(sdk, filePath, turnEvents(turn));\n  }\n  await drain(sdk, filePath);\n  // Open a turn through real intake, then add a second open row: two open\n  // turns, the Epic 01 invariant violation.\n  await send(sdk, filePath, [\n    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n  ]);\n  corruptTwoOpenTurns(filePath);\n  return { filePath, sdk };\n}\n\n// ── Epic 04 Story 2 extensions (test plan: fixture extended in place) ──\n\n// The mutation-in-flight variant: the tool-heavy thread compacted, then ONE\n// edit applied through the production mutation path with the drain NOT\n// settled — so the cascade's cleared-pending states and their queued work\n// are real production states, never hand-written rows (FC-fidelity rule).\n// Serves the mid-rebuild overview shape (TC-1.1) and the rebuild bracket's\n// opening state (TC-4.3).\nexport interface MutationInFlightFixture extends DerivedThreadFixture {\n  compactReceipt: CompactReceipt;\n  editedMessageId: string;\n  // The cascade contract's exact account of the edit: cleared set, queued\n  // replacements, superseded items — what the bracketing health reads\n  // assert against.\n  mutation: MutationResult;\n}\n\nexport async function mutationInFlightVariant(\n  store: TempStore,\n): Promise<MutationInFlightFixture> {\n  // No manufactured failures: the bracket's \"nothing outside the cascade\n  // changed state\" assertion wants a clean baseline.\n  const fixture = await derivedThreadFixture(store, { failures: false });\n  const { sdk, filePath } = fixture;\n\n  const compacted = await sdk.threadView.compact({ filePath }, {});\n  if (!compacted.ok) {\n    throw new Error(`fixture compact failed: ${compacted.error.reason}`);\n  }\n\n  // A mid-thread closed-turn target: turn 2's prompt, so the cascade spans\n  // all three subject kinds — its own smoothed_prompt, t2's two turn forms,\n  // and c1's two chunk summaries.\n  const listed = await sdk.messages.listMessages({ filePath });\n  if (!listed.ok) throw new Error(`fixture list failed: ${listed.error.reason}`);\n  const target = listed.value.find(\n    (record) => record.kind === \"user_prompt\" && record.turnId === \"t2\",\n  );\n  if (target === undefined) {\n    throw new Error(\"fixture invariant: turn 2 carries no prompt message\");\n  }\n\n  const edited = await sdk.messages.edit(\n    { filePath },\n    { messageId: target.messageId, content: \"turn 2 revised: investigate area 2 again\" },\n  );\n  if (!edited.ok) throw new Error(`fixture edit failed: ${edited.error.reason}`);\n\n  return {\n    ...fixture,\n    compactReceipt: compacted.value,\n    editedMessageId: target.messageId,\n    mutation: edited.value,\n  };\n}\n\n// The mixed-state variant (TC-4.1's substrate): one thread carrying every\n// operational state at once — ready (the drained body), failed-transient and\n// failed-permanent (the scripted exhaustions), blocked (a turn derivation\n// meeting real source damage), and pending with live queued work (a partial\n// drain stopping short). All states reached through intake, mutation, and\n// drain behavior; the only below-SDK write is the sanctioned two-open-turns\n// corruption.\nexport interface MixedStateFixture extends DerivedThreadFixture {\n  blockedTurnId: string; // t13: turn forms blocked through the terminal path\n  pendingPromptMessageId: string; // t14's prompt: smoothed_prompt still queued\n}\n\nexport async function mixedStateVariantThread(store: TempStore): Promise<MixedStateFixture> {\n  const fixture = await derivedThreadFixture(store);\n  const { sdk, filePath } = fixture;\n\n  // Turn 13 closes cleanly but is NOT drained: its prompt smoothing and turn\n  // derivation sit queued (events: prompt, thinking, text, end — no tools).\n  await send(sdk, filePath, turnEvents(13));\n\n  // Turn 14 opens with a lone prompt: one more queued smoothing item that the\n  // partial drain below will leave pending.\n  const promptIds = await send(sdk, filePath, [\n    validEvent(\"user_prompt\", {\n      payload: { text: \"turn 14: this prompt's smoothing stays pending\" },\n    }),\n  ]);\n  const pendingPromptMessageId = promptIds[0];\n  if (pendingPromptMessageId === undefined || pendingPromptMessageId === \"\") {\n    throw new Error(\"fixture invariant: turn 14 prompt did not project\");\n  }\n\n  // Real source damage: t14 is open, the corruption writer adds a second open\n  // row — the state t13's claimed derivation meets at drain time.\n  corruptTwoOpenTurns(filePath);\n\n  // Partial drain, head-first FIFO: item 1 is t13's prompt smoothing (ready),\n  // item 2 is t13's turn derivation (terminal on the damage → blocked).\n  // t14's smoothing stays queued — the live pending state.\n  const report = await sdk.work.drain({ filePath }, { maxItems: 2 });\n  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n  const blockedRun = report.value.ran.find(\n    (entry) => entry.kind === \"turn_derivation\" && entry.disposition === \"failed_terminal\",\n  );\n  if (blockedRun === undefined) {\n    throw new Error(\"fixture invariant: turn 13 derivation expected to land terminal on damage\");\n  }\n  if (report.value.remaining !== 1) {\n    throw new Error(\n      `fixture invariant: expected exactly one queued item left, got ${report.value.remaining}`,\n    );\n  }\n\n  return { ...fixture, blockedTurnId: \"t13\", pendingPromptMessageId };\n}\n\n// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\n// queued derivation meets real source damage at drain time — the handler\n// finds two open turns and lands the turn forms blocked through the\n// production terminal path, never a hand-written row.\nexport async function blockedSiblingThread(\n  store: TempStore,\n): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\n  const double = createProviderDouble();\n  const sdk = createSdk({ provider: double, mode: \"manual\" });\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  // Turn 1 closes (its turn_derivation queues); a second turn opens through\n  // real intake; the corruption writer adds another open row. The drain then\n  // claims t1's derivation against a record with two open turns.\n  await send(sdk, filePath, turnEvents(1));\n  await send(sdk, filePath, [\n    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n  ]);\n  corruptTwoOpenTurns(filePath);\n  const report = await sdk.work.drain({ filePath });\n  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n  const blocked = report.value.ran.find(\n    (entry) => entry.kind === \"turn_derivation\" && entry.disposition === \"failed_terminal\",\n  );\n  if (blocked === undefined) {\n    throw new Error(\"fixture invariant: turn_derivation expected to land terminal on damage\");\n  }\n  return { filePath, sdk, blockedTurnId: \"t1\" };\n}\n","numLines":432,"startLine":1,"totalLines":432}}}

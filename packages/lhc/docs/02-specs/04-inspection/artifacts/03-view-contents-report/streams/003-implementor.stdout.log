{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012JvedaNfZ69RKs6yKeU11w","type":"tool_result","content":"1\t// Story 2 (Epic 04), default suite: TC-1.1–1.3 — the inspect overview.\n2\t// One read-only call composing thread identity, event/message/turn/chunk\n3\t// counts, derivation states, view summary, and visibility from the other\n4\t// domains' surfaces. Every thread shape returns the FULL shape with absent\n5\t// pieces as zeros/nulls (AC-1.3); counts honor the deleted contract\n6\t// (AC-1.2); the read is pure (AC-1.4) — asserted as absence of delta and\n7\t// zero provider calls, including under a throwing provider.\n8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n9\timport {\n10\t  createSdk,\n11\t  threadView,\n12\t  type DerivationProvider,\n13\t  type InspectOverview,\n14\t  type Lhc,\n15\t  type MessageEventInput,\n16\t} from \"../src/index.js\";\n17\timport {\n18\t  createProviderDouble,\n19\t  derivedThreadFixture,\n20\t  expectReadOnly,\n21\t  mutationInFlightVariant,\n22\t  tempStore,\n23\t  validEvent,\n24\t  type TempStore,\n25\t} from \"./fixtures/index.js\";\n26\t\n27\tlet store: TempStore;\n28\tbeforeEach(() => {\n29\t  store = tempStore();\n30\t});\n31\tafterEach(() => {\n32\t  store.cleanup();\n33\t});\n34\t\n35\t// A provider whose every operation throws: any inference reached through an\n36\t// inspect read fails the test loudly (the suite-wide zero-provider assert\n37\t// extended to the new operations).\n38\tfunction throwingProvider(): DerivationProvider {\n39\t  const refuse = (): never => {\n40\t    throw new Error(\"provider must never be called by a read operation\");\n41\t  };\n42\t  return {\n43\t    smoothPrompt: refuse,\n44\t    summarizeToolCall: refuse,\n45\t    summarizeToolResult: refuse,\n46\t    composeTurnRendering: refuse,\n47\t    projectLowerBand: refuse,\n48\t    summarizeChunkDetailed: refuse,\n49\t    summarizeChunkBrief: refuse,\n50\t  };\n51\t}\n52\t\n53\tinterface SmallThread {\n54\t  filePath: string;\n55\t  threadId: string;\n56\t  sdk: Lhc;\n57\t  double: ReturnType<typeof createProviderDouble>;\n58\t}\n59\t\n60\t// Two closed turns through real intake, fully drained: m1 prompt, m2 text,\n61\t// m3 call, m4 result (t1; turn_end is event 5), m6 prompt, m7 text (t2;\n62\t// turn_end is event 8). Never compacted.\n63\tasync function twoTurnThread(): Promise<SmallThread> {\n64\t  const double = createProviderDouble();\n65\t  const sdk = createSdk({ provider: double, mode: \"manual\" });\n66\t  const filePath = store.threadPath();\n67\t  const created = await sdk.threads.newThread({\n68\t    filePath,\n69\t    registryPath: store.registryPath,\n70\t    title: \"overview fixture\",\n71\t  });\n72\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n73\t  const batches: MessageEventInput[][] = [\n74\t    [\n75\t      validEvent(\"user_prompt\", { payload: { text: \"please read notes.txt\" } }),\n76\t      validEvent(\"assistant_text\", { payload: { text: \"reading it now\" } }),\n77\t      validEvent(\"tool_call\", {\n78\t        payload: {\n79\t          toolCallId: \"call-ov-1\",\n80\t          toolName: \"read_file\",\n81\t          arguments: { path: \"notes.txt\" },\n82\t        },\n83\t      }),\n84\t      validEvent(\"tool_result\", {\n85\t        payload: { toolCallId: \"call-ov-1\", content: \"contents of notes.txt\", isError: false },\n86\t      }),\n87\t      validEvent(\"turn_end\"),\n88\t    ],\n89\t    [\n90\t      validEvent(\"user_prompt\", { payload: { text: \"summarize what you read\" } }),\n91\t      validEvent(\"assistant_text\", { payload: { text: \"here is the summary\" } }),\n92\t      validEvent(\"turn_end\"),\n93\t    ],\n94\t  ];\n95\t  for (const batch of batches) {\n96\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, batch);\n97\t    if (!sent.ok) throw new Error(`fixture batch failed: ${sent.error.reason}`);\n98\t  }\n99\t  const drained = await sdk.work.drain({ filePath });\n100\t  if (!drained.ok || drained.value.remaining !== 0) {\n101\t    throw new Error(\"fixture drain left work behind\");\n102\t  }\n103\t  return { filePath, threadId: created.value.threadId, sdk, double };\n104\t}\n105\t\n106\tfunction valueOf(result: { ok: boolean }): InspectOverview {\n107\t  if (!result.ok) {\n108\t    throw new Error(`expected ok overview: ${JSON.stringify(result)}`);\n109\t  }\n110\t  return (result as { ok: true; value: InspectOverview }).value;\n111\t}\n112\t\n113\tconst ZERO_DERIVATION = { ready: 0, pending: 0, retrying: 0, failed: 0, blocked: 0 };\n114\t\n115\tdescribe(\"TC-1.1 / AC-1.1, AC-1.3: full overview shape across thread shapes\", () => {\n116\t  it(\"fresh-empty: full shape with zeros and nulls, never omitted fields\", async () => {\n117\t    const double = createProviderDouble();\n118\t    const sdk = createSdk({ provider: double, mode: \"manual\" });\n119\t    const filePath = store.threadPath();\n120\t    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n121\t    expect(created.ok).toBe(true);\n122\t    if (!created.ok) return;\n123\t\n124\t    const overview = valueOf(await sdk.inspect.overview({ filePath }));\n125\t    expect(overview.thread.id).toBe(created.value.threadId);\n126\t    expect(typeof overview.thread.createdAt).toBe(\"string\");\n127\t    expect(overview.events).toEqual({ count: 0, span: null });\n128\t    expect(overview.messages).toEqual({\n129\t      visible: 0,\n130\t      byKind: {},\n131\t      deleted: 0,\n132\t      visibleTokens: 0,\n133\t    });\n134\t    expect(overview.turns).toEqual({ open: 0, closed: 0 });\n135\t    expect(overview.chunks).toEqual({ count: 0, unchunkedTurns: 0 });\n136\t    expect(overview.derivation).toEqual(ZERO_DERIVATION);\n137\t    expect(overview.view).toBeNull();\n138\t    expect(overview.visibility).toEqual({ boundaryPosition: 0, zoneTokens: 0 });\n139\t  });\n140\t\n141\t  it(\"mid-first-turn: open turn, queued derivation, no view — full shape\", async () => {\n142\t    const double = createProviderDouble();\n143\t    const sdk = createSdk({ provider: double, mode: \"manual\" });\n144\t    const filePath = store.threadPath();\n145\t    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n146\t    expect(created.ok).toBe(true);\n147\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\n148\t      validEvent(\"user_prompt\", { payload: { text: \"first prompt, turn still open\" } }),\n149\t      validEvent(\"assistant_thinking\", { payload: { text: \"thinking about it\" } }),\n150\t    ]);\n151\t    expect(sent.ok).toBe(true);\n152\t\n153\t    const overview = valueOf(await sdk.inspect.overview({ filePath }));\n154\t    expect(overview.events).toEqual({ count: 2, span: { first: 1, last: 2 } });\n155\t    expect(overview.messages.visible).toBe(2);\n156\t    expect(overview.messages.byKind).toEqual({ user_prompt: 1, assistant_thinking: 1 });\n157\t    expect(overview.messages.deleted).toBe(0);\n158\t    expect(overview.messages.visibleTokens).toBeGreaterThan(0);\n159\t    expect(overview.turns).toEqual({ open: 1, closed: 0 });\n160\t    expect(overview.chunks).toEqual({ count: 0, unchunkedTurns: 0 });\n161\t    // The prompt's smoothing sits queued, never attempted: pending.\n162\t    expect(overview.derivation).toEqual({ ...ZERO_DERIVATION, pending: 1 });\n163\t    expect(overview.view).toBeNull();\n164\t    expect(overview.visibility.boundaryPosition).toBe(0);\n165\t  });\n166\t\n167\t  it(\"never-compacted-with-record: real counts, view null\", async () => {\n168\t    const { filePath, threadId, sdk } = await twoTurnThread();\n169\t    const overview = valueOf(await sdk.inspect.overview({ filePath }));\n170\t    expect(overview.thread.id).toBe(threadId);\n171\t    expect(overview.events).toEqual({ count: 8, span: { first: 1, last: 8 } });\n172\t    expect(overview.messages.visible).toBe(6);\n173\t    expect(overview.messages.byKind).toEqual({\n174\t      user_prompt: 2,\n175\t      assistant_text: 2,\n176\t      tool_call: 1,\n177\t      tool_result: 1,\n178\t    });\n179\t    expect(overview.messages.deleted).toBe(0);\n180\t    expect(overview.turns).toEqual({ open: 0, closed: 2 });\n181\t    // Both closed turns placed by their derivations into the one open chunk.\n182\t    expect(overview.chunks).toEqual({ count: 1, unchunkedTurns: 0 });\n183\t    // 2 smoothings + 1 call summary + 1 result summary + 2 turns × 2 forms.\n184\t    expect(overview.derivation).toEqual({ ...ZERO_DERIVATION, ready: 8 });\n185\t    expect(overview.view).toBeNull();\n186\t  });\n187\t\n188\t  it(\"compacted tool-heavy fixture: exact counts in every section\", async () => {\n189\t    const fixture = await derivedThreadFixture(store);\n190\t    const { filePath, sdk } = fixture;\n191\t    // sweep: false keeps the two manufactured failed states failed — the\n192\t    // default sweep would requeue the transient one and move the counts.\n193\t    const compacted = await sdk.threadView.compact({ filePath }, { sweep: false });\n194\t    expect(compacted.ok).toBe(true);\n195\t    if (!compacted.ok) return;\n196\t\n197\t    const overview = valueOf(await sdk.inspect.overview({ filePath }));\n198\t    // 8 plain turns × 4 events + 4 tool-heavy turns × 8 events.\n199\t    expect(overview.events).toEqual({ count: 64, span: { first: 1, last: 64 } });\n200\t    // Messages: events minus the 12 turn_ends.\n201\t    expect(overview.messages.visible).toBe(52);\n202\t    expect(overview.messages.byKind).toEqual({\n203\t      user_prompt: 12,\n204\t      assistant_thinking: 12,\n205\t      assistant_text: 12,\n206\t      tool_call: 8,\n207\t      tool_result: 8,\n208\t    });\n209\t    expect(overview.messages.deleted).toBe(0);\n210\t    expect(overview.messages.visibleTokens).toBeGreaterThan(0);\n211\t    expect(overview.turns).toEqual({ open: 0, closed: 12 });\n212\t    expect(overview.chunks).toEqual({ count: 4, unchunkedTurns: 0 });\n213\t    // 12 smoothings + 8 call summaries + 6 ready result summaries + 24 turn\n214\t    // forms + 6 chunk summaries ready; the scripted transient and permanent\n215\t    // exhaustions stay failed.\n216\t    expect(overview.derivation).toEqual({ ...ZERO_DERIVATION, ready: 56, failed: 2 });\n217\t    expect(overview.view).toEqual({\n218\t      viewId: compacted.value.viewId,\n219\t      createdAt: expect.any(String),\n220\t      compactPoint: compacted.value.compactPoint,\n221\t      coveredFrom: compacted.value.coveredFrom,\n222\t    });\n223\t    // Visibility mirrors the serving surface: the stored boundary pull\n224\t    // reports and the zone sum status computes live.\n225\t    const pulled = await threadView.pull({ filePath });\n226\t    const status = await sdk.threadView.status({ filePath });\n227\t    expect(pulled.ok && status.ok).toBe(true);\n228\t    if (!pulled.ok || !status.ok) return;\n229\t    expect(overview.visibility).toEqual({\n230\t      boundaryPosition: pulled.value.meta.boundaryPosition,\n231\t      zoneTokens: status.value.visibility.zoneTokens,\n232\t    });\n233\t  });\n234\t\n235\t  it(\"mid-rebuild: cleared cascade pending, view summary intact — full shape\", async () => {\n236\t    const fixture = await mutationInFlightVariant(store);\n237\t    const overview = valueOf(await fixture.sdk.inspect.overview({ filePath: fixture.filePath }));\n238\t    // The edit cleared exactly the cascade set — its own smoothing, t2's two\n239\t    // turn forms, c1's two chunk summaries — all pending, drain not settled.\n240\t    expect(fixture.mutation.cleared).toHaveLength(5);\n241\t    expect(overview.derivation).toEqual({ ...ZERO_DERIVATION, ready: 53, pending: 5 });\n242\t    expect(overview.turns).toEqual({ open: 0, closed: 12 });\n243\t    expect(overview.chunks).toEqual({ count: 4, unchunkedTurns: 0 });\n244\t    // The view is the pre-edit compact's snapshot, untouched by the mutation.\n245\t    expect(overview.view).toEqual({\n246\t      viewId: fixture.compactReceipt.viewId,\n247\t      createdAt: expect.any(String),\n248\t      compactPoint: fixture.compactReceipt.compactPoint,\n249\t      coveredFrom: fixture.compactReceipt.coveredFrom,\n250\t    });\n251\t    expect(overview.events.count).toBe(64);\n252\t    expect(overview.messages.visible).toBe(52);\n253\t  });\n254\t});\n255\t\n256\tdescribe(\"TC-1.2 / AC-1.2: deleted accounting\", () => {\n257\t  it(\"deleting one message drops visible/kind/token counts, raises deleted, leaves events alone\", async () => {\n258\t    const { filePath, sdk } = await twoTurnThread();\n259\t    const before = valueOf(await sdk.inspect.overview({ filePath }));\n260\t\n261\t    const listed = await sdk.messages.listMessages({ filePath });\n262\t    expect(listed.ok).toBe(true);\n263\t    if (!listed.ok) return;\n264\t    const target = listed.value.find((record) => record.messageId === \"m2\");\n265\t    expect(target?.kind).toBe(\"assistant_text\");\n266\t    if (target === undefined) return;\n267\t\n268\t    const deleted = await sdk.messages.deleteMessage({ filePath }, { messageId: \"m2\" });\n269\t    expect(deleted.ok).toBe(true);\n270\t\n271\t    const after = valueOf(await sdk.inspect.overview({ filePath }));\n272\t    expect(after.messages.visible).toBe(before.messages.visible - 1);\n273\t    expect(after.messages.deleted).toBe(1);\n274\t    expect(after.messages.byKind).toEqual({\n275\t      ...before.messages.byKind,\n276\t      assistant_text: (before.messages.byKind[\"assistant_text\"] ?? 0) - 1,\n277\t    });\n278\t    expect(after.messages.visibleTokens).toBe(\n279\t      before.messages.visibleTokens - target.tokenEstimate,\n280\t    );\n281\t    // The record retains everything: event count and span are unaffected.\n282\t    expect(after.events).toEqual(before.events);\n283\t  });\n284\t});\n285\t\n286\tdescribe(\"TC-1.3 / AC-1.4: overview is a pure read\", () => {\n287\t  it(\"repeated calls are deep-equal, leave no delta, create no work, call no provider\", async () => {\n288\t    const fixture = await mutationInFlightVariant(store);\n289\t    const { filePath, sdk, double } = fixture;\n290\t    const captured = double.captureInputs();\n291\t\n292\t    // Both calls under the read-only delta assert (DD-6): observable state —\n293\t    // queued work, boundary/zone, view identity, events, messages, forms —\n294\t    // is snapshot-equal around each read. No work_item rows can appear under\n295\t    // a green delta (queued work is part of the snapshot).\n296\t    const first = await expectReadOnly(filePath, () => sdk.inspect.overview({ filePath }));\n297\t    const second = await expectReadOnly(filePath, () => sdk.inspect.overview({ filePath }));\n298\t    expect(first.ok && second.ok).toBe(true);\n299\t    expect(second).toEqual(first);\n300\t    expect(captured).toHaveLength(0);\n301\t  });\n302\t\n303\t  it(\"overview succeeds under a throwing provider, and wraps Story 1's reads in the delta assert\", async () => {\n304\t    const { filePath } = await twoTurnThread();\n305\t    // A separate SDK whose provider throws on contact: the read path is\n306\t    // provider-free structurally, in both the new and the Story 1 surfaces.\n307\t    const reader = createSdk({ provider: throwingProvider(), mode: \"manual\" });\n308\t\n309\t    const overview = await expectReadOnly(filePath, () =>\n310\t      reader.inspect.overview({ filePath }),\n311\t    );\n312\t    expect(overview.ok).toBe(true);\n313\t    // Retroactive wrap (test plan, Chunk 2): the Chunk 1 read surface runs\n314\t    // under the same shared delta helper.\n315\t    const listed = await expectReadOnly(filePath, () =>\n316\t      reader.messages.listMessages({ filePath }, { includeDeleted: true }),\n317\t    );\n318\t    const shown = await expectReadOnly(filePath, () => reader.messages.show({ filePath }, \"m1\"));\n319\t    expect(listed.ok && shown.ok).toBe(true);\n320\t  });\n321\t\n322\t  it(\"overview on a missing thread is thread_not_found, not a shape error\", async () => {\n323\t    const sdk = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n324\t    const missing = await sdk.inspect.overview({ filePath: store.threadPath(\"missing\") });\n325\t    expect(missing.ok).toBe(false);\n326\t    if (missing.ok) return;\n327\t    expect(missing.error.errorClass).toBe(\"caller_error\");\n328\t    expect(missing.error.code).toBe(\"thread_not_found\");\n329\t  });\n330\t});\n331\t"}]},"parent_tool_use_id":null,"session_id":"67ded016-4b4e-4398-b028-a8f2c13ea2bb","uuid":"79194fb8-2c6e-4cee-88dc-fc1d74d0e513","timestamp":"2026-06-12T14:45:20.338Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/inspect-overview.test.ts","content":"// Story 2 (Epic 04), default suite: TC-1.1–1.3 — the inspect overview.\n// One read-only call composing thread identity, event/message/turn/chunk\n// counts, derivation states, view summary, and visibility from the other\n// domains' surfaces. Every thread shape returns the FULL shape with absent\n// pieces as zeros/nulls (AC-1.3); counts honor the deleted contract\n// (AC-1.2); the read is pure (AC-1.4) — asserted as absence of delta and\n// zero provider calls, including under a throwing provider.\nimport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\nimport {\n  createSdk,\n  threadView,\n  type DerivationProvider,\n  type InspectOverview,\n  type Lhc,\n  type MessageEventInput,\n} from \"../src/index.js\";\nimport {\n  createProviderDouble,\n  derivedThreadFixture,\n  expectReadOnly,\n  mutationInFlightVariant,\n  tempStore,\n  validEvent,\n  type TempStore,\n} from \"./fixtures/index.js\";\n\nlet store: TempStore;\nbeforeEach(() => {\n  store = tempStore();\n});\nafterEach(() => {\n  store.cleanup();\n});\n\n// A provider whose every operation throws: any inference reached through an\n// inspect read fails the test loudly (the suite-wide zero-provider assert\n// extended to the new operations).\nfunction throwingProvider(): DerivationProvider {\n  const refuse = (): never => {\n    throw new Error(\"provider must never be called by a read operation\");\n  };\n  return {\n    smoothPrompt: refuse,\n    summarizeToolCall: refuse,\n    summarizeToolResult: refuse,\n    composeTurnRendering: refuse,\n    projectLowerBand: refuse,\n    summarizeChunkDetailed: refuse,\n    summarizeChunkBrief: refuse,\n  };\n}\n\ninterface SmallThread {\n  filePath: string;\n  threadId: string;\n  sdk: Lhc;\n  double: ReturnType<typeof createProviderDouble>;\n}\n\n// Two closed turns through real intake, fully drained: m1 prompt, m2 text,\n// m3 call, m4 result (t1; turn_end is event 5), m6 prompt, m7 text (t2;\n// turn_end is event 8). Never compacted.\nasync function twoTurnThread(): Promise<SmallThread> {\n  const double = createProviderDouble();\n  const sdk = createSdk({ provider: double, mode: \"manual\" });\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({\n    filePath,\n    registryPath: store.registryPath,\n    title: \"overview fixture\",\n  });\n  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n  const batches: MessageEventInput[][] = [\n    [\n      validEvent(\"user_prompt\", { payload: { text: \"please read notes.txt\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"reading it now\" } }),\n      validEvent(\"tool_call\", {\n        payload: {\n          toolCallId: \"call-ov-1\",\n          toolName: \"read_file\",\n          arguments: { path: \"notes.txt\" },\n        },\n      }),\n      validEvent(\"tool_result\", {\n        payload: { toolCallId: \"call-ov-1\", content: \"contents of notes.txt\", isError: false },\n      }),\n      validEvent(\"turn_end\"),\n    ],\n    [\n      validEvent(\"user_prompt\", { payload: { text: \"summarize what you read\" } }),\n      validEvent(\"assistant_text\", { payload: { text: \"here is the summary\" } }),\n      validEvent(\"turn_end\"),\n    ],\n  ];\n  for (const batch of batches) {\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    if (!sent.ok) throw new Error(`fixture batch failed: ${sent.error.reason}`);\n  }\n  const drained = await sdk.work.drain({ filePath });\n  if (!drained.ok || drained.value.remaining !== 0) {\n    throw new Error(\"fixture drain left work behind\");\n  }\n  return { filePath, threadId: created.value.threadId, sdk, double };\n}\n\nfunction valueOf(result: { ok: boolean }): InspectOverview {\n  if (!result.ok) {\n    throw new Error(`expected ok overview: ${JSON.stringify(result)}`);\n  }\n  return (result as { ok: true; value: InspectOverview }).value;\n}\n\nconst ZERO_DERIVATION = { ready: 0, pending: 0, retrying: 0, failed: 0, blocked: 0 };\n\ndescribe(\"TC-1.1 / AC-1.1, AC-1.3: full overview shape across thread shapes\", () => {\n  it(\"fresh-empty: full shape with zeros and nulls, never omitted fields\", async () => {\n    const double = createProviderDouble();\n    const sdk = createSdk({ provider: double, mode: \"manual\" });\n    const filePath = store.threadPath();\n    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n    expect(created.ok).toBe(true);\n    if (!created.ok) return;\n\n    const overview = valueOf(await sdk.inspect.overview({ filePath }));\n    expect(overview.thread.id).toBe(created.value.threadId);\n    expect(typeof overview.thread.createdAt).toBe(\"string\");\n    expect(overview.events).toEqual({ count: 0, span: null });\n    expect(overview.messages).toEqual({\n      visible: 0,\n      byKind: {},\n      deleted: 0,\n      visibleTokens: 0,\n    });\n    expect(overview.turns).toEqual({ open: 0, closed: 0 });\n    expect(overview.chunks).toEqual({ count: 0, unchunkedTurns: 0 });\n    expect(overview.derivation).toEqual(ZERO_DERIVATION);\n    expect(overview.view).toBeNull();\n    expect(overview.visibility).toEqual({ boundaryPosition: 0, zoneTokens: 0 });\n  });\n\n  it(\"mid-first-turn: open turn, queued derivation, no view — full shape\", async () => {\n    const double = createProviderDouble();\n    const sdk = createSdk({ provider: double, mode: \"manual\" });\n    const filePath = store.threadPath();\n    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n    expect(created.ok).toBe(true);\n    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\n      validEvent(\"user_prompt\", { payload: { text: \"first prompt, turn still open\" } }),\n      validEvent(\"assistant_thinking\", { payload: { text: \"thinking about it\" } }),\n    ]);\n    expect(sent.ok).toBe(true);\n\n    const overview = valueOf(await sdk.inspect.overview({ filePath }));\n    expect(overview.events).toEqual({ count: 2, span: { first: 1, last: 2 } });\n    expect(overview.messages.visible).toBe(2);\n    expect(overview.messages.byKind).toEqual({ user_prompt: 1, assistant_thinking: 1 });\n    expect(overview.messages.deleted).toBe(0);\n    expect(overview.messages.visibleTokens).toBeGreaterThan(0);\n    expect(overview.turns).toEqual({ open: 1, closed: 0 });\n    expect(overview.chunks).toEqual({ count: 0, unchunkedTurns: 0 });\n    // The prompt's smoothing sits queued, never attempted: pending.\n    expect(overview.derivation).toEqual({ ...ZERO_DERIVATION, pending: 1 });\n    expect(overview.view).toBeNull();\n    expect(overview.visibility.boundaryPosition).toBe(0);\n  });\n\n  it(\"never-compacted-with-record: real counts, view null\", async () => {\n    const { filePath, threadId, sdk } = await twoTurnThread();\n    const overview = valueOf(await sdk.inspect.overview({ filePath }));\n    expect(overview.thread.id).toBe(threadId);\n    expect(overview.events).toEqual({ count: 8, span: { first: 1, last: 8 } });\n    expect(overview.messages.visible).toBe(6);\n    expect(overview.messages.byKind).toEqual({\n      user_prompt: 2,\n      assistant_text: 2,\n      tool_call: 1,\n      tool_result: 1,\n    });\n    expect(overview.messages.deleted).toBe(0);\n    expect(overview.turns).toEqual({ open: 0, closed: 2 });\n    // Both closed turns placed by their derivations into the one open chunk.\n    expect(overview.chunks).toEqual({ count: 1, unchunkedTurns: 0 });\n    // 2 smoothings + 1 call summary + 1 result summary + 2 turns × 2 forms.\n    expect(overview.derivation).toEqual({ ...ZERO_DERIVATION, ready: 8 });\n    expect(overview.view).toBeNull();\n  });\n\n  it(\"compacted tool-heavy fixture: exact counts in every section\", async () => {\n    const fixture = await derivedThreadFixture(store);\n    const { filePath, sdk } = fixture;\n    // sweep: false keeps the two manufactured failed states failed — the\n    // default sweep would requeue the transient one and move the counts.\n    const compacted = await sdk.threadView.compact({ filePath }, { sweep: false });\n    expect(compacted.ok).toBe(true);\n    if (!compacted.ok) return;\n\n    const overview = valueOf(await sdk.inspect.overview({ filePath }));\n    // 8 plain turns × 4 events + 4 tool-heavy turns × 8 events.\n    expect(overview.events).toEqual({ count: 64, span: { first: 1, last: 64 } });\n    // Messages: events minus the 12 turn_ends.\n    expect(overview.messages.visible).toBe(52);\n    expect(overview.messages.byKind).toEqual({\n      user_prompt: 12,\n      assistant_thinking: 12,\n      assistant_text: 12,\n      tool_call: 8,\n      tool_result: 8,\n    });\n    expect(overview.messages.deleted).toBe(0);\n    expect(overview.messages.visibleTokens).toBeGreaterThan(0);\n    expect(overview.turns).toEqual({ open: 0, closed: 12 });\n    expect(overview.chunks).toEqual({ count: 4, unchunkedTurns: 0 });\n    // 12 smoothings + 8 call summaries + 6 ready result summaries + 24 turn\n    // forms + 6 chunk summaries ready; the scripted transient and permanent\n    // exhaustions stay failed.\n    expect(overview.derivation).toEqual({ ...ZERO_DERIVATION, ready: 56, failed: 2 });\n    expect(overview.view).toEqual({\n      viewId: compacted.value.viewId,\n      createdAt: expect.any(String),\n      compactPoint: compacted.value.compactPoint,\n      coveredFrom: compacted.value.coveredFrom,\n    });\n    // Visibility mirrors the serving surface: the stored boundary pull\n    // reports and the zone sum status computes live.\n    const pulled = await threadView.pull({ filePath });\n    const status = await sdk.threadView.status({ filePath });\n    expect(pulled.ok && status.ok).toBe(true);\n    if (!pulled.ok || !status.ok) return;\n    expect(overview.visibility).toEqual({\n      boundaryPosition: pulled.value.meta.boundaryPosition,\n      zoneTokens: status.value.visibility.zoneTokens,\n    });\n  });\n\n  it(\"mid-rebuild: cleared cascade pending, view summary intact — full shape\", async () => {\n    const fixture = await mutationInFlightVariant(store);\n    const overview = valueOf(await fixture.sdk.inspect.overview({ filePath: fixture.filePath }));\n    // The edit cleared exactly the cascade set — its own smoothing, t2's two\n    // turn forms, c1's two chunk summaries — all pending, drain not settled.\n    expect(fixture.mutation.cleared).toHaveLength(5);\n    expect(overview.derivation).toEqual({ ...ZERO_DERIVATION, ready: 53, pending: 5 });\n    expect(overview.turns).toEqual({ open: 0, closed: 12 });\n    expect(overview.chunks).toEqual({ count: 4, unchunkedTurns: 0 });\n    // The view is the pre-edit compact's snapshot, untouched by the mutation.\n    expect(overview.view).toEqual({\n      viewId: fixture.compactReceipt.viewId,\n      createdAt: expect.any(String),\n      compactPoint: fixture.compactReceipt.compactPoint,\n      coveredFrom: fixture.compactReceipt.coveredFrom,\n    });\n    expect(overview.events.count).toBe(64);\n    expect(overview.messages.visible).toBe(52);\n  });\n});\n\ndescribe(\"TC-1.2 / AC-1.2: deleted accounting\", () => {\n  it(\"deleting one message drops visible/kind/token counts, raises deleted, leaves events alone\", async () => {\n    const { filePath, sdk } = await twoTurnThread();\n    const before = valueOf(await sdk.inspect.overview({ filePath }));\n\n    const listed = await sdk.messages.listMessages({ filePath });\n    expect(listed.ok).toBe(true);\n    if (!listed.ok) return;\n    const target = listed.value.find((record) => record.messageId === \"m2\");\n    expect(target?.kind).toBe(\"assistant_text\");\n    if (target === undefined) return;\n\n    const deleted = await sdk.messages.deleteMessage({ filePath }, { messageId: \"m2\" });\n    expect(deleted.ok).toBe(true);\n\n    const after = valueOf(await sdk.inspect.overview({ filePath }));\n    expect(after.messages.visible).toBe(before.messages.visible - 1);\n    expect(after.messages.deleted).toBe(1);\n    expect(after.messages.byKind).toEqual({\n      ...before.messages.byKind,\n      assistant_text: (before.messages.byKind[\"assistant_text\"] ?? 0) - 1,\n    });\n    expect(after.messages.visibleTokens).toBe(\n      before.messages.visibleTokens - target.tokenEstimate,\n    );\n    // The record retains everything: event count and span are unaffected.\n    expect(after.events).toEqual(before.events);\n  });\n});\n\ndescribe(\"TC-1.3 / AC-1.4: overview is a pure read\", () => {\n  it(\"repeated calls are deep-equal, leave no delta, create no work, call no provider\", async () => {\n    const fixture = await mutationInFlightVariant(store);\n    const { filePath, sdk, double } = fixture;\n    const captured = double.captureInputs();\n\n    // Both calls under the read-only delta assert (DD-6): observable state —\n    // queued work, boundary/zone, view identity, events, messages, forms —\n    // is snapshot-equal around each read. No work_item rows can appear under\n    // a green delta (queued work is part of the snapshot).\n    const first = await expectReadOnly(filePath, () => sdk.inspect.overview({ filePath }));\n    const second = await expectReadOnly(filePath, () => sdk.inspect.overview({ filePath }));\n    expect(first.ok && second.ok).toBe(true);\n    expect(second).toEqual(first);\n    expect(captured).toHaveLength(0);\n  });\n\n  it(\"overview succeeds under a throwing provider, and wraps Story 1's reads in the delta assert\", async () => {\n    const { filePath } = await twoTurnThread();\n    // A separate SDK whose provider throws on contact: the read path is\n    // provider-free structurally, in both the new and the Story 1 surfaces.\n    const reader = createSdk({ provider: throwingProvider(), mode: \"manual\" });\n\n    const overview = await expectReadOnly(filePath, () =>\n      reader.inspect.overview({ filePath }),\n    );\n    expect(overview.ok).toBe(true);\n    // Retroactive wrap (test plan, Chunk 2): the Chunk 1 read surface runs\n    // under the same shared delta helper.\n    const listed = await expectReadOnly(filePath, () =>\n      reader.messages.listMessages({ filePath }, { includeDeleted: true }),\n    );\n    const shown = await expectReadOnly(filePath, () => reader.messages.show({ filePath }, \"m1\"));\n    expect(listed.ok && shown.ok).toBe(true);\n  });\n\n  it(\"overview on a missing thread is thread_not_found, not a shape error\", async () => {\n    const sdk = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n    const missing = await sdk.inspect.overview({ filePath: store.threadPath(\"missing\") });\n    expect(missing.ok).toBe(false);\n    if (missing.ok) return;\n    expect(missing.error.errorClass).toBe(\"caller_error\");\n    expect(missing.error.code).toBe(\"thread_not_found\");\n  });\n});\n","numLines":331,"startLine":1,"totalLines":331}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HF2U22KsNYZLTZt5DqpDZE","type":"tool_result","content":"1\t// The shared read-only delta helper (Epic 04, DD-6): inspect describes,\n2\t// never changes — and that is asserted as ABSENCE OF DELTA in observable\n3\t// state, not absence of write code. Snapshot everything a forgotten side\n4\t// effect could move — queued work through both owners, boundary/zone/view\n5\t// identity through the thread-view surface, the event log, the audit message\n6\t// listing, and the raw derived-form rows — before and after an operation,\n7\t// and require deep equality. Lands with Story 2 and wraps Story 1's read\n8\t// ops retroactively (test plan, Chunk 2).\n9\timport { deepStrictEqual } from \"node:assert/strict\";\n10\timport { intakeStream, messages, threadView, turns } from \"../../src/index.js\";\n11\timport { readDerivedForms } from \"./threads.js\";\n12\t\n13\texport interface ObservableState {\n14\t  events: unknown;\n15\t  messages: unknown;\n16\t  messageWork: unknown;\n17\t  turnWork: unknown;\n18\t  viewStatus: unknown;\n19\t  pullMeta: unknown;\n20\t  forms: unknown;\n21\t}\n22\t\n23\texport async function observableState(filePath: string): Promise<ObservableState> {\n24\t  const pulled = await threadView.pull({ filePath });\n25\t  return {\n26\t    events: await intakeStream.listEvents({ filePath }),\n27\t    messages: await messages.listMessages({ filePath }, { includeDeleted: true }),\n28\t    messageWork: await messages.listQueuedWork({ filePath }),\n29\t    turnWork: await turns.listQueuedWork({ filePath }),\n30\t    viewStatus: await threadView.status({ filePath }),\n31\t    pullMeta: pulled.ok ? pulled.value.meta : pulled,\n32\t    forms: readDerivedForms(filePath),\n33\t  };\n34\t}\n35\t\n36\t// Run one operation under the before/after snapshot and return its result so\n37\t// call sites can keep asserting on it. Throws (deepStrictEqual) when the\n38\t// operation moved anything observable.\n39\texport async function expectReadOnly<T>(\n40\t  filePath: string,\n41\t  operation: () => Promise<T>,\n42\t): Promise<T> {\n43\t  const before = await observableState(filePath);\n44\t  const result = await operation();\n45\t  deepStrictEqual(\n46\t    await observableState(filePath),\n47\t    before,\n48\t    \"read-only delta: operation changed observable state\",\n49\t  );\n50\t  return result;\n51\t}\n52\t"}]},"parent_tool_use_id":null,"session_id":"67ded016-4b4e-4398-b028-a8f2c13ea2bb","uuid":"fef1fbb9-bb80-4518-a836-864959f24722","timestamp":"2026-06-12T14:43:00.193Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/read-only-delta.ts","content":"// The shared read-only delta helper (Epic 04, DD-6): inspect describes,\n// never changes — and that is asserted as ABSENCE OF DELTA in observable\n// state, not absence of write code. Snapshot everything a forgotten side\n// effect could move — queued work through both owners, boundary/zone/view\n// identity through the thread-view surface, the event log, the audit message\n// listing, and the raw derived-form rows — before and after an operation,\n// and require deep equality. Lands with Story 2 and wraps Story 1's read\n// ops retroactively (test plan, Chunk 2).\nimport { deepStrictEqual } from \"node:assert/strict\";\nimport { intakeStream, messages, threadView, turns } from \"../../src/index.js\";\nimport { readDerivedForms } from \"./threads.js\";\n\nexport interface ObservableState {\n  events: unknown;\n  messages: unknown;\n  messageWork: unknown;\n  turnWork: unknown;\n  viewStatus: unknown;\n  pullMeta: unknown;\n  forms: unknown;\n}\n\nexport async function observableState(filePath: string): Promise<ObservableState> {\n  const pulled = await threadView.pull({ filePath });\n  return {\n    events: await intakeStream.listEvents({ filePath }),\n    messages: await messages.listMessages({ filePath }, { includeDeleted: true }),\n    messageWork: await messages.listQueuedWork({ filePath }),\n    turnWork: await turns.listQueuedWork({ filePath }),\n    viewStatus: await threadView.status({ filePath }),\n    pullMeta: pulled.ok ? pulled.value.meta : pulled,\n    forms: readDerivedForms(filePath),\n  };\n}\n\n// Run one operation under the before/after snapshot and return its result so\n// call sites can keep asserting on it. Throws (deepStrictEqual) when the\n// operation moved anything observable.\nexport async function expectReadOnly<T>(\n  filePath: string,\n  operation: () => Promise<T>,\n): Promise<T> {\n  const before = await observableState(filePath);\n  const result = await operation();\n  deepStrictEqual(\n    await observableState(filePath),\n    before,\n    \"read-only delta: operation changed observable state\",\n  );\n  return result;\n}\n","numLines":52,"startLine":1,"totalLines":52}}}

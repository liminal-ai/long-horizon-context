{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015y4oojMuo6gLWAr2YYZo6c","type":"tool_result","content":"30\t  return Array<string>(n).fill(\"tok\").join(\" \");\n31\t}\n32\t\n33\t// The story's test budgets: max 100 > target 60 ≥ floor 30 (AC-4.8 ordering).\n34\tconst BUDGETS = { maxTokens: 100, targetTokens: 60, floorTokens: 30 };\n35\t\n36\tconst stores: TempStore[] = [];\n37\tafterEach(() => {\n38\t  setViewInjectionHook(\"post-commit-advance\", null);\n39\t  setSchedulerPoke(null);\n40\t  for (const store of stores.splice(0)) store.cleanup();\n41\t});\n42\t\n43\tfunction visSdk(view: SdkViewConfig = { visibility: BUDGETS }, mode: \"manual\" | \"background\" = \"manual\"): Lhc {\n44\t  return createSdk({ provider: createProviderDouble(), mode, view });\n45\t}\n46\t\n47\tasync function newThread(sdk: Lhc): Promise<string> {\n48\t  const store = tempStore();\n49\t  stores.push(store);\n50\t  const filePath = store.threadPath();\n51\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n52\t  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n53\t  return filePath;\n54\t}\n55\t\n56\tlet callCounter = 0;\n57\t\n58\t// One tool run: call + result with the given token count.\n59\tfunction toolRun(resultTokens: number): MessageEventInput[] {\n60\t  callCounter += 1;\n61\t  const toolCallId = `call-vb-${callCounter}`;\n62\t  return [\n63\t    validEvent(\"tool_call\", {\n64\t      payload: { toolCallId, toolName: \"read_file\", arguments: { path: `vb-${callCounter}.txt` } },\n65\t    }),\n66\t    validEvent(\"tool_result\", {\n67\t      payload: { toolCallId, content: tokens(resultTokens), isError: false },\n68\t    }),\n69\t  ];\n70\t}\n71\t\n72\t// One scripted turn: prompt, a tool run per entry, optional turn_end.\n73\tfunction toolTurn(resultTokens: readonly number[], opts: { turnEnd?: boolean } = {}): MessageEventInput[] {\n74\t  const events: MessageEventInput[] = [\n75\t    validEvent(\"user_prompt\", { payload: { text: \"scripted boundary turn\" } }),\n76\t  ];\n77\t  for (const n of resultTokens) events.push(...toolRun(n));\n78\t  if (opts.turnEnd !== false) events.push(validEvent(\"turn_end\"));\n79\t  return events;\n80\t}\n81\t\n82\tasync function intake(sdk: Lhc, filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n83\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n84\t  if (!result.ok) throw new Error(`intake failed: ${result.error.reason}`);\n85\t}\n86\t\n87\tasync function boundaryOf(sdk: Lhc, filePath: string): Promise<number> {\n88\t  const pulled = await sdk.threadView.pull({ filePath });\n89\t  if (!pulled.ok) throw new Error(`pull failed: ${pulled.error.reason}`);\n90\t  return pulled.value.meta.boundaryPosition;\n91\t}\n92\t\n93\tasync function toolResults(\n94\t  sdk: Lhc,\n95\t  filePath: string,\n96\t): Promise<Array<{ messageId: string; sourceEventOrder: number; tokenEstimate: number }>> {\n97\t  const listed = await sdk.messages.listMessages({ filePath });\n98\t  if (!listed.ok) throw new Error(`listMessages failed: ${listed.error.reason}`);\n99\t  return listed.value\n100\t    .filter((m) => m.kind === \"tool_result\")\n101\t    .map((m) => ({\n102\t      messageId: m.messageId,\n103\t      sourceEventOrder: m.sourceEventOrder,\n104\t      tokenEstimate: m.tokenEstimate,\n105\t    }));\n106\t}\n107\t\n108\tfunction abridgedCount(messages: ReadonlyArray<{ content: string }>): number {\n109\t  return messages.filter((m) => m.content.startsWith(\"[tool result · \") && m.content.includes(\" · abridged]\"))\n110\t    .length;\n111\t}\n112\t\n113\tdescribe(\"TC-4.1 (AC-4.3): under-max batches never move the boundary; the crossing batch moves once to target, oldest-first\", () => {\n114\t  it(\"holds position and bytes below max, then flips exactly one oldest-first batch of results\", async () => {\n115\t    const sdk = visSdk();\n116\t    const filePath = await newThread(sdk);\n117\t\n118\t    // Two under-max batches (zone 40, then 80 ≤ max 100): boundary unmoved.\n119\t    await intake(sdk, filePath, toolTurn([20, 20]));\n120\t    const afterFirst = await sdk.threadView.pull({ filePath });\n121\t    expect(afterFirst.ok).toBe(true);\n122\t    if (!afterFirst.ok) return;\n123\t    expect(afterFirst.value.meta.boundaryPosition).toBe(0);\n124\t\n125\t    await intake(sdk, filePath, toolTurn([20, 20]));\n126\t    const afterSecond = await sdk.threadView.pull({ filePath });\n127\t    expect(afterSecond.ok).toBe(true);\n128\t    if (!afterSecond.ok) return;\n129\t    expect(afterSecond.value.meta.boundaryPosition).toBe(0);\n130\t    // Rendered bytes do not change below max: the earlier pull's messages are\n131\t    // a byte-identical prefix of the later one (AC-4.3's no-churn half).\n132\t    expect(afterSecond.value.messages.slice(0, afterFirst.value.messages.length)).toEqual(\n133\t      afterFirst.value.messages,\n134\t    );\n135\t    expect(abridgedCount(afterSecond.value.messages)).toBe(0);\n136\t\n137\t    // The crossing batch (zone 120 > 100): one advance to target — the three\n138\t    // oldest results flip (120→100→80→60 = target), the newer three stay\n139\t    // full; the protected set (newest joined to 40 ≥ floor 30) is untouched.\n140\t    await intake(sdk, filePath, toolTurn([20, 20]));\n141\t    const results = await toolResults(sdk, filePath);\n142\t    expect(results).toHaveLength(6);\n143\t    const expectedPosition = results[2]?.sourceEventOrder;\n144\t    const crossed = await sdk.threadView.pull({ filePath });\n145\t    expect(crossed.ok).toBe(true);\n146\t    if (!crossed.ok) return;\n147\t    expect(crossed.value.meta.boundaryPosition).toBe(expectedPosition);\n148\t    expect(abridgedCount(crossed.value.messages)).toBe(3);\n149\t\n150\t    // Oldest-first: precisely the first three results render abridged.\n151\t    const abridgedIds = results\n152\t      .filter((r) => r.sourceEventOrder <= (expectedPosition ?? 0))\n153\t      .map((r) => r.messageId);\n154\t    expect(abridgedIds).toEqual(results.slice(0, 3).map((r) => r.messageId));\n155\t\n156\t    // DoD: status's zone sum equals the advance's decision sum on the same\n157\t    // state — the live tool-result estimates ahead of the boundary.\n158\t    const status = await sdk.threadView.status({ filePath });\n159\t    expect(status.ok).toBe(true);\n160\t    if (!status.ok) return;\n161\t    const expectedZone = results\n162\t      .filter((r) => r.sourceEventOrder > (expectedPosition ?? 0))\n163\t      .reduce((sum, r) => sum + r.tokenEstimate, 0);\n164\t    expect(status.value.visibility.zoneTokens).toBe(expectedZone);\n165\t    expect(status.value.visibility.zoneTokens).toBe(60);\n166\t\n167\t    // The next under-max batch (zone 70 ≤ 100): no movement.\n168\t    await intake(sdk, filePath, toolTurn([10]));\n169\t    expect(await boundaryOf(sdk, filePath)).toBe(expectedPosition);"}]},"parent_tool_use_id":null,"session_id":"67ded016-4b4e-4398-b028-a8f2c13ea2bb","uuid":"d9f0b7fb-5328-48f2-8b23-db0593116ae3","timestamp":"2026-06-12T14:48:07.541Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/view-boundary.test.ts","content":"  return Array<string>(n).fill(\"tok\").join(\" \");\n}\n\n// The story's test budgets: max 100 > target 60 ≥ floor 30 (AC-4.8 ordering).\nconst BUDGETS = { maxTokens: 100, targetTokens: 60, floorTokens: 30 };\n\nconst stores: TempStore[] = [];\nafterEach(() => {\n  setViewInjectionHook(\"post-commit-advance\", null);\n  setSchedulerPoke(null);\n  for (const store of stores.splice(0)) store.cleanup();\n});\n\nfunction visSdk(view: SdkViewConfig = { visibility: BUDGETS }, mode: \"manual\" | \"background\" = \"manual\"): Lhc {\n  return createSdk({ provider: createProviderDouble(), mode, view });\n}\n\nasync function newThread(sdk: Lhc): Promise<string> {\n  const store = tempStore();\n  stores.push(store);\n  const filePath = store.threadPath();\n  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n  if (!created.ok) throw new Error(`thread creation failed: ${created.error.reason}`);\n  return filePath;\n}\n\nlet callCounter = 0;\n\n// One tool run: call + result with the given token count.\nfunction toolRun(resultTokens: number): MessageEventInput[] {\n  callCounter += 1;\n  const toolCallId = `call-vb-${callCounter}`;\n  return [\n    validEvent(\"tool_call\", {\n      payload: { toolCallId, toolName: \"read_file\", arguments: { path: `vb-${callCounter}.txt` } },\n    }),\n    validEvent(\"tool_result\", {\n      payload: { toolCallId, content: tokens(resultTokens), isError: false },\n    }),\n  ];\n}\n\n// One scripted turn: prompt, a tool run per entry, optional turn_end.\nfunction toolTurn(resultTokens: readonly number[], opts: { turnEnd?: boolean } = {}): MessageEventInput[] {\n  const events: MessageEventInput[] = [\n    validEvent(\"user_prompt\", { payload: { text: \"scripted boundary turn\" } }),\n  ];\n  for (const n of resultTokens) events.push(...toolRun(n));\n  if (opts.turnEnd !== false) events.push(validEvent(\"turn_end\"));\n  return events;\n}\n\nasync function intake(sdk: Lhc, filePath: string, batch: readonly MessageEventInput[]): Promise<void> {\n  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n  if (!result.ok) throw new Error(`intake failed: ${result.error.reason}`);\n}\n\nasync function boundaryOf(sdk: Lhc, filePath: string): Promise<number> {\n  const pulled = await sdk.threadView.pull({ filePath });\n  if (!pulled.ok) throw new Error(`pull failed: ${pulled.error.reason}`);\n  return pulled.value.meta.boundaryPosition;\n}\n\nasync function toolResults(\n  sdk: Lhc,\n  filePath: string,\n): Promise<Array<{ messageId: string; sourceEventOrder: number; tokenEstimate: number }>> {\n  const listed = await sdk.messages.listMessages({ filePath });\n  if (!listed.ok) throw new Error(`listMessages failed: ${listed.error.reason}`);\n  return listed.value\n    .filter((m) => m.kind === \"tool_result\")\n    .map((m) => ({\n      messageId: m.messageId,\n      sourceEventOrder: m.sourceEventOrder,\n      tokenEstimate: m.tokenEstimate,\n    }));\n}\n\nfunction abridgedCount(messages: ReadonlyArray<{ content: string }>): number {\n  return messages.filter((m) => m.content.startsWith(\"[tool result · \") && m.content.includes(\" · abridged]\"))\n    .length;\n}\n\ndescribe(\"TC-4.1 (AC-4.3): under-max batches never move the boundary; the crossing batch moves once to target, oldest-first\", () => {\n  it(\"holds position and bytes below max, then flips exactly one oldest-first batch of results\", async () => {\n    const sdk = visSdk();\n    const filePath = await newThread(sdk);\n\n    // Two under-max batches (zone 40, then 80 ≤ max 100): boundary unmoved.\n    await intake(sdk, filePath, toolTurn([20, 20]));\n    const afterFirst = await sdk.threadView.pull({ filePath });\n    expect(afterFirst.ok).toBe(true);\n    if (!afterFirst.ok) return;\n    expect(afterFirst.value.meta.boundaryPosition).toBe(0);\n\n    await intake(sdk, filePath, toolTurn([20, 20]));\n    const afterSecond = await sdk.threadView.pull({ filePath });\n    expect(afterSecond.ok).toBe(true);\n    if (!afterSecond.ok) return;\n    expect(afterSecond.value.meta.boundaryPosition).toBe(0);\n    // Rendered bytes do not change below max: the earlier pull's messages are\n    // a byte-identical prefix of the later one (AC-4.3's no-churn half).\n    expect(afterSecond.value.messages.slice(0, afterFirst.value.messages.length)).toEqual(\n      afterFirst.value.messages,\n    );\n    expect(abridgedCount(afterSecond.value.messages)).toBe(0);\n\n    // The crossing batch (zone 120 > 100): one advance to target — the three\n    // oldest results flip (120→100→80→60 = target), the newer three stay\n    // full; the protected set (newest joined to 40 ≥ floor 30) is untouched.\n    await intake(sdk, filePath, toolTurn([20, 20]));\n    const results = await toolResults(sdk, filePath);\n    expect(results).toHaveLength(6);\n    const expectedPosition = results[2]?.sourceEventOrder;\n    const crossed = await sdk.threadView.pull({ filePath });\n    expect(crossed.ok).toBe(true);\n    if (!crossed.ok) return;\n    expect(crossed.value.meta.boundaryPosition).toBe(expectedPosition);\n    expect(abridgedCount(crossed.value.messages)).toBe(3);\n\n    // Oldest-first: precisely the first three results render abridged.\n    const abridgedIds = results\n      .filter((r) => r.sourceEventOrder <= (expectedPosition ?? 0))\n      .map((r) => r.messageId);\n    expect(abridgedIds).toEqual(results.slice(0, 3).map((r) => r.messageId));\n\n    // DoD: status's zone sum equals the advance's decision sum on the same\n    // state — the live tool-result estimates ahead of the boundary.\n    const status = await sdk.threadView.status({ filePath });\n    expect(status.ok).toBe(true);\n    if (!status.ok) return;\n    const expectedZone = results\n      .filter((r) => r.sourceEventOrder > (expectedPosition ?? 0))\n      .reduce((sum, r) => sum + r.tokenEstimate, 0);\n    expect(status.value.visibility.zoneTokens).toBe(expectedZone);\n    expect(status.value.visibility.zoneTokens).toBe(60);\n\n    // The next under-max batch (zone 70 ≤ 100): no movement.\n    await intake(sdk, filePath, toolTurn([10]));\n    expect(await boundaryOf(sdk, filePath)).toBe(expectedPosition);","numLines":140,"startLine":30,"totalLines":507}}}

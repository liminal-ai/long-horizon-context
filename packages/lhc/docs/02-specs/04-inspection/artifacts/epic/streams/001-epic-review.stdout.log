{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AsUBPcce3an9PZg5K96Bhr","type":"tool_result","content":"1\t// Health composition (Flow 4): both owners' report surfaces joined into\n2\t// state counts, actionable failure detail, a repair preview, and live queue\n3\t// visibility. Assembled ENTIRELY from FormReportEntry rows — never a\n4\t// derived_form or work_item read (the must-not-own rule is this domain's\n5\t// whole contract) — and never executing what it previews (AC-4.3).\n6\timport type { FormReportEntry } from \"../../../shared/derivation.js\";\n7\timport type { OpResult } from \"../../../shared/errors.js\";\n8\timport type { HealthReport } from \"../../../shared/inspect.js\";\n9\timport * as messages from \"../../messages/index.js\";\n10\timport * as turns from \"../../turns/index.js\";\n11\timport type { ThreadRef } from \"../../threads/index.js\";\n12\t\n13\ttype Owner = \"messages\" | \"turns\";\n14\t\n15\tfunction emptyCounts(): HealthReport[\"owners\"][number][\"counts\"] {\n16\t  return { ready: 0, pending: 0, retrying: 0, failed: 0, blocked: 0 };\n17\t}\n18\t\n19\t// Failure detail (AC-4.2): attempts and last error read from wherever the\n20\t// mechanics durably put them — retry exhaustion copies them onto the form's\n21\t// metadata before the queue row is deleted; a still-live item carries them\n22\t// on the queue join. Never synthesized.\n23\tfunction failureOf(\n24\t  owner: Owner,\n25\t  entry: FormReportEntry,\n26\t): HealthReport[\"failures\"][number] {\n27\t  const failure: HealthReport[\"failures\"][number] = {\n28\t    owner,\n29\t    subjectKind: entry.subjectKind,\n30\t    subjectId: entry.subjectId,\n31\t    form: entry.form,\n32\t    reason: entry.reason ?? \"\",\n33\t    attempts: entry.metadata?.attempts ?? entry.queue?.attempts ?? 0,\n34\t  };\n35\t  const lastError = entry.metadata?.lastError ?? entry.queue?.lastError;\n36\t  if (lastError !== undefined) failure.lastError = lastError;\n37\t  return failure;\n38\t}\n39\t\n40\texport async function composeHealth(ref: ThreadRef): Promise<OpResult<HealthReport>> {\n41\t  const messageReport = await messages.report(ref);\n42\t  if (!messageReport.ok) return messageReport;\n43\t  const turnReport = await turns.report(ref);\n44\t  if (!turnReport.ok) return turnReport;\n45\t\n46\t  const sources: ReadonlyArray<readonly [Owner, readonly FormReportEntry[]]> = [\n47\t    [\"messages\", messageReport.value],\n48\t    [\"turns\", turnReport.value],\n49\t  ];\n50\t\n51\t  const countsByOwnerKind = new Map<string, HealthReport[\"owners\"][number]>();\n52\t  const failures: HealthReport[\"failures\"] = [];\n53\t  const repairPreview: HealthReport[\"repairPreview\"] = [];\n54\t  const queue = { queued: 0, claimed: 0 };\n55\t\n56\t  for (const [owner, entries] of sources) {\n57\t    for (const entry of entries) {\n58\t      const key = `${owner}:${entry.form}`;\n59\t      let row = countsByOwnerKind.get(key);\n60\t      if (row === undefined) {\n61\t        row = { owner, kind: entry.form, counts: emptyCounts() };\n62\t        countsByOwnerKind.set(key, row);\n63\t      }\n64\t      switch (entry.state) {\n65\t        case \"ready\":\n66\t          row.counts.ready += 1;\n67\t          break;\n68\t        case \"pending\":\n69\t          if ((entry.queue?.attempts ?? 0) > 0) row.counts.retrying += 1;\n70\t          else row.counts.pending += 1;\n71\t          break;\n72\t        case \"failed\":\n73\t          row.counts.failed += 1;\n74\t          failures.push(failureOf(owner, entry));\n75\t          // The preview is exactly the failed-and-not-blocked set: blocked is\n76\t          // a distinct state, so failed entries ARE the requeue targets.\n77\t          repairPreview.push({\n78\t            owner,\n79\t            subjectKind: entry.subjectKind,\n80\t            subjectId: entry.subjectId,\n81\t            form: entry.form,\n82\t          });\n83\t          break;\n84\t        case \"blocked\":\n85\t          row.counts.blocked += 1;\n86\t          failures.push(failureOf(owner, entry));\n87\t          break;\n88\t      }\n89\t      // Live queue visibility (AC-4.5), per report entry: every pending or\n90\t      // retrying entry rides a live item, so queued + claimed here equals\n91\t      // pending + retrying above by construction.\n92\t      if (entry.queue !== undefined) {\n93\t        if (entry.queue.status === \"queued\") queue.queued += 1;\n94\t        else queue.claimed += 1;\n95\t      }\n96\t    }\n97\t  }\n98\t\n99\t  // Deterministic order: messages before turns, kinds alphabetical within\n100\t  // an owner — repeated reads with no writes between are deep-equal.\n101\t  const owners = [...countsByOwnerKind.values()].sort((a, b) =>\n102\t    a.owner === b.owner ? a.kind.localeCompare(b.kind) : a.owner.localeCompare(b.owner),\n103\t  );\n104\t\n105\t  return { ok: true, value: { owners, failures, repairPreview, queue } };\n106\t}\n107\t"}]},"parent_tool_use_id":null,"session_id":"d8996253-06dd-4002-82f5-651d98fa293d","uuid":"f9ba86ee-f489-48ec-8f1b-ac5977238772","timestamp":"2026-06-12T15:50:29.506Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/inspect/internal/health.ts","content":"// Health composition (Flow 4): both owners' report surfaces joined into\n// state counts, actionable failure detail, a repair preview, and live queue\n// visibility. Assembled ENTIRELY from FormReportEntry rows — never a\n// derived_form or work_item read (the must-not-own rule is this domain's\n// whole contract) — and never executing what it previews (AC-4.3).\nimport type { FormReportEntry } from \"../../../shared/derivation.js\";\nimport type { OpResult } from \"../../../shared/errors.js\";\nimport type { HealthReport } from \"../../../shared/inspect.js\";\nimport * as messages from \"../../messages/index.js\";\nimport * as turns from \"../../turns/index.js\";\nimport type { ThreadRef } from \"../../threads/index.js\";\n\ntype Owner = \"messages\" | \"turns\";\n\nfunction emptyCounts(): HealthReport[\"owners\"][number][\"counts\"] {\n  return { ready: 0, pending: 0, retrying: 0, failed: 0, blocked: 0 };\n}\n\n// Failure detail (AC-4.2): attempts and last error read from wherever the\n// mechanics durably put them — retry exhaustion copies them onto the form's\n// metadata before the queue row is deleted; a still-live item carries them\n// on the queue join. Never synthesized.\nfunction failureOf(\n  owner: Owner,\n  entry: FormReportEntry,\n): HealthReport[\"failures\"][number] {\n  const failure: HealthReport[\"failures\"][number] = {\n    owner,\n    subjectKind: entry.subjectKind,\n    subjectId: entry.subjectId,\n    form: entry.form,\n    reason: entry.reason ?? \"\",\n    attempts: entry.metadata?.attempts ?? entry.queue?.attempts ?? 0,\n  };\n  const lastError = entry.metadata?.lastError ?? entry.queue?.lastError;\n  if (lastError !== undefined) failure.lastError = lastError;\n  return failure;\n}\n\nexport async function composeHealth(ref: ThreadRef): Promise<OpResult<HealthReport>> {\n  const messageReport = await messages.report(ref);\n  if (!messageReport.ok) return messageReport;\n  const turnReport = await turns.report(ref);\n  if (!turnReport.ok) return turnReport;\n\n  const sources: ReadonlyArray<readonly [Owner, readonly FormReportEntry[]]> = [\n    [\"messages\", messageReport.value],\n    [\"turns\", turnReport.value],\n  ];\n\n  const countsByOwnerKind = new Map<string, HealthReport[\"owners\"][number]>();\n  const failures: HealthReport[\"failures\"] = [];\n  const repairPreview: HealthReport[\"repairPreview\"] = [];\n  const queue = { queued: 0, claimed: 0 };\n\n  for (const [owner, entries] of sources) {\n    for (const entry of entries) {\n      const key = `${owner}:${entry.form}`;\n      let row = countsByOwnerKind.get(key);\n      if (row === undefined) {\n        row = { owner, kind: entry.form, counts: emptyCounts() };\n        countsByOwnerKind.set(key, row);\n      }\n      switch (entry.state) {\n        case \"ready\":\n          row.counts.ready += 1;\n          break;\n        case \"pending\":\n          if ((entry.queue?.attempts ?? 0) > 0) row.counts.retrying += 1;\n          else row.counts.pending += 1;\n          break;\n        case \"failed\":\n          row.counts.failed += 1;\n          failures.push(failureOf(owner, entry));\n          // The preview is exactly the failed-and-not-blocked set: blocked is\n          // a distinct state, so failed entries ARE the requeue targets.\n          repairPreview.push({\n            owner,\n            subjectKind: entry.subjectKind,\n            subjectId: entry.subjectId,\n            form: entry.form,\n          });\n          break;\n        case \"blocked\":\n          row.counts.blocked += 1;\n          failures.push(failureOf(owner, entry));\n          break;\n      }\n      // Live queue visibility (AC-4.5), per report entry: every pending or\n      // retrying entry rides a live item, so queued + claimed here equals\n      // pending + retrying above by construction.\n      if (entry.queue !== undefined) {\n        if (entry.queue.status === \"queued\") queue.queued += 1;\n        else queue.claimed += 1;\n      }\n    }\n  }\n\n  // Deterministic order: messages before turns, kinds alphabetical within\n  // an owner — repeated reads with no writes between are deep-equal.\n  const owners = [...countsByOwnerKind.values()].sort((a, b) =>\n    a.owner === b.owner ? a.kind.localeCompare(b.kind) : a.owner.localeCompare(b.owner),\n  );\n\n  return { ok: true, value: { owners, failures, repairPreview, queue } };\n}\n","numLines":107,"startLine":1,"totalLines":107}}}

sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1678,\"cache_read_input_tokens\":35251,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1678},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"ceae9c6b-d571-491c-ba4d-0d8e5cb3a7be\",\"uuid\":\"8fd8b500-c6c7-4d67-99f6-d74f896dfacf\",\"request_id\":\"req_011CbycPYmbdujvok3qV3ACk\"}\npackages/lhc/docs/02-specs/04-inspection/artifacts/quick-fix/streams/004-quick-fix.stdout.log:184:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_stop\",\"index\":2},\"session_id\":\"ceae9c6b-d571-491c-ba4d-0d8e5cb3a7be\",\"parent_tool_use_id\":null,\"uuid\":\"3efe6261-0931-4b35-8187-98533a23c67d\"}\npackages/lhc/docs/02-specs/04-inspection/artifacts/quick-fix/streams/004-quick-fix.stdout.log:185:{\"type\":\"stream_event\",\"event\":{\"type\":\"message_delta\",\"delta\":{\"stop_reason\":\"tool_use\",\"stop_sequence\":null,\"stop_details\":null},\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1678,\"cache_read_input_tokens\":35251,\"output_tokens\":4273,\"output_tokens_details\":{\"thinking_tokens\":4089},\"iterations\":[{\"input_tokens\":2,\"output_tokens\":4273,\"cache_read_input_tokens\":35251,\"cache_creation_input_tokens\":1678,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1678},\"type\":\"message\"}]},\"context_management\":{\"applied_edits\":[]}},\"session_id\":\"ceae9c6b-d571-491c-ba4d-0d8e5cb3a7be\",\"parent_tool_use_id\":null,\"uuid\":\"b90a3ede-471b-4694-b641-6e861a91ba89\"}\npackages/lhc/docs/02-specs/04-inspection/artifacts/quick-fix/streams/004-quick-fix.stdout.log:186:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01SNe7cqrxXufs2LUAq9taov\",\"type\":\"tool_result\",\"content\":\"1\\t// The Epic 04 lifecycle script (Story 4, Flow 5): every built v1 surface\\n2\\t// driven once, in PI-extension call order, against one real SDK\\n3\\t// configuration with the deterministic provider — zero network, zero real\\n4\\t// provider, no mocks anywhere. The script owns the sequence and the phase\\n5\\t// names (tech design Flow 5); assertions live in the driving tests, so the\\n6\\t// replay, teardown, and process legs all run THIS sequence rather than a\\n7\\t// re-described one (DD-8).\\n8\\t//\\n9\\t// Phases: create | intake | drain | status | compact1 | pull1 | inspect1 |\\n10\\t// mutate | rebuild | health2 | compact2 | pull2 | materialize.\\n11\\t//\\n12\\t// Mode is background — the production posture the PI extension will run —\\n13\\t// and the drain/rebuild phases settle through `drainSettled`, the real\\n14\\t// background awaitable. The post-mutation health snapshot (AC-5.2's\\n15\\t// \\\"cleared set pending\\\") is deterministic because every SDK operation here\\n16\\t// is synchronous SQLite chained through microtasks, while a background\\n17\\t// drain pass always starts on a macrotask (scheduler runLoop defers through\\n18\\t// setImmediate): the edit → delete → health reads inside the mutate phase\\n19\\t// run as one unbroken microtask cascade and complete before the poked drain\\n20\\t// can claim its first item. The rebuild phase then yields via drainSettled\\n21\\t// and the drain runs to empty.\\n22\\timport { join } from \\\"node:path\\\";\\n23\\timport {\\n24\\t  createSdk,\\n25\\t  resolveNamedProvider,\\n26\\t  type BatchResult,\\n27\\t  type CompactReceipt,\\n28\\t  type FormReportEntry,\\n29\\t  type HealthReport,\\n30\\t  type InspectOverview,\\n31\\t  type Lhc,\\n32\\t  type MessageEventInput,\\n33\\t  type MutationResult,\\n34\\t  type OpResult,\\n35\\t  type PullResult,\\n36\\t  type ViewContentsReport,\\n37\\t  type ViewStatus,\\n38\\t} from \\\"../../src/index.js\\\";\\n39\\timport { validEvent, type TempStore } from \\\"./index.js\\\";\\n40\\t\\n41\\t// ── the one SDK configuration (AC-5.1) ────────────────────────────\\n42\\t//\\n43\\t// Deterministic provider from the production registry (the same resolution\\n44\\t// seam the spawned CLI uses), background mode, zero-backoff retry so a\\n45\\t// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\\n46\\t// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\\n47\\t// a named \\\"lifecycle\\\" profile so compact runs profile-addressed (story\\n48\\t// scope: \\\"compact (profile)\\\") with all three lower bands non-empty on this\\n49\\t// thread (Epic 03 Story 2's reference gradient).\\n50\\texport const LIFECYCLE_PROFILE = {\\n51\\t  name: \\\"lifecycle\\\",\\n52\\t  lowerBound: 400,\\n53\\t  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\\n54\\t} as const;\\n55\\t\\n56\\texport function createLifecycleSdk(): Lhc {\\n57\\t  const provider = resolveNamedProvider(\\\"deterministic\\\");\\n58\\t  if (provider === undefined) throw new Error(\\\"deterministic provider not registered\\\");\\n59\\t  return createSdk({\\n60\\t    provider,\\n61\\t    mode: \\\"background\\\",\\n62\\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n63\\t    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\\n64\\t    view: {\\n65\\t      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\\n66\\t      // Low threshold so the status checkpoint genuinely recommends the\\n67\\t      // compact the sequence performs next.\\n68\\t      compactThreshold: 300,\\n69\\t    },\\n70\\t  });\\n71\\t}\\n72\\t\\n73\\t// ── the recorded conversation ─────────────────────────────────────\\n74\\t//\\n75\\t// Same shape and text profile as the Epic 03 derived-thread fixture (12\\n76\\t// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\\n77\\t// policy cuts the same 4-chunk shape — but with explicit per-run\\n78\\t// idempotency keys so a replay on a fresh thread records byte-identical\\n79\\t// event payloads regardless of any process-global fixture counters.\\n80\\tconst TURN_COUNT = 12;\\n81\\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\n82\\tconst TURNS_PER_BATCH = 3; // multi-turn batches (story scope)\\n83\\t\\n84\\t// Mutation targets: both in the post-compact tail (compact point at t9's\\n85\\t// start under the lifecycle profile), so the second compact's pull shows the\\n86\\t// edit verbatim and the deletion's absence — the tail is full fidelity.\\n87\\texport const EDIT_TARGET = { turnId: \\\"t12\\\", kind: \\\"user_prompt\\\" } as const;\\n88\\texport const EDITED_MESSAGE_TEXT =\\n89\\t  \\\"turn 12 revised: drop area 12 and re-check area 5 instead\\\";\\n90\\texport const DELETE_TARGET = { turnId: \\\"t10\\\", kind: \\\"assistant_text\\\" } as const;\\n91\\texport const DELETED_MESSAGE_TEXT = \\\"findings for area 10\\\";\\n92\\t\\n93\\tfunction turnEvents(turn: number): MessageEventInput[] {\\n94\\t  let seq = 0;\\n95\\t  const key = (): string => {\\n96\\t    seq += 1;\\n97\\t    return `lc-t${turn}-e${seq}`;\\n98\\t  };\\n99\\t  const events: MessageEventInput[] = [\\n100\\t    validEvent(\\\"user_prompt\\\", {\\n101\\t      idempotencyKey: key(),\\n102\\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\n103\\t    }),\\n104\\t    validEvent(\\\"assistant_thinking\\\", {\\n105\\t      idempotencyKey: key(),\\n106\\t      payload: { text: `considering what area ${turn} contains` },\\n107\\t    }),\\n108\\t  ];\\n109\\t  if (TOOL_HEAVY_TURNS.has(turn)) {\\n110\\t    for (const run of [1, 2]) {\\n111\\t      const toolCallId = `call-lc-${turn}-${run}`;\\n112\\t      events.push(\\n113\\t        validEvent(\\\"tool_call\\\", {\\n114\\t          idempotencyKey: key(),\\n115\\t          payload: {\\n116\\t            toolCallId,\\n117\\t            toolName: \\\"read_file\\\",\\n118\\t            arguments: { path: `area-${turn}/file-${run}.txt` },\\n119\\t          },\\n120\\t        }),\\n121\\t        validEvent(\\\"tool_result\\\", {\\n122\\t          idempotencyKey: key(),\\n123\\t          payload: {\\n124\\t            toolCallId,\\n125\\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n126\\t            isError: false,\\n127\\t          },\\n128\\t        }),\\n129\\t      );\\n130\\t    }\\n131\\t  }\\n132\\t  events.push(\\n133\\t    validEvent(\\\"assistant_text\\\", {\\n134\\t      idempotencyKey: key(),\\n135\\t      payload: { text: `findings for area ${turn}` },\\n136\\t    }),\\n137\\t    validEvent(\\\"turn_end\\\", { idempotencyKey: key() }),\\n138\\t  );\\n139\\t  return events;\\n140\\t}\\n141\\t\\n142\\tfunction intakeBatches(): MessageEventInput[][] {\\n143\\t  const batches: MessageEventInput[][] = [];\\n144\\t  for (let first = 1; first <= TURN_COUNT; first += TURNS_PER_BATCH) {\\n145\\t    const batch: MessageEventInput[] = [];\\n146\\t    for (let turn = first; turn < first + TURNS_PER_BATCH && turn <= TURN_COUNT; turn += 1) {\\n147\\t      batch.push(...turnEvents(turn));\\n148\\t    }\\n149\\t    batches.push(batch);\\n150\\t  }\\n151\\t  return batches;\\n152\\t}\\n153\\t\\n154\\t// ── run shape ─────────────────────────────────────────────────────\\n155\\t\\n156\\texport interface LifecyclePhases {\\n157\\t  create: OpResult<{ threadId: string; filePath: string }>;\\n158\\t  intake: Array<OpResult<BatchResult>>;\\n159\\t  drain: { settled: true };\\n160\\t  status: OpResult<ViewStatus>;\\n161\\t  compact1: OpResult<CompactReceipt>;\\n162\\t  pull1: OpResult<PullResult>;\\n163\\t  inspect1: {\\n164\\t    overview: OpResult<InspectOverview>;\\n165\\t    view: OpResult<ViewContentsReport>;\\n166\\t    health: OpResult<HealthReport>;\\n167\\t  };\\n168\\t  mutate: {\\n169\\t    editedMessageId: string;\\n170\\t    deletedMessageId: string;\\n171\\t    edit: OpResult<MutationResult>;\\n172\\t    delete: OpResult<MutationResult>;\\n173\\t    // Captured inside the mutate phase, before the background drain's first\\n174\\t    // macrotask: the cleared-set-pending evidence (AC-5.2).\\n175\\t    healthAfterMutate: OpResult<HealthReport>;\\n176\\t    messagesNotReady: OpResult<FormReportEntry[]>;\\n177\\t    turnsNotReady: OpResult<FormReportEntry[]>;\\n178\\t  };\\n179\\t  rebuild: { settled: true };\\n180\\t  health2: OpResult<HealthReport>;\\n181\\t  compact2: OpResult<CompactReceipt>;\\n182\\t  pull2: OpResult<PullResult>;\\n183\\t  materialize: OpResult<{ writtenPath: string }>;\\n184\\t}\\n185\\t\\n186\\texport type LifecycleCheckpoint = \\\"inspect1\\\" | \\\"health2\\\" | \\\"materialize\\\";\\n187\\t\\n188\\texport interface LifecycleOptions {\\n189\\t  // Distinguishes the thread file and materialize target so replay and\\n190\\t  // teardown legs run side by side in one store (same dir ⇒ same header cwd).\\n191\\t  name?: string;\\n192\\t  // TC-5.3: a fresh createSdk between the intake / compact / mutation /\\n193\\t  // render phase groups — every group boundary is a quiescent point (no\\n194\\t  // queued work, no running drain), so the abandoned instance can never act\\n195\\t  // after its group ends.\\n196\\t  freshSdkBetweenGroups?: boolean;\\n197\\t  // TC-5.4: spawned-CLI parity probes at the three read checkpoints.\\n198\\t  onCheckpoint?: (\\n199\\t    checkpoint: LifecycleCheckpoint,\\n200\\t    ctx: { sdk: Lhc; filePath: string },\\n201\\t  ) => Promise<void>;\\n202\\t}\\n203\\t\\n204\\texport interface LifecycleRun {\\n205\\t  filePath: string;\\n206\\t  outPath: string;\\n207\\t  threadId: string;\\n208\\t  phases: LifecyclePhases;\\n209\\t}\\n210\\t\\n211\\tfunction expectOk<T>(result: OpResult<T>, phase: string): T {\\n212\\t  if (!result.ok) {\\n213\\t    throw new Error(`lifecycle ${phase} failed: ${result.error.code} — ${result.error.reason}`);\\n214\\t  }\\n215\\t  return result.value;\\n216\\t}\\n217\\t\\n218\\t// ── the sequence ──────────────────────────────────────────────────\\n219\\t\\n220\\texport async function runLifecycle(\\n221\\t  store: TempStore,\\n222\\t  opts: LifecycleOptions = {},\\n223\\t): Promise<LifecycleRun> {\\n224\\t  const name = opts.name ?? \\\"lifecycle\\\";\\n225\\t  const filePath = store.threadPath(name);\\n226\\t  const outPath = join(store.dir, `${name}-session.jsonl`);\\n227\\t  const ref = { filePath };\\n228\\t\\n229\\t  let sdk = createLifecycleSdk();\\n230\\t  const nextGroup = (): void => {\\n231\\t    // The fresh instance is the same configuration assembled again — the\\n232\\t    // continuity proof is that no phase depends on the prior instance's\\n233\\t    // memory, only on the thread file.\\n234\\t    if (opts.freshSdkBetweenGroups) sdk = createLifecycleSdk();\\n235\\t  };\\n236\\t  const checkpoint = async (cp: LifecycleCheckpoint): Promise<void> => {\\n237\\t    if (opts.onCheckpoint !== undefined) await opts.onCheckpoint(cp, { sdk, filePath });\\n238\\t  };\\n239\\t\\n240\\t  // ── group 1: create → intake → drain → status ──\\n241\\t  const create = await sdk.threads.newThread({\\n242\\t    filePath,\\n243\\t    registryPath: store.registryPath,\\n244\\t  });\\n245\\t  const threadId = expectOk(create, \\\"create\\\").threadId;\\n246\\t\\n247\\t  const intake: Array<OpResult<BatchResult>> = [];\\n248\\t  for (const batch of intakeBatches()) {\\n249\\t    const sent = await sdk.intakeStream.messageEvents(ref, batch);\\n250\\t    intake.push(sent);\\n251\\t    expectOk(sent, \\\"intake\\\");\\n252\\t  }\\n253\\t\\n254\\t  // Background drain settles (story scope): the intake pokes scheduled the\\n255\\t  // work; this is the await that lets the scheduler run it to empty.\\n256\\t  await sdk.drainSettled(ref);\\n257\\t  const drain = { settled: true } as const;\\n258\\t\\n259\\t  const status = await sdk.threadView.status(ref);\\n260\\t  expectOk(status, \\\"status\\\");\\n261\\t\\n262\\t  // ── group 2: compact1 → pull1 → inspect1 ──\\n263\\t  nextGroup();\\n264\\t  const compact1 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\n265\\t  expectOk(compact1, \\\"compact1\\\");\\n266\\t  const pull1 = await sdk.threadView.pull(ref);\\n267\\t  expectOk(pull1, \\\"pull1\\\");\\n268\\t  const inspect1 = {\\n269\\t    overview: await sdk.inspect.overview(ref),\\n270\\t    view: await sdk.inspect.view(ref),\\n271\\t    health: await sdk.inspect.health(ref),\\n272\\t  };\\n273\\t  expectOk(inspect1.overview, \\\"inspect1.overview\\\");\\n274\\t  expectOk(inspect1.view, \\\"inspect1.view\\\");\\n275\\t  expectOk(inspect1.health, \\\"inspect1.health\\\");\\n276\\t  await checkpoint(\\\"inspect1\\\");\\n277\\t\\n278\\t  // ── group 3: mutate → rebuild → health2 ──\\n279\\t  nextGroup();\\n280\\t  const listed = expectOk(await sdk.messages.listMessages(ref), \\\"mutate.list\\\");\\n281\\t  const editTarget = listed.find(\\n282\\t    (record) => record.kind === EDIT_TARGET.kind && record.turnId === EDIT_TARGET.turnId,\\n283\\t  );\\n284\\t  const deleteTarget = listed.find(\\n285\\t    (record) => record.kind === DELETE_TARGET.kind && record.turnId === DELETE_TARGET.turnId,\\n286\\t  );\\n287\\t  if (editTarget === undefined || deleteTarget === undefined) {\\n288\\t    throw new Error(\\\"lifecycle invariant: edit/delete targets not found in the record\\\");\\n289\\t  }\\n290\\t  // Edit, delete, and the pending-state reads run in one microtask cascade\\n291\\t  // (see module header): the snapshot is taken before the poked background\\n292\\t  // drain starts its first pass.\\n293\\t  const edit = await sdk.messages.edit(ref, {\\n294\\t    messageId: editTarget.messageId,\\n295\\t    content: EDITED_MESSAGE_TEXT,\\n296\\t  });\\n297\\t  expectOk(edit, \\\"mutate.edit\\\");\\n298\\t  const deleted = await sdk.messages.deleteMessage(ref, { messageId: deleteTarget.messageId });\\n299\\t  expectOk(deleted, \\\"mutate.delete\\\");\\n300\\t  const mutate: LifecyclePhases[\\\"mutate\\\"] = {\\n301\\t    editedMessageId: editTarget.messageId,\\n302\\t    deletedMessageId: deleteTarget.messageId,\\n303\\t    edit,\\n304\\t    delete: deleted,\\n305\\t    healthAfterMutate: await sdk.inspect.health(ref),\\n306\\t    messagesNotReady: await sdk.messages.report(ref, { notReady: true }),\\n307\\t    turnsNotReady: await sdk.turns.report(ref, { notReady: true }),\\n308\\t  };\\n309\\t  expectOk(mutate.healthAfterMutate, \\\"mutate.health\\\");\\n310\\t  expectOk(mutate.messagesNotReady, \\\"mutate.messagesNotReady\\\");\\n311\\t  expectOk(mutate.turnsNotReady, \\\"mutate.turnsNotReady\\\");\\n312\\t\\n313\\t  // Rebuild drains: the mutations' pokes already scheduled the cascade\\n314\\t  // rebuilds on THIS instance's scheduler; settle is the production await.\\n315\\t  await sdk.drainSettled(ref);\\n316\\t  const rebuild = { settled: true } as const;\\n317\\t\\n318\\t  const health2 = await sdk.inspect.health(ref);\\n319\\t  expectOk(health2, \\\"health2\\\");\\n320\\t  await checkpoint(\\\"health2\\\");\\n321\\t\\n322\\t  // ── group 4: compact2 → pull2 → materialize ──\\n323\\t  nextGroup();\\n324\\t  const compact2 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\n325\\t  expectOk(compact2, \\\"compact2\\\");\\n326\\t  const pull2 = await sdk.threadView.pull(ref);\\n327\\t  expectOk(pull2, \\\"pull2\\\");\\n328\\t  const materialize = await sdk.threadView.materialize(ref, { path: outPath });\\n329\\t  expectOk(materialize, \\\"materialize\\\");\\n330\\t  await checkpoint(\\\"materialize\\\");\\n331\\t\\n332\\t  return {\\n333\\t    filePath,\\n334\\t    outPath,\\n335\\t    threadId,\\n336\\t    phases: {\\n337\\t      create,\\n338\\t      intake,\\n339\\t      drain,\\n340\\t      status,\\n341\\t      compact1,\\n342\\t      pull1,\\n343\\t      inspect1,\\n344\\t      mutate,\\n345\\t      rebuild,\\n346\\t      health2,\\n347\\t      compact2,\\n348\\t      pull2,\\n349\\t      materialize,\\n350\\t    },\\n351\\t  };\\n352\\t}\\n353\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"ceae9c6b-d571-491c-ba4d-0d8e5cb3a7be\",\"uuid\":\"740bbd7d-6779-45ab-8034-fc42764fda20\",\"timestamp\":\"2026-06-12T15:35:43.651Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/fixtures/lifecycle.ts\",\"content\":\"// The Epic 04 lifecycle script (Story 4, Flow 5): every built v1 surface\\n// driven once, in PI-extension call order, against one real SDK\\n// configuration with the deterministic provider — zero network, zero real\\n// provider, no mocks anywhere. The script owns the sequence and the phase\\n// names (tech design Flow 5); assertions live in the driving tests, so the\\n// replay, teardown, and process legs all run THIS sequence rather than a\\n// re-described one (DD-8).\\n//\\n// Phases: create | intake | drain | status | compact1 | pull1 | inspect1 |\\n// mutate | rebuild | health2 | compact2 | pull2 | materialize.\\n//\\n// Mode is background — the production posture the PI extension will run —\\n// and the drain/rebuild phases settle through `drainSettled`, the real\\n// background awaitable. The post-mutation health snapshot (AC-5.2's\\n// \\\"cleared set pending\\\") is deterministic because every SDK operation here\\n// is synchronous SQLite chained through microtasks, while a background\\n// drain pass always starts on a macrotask (scheduler runLoop defers through\\n// setImmediate): the edit → delete → health reads inside the mutate phase\\n// run as one unbroken microtask cascade and complete before the poked drain\\n// can claim its first item. The rebuild phase then yields via drainSettled\\n// and the drain runs to empty.\\nimport { join } from \\\"node:path\\\";\\nimport {\\n  createSdk,\\n  resolveNamedProvider,\\n  type BatchResult,\\n  type CompactReceipt,\\n  type FormReportEntry,\\n  type HealthReport,\\n  type InspectOverview,\\n  type Lhc,\\n  type MessageEventInput,\\n  type MutationResult,\\n  type OpResult,\\n  type PullResult,\\n  type ViewContentsReport,\\n  type ViewStatus,\\n} from \\\"../../src/index.js\\\";\\nimport { validEvent, type TempStore } from \\\"./index.js\\\";\\n\\n// ── the one SDK configuration (AC-5.1) ────────────────────────────\\n//\\n// Deterministic provider from the production registry (the same resolution\\n// seam the spawned CLI uses), background mode, zero-backoff retry so a\\n// deterministic run never arms a wake timer, the Epic 03 fixture's pinned\\n// chunk policy (12 fixed-shape turns cut into 4 chunks, c1–c3 closed), and\\n// a named \\\"lifecycle\\\" profile so compact runs profile-addressed (story\\n// scope: \\\"compact (profile)\\\") with all three lower bands non-empty on this\\n// thread (Epic 03 Story 2's reference gradient).\\nexport const LIFECYCLE_PROFILE = {\\n  name: \\\"lifecycle\\\",\\n  lowerBound: 400,\\n  percentages: { full: 25, smooth: 16, detailed: 10, brief: 49 },\\n} as const;\\n\\nexport function createLifecycleSdk(): Lhc {\\n  const provider = resolveNamedProvider(\\\"deterministic\\\");\\n  if (provider === undefined) throw new Error(\\\"deterministic provider not registered\\\");\\n  return createSdk({\\n    provider,\\n    mode: \\\"background\\\",\\n    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\\n    chunkPolicy: { targetProjectedTokens: 90, maxProjectedTokens: 4400 },\\n    view: {\\n      profiles: [{ ...LIFECYCLE_PROFILE, percentages: { ...LIFECYCLE_PROFILE.percentages } }],\\n      // Low threshold so the status checkpoint genuinely recommends the\\n      // compact the sequence performs next.\\n      compactThreshold: 300,\\n    },\\n  });\\n}\\n\\n// ── the recorded conversation ─────────────────────────────────────\\n//\\n// Same shape and text profile as the Epic 03 derived-thread fixture (12\\n// turns, tool-heavy middle 5–8, two tool runs each) so the pinned chunk\\n// policy cuts the same 4-chunk shape — but with explicit per-run\\n// idempotency keys so a replay on a fresh thread records byte-identical\\n// event payloads regardless of any process-global fixture counters.\\nconst TURN_COUNT = 12;\\nconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\\nconst TURNS_PER_BATCH = 3; // multi-turn batches (story scope)\\n\\n// Mutation targets: both in the post-compact tail (compact point at t9's\\n// start under the lifecycle profile), so the second compact's pull shows the\\n// edit verbatim and the deletion's absence — the tail is full fidelity.\\nexport const EDIT_TARGET = { turnId: \\\"t12\\\", kind: \\\"user_prompt\\\" } as const;\\nexport const EDITED_MESSAGE_TEXT =\\n  \\\"turn 12 revised: drop area 12 and re-check area 5 instead\\\";\\nexport const DELETE_TARGET = { turnId: \\\"t10\\\", kind: \\\"assistant_text\\\" } as const;\\nexport const DELETED_MESSAGE_TEXT = \\\"findings for area 10\\\";\\n\\nfunction turnEvents(turn: number): MessageEventInput[] {\\n  let seq = 0;\\n  const key = (): string => {\\n    seq += 1;\\n    return `lc-t${turn}-e${seq}`;\\n  };\\n  const events: MessageEventInput[] = [\\n    validEvent(\\\"user_prompt\\\", {\\n      idempotencyKey: key(),\\n      payload: { text: `turn ${turn}: please investigate area ${turn}` },\\n    }),\\n    validEvent(\\\"assistant_thinking\\\", {\\n      idempotencyKey: key(),\\n      payload: { text: `considering what area ${turn} contains` },\\n    }),\\n  ];\\n  if (TOOL_HEAVY_TURNS.has(turn)) {\\n    for (const run of [1, 2]) {\\n      const toolCallId = `call-lc-${turn}-${run}`;\\n      events.push(\\n        validEvent(\\\"tool_call\\\", {\\n          idempotencyKey: key(),\\n          payload: {\\n            toolCallId,\\n            toolName: \\\"read_file\\\",\\n            arguments: { path: `area-${turn}/file-${run}.txt` },\\n          },\\n        }),\\n        validEvent(\\\"tool_result\\\", {\\n          idempotencyKey: key(),\\n          payload: {\\n            toolCallId,\\n            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\\n            isError: false,\\n          },\\n        }),\\n      );\\n    }\\n  }\\n  events.push(\\n    validEvent(\\\"assistant_text\\\", {\\n      idempotencyKey: key(),\\n      payload: { text: `findings for area ${turn}` },\\n    }),\\n    validEvent(\\\"turn_end\\\", { idempotencyKey: key() }),\\n  );\\n  return events;\\n}\\n\\nfunction intakeBatches(): MessageEventInput[][] {\\n  const batches: MessageEventInput[][] = [];\\n  for (let first = 1; first <= TURN_COUNT; first += TURNS_PER_BATCH) {\\n    const batch: MessageEventInput[] = [];\\n    for (let turn = first; turn < first + TURNS_PER_BATCH && turn <= TURN_COUNT; turn += 1) {\\n      batch.push(...turnEvents(turn));\\n    }\\n    batches.push(batch);\\n  }\\n  return batches;\\n}\\n\\n// ── run shape ─────────────────────────────────────────────────────\\n\\nexport interface LifecyclePhases {\\n  create: OpResult<{ threadId: string; filePath: string }>;\\n  intake: Array<OpResult<BatchResult>>;\\n  drain: { settled: true };\\n  status: OpResult<ViewStatus>;\\n  compact1: OpResult<CompactReceipt>;\\n  pull1: OpResult<PullResult>;\\n  inspect1: {\\n    overview: OpResult<InspectOverview>;\\n    view: OpResult<ViewContentsReport>;\\n    health: OpResult<HealthReport>;\\n  };\\n  mutate: {\\n    editedMessageId: string;\\n    deletedMessageId: string;\\n    edit: OpResult<MutationResult>;\\n    delete: OpResult<MutationResult>;\\n    // Captured inside the mutate phase, before the background drain's first\\n    // macrotask: the cleared-set-pending evidence (AC-5.2).\\n    healthAfterMutate: OpResult<HealthReport>;\\n    messagesNotReady: OpResult<FormReportEntry[]>;\\n    turnsNotReady: OpResult<FormReportEntry[]>;\\n  };\\n  rebuild: { settled: true };\\n  health2: OpResult<HealthReport>;\\n  compact2: OpResult<CompactReceipt>;\\n  pull2: OpResult<PullResult>;\\n  materialize: OpResult<{ writtenPath: string }>;\\n}\\n\\nexport type LifecycleCheckpoint = \\\"inspect1\\\" | \\\"health2\\\" | \\\"materialize\\\";\\n\\nexport interface LifecycleOptions {\\n  // Distinguishes the thread file and materialize target so replay and\\n  // teardown legs run side by side in one store (same dir ⇒ same header cwd).\\n  name?: string;\\n  // TC-5.3: a fresh createSdk between the intake / compact / mutation /\\n  // render phase groups — every group boundary is a quiescent point (no\\n  // queued work, no running drain), so the abandoned instance can never act\\n  // after its group ends.\\n  freshSdkBetweenGroups?: boolean;\\n  // TC-5.4: spawned-CLI parity probes at the three read checkpoints.\\n  onCheckpoint?: (\\n    checkpoint: LifecycleCheckpoint,\\n    ctx: { sdk: Lhc; filePath: string },\\n  ) => Promise<void>;\\n}\\n\\nexport interface LifecycleRun {\\n  filePath: string;\\n  outPath: string;\\n  threadId: string;\\n  phases: LifecyclePhases;\\n}\\n\\nfunction expectOk<T>(result: OpResult<T>, phase: string): T {\\n  if (!result.ok) {\\n    throw new Error(`lifecycle ${phase} failed: ${result.error.code} — ${result.error.reason}`);\\n  }\\n  return result.value;\\n}\\n\\n// ── the sequence ──────────────────────────────────────────────────\\n\\nexport async function runLifecycle(\\n  store: TempStore,\\n  opts: LifecycleOptions = {},\\n): Promise<LifecycleRun> {\\n  const name = opts.name ?? \\\"lifecycle\\\";\\n  const filePath = store.threadPath(name);\\n  const outPath = join(store.dir, `${name}-session.jsonl`);\\n  const ref = { filePath };\\n\\n  let sdk = createLifecycleSdk();\\n  const nextGroup = (): void => {\\n    // The fresh instance is the same configuration assembled again — the\\n    // continuity proof is that no phase depends on the prior instance's\\n    // memory, only on the thread file.\\n    if (opts.freshSdkBetweenGroups) sdk = createLifecycleSdk();\\n  };\\n  const checkpoint = async (cp: LifecycleCheckpoint): Promise<void> => {\\n    if (opts.onCheckpoint !== undefined) await opts.onCheckpoint(cp, { sdk, filePath });\\n  };\\n\\n  // ── group 1: create → intake → drain → status ──\\n  const create = await sdk.threads.newThread({\\n    filePath,\\n    registryPath: store.registryPath,\\n  });\\n  const threadId = expectOk(create, \\\"create\\\").threadId;\\n\\n  const intake: Array<OpResult<BatchResult>> = [];\\n  for (const batch of intakeBatches()) {\\n    const sent = await sdk.intakeStream.messageEvents(ref, batch);\\n    intake.push(sent);\\n    expectOk(sent, \\\"intake\\\");\\n  }\\n\\n  // Background drain settles (story scope): the intake pokes scheduled the\\n  // work; this is the await that lets the scheduler run it to empty.\\n  await sdk.drainSettled(ref);\\n  const drain = { settled: true } as const;\\n\\n  const status = await sdk.threadView.status(ref);\\n  expectOk(status, \\\"status\\\");\\n\\n  // ── group 2: compact1 → pull1 → inspect1 ──\\n  nextGroup();\\n  const compact1 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\n  expectOk(compact1, \\\"compact1\\\");\\n  const pull1 = await sdk.threadView.pull(ref);\\n  expectOk(pull1, \\\"pull1\\\");\\n  const inspect1 = {\\n    overview: await sdk.inspect.overview(ref),\\n    view: await sdk.inspect.view(ref),\\n    health: await sdk.inspect.health(ref),\\n  };\\n  expectOk(inspect1.overview, \\\"inspect1.overview\\\");\\n  expectOk(inspect1.view, \\\"inspect1.view\\\");\\n  expectOk(inspect1.health, \\\"inspect1.health\\\");\\n  await checkpoint(\\\"inspect1\\\");\\n\\n  // ── group 3: mutate → rebuild → health2 ──\\n  nextGroup();\\n  const listed = expectOk(await sdk.messages.listMessages(ref), \\\"mutate.list\\\");\\n  const editTarget = listed.find(\\n    (record) => record.kind === EDIT_TARGET.kind && record.turnId === EDIT_TARGET.turnId,\\n  );\\n  const deleteTarget = listed.find(\\n    (record) => record.kind === DELETE_TARGET.kind && record.turnId === DELETE_TARGET.turnId,\\n  );\\n  if (editTarget === undefined || deleteTarget === undefined) {\\n    throw new Error(\\\"lifecycle invariant: edit/delete targets not found in the record\\\");\\n  }\\n  // Edit, delete, and the pending-state reads run in one microtask cascade\\n  // (see module header): the snapshot is taken before the poked background\\n  // drain starts its first pass.\\n  const edit = await sdk.messages.edit(ref, {\\n    messageId: editTarget.messageId,\\n    content: EDITED_MESSAGE_TEXT,\\n  });\\n  expectOk(edit, \\\"mutate.edit\\\");\\n  const deleted = await sdk.messages.deleteMessage(ref, { messageId: deleteTarget.messageId });\\n  expectOk(deleted, \\\"mutate.delete\\\");\\n  const mutate: LifecyclePhases[\\\"mutate\\\"] = {\\n    editedMessageId: editTarget.messageId,\\n    deletedMessageId: deleteTarget.messageId,\\n    edit,\\n    delete: deleted,\\n    healthAfterMutate: await sdk.inspect.health(ref),\\n    messagesNotReady: await sdk.messages.report(ref, { notReady: true }),\\n    turnsNotReady: await sdk.turns.report(ref, { notReady: true }),\\n  };\\n  expectOk(mutate.healthAfterMutate, \\\"mutate.health\\\");\\n  expectOk(mutate.messagesNotReady, \\\"mutate.messagesNotReady\\\");\\n  expectOk(mutate.turnsNotReady, \\\"mutate.turnsNotReady\\\");\\n\\n  // Rebuild drains: the mutations' pokes already scheduled the cascade\\n  // rebuilds on THIS instance's scheduler; settle is the production await.\\n  await sdk.drainSettled(ref);\\n  const rebuild = { settled: true } as const;\\n\\n  const health2 = await sdk.inspect.health(ref);\\n  expectOk(health2, \\\"health2\\\");\\n  await checkpoint(\\\"health2\\\");\\n\\n  // ── group 4: compact2 → pull2 → materialize ──\\n  nextGroup();\\n  const compact2 = await sdk.threadView.compact(ref, { profile: LIFECYCLE_PROFILE.name });\\n  expectOk(compact2, \\\"compact2\\\");\\n  const pull2 = await sdk.threadView.pull(ref);\\n  expectOk(pull2, \\\"pull2\\\");\\n  const materialize = await sdk.threadView.materialize(ref, { path: outPath });\\n  expectOk(materialize, \\\"materialize\\\");\\n  await checkpoint(\\\"materialize\\\");\\n\\n  return {\\n    filePath,\\n    outPath,\\n    threadId,\\n    phases: {\\n      create,\\n      intake,\\n      drain,\\n      status,\\n      compact1,\\n      pull1,\\n      inspect1,\\n      mutate,\\n      rebuild,\\n      health2,\\n      compact2,\\n      pull2,\\n      materialize,\\n    },\\n  };\\n}\\n\",\"numLines\":353,\"startLine\":1,\"totalLines\":353}}}\npackages/lhc/docs/02-specs/04-inspection/artifacts/quick-fix/streams/004-quick-fix.stdout.log:187:{\"type\":\"stream_event\",\"event\":{\"type\":\"message_stop\"},\"session_id\":\"ceae9c6b-d571-491c-ba4d-0d8e5cb3a7be\",\"parent_tool_use_id\":null,\"uuid\":\"a73dd2fa-362a-4db2-8fed-ceeef1da4153\"}\npackages/lhc/docs/02-specs/04-inspection/artifacts/quick-fix/streams/004-quick-fix.stdout.log:188:{\"type\":\"system\",\"subtype\":\"status\",\"status\":\"requesting\",\"uuid\":\"a42670f0-c31f-430e-bd1d-100254075bf3\",\"session_id\":\"ceae9c6b-d571-491c-ba4d-0d8e5cb3a7be\"}\npackages/lhc/docs/02-specs/04-inspection/artifacts/quick-fix/streams/004-quick-fix.stdout.log:189:{\"type\":\"stream_event\",\"event\":{\"type\":\"message_start\",\"message\":{\"model\":\"claude-opus-4-8\",\"id\":\"msg_01LmQs3qhuiNqS7KazajrEZZ\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[],\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":131,\"cache_creation_input_tokens\":10445,\"cache_read_input_tokens\":36929,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":10445},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null}},\"session_id\":\"ceae9c6b-d571-491c-ba4d-0d8e5cb3a7be\",\"parent_tool_use_id\":null,\"uuid\":\"bf043002-ac54-46c3-b7fd-8a3588b65e1a\",\"ttft_ms\":2578}\npackages/lhc/docs/02-specs/04-inspection/artifacts/quick-fix/streams/004-quick-fix.stdout.log:190:{\"type\":\"stream_event\",\"event\":{\"type\":\"content_block_start\",\"index\":0,\"content_block\":{\"type\":\"thinking\",\"thinking\":\"\"
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012gqqxe2cwHs9bFb4atbBMW","type":"tool_result","content":"267\tdescribe(\"architecture risk: reads are read-only and provider-free (DD-6)\", () => {\n268\t  it(\"list and show in every mode leave observable state unchanged and call no provider\", async () => {\n269\t    const { filePath, double } = await readFixture(store);\n270\t    const captured = double.captureInputs();\n271\t    const before = await observableState(filePath);\n272\t\n273\t    await messages.listMessages({ filePath });\n274\t    await messages.listMessages({ filePath }, { from: 2, to: 4, limit: 2 });\n275\t    await messages.listMessages({ filePath }, { includeDeleted: true });\n276\t    await messages.listMessages({ filePath }, { from: 9, to: 1 }); // refused, must not write either\n277\t    await messages.show({ filePath }, \"m4\");\n278\t    await messages.show({ filePath }, \"m99\"); // not-found, must not write either\n279\t\n280\t    const after = await observableState(filePath);\n281\t    expect(after).toEqual(before);\n282\t    expect(captured).toHaveLength(0);\n283\t  });\n284\t});\n285\t\n286\t// A thread with live, undrained work: one tool turn through a manual SDK\n287\t// (its no-op seam never drains), leaving three pending forms and their queue\n288\t// rows. The background read-only proof needs the pending state the manual\n289\t// read-only proof above cannot manufacture.\n290\tasync function pendingWorkThread(): Promise<string> {\n291\t  const seeder = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n292\t  const filePath = store.threadPath();\n293\t  const created = await seeder.threads.newThread({\n294\t    filePath,\n295\t    registryPath: store.registryPath,\n296\t  });\n297\t  if (!created.ok) throw new Error(`pending fixture thread creation failed: ${created.error.reason}`);\n298\t  const sent = await seeder.intakeStream.messageEvents({ filePath }, [\n299\t    validEvent(\"user_prompt\", { payload: { text: \"background prompt\" } }),\n300\t    validEvent(\"tool_call\", {\n301\t      payload: { toolCallId: \"call-bg-1\", toolName: \"read_file\", arguments: { path: \"bg.txt\" } },\n302\t    }),\n303\t    validEvent(\"tool_result\", {\n304\t      payload: { toolCallId: \"call-bg-1\", content: \"background output\", isError: false },\n305\t    }),\n306\t    validEvent(\"assistant_text\", { payload: { text: \"background answer\" } }),\n307\t    validEvent(\"turn_end\"),\n308\t  ]);\n309\t  if (!sent.ok) throw new Error(`pending fixture intake failed: ${sent.error.reason}`);\n310\t  return filePath;\n311\t}\n312\t\n313\t// Below-SDK raw snapshot of everything a wrongly-scheduled catch-up drain\n314\t// would move: work-item rows and derived-form states. Read through a raw\n315\t// handle (openRaw), never the SDK ops — those would fire their own touch and\n316\t// pollute the very state under test.\n317\tfunction rawWorkAndForms(filePath: string): Record<string, unknown> {\n318\t  const db = openRaw(filePath);\n319\t  try {\n320\t    return {\n321\t      workItems: db\n322\t        .prepare(`SELECT work_item_id, status, attempts FROM work_item ORDER BY work_item_id`)\n323\t        .all(),\n324\t      forms: db\n325\t        .prepare(\n326\t          `SELECT subject_id, form, state, source_version FROM derived_form\n327\t           ORDER BY subject_id, form`,\n328\t        )\n329\t        .all(),\n330\t    };\n331\t  } finally {\n332\t    db.close();\n333\t  }\n334\t}\n335\t\n336\tdescribe(\"architecture risk: background reads schedule no catch-up drain (DD-6, SV-01-001)\", () => {"}]},"parent_tool_use_id":null,"session_id":"43cf21d7-2126-46d9-a042-c8289cb3cd73","uuid":"47f72ebb-3eba-4735-8091-102bf93b9dc9","timestamp":"2026-06-12T15:47:05.908Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/test/messages-read.test.ts","content":"describe(\"architecture risk: reads are read-only and provider-free (DD-6)\", () => {\n  it(\"list and show in every mode leave observable state unchanged and call no provider\", async () => {\n    const { filePath, double } = await readFixture(store);\n    const captured = double.captureInputs();\n    const before = await observableState(filePath);\n\n    await messages.listMessages({ filePath });\n    await messages.listMessages({ filePath }, { from: 2, to: 4, limit: 2 });\n    await messages.listMessages({ filePath }, { includeDeleted: true });\n    await messages.listMessages({ filePath }, { from: 9, to: 1 }); // refused, must not write either\n    await messages.show({ filePath }, \"m4\");\n    await messages.show({ filePath }, \"m99\"); // not-found, must not write either\n\n    const after = await observableState(filePath);\n    expect(after).toEqual(before);\n    expect(captured).toHaveLength(0);\n  });\n});\n\n// A thread with live, undrained work: one tool turn through a manual SDK\n// (its no-op seam never drains), leaving three pending forms and their queue\n// rows. The background read-only proof needs the pending state the manual\n// read-only proof above cannot manufacture.\nasync function pendingWorkThread(): Promise<string> {\n  const seeder = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n  const filePath = store.threadPath();\n  const created = await seeder.threads.newThread({\n    filePath,\n    registryPath: store.registryPath,\n  });\n  if (!created.ok) throw new Error(`pending fixture thread creation failed: ${created.error.reason}`);\n  const sent = await seeder.intakeStream.messageEvents({ filePath }, [\n    validEvent(\"user_prompt\", { payload: { text: \"background prompt\" } }),\n    validEvent(\"tool_call\", {\n      payload: { toolCallId: \"call-bg-1\", toolName: \"read_file\", arguments: { path: \"bg.txt\" } },\n    }),\n    validEvent(\"tool_result\", {\n      payload: { toolCallId: \"call-bg-1\", content: \"background output\", isError: false },\n    }),\n    validEvent(\"assistant_text\", { payload: { text: \"background answer\" } }),\n    validEvent(\"turn_end\"),\n  ]);\n  if (!sent.ok) throw new Error(`pending fixture intake failed: ${sent.error.reason}`);\n  return filePath;\n}\n\n// Below-SDK raw snapshot of everything a wrongly-scheduled catch-up drain\n// would move: work-item rows and derived-form states. Read through a raw\n// handle (openRaw), never the SDK ops — those would fire their own touch and\n// pollute the very state under test.\nfunction rawWorkAndForms(filePath: string): Record<string, unknown> {\n  const db = openRaw(filePath);\n  try {\n    return {\n      workItems: db\n        .prepare(`SELECT work_item_id, status, attempts FROM work_item ORDER BY work_item_id`)\n        .all(),\n      forms: db\n        .prepare(\n          `SELECT subject_id, form, state, source_version FROM derived_form\n           ORDER BY subject_id, form`,\n        )\n        .all(),\n    };\n  } finally {\n    db.close();\n  }\n}\n\ndescribe(\"architecture risk: background reads schedule no catch-up drain (DD-6, SV-01-001)\", () => {","numLines":70,"startLine":267,"totalLines":404}}}

5\t} from \"./tech-utils/work-queue/index.js\";\n56\t\n57\texport type {\n58\t  ErrorClass,\n59\t  ErrorCode,\n60\t  ErrorResult,\n61\t  OpResult,\n62\t} from \"./shared/errors.js\";\n63\texport {\n64\t  runInTransaction,\n65\t  setSchedulerPoke,\n66\t  setThreadTouch,\n67\t  type OperationContext,\n68\t} from \"./shared/context.js\";\n69\t\n70\texport {\n71\t  createDeterministicProvider,\n72\t  deterministicOutcomesSuffix,\n73\t  deterministicReceiptsSuffix,\n74\t  deterministicText,\n75\t  type DeterministicOpName,\n76\t} from \"./providers/deterministic.js\";\n77\texport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n78\t\n79\texport type {\n80\t  CompletionTx,\n81\t  DependencyGap,\n82\t  DerivationProvider,\n83\t  DerivedForm,\n84\t  DerivedFormMetadata,\n85\t  DerivedFormState,\n86\t  FormKind,\n87\t  FormReportEntry,\n88\t  HandlerFormWrite,\n89\t  HandlerOutcome,\n90\t  HandlerRunContext,\n91\t  ProviderResult,\n92\t  RenderingPart,\n93\t  ResolvedSdkConfig,\n94\t  SdkConfig,\n95\t  SubjectKind,\n96\t  ToolOutcome,\n97\t  ToolRunReceipt,\n98\t  WorkHandler,\n99\t} from \"./shared/derivation.js\";\n100\texport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n101\t\n102\t// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n103\t// from Story 0; the operation shapes land with Stories 1–5.\n104\texport {\n105\t  BUILT_IN_PROFILES,\n106\t  DEFAULT_COMPACT_THRESHOLD,\n107\t  DEFAULT_VISIBILITY,\n108\t} from \"./domains/thread-view/index.js\";\n109\texport type {\n110\t  Band,\n111\t  CompactReceipt,\n112\t  PullResult,\n113\t  ResolvedViewConfig,\n114\t  SdkViewConfig,\n115\t  SweepReceipt,\n116\t  ViewCompactParams,\n117\t  ViewMessage,\n118\t  ViewMeta,\n119\t  ViewProfile,\n120\t  ViewProfileOverride,\n121\t  ViewStatus,\n122\t  VisibilityBudgets,\n123\t} from \"./shared/view.js\";\n124\texport {\n125\t  countLiveItems,\n126\t  enqueue,\n127\t  queueDetail,\n128\t  supersedeQueued,\n129\t  type ClaimedWorkItem,\n130\t  type EnqueueFormTarget,\n131\t  type EnqueueInput,\n132\t  type QueueDetailRow,\n133\t} from \"./tech-utils/work-queue/index.js\";\n134\t\n135\texport type { ThreadRef } from \"./domains/threads/index.js\";\n136\texport type {\n137\t  Block,\n138\t  BlockType,\n139\t  MessageDetail,\n140\t  MessageListOptions,\n141\t  MessageRecord,\n142\t  MutationResult,\n143\t} from \"./domains/messages/index.js\";\n144\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n145\texport type {\n146\t  BatchResult,\n147\t  EventKind,\n148\t  EventRecord,\n149\t  MessageEventInput,\n150\t} from \"./domains/intake-stream/index.js\";\n151\t\n152\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n153\t\n154\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n155\t\n156\t// Merge per-domain handler tables into the one join between the queue's\n157\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n158\t// (each kind has exactly one owner) and throws at construction.\n159\texport function assembleWorkHandlerMap(\n160\t  tables: ReadonlyArray<WorkHandlerMap>,\n161\t): WorkHandlerMap {\n162\t  const map: WorkHandlerMap = {};\n163\t  for (const table of tables) {\n164\t    for (const [kind, handler] of Object.entries(table)) {\n165\t      if (map[kind as WorkKind] !== undefined) {\n166\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n167\t      }\n168\t      map[kind as WorkKind] = handler;\n169\t    }\n170\t  }\n171\t  return map;\n172\t}\n173\t\n174\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n175\t  return {\n176\t    ok: false,\n177\t    error: {\n178\t      errorClass: \"state_corruption\",\n179\t      code: \"unknown_work_kind\",\n180\t      reason: `no handler registered for work kind \"${kind}\"`,\n181\t    },\n182\t  };\n183\t}\n184\t\n185\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n186\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n187\texport function lookupWorkHandler(\n188\t  map: WorkHandlerMap,\n189\t  kind: string,\n190\t): OpResult<WorkHandler> {\n191\t  const handler = map[kind as WorkKind];\n192\t  if (handler === undefined) return unknownWorkKind(kind);\n193\t  return { ok: true, value: handler };\n194\t}\n195\t\n196\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n197\t// requeue land in Story 4.\n198\texport interface WorkSurface {\n199\t  drain(\n200\t    ref: threadsDomain.ThreadRef,\n201\t    opts?: { maxItems?: number },\n202\t  ): Promise<OpResult<DrainReport>>;\n203\t}\n204\t\n205\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n206\t// §Interface Definitions): the five operations only — the Story 0 config\n207\t// substrate the domain index also carries is construction machinery, not an\n208\t// operation. pull and status are real from Story 1; compact, sweep, and\n209\t// materialize return structured not-implemented results until their stories\n210\t// land.\n211\texport interface ThreadViewSurface {\n212\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n213\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n214\t  compact(\n215\t    ref: threadsDomain.ThreadRef,\n216\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n217\t  ): Promise<OpResult<CompactReceipt>>;\n218\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n219\t  materialize(\n220\t    ref: threadsDomain.ThreadRef,\n221\t    opts: { path: string; format?: \"pi-session\" },\n222\t  ): Promise<OpResult<{ writtenPath: string }>>;\n223\t}\n224\t\n225\texport interface Lhc {\n226\t  threads: typeof threadsDomain;\n227\t  intakeStream: typeof intakeStreamDomain;\n228\t  messages: typeof messagesDomain;\n229\t  turns: typeof turnsDomain;\n230\t  threadView: ThreadViewSurface;\n231\t  config: ResolvedSdkConfig;\n232\t  scheduler: Scheduler;\n233\t  workHandlers: WorkHandlerMap;\n234\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n235\t  work: WorkSurface;\n236\t  // Resolves when the scheduler has no running or pending drain for the\n237\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n238\t  // resolve in manual mode.\n239\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n240\t}\n241\t\n242\tfunction requirePositive(value: number, name: string): void {\n243\t  if (!Number.isFinite(value) || value <= 0) {\n244\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n245\t  }\n246\t}\n247\t\n248\tfunction requireNonNegative(value: number, name: string): void {\n249\t  if (!Number.isFinite(value) || value < 0) {\n250\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n251\t  }\n252\t}\n253\t\n254\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n255\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n256\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n257\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n258\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n259\t// object is the same shape as the namespace, so the public surface type holds.\n260\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n261\t  const scoped: Record<string, unknown> = {};\n262\t  for (const key of Object.keys(surface)) {\n263\t    const value = (surface as Record<string, unknown>)[key];\n264\t    scoped[key] =\n265\t      typeof value === \"function\"\n266\t        ? (...args: unknown[]): unknown =>\n267\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n268\t        : value;\n269\t  }\n270\t  return scoped as T;\n271\t}\n272\t\n273\t// The only assembly path: provider, mode, clock, and policy enter here.\n274\t// Config mistakes are programmer errors at construction and throw; operating\n275\t// failures after construction return OpResults per the error contract.\n276\texport function createSdk(config: SdkConfig): Lhc {\n277\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n278\t    throw new TypeError(\n279\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n280\t    );\n281\t  }\n282\t  if (config.provider === null || typeof config.provider !== \"object\") {\n283\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n284\t  }\n285\t  for (const operation of PROVIDER_OPERATIONS) {\n286\t    if (typeof config.provider[operation] !== \"function\") {\n287\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n288\t    }\n289\t  }\n290\t\n291\t  const resolved: ResolvedSdkConfig = {\n292\t    provider: config.provider,\n293\t    mode: config.mode,\n294\t    clock: config.clock ?? (() => new Date()),\n295\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n296\t    lease: config.lease ?? { durationMs: 120000 },\n297\t    chunkPolicy:\n298\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n299\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n300\t    // sums and visibility budgets validated — throws naming the violation.\n301\t    view: resolveViewConfig(config.view),\n302\t  };\n303\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n304\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n305\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n306\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n307\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n308\t  }\n309\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n310\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n311\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n312\t    throw new TypeError(\n313\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n314\t    );\n315\t  }\n316\t\n317\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n318\t  // The tables are empty until Stories 2–3 land the real handlers; the\n319\t  // assembly mechanics are production code from day one.\n320\t  const workHandlers = assembleWorkHandlerMap([\n321\t    messagesDomain.workHandlers,\n322\t    turnsDomain.workHandlers,\n323\t  ]);\n324\t\n325\t  const drainDeps: DrainDeps = {\n326\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n327\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n328\t    config: resolved,\n329\t  };\n330\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n331\t\n332\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n333\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n334\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n335\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n336\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n337\t  // the construction order, because its operations deliver to the no-op seam,\n338\t  // not to whatever a background SDK installed below.\n339\t  // The seam also carries this instance's resolved view config (Epic 03,\n340\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n341\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n342\t  // fall back to the built-in defaults inside the thread-view surface.\n343\t  const seam: InstanceSeam =\n344\t    resolved.mode === \"background\"\n345\t      ? {\n346\t          poke: (threadId) => scheduler.poke(threadId),\n347\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n348\t          view: resolved.view,\n349\t        }\n350\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\n351\t\n352\t  // Background mode also installs the below-SDK default seam so a direct\n353\t  // domain call made with no SDK scope — a top-level mutation in the\n354\t  // single-background \"production path\" — still reaches the one installed\n355\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n356\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n357\t  // leaves the default alone (pokes stay no-ops by contract).\n358\t  if (resolved.mode === \"background\") {\n359\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n360\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n361\t  }\n362\t\n363\t  const work: WorkSurface = {\n364\t    drain: (ref, opts) =>\n365\t      runWithInstanceSeam(seam, async () => {\n366\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n367\t        if (!resolvedRef.ok) return resolvedRef;\n368\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n369\t      }),\n370\t  };\n371\t\n372\t  return {\n373\t    threads: threadsDomain,\n374\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n375\t    messages: scopeSurface(messagesDomain, seam),\n376\t    turns: scopeSurface(turnsDomain, seam),\n377\t    threadView: scopeSurface<ThreadViewSurface>(\n378\t      {\n379\t        pull: threadViewDomain.pull,\n380\t        status: threadViewDomain.status,\n381\t        compact: threadViewDomain.compact,\n382\t        sweep: threadViewDomain.sweep,\n383\t        materialize: threadViewDomain.materialize,\n384\t      },\n385\t      seam,\n386\t    ),\n387\t    config: resolved,\n388\t    scheduler,\n389\t    workHandlers,\n390\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n391\t    work,\n392\t    drainSettled: async (ref) => {\n393\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n394\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n395\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n396\t      if (threadId === null) return;\n397\t      return scheduler.drainSettled(threadId);\n398\t    },\n399\t  };\n400\t}\n401\t"}]},"parent_tool_use_id":null,"session_id":"129e29ba-fc2e-4a7e-aec1-ad68e0f0dc1b","uuid":"0c899022-f821-4d97-9c29-3711c663ca73","timestamp":"2026-06-12T14:12:40.218Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/sdk.ts","content":"export * as threads from \"./domains/threads/index.js\";\nexport * as intakeStream from \"./domains/intake-stream/index.js\";\nexport * as messages from \"./domains/messages/index.js\";\nexport * as turns from \"./domains/turns/index.js\";\nexport * as threadView from \"./domains/thread-view/index.js\";\n\nimport * as intakeStreamDomain from \"./domains/intake-stream/index.js\";\nimport * as threadViewDomain from \"./domains/thread-view/index.js\";\nimport { resolveViewConfig } from \"./domains/thread-view/index.js\";\nimport * as messagesDomain from \"./domains/messages/index.js\";\nimport * as threadsDomain from \"./domains/threads/index.js\";\nimport * as turnsDomain from \"./domains/turns/index.js\";\nimport {\n  createScheduler,\n  peekThreadId,\n  runDrain,\n  type DrainDeps,\n  type DrainReport,\n  type Scheduler,\n} from \"./scheduler.js\";\nimport {\n  runWithInstanceSeam,\n  setSchedulerPoke as installSchedulerPoke,\n  setThreadTouch,\n  type InstanceSeam,\n} from \"./shared/context.js\";\nimport {\n  PROVIDER_OPERATIONS,\n  type ResolvedSdkConfig,\n  type SdkConfig,\n  type WorkHandler,\n} from \"./shared/derivation.js\";\nimport type { ErrorResult, OpResult } from \"./shared/errors.js\";\nimport type {\n  CompactReceipt,\n  PullResult,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewProfile,\n  ViewStatus,\n} from \"./shared/view.js\";\nimport type { WorkKind } from \"./tech-utils/work-queue/index.js\";\n\nexport {\n  estimateTokens,\n  TOKEN_ESTIMATOR_ID,\n} from \"./tech-utils/token-counting/index.js\";\n\nexport {\n  WORK_KIND_REGISTRY,\n  type WorkItemRecord,\n  type WorkKind,\n  type WorkOwner,\n  type WorkSourceRef,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type {\n  ErrorClass,\n  ErrorCode,\n  ErrorResult,\n  OpResult,\n} from \"./shared/errors.js\";\nexport {\n  runInTransaction,\n  setSchedulerPoke,\n  setThreadTouch,\n  type OperationContext,\n} from \"./shared/context.js\";\n\nexport {\n  createDeterministicProvider,\n  deterministicOutcomesSuffix,\n  deterministicReceiptsSuffix,\n  deterministicText,\n  type DeterministicOpName,\n} from \"./providers/deterministic.js\";\nexport { registeredProviderNames, resolveNamedProvider } from \"./providers/registry.js\";\n\nexport type {\n  CompletionTx,\n  DependencyGap,\n  DerivationProvider,\n  DerivedForm,\n  DerivedFormMetadata,\n  DerivedFormState,\n  FormKind,\n  FormReportEntry,\n  HandlerFormWrite,\n  HandlerOutcome,\n  HandlerRunContext,\n  ProviderResult,\n  RenderingPart,\n  ResolvedSdkConfig,\n  SdkConfig,\n  SubjectKind,\n  ToolOutcome,\n  ToolRunReceipt,\n  WorkHandler,\n} from \"./shared/derivation.js\";\nexport type { DrainReport, Scheduler, SchedulerMode } from \"./scheduler.js\";\n\n// Epic 03 view vocabulary (shared/view.ts): config shapes live on SdkConfig\n// from Story 0; the operation shapes land with Stories 1–5.\nexport {\n  BUILT_IN_PROFILES,\n  DEFAULT_COMPACT_THRESHOLD,\n  DEFAULT_VISIBILITY,\n} from \"./domains/thread-view/index.js\";\nexport type {\n  Band,\n  CompactReceipt,\n  PullResult,\n  ResolvedViewConfig,\n  SdkViewConfig,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewMessage,\n  ViewMeta,\n  ViewProfile,\n  ViewProfileOverride,\n  ViewStatus,\n  VisibilityBudgets,\n} from \"./shared/view.js\";\nexport {\n  countLiveItems,\n  enqueue,\n  queueDetail,\n  supersedeQueued,\n  type ClaimedWorkItem,\n  type EnqueueFormTarget,\n  type EnqueueInput,\n  type QueueDetailRow,\n} from \"./tech-utils/work-queue/index.js\";\n\nexport type { ThreadRef } from \"./domains/threads/index.js\";\nexport type {\n  Block,\n  BlockType,\n  MessageDetail,\n  MessageListOptions,\n  MessageRecord,\n  MutationResult,\n} from \"./domains/messages/index.js\";\nexport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\nexport type {\n  BatchResult,\n  EventKind,\n  EventRecord,\n  MessageEventInput,\n} from \"./domains/intake-stream/index.js\";\n\n// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n\nexport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n\n// Merge per-domain handler tables into the one join between the queue's\n// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n// (each kind has exactly one owner) and throws at construction.\nexport function assembleWorkHandlerMap(\n  tables: ReadonlyArray<WorkHandlerMap>,\n): WorkHandlerMap {\n  const map: WorkHandlerMap = {};\n  for (const table of tables) {\n    for (const [kind, handler] of Object.entries(table)) {\n      if (map[kind as WorkKind] !== undefined) {\n        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n      }\n      map[kind as WorkKind] = handler;\n    }\n  }\n  return map;\n}\n\nfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"state_corruption\",\n      code: \"unknown_work_kind\",\n      reason: `no handler registered for work kind \"${kind}\"`,\n    },\n  };\n}\n\n// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\nexport function lookupWorkHandler(\n  map: WorkHandlerMap,\n  kind: string,\n): OpResult<WorkHandler> {\n  const handler = map[kind as WorkKind];\n  if (handler === undefined) return unknownWorkKind(kind);\n  return { ok: true, value: handler };\n}\n\n// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n// requeue land in Story 4.\nexport interface WorkSurface {\n  drain(\n    ref: threadsDomain.ThreadRef,\n    opts?: { maxItems?: number },\n  ): Promise<OpResult<DrainReport>>;\n}\n\n// The thread-view surface as the SDK exposes it (Epic 03, tech design\n// §Interface Definitions): the five operations only — the Story 0 config\n// substrate the domain index also carries is construction machinery, not an\n// operation. pull and status are real from Story 1; compact, sweep, and\n// materialize return structured not-implemented results until their stories\n// land.\nexport interface ThreadViewSurface {\n  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n  compact(\n    ref: threadsDomain.ThreadRef,\n    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n  ): Promise<OpResult<CompactReceipt>>;\n  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n  materialize(\n    ref: threadsDomain.ThreadRef,\n    opts: { path: string; format?: \"pi-session\" },\n  ): Promise<OpResult<{ writtenPath: string }>>;\n}\n\nexport interface Lhc {\n  threads: typeof threadsDomain;\n  intakeStream: typeof intakeStreamDomain;\n  messages: typeof messagesDomain;\n  turns: typeof turnsDomain;\n  threadView: ThreadViewSurface;\n  config: ResolvedSdkConfig;\n  scheduler: Scheduler;\n  workHandlers: WorkHandlerMap;\n  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n  work: WorkSurface;\n  // Resolves when the scheduler has no running or pending drain for the\n  // thread (issue 3) — the awaitable for background mode, and a no-op\n  // resolve in manual mode.\n  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n}\n\nfunction requirePositive(value: number, name: string): void {\n  if (!Number.isFinite(value) || value <= 0) {\n    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n  }\n}\n\nfunction requireNonNegative(value: number, name: string): void {\n  if (!Number.isFinite(value) || value < 0) {\n    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n  }\n}\n\n// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n// (background) or a no-op (manual) — never another SDK's. Non-function exports\n// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n// object is the same shape as the namespace, so the public surface type holds.\nfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n  const scoped: Record<string, unknown> = {};\n  for (const key of Object.keys(surface)) {\n    const value = (surface as Record<string, unknown>)[key];\n    scoped[key] =\n      typeof value === \"function\"\n        ? (...args: unknown[]): unknown =>\n            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n        : value;\n  }\n  return scoped as T;\n}\n\n// The only assembly path: provider, mode, clock, and policy enter here.\n// Config mistakes are programmer errors at construction and throw; operating\n// failures after construction return OpResults per the error contract.\nexport function createSdk(config: SdkConfig): Lhc {\n  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n    throw new TypeError(\n      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n    );\n  }\n  if (config.provider === null || typeof config.provider !== \"object\") {\n    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n  }\n  for (const operation of PROVIDER_OPERATIONS) {\n    if (typeof config.provider[operation] !== \"function\") {\n      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n    }\n  }\n\n  const resolved: ResolvedSdkConfig = {\n    provider: config.provider,\n    mode: config.mode,\n    clock: config.clock ?? (() => new Date()),\n    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n    lease: config.lease ?? { durationMs: 120000 },\n    chunkPolicy:\n      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n    // sums and visibility budgets validated — throws naming the violation.\n    view: resolveViewConfig(config.view),\n  };\n  requirePositive(resolved.retry.budget, \"retry.budget\");\n  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n  }\n  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n    throw new TypeError(\n      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n    );\n  }\n\n  // Handler maps merge from per-domain contributions at construction (DD-6).\n  // The tables are empty until Stories 2–3 land the real handlers; the\n  // assembly mechanics are production code from day one.\n  const workHandlers = assembleWorkHandlerMap([\n    messagesDomain.workHandlers,\n    turnsDomain.workHandlers,\n  ]);\n\n  const drainDeps: DrainDeps = {\n    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n    config: resolved,\n  };\n  const scheduler = createScheduler(resolved.mode, drainDeps);\n\n  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n  // background mode, or a no-op in manual mode — isolated from any other SDK\n  // alive in the process. A manual SDK therefore never auto-drains, whatever\n  // the construction order, because its operations deliver to the no-op seam,\n  // not to whatever a background SDK installed below.\n  // The seam also carries this instance's resolved view config (Epic 03,\n  // tech design Flow 4): thread-view operations invoked through sdk.* read\n  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n  // fall back to the built-in defaults inside the thread-view surface.\n  const seam: InstanceSeam =\n    resolved.mode === \"background\"\n      ? {\n          poke: (threadId) => scheduler.poke(threadId),\n          touch: (filePath, db) => scheduler.touch(filePath, db),\n          view: resolved.view,\n        }\n      : { poke: () => {}, touch: () => {}, view: resolved.view };\n\n  // Background mode also installs the below-SDK default seam so a direct\n  // domain call made with no SDK scope — a top-level mutation in the\n  // single-background \"production path\" — still reaches the one installed\n  // scheduler. The per-instance scoping above overrides this for every sdk.*\n  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n  // leaves the default alone (pokes stay no-ops by contract).\n  if (resolved.mode === \"background\") {\n    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n  }\n\n  const work: WorkSurface = {\n    drain: (ref, opts) =>\n      runWithInstanceSeam(seam, async () => {\n        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n        if (!resolvedRef.ok) return resolvedRef;\n        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n      }),\n  };\n\n  return {\n    threads: threadsDomain,\n    intakeStream: scopeSurface(intakeStreamDomain, seam),\n    messages: scopeSurface(messagesDomain, seam),\n    turns: scopeSurface(turnsDomain, seam),\n    threadView: scopeSurface<ThreadViewSurface>(\n      {\n        pull: threadViewDomain.pull,\n        status: threadViewDomain.status,\n        compact: threadViewDomain.compact,\n        sweep: threadViewDomain.sweep,\n        materialize: threadViewDomain.materialize,\n      },\n      seam,\n    ),\n    config: resolved,\n    scheduler,\n    workHandlers,\n    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n    work,\n    drainSettled: async (ref) => {\n      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n      const threadId = peekThreadId(resolvedRef.value.filePath);\n      if (threadId === null) return;\n      return scheduler.drainSettled(threadId);\n    },\n  };\n}\n","numLines":401,"startLine":1,"totalLines":401}}}

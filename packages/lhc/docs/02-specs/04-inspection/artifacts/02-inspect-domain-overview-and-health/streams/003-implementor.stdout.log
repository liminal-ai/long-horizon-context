{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W3CnfP3o2eYRAULnCdWhGT","type":"tool_result","content":"1\timport { existsSync } from \"node:fs\";\n2\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n3\timport {\n4\t  createThreadFile,\n5\t  deleteThreadFile,\n6\t  generateThreadId,\n7\t  openThreadDatabase,\n8\t} from \"./internal/create.js\";\n9\t\n10\t// Re-exported for the other domain surfaces: opening a thread file through\n11\t// the threads domain is what guarantees its schema is current (a pre-Story-3\n12\t// file gains the message tables here before any write or read touches them).\n13\texport { openThreadDatabase };\n14\timport {\n15\t  insertThreadRow,\n16\t  openRegistryForRead,\n17\t  openRegistryForWrite,\n18\t  resolveRegistryPath,\n19\t  selectAllThreadRows,\n20\t  selectThreadRow,\n21\t  type RegistryRow,\n22\t} from \"./internal/registry.js\";\n23\t\n24\texport type ThreadRef =\n25\t  | { threadId: string; registryPath?: string }\n26\t  | { filePath: string };\n27\t\n28\texport interface NewThreadInput {\n29\t  filePath: string;\n30\t  title?: string;\n31\t  registryPath?: string;\n32\t}\n33\t\n34\texport interface ThreadInfo {\n35\t  threadId: string;\n36\t  filePath: string;\n37\t  title?: string;\n38\t  createdAt: string; // ISO-8601\n39\t}\n40\t\n41\tfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n42\t  const info: ThreadInfo = {\n43\t    threadId: row.threadId,\n44\t    filePath: row.filePath,\n45\t    createdAt: row.createdAt,\n46\t  };\n47\t  if (row.title !== undefined) info.title = row.title;\n48\t  return info;\n49\t}\n50\t\n51\tfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n52\t  return {\n53\t    ok: false,\n54\t    error: {\n55\t      errorClass: \"caller_error\",\n56\t      code: \"thread_not_found\",\n57\t      reason: `no thread registered with id ${threadId}`,\n58\t    },\n59\t  };\n60\t}\n61\t\n62\tfunction invalidThreadRef(reason: string): { ok: false; error: ErrorResult } {\n63\t  return {\n64\t    ok: false,\n65\t    error: { errorClass: \"caller_error\", code: \"invalid_thread_ref\", reason },\n66\t  };\n67\t}\n68\t\n69\t// A file path that is empty or whitespace-only cannot name a durable file:\n70\t// node:sqlite's DatabaseSync(\"\") opens a temporary database that vanishes on\n71\t// close, so such a path must be refused as a caller error before any storage\n72\t// is touched rather than silently producing a thread with no durable file.\n73\tfunction isBlankPath(filePath: string): boolean {\n74\t  return filePath.trim() === \"\";\n75\t}\n76\t\n77\tfunction detail(cause: unknown): string {\n78\t  return cause instanceof Error ? cause.message : String(cause);\n79\t}\n80\t\n81\t// Creation spans two databases that cannot share a transaction. Order is\n82\t// file-then-row with compensation: the invariant \"no registry row without\n83\t// its file\" is absolute; an orphan file from a crash between the writes is\n84\t// documented harmless (design decision 2).\n85\texport async function newThread(\n86\t  input: NewThreadInput,\n87\t): Promise<OpResult<{ threadId: string; filePath: string }>> {\n88\t  // Guard before any storage touch: an empty/blank path would otherwise open\n89\t  // a temp database and register a thread with no durable file (the no-row-\n90\t  // without-file invariant below depends on the path naming a real file).\n91\t  if (isBlankPath(input.filePath)) {\n92\t    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n93\t  }\n94\t  if (existsSync(input.filePath)) {\n95\t    return {\n96\t      ok: false,\n97\t      error: {\n98\t        errorClass: \"caller_error\",\n99\t        code: \"path_exists\",\n100\t        reason: `a file already exists at ${input.filePath}`,\n101\t      },\n102\t    };\n103\t  }\n104\t\n105\t  const threadId = generateThreadId();\n106\t  const createdAt = new Date().toISOString();\n107\t\n108\t  try {\n109\t    createThreadFile(input.filePath, threadId, createdAt);\n110\t  } catch (cause) {\n111\t    deleteThreadFile(input.filePath);\n112\t    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n113\t  }\n114\t\n115\t  let registry;\n116\t  try {\n117\t    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n118\t    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n119\t    if (input.title !== undefined) row.title = input.title;\n120\t    insertThreadRow(registry, row);\n121\t  } catch (cause) {\n122\t    deleteThreadFile(input.filePath);\n123\t    return storageFailure(`registry insert failed: ${detail(cause)}`);\n124\t  } finally {\n125\t    registry?.close();\n126\t  }\n127\t\n128\t  return { ok: true, value: { threadId, filePath: input.filePath } };\n129\t}\n130\t\n131\texport async function resolve(input: {\n132\t  threadId: string;\n133\t  registryPath?: string;\n134\t}): Promise<OpResult<ThreadInfo>> {\n135\t  let registry;\n136\t  try {\n137\t    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n138\t    if (registry === null) return threadNotFound(input.threadId);\n139\t    const row = selectThreadRow(registry, input.threadId);\n140\t    if (row === undefined) return threadNotFound(input.threadId);\n141\t    return { ok: true, value: toThreadInfo(row) };\n142\t  } catch (cause) {\n143\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n144\t  } finally {\n145\t    registry?.close();\n146\t  }\n147\t}\n148\t\n149\texport async function listThreads(input?: {\n150\t  registryPath?: string;\n151\t}): Promise<OpResult<ThreadInfo[]>> {\n152\t  let registry;\n153\t  try {\n154\t    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n155\t    if (registry === null) return { ok: true, value: [] };\n156\t    return { ok: true, value: selectAllThreadRows(registry).map(toThreadInfo) };\n157\t  } catch (cause) {\n158\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n159\t  } finally {\n160\t    registry?.close();\n161\t  }\n162\t}\n163\t\n164\t// The single interpreter of thread references: { threadId } resolves to a\n165\t// path through the registry, { filePath } passes through untouched. No other\n166\t// code ever reads a thread reference.\n167\texport async function resolveThreadRef(\n168\t  ref: ThreadRef,\n169\t): Promise<OpResult<{ filePath: string }>> {\n170\t  if (\"threadId\" in ref) {\n171\t    const resolved = await resolve(ref);\n172\t    if (!resolved.ok) return resolved;\n173\t    return { ok: true, value: { filePath: resolved.value.filePath } };\n174\t  }\n175\t  // Mirror newThread's guard so every read surface that routes through here\n176\t  // fails closed on a blank path instead of opening a temp database.\n177\t  if (isBlankPath(ref.filePath)) {\n178\t    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n179\t  }\n180\t  return { ok: true, value: { filePath: ref.filePath } };\n181\t}\n182\t"}]},"parent_tool_use_id":null,"session_id":"129e29ba-fc2e-4a7e-aec1-ad68e0f0dc1b","uuid":"9fa663dc-3021-4fa4-a6d0-cc042080007a","timestamp":"2026-06-12T14:14:45.876Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/threads/index.ts","content":"import { existsSync } from \"node:fs\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport {\n  createThreadFile,\n  deleteThreadFile,\n  generateThreadId,\n  openThreadDatabase,\n} from \"./internal/create.js\";\n\n// Re-exported for the other domain surfaces: opening a thread file through\n// the threads domain is what guarantees its schema is current (a pre-Story-3\n// file gains the message tables here before any write or read touches them).\nexport { openThreadDatabase };\nimport {\n  insertThreadRow,\n  openRegistryForRead,\n  openRegistryForWrite,\n  resolveRegistryPath,\n  selectAllThreadRows,\n  selectThreadRow,\n  type RegistryRow,\n} from \"./internal/registry.js\";\n\nexport type ThreadRef =\n  | { threadId: string; registryPath?: string }\n  | { filePath: string };\n\nexport interface NewThreadInput {\n  filePath: string;\n  title?: string;\n  registryPath?: string;\n}\n\nexport interface ThreadInfo {\n  threadId: string;\n  filePath: string;\n  title?: string;\n  createdAt: string; // ISO-8601\n}\n\nfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n  const info: ThreadInfo = {\n    threadId: row.threadId,\n    filePath: row.filePath,\n    createdAt: row.createdAt,\n  };\n  if (row.title !== undefined) info.title = row.title;\n  return info;\n}\n\nfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread registered with id ${threadId}`,\n    },\n  };\n}\n\nfunction invalidThreadRef(reason: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: { errorClass: \"caller_error\", code: \"invalid_thread_ref\", reason },\n  };\n}\n\n// A file path that is empty or whitespace-only cannot name a durable file:\n// node:sqlite's DatabaseSync(\"\") opens a temporary database that vanishes on\n// close, so such a path must be refused as a caller error before any storage\n// is touched rather than silently producing a thread with no durable file.\nfunction isBlankPath(filePath: string): boolean {\n  return filePath.trim() === \"\";\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n// Creation spans two databases that cannot share a transaction. Order is\n// file-then-row with compensation: the invariant \"no registry row without\n// its file\" is absolute; an orphan file from a crash between the writes is\n// documented harmless (design decision 2).\nexport async function newThread(\n  input: NewThreadInput,\n): Promise<OpResult<{ threadId: string; filePath: string }>> {\n  // Guard before any storage touch: an empty/blank path would otherwise open\n  // a temp database and register a thread with no durable file (the no-row-\n  // without-file invariant below depends on the path naming a real file).\n  if (isBlankPath(input.filePath)) {\n    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n  }\n  if (existsSync(input.filePath)) {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"caller_error\",\n        code: \"path_exists\",\n        reason: `a file already exists at ${input.filePath}`,\n      },\n    };\n  }\n\n  const threadId = generateThreadId();\n  const createdAt = new Date().toISOString();\n\n  try {\n    createThreadFile(input.filePath, threadId, createdAt);\n  } catch (cause) {\n    deleteThreadFile(input.filePath);\n    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n  }\n\n  let registry;\n  try {\n    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n    if (input.title !== undefined) row.title = input.title;\n    insertThreadRow(registry, row);\n  } catch (cause) {\n    deleteThreadFile(input.filePath);\n    return storageFailure(`registry insert failed: ${detail(cause)}`);\n  } finally {\n    registry?.close();\n  }\n\n  return { ok: true, value: { threadId, filePath: input.filePath } };\n}\n\nexport async function resolve(input: {\n  threadId: string;\n  registryPath?: string;\n}): Promise<OpResult<ThreadInfo>> {\n  let registry;\n  try {\n    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n    if (registry === null) return threadNotFound(input.threadId);\n    const row = selectThreadRow(registry, input.threadId);\n    if (row === undefined) return threadNotFound(input.threadId);\n    return { ok: true, value: toThreadInfo(row) };\n  } catch (cause) {\n    return storageFailure(`registry read failed: ${detail(cause)}`);\n  } finally {\n    registry?.close();\n  }\n}\n\nexport async function listThreads(input?: {\n  registryPath?: string;\n}): Promise<OpResult<ThreadInfo[]>> {\n  let registry;\n  try {\n    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n    if (registry === null) return { ok: true, value: [] };\n    return { ok: true, value: selectAllThreadRows(registry).map(toThreadInfo) };\n  } catch (cause) {\n    return storageFailure(`registry read failed: ${detail(cause)}`);\n  } finally {\n    registry?.close();\n  }\n}\n\n// The single interpreter of thread references: { threadId } resolves to a\n// path through the registry, { filePath } passes through untouched. No other\n// code ever reads a thread reference.\nexport async function resolveThreadRef(\n  ref: ThreadRef,\n): Promise<OpResult<{ filePath: string }>> {\n  if (\"threadId\" in ref) {\n    const resolved = await resolve(ref);\n    if (!resolved.ok) return resolved;\n    return { ok: true, value: { filePath: resolved.value.filePath } };\n  }\n  // Mirror newThread's guard so every read surface that routes through here\n  // fails closed on a blank path instead of opening a temp database.\n  if (isBlankPath(ref.filePath)) {\n    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n  }\n  return { ok: true, value: { filePath: ref.filePath } };\n}\n","numLines":182,"startLine":1,"totalLines":182}}}

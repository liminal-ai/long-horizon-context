{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019hePQeBLkNvYnuYpjyzwdc","type":"tool_result","content":"1\timport { parseArgs } from \"node:util\";\n2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n3\timport * as messages from \"../domains/messages/index.js\";\n4\timport * as threads from \"../domains/threads/index.js\";\n5\timport * as turns from \"../domains/turns/index.js\";\n6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n8\timport type { OpResult } from \"../shared/errors.js\";\n9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n10\timport { runMessagesDelete, runMessagesEdit } from \"./messages-mutate.js\";\n11\timport { runMessagesList, runMessagesShow } from \"./messages-read.js\";\n12\timport { runTurnsDelete } from \"./turns-mutate.js\";\n13\timport {\n14\t  runMessagesReport,\n15\t  runMessagesRequeue,\n16\t  runTurnsReport,\n17\t  runTurnsRequeue,\n18\t  runWorkDrain,\n19\t} from \"./work.js\";\n20\timport { runViewCommand } from \"./view.js\";\n21\t\n22\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n23\t// process stdin. null means interactive (TTY) — distinct from empty input\n24\t// only in how it arises; both are refused with empty_stdin before any SDK\n25\t// call (the SDK itself can never return that code).\n26\texport type StdinReader = () => Promise<string | null>;\n27\t\n28\tasync function readProcessStdin(): Promise<string | null> {\n29\t  if (process.stdin.isTTY) return null;\n30\t  process.stdin.setEncoding(\"utf8\");\n31\t  let data = \"\";\n32\t  for await (const chunk of process.stdin) data += String(chunk);\n33\t  return data;\n34\t}\n35\t\n36\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n37\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n38\t}\n39\t\n40\tconst HELP = `lhc — Long Horizon Context CLI\n41\t\n42\tUsage:\n43\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n44\t  lhc threads resolve --thread-id <id> [--registry <r>]\n45\t  lhc threads list [--registry <r>]\n46\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n47\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n48\t  lhc messages list (--thread-id <id> | --file-path <p>) [--from <n>] [--to <n>]\n49\t                    [--limit <n>] [--include-deleted] [--registry <r>]\n50\t  lhc messages show (--thread-id <id> | --file-path <p>) --message-id <id> [--registry <r>]\n51\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n52\t  lhc messages report (--thread-id <id> | --file-path <p>) [--not-ready] [--message-id <id>] [--registry <r>]\n53\t  lhc messages requeue (--thread-id <id> | --file-path <p>) --message-id <id> --form <form> [--registry <r>]\n54\t  lhc messages edit (--thread-id <id> | --file-path <p>) --message <id> --content <text> [--registry <r>]\n55\t  lhc messages delete (--thread-id <id> | --file-path <p>) --message <id> [--registry <r>]\n56\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n57\t  lhc turns list-chunks (--thread-id <id> | --file-path <p>) [--registry <r>]\n58\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n59\t  lhc turns report (--thread-id <id> | --file-path <p>) [--not-ready] [--turn-id <id>] [--chunk-id <id>] [--registry <r>]\n60\t  lhc turns requeue (--thread-id <id> | --file-path <p>) --subject-kind (turn|chunk) --subject-id <id> --form <form> [--registry <r>]\n61\t  lhc turns delete (--thread-id <id> | --file-path <p>) --turn <id> [--registry <r>]\n62\t  lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n63\t  lhc view pull (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n64\t  lhc view status (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n65\t  lhc view compact (--thread-id <id> | --file-path <p>) [--profile <name>]\n66\t                   [--lower-bound <n>] [--full <n>] [--smooth <n>] [--detailed <n>] [--brief <n>]\n67\t                   [--no-sweep] [--json] [--registry <r>]\n68\t  lhc view sweep (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n69\t  lhc view materialize (--thread-id <id> | --file-path <p>) --out <path> [--format pi-session] [--registry <r>]\n70\t\n71\tEvery command prints the SDK result (value or error) as JSON and exits 0 on\n72\tsuccess, 1 on failure. message-events reads an events JSON array on stdin.\n73\tView commands need no provider; output is always JSON (--json accepted).\n74\tTwo exceptions on success: view pull prints the message array itself, and\n75\tview materialize prints the written path; their failures stay structured.\n76\t`;\n77\t\n78\tinterface ParsedFlags {\n79\t  threadId?: string;\n80\t  filePath?: string;\n81\t  title?: string;\n82\t  registryPath?: string;\n83\t  maxItems?: string;\n84\t  provider?: string;\n85\t  notReady?: boolean;\n86\t  messageId?: string;\n87\t  turnId?: string;\n88\t  chunkId?: string;\n89\t  form?: string;\n90\t  subjectKind?: string;\n91\t  subjectId?: string;\n92\t  content?: string;\n93\t  from?: string;\n94\t  to?: string;\n95\t  limit?: string;\n96\t  includeDeleted?: boolean;\n97\t}\n98\t\n99\t// strict parse rejects unknown/misspelled flags so they are named back to the\n100\t// caller, never silently dropped — the CLI boundary matching the SDK's\n101\t// closed-contract strictness. The failure is returned as data (not thrown) so\n102\t// runCli can render it as the structured usage error.\n103\ttype ParseFlagsResult =\n104\t  | { ok: true; flags: ParsedFlags }\n105\t  | { ok: false; unknownFlag: string };\n106\t\n107\tfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n108\t  let values;\n109\t  try {\n110\t    ({ values } = parseArgs({\n111\t      args: [...args],\n112\t      options: {\n113\t        \"thread-id\": { type: \"string\" },\n114\t        \"file-path\": { type: \"string\" },\n115\t        title: { type: \"string\" },\n116\t        registry: { type: \"string\" },\n117\t        \"max-items\": { type: \"string\" },\n118\t        provider: { type: \"string\" },\n119\t        \"not-ready\": { type: \"boolean\" },\n120\t        \"message-id\": { type: \"string\" },\n121\t        \"turn-id\": { type: \"string\" },\n122\t        \"chunk-id\": { type: \"string\" },\n123\t        form: { type: \"string\" },\n124\t        \"subject-kind\": { type: \"string\" },\n125\t        \"subject-id\": { type: \"string\" },\n126\t        // `--message` / `--turn` are the mutation commands' spellings\n127\t        // (story/tech design); they parse into the same slots as\n128\t        // `--message-id` / `--turn-id`.\n129\t        message: { type: \"string\" },\n130\t        turn: { type: \"string\" },\n131\t        content: { type: \"string\" },\n132\t        // Epic 04 Story 1: the bounded-listing options (lhc messages list).\n133\t        from: { type: \"string\" },\n134\t        to: { type: \"string\" },\n135\t        limit: { type: \"string\" },\n136\t        \"include-deleted\": { type: \"boolean\" },\n137\t      },\n138\t      strict: true,\n139\t      allowPositionals: true,\n140\t    }));\n141\t  } catch (cause) {\n142\t    const message = cause instanceof Error ? cause.message : String(cause);\n143\t    // parseArgs names the offending option in single quotes (e.g. Unknown\n144\t    // option '--file-pth'); surface that token, falling back to the message.\n145\t    const named = /'([^']+)'/.exec(message);\n146\t    return { ok: false, unknownFlag: named?.[1] ?? message };\n147\t  }\n148\t  const flags: ParsedFlags = {};\n149\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n150\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n151\t  if (typeof values.title === \"string\") flags.title = values.title;\n152\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n153\t  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n154\t  if (typeof values.provider === \"string\") flags.provider = values.provider;\n155\t  if (values[\"not-ready\"] === true) flags.notReady = true;\n156\t  if (typeof values[\"message-id\"] === \"string\") flags.messageId = values[\"message-id\"];\n157\t  if (typeof values.message === \"string\") flags.messageId = values.message;\n158\t  if (typeof values.content === \"string\") flags.content = values.content;\n159\t  if (typeof values[\"turn-id\"] === \"string\") flags.turnId = values[\"turn-id\"];\n160\t  if (typeof values.turn === \"string\") flags.turnId = values.turn;\n161\t  if (typeof values[\"chunk-id\"] === \"string\") flags.chunkId = values[\"chunk-id\"];\n162\t  if (typeof values.form === \"string\") flags.form = values.form;\n163\t  if (typeof values[\"subject-kind\"] === \"string\") flags.subjectKind = values[\"subject-kind\"];\n164\t  if (typeof values[\"subject-id\"] === \"string\") flags.subjectId = values[\"subject-id\"];\n165\t  if (typeof values.from === \"string\") flags.from = values.from;\n166\t  if (typeof values.to === \"string\") flags.to = values.to;\n167\t  if (typeof values.limit === \"string\") flags.limit = values.limit;\n168\t  if (values[\"include-deleted\"] === true) flags.includeDeleted = true;\n169\t  return { ok: true, flags };\n170\t}\n171\t\n172\t// The read commands take a thread reference but no stdin; a missing reference\n173\t// is a usage error named before any SDK call, matching the intake commands.\n174\tfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n175\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n176\t    return renderCliError(\n177\t      \"caller_error\",\n178\t      \"missing_flag\",\n179\t      `${command} requires --thread-id or --file-path`,\n180\t    );\n181\t  }\n182\t  return undefined;\n183\t}\n184\t\n185\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n186\t  if (flags.threadId !== undefined) {\n187\t    return flags.registryPath !== undefined\n188\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n189\t      : { threadId: flags.threadId };\n190\t  }\n191\t  return { filePath: flags.filePath ?? \"\" };\n192\t}\n193\t\n194\texport async function runCli(\n195\t  argv: readonly string[],\n196\t  readStdin: StdinReader = readProcessStdin,\n197\t): Promise<CliResult> {\n198\t  if (argv.length === 0) {\n199\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n200\t  }\n201\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n202\t    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n203\t  }\n204\t\n205\t  const [group, command, ...rest] = argv;\n206\t  // The view group parses its own flag surface (band overrides, --out,\n207\t  // --format) — routed before the shared parse so its flags never widen the\n208\t  // other commands' accepted set.\n209\t  if (group === \"view\") {\n210\t    return runViewCommand(command, rest);\n211\t  }\n212\t  const key = command === undefined ? group : `${group} ${command}`;\n213\t  const parsed = parseFlags(command === undefined ? [] : rest);\n214\t  if (!parsed.ok) {\n215\t    return renderCliError(\n216\t      \"caller_error\",\n217\t      \"unknown_flag\",\n218\t      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n219\t    );\n220\t  }\n221\t  const flags = parsed.flags;\n222\t\n223\t  switch (key) {\n224\t    case \"threads new-thread\": {\n225\t      // Guard here: an empty path reaching node:sqlite opens a temp database\n226\t      // instead of failing, so the adapter refuses before any SDK call.\n227\t      if (flags.filePath === undefined) {\n228\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n229\t      }\n230\t      const input: Parameters<typeof threads.newThread>[0] = {\n231\t        filePath: flags.filePath,\n232\t      };\n233\t      if (flags.title !== undefined) input.title = flags.title;\n234\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n235\t      return renderResult(await threads.newThread(input));\n236\t    }\n237\t    case \"threads resolve\": {\n238\t      if (flags.threadId === undefined) {\n239\t        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n240\t      }\n241\t      const input: Parameters<typeof threads.resolve>[0] = {\n242\t        threadId: flags.threadId,\n243\t      };\n244\t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n245\t      return renderResult(await threads.resolve(input));\n246\t    }\n247\t    case \"threads list\": {\n248\t      return renderResult(\n249\t        await threads.listThreads(\n250\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n251\t        ),\n252\t      );\n253\t    }\n254\t    case \"intake-stream message-events\": {\n255\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n256\t        return renderCliError(\n257\t          \"caller_error\",\n258\t          \"missing_flag\",\n259\t          \"intake-stream message-events requires --thread-id or --file-path\",\n260\t        );\n261\t      }\n262\t      const text = await readStdin();\n263\t      if (text === null || text.trim() === \"\") {\n264\t        return renderResult(\n265\t          stdinCallerError(\n266\t            \"empty_stdin\",\n267\t            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n268\t          ),\n269\t        );\n270\t      }\n271\t      let parsed: unknown;\n272\t      try {\n273\t        parsed = JSON.parse(text);\n274\t      } catch (cause) {\n275\t        const detail = cause instanceof Error ? cause.message : String(cause);\n276\t        return renderResult(\n277\t          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n278\t        );\n279\t      }\n280\t      if (!Array.isArray(parsed)) {\n281\t        return renderResult(\n282\t          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n283\t        );\n284\t      }\n285\t      return renderResult(\n286\t        await intakeStream.messageEvents(\n287\t          threadRefFrom(flags),\n288\t          parsed as readonly MessageEventInput[],\n289\t        ),\n290\t      );\n291\t    }\n292\t    case \"intake-stream list-events\": {\n293\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n294\t        return renderCliError(\n295\t          \"caller_error\",\n296\t          \"missing_flag\",\n297\t          \"intake-stream list-events requires --thread-id or --file-path\",\n298\t        );\n299\t      }\n300\t      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n301\t    }\n302\t    case \"messages list\": {\n303\t      const missingRef = requireThreadRef(flags, \"messages list\");\n304\t      if (missingRef !== undefined) return missingRef;\n305\t      // Numeric flags convert here (the argv boundary); semantic bounds\n306\t      // checks (from > to, limit < 1) stay in the SDK so refusal JSON has\n307\t      // CLI/SDK parity.\n308\t      const listOpts: { from?: number; to?: number; limit?: number; includeDeleted?: boolean } =\n309\t        {};\n310\t      if (flags.includeDeleted === true) listOpts.includeDeleted = true;\n311\t      const numericFlags = [\n312\t        [\"from\", flags.from],\n313\t        [\"to\", flags.to],\n314\t        [\"limit\", flags.limit],\n315\t      ] as const;\n316\t      for (const [name, raw] of numericFlags) {\n317\t        if (raw === undefined) continue;\n318\t        const value = Number(raw);\n319\t        if (!Number.isInteger(value)) {\n320\t          return renderCliError(\n321\t            \"caller_error\",\n322\t            \"missing_flag\",\n323\t            `--${name} must be an integer, got ${raw}`,\n324\t          );\n325\t        }\n326\t        listOpts[name] = value;\n327\t      }\n328\t      return runMessagesList(threadRefFrom(flags), listOpts);\n329\t    }\n330\t    case \"messages show\": {\n331\t      const missingRef = requireThreadRef(flags, \"messages show\");\n332\t      if (missingRef !== undefined) return missingRef;\n333\t      if (flags.messageId === undefined) {\n334\t        return renderCliError(\n335\t          \"caller_error\",\n336\t          \"missing_flag\",\n337\t          \"messages show requires --message-id\",\n338\t        );\n339\t      }\n340\t      return runMessagesShow(threadRefFrom(flags), { messageId: flags.messageId });\n341\t    }\n342\t    case \"messages list-queued-work\":\n343\t      return (\n344\t        requireThreadRef(flags, \"messages list-queued-work\") ??\n345\t        renderResult(await messages.listQueuedWork(threadRefFrom(flags)))\n346\t      );\n347\t    case \"messages report\": {\n348\t      const missingRef = requireThreadRef(flags, \"messages report\");\n349\t      if (missingRef !== undefined) return missingRef;\n350\t      const reportFlags: { notReady?: boolean; messageId?: string } = {};\n351\t      if (flags.notReady === true) reportFlags.notReady = true;\n352\t      if (flags.messageId !== undefined) reportFlags.messageId = flags.messageId;\n353\t      return runMessagesReport(threadRefFrom(flags), reportFlags);\n354\t    }\n355\t    case \"messages requeue\": {\n356\t      const missingRef = requireThreadRef(flags, \"messages requeue\");\n357\t      if (missingRef !== undefined) return missingRef;\n358\t      if (flags.messageId === undefined || flags.form === undefined) {\n359\t        return renderCliError(\n360\t          \"caller_error\",\n361\t          \"missing_flag\",\n362\t          \"messages requeue requires --message-id and --form\",\n363\t        );\n364\t      }\n365\t      return runMessagesRequeue(threadRefFrom(flags), {\n366\t        messageId: flags.messageId,\n367\t        form: flags.form,\n368\t      });\n369\t    }\n370\t    case \"messages edit\": {\n371\t      const missingRef = requireThreadRef(flags, \"messages edit\");\n372\t      if (missingRef !== undefined) return missingRef;\n373\t      if (flags.messageId === undefined || flags.content === undefined) {\n374\t        return renderCliError(\n375\t          \"caller_error\",\n376\t          \"missing_flag\",\n377\t          \"messages edit requires --message (or --message-id) and --content\",\n378\t        );\n379\t      }\n380\t      return runMessagesEdit(threadRefFrom(flags), {\n381\t        messageId: flags.messageId,\n382\t        content: flags.content,\n383\t      });\n384\t    }\n385\t    case \"messages delete\": {\n386\t      const missingRef = requireThreadRef(flags, \"messages delete\");\n387\t      if (missingRef !== undefined) return missingRef;\n388\t      if (flags.messageId === undefined) {\n389\t        return renderCliError(\n390\t          \"caller_error\",\n391\t          \"missing_flag\",\n392\t          \"messages delete requires --message (or --message-id)\",\n393\t        );\n394\t      }\n395\t      return runMessagesDelete(threadRefFrom(flags), { messageId: flags.messageId });\n396\t    }\n397\t    case \"turns list\":\n398\t      return (\n399\t        requireThreadRef(flags, \"turns list\") ??\n400\t        renderResult(await turns.listTurns(threadRefFrom(flags)))\n401\t      );\n402\t    case \"turns list-chunks\":\n403\t      return (\n404\t        requireThreadRef(flags, \"turns list-chunks\") ??\n405\t        renderResult(await turns.listChunks(threadRefFrom(flags)))\n406\t      );\n407\t    case \"turns list-queued-work\":\n408\t      return (\n409\t        requireThreadRef(flags, \"turns list-queued-work\") ??\n410\t        renderResult(await turns.listQueuedWork(threadRefFrom(flags)))\n411\t      );\n412\t    case \"turns report\": {\n413\t      const missingRef = requireThreadRef(flags, \"turns report\");\n414\t      if (missingRef !== undefined) return missingRef;\n415\t      const reportFlags: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n416\t      if (flags.notReady === true) reportFlags.notReady = true;\n417\t      if (flags.turnId !== undefined) reportFlags.turnId = flags.turnId;\n418\t      if (flags.chunkId !== undefined) reportFlags.chunkId = flags.chunkId;\n419\t      return runTurnsReport(threadRefFrom(flags), reportFlags);\n420\t    }\n421\t    case \"turns requeue\": {\n422\t      const missingRef = requireThreadRef(flags, \"turns requeue\");\n423\t      if (missingRef !== undefined) return missingRef;\n424\t      if (\n425\t        flags.subjectKind === undefined ||\n426\t        flags.subjectId === undefined ||\n427\t        flags.form === undefined\n428\t      ) {\n429\t        return renderCliError(\n430\t          \"caller_error\",\n431\t          \"missing_flag\",\n432\t          \"turns requeue requires --subject-kind, --subject-id, and --form\",\n433\t        );\n434\t      }\n435\t      if (flags.subjectKind !== \"turn\" && flags.subjectKind !== \"chunk\") {\n436\t        return renderCliError(\n437\t          \"caller_error\",\n438\t          \"missing_flag\",\n439\t          `--subject-kind must be \"turn\" or \"chunk\", got ${flags.subjectKind}`,\n440\t        );\n441\t      }\n442\t      return runTurnsRequeue(threadRefFrom(flags), {\n443\t        subjectKind: flags.subjectKind,\n444\t        subjectId: flags.subjectId,\n445\t        form: flags.form,\n446\t      });\n447\t    }\n448\t    case \"turns delete\": {\n449\t      const missingRef = requireThreadRef(flags, \"turns delete\");\n450\t      if (missingRef !== undefined) return missingRef;\n451\t      if (flags.turnId === undefined) {\n452\t        return renderCliError(\n453\t          \"caller_error\",\n454\t          \"missing_flag\",\n455\t          \"turns delete requires --turn (or --turn-id)\",\n456\t        );\n457\t      }\n458\t      return runTurnsDelete(threadRefFrom(flags), { turnId: flags.turnId });\n459\t    }\n460\t    case \"work drain\": {\n461\t      const missingRef = requireThreadRef(flags, \"work drain\");\n462\t      if (missingRef !== undefined) return missingRef;\n463\t      const drainFlags: { provider?: string; maxItems?: number } = {};\n464\t      if (flags.provider !== undefined) drainFlags.provider = flags.provider;\n465\t      if (flags.maxItems !== undefined) {\n466\t        const maxItems = Number(flags.maxItems);\n467\t        if (!Number.isInteger(maxItems) || maxItems <= 0) {\n468\t          return renderCliError(\n469\t            \"caller_error\",\n470\t            \"missing_flag\",\n471\t            `--max-items must be a positive integer, got ${flags.maxItems}`,\n472\t          );\n473\t        }\n474\t        drainFlags.maxItems = maxItems;\n475\t      }\n476\t      return runWorkDrain(threadRefFrom(flags), drainFlags);\n477\t    }\n478\t    default:\n479\t      return renderCliError(\n480\t        \"caller_error\",\n481\t        \"unknown_command\",\n482\t        `unknown command: ${key}; run lhc --help`,\n483\t      );\n484\t  }\n485\t}\n486\t"}]},"parent_tool_use_id":null,"session_id":"129e29ba-fc2e-4a7e-aec1-ad68e0f0dc1b","uuid":"971e90ae-9c1d-43c5-add7-1a18c6ae1504","timestamp":"2026-06-12T14:14:39.286Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/cli/index.ts","content":"import { parseArgs } from \"node:util\";\nimport * as intakeStream from \"../domains/intake-stream/index.js\";\nimport * as messages from \"../domains/messages/index.js\";\nimport * as threads from \"../domains/threads/index.js\";\nimport * as turns from \"../domains/turns/index.js\";\nimport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\nimport type { ThreadRef } from \"../domains/threads/index.js\";\nimport type { OpResult } from \"../shared/errors.js\";\nimport { renderCliError, renderResult, type CliResult } from \"./render.js\";\nimport { runMessagesDelete, runMessagesEdit } from \"./messages-mutate.js\";\nimport { runMessagesList, runMessagesShow } from \"./messages-read.js\";\nimport { runTurnsDelete } from \"./turns-mutate.js\";\nimport {\n  runMessagesReport,\n  runMessagesRequeue,\n  runTurnsReport,\n  runTurnsRequeue,\n  runWorkDrain,\n} from \"./work.js\";\nimport { runViewCommand } from \"./view.js\";\n\n// Stdin seam: in-process tests inject a reader; the binary reads the real\n// process stdin. null means interactive (TTY) — distinct from empty input\n// only in how it arises; both are refused with empty_stdin before any SDK\n// call (the SDK itself can never return that code).\nexport type StdinReader = () => Promise<string | null>;\n\nasync function readProcessStdin(): Promise<string | null> {\n  if (process.stdin.isTTY) return null;\n  process.stdin.setEncoding(\"utf8\");\n  let data = \"\";\n  for await (const chunk of process.stdin) data += String(chunk);\n  return data;\n}\n\nfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n}\n\nconst HELP = `lhc — Long Horizon Context CLI\n\nUsage:\n  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n  lhc threads resolve --thread-id <id> [--registry <r>]\n  lhc threads list [--registry <r>]\n  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc messages list (--thread-id <id> | --file-path <p>) [--from <n>] [--to <n>]\n                    [--limit <n>] [--include-deleted] [--registry <r>]\n  lhc messages show (--thread-id <id> | --file-path <p>) --message-id <id> [--registry <r>]\n  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc messages report (--thread-id <id> | --file-path <p>) [--not-ready] [--message-id <id>] [--registry <r>]\n  lhc messages requeue (--thread-id <id> | --file-path <p>) --message-id <id> --form <form> [--registry <r>]\n  lhc messages edit (--thread-id <id> | --file-path <p>) --message <id> --content <text> [--registry <r>]\n  lhc messages delete (--thread-id <id> | --file-path <p>) --message <id> [--registry <r>]\n  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns list-chunks (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n  lhc turns report (--thread-id <id> | --file-path <p>) [--not-ready] [--turn-id <id>] [--chunk-id <id>] [--registry <r>]\n  lhc turns requeue (--thread-id <id> | --file-path <p>) --subject-kind (turn|chunk) --subject-id <id> --form <form> [--registry <r>]\n  lhc turns delete (--thread-id <id> | --file-path <p>) --turn <id> [--registry <r>]\n  lhc work drain (--thread-id <id> | --file-path <p>) [--max-items <n>] [--provider <name>] [--registry <r>]\n  lhc view pull (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n  lhc view status (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n  lhc view compact (--thread-id <id> | --file-path <p>) [--profile <name>]\n                   [--lower-bound <n>] [--full <n>] [--smooth <n>] [--detailed <n>] [--brief <n>]\n                   [--no-sweep] [--json] [--registry <r>]\n  lhc view sweep (--thread-id <id> | --file-path <p>) [--json] [--registry <r>]\n  lhc view materialize (--thread-id <id> | --file-path <p>) --out <path> [--format pi-session] [--registry <r>]\n\nEvery command prints the SDK result (value or error) as JSON and exits 0 on\nsuccess, 1 on failure. message-events reads an events JSON array on stdin.\nView commands need no provider; output is always JSON (--json accepted).\nTwo exceptions on success: view pull prints the message array itself, and\nview materialize prints the written path; their failures stay structured.\n`;\n\ninterface ParsedFlags {\n  threadId?: string;\n  filePath?: string;\n  title?: string;\n  registryPath?: string;\n  maxItems?: string;\n  provider?: string;\n  notReady?: boolean;\n  messageId?: string;\n  turnId?: string;\n  chunkId?: string;\n  form?: string;\n  subjectKind?: string;\n  subjectId?: string;\n  content?: string;\n  from?: string;\n  to?: string;\n  limit?: string;\n  includeDeleted?: boolean;\n}\n\n// strict parse rejects unknown/misspelled flags so they are named back to the\n// caller, never silently dropped — the CLI boundary matching the SDK's\n// closed-contract strictness. The failure is returned as data (not thrown) so\n// runCli can render it as the structured usage error.\ntype ParseFlagsResult =\n  | { ok: true; flags: ParsedFlags }\n  | { ok: false; unknownFlag: string };\n\nfunction parseFlags(args: readonly string[]): ParseFlagsResult {\n  let values;\n  try {\n    ({ values } = parseArgs({\n      args: [...args],\n      options: {\n        \"thread-id\": { type: \"string\" },\n        \"file-path\": { type: \"string\" },\n        title: { type: \"string\" },\n        registry: { type: \"string\" },\n        \"max-items\": { type: \"string\" },\n        provider: { type: \"string\" },\n        \"not-ready\": { type: \"boolean\" },\n        \"message-id\": { type: \"string\" },\n        \"turn-id\": { type: \"string\" },\n        \"chunk-id\": { type: \"string\" },\n        form: { type: \"string\" },\n        \"subject-kind\": { type: \"string\" },\n        \"subject-id\": { type: \"string\" },\n        // `--message` / `--turn` are the mutation commands' spellings\n        // (story/tech design); they parse into the same slots as\n        // `--message-id` / `--turn-id`.\n        message: { type: \"string\" },\n        turn: { type: \"string\" },\n        content: { type: \"string\" },\n        // Epic 04 Story 1: the bounded-listing options (lhc messages list).\n        from: { type: \"string\" },\n        to: { type: \"string\" },\n        limit: { type: \"string\" },\n        \"include-deleted\": { type: \"boolean\" },\n      },\n      strict: true,\n      allowPositionals: true,\n    }));\n  } catch (cause) {\n    const message = cause instanceof Error ? cause.message : String(cause);\n    // parseArgs names the offending option in single quotes (e.g. Unknown\n    // option '--file-pth'); surface that token, falling back to the message.\n    const named = /'([^']+)'/.exec(message);\n    return { ok: false, unknownFlag: named?.[1] ?? message };\n  }\n  const flags: ParsedFlags = {};\n  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n  if (typeof values.title === \"string\") flags.title = values.title;\n  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n  if (typeof values.provider === \"string\") flags.provider = values.provider;\n  if (values[\"not-ready\"] === true) flags.notReady = true;\n  if (typeof values[\"message-id\"] === \"string\") flags.messageId = values[\"message-id\"];\n  if (typeof values.message === \"string\") flags.messageId = values.message;\n  if (typeof values.content === \"string\") flags.content = values.content;\n  if (typeof values[\"turn-id\"] === \"string\") flags.turnId = values[\"turn-id\"];\n  if (typeof values.turn === \"string\") flags.turnId = values.turn;\n  if (typeof values[\"chunk-id\"] === \"string\") flags.chunkId = values[\"chunk-id\"];\n  if (typeof values.form === \"string\") flags.form = values.form;\n  if (typeof values[\"subject-kind\"] === \"string\") flags.subjectKind = values[\"subject-kind\"];\n  if (typeof values[\"subject-id\"] === \"string\") flags.subjectId = values[\"subject-id\"];\n  if (typeof values.from === \"string\") flags.from = values.from;\n  if (typeof values.to === \"string\") flags.to = values.to;\n  if (typeof values.limit === \"string\") flags.limit = values.limit;\n  if (values[\"include-deleted\"] === true) flags.includeDeleted = true;\n  return { ok: true, flags };\n}\n\n// The read commands take a thread reference but no stdin; a missing reference\n// is a usage error named before any SDK call, matching the intake commands.\nfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n  if (flags.threadId === undefined && flags.filePath === undefined) {\n    return renderCliError(\n      \"caller_error\",\n      \"missing_flag\",\n      `${command} requires --thread-id or --file-path`,\n    );\n  }\n  return undefined;\n}\n\nfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n  if (flags.threadId !== undefined) {\n    return flags.registryPath !== undefined\n      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n      : { threadId: flags.threadId };\n  }\n  return { filePath: flags.filePath ?? \"\" };\n}\n\nexport async function runCli(\n  argv: readonly string[],\n  readStdin: StdinReader = readProcessStdin,\n): Promise<CliResult> {\n  if (argv.length === 0) {\n    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n  }\n  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n    return { exitCode: 0, stdout: HELP, stderr: \"\" };\n  }\n\n  const [group, command, ...rest] = argv;\n  // The view group parses its own flag surface (band overrides, --out,\n  // --format) — routed before the shared parse so its flags never widen the\n  // other commands' accepted set.\n  if (group === \"view\") {\n    return runViewCommand(command, rest);\n  }\n  const key = command === undefined ? group : `${group} ${command}`;\n  const parsed = parseFlags(command === undefined ? [] : rest);\n  if (!parsed.ok) {\n    return renderCliError(\n      \"caller_error\",\n      \"unknown_flag\",\n      `unknown flag: ${parsed.unknownFlag}; run lhc --help`,\n    );\n  }\n  const flags = parsed.flags;\n\n  switch (key) {\n    case \"threads new-thread\": {\n      // Guard here: an empty path reaching node:sqlite opens a temp database\n      // instead of failing, so the adapter refuses before any SDK call.\n      if (flags.filePath === undefined) {\n        return renderCliError(\"caller_error\", \"missing_flag\", \"threads new-thread requires --file-path\");\n      }\n      const input: Parameters<typeof threads.newThread>[0] = {\n        filePath: flags.filePath,\n      };\n      if (flags.title !== undefined) input.title = flags.title;\n      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n      return renderResult(await threads.newThread(input));\n    }\n    case \"threads resolve\": {\n      if (flags.threadId === undefined) {\n        return renderCliError(\"caller_error\", \"missing_flag\", \"threads resolve requires --thread-id\");\n      }\n      const input: Parameters<typeof threads.resolve>[0] = {\n        threadId: flags.threadId,\n      };\n      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n      return renderResult(await threads.resolve(input));\n    }\n    case \"threads list\": {\n      return renderResult(\n        await threads.listThreads(\n          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n        ),\n      );\n    }\n    case \"intake-stream message-events\": {\n      if (flags.threadId === undefined && flags.filePath === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"intake-stream message-events requires --thread-id or --file-path\",\n        );\n      }\n      const text = await readStdin();\n      if (text === null || text.trim() === \"\") {\n        return renderResult(\n          stdinCallerError(\n            \"empty_stdin\",\n            \"message-events expects an events JSON array on stdin; stdin was a TTY or empty\",\n          ),\n        );\n      }\n      let parsed: unknown;\n      try {\n        parsed = JSON.parse(text);\n      } catch (cause) {\n        const detail = cause instanceof Error ? cause.message : String(cause);\n        return renderResult(\n          stdinCallerError(\"invalid_event\", `stdin is not valid JSON: ${detail}`),\n        );\n      }\n      if (!Array.isArray(parsed)) {\n        return renderResult(\n          stdinCallerError(\"invalid_event\", \"stdin must be a JSON array of events\"),\n        );\n      }\n      return renderResult(\n        await intakeStream.messageEvents(\n          threadRefFrom(flags),\n          parsed as readonly MessageEventInput[],\n        ),\n      );\n    }\n    case \"intake-stream list-events\": {\n      if (flags.threadId === undefined && flags.filePath === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"intake-stream list-events requires --thread-id or --file-path\",\n        );\n      }\n      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n    }\n    case \"messages list\": {\n      const missingRef = requireThreadRef(flags, \"messages list\");\n      if (missingRef !== undefined) return missingRef;\n      // Numeric flags convert here (the argv boundary); semantic bounds\n      // checks (from > to, limit < 1) stay in the SDK so refusal JSON has\n      // CLI/SDK parity.\n      const listOpts: { from?: number; to?: number; limit?: number; includeDeleted?: boolean } =\n        {};\n      if (flags.includeDeleted === true) listOpts.includeDeleted = true;\n      const numericFlags = [\n        [\"from\", flags.from],\n        [\"to\", flags.to],\n        [\"limit\", flags.limit],\n      ] as const;\n      for (const [name, raw] of numericFlags) {\n        if (raw === undefined) continue;\n        const value = Number(raw);\n        if (!Number.isInteger(value)) {\n          return renderCliError(\n            \"caller_error\",\n            \"missing_flag\",\n            `--${name} must be an integer, got ${raw}`,\n          );\n        }\n        listOpts[name] = value;\n      }\n      return runMessagesList(threadRefFrom(flags), listOpts);\n    }\n    case \"messages show\": {\n      const missingRef = requireThreadRef(flags, \"messages show\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.messageId === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"messages show requires --message-id\",\n        );\n      }\n      return runMessagesShow(threadRefFrom(flags), { messageId: flags.messageId });\n    }\n    case \"messages list-queued-work\":\n      return (\n        requireThreadRef(flags, \"messages list-queued-work\") ??\n        renderResult(await messages.listQueuedWork(threadRefFrom(flags)))\n      );\n    case \"messages report\": {\n      const missingRef = requireThreadRef(flags, \"messages report\");\n      if (missingRef !== undefined) return missingRef;\n      const reportFlags: { notReady?: boolean; messageId?: string } = {};\n      if (flags.notReady === true) reportFlags.notReady = true;\n      if (flags.messageId !== undefined) reportFlags.messageId = flags.messageId;\n      return runMessagesReport(threadRefFrom(flags), reportFlags);\n    }\n    case \"messages requeue\": {\n      const missingRef = requireThreadRef(flags, \"messages requeue\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.messageId === undefined || flags.form === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"messages requeue requires --message-id and --form\",\n        );\n      }\n      return runMessagesRequeue(threadRefFrom(flags), {\n        messageId: flags.messageId,\n        form: flags.form,\n      });\n    }\n    case \"messages edit\": {\n      const missingRef = requireThreadRef(flags, \"messages edit\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.messageId === undefined || flags.content === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"messages edit requires --message (or --message-id) and --content\",\n        );\n      }\n      return runMessagesEdit(threadRefFrom(flags), {\n        messageId: flags.messageId,\n        content: flags.content,\n      });\n    }\n    case \"messages delete\": {\n      const missingRef = requireThreadRef(flags, \"messages delete\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.messageId === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"messages delete requires --message (or --message-id)\",\n        );\n      }\n      return runMessagesDelete(threadRefFrom(flags), { messageId: flags.messageId });\n    }\n    case \"turns list\":\n      return (\n        requireThreadRef(flags, \"turns list\") ??\n        renderResult(await turns.listTurns(threadRefFrom(flags)))\n      );\n    case \"turns list-chunks\":\n      return (\n        requireThreadRef(flags, \"turns list-chunks\") ??\n        renderResult(await turns.listChunks(threadRefFrom(flags)))\n      );\n    case \"turns list-queued-work\":\n      return (\n        requireThreadRef(flags, \"turns list-queued-work\") ??\n        renderResult(await turns.listQueuedWork(threadRefFrom(flags)))\n      );\n    case \"turns report\": {\n      const missingRef = requireThreadRef(flags, \"turns report\");\n      if (missingRef !== undefined) return missingRef;\n      const reportFlags: { notReady?: boolean; turnId?: string; chunkId?: string } = {};\n      if (flags.notReady === true) reportFlags.notReady = true;\n      if (flags.turnId !== undefined) reportFlags.turnId = flags.turnId;\n      if (flags.chunkId !== undefined) reportFlags.chunkId = flags.chunkId;\n      return runTurnsReport(threadRefFrom(flags), reportFlags);\n    }\n    case \"turns requeue\": {\n      const missingRef = requireThreadRef(flags, \"turns requeue\");\n      if (missingRef !== undefined) return missingRef;\n      if (\n        flags.subjectKind === undefined ||\n        flags.subjectId === undefined ||\n        flags.form === undefined\n      ) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"turns requeue requires --subject-kind, --subject-id, and --form\",\n        );\n      }\n      if (flags.subjectKind !== \"turn\" && flags.subjectKind !== \"chunk\") {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          `--subject-kind must be \"turn\" or \"chunk\", got ${flags.subjectKind}`,\n        );\n      }\n      return runTurnsRequeue(threadRefFrom(flags), {\n        subjectKind: flags.subjectKind,\n        subjectId: flags.subjectId,\n        form: flags.form,\n      });\n    }\n    case \"turns delete\": {\n      const missingRef = requireThreadRef(flags, \"turns delete\");\n      if (missingRef !== undefined) return missingRef;\n      if (flags.turnId === undefined) {\n        return renderCliError(\n          \"caller_error\",\n          \"missing_flag\",\n          \"turns delete requires --turn (or --turn-id)\",\n        );\n      }\n      return runTurnsDelete(threadRefFrom(flags), { turnId: flags.turnId });\n    }\n    case \"work drain\": {\n      const missingRef = requireThreadRef(flags, \"work drain\");\n      if (missingRef !== undefined) return missingRef;\n      const drainFlags: { provider?: string; maxItems?: number } = {};\n      if (flags.provider !== undefined) drainFlags.provider = flags.provider;\n      if (flags.maxItems !== undefined) {\n        const maxItems = Number(flags.maxItems);\n        if (!Number.isInteger(maxItems) || maxItems <= 0) {\n          return renderCliError(\n            \"caller_error\",\n            \"missing_flag\",\n            `--max-items must be a positive integer, got ${flags.maxItems}`,\n          );\n        }\n        drainFlags.maxItems = maxItems;\n      }\n      return runWorkDrain(threadRefFrom(flags), drainFlags);\n    }\n    default:\n      return renderCliError(\n        \"caller_error\",\n        \"unknown_command\",\n        `unknown command: ${key}; run lhc --help`,\n      );\n  }\n}\n","numLines":486,"startLine":1,"totalLines":486}}}

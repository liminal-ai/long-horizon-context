{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HuoJXvhJ4ugCpA6KHk8uMk","type":"tool_result","content":"1\t// thread-view surface (Epic 03): pull, status, compact, sweep, materialize.\n2\t// Story 1 landed the hot-path reads (`pull`, `status`): local reads and\n3\t// deterministic string assembly only, no inference, no network, no queue\n4\t// interaction, no writes (AC-1.1, AC-2.8). Story 2 landed `compact`;\n5\t// Story 3 landed `sweep` (standalone and embedded default-on in compact);\n6\t// Story 5 lands `materialize` (the PI session-file render target over the\n7\t// same pull assembly). Story 0's substrate (profile resolution, consumed by\n8\t// createSdk) re-exports at the bottom.\n9\timport { existsSync } from \"node:fs\";\n10\timport * as path from \"node:path\";\n11\timport {\n12\t  resolveInstanceViewConfig,\n13\t  runWithThreadTouchSuppressed,\n14\t  type OperationContext,\n15\t} from \"../../shared/context.js\";\n16\timport type { FormReportEntry } from \"../../shared/derivation.js\";\n17\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n18\timport type {\n19\t  CompactReceipt,\n20\t  PullResult,\n21\t  ResolvedViewConfig,\n22\t  SweepReceipt,\n23\t  ViewCompactParams,\n24\t  ViewMessage,\n25\t  ViewProfile,\n26\t  ViewStatus,\n27\t} from \"../../shared/view.js\";\n28\timport * as messagesDomain from \"../messages/index.js\";\n29\timport * as turnsDomain from \"../turns/index.js\";\n30\timport {\n31\t  openThreadDatabase,\n32\t  resolveThreadRef,\n33\t  type ThreadRef,\n34\t} from \"../threads/index.js\";\n35\timport {\n36\t  executeBoundaryAdvance,\n37\t  readBoundaryPosition,\n38\t  visibilityZoneTokens,\n39\t} from \"./internal/boundary.js\";\n40\timport { profileViolation, resolveViewConfig } from \"./internal/profiles.js\";\n41\timport {\n42\t  assembleBandText,\n43\t  renderBandMessage,\n44\t  renderTailMessage,\n45\t  toolNamesByCallId,\n46\t} from \"./internal/render.js\";\n47\timport { fireViewInjection } from \"./internal/seam.js\";\n48\timport {\n49\t  CanonicalCorruptionError,\n50\t  readSelectionInputs,\n51\t  selectArrangement,\n52\t  type ArrangementEntry,\n53\t} from \"./internal/select.js\";\n54\timport { writePiSessionFile, type MaterializeInput } from \"./internal/materialize.js\";\n55\timport {\n56\t  readReadyToolResultSummaries,\n57\t  readTailMessages,\n58\t  readThreadMetadata,\n59\t  readViewSnapshot,\n60\t  replaceViewSnapshot,\n61\t  tailTokenSum,\n62\t} from \"./internal/snapshot.js\";\n63\timport { runSweep } from \"./internal/sweep.js\";\n64\timport { estimateTokens } from \"../../tech-utils/token-counting/index.js\";\n65\timport type { Band } from \"../../shared/view.js\";\n66\t\n67\t// Config resolution for the operation in hand: the SDK instance's resolved\n68\t// view config rides the per-instance seam (epic-fix-001 pattern, tech design\n69\t// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\n70\t// through the same one resolution path createSdk uses.\n71\tconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\n72\t\n73\tfunction viewConfig(): ResolvedViewConfig {\n74\t  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\n75\t}\n76\t\n77\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n78\t  return {\n79\t    ok: false,\n80\t    error: {\n81\t      errorClass: \"caller_error\",\n82\t      code: \"thread_not_found\",\n83\t      reason: `no thread file exists at ${filePath}`,\n84\t    },\n85\t  };\n86\t}\n87\t\n88\tfunction detail(cause: unknown): string {\n89\t  return cause instanceof Error ? cause.message : String(cause);\n90\t}\n91\t\n92\t// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\n93\t\n94\t// The hot-path read: view header + bands (if any), tail messages after the\n95\t// compact point (deleted-filtered, record order), boundary position; then\n96\t// format — band messages first, tail per the mapping table, tool results\n97\t// at-or-behind the boundary in short form. No view row ⇒ the whole record is\n98\t// tail from event 1 (AC-1.3) through this same code path with the compact\n99\t// point at its zero origin — snapshot-absent, never a separate branch.\n100\t//\n101\t// Reads-only is structural, not disciplined: the whole operation runs in the\n102\t// touch-suppressed scope, so the open announcement that would let a\n103\t// background SDK's scheduler hang a first-touch catch-up drain off this read\n104\t// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\n105\t// AC-1.1's no-queue-interaction holds in both host modes.\n106\texport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\n107\t  return runWithThreadTouchSuppressed(() => pullInner(ref));\n108\t}\n109\t\n110\t// The one assembly both render targets consume (Story 5): pull serves the\n111\t// messages; materialize serves the same entries with the metadata the file's\n112\t// generated fields derive from (entry ids, record-time timestamps). Sharing\n113\t// the array is what makes AC-5.3's parity structural — materialize cannot\n114\t// diverge from pull because there is no second assembly to diverge.\n115\tinterface AssembledView {\n116\t  entries: Array<{ message: ViewMessage; entryId: string; timestamp: string }>;\n117\t  meta: PullResult[\"meta\"];\n118\t  snapshot: ReturnType<typeof readViewSnapshot>;\n119\t}\n120\t\n121\tfunction assembleView(db: Parameters<typeof readViewSnapshot>[0]): AssembledView {\n122\t  const snapshot = readViewSnapshot(db);\n123\t  const compactPoint = snapshot?.compactPoint ?? 0;\n124\t  const boundaryPosition = readBoundaryPosition(db);\n125\t  const tailRows = readTailMessages(db, compactPoint);\n126\t  const renderCtx = {\n127\t    boundaryPosition,\n128\t    toolNameByCallId: toolNamesByCallId(tailRows),\n129\t    toolResultSummaries: readReadyToolResultSummaries(db),\n130\t  };\n131\t\n132\t  const entries: AssembledView[\"entries\"] = [];\n133\t  if (snapshot !== null) {\n134\t    for (const band of snapshot.bands) {\n135\t      entries.push({\n136\t        message: renderBandMessage(band.band, band.renderedText),\n137\t        // Band entries are not record messages; their generated fields\n138\t        // derive from view metadata (AC-5.2).\n139\t        entryId: `${snapshot.viewId}-${band.band}`,\n140\t        timestamp: snapshot.createdAt,\n141\t      });\n142\t    }\n143\t  }\n144\t  for (const row of tailRows) {\n145\t    entries.push({\n146\t      message: renderTailMessage(row, renderCtx),\n147\t      entryId: row.messageId,\n148\t      timestamp: row.recordedAt,\n149\t    });\n150\t  }\n151\t\n152\t  return {\n153\t    entries,\n154\t    meta: {\n155\t      compactPoint: snapshot?.compactPoint ?? null,\n156\t      coveredFrom: snapshot?.coveredFrom ?? null,\n157\t      boundaryPosition,\n158\t      gapCount: snapshot?.gapCount ?? 0,\n159\t      degradedCount: snapshot?.degradedCount ?? 0,\n160\t      viewId: snapshot?.viewId ?? null,\n161\t      createdAt: snapshot?.createdAt ?? null,\n162\t    },\n163\t    snapshot,\n164\t  };\n165\t}\n166\t\n167\tasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n168\t  const resolved = await resolveThreadRef(ref);\n169\t  if (!resolved.ok) return resolved;\n170\t  const { filePath } = resolved.value;\n171\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n172\t\n173\t  const opened = openThreadDatabase(filePath);\n174\t  if (!opened.ok) return opened;\n175\t  const db = opened.value;\n176\t  try {\n177\t    const assembled = assembleView(db);\n178\t    return {\n179\t      ok: true,\n180\t      value: {\n181\t        messages: assembled.entries.map((entry) => entry.message),\n182\t        meta: assembled.meta,\n183\t      },\n184\t    };\n185\t  } catch (cause) {\n186\t    return storageFailure(`view pull failed: ${detail(cause)}`);\n187\t  } finally {\n188\t    db.close();\n189\t  }\n190\t}\n191\t\n192\t// ── status (AC-2.8) ───────────────────────────────────────────────\n193\t\n194\t// Derivation counts bucket from one report entry the way the report's own\n195\t// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\n196\t// pending, retrying (pending with attempts spent), failed, blocked. Ready\n197\t// forms are healthy and not an operational situation.\n198\tfunction bucketDerivation(\n199\t  entries: readonly FormReportEntry[],\n200\t  counts: ViewStatus[\"derivation\"],\n201\t): void {\n202\t  for (const entry of entries) {\n203\t    switch (entry.state) {\n204\t      case \"pending\":\n205\t        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\n206\t        else counts.pending += 1;\n207\t        break;\n208\t      case \"failed\":\n209\t        counts.failed += 1;\n210\t        break;\n211\t      case \"blocked\":\n212\t        counts.blocked += 1;\n213\t        break;\n214\t      case \"ready\":\n215\t        break;\n216\t    }\n217\t  }\n218\t}\n219\t\n220\t// Reads only, callable any time, no side effects: tail size against the\n221\t// configured trigger threshold with a compact recommendation (`tailTokens >\n222\t// threshold`, nothing smarter — the caller owns policy), derivation counts\n223\t// by state read through the OWNERS' report surfaces (must-not-own: never a\n224\t// direct derived_form read here), the active view's health or null\n225\t// pre-compact, and the visibility zone's sum against its max — computed live\n226\t// by the same query the Story 4 advance will use, so \"visible in status\" is\n227\t// structural, not stored.\n228\t//\n229\t// Like pull, the whole read — including the owners' report surfaces it\n230\t// consumes — runs in the touch-suppressed scope, so a background SDK's\n231\t// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n232\t// host modes).\n233\texport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n234\t  return runWithThreadTouchSuppressed(() => statusInner(ref));\n235\t}\n236\t\n237\tasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n238\t  const resolved = await resolveThreadRef(ref);\n239\t  if (!resolved.ok) return resolved;\n240\t  const { filePath } = resolved.value;\n241\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n242\t\n243\t  const config = viewConfig();\n244\t  const opened = openThreadDatabase(filePath);\n245\t  if (!opened.ok) return opened;\n246\t  const db = opened.value;\n247\t  let tailTokens: number;\n248\t  let zoneTokens: number;\n249\t  let view: ViewStatus[\"view\"];\n250\t  try {\n251\t    const snapshot = readViewSnapshot(db);\n252\t    const compactPoint = snapshot?.compactPoint ?? 0;\n253\t    const boundaryPosition = readBoundaryPosition(db);\n254\t    tailTokens = tailTokenSum(db, compactPoint);\n255\t    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n256\t    view =\n257\t      snapshot === null\n258\t        ? null\n259\t        : {\n260\t            degraded: snapshot.degradedCount,\n261\t            gaps: snapshot.gapCount,\n262\t            builtAt: snapshot.createdAt,\n263\t          };\n264\t  } catch (cause) {\n265\t    return storageFailure(`view status failed: ${detail(cause)}`);\n266\t  } finally {\n267\t    db.close();\n268\t  }\n269\t\n270\t  // The owners' report surfaces open their own handles; ours is closed first\n271\t  // so the status read never holds two handles on one thread file.\n272\t  const messageReport = await messagesDomain.report({ filePath });\n273\t  if (!messageReport.ok) return messageReport;\n274\t  const turnReport = await turnsDomain.report({ filePath });\n275\t  if (!turnReport.ok) return turnReport;\n276\t  const derivation: ViewStatus[\"derivation\"] = {\n277\t    pending: 0,\n278\t    retrying: 0,\n279\t    failed: 0,\n280\t    blocked: 0,\n281\t  };\n282\t  bucketDerivation(messageReport.value, derivation);\n283\t  bucketDerivation(turnReport.value, derivation);\n284\t\n285\t  return {\n286\t    ok: true,\n287\t    value: {\n288\t      tailTokens,\n289\t      threshold: config.compactThreshold,\n290\t      compactRecommended: tailTokens > config.compactThreshold,\n291\t      derivation,\n292\t      view,\n293\t      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\n294\t    },\n295\t  };\n296\t}\n297\t\n298\t// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\n299\t\n300\t// The default base when no profile is named: the first built-in, matching\n301\t// the epic's primary user (the PI continuation harness). Explicit params\n302\t// override the base field-wise (AC-2.2).\n303\tconst DEFAULT_PROFILE_NAME = \"continuation\";\n304\t\n305\tfunction callerError(\n306\t  code: \"unknown_profile\" | \"invalid_view_config\",\n307\t  reason: string,\n308\t): { ok: false; error: ErrorResult } {\n309\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n310\t}\n311\t\n312\tconst BAND_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n313\t\n314\t// Compact runs only when invoked through this surface (AC-2.1: no code path\n315\t// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\n316\t// rejection provably touches nothing) → sweep, on by default, `sweep: false`\n317\t// skips (AC-3.6; the receipt records which) → read record + forms with the\n318\t// corruption check in the reads (pre-transaction, prior view trivially\n319\t// intact on refusal) → selection walk → band rendering → one BEGIN\n320\t// IMMEDIATE replacing the view and resetting the boundary → receipt.\n321\t// Assembly is entirely from stored artifacts: nothing here can reach a\n322\t// provider (AC-2.4 zero-inference is structural — the sweep step repairs\n323\t// through owners' requeue surfaces and calls no provider either).\n324\texport async function compact(\n325\t  ref: ThreadRef,\n326\t  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n327\t): Promise<OpResult<CompactReceipt>> {\n328\t  const resolved = await resolveThreadRef(ref);\n329\t  if (!resolved.ok) return resolved;\n330\t  const { filePath } = resolved.value;\n331\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n332\t\n333\t  const config = viewConfig();\n334\t  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\n335\t  const base = config.profiles[baseName];\n336\t  if (base === undefined) {\n337\t    return callerError(\n338\t      \"unknown_profile\",\n339\t      `unknown profile \"${baseName}\"; configured profiles are ${Object.keys(config.profiles)\n340\t        .map((name) => `\"${name}\"`)\n341\t        .join(\", \")}`,\n342\t    );\n343\t  }\n344\t  const merged: ViewProfile = {\n345\t    name: base.name,\n346\t    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\n347\t    percentages: { ...base.percentages, ...opts.params?.percentages },\n348\t  };\n349\t  const violation = profileViolation(merged);\n350\t  if (violation !== null) return callerError(\"invalid_view_config\", violation);\n351\t  // Receipt provenance: \"null when explicit params\" (tech design §Storage) —\n352\t  // any param override means the config is no longer a named profile's mix,\n353\t  // even when one served as the merge base; the receipt's config carries the\n354\t  // resolved truth. A bare or profile-only call names its profile.\n355\t  const profileName = opts.params === undefined ? baseName : null;\n356\t\n357\t  // The sweep step (Flow 2 / Flow 3, AC-3.6): on by default so every compact\n358\t  // leaves the thread healthier than it found it; `sweep: false` skips with\n359\t  // the skip recorded in the receipt. Runs before this operation opens its\n360\t  // own handle (the owners' surfaces open theirs), and before any view\n361\t  // write — a sweep failure aborts the compact with the prior view intact.\n362\t  let sweepOutcome: SweepReceipt | { skipped: true };\n363\t  if (opts.sweep === false) {\n364\t    sweepOutcome = { skipped: true };\n365\t  } else {\n366\t    const swept = await runSweep(filePath);\n367\t    if (!swept.ok) return swept;\n368\t    sweepOutcome = swept.value;\n369\t  }\n370\t\n371\t  const opened = openThreadDatabase(filePath);\n372\t  if (!opened.ok) return opened;\n373\t  const db = opened.value;\n374\t  try {\n375\t    let inputs;\n376\t    try {\n377\t      inputs = readSelectionInputs(db);\n378\t    } catch (cause) {\n379\t      if (cause instanceof CanonicalCorruptionError) {\n380\t        // Pre-transaction refusal: nothing was written, the prior view and\n381\t        // the record are untouched (AC-2.5).\n382\t        return {\n383\t          ok: false,\n384\t          error: { errorClass: \"state_corruption\", code: cause.code, reason: cause.message },\n385\t        };\n386\t      }\n387\t      throw cause;\n388\t    }\n389\t    const selection = selectArrangement(inputs, {\n390\t      lowerBound: merged.lowerBound,\n391\t      percentages: merged.percentages,\n392\t    });\n393\t\n394\t    const entriesByBand = (band: Band): ArrangementEntry[] =>\n395\t      selection.entries.filter((entry) => entry.band === band);\n396\t    const bands = BAND_ORDER.flatMap((band) => {\n397\t      const entries = entriesByBand(band);\n398\t      if (entries.length === 0) return [];\n399\t      const renderedText = assembleBandText(entries.map((entry) => entry.text));\n400\t      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\n401\t    });\n402\t\n403\t    const createdAt = new Date().toISOString();\n404\t    // view_id is v<compact event order> — deterministic, and deliberately\n405\t    // reused by an intake-free recompact (tech design L395: do not \"fix\"\n406\t    // into a uniqueness scheme; the singleton row is replaced whole).\n407\t    const viewId = `v${inputs.maxEventOrder}`;\n408\t\n409\t    // Story-0 injection point: TC-2.4's crash between the sweep and the\n410\t    // view-write transaction. An installed hook's throw aborts here —\n411\t    // before BEGIN — so the previous view keeps serving.\n412\t    fireViewInjection(\"compact-write\");\n413\t\n414\t    replaceViewSnapshot(db, {\n415\t      viewId,\n416\t      createdAt,\n417\t      compactPoint: selection.compactPoint,\n418\t      coveredFrom: selection.coveredFrom,\n419\t      profileName,\n420\t      configJson: JSON.stringify({\n421\t        lowerBound: merged.lowerBound,\n422\t        percentages: merged.percentages,\n423\t      }),\n424\t      arrangementJson: JSON.stringify(\n425\t        selection.entries.map((entry) => ({\n426\t          band: entry.band,\n427\t          subjectKind: entry.subjectKind,\n428\t          subjectId: entry.subjectId,\n429\t          formUsed: entry.formUsed,\n430\t          degraded: entry.degraded,\n431\t        })),\n432\t      ),\n433\t      gapsJson: JSON.stringify(\n434\t        selection.entries\n435\t          .filter((entry) => entry.gap)\n436\t          .map((entry) => ({\n437\t            band: entry.band,\n438\t            subjectId: entry.subjectId,\n439\t            reason: entry.reason ?? \"unknown\",\n440\t          })),\n441\t      ),\n442\t      sourceStateJson: JSON.stringify({\n443\t        maxEventOrder: inputs.maxEventOrder,\n444\t        formCounts: inputs.formCounts,\n445\t      }),\n446\t      bands,\n447\t    });\n448\t\n449\t    const bandReport = {} as CompactReceipt[\"bands\"];\n450\t    for (const band of BAND_ORDER) {\n451\t      const stored = bands.find((row) => row.band === band);\n452\t      bandReport[band] = {\n453\t        entries: entriesByBand(band).length,\n454\t        tokens: stored?.tokenCount ?? 0,\n455\t      };\n456\t    }\n457\t    const tailTokens = tailTokenSum(db, selection.compactPoint);\n458\t    return {\n459\t      ok: true,\n460\t      value: {\n461\t        viewId,\n462\t        profile: profileName,\n463\t        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n464\t        bands: bandReport,\n465\t        tailTokens,\n466\t        // Actual assembled total vs the bound (target, not cap — AC-2.4).\n467\t        totalTokens:\n468\t          bandReport.brief.tokens +\n469\t          bandReport.detailed.tokens +\n470\t          bandReport.smooth.tokens +\n471\t          tailTokens,\n472\t        coveredFrom: selection.coveredFrom,\n473\t        compactPoint: selection.compactPoint,\n474\t        degraded: selection.entries\n475\t          .filter((entry) => entry.degraded)\n476\t          .map((entry) => ({\n477\t            band: entry.band,\n478\t            subjectId: entry.subjectId,\n479\t            usedForm: entry.formUsed,\n480\t          })),\n481\t        gaps: selection.entries\n482\t          .filter((entry) => entry.gap)\n483\t          .map((entry) => ({\n484\t            band: entry.band,\n485\t            subjectId: entry.subjectId,\n486\t            reason: entry.reason ?? \"unknown\",\n487\t          })),\n488\t        sweep: sweepOutcome,\n489\t      },\n490\t    };\n491\t  } catch (cause) {\n492\t    return storageFailure(`view compact failed: ${detail(cause)}`);\n493\t  } finally {\n494\t    db.close();\n495\t  }\n496\t}\n497\t\n498\t// ── sweep (Flow 3: AC-3.1–3.5, 3.7) ──────────────────────────────\n499\t\n500\t// The standalone readiness sweep: walk the owners' reports, requeue the\n501\t// transiently-failed forms through the owners' requeue surfaces, return the\n502\t// per-owner/kind receipt. The walk itself lives in internal/sweep.ts; the\n503\t// compact embeds the same walk (AC-3.6), so standalone and embedded receipts\n504\t// share one shape by construction (AC-3.7's SDK leg; the CLI leg rides\n505\t// Story 5's process suite). Returns without waiting on any queued work\n506\t// (AC-3.2): requeues are row writes; background mode's drain heals later.\n507\texport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\n508\t  const resolved = await resolveThreadRef(ref);\n509\t  if (!resolved.ok) return resolved;\n510\t  const { filePath } = resolved.value;\n511\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n512\t  try {\n513\t    return await runSweep(filePath);\n514\t  } catch (cause) {\n515\t    return storageFailure(`view sweep failed: ${detail(cause)}`);\n516\t  }\n517\t}\n518\t\n519\t// ── boundary advance (Flow 4: AC-4.3–4.6, 4.9) ───────────────────\n520\t\n521\t// The post-commit advance, Story 4. NOT a host operation: no public advance\n522\t// surface exists (story Anti-Shim Requirements) — the SDK's ThreadViewSurface\n523\t// carries only the five operations, and this function's one production caller\n524\t// is intake-stream's ctx.onCommit registration (the sanctioned\n525\t// intake→thread-view surface import, tech design §Module Boundaries). It\n526\t// runs at flush in BOTH host modes — unlike the queue poke it is cheap and\n527\t// deterministic, and a CLI intake must advance too or CLI-driven threads\n528\t// bloat. Budgets resolve through the per-instance seam exactly as the poke\n529\t// does (the flush runs synchronously inside the SDK operation's seam scope),\n530\t// falling back to the built-in defaults for direct domain calls.\n531\t//\n532\t// Synchronous and throw-permitted by contract: the registering site wraps it\n533\t// (catch + diagnose) so a failure never reaches intake's caller and never\n534\t// eats the queue poke; the boundary is then simply unchanged and the\n535\t// over-budget condition stays visible because status computes the same zone\n536\t// sum live (AC-4.9).\n537\texport function runPostCommitBoundaryAdvance(ctx: OperationContext): void {\n538\t  // Story-0 injection point (TC-4.6): fired before the advance computes; an\n539\t  // installed hook's throw stands in for an advance failure.\n540\t  fireViewInjection(\"post-commit-advance\");\n541\t  executeBoundaryAdvance(ctx.db, viewConfig().visibility, ctx.clock);\n542\t}\n543\t\n544\t// ── materialize (Flow 5: AC-5.2–5.5) ─────────────────────────────\n545\t\n546\t// PI session-file materialization: run the pull assembly internally, hand\n547\t// the same entry array to the JSONL writer, return the written path. No\n548\t// thread state changes (reads + a file write outside the thread file), and\n549\t// every generated field derives from view/record metadata, never write-time\n550\t// clocks — repeating after no thread changes produces a byte-identical file\n551\t// (AC-5.2). Parity with pull is by construction: one assembly, two shapes\n552\t// (AC-5.3). A never-compacted thread materializes its tail-only pull with\n553\t// the header timestamp from the thread's created-at (AC-5.4). Like pull,\n554\t// the whole operation runs touch-suppressed: a background SDK's materialize\n555\t// can never schedule a catch-up drain.\n556\texport async function materialize(\n557\t  ref: ThreadRef,\n558\t  opts: { path: string; format?: \"pi-session\" },\n559\t): Promise<OpResult<{ writtenPath: string }>> {\n560\t  return runWithThreadTouchSuppressed(() => materializeInner(ref, opts));\n561\t}\n562\t\n563\tasync function materializeInner(\n564\t  ref: ThreadRef,\n565\t  opts: { path: string; format?: \"pi-session\" },\n566\t): Promise<OpResult<{ writtenPath: string }>> {\n567\t  const format = opts.format ?? \"pi-session\";\n568\t  if (format !== \"pi-session\") {\n569\t    return {\n570\t      ok: false,\n571\t      error: {\n572\t        errorClass: \"caller_error\",\n573\t        code: \"unknown_format\",\n574\t        reason: `unknown materialize format \"${String(format)}\"; accepted formats are \"pi-session\"`,\n575\t      },\n576\t    };\n577\t  }\n578\t  const resolved = await resolveThreadRef(ref);\n579\t  if (!resolved.ok) return resolved;\n580\t  const { filePath } = resolved.value;\n581\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n582\t\n583\t  const opened = openThreadDatabase(filePath);\n584\t  if (!opened.ok) return opened;\n585\t  const db = opened.value;\n586\t  let input: MaterializeInput;\n587\t  try {\n588\t    const assembled = assembleView(db);\n589\t    const threadMeta = readThreadMetadata(db);\n590\t    input = {\n591\t      threadId: threadMeta.threadId,\n592\t      headerTimestamp: assembled.snapshot?.createdAt ?? threadMeta.createdAt,\n593\t      // Deterministic per thread file — never the writing process's cwd.\n594\t      cwd: path.dirname(path.resolve(filePath)),\n595\t      entries: assembled.entries,\n596\t    };\n597\t  } catch (cause) {\n598\t    return storageFailure(`view materialize failed: ${detail(cause)}`);\n599\t  } finally {\n600\t    db.close();\n601\t  }\n602\t  try {\n603\t    return { ok: true, value: writePiSessionFile(input, opts.path) };\n604\t  } catch (cause) {\n605\t    return storageFailure(\n606\t      `view materialize could not write ${opts.path}: ${detail(cause)}`,\n607\t    );\n608\t  }\n609\t}\n610\t\n611\t// ── Story 0 substrate (consumed by createSdk at construction) ─────\n612\texport {\n613\t  BUILT_IN_PROFILES,\n614\t  DEFAULT_COMPACT_THRESHOLD,\n615\t  DEFAULT_VISIBILITY,\n616\t  resolveViewConfig,\n617\t} from \"./internal/profiles.js\";\n618\t"}]},"parent_tool_use_id":null,"session_id":"129e29ba-fc2e-4a7e-aec1-ad68e0f0dc1b","uuid":"a3fc393a-ca47-4521-99f5-f4cbbe246cc5","timestamp":"2026-06-12T14:13:30.393Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/leemoore/code/pi-long-horizon/liminal-context/packages/lhc/src/domains/thread-view/index.ts","content":"// thread-view surface (Epic 03): pull, status, compact, sweep, materialize.\n// Story 1 landed the hot-path reads (`pull`, `status`): local reads and\n// deterministic string assembly only, no inference, no network, no queue\n// interaction, no writes (AC-1.1, AC-2.8). Story 2 landed `compact`;\n// Story 3 landed `sweep` (standalone and embedded default-on in compact);\n// Story 5 lands `materialize` (the PI session-file render target over the\n// same pull assembly). Story 0's substrate (profile resolution, consumed by\n// createSdk) re-exports at the bottom.\nimport { existsSync } from \"node:fs\";\nimport * as path from \"node:path\";\nimport {\n  resolveInstanceViewConfig,\n  runWithThreadTouchSuppressed,\n  type OperationContext,\n} from \"../../shared/context.js\";\nimport type { FormReportEntry } from \"../../shared/derivation.js\";\nimport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\nimport type {\n  CompactReceipt,\n  PullResult,\n  ResolvedViewConfig,\n  SweepReceipt,\n  ViewCompactParams,\n  ViewMessage,\n  ViewProfile,\n  ViewStatus,\n} from \"../../shared/view.js\";\nimport * as messagesDomain from \"../messages/index.js\";\nimport * as turnsDomain from \"../turns/index.js\";\nimport {\n  openThreadDatabase,\n  resolveThreadRef,\n  type ThreadRef,\n} from \"../threads/index.js\";\nimport {\n  executeBoundaryAdvance,\n  readBoundaryPosition,\n  visibilityZoneTokens,\n} from \"./internal/boundary.js\";\nimport { profileViolation, resolveViewConfig } from \"./internal/profiles.js\";\nimport {\n  assembleBandText,\n  renderBandMessage,\n  renderTailMessage,\n  toolNamesByCallId,\n} from \"./internal/render.js\";\nimport { fireViewInjection } from \"./internal/seam.js\";\nimport {\n  CanonicalCorruptionError,\n  readSelectionInputs,\n  selectArrangement,\n  type ArrangementEntry,\n} from \"./internal/select.js\";\nimport { writePiSessionFile, type MaterializeInput } from \"./internal/materialize.js\";\nimport {\n  readReadyToolResultSummaries,\n  readTailMessages,\n  readThreadMetadata,\n  readViewSnapshot,\n  replaceViewSnapshot,\n  tailTokenSum,\n} from \"./internal/snapshot.js\";\nimport { runSweep } from \"./internal/sweep.js\";\nimport { estimateTokens } from \"../../tech-utils/token-counting/index.js\";\nimport type { Band } from \"../../shared/view.js\";\n\n// Config resolution for the operation in hand: the SDK instance's resolved\n// view config rides the per-instance seam (epic-fix-001 pattern, tech design\n// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\n// through the same one resolution path createSdk uses.\nconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\n\nfunction viewConfig(): ResolvedViewConfig {\n  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\n}\n\nfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n  return {\n    ok: false,\n    error: {\n      errorClass: \"caller_error\",\n      code: \"thread_not_found\",\n      reason: `no thread file exists at ${filePath}`,\n    },\n  };\n}\n\nfunction detail(cause: unknown): string {\n  return cause instanceof Error ? cause.message : String(cause);\n}\n\n// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\n\n// The hot-path read: view header + bands (if any), tail messages after the\n// compact point (deleted-filtered, record order), boundary position; then\n// format — band messages first, tail per the mapping table, tool results\n// at-or-behind the boundary in short form. No view row ⇒ the whole record is\n// tail from event 1 (AC-1.3) through this same code path with the compact\n// point at its zero origin — snapshot-absent, never a separate branch.\n//\n// Reads-only is structural, not disciplined: the whole operation runs in the\n// touch-suppressed scope, so the open announcement that would let a\n// background SDK's scheduler hang a first-touch catch-up drain off this read\n// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\n// AC-1.1's no-queue-interaction holds in both host modes.\nexport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\n  return runWithThreadTouchSuppressed(() => pullInner(ref));\n}\n\n// The one assembly both render targets consume (Story 5): pull serves the\n// messages; materialize serves the same entries with the metadata the file's\n// generated fields derive from (entry ids, record-time timestamps). Sharing\n// the array is what makes AC-5.3's parity structural — materialize cannot\n// diverge from pull because there is no second assembly to diverge.\ninterface AssembledView {\n  entries: Array<{ message: ViewMessage; entryId: string; timestamp: string }>;\n  meta: PullResult[\"meta\"];\n  snapshot: ReturnType<typeof readViewSnapshot>;\n}\n\nfunction assembleView(db: Parameters<typeof readViewSnapshot>[0]): AssembledView {\n  const snapshot = readViewSnapshot(db);\n  const compactPoint = snapshot?.compactPoint ?? 0;\n  const boundaryPosition = readBoundaryPosition(db);\n  const tailRows = readTailMessages(db, compactPoint);\n  const renderCtx = {\n    boundaryPosition,\n    toolNameByCallId: toolNamesByCallId(tailRows),\n    toolResultSummaries: readReadyToolResultSummaries(db),\n  };\n\n  const entries: AssembledView[\"entries\"] = [];\n  if (snapshot !== null) {\n    for (const band of snapshot.bands) {\n      entries.push({\n        message: renderBandMessage(band.band, band.renderedText),\n        // Band entries are not record messages; their generated fields\n        // derive from view metadata (AC-5.2).\n        entryId: `${snapshot.viewId}-${band.band}`,\n        timestamp: snapshot.createdAt,\n      });\n    }\n  }\n  for (const row of tailRows) {\n    entries.push({\n      message: renderTailMessage(row, renderCtx),\n      entryId: row.messageId,\n      timestamp: row.recordedAt,\n    });\n  }\n\n  return {\n    entries,\n    meta: {\n      compactPoint: snapshot?.compactPoint ?? null,\n      coveredFrom: snapshot?.coveredFrom ?? null,\n      boundaryPosition,\n      gapCount: snapshot?.gapCount ?? 0,\n      degradedCount: snapshot?.degradedCount ?? 0,\n      viewId: snapshot?.viewId ?? null,\n      createdAt: snapshot?.createdAt ?? null,\n    },\n    snapshot,\n  };\n}\n\nasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    const assembled = assembleView(db);\n    return {\n      ok: true,\n      value: {\n        messages: assembled.entries.map((entry) => entry.message),\n        meta: assembled.meta,\n      },\n    };\n  } catch (cause) {\n    return storageFailure(`view pull failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── status (AC-2.8) ───────────────────────────────────────────────\n\n// Derivation counts bucket from one report entry the way the report's own\n// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\n// pending, retrying (pending with attempts spent), failed, blocked. Ready\n// forms are healthy and not an operational situation.\nfunction bucketDerivation(\n  entries: readonly FormReportEntry[],\n  counts: ViewStatus[\"derivation\"],\n): void {\n  for (const entry of entries) {\n    switch (entry.state) {\n      case \"pending\":\n        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\n        else counts.pending += 1;\n        break;\n      case \"failed\":\n        counts.failed += 1;\n        break;\n      case \"blocked\":\n        counts.blocked += 1;\n        break;\n      case \"ready\":\n        break;\n    }\n  }\n}\n\n// Reads only, callable any time, no side effects: tail size against the\n// configured trigger threshold with a compact recommendation (`tailTokens >\n// threshold`, nothing smarter — the caller owns policy), derivation counts\n// by state read through the OWNERS' report surfaces (must-not-own: never a\n// direct derived_form read here), the active view's health or null\n// pre-compact, and the visibility zone's sum against its max — computed live\n// by the same query the Story 4 advance will use, so \"visible in status\" is\n// structural, not stored.\n//\n// Like pull, the whole read — including the owners' report surfaces it\n// consumes — runs in the touch-suppressed scope, so a background SDK's\n// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n// host modes).\nexport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n  return runWithThreadTouchSuppressed(() => statusInner(ref));\n}\n\nasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const config = viewConfig();\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  let tailTokens: number;\n  let zoneTokens: number;\n  let view: ViewStatus[\"view\"];\n  try {\n    const snapshot = readViewSnapshot(db);\n    const compactPoint = snapshot?.compactPoint ?? 0;\n    const boundaryPosition = readBoundaryPosition(db);\n    tailTokens = tailTokenSum(db, compactPoint);\n    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n    view =\n      snapshot === null\n        ? null\n        : {\n            degraded: snapshot.degradedCount,\n            gaps: snapshot.gapCount,\n            builtAt: snapshot.createdAt,\n          };\n  } catch (cause) {\n    return storageFailure(`view status failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n\n  // The owners' report surfaces open their own handles; ours is closed first\n  // so the status read never holds two handles on one thread file.\n  const messageReport = await messagesDomain.report({ filePath });\n  if (!messageReport.ok) return messageReport;\n  const turnReport = await turnsDomain.report({ filePath });\n  if (!turnReport.ok) return turnReport;\n  const derivation: ViewStatus[\"derivation\"] = {\n    pending: 0,\n    retrying: 0,\n    failed: 0,\n    blocked: 0,\n  };\n  bucketDerivation(messageReport.value, derivation);\n  bucketDerivation(turnReport.value, derivation);\n\n  return {\n    ok: true,\n    value: {\n      tailTokens,\n      threshold: config.compactThreshold,\n      compactRecommended: tailTokens > config.compactThreshold,\n      derivation,\n      view,\n      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\n    },\n  };\n}\n\n// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\n\n// The default base when no profile is named: the first built-in, matching\n// the epic's primary user (the PI continuation harness). Explicit params\n// override the base field-wise (AC-2.2).\nconst DEFAULT_PROFILE_NAME = \"continuation\";\n\nfunction callerError(\n  code: \"unknown_profile\" | \"invalid_view_config\",\n  reason: string,\n): { ok: false; error: ErrorResult } {\n  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n}\n\nconst BAND_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n\n// Compact runs only when invoked through this surface (AC-2.1: no code path\n// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\n// rejection provably touches nothing) → sweep, on by default, `sweep: false`\n// skips (AC-3.6; the receipt records which) → read record + forms with the\n// corruption check in the reads (pre-transaction, prior view trivially\n// intact on refusal) → selection walk → band rendering → one BEGIN\n// IMMEDIATE replacing the view and resetting the boundary → receipt.\n// Assembly is entirely from stored artifacts: nothing here can reach a\n// provider (AC-2.4 zero-inference is structural — the sweep step repairs\n// through owners' requeue surfaces and calls no provider either).\nexport async function compact(\n  ref: ThreadRef,\n  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n): Promise<OpResult<CompactReceipt>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const config = viewConfig();\n  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\n  const base = config.profiles[baseName];\n  if (base === undefined) {\n    return callerError(\n      \"unknown_profile\",\n      `unknown profile \"${baseName}\"; configured profiles are ${Object.keys(config.profiles)\n        .map((name) => `\"${name}\"`)\n        .join(\", \")}`,\n    );\n  }\n  const merged: ViewProfile = {\n    name: base.name,\n    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\n    percentages: { ...base.percentages, ...opts.params?.percentages },\n  };\n  const violation = profileViolation(merged);\n  if (violation !== null) return callerError(\"invalid_view_config\", violation);\n  // Receipt provenance: \"null when explicit params\" (tech design §Storage) —\n  // any param override means the config is no longer a named profile's mix,\n  // even when one served as the merge base; the receipt's config carries the\n  // resolved truth. A bare or profile-only call names its profile.\n  const profileName = opts.params === undefined ? baseName : null;\n\n  // The sweep step (Flow 2 / Flow 3, AC-3.6): on by default so every compact\n  // leaves the thread healthier than it found it; `sweep: false` skips with\n  // the skip recorded in the receipt. Runs before this operation opens its\n  // own handle (the owners' surfaces open theirs), and before any view\n  // write — a sweep failure aborts the compact with the prior view intact.\n  let sweepOutcome: SweepReceipt | { skipped: true };\n  if (opts.sweep === false) {\n    sweepOutcome = { skipped: true };\n  } else {\n    const swept = await runSweep(filePath);\n    if (!swept.ok) return swept;\n    sweepOutcome = swept.value;\n  }\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  try {\n    let inputs;\n    try {\n      inputs = readSelectionInputs(db);\n    } catch (cause) {\n      if (cause instanceof CanonicalCorruptionError) {\n        // Pre-transaction refusal: nothing was written, the prior view and\n        // the record are untouched (AC-2.5).\n        return {\n          ok: false,\n          error: { errorClass: \"state_corruption\", code: cause.code, reason: cause.message },\n        };\n      }\n      throw cause;\n    }\n    const selection = selectArrangement(inputs, {\n      lowerBound: merged.lowerBound,\n      percentages: merged.percentages,\n    });\n\n    const entriesByBand = (band: Band): ArrangementEntry[] =>\n      selection.entries.filter((entry) => entry.band === band);\n    const bands = BAND_ORDER.flatMap((band) => {\n      const entries = entriesByBand(band);\n      if (entries.length === 0) return [];\n      const renderedText = assembleBandText(entries.map((entry) => entry.text));\n      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\n    });\n\n    const createdAt = new Date().toISOString();\n    // view_id is v<compact event order> — deterministic, and deliberately\n    // reused by an intake-free recompact (tech design L395: do not \"fix\"\n    // into a uniqueness scheme; the singleton row is replaced whole).\n    const viewId = `v${inputs.maxEventOrder}`;\n\n    // Story-0 injection point: TC-2.4's crash between the sweep and the\n    // view-write transaction. An installed hook's throw aborts here —\n    // before BEGIN — so the previous view keeps serving.\n    fireViewInjection(\"compact-write\");\n\n    replaceViewSnapshot(db, {\n      viewId,\n      createdAt,\n      compactPoint: selection.compactPoint,\n      coveredFrom: selection.coveredFrom,\n      profileName,\n      configJson: JSON.stringify({\n        lowerBound: merged.lowerBound,\n        percentages: merged.percentages,\n      }),\n      arrangementJson: JSON.stringify(\n        selection.entries.map((entry) => ({\n          band: entry.band,\n          subjectKind: entry.subjectKind,\n          subjectId: entry.subjectId,\n          formUsed: entry.formUsed,\n          degraded: entry.degraded,\n        })),\n      ),\n      gapsJson: JSON.stringify(\n        selection.entries\n          .filter((entry) => entry.gap)\n          .map((entry) => ({\n            band: entry.band,\n            subjectId: entry.subjectId,\n            reason: entry.reason ?? \"unknown\",\n          })),\n      ),\n      sourceStateJson: JSON.stringify({\n        maxEventOrder: inputs.maxEventOrder,\n        formCounts: inputs.formCounts,\n      }),\n      bands,\n    });\n\n    const bandReport = {} as CompactReceipt[\"bands\"];\n    for (const band of BAND_ORDER) {\n      const stored = bands.find((row) => row.band === band);\n      bandReport[band] = {\n        entries: entriesByBand(band).length,\n        tokens: stored?.tokenCount ?? 0,\n      };\n    }\n    const tailTokens = tailTokenSum(db, selection.compactPoint);\n    return {\n      ok: true,\n      value: {\n        viewId,\n        profile: profileName,\n        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n        bands: bandReport,\n        tailTokens,\n        // Actual assembled total vs the bound (target, not cap — AC-2.4).\n        totalTokens:\n          bandReport.brief.tokens +\n          bandReport.detailed.tokens +\n          bandReport.smooth.tokens +\n          tailTokens,\n        coveredFrom: selection.coveredFrom,\n        compactPoint: selection.compactPoint,\n        degraded: selection.entries\n          .filter((entry) => entry.degraded)\n          .map((entry) => ({\n            band: entry.band,\n            subjectId: entry.subjectId,\n            usedForm: entry.formUsed,\n          })),\n        gaps: selection.entries\n          .filter((entry) => entry.gap)\n          .map((entry) => ({\n            band: entry.band,\n            subjectId: entry.subjectId,\n            reason: entry.reason ?? \"unknown\",\n          })),\n        sweep: sweepOutcome,\n      },\n    };\n  } catch (cause) {\n    return storageFailure(`view compact failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n}\n\n// ── sweep (Flow 3: AC-3.1–3.5, 3.7) ──────────────────────────────\n\n// The standalone readiness sweep: walk the owners' reports, requeue the\n// transiently-failed forms through the owners' requeue surfaces, return the\n// per-owner/kind receipt. The walk itself lives in internal/sweep.ts; the\n// compact embeds the same walk (AC-3.6), so standalone and embedded receipts\n// share one shape by construction (AC-3.7's SDK leg; the CLI leg rides\n// Story 5's process suite). Returns without waiting on any queued work\n// (AC-3.2): requeues are row writes; background mode's drain heals later.\nexport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n  try {\n    return await runSweep(filePath);\n  } catch (cause) {\n    return storageFailure(`view sweep failed: ${detail(cause)}`);\n  }\n}\n\n// ── boundary advance (Flow 4: AC-4.3–4.6, 4.9) ───────────────────\n\n// The post-commit advance, Story 4. NOT a host operation: no public advance\n// surface exists (story Anti-Shim Requirements) — the SDK's ThreadViewSurface\n// carries only the five operations, and this function's one production caller\n// is intake-stream's ctx.onCommit registration (the sanctioned\n// intake→thread-view surface import, tech design §Module Boundaries). It\n// runs at flush in BOTH host modes — unlike the queue poke it is cheap and\n// deterministic, and a CLI intake must advance too or CLI-driven threads\n// bloat. Budgets resolve through the per-instance seam exactly as the poke\n// does (the flush runs synchronously inside the SDK operation's seam scope),\n// falling back to the built-in defaults for direct domain calls.\n//\n// Synchronous and throw-permitted by contract: the registering site wraps it\n// (catch + diagnose) so a failure never reaches intake's caller and never\n// eats the queue poke; the boundary is then simply unchanged and the\n// over-budget condition stays visible because status computes the same zone\n// sum live (AC-4.9).\nexport function runPostCommitBoundaryAdvance(ctx: OperationContext): void {\n  // Story-0 injection point (TC-4.6): fired before the advance computes; an\n  // installed hook's throw stands in for an advance failure.\n  fireViewInjection(\"post-commit-advance\");\n  executeBoundaryAdvance(ctx.db, viewConfig().visibility, ctx.clock);\n}\n\n// ── materialize (Flow 5: AC-5.2–5.5) ─────────────────────────────\n\n// PI session-file materialization: run the pull assembly internally, hand\n// the same entry array to the JSONL writer, return the written path. No\n// thread state changes (reads + a file write outside the thread file), and\n// every generated field derives from view/record metadata, never write-time\n// clocks — repeating after no thread changes produces a byte-identical file\n// (AC-5.2). Parity with pull is by construction: one assembly, two shapes\n// (AC-5.3). A never-compacted thread materializes its tail-only pull with\n// the header timestamp from the thread's created-at (AC-5.4). Like pull,\n// the whole operation runs touch-suppressed: a background SDK's materialize\n// can never schedule a catch-up drain.\nexport async function materialize(\n  ref: ThreadRef,\n  opts: { path: string; format?: \"pi-session\" },\n): Promise<OpResult<{ writtenPath: string }>> {\n  return runWithThreadTouchSuppressed(() => materializeInner(ref, opts));\n}\n\nasync function materializeInner(\n  ref: ThreadRef,\n  opts: { path: string; format?: \"pi-session\" },\n): Promise<OpResult<{ writtenPath: string }>> {\n  const format = opts.format ?? \"pi-session\";\n  if (format !== \"pi-session\") {\n    return {\n      ok: false,\n      error: {\n        errorClass: \"caller_error\",\n        code: \"unknown_format\",\n        reason: `unknown materialize format \"${String(format)}\"; accepted formats are \"pi-session\"`,\n      },\n    };\n  }\n  const resolved = await resolveThreadRef(ref);\n  if (!resolved.ok) return resolved;\n  const { filePath } = resolved.value;\n  if (!existsSync(filePath)) return threadNotFound(filePath);\n\n  const opened = openThreadDatabase(filePath);\n  if (!opened.ok) return opened;\n  const db = opened.value;\n  let input: MaterializeInput;\n  try {\n    const assembled = assembleView(db);\n    const threadMeta = readThreadMetadata(db);\n    input = {\n      threadId: threadMeta.threadId,\n      headerTimestamp: assembled.snapshot?.createdAt ?? threadMeta.createdAt,\n      // Deterministic per thread file — never the writing process's cwd.\n      cwd: path.dirname(path.resolve(filePath)),\n      entries: assembled.entries,\n    };\n  } catch (cause) {\n    return storageFailure(`view materialize failed: ${detail(cause)}`);\n  } finally {\n    db.close();\n  }\n  try {\n    return { ok: true, value: writePiSessionFile(input, opts.path) };\n  } catch (cause) {\n    return storageFailure(\n      `view materialize could not write ${opts.path}: ${detail(cause)}`,\n    );\n  }\n}\n\n// ── Story 0 substrate (consumed by createSdk at construction) ─────\nexport {\n  BUILT_IN_PROFILES,\n  DEFAULT_COMPACT_THRESHOLD,\n  DEFAULT_VISIBILITY,\n  resolveViewConfig,\n} from \"./internal/profiles.js\";\n","numLines":618,"startLine":1,"totalLines":618}}}

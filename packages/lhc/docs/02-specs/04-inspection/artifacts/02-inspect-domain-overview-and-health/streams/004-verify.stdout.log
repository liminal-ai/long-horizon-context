  from: { type: \"string\" },\n   137\t        to: { type: \"string\" },\n   138\t        limit: { type: \"string\" },\n   139\t        \"include-deleted\": { type: \"boolean\" },\n   140\t      },\n   141\t      strict: true,\n   142\t      allowPositionals: true,\n   143\t    }));\n   144\t  } catch (cause) {\n   145\t    const message = cause instanceof Error ? cause.message : String(cause);\n   146\t    // parseArgs names the offending option in single quotes (e.g. Unknown\n   147\t    // option '--file-pth'); surface that token, falling back to the message.\n   148\t    const named = /'([^']+)'/.exec(message);\n   149\t    return { ok: false, unknownFlag: named?.[1] ?? message };\n   150\t  }\n   151\t  const flags: ParsedFlags = {};\n   152\t  if (typeof values[\"thread-id\"] === \"string\") flags.threadId = values[\"thread-id\"];\n   153\t  if (typeof values[\"file-path\"] === \"string\") flags.filePath = values[\"file-path\"];\n   154\t  if (typeof values.title === \"string\") flags.title = values.title;\n   155\t  if (typeof values.registry === \"string\") flags.registryPath = values.registry;\n   156\t  if (typeof values[\"max-items\"] === \"string\") flags.maxItems = values[\"max-items\"];\n   157\t  if (typeof values.provider === \"string\") flags.provider = values.provider;\n   158\t  if (values[\"not-ready\"] === true) flags.notReady = true;\n   159\t  if (typeof values[\"message-id\"] === \"string\") flags.messageId = values[\"message-id\"];\n   160\t  if (typeof values.message === \"string\") flags.messageId = values.message;\n   161\t  if (typeof values.content === \"string\") flags.content = values.content;\n   162\t  if (typeof values[\"turn-id\"] === \"string\") flags.turnId = values[\"turn-id\"];\n   163\t  if (typeof values.turn === \"string\") flags.turnId = values.turn;\n   164\t  if (typeof values[\"chunk-id\"] === \"string\") flags.chunkId = values[\"chunk-id\"];\n   165\t  if (typeof values.form === \"string\") flags.form = values.form;\n   166\t  if (typeof values[\"subject-kind\"] === \"string\") flags.subjectKind = values[\"subject-kind\"];\n   167\t  if (typeof values[\"subject-id\"] === \"string\") flags.subjectId = values[\"subject-id\"];\n   168\t  if (typeof values.from === \"string\") flags.from = values.from;\n   169\t  if (typeof values.to === \"string\") flags.to = values.to;\n   170\t  if (typeof values.limit === \"string\") flags.limit = values.limit;\n   171\t  if (values[\"include-deleted\"] === true) flags.includeDeleted = true;\n   172\t  return { ok: true, flags };\n   173\t}\n   174\t\n   175\t// The read commands take a thread reference but no stdin; a missing reference\n   176\t// is a usage error named before any SDK call, matching the intake commands.\n   177\tfunction requireThreadRef(flags: ParsedFlags, command: string): CliResult | undefined {\n   178\t  if (flags.threadId === undefined && flags.filePath === undefined) {\n   179\t    return renderCliError(\n   180\t      \"caller_error\",\n   181\t      \"missing_flag\",\n   182\t      `${command} requires --thread-id or --file-path`,\n   183\t    );\n   184\t  }\n   185\t  return undefined;\n   186\t}\n   187\t\n   188\tfunction threadRefFrom(flags: ParsedFlags): ThreadRef {\n   189\t  if (flags.threadId !== undefined) {\n   190\t    return flags.registryPath !== undefined\n   191\t      ? { threadId: flags.threadId, registryPath: flags.registryPath }\n   192\t      : { threadId: flags.threadId };\n   193\t  }\n   194\t  return { filePath: flags.filePath ?? \"\" };\n   195\t}\n   196\t\n   197\texport async function runCli(\n   198\t  argv: readonly string[],\n   199\t  readStdin: StdinReader = readProcessStdin,\n   200\t): Promise<CliResult> {\n   201\t  if (argv.length === 0) {\n   202\t    return renderCliError(\"caller_error\", \"unknown_command\", \"no command given; run lhc --help\");\n   203\t  }\n   204\t  if (argv[0] === \"--help\" || argv[0] === \"-h\") {\n   205\t    return { exitCode: 0, stdout: HELP, stderr: \
{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"function readTurns|readTurns\\\\(\\\" packages/lhc/src/domains/turns/internal/store.ts packages/lhc/src/domains/turns/internal/forms.ts && nl -ba packages/lhc/src/domains/turns/internal/store.ts | sed -n '1,220p'\"","aggregated_output":"packages/lhc/src/domains/turns/internal/store.ts:77:export function readTurns(db: DatabaseSync): TurnRecord[] {\n     1\t// Turn row operations. Writes run on the caller's handle inside the batch\n     2\t// transaction; reads run on a fresh handle per operation. A closed turn has\n     3\t// no writer anywhere in this module — frozenness (AC-3.7) is the absence of\n     4\t// any UPDATE that touches a closed row.\n     5\timport type { DatabaseSync } from \"node:sqlite\";\n     6\timport type { TurnRecord } from \"../index.js\";\n     7\timport { readPlacements } from \"./chunks.js\";\n     8\t\n     9\texport function selectOpenTurnIds(db: DatabaseSync): string[] {\n    10\t  const rows = db\n    11\t    .prepare(\"SELECT turn_id FROM turns WHERE status = 'open' ORDER BY turn_order\")\n    12\t    .all() as unknown as Array<{ turn_id: string }>;\n    13\t  return rows.map((row) => row.turn_id);\n    14\t}\n    15\t\n    16\texport function nextTurnOrder(db: DatabaseSync): number {\n    17\t  const row = db.prepare(\"SELECT MAX(turn_order) AS max_order FROM turns\").get() as\n    18\t    | { max_order: number | bigint | null }\n    19\t    | undefined;\n    20\t  return Number(row?.max_order ?? 0) + 1;\n    21\t}\n    22\t\n    23\texport function insertOpenTurn(\n    24\t  db: DatabaseSync,\n    25\t  turnOrder: number,\n    26\t  openedAtEventOrder: number,\n    27\t): string {\n    28\t  const turnId = `t${turnOrder}`;\n    29\t  db.prepare(\n    30\t    `INSERT INTO turns (turn_id, turn_order, status, opened_at_event_order)\n    31\t     VALUES (?, ?, 'open', ?)`,\n    32\t  ).run(turnId, turnOrder, openedAtEventOrder);\n    33\t  return turnId;\n    34\t}\n    35\t\n    36\texport function closeTurn(db: DatabaseSync, turnId: string, closedAtEventOrder: number): void {\n    37\t  db.prepare(\n    38\t    \"UPDATE turns SET status = 'closed', closed_at_event_order = ? WHERE turn_id = ? AND status = 'open'\",\n    39\t  ).run(closedAtEventOrder, turnId);\n    40\t}\n    41\t\n    42\t// The turn delete's validation read (Flow 6): the live (deleted-filtered)\n    43\t// turn row. A deleted or missing target misses here and refuses as\n    44\t// turn_not_found — the filtered view is the refusal's read, so a double\n    45\t// delete is a refusal, never a silent success (AC-6.7).\n    46\texport function readMutableTurn(\n    47\t  db: DatabaseSync,\n    48\t  turnId: string,\n    49\t): { turnId: string; status: \"open\" | \"closed\" } | undefined {\n    50\t  const row = db\n    51\t    .prepare(`SELECT status FROM turns WHERE turn_id = ? AND deleted_at IS NULL`)\n    52\t    .get(turnId) as unknown as { status: string } | undefined;\n    53\t  if (row === undefined) return undefined;\n    54\t  return { turnId, status: row.status as \"open\" | \"closed\" };\n    55\t}\n    56\t\n    57\t// The turn delete's record apply: a projection-level tombstone on the turn\n    58\t// row, mirroring the message stamp. Events and membership rows are never\n    59\t// touched — reads filter; boundaries never re-cut (shrink-only membership).\n    60\texport function markTurnDeleted(db: DatabaseSync, turnId: string, deletedAt: string): void {\n    61\t  db.prepare(`UPDATE turns SET deleted_at = ? WHERE turn_id = ?`).run(deletedAt, turnId);\n    62\t}\n    63\t\n    64\tinterface RawTurnRow {\n    65\t  turn_id: string;\n    66\t  status: string;\n    67\t  opened_at_event_order: number | bigint;\n    68\t  closed_at_event_order: number | bigint | null;\n    69\t}\n    70\t\n    71\t// Membership is stored on the member (message.turn_id), never as a list on\n    72\t// the turn: memberMessageIds is a query, ordered by event order, so there is\n    73\t// exactly one source of truth. Both halves read deleted-filtered (tech\n    74\t// design §Mechanics): a deleted turn leaves the listing entirely, and a\n    75\t// deleted message leaves its turn's membership — the membership shrinks in\n    76\t// place, the turn row and its boundaries untouched.\n    77\texport function readTurns(db: DatabaseSync): TurnRecord[] {\n    78\t  const memberRows = db\n    79\t    .prepare(\n    80\t      `SELECT message_id, turn_id FROM message\n    81\t       WHERE turn_id IS NOT NULL AND deleted_at IS NULL ORDER BY source_event_order`,\n    82\t    )\n    83\t    .all() as unknown as Array<{ message_id: string; turn_id: string }>;\n    84\t  const membersByTurn = new Map<string, string[]>();\n    85\t  for (const row of memberRows) {\n    86\t    const members = membersByTurn.get(row.turn_id) ?? [];\n    87\t    members.push(row.message_id);\n    88\t    membersByTurn.set(row.turn_id, members);\n    89\t  }\n    90\t\n    91\t  const turnRows = db\n    92\t    .prepare(\n    93\t      `SELECT turn_id, status, opened_at_event_order, closed_at_event_order\n    94\t       FROM turns WHERE deleted_at IS NULL ORDER BY turn_order`,\n    95\t    )\n    96\t    .all() as unknown as RawTurnRow[];\n    97\t  // Chunk placement rides the turn read-back (Epic 02 AC-3.5): stored\n    98\t  // chunk_member values, absent until the turn's derivation placed it.\n    99\t  const placements = readPlacements(db);\n   100\t  return turnRows.map((row) => {\n   101\t    const record: TurnRecord = {\n   102\t      turnId: row.turn_id,\n   103\t      status: row.status as TurnRecord[\"status\"],\n   104\t      memberMessageIds: membersByTurn.get(row.turn_id) ?? [],\n   105\t      openedAtEventOrder: Number(row.opened_at_event_order),\n   106\t    };\n   107\t    if (row.closed_at_event_order !== null) {\n   108\t      record.closedAtEventOrder = Number(row.closed_at_event_order);\n   109\t    }\n   110\t    const placement = placements.get(row.turn_id);\n   111\t    if (placement !== undefined) {\n   112\t      record.chunkId = placement.chunkId;\n   113\t      record.memberIdx = placement.memberIdx;\n   114\t    }\n   115\t    return record;\n   116\t  });\n   117\t}\n","exit_code":0,"status":"completed"}}

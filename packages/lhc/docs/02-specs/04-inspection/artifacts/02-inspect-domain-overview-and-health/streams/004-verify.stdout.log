{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/derivation.ts | sed -n '1,220p'\"","aggregated_output":"     1\t// Epic 02 shared vocabulary: the derived-form state machine's types, the\n     2\t// provider seam, and the handler contract. Both owning domains (messages,\n     3\t// turns) consume these; neither owns them — the repair report, the mutation\n     4\t// cascade, and the drain all speak this vocabulary across domain lines, so it\n     5\t// lives in shared/ (tech design §Interfaces, DD-2/DD-7).\n     6\timport type { DatabaseSync } from \"node:sqlite\";\n     7\timport type { ResolvedViewConfig, SdkViewConfig } from \"./view.js\";\n     8\t\n     9\texport type SubjectKind = \"message\" | \"turn\" | \"chunk\";\n    10\t\n    11\texport type FormKind =\n    12\t  | \"smoothed_prompt\"\n    13\t  | \"tool_call_summary\"\n    14\t  | \"tool_result_summary\"\n    15\t  | \"turn_rendering\"\n    16\t  | \"lower_band_projection\"\n    17\t  | \"chunk_summary_detailed\"\n    18\t  | \"chunk_summary_brief\";\n    19\t\n    20\texport type DerivedFormState = \"pending\" | \"ready\" | \"failed\" | \"blocked\";\n    21\t\n    22\t// Outcome on tool-activity summaries — mechanically stamped from the record\n    23\t// (isError/presence), never authored by the provider (AC-2.4).\n    24\texport type ToolOutcome = \"succeeded\" | \"failed\" | \"unknown\";\n    25\t\n    26\t// A composed form's record of a dependency that fell back during composition:\n    27\t// names the source record and the form that was not ready (AC-3.2/3.3).\n    28\texport interface DependencyGap {\n    29\t  subjectKind: SubjectKind;\n    30\t  subjectId: string;\n    31\t  form: FormKind;\n    32\t}\n    33\t\n    34\t// The read shape for one derived form's state row (DD-2, DD-3).\n    35\texport interface DerivedForm {\n    36\t  subjectKind: SubjectKind;\n    37\t  subjectId: string;\n    38\t  form: FormKind;\n    39\t  state: DerivedFormState;\n    40\t  content?: string; // ready only\n    41\t  reason?: string; // failed | blocked\n    42\t  sourceVersion: number; // which version of the source this form derives from (DD-3)\n    43\t  gaps?: DependencyGap[]; // composed forms; landed-with-fallback record\n    44\t  metadata?: DerivedFormMetadata; // mechanically stamped fields; never provider-authored\n    45\t  derivedAt?: string;\n    46\t}\n    47\t\n    48\t// One tool call's or result's receipt within a turn's composed account\n    49\t// (AC-3.8): the account text — what changed, as composed — plus the\n    50\t// mechanically derived outcome. Derived from the composition input, never\n    51\t// from provider prose; stamped on the turn_rendering form so the chunk\n    52\t// summaries can read receipts machine-readably in turn order.\n    53\texport interface ToolRunReceipt {\n    54\t  messageId: string;\n    55\t  activity: \"tool_call\" | \"tool_result\";\n    56\t  account: string;\n    57\t  outcome: ToolOutcome;\n    58\t}\n    59\t\n    60\t// Mechanically stamped form metadata: tool outcomes (AC-2.4), the turn\n    61\t// rendering's tool-run receipts (AC-3.8), plus — at retry exhaustion — the\n    62\t// final attempts/last-error copied from the work item before its row is\n    63\t// deleted (DD-1: the queue is not an audit table; durable outcome detail\n    64\t// lives here).\n    65\texport interface DerivedFormMetadata {\n    66\t  outcome?: ToolOutcome;\n    67\t  receipts?: ToolRunReceipt[];\n    68\t  attempts?: number;\n    69\t  lastError?: string;\n    70\t}\n    71\t\n    72\t// One row of an owner's repair report (Flow 4): the form's durable state\n    73\t// joined with the queue's mechanical detail for the live item still working\n    74\t// toward it, if any. The five operational situations read from this one row:\n    75\t// never-attempted (pending, no queue), retrying (pending + queue with\n    76\t// attempts > 0), ready, failed (+ reason), blocked (+ reason) — no caller\n    77\t// ever needs a queue API.\n    78\texport interface FormReportEntry extends DerivedForm {\n    79\t  queue?: {\n    80\t    status: \"queued\" | \"claimed\";\n    81\t    attempts: number;\n    82\t    lastError?: string;\n    83\t    eligibleAt?: string;\n    84\t  };\n    85\t}\n    86\t\n    87\t// ── provider seam (DD-7) ─────────────────────────────────────────\n    88\t// Every operation returns content or a structured failure carrying\n    89\t// retryable-or-not; classification is the adapter's duty.\n    90\texport type ProviderResult =\n    91\t  | { ok: true; text: string }\n    92\t  | { ok: false; retryable: boolean; reason: string };\n    93\t\n    94\t// Message kinds a rendering part can carry — mirrors the intake event-kind\n    95\t// vocabulary minus turn_end (turn_end never projects a message). Mirrored\n    96\t// rather than imported: shared/ may not import domains/.\n    97\texport type RenderingPartKind =\n    98\t  | \"user_prompt\"\n    99\t  | \"assistant_text\"\n   100\t  | \"assistant_thinking\"\n   101\t  | \"runtime_note\"\n   102\t  | \"tool_call\"\n   103\t  | \"tool_result\";\n   104\t\n   105\texport interface RenderingPart {\n   106\t  messageId: string;\n   107\t  kind: RenderingPartKind;\n   108\t  text: string; // ready form content, or raw/truncated fallback\n   109\t  fallback: boolean; // true ⇒ gap recorded\n   110\t  outcome?: ToolOutcome; // tool activity only\n   111\t}\n   112\t\n   113\texport interface DerivationProvider {\n   114\t  smoothPrompt(i: { text: string }): Promise<ProviderResult>;\n   115\t  summarizeToolCall(i: {\n   116\t    toolName: string;\n   117\t    argsJson: string;\n   118\t    pairedResult?: { content: string; isError: boolean };\n   119\t  }): Promise<ProviderResult>;\n   120\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult>;\n   121\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult>;\n   122\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult>;\n   123\t  // The two summary inputs differ by contract (AC-3.8): detailed receives\n   124\t  // the members' tool-run receipts (what changed, outcome) alongside the\n   125\t  // projections; brief receives outcomes only — receipt text is stripped\n   126\t  // before the provider is called, so brief structurally cannot leak it.\n   127\t  // The receipt fields are optional in the type for callers without member\n   128\t  // context (the production chunk handlers always pass them).\n   129\t  summarizeChunkDetailed(i: {\n   130\t    memberProjections: string[];\n   131\t    memberReceipts?: ToolRunReceipt[][];\n   132\t  }): Promise<ProviderResult>;\n   133\t  summarizeChunkBrief(i: {\n   134\t    memberProjections: string[];\n   135\t    memberOutcomes?: ToolOutcome[][];\n   136\t  }): Promise<ProviderResult>;\n   137\t}\n   138\t\n   139\texport const PROVIDER_OPERATIONS = [\n   140\t  \"smoothPrompt\",\n   141\t  \"summarizeToolCall\",\n   142\t  \"summarizeToolResult\",\n   143\t  \"composeTurnRendering\",\n   144\t  \"projectLowerBand\",\n   145\t  \"summarizeChunkDetailed\",\n   146\t  \"summarizeChunkBrief\",\n   147\t] as const;\n   148\t\n   149\texport type ProviderOperationName = (typeof PROVIDER_OPERATIONS)[number];\n   150\t\n   151\t// ── SDK assembly config (tech design §Interfaces) ────────────────\n   152\texport interface SdkConfig {\n   153\t  provider: DerivationProvider;\n   154\t  mode: \"background\" | \"manual\";\n   155\t  clock?: () => Date;\n   156\t  retry?: { budget: number; backoffBaseMs: number; backoffCapMs: number }; // 3 / 5000 / 60000\n   157\t  lease?: { durationMs: number }; // 120000\n   158\t  chunkPolicy?: { targetProjectedTokens: number; maxProjectedTokens: number }; // 2200 / 4400\n   159\t  view?: SdkViewConfig; // Epic 03: profiles, visibility budgets, compact threshold\n   160\t}\n   161\t\n   162\t// Every optional filled by createSdk's central defaults.\n   163\texport interface ResolvedSdkConfig {\n   164\t  provider: DerivationProvider;\n   165\t  mode: \"background\" | \"manual\";\n   166\t  clock: () => Date;\n   167\t  retry: { budget: number; backoffBaseMs: number; backoffCapMs: number };\n   168\t  lease: { durationMs: number };\n   169\t  chunkPolicy: { targetProjectedTokens: number; maxProjectedTokens: number };\n   170\t  view: ResolvedViewConfig;\n   171\t}\n   172\t\n   173\t// ── handler contract (DD-6; the map's value type) ────────────────\n   174\texport interface HandlerRunContext {\n   175\t  openDb(): DatabaseSync; // short-txn access; NEVER held across provider calls\n   176\t  provider: DerivationProvider;\n   177\t  clock: () => Date;\n   178\t  config: ResolvedSdkConfig;\n   179\t}\n   180\t\n   181\t// A successful handler hands its derived-form content back as data; the\n   182\t// drain's completion transaction performs the version-checked UPDATE and the\n   183\t// item-row deletion atomically (tech design §Mechanics: completion is one\n   184\t// short BEGIN IMMEDIATE doing the form write and the delete). The handler\n   185\t// never opens that transaction itself, so the version check and the\n   186\t// done/stale_discarded disposition stay in one place — the queue util.\n   187\texport interface HandlerFormWrite {\n   188\t  subjectKind: SubjectKind;\n   189\t  subjectId: string;\n   190\t  form: FormKind;\n   191\t  content: string;\n   192\t  metadata?: DerivedFormMetadata;\n   193\t  gaps?: DependencyGap[];\n   194\t}\n   195\t\n   196\t// The completion-transaction hook (Story 3): work that must land atomically\n   197\t// with the version-checked form writes — chunk placement and the\n   198\t// close→summary enqueues above all. The queue util invokes it inside the\n   199\t// completion's BEGIN IMMEDIATE, after the form writes and only when they hit\n   200\t// (a stale completion must not place a turn or enqueue summaries); onCommit\n   201\t// registrations flush after that COMMIT succeeds and drop on rollback, so a\n   202\t// crash leaves either a placed turn with its enqueues or nothing — never a\n   203\t// derived-but-unplaced turn.\n   204\texport interface CompletionTx {\n   205\t  db: DatabaseSync;\n   206\t  onCommit: (fn: () => void) => void;\n   207\t}\n   208\t\n   209\texport type HandlerOutcome =\n   210\t  | { ok: true; forms?: HandlerFormWrite[]; onApplied?: (tx: CompletionTx) => void }\n   211\t  | { ok: false; retryable: boolean; reason: string }\n   212\t  | { ok: false; blocked: true; reason: string }; // source damage → form blocked, item terminal\n   213\t\n   214\t// item is the queue util's WorkItemRecord; typed structurally here so the\n   215\t// shared layer does not depend on the util's module (and vice versa stays\n   216\t// one-directional: tech-utils imports shared).\n   217\texport type WorkHandler = (\n   218\t  run: HandlerRunContext,\n   219\t  item: { workItemId: string; kind: string; sourceRef: Record<string, string> },\n   220\t) => Promise<HandlerOutcome>;\n","exit_code":0,"status":"completed"}}

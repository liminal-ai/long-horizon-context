{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/scripts/check-boundaries.mjs | sed -n '1,240p'\"","aggregated_output":"     1\t#!/usr/bin/env node\n     2\t// Zero-dependency import-boundary check.\n     3\t// Rules:\n     4\t//   1. No file may import another domain's internal/ modules.\n     5\t//   2. tech-utils/ and shared/ may not import from domains/.\n     6\t//   3. A domain may import another domain's surface (index.ts) only along an\n     7\t//      edge pinned in ALLOWED_SURFACE_IMPORTS below — a new cross-domain\n     8\t//      edge is a conscious decision, never a silent pass.\n     9\t// The test fixtures directory (test/fixtures/) is exempt by design — it is\n    10\t// the one sanctioned below-SDK writer.\n    11\timport { readdirSync, readFileSync, statSync } from \"node:fs\";\n    12\timport path from \"node:path\";\n    13\timport { fileURLToPath } from \"node:url\";\n    14\t\n    15\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n    16\tconst srcRoot = path.join(pkgRoot, \"src\");\n    17\tconst testRoot = path.join(pkgRoot, \"test\");\n    18\tconst fixturesRoot = path.join(testRoot, \"fixtures\");\n    19\t\n    20\tfunction collectTsFiles(dir, out = []) {\n    21\t  let entries;\n    22\t  try {\n    23\t    entries = readdirSync(dir);\n    24\t  } catch {\n    25\t    return out;\n    26\t  }\n    27\t  for (const entry of entries) {\n    28\t    const full = path.join(dir, entry);\n    29\t    if (full === fixturesRoot) continue; // fixtures exempt\n    30\t    if (statSync(full).isDirectory()) {\n    31\t      collectTsFiles(full, out);\n    32\t    } else if (full.endsWith(\".ts\")) {\n    33\t      out.push(full);\n    34\t    }\n    35\t  }\n    36\t  return out;\n    37\t}\n    38\t\n    39\tfunction importSpecifiers(source) {\n    40\t  const specs = [];\n    41\t  const patterns = [\n    42\t    /(?:^|\\s)import\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    43\t    /(?:^|\\s)export\\s+[^\"']*?from\\s+[\"']([^\"']+)[\"']/gms,\n    44\t    /(?:^|\\s)import\\s+[\"']([^\"']+)[\"']/gm,\n    45\t    /import\\(\\s*[\"']([^\"']+)[\"']\\s*\\)/g,\n    46\t  ];\n    47\t  for (const re of patterns) {\n    48\t    let m;\n    49\t    while ((m = re.exec(source)) !== null) specs.push(m[1]);\n    50\t  }\n    51\t  return specs;\n    52\t}\n    53\t\n    54\tfunction domainOf(filePath) {\n    55\t  const rel = path.relative(srcRoot, filePath);\n    56\t  const parts = rel.split(path.sep);\n    57\t  if (parts[0] === \"domains\" && parts.length > 1) return parts[1];\n    58\t  return null;\n    59\t}\n    60\t\n    61\t// The pinned domain-surface dependency edges (rule 3). Epic 03 adds two:\n    62\t// thread-view consumes the messages/turns report surfaces and the threads\n    63\t// resolver; intake-stream gains the thread-view surface for the boundary\n    64\t// advance registration (Flow 4).\n    65\t// SANCTIONED CYCLE (Epic 03 tech design §Module Boundaries): intake-stream →\n    66\t// thread-view → messages/turns → intake-stream (the last edges are type-only\n    67\t// event vocabulary). The domain graph is therefore deliberately not a DAG —\n    68\t// runtime-safe because the advance is registration-then-flush with no\n    69\t// import-time execution — so this check pins the allowed edge set instead of\n    70\t// asserting acyclicity.\n    71\tconst ALLOWED_SURFACE_IMPORTS = {\n    72\t  \"intake-stream\": new Set([\"threads\", \"messages\", \"turns\", \"thread-view\"]),\n    73\t  messages: new Set([\"threads\", \"intake-stream\"]),\n    74\t  turns: new Set([\"threads\", \"intake-stream\", \"messages\"]),\n    75\t  \"thread-view\": new Set([\"threads\", \"messages\", \"turns\"]),\n    76\t  threads: new Set(),\n    77\t  // Epic 04: inspect sits at the top of the graph — pure consumer of the\n    78\t  // five surfaces, nothing imports it except sdk.ts and cli/. Acyclic by\n    79\t  // construction.\n    80\t  inspect: new Set([\"threads\", \"intake-stream\", \"messages\", \"turns\", \"thread-view\"]),\n    81\t};\n    82\t\n    83\t// Epic 04 source check (tech design §Testing Strategy): inspect composes\n    84\t// other domains' SURFACES — it owns no tables and may not reach storage at\n    85\t// all. Any sqlite usage or SQL keyword over a known table name inside\n    86\t// domains/inspect/** is a violation; a direct-SQL implementation could match\n    87\t// report output while violating inspect's entire contract.\n    88\tconst INSPECT_FORBIDDEN_PATTERNS = [\n    89\t  [/node:sqlite/, \"imports node:sqlite\"],\n    90\t  [/DatabaseSync/, \"references DatabaseSync\"],\n    91\t  [/\\.prepare\\s*\\(/, \"prepares a SQL statement\"],\n    92\t  [\n    93\t    /\\b(?:FROM|JOIN|INSERT\\s+INTO|UPDATE|DELETE\\s+FROM)\\s+(?:event|message|message_block|turns|chunk|chunk_member|work_item|derived_form|thread_metadata|thread_view|thread_view_band|view_boundary)\\b/i,\n    94\t    \"contains raw SQL over a domain table\",\n    95\t  ],\n    96\t];\n    97\t\n    98\tfunction inspectSourceViolations(file, source) {\n    99\t  const rel = path.relative(srcRoot, file);\n   100\t  if (!rel.startsWith(path.join(\"domains\", \"inspect\") + path.sep)) return [];\n   101\t  const found = [];\n   102\t  for (const [pattern, label] of INSPECT_FORBIDDEN_PATTERNS) {\n   103\t    if (pattern.test(source)) {\n   104\t      found.push(`${path.relative(pkgRoot, file)} ${label} — inspect may not read storage`);\n   105\t    }\n   106\t  }\n   107\t  return found;\n   108\t}\n   109\t\n   110\tconst files = [...collectTsFiles(srcRoot), ...collectTsFiles(testRoot)];\n   111\tconst violations = [];\n   112\t\n   113\tfor (const file of files) {\n   114\t  const source = readFileSync(file, \"utf8\");\n   115\t  violations.push(...inspectSourceViolations(file, source));\n   116\t  const fileDomain = domainOf(file);\n   117\t  const inTechUtilsOrShared =\n   118\t    file.startsWith(path.join(srcRoot, \"tech-utils\") + path.sep) ||\n   119\t    file.startsWith(path.join(srcRoot, \"shared\") + path.sep);\n   120\t\n   121\t  for (const spec of importSpecifiers(source)) {\n   122\t    if (!spec.startsWith(\".\")) continue; // only relative imports cross our tree\n   123\t    const resolved = path.resolve(path.dirname(file), spec);\n   124\t    const relToSrc = path.relative(srcRoot, resolved);\n   125\t    if (relToSrc.startsWith(\"..\")) continue; // outside src/\n   126\t    const parts = relToSrc.split(path.sep);\n   127\t\n   128\t    if (parts[0] === \"domains\" && parts.includes(\"internal\")) {\n   129\t      const targetDomain = parts[1];\n   130\t      if (fileDomain !== targetDomain) {\n   131\t        violations.push(\n   132\t          `${path.relative(pkgRoot, file)} imports ${spec} — reaches into domain \"${targetDomain}\" internal/`,\n   133\t        );\n   134\t      }\n   135\t    }\n   136\t    if (\n   137\t      parts[0] === \"domains\" &&\n   138\t      !parts.includes(\"internal\") &&\n   139\t      fileDomain !== null &&\n   140\t      parts[1] !== fileDomain\n   141\t    ) {\n   142\t      const targetDomain = parts[1];\n   143\t      const allowed = ALLOWED_SURFACE_IMPORTS[fileDomain];\n   144\t      if (allowed === undefined || !allowed.has(targetDomain)) {\n   145\t        violations.push(\n   146\t          `${path.relative(pkgRoot, file)} imports ${spec} — domain \"${fileDomain}\" has no pinned surface edge to \"${targetDomain}\" (rule 3)`,\n   147\t        );\n   148\t      }\n   149\t    }\n   150\t    if (inTechUtilsOrShared && parts[0] === \"domains\") {\n   151\t      violations.push(\n   152\t        `${path.relative(pkgRoot, file)} imports ${spec} — tech-utils/shared may not import domains/`,\n   153\t      );\n   154\t    }\n   155\t  }\n   156\t}\n   157\t\n   158\tif (violations.length > 0) {\n   159\t  console.error(\"boundary check FAILED:\");\n   160\t  for (const v of violations) console.error(`  - ${v}`);\n   161\t  process.exit(1);\n   162\t}\n   163\tconsole.log(`boundaries: OK (${files.length} files checked, fixtures exempt)`);\n","exit_code":0,"status":"completed"}}

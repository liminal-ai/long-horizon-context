{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/cli-process-inspect.test.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Story 1 (Epic 04), process-boundary suite: TC-3.4 — `lhc messages list`\n     2\t// and `lhc messages show` through the spawned dist/cli.js have full JSON\n     3\t// parity with the in-process SDK operations: same options, same result JSON,\n     4\t// refusals included. Reads are non-mutating, so one fixture thread serves\n     5\t// both sides — the spawned output deep-equals the SDK result on the same\n     6\t// file (the production-path proof: cli/messages-read.ts routes to the SDK,\n     7\t// any divergence is a bypass). Reads need no provider; the binary runs with\n     8\t// LHC_PROVIDER unset. Runs under verify-all only (LHC_PROCESS_SUITE=1).\n     9\t// TC-5.4's checkpoint parity joins this file in Story 4.\n    10\timport { spawnSync } from \"node:child_process\";\n    11\timport { mkdtempSync, rmSync } from \"node:fs\";\n    12\timport { tmpdir } from \"node:os\";\n    13\timport path from \"node:path\";\n    14\timport { fileURLToPath } from \"node:url\";\n    15\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n    16\timport {\n    17\t  createSdk,\n    18\t  messages,\n    19\t  resolveNamedProvider,\n    20\t  threads,\n    21\t  type MessageListOptions,\n    22\t} from \"../src/index.js\";\n    23\timport { validEvent } from \"./fixtures/index.js\";\n    24\t\n    25\tconst pkgRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"..\");\n    26\tconst cliPath = path.join(pkgRoot, \"dist\", \"cli.js\");\n    27\t\n    28\tfunction runBinary(args: string[]): { status: number | null; stdout: string; stderr: string } {\n    29\t  const result = spawnSync(process.execPath, [cliPath, ...args], {\n    30\t    encoding: \"utf8\",\n    31\t    env: { ...process.env, LHC_PROVIDER: undefined },\n    32\t  });\n    33\t  return { status: result.status, stdout: result.stdout, stderr: result.stderr };\n    34\t}\n    35\t\n    36\tlet dir: string;\n    37\tbeforeEach(() => {\n    38\t  dir = mkdtempSync(path.join(tmpdir(), \"lhc-proc-inspect-\"));\n    39\t});\n    40\tafterEach(() => {\n    41\t  rmSync(dir, { recursive: true, force: true });\n    42\t});\n    43\t\n    44\t// Two closed turns (m1 prompt, m2 text, m3 call, m4 result; m6 prompt,\n    45\t// m7 text), drained in-process against the registry's deterministic\n    46\t// provider, then m2 deleted — so the parity sweep covers live, bounded,\n    47\t// deleted-included, and deleted-shown reads on one record.\n    48\tasync function seedThread(): Promise<string> {\n    49\t  const filePath = path.join(dir, \"inspect-parity.sqlite\");\n    50\t  const created = await threads.newThread({\n    51\t    filePath,\n    52\t    registryPath: path.join(dir, \"registry.sqlite\"),\n    53\t  });\n    54\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    55\t  const provider = resolveNamedProvider(\"deterministic\");\n    56\t  if (provider === undefined) throw new Error(\"deterministic provider not registered\");\n    57\t  const sdk = createSdk({ provider, mode: \"manual\" });\n    58\t  const batches = [\n    59\t    [\n    60\t      validEvent(\"user_prompt\", { payload: { text: \"please read notes.txt\" } }),\n    61\t      validEvent(\"assistant_text\", { payload: { text: \"reading it now\" } }),\n    62\t      validEvent(\"tool_call\", {\n    63\t        payload: {\n    64\t          toolCallId: \"call-parity-1\",\n    65\t          toolName: \"read_file\",\n    66\t          arguments: { path: \"notes.txt\" },\n    67\t        },\n    68\t      }),\n    69\t      validEvent(\"tool_result\", {\n    70\t        payload: {\n    71\t          toolCallId: \"call-parity-1\",\n    72\t          content: \"contents of notes.txt: full parity-fixture tool output\",\n    73\t          isError: false,\n    74\t        },\n    75\t      }),\n    76\t      validEvent(\"turn_end\"),\n    77\t    ],\n    78\t    [\n    79\t      validEvent(\"user_prompt\", { payload: { text: \"summarize what you read\" } }),\n    80\t      validEvent(\"assistant_text\", { payload: { text: \"here is the summary\" } }),\n    81\t      validEvent(\"turn_end\"),\n    82\t    ],\n    83\t  ];\n    84\t  for (const batch of batches) {\n    85\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    86\t    if (!sent.ok) throw new Error(`fixture batch failed: ${sent.error.reason}`);\n    87\t  }\n    88\t  const drained = await sdk.work.drain({ filePath });\n    89\t  if (!drained.ok || drained.value.remaining !== 0) {\n    90\t    throw new Error(\"fixture drain did not settle\");\n    91\t  }\n    92\t  const deleted = await messages.deleteMessage({ filePath }, { messageId: \"m2\" });\n    93\t  if (!deleted.ok) throw new Error(`fixture delete failed: ${deleted.error.reason}`);\n    94\t  return filePath;\n    95\t}\n    96\t\n    97\tdescribe(\"TC-3.4 / AC-3.4: spawned-CLI message list/show parity with the SDK\", () => {\n    98\t  it(\"messages list mirrors the SDK across default, bounded, include-deleted, and refused options\", async () => {\n    99\t    const filePath = await seedThread();\n   100\t    const cases: Array<{ args: string[]; opts: MessageListOptions; ok: boolean }> = [\n   101\t      { args: [], opts: {}, ok: true },\n   102\t      { args: [\"--from\", \"2\", \"--to\", \"4\"], opts: { from: 2, to: 4 }, ok: true },\n   103\t      { args: [\"--limit\", \"2\"], opts: { limit: 2 }, ok: true },\n   104\t      { args: [\"--include-deleted\"], opts: { includeDeleted: true }, ok: true },\n   105\t      {\n   106\t        args: [\"--from\", \"3\", \"--limit\", \"2\", \"--include-deleted\"],\n   107\t        opts: { from: 3, limit: 2, includeDeleted: true },\n   108\t        ok: true,\n   109\t      },\n   110\t      // The refusal leg: bad bounds carry the same structured error through\n   111\t      // the process boundary, exit 1.\n   112\t      { args: [\"--from\", \"5\", \"--to\", \"2\"], opts: { from: 5, to: 2 }, ok: false },\n   113\t    ];\n   114\t    for (const parity of cases) {\n   115\t      const viaSdk = await messages.listMessages({ filePath }, parity.opts);\n   116\t      expect(viaSdk.ok).toBe(parity.ok);\n   117\t      const viaCli = runBinary([\"messages\", \"list\", \"--file-path\", filePath, ...parity.args]);\n   118\t      expect(viaCli.status).toBe(parity.ok ? 0 : 1);\n   119\t      expect(JSON.parse(viaCli.stdout)).toEqual(viaSdk);\n   120\t    }\n   121\t    // Six serial dist/cli.js spawns push past Vitest's 5000ms default on a\n   122\t    // loaded machine; the explicit budget keeps the configured verify-all gate\n   123\t    // stable (SV-01-003), matching the other process-suite spawn tests.\n   124\t  }, 30000);\n   125\t\n   126\t  it(\"messages show mirrors the SDK for live, deleted, and missing targets\", async () => {\n   127\t    const filePath = await seedThread();\n   128\t    for (const messageId of [\n   129\t      \"m4\", // live drained tool result, forms attached\n   130\t      \"m2\", // deleted: ok + flag — the audit read\n   131\t      \"m99\", // missing: message_not_found, exit 1\n   132\t    ]) {\n   133\t      const viaSdk = await messages.show({ filePath }, messageId);\n   134\t      const viaCli = runBinary([\n   135\t        \"messages\",\n   136\t        \"show\",\n   137\t        \"--file-path\",\n   138\t        filePath,\n   139\t        \"--message-id\",\n   140\t        messageId,\n   141\t      ]);\n   142\t      expect(viaCli.status).toBe(viaSdk.ok ? 0 : 1);\n   143\t      expect(JSON.parse(viaCli.stdout)).toEqual(viaSdk);\n   144\t    }\n   145\t    // The deleted target succeeds with the flag; the missing one refuses —\n   146\t    // pinned here so the loop's parity can't both-sides-drift.\n   147\t    const deletedShown = await messages.show({ filePath }, \"m2\");\n   148\t    expect(deletedShown.ok).toBe(true);\n   149\t    if (deletedShown.ok) expect(deletedShown.value.deleted).toBe(true);\n   150\t    const missing = await messages.show({ filePath }, \"m99\");\n   151\t    expect(missing.ok).toBe(false);\n   152\t    if (!missing.ok) expect(missing.error.code).toBe(\"message_not_found\");\n   153\t    // Same spawn-cost budget as the list leg, for the same gate-stability\n   154\t    // reason (SV-01-003).\n   155\t  }, 30000);\n   156\t});\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/cli/index.ts | sed -n '1,260p'\"","aggregated_output":"     1\timport { parseArgs } from \"node:util\";\n     2\timport * as intakeStream from \"../domains/intake-stream/index.js\";\n     3\timport * as messages from \"../domains/messages/index.js\";\n     4\timport * as threads from \"../domains/threads/index.js\";\n     5\timport * as turns from \"../domains/turns/index.js\";\n     6\timport type { MessageEventInput } from \"../domains/intake-stream/index.js\";\n     7\timport type { ThreadRef } from \"../domains/threads/index.js\";\n     8\timport type { OpResult } from \"../shared/errors.js\";\n     9\timport { renderCliError, renderResult, type CliResult } from \"./render.js\";\n    10\timport { runInspectHealth, runInspectOverview, runInspectView } from \"./inspect.js\";\n    11\timport { runMessagesDelete, runMessagesEdit } from \"./messages-mutate.js\";\n    12\timport { runMessagesList, runMessagesShow } from \"./messages-read.js\";\n    13\timport { runTurnsDelete } from \"./turns-mutate.js\";\n    14\timport {\n    15\t  runMessagesReport,\n    16\t  runMessagesRequeue,\n    17\t  runTurnsReport,\n    18\t  runTurnsRequeue,\n    19\t  runWorkDrain,\n    20\t} from \"./work.js\";\n    21\timport { runViewCommand } from \"./view.js\";\n    22\t\n    23\t// Stdin seam: in-process tests inject a reader; the binary reads the real\n    24\t// process stdin. null means interactive (TTY) — distinct from empty input\n    25\t// only in how it arises; both are refused with empty_stdin before any SDK\n    26\t// call (the SDK itself can never return that code).\n    27\texport type StdinReader = () => Promise<string | null>;\n    28\t\n    29\tasync function readProcessStdin(): Promise<string | null> {\n    30\t  if (process.stdin.isTTY) return null;\n    31\t  process.stdin.setEncoding(\"utf8\");\n    32\t  let data = \"\";\n    33\t  for await (const chunk of process.stdin) data += String(chunk);\n    34\t  return data;\n    35\t}\n    36\t\n    37\tfunction stdinCallerError(code: \"empty_stdin\" | \"invalid_event\", reason: string): OpResult<never> {\n    38\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n    39\t}\n    40\t\n    41\tconst HELP = `lhc — Long Horizon Context CLI\n    42\t\n    43\tUsage:\n    44\t  lhc threads new-thread --file-path <p> [--title <t>] [--registry <r>]\n    45\t  lhc threads resolve --thread-id <id> [--registry <r>]\n    46\t  lhc threads list [--registry <r>]\n    47\t  lhc intake-stream message-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n    48\t  lhc intake-stream list-events (--thread-id <id> | --file-path <p>) [--registry <r>]\n    49\t  lhc messages list (--thread-id <id> | --file-path <p>) [--from <n>] [--to <n>]\n    50\t                    [--limit <n>] [--include-deleted] [--registry <r>]\n    51\t  lhc messages show (--thread-id <id> | --file-path <p>) --message-id <id> [--registry <r>]\n    52\t  lhc messages list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n    53\t  lhc messages report (--thread-id <id> | --file-path <p>) [--not-ready] [--message-id <id>] [--registry <r>]\n    54\t  lhc messages requeue (--thread-id <id> | --file-path <p>) --message-id <id> --form <form> [--registry <r>]\n    55\t  lhc messages edit (--thread-id <id> | --file-path <p>) --message <id> --content <text> [--registry <r>]\n    56\t  lhc messages delete (--thread-id <id> | --file-path <p>) --message <id> [--registry <r>]\n    57\t  lhc turns list (--thread-id <id> | --file-path <p>) [--registry <r>]\n    58\t  lhc turns list-chunks (--thread-id <id> | --file-path <p>) [--registry <r>]\n    59\t  lhc turns list-queued-work (--thread-id <id> | --file-path <p>) [--registry <r>]\n    60\t  lhc turns report (--thread-id <id> | --file-path <p>) [--not-ready] [--turn-id <id>] [--chunk-id <id>] [--registry <r>]\n   
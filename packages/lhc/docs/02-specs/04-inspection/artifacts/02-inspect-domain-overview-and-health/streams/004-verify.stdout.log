{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/messages/index.ts | sed -n '1,260p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport {\n     3\t  runInTransaction,\n     4\t  runWithThreadTouchSuppressed,\n     5\t  type OperationContext,\n     6\t} from \"../../shared/context.js\";\n     7\timport type { FormKind, FormReportEntry, WorkHandler } from \"../../shared/derivation.js\";\n     8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     9\timport {\n    10\t  enqueue,\n    11\t  hasLiveItem,\n    12\t  listItems,\n    13\t  type WorkItemRecord,\n    14\t  type WorkKind,\n    15\t} from \"../../tech-utils/work-queue/index.js\";\n    16\timport type { EventKind, EventRecord } from \"../intake-stream/index.js\";\n    17\timport {\n    18\t  openThreadDatabase,\n    19\t  resolveThreadRef,\n    20\t  type ThreadRef,\n    21\t} from \"../threads/index.js\";\n    22\timport type { DerivedForm } from \"../../shared/derivation.js\";\n    23\timport {\n    24\t  findUnknownOutcomeCallSummary,\n    25\t  readMessageFormRow,\n    26\t  readMessageForms,\n    27\t  reportMessageForms,\n    28\t} from \"./internal/forms.js\";\n    29\timport { messageWorkHandlers } from \"./internal/handlers.js\";\n    30\timport { projectEvent } from \"./internal/project.js\";\n    31\timport {\n    32\t  cascadeFromMessage,\n    33\t  cascadeMessageDelete,\n    34\t  cascadeTurnDelete,\n    35\t  type CascadeClear,\n    36\t  type CascadeOutcome,\n    37\t} from \"./internal/cascade.js\";\n    38\timport {\n    39\t  applyMessageEdit,\n    40\t  insertMessage,\n    41\t  markMessageDeleted,\n    42\t  markTurnMessagesDeleted,\n    43\t  readMessageById,\n    44\t  readMessages,\n    45\t  readMutableMessage,\n    46\t} from \"./internal/store.js\";\n    47\t\n    48\texport type BlockType = \"text\" | \"tool_call\" | \"tool_result\";\n    49\t\n    50\texport interface Block {\n    51\t  blockType: BlockType;\n    52\t  content: Record<string, unknown>; // per-kind shape as projected, verbatim source content\n    53\t}\n    54\t\n    55\texport interface MessageRecord {\n    56\t  messageId: string;\n    57\t  sourceEventOrder: number;\n    58\t  kind: Exclude<EventKind, \"turn_end\">;\n    59\t  blocks: Block[];\n    60\t  tokenEstimate: number;\n    61\t  actor: string;\n    62\t  harness: string;\n    63\t  turnId?: string;\n    64\t  // The message's derived forms as stored (Epic 02 Story 2): present only\n    65\t  // for messages that are derivation sources — kinds with no derivable form\n    66\t  // carry no rows and no key (AC-2.7). Stored state returned verbatim,\n    67\t  // never re-derived on read.\n    68\t  forms?: DerivedForm[];\n    69\t  // The deleted-audit marker (Epic 04 AC-3.3): present (true) only on\n    70\t  // deleted records, which only the includeDeleted listing and the show\n    71\t  // read ever surface — a default list never carries the key.\n    72\t  deleted?: boolean;\n    73\t}\n    74\t\n    75\t// The event as the walk holds it after recording: the validated input plus\n    76\t// its server-stamped order and timestamp.\n    77\texport type RecordedEvent = EventRecord;\n    78\t\n    79\texport type MessageCreated = {\n    80\t  messageId: string;\n    81\t  kind: Exclude<EventKind, \"turn_end\">;\n    82\t  // Carried for tool activity only: the pairing key the queue sites need —\n    83\t  // tool_result projection runs the AC-2.8 late-result lookup against it.\n    84\t  toolCallId?: string;\n    85\t} | null;\n    86\t\n    87\t// Cross-domain surface, called by intake-stream inside the batch transaction\n    88\t// (the first such call through the operation context; turns.applyEvent\n    89\t// follows the pattern in Story 4). Synchronous and throwing by design: a\n    90\t// projection failure propagates to the pipeline's catch and rejects the\n    91\t// whole batch — recorded events without messages is the stranded state the\n    92\t// transaction exists to prevent. Returns null for turn_end (no message).\n    93\t// turnId is the membership stamp, settled by the pipeline before this call:\n    94\t// the turn open *after* this event's transition (so a prompt belongs to the\n    95\t// turn it just opened), or null in a gap — written once, never updated.\n    96\texport function createFromEvent(\n    97\t  ctx: OperationContext,\n    98\t  event: RecordedEvent,\n    99\t  turnId: string | null,\n   100\t): MessageCreated {\n   101\t  const projected = projectEvent(event);\n   102\t  if (projected === null) return null;\n   103\t  const kind = event.eventKind as Exclude<EventKind, \"turn_end\">;\n   104\t  const messageId = `m${event.eventOrder}`;\n   105\t  insertMessage(ctx.db, {\n   106\t    messageId,\n   107\t    sourceEventOrder: event.eventOrder,\n   108\t    kind,\n   109\t    tokenEstimate: projected.tokenEstimate,\n   110\t    actor: event.actor,\n   111\t    harness: event.harness,\n   112\t    turnId,\n   113\t    blocks: projected.blocks,\n   114\t  });\n   115\t  if (event.eventKind === \"tool_call\" || event.eventKind === \"tool_result\") {\n   116\t    return { messageId, kind, toolCallId: event.payload.toolCallId };\n   117\t  }\n   118\t  return { messageId, kind };\n   119\t}\n   120\t\n   121\t// The kind gate, exact by design: a prompt queues prompt_smoothing, a tool\n   122\t// call queues tool_call_summary (Epic 02 Story 2's additive extension), a\n   123\t// tool result queues tool_result_summary, nothing else queues anything —\n   124\t// text, thinking, and note messages are not derivation sources (Epic 01\n   125\t// AC-2.8/TC-2.9; Epic 02 AC-2.2/AC-2.7). Cross-domain surface, called by\n   126\t// intake-stream inside the batch transaction for every recorded message, so\n   127\t// the item commits (or rolls back) with the batch.\n   128\tconst MESSAGE_WORK_KINDS: Partial<Record<EventKind, WorkKind>> = {\n   129\t  user_prompt: \"prompt_smoothing\",\n   130\t  tool_call: \"tool_call_summary\",\n   131\t  tool_result: \"tool_result_summary\",\n   132\t};\n   133\t\n   134\t// Which derived form each message-owned kind produces — the owning domain's\n   135\t// knowledge, handed to the meaning-blind enqueue so the form's pending row\n   136\t// rides the same transaction (DD-5).\n   137\tconst MESSAGE_WORK_FORMS: Partial<Record<WorkKind, FormKind>> = {\n   138\t  prompt_smoothing: \"smoothed_prompt\",\n   139\t  tool_call_summary: \"tool_call_summary\",\n   140\t  tool_result_summary: \"tool_result_summary\",\n   141\t};\n   142\t\n   143\t// Message-owned work handlers, merged into the SDK's dispatch map at\n   144\t// construction (DD-6): prompt smoothing and the two tool-activity summaries.\n   145\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   146\t  messageWorkHandlers;\n   147\t\n   148\texport function queueMessageWork(\n   149\t  ctx: OperationContext,\n   150\t  message: MessageCreated,\n   151\t): WorkItemRecord[] {\n   152\t  if (message === null) return [];\n   153\t  const items: WorkItemRecord[] = [];\n   154\t  const kind = MESSAGE_WORK_KINDS[message.kind];\n   155\t  if (kind !== undefined) {\n   156\t    const form = MESSAGE_WORK_FORMS[kind];\n   157\t    if (form === undefined) {\n   158\t      // Every queuing kind names its form above; a miss is a wiring bug.\n   159\t      throw new Error(`no derived form mapped for message work kind ${kind}`);\n   160\t    }\n   161\t    items.push(\n   162\t      enqueue(ctx, {\n   163\t        owner: \"messages\",\n   164\t        kind,\n   165\t        sourceRef: { messageId: message.messageId },\n   166\t        forms: [{ subjectKind: \"message\", subjectId: message.messageId, form }],\n   167\t      }),\n   168\t    );\n   169\t  }\n   170\t  // Late-result repair (AC-2.8): a tool result landing after its call's\n   171\t  // summary already derived with outcome \"unknown\" means the summary's\n   172\t  // source — the call+result pair — completed underneath it; clear and\n   173\t  // regenerate at the next source version, in this same batch transaction.\n   174\t  // One indexed lookup; pending summaries (metadata NULL) never match, so\n   175\t  // the common call-and-result-in-one-batch case never triggers, and the\n   176\t  // version-scoped item id keeps the requeue idempotent.\n   177\t  if (message.kind === \"tool_result\" && message.toolCallId !== undefined) {\n   178\t    const stale = findUnknownOutcomeCallSummary(ctx.db, message.toolCallId);\n   179\t    if (stale !== undefined) {\n   180\t      items.push(\n   181\t        enqueue(ctx, {\n   182\t          owner: \"messages\",\n   183\t          kind: \"tool_call_summary\",\n   184\t          sourceRef: { messageId: stale.messageId },\n   185\t          sourceVersion: stale.sourceVersion + 1,\n   186\t          forms: [\n   187\t            {\n   188\t              subjectKind: \"message\",\n   189\t              subjectId: stale.messageId,\n   190\t              form: \"tool_call_summary\",\n   191\t            },\n   192\t          ],\n   193\t        }),\n   194\t      );\n   195\t    }\n   196\t  }\n   197\t  return items;\n   198\t}\n   199\t\n   200\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   201\t  return {\n   202\t    ok: false,\n   203\t    error: {\n   204\t      errorClass: \"caller_error\",\n   205\t      code: \"thread_not_found\",\n   206\t      reason: `no thread file exists at ${filePath}`,\n   207\t    },\n   208\t  };\n   209\t}\n   210\t\n   211\t// Bounded-listing options (Epic 04 Story 1, DD-3): from/to are\n   212\t// source-event-order bounds, limit caps the count after bounds,\n   213\t// includeDeleted is the audit opt-in. All optional — existing callers see\n   214\t// identical results (visible messages, unbounded, record order).\n   215\texport interface MessageListOptions {\n   216\t  from?: number;\n   217\t  to?: number;\n   218\t  limit?: number;\n   219\t  includeDeleted?: boolean;\n   220\t}\n   221\t\n   222\tfunction invalidBounds(reason: string): ErrorResult {\n   223\t  return { errorClass: \"caller_error\", code: \"invalid_bounds\", reason };\n   224\t}\n   225\t\n   226\t// Bounds mistakes are operational caller errors returned as results (tech\n   227\t// design §Interface Definitions: from > to, limit < 1) — never a silent\n   228\t// empty list a caller could mistake for an empty window.\n   229\tfunction validateListOptions(opts: MessageListOptions): ErrorResult | undefined {\n   230\t  const integers: ReadonlyArray<readonly [string, number | undefined]> = [\n   231\t    [\"from\", opts.from],\n   232\t    [\"to\", opts.to],\n   233\t    [\"limit\", opts.limit],\n   234\t  ];\n   235\t  for (const [name, value] of integers) {\n   236\t    if (value !== undefined && !Number.isInteger(value)) {\n   237\t      return invalidBounds(`${name} must be an integer, got ${value}`);\n   238\t    }\n   239\t  }\n   240\t  if (opts.from !== undefined && opts.to !== undefined && opts.from > opts.to) {\n   241\t    return invalidBounds(`from (${opts.from}) must not exceed to (${opts.to})`);\n   242\t  }\n   243\t  if (opts.limit !== undefined && opts.limit < 1) {\n   244\t    return invalidBounds(`limit must be at least 1, got ${opts.limit}`);\n   245\t  }\n   246\t  return undefined;\n   247\t}\n   248\t\n   249\t// Reads-only is structural, not disciplined (DD-6, SV-01-001): the whole\n   250\t// operation runs in the touch-suppressed scope, so openThreadDatabase's open\n   251\t// announcement (openThreadDatabase → fireThreadTouch → scheduler.touch) can\n   252\t// never let a background SDK's scheduler hang a first-touch catch-up drain —\n   253\t// and the provider call that drain would make — off this read. A list calls\n   254\t// no provider and schedules no work in either host mode.\n   255\texport function listMessages(\n   256\t  thread: ThreadRef,\n   257\t  opts?: MessageListOptions,\n   258\t): Promise<OpResult<MessageRecord[]>> {\n   259\t  return runWithThreadTouchSuppressed(() => listMessagesInner(thread, opts));\n   260\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/index.ts | sed -n '1,320p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runInTransaction, type OperationContext } from \"../../shared/context.js\";\n     3\timport type {\n     4\t  FormKind,\n     5\t  FormReportEntry,\n     6\t  WorkHandler,\n     7\t} from \"../../shared/derivation.js\";\n     8\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     9\timport {\n    10\t  enqueue,\n    11\t  hasLiveItem,\n    12\t  listItems,\n    13\t  type EnqueueFormTarget,\n    14\t  type WorkItemRecord,\n    15\t  type WorkKind,\n    16\t  type WorkSourceRef,\n    17\t} from \"../../tech-utils/work-queue/index.js\";\n    18\timport type { EventKind } from \"../intake-stream/index.js\";\n    19\timport { openThreadDatabase, resolveThreadRef, type ThreadRef } from \"../threads/index.js\";\n    20\timport { transition } from \"./internal/state-machine.js\";\n    21\t\n    22\t// The pure rule table, re-exported for the golden supplemental suite (the\n    23\t// test plan's one sanctioned direct entry besides the tokenizer); production\n    24\t// callers go through applyEvent.\n    25\texport { transition, type TurnEffect, type TurnState } from \"./internal/state-machine.js\";\n    26\timport type { DerivedForm } from \"../../shared/derivation.js\";\n    27\timport { turnWorkHandlers } from \"./internal/derive.js\";\n    28\timport {\n    29\t  readChunkRows,\n    30\t  readOwnedForms,\n    31\t  readTurnFormRow,\n    32\t  reportTurnForms,\n    33\t} from \"./internal/forms.js\";\n    34\timport {\n    35\t  applyTurnDeleteCascade,\n    36\t  type MutationResult,\n    37\t} from \"../messages/index.js\";\n    38\timport {\n    39\t  closeTurn,\n    40\t  insertOpenTurn,\n    41\t  markTurnDeleted,\n    42\t  nextTurnOrder,\n    43\t  readMutableTurn,\n    44\t  readTurns,\n    45\t  selectOpenTurnIds,\n    46\t} from \"./internal/store.js\";\n    47\t\n    48\texport interface TurnRecord {\n    49\t  turnId: string;\n    50\t  status: \"open\" | \"closed\";\n    51\t  memberMessageIds: string[];\n    52\t  openedAtEventOrder: number;\n    53\t  closedAtEventOrder?: number;\n    54\t  // Chunk placement (Epic 02 Story 3, AC-3.5): present once the turn's\n    55\t  // derivation placed it — stored values read back, never recomputed.\n    56\t  chunkId?: string;\n    57\t  memberIdx?: number;\n    58\t  // The turn's derived forms as stored (Epic 02 Story 4, AC-4.7 ruling 012):\n    59\t  // present only when rows exist — a closed turn carries them from the\n    60\t  // moment its derivation queues. Stored state returned verbatim, mirroring\n    61\t  // the message read's forms key; reads degrade, never block.\n    62\t  forms?: DerivedForm[];\n    63\t}\n    64\t\n    65\t// Chunk read-back (Epic 02 Story 4, AC-4.7 ruling 012): the stored chunk\n    66\t// record with live membership and its summary forms' states attached —\n    67\t// the chunk leg of \"reading a message, turn, or chunk returns the record\n    68\t// with form states\".\n    69\texport interface ChunkRecord {\n    70\t  chunkId: string;\n    71\t  chunkOrder: number;\n    72\t  status: \"open\" | \"closed\";\n    73\t  accumulatedProjectedTokens: number;\n    74\t  memberTurnIds: string[];\n    75\t  forms?: DerivedForm[];\n    76\t}\n    77\t\n    78\texport interface TurnTransitionOutcome {\n    79\t  // Transitions in occurrence order: a close_then_open reports the close\n    80\t  // first, then the open, exactly as the batch result surfaces them.\n    81\t  transitions: Array<{ action: \"opened\" | \"closed\"; turnId: string }>;\n    82\t  // Turn state after the transition — the stamp for this event's message.\n    83\t  // Prompts see the turn they just opened (transition first, then stamp);\n    84\t  // non-transition kinds see whatever is open, or null in a gap (AC-3.8).\n    85\t  openTurnId: string | null;\n    86\t  // Work queued by this transition: one turn_derivation item per closed\n    87\t  // turn, by either close path (AC-3.6). Empty when nothing closed.\n    88\t  queuedWork: WorkItemRecord[];\n    89\t}\n    90\t\n    91\t// Pipeline corruption check (AC-3.9): read at state load, after BEGIN\n    92\t// IMMEDIATE and before any event is processed. Only the batch pipeline\n    93\t// writes turn state, so more than one open turn means external interference.\n    94\texport function listOpenTurnIds(ctx: OperationContext): string[] {\n    95\t  return selectOpenTurnIds(ctx.db);\n    96\t}\n    97\t\n    98\t// Closing a turn — by either close path — durably queues that turn's\n    99\t// derivation work in the same transaction (AC-3.6): the close update and the\n   100\t// work item commit or roll back together.\n   101\tfunction closeTurnAndQueueWork(\n   102\t  ctx: OperationContext,\n   103\t  turnId: string,\n   104\t  eventOrder: number,\n   105\t): WorkItemRecord {\n   106\t  closeTurn(ctx.db, turnId, eventOrder);\n   107\t  // One work item, two derived forms: the turn_derivation handler (Story 3)\n   108\t  // lands the rendering and the lower-band projection as independent rows;\n   109\t  // both go pending with the enqueue (DD-5).\n   110\t  return enqueue(ctx, {\n   111\t    owner: \"turns\",\n   112\t    kind: \"turn_derivation\",\n   113\t    sourceRef: { turnId },\n   114\t    forms: [\n   115\t      { subjectKind: \"turn\", subjectId: turnId, form: \"turn_rendering\" },\n   116\t      { subjectKind: \"turn\", subjectId: turnId, form: \"lower_band_projection\" },\n   117\t    ],\n   118\t  });\n   119\t}\n   120\t\n   121\t// Turn-owned work handlers, merged into the SDK's dispatch map at\n   122\t// construction (DD-6): turn derivation and the two chunk summaries.\n   123\texport const workHandlers: Readonly<Partial<Record<WorkKind, WorkHandler>>> =\n   124\t  turnWorkHandlers;\n   125\t\n   126\t// Cross-domain surface, called by intake-stream inside the batch transaction\n   127\t// for every recorded event. Synchronous and throwing by design, like\n   128\t// messages.createFromEvent: a turn-storage failure rejects the whole batch.\n   129\texport function applyEvent(\n   130\t  ctx: OperationContext,\n   131\t  eventKind: EventKind,\n   132\t  eventOrder: number,\n   133\t): TurnTransitionOutcome {\n   134\t  const openTurnId = selectOpenTurnIds(ctx.db)[0] ?? null;\n   135\t  const effect = transition({ openTurnId }, eventKind);\n   136\t  switch (effect.kind) {\n   137\t    case \"none\":\n   138\t      return { transitions: [], openTurnId, queuedWork: [] };\n   139\t    case \"open\": {\n   140\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   141\t      return {\n   142\t        transitions: [{ action: \"opened\", turnId }],\n   143\t        openTurnId: turnId,\n   144\t        queuedWork: [],\n   145\t      };\n   146\t    }\n   147\t    case \"close\": {\n   148\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   149\t      return {\n   150\t        transitions: [{ action: \"closed\", turnId: openTurnId as string }],\n   151\t        openTurnId: null,\n   152\t        queuedWork: [item],\n   153\t      };\n   154\t    }\n   155\t    case \"close_then_open\": {\n   156\t      const item = closeTurnAndQueueWork(ctx, openTurnId as string, eventOrder);\n   157\t      const turnId = insertOpenTurn(ctx.db, nextTurnOrder(ctx.db), eventOrder);\n   158\t      return {\n   159\t        transitions: [\n   160\t          { action: \"closed\", turnId: openTurnId as string },\n   161\t          { action: \"opened\", turnId },\n   162\t        ],\n   163\t        openTurnId: turnId,\n   164\t        queuedWork: [item],\n   165\t      };\n   166\t    }\n   167\t  }\n   168\t}\n   169\t\n   170\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n   171\t  return {\n   172\t    ok: false,\n   173\t    error: {\n   174\t      errorClass: \"caller_error\",\n   175\t      code: \"thread_not_found\",\n   176\t      reason: `no thread file exists at ${filePath}`,\n   177\t    },\n   178\t  };\n   179\t}\n   180\t\n   181\texport async function listTurns(thread: ThreadRef): Promise<OpResult<TurnRecord[]>> {\n   182\t  const resolved = await resolveThreadRef(thread);\n   183\t  if (!resolved.ok) return resolved;\n   184\t  const { filePath } = resolved.value;\n   185\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   186\t\n   187\t  const opened = openThreadDatabase(filePath);\n   188\t  if (!opened.ok) return opened;\n   189\t  const db = opened.value;\n   190\t  try {\n   191\t    // Form read-back rides the turn read (AC-4.7): each record carries its\n   192\t    // stored derived forms, attached from one grouped query — mirroring the\n   193\t    // message read's production path for \"readable alongside the record\".\n   194\t    const formsByTurn = readOwnedForms(db, \"turn\");\n   195\t    const records = readTurns(db).map((record) => {\n   196\t      const forms = formsByTurn.get(record.turnId);\n   197\t      return forms === undefined ? record : { ...record, forms };\n   198\t    });\n   199\t    return { ok: true, value: records };\n   200\t  } catch (cause) {\n   201\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   202\t    return storageFailure(`turn read-back failed: ${reason}`);\n   203\t  } finally {\n   204\t    db.close();\n   205\t  }\n   206\t}\n   207\t\n   208\t// Chunk read-back with summary-form states attached (AC-4.7 ruling 012):\n   209\t// returns stored records whatever the forms' states — reads degrade, never\n   210\t// block. Forms attach only where rows exist (a freshly opened chunk has no\n   211\t// summary rows until close queues them).\n   212\texport async function listChunks(thread: ThreadRef): Promise<OpResult<ChunkRecord[]>> {\n   213\t  const resolved = await resolveThreadRef(thread);\n   214\t  if (!resolved.ok) return resolved;\n   215\t  const { filePath } = resolved.value;\n   216\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   217\t\n   218\t  const opened = openThreadDatabase(filePath);\n   219\t  if (!opened.ok) return opened;\n   220\t  const db = opened.value;\n   221\t  try {\n   222\t    const formsByChunk = readOwnedForms(db, \"chunk\");\n   223\t    const records: ChunkRecord[] = readChunkRows(db).map((row) => {\n   224\t      const forms = formsByChunk.get(row.chunkId);\n   225\t      return forms === undefined ? row : { ...row, forms };\n   226\t    });\n   227\t    return { ok: true, value: records };\n   228\t  } catch (cause) {\n   229\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   230\t    return storageFailure(`chunk read-back failed: ${reason}`);\n   231\t  } finally {\n   232\t    db.close();\n   233\t  }\n   234\t}\n   235\t\n   236\texport async function listQueuedWork(\n   237\t  thread: ThreadRef,\n   238\t): Promise<OpResult<WorkItemRecord[]>> {\n   239\t  const resolved = await resolveThreadRef(thread);\n   240\t  if (!resolved.ok) return resolved;\n   241\t  const { filePath } = resolved.value;\n   242\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   243\t\n   244\t  const opened = openThreadDatabase(filePath);\n   245\t  if (!opened.ok) return opened;\n   246\t  const db = opened.value;\n   247\t  try {\n   248\t    return { ok: true, value: listItems(db, \"turns\") };\n   249\t  } catch (cause) {\n   250\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   251\t    return storageFailure(`queued-work read-back failed: ${reason}`);\n   252\t  } finally {\n   253\t    db.close();\n   254\t  }\n   255\t}\n   256\t\n   257\t// ── report and repair (Epic 02 Story 4, Flow 4) ──────────────────\n   258\t\n   259\t// This owner's repair report: every turn- and chunk-owned form's durable\n   260\t// state joined with live queue detail in one query. Needs no provider;\n   261\t// reads degrade, never block.\n   262\texport async function report(\n   263\t  thread: ThreadRef,\n   264\t  opts?: { notReady?: boolean; turnId?: string; chunkId?: string },\n   265\t): Promise<OpResult<FormReportEntry[]>> {\n   266\t  const resolved = await resolveThreadRef(thread);\n   267\t  if (!resolved.ok) return resolved;\n   268\t  const { filePath } = resolved.value;\n   269\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   270\t\n   271\t  const opened = openThreadDatabase(filePath);\n   272\t  if (!opened.ok) return opened;\n   273\t  const db = opened.value;\n   274\t  try {\n   275\t    return { ok: true, value: reportTurnForms(db, opts ?? {}) };\n   276\t  } catch (cause) {\n   277\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   278\t    return storageFailure(`report read failed: ${reason}`);\n   279\t  } finally {\n   280\t    db.close();\n   281\t  }\n   282\t}\n   283\t\n   284\texport type RequeueOutcome = { workItemId: string } | { noop: \"already_queued\" };\n   285\t\n   286\t// The queue site each turn-owned form rebuilds through. Both turn forms ride\n   287\t// the one turn_derivation item (the handler lands rendering and projection\n   288\t// together, so a rebuild of either re-derives both — the rebuild rule from\n   289\t// Flow 3); each chunk summary rides its same-named kind alone (AC-3.8's\n   290\t// independent lifecycles).\n   291\tfunction turnRequeueTarget(target: {\n   292\t  subjectKind: \"turn\" | \"chunk\";\n   293\t  subjectId: string;\n   294\t  form: FormKind;\n   295\t}): { kind: WorkKind; sourceRef: WorkSourceRef; forms: EnqueueFormTarget[] } | undefined {\n   296\t  if (\n   297\t    target.subjectKind === \"turn\" &&\n   298\t    (target.form === \"turn_rendering\" || target.form === \"lower_band_projection\")\n   299\t  ) {\n   300\t    return {\n   301\t      kind: \"turn_derivation\",\n   302\t      sourceRef: { turnId: target.subjectId },\n   303\t      forms: [\n   304\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"turn_rendering\" },\n   305\t        { subjectKind: \"turn\", subjectId: target.subjectId, form: \"lower_band_projection\" },\n   306\t      ],\n   307\t    };\n   308\t  }\n   309\t  if (\n   310\t    target.subjectKind === \"chunk\" &&\n   311\t    (target.form === \"chunk_summary_detailed\" || target.form === \"chunk_summary_brief\")\n   312\t  ) {\n   313\t    return {\n   314\t      kind: target.form,\n   315\t      sourceRef: { chunkId: target.subjectId },\n   316\t      forms: [{ subjectKind: \"chunk\", subjectId: target.subjectId, form: target.form }],\n   317\t    };\n   318\t  }\n   319\t  return undefined;\n   320\t}\n","exit_code":0,"status":"completed"}}

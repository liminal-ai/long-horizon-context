{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/read-only-delta.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// The shared read-only delta helper (Epic 04, DD-6): inspect describes,\n     2\t// never changes — and that is asserted as ABSENCE OF DELTA in observable\n     3\t// state, not absence of write code. Snapshot everything a forgotten side\n     4\t// effect could move — queued work through both owners, boundary/zone/view\n     5\t// identity through the thread-view surface, the event log, the audit message\n     6\t// listing, and the raw derived-form rows — before and after an operation,\n     7\t// and require deep equality. Lands with Story 2 and wraps Story 1's read\n     8\t// ops retroactively (test plan, Chunk 2).\n     9\timport { deepStrictEqual } from \"node:assert/strict\";\n    10\timport { intakeStream, messages, threadView, turns } from \"../../src/index.js\";\n    11\timport { readDerivedForms } from \"./threads.js\";\n    12\t\n    13\texport interface ObservableState {\n    14\t  events: unknown;\n    15\t  messages: unknown;\n    16\t  messageWork: unknown;\n    17\t  turnWork: unknown;\n    18\t  viewStatus: unknown;\n    19\t  pullMeta: unknown;\n    20\t  forms: unknown;\n    21\t}\n    22\t\n    23\texport async function observableState(filePath: string): Promise<ObservableState> {\n    24\t  const pulled = await threadView.pull({ filePath });\n    25\t  return {\n    26\t    events: await intakeStream.listEvents({ filePath }),\n    27\t    messages: await messages.listMessages({ filePath }, { includeDeleted: true }),\n    28\t    messageWork: await messages.listQueuedWork({ filePath }),\n    29\t    turnWork: await turns.listQueuedWork({ filePath }),\n    30\t    viewStatus: await threadView.status({ filePath }),\n    31\t    pullMeta: pulled.ok ? pulled.value.meta : pulled,\n    32\t    forms: readDerivedForms(filePath),\n    33\t  };\n    34\t}\n    35\t\n    36\t// Run one operation under the before/after snapshot and return its result so\n    37\t// call sites can keep asserting on it. Throws (deepStrictEqual) when the\n    38\t// operation moved anything observable.\n    39\texport async function expectReadOnly<T>(\n    40\t  filePath: string,\n    41\t  operation: () => Promise<T>,\n    42\t): Promise<T> {\n    43\t  const before = await observableState(filePath);\n    44\t  const result = await operation();\n    45\t  deepStrictEqual(\n    46\t    await observableState(filePath),\n    47\t    before,\n    48\t    \"read-only delta: operation changed observable state\",\n    49\t  );\n    50\t  return result;\n    51\t}\n","exit_code":0,"status":"completed"}}

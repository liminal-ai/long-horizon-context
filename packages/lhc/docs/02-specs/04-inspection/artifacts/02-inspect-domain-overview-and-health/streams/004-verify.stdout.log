,\n   299\t          \"missing_flag\",\n   300\t          \"intake-stream list-events requires --thread-id or --file-path\",\n   301\t        );\n   302\t      }\n   303\t      return renderResult(await intakeStream.listEvents(threadRefFrom(flags)));\n   304\t    }\n   305\t    case \"messages list\": {\n   306\t      const missingRef = requireThreadRef(flags, \"messages list\");\n   307\t      if (missingRef !== undefined) return missingRef;\n   308\t      // Numeric flags convert here (the argv boundary); semantic bounds\n   309\t      // checks (from > to, limit < 1) stay in the SDK so refusal JSON has\n   310\t      // CLI/SDK parity.\n   311\t      const listOpts: { from?: number; to?: number; limit?: number; includeDeleted?: boolean } =\n   312\t        {};\n   313\t      if (flags.includeDeleted === true) listOpts.includeDeleted = true;\n   314\t      const numericFlags = [\n   315\t        [\"from\", flags.from],\n   316\t        [\"to\", flags.to],\n   317\t        [\"limit\", flags.limit],\n   318\t      ] as const;\n   319\t      for (const [name, raw] of numericFlags) {\n   320\t        if (raw === undefined) continue;\n   321\t        const value = Number(raw);\n   322\t        if (!Number.isInteger(value)) {\n   323\t          return renderCliError(\n   324\t            \"caller_error\",\n   325\t            \"missing_flag\",\n   326\t            `--${name} must be an integer, got ${raw}`,\n   327\t          );\n   328\t        }\n   329\t        listOpts[name] = value;\n   330\t      }\n   331\t      return runMessagesList(threadRefFrom(flags), listOpts);\n   332\t    }\n   333\t    case \"messages show\": {\n   334\t      const missingRef = requireThreadRef(flags, \"messages show\");\n   335\t      if (missingRef !== undefined) return missingRef;\n   336\t      if (flags.messageId === undefined) {\n   337\t        return renderCliError(\n   338\t          \"caller_error\",\n   339\t          \"missing_flag\",\n   340\t          \"messages show requir
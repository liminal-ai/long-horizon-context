{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/turns/index.ts | sed -n '320,700p'\"","aggregated_output":"   320\t}\n   321\t\n   322\t// Explicit re-queue through the owning surface (AC-4.4): same contract as\n   323\t// messages.requeue — blocked refused with the stored damage reason, missing\n   324\t// rows refused, no-op against live work at the current source version, and\n   325\t// the no-op check + enqueue in one transaction. A successful requeue rebuilds\n   326\t// at the next source version: composed forms recompute their gaps from\n   327\t// current dependency states (Flow 3's rebuild rule).\n   328\texport async function requeue(\n   329\t  thread: ThreadRef,\n   330\t  target: { subjectKind: \"turn\" | \"chunk\"; subjectId: string; form: FormKind },\n   331\t): Promise<OpResult<RequeueOutcome>> {\n   332\t  const mapped = turnRequeueTarget(target);\n   333\t  if (mapped === undefined) {\n   334\t    return {\n   335\t      ok: false,\n   336\t      error: {\n   337\t        errorClass: \"caller_error\",\n   338\t        code: \"turn_not_found\",\n   339\t        reason: `form ${target.form} is not a ${target.subjectKind}-owned form; turns.requeue repairs turn_rendering and lower_band_projection (turn) or chunk_summary_detailed and chunk_summary_brief (chunk)`,\n   340\t      },\n   341\t    };\n   342\t  }\n   343\t  const resolved = await resolveThreadRef(thread);\n   344\t  if (!resolved.ok) return resolved;\n   345\t  const { filePath } = resolved.value;\n   346\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   347\t\n   348\t  const opened = openThreadDatabase(filePath);\n   349\t  if (!opened.ok) return opened;\n   350\t  const db = opened.value;\n   351\t  try {\n   352\t    const meta = db\n   353\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   354\t      .get() as { thread_id: string } | undefined;\n   355\t    const threadId = meta?.thread_id ?? \"\";\n   356\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<RequeueOutcome> => {\n   357\t      const row = readTurnFormRow(ctx.db, target.subjectKind, target.subjectId, target.form);\n   358\t      if (row === undefined) {\n   359\t        return {\n   360\t          ok: false,\n   361\t          error: {\n   362\t            errorClass: \"caller_error\",\n   363\t            code: \"turn_not_found\",\n   364\t            reason: `no derived form ${target.form} exists for ${target.subjectKind} ${target.subjectId}`,\n   365\t          },\n   366\t        };\n   367\t      }\n   368\t      if (row.state === \"blocked\") {\n   369\t        // The refusal carries the form's stored reason — the damage named at\n   370\t        // blocking time, not a generic string (AC-4.6).\n   371\t        return {\n   372\t          ok: false,\n   373\t          error: {\n   374\t            errorClass: \"state_corruption\",\n   375\t            code: \"source_damaged\",\n   376\t            reason:\n   377\t              row.reason ??\n   378\t              `form ${target.form} for ${target.subjectKind} ${target.subjectId} is blocked`,\n   379\t          },\n   380\t        };\n   381\t      }\n   382\t      if (hasLiveItem(ctx.db, mapped.kind, mapped.sourceRef, row.sourceVersion)) {\n   383\t        return { ok: true, value: { noop: \"already_queued\" } };\n   384\t      }\n   385\t      const item = enqueue(ctx, {\n   386\t        owner: \"turns\",\n   387\t        kind: mapped.kind,\n   388\t        sourceRef: mapped.sourceRef,\n   389\t        sourceVersion: row.sourceVersion + 1,\n   390\t        forms: mapped.forms,\n   391\t      });\n   392\t      return { ok: true, value: { workItemId: item.workItemId } };\n   393\t    });\n   394\t  } catch (cause) {\n   395\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   396\t    return storageFailure(`requeue failed: ${reason}`);\n   397\t  } finally {\n   398\t    db.close();\n   399\t  }\n   400\t}\n   401\t\n   402\t// ── delete (Epic 02 Story 6, Flow 6) ─────────────────────────────\n   403\t\n   404\t// The whole-exchange removal (AC-6.4–6.7): \"that exchange was a dead end —\n   405\t// kill it.\" One transaction stamps the turn and all its live member\n   406\t// messages deleted, drops the turn's and members' derived forms, and\n   407\t// re-queues the containing chunk's summaries from the remaining live\n   408\t// members — or drops them when the chunk empties out (AC-6.6). The shared\n   409\t// machinery is the messages domain's cascade module (DD-8, one cascade,\n   410\t// two callers), reached through its public surface; this operation owns\n   411\t// the turn-side validation and the turn-row stamp. Source events are never\n   412\t// touched; chunk membership rows are never moved or re-cut — reads filter\n   413\t// the deleted turn out, shrinking the chunk in place. Refusals read the\n   414\t// filtered view: a missing, deleted, or double-deleted turn is\n   415\t// turn_not_found; an open turn is turn_open; a refusal changes nothing.\n   416\texport async function deleteTurn(\n   417\t  thread: ThreadRef,\n   418\t  input: { turnId: string },\n   419\t): Promise<OpResult<MutationResult>> {\n   420\t  const resolved = await resolveThreadRef(thread);\n   421\t  if (!resolved.ok) return resolved;\n   422\t  const { filePath } = resolved.value;\n   423\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   424\t\n   425\t  const opened = openThreadDatabase(filePath);\n   426\t  if (!opened.ok) return opened;\n   427\t  const db = opened.value;\n   428\t  try {\n   429\t    const meta = db\n   430\t      .prepare(`SELECT thread_id FROM thread_metadata WHERE id = 1`)\n   431\t      .get() as { thread_id: string } | undefined;\n   432\t    const threadId = meta?.thread_id ?? \"\";\n   433\t    return runInTransaction(db, () => new Date(), threadId, (ctx): OpResult<MutationResult> => {\n   434\t      const target = readMutableTurn(ctx.db, input.turnId);\n   435\t      if (target === undefined) {\n   436\t        return {\n   437\t          ok: false,\n   438\t          error: {\n   439\t            errorClass: \"caller_error\",\n   440\t            code: \"turn_not_found\",\n   441\t            reason: `no turn ${input.turnId} exists in this thread`,\n   442\t          },\n   443\t        };\n   444\t      }\n   445\t      if (target.status !== \"closed\") {\n   446\t        return {\n   447\t          ok: false,\n   448\t          error: {\n   449\t            errorClass: \"caller_error\",\n   450\t            code: \"turn_open\",\n   451\t            reason: `turn ${input.turnId} is open; open turns cannot be deleted (v1 boundary)`,\n   452\t          },\n   453\t        };\n   454\t      }\n   455\t      markTurnDeleted(ctx.db, input.turnId, ctx.clock().toISOString());\n   456\t      const cascade = applyTurnDeleteCascade(ctx, input.turnId);\n   457\t      return {\n   458\t        ok: true,\n   459\t        value: {\n   460\t          changed: { messageIds: cascade.memberMessageIds, turnIds: [input.turnId] },\n   461\t          cleared: cascade.cleared,\n   462\t          dropped: cascade.dropped,\n   463\t          queued: cascade.queued,\n   464\t          superseded: cascade.superseded,\n   465\t        },\n   466\t      };\n   467\t    });\n   468\t  } catch (cause) {\n   469\t    const reason = cause instanceof Error ? cause.message : String(cause);\n   470\t    return storageFailure(`delete failed: ${reason}`);\n   471\t  } finally {\n   472\t    db.close();\n   473\t  }\n   474\t}\n","exit_code":0,"status":"completed"}}

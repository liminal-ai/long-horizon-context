{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/inspect-overview.test.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Story 2 (Epic 04), default suite: TC-1.1–1.3 — the inspect overview.\n     2\t// One read-only call composing thread identity, event/message/turn/chunk\n     3\t// counts, derivation states, view summary, and visibility from the other\n     4\t// domains' surfaces. Every thread shape returns the FULL shape with absent\n     5\t// pieces as zeros/nulls (AC-1.3); counts honor the deleted contract\n     6\t// (AC-1.2); the read is pure (AC-1.4) — asserted as absence of delta and\n     7\t// zero provider calls, including under a throwing provider.\n     8\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     9\timport {\n    10\t  createSdk,\n    11\t  threadView,\n    12\t  type DerivationProvider,\n    13\t  type InspectOverview,\n    14\t  type Lhc,\n    15\t  type MessageEventInput,\n    16\t} from \"../src/index.js\";\n    17\timport {\n    18\t  createProviderDouble,\n    19\t  derivedThreadFixture,\n    20\t  expectReadOnly,\n    21\t  mutationInFlightVariant,\n    22\t  tempStore,\n    23\t  validEvent,\n    24\t  type TempStore,\n    25\t} from \"./fixtures/index.js\";\n    26\t\n    27\tlet store: TempStore;\n    28\tbeforeEach(() => {\n    29\t  store = tempStore();\n    30\t});\n    31\tafterEach(() => {\n    32\t  store.cleanup();\n    33\t});\n    34\t\n    35\t// A provider whose every operation throws: any inference reached through an\n    36\t// inspect read fails the test loudly (the suite-wide zero-provider assert\n    37\t// extended to the new operations).\n    38\tfunction throwingProvider(): DerivationProvider {\n    39\t  const refuse = (): never => {\n    40\t    throw new Error(\"provider must never be called by a read operation\");\n    41\t  };\n    42\t  return {\n    43\t    smoothPrompt: refuse,\n    44\t    summarizeToolCall: refuse,\n    45\t    summarizeToolResult: refuse,\n    46\t    composeTurnRendering: refuse,\n    47\t    projectLowerBand: refuse,\n    48\t    summarizeChunkDetailed: refuse,\n    49\t    summarizeChunkBrief: refuse,\n    50\t  };\n    51\t}\n    52\t\n    53\tinterface SmallThread {\n    54\t  filePath: string;\n    55\t  threadId: string;\n    56\t  sdk: Lhc;\n    57\t  double: ReturnType<typeof createProviderDouble>;\n    58\t}\n    59\t\n    60\t// Two closed turns through real intake, fully drained: m1 prompt, m2 text,\n    61\t// m3 call, m4 result (t1; turn_end is event 5), m6 prompt, m7 text (t2;\n    62\t// turn_end is event 8). Never compacted.\n    63\tasync function twoTurnThread(): Promise<SmallThread> {\n    64\t  const double = createProviderDouble();\n    65\t  const sdk = createSdk({ provider: double, mode: \"manual\" });\n    66\t  const filePath = store.threadPath();\n    67\t  const created = await sdk.threads.newThread({\n    68\t    filePath,\n    69\t    registryPath: store.registryPath,\n    70\t    title: \"overview fixture\",\n    71\t  });\n    72\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n    73\t  const batches: MessageEventInput[][] = [\n    74\t    [\n    75\t      validEvent(\"user_prompt\", { payload: { text: \"please read notes.txt\" } }),\n    76\t      validEvent(\"assistant_text\", { payload: { text: \"reading it now\" } }),\n    77\t      validEvent(\"tool_call\", {\n    78\t        payload: {\n    79\t          toolCallId: \"call-ov-1\",\n    80\t          toolName: \"read_file\",\n    81\t          arguments: { path: \"notes.txt\" },\n    82\t        },\n    83\t      }),\n    84\t      validEvent(\"tool_result\", {\n    85\t        payload: { toolCallId: \"call-ov-1\", content: \"contents of notes.txt\", isError: false },\n    86\t      }),\n    87\t      validEvent(\"turn_end\"),\n    88\t    ],\n    89\t    [\n    90\t      validEvent(\"user_prompt\", { payload: { text: \"summarize what you read\" } }),\n    91\t      validEvent(\"assistant_text\", { payload: { text: \"here is the summary\" } }),\n    92\t      validEvent(\"turn_end\"),\n    93\t    ],\n    94\t  ];\n    95\t  for (const batch of batches) {\n    96\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, batch);\n    97\t    if (!sent.ok) throw new Error(`fixture batch failed: ${sent.error.reason}`);\n    98\t  }\n    99\t  const drained = await sdk.work.drain({ filePath });\n   100\t  if (!drained.ok || drained.value.remaining !== 0) {\n   101\t    throw new Error(\"fixture drain left work behind\");\n   102\t  }\n   103\t  return { filePath, threadId: created.value.threadId, sdk, double };\n   104\t}\n   105\t\n   106\tfunction valueOf(result: { ok: boolean }): InspectOverview {\n   107\t  if (!result.ok) {\n   108\t    throw new Error(`expected ok overview: ${JSON.stringify(result)}`);\n   109\t  }\n   110\t  return (result as { ok: true; value: InspectOverview }).value;\n   111\t}\n   112\t\n   113\tconst ZERO_DERIVATION = { ready: 0, pending: 0, retrying: 0, failed: 0, blocked: 0 };\n   114\t\n   115\tdescribe(\"TC-1.1 / AC-1.1, AC-1.3: full overview shape across thread shapes\", () => {\n   116\t  it(\"fresh-empty: full shape with zeros and nulls, never omitted fields\", async () => {\n   117\t    const double = createProviderDouble();\n   118\t    const sdk = createSdk({ provider: double, mode: \"manual\" });\n   119\t    const filePath = store.threadPath();\n   120\t    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   121\t    expect(created.ok).toBe(true);\n   122\t    if (!created.ok) return;\n   123\t\n   124\t    const overview = valueOf(await sdk.inspect.overview({ filePath }));\n   125\t    expect(overview.thread.id).toBe(created.value.threadId);\n   126\t    expect(typeof overview.thread.createdAt).toBe(\"string\");\n   127\t    expect(overview.events).toEqual({ count: 0, span: null });\n   128\t    expect(overview.messages).toEqual({\n   129\t      visible: 0,\n   130\t      byKind: {},\n   131\t      deleted: 0,\n   132\t      visibleTokens: 0,\n   133\t    });\n   134\t    expect(overview.turns).toEqual({ open: 0, closed: 0 });\n   135\t    expect(overview.chunks).toEqual({ count: 0, unchunkedTurns: 0 });\n   136\t    expect(overview.derivation).toEqual(ZERO_DERIVATION);\n   137\t    expect(overview.view).toBeNull();\n   138\t    expect(overview.visibility).toEqual({ boundaryPosition: 0, zoneTokens: 0 });\n   139\t  });\n   140\t\n   141\t  it(\"mid-first-turn: open turn, queued derivation, no view — full shape\", async () => {\n   142\t    const double = createProviderDouble();\n   143\t    const sdk = createSdk({ provider: double, mode: \"manual\" });\n   144\t    const filePath = store.threadPath();\n   145\t    const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   146\t    expect(created.ok).toBe(true);\n   147\t    const sent = await sdk.intakeStream.messageEvents({ filePath }, [\n   148\t      validEvent(\"user_prompt\", { payload: { text: \"first prompt, turn still open\" } }),\n   149\t      validEvent(\"assistant_thinking\", { payload: { text: \"thinking about it\" } }),\n   150\t    ]);\n   151\t    expect(sent.ok).toBe(true);\n   152\t\n   153\t    const overview = valueOf(await sdk.inspect.overview({ filePath }));\n   154\t    expect(overview.events).toEqual({ count: 2, span: { first: 1, last: 2 } });\n   155\t    expect(overview.messages.visible).toBe(2);\n   156\t    expect(overview.messages.byKind).toEqual({ user_prompt: 1, assistant_thinking: 1 });\n   157\t    expect(overview.messages.deleted).toBe(0);\n   158\t    expect(overview.messages.visibleTokens).toBeGreaterThan(0);\n   159\t    expect(overview.turns).toEqual({ open: 1, closed: 0 });\n   160\t    expect(overview.chunks).toEqual({ count: 0, unchunkedTurns: 0 });\n   161\t    // The prompt's smoothing sits queued, never attempted: pending.\n   162\t    expect(overview.derivation).toEqual({ ...ZERO_DERIVATION, pending: 1 });\n   163\t    expect(overview.view).toBeNull();\n   164\t    expect(overview.visibility.boundaryPosition).toBe(0);\n   165\t  });\n   166\t\n   167\t  it(\"never-compacted-with-record: real counts, view null\", async () => {\n   168\t    const { filePath, threadId, sdk } = await twoTurnThread();\n   169\t    const overview = valueOf(await sdk.inspect.overview({ filePath }));\n   170\t    expect(overview.thread.id).toBe(threadId);\n   171\t    expect(overview.events).toEqual({ count: 8, span: { first: 1, last: 8 } });\n   172\t    expect(overview.messages.visible).toBe(6);\n   173\t    expect(overview.messages.byKind).toEqual({\n   174\t      user_prompt: 2,\n   175\t      assistant_text: 2,\n   176\t      tool_call: 1,\n   177\t      tool_result: 1,\n   178\t    });\n   179\t    expect(overview.messages.deleted).toBe(0);\n   180\t    expect(overview.turns).toEqual({ open: 0, closed: 2 });\n   181\t    // Both closed turns placed by their derivations into the one open chunk.\n   182\t    expect(overview.chunks).toEqual({ count: 1, unchunkedTurns: 0 });\n   183\t    // 2 smoothings + 1 call summary + 1 result summary + 2 turns × 2 forms.\n   184\t    expect(overview.derivation).toEqual({ ...ZERO_DERIVATION, ready: 8 });\n   185\t    expect(overview.view).toBeNull();\n   186\t  });\n   187\t\n   188\t  it(\"compacted tool-heavy fixture: exact counts in every section\", async () => {\n   189\t    const fixture = await derivedThreadFixture(store);\n   190\t    const { filePath, sdk } = fixture;\n   191\t    // sweep: false keeps the two manufactured failed states failed — the\n   192\t    // default sweep would requeue the transient one and move the counts.\n   193\t    const compacted = await sdk.threadView.compact({ filePath }, { sweep: false });\n   194\t    expect(compacted.ok).toBe(true);\n   195\t    if (!compacted.ok) return;\n   196\t\n   197\t    const overview = valueOf(await sdk.inspect.overview({ filePath }));\n   198\t    // 8 plain turns × 4 events + 4 tool-heavy turns × 8 events.\n   199\t    expect(overview.events).toEqual({ count: 64, span: { first: 1, last: 64 } });\n   200\t    // Messages: events minus the 12 turn_ends.\n   201\t    expect(overview.messages.visible).toBe(52);\n   202\t    expect(overview.messages.byKind).toEqual({\n   203\t      user_prompt: 12,\n   204\t      assistant_thinking: 12,\n   205\t      assistant_text: 12,\n   206\t      tool_call: 8,\n   207\t      tool_result: 8,\n   208\t    });\n   209\t    expect(overview.messages.deleted).toBe(0);\n   210\t    expect(overview.messages.visibleTokens).toBeGreaterThan(0);\n   211\t    expect(overview.turns).toEqual({ open: 0, closed: 12 });\n   212\t    expect(overview.chunks).toEqual({ count: 4, unchunkedTurns: 0 });\n   213\t    // 12 smoothings + 8 call summaries + 6 ready result summaries + 24 turn\n   214\t    // forms + 6 chunk summaries ready; the scripted transient and permanent\n   215\t    // exhaustions stay failed.\n   216\t    expect(overview.derivation).toEqual({ ...ZERO_DERIVATION, ready: 56, failed: 2 });\n   217\t    expect(overview.view).toEqual({\n   218\t      viewId: compacted.value.viewId,\n   219\t      createdAt: expect.any(String),\n   220\t      compactPoint: compacted.value.compactPoint,\n   221\t      coveredFrom: compacted.value.coveredFrom,\n   222\t    });\n   223\t    // Visibility mirrors the serving surface: the stored boundary pull\n   224\t    // reports and the zone sum status computes live.\n   225\t    const pulled = await threadView.pull({ filePath });\n   226\t    const status = await sdk.threadView.status({ filePath });\n   227\t    expect(pulled.ok && status.ok).toBe(true);\n   228\t    if (!pulled.ok || !status.ok) return;\n   229\t    expect(overview.visibility).toEqual({\n   230\t      boundaryPosition: pulled.value.meta.boundaryPosition,\n   231\t      zoneTokens: status.value.visibility.zoneTokens,\n   232\t    });\n   233\t  });\n   234\t\n   235\t  it(\"mid-rebuild: cleared cascade pending, view summary intact — full shape\", async () => {\n   236\t    const fixture = await mutationInFlightVariant(store);\n   237\t    const overview = valueOf(await fixture.sdk.inspect.overview({ filePath: fixture.filePath }));\n   238\t    // The edit cleared exactly the cascade set — its own smoothing, t2's two\n   239\t    // turn forms, c1's two chunk summaries — all pending, drain not settled.\n   240\t    expect(fixture.mutation.cleared).toHaveLength(5);\n   241\t    expect(overview.derivation).toEqual({ ...ZERO_DERIVATION, ready: 53, pending: 5 });\n   242\t    expect(overview.turns).toEqual({ open: 0, closed: 12 });\n   243\t    expect(overview.chunks).toEqual({ count: 4, unchunkedTurns: 0 });\n   244\t    // The view is the pre-edit compact's snapshot, untouched by the mutation.\n   245\t    expect(overview.view).toEqual({\n   246\t      viewId: fixture.compactReceipt.viewId,\n   247\t      createdAt: expect.any(String),\n   248\t      compactPoint: fixture.compactReceipt.compactPoint,\n   249\t      coveredFrom: fixture.compactReceipt.coveredFrom,\n   250\t    });\n   251\t    expect(overview.events.count).toBe(64);\n   252\t    expect(overview.messages.visible).toBe(52);\n   253\t  });\n   254\t});\n   255\t\n   256\tdescribe(\"TC-1.2 / AC-1.2: deleted accounting\", () => {\n   257\t  it(\"deleting one message drops visible/kind/token counts, raises deleted, leaves events alone\", async () => {\n   258\t    const { filePath, sdk } = await twoTurnThread();\n   259\t    const before = valueOf(await sdk.inspect.overview({ filePath }));\n   260\t\n   261\t    const listed = await sdk.messages.listMessages({ filePath });\n   262\t    expect(listed.ok).toBe(true);\n   263\t    if (!listed.ok) return;\n   264\t    const target = listed.value.find((record) => record.messageId === \"m2\");\n   265\t    expect(target?.kind).toBe(\"assistant_text\");\n   266\t    if (target === undefined) return;\n   267\t\n   268\t    const deleted = await sdk.messages.deleteMessage({ filePath }, { messageId: \"m2\" });\n   269\t    expect(deleted.ok).toBe(true);\n   270\t\n   271\t    const after = valueOf(await sdk.inspect.overview({ filePath }));\n   272\t    expect(after.messages.visible).toBe(before.messages.visible - 1);\n   273\t    expect(after.messages.deleted).toBe(1);\n   274\t    expect(after.messages.byKind).toEqual({\n   275\t      ...before.messages.byKind,\n   276\t      assistant_text: (before.messages.byKind[\"assistant_text\"] ?? 0) - 1,\n   277\t    });\n   278\t    expect(after.messages.visibleTokens).toBe(\n   279\t      before.messages.visibleTokens - target.tokenEstimate,\n   280\t    );\n   281\t    // The record retains everything: event count and span are unaffected.\n   282\t    expect(after.events).toEqual(before.events);\n   283\t  });\n   284\t});\n   285\t\n   286\tdescribe(\"TC-1.3 / AC-1.4: overview is a pure read\", () => {\n   287\t  it(\"repeated calls are deep-equal, leave no delta, create no work, call no provider\", async () => {\n   288\t    const fixture = await mutationInFlightVariant(store);\n   289\t    const { filePath, sdk, double } = fixture;\n   290\t    const captured = double.captureInputs();\n   291\t\n   292\t    // Both calls under the read-only delta assert (DD-6): observable state —\n   293\t    // queued work, boundary/zone, view identity, events, messages, forms —\n   294\t    // is snapshot-equal around each read. No work_item rows can appear under\n   295\t    // a green delta (queued work is part of the snapshot).\n   296\t    const first = await expectReadOnly(filePath, () => sdk.inspect.overview({ filePath }));\n   297\t    const second = await expectReadOnly(filePath, () => sdk.inspect.overview({ filePath }));\n   298\t    expect(first.ok && second.ok).toBe(true);\n   299\t    expect(second).toEqual(first);\n   300\t    expect(captured).toHaveLength(0);\n   301\t  });\n   302\t\n   303\t  it(\"overview succeeds under a throwing provider, and wraps Story 1's reads in the delta assert\", async () => {\n   304\t    const { filePath } = await twoTurnThread();\n   305\t    // A separate SDK whose provider throws on contact: the read path is\n   306\t    // provider-free structurally, in both the new and the Story 1 surfaces.\n   307\t    const reader = createSdk({ provider: throwingProvider(), mode: \"manual\" });\n   308\t\n   309\t    const overview = await expectReadOnly(filePath, () =>\n   310\t      reader.inspect.overview({ filePath }),\n   311\t    );\n   312\t    expect(overview.ok).toBe(true);\n   313\t    // Retroactive wrap (test plan, Chunk 2): the Chunk 1 read surface runs\n   314\t    // under the same shared delta helper.\n   315\t    const listed = await expectReadOnly(filePath, () =>\n   316\t      reader.messages.listMessages({ filePath }, { includeDeleted: true }),\n   317\t    );\n   318\t    const shown = await expectReadOnly(filePath, () => reader.messages.show({ filePath }, \"m1\"));\n   319\t    expect(listed.ok && shown.ok).toBe(true);\n   320\t  });\n   321\t\n   322\t  it(\"overview on a missing thread is thread_not_found, not a shape error\", async () => {\n   323\t    const sdk = createSdk({ provider: createProviderDouble(), mode: \"manual\" });\n   324\t    const missing = await sdk.inspect.overview({ filePath: store.threadPath(\"missing\") });\n   325\t    expect(missing.ok).toBe(false);\n   326\t    if (missing.ok) return;\n   327\t    expect(missing.error.errorClass).toBe(\"caller_error\");\n   328\t    expect(missing.error.code).toBe(\"thread_not_found\");\n   329\t  });\n   330\t});\n","exit_code":0,"status":"completed"}}

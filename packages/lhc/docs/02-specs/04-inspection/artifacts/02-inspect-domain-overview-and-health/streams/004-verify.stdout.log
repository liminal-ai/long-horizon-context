t      if (flags.registryPath !== undefined) input.registryPath = flags.registryPath;\n   248\t      return renderResult(await threads.resolve(input));\n   249\t    }\n   250\t    case \"threads list\": {\n   251\t      return renderResult(\n   252\t        await threads.listThreads(\n   253\t          flags.registryPath !== undefined ? { registryPath: flags.registryPath } : undefined,\n   254\t        ),\n   255\t      );\n   256\t    }\n   257\t    case \"intake-stream message-events\": {\n   258\t      if (flags.threadId === undefined && flags.filePath === undefined) {\n   259\t        return renderCliError(\n   260\t          \"caller_error\",\n","exit_code":0,"status":"completed"}}

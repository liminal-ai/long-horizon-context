{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/threads/index.ts | sed -n '1,280p'\"","aggregated_output":"     1\timport { existsSync } from \"node:fs\";\n     2\timport { runWithThreadTouchSuppressed } from \"../../shared/context.js\";\n     3\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n     4\timport {\n     5\t  createThreadFile,\n     6\t  deleteThreadFile,\n     7\t  generateThreadId,\n     8\t  openThreadDatabase,\n     9\t} from \"./internal/create.js\";\n    10\t\n    11\t// Re-exported for the other domain surfaces: opening a thread file through\n    12\t// the threads domain is what guarantees its schema is current (a pre-Story-3\n    13\t// file gains the message tables here before any write or read touches them).\n    14\texport { openThreadDatabase };\n    15\timport {\n    16\t  insertThreadRow,\n    17\t  openRegistryForRead,\n    18\t  openRegistryForWrite,\n    19\t  resolveRegistryPath,\n    20\t  selectAllThreadRows,\n    21\t  selectThreadRow,\n    22\t  type RegistryRow,\n    23\t} from \"./internal/registry.js\";\n    24\t\n    25\texport type ThreadRef =\n    26\t  | { threadId: string; registryPath?: string }\n    27\t  | { filePath: string };\n    28\t\n    29\texport interface NewThreadInput {\n    30\t  filePath: string;\n    31\t  title?: string;\n    32\t  registryPath?: string;\n    33\t}\n    34\t\n    35\texport interface ThreadInfo {\n    36\t  threadId: string;\n    37\t  filePath: string;\n    38\t  title?: string;\n    39\t  createdAt: string; // ISO-8601\n    40\t}\n    41\t\n    42\tfunction toThreadInfo(row: RegistryRow): ThreadInfo {\n    43\t  const info: ThreadInfo = {\n    44\t    threadId: row.threadId,\n    45\t    filePath: row.filePath,\n    46\t    createdAt: row.createdAt,\n    47\t  };\n    48\t  if (row.title !== undefined) info.title = row.title;\n    49\t  return info;\n    50\t}\n    51\t\n    52\tfunction threadNotFound(threadId: string): { ok: false; error: ErrorResult } {\n    53\t  return {\n    54\t    ok: false,\n    55\t    error: {\n    56\t      errorClass: \"caller_error\",\n    57\t      code: \"thread_not_found\",\n    58\t      reason: `no thread registered with id ${threadId}`,\n    59\t    },\n    60\t  };\n    61\t}\n    62\t\n    63\tfunction invalidThreadRef(reason: string): { ok: false; error: ErrorResult } {\n    64\t  return {\n    65\t    ok: false,\n    66\t    error: { errorClass: \"caller_error\", code: \"invalid_thread_ref\", reason },\n    67\t  };\n    68\t}\n    69\t\n    70\t// A file path that is empty or whitespace-only cannot name a durable file:\n    71\t// node:sqlite's DatabaseSync(\"\") opens a temporary database that vanishes on\n    72\t// close, so such a path must be refused as a caller error before any storage\n    73\t// is touched rather than silently producing a thread with no durable file.\n    74\tfunction isBlankPath(filePath: string): boolean {\n    75\t  return filePath.trim() === \"\";\n    76\t}\n    77\t\n    78\tfunction detail(cause: unknown): string {\n    79\t  return cause instanceof Error ? cause.message : String(cause);\n    80\t}\n    81\t\n    82\t// Creation spans two databases that cannot share a transaction. Order is\n    83\t// file-then-row with compensation: the invariant \"no registry row without\n    84\t// its file\" is absolute; an orphan file from a crash between the writes is\n    85\t// documented harmless (design decision 2).\n    86\texport async function newThread(\n    87\t  input: NewThreadInput,\n    88\t): Promise<OpResult<{ threadId: string; filePath: string }>> {\n    89\t  // Guard before any storage touch: an empty/blank path would otherwise open\n    90\t  // a temp database and register a thread with no durable file (the no-row-\n    91\t  // without-file invariant below depends on the path naming a real file).\n    92\t  if (isBlankPath(input.filePath)) {\n    93\t    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n    94\t  }\n    95\t  if (existsSync(input.filePath)) {\n    96\t    return {\n    97\t      ok: false,\n    98\t      error: {\n    99\t        errorClass: \"caller_error\",\n   100\t        code: \"path_exists\",\n   101\t        reason: `a file already exists at ${input.filePath}`,\n   102\t      },\n   103\t    };\n   104\t  }\n   105\t\n   106\t  const threadId = generateThreadId();\n   107\t  const createdAt = new Date().toISOString();\n   108\t\n   109\t  try {\n   110\t    createThreadFile(input.filePath, threadId, createdAt);\n   111\t  } catch (cause) {\n   112\t    deleteThreadFile(input.filePath);\n   113\t    return storageFailure(`thread file creation failed: ${detail(cause)}`);\n   114\t  }\n   115\t\n   116\t  let registry;\n   117\t  try {\n   118\t    registry = openRegistryForWrite(resolveRegistryPath(input.registryPath));\n   119\t    const row: RegistryRow = { threadId, filePath: input.filePath, createdAt };\n   120\t    if (input.title !== undefined) row.title = input.title;\n   121\t    insertThreadRow(registry, row);\n   122\t  } catch (cause) {\n   123\t    deleteThreadFile(input.filePath);\n   124\t    return storageFailure(`registry insert failed: ${detail(cause)}`);\n   125\t  } finally {\n   126\t    registry?.close();\n   127\t  }\n   128\t\n   129\t  return { ok: true, value: { threadId, filePath: input.filePath } };\n   130\t}\n   131\t\n   132\texport async function resolve(input: {\n   133\t  threadId: string;\n   134\t  registryPath?: string;\n   135\t}): Promise<OpResult<ThreadInfo>> {\n   136\t  let registry;\n   137\t  try {\n   138\t    registry = openRegistryForRead(resolveRegistryPath(input.registryPath));\n   139\t    if (registry === null) return threadNotFound(input.threadId);\n   140\t    const row = selectThreadRow(registry, input.threadId);\n   141\t    if (row === undefined) return threadNotFound(input.threadId);\n   142\t    return { ok: true, value: toThreadInfo(row) };\n   143\t  } catch (cause) {\n   144\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n   145\t  } finally {\n   146\t    registry?.close();\n   147\t  }\n   148\t}\n   149\t\n   150\texport async function listThreads(input?: {\n   151\t  registryPath?: string;\n   152\t}): Promise<OpResult<ThreadInfo[]>> {\n   153\t  let registry;\n   154\t  try {\n   155\t    registry = openRegistryForRead(resolveRegistryPath(input?.registryPath));\n   156\t    if (registry === null) return { ok: true, value: [] };\n   157\t    return { ok: true, value: selectAllThreadRows(registry).map(toThreadInfo) };\n   158\t  } catch (cause) {\n   159\t    return storageFailure(`registry read failed: ${detail(cause)}`);\n   160\t  } finally {\n   161\t    registry?.close();\n   162\t  }\n   163\t}\n   164\t\n   165\t// The thread file's own identity header (Epic 04): thread_metadata is this\n   166\t// domain's table — creation writes it (internal/create.ts) and only this\n   167\t// surface reads it back. Added for inspect's overview, which must report\n   168\t// thread identity for ANY resolvable ref — including a { filePath } ref that\n   169\t// no registry knows — without reading tables itself (inspect's must-not-own\n   170\t// rule). A pure read: the whole operation runs touch-suppressed (DD-6), so a\n   171\t// background SDK can never hang a first-touch catch-up drain off it.\n   172\texport interface ThreadFileInfo {\n   173\t  threadId: string;\n   174\t  createdAt: string;\n   175\t}\n   176\t\n   177\texport async function info(ref: ThreadRef): Promise<OpResult<ThreadFileInfo>> {\n   178\t  return runWithThreadTouchSuppressed(() => infoInner(ref));\n   179\t}\n   180\t\n   181\tasync function infoInner(ref: ThreadRef): Promise<OpResult<ThreadFileInfo>> {\n   182\t  const resolved = await resolveThreadRef(ref);\n   183\t  if (!resolved.ok) return resolved;\n   184\t  const { filePath } = resolved.value;\n   185\t  if (!existsSync(filePath)) {\n   186\t    return {\n   187\t      ok: false,\n   188\t      error: {\n   189\t        errorClass: \"caller_error\",\n   190\t        code: \"thread_not_found\",\n   191\t        reason: `no thread file exists at ${filePath}`,\n   192\t      },\n   193\t    };\n   194\t  }\n   195\t  const opened = openThreadDatabase(filePath);\n   196\t  if (!opened.ok) return opened;\n   197\t  const db = opened.value;\n   198\t  try {\n   199\t    const row = db\n   200\t      .prepare(`SELECT thread_id, created_at FROM thread_metadata WHERE id = 1`)\n   201\t      .get() as { thread_id: string; created_at: string } | undefined;\n   202\t    if (row === undefined) {\n   203\t      // openThreadDatabase validated the row exists; its absence here is\n   204\t      // external interference between the probe and this read.\n   205\t      return storageFailure(`thread file at ${filePath} lost its metadata row`);\n   206\t    }\n   207\t    return { ok: true, value: { threadId: row.thread_id, createdAt: row.created_at } };\n   208\t  } catch (cause) {\n   209\t    return storageFailure(`thread info read failed: ${detail(cause)}`);\n   210\t  } finally {\n   211\t    db.close();\n   212\t  }\n   213\t}\n   214\t\n   215\t// The single interpreter of thread references: { threadId } resolves to a\n   216\t// path through the registry, { filePath } passes through untouched. No other\n   217\t// code ever reads a thread reference.\n   218\texport async function resolveThreadRef(\n   219\t  ref: ThreadRef,\n   220\t): Promise<OpResult<{ filePath: string }>> {\n   221\t  if (\"threadId\" in ref) {\n   222\t    const resolved = await resolve(ref);\n   223\t    if (!resolved.ok) return resolved;\n   224\t    return { ok: true, value: { filePath: resolved.value.filePath } };\n   225\t  }\n   226\t  // Mirror newThread's guard so every read surface that routes through here\n   227\t  // fails closed on a blank path instead of opening a temp database.\n   228\t  if (isBlankPath(ref.filePath)) {\n   229\t    return invalidThreadRef(\"filePath must be a non-empty path; received a blank string\");\n   230\t  }\n   231\t  return { ok: true, value: { filePath: ref.filePath } };\n   232\t}\n","exit_code":0,"status":"completed"}}

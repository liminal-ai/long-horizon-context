{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/inspect-health.test.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Story 2 (Epic 04), default suite: TC-4.1–4.3 — the inspect health report.\n     2\t// Counts by owner/kind/state assembled entirely from the owners' report\n     3\t// surfaces (AC-4.1), actionable failure detail (AC-4.2), a repair preview\n     4\t// that is reported and never executed (AC-4.3), rebuild visibility bracketing\n     5\t// a drain (AC-4.4), and live queue visibility consistent with the state\n     6\t// counts in the same report (AC-4.5).\n     7\timport { afterEach, beforeEach, describe, expect, it } from \"vitest\";\n     8\timport { createSdk, type HealthReport } from \"../src/index.js\";\n     9\timport {\n    10\t  createProviderDouble,\n    11\t  expectReadOnly,\n    12\t  mixedStateVariantThread,\n    13\t  mutationInFlightVariant,\n    14\t  PERMANENT_FAILURE_REASON,\n    15\t  tempStore,\n    16\t  TRANSIENT_EXHAUST_REASON,\n    17\t  type TempStore,\n    18\t} from \"./fixtures/index.js\";\n    19\t\n    20\tlet store: TempStore;\n    21\tbeforeEach(() => {\n    22\t  store = tempStore();\n    23\t});\n    24\tafterEach(() => {\n    25\t  store.cleanup();\n    26\t});\n    27\t\n    28\tfunction valueOf(result: { ok: boolean }): HealthReport {\n    29\t  if (!result.ok) {\n    30\t    throw new Error(`expected ok health report: ${JSON.stringify(result)}`);\n    31\t  }\n    32\t  return (result as { ok: true; value: HealthReport }).value;\n    33\t}\n    34\t\n    35\tconst ZERO = { ready: 0, pending: 0, retrying: 0, failed: 0, blocked: 0 };\n    36\t\n    37\tdescribe(\"TC-4.1 / AC-4.1, AC-4.5: counts per owner/kind/state and queue consistency\", () => {\n    38\t  it(\"the mixed-state fixture reports exact counts and a queue section consistent with them\", async () => {\n    39\t    const fixture = await mixedStateVariantThread(store);\n    40\t    const { filePath, sdk } = fixture;\n    41\t\n    42\t    const health = await expectReadOnly(filePath, () => sdk.inspect.health({ filePath }));\n    43\t    expect(health.ok).toBe(true);\n    44\t    if (!health.ok) return;\n    45\t    const report = health.value;\n    46\t\n    47\t    // Every owner/kind/state count, exact, in deterministic order: 13 turns'\n    48\t    // smoothings ready + t14's pending; the tool-heavy middle's summaries\n    49\t    // with the two scripted failures; t13's turn forms blocked on the real\n    50\t    // source damage; the three closed chunks' summaries ready.\n    51\t    expect(report.owners).toEqual([\n    52\t      { owner: \"messages\", kind: \"smoothed_prompt\", counts: { ...ZERO, ready: 13, pending: 1 } },\n    53\t      { owner: \"messages\", kind: \"tool_call_summary\", counts: { ...ZERO, ready: 8 } },\n    54\t      { owner: \"messages\", kind: \"tool_result_summary\", counts: { ...ZERO, ready: 6, failed: 2 } },\n    55\t      { owner: \"turns\", kind: \"chunk_summary_brief\", counts: { ...ZERO, ready: 3 } },\n    56\t      { owner: \"turns\", kind: \"chunk_summary_detailed\", counts: { ...ZERO, ready: 3 } },\n    57\t      { owner: \"turns\", kind: \"lower_band_projection\", counts: { ...ZERO, ready: 12, blocked: 1 } },\n    58\t      { owner: \"turns\", kind: \"turn_rendering\", counts: { ...ZERO, ready: 12, blocked: 1 } },\n    59\t    ]);\n    60\t\n    61\t    // Queue visibility from the same report's live joins: exactly the one\n    62\t    // still-queued smoothing item, consistent with the pending count.\n    63\t    expect(report.queue).toEqual({ queued: 1, claimed: 0 });\n    64\t    const pendingTotal = report.owners.reduce(\n    65\t      (sum, row) => sum + row.counts.pending + row.counts.retrying,\n    66\t      0,\n    67\t    );\n    68\t    expect(report.queue.queued + report.queue.claimed).toBe(pendingTotal);\n    69\t  });\n    70\t});\n    71\t\n    72\tdescribe(\"TC-4.2 / AC-4.2, AC-4.3: failure detail and repair preview\", () => {\n    73\t  it(\"failed entries carry exact detail; the preview is exactly the failed-not-blocked set\", async () => {\n    74\t    const fixture = await mixedStateVariantThread(store);\n    75\t    const { filePath, sdk } = fixture;\n    76\t    const report = valueOf(await sdk.inspect.health({ filePath }));\n    77\t\n    78\t    // Actionable failure detail: subject, form, reason, attempts, last error\n    79\t    // — enough to target a requeue without raw SQL.\n    80\t    const failed = report.failures.filter((entry) => entry.reason.startsWith(\"rate_limit\") || entry.reason.startsWith(\"content_refusal\"));\n    81\t    expect(failed).toEqual([\n    82\t      {\n    83\t        owner: \"messages\",\n    84\t        subjectKind: \"message\",\n    85\t        subjectId: fixture.failedTransientMessageId,\n    86\t        form: \"tool_result_summary\",\n    87\t        reason: TRANSIENT_EXHAUST_REASON,\n    88\t        attempts: 3,\n    89\t        lastError: TRANSIENT_EXHAUST_REASON,\n    90\t      },\n    91\t      {\n    92\t        owner: \"messages\",\n    93\t        subjectKind: \"message\",\n    94\t        subjectId: fixture.failedPermanentMessageId,\n    95\t        form: \"tool_result_summary\",\n    96\t        reason: PERMANENT_FAILURE_REASON,\n    97\t        attempts: 1,\n    98\t        lastError: PERMANENT_FAILURE_REASON,\n    99\t      },\n   100\t    ]);\n   101\t\n   102\t    // Blocked forms surface as failures too — with the damage named — but\n   103\t    // never as repair targets.\n   104\t    const blocked = report.failures.filter((entry) => !failed.includes(entry));\n   105\t    expect(blocked.map((entry) => [entry.owner, entry.subjectKind, entry.subjectId, entry.form])).toEqual([\n   106\t      [\"turns\", \"turn\", fixture.blockedTurnId, \"lower_band_projection\"],\n   107\t      [\"turns\", \"turn\", fixture.blockedTurnId, \"turn_rendering\"],\n   108\t    ]);\n   109\t    for (const entry of blocked) {\n   110\t      expect(entry.reason.length).toBeGreaterThan(0);\n   111\t    }\n   112\t\n   113\t    // The preview lists exactly the failed-and-not-blocked set, in report\n   114\t    // order — and previews only: the read changed nothing (the delta assert\n   115\t    // in TC-4.1 covers the same operation).\n   116\t    expect(report.repairPreview).toEqual([\n   117\t      {\n   118\t        owner: \"messages\",\n   119\t        subjectKind: \"message\",\n   120\t        subjectId: fixture.failedTransientMessageId,\n   121\t        form: \"tool_result_summary\",\n   122\t      },\n   123\t      {\n   124\t        owner: \"messages\",\n   125\t        subjectKind: \"message\",\n   126\t        subjectId: fixture.failedPermanentMessageId,\n   127\t        form: \"tool_result_summary\",\n   128\t      },\n   129\t    ]);\n   130\t\n   131\t    // Never executed: the failed forms are still failed on a second read —\n   132\t    // health did not requeue what it previewed.\n   133\t    const again = valueOf(await sdk.inspect.health({ filePath }));\n   134\t    expect(again).toEqual(report);\n   135\t  });\n   136\t});\n   137\t\n   138\tdescribe(\"TC-4.3 / AC-4.4: rebuild visibility brackets a drain\", () => {\n   139\t  it(\"after an edit the cascade's cleared set is pending with queued work; after the drain the same set is ready; nothing else moved\", async () => {\n   140\t    const fixture = await mutationInFlightVariant(store);\n   141\t    const { filePath, sdk } = fixture;\n   142\t\n   143\t    // The cascade contract's exact cleared set: the prompt's own smoothing,\n   144\t    // t2's two turn forms, c1's two chunk summaries.\n   145\t    const clearedKeys = fixture.mutation.cleared\n   146\t      .map((target) => `${target.subjectKind}:${target.subjectId}:${target.form}`)\n   147\t      .sort();\n   148\t    expect(clearedKeys).toEqual(\n   149\t      [\n   150\t        `message:${fixture.editedMessageId}:smoothed_prompt`,\n   151\t        \"turn:t2:turn_rendering\",\n   152\t        \"turn:t2:lower_band_projection\",\n   153\t        \"chunk:c1:chunk_summary_detailed\",\n   154\t        \"chunk:c1:chunk_summary_brief\",\n   155\t      ].sort(),\n   156\t    );\n   157\t\n   158\t    const before = valueOf(await expectReadOnly(filePath, () => sdk.inspect.health({ filePath })));\n   159\t    // The cleared set reads pending — one per owner/kind — with its queued\n   160\t    // replacement work visible, and every form outside the cascade still\n   161\t    // ready (failures-free fixture: full counts minus the cascade).\n   162\t    expect(before.owners).toEqual([\n   163\t      { owner: \"messages\", kind: \"smoothed_prompt\", counts: { ...ZERO, ready: 11, pending: 1 } },\n   164\t      { owner: \"messages\", kind: \"tool_call_summary\", counts: { ...ZERO, ready: 8 } },\n   165\t      { owner: \"messages\", kind: \"tool_result_summary\", counts: { ...ZERO, ready: 8 } },\n   166\t      { owner: \"turns\", kind: \"chunk_summary_brief\", counts: { ...ZERO, ready: 2, pending: 1 } },\n   167\t      { owner: \"turns\", kind: \"chunk_summary_detailed\", counts: { ...ZERO, ready: 2, pending: 1 } },\n   168\t      { owner: \"turns\", kind: \"lower_band_projection\", counts: { ...ZERO, ready: 11, pending: 1 } },\n   169\t      { owner: \"turns\", kind: \"turn_rendering\", counts: { ...ZERO, ready: 11, pending: 1 } },\n   170\t    ]);\n   171\t    // Queued work visible and consistent: 4 replacement items — smoothing,\n   172\t    // turn derivation (two forms), two chunk summaries — join onto the 5\n   173\t    // pending entries.\n   174\t    expect(before.queue).toEqual({ queued: 5, claimed: 0 });\n   175\t    expect(before.failures).toEqual([]);\n   176\t    expect(before.repairPreview).toEqual([]);\n   177\t\n   178\t    // The exact pending subjects per the cascade contract, read through the\n   179\t    // owners' surfaces health composes.\n   180\t    const messagesPending = await sdk.messages.report({ filePath }, { notReady: true });\n   181\t    const turnsPending = await sdk.turns.report({ filePath }, { notReady: true });\n   182\t    expect(messagesPending.ok && turnsPending.ok).toBe(true);\n   183\t    if (!messagesPending.ok || !turnsPending.ok) return;\n   184\t    const pendingKeys = [...messagesPending.value, ...turnsPending.value]\n   185\t      .filter((entry) => entry.state === \"pending\")\n   186\t      .map((entry) => `${entry.subjectKind}:${entry.subjectId}:${entry.form}`)\n   187\t      .sort();\n   188\t    expect(pendingKeys).toEqual(clearedKeys);\n   189\t\n   190\t    // Drain the queued rebuilds and wait the scheduler out.\n   191\t    const drained = await sdk.work.drain({ filePath });\n   192\t    expect(drained.ok).toBe(true);\n   193\t    await sdk.drainSettled({ filePath });\n   194\t\n   195\t    // The same set reads ready; counts return to the full fixture totals;\n   196\t    // queue empty — two reads bracket the rebuild.\n   197\t    const after = valueOf(await sdk.inspect.health({ filePath }));\n   198\t    expect(after.owners).toEqual([\n   199\t      { owner: \"messages\", kind: \"smoothed_prompt\", counts: { ...ZERO, ready: 12 } },\n   200\t      { owner: \"messages\", kind: \"tool_call_summary\", counts: { ...ZERO, ready: 8 } },\n   201\t      { owner: \"messages\", kind: \"tool_result_summary\", counts: { ...ZERO, ready: 8 } },\n   202\t      { owner: \"turns\", kind: \"chunk_summary_brief\", counts: { ...ZERO, ready: 3 } },\n   203\t      { owner: \"turns\", kind: \"chunk_summary_detailed\", counts: { ...ZERO, ready: 3 } },\n   204\t      { owner: \"turns\", kind: \"lower_band_projection\", counts: { ...ZERO, ready: 12 } },\n   205\t      { owner: \"turns\", kind: \"turn_rendering\", counts: { ...ZERO, ready: 12 } },\n   206\t    ]);\n   207\t    expect(after.queue).toEqual({ queued: 0, claimed: 0 });\n   208\t    expect(after.failures).toEqual([]);\n   209\t  });\n   210\t});\n   211\t\n   212\tdescribe(\"architecture risk: health is provider-free and surface-composed\", () => {\n   213\t  it(\"health succeeds under a throwing provider and calls no provider on the fixture SDK\", async () => {\n   214\t    const fixture = await mixedStateVariantThread(store);\n   215\t    const captured = fixture.double.captureInputs();\n   216\t\n   217\t    const refuse = (): never => {\n   218\t      throw new Error(\"provider must never be called by a read operation\");\n   219\t    };\n   220\t    const reader = createSdk({\n   221\t      provider: {\n   222\t        smoothPrompt: refuse,\n   223\t        summarizeToolCall: refuse,\n   224\t        summarizeToolResult: refuse,\n   225\t        composeTurnRendering: refuse,\n   226\t        projectLowerBand: refuse,\n   227\t        summarizeChunkDetailed: refuse,\n   228\t        summarizeChunkBrief: refuse,\n   229\t      },\n   230\t      mode: \"manual\",\n   231\t    });\n   232\t    const health = await expectReadOnly(fixture.filePath, () =>\n   233\t      reader.inspect.health({ filePath: fixture.filePath }),\n   234\t    );\n   235\t    expect(health.ok).toBe(true);\n   236\t    expect(captured).toHaveLength(0);\n   237\t  });\n   238\t});\n","exit_code":0,"status":"completed"}}

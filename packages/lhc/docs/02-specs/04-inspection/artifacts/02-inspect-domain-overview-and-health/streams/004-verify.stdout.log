{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/index.ts | sed -n '1,220p'\"","aggregated_output":"     1\timport { mkdtempSync, rmSync } from \"node:fs\";\n     2\timport { tmpdir } from \"node:os\";\n     3\timport { join } from \"node:path\";\n     4\timport { DatabaseSync } from \"node:sqlite\";\n     5\timport type { EventKind, MessageEventInput } from \"../../src/index.js\";\n     6\t\n     7\texport type EventByKind<K extends EventKind> = Extract<\n     8\t  MessageEventInput,\n     9\t  { eventKind: K }\n    10\t>;\n    11\t\n    12\tlet keyCounter = 0;\n    13\t\n    14\tconst defaultPayloads: { [K in EventKind]: () => EventByKind<K>[\"payload\"] } = {\n    15\t  user_prompt: () => ({ text: \"please read the file\" }),\n    16\t  assistant_text: () => ({ text: \"here is what I found\" }),\n    17\t  assistant_thinking: () => ({ text: \"considering the file contents\" }),\n    18\t  runtime_note: () => ({ text: \"harness restarted mid-turn\" }),\n    19\t  tool_call: () => ({\n    20\t    toolCallId: \"call-1\",\n    21\t    toolName: \"read_file\",\n    22\t    arguments: { path: \"notes.txt\" },\n    23\t  }),\n    24\t  tool_result: () => ({\n    25\t    toolCallId: \"call-1\",\n    26\t    content: \"contents of notes.txt\",\n    27\t    isError: false,\n    28\t  }),\n    29\t  turn_end: () => ({}),\n    30\t};\n    31\t\n    32\t// Returns the discriminated MessageEventInput member for its kind, so a\n    33\t// kind/payload mismatch in test code is a compile error — building an invalid\n    34\t// pairing requires an explicit cast at the call site.\n    35\texport function validEvent<K extends EventKind>(\n    36\t  kind: K,\n    37\t  overrides: Partial<Omit<EventByKind<K>, \"eventKind\">> = {},\n    38\t): EventByKind<K> {\n    39\t  keyCounter += 1;\n    40\t  const base = {\n    41\t    eventKind: kind,\n    42\t    idempotencyKey: `fixture-key-${keyCounter}`,\n    43\t    actor: \"fixture-actor\",\n    44\t    harness: \"fixture-harness\",\n    45\t    payload: defaultPayloads[kind](),\n    46\t  };\n    47\t  // The fields are built per-kind above (payload is typed EventByKind<K>[\"payload\"]),\n    48\t  // but TS can't reduce a structural spread to the deferred Extract<…, { eventKind: K }>,\n    49\t  // so the final reconciliation goes through unknown. Call-site safety lives in the\n    50\t  // parameter types, not this assertion.\n    51\t  return { ...base, ...overrides } as unknown as EventByKind<K>;\n    52\t}\n    53\t\n    54\texport function eventBatch(kinds: readonly EventKind[]): MessageEventInput[] {\n    55\t  return kinds.map((kind) => validEvent(kind));\n    56\t}\n    57\t\n    58\texport function conversationTurn(): MessageEventInput[] {\n    59\t  return eventBatch([\n    60\t    \"user_prompt\",\n    61\t    \"assistant_text\",\n    62\t    \"tool_call\",\n    63\t    \"tool_result\",\n    64\t    \"turn_end\",\n    65\t  ]);\n    66\t}\n    67\t\n    68\texport interface TempStore {\n    69\t  dir: string;\n    70\t  registryPath: string;\n    71\t  threadPath: (name?: string) => string;\n    72\t  cleanup: () => void;\n    73\t}\n    74\t\n    75\texport function tempStore(): TempStore {\n    76\t  const dir = mkdtempSync(join(tmpdir(), \"lhc-test-\"));\n    77\t  let threadCounter = 0;\n    78\t  return {\n    79\t    dir,\n    80\t    registryPath: join(dir, \"registry.sqlite\"),\n    81\t    threadPath: (name) => {\n    82\t      threadCounter += 1;\n    83\t      return join(dir, `${name ?? `thread-${threadCounter}`}.sqlite`);\n    84\t    },\n    85\t    cleanup: () => rmSync(dir, { recursive: true, force: true }),\n    86\t  };\n    87\t}\n    88\t\n    89\t// Direct node:sqlite handle for below-SDK assertions. Read-only use by\n    90\t// convention; fixtures/corrupt.ts is the one sanctioned writer.\n    91\texport function openRaw(path: string): DatabaseSync {\n    92\t  return new DatabaseSync(path);\n    93\t}\n    94\t\n    95\texport {\n    96\t  corruptTwoOpenTurns,\n    97\t  poisonMessageBlockJson,\n    98\t  poisonMessageFormJson,\n    99\t} from \"./corrupt.js\";\n   100\texport { assertSweepReceiptShape } from \"./receipt-schema.js\";\n   101\texport { assertPiSessionConformance, loadPiSessionFixture } from \"./pi-session-format.js\";\n   102\t// The sweep's classification table, re-exported for the Story 3 unit legs:\n   103\t// fixtures are the one sanctioned bridge across the no-internal-imports\n   104\t// boundary (check-boundaries exempts test/fixtures/ by design), and the\n   105\t// table is exported from sweep.ts for tests by story contract.\n   106\texport {\n   107\t  classifyFailureReason,\n   108\t  REASON_CLASS_TABLE,\n   109\t  type ReasonClass,\n   110\t} from \"../../src/domains/thread-view/internal/sweep.js\";\n   111\texport {\n   112\t  legacyEpic01ThreadFile,\n   113\t  legacyEpic02ThreadFile,\n   114\t  legacyStory2ThreadFile,\n   115\t  schemaVersionOf,\n   116\t  type LegacyRecordedEvent,\n   117\t} from \"./legacy.js\";\n   118\texport { setIntakeClock, setIntakeWalkHook, type IntakeWalkHook } from \"./intake-seam.js\";\n   119\texport {\n   120\t  createProviderDouble,\n   121\t  ProviderDouble,\n   122\t  type CapturedInput,\n   123\t  type ProviderOpName,\n   124\t} from \"./provider-double.js\";\n   125\texport {\n   126\t  registerTestWorkHandlers,\n   127\t  testWorkHandlers,\n   128\t  type TestHandlerHooks,\n   129\t} from \"./work-handlers.js\";\n   130\texport {\n   131\t  fireViewInjection,\n   132\t  seedViewBoundary,\n   133\t  setViewInjectionHook,\n   134\t  type ViewInjectionHook,\n   135\t  type ViewInjectionPoint,\n   136\t} from \"./view-seam.js\";\n   137\texport {\n   138\t  blockedSiblingThread,\n   139\t  corruptedVariantThread,\n   140\t  derivedThreadFixture,\n   141\t  mixedStateVariantThread,\n   142\t  mutationInFlightVariant,\n   143\t  PERMANENT_FAILURE_REASON,\n   144\t  stragglerVariantThread,\n   145\t  TRANSIENT_EXHAUST_REASON,\n   146\t  type DerivedThreadFixture,\n   147\t  type DerivedThreadOptions,\n   148\t  type MixedStateFixture,\n   149\t  type MutationInFlightFixture,\n   150\t} from \"./view-thread.js\";\n   151\texport {\n   152\t  expectReadOnly,\n   153\t  observableState,\n   154\t  type ObservableState,\n   155\t} from \"./read-only-delta.js\";\n   156\texport {\n   157\t  damagedSourceThread,\n   158\t  GAPPED_SMOOTHING_REASON,\n   159\t  gappedRenderingThread,\n   160\t  multiStateThread,\n   161\t  readChunks,\n   162\t  readDerivedForms,\n   163\t  setFormState,\n   164\t  threadWithClosedTurns,\n   165\t  threadWithToolRun,\n   166\t  twinThreads,\n   167\t  type ChunkSnapshot,\n   168\t  type MultiStateClaim,\n   169\t} from \"./threads.js\";\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/view-thread.ts | sed -n '1,520p'\"","aggregated_output":"     1\t// The Epic 03 derived-thread fixture (Story 0, FC-0.3/0.4/0.5): one recorded\n     2\t// conversation — 12 turns, 4 chunks, tool-heavy middle — drained through the\n     3\t// real Epic 02 machinery (intake → enqueue → drain → handlers) against the\n     4\t// deterministic provider double into known form states. States are reached\n     5\t// through production paths, never hand-written rows (the anti-shim line\n     6\t// FC-0.3 enforces): the failed states come from scripted provider failures\n     7\t// consumed by the real retry/exhaustion mechanics, and blocked comes from\n     8\t// real source damage on a sacrificial sibling thread. Every later Epic 03\n     9\t// story compacts against what this builder returns.\n    10\timport {\n    11\t  createSdk,\n    12\t  type CompactReceipt,\n    13\t  type FormReportEntry,\n    14\t  type Lhc,\n    15\t  type MessageEventInput,\n    16\t  type MutationResult,\n    17\t} from \"../../src/index.js\";\n    18\timport { corruptTwoOpenTurns } from \"./corrupt.js\";\n    19\timport { createProviderDouble, type ProviderDouble } from \"./provider-double.js\";\n    20\timport { readChunks, type ChunkSnapshot } from \"./threads.js\";\n    21\timport { validEvent, type TempStore } from \"./index.js\";\n    22\t\n    23\t// Reason classes the scripted failures stamp, chosen from the sweep\n    24\t// classification table's vocabulary (tech design §Spec Validation): a\n    25\t// rate-limit class reads transient, a content-refusal class reads permanent —\n    26\t// FC-0.4's distinguishable-on-read-back guarantee, proven here before\n    27\t// Story 3 depends on it.\n    28\texport const TRANSIENT_EXHAUST_REASON =\n    29\t  \"rate_limit: scripted transient exhaustion (fixture)\";\n    30\texport const PERMANENT_FAILURE_REASON =\n    31\t  \"content_refusal: scripted permanent failure (fixture)\";\n    32\t\n    33\t// Chunk policy pinned so the 12 fixed-shape turns cut into exactly 4 chunks\n    34\t// (3 members each; c1–c3 closed, c4 still open). Projections from the\n    35\t// deterministic double are near-constant in size (`projection(<digest>:<40\n    36\t// chars>)`), so the cut is stable; the builder asserts the shape and throws\n    37\t// if drift ever moves it.\n    38\tconst FIXTURE_CHUNK_POLICY = { targetProjectedTokens: 90, maxProjectedTokens: 4400 };\n    39\t\n    40\tconst TURN_COUNT = 12;\n    41\tconst TOOL_HEAVY_TURNS = new Set([5, 6, 7, 8]);\n    42\t\n    43\tfunction turnEvents(turn: number): MessageEventInput[] {\n    44\t  const events: MessageEventInput[] = [\n    45\t    validEvent(\"user_prompt\", {\n    46\t      payload: { text: `turn ${turn}: please investigate area ${turn}` },\n    47\t    }),\n    48\t    validEvent(\"assistant_thinking\", {\n    49\t      payload: { text: `considering what area ${turn} contains` },\n    50\t    }),\n    51\t  ];\n    52\t  if (TOOL_HEAVY_TURNS.has(turn)) {\n    53\t    // The tool-heavy middle: two tool runs per turn — what gives Story 4 a\n    54\t    // realistic over-max zone of tool results to age behind the boundary.\n    55\t    for (const run of [1, 2]) {\n    56\t      const toolCallId = `call-fx-${turn}-${run}`;\n    57\t      events.push(\n    58\t        validEvent(\"tool_call\", {\n    59\t          payload: {\n    60\t            toolCallId,\n    61\t            toolName: \"read_file\",\n    62\t            arguments: { path: `area-${turn}/file-${run}.txt` },\n    63\t          },\n    64\t        }),\n    65\t        validEvent(\"tool_result\", {\n    66\t          payload: {\n    67\t            toolCallId,\n    68\t            content: `contents of area-${turn}/file-${run}.txt: detail ${turn}.${run} with enough text to summarize`,\n    69\t            isError: false,\n    70\t          },\n    71\t        }),\n    72\t      );\n    73\t    }\n    74\t  }\n    75\t  events.push(\n    76\t    validEvent(\"assistant_text\", { payload: { text: `findings for area ${turn}` } }),\n    77\t    validEvent(\"turn_end\"),\n    78\t  );\n    79\t  return events;\n    80\t}\n    81\t\n    82\texport interface DerivedThreadFixture {\n    83\t  filePath: string;\n    84\t  sdk: Lhc;\n    85\t  double: ProviderDouble;\n    86\t  turnIds: string[]; // t1..t12\n    87\t  chunks: ChunkSnapshot;\n    88\t  // The two manufactured failed subjects (tool_result_summary forms), reached\n    89\t  // through real retry exhaustion / terminal failure — absent when failures\n    90\t  // are disabled for a variant.\n    91\t  failedTransientMessageId?: string;\n    92\t  failedPermanentMessageId?: string;\n    93\t  // The straggler variant's turnId-null messages: one between two turns, one\n    94\t  // after the last turn — absent unless stragglers are enabled.\n    95\t  stragglerBetweenMessageId?: string;\n    96\t  stragglerTrailingMessageId?: string;\n    97\t}\n    98\t\n    99\texport interface DerivedThreadOptions {\n   100\t  failures?: boolean; // default true: manufacture the two failed states\n   101\t  stragglers?: boolean; // default false: insert the turnless runtime notes\n   102\t}\n   103\t\n   104\tasync function send(\n   105\t  sdk: Lhc,\n   106\t  filePath: string,\n   107\t  batch: readonly MessageEventInput[],\n   108\t): Promise<string[]> {\n   109\t  const result = await sdk.intakeStream.messageEvents({ filePath }, batch);\n   110\t  if (!result.ok) throw new Error(`fixture batch failed: ${result.error.reason}`);\n   111\t  return result.value.events.map((entry) => entry.messageId ?? \"\");\n   112\t}\n   113\t\n   114\tasync function drain(sdk: Lhc, filePath: string): Promise<void> {\n   115\t  const report = await sdk.work.drain({ filePath });\n   116\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n   117\t  if (report.value.stoppedBecause !== \"empty\" || report.value.remaining !== 0) {\n   118\t    throw new Error(\n   119\t      `fixture drain left work behind (stopped: ${report.value.stoppedBecause}, remaining: ${report.value.remaining})`,\n   120\t    );\n   121\t  }\n   122\t}\n   123\t\n   124\tfunction failedEntries(entries: readonly FormReportEntry[], reason: string): FormReportEntry[] {\n   125\t  return entries.filter((entry) => entry.state === \"failed\" && entry.reason === reason);\n   126\t}\n   127\t\n   128\texport async function derivedThreadFixture(\n   129\t  store: TempStore,\n   130\t  opts: DerivedThreadOptions = {},\n   131\t): Promise<DerivedThreadFixture> {\n   132\t  const failures = opts.failures ?? true;\n   133\t  const stragglers = opts.stragglers ?? false;\n   134\t\n   135\t  const double = createProviderDouble();\n   136\t  const sdk = createSdk({\n   137\t    provider: double,\n   138\t    mode: \"manual\",\n   139\t    retry: { budget: 3, backoffBaseMs: 0, backoffCapMs: 0 },\n   140\t    chunkPolicy: FIXTURE_CHUNK_POLICY,\n   141\t  });\n   142\t\n   143\t  const filePath = store.threadPath();\n   144\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   145\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n   146\t\n   147\t  const turnIds: string[] = [];\n   148\t  const fixture: DerivedThreadFixture = {\n   149\t    filePath,\n   150\t    sdk,\n   151\t    double,\n   152\t    turnIds,\n   153\t    chunks: { chunks: [], members: [] },\n   154\t  };\n   155\t\n   156\t  for (let turn = 1; turn <= TURN_COUNT; turn += 1) {\n   157\t    if (failures && turn === 6) {\n   158\t      // Retryable failures consumed to exhaustion by the head-first drain:\n   159\t      // the first tool_result_summary item of this batch takes all three\n   160\t      // attempts and lands failed with the transient reason class.\n   161\t      double.failKind(\"tool_result_summary\", 3, {\n   162\t        retryable: true,\n   163\t        reason: TRANSIENT_EXHAUST_REASON,\n   164\t      });\n   165\t    }\n   166\t    if (failures && turn === 7) {\n   167\t      // One non-retryable failure: terminal on the first attempt — the\n   168\t      // permanent reason class, attempts 1.\n   169\t      double.failKind(\"tool_result_summary\", 1, {\n   170\t        retryable: false,\n   171\t        reason: PERMANENT_FAILURE_REASON,\n   172\t      });\n   173\t    }\n   174\t    const messageIds = await send(sdk, filePath, turnEvents(turn));\n   175\t    // Batch shape is fixed for tool-heavy turns: prompt, thinking, call,\n   176\t    // result, call, result, text, end — index 3 is the first tool result,\n   177\t    // the scripted failures' subject.\n   178\t    const firstToolResultId = messageIds[3];\n   179\t    if (failures && (turn === 6 || turn === 7)) {\n   180\t      if (firstToolResultId === undefined || firstToolResultId === \"\") {\n   181\t        throw new Error(`fixture invariant: turn ${turn} carries no first tool result message`);\n   182\t      }\n   183\t      if (turn === 6) fixture.failedTransientMessageId = firstToolResultId;\n   184\t      else fixture.failedPermanentMessageId = firstToolResultId;\n   185\t    }\n   186\t    await drain(sdk, filePath);\n   187\t\n   188\t    if (stragglers && turn === 3) {\n   189\t      // A runtime note between turn 3's end and turn 4's prompt: projected\n   190\t      // with turnId = null (the Epic 01 straggler), selection rule 6 / G4.\n   191\t      const noteIds = await send(sdk, filePath, [\n   192\t        validEvent(\"runtime_note\", {\n   193\t          payload: { text: \"harness restarted between turns (fixture straggler)\" },\n   194\t        }),\n   195\t      ]);\n   196\t      const noteId = noteIds[0];\n   197\t      if (noteId === undefined || noteId === \"\") {\n   198\t        throw new Error(\"fixture invariant: between-turns straggler did not project\");\n   199\t      }\n   200\t      fixture.stragglerBetweenMessageId = noteId;\n   201\t    }\n   202\t    turnIds.push(`t${turn}`);\n   203\t  }\n   204\t\n   205\t  if (stragglers) {\n   206\t    const noteIds = await send(sdk, filePath, [\n   207\t      validEvent(\"runtime_note\", {\n   208\t        payload: { text: \"session closing note after the last turn (fixture straggler)\" },\n   209\t      }),\n   210\t    ]);\n   211\t    const noteId = noteIds[0];\n   212\t    if (noteId === undefined || noteId === \"\") {\n   213\t      throw new Error(\"fixture invariant: trailing straggler did not project\");\n   214\t    }\n   215\t    fixture.stragglerTrailingMessageId = noteId;\n   216\t    await drain(sdk, filePath);\n   217\t  }\n   218\t\n   219\t  // Shape invariants the chunk policy is pinned for: 12 closed turns in 4\n   220\t  // chunks, the first three closed. A failure here means the deterministic\n   221\t  // substrate moved (provider output or tokenizer), not a flaky test.\n   222\t  fixture.chunks = readChunks(filePath);\n   223\t  if (fixture.chunks.chunks.length !== 4) {\n   224\t    throw new Error(\n   225\t      `fixture invariant: expected 4 chunks, got ${fixture.chunks.chunks.length} — re-pin FIXTURE_CHUNK_POLICY`,\n   226\t    );\n   227\t  }\n   228\t  const closed = fixture.chunks.chunks.filter((chunk) => chunk.status === \"closed\").length;\n   229\t  if (closed !== 3) {\n   230\t    throw new Error(\n   231\t      `fixture invariant: expected chunks c1–c3 closed, got ${closed} closed — re-pin FIXTURE_CHUNK_POLICY`,\n   232\t    );\n   233\t  }\n   234\t\n   235\t  if (failures) {\n   236\t    // Verify the manufactured states by read-back through the owning report\n   237\t    // surface before handing the fixture to any test (FC-0.3's enforcement\n   238\t    // lives in the tests; this guards the builder's own contract).\n   239\t    const report = await sdk.messages.report({ filePath });\n   240\t    if (!report.ok) throw new Error(`fixture report failed: ${report.error.reason}`);\n   241\t    const transient = failedEntries(report.value, TRANSIENT_EXHAUST_REASON);\n   242\t    const permanent = failedEntries(report.value, PERMANENT_FAILURE_REASON);\n   243\t    if (\n   244\t      transient.length !== 1 ||\n   245\t      transient[0]?.subjectId !== fixture.failedTransientMessageId ||\n   246\t      permanent.length !== 1 ||\n   247\t      permanent[0]?.subjectId !== fixture.failedPermanentMessageId\n   248\t    ) {\n   249\t      throw new Error(\n   250\t        `fixture invariant: expected exactly one transient-failed and one permanent-failed tool_result_summary on the named subjects`,\n   251\t      );\n   252\t    }\n   253\t  }\n   254\t\n   255\t  return fixture;\n   256\t}\n   257\t\n   258\t// The turnless-straggler variant (FC-0.5, golden G4's substrate): the same\n   259\t// conversation with a runtime note between two turns and one after the last\n   260\t// turn, fully drained, no manufactured failures.\n   261\texport async function stragglerVariantThread(store: TempStore): Promise<DerivedThreadFixture> {\n   262\t  return derivedThreadFixture(store, { failures: false, stragglers: true });\n   263\t}\n   264\t\n   265\t// The canonical-corruption variant (FC-0.5, Epic 01 fixture pattern): a\n   266\t// short real conversation, drained clean, then damaged below the SDK into\n   267\t// the two-open-turns state no public operation can produce. Canonical\n   268\t// consumers refuse it with state_corruption.\n   269\texport async function corruptedVariantThread(\n   270\t  store: TempStore,\n   271\t): Promise<{ filePath: string; sdk: Lhc }> {\n   272\t  const double = createProviderDouble();\n   273\t  const sdk = createSdk({ provider: double, mode: \"manual\" });\n   274\t  const filePath = store.threadPath();\n   275\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   276\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n   277\t  for (let turn = 1; turn <= 3; turn += 1) {\n   278\t    await send(sdk, filePath, turnEvents(turn));\n   279\t  }\n   280\t  await drain(sdk, filePath);\n   281\t  // Open a turn through real intake, then add a second open row: two open\n   282\t  // turns, the Epic 01 invariant violation.\n   283\t  await send(sdk, filePath, [\n   284\t    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n   285\t  ]);\n   286\t  corruptTwoOpenTurns(filePath);\n   287\t  return { filePath, sdk };\n   288\t}\n   289\t\n   290\t// ── Epic 04 Story 2 extensions (test plan: fixture extended in place) ──\n   291\t\n   292\t// The mutation-in-flight variant: the tool-heavy thread compacted, then ONE\n   293\t// edit applied through the production mutation path with the drain NOT\n   294\t// settled — so the cascade's cleared-pending states and their queued work\n   295\t// are real production states, never hand-written rows (FC-fidelity rule).\n   296\t// Serves the mid-rebuild overview shape (TC-1.1) and the rebuild bracket's\n   297\t// opening state (TC-4.3).\n   298\texport interface MutationInFlightFixture extends DerivedThreadFixture {\n   299\t  compactReceipt: CompactReceipt;\n   300\t  editedMessageId: string;\n   301\t  // The cascade contract's exact account of the edit: cleared set, queued\n   302\t  // replacements, superseded items — what the bracketing health reads\n   303\t  // assert against.\n   304\t  mutation: MutationResult;\n   305\t}\n   306\t\n   307\texport async function mutationInFlightVariant(\n   308\t  store: TempStore,\n   309\t): Promise<MutationInFlightFixture> {\n   310\t  // No manufactured failures: the bracket's \"nothing outside the cascade\n   311\t  // changed state\" assertion wants a clean baseline.\n   312\t  const fixture = await derivedThreadFixture(store, { failures: false });\n   313\t  const { sdk, filePath } = fixture;\n   314\t\n   315\t  const compacted = await sdk.threadView.compact({ filePath }, {});\n   316\t  if (!compacted.ok) {\n   317\t    throw new Error(`fixture compact failed: ${compacted.error.reason}`);\n   318\t  }\n   319\t\n   320\t  // A mid-thread closed-turn target: turn 2's prompt, so the cascade spans\n   321\t  // all three subject kinds — its own smoothed_prompt, t2's two turn forms,\n   322\t  // and c1's two chunk summaries.\n   323\t  const listed = await sdk.messages.listMessages({ filePath });\n   324\t  if (!listed.ok) throw new Error(`fixture list failed: ${listed.error.reason}`);\n   325\t  const target = listed.value.find(\n   326\t    (record) => record.kind === \"user_prompt\" && record.turnId === \"t2\",\n   327\t  );\n   328\t  if (target === undefined) {\n   329\t    throw new Error(\"fixture invariant: turn 2 carries no prompt message\");\n   330\t  }\n   331\t\n   332\t  const edited = await sdk.messages.edit(\n   333\t    { filePath },\n   334\t    { messageId: target.messageId, content: \"turn 2 revised: investigate area 2 again\" },\n   335\t  );\n   336\t  if (!edited.ok) throw new Error(`fixture edit failed: ${edited.error.reason}`);\n   337\t\n   338\t  return {\n   339\t    ...fixture,\n   340\t    compactReceipt: compacted.value,\n   341\t    editedMessageId: target.messageId,\n   342\t    mutation: edited.value,\n   343\t  };\n   344\t}\n   345\t\n   346\t// The mixed-state variant (TC-4.1's substrate): one thread carrying every\n   347\t// operational state at once — ready (the drained body), failed-transient and\n   348\t// failed-permanent (the scripted exhaustions), blocked (a turn derivation\n   349\t// meeting real source damage), and pending with live queued work (a partial\n   350\t// drain stopping short). All states reached through intake, mutation, and\n   351\t// drain behavior; the only below-SDK write is the sanctioned two-open-turns\n   352\t// corruption.\n   353\texport interface MixedStateFixture extends DerivedThreadFixture {\n   354\t  blockedTurnId: string; // t13: turn forms blocked through the terminal path\n   355\t  pendingPromptMessageId: string; // t14's prompt: smoothed_prompt still queued\n   356\t}\n   357\t\n   358\texport async function mixedStateVariantThread(store: TempStore): Promise<MixedStateFixture> {\n   359\t  const fixture = await derivedThreadFixture(store);\n   360\t  const { sdk, filePath } = fixture;\n   361\t\n   362\t  // Turn 13 closes cleanly but is NOT drained: its prompt smoothing and turn\n   363\t  // derivation sit queued (events: prompt, thinking, text, end — no tools).\n   364\t  await send(sdk, filePath, turnEvents(13));\n   365\t\n   366\t  // Turn 14 opens with a lone prompt: one more queued smoothing item that the\n   367\t  // partial drain below will leave pending.\n   368\t  const promptIds = await send(sdk, filePath, [\n   369\t    validEvent(\"user_prompt\", {\n   370\t      payload: { text: \"turn 14: this prompt's smoothing stays pending\" },\n   371\t    }),\n   372\t  ]);\n   373\t  const pendingPromptMessageId = promptIds[0];\n   374\t  if (pendingPromptMessageId === undefined || pendingPromptMessageId === \"\") {\n   375\t    throw new Error(\"fixture invariant: turn 14 prompt did not project\");\n   376\t  }\n   377\t\n   378\t  // Real source damage: t14 is open, the corruption writer adds a second open\n   379\t  // row — the state t13's claimed derivation meets at drain time.\n   380\t  corruptTwoOpenTurns(filePath);\n   381\t\n   382\t  // Partial drain, head-first FIFO: item 1 is t13's prompt smoothing (ready),\n   383\t  // item 2 is t13's turn derivation (terminal on the damage → blocked).\n   384\t  // t14's smoothing stays queued — the live pending state.\n   385\t  const report = await sdk.work.drain({ filePath }, { maxItems: 2 });\n   386\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n   387\t  const blockedRun = report.value.ran.find(\n   388\t    (entry) => entry.kind === \"turn_derivation\" && entry.disposition === \"failed_terminal\",\n   389\t  );\n   390\t  if (blockedRun === undefined) {\n   391\t    throw new Error(\"fixture invariant: turn 13 derivation expected to land terminal on damage\");\n   392\t  }\n   393\t  if (report.value.remaining !== 1) {\n   394\t    throw new Error(\n   395\t      `fixture invariant: expected exactly one queued item left, got ${report.value.remaining}`,\n   396\t    );\n   397\t  }\n   398\t\n   399\t  return { ...fixture, blockedTurnId: \"t13\", pendingPromptMessageId };\n   400\t}\n   401\t\n   402\t// The blocked state's sacrificial sibling (FC-0.3): a closed turn whose\n   403\t// queued derivation meets real source damage at drain time — the handler\n   404\t// finds two open turns and lands the turn forms blocked through the\n   405\t// production terminal path, never a hand-written row.\n   406\texport async function blockedSiblingThread(\n   407\t  store: TempStore,\n   408\t): Promise<{ filePath: string; sdk: Lhc; blockedTurnId: string }> {\n   409\t  const double = createProviderDouble();\n   410\t  const sdk = createSdk({ provider: double, mode: \"manual\" });\n   411\t  const filePath = store.threadPath();\n   412\t  const created = await sdk.threads.newThread({ filePath, registryPath: store.registryPath });\n   413\t  if (!created.ok) throw new Error(`fixture thread creation failed: ${created.error.reason}`);\n   414\t  // Turn 1 closes (its turn_derivation queues); a second turn opens through\n   415\t  // real intake; the corruption writer adds another open row. The drain then\n   416\t  // claims t1's derivation against a record with two open turns.\n   417\t  await send(sdk, filePath, turnEvents(1));\n   418\t  await send(sdk, filePath, [\n   419\t    validEvent(\"user_prompt\", { payload: { text: \"left open before the damage\" } }),\n   420\t  ]);\n   421\t  corruptTwoOpenTurns(filePath);\n   422\t  const report = await sdk.work.drain({ filePath });\n   423\t  if (!report.ok) throw new Error(`fixture drain failed: ${report.error.reason}`);\n   424\t  const blocked = report.value.ran.find(\n   425\t    (entry) => entry.kind === \"turn_derivation\" && entry.disposition === \"failed_terminal\",\n   426\t  );\n   427\t  if (blocked === undefined) {\n   428\t    throw new Error(\"fixture invariant: turn_derivation expected to land terminal on damage\");\n   429\t  }\n   430\t  return { filePath, sdk, blockedTurnId: \"t1\" };\n   431\t}\n","exit_code":0,"status":"completed"}}

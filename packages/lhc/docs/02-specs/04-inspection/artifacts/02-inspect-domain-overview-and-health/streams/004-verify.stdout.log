_config\" // caller_error — band sum / bound violation, named\n    29\t  // Epic 03 Story 5: materialize accepts pi-session only; an unknown format\n    30\t  // is a caller error naming the accepted values (story Scope).\n    31\t  | \"unknown_format\" // caller_error — materialize format not supported\n    32\t  // Epic 04 Story 1: bounded listing — a bad bounds option (from > to,\n    33\t  // limit < 1, non-integer) is an operational caller error returned as a\n    34\t  // result, mirroring the compact-params precedent (additive code, the\n    35\t  // Epic 03 deviation pattern).\n    36\t  | \"invalid_bounds\"; // caller_error — listMessages bounds option rejected\n    37\t\n    38\texport interface ErrorResult {\n    39\t  errorClass: ErrorClass;\n    40\t  code: ErrorCode;\n    41\t  reason: string; // human-readable; machine logic switches on code\n    42\t  eventIndex?: number; // present on batch validation failures\n    43\t}\n    44\t\n    45\t// Expected operational failures — caller errors, corruption, environment\n    46\t// failures — are always returned as OpResult errors, never thrown.\n    47\t// Programmer bugs inside lhc may still throw; callers are not expected\n    48\t// to handle throws as contract outcomes.\n    49\texport type OpResult<T> =\n    50\t  | { ok: true; value: T }\n    51\t  | { ok: false; error: ErrorResult };\n    52\t\n    53\t// Infrastructure failures (SQLite, fs) are expected operational outcomes,\n    54\t// caught at the operation boundary and wrapped with the underlying detail.\n    55\texport function storageFailure(reason: string): { ok: false; error: ErrorResult } {\n    56\t  return {\n    57\t    ok: false,\n    58\t    error: { errorClass: \"system_error\", code: \"storage_failure\", reason },\n    59\t  };\n    60\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/zsh -lc \"node --input-type=module <<'NODE'\nimport { mkdtempSync, rmSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport path from 'node:path';\nimport { createSdk, resolveNamedProvider } from './dist/index.js';\nconst dir = mkdtempSync(path.join(tmpdir(), 'lhc-bg-inspect-read-'));\ntry {\n  const filePath = path.join(dir, 'thread.sqlite');\n  const provider = resolveNamedProvider('deterministic');\n  const seed = createSdk({ provider, mode: 'manual' });\n  const created = await seed.threads.newThread({ filePath });\n  if (\"'!created.ok) throw new Error(JSON.stringify(created));\n  const sent = await seed.intakeStream.messageEvents({ filePath }, [\n    { eventKind: '\"'user_prompt', idempotencyKey: 'k1', actor: 'tester', harness: 'bg-read', payload: { text: 'leave this pending' } }\n  ]);\n  if (\"'!sent.ok) throw new Error(JSON.stringify(sent));\n  const reader = createSdk({ provider, mode: '\"'manual' });\n  const before = await reader.messages.listQueuedWork({ filePath });\n  if (\"'!before.ok) throw new Error(JSON.stringify(before));\n  const calls = [];\n  const captureProvider = Object.fromEntries(['\"'smoothPrompt','summarizeToolCall','summarizeToolResult','composeTurnRendering','projectLowerBand','summarizeChunkDetailed','summarizeChunkBrief'].map((op) => [op, async (input) => { calls.push({ op, input }); return { ok: true, text: \"'`${op}-unexpected` }; } ]));\n  const bg = createSdk({ provider: captureProvider, mode: '\"'background', retry: { budget: 1, backoffBaseMs: 0, backoffCapMs: 0 } });\n  for (const command of ['overview', 'health']) {\n    const result = await bg.inspect[command]({ filePath });\n    if (\"'!result.ok) throw new Error(`${command} failed ${JSON.stringify(result)}`);\n    await bg.drainSettled({ filePath });\n  }\n  const after = await reader.messages.listQueuedWork({ filePath });\n  if (!after.ok) throw new Error(JSON.stringify(after));\n  if (calls.length !== 0) throw new Error(`provider called ${JSON.stringify(calls)}`);\n  if (JSON.stringify(after.value) !== JSON.stringify(before.value)) throw new Error(`queued work changed before=${JSON.stringify(before.value)} after=${JSON.stringify(after.value)}`);\n  console.log('\"'background inspect overview/health no-provider/read-only probe: OK');\n} finally {\n  rmSync(dir, { recursive: true, force: true });\n}\nNODE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

s.chunkId !== undefined) reportFlags.chunkId = flags.chunkId;\n   422\t      return runTurnsReport(threadRefFrom(flags), reportFlags);\n   423\t    }\n   424\t    case \"turns requeue\": {\n   425\t      const missingRef = requireThreadRef(flags, \"turns requeue\");\n   426\t      if (missingRef !== undefined) return missingRef;\n   427\t      if (\n   428\t        flags.subjectKind === undefined ||\n   429\t        flags.subjectId === undefined ||\n   430\t        flags.form === undefined\n   431\t      ) {\n   432\t        return renderCliError(\n   433\t          \"caller_error\",\n   434\t          \"missing_flag\",\n   435\t          \"turns requeue requires --subject-kind, --subject-id, and --form\",\n   436\t        );\n   437\t      }\n   438\t      if (flags.subjectKind !== \"turn\" && flags.subjectKind !== \"chunk\") {\n   439\t        return renderCliError(\n   440\t          \"caller_error\",\n   441\t          \"missing_flag\",\n   442\t          `--subject-kind must be \"turn\" or \"chunk\", got ${flags.subjectKind}`,\n   443\t        );\n   444\t      }\n   445\t      return runTurnsRequeue(threadRefFrom(flags), {\n   446\t        subjectKind: flags.subjectKind,\n   447\t        subjectId: flags.subjectId,\n   448\t        form: flags.form,\n   449\t      });\n   450\t    }\n   451\t    case \"turns delete\": {\n   452\t      const missingRef = requireThreadRef(flags, \"turns delete\");\n   453\t      if (missingRef !== undefined) return missingRef;\n   454\t      if (flags.turnId === undefined) {\n   455\t        return renderCliError(\n   456\t          \"caller_error\",\n   457\t          \"missing_flag\",\n   458\t          \"turns delete requires --turn (or --turn-id)\",\n   459\t        );\n   460\t      }\n   461\t      return runTurnsDelete(threadRefFrom(flags), { turnId: flags.turnId });\n   462\t    }\n   463\t    case \"inspect overview\":\n   464\t      return (\n   465\t        requireThreadRef(flags, \"inspect overview\") ??\n   466\t        runInspectOverview(threadRefFrom(flags))\n   467\t      );\n   468\t    case \"inspect health\":\n   469\t      return (\n   470\t        requireThreadRef(flags, \"inspect health\") ?? runInspectHealth(threadRefFrom(flags))\n   471\t      );\n   472\t    // Routed ahead of its story so the CLI mirrors the SDK surface: the stub\n   473\t    // returns the structured not-implemented result; Story 3 makes it real\n   474\t    // (and adds it to the help text).\n   475\t    case \"inspect view\":\n   476\t      return (\n   477\t        requireThreadRef(flags, \"inspect view\") ?? runInspectView(threadRefFrom(flags))\n   478\t      );\n   479\t    case \"work drain\": {\n   480\t      const missingRef = requireThreadRef(flags, \"work drain\");\n   481\t      if (missingRef !== undefined) return missingRef;\n   482\t      const drainFlags: { provider?: string; maxItems?: number } = {};\n   483\t      if (flags.provider !== undefined) drainFlags.provider = flags.provider;\n   484\t      if (flags.maxItems !== undefined) {\n   485\t        const maxItems = Number(flags.maxItems);\n   486\t        if (!Number.isInteger(maxItems) || maxItems <= 0) {\n   487\t          return renderCliError(\n   488\t            \"caller_error\",\n   489\t            \"missing_flag\",\n   490\t            `--max-items must be a positive integer, got ${flags.maxItems}`,\n   491\t          );\n   492\t        }\n   493\t        drainFlags.maxItems = maxItems;\n   494\t      }\n   495\t      return runWorkDrain(threadRefFrom(flags), drainFlags);\n   496\t    }\n   497\t    default:\n   498\t      return renderCliError(\n   499\t        \"caller_error\",\n   500\t        \"unknown_command\",\n   501\t        `unknown command: ${key}; run lhc --help`,\n   502\t      );\n   503\t  }\n   504\t}\n","exit_code":0,"status":"completed"}}

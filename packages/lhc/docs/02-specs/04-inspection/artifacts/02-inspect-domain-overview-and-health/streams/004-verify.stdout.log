{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/cli/inspect.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// `lhc inspect overview|view|health` (Epic 04 Story 2) per tech design\n     2\t// §Placement: thin argv-to-SDK wrappers — no logic beyond arg mapping, so\n     3\t// CLI parity with the SDK result is structural (same code path, same JSON).\n     4\timport * as inspect from \"../domains/inspect/index.js\";\n     5\timport type { ThreadRef } from \"../domains/threads/index.js\";\n     6\timport { renderResult, type CliResult } from \"./render.js\";\n     7\t\n     8\texport async function runInspectOverview(threadRef: ThreadRef): Promise<CliResult> {\n     9\t  return renderResult(await inspect.overview(threadRef));\n    10\t}\n    11\t\n    12\texport async function runInspectHealth(threadRef: ThreadRef): Promise<CliResult> {\n    13\t  return renderResult(await inspect.health(threadRef));\n    14\t}\n    15\t\n    16\texport async function runInspectView(threadRef: ThreadRef): Promise<CliResult> {\n    17\t  return renderResult(await inspect.view(threadRef));\n    18\t}\n","exit_code":0,"status":"completed"}}

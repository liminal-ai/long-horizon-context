{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/domains/thread-view/index.ts | sed -n '1,520p'\"","aggregated_output":"     1\t// thread-view surface (Epic 03): pull, status, compact, sweep, materialize.\n     2\t// Story 1 landed the hot-path reads (`pull`, `status`): local reads and\n     3\t// deterministic string assembly only, no inference, no network, no queue\n     4\t// interaction, no writes (AC-1.1, AC-2.8). Story 2 landed `compact`;\n     5\t// Story 3 landed `sweep` (standalone and embedded default-on in compact);\n     6\t// Story 5 lands `materialize` (the PI session-file render target over the\n     7\t// same pull assembly). Story 0's substrate (profile resolution, consumed by\n     8\t// createSdk) re-exports at the bottom.\n     9\timport { existsSync } from \"node:fs\";\n    10\timport * as path from \"node:path\";\n    11\timport {\n    12\t  resolveInstanceViewConfig,\n    13\t  runWithThreadTouchSuppressed,\n    14\t  type OperationContext,\n    15\t} from \"../../shared/context.js\";\n    16\timport type { FormReportEntry } from \"../../shared/derivation.js\";\n    17\timport { storageFailure, type ErrorResult, type OpResult } from \"../../shared/errors.js\";\n    18\timport type {\n    19\t  CompactReceipt,\n    20\t  PullResult,\n    21\t  ResolvedViewConfig,\n    22\t  SweepReceipt,\n    23\t  ViewCompactParams,\n    24\t  ViewMessage,\n    25\t  ViewProfile,\n    26\t  ViewStatus,\n    27\t} from \"../../shared/view.js\";\n    28\timport * as messagesDomain from \"../messages/index.js\";\n    29\timport * as turnsDomain from \"../turns/index.js\";\n    30\timport {\n    31\t  openThreadDatabase,\n    32\t  resolveThreadRef,\n    33\t  type ThreadRef,\n    34\t} from \"../threads/index.js\";\n    35\timport {\n    36\t  executeBoundaryAdvance,\n    37\t  readBoundaryPosition,\n    38\t  visibilityZoneTokens,\n    39\t} from \"./internal/boundary.js\";\n    40\timport { profileViolation, resolveViewConfig } from \"./internal/profiles.js\";\n    41\timport {\n    42\t  assembleBandText,\n    43\t  renderBandMessage,\n    44\t  renderTailMessage,\n    45\t  toolNamesByCallId,\n    46\t} from \"./internal/render.js\";\n    47\timport { fireViewInjection } from \"./internal/seam.js\";\n    48\timport {\n    49\t  CanonicalCorruptionError,\n    50\t  readSelectionInputs,\n    51\t  selectArrangement,\n    52\t  type ArrangementEntry,\n    53\t} from \"./internal/select.js\";\n    54\timport { writePiSessionFile, type MaterializeInput } from \"./internal/materialize.js\";\n    55\timport {\n    56\t  readReadyToolResultSummaries,\n    57\t  readTailMessages,\n    58\t  readThreadMetadata,\n    59\t  readViewSnapshot,\n    60\t  replaceViewSnapshot,\n    61\t  tailTokenSum,\n    62\t} from \"./internal/snapshot.js\";\n    63\timport { runSweep } from \"./internal/sweep.js\";\n    64\timport { estimateTokens } from \"../../tech-utils/token-counting/index.js\";\n    65\timport type { Band } from \"../../shared/view.js\";\n    66\t\n    67\t// Config resolution for the operation in hand: the SDK instance's resolved\n    68\t// view config rides the per-instance seam (epic-fix-001 pattern, tech design\n    69\t// Flow 4); below-SDK direct domain calls fall back to the built-in defaults\n    70\t// through the same one resolution path createSdk uses.\n    71\tconst DEFAULT_VIEW_CONFIG: ResolvedViewConfig = resolveViewConfig();\n    72\t\n    73\tfunction viewConfig(): ResolvedViewConfig {\n    74\t  return resolveInstanceViewConfig() ?? DEFAULT_VIEW_CONFIG;\n    75\t}\n    76\t\n    77\tfunction threadNotFound(filePath: string): { ok: false; error: ErrorResult } {\n    78\t  return {\n    79\t    ok: false,\n    80\t    error: {\n    81\t      errorClass: \"caller_error\",\n    82\t      code: \"thread_not_found\",\n    83\t      reason: `no thread file exists at ${filePath}`,\n    84\t    },\n    85\t  };\n    86\t}\n    87\t\n    88\tfunction detail(cause: unknown): string {\n    89\t  return cause instanceof Error ? cause.message : String(cause);\n    90\t}\n    91\t\n    92\t// ── pull (Flow 1: AC-1.1–1.3, 1.5 default-boundary leg, 1.7) ─────\n    93\t\n    94\t// The hot-path read: view header + bands (if any), tail messages after the\n    95\t// compact point (deleted-filtered, record order), boundary position; then\n    96\t// format — band messages first, tail per the mapping table, tool results\n    97\t// at-or-behind the boundary in short form. No view row ⇒ the whole record is\n    98\t// tail from event 1 (AC-1.3) through this same code path with the compact\n    99\t// point at its zero origin — snapshot-absent, never a separate branch.\n   100\t//\n   101\t// Reads-only is structural, not disciplined: the whole operation runs in the\n   102\t// touch-suppressed scope, so the open announcement that would let a\n   103\t// background SDK's scheduler hang a first-touch catch-up drain off this read\n   104\t// (openThreadDatabase → fireThreadTouch → scheduler.touch) never fires —\n   105\t// AC-1.1's no-queue-interaction holds in both host modes.\n   106\texport async function pull(ref: ThreadRef): Promise<OpResult<PullResult>> {\n   107\t  return runWithThreadTouchSuppressed(() => pullInner(ref));\n   108\t}\n   109\t\n   110\t// The one assembly both render targets consume (Story 5): pull serves the\n   111\t// messages; materialize serves the same entries with the metadata the file's\n   112\t// generated fields derive from (entry ids, record-time timestamps). Sharing\n   113\t// the array is what makes AC-5.3's parity structural — materialize cannot\n   114\t// diverge from pull because there is no second assembly to diverge.\n   115\tinterface AssembledView {\n   116\t  entries: Array<{ message: ViewMessage; entryId: string; timestamp: string }>;\n   117\t  meta: PullResult[\"meta\"];\n   118\t  snapshot: ReturnType<typeof readViewSnapshot>;\n   119\t}\n   120\t\n   121\tfunction assembleView(db: Parameters<typeof readViewSnapshot>[0]): AssembledView {\n   122\t  const snapshot = readViewSnapshot(db);\n   123\t  const compactPoint = snapshot?.compactPoint ?? 0;\n   124\t  const boundaryPosition = readBoundaryPosition(db);\n   125\t  const tailRows = readTailMessages(db, compactPoint);\n   126\t  const renderCtx = {\n   127\t    boundaryPosition,\n   128\t    toolNameByCallId: toolNamesByCallId(tailRows),\n   129\t    toolResultSummaries: readReadyToolResultSummaries(db),\n   130\t  };\n   131\t\n   132\t  const entries: AssembledView[\"entries\"] = [];\n   133\t  if (snapshot !== null) {\n   134\t    for (const band of snapshot.bands) {\n   135\t      entries.push({\n   136\t        message: renderBandMessage(band.band, band.renderedText),\n   137\t        // Band entries are not record messages; their generated fields\n   138\t        // derive from view metadata (AC-5.2).\n   139\t        entryId: `${snapshot.viewId}-${band.band}`,\n   140\t        timestamp: snapshot.createdAt,\n   141\t      });\n   142\t    }\n   143\t  }\n   144\t  for (const row of tailRows) {\n   145\t    entries.push({\n   146\t      message: renderTailMessage(row, renderCtx),\n   147\t      entryId: row.messageId,\n   148\t      timestamp: row.recordedAt,\n   149\t    });\n   150\t  }\n   151\t\n   152\t  return {\n   153\t    entries,\n   154\t    meta: {\n   155\t      compactPoint: snapshot?.compactPoint ?? null,\n   156\t      coveredFrom: snapshot?.coveredFrom ?? null,\n   157\t      boundaryPosition,\n   158\t      gapCount: snapshot?.gapCount ?? 0,\n   159\t      degradedCount: snapshot?.degradedCount ?? 0,\n   160\t      viewId: snapshot?.viewId ?? null,\n   161\t      createdAt: snapshot?.createdAt ?? null,\n   162\t    },\n   163\t    snapshot,\n   164\t  };\n   165\t}\n   166\t\n   167\tasync function pullInner(ref: ThreadRef): Promise<OpResult<PullResult>> {\n   168\t  const resolved = await resolveThreadRef(ref);\n   169\t  if (!resolved.ok) return resolved;\n   170\t  const { filePath } = resolved.value;\n   171\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   172\t\n   173\t  const opened = openThreadDatabase(filePath);\n   174\t  if (!opened.ok) return opened;\n   175\t  const db = opened.value;\n   176\t  try {\n   177\t    const assembled = assembleView(db);\n   178\t    return {\n   179\t      ok: true,\n   180\t      value: {\n   181\t        messages: assembled.entries.map((entry) => entry.message),\n   182\t        meta: assembled.meta,\n   183\t      },\n   184\t    };\n   185\t  } catch (cause) {\n   186\t    return storageFailure(`view pull failed: ${detail(cause)}`);\n   187\t  } finally {\n   188\t    db.close();\n   189\t  }\n   190\t}\n   191\t\n   192\t// ── status (AC-2.8) ───────────────────────────────────────────────\n   193\t\n   194\t// Derivation counts bucket from one report entry the way the report's own\n   195\t// vocabulary reads (shared/derivation.ts): never-attempted or first-flight\n   196\t// pending, retrying (pending with attempts spent), failed, blocked. Ready\n   197\t// forms are healthy and not an operational situation.\n   198\tfunction bucketDerivation(\n   199\t  entries: readonly FormReportEntry[],\n   200\t  counts: ViewStatus[\"derivation\"],\n   201\t): void {\n   202\t  for (const entry of entries) {\n   203\t    switch (entry.state) {\n   204\t      case \"pending\":\n   205\t        if ((entry.queue?.attempts ?? 0) > 0) counts.retrying += 1;\n   206\t        else counts.pending += 1;\n   207\t        break;\n   208\t      case \"failed\":\n   209\t        counts.failed += 1;\n   210\t        break;\n   211\t      case \"blocked\":\n   212\t        counts.blocked += 1;\n   213\t        break;\n   214\t      case \"ready\":\n   215\t        break;\n   216\t    }\n   217\t  }\n   218\t}\n   219\t\n   220\t// Reads only, callable any time, no side effects: tail size against the\n   221\t// configured trigger threshold with a compact recommendation (`tailTokens >\n   222\t// threshold`, nothing smarter — the caller owns policy), derivation counts\n   223\t// by state read through the OWNERS' report surfaces (must-not-own: never a\n   224\t// direct derived_form read here), the active view's health or null\n   225\t// pre-compact, and the visibility zone's sum against its max — computed live\n   226\t// by the same query the Story 4 advance will use, so \"visible in status\" is\n   227\t// structural, not stored.\n   228\t//\n   229\t// Like pull, the whole read — including the owners' report surfaces it\n   230\t// consumes — runs in the touch-suppressed scope, so a background SDK's\n   231\t// status can never schedule a catch-up drain (AC-2.8 reads-only, both\n   232\t// host modes).\n   233\texport async function status(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n   234\t  return runWithThreadTouchSuppressed(() => statusInner(ref));\n   235\t}\n   236\t\n   237\tasync function statusInner(ref: ThreadRef): Promise<OpResult<ViewStatus>> {\n   238\t  const resolved = await resolveThreadRef(ref);\n   239\t  if (!resolved.ok) return resolved;\n   240\t  const { filePath } = resolved.value;\n   241\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   242\t\n   243\t  const config = viewConfig();\n   244\t  const opened = openThreadDatabase(filePath);\n   245\t  if (!opened.ok) return opened;\n   246\t  const db = opened.value;\n   247\t  let tailTokens: number;\n   248\t  let zoneTokens: number;\n   249\t  let view: ViewStatus[\"view\"];\n   250\t  try {\n   251\t    const snapshot = readViewSnapshot(db);\n   252\t    const compactPoint = snapshot?.compactPoint ?? 0;\n   253\t    const boundaryPosition = readBoundaryPosition(db);\n   254\t    tailTokens = tailTokenSum(db, compactPoint);\n   255\t    zoneTokens = visibilityZoneTokens(db, boundaryPosition, compactPoint);\n   256\t    view =\n   257\t      snapshot === null\n   258\t        ? null\n   259\t        : {\n   260\t            degraded: snapshot.degradedCount,\n   261\t            gaps: snapshot.gapCount,\n   262\t            builtAt: snapshot.createdAt,\n   263\t          };\n   264\t  } catch (cause) {\n   265\t    return storageFailure(`view status failed: ${detail(cause)}`);\n   266\t  } finally {\n   267\t    db.close();\n   268\t  }\n   269\t\n   270\t  // The owners' report surfaces open their own handles; ours is closed first\n   271\t  // so the status read never holds two handles on one thread file.\n   272\t  const messageReport = await messagesDomain.report({ filePath });\n   273\t  if (!messageReport.ok) return messageReport;\n   274\t  const turnReport = await turnsDomain.report({ filePath });\n   275\t  if (!turnReport.ok) return turnReport;\n   276\t  const derivation: ViewStatus[\"derivation\"] = {\n   277\t    pending: 0,\n   278\t    retrying: 0,\n   279\t    failed: 0,\n   280\t    blocked: 0,\n   281\t  };\n   282\t  bucketDerivation(messageReport.value, derivation);\n   283\t  bucketDerivation(turnReport.value, derivation);\n   284\t\n   285\t  return {\n   286\t    ok: true,\n   287\t    value: {\n   288\t      tailTokens,\n   289\t      threshold: config.compactThreshold,\n   290\t      compactRecommended: tailTokens > config.compactThreshold,\n   291\t      derivation,\n   292\t      view,\n   293\t      visibility: { zoneTokens, maxTokens: config.visibility.maxTokens },\n   294\t    },\n   295\t  };\n   296\t}\n   297\t\n   298\t// ── compact (Flow 2: AC-2.1–2.7, 2.9, 2.10) ──────────────────────\n   299\t\n   300\t// The default base when no profile is named: the first built-in, matching\n   301\t// the epic's primary user (the PI continuation harness). Explicit params\n   302\t// override the base field-wise (AC-2.2).\n   303\tconst DEFAULT_PROFILE_NAME = \"continuation\";\n   304\t\n   305\tfunction callerError(\n   306\t  code: \"unknown_profile\" | \"invalid_view_config\",\n   307\t  reason: string,\n   308\t): { ok: false; error: ErrorResult } {\n   309\t  return { ok: false, error: { errorClass: \"caller_error\", code, reason } };\n   310\t}\n   311\t\n   312\tconst BAND_ORDER: readonly Band[] = [\"brief\", \"detailed\", \"smooth\"];\n   313\t\n   314\t// Compact runs only when invoked through this surface (AC-2.1: no code path\n   315\t// in core calls it). Flow, in order: validate profile/params (pre-IO, so a\n   316\t// rejection provably touches nothing) → sweep, on by default, `sweep: false`\n   317\t// skips (AC-3.6; the receipt records which) → read record + forms with the\n   318\t// corruption check in the reads (pre-transaction, prior view trivially\n   319\t// intact on refusal) → selection walk → band rendering → one BEGIN\n   320\t// IMMEDIATE replacing the view and resetting the boundary → receipt.\n   321\t// Assembly is entirely from stored artifacts: nothing here can reach a\n   322\t// provider (AC-2.4 zero-inference is structural — the sweep step repairs\n   323\t// through owners' requeue surfaces and calls no provider either).\n   324\texport async function compact(\n   325\t  ref: ThreadRef,\n   326\t  opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n   327\t): Promise<OpResult<CompactReceipt>> {\n   328\t  const resolved = await resolveThreadRef(ref);\n   329\t  if (!resolved.ok) return resolved;\n   330\t  const { filePath } = resolved.value;\n   331\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   332\t\n   333\t  const config = viewConfig();\n   334\t  const baseName = opts.profile ?? DEFAULT_PROFILE_NAME;\n   335\t  const base = config.profiles[baseName];\n   336\t  if (base === undefined) {\n   337\t    return callerError(\n   338\t      \"unknown_profile\",\n   339\t      `unknown profile \"${baseName}\"; configured profiles are ${Object.keys(config.profiles)\n   340\t        .map((name) => `\"${name}\"`)\n   341\t        .join(\", \")}`,\n   342\t    );\n   343\t  }\n   344\t  const merged: ViewProfile = {\n   345\t    name: base.name,\n   346\t    lowerBound: opts.params?.lowerBound ?? base.lowerBound,\n   347\t    percentages: { ...base.percentages, ...opts.params?.percentages },\n   348\t  };\n   349\t  const violation = profileViolation(merged);\n   350\t  if (violation !== null) return callerError(\"invalid_view_config\", violation);\n   351\t  // Receipt provenance: \"null when explicit params\" (tech design §Storage) —\n   352\t  // any param override means the config is no longer a named profile's mix,\n   353\t  // even when one served as the merge base; the receipt's config carries the\n   354\t  // resolved truth. A bare or profile-only call names its profile.\n   355\t  const profileName = opts.params === undefined ? baseName : null;\n   356\t\n   357\t  // The sweep step (Flow 2 / Flow 3, AC-3.6): on by default so every compact\n   358\t  // leaves the thread healthier than it found it; `sweep: false` skips with\n   359\t  // the skip recorded in the receipt. Runs before this operation opens its\n   360\t  // own handle (the owners' surfaces open theirs), and before any view\n   361\t  // write — a sweep failure aborts the compact with the prior view intact.\n   362\t  let sweepOutcome: SweepReceipt | { skipped: true };\n   363\t  if (opts.sweep === false) {\n   364\t    sweepOutcome = { skipped: true };\n   365\t  } else {\n   366\t    const swept = await runSweep(filePath);\n   367\t    if (!swept.ok) return swept;\n   368\t    sweepOutcome = swept.value;\n   369\t  }\n   370\t\n   371\t  const opened = openThreadDatabase(filePath);\n   372\t  if (!opened.ok) return opened;\n   373\t  const db = opened.value;\n   374\t  try {\n   375\t    let inputs;\n   376\t    try {\n   377\t      inputs = readSelectionInputs(db);\n   378\t    } catch (cause) {\n   379\t      if (cause instanceof CanonicalCorruptionError) {\n   380\t        // Pre-transaction refusal: nothing was written, the prior view and\n   381\t        // the record are untouched (AC-2.5).\n   382\t        return {\n   383\t          ok: false,\n   384\t          error: { errorClass: \"state_corruption\", code: cause.code, reason: cause.message },\n   385\t        };\n   386\t      }\n   387\t      throw cause;\n   388\t    }\n   389\t    const selection = selectArrangement(inputs, {\n   390\t      lowerBound: merged.lowerBound,\n   391\t      percentages: merged.percentages,\n   392\t    });\n   393\t\n   394\t    const entriesByBand = (band: Band): ArrangementEntry[] =>\n   395\t      selection.entries.filter((entry) => entry.band === band);\n   396\t    const bands = BAND_ORDER.flatMap((band) => {\n   397\t      const entries = entriesByBand(band);\n   398\t      if (entries.length === 0) return [];\n   399\t      const renderedText = assembleBandText(entries.map((entry) => entry.text));\n   400\t      return [{ band, renderedText, tokenCount: estimateTokens(renderedText) }];\n   401\t    });\n   402\t\n   403\t    const createdAt = new Date().toISOString();\n   404\t    // view_id is v<compact event order> — deterministic, and deliberately\n   405\t    // reused by an intake-free recompact (tech design L395: do not \"fix\"\n   406\t    // into a uniqueness scheme; the singleton row is replaced whole).\n   407\t    const viewId = `v${inputs.maxEventOrder}`;\n   408\t\n   409\t    // Story-0 injection point: TC-2.4's crash between the sweep and the\n   410\t    // view-write transaction. An installed hook's throw aborts here —\n   411\t    // before BEGIN — so the previous view keeps serving.\n   412\t    fireViewInjection(\"compact-write\");\n   413\t\n   414\t    replaceViewSnapshot(db, {\n   415\t      viewId,\n   416\t      createdAt,\n   417\t      compactPoint: selection.compactPoint,\n   418\t      coveredFrom: selection.coveredFrom,\n   419\t      profileName,\n   420\t      configJson: JSON.stringify({\n   421\t        lowerBound: merged.lowerBound,\n   422\t        percentages: merged.percentages,\n   423\t      }),\n   424\t      arrangementJson: JSON.stringify(\n   425\t        selection.entries.map((entry) => ({\n   426\t          band: entry.band,\n   427\t          subjectKind: entry.subjectKind,\n   428\t          subjectId: entry.subjectId,\n   429\t          formUsed: entry.formUsed,\n   430\t          degraded: entry.degraded,\n   431\t        })),\n   432\t      ),\n   433\t      gapsJson: JSON.stringify(\n   434\t        selection.entries\n   435\t          .filter((entry) => entry.gap)\n   436\t          .map((entry) => ({\n   437\t            band: entry.band,\n   438\t            subjectId: entry.subjectId,\n   439\t            reason: entry.reason ?? \"unknown\",\n   440\t          })),\n   441\t      ),\n   442\t      sourceStateJson: JSON.stringify({\n   443\t        maxEventOrder: inputs.maxEventOrder,\n   444\t        formCounts: inputs.formCounts,\n   445\t      }),\n   446\t      bands,\n   447\t    });\n   448\t\n   449\t    const bandReport = {} as CompactReceipt[\"bands\"];\n   450\t    for (const band of BAND_ORDER) {\n   451\t      const stored = bands.find((row) => row.band === band);\n   452\t      bandReport[band] = {\n   453\t        entries: entriesByBand(band).length,\n   454\t        tokens: stored?.tokenCount ?? 0,\n   455\t      };\n   456\t    }\n   457\t    const tailTokens = tailTokenSum(db, selection.compactPoint);\n   458\t    return {\n   459\t      ok: true,\n   460\t      value: {\n   461\t        viewId,\n   462\t        profile: profileName,\n   463\t        config: { ...merged.percentages, lowerBound: merged.lowerBound },\n   464\t        bands: bandReport,\n   465\t        tailTokens,\n   466\t        // Actual assembled total vs the bound (target, not cap — AC-2.4).\n   467\t        totalTokens:\n   468\t          bandReport.brief.tokens +\n   469\t          bandReport.detailed.tokens +\n   470\t          bandReport.smooth.tokens +\n   471\t          tailTokens,\n   472\t        coveredFrom: selection.coveredFrom,\n   473\t        compactPoint: selection.compactPoint,\n   474\t        degraded: selection.entries\n   475\t          .filter((entry) => entry.degraded)\n   476\t          .map((entry) => ({\n   477\t            band: entry.band,\n   478\t            subjectId: entry.subjectId,\n   479\t            usedForm: entry.formUsed,\n   480\t          })),\n   481\t        gaps: selection.entries\n   482\t          .filter((entry) => entry.gap)\n   483\t          .map((entry) => ({\n   484\t            band: entry.band,\n   485\t            subjectId: entry.subjectId,\n   486\t            reason: entry.reason ?? \"unknown\",\n   487\t          })),\n   488\t        sweep: sweepOutcome,\n   489\t      },\n   490\t    };\n   491\t  } catch (cause) {\n   492\t    return storageFailure(`view compact failed: ${detail(cause)}`);\n   493\t  } finally {\n   494\t    db.close();\n   495\t  }\n   496\t}\n   497\t\n   498\t// ── sweep (Flow 3: AC-3.1–3.5, 3.7) ──────────────────────────────\n   499\t\n   500\t// The standalone readiness sweep: walk the owners' reports, requeue the\n   501\t// transiently-failed forms through the owners' requeue surfaces, return the\n   502\t// per-owner/kind receipt. The walk itself lives in internal/sweep.ts; the\n   503\t// compact embeds the same walk (AC-3.6), so standalone and embedded receipts\n   504\t// share one shape by construction (AC-3.7's SDK leg; the CLI leg rides\n   505\t// Story 5's process suite). Returns without waiting on any queued work\n   506\t// (AC-3.2): requeues are row writes; background mode's drain heals later.\n   507\texport async function sweep(ref: ThreadRef): Promise<OpResult<SweepReceipt>> {\n   508\t  const resolved = await resolveThreadRef(ref);\n   509\t  if (!resolved.ok) return resolved;\n   510\t  const { filePath } = resolved.value;\n   511\t  if (!existsSync(filePath)) return threadNotFound(filePath);\n   512\t  try {\n   513\t    return await runSweep(filePath);\n   514\t  } catch (cause) {\n   515\t    return storageFailure(`view sweep failed: ${detail(cause)}`);\n   516\t  }\n   517\t}\n   518\t\n  
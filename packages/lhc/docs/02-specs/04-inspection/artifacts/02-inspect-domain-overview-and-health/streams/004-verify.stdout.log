{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/src/shared/inspect.ts | sed -n '1,500p'\"","aggregated_output":"     1\t// Epic 04 shared vocabulary: the inspect domain's report shapes (tech design\n     2\t// §Interface Definitions). Inspect is a pure consumer — these shapes carry\n     3\t// other domains' surface output composed into counts and summaries; nothing\n     4\t// here is re-derived or re-interpreted beyond the owners' reported states.\n     5\timport type { Band } from \"./view.js\";\n     6\t\n     7\texport interface InspectOverview {\n     8\t  thread: { id: string; createdAt: string; metadata?: Record<string, string> };\n     9\t  // span null ⇔ count 0 (AC-1.3: absent pieces report as zeros/nulls).\n    10\t  events: { count: number; span: { first: number; last: number } | null };\n    11\t  // Deleted contract (AC-1.2): deleted messages appear only in `deleted` —\n    12\t  // excluded from visible, byKind, and visibleTokens; event counts above are\n    13\t  // unaffected (the record retains everything).\n    14\t  messages: {\n    15\t    visible: number;\n    16\t    byKind: Record<string, number>;\n    17\t    deleted: number;\n    18\t    visibleTokens: number;\n    19\t  };\n    20\t  turns: { open: number; closed: number };\n    21\t  chunks: { count: number; unchunkedTurns: number };\n    22\t  // Counts by operational state across both owners' report surfaces; ready\n    23\t  // included (AC-1.1 — unlike ViewStatus, which reports situations only).\n    24\t  derivation: {\n    25\t    ready: number;\n    26\t    pending: number;\n    27\t    retrying: number;\n    28\t    failed: number;\n    29\t    blocked: number;\n    30\t  };\n    31\t  // Active-view summary, or null when never compacted (AC-1.1).\n    32\t  view: {\n    33\t    viewId: string;\n    34\t    createdAt: string;\n    35\t    compactPoint: number;\n    36\t    coveredFrom: number;\n    37\t  } | null;\n    38\t  visibility: { boundaryPosition: number; zoneTokens: number };\n    39\t}\n    40\t\n    41\t// Story 3's shape, pinned with the domain so the inspect vocabulary lands\n    42\t// whole (tech design §Interface Definitions); `inspect.view` serves it.\n    43\texport interface ViewContentsReport {\n    44\t  meta: {\n    45\t    viewId: string;\n    46\t    createdAt: string;\n    47\t    profile: string | null;\n    48\t    config: { lowerBound: number; percentages: Record<string, number> };\n    49\t    compactPoint: number;\n    50\t    coveredFrom: number;\n    51\t  } | null;\n    52\t  bands: Array<{\n    53\t    band: Band;\n    54\t    entries: Array<{\n    55\t      subjectKind: \"chunk\" | \"turn\";\n    56\t      subjectId: string;\n    57\t      formUsed: string;\n    58\t      degraded: boolean;\n    59\t    }>;\n    60\t    storedTokens: number;\n    61\t  }>;\n    62\t  gaps: Array<{ band: Band; subjectId: string; reason: string }>;\n    63\t  tail: { messageCount: number; tokens: number }; // as served (AC-2.2)\n    64\t  loadCost: { bandTokens: number; tailTokens: number; total: number }; // = pull (AC-2.3)\n    65\t  sourceState: { maxEventOrder: number; formCounts: Record<string, number> }; // provenance verbatim (AC-2.5)\n    66\t}\n    67\t\n    68\texport interface HealthReport {\n    69\t  // Counts by owner, form kind, and operational state (AC-4.1), assembled\n    70\t  // entirely from the owners' report surfaces.\n    71\t  owners: Array<{\n    72\t    owner: \"messages\" | \"turns\";\n    73\t    kind: string;\n    74\t    counts: {\n    75\t      ready: number;\n    76\t      pending: number;\n    77\t      retrying: number;\n    78\t      failed: number;\n    79\t      blocked: number;\n    80\t    };\n    81\t  }>;\n    82\t  // Actionable failure detail (AC-4.2): enough to decide and target a\n    83\t  // requeue without raw SQL.\n    84\t  failures: Array<{\n    85\t    owner: string;\n    86\t    subjectKind: string;\n    87\t    subjectId: string;\n    88\t    form: string;\n    89\t    reason: string;\n    90\t    attempts: number;\n    91\t    lastError?: string;\n    92\t  }>;\n    93\t  // What a requeue pass would touch — failed and not blocked — reported,\n    94\t  // never executed (AC-4.3).\n    95\t  repairPreview: Array<{\n    96\t    owner: string;\n    97\t    subjectKind: string;\n    98\t    subjectId: string;\n    99\t    form: string;\n   100\t  }>;\n   101\t  // Live queue visibility from the owners' queue detail (AC-4.5), counted\n   102\t  // per report entry so the section is consistent by construction with the\n   103\t  // pending/retrying state counts in the same report.\n   104\t  queue: { queued: number; claimed: number };\n   105\t}\n","exit_code":0,"status":"completed"}}

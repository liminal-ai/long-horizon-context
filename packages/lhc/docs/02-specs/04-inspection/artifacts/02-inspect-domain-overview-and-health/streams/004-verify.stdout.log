{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/lhc/test/fixtures/provider-double.ts | sed -n '1,260p'\"","aggregated_output":"     1\t// Deterministic DerivationProvider double (DD-7, test plan §Test Substrate).\n     2\t// Injected at the same seam production adapters use — dependency injection,\n     3\t// not a mock of internals. Every operation returns marked, input-derived\n     4\t// output: `<marker>(<digest>:<prefix>)` where the digest and prefix are pure\n     5\t// functions of the input, so identical input to the same operation yields\n     6\t// identical output across double instances, and different operations are\n     7\t// distinguishable by marker. Scripting (failNext / failKind / delayKind /\n     8\t// captureInputs) is per-instance state and never leaks across tests that\n     9\t// construct their own double.\n    10\timport {\n    11\t  deterministicOutcomesSuffix,\n    12\t  deterministicReceiptsSuffix,\n    13\t  deterministicText,\n    14\t  type DerivationProvider,\n    15\t  type ProviderResult,\n    16\t  type RenderingPart,\n    17\t  type ToolOutcome,\n    18\t  type ToolRunReceipt,\n    19\t} from \"../../src/index.js\";\n    20\t\n    21\texport type ProviderOpName =\n    22\t  | \"smoothPrompt\"\n    23\t  | \"summarizeToolCall\"\n    24\t  | \"summarizeToolResult\"\n    25\t  | \"composeTurnRendering\"\n    26\t  | \"projectLowerBand\"\n    27\t  | \"summarizeChunkDetailed\"\n    28\t  | \"summarizeChunkBrief\";\n    29\t\n    30\t// Tests script by work-kind / form-kind vocabulary (the test plan writes\n    31\t// `failKind(prompt_smoothing, …)`); the double accepts those aliases as well\n    32\t// as the operation names themselves.\n    33\tconst KIND_ALIASES: Record<string, ProviderOpName> = {\n    34\t  smoothPrompt: \"smoothPrompt\",\n    35\t  summarizeToolCall: \"summarizeToolCall\",\n    36\t  summarizeToolResult: \"summarizeToolResult\",\n    37\t  composeTurnRendering: \"composeTurnRendering\",\n    38\t  projectLowerBand: \"projectLowerBand\",\n    39\t  summarizeChunkDetailed: \"summarizeChunkDetailed\",\n    40\t  summarizeChunkBrief: \"summarizeChunkBrief\",\n    41\t  prompt_smoothing: \"smoothPrompt\",\n    42\t  smoothed_prompt: \"smoothPrompt\",\n    43\t  tool_call_summary: \"summarizeToolCall\",\n    44\t  tool_result_summary: \"summarizeToolResult\",\n    45\t  turn_rendering: \"composeTurnRendering\",\n    46\t  lower_band_projection: \"projectLowerBand\",\n    47\t  chunk_summary_detailed: \"summarizeChunkDetailed\",\n    48\t  chunk_summary_brief: \"summarizeChunkBrief\",\n    49\t};\n    50\t\n    51\tfunction resolveOpName(kind: string): ProviderOpName {\n    52\t  const op = KIND_ALIASES[kind];\n    53\t  if (op === undefined) throw new Error(`provider double: unknown operation/kind \"${kind}\"`);\n    54\t  return op;\n    55\t}\n    56\t\n    57\tinterface FailScript {\n    58\t  remaining: number;\n    59\t  retryable: boolean;\n    60\t  reason: string;\n    61\t}\n    62\t\n    63\texport interface CapturedInput {\n    64\t  op: ProviderOpName;\n    65\t  input: unknown;\n    66\t}\n    67\t\n    68\texport class ProviderDouble implements DerivationProvider {\n    69\t  private failNextScript: FailScript | null = null;\n    70\t  private readonly failByOp = new Map<ProviderOpName, FailScript>();\n    71\t  private readonly delayByOp = new Map<ProviderOpName, number>();\n    72\t  private capturing = false;\n    73\t  private readonly captured: CapturedInput[] = [];\n    74\t\n    75\t  // Fail the next n calls to any operation, then succeed.\n    76\t  failNext(n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    77\t    this.failNextScript = {\n    78\t      remaining: n,\n    79\t      retryable: opts?.retryable ?? true,\n    80\t      reason: opts?.reason ?? \"scripted failure (failNext)\",\n    81\t    };\n    82\t  }\n    83\t\n    84\t  // Fail the next n calls to one operation (kind names and op names both\n    85\t  // accepted). retryable: false scripts a terminal failure.\n    86\t  failKind(kind: string, n: number, opts?: { retryable?: boolean; reason?: string }): void {\n    87\t    const op = resolveOpName(kind);\n    88\t    this.failByOp.set(op, {\n    89\t      remaining: n,\n    90\t      retryable: opts?.retryable ?? true,\n    91\t      reason: opts?.reason ?? `scripted failure (${op})`,\n    92\t    });\n    93\t  }\n    94\t\n    95\t  delayKind(kind: string, ms: number): void {\n    96\t    this.delayByOp.set(resolveOpName(kind), ms);\n    97\t  }\n    98\t\n    99\t  // Start capturing inputs; returns the live log (appended in call order).\n   100\t  captureInputs(): readonly CapturedInput[] {\n   101\t    this.capturing = true;\n   102\t    return this.captured;\n   103\t  }\n   104\t\n   105\t  private async run(\n   106\t    op: ProviderOpName,\n   107\t    input: unknown,\n   108\t    text: string,\n   109\t    suffix = \"\",\n   110\t  ): Promise<ProviderResult> {\n   111\t    if (this.capturing) this.captured.push({ op, input: structuredClone(input) });\n   112\t    const delay = this.delayByOp.get(op);\n   113\t    if (delay !== undefined && delay > 0) {\n   114\t      await new Promise((resolve) => setTimeout(resolve, delay));\n   115\t    }\n   116\t    const scripts = [this.failNextScript, this.failByOp.get(op) ?? null];\n   117\t    for (const script of scripts) {\n   118\t      if (script !== null && script.remaining > 0) {\n   119\t        script.remaining -= 1;\n   120\t        return { ok: false, retryable: script.retryable, reason: script.reason };\n   121\t      }\n   122\t    }\n   123\t    // Output format shared with src/providers/deterministic.ts so the double\n   124\t    // and the registry's \"deterministic\" provider produce byte-identical\n   125\t    // artifacts across in-process and spawned runs; the chunk-summary\n   126\t    // receipt/outcome suffixes (AC-3.8) come from the same shared helpers.\n   127\t    return { ok: true, text: deterministicText(op, input, text) + suffix };\n   128\t  }\n   129\t\n   130\t  smoothPrompt(i: { text: string }): Promise<ProviderResult> {\n   131\t    return this.run(\"smoothPrompt\", i, i.text);\n   132\t  }\n   133\t\n   134\t  summarizeToolCall(i: {\n   135\t    toolName: string;\n   136\t    argsJson: string;\n   137\t    pairedResult?: { content: string; isError: boolean };\n   138\t  }): Promise<ProviderResult> {\n   139\t    return this.run(\"summarizeToolCall\", i, `${i.toolName} ${i.argsJson}`);\n   140\t  }\n   141\t\n   142\t  summarizeToolResult(i: { toolName: string; content: string }): Promise<ProviderResult> {\n   143\t    return this.run(\"summarizeToolResult\", i, i.content);\n   144\t  }\n   145\t\n   146\t  composeTurnRendering(i: { parts: RenderingPart[] }): Promise<ProviderResult> {\n   147\t    return this.run(\"composeTurnRendering\", i, i.parts.map((p) => p.text).join(\" | \"));\n   148\t  }\n   149\t\n   150\t  projectLowerBand(i: { rendering: string }): Promise<ProviderResult> {\n   151\t    return this.run(\"projectLowerBand\", i, i.rendering);\n   152\t  }\n   153\t\n   154\t  summarizeChunkDetailed(i: {\n   155\t    memberProjections: string[];\n   156\t    memberReceipts?: ToolRunReceipt[][];\n   157\t  }): Promise<ProviderResult> {\n   158\t    return this.run(\n   159\t      \"summarizeChunkDetailed\",\n   160\t      i,\n   161\t      i.memberProjections.join(\" | \"),\n   162\t      deterministicReceiptsSuffix(i.memberReceipts),\n   163\t    );\n   164\t  }\n   165\t\n   166\t  summarizeChunkBrief(i: {\n   167\t    memberProjections: string[];\n   168\t    memberOutcomes?: ToolOutcome[][];\n   169\t  }): Promise<ProviderResult> {\n   170\t    return this.run(\n   171\t      \"summarizeChunkBrief\",\n   172\t      i,\n   173\t      i.memberProjections.join(\" | \"),\n   174\t      deterministicOutcomesSuffix(i.memberOutcomes),\n   175\t    );\n   176\t  }\n   177\t}\n   178\t\n   179\texport function createProviderDouble(): ProviderDouble {\n   180\t  return new ProviderDouble();\n   181\t}\n","exit_code":0,"status":"completed"}}

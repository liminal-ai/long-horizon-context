\n   106\texport {\n   107\t  BUILT_IN_PROFILES,\n   108\t  DEFAULT_COMPACT_THRESHOLD,\n   109\t  DEFAULT_VISIBILITY,\n   110\t} from \"./domains/thread-view/index.js\";\n   111\texport type {\n   112\t  Band,\n   113\t  CompactReceipt,\n   114\t  PullResult,\n   115\t  ResolvedViewConfig,\n   116\t  SdkViewConfig,\n   117\t  SweepReceipt,\n   118\t  ViewCompactParams,\n   119\t  ViewMessage,\n   120\t  ViewMeta,\n   121\t  ViewProfile,\n   122\t  ViewProfileOverride,\n   123\t  ViewStatus,\n   124\t  VisibilityBudgets,\n   125\t} from \"./shared/view.js\";\n   126\texport {\n   127\t  countLiveItems,\n   128\t  enqueue,\n   129\t  queueDetail,\n   130\t  supersedeQueued,\n   131\t  type ClaimedWorkItem,\n   132\t  type EnqueueFormTarget,\n   133\t  type EnqueueInput,\n   134\t  type QueueDetailRow,\n   135\t} from \"./tech-utils/work-queue/index.js\";\n   136\t\n   137\t// Epic 04 inspect vocabulary (shared/inspect.ts): the report shapes the\n   138\t// inspect surface serves.\n   139\texport type {\n   140\t  HealthReport,\n   141\t  InspectOverview,\n   142\t  ViewContentsReport,\n   143\t} from \"./shared/inspect.js\";\n   144\t\n   145\texport type { ThreadFileInfo, ThreadRef } from \"./domains/threads/index.js\";\n   146\texport type {\n   147\t  Block,\n   148\t  BlockType,\n   149\t  MessageDetail,\n   150\t  MessageListOptions,\n   151\t  MessageRecord,\n   152\t  MutationResult,\n   153\t} from \"./domains/messages/index.js\";\n   154\texport type { ChunkRecord, TurnRecord } from \"./domains/turns/index.js\";\n   155\texport type {\n   156\t  BatchResult,\n   157\t  EventKind,\n   158\t  EventRecord,\n   159\t  MessageEventInput,\n   160\t} from \"./domains/intake-stream/index.js\";\n   161\t\n   162\t// ── SDK assembly (DD-6/DD-7) ─────────────────────────────────────\n   163\t\n   164\texport type WorkHandlerMap = Partial<Record<WorkKind, WorkHandler>>;\n   165\t\n   166\t// Merge per-domain handler tables into the one join between the queue's\n   167\t// opaque kinds and domain code. A kind claimed by two tables is a wiring bug\n   168\t// (each kind has exactly one owner) and throws at construction.\n   169\texport function assembleWorkHandlerMap(\n   170\t  tables: ReadonlyArray<WorkHandlerMap>,\n   171\t): WorkHandlerMap {\n   172\t  const map: WorkHandlerMap = {};\n   173\t  for (const table of tables) {\n   174\t    for (const [kind, handler] of Object.entries(table)) {\n   175\t      if (map[kind as WorkKind] !== undefined) {\n   176\t        throw new TypeError(`work kind \"${kind}\" registered by more than one domain`);\n   177\t      }\n   178\t      map[kind as WorkKind] = handler;\n   179\t    }\n   180\t  }\n   181\t  return map;\n   182\t}\n   183\t\n   184\tfunction unknownWorkKind(kind: string): { ok: false; error: ErrorResult } {\n   185\t  return {\n   186\t    ok: false,\n   187\t    error: {\n   188\t      errorClass: \"state_corruption\",\n   189\t      code: \"unknown_work_kind\",\n   190\t      reason: `no handler registered for work kind \"${kind}\"`,\n   191\t    },\n   192\t  };\n   193\t}\n   194\t\n   195\t// Dispatch-time lookup: an unregistered kind is reported explicitly — never\n   196\t// a throw, never a silent undefined (DD-6, AC-1.8's foundation).\n   197\texport function lookupWorkHandler(\n   198\t  map: WorkHandlerMap,\n   199\t  kind: string,\n   200\t): OpResult<WorkHandler> {\n   201\t  const handler = map[kind as WorkKind];\n   202\t  if (handler === undefined) return unknownWorkKind(kind);\n   203\t  return { ok: true, value: handler };\n   204\t}\n   205\t\n   206\t// The work surface (CLI: lhc work …). Story 1 carries drain; report and\n   207\t// requeue land in Story 4.\n   208\texport interface WorkSurface {\n   209\t  drain(\n   210\t    ref: threadsDomain.ThreadRef,\n   211\t    opts?: { maxItems?: number },\n   212\t  ): Promise<OpResult<DrainReport>>;\n   213\t}\n   214\t\n   215\t// The thread-view surface as the SDK exposes it (Epic 03, tech design\n   216\t// §Interface Definitions): the five operations only — the Story 0 config\n   217\t// substrate the domain index also carries is construction machinery, not an\n   218\t// operation. pull and status are real from Story 1; compact, sweep, and\n   219\t// materialize return structured not-implemented results until their stories\n   220\t// land.\n   221\texport interface ThreadViewSurface {\n   222\t  pull(ref: threadsDomain.ThreadRef): Promise<OpResult<PullResult>>;\n   223\t  status(ref: threadsDomain.ThreadRef): Promise<OpResult<ViewStatus>>;\n   224\t  compact(\n   225\t    ref: threadsDomain.ThreadRef,\n   226\t    opts: { profile?: string; params?: ViewCompactParams; sweep?: boolean },\n   227\t  ): Promise<OpResult<CompactReceipt>>;\n   228\t  sweep(ref: threadsDomain.ThreadRef): Promise<OpResult<SweepReceipt>>;\n   229\t  materialize(\n   230\t    ref: threadsDomain.ThreadRef,\n   231\t    opts: { path: string; format?: \"pi-session\" },\n   232\t  ): Promise<OpResult<{ writtenPath: string }>>;\n   233\t}\n   234\t\n   235\texport interface Lhc {\n   236\t  threads: typeof threadsDomain;\n   237\t  intakeStream: typeof intakeStreamDomain;\n   238\t  messages: typeof messagesDomain;\n   239\t  turns: typeof turnsDomain;\n   240\t  threadView: ThreadViewSurface;\n   241\t  // Epic 04: the read-only report surface. Scoped through the instance seam\n   242\t  // like every other namespace so the status read it composes resolves THIS\n   243\t  // SDK's view config (threshold, visibility budgets).\n   244\t  inspect: typeof inspectDomain;\n   245\t  config: ResolvedSdkConfig;\n   246\t  scheduler: Scheduler;\n   247\t  workHandlers: WorkHandlerMap;\n   248\t  lookupWorkHandler(kind: string): OpResult<WorkHandler>;\n   249\t  work: WorkSurface;\n   250\t  // Resolves when the scheduler has no running or pending drain for the\n   251\t  // thread (issue 3) — the awaitable for background mode, and a no-op\n   252\t  // resolve in manual mode.\n   253\t  drainSettled(ref: threadsDomain.ThreadRef): Promise<void>;\n   254\t}\n   255\t\n   256\tfunction requirePositive(value: number, name: string): void {\n   257\t  if (!Number.isFinite(value) || value <= 0) {\n   258\t    throw new TypeError(`createSdk config: ${name} must be a positive number, got ${value}`);\n   259\t  }\n   260\t}\n   261\t\n   262\tfunction requireNonNegative(value: number, name: string): void {\n   263\t  if (!Number.isFinite(value) || value < 0) {\n   264\t    throw new TypeError(`createSdk config: ${name} must be a non-negative number, got ${value}`);\n   265\t  }\n   266\t}\n   267\t\n   268\t// Bind a domain surface to one SDK instance's delivery seam (epic-fix-001):\n   269\t// every operation invoked through sdk.* runs inside runWithInstanceSeam, so\n   270\t// the poke/touch it triggers deep inside reaches THIS SDK's scheduler\n   271\t// (background) or a no-op (manual) — never another SDK's. Non-function exports\n   272\t// (e.g. a domain's workHandlers table) pass through unchanged. The wrapped\n   273\t// object is the same shape as the namespace, so the public surface type holds.\n   274\tfunction scopeSurface<T extends object>(surface: T, seam: InstanceSeam): T {\n   275\t  const scoped: Record<string, unknown> = {};\n   276\t  for (const key of Object.keys(surface)) {\n   277\t    const value = (surface as Record<string, unknown>)[key];\n   278\t    scoped[key] =\n   279\t      typeof value === \"function\"\n   280\t        ? (...args: unknown[]): unknown =>\n   281\t            runWithInstanceSeam(seam, () => (value as (...a: unknown[]) => unknown)(...args))\n   282\t        : value;\n   283\t  }\n   284\t  return scoped as T;\n   285\t}\n   286\t\n   287\t// The only assembly path: provider, mode, clock, and policy enter here.\n   288\t// Config mistakes are programmer errors at construction and throw; operating\n   289\t// failures after construction return OpResults per the error contract.\n   290\texport function createSdk(config: SdkConfig): Lhc {\n   291\t  if (config.mode !== \"background\" && config.mode !== \"manual\") {\n   292\t    throw new TypeError(\n   293\t      `createSdk config: mode must be \"background\" or \"manual\", got ${JSON.stringify(config.mode)}`,\n   294\t    );\n   295\t  }\n   296\t  if (config.provider === null || typeof config.provider !== \"object\") {\n   297\t    throw new TypeError(\"createSdk config: provider must implement DerivationProvider\");\n   298\t  }\n   299\t  for (const operation of PROVIDER_OPERATIONS) {\n   300\t    if (typeof config.provider[operation] !== \"function\") {\n   301\t      throw new TypeError(`createSdk config: provider is missing operation ${operation}`);\n   302\t    }\n   303\t  }\n   304\t\n   305\t  const resolved: ResolvedSdkConfig = {\n   306\t    provider: config.provider,\n   307\t    mode: config.mode,\n   308\t    clock: config.clock ?? (() => new Date()),\n   309\t    retry: config.retry ?? { budget: 3, backoffBaseMs: 5000, backoffCapMs: 60000 },\n   310\t    lease: config.lease ?? { durationMs: 120000 },\n   311\t    chunkPolicy:\n   312\t      config.chunkPolicy ?? { targetProjectedTokens: 2200, maxProjectedTokens: 4400 },\n   313\t    // Epic 03 (FC-0.2): built-ins merged with user profiles by name, band\n   314\t    // sums and visibility budgets validated — throws naming the violation.\n   315\t    view: resolveViewConfig(config.view),\n   316\t  };\n   317\t  requirePositive(resolved.retry.budget, \"retry.budget\");\n   318\t  requireNonNegative(resolved.retry.backoffBaseMs, \"retry.backoffBaseMs\");\n   319\t  requireNonNegative(resolved.retry.backoffCapMs, \"retry.backoffCapMs\");\n   320\t  if (resolved.retry.backoffCapMs < resolved.retry.backoffBaseMs) {\n   321\t    throw new TypeError(\"createSdk config: retry.backoffCapMs must be >= retry.backoffBaseMs\");\n   322\t  }\n   323\t  requirePositive(resolved.lease.durationMs, \"lease.durationMs\");\n   324\t  requirePositive(resolved.chunkPolicy.targetProjectedTokens, \"chunkPolicy.targetProjectedTokens\");\n   325\t  if (resolved.chunkPolicy.maxProjectedTokens < resolved.chunkPolicy.targetProjectedTokens) {\n   326\t    throw new TypeError(\n   327\t      \"createSdk config: chunkPolicy.maxProjectedTokens must be >= targetProjectedTokens\",\n   328\t    );\n   329\t  }\n   330\t\n   331\t  // Handler maps merge from per-domain contributions at construction (DD-6).\n   332\t  // The tables are empty until Stories 2–3 land the real handlers; the\n   333\t  // assembly mechanics are production code from day one.\n   334\t  const workHandlers = assembleWorkHandlerMap([\n   335\t    messagesDomain.workHandlers,\n   336\t    turnsDomain.workHandlers,\n   337\t  ]);\n   338\t\n   339\t  const drainDeps: DrainDeps = {\n   340\t    lookupHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   341\t    hasAnyHandler: () => Object.keys(workHandlers).length > 0,\n   342\t    config: resolved,\n   343\t  };\n   344\t  const scheduler = createScheduler(resolved.mode, drainDeps);\n   345\t\n   346\t  // This SDK's per-instance delivery seam (epic-fix-001). Every operation\n   347\t  // invoked through the scoped surfaces below runs inside it, so enqueue pokes\n   348\t  // (DD-5) and thread-file touches (DD-10) reach THIS instance's scheduler in\n   349\t  // background mode, or a no-op in manual mode — isolated from any other SDK\n   350\t  // alive in the process. A manual SDK therefore never auto-drains, whatever\n   351\t  // the construction order, because its operations deliver to the no-op seam,\n   352\t  // not to whatever a background SDK installed below.\n   353\t  // The seam also carries this instance's resolved view config (Epic 03,\n   354\t  // tech design Flow 4): thread-view operations invoked through sdk.* read\n   355\t  // THIS SDK's profiles/budgets/threshold; below-SDK direct domain calls\n   356\t  // fall back to the built-in defaults inside the thread-view surface.\n   357\t  const seam: InstanceSeam =\n   358\t    resolved.mode === \"background\"\n   359\t      ? {\n   360\t          poke: (threadId) => scheduler.poke(threadId),\n   361\t          touch: (filePath, db) => scheduler.touch(filePath, db),\n   362\t          view: resolved.view,\n   363\t        }\n   364\t      : { poke: () => {}, touch: () => {}, view: resolved.view };\n   365\t\n   366\t  // Background mode also installs the below-SDK default seam so a direct\n   367\t  // domain call made with no SDK scope — a top-level mutation in the\n   368\t  // single-background \"production path\" — still reaches the one installed\n   369\t  // scheduler. The per-instance scoping above overrides this for every sdk.*\n   370\t  // call, so the default can never auto-drain a manual SDK's work. Manual mode\n   371\t  // leaves the default alone (pokes stay no-ops by contract).\n   372\t  if (resolved.mode === \"background\") {\n   373\t    installSchedulerPoke((threadId) => scheduler.poke(threadId));\n   374\t    setThreadTouch((filePath, db) => scheduler.touch(filePath, db));\n   375\t  }\n   376\t\n   377\t  const work: WorkSurface = {\n   378\t    drain: (ref, opts) =>\n   379\t      runWithInstanceSeam(seam, async () => {\n   380\t        const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   381\t        if (!resolvedRef.ok) return resolvedRef;\n   382\t        return runDrain(resolvedRef.value.filePath, drainDeps, opts);\n   383\t      }),\n   384\t  };\n   385\t\n   386\t  return {\n   387\t    threads: threadsDomain,\n   388\t    intakeStream: scopeSurface(intakeStreamDomain, seam),\n   389\t    messages: scopeSurface(messagesDomain, seam),\n   390\t    turns: scopeSurface(turnsDomain, seam),\n   391\t    threadView: scopeSurface<ThreadViewSurface>(\n   392\t      {\n   393\t        pull: threadViewDomain.pull,\n   394\t        status: threadViewDomain.status,\n   395\t        compact: threadViewDomain.compact,\n   396\t        sweep: threadViewDomain.sweep,\n   397\t        materialize: threadViewDomain.materialize,\n   398\t      },\n   399\t      seam,\n   400\t    ),\n   401\t    inspect: scopeSurface(inspectDomain, seam),\n   402\t    config: resolved,\n   403\t    scheduler,\n   404\t    workHandlers,\n   405\t    lookupWorkHandler: (kind) => lookupWorkHandler(workHandlers, kind),\n   406\t    work,\n   407\t    drainSettled: async (ref) => {\n   408\t      const resolvedRef = await threadsDomain.resolveThreadRef(ref);\n   409\t      if (!resolvedRef.ok) return; // nothing can be scheduled for an unresolvable ref\n   410\t      const threadId = peekThreadId(resolvedRef.value.filePath);\n   411\t      if (threadId === null) return;\n   412\t      return scheduler.drainSettled(threadId);\n   413\t    },\n   414\t  };\n   415\t}\n","exit_code":0,"status":"completed"}}

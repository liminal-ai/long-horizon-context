ck_index)\n    83\t        );`,\n    84\t      ],\n    85\t    },\n    86\t    {\n    87\t      version: 3, // Story 4: turn state machine\n    88\t      statements: [\n    89\t        `CREATE TABLE turns (\n    90\t          turn_id TEXT PRIMARY KEY,\n","exit_code":0,"status":"completed"}}

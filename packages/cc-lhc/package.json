{
  "name": "cc-lhc",
  "version": "0.0.0",
  "private": true,
  "description": "Claude Code \u2194 LHC CLI wrapper (PTY passthrough).",
  "type": "module",
  "bin": {
    "cc-lhc": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:all": "pnpm run test",
    "verify": "pnpm run typecheck && pnpm run test"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.12",
    "cc-lhc-native": "workspace:*",
    "lhc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}

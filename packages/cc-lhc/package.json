{
  "name": "cc-lhc",
  "version": "0.3.0",
  "private": true,
  "description": "Claude Code \u2194 LHC CLI wrapper (PTY passthrough).",
  "type": "module",
  "bin": {
    "cc-lhc": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/stamp-build-identity.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --exclude test/package/**",
    "test:all": "vitest run --exclude test/package/**",
    "test:package": "vitest run test/package/bounded-core-production.test.ts",
    "assemble:npm": "node scripts/assemble-npm-package.mjs",
    "check:npm": "node scripts/check-npm-package.mjs",
    "smoke:npm": "node scripts/smoke-npm-package.mjs",
    "preview:panel": "node dist/bin.js preview",
    "verify": "pnpm run typecheck && pnpm run test",
    "story0:process-capability": "vitest run test/story0/process-capability/production-path.test.ts"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.12",
    "cc-lhc-native": "workspace:*",
    "lhc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
